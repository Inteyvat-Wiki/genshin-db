			"dialogs": [
				{
					"id": 750230701,
					"content": "キュウ！キュー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230702
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230702,
					"content": "まあまあ、そう焦るなよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230703
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750230703,
					"content": "正直、私もさっきはおチビさんが心配だったよ。リアリティを追求するために、かなりの量の爆薬を用意したからね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230704,
						750230706
					],
					"speakerTitle": "アカタンカ"
				},
				{
					"id": 750230704,
					"content": "たかが爆発なんて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230705
					]
				},
				{
					"id": 750230705,
					"content": "キュウ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230708
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230708,
					"content": "とにかく、今回の経験を活かせば、次はもっと上手くいくはずだ。みんなの協力に感謝するよ。さて、完成した映影を見てみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230709
					],
					"speakerTitle": "アカタンカ"
				},
				{
					"id": 750230709,
					"content": "予想外なことに、画面には尾に赤いリボンをつけた救世主も、ジージー音を立てる邪悪な敵も、ハラハラドキドキの爆発シーンも映っていなく…アカタンカの次々と変わる表情だけが映っていた…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750230710
					]
				},
				{
					"id": 750230710,
					"content": "私が主役になった…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230711,
						750230713
					],
					"speakerTitle": "アカタンカ"
				},
				{
					"id": 750230711,
					"content": "おめでとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230712
					]
				},
				{
					"id": 750230712,
					"content": "そんなわけないだろ！まさか写真機が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230714
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750230714,
					"content": "そういえば…確かに今回、初めて写真機を本格的に使ったな…まさか、逆にしてしまっていたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230715
					],
					"speakerTitle": "アカタンカ"
				},
				{
					"id": 750230715,
					"content": "そんな簡単に言うけど、オイラたちの苦労が台無しじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230716
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750230716,
					"content": "キュ…キュウ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230717
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230717,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}も期待してたのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230718
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750230718,
					"content": "すまない、すべて私のせいだ！さっきのはリハーサルということにしてくれ。今度こそ本気を出して、最高の映影を撮る！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230719
					],
					"speakerTitle": "アカタンカ"
				},
				{
					"id": 750230719,
					"content": "キュ…キュー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230720
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230720,
					"content": "やる気満々だな。じゃあ、もう一回やってみるか。今度こそ、なんもなきゃいいんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230721
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750230721,
					"content": "さっきと同じ手順をもう一度踏み、ようやく納得のいく結果となった…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750230722
					]
				},
				{
					"id": 750230722,
					"content": "見事！パーフェクト！期待以上だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230723,
						750230724
					],
					"speakerTitle": "アカタンカ"
				},
				{
					"id": 750230723,
					"content": "こんなの朝飯前だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230725
					]
				},
				{
					"id": 750230725,
					"content": "約束通りの報酬に加えて、この写真を記念に贈ろう。なんて言ったって、私の傑作だからね。もちろん、君たちの協力のおかげでもある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230726
					],
					"speakerTitle": "アカタンカ"
				},
				{
					"id": 750230726,
					"content": "#わぁ、{REALNAME[ID(2)|SHOWHOST(true)]}の堂々とした姿、確かにかっこいいぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230727
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750230727,
					"content": "キュー！キュー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230728
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230728,
					"content": "#へへっ、{REALNAME[ID(2)|SHOWHOST(true)]}も満足だし、結果オーライだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750230724,
					"content": "監督さん、報酬は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230725
					]
				},
				{
					"id": 750230713,
					"content": "写真機の操作が…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230714
					]
				},
				{
					"id": 750230706,
					"content": "さすがに危険すぎるんじゃない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230707
					]
				},
				{
					"id": 750230707,
					"content": "そうだそうだ！もし怪我をしたり、火事を引き起こしたりしたら大変だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230708
					],
					"speakerTitle": "パイモン"
				}
			]
		},
