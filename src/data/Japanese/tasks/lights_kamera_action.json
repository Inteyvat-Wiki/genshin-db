			"dialogs": [
				{
					"id": 750231201,
					"content": "なんで敵役が事前の打ち合わせにもいなかった臨時の役者なんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750231202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750231202,
					"content": "シーッ、静かに！撮影を始める！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750231203
					],
					"speakerTitle": "アカタンカ"
				},
				{
					"id": 750231203,
					"content": "「許せない…安らかに眠れ、我が友よ、ああ…ああ…倒れた部{RUBY#[D]仲間たち}族のを見ると、涙が出そうだ！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750231204
					],
					"speakerTitle": "アカタンカ"
				},
				{
					"id": 750231204,
					"content": "「だが、今は泣いている場合ではない。枯燥の{RUBY#[S]ショロトル}使者がすぐそこにいる。今日こそ仇を討つ！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750231205
					],
					"speakerTitle": "アカタンカ"
				},
				{
					"id": 750231205,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750231206
					],
					"speakerTitle": "アカタンカ"
				},
				{
					"id": 750231206,
					"content": "歯も牙もない猛獣、その顔色は遠い国の特産品であるスミレウリのように冷静沈着である！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750231207
					],
					"speakerTitle": "アカタンカ"
				},
				{
					"id": 750231207,
					"content": "それは——たとえ「火山級激辛タタコス」を飲み込んでも、微動だにしない残酷な顔だ。実に恐ろしい——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750231208
					],
					"speakerTitle": "アカタンカ"
				},
				{
					"id": 750231208,
					"content": "「今度こそ、死ぬまで後悔させてやる！」と言いながら、尾に赤いリボンをつけた巨獣は、幾度となく鍛錬した「ミートシチュー·ブレイズ」を使った——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750231209
					],
					"speakerTitle": "アカタンカ"
				},
				{
					"id": 750231209,
					"content": "よし、今だ！雷スライムを樽のそばに誘導し、樽を壊すんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750231210
					],
					"speakerTitle": "アカタンカ"
				},
				{
					"id": 750231210,
					"content": "このタイミングで樽を壊すのか？その樽が「ミートシチュー·ブレイズ」なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750231211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750231211,
					"content": "なんか変だけど…まあ、やってみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
