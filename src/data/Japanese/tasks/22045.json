					"大島純平"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220450101,
					"content": "うーん…なんか違う…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450102
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220450102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450103
					]
				},
				{
					"id": 220450103,
					"content": "旅人！ちょうどいい時に来た、君を探してたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450104
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220450104,
					"content": "最近木彫りを作ってる時に思ったんだが…完成した木彫りに生気を感じない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450105,
						220450107
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220450105,
					"content": "木彫りだからね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450106
					]
				},
				{
					"id": 220450106,
					"content": "まあ、そうなんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450108
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220450108,
					"content": "ああ…なんて言うか…俺の求めてる「生気」は、活力なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450109
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220450109,
					"content": "ほら、代理宮司様は普段寝てるけど、たまには起きてうろうろするだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450110
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220450110,
					"content": "そうしてる時、代理宮司様は飛び跳ねたり、落ち葉に飛びついたり、背伸びをしたりする…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450111
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220450111,
					"content": "そういう動作が、俺の求めてる活力なんだ。それを原型に木彫りを作れば、「生気」を込めた作品になると思う…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450112,
						220450113
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220450112,
					"content": "じゃあ直接観察すれば…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450114
					]
				},
				{
					"id": 220450114,
					"content": "いや、俺は…ちょっと照れくさくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450115
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220450115,
					"content": "代理宮司様は俺に給料をくれる雇い主だ、そんな俺が横からじっと観察したら、代理宮司様もきっと良いように思わない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450116
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220450116,
					"content": "君は代理宮司様とも仲が良いだろ、俺の代わりに写真を何枚か撮ってきてくれないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450117,
						220450118
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220450117,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450121
					]
				},
				{
					"id": 220450121,
					"content": "それじゃ頼んだよ、写真を撮ったら、俺のところに持ってきてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220450118,
					"content": "欲しい動作が撮れなかったら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450119
					]
				},
				{
					"id": 220450119,
					"content": "大丈夫、大きな動作は撮らなくてもいい。どうせ今の俺の技術では、ああいう動作を再現することはできないしな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450120
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220450120,
					"content": "代理宮司様の自然としてる姿を撮ってきてくれ。それで十分参考になるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450121
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220450113,
					"content": "寝子はすぐそこにいるけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450114
					]
				},
				{
					"id": 220450107,
					"content": "どんな「生気」を目指してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450108
					]
				}
			]
		},
