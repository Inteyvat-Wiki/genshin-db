							9393.557
						],
						"pointId": 13574
					}
				]
			},
			"dialogs": [
				{
					"id": 760470201,
					"content": "おや、お得意様ではありませんか。今日も投資証券を買いに？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470202
					],
					"speakerTitle": "サビト"
				},
				{
					"id": 760470202,
					"content": "ここの投資証券は詐欺だって聞いたけど？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760470203
					]
				},
				{
					"id": 760470203,
					"content": "おやおや、もしかしてここ最近損失続きだからって、勝手な想像を膨らませてませんか——？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470204
					],
					"speakerTitle": "サビト"
				},
				{
					"id": 760470204,
					"content": "この世に絶対勝てる商売なんてありません。誰かが損をすれば、誰かが儲かる。今思えば、私がスメールシティにいた頃も…コホン、まぁ、ただ最近運が悪いだけでしょう。運というのは予測できないものですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470205
					],
					"speakerTitle": "サビト"
				},
				{
					"id": 760470205,
					"content": "「希望」は辛抱強く耐えてこそ掴めるものです。今後も投資を続ければ、必ず報われる日が来るでしょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470206,
						760470208
					],
					"speakerTitle": "サビト"
				},
				{
					"id": 760470206,
					"content": "分かった。また来る。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760470207
					]
				},
				{
					"id": 760470207,
					"content": "おい、そんな簡単に受け入れるなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760470209,
					"content": "#オイラたちを騙したら、後悔するぞ！オイラたちは…そうだ、オイラたちはかの有名な{NICKNAME}とパイモンだ！ナシャタウンにも、友達がたくさんいるんだからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760470210,
					"content": "「友達」？それが一体…ま、まさか「その手の友達」ですか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470211
					],
					"speakerTitle": "サビト"
				},
				{
					"id": 760470211,
					"content": "…え？そ、そうだぞ！「その手の友達」だ。それもたくさん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760470212,
					"content": "そんな！なんで早く言ってくれなかったんですか…これはまずい、本当にまずい…こちらは全部差し上げます。それに、もう投資証券を売りつけたりもしませんから、この辺で勘弁してください…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "サビト"
				},
				{
					"id": 760470208,
					"content": "もう嘘は通用しないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760470209
					]
				}
			]
		}
	]
}