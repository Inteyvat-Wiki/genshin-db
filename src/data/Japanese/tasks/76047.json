			"dialogs": [
				{
					"id": 760470101,
					"content": "えっと…ずっとここで二人を観察してたんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470102
					],
					"speakerTitle": "ペチーナ"
				},
				{
					"id": 760470102,
					"content": "まさか監視員かなにか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760470103
					]
				},
				{
					"id": 760470103,
					"content": "違う違う。ここにはよく本を探しに来るんだけど、投資に興味を持ってそうな二人をたまたま見かけたから…ここの投資は胡散臭いから、やめといたほうがいいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470104
					],
					"speakerTitle": "ペチーナ"
				},
				{
					"id": 760470104,
					"content": "確かにオイラたち、まだ大きな見返りはもらってないけど…「胡散臭い」ってどういうことだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760470105,
					"content": "大儲けできるわけないと思うんだよね。あの人、まだかなりの借金があるから、損する商売はしないはずだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470106
					],
					"speakerTitle": "ペチーナ"
				},
				{
					"id": 760470106,
					"content": "私の友達も同じような詐欺に遭ったことがあるから、二人も買うのはもうやめたほうがいいと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470107
					],
					"speakerTitle": "ペチーナ"
				},
				{
					"id": 760470107,
					"content": "#本当に詐欺なのか…？{NICKNAME}、あいつをしっかり問いただそうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
