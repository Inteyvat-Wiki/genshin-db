			"dialogs": [
				{
					"id": 740730501,
					"content": "少し前に誰か来てたみたいだな。この先にある変わった装置もすでに解かれてるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740730502,
					"content": "まだ地面で焚き火が燃えてるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740730503,
					"content": "そもそもなんでこんなとこで火を起こしたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740730504,
					"content": "えっと…石碑には何が書いてあるかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740730505,
					"content": "「ここは記憶のぞ…象…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730506
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740730506,
					"content": "象限。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740730507
					]
				},
				{
					"id": 740730507,
					"content": "「…象限。記憶の広間、記憶の間…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730508
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740730508,
					"content": "「一瞬で生まれ」…「何時も相いれず、永遠の眠りにもつきそい、絶対に離れることはない」…「烈火も燃やせぬもの」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730509
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740730509,
					"content": "なぞなぞだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730510
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740730510,
					"content": "答えは火だ！だって、近くに焚き火があったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730511
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740730511,
					"content": "お題に答えと同じ文字を入れたりするかな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740730512
					]
				},
