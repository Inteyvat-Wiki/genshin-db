			"dialogs": [
				{
					"id": 740732101,
					"content": "装置の上の部分を念入りに調べたが、何も見つからなかった。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740732102
					]
				},
				{
					"id": 740732102,
					"content": "結局、ここにはなにもないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740732103,
					"content": "いや…どうやら誰かに持ち去られたようですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732104
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740732104,
					"content": "それってつまり、オイラたちの計画は失敗したってことじゃないのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740732105,
					"content": "「理性」を誕生させるには四つの象限を一つにしなければなりません。残りのいくつかをゲットできれば、ボクたちにもまだチャンスはありますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732106
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740732106,
					"content": "だったらあたしたち、早く次の場所に行かなくちゃね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アン"
				}
			]
		},
