			"dialogs": [
				{
					"id": 740732201,
					"content": "装置の上の部分を念入りに調べたが、何も見つからなかった。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740732202
					]
				},
				{
					"id": 740732202,
					"content": "ここも、なんにもないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740732203,
					"content": "キャタピラー、あたしたちは何を探してるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732204
					],
					"speakerTitle": "アン"
				},
				{
					"id": 740732204,
					"content": "水仙十字聖剣を作る材料を探しているんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732205
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740732205,
					"content": "水仙十字結社は地下の国と古代フォンテーヌの神秘主義哲学によって、物質世界に必要な四種類の架空物質を再現しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732206
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740732206,
					"content": "理解できません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732207
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 740732207,
					"content": "神秘的なものはそもそも、体験によってのみ作用するんです。元素力以上に、普通の枠にはまらないものだとも言えます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732208
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740732208,
					"content": "数十年前、私は教令院素論派の入門から中級教材を記録しましたが、元素力はさほど神秘的なものではありませんでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732209
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 740732209,
					"content": "そうですか。とにかく結論から言えば、フォンテーヌに伝わる古来からの手法と地下の古国の技術の結晶というわけです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732210
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740732210,
					"content": "そうして世界には「記憶」、「願い」、「霊魂」、「人格」という四種の物{RUBY#[D]サブスタンス}質が現れました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732211
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740732211,
					"content": "複数の解釈を避けるため、「記憶」「願い」「霊魂」「人格」にそれぞれピースを分けて考えましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732212
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740732212,
					"content": "どうしてそんなもので聖剣を作るんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740732213,
					"content": "水仙十字結社の神秘主義哲学では、神殿は宇宙の縮図であり、メンバーは神々の代行者であり、聖油は鍛え抜かれた意志ですからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732214
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740732214,
					"content": "そして聖剣はすべてを切り開く「理性」です。これは完璧なる人の意志から生まれる必要があります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732215
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740732215,
					"content": "うさんくさいな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740732216
					]
				},
				{
					"id": 740732216,
					"content": "まあまあ、神秘主義哲学とはこういうものですよ。類似性のあるものは何でも取り入れて、それが魔法になった暁には、すべての偽りが真実に変わるんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732217
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740732217,
					"content": "とにかく、次のところへ急ぎましょうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キャタピラー"
				}
			]
		},
