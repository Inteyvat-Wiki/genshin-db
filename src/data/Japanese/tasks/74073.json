					"nextDialogs": [
						740732302
					]
				},
				{
					"id": 740732302,
					"content": "ここのものも…持って行かれちゃってるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740732303,
					"content": "そのようですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732304
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740732304,
					"content": "一体誰が…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740732305
					]
				},
				{
					"id": 740732305,
					"content": "ジェイコブでしょうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732306
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740732306,
					"content": "エリナスで、私たちはジェイコブと衝突を起こしました。補足：これは比較的最近起こったほうの「エリナス」事件です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732307
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 740732307,
					"content": "扉のところにいた悲劇の被害者を見たとき、彼だと分かりました。案の定、まだ動いていたようですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732308
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740732308,
					"content": "ジェイコブはここのものを持ち去って、一体なにをするつもりなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740732309,
					"content": "簡単なことです——あちらも水仙十字の聖剣を作り直そうとしているんでしょう。水仙十字結社の使命はまだ終わっていませんからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732310
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740732310,
					"content": "さて、ボクたちも最後の一箇所に急ぎましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キャタピラー"
				}
			]
		},
