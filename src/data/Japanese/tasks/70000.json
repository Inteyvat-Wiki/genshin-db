			"trigger": {
				"objectNames": [
					"サイード"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700000101,
					"content": "ロマンのある風習だね。これこそ研究に値する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000102
					],
					"speakerTitle": "サイード"
				},
				{
					"id": 700000102,
					"content": "なにしてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000103
					]
				},
				{
					"id": 700000103,
					"content": "旅人、君もモンドのロマンに興味が湧いて、この図書館に来たのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000104
					],
					"speakerTitle": "サイード"
				},
				{
					"id": 700000104,
					"content": "でも、文字の記録ならいつでも読めるけど、身の回りに起きた歴史は注意を払わないと逃してしまう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000105
					],
					"speakerTitle": "サイード"
				},
				{
					"id": 700000105,
					"content": "風花祭というロマン溢れる祭りで、モンド人の風習が数々見られる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000106
					],
					"speakerTitle": "サイード"
				},
				{
					"id": 700000106,
					"content": "その風習がどのようなものか、背後の歴史はどうなっているのか。絶好の研究対象といえるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000107
					],
					"speakerTitle": "サイード"
				},
				{
					"id": 700000107,
					"content": "いま研究報告を書いているのだが、文字だけではだめだ。悪いが、風花祭の風景を撮ってきてくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000108,
						700000110
					],
					"speakerTitle": "サイード"
				},
				{
					"id": 700000108,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000109
					]
				},
				{
					"id": 700000109,
					"content": "学術の手助け、感謝するよ。旅人、報告書には君の名前も載せておく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000113
					],
					"speakerTitle": "サイード"
				},
				{
					"id": 700000113,
					"content": "<color=#00E1FFFF>噴水広場の上空にある花飾り</color>、<color=#00E1FFFF>大聖堂前の花に飾られた神像</color>、それと<color=#00E1FFFF>忙しい花屋の店主</color>。みな記録に値するものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000115
					],
					"speakerTitle": "サイード"
				},
				{
					"id": 700000115,
					"content": "これらの風景を記録してくれ。撮った写真を渡してくれればいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "サイード"
				},
				{
					"id": 700000110,
					"content": "自分でやった方がいい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000111
					]
				},
				{
					"id": 700000111,
					"content": "いや、私はいま離れられないんだ。やっと大まかな考えを思いついてね、いまここを離れると思考が乱れてしまう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000112
					],
					"speakerTitle": "サイード"
				},
				{
					"id": 700000112,
					"content": "だから頼むよ、旅人。それほど多くないけど報酬も用意するつもりだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000113
					],
					"speakerTitle": "サイード"
				}
			]
		},
