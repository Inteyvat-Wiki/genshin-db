					"サイード"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700000601,
					"content": "写真は撮れたかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000602
					],
					"speakerTitle": "サイード"
				},
				{
					"id": 700000602,
					"content": "全部撮れた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000603
					]
				},
				{
					"id": 700000603,
					"content": "すごくいい出来だ。きっと研究に使えるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000604
					],
					"speakerTitle": "サイード"
				},
				{
					"id": 700000604,
					"content": "この美しい風景を見ると…故郷のスメールの祭りを思い出す…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000605
					],
					"speakerTitle": "サイード"
				},
				{
					"id": 700000605,
					"content": "スメールにはどんな祭りが？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000606
					]
				},
				{
					"id": 700000606,
					"content": "そうか、君は知らなかったな。私たちは毎年「花神祭り」を開催して、「クラクサナリデビ」の誕生を祝う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000607
					],
					"speakerTitle": "サイード"
				},
				{
					"id": 700000607,
					"content": "でも雰囲気に関しては、モンド城の風花祭と結構違う…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000608
					],
					"speakerTitle": "サイード"
				},
				{
					"id": 700000608,
					"content": "そういえば…今年の花神祭りには参加できなかった。もう長いこと離れてるからな…教令院は今どうなったのだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000609
					],
					"speakerTitle": "サイード"
				},
				{
					"id": 700000609,
					"content": "話がそれたな。手伝ってくれてありがとう、報酬を受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "サイード"
				}
			]
		}
	]
