	"talks": [
		{
			"id": 7604901,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7604901",
							"2"
						],
						"stepId": 7604901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「少女」"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2130.918,
							108.955,
							11206.71
						],
						"pointId": 360300003
					}
				]
			},
			"dialogs": [
				{
					"id": 760490101,
					"content": "…ちょっとピッチが高いかも。もう一回やってみて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490102
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490102,
					"content": "よっ、コロンビーナ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760490103,
					"content": "あれ？もしかして…月霊に楽器を教えてるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760490104,
					"content": "うん。この前修理してもらった後、毎日嬉しそうにせがんでくるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490105
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490105,
					"content": "でも、実は私もあんまりうまく弾けないの。ほかの人が弾いてるところを見てただけだから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490106
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490106,
					"content": "ま、でもそんなイメージだよな。コロンビーナが楽隊にいたとしたら、歌を唄ってるとこしか想像できないぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760490107,
					"content": "楽器なら、こいつが結構得意だぞ！モンドの「ライアー」もナタの「ジャンベ」もお任せだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490108,
						760490109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760490108,
					"content": "いやいや…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490110
					]
				},
				{
					"id": 760490110,
					"content": "そう？じゃあ…キミがこの子たちに教えてみて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490111,
						760490112
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490111,
					"content": "じゃあ、ちょっとだけ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490113
					]
				},
				{
					"id": 760490113,
					"content": "今は最近私がいつも歌ってる曲を練習してるの。メロディは覚えてる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490114
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490114,
					"content": "それか…キミの得意な曲でもいいよ。この子たちにほかの国の曲を聴かせてあげられる機会はあんまりないし、私も聴いてみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490115
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490115,
					"content": "（何を弾こう…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490202,
						760490801
					]
				},
				{
					"id": 760490202,
					"content": "コロンビーナがよく口ずさんでたあの歌…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490201
					]
				},
				{
					"id": 760490201,
					"content": "（どんな感情を込めて弾こう…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490603,
						760490701
					]
				},
				{
					"id": 760490603,
					"content": "穏やかな曲調…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490604
					]
				},
				{
					"id": 760490604,
					"content": "素敵。私がよく歌ってるメロディ、覚えてくれたんだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490605
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490605,
					"content": "へへっ、おまえの歌は上手だからな。たまにこっそり聴いてるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490606
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760490606,
					"content": "月霊もうっとりしてるみたい。ちゃんとお手本を覚えてくれたかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490607
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490607,
					"content": "また教えてもらうかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490608
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490608,
					"content": "手を出して。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490609
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490609,
					"content": "えっ？オイラたちボランティアでやってるから、授業料はいらないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490610
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760490610,
					"content": "授業料？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490611
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490611,
					"content": "私はただ、きれいなメロディには美しい月光が合うって思っただけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490701,
					"content": "楽しい曲調…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490702
					]
				},
				{
					"id": 760490702,
					"content": "もう終わっちゃったの？まだまだ聴いてたい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490703
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490703,
					"content": "これは私が唯一覚えてる「子守唄」だっていうのは、前に言ったよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490704
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490704,
					"content": "唄に込められた意味はわからないけど…キミの演奏を聴いてると、月の上で私を待ってる答えは、少なくとも素敵なものだって感じられた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490705
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490705,
					"content": "手を出して。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490706
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490706,
					"content": "見返りなんていらないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490707
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760490707,
					"content": "ううん、このメロディに美しい月明かりを添えたいだけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490801,
					"content": "異国の曲を演奏する…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490802
					]
				},
				{
					"id": 760490802,
					"content": "不思議な感じ。昔、たまにこんな感じのメロディを聞いてたけど…キミが弾くとまた違った感じがする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490803
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490803,
					"content": "旅人のこの国に対する感情がこもってるからじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490804
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760490804,
					"content": "不思議だね。曲調から風景が想像できる…実際は、私の想像とどれくらい違うんだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490805
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490805,
					"content": "見たいのか？オイラたちがガイドしてやるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490806
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760490806,
					"content": "うん…いつかその日が来たら、お願い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490112,
					"content": "何を弾こう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490113
					]
				},
				{
					"id": 760490109,
					"content": "ちょっとできるだけだよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490110
					]
				}
			]
		},
