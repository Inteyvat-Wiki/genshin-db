				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790221101,
					"content": "そうだ…そういえば、この島で懐中時計を拾ったよな。その懐中時計の中にあった写真のことなんじゃないか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790221102,
					"content": "懐中時計を見せてみる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7902212,
			"completionStepIds": [
				7902213
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7902213",
							"2"
						],
						"stepId": 7902213,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アガフィア"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790221201,
					"content": "あっ…それ私の。中に、兄さんたちとの写真が入ってるの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221202
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790221202,
					"content": "取り戻せてよかった…一体どこで落としたんだろう…うっ、頭が…痛い…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221203
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790221203,
					"content": "ヒルチャールの拠点の近くで見つけたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790221204,
					"content": "本当に、ありがとう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221205
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790221205,
					"content": "#あっ！あなたたち、内部資料に載ってた…金髪の{M#少年}{F#少女}と空飛ぶ小さいの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221206
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790221206,
					"content": "「パイモン」だ！…はぁ、いっそのこと、「空飛ぶ小さいの」に名前を変えようかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790221207,
					"content": "あなたたち、私に何をしたの？記憶…記憶に繋がりがない。まさか、私に変な実験を！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221208
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790221208,
					"content": "お互いの立場が異なるにしても…こんなこと許されるわけない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221209
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790221209,
					"content": "変な実験をしてたのは、おまえらだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790221210,
					"content": "写真を返してやった恩人に、よくそんなこと言えるな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790221211,
					"content": "…そ、そうだったの。でも、私が正気に戻ったってことは…ペルシーコフ研究員の実験は失敗したってことね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221212
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790221212,
					"content": "あなたたちを見て、失敗した原因も分かったわ…はぁ…私たち敵同士なのに写真を返してくれるなんて、いくらなんでも親切すぎない…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221213
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790221213,
					"content": "相手の大切なもの…例えば私の場合、懐中時計の中の写真をエサに情報を聞き出すのが、正しいやり方じゃない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221214
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790221214,
					"content": "なんで、オイラたち逆に責められてるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221215,
						790221217
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790221215,
					"content": "それはさすがに非道なやり方だと思う…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790221216
					]
				},
				{
					"id": 790221216,
					"content": "…確かに非道なやり方だけど、ファデュイに入ってからはそう教えられてきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221219
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790221219,
					"content": "ところで、おまえらここでなにをするつもりだったんだ。さっそく吐いてもらうぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221220
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790221220,
					"content": "わ…私たち、みんなでこの島に来て…そうだ、ザハール！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221221
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790221221,
					"content": "彼が一人でまだあそこに…早く戻らないと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221222
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790221222,
					"content": "何かを思い出したのか、目覚めたばかりのファデュイはその場を離れた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 790221217,
					"content": "今度やってみよう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790221218
					]
				},
				{
					"id": 790221218,
					"content": "こんなこと学ばなくていいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221219
					],
					"speakerTitle": "パイモン"
				}
			]
		},
