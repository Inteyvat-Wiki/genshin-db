					"ザハール"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790222301,
					"content": "ザハール、ザハール…大丈夫？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222302
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790222302,
					"content": "アガシャ、どうかしたか…？俺はここで少し寝てただけだぞ。体のほうもだいぶよくなってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222303
					],
					"speakerTitle": "ザハール"
				},
				{
					"id": 790222303,
					"content": "はぁ…無事でよかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222304
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790222304,
					"content": "ははっ。そうだ、アガシャ。この前くれた果実だが、四つともまだ食べてないんだ。お前が戻ってから食べようと思ってな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222305
					],
					"speakerTitle": "ザハール"
				},
				{
					"id": 790222305,
					"content": "まったく、あれはあなたのために採ってきたリンゴなんだから…お腹が空いたらちゃんと食べてくれないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222306
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790222306,
					"content": "でも、お前は一人で任務を遂行してるんだし、俺なんかよりずっと大変だろ…お腹は空いてるが、そんくらい俺だって我慢できる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222307
					],
					"speakerTitle": "ザハール"
				},
				{
					"id": 790222307,
					"content": "へぇ？一人で任務…？なんの任務だろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790222308,
					"content": "ああ、ヤコヴが危うく設備を壊してしまうところでな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222309
					],
					"speakerTitle": "ザハール"
				},
				{
					"id": 790222309,
					"content": "ザハール！それ以上は言っちゃダメ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222310
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790222310,
					"content": "#あっ！？お前ら、内部資料に載ってた{NICKNAME}と…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222311
					],
					"speakerTitle": "ザハール"
				},
				{
					"id": 790222311,
					"content": "「空飛ぶ小さいの」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790222312
					]
				},
				{
					"id": 790222312,
					"content": "そう、「空飛ぶ小さいの」だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222313
					],
					"speakerTitle": "ザハール"
				},
				{
					"id": 790222313,
					"content": "もう説明するのも飽きてきたぞ。オイラはパイモンだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222314
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790222314,
					"content": "へへっ、俺、あんま頭が良くなくってさ。俺はザハール…ん、待てよ、俺たちファデュイとお前らって…敵同士じゃないか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222315
					],
					"speakerTitle": "ザハール"
				},
				{
					"id": 790222315,
					"content": "アガフィア、お前が敵をここに連れてきたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222316
					],
					"speakerTitle": "ザハール"
				},
				{
					"id": 790222316,
					"content": "ええ、この二人はあなたをいばらから救い出した親切な人…コホンッ、親切な敵なの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222317
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790222317,
					"content": "ああ、そうだった。お前が離れた後、巨大ないばらが突然現れてな、洞窟を塞いじまったんだよ…お前らがあの巨大ないばらを片付けたのか？すげぇじゃねぇか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222318
					],
					"speakerTitle": "ザハール"
				},
				{
					"id": 790222318,
					"content": "その通り！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222319
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790222319,
					"content": "でも、俺たち敵同士だよな？なんで敵を助けるような真似をしたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222320
					],
					"speakerTitle": "ザハール"
				},
				{
					"id": 790222320,
					"content": "えーっと、答えづらい質問だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222321
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790222321,
					"content": "おまえを助けたら、おまえらがここでなにをするつもりなのか、こいつに教えてもらう約束をしてたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222322
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790222322,
					"content": "アガシャ、お前…情報を売るつもりなのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222323
					],
					"speakerTitle": "ザハール"
				},
				{
					"id": 790222323,
					"content": "大丈夫よ、ザハール。「ファデュイはこの海域で謎のグッピーを狩ってる」みたいなことを言っとけば、誤魔化せるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222324
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790222324,
					"content": "うわぁ、あからさまに誤魔化そうとするなんて、オイラたちなめられてるみたいだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222325
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790222325,
					"content": "ほら、いばらも片付けてやったし、ザハールも救出したんだ。そろそろおまえらの目的を話してもらうぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222326
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790222326,
					"content": "言うんじゃないぞ、アガフィア。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222327
					],
					"speakerTitle": "ザハール"
				},
				{
					"id": 790222327,
					"content": "はぁ、話さないとダメそうね…けど正直に言うと、私たちにもよく分からないの。私たちはただ、テストをしに来ただけだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222328,
						790222329
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790222328,
					"content": "テスト？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790222330
					]
				},
				{
					"id": 790222330,
					"content": "信号テスト、かな…具体的なことは私も知らない。でも、もう一組のチームの人たちなら、何か知ってるかもね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222331
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790222331,
					"content": "ああ、そいつらは色々と白状してくれたぜ。でも、なんでおまえらはそれしか情報を持ってないんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222332
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790222332,
					"content": "私も細かいことは知らないんだってば…それより、情報も話したんだし、もう見逃してくれない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222333
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790222333,
					"content": "おまえらを見逃すなんて約束してないと思うけど…まあ、危険なやつらじゃなさそうだし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222334
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790222334,
					"content": "大目に見てあげよう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790222335
					]
				},
				{
					"id": 790222335,
					"content": "あら、それはありがと。はぁ、他の二つの島に行ったもう一組の人たちはどうしてるかな。任務が完了したら、海域の真ん中にある拠点に戻るって約束したのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222336
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790222336,
					"content": "うん？それって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222337
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790222337,
					"content": "このまえ会ったファデュイのことだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790222338
					]
				},
				{
					"id": 790222338,
					"content": "もう会ってたの？いけない…ザハール、はやく拠点に戻りましょう。前に話した待ち合わせ場所に行かないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790222329,
					"content": "何のテスト？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790222330
					]
				}
			]
		},
