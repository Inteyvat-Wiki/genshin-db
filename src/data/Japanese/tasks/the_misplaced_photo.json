					"アガフィア"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790220101,
					"content": "どうして、ここにファデュイがいるんだ？このミラーメイデン…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790220102,
					"content": "こいつら、ここでまた悪いことを企んでるのかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790220103,
					"content": "…早く戻らないと…彼はまだあそこに…でも、兄さんたちがいない。兄さんたちの写真が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220104
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790220104,
					"content": "おい、おまえ何者だ？ここでなにか悪いことを企んでるんだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790220105,
					"content": "兄さんたちの写真が…写真を失くしたまま、帰れない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220106
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790220106,
					"content": "聞いてるのか、そこのファデュイ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790220107,
					"content": "彼を一人残して、見捨てるわけには…いかない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220108,
						790220109
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790220108,
					"content": "様子が少しおかしい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790220110
					]
				},
				{
					"id": 790220110,
					"content": "うーん…ちょっと気になったんだけど、どうしてミラーメイデンが一人でここにいるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790220111,
					"content": "#{NICKNAME}、こいつを正気に戻して、外をうろついてるファデュイがなにをしてるのか聞き出してみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790220112,
					"content": "確かに放っておけない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790220113
					]
				},
				{
					"id": 790220113,
					"content": "ああ、変わったファデュイだけど…放っておくのも気が引けるしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790220114,
					"content": "でも、どうしてこんな風になっちゃったんだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790220115,
					"content": "あの装置のせいかもしれない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790220116
					]
				},
				{
					"id": 790220116,
					"content": "あっ、そっか。あの装置が島のすべてに影響を与えたんだもんな…けど、もう止めたはずなのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790220117,
					"content": "兄さんたちとの写真…あれを見つけないと帰れない。けど…彼はまだあそこで…一人、私を待っている…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220118
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790220118,
					"content": "#あっ、いいこと思いついたぞ…{NICKNAME}、こいつの大切な写真を探してあげようぜ。そうすれば、正気に戻るかもしれない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790220109,
					"content": "会話がままならない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790220110
					]
				}
			]
		},
		{
			"id": 7902206,
