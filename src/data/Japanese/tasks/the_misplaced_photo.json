			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"アガフィア"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790220701,
					"content": "#{NICKNAME}、このミラーメイデン…なんか変じゃないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220702
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790220702,
					"content": "…早く戻らないと…彼はまだあそこに…でも、兄さんたちがいない。兄さんたちの写真が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220703
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790220703,
					"content": "おい、ファデュイの人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220704
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790220704,
					"content": "兄さんたちの写真が…写真を失くしたまま、帰れない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220705
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790220705,
					"content": "聞いてるのか、そこのファデュイ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220706
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790220706,
					"content": "彼を一人残して、見捨てるわけには…いかない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220707,
						790220708
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790220707,
					"content": "様子が少しおかしい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790220709
					]
				},
				{
					"id": 790220709,
					"content": "なんだか既視感があるような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220710
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790220710,
					"content": "この前のファデュイ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790220711
					]
				},
				{
					"id": 790220711,
					"content": "そうだ、エフカに会った時もあいつずっと「記章、記章…」ってぶつぶつ呟いてたよな。そんで、記章をあげたらすぐ正気に戻った…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220712
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790220712,
					"content": "ファデュイがここで行った実験は、味方にまで影響を及ぼしたってことだろうな。まさに「悪には悪の報い」ってやつだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220713
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790220713,
					"content": "パイモンの言う通り！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790220714
					]
				},
				{
					"id": 790220714,
					"content": "もしかしてこのミラーメイデン、エフカが言ってたチームのメンバーなんじゃないか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220715
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790220715,
					"content": "同じようになにかを探してやらないと、正気に戻らないかもしれないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220716
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790220716,
					"content": "兄さんたちとの写真…あれを見つけないと帰れない。けど…彼はまだあそこで…一人、私を待っている…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220717
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790220717,
					"content": "#なるほどな…{NICKNAME}、こいつの大切な写真が見つかれば、正気に戻りそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790220708,
					"content": "会話がままならない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790220709
					]
				}
			]
		},
		{
			"id": 7902208,
			"completionStepIds": [
				7902208
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_A_AND_ETCOR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7902208",
