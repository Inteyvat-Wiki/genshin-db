						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アガフィア",
					"ザハール"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790220801,
					"content": "ザハール、ザハール…大丈夫？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220802
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790220802,
					"content": "アガシャ、どうかしたか…？俺はここで少し寝てただけだぞ。体のほうもだいぶよくなってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220803
					],
					"speakerTitle": "ザハール"
				},
				{
					"id": 790220803,
					"content": "はぁ…無事でよかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220804
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790220804,
					"content": "ははっ。そうだ、アガシャ。この前くれた果実だが、四つともまだ食べてないんだ。お前が戻ってから食べようと思ってな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220805
					],
					"speakerTitle": "ザハール"
				},
				{
					"id": 790220805,
					"content": "まったく、あれはあなたのために採ってきたリンゴなんだから…お腹が空いたらちゃんと食べてくれないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220806
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790220806,
					"content": "でも、お前は一人で任務を遂行してるんだし、俺なんかよりずっと大変だろ…お腹は空いてるが、そんくらい俺だって我慢できる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220807
					],
					"speakerTitle": "ザハール"
				},
				{
					"id": 790220807,
					"content": "へぇ？一人で任務…？なんの任務だろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220808
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790220808,
					"content": "ああ、ヤコヴが危うく設備を壊してしまうところでな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220809
					],
					"speakerTitle": "ザハール"
				},
				{
					"id": 790220809,
					"content": "ザハール！それ以上は言っちゃダメ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220810
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790220810,
					"content": "#あっ！？お前ら、内部資料に載ってた{NICKNAME}と…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220811
					],
					"speakerTitle": "ザハール"
				},
				{
					"id": 790220811,
					"content": "「空飛ぶ小さいの」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790220812
					]
				},
				{
					"id": 790220812,
					"content": "そう、「空飛ぶ小さいの」だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220813
					],
					"speakerTitle": "ザハール"
				},
				{
					"id": 790220813,
					"content": "もう説明するのも飽きてきたぞ。オイラはパイモンだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220814
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790220814,
					"content": "へへっ、俺、あんま頭が良くなくってさ。俺はザハール…ん、待てよ、俺たちファデュイとお前らって…敵同士じゃないか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220815
					],
					"speakerTitle": "ザハール"
				},
				{
					"id": 790220815,
					"content": "アガフィア、お前が敵をここに連れてきたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220816
					],
					"speakerTitle": "ザハール"
				},
				{
					"id": 790220816,
					"content": "ええ、この二人はあなたをいばらから救い出した親切な人…コホンッ、親切な敵なの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220817
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790220817,
					"content": "ああ、そうだった。お前が離れた後、巨大ないばらが突然現れてな、洞窟を塞いじまったんだよ…お前らがあの巨大ないばらを片付けたのか？すげぇじゃねぇか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220818
					],
					"speakerTitle": "ザハール"
				},
				{
					"id": 790220818,
					"content": "その通り！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220819
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790220819,
					"content": "でも、俺たち敵同士だよな？なんで敵を助けるような真似をしたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220820
					],
					"speakerTitle": "ザハール"
				},
				{
					"id": 790220820,
					"content": "えーっと、答えづらい質問だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220821
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790220821,
					"content": "おまえを助けたら、おまえらがここでなにをするつもりなのか、こいつに教えてもらう約束をしてたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220822
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790220822,
					"content": "アガフィア、お前…情報を売るつもりか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220823
					],
					"speakerTitle": "ザハール"
				},
				{
					"id": 790220823,
					"content": "大丈夫よ、ザハール。「ファデュイはこの海域で謎のグッピーを狩ってる」みたいなことを言っとけば、誤魔化せるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220824
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790220824,
					"content": "うわぁ、あからさまに誤魔化そうとするなんて、オイラたちなめられてるみたいだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220825
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790220825,
					"content": "ほら、いばらも片付けてやったし、ザハールも救出したんだ。そろそろおまえらの目的を話してもらうぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220826
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790220826,
					"content": "言うんじゃないぞ、アガフィア。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220827
					],
					"speakerTitle": "ザハール"
				},
				{
					"id": 790220827,
					"content": "はぁ、話さないとダメそうね…けど正直に言うと、私たちにもよく分からないの。私たちはただ、テストをしに来ただけだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220828,
						790220829
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790220828,
					"content": "テスト？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790220830
					]
				},
				{
					"id": 790220830,
					"content": "信号テスト、かな…具体的なことは私も知らない。でも、もう一組のチームの人たちなら、何か知ってるかもね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220831
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790220831,
					"content": "うぅ、情報はそれだけかよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220832
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790220832,
					"content": "私も細かいことは知らないんだってば…それより、情報も話したんだし、もう見逃してくれない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220833
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790220833,
					"content": "おまえらを見逃すなんて約束してないと思うけど…まあ、危険なやつらじゃなさそうだし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220834
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790220834,
					"content": "大目に見てあげよう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790220835
					]
				},
				{
					"id": 790220835,
					"content": "あら、それはありがと。はぁ、<color=#00E1FFFF>もう一組の人たち</color>はどうしてるかな。任務が完了したら、海域の真ん中にある拠点に戻るって約束したのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220836
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790220836,
					"content": "もう一組？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220837
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790220837,
					"content": "ええ、向こうも二人組でね。<color=#00E1FFFF>南にある二つの島</color>のほうへ向かったんだけど…あっ、これはサービス！決して口車に乗せられたわけじゃないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220838
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790220838,
					"content": "南方向の島…あっ、ハラハラ島か！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220839
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790220839,
					"content": "話はここまで。早く海域の真ん中にある島へ行って、拠点に戻らないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790220829,
					"content": "何のテスト？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790220830
					]
				}
			]
		},
