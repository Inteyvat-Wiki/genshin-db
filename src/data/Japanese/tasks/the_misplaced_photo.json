			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アガフィア"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790220601,
					"content": "ザハール！ザハール！聞こえる！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220602
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790220602,
					"content": "ここは一体…？私たちが初めて来た時、ここはただの洞窟だったのに…このいばらはどういうこと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220603
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790220603,
					"content": "ああ、これはおまえらのなんとか幻境実験のせいでこうなっちゃったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790220604,
					"content": "この島には似たようないばらがたくさんあるぞ。でも、ある方法を使えば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220605
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790220605,
					"content": "火をつけるの？まさかあなたたち、いばらを燃やすんじゃないでしょうね！？それはダメ、中にまだ人がいるの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220606
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790220606,
					"content": "#{NICKNAME}とパイモンは非常に危険な相手だと、私も聞いてはいた。公務に向かう途中、突然襲われたって声も…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220607
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790220607,
					"content": "でも、火を放って人をじわじわ焼き殺そうとするなんて、一番冷酷なデットエージェントだって、あなたたちの非情さには敵わない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220608
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790220608,
					"content": "おい、そんなんじゃないって…それに、このいばらは火をつけても無駄なんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220609
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790220609,
					"content": "オイラたち、中の人を傷つけることなく、いばらを片付ける方法を知ってるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220610
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790220610,
					"content": "本当なの？あなたたちにそんなことが出来るなんて、信じられないんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220611
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790220611,
					"content": "#なんだと！？{NICKNAME}、早くこのいばらを片付けるところを見せてやろうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220612,
						790220613
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790220612,
					"content": "口車に乗せられてるよ、パイモン…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790220614
					]
				},
				{
					"id": 790220614,
					"content": "へっ…このぉ、よくもオイラを騙したな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220615
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790220615,
					"content": "見抜かれちゃうなんて、とっても残念。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220616
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790220616,
					"content": "ふん、ずる賢いファデュイめ。危うくおまえの策にはまるところだったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220617
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790220617,
					"content": "騙されたのはパイモンだけ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790220618
					]
				},
				{
					"id": 790220618,
					"content": "と…とにかく、オイラたちは中に囚われた人を救い出せるんだ。でもその代わり、おまえが知ってる情報を話してもらうからな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220619
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790220619,
					"content": "これぞ、人の大切なものを利用して、情報を聞き出す方法だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220620
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790220620,
					"content": "まったく、非道なやり方ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220621
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790220621,
					"content": "確かに非道…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790220622
					]
				},
				{
					"id": 790220622,
					"content": "おい、こいつはともかく、なんでおまえまでオイラを責めるんだよ、味方だろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220623
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790220623,
					"content": "…情報ね。アガフィア、それが私の名前よ。今あげられる情報はこれくらいしかないかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220624
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790220624,
					"content": "名前だけかよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220625
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790220625,
					"content": "もし重要な情報を言ったりしたら、あなたたちは「そうか、ならばおまえはもう用済みだ…」なんて言って、私を始末するに決まってるでしょ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220626
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790220626,
					"content": "ファデュイの教官も、こういう事件が毎年多発してるから、重要な情報は軽々しく漏らしてはいけないって言ってたもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220627
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790220627,
					"content": "そんなことしないぞ！というか、おまえらの教官って、なんだか変な感じがするな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220628
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790220628,
					"content": "そう？…普通だと思うけど。とにかく、私は今一人だし、逃げることもできない。あなたたちは簡単に私を始末できるでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220629
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790220629,
					"content": "#うーん…なんだか悔しいけど、まあしょうがないか。{NICKNAME}、洞窟の入り口を塞いでるいばらを片付けようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790220613,
					"content": "見え見えの挑発に乗らないで…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790220614
					]
				}
			]
		},
		{
			"id": 7902207,
			"completionStepIds": [
				7902201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
