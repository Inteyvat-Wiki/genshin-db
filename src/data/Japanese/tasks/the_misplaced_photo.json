			"dialogs": [
				{
					"id": 790221801,
					"content": "ああ…ザハール、どうか無事で…ん？どうしたの？いばらで塞がれた入り口はまだ開けられないの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221802,
						790221804,
						790221807,
						790221809
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790221802,
					"content": "ここへは何しに来たの…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790221803
					]
				},
				{
					"id": 790221803,
					"content": "ただ使いっ走りをさせられてただけ。話はおしまい、何を聞かれても答えないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790221804,
					"content": "ザハールって誰？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790221805
					]
				},
				{
					"id": 790221805,
					"content": "ザハールは私の仲間。ちょっと体調が優れないみたいだから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221806
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790221806,
					"content": "無事か心配で…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790221807,
					"content": "懐中時計の中にあった写真について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790221808
					]
				},
				{
					"id": 790221808,
					"content": "ダメよ、あれはファデュイと関係ないものだから答えないわ。探し出してくれたことには感謝してるけど、言えないものは言えないの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790221809,
					"content": "さよなら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
