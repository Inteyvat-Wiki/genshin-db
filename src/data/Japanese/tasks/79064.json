			"dialogs": [
				{
					"id": 790640801,
					"content": "ここは警備本部だ。きちんと話を通せば、巨大衛兵の警戒を解除できるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640802
					],
					"speakerTitle": "オービック",
					"speakerSubtitle": "青の監督者"
				},
				{
					"id": 790640802,
					"content": "こんにちはー…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790640803
					]
				},
				{
					"id": 790640803,
					"content": "何だ？いま親友の写真を見ながら、昔のことを思い出してるところなんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640804
					],
					"speakerTitle": "ノックする"
				},
				{
					"id": 790640804,
					"content": "この声は、ウィンストンか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640805
					],
					"speakerTitle": "オービック",
					"speakerSubtitle": "青の監督者"
				},
				{
					"id": 790640805,
					"content": "ふん、ついに観念して帰ってきたか。お前の親友は俺しかいないと言ったのに、なぜ余所の二人とつるんで任務を受けた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640806
					],
					"speakerTitle": "ノックする"
				},
				{
					"id": 790640806,
					"content": "あの時、お前は無邪気にこう言った。「きっと彼らとはいい友達になれるよ！」と。結局、最後までお前を待っていたのは俺だけだ。俺だけがお前の親友だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640807
					],
					"speakerTitle": "ノックする"
				},
				{
					"id": 790640807,
					"content": "#実は…その二人だけじゃなく、今は{NICKNAME}侯爵とその仲間たちも一緒に来ているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640808
					],
					"speakerTitle": "オービック",
					"speakerSubtitle": "青の監督者"
				},
				{
					"id": 790640808,
					"content": "…まさか、俺に隠れて外で友達を作ったのか？立派になったもんだな、オービック。もういい、出て行け、二度と会いたくない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640809
					],
					"speakerTitle": "ノックする"
				},
				{
					"id": 790640809,
					"content": "いや、違うんだ。警戒態勢を解除して欲しいんだよ。重要人物を連れて帰ってきたんだ。今こそ聖地の謎を解くことができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640810
					],
					"speakerTitle": "オービック",
					"speakerSubtitle": "青の監督者"
				},
				{
					"id": 790640810,
					"content": "出て行け！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640811
					],
					"speakerTitle": "ノックする"
				},
				{
					"id": 790640811,
