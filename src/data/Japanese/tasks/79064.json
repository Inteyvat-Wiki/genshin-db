			"dialogs": [
				{
					"id": 790640601,
					"content": "いたぞ、不審者だ！いったいどんな法を犯したのかは知らんが、今は最高警戒態勢だ。さあ来い、観念するんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640602
					],
					"speakerTitle": "巨大衛兵"
				},
				{
					"id": 790640602,
					"content": "あなたたちは散り散りになって逃げた。カペーが「みんな上手くやれよ！」と叫ぶ。\\n衛兵を振り切った後、あなたたちは再び元の場所に集合した。幸い、誰も捕まってはいないようだ…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						790640603
					]
				},
				{
					"id": 790640603,
					"content": "再挑戦だ。",
