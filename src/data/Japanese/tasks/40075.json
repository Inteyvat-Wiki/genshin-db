			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"辛炎",
					"モナ",
					"楓原万葉",
					"フィッシュル",
					"オズ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400750801,
					"content": "わっ、また出てきたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750802
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400750802,
					"content": "モナ、その冒険者は…本当に死んじまったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750803
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400750803,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750804
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400750804,
					"content": "私は彼に一度しか会っていません。あれからもう、三年あまり過ぎているので…もうこの世にはいないでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750805
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400750805,
					"content": "でも、その人がまだ生きていて、おまえの勘違いだったって可能性はないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750806
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400750806,
					"content": "それは都合の良すぎる考え。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400750807
					]
				},
				{
					"id": 400750807,
					"content": "悪いことになると全否定し、良いことになると信じて疑わない。そんなのは占いではなく、ただの自己満足と言ったほうが正しいでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750808
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400750808,
					"content": "日々の娯楽であればいいのですが、私が学んでいるのは嘘偽りのない学問。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750809
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400750809,
					"content": "自らが導き出した結論を否定することは、占星術を冒涜するのと同じです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750810
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400750810,
					"content": "残酷だが、真実でもある。運命とは、確かにかようなものでござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750811
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400750811,
					"content": "普段ならこんなことは言いませんが、せっかくの機会ですし、やはり皆さんには分かってもらいたいことがあります。占星術を、そこらの屋台にあるクジ引きと同じように扱わないでください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750812
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400750812,
					"content": "私たちが研究しているのは星象であって、決して誰かにお世辞を言って喜んでもらうためのものではありません。占星術師は、真実を検証し、世界の理を見届けるために存在しています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750813
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400750813,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750814
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400750814,
					"content": "ああもう——！だから占星術師は嫌われやすい職業だと言ったのです！偉大さと嫌われやすさは、本来まったく両立しないもののはずなのに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750815
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400750815,
					"content": "何故そうも騒ぎ立てる？あなたはそれほどまでに交友に値しない者ではなかったはずよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750816
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400750816,
					"content": "お嬢様は、友達になれてとても嬉しい、とおっしゃっています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750817
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 400750817,
					"content": "違うわ！そんなこと言ってないでしょ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750818
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400750818,
					"content": "オズ、あなたどういうこと？ますますわたくしの主旨を曲解するのが好きになってきたようね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750819
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400750819,
					"content": "おやおや、どうしてでしょう。もしかすると、お嬢様がお友達の恨みを買ってしまうのを心配して、なるべく取り繕うようにしているのかもしれませんね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750820
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 400750820,
					"content": "アタイも別に見識が広いわけじゃないから、占星術師はあんたくらいしか知らないけど。でも、あんたの印象は悪くないぜ、まったく嫌な感じはしねぇ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750821
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400750821,
					"content": "人の秘密を軽々しく詮索したり、気に入らない結果を適当に捨てたりする人こそ、反省する必要があると思う。運命はそんなに安っぽいもんじゃねぇだろうしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750822
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400750822,
					"content": "もしも運命が二言三言で回避できるようなものであれば、この世に別離の苦など存在せぬ。モナ殿、気にすることはないでござるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750823
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400750823,
					"content": "己が本心に従い、正しきことを永遠に忘れない。それだけで十分でござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750824
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400750824,
					"content": "コホンッ、そ…そんなに私のことを心配せずとも大丈夫です。こう見えて、結構打たれ強いので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750825
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400750825,
					"content": "じゃあ、どうして耳が赤いの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400750826
					]
				},
				{
					"id": 400750826,
					"content": "うぅ…えっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750827
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400750827,
					"content": "…わ、わかりました。じゃあ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750828
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400750828,
					"content": "ありがとう…ございます…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750829
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400750829,
					"content": "聞こえないわ。もっと大きな声で、このわたくしにあなたの崇敬と祝福を献上なさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750830
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400750830,
					"content": "まあまあ、そんなこと言ってないで、殿下は池に映し出された新しい地点に行って、他の欠片を回収したほうがいいんじゃないか？あれがないと、アタイたち幻境に入れないだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750831
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400750831,
					"content": "お嬢様の鋭い眼差しだけが、秘密を暴くことができるのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750832
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 400750832,
					"content": "そこまで言うなら、仕方ないわね。わたくしは浜辺に行くとするわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750833
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400750833,
					"content": "行くぞ、モナ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750834
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400750834,
					"content": "は、はい！すぐ行きます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750835
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400750835,
					"content": "…ははっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "楓原万葉"
				}
			]
		}
	]
}