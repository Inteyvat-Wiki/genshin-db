			"dialogs": [
				{
					"id": 761360301,
					"content": "（<color=#FFCC33FF>ヤフォダ</color>は、箱の様子を見たいようだ…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761360302
					]
				},
				{
					"id": 761360302,
					"content": "へへ…稼ぎを確認しておこうっと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360303
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761360303,
					"content": "この前ネフェル姐さんがボーナスくれるって言ってたし。どれくらいくれるのかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360304
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761360304,
					"content": "あれ？なんでお金が入ってないんだ？なんか入ってるぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360305
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761360305,
					"content": "「愛しのヤフォダへ——箱はちゃんと閉めるんだよ。あんたのボーナスはここから出るわけじゃないからね。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360306
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761360306,
					"content": "ちっ、ネフェル姐さんの脅しか。もしかして二重底になってるとかか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360307
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761360307,
					"content": "二重底なんてないよ。あんたのボーナスはここだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360308
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761360308,
					"content": "おう、ありがとうボス！！！あたい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360309
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761360309,
					"content": "うわあああああああ——ボ、ボ、ボ、ボス、あたい、ちょ、ちょっと確認しようと思っただけなんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360310
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761360310,
					"content": "あ、あたい、仕事行ってくるっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360311
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761360311,
					"content": "待ちな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360312
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761360312,
					"content": "はいぃ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360313
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761360313,
					"content": "箱を閉めて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360314
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761360314,
					"content": "はい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360315
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761360315,
					"content": "行きな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360316
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761360316,
					"content": "はい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヤフォダ"
				}
			]
		},
