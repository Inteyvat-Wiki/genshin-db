			},
			"dialogs": [
				{
					"id": 722430102,
					"content": "お宝を売りたいんだけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722430103
					]
				},
				{
					"id": 722430103,
					"content": "お宝を売る？それはまた珍しい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430104
					],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 722430104,
					"content": "あなたのような強い冒険者なら、きっと凄く貴重な物なのでしょうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430105
					],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 722430105,
					"content": "早く私に見せてもらえますでしょうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430106
					],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 722430106,
					"content": "龍骨花の露玉のことをマージョリーに伝えた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722430107
					]
				},
				{
					"id": 722430107,
					"content": "それって…吟遊詩人の物語に出てくる、忘憂の実のことではないでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430108
					],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 722430108,
					"content": "本当にそのようなものが存在していたのですね…龍骨花の露玉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430109
					],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 722430109,
					"content": "もしあなたのおっしゃる通りの効果があるのでしたら、八万モラといくつかのオリジナル料理で買い取らせていただきます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430110
					],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 722430110,
					"content": "そうですね…八万モラとムーンパイ五つで、どうでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430111,
						722430114,
						722430120
					],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 722430111,
					"content": "これをどんなことに使うか教えて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722430112
					]
				},
				{
					"id": 722430112,
					"content": "ふふっ、これは特別なお宝です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430113
					],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 722430113,
					"content": "童話にあるような神秘的な力を持っているため、錬金術師たちがこぞって欲しがると思いますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430110
					],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 722430114,
					"content": "適正な価格だと思う、交渉成立。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722430115
					]
				},
				{
					"id": 722430115,
					"content": "ではお宝をお受け取りいたします、ありがとうございました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430116
					],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 722430116,
					"content": "あっ、それと…一般的に、露玉の類は風によって揮発してしまいます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430117
					],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 722430117,
					"content": "ですので、品質を確保するため、それを包むか容器に入れて密封したほうがいいかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430118
					],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 722430118,
					"content": "これは、ちょっとした小技なんです。あなたの冒険の役に立つことを願っています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430119
					],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 722430119,
					"content": "今後もこのようなお宝を手に入れた時、あなたの忠実な買取人がここにいることをお忘れなく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 722430120,
					"content": "少し考えさせて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722430121
					]
				},
				{
					"id": 722430121,
					"content": "ええ、もちろん。ですが私は、自分が出した価格こそもっとも適したものだと信じています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430122
					],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 722430122,
					"content": "決まりましたら、またお声がけください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マージョリー"
				}
			]
		},
