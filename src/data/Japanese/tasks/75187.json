			"dialogs": [
				{
					"id": 751870101,
					"content": "#角に炎みたいな模様がない…{REALNAME[ID(2)|SHOWHOST(true)]}じゃないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751870102,
					"content": "うーん、こいつはどこから来たんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751870103,
					"content": "オシカ・ナタの竜の卵…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751870104
					]
				},
				{
					"id": 751870104,
					"content": "それって、あの時の竜の卵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751870105,
					"content": "キュウ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870106
					],
					"speakerTitle": "アグワラ"
				},
				{
					"id": 751870106,
					"content": "まさか卵の中にテペトル竜がいたなんてな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751870107,
					"content": "オイラ、この卵を守ってた人が名前をつけてたのを聞いたぞ。たしか…「アグワラ」じゃなかったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751870108,
					"content": "キュー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870109
					],
					"speakerTitle": "アグワラ"
				},
				{
					"id": 751870109,
					"content": "おっ、自分の名前に反応したみたいだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751870110,
					"content": "キュウ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870111
					],
					"speakerTitle": "アグワラ"
				},
				{
					"id": 751870111,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}みたいに、こいつも家がないみたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751870112,
					"content": "#それなら一緒に行こう！へへっ、オイラと{NICKNAME}はテペトル竜と友達になるのが得意なんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751870113,
					"content": "キュイッ！キュイッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870114
					],
					"speakerTitle": "アグワラ"
				},
				{
					"id": 751870114,
					"content": "へへっ…おまえならそう言ってくれると思ったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751870115,
					"content": "かつての仲間にしたように、この子にもスカーフを巻いた。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751870116
					]
				},
				{
					"id": 751870116,
					"content": "そのスカーフを最後に巻いてた竜は、めちゃくちゃ立派に成長したんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751870117,
					"content": "アグワラ！お前もあいつみたいに、元気に…大きく育ってくれよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
