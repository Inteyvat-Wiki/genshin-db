			},
			"dialogs": [
				{
					"id": 750460101,
					"content": "おーい、戻っておいでー！おーい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460102
					],
					"speakerTitle": "ウルバンバ"
				},
				{
					"id": 750460102,
					"content": "こんにちは。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460103
					]
				},
				{
					"id": 750460103,
					"content": "おーい！おーい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460104
					],
					"speakerTitle": "ウルバンバ"
				},
				{
					"id": 750460104,
					"content": "はぁ、酷い気分だ…一体どうしたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460105
					],
					"speakerTitle": "ウルバンバ"
				},
				{
					"id": 750460105,
					"content": "干し草を買うためにちょっと外に出てたら、飼っていた竜が八匹もいなくなっちゃって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460106
					],
					"speakerTitle": "ウルバンバ"
				},
				{
					"id": 750460106,
					"content": "まだまだ小さい子ばかりなのに、ヒルチャールにいじめられてたり、迷子になって困ってたらどうしよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460107
					],
					"speakerTitle": "ウルバンバ"
				},
				{
					"id": 750460107,
					"content": "親切なお方、迷子になったライノ竜を見かけてないかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460108
					],
					"speakerTitle": "ウルバンバ"
				},
				{
					"id": 750460108,
					"content": "どんな見た目なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460109
					]
				},
				{
					"id": 750460109,
					"content": "このライノ竜は迷子になった八匹の母親で、僕が手塩にかけて育てた娘のような存在なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460110
					],
					"speakerTitle": "ウルバンバ"
				},
				{
					"id": 750460110,
					"content": "それも、豊穣の邦で一、二を争うくらいに美しく、この地区の美竜コンテストで優勝したこともあるんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460111
					],
					"speakerTitle": "ウルバンバ"
				},
				{
					"id": 750460111,
					"content": "だから、八匹のやんちゃな子供たちにも母親譲りの美貌と、透き通るような桃色の肌と、左右対称の紫がかった扇状の角がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460112
					],
					"speakerTitle": "ウルバンバ"
				},
				{
					"id": 750460112,
					"content": "もし見かけたら、どうにかして連れ戻してくれると助かるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460113
					],
					"speakerTitle": "ウルバンバ"
				},
				{
					"id": 750460113,
					"content": "僕の小さな孫たち…もう二度と怒ったりしないから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460118
					],
					"speakerTitle": "ウルバンバ"
				},
				{
					"id": 750460118,
					"content": "気にかけておくよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460119
					]
				},
				{
					"id": 750460119,
					"content": "恩に着るよ。君のベンチプレスや懸垂トレーニングがうまくいくことを祈ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウルバンバ"
				}
			]
		},
