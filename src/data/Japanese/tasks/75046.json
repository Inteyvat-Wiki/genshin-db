						750460504
					]
				},
				{
					"id": 750460504,
					"content": "ああ、ありがとう。無事でよかった、心配で気が気じゃなかったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460505
					],
					"speakerTitle": "ウルバンバ"
				},
				{
					"id": 750460505,
