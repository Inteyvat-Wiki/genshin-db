					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460804
					],
					"speakerTitle": "ウルバンバ"
				},
				{
					"id": 750460804,
					"content": "はぁ、酷い気分だ…一体どうしたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460805
					],
					"speakerTitle": "ウルバンバ"
				},
				{
					"id": 750460805,
					"content": "干し草を買うためにちょっと外に出てたら、飼っていた竜が八匹もいなくなっちゃって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460806
					],
					"speakerTitle": "ウルバンバ"
				},
				{
					"id": 750460806,
					"content": "まだまだ小さい子ばかりなのに、ヒルチャールにいじめられてたり、迷子になって困ってたらどうしよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460807
					],
					"speakerTitle": "ウルバンバ"
				},
				{
					"id": 750460807,
					"content": "親切なお方、迷子になったライノ竜を見かけてないかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460808
					],
					"speakerTitle": "ウルバンバ"
				},
				{
					"id": 750460808,
					"content": "どんな見た目なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460809
					]
				},
				{
					"id": 750460809,
					"content": "このライノ竜は迷子になった八匹の母親で、僕が手塩にかけて育てた娘のような存在なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460810
					],
					"speakerTitle": "ウルバンバ"
				},
				{
					"id": 750460810,
					"content": "それも、豊穣の邦で一、二を争うくらいに美しく、この地区の美竜コンテストで優勝したこともあるんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460811
					],
					"speakerTitle": "ウルバンバ"
				},
				{
					"id": 750460811,
					"content": "だから、八匹のやんちゃな子供たちにも母親譲りの美貌と、透き通るような桃色の肌と、左右対称の紫がかった扇状の角がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460812
					],
					"speakerTitle": "ウルバンバ"
				},
				{
					"id": 750460812,
					"content": "もし見かけたら、どうにかして連れ戻してくれると助かるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460813
					],
					"speakerTitle": "ウルバンバ"
				},
				{
					"id": 750460813,
					"content": "僕の小さな孫たち…もう二度と怒ったりしないから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460814
					],
					"speakerTitle": "ウルバンバ"
				},
				{
					"id": 750460814,
					"content": "何匹か見つけたよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460815
					]
				},
				{
					"id": 750460815,
					"content": "ああ、ありがとう。無事でよかった、心配で気が気じゃなかったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460816
					],
					"speakerTitle": "ウルバンバ"
				},
				{
					"id": 750460816,
					"content": "でも、残りの子たちは無事なのかな…もし見かけたら、また連れ戻してくれるとすごく助かる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウルバンバ"
				}
			]
		}
	]
}