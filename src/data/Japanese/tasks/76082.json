	"talks": [
		{
			"id": 7601414,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7608201",
							"2"
						],
						"stepId": 7608201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"マイテ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760141401,
					"content": "#どうしたの、{M#お兄さん}{F#お姉さん}？他に聞きたいことでもある？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141402,
						760141406,
						760141409,
						760141413,
						760141426
					],
					"speakerTitle": "マイテ"
				},
				{
					"id": 760141402,
					"content": "あのカニについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141403
					]
				},
				{
					"id": 760141403,
					"content": "はぁ、見た目は怖いけど、本当はすごく温厚な子なんだ。あの変な石もとれたし、前の性格に戻ってくれると思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141404
					],
					"speakerTitle": "マイテ"
				},
				{
					"id": 760141404,
					"content": "でも、しばらくは閉じ込めて反省させないと。理由はどうあれ、あいつが悪かったことには変わりないし、小さいカニたちは傷つけられたんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141405
					],
					"speakerTitle": "マイテ"
				},
				{
					"id": 760141405,
					"content": "大盗賊レッド・ミラーに懲らしめられた、鏡に惑わされた悪いフェイの総督と同じだよ。どんだけ言い訳をしたって、結局は自分の行動でしか罪は償えない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マイテ"
				},
				{
					"id": 760141406,
					"content": "あの奇妙な石について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141407
					]
				},
				{
					"id": 760141407,
					"content": "はは、あれは人の心を操る欲望{RUBY#[D]ツワドフスカ}の石さ。たしかヒディンバお姉さんがそう言ってたんだったかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141408
					],
					"speakerTitle": "マイテ"
				},
				{
					"id": 760141408,
					"content": "コホン、と、とにかく、霜月のほうに落ちたでかい石と同じように、空から落ちてきたらしい。ま、もう飛んでっちゃったんだから、もう危険はないはずだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マイテ"
				},
				{
					"id": 760141409,
					"content": "ホラガイ団について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141410
					]
				},
				{
					"id": 760141410,
					"content": "#えっ？ホラガイ団のことが知りたいの？ま、{M#お兄さん}{F#お姉さん}はもう仲間みたいなもんだし、教えてあげてもいいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141411
					],
					"speakerTitle": "マイテ"
				},
				{
					"id": 760141411,
					"content": "#アタシたちは…そうだな、同じ道を歩む同年代の「助け合いの会」とでもいうべきかな。年齢で言うと、実は{M#お兄さん}{F#お姉さん}は入会資格ないんだけどね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141412
					],
					"speakerTitle": "マイテ"
				},
				{
					"id": 760141412,
					"content": "でも、ナシャタウンで助けが必要になったら、いつでも言って！アタシにできることなら力になるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マイテ"
				},
				{
					"id": 760141413,
					"content": "さっきのおかしな人について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141414
					]
				},
				{
					"id": 760141414,
					"content": "ああ、あの紫色の祭司のこと？手を出してこないってことは、少なくとも今は敵じゃない。できるだけ関わらないようにしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141415
					],
					"speakerTitle": "マイテ"
				},
				{
					"id": 760141415,
					"content": "好奇心は命取りになる。カーチャ姉さんも、霜月の変人たちにはできるだけ近づかないようにって言ってたし。アタシみたいな大怪盗でさえ、あいつらに捕まって月神の生贄にされるとこだったんだからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141416
					],
					"speakerTitle": "マイテ"
				},
				{
					"id": 760141416,
					"content": "生贄！？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141417
					]
				},
				{
					"id": 760141417,
					"content": "そうだよ。あいつら本当にイカれてて、いろんな人の血を…うーん、思い出しただけでゾッとする。この話はやめよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141418
					],
					"speakerTitle": "マイテ"
				},
				{
					"id": 760141418,
					"content": "アタシを捕まえたのが右も左も分からない小娘でよかったよ。いくつかお話を聞かせてあげたら解放してくれたんだ。でなきゃ今ごろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141419
					],
					"speakerTitle": "マイテ"
				},
				{
					"id": 760141419,
					"content": "#べ、別にそこまで怖がってないんだからね。大怪盗が怖がりじゃ、やっていけないでしょ。ただ、あいつらにはなるべく関わらないほうがいいって、{M#お兄さん}{F#お姉さん}に忠告してるだけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141420
					],
					"speakerTitle": "マイテ"
				},
				{
					"id": 760141420,
					"content": "あっ、そうだ、情報源について伝えるの忘れるところだった。霜月の子の件に関してはヒディンバお姉さんから聞いたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141421
					],
					"speakerTitle": "マイテ"
				},
				{
					"id": 760141421,
					"content": "ヒディンバお姉さんに用があるなら…まだナシャタウンの近くにいるはずだから、ちょっと聞けば、すぐに見つかると思うよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141422,
						760141424
					],
					"speakerTitle": "マイテ"
				},
				{
					"id": 760141422,
					"content": "引退するって聞いたけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141423
					]
				},
				{
					"id": 760141423,
					"content": "え？ヒディンバお姉さんに会ったことあるの？引退の話なんて聞いてないけど…後で聞いてみないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マイテ"
				},
				{
					"id": 760141424,
					"content": "頼りになるかな…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141425
					]
				},
				{
					"id": 760141425,
					"content": "心配いらないよ。超頼りになるって、このマイテが保証する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マイテ"
				},
				{
					"id": 760141426,
					"content": "さようなら。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141427
					]
				},
				{
					"id": 760141427,
					"content": "うん、気を付けてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マイテ"
				}
			]
		},
		{
			"id": 7601417,
			"completionStepIds": [
				7608202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
