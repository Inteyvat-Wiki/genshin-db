			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"マイテ",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760141701,
					"content": "うわぁ！こいつ、前より大きくなったんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141702
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760141702,
					"content": "ふふん、当たり前じゃん！アタシが苦労して集めたホワイトベリーを山ほど食べてるんだからね。今じゃパイモンより丸々してるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141703
					],
					"speakerTitle": "マイテ"
				},
				{
					"id": 760141703,
					"content": "おい！オイラを比較対象にするなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141704
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760141704,
					"content": "#うわっ！どうしちゃったの？{NICKNAME}{M#お兄さん}{F#お姉さん}を見た途端、急にテンション上がったみたいな…ってか、興奮してない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141705
					],
					"speakerTitle": "マイテ"
				},
				{
					"id": 760141705,
					"content": "#{NICKNAME}{M#お兄さん}{F#お姉さん}と勝負したいみたいだけど…あ、もしかして——前に手も足も出なかったのがよほど悔しかったんだね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141706,
						760141708
					],
					"speakerTitle": "マイテ"
				},
				{
					"id": 760141706,
					"content": "望むところだよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141707
					]
				},
				{
					"id": 760141707,
					"content": "#気を付けてよ、{M#お兄さん}{F#お姉さん}。この子、前よりもずっと強くなってるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マイテ"
				},
				{
					"id": 760141708,
					"content": "え？勝負って今から？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141709
					]
				},
				{
					"id": 760141709,
					"content": "#{M#お兄さん}{F#お姉さん}の気が向いた時に相手してあげてよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141710
					],
					"speakerTitle": "マイテ"
				},
				{
					"id": 760141710,
					"content": "今じゃアタシが面倒見てやってるようなもんだからさ、アタシの言うことは聞くんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141711
					],
					"speakerTitle": "マイテ"
				},
				{
					"id": 760141711,
					"content": "おいで。いい子だね、おすわり。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141712
					],
					"speakerTitle": "マイテ"
				},
				{
					"id": 760141712,
					"content": "飼い犬かよ！いや待てよ、カニっていつも座ってるもんじゃないのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
