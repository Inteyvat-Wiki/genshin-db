			"dialogs": [
				{
					"id": 401960101,
					"content": "ごめんな！待たせちゃったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401960102,
					"content": "いや、ちょうどいいタイミングだった。ちゃんと休めただろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960103
					],
					"speakerTitle": "ヌヴィレット"
				},
				{
					"id": 401960103,
					"content": "忙しいほど元気が出るから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960104
					]
				},
				{
					"id": 401960104,
					"content": "確かにそれが元気の秘訣かもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960105
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 401960105,
					"content": "もうすでに準備中？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960106
					]
				},
				{
					"id": 401960106,
					"content": "ああ。昨日、アルジャントーさんから取引の時間と場所を聞いた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960107
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 401960107,
					"content": "みんな知ってる場所だ。「本日午後、映影ランドのレストランで会おう」ってさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960108
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 401960108,
					"content": "また映影ランドかよ！よっぽどお気に入りの場所なんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401960109,
					"content": "あそこだと…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960110
					]
				},
				{
					"id": 401960110,
					"content": "どうやら、旅人も同じことを心配してるようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960111
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 401960111,
					"content": "ああ。人の出入りが多いと、身柄の確保が難しくなる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960112
					],
					"speakerTitle": "ヌヴィレット"
				},
				{
					"id": 401960112,
					"content": "犯人が人混みに紛れ込み、人質をとって逃走する可能性もあるからだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960113
					],
					"speakerTitle": "ヌヴィレット"
				},
				{
					"id": 401960113,
					"content": "諸々に備えて、情報が入った昨日のうちに、マレショーセ・ファントムと特巡隊の手配は済ませてある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960114
					],
					"speakerTitle": "ヌヴィレット"
				},
				{
					"id": 401960114,
					"content": "ああ。現場には私服警官を大量配置する予定だ。状況次第では、市民の安全確保を最優先する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960115
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 401960115,
					"content": "もちろん、何事もなければそれが一番だが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960116
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 401960116,
					"content": "事件のことで世話になった特巡隊隊長のシュヴルーズさんたちも入るらしい——だから、俺は前向きに考えてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960117
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 401960117,
					"content": "信じてくれてありがとう、ナタの大英雄さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960118
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 401960118,
					"content": "それと、レピーヌ・ポーリーンさんやナヴィアさんとも、話を付けてきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960119
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 401960119,
					"content": "棘薔薇の会が可能な範囲でサポートしてくれるから、心配はいらない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960120
					],
					"speakerTitle": "ヌヴィレット"
				},
				{
					"id": 401960120,
					"content": "唯一の問題は…エスコフィエさんのほうかもしれないが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960121,
						401960123
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 401960121,
					"content": "犯罪者に料理を振る舞いたくない、とか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960122
					]
				},
				{
					"id": 401960123,
					"content": "犯罪者を料理してやろうと思ってるとか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960124
					]
				},
				{
					"id": 401960122,
					"content": "ははっ、そうだったらやりやすいけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960125
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 401960124,
					"content": "面白い発想だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960125
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 401960125,
					"content": "コホン…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960126
					],
					"speakerTitle": "ヌヴィレット"
				},
				{
					"id": 401960126,
					"content": "冗談だ。エスコフィエさんは、今回の作戦で自分の店が被害に遭うのはごめんなんだとさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960127
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 401960127,
					"content": "ははっ…そうはいかないって予感がするだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960128
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 401960128,
					"content": "何か手伝えることはある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960129
					]
				},
				{
					"id": 401960129,
					"content": "いや、この件はあんたとは無関係なのに、すでにかなり迷惑をかけちまった。後のことはフォンテーヌの役人に任せてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960130
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 401960130,
					"content": "と言いたいところだが、この事件の結末が気になるんだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960131
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 401960131,
					"content": "うん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960132
					]
				},
				{
					"id": 401960132,
					"content": "それじゃ、臨機応変に対応してくれ。必ずしも手を出す必要はない——ただ、万が一があったらな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960133
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 401960133,
					"content": "そうならないように最善を尽くす。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960134
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 401960134,
					"content": "キィニチも作戦に参加するの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960135
					]
				},
				{
					"id": 401960135,
					"content": "もちろんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960136
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 401960136,
					"content": "疑問は山積みだが、今ある情報を見る限り、犯人はナタ出身だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960137
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 401960137,
					"content": "俺も証人の一人だから、放っておく訳にはいかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960138
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 401960138,
					"content": "キィニチらしいな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960139
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401960139,
					"content": "みんなで作戦の詳細や注意事項について、改めて話し合った。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401960140
					]
				},
				{
					"id": 401960142,
					"content": "さて、こんなもんか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960143
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 401960143,
					"content": "作戦開始は午後だ。うまくいけば、出発前にまだお茶を何杯か飲めるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960144
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 401960144,
					"content": "そうだな…オイラたちもなにか食べに行かないか？お腹いっぱいにならないと、力が出ないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960145
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401960145,
					"content": "パイモンは見てるだけでしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960146
					]
				},
				{
					"id": 401960146,
					"content": "寄り添うのも大事な仕事なんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960147
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401960147,
					"content": "俺は先に会場に向かう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960148
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 401960148,
					"content": "アハウがここ数日、イベント限定セットが食べたいとずっと騒いでるんだ。早く気のすむようにさせてやらないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960149
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 401960149,
					"content": "じゃあ、またあとで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960150
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 401960150,
					"content": "——いい知らせを待っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヌヴィレット"
				}
			]
		},
