			"dialogs": [
				{
					"id": 401960301,
					"content": "よう！二人とも戻ってきたんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401960302,
					"content": "シュヴルーズが犯人を連れてったけど、なんだか上機嫌だったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960303,
						401960304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401960303,
					"content": "思ったより順調だったからね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960305
					]
				},
				{
					"id": 401960305,
					"content": "へへっ、あんなに手間をかけさせた割に、結局逃げ回る以外に能のないやつだったんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401960306,
					"content": "そうだ、リオセスリはパレ・メルモニアに報告に行くってさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401960307,
					"content": "マレショーセ・ファントムがギャンブル業界について調査を入れることになったから、これからかなり忙しくなるって言ってたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401960308,
					"content": "ま、パレ・メルモニアの仕事だし、オイラたちにはあんまり関係ないけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401960309,
					"content": "質問攻めに遭わないうちに逃げたとしか思えないけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960310
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 401960310,
					"content": "はぁ…ま、いつものことね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960311
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 401960311,
					"content": "えっ、取材のチャンスをあっさり諦めちゃうのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401960312,
					"content": "へへ、実はいい写真がたっぷり撮れたの。これなら一面を派手に飾る記事が書けるわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960313
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 401960313,
					"content": "ということで——さっそく写真を現像して記事作成に取り掛かりたいから、お先に失礼するわね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960314
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 401960314,
					"content": "オイラがかっこよく写ってるやつにしてくれよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960315
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401960315,
					"content": "あっ、行っちゃった。聞こえてたかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960316
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401960316,
					"content": "プロのカメラマンの腕を信じよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960317
					]
				},
				{
					"id": 401960317,
					"content": "へへっ、それもそうだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960318
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401960318,
					"content": "それより、ずいぶん遅かったけど、なにかあったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960319,
						401960324
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401960319,
					"content": "アハウが頭をぶつけてめそめそしてた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960320
					]
				},
				{
					"id": 401960320,
					"content": "なんだって！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960321
					],
					"speakerTitle": "アハウ"
				},
				{
					"id": 401960321,
					"content": "てめぇ、何デタラメ言ってやがる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960322
					],
					"speakerTitle": "アハウ"
				},
				{
					"id": 401960322,
					"content": "この「偉大なる聖龍」クフル・アハウが、そんな醜態を晒したことがあるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960323
					],
					"speakerTitle": "アハウ"
				},
				{
					"id": 401960323,
					"content": "醜態はいつものことだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960329
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 401960329,
					"content": "これからどうするの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960330
					]
				},
				{
					"id": 401960330,
					"content": "そうだな…実はまだ決まってないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960331
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 401960331,
					"content": "急ぎの用事もないし、法廷からまた証人として呼ばれるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960332
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 401960332,
					"content": "あの銃も重要な物証だから、事件の審理が終わるまではナタに持ち帰れないだろうし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960333
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 401960333,
					"content": "今はもうしばらく、砂浜と海を楽しむことにする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 401960324,
					"content": "キィニチが頭をぶつけてめそめそしてた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960325
					]
				},
				{
					"id": 401960325,
					"content": "そう言うことにしておこう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960326
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 401960326,
					"content": "ギャハハッ、ちびニチ、誰もよしよししてくれなかったから、一人でめそめそしてたんだぜ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960327
					],
					"speakerTitle": "アハウ"
				},
				{
					"id": 401960327,
					"content": "本当かよ？アハウがめそめそしてたんなら分かるけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960328
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401960328,
					"content": "おいっ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960329
					],
					"speakerTitle": "アハウ"
				},
				{
					"id": 401960304,
					"content": "敵が弱かったからね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960305
					]
				}
			]
		}
	]
}