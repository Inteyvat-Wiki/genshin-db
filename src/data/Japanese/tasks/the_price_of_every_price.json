			"dialogs": [
				{
					"id": 401960201,
					"content": "たった数日で、この砂浜も賑やかになったな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401960202,
					"content": "（警察隊員がたくさん紛れ込んでるからかもしれないけどね。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960203
					]
				},
				{
					"id": 401960203,
					"content": "旅人、その…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401960204,
					"content": "オイラお腹が減ってきたぞ。レストランに行ってメニューを見てみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401960205,
					"content": "（箱を持ってる人が、取引に来た人物のはず。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960206
					]
				},
				{
					"id": 401960206,
					"content": "#（いよいよ本番{M#だ}{F#だね}。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960207
					]
				},
				{
					"id": 401960207,
					"content": "ひどい、あんな風に引っ張るなんて…傷害罪です！法廷で訴えますよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960208
					],
					"speakerTitle": "アングルヴァン"
				},
				{
					"id": 401960208,
					"content": "そうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960209
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 401960209,
					"content": "「観客」の目の前から連れ出したのは、お前のメンツを保つためだったんだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960210
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 401960210,
					"content": "それに、頭から落ちるのも逆から落ちるのも、お前自身が決めたことだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960211
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 401960211,
					"content": "君…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960212
					],
					"speakerTitle": "アングルヴァン"
				},
				{
					"id": 401960212,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960213
					],
					"speakerTitle": "アングルヴァン"
				},
				{
					"id": 401960213,
					"content": "わ、分かりました。私が悪かったと認めましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960214
					],
					"speakerTitle": "アングルヴァン"
				},
				{
					"id": 401960214,
					"content": "はぁ…善悪の区別くらい、ついてます。でも、本当にモラが必要で、どうしようもなく…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960215
					],
					"speakerTitle": "アングルヴァン"
				},
				{
					"id": 401960215,
					"content": "私は元々古代遺跡研究の専門家で、幸せな家庭と仕事に恵まれて順風満帆でした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960216
					],
					"speakerTitle": "アングルヴァン"
				},
				{
					"id": 401960216,
					"content": "それなのに、まさか息子がギャンブルにハマってしまうなんて…貯金はあっという間に底をつきました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960217
					],
					"speakerTitle": "アングルヴァン"
				},
				{
					"id": 401960217,
					"content": "借金ができてからは、息子が債権者から脅迫されるようになって…父親として、息子がひどい目に遭うのを黙って見るわけにはいかないでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960218
					],
					"speakerTitle": "アングルヴァン"
				},
				{
					"id": 401960218,
					"content": "はぁ、息子は君と同じ年頃なんですが…君のようにまともに育ってくれればよかったのに…とにかく、そういうわけでモラが必要だったんです…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960219
					],
					"speakerTitle": "アングルヴァン"
				},
				{
					"id": 401960219,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960220
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 401960220,
					"content": "あの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960221
					],
					"speakerTitle": "アングルヴァン"
				},
				{
					"id": 401960221,
					"content": "お願いです！どうか助けてください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960222
					],
					"speakerTitle": "アングルヴァン"
				},
				{
					"id": 401960222,
					"content": "ナタ人同士のよしみで、見逃してくださいませんか…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960223
					],
					"speakerTitle": "アングルヴァン"
				},
				{
					"id": 401960223,
					"content": "帰して頂ければ、ドラ息子をしっかり教育します。しかし…私が捕まれば、息子は死んでしまうかもしれません！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960224
					],
					"speakerTitle": "アングルヴァン"
				},
				{
					"id": 401960224,
					"content": "家族とは、より良い未来のために一緒に頑張るものでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960225
					],
					"speakerTitle": "アングルヴァン"
				},
				{
					"id": 401960225,
					"content": "一家の運命は君の手にかかってます。どうか、お願いします！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960226
					],
					"speakerTitle": "アングルヴァン"
				},
				{
					"id": 401960226,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960227
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 401960227,
					"content": "ハハッ、おいキィニチ、なんで黙ってるんだ？まさか、ほだされたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960228
					],
					"speakerTitle": "アハウ"
				},
				{
					"id": 401960228,
					"content": "フン。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960229
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 401960229,
					"content": "お前の言葉なんて一ミリも信用できない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960230
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 401960230,
					"content": "リオセスリさんの予想通りだ。お前は根っからのギャンブラーだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960231
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 401960231,
					"content": "えっ、私がギャンブラーですって？違います。それは息子の話で…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960232
					],
					"speakerTitle": "アングルヴァン"
				},
				{
					"id": 401960232,
					"content": "大体、お前は本当にナタ人なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960233
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 401960233,
					"content": "ナタ人なら、銃の行方を監視していた間に、見覚えのある顔に気づいたはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960234
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 401960234,
					"content": "対して——「法廷」のくだりはすらすら出たな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960235
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 401960235,
					"content": "そ、それくらいのことで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960236
					],
					"speakerTitle": "アングルヴァン"
				},
				{
					"id": 401960236,
					"content": "せ、説明しましょう！実は小さい頃から…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960237
					],
					"speakerTitle": "アングルヴァン"
				},
				{
					"id": 401960237,
					"content": "ちっ…これ以上聞きたくない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960238
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 401960238,
					"content": "アハウ、口を塞ぐチャンスをやる。どうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960239
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 401960239,
					"content": "ハハハッ、その言葉、待ってたぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960240
					],
					"speakerTitle": "アハウ"
				},
				{
					"id": 401960240,
					"content": "この恥知らずめ、喰らえ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960241
					],
					"speakerTitle": "アハウ"
				},
				{
					"id": 401960241,
					"content": "嘘ばかりつくのがギャンブラーの特徴だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960242
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 401960242,
					"content": "お前はナタ人に成りすましたフォンテーヌ人だろう？家族や友達なんていないと俺は推測してる。いたとしても、とっくに離れていったはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960243
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 401960243,
					"content": "もちろん、外れてる可能性もある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960244
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 401960244,
					"content": "——だが、だからなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960245
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 401960245,
					"content": "俺は身柄の確保を任されただけで、お前の代理人じゃなければ、お悩み相談の相手でもない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960246
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 401960246,
					"content": "お前の口から真相を聞き出すのは、お前が大好きな法廷の役目だ。違うか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960247
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 401960247,
					"content": "ああ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960248
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 401960248,
					"content": "キィニチさん、久しぶりだな。容疑者は引き取ろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960249
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 401960249,
					"content": "ああ、頼む。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960250
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 401960250,
					"content": "ご協力、改めて感謝する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960251
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 401960251,
					"content": "オレにはないのか？失礼だな！この偉大なる聖龍に礼も言えないのかよ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960252
					],
					"speakerTitle": "アハウ"
				},
				{
					"id": 401960252,
					"content": "ああ——カクークくんとの素晴らしいショーをありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960253
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 401960253,
					"content": "えっ——何だそれは！おい、待て——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960254
					],
					"speakerTitle": "アハウ"
				},
				{
					"id": 401960254,
					"content": "キィニチ、大丈夫？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960255
					]
				},
				{
					"id": 401960255,
					"content": "引きずって行かれたのは俺じゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960256
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 401960256,
					"content": "さっき、暗い顔をしてなかった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960257
					]
				},
				{
					"id": 401960257,
					"content": "ププッ、ちびちびニチだった頃のことを思い出したんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960258
					],
					"speakerTitle": "アハウ"
				},
				{
					"id": 401960258,
					"content": "泣きべそかくなよ！泣き虫な下僕なんて、恥ずかしいからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960259
					],
					"speakerTitle": "アハウ"
				},
				{
					"id": 401960259,
					"content": "何を言ってる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960260
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 401960260,
					"content": "アハウって意地悪。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960261
					]
				},
				{
					"id": 401960261,
					"content": "…別に隠すことはない。簡単に言えば、ギャンブラーが嫌いなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960262
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 401960262,
					"content": "この世で最も無責任で、努力とその結果を尊重しないやつらだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960263
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 401960263,
					"content": "コイン一枚のために、幾千万もの嘘を平気でつき、手の中にあるコインで幾千万もの富を生み出すことを夢見てる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960264
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 401960264,
					"content": "だが、タダで手に入れたものの裏には、想像を絶する代償が隠されてるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960265
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 401960265,
					"content": "昔の暮らしは、父が賭けに負けた代償の一部だった。できれば、誰にも同じ目に遭ってほしくない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960266
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 401960266,
					"content": "キィニチ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960267
					]
				},
				{
					"id": 401960267,
					"content": "同情する必要はない。悲しいとは思ってないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960268
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 401960268,
					"content": "人間は過去でできてるって、人は言う。なら、ここまで歩んでこれたのは、きっと正しいことをたくさんしてきたからだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960269
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 401960269,
					"content": "他人の過ちのために、苦しむ必要なんかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960270
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 401960270,
					"content": "そんなことより、俺は成長した瞬間を覚えておくようにしてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960271
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 401960271,
					"content": "例えば、初めてカギ縄の使い方を覚えた瞬間とか——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960272
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 401960272,
					"content": "初めて知識を求めた時とかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960273
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 401960273,
					"content": "そっか。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960274
					]
				},
				{
					"id": 401960274,
					"content": "ああ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960275
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 401960275,
					"content": "それじゃ、行こう。そろそろ戻らないと、みんなが心配する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キィニチ"
				}
			]
		},
