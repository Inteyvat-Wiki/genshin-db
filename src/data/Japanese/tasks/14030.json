					}
				]
			},
			"dialogs": [
				{
					"id": 140300301,
					"content": "来てくれたのね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300302
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 140300302,
					"content": "弔いたいのはウチの先生よ。遺体がなくて、服や遺品だけが残ってたんだけど、それも今はもう水の中に沈んじゃってるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300303
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 140300303,
					"content": "シグウィン…薬を作ったのって、おまえの先生の魔女婆さんだったんだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140300304,
					"content": "ええ。ヌヴィレットさんから色々と聞いたみたいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300305
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 140300305,
					"content": "その、真実を知ってさ、すごく内心複雑だったんじゃないか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140300306,
					"content": "うん…でもあの夜の出来事を理解したとき、やっぱり先生らしいなって思ったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300307
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 140300307,
					"content": "自分が犠牲になるのを黙ってたこともか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140300308,
					"content": "病気に効く薬であれば、嘘をついてでも子供に飲ませる…それが先生なのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300309,
						140300310
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 140300309,
					"content": "本当に偉大な医者なんだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140300311
					]
				},
				{
					"id": 140300311,
					"content": "そっか…でも、なんでシグウィンは自首したんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140300312,
					"content": "法を犯したからには、罰を受けるべきよ。先生は自分の選択をしたんだから、ウチも自分の選択をしただけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300313
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 140300313,
					"content": "それはそうなんだろうけどさ…ただ、ポトンがシグウィンを問い詰めてたとき、オイラ本当に頭に来たんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300314
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140300314,
					"content": "シグウィンがあいつと同じなわけないだろ？ヌヴィレットから真実を教えてもらって、なおさらそう思ったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300315
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140300315,
					"content": "でも結局、シグウィンも同じように有罪判決を受けて監獄に送られた…そう思うと、なんだかやるせなくって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300316
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140300316,
					"content": "パイモンちゃん、その逆よ。もしあの服役経験がなかったら、ポトンさんの質問に動じることなく対応できなかったかもしれないもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300317
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 140300317,
					"content": "えっ？どうしてそう思うんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300318
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140300318,
					"content": "パイモンちゃんも旅人も知りたいみたいね。なら、その理由を教えてあげるのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300319
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 140300319,
					"content": "うんうん、これこそオイラが望んでた結末だぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300320
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140300320,
					"content": "ポトンさんの告白を聞いて、ずっと彼に伝えたかったの。ポトンかラワットかなんて、実はそれほど重要じゃないってね。でも遅かった。彼の手の平のぬくもりは、もう消えちゃってたから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300321
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 140300321,
					"content": "彼を治療したいと思ったけど、その病気の根源は顔じゃなかったのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300322,
						140300323
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 140300322,
					"content": "彼のことを気の毒に思う必要はない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140300324
					]
				},
				{
					"id": 140300324,
					"content": "キミもパイモンちゃんも、ウチを慰めてくれてるのよね。ありがと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300325
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 140300325,
					"content": "気にすんなって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300326
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140300326,
					"content": "実は、キミたちを呼んだ理由はもう一つあるの。まだ約束の報酬を渡してなかったでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300327
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 140300327,
					"content": "マレショーセ·ファントムから特別に許可をもらって、あの薬の改良版をいくつか調合したの。顔を入れ替えられた囚人を元に戻すためにね。キミたちの分も一本とっておいたのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300328
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 140300328,
					"content": "えっ？オイラたちには必要ないし、処分しといたほうがいいんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300329
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140300329,
					"content": "これをどうするかは、キミたちが決めるべきだと思ったの。それに旅人とパイモンちゃんはたくさん頑張ってくれたし、約束を破るわけにはいかないでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300330
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 140300330,
					"content": "そうかもしれないけど、さすがにちょっと使うのは気が引けるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300331
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140300331,
					"content": "いや、でもこれってもうテイワットに一本しかないんだよな？このまま処分するのはちょっともったいない気がするぞ。なにかいい使い道は…あっ、そうだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300332
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140300332,
					"content": "メリュジーヌの体質はあの大洪水で変わってないし、まだこの薬の効果をちゃんと受けられるってことだよな。なら、シグウィンを元の姿に戻すってのはどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300333
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140300333,
					"content": "だって、メリュジーヌからしたらやっぱり、元の姿のほうが可愛いだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300334
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140300334,
					"content": "パイモン…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140300335
					]
				},
				{
					"id": 140300335,
					"content": "パイモンちゃん、人間かメリュジーヌか、そんなに重要かしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300336
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 140300336,
					"content": "それは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300337
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140300337,
					"content": "…オイラ、なに言ってんだろ。シグウィンはとっくに答えを出してたってことか。じゃあ、これは今すぐ処分しようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300338
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140300338,
					"content": "ええ、任せてちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 140300323,
					"content": "確かに、少し気の毒だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140300324
					]
				},
				{
					"id": 140300310,
					"content": "本当に変わった医者なんだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140300311
					]
				}
			]
		},
