			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ヌヴィレット",
					"リオセスリ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 140305101,
					"content": "昨日の脱獄事件だが、マレショーセ·ファントムを代表し、メロピデ要塞の協力に改めて感謝する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140305102
					],
					"speakerTitle": "ヌヴィレット"
				},
				{
					"id": 140305102,
					"content": "ま、主に看護師長、それから旅人とパイモンのおかげだがな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140305103
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140305103,
					"content": "シグウィンが元気なところを見るに、最近は仕事が忙しくないのだろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140305104
					],
					"speakerTitle": "ヌヴィレット"
				},
				{
					"id": 140305104,
					"content": "ああ。メロピデ要塞に長期駐留してる医療スタッフは彼女だけだが、中には医学の知識があって、手伝ってくれる人もたくさんいるんでね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140305105
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140305105,
					"content": "その言葉を聞いて、安心した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140305106
					],
					"speakerTitle": "ヌヴィレット"
				},
				{
					"id": 140305106,
					"content": "ふっ、看護師長のことをそうやって気にかけてる姿を見ると、まるで本当の親みたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140305107
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140305107,
					"content": "実際のところ、以前からずっとそう思っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140305108
					],
					"speakerTitle": "ヌヴィレット"
				},
				{
					"id": 140305108,
					"content": "あんたの年齢を実感させられるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140305109
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140305109,
					"content": "ああ。実は君よりずっと年上だということを私もよく忘れてしまう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140305110
					],
					"speakerTitle": "ヌヴィレット"
				},
				{
					"id": 140305110,
					"content": "そういえば、審判官になる前は何をやってたんだ？毎日海に潜って、西から東へ、北から南へ泳いでたとか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140305111
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140305111,
					"content": "ああ…それと…時に上から下へ泳ぐこともあった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140305112
					],
					"speakerTitle": "ヌヴィレット"
				},
				{
					"id": 140305112,
					"content": "ほう、そりゃすごい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140305113
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140305113,
					"content": "…すまない。今のは冗談だ。本気にしないでくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140305114
					],
					"speakerTitle": "ヌヴィレット"
				},
				{
					"id": 140305114,
					"content": "くくっ、大丈夫だ。俺は想像力が豊かだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リオセスリ"
				}
			]
		},
