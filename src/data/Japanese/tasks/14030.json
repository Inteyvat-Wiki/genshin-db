			},
			"dialogs": [
				{
					"id": 140300201,
					"content": "あれ？ヌヴィレットとリオセスリがいるぞ！あいつら、どうしてここにいるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140300202,
					"content": "旅人、パイモン、ごきげんよう。息災であっただろうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300203
					],
					"speakerTitle": "ヌヴィレット"
				},
				{
					"id": 140300203,
					"content": "最高審判官が重要な用事で出かけるなんて、新聞の一面を飾れるんじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300204
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140300204,
					"content": "ほう。人々はこのようなことに興味を示すのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300205
					],
					"speakerTitle": "ヌヴィレット"
				},
				{
					"id": 140300205,
					"content": "違うか？なんてったって「重要な用事」だろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300206
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140300206,
					"content": "ふむ…確かに。大切な人が心の支えを必要とするとき、適切な時間と場所に現れるのは非常に重要なことだと言える。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300256
					],
					"speakerTitle": "ヌヴィレット"
				},
				{
					"id": 140300256,
					"content": "マレショーセ·ファントムの報告を受け、ここに来なければならないと思ったのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300207
					],
					"speakerTitle": "ヌヴィレット"
				},
				{
					"id": 140300207,
					"content": "見ろ、これがヌヴィレットさんの思いやりってやつさ。そんなわけで俺たちはここに来た——看護師長に付き添って、彼女の先生の墓参りをするためにな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300208
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140300208,
					"content": "ってことは、シグウィンが弔うって言ってた人は、あいつの先生のことだったのか。確か「魔女婆さん」って人だよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140300209,
					"content": "あっ、ごめん、悪気はないんだ。ただシグウィンがずっとそう呼んでだから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140300210,
					"content": "看護師長にとって、それは気に障る呼び方じゃないはずだ。気にしなくていいだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300211
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140300211,
					"content": "ああ。むしろシグウィンからすれば、親しみを込めた呼び方と言える。その医者のことは何度かシグウィンから聞いたが、とても寛大な方のようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300212
					],
					"speakerTitle": "ヌヴィレット"
				},
				{
					"id": 140300212,
					"content": "人間の大半がメリュジーヌを差別していた時代、あの方だけがシグウィンの先生になってくれた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300213
					],
					"speakerTitle": "ヌヴィレット"
				},
				{
					"id": 140300213,
					"content": "へへっ、ヌヴィレットもリオセスリもやっぱり優しいんだな！職場の後輩への思いやりってやつか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140300214,
					"content": "職場の後輩？とんでもない。せいぜいヌヴィレットさんの後輩っていうのが妥当だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300215
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140300215,
					"content": "看護師長は数百年前、メロピデ要塞に服役してたんだ。刑期が終わった後も、彼女はメロピデ要塞に残り、その管理体制における中核メンバーとなった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300216
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140300216,
					"content": "厳密に言うと、メロピデ要塞にいるほとんどのやつが看護師長の後輩さ。この俺も含めてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300217
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140300217,
					"content": "服役？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140300218,
					"content": "シグウィンは何か罪を犯したの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140300219
					]
				},
				{
					"id": 140300219,
					"content": "ああ。私が最高審判官に就任する前から、フォンテーヌにはある古い法律があってね。それが「他の種を人類に転化させる行為を禁ずる」というものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300220
					],
					"speakerTitle": "ヌヴィレット"
				},
				{
					"id": 140300220,
					"content": "最初私は、大半の研究員同様こう考えていた——これは科学倫理を規定するための法律だと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300221
					],
					"speakerTitle": "ヌヴィレット"
				},
				{
					"id": 140300221,
					"content": "だが今思い返せば、これは民が真実を知ることなく、より純粋で幸福な人生を享受できるよう、エゲリアがかけた保険だったのだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300222
					],
					"speakerTitle": "ヌヴィレット"
				},
				{
					"id": 140300222,
					"content": "ああ、無知は幸せってやつだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300223
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140300223,
					"content": "たとえ事情があったにせよ、シグウィンは人間の姿になったことで法に抵触した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300224
					],
					"speakerTitle": "ヌヴィレット"
				},
				{
					"id": 140300224,
					"content": "えっと、一体なにがあったんだ？教えてくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300225
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140300225,
					"content": "ふむ、いいだろう。シグウィンは友人に過去を知られることを厭わないだろうからな。あの時、彼女は自ら私にすべてを打ち明けてくれた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300226
					],
					"speakerTitle": "ヌヴィレット"
				},
				{
					"id": 140300226,
					"content": "娘の病気がひどいというのに、お主を家に入れなかったのかい？なんて頑固な連中じゃ…人の偏見も、わしには治せない病気の一つじゃな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300227
					],
					"speakerTitle": "「魔女婆さん」"
				},
				{
					"id": 140300227,
					"content": "はぁ…残念じゃが、わしにはもうそこへ駆け付ける余力がない。なんと嘆かわしい魔女じゃ。すべてのフォンテーヌ人を救おうと思っておったのに、今苦しんでいる患者さえも救えぬとは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300228
					],
					"speakerTitle": "「魔女婆さん」"
				},
				{
					"id": 140300228,
					"content": "先生、どうしたのそれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300229
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 140300229,
					"content": "フォンテーヌにはおそらく、誰もが罹ってる奇病が存在する。目撃者も証拠もないし、誰も信じてはくれぬじゃろうがな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300230
					],
					"speakerTitle": "「魔女婆さん」"
				},
				{
					"id": 140300230,
					"content": "じゃから、自分の身体を使って治療法を探すほかなかった。ただ結果は芳しくなく、この有り様じゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300231
					],
					"speakerTitle": "「魔女婆さん」"
				},
				{
					"id": 140300231,
					"content": "じゃあ…まずは先生を治さないと。そしたら、先生があの子を治療できるでしょ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300232
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 140300232,
					"content": "いや…自分の状況は分かっておるつもりじゃ。わしの身体はお主じゃ治せん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300233
					],
					"speakerTitle": "「魔女婆さん」"
				},
				{
					"id": 140300233,
					"content": "先生…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300234
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 140300234,
					"content": "前にも言ったように、医者の最大の責務は、治せる病気を治すことじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300235
					],
					"speakerTitle": "「魔女婆さん」"
				},
				{
					"id": 140300235,
					"content": "うん…でも、あの人たちはウチのことを全然信じてくれないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300236
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 140300236,
					"content": "ゴホッ、ゴホッ…そういえば、あの女の子はシグウィンの初めての患者じゃったな。なら、どうしても治してあげたいじゃろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300237
					],
					"speakerTitle": "「魔女婆さん」"
				},
				{
					"id": 140300237,
					"content": "うん、そのためなら何でもする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300238
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 140300238,
					"content": "たとえ法を犯し、罰を受けることになってもか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300239
					],
					"speakerTitle": "「魔女婆さん」"
				},
				{
					"id": 140300239,
					"content": "…誰かを傷つけないなら、何でもするよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300240
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 140300240,
					"content": "ふふっ、さすがわしの弟子じゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300241
					],
					"speakerTitle": "「魔女婆さん」"
				},
				{
					"id": 140300241,
					"content": "なら、もう一度賭けてみるとしよう。最後まで治療法を模索してみるから、しばらくここを離れててくれるかい？二時間後にまた来ておくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300242
					],
					"speakerTitle": "「魔女婆さん」"
				},
				{
					"id": 140300242,
					"content": "もし奇跡が起これば、わしはすべてのフォンテーヌ人を救う方法を見つけられる。そしてこの身体も、女の子を治せるまで回復するじゃろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300243
					],
					"speakerTitle": "「魔女婆さん」"
				},
				{
					"id": 140300243,
					"content": "もし奇跡が起こらなかったら…治せない病気がまた一つ増える。その時はどうか、わしを探さないでおくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300244
					],
					"speakerTitle": "「魔女婆さん」"
				},
				{
					"id": 140300244,
					"content": "シグウィンへ贈りものを残そう。病気の研究中に偶然発見したものじゃ。大したものではないが、少なくともお主の患者を治療するのに役立つじゃろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300245
					],
					"speakerTitle": "「魔女婆さん」"
				},
				{
					"id": 140300245,
					"content": "シグウィンが戻ってきた時、奇跡は起こっていなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300246
					],
					"speakerTitle": "ヌヴィレット"
				},
				{
					"id": 140300246,
					"content": "机に残されていたのは、一本の薬と一枚のメモ。そのメモの通りに薬を使うと、シグウィンは今の姿となっていた。そして、フォンテーヌの法にも触れてしまったのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300247
					],
					"speakerTitle": "ヌヴィレット"
				},
				{
					"id": 140300247,
					"content": "私はその事実に基づき、彼女に審判を下した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300248
					],
					"speakerTitle": "ヌヴィレット"
				},
				{
					"id": 140300248,
					"content": "そうだったのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300256
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140300249,
					"content": "先生は自分を犠牲にして…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140300251
					]
				},
				{
					"id": 140300250,
					"content": "薬を残した。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140300251
					]
				},
				{
					"id": 140300251,
					"content": "恐らく、フォンテーヌ人が溶けることが分かり、その真相が明らかになってようやく、シグウィンも理解したのだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300252
					],
					"speakerTitle": "ヌヴィレット"
				},
				{
					"id": 140300252,
					"content": "私はそのすべてを知ったとき、実に嘆かわしく思った…法の公正さを守ると同時に、その無情さも受け入れなければならないのかと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300253
					],
					"speakerTitle": "ヌヴィレット"
				},
				{
					"id": 140300253,
					"content": "幸い、フォンテーヌの法律によると、隠されていた真実によってシグウィンがさらなる刑を負うことはない。この点については、何度も確認してある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300254
					],
					"speakerTitle": "ヌヴィレット"
				},
				{
					"id": 140300254,
					"content": "シグウィンはどんな気持ちだったんだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300255
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140300255,
					"content": "君たちをここに招いた以上、シグウィンは過去を打ち明ける覚悟ができているのだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヌヴィレット"
				}
			]
		},
