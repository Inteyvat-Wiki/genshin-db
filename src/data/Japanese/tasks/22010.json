			},
			"dialogs": [
				{
					"id": 220100801,
					"content": "同心たちは花見坂の平和を守っていて、怪しい人物は彼らの監視から逃げられない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100802
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100802,
					"content": "敵国の騎士は同心と同じ責任を担っている。じゃあ、もっと面白くするために、同心の…十倍の強さに設定しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100803,
						220100805
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100803,
					"content": "いくら何でも強すぎる！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100804
					]
				},
				{
					"id": 220100804,
					"content": "そうした方が一番分かりやすいからね。主人公の強さをうまく表現しないと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100806
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100806,
					"content": "主人公がどう対処するかというと…えーと、主人公に偽装能力を与えよう。姿や声を自由に変えられる能力があれば問題ない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100807
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100807,
					"content": "いきなり出てくる設定なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100808
					]
				},
				{
					"id": 220100808,
					"content": "主人公の隠し能力さ。手強い相手に出会ったからこそ、使わざるを得なかったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100809
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100809,
					"content": "その…無理やり過ぎない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100810
					]
				},
				{
					"id": 220100810,
					"content": "そ、そんなことないよ…あらかじめそう考えてたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100811
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100811,
					"content": "よーし、そうしよう。戻って僕の構想を茂さんに教えよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100805,
					"content": "主人公にどう対処させるつもり？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100806
					]
				}
