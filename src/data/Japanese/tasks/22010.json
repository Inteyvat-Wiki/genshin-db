				"points": []
			},
			"dialogs": [
				{
					"id": 220100701,
					"content": "「九十九物」には色んな商品が並んでいるんだね。冒険中に収集できるアイテムとよく似ている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100702
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100702,
					"content": "葵さんはいつも「どんなに素朴な見た目の品でも、必ず買い手が見つかる」って言ってた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100703
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100703,
					"content": "うん…買い手が評価する要素を見つけることが、商品を高く売るために必要なポイントのようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100704
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100704,
					"content": "でもこんな風に書いちゃうと、心理戦の描写に力を入れる必要がある。『鬼武道』のテーマとはちょっと相容れないかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100705
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100705,
					"content": "主人公に読心術を持たせることにしよう。そうすれば、買い手の需要を見極められる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100706,
						220100708
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100706,
					"content": "設定をいきなり加えていいのかな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100707
					]
				},
				{
					"id": 220100707,
					"content": "これこそが人の「成長」さ、大丈夫だって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100710
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100710,
					"content": "思いついた、どう書けばいいか分かったよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100711
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100711,
					"content": "戻ろうよ、旅人。僕の構想を茂さんに教えてあげないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100708,
					"content": "筋を通さなくていいの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100709
					]
				},
				{
					"id": 220100709,
					"content": "筋を通す…うん、それは書く時に考えておくから、問題ないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100710
					],
					"speakerTitle": "順吉"
				}
			]
		},
