					"speakerTitle": "順吉"
				},
				{
					"id": 220100202,
					"content": "彼にはもっと強力な武器が必要で、そうだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100203
					],
