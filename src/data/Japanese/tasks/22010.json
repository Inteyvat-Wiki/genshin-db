					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220101105
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220101105,
					"content": "おい…またそんなマネをするのかよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220101106,
						220101107
					],
					"speakerTitle": "茂"
				},
				{
					"id": 220101106,
					"content": "また？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220101108
					]
				},
				{
					"id": 220101108,
					"content": "お前な！また無理やり設定を加えるつもりなのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220101109
					],
					"speakerTitle": "茂"
				},
				{
					"id": 220101109,
					"content": "新しい章を書き終えるために、とにかく設定を一つ加えて、その設定の筋道を立たせるために、さらに複雑な設定を加える。そうだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220101110
					],
					"speakerTitle": "茂"
				},
				{
					"id": 220101110,
					"content": "どんなにその登場人物が好きだと言っても、無理やり設定を加えるのはやめてくれ！読者が目を回してしまうぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220101111
					],
					"speakerTitle": "茂"
				},
				{
					"id": 220101111,
					"content": "僕はいつもそういう作風じゃないか。そうした方がキレのある物語になるし、ファンもきっと喜んでくれる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220101112
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220101112,
					"content": "でたらめを言うな！お前のむちゃくちゃな設定のせいで、読者はもう混乱してきているんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220101113
					],
					"speakerTitle": "茂"
				},
				{
					"id": 220101113,
					"content": "考え方が古い君とはもう話したくないね。ちょうどいいから、旅人に判断してもらおうよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220101114
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220101114,
					"content": "旅人、僕と茂さんのどっちが正しいと思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "順吉"
				},
				{
					"id": 220101107,
					"content": "どんなマネ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220101108
					]
				}
			]
		},
