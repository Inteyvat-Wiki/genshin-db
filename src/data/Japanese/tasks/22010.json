				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220100601,
					"content": "火花が飛び散り、金槌と鉄床がぶつかり合う…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100602
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100602,
					"content": "「天目鍛冶屋」は情熱に満ちた場所だね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100603
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100603,
					"content": "鍛冶屋は簡単な道具だけで、粗雑な原型と鉱石を優れた武器に変えることができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100604
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100604,
					"content": "もし鍛造の過程で、さらに錬金術を加えれば、壊れることのない神器でさえも生み出せるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100605,
						220100606
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100605,
					"content": "錬金術はそんなに神がかっていない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100608
					]
				},
				{
					"id": 220100608,
					"content": "うん！いいアイデアだ、主人公に…錬金術で鍛造した最強の武器を与えるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100609
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100609,
					"content": "そして、その武器にカッコイイ名前と…物語を与えてあげないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100610
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100610,
					"content": "間違いない、そうしよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100611
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100611,
					"content": "戻ろうよ、旅人。僕の構想を茂さんに教えてあげないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100606,
					"content": "錬金術を誤解しているようだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100607
					]
				},
				{
					"id": 220100607,
					"content": "誤解？誤解って何？錬金術って…不可能を可能にする技術じゃないの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100608
					],
					"speakerTitle": "順吉"
				}
			]
		},
		{
