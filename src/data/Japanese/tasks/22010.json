			},
			"dialogs": [
				{
					"id": 220100922,
					"content": "茂の方が合理的だと思う…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100923
					]
				},
				{
					"id": 220100923,
					"content": "合理的？合理性よりも爽快感ある物語の方が重要だろ？物語で人を魅了できなかったら、いくら合理性があっても退屈になるだけだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100924
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100924,
					"content": "お前なぁ…一時的に盛り上がったとしても、無理して設定を加えると、物語の終盤で自分を追い込んでしまう羽目になるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100925
					],
					"speakerTitle": "茂"
				},
				{
					"id": 220100925,
					"content": "そ、そこは記録しておいたから、終盤も問題ない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100926
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100926,
					"content": "ほら、記録しておかないと自分でも覚えられないんだろう？読者にもメモを取りながら読んでもらうつもりなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100927
					],
					"speakerTitle": "茂"
				},
				{
					"id": 220100927,
					"content": "ぐぅ…それは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100928
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100928,
					"content": "設定を加えてはいけないって訳じゃないが、加えるにしても、方法や頻度を慎重に考えるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100929
					],
					"speakerTitle": "茂"
				},
				{
					"id": 220100929,
					"content": "小説を書くということは、結局は体力勝負なんだ。最初に頑張りすぎると、終盤は手に負えなくなる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100930
					],
					"speakerTitle": "茂"
				},
				{
					"id": 220100930,
					"content": "一歩一歩着実に進めて初めて、いい小説が完成するんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100931
					],
					"speakerTitle": "茂"
				},
				{
					"id": 220100931,
					"content": "わ、分かったよ…うぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "順吉"
				}
			]
