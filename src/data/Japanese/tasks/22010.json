			"dialogs": [
				{
					"id": 220100301,
					"content": "僕が今考えてる章では、主人公は冒険の途中で集めた物を売って、お金を貯めてるところなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100302
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100302,
					"content": "そうすると、色んな買い手と取引しないといけなくなる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100303
					],
					"speakerTitle": "順吉"
				},
				{
