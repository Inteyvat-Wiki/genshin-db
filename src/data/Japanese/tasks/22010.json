				"points": []
			},
			"dialogs": [
				{
					"id": 220100101,
					"content": "順吉、提出締め切りは明日だ。絶対に遅れるなよ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100102
					],
					"speakerTitle": "茂"
				},
				{
					"id": 220100102,
					"content": "焦ってもしょうがないよ。肝心なところで行き詰まっていて、物語をどう進めたらいいか分からないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100103
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100103,
					"content": "何か揉めてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100104
					]
				},
				{
					"id": 220100104,
					"content": "た…旅人か？丁度いいところに来た、客観的な意見を聞かせてくれないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100105
					],
					"speakerTitle": "茂"
				},
				{
					"id": 220100105,
					"content": "僕は「八重堂」で編集者をしている茂だ。彼は僕が担当している作家の順吉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100106
					],
					"speakerTitle": "茂"
				},
				{
					"id": 220100106,
					"content": "彼の新しい小説『鬼武道』は人気があるんだが、いつも締め切りに間に合わなくて、数週間遅れることもある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100107
					],
					"speakerTitle": "茂"
				},
				{
					"id": 220100107,
					"content": "今回もやっちまったんだ。明日中に提出しないと、今月の合併号の印刷が間に合わなくなってしまう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100108
					],
					"speakerTitle": "茂"
				},
				{
					"id": 220100108,
					"content": "最悪の場合、発売を延期するしかないよ。ファンの人はそれでも買ってくれるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100109
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100109,
					"content": "冗談じゃない。もし連載を続けられなかったら、小説の評価はガタ落ちだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100110
					],
					"speakerTitle": "茂"
				},
				{
					"id": 220100110,
					"content": "でも本当にアイデアが湧かないんだ。水増しした内容を書くよりも、面白い物語をじっくり考えた方がいいと思うんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100111
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100111,
					"content": "だが他の作家はちゃんと提出済みで、間に合ってないのは君だけなんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100112
					],
					"speakerTitle": "茂"
				},
				{
					"id": 220100112,
					"content": "順吉さんは刺激が足りないんだと思う…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100113
					]
				},
				{
					"id": 220100113,
					"content": "そう！君は、僕を理解してくれるんだね。そう、刺激が必要なんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100114
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100114,
					"content": "刺激を求めてどこかへ旅にでも出れば、何を書けばいいのか分かるかもしれない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100115
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100115,
					"content": "おい、前回もそんな言い訳をして、一日遅らせたよな。またやるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100116
					],
					"speakerTitle": "茂"
				},
				{
					"id": 220100116,
					"content": "今回は言い訳じゃない、一回ぐらい信じてくれよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100117
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100117,
					"content": "まったく…分かった、二度目はないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100118
					],
					"speakerTitle": "茂"
				},
				{
					"id": 220100118,
					"content": "これ以上の延期はもう許されないからな、分かったな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100119
					],
					"speakerTitle": "茂"
				},
				{
					"id": 220100119,
					"content": "わ、分かったよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100120
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100120,
					"content": "ふぅ…今回は本当に遅れるわけにはいかなさそうだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100121,
						220100122
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100121,
					"content": "早速刺激になりそうなものを探しに行こう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220100122,
					"content": "アイデア探しに行こう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100123
					]
				},
				{
					"id": 220100123,
					"content": "そう言われても、アイデアってのはそう簡単に見つからないんだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100124
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100124,
					"content": "でも今はあっちこっち探してみるしかないな。さもないとまた茂さんに怒られる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "順吉"
				}
			]
		},
