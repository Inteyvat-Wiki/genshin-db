					"グッドウィン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200370101,
					"content": "…はあ、このままモンドに帰りたいな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370102
					],
					"speakerTitle": "グッドウィン"
				},
				{
					"id": 200370102,
					"content": "あっ、旅人！えっと、一つ手伝ってくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370103
					],
					"speakerTitle": "グッドウィン"
				},
				{
					"id": 200370103,
					"content": "見ての通り、俺は西風騎士で、今野外で見回り任務を行っているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370104
					],
					"speakerTitle": "グッドウィン"
				},
				{
					"id": 200370104,
					"content": "手紙を送って無事を伝えると、恋人と約束したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370105
					],
					"speakerTitle": "グッドウィン"
				},
				{
					"id": 200370105,
					"content": "忙しくて忘れてしまってね、ハハッ…この<color=#00E1FFFF>手紙</color>を彼女に届けてくれないか？彼女は<color=#00E1FFFF>グローリー</color>というんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370106
					],
					"speakerTitle": "グッドウィン"
				},
				{
					"id": 200370106,
					"content": "待って、グローリー？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370107
					]
				},
				{
					"id": 200370107,
					"content": "あの目が見えない…蒲公英を集めてる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 200370108,
					"content": "おい、グローリーが言ってたグッドウィンっておまえだったのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 200370109,
					"content": "えっ？グローリーとは知り合いなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370110
					],
					"speakerTitle": "グッドウィン"
				},
				{
					"id": 200370110,
					"content": "彼女を手伝ったことがある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370111
					]
				},
				{
					"id": 200370111,
					"content": "て、手伝う？なにか危険なことでもしていたのか？君たち…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370112
					],
					"speakerTitle": "グッドウィン"
				},
				{
					"id": 200370112,
					"content": "グローリーに蒲公英を集めてほしいって言われたんだ。空に蒔けば、願いがおまえに届くって言ってたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 200370113,
					"content": "ああ、蒲公英…確かにグローリーがしそうなことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370114
					],
					"speakerTitle": "グッドウィン"
				},
				{
					"id": 200370114,
					"content": "モンドから離れたんじゃないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370115
					]
				},
				{
					"id": 200370115,
					"content": "本来ならそうだった。いい…話そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370116
					],
					"speakerTitle": "グッドウィン"
				},
				{
					"id": 200370116,
					"content": "大団長が五分の四の騎士を連れてモンドを出たことは知ってるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370117
					],
					"speakerTitle": "グッドウィン"
				},
				{
					"id": 200370117,
					"content": "ああ、俺もその一員だ…しかし出征する前に、グローリーからもらったものをなくしてしまって、探してたら置いて行かれたんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370118
					],
					"speakerTitle": "グッドウィン"
				},
				{
					"id": 200370118,
					"content": "戻る方法もないから、この辺をうろうろするしかないんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370119
					],
					"speakerTitle": "グッドウィン"
				},
				{
					"id": 200370119,
					"content": "モンドに戻ることもできないんだ。このまま帰ったら、西風騎士たちが俺をどう見るか…。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370120
					],
					"speakerTitle": "グッドウィン"
				},
				{
					"id": 200370120,
					"content": "それとグローリーのこともだ。世界各地から手紙とプレゼントを送って、「世界」を彼女にあげるって約束したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370121
					],
					"speakerTitle": "グッドウィン"
				},
				{
					"id": 200370121,
					"content": "モンドから出てないって分かったら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370122
					],
					"speakerTitle": "グッドウィン"
				},
				{
					"id": 200370122,
					"content": "そういう問題か",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 200370123,
					"content": "頼む！この<color=#00E1FFFF>手紙</color>を<color=#00E1FFFF>グローリー</color>に届けてくれないか？きっと俺の心配をしてるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370124,
						200370126
					],
					"speakerTitle": "グッドウィン"
				},
				{
					"id": 200370124,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370125
					]
				},
				{
					"id": 200370125,
					"content": "頼んだよ、旅人。あとこのことは内緒にしてほしい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "グッドウィン"
				},
				{
					"id": 200370126,
					"content": "蒲公英を使えばいいと思う…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370127
					]
				},
				{
					"id": 200370127,
					"content": "グローリーに話したいことがたくさんあるんだ。蒲公英に乗せたら飛べなくなるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370128
					],
					"speakerTitle": "グッドウィン"
				},
				{
					"id": 200370128,
					"content": "手紙のことは頼んだ。それとこの件は内緒で頼む！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "グッドウィン"
				}
			]
		},
