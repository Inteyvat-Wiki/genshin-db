			"dialogs": [
				{
					"id": 200370301,
					"content": "こんにちは…あっ、この声は、旅人ですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370302
					],
					"speakerTitle": "グローリー"
				},
				{
					"id": 200370302,
					"content": "何かご用でしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370303
					],
					"speakerTitle": "グローリー"
				},
				{
					"id": 200370303,
					"content": "手紙を届けにきた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370304
					]
				},
				{
					"id": 200370304,
					"content": "手紙？誰が私に手紙を…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370305
					],
					"speakerTitle": "グローリー"
				},
				{
					"id": 200370305,
					"content": "まさかグッドウィンですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370306
					],
					"speakerTitle": "グローリー"
				},
				{
					"id": 200370306,
					"content": "彼に会ったんですか？彼は大丈夫ですか？いつ帰ってくるんですか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370307
					],
					"speakerTitle": "グローリー"
				},
				{
					"id": 200370307,
					"content": "ごめんなさい、彼は忙しいですよね。私が言ったことは忘れて、もう彼にプレッシャーを与えたくありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370308
					],
					"speakerTitle": "グローリー"
				},
				{
					"id": 200370308,
					"content": "この手紙を読んでくれませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370309
					],
					"speakerTitle": "グローリー"
				},
				{
					"id": 200370309,
					"content": "私たちだけが聞こえるくらいの声量でお願いしますよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370310
					],
					"speakerTitle": "グローリー"
				},
				{
					"id": 200370310,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370311
					]
				},
				{
					"id": 200370311,
					"content": "上手ですね…よく、手紙を人に読んであげているのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370312
					],
					"speakerTitle": "グローリー"
				},
				{
					"id": 200370312,
					"content": "手紙はここまでだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370313
					]
				},
				{
					"id": 200370313,
					"content": "璃月港…グッドウィンは遠いところまで行きましたね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370314
					],
					"speakerTitle": "グローリー"
				},
				{
					"id": 200370314,
					"content": "ありがとうございます。この手紙は大事にします。また<color=#00E1FFFF>グッドウィン</color>に会ったら、会いたいって伝えてくれると嬉しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370315
					],
					"speakerTitle": "グローリー"
				}
			]
		},
