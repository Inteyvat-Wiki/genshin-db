			"dialogs": [
				{
					"id": 200370501,
					"content": "手紙を届けてくれたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370502
					],
					"speakerTitle": "グッドウィン"
				},
				{
					"id": 200370502,
					"content": "グローリーが会いたいと言っている。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370503
					]
				},
				{
					"id": 200370503,
					"content": "ふう…こんなに長く連絡してないのに、怒ってなくてよかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370504
					],
					"speakerTitle": "グッドウィン"
				},
				{
					"id": 200370504,
					"content": "ずっとモンドの近くにいたのに、どうして璃月港のことが分かるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 200370505,
					"content": "ああ、それか…大団長から話を聞いたんだ。大団長はいろんな場所に行ったことがあるからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370506
					],
					"speakerTitle": "グッドウィン"
				},
				{
					"id": 200370506,
					"content": "ありがとう、助かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370507
					],
					"speakerTitle": "グッドウィン"
				},
				{
					"id": 200370507,
					"content": "この蒲公英を君たちに渡すよ。全部俺が取ってきたものだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370508
					],
					"speakerTitle": "グッドウィン"
				},
				{
					"id": 200370508,
					"content": "今度グローリーがまた蒲公英がほしいと言い出したら、どうか手伝ってあげてほしい。頼む。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "グッドウィン"
				}
			]
		}
	]
