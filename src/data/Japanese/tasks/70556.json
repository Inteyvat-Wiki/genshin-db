					}
				]
			},
			"dialogs": [
				{
					"id": 705560101,
					"content": "来てくれたんだね。旅人、パイモン。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560102
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 705560102,
					"content": "まずは新しい同僚を紹介するね。こっちが第7小隊の信号官イェーガーで、そっちが相棒のスイカズラだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560103
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 705560103,
					"content": "初めまして、栄誉騎士、そして白い助手さん。お二人にお会いできて光栄です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560104
					],
					"speakerTitle": "イェーガー"
				},
				{
					"id": 705560104,
					"content": "ほら、スイカズラ、皆さんにご挨拶して。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560105
					],
					"speakerTitle": "イェーガー"
				},
				{
					"id": 705560105,
					"content": "ピュイ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560106,
						705560107
					],
					"speakerTitle": "スイカズラ"
				},
				{
					"id": 705560106,
					"content": "新しい…信号官？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705560108
					]
				},
				{
					"id": 705560108,
					"content": "この大きな鷹、すっごくお利口さんだな！鎧みたいな服を着てるし、バッグも背負ってるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705560109,
					"content": "待ってくれ、オイラちょっとこんがらがってきたぞ…アンバーの言ってた「パフォーマンス」って、どういう意味なんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705560110,
					"content": "イェーガーと、この鷹に関係あるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705560111,
					"content": "えへへっ、簡単に説明してあげる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560112
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 705560112,
					"content": "ジン団長から聞いてると思うけど、風の翼の競走射撃イベントを開催してるんだ…っていうのは、分かりやすく言っただけで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560113
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 705560113,
					"content": "本当は、あんたたちが想像してるのとはちょっと違うかも。今回はどっちかって言うと、「飛行演習と指揮チャレンジ」みたいな感じかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560114
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 705560114,
					"content": "メインは、お馴染みの風の翼での滑翔じゃないんだよね。地上から「スイカズラ」のような空中ユニットに信号を送ることで、いろんな複雑な動きをするように誘導して、標的の魔物を倒すんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560115
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 705560115,
					"content": "みんなに、ちょっとしたサプライズを届けられる新鮮な体験ってわけ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560116
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 705560116,
					"content": "ピューイ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560117,
						705560118
					],
					"speakerTitle": "スイカズラ"
				},
				{
					"id": 705560117,
					"content": "自分で飛ばずに、鷹の指揮をするの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705560119
					]
				},
				{
					"id": 705560119,
					"content": "その通りです。今回の飛行チャレンジは技術演習の一環でもあります。騎士団の偵察力の発展の方向性を、同僚たちに示すのが目的なんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560120
					],
					"speakerTitle": "イェーガー"
				},
				{
					"id": 705560120,
					"content": "すべての騎士がアンバー先輩のように、滑翔中に敵の状況を正確に捕捉し、簡潔に記録できるわけではありませんから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560121
					],
					"speakerTitle": "イェーガー"
				},
				{
					"id": 705560121,
					"content": "そこで私とスイカズラの使命は、規則をしっかり作り、一般的な騎士と訓練されたモンドの鷹を連携させ、「空中の目」を運用することです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560122
					],
					"speakerTitle": "イェーガー"
				},
				{
					"id": 705560122,
					"content": "そうすれば、優れた偵察騎士が不在でも長時間にわたって敵情を把握し、安定した行軍を続けることができます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560123
					],
					"speakerTitle": "イェーガー"
				},
				{
					"id": 705560123,
					"content": "さらに、スイカズラに装備された武器によって、比較的弱い空中の魔物を事前に排除することも可能です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560124
					],
					"speakerTitle": "イェーガー"
				},
				{
					"id": 705560124,
					"content": "す、すごい専門的な感じだな？なんだか、話し方がエンジニアみたいだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705560125,
					"content": "気楽にして、イェーガー。フレデリカおばさんの前みたいに堅くならなくていいんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560126
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 705560126,
					"content": "栄誉騎士とパイモンは、新しく知り合った動物の仲間と一緒に遊ぶつもりでいればいいよ。楽しむことが一番だからね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560127
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 705560127,
					"content": "すみません、先輩。ただ…興奮が抑えきれなくて。私とスイカズラは、この演習のためにずっと練習を繰り返してきましたから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560128
					],
					"speakerTitle": "イェーガー"
				},
				{
					"id": 705560128,
					"content": "栄誉騎士と白い助手さんに認めていただければ、規則はほぼ完成したと言えます。あと少し手を加えれば、運用を開始できるはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560129
					],
					"speakerTitle": "イェーガー"
				},
				{
					"id": 705560129,
					"content": "もちろん、演習中に機械の故障が発生するかもしれませんが…それは以前の訓練の強度が高すぎて、一部の部品の寿命が尽きてしまったからです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560130
					],
					"speakerTitle": "イェーガー"
				},
				{
					"id": 705560130,
					"content": "消耗品が揃い、それらを全部交換したら、本番の作戦中にスイカズラのバッグに不備は絶対に発生しません。どうかご安心ください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560131
					],
					"speakerTitle": "イェーガー"
				},
				{
					"id": 705560131,
					"content": "ピューイ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560132,
						705560133
					],
					"speakerTitle": "スイカズラ"
				},
				{
					"id": 705560132,
					"content": "多少厳しくいくけど、責めたりはしないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705560134
					]
				},
				{
					"id": 705560134,
					"content": "じゃ、じゃあオイラも心して取り掛かるぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560135
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705560135,
					"content": "えへへっ、みんなやる気満々みたいだね。じゃあ、みんな楽しんできて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アンバー"
				},
				{
					"id": 705560133,
					"content": "大丈夫、難癖はつけないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705560134
					]
				},
				{
					"id": 705560118,
					"content": "#{M#俺たち}{F#私たち}は動かず、ただ指示を出せばいいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705560119
					]
				},
				{
					"id": 705560107,
					"content": "初めて聞く役職…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705560108
					]
				}
			]
		}
	]
}