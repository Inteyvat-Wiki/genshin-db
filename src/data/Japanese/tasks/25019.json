				"points": []
			},
			"dialogs": [
				{
					"id": 250190403,
					"content": "なんと、あなたがあの有名な旅人さんですか！お会いできて実に光栄です！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190404
					],
					"speakerTitle": "グリスパン"
				},
				{
					"id": 250190404,
					"content": "ニャ、ニャニャ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190405
					],
					"speakerTitle": "グロベル"
				},
				{
					"id": 250190405,
					"content": "会長もご機嫌ようと申しております。ここがペトリコール町だったら、上等なお茶をご馳走できたのですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190406
					],
					"speakerTitle": "グリスパン"
				},
				{
					"id": 250190406,
					"content": "今は…あはは…そうですね、お茶もなければ、おしゃべりをする余裕も…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190407
					],
					"speakerTitle": "グリスパン"
				},
				{
					"id": 250190407,
					"content": "ん？おまえたち、なにかあったのか？汗がすごいぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 250190408,
					"content": "ナタは暑いから汗をかくのも仕方ない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250190409
					]
				},
				{
					"id": 250190409,
					"content": "ははっ！愉快なお方ですね！ナタに来てからユーモアのセンスが合ったのはあなただけです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190410
					],
					"speakerTitle": "グリスパン"
				},
				{
					"id": 250190410,
					"content": "しかし、ナタの暑さも私の焦りと比べたら大したものではありません。はぁ…どうしてこうも厄介ごとが続くのでしょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190411
					],
					"speakerTitle": "グリスパン"
				},
				{
					"id": 250190411,
					"content": "十分な燃素も集められず、町からの連絡も途絶えてしまって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190412
					],
					"speakerTitle": "グリスパン"
				},
				{
					"id": 250190412,
					"content": "#{NICKNAME}さん、初対面の方に任務を依頼するのは失礼かと思いますが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190413
					],
					"speakerTitle": "グリスパン"
				},
				{
					"id": 250190413,
					"content": "どうしても頼れる方の助けが必要なんです。今はあなたにお願いするほか手立てがありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "グリスパン"
				}
			]
		},
