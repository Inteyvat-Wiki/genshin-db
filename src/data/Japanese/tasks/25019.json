				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"グリスパン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250190201,
					"content": "ニャ、ニャニャニャ、ニャニャ、ニャン。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190202
					],
					"speakerTitle": "グロベル"
				},
				{
					"id": 250190202,
					"content": "大丈夫ですよ、会長。なるべく手短にご紹介しますから…私のこの止まらない口をどうかお許しください。この口を叱ってくれる別の口は私には無いのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190203
					],
					"speakerTitle": "グリスパン"
				},
				{
					"id": 250190203,
					"content": "簡単に申し上げますと、「燃素」を含んだものを集めてきてほしいんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190204
					],
					"speakerTitle": "グリスパン"
				},
				{
					"id": 250190204,
					"content": "そうですね…えっと、私はいつも「キャンドルキノコ」を使って燃素を抽出しているので、それをいくつか探してくれないでしょうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190206
					],
					"speakerTitle": "グリスパン"
				},
				{
					"id": 250190206,
					"content": "ただ、「エンバーコアフラワー」にも燃素がたくさん含まれていると聞きました…それを持ってきてくださったら、それもまた助かります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190205
					],
					"speakerTitle": "グリスパン"
				},
				{
					"id": 250190205,
					"content": "燃素を十分に抽出できれば、ここで研究を始められます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190206
					],
					"speakerTitle": "グリスパン"
				}
			]
		},
		{
