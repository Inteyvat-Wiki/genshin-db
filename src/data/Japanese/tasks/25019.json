			"dialogs": [
				{
					"id": 250190901,
					"content": "#助けていただきありがとうございます、{NICKNAME}さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190902
					],
					"speakerTitle": "グリスパン"
				},
				{
					"id": 250190902,
					"content": "やっぱり大冒険になりましたね。会長に集落に残っていただいて正解でした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190903
					],
					"speakerTitle": "グリスパン"
				},
				{
					"id": 250190903,
					"content": "会長がここにいたら、私が怒られていましたよ。あの方は急に事件が起きるのが大の苦手ですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190904
					],
					"speakerTitle": "グリスパン"
				},
				{
					"id": 250190904,
					"content": "しかし、結果的に材料を十分採れたわけですし、めでたしめでたしですね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190905
					],
					"speakerTitle": "グリスパン"
				},
				{
					"id": 250190905,
					"content": "#{NICKNAME}さん、これを受け取ってください。改めてご助力に感謝いたします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190906
					],
					"speakerTitle": "グリスパン"
				},
				{
					"id": 250190906,
					"content": "研究が成功したら「熱エネルギー催眠術」の最初の体験者様としてご招待いたしますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "グリスパン"
				}
			]
