			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"グリスパン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250190301,
					"content": "一緒に集めに行こう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250190302
					]
				},
				{
					"id": 250190302,
					"content": "一緒に…？いいんですか？実は、以前から現地調査をしたいと思っていたんです！あなたもいらっしゃるなら怖いものなんてありませんね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190303
					],
					"speakerTitle": "グリスパン"
				},
				{
					"id": 250190303,
					"content": "#では早速行きましょう、{NICKNAME}さん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190304
					],
					"speakerTitle": "グリスパン"
				},
				{
					"id": 250190304,
					"content": "#そうですね…会長はここに残ってください。{NICKNAME}さんがいる限り私の安全は保証されますからどうぞご安心を！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190305
					],
					"speakerTitle": "グリスパン"
				},
				{
					"id": 250190305,
					"content": "ニャ…ニャニャ…ニャ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190306
					],
					"speakerTitle": "グロベル"
				},
				{
					"id": 250190306,
					"content": "おっと…危うく忘れるところでした。場所を地図にマークしておきますね。あそこのキャンドルキノコ、かなりいいんですよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "グリスパン"
				}
			]
		},
