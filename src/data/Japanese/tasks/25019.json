			"dialogs": [
				{
					"id": 250191101,
					"content": "見てください、この「グレインの実」！なんと見事な成長っぷり。もしかして、燃素の影響を受けているとか？採ってサンプルにしましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191102
					],
					"speakerTitle": "グリスパン"
				},
				{
					"id": 250191102,
					"content": "#{NICKNAME}さん、来てくれましたか。少し力を貸してくれませんか？この根っこを…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191103,
						250191104
					],
