			"dialogs": [
				{
					"id": 250190101,
					"content": "これは…エンバーコアフラワーですね。いいですね、きっと役に立ちますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190102
					],
					"speakerTitle": "グリスパン"
				},
				{
					"id": 250190102,
					"content": "ニャ？ニャニャ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190103
					],
					"speakerTitle": "グロベル"
				},
				{
					"id": 250190103,
					"content": "会長、この花はフォンテーヌでは育ちませんよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190104
					],
					"speakerTitle": "グリスパン"
				},
				{
					"id": 250190104,
					"content": "どうしてもと仰るなら…栞にしてはいかがでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "グリスパン"
				}
			]
		},
		{
			"id": 2501902,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
