			"dialogs": [
				{
					"id": 250191201,
					"content": "#{M#君}{F#あなた}は空想クラブに所属してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250191202
					]
				},
				{
					"id": 250191202,
					"content": "あれ？エストたちが「グリスパン」って名前を言ってたような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 250191203,
					"content": "あなた方はクラブに行ったことがあるのですか？ルキナの泉よ、私にもようやく運が回ってきました！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191204
					],
					"speakerTitle": "グリスパン"
				},
				{
					"id": 250191204,
					"content": "すみませんが、クラブに何があったのかご存知ないでしょうか？実は何通も手紙を出したのですが、一向に返信がないのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191216
					],
					"speakerTitle": "グリスパン"
				},
				{
					"id": 250191216,
					"content": "ペトリコール町のことについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250191206
					]
				},
				{
					"id": 250191206,
					"content": "グリスパンにペトリコール町で起きたことを話した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250191207
					]
				},
				{
					"id": 250191207,
					"content": "な、なんと…これは驚きました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191208
					],
					"speakerTitle": "グリスパン"
				},
				{
					"id": 250191208,
					"content": "ニャ…ニャンニャ。ニャ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191209
					],
					"speakerTitle": "グロベル"
				},
				{
					"id": 250191209,
					"content": "ええ、会長、その通りです。本当に驚きました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191215
					],
					"speakerTitle": "グリスパン"
				},
				{
					"id": 250191215,
					"content": "信じられません、これほど超大規模な催眠を逃すなんて…ああ、ルキナの泉よ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191211
					],
					"speakerTitle": "グリスパン"
				},
				{
					"id": 250191211,
					"content": "町にいたら、使える実験データがたくさん取れたことでしょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191212
					],
					"speakerTitle": "グリスパン"
				},
				{
					"id": 250191212,
					"content": "会長、急いで研究を終わらせてクラブの状況を確認しに戻りましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191213
					],
					"speakerTitle": "グリスパン"
				},
				{
					"id": 250191213,
					"content": "#ゴホン。すみませんが{NICKNAME}さん。初対面の方に任務の依頼を出すのは失礼と承知の上なのですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191214
					],
					"speakerTitle": "グリスパン"
				},
				{
					"id": 250191214,
					"content": "どうしても頼れる方の助けが必要なんです。今はあなたにお願いするほか手立てがありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191216
					],
					"speakerTitle": "グリスパン"
				}
			]
