						250190702
					],
					"speakerTitle": "グリスパン"
				},
				{
					"id": 250190702,
					"content": "ニャ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190703
					],
					"speakerTitle": "グロベル"
				},
				{
					"id": 250190703,
					"content": "申し訳ありません、会長。エストとメカントルからの返信はまだないんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190704
					],
					"speakerTitle": "グリスパン"
				},
				{
					"id": 250190704,
					"content": "もしかして町で何かあったのでしょうか…今すぐ帰るわけにもいきませんし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190705
					],
					"speakerTitle": "グリスパン"
				},
				{
					"id": 250190705,
					"content": "その恰好…ナタ人じゃないよね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250190706
					]
				},
				{
					"id": 250190706,
					"content": "あなたもこちらの国の方ではなさそうですね。初めまして、グリスパンと申します。フォンテーヌ空想クラブのメンバーです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190707
					],
					"speakerTitle": "グリスパン"
				},
				{
					"id": 250190707,
					"content": "こちらはクラブの会長…いや、部長…？いずれにせよ、リーダーのグロベルさんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "グリスパン"
				}
			]
