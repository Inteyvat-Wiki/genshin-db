					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610437
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722610437,
					"content": "おまえと一緒に旅をするうちに、色んなことを学べたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610438
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722610438,
					"content": "今回学んだのは…妖狸と仙人は、気が合わないかもしれないってことだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610439
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722610439,
					"content": "よーし、次の目的地を考えないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722610435,
					"content": "確かに、子供の面倒はたくさん見てきた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610436
					]
				},
				{
					"id": 722610436,
					"content": "うん、色んな子供たちと遊んできたよな。冥ちゃんとか、チャンチャンとか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610437
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722610420,
					"content": "吉法師を守る。",
