			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パイモン",
					"「吉法師」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722610201,
					"content": "よく撮れてるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722610202,
					"content": "ぬはは、吉法師、イケメン。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610203
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722610203,
					"content": "こいつ、よく恥ずかしげもなくそんなこと言えるな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722610204,
					"content": "パイモン、仙人はどんな法術が使えるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610205
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722610205,
					"content": "仙人の力は半端ないんだぞ！例えば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722610206,
					"content": "そうだな、この辺りの琥珀で説明してやるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610207
					]
				},
				{
					"id": 722610207,
					"content": "琥珀？何それ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610208
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722610208,
					"content": "ええと…そうだ！たしか、理水畳山真君は琥珀を生み出す花を持っていて、侵入してきた悪いやつらを中に閉じ込められるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722610209,
					"content": "理理真すごい。悪いやつらを閉じ込めて、璃月を守った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610210
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722610210,
					"content": "昔、とてもとても悪い緒方の四鬼が森にやってきて、狸たちをいじめた。だから、五百蔵は公家に変身して、彼らに妖狸飯を食べさせた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610211
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722610211,
					"content": "その後、御伽大王と一緒に絵の中に放りこんで封印した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610212
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722610212,
					"content": "へぇ、そんなことがあったのか。それなら、 五百蔵が吉法師の写真を見てあんなにびっくりしてたのも無理ないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722610213,
					"content": "五百蔵は璃月を守る仙人じゃない。でも、五百蔵は森と狸たちを守る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610214
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722610214,
					"content": "人それぞれ、守るべきものが違うんだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610215
					]
				},
				{
					"id": 722610215,
					"content": "ぬ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610216
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722610216,
					"content": "大人になれば分かるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610217
					]
				},
				{
					"id": 722610217,
					"content": "だから、吉法師も頑張って修行して、立派な大妖狸になるんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722610218,
					"content": "ぬ！もちろん。その名もとどろく妖狸吉法師！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610219
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722610219,
					"content": "五百蔵って、封印されてなかった頃はどんな感じだったんだ？オイラすっごく気になるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610220
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722610220,
					"content": "あ、今思い出したんだけど、前にも琥珀に閉じ込められてた宝盗団がいたよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610221
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722610221,
					"content": "「仙人の使い」だと勘違いされた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610222
					]
				},
				{
					"id": 722610222,
					"content": "だいぶ前のことみたいに感じるけど…そうでもないよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610223
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722610223,
					"content": "ぬ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610224
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722610224,
					"content": "オイラたちが璃月に辿り着いたあと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610225
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722610225,
					"content": "#「一年に一度の迎仙儀式だ。わっはっは、{NICKNAME}も、もりもり食べてやるぞ～！パイモン、早く行こう！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610226
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722610226,
					"content": "「お供えものも全部な！オイラすぐに飛んでくぞ！」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610227
					]
				},
				{
					"id": 722610227,
					"content": "？？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610228
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722610228,
					"content": "ふざけるのやめよう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610229
					]
				},
				{
					"id": 722610229,
					"content": "お、おう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610230
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722610230,
					"content": "珉林の絶雲の間に仙人たちを尋ねて行くところまで、\\n璃月での冒険譚を分かりやすく説明した。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722610231
					]
				},
				{
					"id": 722610231,
					"content": "#…この後、オイラは{NICKNAME}と「琉璃亭」で食事することになったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610232
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722610232,
					"content": "理理真すごい、留留真もすごい！動く建物を造れるなんて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610233
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722610233,
					"content": "留留真…じゃなくて、留雲借風真君も美味しいものが好きみたいだぞ！前回も料理をたくさん作ってあげたから会えたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610234
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722610234,
					"content": "食いしん坊、パイモンみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610235,
						722610236
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722610235,
					"content": "確かにパイモンみたいだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610237
					]
				},
				{
					"id": 722610237,
					"content": "おい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610238
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722610238,
					"content": "パイモンって仙人なの？パイモンすごい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610239
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722610239,
					"content": "うーん、褒められたのに、なんだかあんまり嬉しくないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610240
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722610240,
					"content": "でも、オイラは仙人じゃないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610241
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722610241,
