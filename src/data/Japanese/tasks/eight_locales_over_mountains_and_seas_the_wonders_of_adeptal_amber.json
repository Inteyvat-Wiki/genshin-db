					"nextDialogs": [
						722610432
					]
				},
				{
					"id": 722610432,
					"content": "そうか？へへ、だてにおまえと長い間旅をしてきてないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610433,
						722610435
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722610433,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}を子ども扱いしてるってこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610434
					]
				},
				{
					"id": 722610434,
