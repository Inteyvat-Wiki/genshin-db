			"dialogs": [
				{
					"id": 722610101,
					"content": "おーい、理水畳山真君——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722610102,
					"content": "おーい、理理真——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610103
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722610103,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722610104,
					"content": "困ったな、仙人はいないみたいだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722610105,
					"content": "仙人には失礼のないように。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610106
					]
				},
				{
					"id": 722610106,
					"content": "パイモン、仙人ってなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610107
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722610107,
					"content": "うーん…すっごく特別な人たち…いやまてよ、動物？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722610108,
					"content": "吉法師みたいなの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610109
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722610109,
					"content": "違う違う！なんというか、不思議な力を持ってるって言うか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722610110,
					"content": "ぽんぽこできるの？じゃあ、吉法師も仙人だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610111
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722610111,
					"content": "うーん…仙人はもっと昔から生きてて、威厳があって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722610112,
					"content": "分かった、吉法師は仙人じゃない。五百蔵が仙人だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610113
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722610113,
					"content": "うっ、なんて説明したらいいんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722610114,
					"content": "仙人は古くから璃月港を守ってきた存在…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610115
					]
				},
				{
					"id": 722610115,
					"content": "分かった。五百蔵が守るのは鎮守の森だから、仙人じゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610116
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722610116,
					"content": "そういう理由じゃないけど、吉法師が分かったならそれでいいか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722610117,
					"content": "おっ、いいところに仙府があるぞ。ここで吉法師に写真を撮ってやろうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722610118,
					"content": "ぬ！吉法師、ちゃんと立つ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610119
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722610119,
					"content": "吉法師はいい子だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7226102,
			"completionStepIds": [
				7226104
			],
