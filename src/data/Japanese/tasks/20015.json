			"dialogs": [
				{
					"id": 200150201,
					"content": "ちょうどここに起きてるヒルチャールがいるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150202
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 200150202,
					"content": "この子にしよう、急いで近づこう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150203
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 200150203,
					"content": "他のヒルチャールを起こさないように気を付けてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150204
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 200150204,
					"content": "でないと絶対攻撃しに来たって思われるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150205
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 200150205,
					"content": "そんなことになったら会話ができなくなっちゃうもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エラ·マスク"
				}
			]
		},
