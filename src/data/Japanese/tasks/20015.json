			"dialogs": [
				{
					"id": 200150601,
					"content": "Olah! Muhe mimi, nye, eh... mosi aba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150602
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 200150602,
					"content": "Yo mimi beru si?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150603
					],
					"speakerTitle": "ヒルチャール"
				},
				{
					"id": 200150603,
					"content": "Buka...mita nye, guru-guru...yo mosi ka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150604
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 200150604,
					"content": "Ya odomu, Todo yo, buka guru-guru nye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150605
					],
					"speakerTitle": "ヒルチャール"
				},
				{
					"id": 200150605,
					"content": "Mi? Dada! Valo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150606
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 200150606,
					"content": "Valo, ya odomu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150607
					],
					"speakerTitle": "ヒルチャール"
				},
				{
					"id": 200150607,
					"content": "ふふっ、このヒルチャールの動きを見て、喜んでくれたみたいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150608
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 200150608,
					"content": "今回の交流はうまくいったみたいね。私のヒルチャール語のスキルもなかなかのものね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エラ·マスク"
				}
			]
		},
