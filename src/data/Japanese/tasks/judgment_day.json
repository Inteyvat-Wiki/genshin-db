				]
			},
			"dialogs": [
				{
					"id": 140310101,
					"content": "…やはりダメだったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310102
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140310102,
					"content": "そうなの…フォンテーヌ廷を探し回ったんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310103
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140310103,
					"content": "リネットは数日外で走り回ることになるって言った瞬間、耳をペタンと伏せちゃった。フレミネは知らない人が多そうだと思ったのか、ヘルメットで顔を隠しちゃったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310104
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140310104,
					"content": "千織やシャルロットはどうだ？彼女たちになら任せられると思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310105
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140310105,
					"content": "聞いてみたんだけど、二人とも最近忙しくて、時間がないんだって。うちのメンバーたちには数日ゆっくり休んでって言ったばかりだから、みんなに声を掛けるのも気が引けて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310106
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140310106,
					"content": "…困ったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310107
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140310107,
					"content": "よう、ナヴィア！クロリンデ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140310108,
					"content": "あら！相棒とパイモン！やっほー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310109
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140310109,
					"content": "…ナヴィア！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310110
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140310110,
					"content": "…あっ！もしかして…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310111
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140310111,
					"content": "ああ、チャンスだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310112,
						140310113
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140310112,
					"content": "…な、何する気？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140310114
					]
				},
				{
					"id": 140310114,
					"content": "おまえら、なにか困ったことでもあったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140310115,
					"content": "そうなの。相棒！今…とんでもない難題を抱えてるんだけど、あんたたちにしか解決できないことなの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310116
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140310116,
					"content": "大げさじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140310117,
					"content": "いや、全然大げさじゃない…もうどうしようもないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310118,
						140310119
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140310118,
					"content": "一体どれほどの難題なの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140310120
					]
				},
				{
					"id": 140310120,
					"content": "旅人、パイモン…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310121
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140310121,
					"content": "——『ファントムハンター：審判の時』を一緒に遊んでくれない！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310122
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140310122,
					"content": "…なんだって？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140310123,
					"content": "フォンテーヌの「テーブルトークシアター倶楽部」が出した、テーブルゲームのシナリオだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310124
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140310124,
					"content": "テーブルトークシアターゲームって聞いたことある？友達とテーブルを囲んで、キャラクターを演じながらシナリオを進めていくゲームなんだけど、あたし、小さい頃から大好きなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310125
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140310125,
					"content": "へえ、面白そうだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140310126,
					"content": "あたしもクロリンデも昔からこの会のメンバーよ。で、最近メンバーが新しいシナリオを作ったから、試しに遊んでみてほしいって言ってきたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310127
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140310127,
					"content": "だからこれは新しいシナリオなのよ！でもって、あたしたちが初めてのプレイヤーってわけ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310128
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140310128,
					"content": "試遊段階のシナリオは普通、多くの問題点があるものなんだ。けど、今回のものは完成度が高いし、作者の考察も行き届いていて…なかなかよくできていると思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310129
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140310129,
					"content": "ストップストップ！あたしはシナリオ読まずにあんたに渡したんだから、ネタバレしないで！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310130
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140310130,
					"content": "…とにかく、このシナリオには四人のプレイヤーが必要なんだけど、一人足りないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310131
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140310131,
					"content": "…本当にとんでもない難題だね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140310132
					]
				},
				{
					"id": 140310132,
					"content": "あんたもそう思うでしょ？相棒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310133
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140310133,
					"content": "でもオイラと旅人って二人だけど、いいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310134
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140310134,
					"content": "問題ない。プレイ体験を損なわないよう、実際の参加者数に応じて進行は調整する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310135
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140310135,
					"content": "へへっ、どうする？遊んでみるか？おまえに任せるぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310136,
						140310137
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140310136,
					"content": "友達が困ってるなら助けないと！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140310138
					]
				},
				{
					"id": 140310138,
					"content": "よかった。これで問題解決だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310139
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140310139,
					"content": "よし！じゃあ、さっそくシナリオ担当を呼んでくるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310140
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140310140,
					"content": "シナリオ担当？シナリオってクロリンデが持ってるんじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310141
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140310141,
					"content": "このシナリオに合わせ、倶楽部は新しい遊び方を考えた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310142
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140310142,
					"content": "最初、進行役である「ゲームマスター」が持っているシナリオは完全なものではない——初めのストーリーをクリアしてやっと、シナリオ担当から次の章のシナリオを受け取れるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310143
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140310143,
					"content": "さらに、参加者に臨場感を与えるために、倶楽部はシナリオのシチュエーションを再現する。そして初日の集合場所は、シナリオ担当が教えてくれるまで分からないというわけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310144
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140310144,
					"content": "おお、シナリオの作者も、かなりこだわってるんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310145
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140310145,
					"content": "へへっ、ワクワクしてきたでしょ？ゲームマスターですら、物語の結末を知らないんだもの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310146
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140310146,
					"content": "あなたたちと一緒に結末を見届けられるのを楽しみにしている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310147
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140310147,
					"content": "他のみんなは千織屋で待ってるから、先に合流しておいて。あたしはあとでシナリオ担当と一緒に向かうよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310148
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140310148,
					"content": "ああ。焦らず、足元に気をつけてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310149
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140310149,
					"content": "もう、子ども扱いしないでってば。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310150
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140310150,
					"content": "うーん…そうね…今回はどんなキャラクターを演じようかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310151
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140310151,
					"content": "…今回は普通の技能を習得してくれ。それと、動物を見かけるたびに「説得」しようとするのはやめてくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140310137,
					"content": "いいシナリオがあるなら遊ばないと！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140310138
					]
				},
				{
					"id": 140310119,
					"content": "とりあえず聞かせて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140310120
					]
				},
				{
					"id": 140310113,
					"content": "…た、ただの通りすがりだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140310114
					]
				}
			]
		},
