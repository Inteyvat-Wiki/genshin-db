			"dialogs": [
				{
					"id": 140310201,
					"content": "待たせたな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310202
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140310202,
					"content": "おや、戻ってきたのかい。あれ？旅人にパイモン？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310203
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140310203,
					"content": "驚いたよ。一緒に遊んでくれるのは君たちなのかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310204
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140310204,
					"content": "リネ！それにフリーナ！残り二人のプレイヤーっておまえたちだったのか！おまえたちもテーブルトークシアター倶楽部のメンバーなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140310205,
					"content": "二人とも、こんにちは。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140310206
					]
				},
				{
					"id": 140310206,
					"content": "僕はあくまで「幽霊部員」って感じかな。あんまりイベントには参加してないんだ。ブーフ·ド·エテの館ではよく進行役として、リネットとフレミネに付き合って似たようなゲームをやってるけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310207
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140310207,
					"content": "プレイヤーとして参加するのは初めてだから、みんなと一緒に楽しめるといいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310208
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140310208,
					"content": "僕はメンバーじゃない。ただ、朝からクロリンデがうちのドアをノックする音で起こされてね。いいシナリオがあるって聞かされたから、参加するって決めたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310209
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140310209,
					"content": "興味がおありなら、紹介しましょう。入会費用が四割引きになりますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310210
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140310210,
					"content": "それは今回のシナリオのクオリティを見てから考えるよ。楽しかったら入らせてもらうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310211
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140310211,
					"content": "クロリンデはよく「テーブルトークシアター」をやってるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140310212,
					"content": "クロリンデさんは倶楽部屈指の「ベテランゲームマスター」なんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310213
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140310213,
					"content": "ああ、まだ上下関係があった頃から、噂には聞いてたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310214
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140310214,
					"content": "…ただの趣味だ。驚くほどのことでもない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310215
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140310215,
					"content": "そうだったのか。厳かな決闘代理人としてのおまえしか知らないから、テーブルトークシアターの進行を取り仕切ってるとこなんて、全然想像できないぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310216,
						140310217
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140310216,
					"content": "ルールに意見があったら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140310218
					]
				},
				{
					"id": 140310218,
					"content": "面白い冗談だ。プレイヤーを困らせたりしない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310219
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140310219,
					"content": "仕事とプライベートは別だ。法廷での私は、フォンテーヌの法律と規則を代表し、己の名誉を守りたい者に公平な決闘の機会を与える。私情は一切挟まずにな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310220
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140310220,
					"content": "しかしプライベートでは——私も皆と同じ、ごく普通の人間だ。怒ることもあれば、悲しむこともある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310221
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140310221,
					"content": "嘘だろう？キミとあんなに長く一緒にいたけど、一度も泣いてるとこなんか見たことないよ。怒ってるとこは結構見たけど…それともあれは怒ってるように見えただけ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310222
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140310222,
					"content": "あれはすべて仕事の時の私ですので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310223
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140310223,
					"content": "そうだったんだね…？プライベートでも、キミは気持ちの浮き沈みが少なそうだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310224
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140310224,
					"content": "泣いているところが見たいのですか？それは少し難しいかもしれません。怒るのであればもう少し簡単なのですが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310225
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140310225,
					"content": "いやいやいやいや、そういうわけじゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310226
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140310226,
					"content": "みんなただいまー！紹介するね。こちらがシナリオ担当のフロリアンさん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310227
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140310227,
					"content": "皆さん、初めまして。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310228
					],
					"speakerTitle": "フロリアン"
				},
				{
					"id": 140310228,
					"content": "よろしくな！…あれ？フロリアンも決闘代理人なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310229
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140310229,
					"content": "あっ、いえ、これは倶楽部の保有している衣裳です。ゲームで、他のキャラクターを演じることがあるので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310230
					],
					"speakerTitle": "フロリアン"
				},
				{
					"id": 140310230,
					"content": "大変な仕事だね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310231
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140310231,
					"content": "大したことではありません。プレイヤーによりストーリーに没入してもらい、楽しんでもらうのが私たちの役目ですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310232
					],
					"speakerTitle": "フロリアン"
				},
				{
					"id": 140310232,
					"content": "それでは、簡単にご紹介しますね——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310233
					],
					"speakerTitle": "フロリアン"
				},
				{
					"id": 140310233,
					"content": "今回のシナリオは、ファントムハンターの歴史をモデルにしています。皆さんにはとある時代のファントムハンターになりきって、街で起きた一連の事件を解決していただきます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310234
					],
					"speakerTitle": "フロリアン"
				},
				{
					"id": 140310234,
					"content": "えっと…ファントムハンターの歴史なんて、オイラそんなに知らないけど…大丈夫なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310235
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140310235,
					"content": "はい、まったく問題ありません。簡単にご紹介しますね——「ファントムハンター」とは特殊な剣術を受け継いで魔物を狩り、街を守る人々のことです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310236
					],
					"speakerTitle": "フロリアン"
				},
				{
					"id": 140310236,
					"content": "彼らに関する物語は、昔々のレムリア王国、そして最初の狩人「カッシオドル」の時代まで遡ります…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310237
					],
					"speakerTitle": "フロリアン"
				},
				{
					"id": 140310237,
					"content": "詳細は、また皆さんご自身で調べてみてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310238
					],
					"speakerTitle": "フロリアン"
				},
				{
					"id": 140310238,
					"content": "ああ。私もやりながら詳しく説明しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310239
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140310239,
					"content": "さて…コホンッ！——勇敢なハンターたちよ、未知なる冒険の旅に出る準備はできていますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310240
					],
					"speakerTitle": "フロリアン"
				},
				{
					"id": 140310240,
					"content": "おお！一気にそれっぽくなってきたな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310241
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140310241,
					"content": "いいでしょう。あなたがたの決意に満ちた眼差しは確かなもののようです。それではこちらへ…さあ、旅を始めてください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310242
					],
					"speakerTitle": "フロリアン"
				},
				{
					"id": 140310242,
					"content": "ストーリーの流れに合わせて、特定の「シーン」に向かうというわけかい？斬新なアイデアだね。それで、手紙の内容は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310243
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140310243,
					"content": "第一段階のシーンの具体的な場所と…会場の使用許可書ですね。用意周到だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310244
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140310244,
					"content": "皆、忘れ物がないよう、持ち物を確認してくれ。準備ができたら、一緒に指定の場所へ向かおう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310245
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140310245,
					"content": "よし！ファントムハンター小隊、出発！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140310217,
					"content": "決闘を申し込まないといけないの…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140310218
					]
				}
			]
		}
	]
}