					"nextDialogs": [
						4610503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4610503,
					"content": "…「アルカディア遺跡」？このスタンレーにも行ったことない場所があったとは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610504
					],
					"speakerTitle": "スタンレー"
				},
				{
