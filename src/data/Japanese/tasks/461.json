					"id": 4610804,
					"content": "ん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610805
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4610805,
					"content": "いや、手に入れ難いものほど、手にした時、喜びを感じられるものだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610806
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4610806,
					"content": "そこでだ、俺の方でちょっとした情報を仕入れてきてやった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610807
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4610807,
					"content": "知り合いに頼んで裏の情報屋に行ってもらってね…どうやら「アルカディア遺跡」について知っている人間がいるらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610808
					],
					"speakerTitle": "ガイア"
				},
