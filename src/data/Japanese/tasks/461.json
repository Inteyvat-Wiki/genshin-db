						4610603
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4610603,
					"content": "アルカディア…聞いたことないね。ごめん、僕はまだ新米だからさ、知ってることは少ないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610604
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 4610604,
					"content": "そうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610605
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4610605,
					"content": "協会に依頼してみたらどうかな？ベテランの先輩たちなら力になれるかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610606
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 4610606,
					"content": "ダメダメダメ、それはダメだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610607
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4610607,
					"content": "もし他の冒険者たちに先を越されて、お宝を取られたらおしまいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610608
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4610608,
					"content": "（言っちゃった…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610609
					]
				},
				{
					"id": 4610609,
					"content": "なるほど。",
