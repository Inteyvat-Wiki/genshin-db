					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610809
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4610809,
					"content": "そう慌てるな。情報屋にもルールがあってな。情報の漏洩を防ぐために、まずは連絡係に会わないといけない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610810
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4610810,
					"content": "待ち合わせ場所は囁きの森だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610811
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4610811,
					"content": "そうと分かれば、さっそく向かおうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610812,
						4610815
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4610812,
					"content": "立場上、ガイアは一緒に行けないよね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610813
					]
				},
				{
					"id": 4610813,
					"content": "その通り、さすがだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610814
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4610814,
					"content": "俺も一応騎士だからな、そういう裏社会と繋がりを持つわけにはいかない、だろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610816
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4610816,
					"content": "助かる。頼んだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610817
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4610817,
					"content": "もちろん情報料については、こちらが持つから安心しろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610818
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4610818,
					"content": "へへっ、任せろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4610815,
					"content": "パイモンと二人で情報を聞いてくる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610816
					]
				}
