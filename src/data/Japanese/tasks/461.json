			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ガイア"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4610101,
					"content": "まずい、これはまずいことになったな…どうするか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610102,
						4610103
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4610102,
					"content": "ガイアさん、どうかした？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610104
					]
				},
				{
					"id": 4610104,
					"content": "#おお、{NICKNAME}。これは千の風に感謝しないとな。今、お前に出会えたこと、これはきっと神の思し召しだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610105
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4610105,
					"content": "凡人を助けるため風神が遣わした使者よ、どうか手を貸してくれまいか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610106
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4610106,
					"content": "うわっ、なんかムカムカするぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610107,
						4610109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4610107,
					"content": "手は空いてるけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610108
					]
				},
				{
					"id": 4610108,
					"content": "そりゃ、ちょうどよかった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610110
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4610110,
					"content": "実は騎士団のヤツらの耳には入れられない話でな、お前にしか頼めないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610111
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4610111,
					"content": "ここじゃちょっと。場所を変えよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610112
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4610112,
					"content": "そうだな、騎士団横の庭あたりがいいだろう。ついて来てくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610113
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4610113,
					"content": "何か怪しいなぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4610109,
					"content": "とりあえず、話くらい聞いてみよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610110
					]
				},
				{
					"id": 4610103,
					"content": "慌てるなんてらしくない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610104
					]
				}
			]
		},
		{
			"id": 46102,
			"completionStepIds": [
				46109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"46109",
							"2"
						],
						"stepId": 46109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ガイア"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4610201,
					"content": "この辺なら大丈夫だろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610202
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4610202,
					"content": "早く教えろよ、一体何があったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4610203,
					"content": "何から話すか…そうだな、まず一つ、お前たちに秘密を教えてやる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610204
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4610204,
					"content": "俺個人の過去に関わることだから、他言無用で頼むな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610205
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4610205,
					"content": "安心しろ、オイラの口は堅いぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4610206,
					"content": "実は…俺の祖父は、海賊だったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610207
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4610207,
					"content": "へー",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4610208,
					"content": "…いやいや、反応薄くないか。さては信じてないな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610209
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4610209,
					"content": "ほら見ろ、この眼帯は海賊である祖父の遺伝なんだ。血が繋がっている証だろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610210,
						4610213
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4610210,
					"content": "眼帯って遺伝するもの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610211
					]
				},
				{
					"id": 4610211,
					"content": "#あははっ、{NICKNAME}、そんなの常識だぜ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610212
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4610212,
					"content": "母親のくせ毛が子供に遺伝するのと同じ理屈さ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610214
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4610214,
					"content": "昨日、祖父が残した手記を読んでいて、偶然見つけたんだ。<color=#00E1FFFF>お宝</color>についての記述をな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610215
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4610215,
					"content": "…お宝！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4610216,
					"content": "手記によると、お宝の隠し場所は「失われたアルカディア遺跡」っつうところらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610217
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4610217,
					"content": "お宝…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4610218,
					"content": "けどな、遺跡の所在については、未だ手がかりがないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610219
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4610219,
					"content": "お宝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610220
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4610220,
					"content": "ガイア！それはどんなお宝だ？金塊か？宝石か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610221
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4610221,
					"content": "ふふん、金目のものなど、三流のお宝さ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610222
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4610222,
					"content": "祖父の宝は、「剣」だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610223
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4610223,
					"content": "手にするだけで、無敵の力を得られる神剣らしいぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610224
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4610224,
					"content": "おぉ——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610225
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4610225,
					"content": "元々は天空の島にいる神がうっかり海に落としたもんでな、それを祖父たちが引き上げたんだそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610226
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4610226,
					"content": "その剣を手にした瞬間、雷鳴は轟き、海は荒れ狂い、晴天だった海原に突如として竜巻が現れる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610227
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4610227,
					"content": "神剣の力で、祖父は八つの頭を持つ海蛇や、銀髪のサキュバス、深淵の邪竜を倒したそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610228
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4610228,
					"content": "しかし、あまりにも強大であったため、他の海賊たちがその剣を奪おうとしてきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610229
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4610229,
					"content": "争いを避けるため、祖父は神剣を隠したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610230,
						4610232
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4610230,
					"content": "八つの頭の海蛇、サキュバス…本当？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610231
					]
				},
				{
					"id": 4610231,
					"content": "世界は未知に満ち溢れているからこそ、面白いんじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610233
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4610233,
					"content": "いやぁ、信じがたい大冒険だよな。これぞ海賊のロマン、だろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610234
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4610234,
					"content": "うわ～～～～～～っ！！すごい、すごすぎる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610235
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4610235,
					"content": "だが近頃、ある<color=#00E1FFFF>宝盗団</color>の動きが活発でな、幾つもの遺跡が盗掘に遭っているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610236
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4610236,
					"content": "その「アルカディア遺跡」も、ヤツらに見つかっちまうんじゃないかって心配なんだよ。そしたら、神剣もきっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610237
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4610237,
					"content": "そりゃダメだ！悪いヤツらに取られるぐらいなら、オイラたちが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610238
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4610238,
					"content": "#…とにかく安心しろ！オイラと{NICKNAME}が力を貸すぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610239
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4610239,
					"content": "ほお～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610240
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4610240,
					"content": "助かるぜ。くれぐれも内密に頼むな。いい知らせを待ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610241
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4610241,
					"content": "#なあ、どうだ？{NICKNAME}、ワクワクしないか？すっっっごい神剣らしいぞッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610242,
						4610243
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4610242,
					"content": "本当？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610244
					]
				},
				{
					"id": 4610244,
					"content": "とりあえず、<color=#00E1FFFF>冒険者協会</color>へ行って、情報を集めようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610245
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4610245,
					"content": "遺跡のことなら、冒険者たちの方が詳しいだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4610243,
					"content": "本当に本当？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610244
					]
				},
				{
					"id": 4610232,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610233
					]
				},
				{
					"id": 4610213,
					"content": "本当なのか、驚いた。",
					"roleType": "TALK_ROLE_PLAYER",
