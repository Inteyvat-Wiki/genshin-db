			"dialogs": [
				{
					"id": 4610404,
					"content": "おっと、そんなくだらないことのために来たんじゃないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4610405,
					"content": "天空の島から落ちてきた、八つの頭を持つサキュバスや、銀髪の海蛇を切ったっていう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4610407,
					"content": "八つの頭の海蛇と、銀髪のサキュバスね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610408
					]
				},
				{
					"id": 4610410,
					"content": "喋りすぎ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610411
					]
				},
				{
					"id": 4610406,
					"content": "超、超、すっごい神剣を探してるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610407,
						4610410
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4610408,
					"content": "え、どっちも似たようなもんだろ。とりあえず、すごいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610409
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4610409,
					"content": "それに、お宝の隠し場所さえ言わなきゃ大丈夫さ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4610411,
					"content": "平気平気、お宝の隠し場所さえ言わなきゃ大丈夫だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610412
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4610413,
					"content": "（言っちゃった…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610414
					]
				},
				{
					"id": 4610412,
					"content": "それで、サイリュスさん、「失われたアルカディア遺跡」ってどこにあるか知らないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4610414,
					"content": "「アルカディア遺跡」…聞いたことない名前だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610415
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 4610415,
					"content": "でも、情報提供ありがとさん。見つけたら、俺にも見せてくれよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610416
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 4610416,
					"content": "ん？情報…提供…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
