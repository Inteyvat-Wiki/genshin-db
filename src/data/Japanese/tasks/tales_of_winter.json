			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ヴィクトル"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206000201,
					"content": "「ファデュイ」について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000202
					]
				},
				{
					"id": 206000202,
					"content": "ハハッ、単刀直入に聞くんだな。それはそれは話せば長くなるんだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000203
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 206000203,
					"content": "お前はまだ「ファデュイ」の正規メンバーじゃないから、全部は教えられないんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000204
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 206000204,
					"content": "城の周辺にヒルチャールがたくさんいて、群れで行動するヒルチャールもいると聞いたが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000205
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 206000205,
					"content": "そのリーダーの「ヒルチャール暴徒」から戦利品を取ってこれたら、お前にファデュイの話を教えてやる。どうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000206,
						206000209
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 206000206,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000207
					]
				},
				{
					"id": 206000207,
					"content": "ハッ、話が分かるやつだな。モンドではなかなか珍しいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000208
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 206000208,
					"content": "じゃあ、早く行ってきてくれ。俺様はここで待ってるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 206000209,
					"content": "あれだけでいいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000210
					]
				},
				{
					"id": 206000210,
					"content": "あ？あれだけで十分だろ？あれ以上強い魔物、お前倒せるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000211
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 206000211,
					"content": "早く行ってこい。俺様はここで待ってるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000212
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 206000212,
					"content": "ふわぁ…俺様を待たせすぎると、眠ってしまうだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴィクトル"
				}
			]
		},
		{
