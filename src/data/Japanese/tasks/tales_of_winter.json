			"trigger": {
				"objectNames": [
					"ヴィクトル"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206000101,
					"content": "ここだ、旅人。お前のことは観察させてもらったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000102
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 206000102,
					"content": "何か？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000103
					]
				},
				{
					"id": 206000103,
					"content": "そう警戒するなよ、お前にはいいことを教えてやる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000104
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 206000104,
					"content": "どうだ？「ファデュイ」に入らないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000105
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 206000105,
					"content": "フン、そんなの興味ないよ！だろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000106,
						206000109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 206000106,
					"content": "考えてみる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000107
					]
				},
				{
					"id": 206000107,
					"content": "おい！考えるまでもないよ、断れ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 206000108,
					"content": "自分の立場が分かるんだな。偉くなりたければ、俺ら「ファデュイ」に入ることが一番だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000111
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 206000111,
					"content": "ふーん、その顔、俺様に聞きたいことがあるみたいだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 206000109,
					"content": "ここはモンドだけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000110
					]
				},
				{
					"id": 206000110,
					"content": "だからなんだ？俺ら「ファデュイ」は全大陸で公開募集してるし、不正などはない。西風騎士だって何も言えないんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000111
					],
					"speakerTitle": "ヴィクトル"
				}
			]
		},
		{
			"id": 2060002,
			"completionStepIds": [
				2060002
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
