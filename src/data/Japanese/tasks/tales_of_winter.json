			},
			"dialogs": [
				{
					"id": 206000301,
					"content": "「邪眼」について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000302
					]
				},
				{
					"id": 206000302,
					"content": "ハッ…お前って空気を読まないというか、とぼけてるというか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000303
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 206000303,
					"content": "お前は「ファデュイ」の正規メンバーじゃないくせに、「『邪眼』は何？」って聞くんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000304
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 206000304,
					"content": "それで俺様が正直に教えると思う？あっちにいる西風騎士団の門番じゃないし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000305
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 206000305,
					"content": "でも…「邪眼」は俺ら「ファデュイ」の宝物だし、少し紹介するくらいなら、できなくはないが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000306
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 206000306,
					"content": "こうしよう、お前、城外にいる「宝盗団」を知ってるんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000307
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 206000307,
					"content": "コソ泥集団だけど、本物のお宝を持ってる時もあるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000308
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 206000308,
					"content": "その「宝盗団」から何か入手して俺様に渡したら、代わりに「邪眼」を教えてやる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000309,
						206000311
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 206000309,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000310
					]
				},
				{
					"id": 206000310,
					"content": "お前みたいなやつは気になったぜ、さっさと行ってきてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 206000311,
					"content": "お金に困ってる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000312
					]
				},
				{
					"id": 206000312,
					"content": "金に困る？ハハッ、西風騎士団じゃあるまいし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000313
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 206000313,
					"content": "宝盗団はモンドでどんなお宝を手に入れられるか見てみたいだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000314
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 206000314,
					"content": "でも…ハッ、お宝と言えるものはないだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴィクトル"
				}
			]
		},
