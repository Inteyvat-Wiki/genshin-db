			"dialogs": [
				{
					"id": 206000401,
					"content": "「女皇陛下」について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000402
					]
				},
				{
					"id": 206000402,
					"content": "なんだ、お前は女皇陛下が気になるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000403
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 206000403,
					"content": "まさか女皇陛下目当てでファデュイに入ろうかと考えてるんじゃないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000404
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 206000404,
					"content": "ハッ、お前、自分の立場を弁えろよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000405
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 206000405,
					"content": "まあ、女皇陛下の情報なら、なおさらただで教えるわけにはいかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000406
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 206000406,
					"content": "お前、遺跡守衛から戦利品を取ってきてくれ。あれをコレクションに加えたいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000407,
						206000409
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 206000407,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000408
					]
				},
				{
					"id": 206000408,
					"content": "ああ、早く行ってこい。ここで待ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 206000409,
					"content": "どうしてそんなものを？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000410
					]
				},
				{
					"id": 206000410,
					"content": "あ？コレクションにするのがだめなのか？それとも、モンドのやつらは遺跡守衛が怖いのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000411
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 206000411,
					"content": "フン、「ファデュイ」にとって、そんなの全然怖くないぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000412
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 206000412,
					"content": "でも、ふわぁ…この風を浴びると眠くてしょうがないし、やる気も出ないから、お前に任せた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴィクトル"
				}
			]
		},
