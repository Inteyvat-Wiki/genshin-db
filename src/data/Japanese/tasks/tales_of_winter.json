						206000602
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 206000602,
					"content": "手に入った。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000603
					]
				},
				{
					"id": 206000603,
					"content": "どれどれ…まあ、いいだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000604
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 206000604,
					"content": "じゃあ、お前に「ファデュイ」のことを教えてやるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000605
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 206000605,
					"content": "俺ら「ファデュイ」は「スネージナヤパレス」から来たんだ。女皇陛下の命令に従い、その意志を元に世界各地で活動してる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000606
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 206000606,
					"content": "その中で最も強い11人は、女皇陛下から「執行官」の名をいただいてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000607
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 206000607,
					"content": "俺らみたいな無名のやつらと比べて、あの11人の「執行官」こそが名高き人物だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000608
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 206000608,
					"content": "お前も「ファデュイ」に入って、実力をつけたら、あの方たちに選ばれることもあるかもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000609
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 206000609,
					"content": "そしたら、お前の将来は安泰だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000610
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 206000610,
					"content": "俺様？選ばれたってほどではないが、「淑女」様のために働いてるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000611
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 206000611,
					"content": "まあ…本当のことを言うなら、俺様は「隊長」様の下がいいんだけどな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴィクトル"
				}
			]
