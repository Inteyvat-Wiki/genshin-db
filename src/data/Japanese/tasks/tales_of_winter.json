				{
					"id": 206000501,
					"content": "「ヒルチャール暴徒」からの戦利品だぞ、忘れるなよ。入手したら早く戻るんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000502
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 206000502,
					"content": "詳細？…角笛だ。とにかく、入手したら俺様に渡せばいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴィクトル"
				}
			]
		},
