				"points": []
			},
			"dialogs": [
				{
					"id": 710830201,
					"content": "下の様子はどうだ？危険な目には遭わなかったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830202,
						710830210
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710830202,
					"content": "（沐寧に状況を説明した）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830203
					]
				},
				{
					"id": 710830203,
					"content": "なるほど、そいつは危険だな。それじゃ、瑾武さんと志璇のことはあんたに任せたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830204
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710830204,
					"content": "ここは止めるべきじゃないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830205
					]
				},
				{
					"id": 710830205,
					"content": "もちろん、俺の立場ならあんたを止めるべきだろうよ。だが、あんたの足は速くてとても追いつけない。だから止めようにも、止められないってわけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830206
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710830206,
					"content": "#{M#俺}{F#私}の足は速くない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830207
					]
				},
				{
					"id": 710830207,
					"content": "いや、あんたの足は速い。週報にはそう書いてあった。これは間違いなく事実だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830208
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710830208,
					"content": "#分かった。{M#俺}{F#私}の足は速いから仕方ない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830209
					]
				},
				{
					"id": 710830209,
					"content": "ああ。それじゃあ、くれぐれも気をつけてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710830210,
					"content": "全部任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830211
					]
				},
				{
					"id": 710830211,
					"content": "よしよし。何事もないなら、「七星」にキツく言われることもないだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "沐寧"
				}
			]
		}
	]
