					"沐寧"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710830101,
					"content": "まさか、あんたらが「七星陣法」を本当に壊したなんて。これを週報に書かないと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830102
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710830102,
					"content": "カッコ良く書いてね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830103
					]
				},
				{
					"id": 710830103,
					"content": "コホンッ…冗談言わないでくれ、これは深刻な事件だぞ。どの程度の深刻かについては、最終的に「七星」がお決めになることだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830104
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710830104,
					"content": "つまり報告を上に提出すれば、「七星」のお方たち自ら、あんたらを止めに来るかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830105
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710830105,
					"content": "ふん。その時が来たら、俺もあんたを庇うことができなくなるからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830106
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710830106,
					"content": "（分かりやすい…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830107
					]
				},
				{
					"id": 710830107,
					"content": "はは…びびったか？さあ、早く行け、あんたを待ってる人がいる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "沐寧"
				}
			]
		},
		{
