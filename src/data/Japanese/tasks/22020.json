			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"龍二"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220200101,
					"content": "旅人、ここで会えるとは！所長の言った通りですね、私たちには縁がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200102
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200102,
					"content": "ここでなにしてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200103
					]
				},
				{
					"id": 220200103,
					"content": "所長の指示で、前回の仕事の後片付けをしています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200104
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200104,
					"content": "お世話になった同心の方たちに感謝の気持ちを込めて、お菓子を贈るだけですけどね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200105,
						220200106
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200105,
					"content": "#彼らが{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}たちに感謝するべき。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200107
					]
				},
				{
					"id": 220200107,
					"content": "そうですけど。実は、これを機にプレゼントを贈って、人脈を築きたいのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200108
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200108,
					"content": "何しろうちの探偵所には、今後も同心の方たちの力が必要になる場面が必ず出てきます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200109,
						220200110
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200109,
					"content": "きっとまた珊瑚の指示でしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200111
					]
				},
				{
					"id": 220200111,
					"content": "あはは、その通りです。やはりあなたは勘が鋭い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200112
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200112,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYSECOND|INFO_FEMALE_PRONOUN_GIRLSECOND]}自身の考えは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200113
					]
				},
				{
					"id": 220200113,
					"content": "私？天野さんと安藤さん…彼らと共に仕事をしたことがあるので、別に、お菓子を贈ってもおかしくないと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200114
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200114,
					"content": "しかし…今日は所長から別件の調査も頼まれていて、時間的に少し厳しいんです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200115
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200115,
					"content": "旅人、このお菓子をあの三方に渡してくれませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200116,
						220200118
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200116,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200117
					]
				},
				{
					"id": 220200117,
					"content": "手伝ってくれてありがとうございます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200121
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200121,
					"content": "ここには三つのお菓子があります。天野さん、安藤さん、それに大和田さんにお願いします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200122
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200122,
					"content": "大和田さん？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200123
					]
				},
				{
					"id": 220200123,
					"content": "彼も昔の同僚でした。私が奉行所から離れる前は、お世話になっていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200124
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200124,
					"content": "以前連続窃盗事件を処理していた時、奉行所にいた彼に助けてもらったんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200125
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200125,
					"content": "それではこの件はお任せします。終わったら、ここでまたお会いしましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200118,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYSECOND|INFO_FEMALE_PRONOUN_GIRLSECOND]}が贈った方がいい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200119
					]
				},
				{
					"id": 220200119,
					"content": "いえ…やはり所長の依頼の方が重要なので…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200120
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200120,
					"content": "時間がある時にまたあのお三方にあいさつしに行きます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200121
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200110,
					"content": "珊瑚が考えた策だね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200111
					]
				},
				{
					"id": 220200106,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}たちが力になったわけじゃないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200107
					]
				}
			]
		},
		{
			"id": 2202002,
			"completionStepIds": [
				2202002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
