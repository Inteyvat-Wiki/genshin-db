							"2202003",
							"2"
						],
						"stepId": 2202003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"大和田",
					"上杉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220200301,
					"content": "おや？君は…金髪の旅人、天野から噂は聞いている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200302
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200302,
					"content": "私に何か用か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200303
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200303,
					"content": "龍二に頼まれてこれを渡しに来た。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200304
					]
				},
				{
					"id": 220200304,
					"content": "おお、まさか「緋櫻餅」とは。すぐ食べてしまうのはもったいない、ちゃんと場所を選んでじっくりと味わうとしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200305
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200305,
					"content": "上杉、少しの間、私の代わりにここにいてくれ。もし誰か訪ねて来たら、待ってもらうよう伝えてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200306
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200306,
					"content": "でも大和田さん、今は勤務時間中ですよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200307
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 220200307,
					"content": "ははは、問題ない。外に行って少し休憩するだけだから、すぐに戻る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200308
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200308,
					"content": "はぁ…わかりました、でもすぐに戻ってきてくださいね、もし偉いお方が急に来られたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200309
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 220200309,
					"content": "安心しろ。事件を解決したばかりだからな。人が来たとしても、褒美を賜るくらいだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200310
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200310,
					"content": "任せたぞ、上杉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200311
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200311,
					"content": "旅人、共に外で散歩するか？このような菓子を楽しむのに最適な場所を知っているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大和田"
				}
			]
		},
		{
			"id": 2202004,
			"completionStepIds": [
				2202005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2202005",
							"2"
						],
						"stepId": 2202005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"大和田"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220200404,
					"content": "着いたぞ、いいところだろう。私は気分転換しによく来るんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200405
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200405,
					"content": "景色が良くて、空気もおいしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200406
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200406,
					"content": "気になることがあったら、遠慮せずに聞いてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200407,
						220200409
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200407,
					"content": "昔、龍二の同僚だったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200408
					]
				},
				{
					"id": 220200408,
					"content": "龍二から聞いたのか？その通り、確かに私は龍二と共に仕事をしていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200411
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200411,
					"content": "当時の出来事について、龍二から聞いているか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200412
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200412,
					"content": "簡単に説明すると、龍二はその事件で、衝動的に動いて犯人の罠にかかり、身代わりにされてしまったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200413
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200413,
					"content": "私が保証人になっても、判決の担当者は彼を有罪にすべきと主張した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200414
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200414,
					"content": "私は色んな人に調査を依頼したが、結局役に立たなかったり、「これ以上調査するな」と言われたりもした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200415
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200415,
					"content": "はは、当時の私は…なんというか、警告を受け、言うことを聞いてしまったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200416
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200416,
					"content": "この件は、「龍二が濡れ衣を着せられた」件と同じくらい知れ渡っている秘密だから、君に話しても問題ないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200417
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200417,
					"content": "誰もが知っているんだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200418
					]
				},
				{
					"id": 220200418,
					"content": "ああ、「誰もが知っていた」からこそ、その事実に気付いたみんなは、あえて事件に突っ込まなくなったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200419
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200419,
					"content": "でも幸いなことに、たまたま仕事で奉行所に来た「何も知らない」探偵が、この事件に関心を持ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200420
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200420,
					"content": "その探偵の活躍により、事件は解決し、龍二の無実も証明された。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200421
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200421,
					"content": "その後、龍二は奉行所を離れ、その探偵の下で働くようになったんだ。物語はここでおしまいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200422
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200422,
					"content": "どうして教えてくれたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200423
					]
				},
				{
					"id": 220200423,
					"content": "誰にプレゼントを頼まれたんだい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200424
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200424,
					"content": "龍二。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200425
					]
				},
				{
					"id": 220200425,
					"content": "龍二がこれを届けに来たのも、きっと「所長の指示」なんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200426
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200426,
					"content": "龍二の性格から考えると、珊瑚の頼みであれば、たとえ私が火の海に住んでいたとしても、必ずプレゼントを無傷で届けに来た筈だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200427
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200427,
					"content": "君が龍二に頼まれたのなら、それもきっと、珊瑚の指示通りに動いているだけだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200428
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200428,
					"content": "#珊瑚は{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}にこの件を知って欲しかったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200429
					]
				},
				{
					"id": 220200429,
					"content": "ははは、君も鋭いね。君が来てくれたことで、まるで珊瑚が私に「新しい助っ人を雇ったよ」と言ってるみたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200430
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200430,
					"content": "彼女は今でもあの時のことを根に持っているようだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200431
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200431,
					"content": "それもしょうがない、何せ…今になっても、罠を仕掛けた犯人が見つかっていないのだからな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200432
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200432,
					"content": "まあ、教えられることは全部話した。珊瑚の下で働くか働かないかは、君次第だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200433
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200433,
					"content": "それと、戻ったら、代わりに龍二に礼を言っておいてくれ。大好物の「緋櫻餅」をありがとうってな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200409,
					"content": "龍二はどうして奉行所を離れたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200410
					]
				},
				{
					"id": 220200410,
					"content": "彼が奉行所を離れたのも、彼自身の選択。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200411
					],
					"speakerTitle": "大和田"
				}
			]
		},
		{
			"id": 2202005,
			"completionStepIds": [
				2202006
			],
