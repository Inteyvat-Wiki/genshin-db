				"objectNames": [
					"龍二"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220200501,
					"content": "お疲れ様です、旅人。プレゼントは…無事渡せましたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200502,
						220200503
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200502,
					"content": "全部珊瑚に指示されたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200504
					]
				},
				{
					"id": 220200504,
					"content": "き…気付いてしまいました？ごめんなさい…プレゼントの件は、所長の指示です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200505
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200505,
					"content": "所長は、当時の事件を完全に解決し、真犯人を明らかにするためには、あなたの力が必要不可欠だと言っていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200506,
						220200510
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200506,
					"content": "事件はまだ解決していないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200507
					]
				},
				{
					"id": 220200507,
					"content": "ええ。当時、所長は「犯人」を見つけ出した時に、何もかもが…完璧すぎたと言っていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200508
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200508,
					"content": "所長が調査を始めた後、手がかりや証拠、犯行動機が自ずと手に入ったそうなんですが、それら全てがある人物を指していたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200509
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200509,
					"content": "結局、奉行所はその人物を犯人として扱いましたが、所長は「真犯人は別にいる」と信じています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200514
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200514,
					"content": "彼女が私を雇ってくれたのも、その事件を解決する機会を得るためだったのでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200515
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200515,
					"content": "#しかし、{M#俺}{F#私}に何ができるというのでしょう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200516
					]
				},
				{
					"id": 220200516,
					"content": "所長の考えていることは…私にはよく分かりません。しかし以前、稲妻にずっといるせいか、見識が狭くなったと所長は言っていました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200517
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200517,
					"content": "もし博識で自由奔放な協力者がいたら、その人が事件解決の突破口を開いてくれるかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200518
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200518,
					"content": "旅人、所長が求めている協力者とは、あなたのことなのではないかと私は推測しています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200519,
						220200521
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200519,
					"content": "#じゃあ{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}も「探偵」だね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200520
					]
				},
				{
					"id": 220200520,
					"content": "もちろん、手伝っていただけるのであれば。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200523
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200523,
					"content": "いずれにしても、色々と助けてもらいましたので、今回の報酬を先に受け取ってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200524
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200524,
					"content": "それも珊瑚から指示されたこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200525
					]
				},
				{
					"id": 220200525,
					"content": "いいえ、今回は私自身の気持ちです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200526
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200526,
					"content": "改めて感謝申し上げます。もしよろしければ、また遊びに来てください。所長もきっと歓迎するでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200521,
					"content": "解決した後の報酬は期待できるよね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200522
					]
				},
				{
					"id": 220200522,
					"content": "具体的なことは分かりませんが、きっと満足すると思いますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200523
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200510,
					"content": "それが珊瑚の言ってた「完全犯罪」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200511
					]
				},
				{
					"id": 220200511,
					"content": "はい。当時、所長は「犯人」を見つけ出した時に、何もかもが…完璧すぎたと言っていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200512
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200512,
					"content": "所長が調査を始めた後、手がかりや証拠、犯行動機が自ずと手に入ったそうなんですが、それら全てがある人物を指していたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200513
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200513,
					"content": "結局、奉行所はその人物を犯人として扱いましたが、所長は「真犯人は別にいる」と信じています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200514
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200503,
					"content": "本当のことを言ってくれてもいいのに…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200504
					]
				}
			]
