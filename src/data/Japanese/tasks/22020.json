			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"天野",
					"安藤"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220200201,
					"content": "おや？旅人、どうしてここに？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200202
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220200202,
					"content": "龍二に頼まれてお菓子を渡しに来た。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200203
					]
				},
				{
					"id": 220200203,
					"content": "お？どれどれ…「緋櫻餅」じゃないか。龍二のやつ、気を遣ってるな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200204
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220200204,
					"content": "#おい安藤、お前もそんなに警戒するなよ。{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}は外国人だけど、この前助けてくれたじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200205
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220200205,
					"content": "あいつ、俺の大好物を覚えてくれていたのか。さすが、一緒に仕事してた仲間だぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200206
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220200206,
					"content": "龍二と同僚だったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200207
					]
				},
				{
					"id": 220200207,
					"content": "おや？あいつ言ってなかったのか？短い間だったけど、俺たちと一緒に働いてたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200208
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220200208,
					"content": "しかし、なぜか突然、あいつはある事件に巻き込まれてしまったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200209
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220200209,
					"content": "最後は珊瑚のおかげで真犯人が判明し、龍二への疑いは晴れた。しかしその後、あいつはなぜか奉行所を出て、珊瑚のところで働くようになった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200210
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220200210,
					"content": "これ以上の情報は、俺でも分からない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200211
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220200211,
					"content": "おい、そこまででいいだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200212
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220200212,
					"content": "うん、そうだな。しかしあいつ、珊瑚のところで上手くやってるみたいだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200213
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220200213,
					"content": "できれば、俺も…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200214
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220200214,
					"content": "お前なぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200215
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220200215,
					"content": "コホン！とにかく、ありがとうな。旅人、この菓子は受け取っておくよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200216
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220200216,
					"content": "龍二と珊瑚によろしくな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "天野"
				}
			]
		},
		{
			"id": 2202003,
			"completionStepIds": [
				2202003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
