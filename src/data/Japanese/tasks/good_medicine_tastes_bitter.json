			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"沈香"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220080101,
					"content": "小豆、大人しく薬を飲まないと治らないわよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080102
					],
					"speakerTitle": "沈香"
				},
				{
					"id": 220080102,
					"content": "嫌だ嫌だ！苦いし、飲みたくない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080103
					],
					"speakerTitle": "小豆"
				},
				{
					"id": 220080103,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080104
					]
				},
				{
					"id": 220080104,
					"content": "旅人かしら…実はね、うちの小豆は体が弱く、この前白先生から処方をもらったんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080105
					],
					"speakerTitle": "沈香"
				},
				{
					"id": 220080105,
					"content": "この子ったら不卜廬の薬が苦いと言って、どうしても飲んでくれないの。はあ、苦くない薬なんてあるわけないでしょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080106
					],
					"speakerTitle": "沈香"
				},
				{
					"id": 220080106,
					"content": "この子に大人しく言うことを聞いてもらうように、薬を飲んだら「杏仁豆腐」を食べさせるって約束したわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080107
					],
					"speakerTitle": "沈香"
				},
				{
					"id": 220080107,
					"content": "旅人、もし時間があったら、「杏仁豆腐」を探してくれる？私は小豆の相手をしなきゃいけないから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080108,
						220080110,
						220080115
					],
					"speakerTitle": "沈香"
				},
				{
					"id": 220080108,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080109
					]
				},
				{
					"id": 220080109,
					"content": "では頼んだわね。一つでいいから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "沈香"
				},
				{
					"id": 220080110,
					"content": "どういう病気？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080111
					]
				},
				{
					"id": 220080111,
					"content": "私もよく分からないけど、白先生曰く、とても難しい病気で、症状がよくなっても薬を飲み続けないといけないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080112
					],
					"speakerTitle": "沈香"
				},
				{
					"id": 220080112,
					"content": "もしかしたら、小豆は一生薬を飲まないといけない…まだこんなに小さいのに、想像もできないわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080113
					],
					"speakerTitle": "沈香"
				},
				{
					"id": 220080113,
					"content": "私が代わりに病気をもらえたらいいのに…今は少しでもこの子が楽になれるように祈るしかないわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080114
					],
					"speakerTitle": "沈香"
				},
				{
					"id": 220080114,
					"content": "旅人、お願い、杏仁豆腐を探してきてほしい、一つでいいから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "沈香"
				},
				{
					"id": 220080115,
					"content": "小豆、どうして薬を飲まないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080116
					]
				},
				{
					"id": 220080116,
					"content": "薬は苦いもん！ルルたちの薬はそんなに苦くないのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080117
					],
					"speakerTitle": "小豆"
				},
				{
					"id": 220080117,
					"content": "小豆、ルルたちのはままごと遊びよ、あれは杏仁豆腐の糖水で、薬じゃないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080118
					],
					"speakerTitle": "沈香"
				},
				{
					"id": 220080118,
					"content": "じゃあ…杏仁豆腐で治せないの？なんで苦い薬なんか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080119
					],
					"speakerTitle": "小豆"
				},
				{
					"id": 220080119,
					"content": "いい子だから、病気を治したら、なんでも食べていいから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080120
					],
					"speakerTitle": "沈香"
				},
				{
					"id": 220080120,
					"content": "なんで薬は杏仁豆腐みたいに甘くないの、嫌だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080121
					],
					"speakerTitle": "小豆"
				},
				{
					"id": 220080121,
					"content": "この子ったら…旅人、お願い、杏仁豆腐を探してきてほしい、一つでいいから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "沈香"
				}
			]
		},
