					"nextDialogs": [
						205110403
					]
				},
				{
					"id": 205110403,
					"content": "これが？なんだか、普通のものとあまり変わらないみたいだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110404
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205110404,
					"content": "どう見ても、普通のラズベリーだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110405
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205110405,
					"content": "まあ、いいや、先生からもらった処方箋だし、指示通りに作ってみるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110406
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205110406,
					"content": "ありがとな、これは報酬だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110407
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205110407,
					"content": "今後もお前に頼むかもしれないから、断らないでくれよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アンソニー"
