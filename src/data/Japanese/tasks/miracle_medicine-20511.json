					"アンソニー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205110101,
					"content": "この処方は本当に効くのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110102
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205110102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110103
					]
				},
				{
					"id": 205110103,
					"content": "旅人！ちょうどよかった、今困ってるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110104
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205110104,
					"content": "あのさ、妹のアナは覚えてるよな？病気で今まで何度診てもらっても治らなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110105
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205110105,
					"content": "それで璃月港に難病の解決に長ける神医がいると聞いて、人に頼んで処方箋をもらってきたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110106
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205110106,
					"content": "処方箋に書いてある材料は変わってるけど…試してみるしかないんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110107
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205110107,
					"content": "えっと…「草スライムに呑み込まれたラズベリー」を探してきてくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110108,
						205110112,
						205110116
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205110108,
					"content": "本当にそういうものがある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110109
					]
				},
				{
					"id": 205110109,
					"content": "俺も分からないんだ！草スライムはラズベリーを食べるのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110110
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205110110,
					"content": "た、頼むよ！草スライムが出没する場所を知ってるし、ちょうどそこにもラズベリーがあるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110111
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205110111,
					"content": "見てきてほしいんだ、頼むよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205110112,
					"content": "その医者あやしいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110113
					]
				},
				{
					"id": 205110113,
					"content": "やっぱお前もそう思うのか？でも、他に方法はないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110114
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205110114,
					"content": "草スライムが出没する場所を知ってる、ちょうどそこにもラズベリーがあるから、見てきてほしいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110115
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205110115,
					"content": "もちろんそれでできた薬は俺は毒見するよ。なにがあってもアナの体を治したいんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205110116,
					"content": "なかったら草スライムを連れてくる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110117
					]
				},
				{
					"id": 205110117,
					"content": "え、えっ？俺が草スライムにラズベリーを食べさせるのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110118
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205110118,
					"content": "勘弁してくれよ、こないだアナの薬を取った時、清泉町まで草スライムに追いかけられたんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110119
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205110119,
					"content": "草スライムが出没する場所を知ってる、ちょうどそこにもラズベリーがあるから、見てきてほしいんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110120
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205110120,
					"content": "まあ…本当に見つからなかったら…草スライムでもいいよ！大丈夫！アナのために俺はやるよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アンソニー"
				}
			]
		},
