			},
			"dialogs": [
				{
					"id": 730600501,
					"content": "アランバリカはきっとすぐダーリ遺跡から戻ってきます。アランバリカのアランラカラリがあれば、鉄塊だって、「キノコン」だって、怖くないのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600502
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730600502,
					"content": "アランナクラ、アランバリカの半分くらい強かったら、苗畑を守れるのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600503
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730600503,
					"content": "アランナクラ、アランバリカの半分の半分もない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600504
					],
					"speakerTitle": "アランコンティ"
				},
				{
					"id": 730600504,
					"content": "ううぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600505
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730600505,
					"content": "アランナクラはもっと勇敢になれます。金色のナラのように。ただ、時間がかかるだけなのです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランパンドゥ"
				}
			]
		},
