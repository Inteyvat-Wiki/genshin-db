				"points": []
			},
			"dialogs": [
				{
					"id": 730600301,
					"content": "アランバリカは予想通り順調でしたが、ヤスナ幽境のアランナクラと夢の林のアランコンティが心配です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600302
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730600302,
					"content": "アランナクラ…わんさといる悪いキノコに、万が一また捕まってたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600303
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730600303,
					"content": "無駄な心配はよせ。金色のナラは強い。嵐が枯れ木を倒すみたいに、メガトン大鉄塊をやっつけた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600304
					],
					"speakerTitle": "アランバリカ"
				},
				{
					"id": 730600304,
					"content": "ヴァルナ神器さえ治れば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランパンドゥ"
				}
			]
		},
