			"dialogs": [
				{
					"id": 730600601,
					"content": "ヤスナ幽境、悪い奴がたくさんいる。でもアランナクラは戻ってきた。うん、いいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600602
					],
					"speakerTitle": "アランバリカ"
				},
				{
					"id": 730600602,
					"content": "金色のナラ、アランナクラと一緒に悪い奴をかわして、石の記憶もきれいにしてくれた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600603
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730600603,
					"content": "ヴァルナ神器が治ったら、苗畑の花を持っていって。アランナラは、忘れない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600604
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730600604,
					"content": "あとは、夢の林にいるアランコンティだけです。アランコンティが戻ってきたら、ヴァルナ神器の根をかじる、悪い虫を退治しに行けます…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランパンドゥ"
				}
			]
		},
