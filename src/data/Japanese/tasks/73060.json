			},
			"dialogs": [
				{
					"id": 730600401,
					"content": "夢の林…穏やかな曲、水の音、鳥の羽音、小枝を踏む音…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600402
					],
					"speakerTitle": "アランコンティ"
				},
				{
					"id": 730600402,
					"content": "ナラやパイモンと話していると…パイモンはおもしろい。でも、種になりたがらないのが残念だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600403
					],
					"speakerTitle": "アランコンティ"
				},
				{
					"id": 730600403,
					"content": "なぜなら、パイモンはアランナラではないからです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600404
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730600404,
					"content": "夢の林はもう大丈夫。ダーリ遺跡にいるアランバリカも安全です。ヤスナ幽境には「キノコン」が大勢います。アランナクラ…心配なのです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランパンドゥ"
				}
			]
		},
