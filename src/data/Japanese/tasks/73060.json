			},
			"dialogs": [
				{
					"id": 730600201,
					"content": "金色のナラ、なにも怖くないみたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600202
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730600202,
					"content": "金色のナラは勇敢なナラ、ナラヴァルナと同じなのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600203
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730600203,
					"content": "ダーリ遺跡のアランバリカと夢の林のアランコンティは心配ですが、金色のナラの助けがあればきっと大丈夫なのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600204
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730600204,
					"content": "#ヴァルナ神器がなおったら、悪いヤツは苗畑を荒らさなくなる。苗畑の花は、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}にあげる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランナクラ"
				}
			]
		},
