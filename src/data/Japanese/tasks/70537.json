			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"怪しい木箱"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705371101,
					"content": "ひとまず調べてみよう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705371102
					]
				},
				{
					"id": 705371102,
					"content": "箱に残されたメモの内容…なんだかおっかないな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705371103,
					"content": "なんで危険物をシードル湖に放置してるんだよ？向こうにいる二人の騎士の持ち物じゃないだろうな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705371104,
					"content": "木箱におっきな隙間があるぞ。中を覗いてみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705371105,
					"content": "どれどれ…中には丸い物が…みっちり詰まってるな…夕暮れの実よりもずっと大きくて、赤いまるい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705371106,
					"content": "待てよ、爆弾じゃないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705371107,
					"content": "でも騎士団はなんでここに爆弾を置いてるんだ？まさかリサさんの言ってた、シードル湖に侵入した魚たちを…爆破するためか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7053712,
			"completionStepIds": [
				7053701
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_ACTIVITY_CLIENT_COND",
						"rawParams": [
							"5160",
							"5160001",
							"1"
						]
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7053701",
							"2"
						],
						"stepId": 7053701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"怪しい木箱"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705371201,
					"content": "ははっ！爆弾だ！これで遊ぼう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705371202
					]
				},
				{
					"id": 705371202,
					"content": "急にテンションが上がったな…この爆弾の威力がどのくらいかわからないんだぞ。罪もない通行人をケガさせたらマズいだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371203,
						705371204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705371203,
					"content": "どのみち魚に使うんだし、湖に投げよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705371205
					]
				},
				{
					"id": 705371205,
					"content": "うっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705371206,
					"content": "そう言われると、気になってきちゃったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705371207,
					"content": "いつもはよく、クレーが魚をドカーンしたいとか、魚をドカーンしてるとか、そのせいでお仕置きされてるとか聞くけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705371208,
					"content": "すぐそばに爆弾があって、しかも目の前に湖があるんなら…確かに試したくなってくるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705371209,
					"content": "一つ投げるくらいなら…大丈夫だよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371210,
						705371211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705371210,
					"content": "一人一つね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705371212
					]
				},
				{
					"id": 705371212,
					"content": "パイモンと一緒に怪しい木箱を開け、それぞれ爆弾を取り出して点火方法を調べた。そして「3、2、1」の合図で安全ピンをぐっと抜き、爆弾をシードル湖へと投げ入れた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705371213
					]
				},
				{
					"id": 705371213,
					"content": "水中から鈍い轟音が響いたかと思うと湖面に二つの水しぶきが上がり、コオニフグが何匹か回転しながら飛び散った。\\nパイモンと顔を見合わせて笑い、喜びのハイタッチをすると、初の爆弾漁で得た魚をいそいそと拾い集めて、その場を後にしようとした…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705371214
					]
				},
				{
					"id": 705371214,
					"content": "ところが「思いつきの極秘おさかなドッカーン作戦」には、よからぬ結果が待ち受けていたようだ。爆弾と同時に、別の問題を誘爆させてしまったらしい…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705371215
					]
				},
				{
					"id": 705371215,
					"content": "ああっ！！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371216
					],
					"speakerTitle": "ファニーヤ"
				},
				{
					"id": 705371216,
					"content": "耳が！！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371217
					],
					"speakerTitle": "ファニーヤ"
				},
				{
					"id": 705371217,
					"content": "びっくりした…！ファニーヤ、どうしたんです？大丈夫ですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371218
					],
					"speakerTitle": "エマート",
					"speakerSubtitle": "慌てふためいたような叫び声"
				},
				{
					"id": 705371218,
					"content": "水中で突然、爆発が…あやうく耳が聞こえなくなるところだった。この声紋はあなたの爆弾でしょ、エマート！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371219
					],
					"speakerTitle": "ファニーヤ",
					"speakerSubtitle": "すごく恨めしそうな声"
				},
				{
					"id": 705371219,
					"content": "ええっ？私はずっとあなたの隣にいましたよ？何もしてないですって。ほら、爆弾なんて持ってません！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371220
					],
					"speakerTitle": "エマート",
					"speakerSubtitle": "ショックから抜け出しきれていない声"
				},
				{
					"id": 705371220,
					"content": "嘘つき！慌てふためくあたしの姿を見たいがために、時限爆弾を用意して湖に投げたんじゃない！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371221
					],
					"speakerTitle": "ファニーヤ",
					"speakerSubtitle": "すごく恨めしそうな声"
				},
				{
					"id": 705371221,
					"content": "あなたの言う通りなら、私は写真機を用意してますよ。今こうして地面に泣き崩れてるあなたを撮らなきゃ損ですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371222
					],
					"speakerTitle": "エマート",
					"speakerSubtitle": "ショックから抜け出しきれていない声"
				},
				{
					"id": 705371222,
					"content": "サイテー！来月の家賃は割引してやらないからね。それと、未だに支払ってない水道料金、家具費用、奢ってやった食事代も…耳を揃えて返しなさいよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371223
					],
					"speakerTitle": "ファニーヤ",
					"speakerSubtitle": "すごく恨めしそうな声"
				},
				{
					"id": 705371223,
					"content": "ちょ…ちょちょちょ、ちょっとお待ちを！私が悪うございました！ファニーヤ、信じてください！今まで何十回もイタズラをしてきましたけど…今回ばかりは絶対に私じゃありません！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371224
					],
					"speakerTitle": "エマート",
					"speakerSubtitle": "ショックから抜け出しきれていない声"
				},
				{
					"id": 705371224,
					"content": "もし私が…水中に長時間入れたままにでき、信頼性のすこぶる高い時限爆弾を手軽に作れるのなら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371225
					],
					"speakerTitle": "エマート",
					"speakerSubtitle": "ショックから抜け出しきれていない声"
				},
				{
					"id": 705371225,
					"content": "前回一緒にヒルチャールを罠にハメた時に、仕掛け場所に死に物狂いで突っ込んで、手動で起爆する必要なんてなかったでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371226
					],
					"speakerTitle": "エマート",
					"speakerSubtitle": "ショックから抜け出しきれていない声"
				},
				{
					"id": 705371226,
					"content": "…確かに。あなたほど思考回路の単純な人が、時限爆弾でイタズラを仕掛けるなんて思いつくわけないよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371227
					],
					"speakerTitle": "ファニーヤ",
					"speakerSubtitle": "すごく恨めしそうな声"
				},
				{
					"id": 705371227,
					"content": "なっ…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371228
					],
					"speakerTitle": "エマート",
					"speakerSubtitle": "ショックから抜け出しきれていない声"
				},
				{
					"id": 705371228,
					"content": "あなただって、私を騙してますよね！偵察装置を使ってるときに、少しでも大きな音がしたら聴力を損ねるんだって言いませんでしたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371229
					],
					"speakerTitle": "エマート",
					"speakerSubtitle": "ショックから抜け出しきれていない声"
				},
				{
					"id": 705371229,
					"content": "なのに今でも耳は聴こえているようですし、威勢よく私とケンカしてますよね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371230
					],
					"speakerTitle": "エマート",
					"speakerSubtitle": "ショックから抜け出しきれていない声"
				},
				{
					"id": 705371230,
					"content": "あなた、何も分かってない！耳へのダメージは徐々に蓄積されて、段階的に悪化するの。今まさにあんたが大声で口答えするせいで、ダメージが大きくなってるんだから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371231
					],
					"speakerTitle": "ファニーヤ",
					"speakerSubtitle": "すごく恨めしそうな声"
				},
				{
					"id": 705371231,
					"content": "ある日突然、声紋の精密な識別ができなくなったら、その日があたしの失業する日ね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371232
					],
					"speakerTitle": "ファニーヤ",
					"speakerSubtitle": "すごく恨めしそうな声"
				},
				{
					"id": 705371232,
					"content": "そうなったら、あなただって住む家を失うよ。あたしはもっと高い家賃を払ってくれる人に貸し出すことになるから。それで…そう…漁師にでもなるんだ！あなたのことなんて知ったこっちゃないからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371233
					],
					"speakerTitle": "ファニーヤ",
					"speakerSubtitle": "すごく恨めしそうな声"
				},
				{
					"id": 705371233,
					"content": "じゃあ小さい声でケンカすればいいんですよ…小さい声で…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371234
					],
					"speakerTitle": "エマート",
					"speakerSubtitle": "ショックから抜け出しきれていない声"
				},
				{
					"id": 705371234,
					"content": "………",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371235
					],
					"speakerTitle": "エマート",
					"speakerSubtitle": "はっきりしない声"
				},
				{
					"id": 705371235,
					"content": "………",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371236
					],
					"speakerTitle": "ファニーヤ",
					"speakerSubtitle": "ぼやけてゆく声"
				},
				{
					"id": 705371236,
					"content": "なに喋ってるのかよく聞こえないな…けど、どうせ自分勝手なことを言い合ってケンカしてるんだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371237,
						705371238
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705371237,
					"content": "はぁ～！すっごく楽しい！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705371239
					]
				},
				{
					"id": 705371239,
					"content": "だな！超おもしろいぜ！もう一個投げて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371240
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705371240,
					"content": "いやいや、一回で十分だぞ。あんまり投げたら、向こうにいる二人が調べに来るだろうし。捕まるわけにはいかないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371241
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705371241,
					"content": "そこそこの騒ぎを…引き起こしちゃったみたいだな？でも、ずっと抱えてた好奇心を満たせて大満足だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705371238,
					"content": "何も問題なさそうだね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705371239
					]
				},
				{
					"id": 705371211,
					"content": "思いっきり投げよう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705371212
					]
				},
				{
					"id": 705371204,
					"content": "爆弾を投げる感覚、知りたくない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705371205
					]
				}
			]
		},
