			"completionStepIds": [
				7154101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7154101",
							"2"
						],
						"stepId": 7154101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"明瀾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715410101,
					"content": "責任者があの教官じゃありませんように…はぁ、もう祈るしかない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410102
					],
					"speakerTitle": "明瀾"
				},
				{
					"id": 715410102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715410103
					]
				},
				{
					"id": 715410103,
					"content": "#えっ！？…ああ、{NICKNAME}さんでしたか。ふぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410104
					],
					"speakerTitle": "明瀾"
				},
				{
					"id": 715410104,
					"content": "教官かと思いました…今の言葉を聞かれたら、また訓練に連れていかれるところです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410105,
						715410106
					],
					"speakerTitle": "明瀾"
				},
				{
					"id": 715410105,
					"content": "こんな時も訓練してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715410107
					]
				},
				{
					"id": 715410107,
					"content": "まあ、祭りだからこそですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410108
					],
					"speakerTitle": "明瀾"
				},
				{
					"id": 715410108,
					"content": "璃月港は広いですし、祭りの間は各地から観光客が集まります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410109
					],
					"speakerTitle": "明瀾"
				},
				{
					"id": 715410109,
					"content": "街の秩序を保ち、皆さんの安全を守るために、千岩軍は街中だけでなく野外にも機動隊の拠点を設けました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410110
					],
					"speakerTitle": "明瀾"
				},
				{
					"id": 715410110,
					"content": "機動隊というのは——そうですね…あちこち回りながら、人々を助ける部隊だと思っていただければ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410111
					],
					"speakerTitle": "明瀾"
				},
				{
					"id": 715410111,
					"content": "困ったときは、その辺にいる機動隊に助けを求めれば、協力が得られるというわけです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410112
					],
					"speakerTitle": "明瀾"
				},
				{
					"id": 715410112,
					"content": "危険に遭遇した時や、ものを失くした時、迷子になった時なんかにも、お助けします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410113
					],
					"speakerTitle": "明瀾"
				},
				{
					"id": 715410113,
					"content": "ただ…璃月港全土に配備するには人員が足りなくて…教官は待機予定だった我々予備軍まで動員したんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410114
					],
					"speakerTitle": "明瀾"
				},
				{
					"id": 715410114,
					"content": "私たちは入隊したばかりで、訓練期間もさほど長くありません。その埋め合わせに、教官は演武会を開いて鍛えさせようとしているんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410115
					],
					"speakerTitle": "明瀾"
				},
				{
					"id": 715410115,
					"content": "教官はとても厳しい方で、彼の下で訓練したことがある人は、名前を聞いただけで震えてしまうほどです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410116
					],
					"speakerTitle": "明瀾"
				},
				{
					"id": 715410116,
					"content": "その人の訓練を受けたことがあるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715410117
					]
				},
				{
					"id": 715410117,
					"content": "ええ…まあ一応。確かに訓練の効果は抜群でしたが、思い出すたびに…足が震えて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410118
					],
					"speakerTitle": "明瀾"
				},
				{
					"id": 715410118,
					"content": "そうだ。もしよかったら、演武会に参加してみませんか？訓練中、教官は何度もあなたの話をしていました。戦闘はもちろん、格闘も強いのだとか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410119
					],
					"speakerTitle": "明瀾"
				},
				{
					"id": 715410119,
					"content": "あなたなら、きっと我々を上回る成績を収められると思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410120,
						715410122
					],
					"speakerTitle": "明瀾"
				},
				{
					"id": 715410120,
					"content": "試してみたい！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715410121
					]
				},
				{
					"id": 715410121,
					"content": "潔いですね…さすが璃月にその名を轟かせる英雄です。では、こちらにどうぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "明瀾"
				},
				{
					"id": 715410122,
					"content": "ちょっと考えさせて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715410123
					]
				},
				{
					"id": 715410123,
					"content": "はい。参加したくなったら、気軽に声をかけてくださいね。きっと教官も大歓迎だと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "明瀾"
				},
				{
					"id": 715410106,
					"content": "海灯祭なのに。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715410107
					]
				}
			]
		}
	]
}