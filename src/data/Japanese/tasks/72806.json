				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"行秋"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728060401,
					"content": "ふむ…ここの表現は悪くない、とても斬新だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060402
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 728060402,
					"content": "行秋。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060403
					]
				},
				{
					"id": 728060403,
					"content": "なるほど、なるほど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060404
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 728060404,
					"content": "行秋！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060405
					]
				},
				{
					"id": 728060405,
					"content": "#おや？{NICKNAME}、君だったか、久しぶり。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060406
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 728060406,
					"content": "さっきの挨拶からして、元気そうだね。ふむ、よかった…今日は何か用かい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060407
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 728060407,
					"content": "実は、おまえに人を探してほしいんだ。おまえは本をたくさん読んでるし、知ってるかもしれないと思って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 728060408,
					"content": "人探し？もしかして作家かな？ふむ…構わないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060409
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 728060409,
					"content": "「枕玉」について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060410
					]
				},
				{
					"id": 728060410,
					"content": "「枕玉」？そ、その名前をどこで聞いたんだい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060411
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 728060411,
					"content": "この『沈秋拾剣録』に書いてある…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060412
					]
				},
				{
					"id": 728060412,
					"content": "今、稲妻にある「八重堂」から「枕玉」って人への手紙を届けるために、その人を探してるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 728060413,
					"content": "「枕玉」って人が誰なのか知らないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060414
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 728060414,
					"content": "えっと…「枕玉」は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060415
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 728060415,
					"content": "恥ずかしながら、それは…僕の筆名だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060416
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 728060416,
					"content": "えっ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060417
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 728060417,
					"content": "聞いたことないけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060418
					]
				},
				{
					"id": 728060418,
					"content": "これは別に…言わなきゃいけないことじゃなかったから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060419
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 728060419,
					"content": "当時、璃月にいた時、担当の編集がこの本について「設定が突飛すぎて、物語も陳腐。誰も好きにならないだろう」と言って、僕の投稿をボツにした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060420
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 728060420,
					"content": "それを聞いた後…コホンッ、不服に思ってね。自分で何冊か刷って、こっそり「万文集舎」に置いたんだ。読む者がいるか確かめるために。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060421
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 728060421,
					"content": "だけど結果は、ほとんど読む者がいなかった。だからそれ以降は気にしていなかったんだ。だけどまさか、この本が稲妻で人気になるとはね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060422
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 728060422,
					"content": "何はともあれ、僕の書いた本が人々に読まれるのはいいことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060423
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 728060423,
					"content": "この手紙もしっかり読ませてもらうよ。ありがとう、旅人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "行秋"
				}
			]
		},
		{
