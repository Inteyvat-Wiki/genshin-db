			"trigger": {
				"objectNames": [
					"常九"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728060201,
					"content": "ん？旅人、今日は何か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060202
					],
					"speakerTitle": "常九"
				},
				{
					"id": 728060202,
					"content": "「八重堂」の手紙と贈り物について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060203
					]
				},
				{
					"id": 728060203,
					"content": "「八重堂」からの手紙？またわしにペンネームを変えさせるつもりじゃないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060204
					],
					"speakerTitle": "常九"
				},
				{
					"id": 728060204,
					"content": "だから、本名を使うって言ったのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060205
					],
					"speakerTitle": "常九"
				},
				{
					"id": 728060205,
					"content": "まあ、いい、読んでみる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060206
					],
					"speakerTitle": "常九"
				},
				{
					"id": 728060206,
					"content": "小説コンテストの…審査員って…わしには時間がないかもしれないが、招待してくれてありがとう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060207
					],
					"speakerTitle": "常九"
				},
				{
					"id": 728060207,
					"content": "ん？それと他にもこんなに…これは…創作についての意見…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060208
					],
					"speakerTitle": "常九"
				},
				{
					"id": 728060208,
					"content": "うぅ、き、きちんと見ておくよ。ありがとう、旅人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "常九"
				}
			]
		},
		{
			"id": 7280604,
			"completionStepIds": [
				7280604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280604",
							"2"
						],
						"stepId": 7280604,
						"stateName": "QUEST_STATE_UNFINISHED"
