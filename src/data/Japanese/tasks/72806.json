					"荒谷"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728060501,
					"content": "あら、やっと帰ってきたのね！どうだった？お二人に会えた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060502
					],
					"speakerTitle": "荒谷"
				},
				{
					"id": 728060502,
					"content": "手紙は届けた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060503
					]
				},
				{
					"id": 728060503,
					"content": "よかった！ありがとう、なんて言ってた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060504
					],
					"speakerTitle": "荒谷"
				},
				{
					"id": 728060504,
					"content": "ちゃんと手紙を見るって。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060505
					]
				},
				{
					"id": 728060505,
					"content": "よかった…はぁ、お二人とも璃月にいるから…普段は会いに行けなかったのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060506
					],
					"speakerTitle": "荒谷"
				},
				{
					"id": 728060506,
					"content": "特に「枕玉」先生の『沈秋拾剣録』は本人の投稿じゃなくて、稲妻に持ち込んだ商人によるものなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060507
					],
					"speakerTitle": "荒谷"
				},
				{
					"id": 728060507,
					"content": "それで、「八重堂」の編集がその本を読んで価値に気付き、璃月に行って「枕玉」先生と正式な契約を交わそうとしたんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060508
					],
					"speakerTitle": "荒谷"
				},
				{
					"id": 728060508,
					"content": "稲妻の形勢が大きく変わって、璃月に行ける人も手配できず…送った手紙も音沙汰がなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060509
					],
					"speakerTitle": "荒谷"
				},
				{
					"id": 728060509,
					"content": "だから先にこの本を刷って、印税を記録しておいたの。あとで「枕玉」先生に連絡して渡すために。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060510
					],
					"speakerTitle": "荒谷"
				},
				{
					"id": 728060510,
					"content": "でも、こんなに長い時間が経ったのに、『沈秋拾剣録』はまだ売り上げを落としてない。印税もますます貯まってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060511
					],
					"speakerTitle": "荒谷"
				},
				{
					"id": 728060511,
					"content": "はぁ、今回のコンテストにはぜひ「枕玉」先生に参加してほしいの。この印税を…このままにしてちゃいけない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "荒谷"
				}
			]
		},
