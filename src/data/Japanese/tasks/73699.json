					"nextDialogs": [
						736990647
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736990647,
					"content": "ソルシュにはもうちょっと時間が必要かもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736990642,
					"content": "ミヒルには「謁賛主」は必要ない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736990643
					]
				},
				{
					"id": 736990643,
					"content": "うん、むしろ忘れ去られたほうがいいって、あいつは言ってたもんな。",
