	"talks": [
		{
			"id": 7369901,
			"completionStepIds": [
				7369901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
