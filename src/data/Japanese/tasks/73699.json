			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ズルヴァーン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736990101,
					"content": "おや——これまでの訓練を順調にクリアしたみたいネ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990102
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 736990102,
					"content": "クリアはしたけど、ソルシュが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736990103,
					"content": "何百年か前のウェネトの結晶を見た時は、何百年保存されてきたとは言え、いつかは跡形もなく消えてしまう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736990104,
					"content": "とか言ってたくせに、自分の頌歌がボロボロになって世に伝えられる話になると、手のひらを返すみたいに態度が急変したぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736990105,
					"content": "ふん、当然デショ？私の功績…いえ、つまり我ら花霊の功績は、永遠に残るモノ。いつ消え失せるかも分からない存在と、比べられる筋合いはありマセン。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990106
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736990106,
					"content": "保存がきかないというのは、きっと保存方法に問題があるハズ。先輩はそれを私に悟らせるために、ウェネトの結晶を改めて観察させてくださったんですよネ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990107
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736990107,
					"content": "なるほど、ソルシュはそういう風に考えてたのネ。それはそれで面白い考えだと思うワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990108
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 736990108,
					"content": "先輩にとって、花霊一族の名声は重要ではないのデスか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990109
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736990109,
					"content": "そうネェ、人類の間で伝えられるような名声なら、あまり気にしてはいないかしら。だって、今のスケプティック団はつまらないにも程があるもノ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990110
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 736990110,
					"content": "#勿論、{NICKNAME}やパイモンのような面白い人が、人類の中にもう少し増えているのであれば、話は別だけれど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990111
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 736990111,
					"content": "へへ、ズルヴァーンに褒められたぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990112,
						736990115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736990112,
					"content": "やった！先輩、お褒めにあずかり光栄です！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736990113
					]
				},
				{
					"id": 736990113,
					"content": "ま…待ちなさいヨ、あなたの先輩じゃないデショ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990114
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736990114,
					"content": "なんだよソルシュ、けち臭いな。ズルヴァーンはここの長老で大先輩なんだから、オイラたちが先輩って呼んだっておかしくないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736990117,
					"content": "さて、本題に戻りましょう…ソルシュにとって、人間の世界における名声は重要、ということネ。ちょうど次の訓練は、あなたにぴったりかもしれないわネ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990118
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 736990118,
					"content": "では、吉報を待っているワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 736990115,
					"content": "「面白い」って褒め言葉？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736990116
					]
				},
				{
					"id": 736990116,
					"content": "あら、私からすれば、褒め言葉ヨ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990117
					],
					"speakerTitle": "ズルヴァーン"
				}
			]
		},
		{
			"id": 7369906,
			"completionStepIds": [
				7369906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7369906",
							"2"
						],
						"stepId": 7369906,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ソルシュ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736990601,
					"content": "あれ、ここって、前にミヒルを探しに来たとき、通った場所じゃないか？ミヒルはもうここにはいないはずだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990602
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736990602,
					"content": "周りのいばらたちは、ミヒルの仲間たちか？いいやつらだったよな。あいつらには結構助けてもらったぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990603
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736990603,
					"content": "白フラってば…私の功績のコト、忘れてないでしょうネ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990604
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736990604,
					"content": "もちろん、ソルシュは口うるさいけど、仲間たちとの友情を大事にするってことは、オイラも分かってるぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990605,
						736990607
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736990605,
					"content": "ソルシュの功績…もう忘れた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736990606
					]
				},
				{
					"id": 736990606,
					"content": "「謁賛主」たるものが、そんなに忘れっぽくては話にならないワ。罰として、頌歌をあと数篇書きなさい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990609
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736990609,
					"content": "へへ、ソルシュは口はキツいけど、心は豆腐みたいに柔らかくって優しいもんな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990610
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736990610,
					"content": "んなことないわヨ、私はただ花冠を手に入れるために…先輩に言われたカラ、仕方なく…ふん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990611
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736990611,
					"content": "何はともあれ、ソルシュが「二本角の花冠」を獲得できたのは、ミヒルのおかげでもあるんだろ？ちゃんと感謝しないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990612
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736990612,
					"content": "あいつは穢れに身を染め、醜くあがいていたのヨ…「浄罪の巡礼の道」を十回歩かせたって足りないワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990613
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736990613,
					"content": "十回はひどいだろ！待てよ…そんなにひどくもないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990614,
						736990616
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736990614,
					"content": "距離的にはそれほどでもない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736990615
					]
				},
				{
					"id": 736990615,
					"content": "うん、たまには運動するのもいいことだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990618
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736990618,
					"content": "大層な名前だから十日十晩も歩かされるのかと思っちゃったけど、実際はそんなに遠くないよな。むしろ、信じられないくらい短いぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990619
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736990619,
					"content": "もし純水精霊の巡礼の道ほどの長さを歩けるっていうなら、私もミヒルに感心するかもしれないワ。でもこれくらいの距離が、ミヒルには分相応デショ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990620
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736990620,
					"content": "純水精霊の巡礼の道ってなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990621
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736990621,
					"content": "巨大な災厄が発生した後、多くの純水精霊たちがフォンテーヌからスメールにやってきたノ。彼女たちが通った道のことを、巡礼の道って呼ぶのヨ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990622
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736990622,
					"content": "ええ、なんだそれ。純水精霊はなんでスメールにやってきたんだ？巡礼…って、なんのためのだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990623
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736990623,
					"content": "うぅ…私も先輩から聞いただけだもノ。確かに以前、フォンテーヌからやってきた純水精霊に会ったことはあるケド、あまり詳しいことは調べてないカラ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990624
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736990624,
					"content": "もしかして「万種母樹」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736990625
					]
				},
				{
					"id": 736990625,
					"content": "そうだ、花霊ができたのはその神様のお陰だって、ソルシュは言ってたよな。尊さなら、万種母樹が一番尊いぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990626
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736990626,
					"content": "でも、純水精霊と万種母樹に一体なんの関係があるんだ…？あ、もしかして、純水精霊と花霊って、遠い親戚だったりして？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990627
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736990627,
					"content": "うーん…ソルシュをよーく見たら、ますます純水精霊と似てるような気がしてきたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990628
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736990628,
					"content": "へへっ、もしかしてオイラ、驚きの秘密を発見しちゃったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990629,
						736990630
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736990629,
					"content": "あまり似てないけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736990631
					]
				},
				{
					"id": 736990631,
					"content": "白フラってば、またでたらめ言っちゃって…純水精霊になんか似てる訳ないデショ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990632
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736990632,
					"content": "うーん、それもそうだな。さっきのソルシュの話からすれば、純水精霊が歩く巡礼の道は、ミヒルが歩く浄罪の巡礼の道よりも遥かに長いんだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990633
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736990633,
					"content": "ってことは、純水精霊は花霊よりすごいってことだな！ソルシュの負けだ、ふふん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990634
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736990634,
					"content": "な、なんですっテ！？私はそういう意味で言ったんじゃなくって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990635
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736990635,
					"content": "…正確に言えば、「浄罪の巡礼の道」は単に実際に歩く距離を示しているだけじゃなく、一種の上昇と回帰の傾向を表しているノ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990636
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736990636,
					"content": "うーん…なんかすごそうには聞こえるけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990637
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736990637,
					"content": "とにかく、限られた情報だけで花霊が純水精霊より劣ると断定するのは、合理的ではないワ！けっしてミヒルをかばうわけじゃないわヨ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990638
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736990638,
					"content": "そう言えば、なんでズルヴァーンは、今回の訓練がソルシュにぴったりとか言ってたんだろうな？特別なところは見当たらないけど…ミヒルもいないし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990639
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736990639,
					"content": "でも、もしミヒルがいたとしても、きっとソルシュに冷たい扱いをされたんだろうけど。二人は色んな面で正反対だからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990640,
						736990642
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736990640,
					"content": "まんまる対トゲトゲ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736990641
					]
				},
				{
					"id": 736990641,
					"content": "確かに…って、オイラが言いたいのはそういうことじゃないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990644
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736990644,
					"content": "あのマヌケ…もし自分の存在や、数百年間も貢献してきたコトが全部忘れ去られるとしたら、すべての意味がなくなるじゃナイ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990645
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736990645,
					"content": "もしかしたら、ズルヴァーンはそのことをソルシュに考えてほしかったんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990646
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736990646,
					"content": "……",
