			"dialogs": [
				{
					"id": 711450101,
					"content": "#本当に助かった。{NICKNAME}顧問、それに才能溢れる助手さん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711450102
					],
					"speakerTitle": "蘇定"
				},
				{
					"id": 711450102,
					"content": "これまでの演習を通して、複雑な戦況を解析するのに役立つ戦闘事例を数多く集めることができた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711450103
					],
					"speakerTitle": "蘇定"
				},
				{
					"id": 711450103,
					"content": "次は兵種の特徴に基づいて、戦法の幅を広げていけば、様々な状況を反映した「想定シナリオ」を作成できる。各部門、各等級の将校や兵士の参考になるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711450104
					],
					"speakerTitle": "蘇定"
				},
				{
					"id": 711450104,
					"content": "興味があるなら、今度会ったときに君たちにもその想定シナリオを渡そう。暇があれば練習材料として使ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711450105,
						711450107
					],
					"speakerTitle": "蘇定"
				},
				{
					"id": 711450105,
					"content": "もう終わり？まだ数回しかやってないのに…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711450106
					]
				},
				{
					"id": 711450106,
					"content": "君たちが多忙なことは承知しているからな、できるだけ似たような演習の繰り返しは避けたんだ。無論、まだ遊び足りないというなら、何度でも試してくれて構わない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711450109
					],
					"speakerTitle": "蘇定"
				},
				{
					"id": 711450109,
					"content": "何はともあれ、千岩軍の参謀部および他の参加部門を代表し、君たちに心から感謝しよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711450110
					],
					"speakerTitle": "蘇定"
				},
				{
					"id": 711450110,
					"content": "今後も君たちと協力して、魔物退治の力を高め、治安の改善を図っていけることを願っているよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711450111,
						711450112
					],
					"speakerTitle": "蘇定"
				},
				{
					"id": 711450111,
					"content": "喜んで力を貸すよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711450113
					]
				},
				{
					"id": 711450113,
					"content": "へへ、今回は万事順調だったな。過去に出会ってきたいろんな組織とも仲良くなれたし、テイワット各地の人の役にも立てて、ほんとよかったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711450114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711450114,
					"content": "それに、おまえが演習してるところを見てるうちに、オイラもいろいろ学べた気がするぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711450115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711450115,
					"content": "今後はヒマな時間があったら、オイラたちも分析とやらをやってみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711450116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711450116,
					"content": "たとえば、えーっと…アビスの魔術師と雪のイノシシ王がやりあったら、どっちが勝つかとか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711450117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711450117,
					"content": "あと…遺跡守衛とヴィシャップ·岩はどっちの頭のほうが硬いかとかさ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711450112,
					"content": "時間があったらまた来るね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711450113
					]
				},
				{
					"id": 711450107,
					"content": "#やっと終わった！お疲れ様、パイモンと{M#俺}{F#私}…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711450108
					]
				},
				{
					"id": 711450108,
					"content": "へへっ、まだルールとか完全には理解できてないけど、結構楽しかったし、結果もそう悪くなかったみたいだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711450109
					],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
}