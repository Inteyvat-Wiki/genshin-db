			"dialogs": [
				{
					"id": 401720401,
					"content": "新しいのが出てきたぞ！これは…地図だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401720402,
					"content": "地図？どこのだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720403
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401720403,
					"content": "これは、まさか燼寂海の…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720404
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401720404,
					"content": "燼寂海！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401720405,
					"content": "ワタシの知る限りでは、あの戦いの後、燼寂海は荒れ果てたトコロになった。ううん、あの戦いがあったからこそ、あそこは燼寂海になったのかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720406
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401720406,
					"content": "魔物と戦士が灰となって、戦場を埋め尽くした。時にはどこからともなく恐ろしい叫び声が聞こえる。時には天まで届くほどの炎が、叫び声を飲み込むコトもある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720407
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401720407,
					"content": "あそこの未知の危険と秘密は、数百年もの間、ジブンのチカラを証明したい、トップレベルの冒険者たちを引き寄せた。でも彼らのほとんどが戻らなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720408
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401720408,
					"content": "だいたい二、三十年前だったかしら、燼寂海の異変に気づいた人がいたの。山のように巨大な黒いイキモノが移動してるのを見たそうよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720409
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401720409,
					"content": "でもトツゼン、そこ一帯がすべて消えてしまった。何が起きたのかは、誰にも分からない。謎に満ちた伝説の地は、こうして無くなったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720410
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401720410,
					"content": "消えただって！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720411
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401720411,
					"content": "ええ。ワタシの記憶が正しければ、燼寂海が消えたのは、まさにこの地図が示すトコロなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720412
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401720412,
					"content": "それってどこなの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401720413
					]
				},
				{
					"id": 401720413,
					"content": "ナタの一番西、すべての部族から離れたトコロよ。昔は一般人が集団で暮らせるようなトコロじゃなかった。燼寂海が消えて、ようやく人が住めるような場所になったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720414
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401720414,
					"content": "って言っても、どれも聞いたハナシだから、ワタシも行ったコトはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720415
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401720415,
					"content": "人はそういうものよ。年を取っていくと、冒険心が薄れていく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720416
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401720416,
					"content": "ばあちゃんは遠出が面倒なだけだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720417
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401720417,
					"content": "待って、スピリットが集まり出した！欠片とウォーベンに向かってきてる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720418
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401720418,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720419
					],
					"speakerTitle": "ルラ"
				},
				{
					"id": 401720419,
					"content": "おおっ！ルラの体がまた動いたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720420
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401720420,
					"content": "今度は激しく反応してる…もしかして、燼寂海の場所が知りたかったの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720421
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401720421,
					"content": "僕も感じる。スピリットが集まってこっちに近づいてくる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720422
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401720422,
					"content": "ひぃっ、トリハダが立ってきたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720423
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401720423,
					"content": "効いたみたいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720424
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401720424,
					"content": "じゃあ、もうルラを起こしていいか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720425
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401720425,
					"content": "今日はまだダメ。スピリットをカラダに戻すのって、水をビンに入れるみたいにカンタンにはいかないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720426
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401720426,
					"content": "儀式用の剣を用意して、他の準備もしないと。大体二日くらいかかるかしら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720427
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401720427,
					"content": "でも、安心して。スピリットがもう戻ってきてるから、あと一歩よ。じゃあ、また二日後に会いましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シトラリ"
				}
			]
		}
	]
