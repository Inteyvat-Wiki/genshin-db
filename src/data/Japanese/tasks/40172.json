			"dialogs": [
				{
					"id": 401720101,
					"content": "みんな、調子はどう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720102
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401720102,
					"content": "ああ、ばあちゃんか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720103
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401720103,
					"content": "いい知らせはなさそうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720104
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401720104,
					"content": "ばあちゃんは何でもお見通しだな。旅人が霊をたくさん集めてきてくれたけど、ルラらしきものはなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720105
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401720105,
					"content": "ま、その顔を見ればね。気にしないで。しらみつぶしにやる方法はタイヘンだし、そんなものよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720106
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401720106,
					"content": "ルラの状態は安定しているけど、このまま待っていても、良くならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720107
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401720107,
					"content": "こっちは少し進展があったから安心して。ルラのご両親によると、この間、彼にある友人ができたそうなの。それからというもの、出かけたら何日も戻ってこないコトがよくあるみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720108
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401720108,
					"content": "ご両親がナイショでその後をつけて行ってみたら、例の友人と何かをしてたのを見たって言ってた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720109
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401720109,
					"content": "その友達を見たの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401720110
					]
				},
				{
					"id": 401720110,
					"content": "そうよ。谷中という男で、服装から察するに稲妻の人みたいだったって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720111
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401720111,
					"content": "谷中さん、これでいいかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720112
					],
					"speakerTitle": "ルラ"
				},
				{
					"id": 401720112,
					"content": "古書で学んだ知識によると、アレルギーには減感作療法というものがある。過敏の逆、鈍感つまり霊感音痴にも使えると思わないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720113
					],
					"speakerTitle": "淵上"
				},
				{
					"id": 401720113,
					"content": "お前はかわいそうなことに霊感が全くない。だがそんなお前でも、スピリットに多く曝されれば、改善するのではないだろうか。これは俺流の減感作療法、いや増感作療法だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720114
					],
					"speakerTitle": "淵上"
				},
				{
					"id": 401720114,
					"content": "…本当に大丈夫なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720115
					],
					"speakerTitle": "ルラ"
				},
				{
					"id": 401720115,
					"content": "霊感音痴のお前のことだ。無理やり巫術を使えばどうなるか、俺よりよく知っているんじゃないか。どうするかは、お前次第だがな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720116
					],
					"speakerTitle": "淵上"
				},
				{
					"id": 401720116,
					"content": "分かった…もう一つ質問があるんだけど、谷中さんはどうしてぼくを助けようとしてくれるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720117
					],
					"speakerTitle": "ルラ"
				},
				{
					"id": 401720117,
					"content": "ぼくみたいなやつは部族での地位も低いし、まともな恩返しもできないのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720118
					],
					"speakerTitle": "ルラ"
				},
				{
					"id": 401720118,
					"content": "恩返し？俺の顔をよ～く見てくれ。なんて書いてある？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720119
					],
					"speakerTitle": "淵上"
				},
				{
					"id": 401720119,
					"content": "えっと…なんて？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720120
					],
					"speakerTitle": "ルラ"
				},
				{
					"id": 401720120,
					"content": "「優しい」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720121
					],
					"speakerTitle": "淵上"
				},
				{
					"id": 401720121,
					"content": "ええっ！そいつがルラの体質を変えようとしてたってことか？なんで稲妻人が？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401720122,
					"content": "ぶっ飛んだ発想だな。本当に効くのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720123
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401720123,
					"content": "ルラの今の様子だと、失敗したんだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401720124,
					"content": "フン、遠い昔、部族で行われてたコトもあるけど、成功率が低いうえ、危なすぎるから、だんだん禁止されるようになった方法ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720125
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401720125,
					"content": "それに谷中の目的は、そう単純なものじゃないハズ。ルラのアクシデントの後、ソイツは姿を消してるんだもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720126
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401720126,
					"content": "ルラのご両親からもらった住所をたよりに二人の溜まり場に行ったけど、そこには明らかにスピリットが残ってた。それと、こんなのも見つけたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720127
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401720127,
					"content": "それは…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720128
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401720128,
					"content": "欠片よ…武器や儀式の道具のね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720129
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401720129,
					"content": "キミも分かるでしょ？かなり古い物だけど、スピリットが多く残ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720130
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401720130,
					"content": "ルラはきっと、これを媒体にしたのよ。あの霊感音痴がどうして霊視できたのか、これで説明がつく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720131
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401720131,
					"content": "待って。この感覚、なんか懐かしい。僕の古名と関係がありそうだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720132
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401720132,
					"content": "オロルンの古名？それって古名の欠片なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720133
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401720133,
					"content": "いや…先代の古名の持ち主が残したものだと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720134
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401720134,
					"content": "サンハジの物なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401720135
					]
				},
				{
					"id": 401720135,
					"content": "気になってムズムズしてきた。さっそくこれを媒体に霊視しましょ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720136
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401720136,
					"content": "じゃ、前と同じように、旅人がスピリットの織り機を使って、シトラリの見たビジョンをウォーベンに記録すればいいんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720137
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401720137,
					"content": "いいえ、今回は旅人じゃなくて、オロルンに任せる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720138
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401720138,
					"content": "どうして？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720139
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401720139,
					"content": "保険よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720140
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401720140,
					"content": "キミはスピリットについて旅人よりもよく知ってる。これがサンハジの遺物なら、もしものコトがあったとしても、キミならうまく対応できるハズ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720141
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401720141,
					"content": "分かった…ほら、言っただろう、パイモン。ばあちゃんは旅人に一目置いていて、危ないことから遠ざけるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720142
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401720142,
					"content": "孫の扱いは雑なのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720143
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401720143,
					"content": "このコったら、何ブツブツ言ってるのかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720144
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401720144,
					"content": "なんでもない。ばあちゃん、もう始められる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720145
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401720145,
					"content": "それじゃ、始めましょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720149
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401720146,
					"content": "そうして、シトラリは謎の欠片を媒体に、二度目の霊視を始めた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401720147
					]
				},
				{
					"id": 401720149,
					"content": "できたんだな！これは…壊れた弓が、燃えてるみたいだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720150
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401720150,
					"content": "見ろ。弓の一部が、欠片と少し似ていないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720151
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401720151,
					"content": "ホントだ！弓の持ち手の部分が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720152
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401720152,
					"content": "ばあちゃんの家のウォーベンで、この弓に似たものを見たことがある…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720153
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401720153,
					"content": "…ええ、これはサンハジが燼寂海の戦いで使った弓よ。この欠片は、本当にサンハジの遺物のようね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720154
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401720154,
					"content": "さすが、サンハジだ。遺物のスピリットは不安定だが、さっきは何ともなかった。旅人なら記録をしても大丈夫だったと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720155
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401720155,
					"content": "さすが英雄って感じだな！残されたものが後世の人にこんなに影響を与えちゃうなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720156
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401720156,
					"content": "あの谷中ってやつの目的はホントに霊感音痴の治療なのかしら？別にナニかある気がするのよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720157
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401720157,
					"content": "それはオイラも気になってたぞ。さっき弓の絵を見たけど…まさか…そいつ、他の欠片を探してるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720158
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401720158,
					"content": "サンハジのものとは言え、もうバラバラだから、全部集めても大して役には立たないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720159
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401720159,
					"content": "それに、どうしてわざわざ霊感音痴を選んだの？やるだけムダなのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720160
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401720160,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720161
					],
					"speakerTitle": "ルラ"
				},
				{
					"id": 401720161,
					"content": "えっ？今ルラが動いたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720162
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401720162,
					"content": "どれどれ…ルラのスピリットがさらに欠片に集まり出してる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720163
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401720163,
					"content": "ってことは、ばあちゃんのやり方は間違っていないということだな。確かにルラのスピリットが引き寄せられている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720164
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401720164,
					"content": "それなら、彼のカラダとこの欠片を媒体にして、もう一度試しましょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720165
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401720165,
					"content": "頼んだ、ばあちゃん。僕も頑張るから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720166
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401720166,
					"content": "#今度は{M#俺}{F#私}がスピリットの織り機を動かすよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401720167
					]
				},
				{
					"id": 401720167,
					"content": "キミもやりたくてウズウズしてきたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720168
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401720168,
					"content": "交代で一回ずつ、そしたら公平だろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720169
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401720169,
					"content": "安全性は確認できてるから、危険はないはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720170
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401720170,
					"content": "うん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720171
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401720171,
					"content": "分かった、旅人がそう言うなら。準備できたら言ってちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シトラリ"
				}
			]
		},
