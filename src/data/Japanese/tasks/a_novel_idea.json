			"dialogs": [
				{
					"id": 221160701,
					"content": "前回城内に行った時、偶然ある男性と占い師の女性の話を聞いてね、あの時は真面目に聞いてなかったが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160702
					],
					"speakerTitle": "常九"
				},
				{
					"id": 221160702,
					"content": "あとであの二人が志華と綺命って分かったんだ。あの二人に何かエピソードはないか、聞いてきてもらえないかい？あったら、わしに教えてほしいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "常九"
				}
			]
		},
		{
			"id": 2211608,
