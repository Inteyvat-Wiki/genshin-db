			"dialogs": [
				{
					"id": 221161101,
					"content": "汐さん、お、おかえりなさい。新しい料理を覚えたから、食べてくださいな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161102
					],
					"speakerTitle": "思思"
				},
				{
					"id": 221161102,
					"content": "思思、ただいま。もう疲れたから、休みたいんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161103
					],
					"speakerTitle": "潮汐"
				},
				{
					"id": 221161103,
					"content": "そ、そうね、大変だったから、休んだ方がいいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161104
					],
					"speakerTitle": "思思"
				},
				{
					"id": 221161104,
					"content": "じゃあ、その、休んだら、話をしましょう？そろそろ日にちを…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161105
					],
					"speakerTitle": "思思"
				},
				{
					"id": 221161105,
					"content": "あ、ああ、覚えてるよ、ただまだ決めてないんだ。責任を取りたくないわけじゃないが、君を不幸せにしたくないんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161106
					],
					"speakerTitle": "潮汐"
				},
				{
					"id": 221161106,
					"content": "はあ、海と共にいるのは船員としての運命、思思、君にはもっといい相手がいるはずだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161107
					],
					"speakerTitle": "潮汐"
				},
				{
					"id": 221161107,
					"content": "汐さん、そんなこと言わないで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "思思"
				}
			]
