			"dialogs": [
				{
					"id": 221160101,
					"content": "序章はどうすれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160102
					],
					"speakerTitle": "常九"
				},
				{
					"id": 221160102,
					"content": "何をしてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221160103
					]
				},
				{
					"id": 221160103,
					"content": "ああ、また君か。新しい小説を書こうとしてるんだが、序章どうも何かが足りなくてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160104
					],
					"speakerTitle": "常九"
				},
				{
					"id": 221160104,
					"content": "たくさん考えたんだが、いい案がなくてね、このままじゃいつになったら書けるんだか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160105
					],
					"speakerTitle": "常九"
				},
				{
					"id": 221160105,
					"content": "そうだ、君はいろいろ見てきたんだろう。成功する小説に必要なものは何だと思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160106
					],
					"speakerTitle": "常九"
				}
			]
		},
