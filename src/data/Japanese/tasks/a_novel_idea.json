					"常九"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221160301,
					"content": "熱い戦闘。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221160302
					]
				},
				{
					"id": 221160302,
					"content": "熱い戦闘…熱い戦闘…ふむ、一理ある、こういうものは読者の目を惹きつける。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160303
					],
					"speakerTitle": "常九"
				},
				{
					"id": 221160303,
					"content": "でも、「熱い戦闘」どころか、この軽策荘には「戦闘」もないよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160304
					],
					"speakerTitle": "常九"
				},
				{
					"id": 221160304,
					"content": "どうやら外で取材しないといけないな。そうだ、その…野外に冒険者がたくさんいると聞いた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160305
					],
					"speakerTitle": "常九"
				},
				{
					"id": 221160305,
					"content": "宝探しのために、いろんなところに行って、よく野外の怪物と戦うんだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160306
					],
					"speakerTitle": "常九"
				},
				{
					"id": 221160306,
					"content": "ちょうど怪物がたくさん出没する場所を知ってるんだ、その場所…雰囲気があるといえばある、わしはそこで待つことにするよ！冒険者たちが来て怪物と戦ってくれるのを待つよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160307
					],
					"speakerTitle": "常九"
				},
				{
					"id": 221160307,
					"content": "それで、へへっ、素材がたくさんもらえる。さて、その場所は少し離れてるから…わしは先に行くけど、君も早く来るんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "常九"
				}
			]
		},
		{
			"id": 2211605,
			"completionStepIds": [
				2211608
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
