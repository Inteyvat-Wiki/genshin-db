					"nextDialogs": [
						221161210
					],
					"speakerTitle": "モン"
				},
				{
					"id": 221161210,
					"content": "大丈夫！大丈夫だよ、ルルが楽しかったらそれでいい、さあ遊ぶよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161211
					],
					"speakerTitle": "飛"
				},
				{
					"id": 221161211,
					"content": "たかがキャプテン、気にしないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161212
					],
					"speakerTitle": "飛"
				},
