				"points": []
			},
			"dialogs": [
				{
					"id": 221161801,
					"content": "どう？何か収穫は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161802
					],
					"speakerTitle": "常九"
				},
				{
					"id": 221161802,
					"content": "記録しておいた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221161803
					]
				},
				{
					"id": 221161803,
					"content": "本当に収穫があるんだ、どれどれ…しかし、所詮子供たちのお遊戯だ。彼らがもっと大きくなったら、本当に「ロマン」があるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161804
					],
					"speakerTitle": "常九"
				},
				{
					"id": 221161804,
					"content": "でも、一応受け取っておこう。これも一つの物語だ、ロマンな展開に使えなくても、参考価値はある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161805
					],
					"speakerTitle": "常九"
				},
				{
					"id": 221161805,
					"content": "そうだ、これは君へのお礼だ、受け取ってくれ。わしは執筆に戻るよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "常九"
				}
			]
		},
