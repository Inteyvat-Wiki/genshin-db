					"nextDialogs": [
						221161207
					],
					"speakerTitle": "ルル"
				},
				{
					"id": 221161207,
					"content": "ルルってば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161208
					],
					"speakerTitle": "モン"
				},
				{
					"id": 221161208,
					"content": "ルルがそう言うなら…まあ、そうしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161209
					],
					"speakerTitle": "飛"
				},
