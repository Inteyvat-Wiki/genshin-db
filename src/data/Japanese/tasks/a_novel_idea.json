			"dialogs": [
				{
					"id": 221161201,
					"content": "ルル、今回こそ飛くんにキャプテンをやってもらおうよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161202
					],
					"speakerTitle": "モン"
				},
				{
					"id": 221161202,
					"content": "そうだよ、何回も言ったのに、いつもいつも接客係ばかり…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161203
					],
					"speakerTitle": "飛"
				},
				{
					"id": 221161203,
					"content": "でもモンちゃんがキャプテンをやってる時が一番楽しかったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161204
					],
					"speakerTitle": "ルル"
				},
				{
					"id": 221161204,
					"content": "ルル、そんなこと言っちゃだめだよ、飛くんだってよくできてたよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161205
					],
					"speakerTitle": "モン"
				},
				{
					"id": 221161205,
					"content": "そうだね、モンちゃんがキャプテン、私が商人、飛くんが接客係。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161206
					],
					"speakerTitle": "ルル"
				},
				{
					"id": 221161206,
					"content": "あの時が一番楽しかった、そうでしょう？飛くん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161207
					],
					"speakerTitle": "ルル"
				},
				{
					"id": 221161207,
					"content": "ルルってば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161208
					],
					"speakerTitle": "モン"
				},
				{
					"id": 221161208,
					"content": "ルルがそう言うなら…まあ、そうしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161209
					],
					"speakerTitle": "飛"
				},
				{
					"id": 221161209,
					"content": "飛くん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161210
					],
					"speakerTitle": "モン"
				},
				{
					"id": 221161210,
					"content": "大丈夫！大丈夫だよ、ルルが楽しかったらそれでいい、さあ遊ぶよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161211
					],
					"speakerTitle": "飛"
				},
				{
					"id": 221161211,
					"content": "たかがキャプテン、気にしないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161212
					],
					"speakerTitle": "飛"
				},
				{
					"id": 221161212,
					"content": "…あなたたち、はあ…",
