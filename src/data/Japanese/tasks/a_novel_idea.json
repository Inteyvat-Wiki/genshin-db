					"nextDialogs": [
						221161203
					],
					"speakerTitle": "飛"
				},
				{
					"id": 221161203,
					"content": "でもモンちゃんがキャプテンをやってる時が一番楽しかったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161204
					],
					"speakerTitle": "ルル"
				},
				{
					"id": 221161204,
					"content": "ルル、そんなこと言っちゃだめだよ、飛くんだってよくできてたよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161205
					],
					"speakerTitle": "モン"
				},
				{
					"id": 221161205,
					"content": "そうだね、モンちゃんがキャプテン、私が商人、飛くんが接客係。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161206
					],
					"speakerTitle": "ルル"
				},
				{
					"id": 221161206,
					"content": "あの時が一番楽しかった、そうでしょう？飛くん。",
