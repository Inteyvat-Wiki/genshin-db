			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"常九"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221160501,
					"content": "へへっ…今回はわしもこの身で「熱い戦闘」を体験してしまったよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160502
					],
					"speakerTitle": "常九"
				},
				{
					"id": 221160502,
					"content": "戦闘は見るだけで十分では？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221160503
					]
				},
				{
					"id": 221160503,
					"content": "そうだよ、そう思ってたけど、冒険者が全然現れないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160504
					],
					"speakerTitle": "常九"
				},
				{
					"id": 221160504,
					"content": "それで怪物たちがここを離れようとしていた。怪物がいなくなったら、わしの待ち時間が無駄になるじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160505
					],
					"speakerTitle": "常九"
				},
				{
					"id": 221160505,
					"content": "だから…小石を投げたんだ。ほら、石で注意力を引くって小説にも書いてあるじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160506
					],
					"speakerTitle": "常九"
				},
				{
					"id": 221160506,
					"content": "ま、まさか石が怪物の頭に命中するなんて…気付いたらああいうことに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160507
					],
					"speakerTitle": "常九"
				},
				{
					"id": 221160507,
					"content": "まあまあ、大変だったけど、取材はできたからよしとしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160508
					],
					"speakerTitle": "常九"
				},
				{
					"id": 221160508,
					"content": "今アイデアがたくさん湧いてきてるぞ！そうだ、これは君にあげるよ、助けてくれたお礼だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160509
					],
					"speakerTitle": "常九"
				},
				{
					"id": 221160509,
					"content": "戻ったらすぐ書けそうな気がするよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "常九"
				}
			]
		},
