			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"淮安"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221130101,
					"content": "参りましたね、まさに泣き面に蜂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130102
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221130102,
					"content": "また階段の補修？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221130103
					]
				},
				{
					"id": 221130103,
					"content": "ちょうどよかったです。前回はありがとうございました…今回もお願いしたいのですが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130104
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221130104,
					"content": "この箇所なのですが、木の板が足りなくて追加注文をして、旅館の者に運んでもらう予定でした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130105
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221130105,
					"content": "しかし途中で魔物に襲われて、木の板を道に落としてしまったらしいんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130106
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221130106,
					"content": "かなりひどい目に遭ったようで、場所を教えてくれたのはいいんですが、どうしても戻りたくないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130107
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221130107,
					"content": "いろいろ考えたんですが、あなたにしか頼めないと思いました。木の板を取り戻してもらえますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130108,
						221130110
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221130108,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221130109
					]
				},
				{
					"id": 221130109,
					"content": "ではお願いします。ここでお待ちしています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "淮安"
				},
				{
					"id": 221130110,
					"content": "結構壊れたね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221130111
					]
				},
				{
					"id": 221130111,
					"content": "そんな目で見ないでください。これは私のせいではありませんから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130112
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221130112,
					"content": "ここの傷は…昔、二人のお客様がいまして、何やらお互いに個人的な恨みがあったらしいです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130113
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221130113,
					"content": "二人ともうちに泊まることになりまして、階段でばったり会ったのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130114
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221130114,
					"content": "その後、二人は階段で戦いを繰り広げて、階段まで壊したんです…あの喧嘩を止めるのはなかなか大変でしたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130115
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221130115,
					"content": "さすがの私も怒りました…賠償として三日分の宿泊費を払ってもらいましたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130116
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221130116,
					"content": "さて、雑談はここまでにして、木の板を取り戻してきてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130117
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221130117,
					"content": "階段で喧嘩するお客様はもう現れないといいんですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "淮安"
				}
			]
		},
		{
			"id": 2211302,
