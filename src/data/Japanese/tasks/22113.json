			"dialogs": [
				{
					"id": 221130301,
					"content": "木の板を持ってきてくれましたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130302
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221130302,
					"content": "手に入れた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221130303
					]
				},
				{
					"id": 221130303,
					"content": "よかった、あの魔物は本当に厄介ですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130304
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221130304,
					"content": "これで十分です、本当にありがとうございます。これで補修を始めますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "淮安"
				}
			]
		},
		{
			"id": 2211305,
			"completionStepIds": [
				2211305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
