			},
			"dialogs": [
				{
					"id": 221130201,
					"content": "木の板を持ってきてくれましたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130202
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221130202,
					"content": "まだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221130203
					]
				},
				{
					"id": 221130203,
					"content": "急いでください。持ってきたらすぐ補修しますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "淮安"
				}
			]
		},
