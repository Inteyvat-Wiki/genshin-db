				"points": []
			},
			"dialogs": [
				{
					"id": 221130501,
					"content": "これで補修は全て終わりました。どうですか？なかなかの腕前でしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130502
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221130502,
					"content": "これでお客様にとっても便利になりますね、ハハッ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130503
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221130503,
					"content": "さあ、報酬を受け取ってください。本当にありがとうございました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130504
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221130504,
					"content": "お時間があれば、またいらしてください。うちのシェフの腕前は結構期待できますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "淮安"
				}
			]
		}
	]
