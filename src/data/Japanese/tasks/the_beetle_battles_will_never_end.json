			"dialogs": [
				{
					"id": 727310201,
					"content": "ハッ、ハハハッ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310202
					],
					"speakerTitle": "「花角玉将」"
				},
				{
					"id": 727310202,
					"content": "満足！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310203
					],
					"speakerTitle": "「花角玉将」"
				},
				{
					"id": 727310203,
					"content": "ハッ、ハハハッ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310204
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727310204,
					"content": "爽快！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310205
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727310205,
					"content": "虫相撲の戦い方は違えど、お前がオニカブトムシに注いだ熱い気持ちに、俺は強く共感した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310206
					],
					"speakerTitle": "「花角玉将」"
				},
				{
					"id": 727310206,
					"content": "いつの日か、お前は虫相撲界の傑物になるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310207
					],
					"speakerTitle": "「花角玉将」"
				},
				{
					"id": 727310207,
					"content": "お前も悪くねぇぜ！千百四十一回の勝負の中、五百七十回も俺様にギリギリ勝つなんてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310208
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727310208,
					"content": "俺様と百回以上戦い続けた相手の中では、お前は一番根性を持ってやがる、見直した！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310209
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727310209,
					"content": "五百七十一回だ。俺のほうが多く勝ってる。場所が不利なことを考えると、俺のほうが上のはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310210
					],
					"speakerTitle": "「花角玉将」"
				},
				{
					"id": 727310210,
					"content": "ほう？なんだ？負け惜しみか？俺様はしっかり覚えてるぜ。守だって証明できる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310211
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727310211,
					"content": "だろう、守？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310212
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727310212,
					"content": "親分…お、俺はもうダメだ…ちょっと寝かせてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310213
					],
					"speakerTitle": "守"
				},
				{
					"id": 727310213,
					"content": "うわぁ、まさか今までずっとここで虫相撲をやってたのか…しかも休まずに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 727310214,
					"content": "うわぁ、まさか今までずっとここで虫相撲をやってたのか…しかも休まずに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310215,
						727310216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 727310215,
					"content": "土俵も壊れそう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310217
					]
				},
				{
					"id": 727310217,
					"content": "よし！俺様が特別に一回勝たせてやってもいいぜ。どうせすぐ取り返せるからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310218
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727310218,
					"content": "もし不服ってんなら、次の勝負はお前の本陣に行ってやる。場所なんざ関係なく、重要なのは虫相撲をするやつの腕だってことを証明してやんぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310219
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727310219,
					"content": "望むところだ、ついてこい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310220
					],
					"speakerTitle": "「花角玉将」"
				},
				{
					"id": 727310220,
					"content": "ん？ダチ公に空飛ぶチビ助、やっと来てくれたか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310221
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727310221,
					"content": "なんでまた空飛ぶチビ助に戻ってんだ？虫相撲を手伝ってない時は、カッコ悪いあだ名しか思い出せないのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310222
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 727310222,
					"content": "それはいったん置いとけ！約束した二ヶ月分のラーメン無料券だ、持ってけ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310223
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727310223,
					"content": "ラーメン無料券？そうだ、ラーメン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310224
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 727310224,
					"content": "へへっ、そうこなくっちゃ。わかってんじゃんかよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310225,
						727310226
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 727310225,
					"content": "バンザイ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310227
					]
				},
				{
					"id": 727310227,
					"content": "いやいや、今回はあくまで「荒瀧極意堂々虫相撲大試合」の予行演習だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310228
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727310228,
					"content": "だって観客もいないし、これじゃ寂しすぎんだろ。こんなのは祭りじゃねぇ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310229
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727310229,
					"content": "幸い、「花角玉将」はその驕りを捨てて、俺様こそが得難い虫相撲の強者だと認めてくれた！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310230
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727310230,
					"content": "だが、俺たちの戦いはまだ終わっちゃいない。これから俺様は単騎で「花角玉将」の本陣に乗り込み、やつが納得するまで叩きのめしてやるつもりだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310231
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727310231,
					"content": "その時はきっと、「花角玉将」も俺様の指揮に従って「荒瀧極意堂々虫相撲大試合」を盛り上げてくれるはずだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310232
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727310232,
					"content": "今回はあんがとな。俺様からの朗報を待っててくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310233
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727310233,
					"content": "へへっ、牛使い野郎も思う存分楽しめたし、オイラたちも二ヶ月分のラーメンをゲットできた、めでたしだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310234,
						727310235
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 727310234,
					"content": "全員大満足！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310236
					]
				},
				{
					"id": 727310236,
					"content": "親分、親分！忍の姉御からの手紙だ。見てくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310237
					],
					"speakerTitle": "晃"
				},
				{
					"id": 727310237,
					"content": "って、あれ？親分はどこ行ったんだ？さっきまでここで虫相撲をやってたのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310238
					],
					"speakerTitle": "晃"
				},
				{
					"id": 727310238,
					"content": "え？なんかあったのか？牛使い野郎ならさっき「花角玉将」と一緒に行っちゃったぞ。技を磨き合うとかなんとか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310239
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 727310239,
					"content": "いや、大したことじゃないんだが、ちょっと予想外のことがあってな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310240
					],
					"speakerTitle": "晃"
				},
				{
					"id": 727310240,
					"content": "詳しくはこの手紙を読んでみてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310241
					],
					"speakerTitle": "晃"
				},
				{
					"id": 727310241,
					"content": "えっ、つまり「花角玉将」って、荒瀧派の協力者なのか？けど「花角玉将」は口の利き方があんなだから、牛使い野郎も敵だと思っちゃったのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310242
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 727310242,
					"content": "忍の予想通り、牛使い野郎は確かに虫相撲に夢中になってるけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310243
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 727310243,
					"content": "結局、オイラたちに「荒瀧極意堂々虫相撲大試合」のことで手を焼かせたから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310244
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 727310244,
					"content": "落ち着いてはいなかった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310245
					]
				},
				{
					"id": 727310245,
					"content": "こうしてみると、ラーメンの無料券は忍にあげるべきだな！忍が戻ってきたら、一緒に食いに行こうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310246
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 727310246,
					"content": "あれ？待った…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310247
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 727310247,
					"content": "そういえば、この無料券がどこのラーメン屋で使えるか、牛使い野郎に教えてもらってないぞ…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310248
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 727310248,
					"content": "まさか、自分で探さなきゃいけないのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 727310235,
					"content": "うん、楽しむことが一番大切…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310236
					]
				},
				{
					"id": 727310226,
					"content": "「虫相撲大試合」もこれで無事終了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310227
					]
				},
				{
					"id": 727310216,
					"content": "オニカブトムシだってくたびれる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310248
					]
				}
			]
		},
