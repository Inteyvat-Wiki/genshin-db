			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10150301,
					"content": "こんなに大きいのか、さすが仙人が残したものだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10150302,
					"content": "でも、どうやって使うんだ？動かすのにどんだけ力がいるんだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10150303,
					"content": "今は動かせない、壊れているからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150304
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150304,
					"content": "え…これ壊れてるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10150305,
					"content": "千年もの時が経っているからな、たとえ仙人の道具でもボロが出てくる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150306
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150306,
					"content": "じゃあ、どうすりゃいいんだ？鍾離、早くいつもの「上流階級の豆知識」でなんとかしろよぉ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10150307,
					"content": "む、俺を何だと…芝居と鳥の鑑賞以外、何もできない金持ちの坊っちゃんじゃないぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150308
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150308,
					"content": "そうだな…「帰終機」が作られた当時、傷などの修復をするため予備用の材料が用意されていたはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150309
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150309,
					"content": "俺の知識が正しければ、この「古城垣」の中に当時の備品室があるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150310
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150310,
					"content": "そこに保管されている材料と「帰終機」の原理を理解できれば、修理も難しくないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150311
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150311,
					"content": "ってことは…鍾離はその原理を知ってるんだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10150312,
					"content": "少しはな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150313
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150313,
					"content": "<color=#00E1FFFF>材料が十分に集まったら</color>、試してみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鍾離"
				}
			]
		},
		{
			"id": 101506,
			"completionStepIds": [
				101515
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101506",
							"2"
						],
						"stepId": 101506,
						"stateName": "QUEST_STATE_UNFINISHED"
