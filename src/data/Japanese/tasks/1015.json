				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10150601,
					"content": "ふむ、これだけ予備用の材料があれば事足りそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150602
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150602,
					"content": "修理してみるから、少し待っててくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150603
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150603,
					"content": "完成だ。「帰終機」の構造は、思ったより精密だったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150604
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150604,
					"content": "おおぉっ、それでどう動かすんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150605
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10150605,
					"content": "簡単だ、こうして…こうだ。ほら「望遠」機能もついているぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150617
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150617,
					"content": "ここは…いない…ここにもいない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150606
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10150606,
					"content": "おい！何してんだッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150607
					],
					"speakerTitle": "黄麻"
				},
				{
					"id": 10150607,
					"content": "これは…この大弓を直したのか？何勝手な真似をしてやがる！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150608
					],
					"speakerTitle": "黄麻"
				},
				{
					"id": 10150608,
					"content": "大弓ではなく「帰終機」だ。それから——質問をする前に、まず名を名乗れ。それが礼儀というものだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150609
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150609,
					"content": "見てわからないか？ハンッ、俺たちは宝盗団だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150610
					],
					"speakerTitle": "黄麻"
				},
				{
					"id": 10150610,
					"content": "この辺りにお宝が隠されてると聞いてやって来たら、この機械の大弓が厄介でな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150611
					],
					"speakerTitle": "黄麻"
				},
				{
					"id": 10150611,
					"content": "この間も山に入ったら、兄弟がこいつに串刺しされそうになる始末だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150612
					],
					"speakerTitle": "黄麻"
				},
				{
					"id": 10150612,
					"content": "俺たちが命懸けでこいつを破壊したってぇのに——ちょっと目を離した隙に直しやがって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150613
					],
					"speakerTitle": "黄麻"
				},
				{
					"id": 10150613,
					"content": "お前ら、許さねぇッ！痛い目に合わせてやる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150614
					],
					"speakerTitle": "黄麻"
				},
				{
					"id": 10150614,
					"content": "フン。私欲のために仙人の知恵を汚すとは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150615
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150615,
					"content": "お前たちには教訓が必要なようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150616
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150616,
					"content": "#その通りだ！{NICKNAME}、やるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 101507,
			"completionStepIds": [
				101507
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101507",
							"2"
						],
						"stepId": 101507,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"七七"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10150701,
					"content": "すまないが、「契約」は完遂できなかった。「ココナッツヒツジ」という半仙の獣に…心当たりがないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150702
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150702,
					"content": "あうっ。がっかり。大丈夫だけど、がっかり。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150703
					],
					"speakerTitle": "七七"
				},
				{
					"id": 10150703,
					"content": "うぅ——こんなションボリする七七を見てたら、なぜだかすごく申し訳ない気持ちに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150704,
						10150705
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10150704,
					"content": "七七ちゃん、他に手がかりは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150706
					]
				},
				{
					"id": 10150706,
					"content": "うん…「ココナッツヒツジ」のミルクは、おいしい。普通のヒツジのミルクより、おいしい。だからきっと、半仙の獣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150707
					],
					"speakerTitle": "七七"
				},
				{
					"id": 10150707,
					"content": "ごめん。七七は、記憶力がよくない。だから、あのミルクの名前を、書いた…探して、みる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150708
					],
					"speakerTitle": "七七"
				},
				{
					"id": 10150708,
					"content": "そうだ、これだ、おいしいミルク…「ココナッツミルク」だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150709
					],
					"speakerTitle": "七七"
				},
				{
					"id": 10150709,
					"content": "えっ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150710
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10150710,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150711
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150711,
					"content": "すまない、二人とも。七七嬢と対等な立場であるために、よく考えもせず軽率な契約を結んでいた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150712
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150712,
					"content": "ああ、大丈夫だ、鍾離。璃月にも「諸行無常」って言葉があるだろ、誰もこんな結末、予想できないって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150713
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10150713,
					"content": "あれっ…七七、何か悪いことでも、した？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150714
					],
					"speakerTitle": "七七"
				},
				{
					"id": 10150714,
					"content": "#{NICKNAME}、ごめん、オイラは子供の夢を壊せない！おまえに任せるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150715,
						10150716
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10150715,
					"content": "ココナッツミルクはヒツジから採れないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150717
					]
				},
				{
					"id": 10150717,
					"content": "はっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150718
					],
					"speakerTitle": "七七"
				},
				{
					"id": 10150718,
					"content": "七七が何やら考え出したぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150719,
						10150720
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10150719,
					"content": "邪魔しないでおこう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150721
					]
				},
				{
					"id": 10150721,
					"content": "ハハッ、有意義な人生の授業でしたね、七七がお世話になりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150722
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 10150722,
					"content": "お前は…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150723
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150723,
					"content": "失礼しました。私はこの「不卜廬」の店主、白朮です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150724
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 10150724,
					"content": "店主は七七じゃなかったのか——この首に蛇を巻いた変わり者が店主！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150725
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10150725,
					"content": "可哀想に。七七でさえ十分単純なのに、それを上回る単純なヤツがいるとは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150726
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 10150726,
					"content": "えっ！…へ、蛇が、しゃ、しゃ、喋った！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150727,
						10150728
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10150727,
					"content": "蛇が喋った！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150729
					]
				},
				{
					"id": 10150729,
					"content": "フン、喋るつもりはなかった。常連さんならまだしも、一見さんはビックリするからね。でもこれ以上黙ってると、私は引き出しの中にいる蛇の干物たちと一緒だと思われてしまう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150730
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 10150730,
					"content": "ハハハッ…こちらは「長生」、悪意はありませんからご安心を。さて、七七のおふざけに付き合ってくれたことはさておき…皆さんがここに来たのは何のご用ですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150731
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 10150731,
					"content": "こちらに「永生香」は置いてるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150732
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150732,
					"content": "ああ、「永生香」ですか、もちろんありますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150733
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 10150733,
					"content": "ふう…よかった、少なくとも無駄足にはならなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150734
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10150734,
					"content": "300万モラで、上質なものをご用意します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150735,
						10150737
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 10150735,
					"content": "300万！？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150736
					]
				},
				{
					"id": 10150736,
					"content": "「黄金屋」を強盗した方が早いぞ！まあ…今は七星が「黄金屋」を使ってるから難しいと思うけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150739
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10150739,
					"content": "ふむ…300万…特に気にしたことないが、一般的に見れば、確かに少し無理があるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150740
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150740,
					"content": "そんな大金！オイラたちが払えるわけない！——鍾離ならもっと払えないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150741
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10150741,
					"content": "確かに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150742
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150742,
					"content": "潔く認めた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150743
					]
				},
				{
					"id": 10150743,
					"content": "どうすればいいんだ…はあ、また公子に助けを求めるしかないのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150744
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10150744,
					"content": "あっははははっ——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150745
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10150745,
					"content": "ココ…ココナッツヒツジ！面白すぎる、君たち、そんなものに振り回されてたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150746
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10150746,
					"content": "人の不幸を喜ぶな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150747
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10150747,
					"content": "はあ、涙が出るくらい笑わせてもらったよ。さて、君たちのおかげで笑えたし、この問題は俺が解決してあげよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150748
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10150748,
					"content": "えっと…白朮さん、かな？俺は「ファデュイ」の執行官、「公子」だ。今後のために、こちらと協力関係を結んでおくのも悪くない話だと思うのだけど、どうかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150749
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10150749,
					"content": "「不卜廬」に必要であれば、ファデュイがココナッツミルクの仕入先をリサーチしておこう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150750
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10150750,
					"content": "おん？ファデュイはそういうのが得意だと聞いたが、この「不卜廬」がただのココナッツミルクで買収できると思ってるのか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150751
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 10150751,
					"content": "ココナッツミルク、ココナッツミルク。白先生、ココナッツミルク。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150752
					],
					"speakerTitle": "七七"
				},
				{
					"id": 10150752,
					"content": "わかりました、わかりました…では、「公子」殿、よろしくお願いしますね。この「永生香」も特別価格で299万モラにしましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150753
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 10150753,
					"content": "300万と299万じゃ、そんなに違わないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150754
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10150754,
					"content": "ふむ…299万…特に気にしたことないが、普通に考えて、確かに300万より1万安くなった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150755
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150755,
					"content": "さて、問題が解決したなら、そろそろ玉京台に戻らなければいけない。「公子」殿、店主殿、七七嬢、ではまた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150756
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150756,
					"content": "面白いヤツらだ、こんなに笑ったのは久しぶりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150757
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10150757,
					"content": "それで、俺が来る前から…ここに潜伏していた君は、何か「聞けた」かな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150758
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10150758,
					"content": "はい、「公子」様。彼らは、七星が「黄金屋」に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150759
					],
					"speakerTitle": "エカテリーナ"
				},
				{
					"id": 10150759,
					"content": "なるほど、なるほど。フフッ、凝光、それと七星ね。ヤツらが黄金屋に隠したいものなんて…「仙祖の亡骸」以外、何があるというんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150760
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10150760,
					"content": "#すまない、{NICKNAME}。でも忠告はしただろ？璃月には「壁に耳あり」ということわざがあるとね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10150737,
					"content": "「黄金屋」へ強盗に入るしかない！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150738
					]
				},
				{
					"id": 10150738,
					"content": "でも、今は七星が「黄金屋」を使ってるから、強盗は難しいと思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150739
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10150728,
					"content": "ここは璃月、なんでもありうる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150729
					]
				},
				{
					"id": 10150720,
					"content": "こういう時、子供は成長する。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150721
					]
				},
				{
					"id": 10150716,
					"content": "#ココナッツミルクはココナッツから{M#採るんだよ}{F#採るのよ}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150717
					]
				},
				{
					"id": 10150705,
					"content": "「ココナッツヒツジ」を使って、何をする？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150706
					]
				}
			]
		},
		{
			"id": 101509,
			"completionStepIds": [
				101509
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101509",
							"2"
						],
						"stepId": 101509,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"七七"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10150901,
					"content": "こんなところにいたのか！カウンターより身長が低かったんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150902,
						10150904
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10150902,
					"content": "…「キョンシー」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150903
					]
				},
				{
					"id": 10150903,
					"content": "あっ…本当だ！おでこに札があるぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150908
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10150908,
					"content": "「不卜廬」へようこそ、七七だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150909
					],
					"speakerTitle": "七七"
				},
				{
					"id": 10150909,
					"content": "七七は、一度死んだ。仙人に助けられた。だから、キョンシー。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150910,
						10150911
					],
					"speakerTitle": "七七"
				},
				{
					"id": 10150910,
					"content": "さらっとすごいこと言った…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150912
					]
				},
				{
					"id": 10150912,
					"content": "モンドだと、こんなのあり得ないよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150913
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10150913,
					"content": "それで…お嬢さん。ここに「永生香」はあるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150914
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150914,
					"content": "処方箋は…処方箋は持ってきた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150915
					],
					"speakerTitle": "七七"
				},
				{
					"id": 10150915,
					"content": "…「永生香」なら、処方箋はいらないと思うが？病とは関係ないからな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150916
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150916,
					"content": "処方箋があれば、薬用意できる。これは、七七が自分に下した「勅令」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150917,
						10150918
					],
					"speakerTitle": "七七"
				},
				{
					"id": 10150917,
					"content": "「勅令」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150920
					]
				},
				{
					"id": 10150920,
					"content": "キョンシーを動かすには勅令が必要だ。しかし、なぜかこのお嬢さんは自分で自分に勅令を下しているみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150921
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150921,
					"content": "処方箋はないが、「永生香」を用意してほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150922
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150922,
					"content": "いいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150923
					],
					"speakerTitle": "七七"
				},
				{
					"id": 10150923,
					"content": "あれ？急に協力的になったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150924
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10150924,
					"content": "でも、七七を手伝ってほしい、そのほうが公平。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150925
					],
					"speakerTitle": "七七"
				},
				{
					"id": 10150925,
					"content": "店員が客を手伝うのは、不公平なことだったのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150926
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10150926,
					"content": "ハハッ…構わん、こういう対等な関係も悪くない。璃月において、取り引きの真髄とは相手の立場に立って考えることだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150927
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150927,
					"content": "じゃあ、天衡山に行って。「帰終機」を使って、「ココナッツヒツジ」を狩ってほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150928,
						10150930
					],
					"speakerTitle": "七七"
				},
				{
					"id": 10150928,
					"content": "よく分からない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150929
					]
				},
				{
					"id": 10150929,
					"content": "帰終機…彼女が言ったものに、俺は聞き覚えがある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150932
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150932,
					"content": "「帰終機」は昔、仙人が天衡山の上に建てた弩砲で、機関術の産物の一つだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150933
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150933,
					"content": "場所は「天衡古城垣」の間にある。自動的に巨大な魔物を迎撃するため、外からの脅威を防げるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150934
					],
