			"trigger": {
				"objectNames": [
					"アフラトゥ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730840101,
					"content": "君たちは、このアフラトゥの依頼を受けて来たエルマイト旅団か？そうでなければ、ここはお引き取りを。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840102
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730840102,
					"content": "この先のエリアはとても危険でね。レグザー庁に依頼を出して、エルマイト旅団に処理を頼んだんだ。一般人は気を付けたほうがいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840103
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730840103,
					"content": "君たちにもしものことがあったら、それは教令官であるこの僕の職務怠慢になる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840104,
						730840106
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730840104,
					"content": "一般人じゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730840105
					]
				},
				{
					"id": 730840105,
					"content": "ふむ…初めて砂漠に来た冒険者たちはみんなそう言うけど、過度な自信はここでは命取りになるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840108
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730840108,
					"content": "あそこの巨大な機械は見えるか？あれはダーリ人の遺物だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840109
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730840109,
					"content": "ダーリ人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730840110
					]
				},
				{
					"id": 730840110,
					"content": "ああ、一般的な呼び方はカーンルイアだったな？ダーリは僕たち因論派が好んで使っている古い呼び方でね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840111
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730840111,
					"content": "伝説によると、五百年前、ダーリ{RUBY#[D]カーンルイア}古国の「白鵠騎士」はこれらの巨大機械に乗って、黒淵から湧き出た魔物の群れと対抗していたそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840112
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730840112,
					"content": "その残酷な戦争が終わった後、最後に残された三台の遺跡巨像は賢者たちに封印された。これがその遺跡巨像のうちの一つだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840113
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730840113,
					"content": "理論上、この機械はここで沈黙して数百年になる。だが最近、なぜか急に動き出して、近くにいる人間を攻撃し始めた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840114
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730840114,
					"content": "レーザー砲で無差別に付近の生き物を攻撃するなんて、このような危険な機能、封印された遺跡巨像では初めて見た。放っておくわけにはいかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840115
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730840115,
					"content": "これらの機械にエネルギーを供給する混沌の炉心は、すでに無害化の処理を施したはずなんだが。数百年経ってもまだ動けるなんて、おかしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840116
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730840116,
					"content": "混沌の炉心？遺跡守衛のと同じじゃないのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730840117,
					"content": "おお、遺跡守衛のことは知っているのか。それなら話が早い。簡単に言えば、遺跡巨像は巨大化した遺跡守衛みたいなものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840118
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730840118,
					"content": "でも遺跡守衛と違って、遺跡巨像は自律システムを搭載しているが、主に人間が操縦するものでね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840119
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730840119,
					"content": "これが一番おかしいところなんだ。遺跡巨像に繋がる道は、賢者が「須陀流心」を使って封印している。誰もあれを起動することはできないはずなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840120
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730840120,
					"content": "誰かが何らかの方法を使って侵入したのか？それとも僕たちの知らない自動起動システムか何かが起動したのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840121
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730840121,
					"content": "入ってみないと分からないと思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730840122
					]
				},
				{
					"id": 730840122,
					"content": "それはそうだけど、レグザー庁は忙しすぎるのか、エルマイト旅団がなかなか来てくれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840123
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730840123,
					"content": "教令院の封印ならまだしも、遺跡巨像に繋がる道の入口は石に阻まれているんだ。僕だけではそれを動かせない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840124
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730840124,
					"content": "おっ、それなら手伝ってやってもいいぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730840125,
					"content": "#エルマイト旅団の分の報酬をオイラたちにくれればな。そうだろ、{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730840126,
					"content": "君たちは冒険者なのか？もし一般市民なら、君たちを危険に晒すわけにはいかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840127
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730840127,
					"content": "やつのレーザー砲はシャレにならないからな。君たちにもしものことがあったら、僕は教令院に何と報告したらいいのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840128,
						730840130
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730840128,
					"content": "冒険者協会に登録済みの冒険者だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730840129
					]
				},
				{
					"id": 730840129,
					"content": "それなら、理論上は問題なさそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840132
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730840132,
					"content": "何しろ、僕には重要な研究の仕事があるからね。ここで時間を無駄にはできない。一刻も早く解決できるよう、君たちに任せたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840133
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730840133,
					"content": "依頼は遺跡巨像の中に入って、その自律システムを閉じることだ。もし遺跡巨像の異変の原因を突き止められるなら尚のこといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840134
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730840134,
					"content": "自律システムのスイッチは操縦室にあるはずだ。オフにできれば手動モードに切り替えられる。でも、操縦室も封印されていたら、入るには封印を解かなければならないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840135
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730840135,
					"content": "えっと…記載によると、封印を維持する力は巨像内の三組の「須陀流心」にあるらしい。それらを破壊できれば封印も解けるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840136
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730840136,
					"content": "でも、機械の内部構造は壊さないように注意してほしい。あれは教令院が登録している重要な文物だからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840137
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730840137,
					"content": "へへ、心配すんな、任せとけ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730840130,
					"content": "諸国に名を轟かせた冒険者だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730840131
					]
				},
				{
					"id": 730840131,
					"content": "そうなのか？あとで冒険者協会に確認させてもらうが、今は一応信じよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840132
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730840106,
					"content": "この先で何があったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730840107
					]
				},
				{
					"id": 730840107,
					"content": "ちょっとな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840108
					],
					"speakerTitle": "アフラトゥ"
				}
			]
		},
		{
			"id": 7308402,
			"completionStepIds": [
				7308402,
				7308418
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_A_AND_ETCOR",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"73026",
							"1"
						]
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7308402",
							"2"
						],
						"stepId": 7308402,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7308418",
							"2"
						],
						"stepId": 7308418,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"アフラトゥ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730840201,
					"content": "君たちは、このアフラトゥの依頼を受けて来たエルマイト旅団か？そうでなければ、ここはお引き取りを。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840202
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730840202,
					"content": "この先のエリアはとても危険でね。レグザー庁に依頼を出して、エルマイト旅団に処理を頼んだんだ。一般人は気を付けたほうがいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840203
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730840203,
					"content": "君たちにもしものことがあったら、それは教令官であるこの僕の職務怠慢になる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840204,
						730840206
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730840204,
					"content": "一般人じゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730840205
					]
				},
				{
					"id": 730840205,
					"content": "ふむ…初めて砂漠に来た冒険者たちはみんなそう言うけど、過度な自信はここでは命取りになるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840208
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730840208,
					"content": "あそこの巨大な機械は見えるか？あれはダーリ人の遺物だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840209
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730840209,
					"content": "ダーリ人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730840210
					]
				},
				{
					"id": 730840210,
					"content": "ああ、一般的な呼び方はカーンルイアだったな？ダーリは僕たち因論派が好んで使っている古い呼び方でね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840211
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730840211,
					"content": "伝説によると、五百年前、ダーリ{RUBY#[D]カーンルイア}古国の「白鵠騎士」はこれらの巨大機械に乗って、黒淵から湧き出た魔物の群れと対抗していたそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840212
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730840212,
					"content": "その残酷な戦争が終わった後、最後に残された三台の遺跡巨像は賢者たちに封印された。これがその遺跡巨像のうちの一つだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840213
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730840213,
					"content": "理論上、この機械はここで沈黙して数百年になる。だが最近、なぜか急に動き出して、近くにいる人間を攻撃し始めた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840214
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730840214,
					"content": "レーザー砲で無差別に付近の生き物を攻撃するなんて、このような危険な機能、封印された遺跡巨像では初めて見た。放っておくわけにはいかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840215
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730840215,
					"content": "これらの機械にエネルギーを供給する混沌の炉心は、すでに無害化の処理を施したはずなんだが。数百年経ってもまだ動けるなんて、おかしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840216
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730840216,
					"content": "なにひとつ分からなかったけど、この遺跡巨像って、前にデーヴァーンタカ山で見たのと同じだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840217
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730840217,
					"content": "でも、この前のデカブツはむやみに人を攻撃しなかったけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730840218,
					"content": "おお、遺跡巨像を知っているのか？それなら、話が早い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840219
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730840219,
					"content": "君たちも知ってると思うが、遺跡巨像は自律システムを搭載している。だが、主に人間が操縦するものでね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840220
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730840220,
					"content": "これが一番おかしいところなんだ。遺跡巨像に繋がる道は、賢者が「須陀流心」を使って封印している。誰もあれを起動することはできないはずなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840221
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730840221,
					"content": "誰かが何らかの方法を使って侵入したのか？それとも僕たちの知らない自動起動システムか何かが起動したのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840222,
						730840227
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730840222,
					"content": "ジャザリーがここにいたら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730840223
					]
				},
				{
					"id": 730840223,
					"content": "そういえば、ジャザリーはこの遺跡巨像を研究する専門家だよな？あいつがいたら、絶対入りたがってただろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840224
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730840224,
					"content": "あれ？君たちはジャザリーを知っているのか？彼なら確かにこういった研究をしていた。僕も彼に調査を頼みたかったけど、最近は閉じこもって何かを書いているようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840225
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730840225,
					"content": "妙論派の者特有の無邪気さと言うべきか？彼が教令院の事務にもっと関心を持っていれば、未だにダステアに残ってることはなかっただろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840226
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730840226,
					"content": "調査はオイラたちに任せろ。この前のジャザリーの調査も、オイラたちが手伝ってやったんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840231
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730840231,
					"content": "#エルマイト旅団の分の報酬をオイラたちにくれればな。そうだろ、{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840232
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730840232,
					"content": "本当に？そのような経験があるなら、ちょうどよかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840233
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730840233,
					"content": "しかし、君たちは冒険者なのか？もし一般市民なら、君たちを危険に晒すわけにはいかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840234
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730840234,
					"content": "以前も似たような機械を調査したとは言え、今回のはわけが違うぞ。こいつのレーザー砲はシャレにならないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840235
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730840235,
					"content": "君たちにもしものことがあったら、僕は教令院に何と報告したらいいのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840236,
						730840238
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730840236,
					"content": "冒険者協会に登録済みの冒険者だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730840237
					]
				},
				{
					"id": 730840237,
					"content": "それなら、理論上は問題なさそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840240
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730840240,
					"content": "何しろ、僕には重要な研究の仕事があるからね。ここで時間を無駄にはできない。一刻も早く解決できるよう、君たちに任せたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840241
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730840241,
					"content": "依頼は遺跡巨像の中に入って、その自律システムを閉じることだ。もし遺跡巨像の異変の原因を突き止められるなら尚のこといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840242
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730840242,
					"content": "自律システムのスイッチは操縦室にあるはずだ。オフにできれば手動モードに切り替えられる。でも、操縦室も封印されていたら、入るには封印を解かなければならないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840243
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730840243,
					"content": "えっと…記載によると、封印を維持する力は巨像内の三組の「須陀流心」にあるらしい。それらを破壊できれば封印も解けるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840244
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730840244,
					"content": "でも、機械の内部構造は壊さないように注意してほしい。あれは教令院が登録している重要な文物だからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840245
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730840245,
					"content": "へへ、心配すんな、任せとけ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730840238,
					"content": "諸国に名を轟かせた冒険者だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730840239
					]
				},
				{
					"id": 730840239,
					"content": "そうなのか？あとで冒険者協会に確認させてもらうが、今は一応信じよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840240
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730840227,
					"content": "入ってみないと分からないと思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730840228
					]
				},
				{
					"id": 730840228,
					"content": "それはそうだけど、レグザー庁は忙しすぎるのか、エルマイト旅団がなかなか来てくれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840229
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730840229,
					"content": "教令院の封印ならまだしも、遺跡巨像に繋がる道の入口は石に阻まれているんだ。僕だけではそれを動かせない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840230
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730840230,
					"content": "おっ、それなら手伝ってやってもいいぜ。この前、一回入ってきたからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840231
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730840206,
					"content": "この先で何があったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730840207
					]
				},
				{
					"id": 730840207,
					"content": "ちょっとな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840208
					],
					"speakerTitle": "アフラトゥ"
				}
			]
		},
		{
			"id": 7308403,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アフラトゥ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730840301,
					"content": "教令官としてここを任せられているけど、実は実地調査の途中、ちょうど近くにいたから臨時派遣されてきたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840302
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730840302,
					"content": "それに、僕はヴァフ{RUBY#[S]因論派}マナ学院出身で、遺跡巨像に関する知識は歴史の本で少し閲覧しただけの程度でね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840303
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730840303,
					"content": "でもこれを機に、ダーリ{RUBY#[D]カーンルイア}古国の歴史をもっと深く知ることが出来たら、これからの研究にも役立つだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アフラトゥ"
				}
			]
		},
		{
			"id": 7308417,
			"completionStepIds": [
				7308417
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7308417",
							"2"
						],
						"stepId": 7308417,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アフラトゥ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730841701,
					"content": "どうだった？遺跡巨像が動いたように見えたが、君たちが中に入って自律システムをオフにしたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841702,
						730841704
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730841702,
					"content": "簡単に解決できた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730841703
					]
				},
				{
					"id": 730841703,
					"content": "それはよかった。これで依頼も無事終了したな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841706
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730841706,
					"content": "でも、あいつはどうして急に起動したんだ？遺跡巨像の中で何か手がかりは見つかったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841707
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730841707,
					"content": "アフラトゥに遺跡巨像の内部で発見したものを報告した。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730841708
					]
				},
				{
					"id": 730841708,
					"content": "ふむ…ツル草が生い茂っていた…とても砂漠で見られるような生態じゃない。僕にもよく分からないけど。なんだか地脈と関係がありそうだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841709
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730841709,
					"content": "前にもこういう報告があった。炉心を破壊された遺跡機械が、地脈のせいで繰り返し「復活」しているとね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841710
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730841710,
					"content": "ダーリ人が製造した機械と地脈エネルギーとの間に、まだ知られていない関連性があるんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841711
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730841711,
					"content": "それに、古代の賢者たちの封印はもともと地脈の力を利用して構成されたもの、もし地脈に何らかの異変が起きたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841712
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730841712,
					"content": "僕の推測が正しければ、各地に封印されている遺跡巨像が一斉に問題を起こすだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841713
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730841713,
					"content": "ちょっとまずいことになりそう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730841714
					]
				},
				{
					"id": 730841714,
					"content": "まずは教令院に報告するよ。これは僕の手に負えない状況だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841715
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730841715,
					"content": "今回は元々、ダーリ人の遺跡の実地調査をするために来たんだ。ようやく教令院から許可が下りて、地元の教団に迎えてもらうよう頼んでたんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841716
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730841716,
					"content": "シティから出たばかりでこんな厄介事に遭ってしまうとは。でも、教令院からの任務を断るにもいかない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841717
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730841717,
					"content": "だが今、この件もようやく解決した。僕も遊学の旅を続けられる。残りの作業は教令院の他の人に任せよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841718
					],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730841718,
					"content": "それでは報酬を受け取ってくれ。縁があれば、またどこかで会えるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アフラトゥ"
				},
				{
					"id": 730841704,
					"content": "オフにした。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730841705
					]
				},
				{
					"id": 730841705,
					"content": "よし、これであいつはもう付近の人を攻撃しなくなるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841706
					],
					"speakerTitle": "アフラトゥ"
				}
			]
		}
	]
}