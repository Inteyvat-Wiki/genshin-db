						"pointId": 14269
					}
				]
			},
			"dialogs": [
				{
					"id": 761170401,
					"content": "…はぁ…はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170402
					],
					"speakerTitle": "イハンティ"
				},
				{
					"id": 761170402,
					"content": "誰だ？金ならない…もう何もないんだ。俺の命が欲しいのなら、持っていけよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170403
					],
					"speakerTitle": "イハンティ"
				},
				{
					"id": 761170403,
					"content": "イハンティ、依頼のものを取り戻してきたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170404
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761170404,
					"content": "…ヤフォダ？お前なのか。声は聞こえるが、俺はもうはっきりとは見えないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170405
					],
					"speakerTitle": "イハンティ"
				},
				{
					"id": 761170405,
					"content": "あたいだよ、目の前にいる。こんなに重病なのに、なんであたいのところに来なかったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170406
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761170406,
					"content": "落ちぶれた野良犬は死にかかっていようと、きらびやかな街に足を踏み入れたりしないだろ…金持ちから過去に何度も鞭で打たれてきたんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170407
					],
					"speakerTitle": "イハンティ"
				},
				{
					"id": 761170407,
					"content": "あたいはそんなやつじゃない。ネフェ…ボスだってそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170408
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761170408,
					"content": "だったら余計に行けない。お前らが親切だとみんなが知ったら、お前らは毎日その相手をしないといけなくなる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170409
					],
					"speakerTitle": "イハンティ"
				},
				{
					"id": 761170409,
					"content": "ボスの前でそんな空気の読めない行動を取るやつはいないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170410
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761170410,
					"content": "だが、お前はいつもこっそり親切をして、後でそいつのせいで痛い目を見てきただろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170411
					],
					"speakerTitle": "イハンティ"
				},
				{
					"id": 761170411,
					"content": "あたいはボスから多くを学んだんだ。あたいを傷つけられるやつなんていないし、そんなことは今後も起こらない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170412
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761170412,
					"content": "人助けをやめるつもりはないんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170413
					],
					"speakerTitle": "イハンティ"
				},
				{
					"id": 761170413,
					"content": "これは、あたい自身の問題だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170414
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761170414,
					"content": "フッ、親分がお前を大切にする理由はそれかもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170415
					],
					"speakerTitle": "イハンティ"
				},
				{
					"id": 761170415,
					"content": "あたいが今まで生きてこられたのも、きっとそのおかげだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170416
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761170416,
					"content": "ハハ…ッ、ゴホッゴホッ！そのとおりだ、ヤフォダ。そのとおりだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170417
					],
					"speakerTitle": "イハンティ"
				},
				{
					"id": 761170417,
					"content": "…よし、イハンティ。あたいに手伝えることがあったら、今すぐ言ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170418
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761170418,
					"content": "相変わらずだな。俺が金をたかるんじゃないか、罠を仕掛けてるんじゃないかって警戒しないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170419
					],
					"speakerTitle": "イハンティ"
				},
				{
					"id": 761170419,
					"content": "あんたはそんなことしない。もう知り合って長いだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170420
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761170420,
					"content": "それだけの理由で？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170421
					],
					"speakerTitle": "イハンティ"
				},
				{
					"id": 761170421,
					"content": "だいたい、あんたはそんなザマなのに、どうやってあたいを陥れるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170422
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761170422,
					"content": "フッ！少しは成長したみたいだな。骨までボロボロになった毒蛇なら、まあ助けても噛まれる心配はないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170423
					],
					"speakerTitle": "イハンティ"
				},
				{
					"id": 761170423,
					"content": "なら頼みがある。その袋の中にある絵を丸めて、俺のポケットに入れてくれ。もうそいつを持ち上げる力も残っていないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170424
					],
					"speakerTitle": "イハンティ"
				},
				{
					"id": 761170424,
					"content": "俺と妻と娘で、一緒に描いた絵でな。俺が今、この世で唯一大切にしているものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170425
					],
					"speakerTitle": "イハンティ"
				},
				{
					"id": 761170425,
					"content": "他のものは、俺にとってもう何の価値もない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170426
					],
					"speakerTitle": "イハンティ"
				},
				{
					"id": 761170426,
					"content": "もし以前のあんたがそのセリフを聞いたら、おかしくて笑い転げるだろうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170427
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761170427,
					"content": "残念だが…かつて俺が何よりも大切にしていたものは、結局妻子を救うことも、俺の人生を救うこともできなかったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170428
					],
					"speakerTitle": "イハンティ"
				},
				{
					"id": 761170428,
					"content": "これが盗賊の宿命なのかもな。俺たちが略奪したものは結局また奪い返され、最終的には何も残らないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170429
					],
					"speakerTitle": "イハンティ"
				},
				{
					"id": 761170429,
					"content": "俺が依頼を出すために担保として差し出したペンダントも、俺の最後の財産…はは…いや、あれも「俺の」とは言えないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170430
					],
					"speakerTitle": "イハンティ"
				},
				{
					"id": 761170430,
					"content": "これ、あんたが一番最初に盗み出したアクセサリーだろ。何度もあたいに話してたじゃないか。どんな方法を使ったか、盗まれたと知った金持ちがどんな顔をしてたか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170431
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761170431,
					"content": "ああ。もうそれはお前のものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170432
					],
					"speakerTitle": "イハンティ"
				},
				{
					"id": 761170432,
					"content": "このアクセサリーの持ち主は誰なんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170433
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761170433,
					"content": "ホロモフっていうスネージナヤ人だ。ナド・クライに住んでたが、今はスネージナヤに戻ってるはずだ。お前、まさか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170434
					],
					"speakerTitle": "イハンティ"
				},
				{
					"id": 761170434,
					"content": "あたいはもう盗賊じゃないし、盗んだものを私物化したりしない。このアクセサリーの持ち主がいるんなら、そいつに返すべきだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170435
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761170435,
					"content": "ふ…はははは…！お前ってやつは…本当にバカだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170436
					],
					"speakerTitle": "イハンティ"
				},
				{
					"id": 761170436,
					"content": "親分の言ってたとおりだ。お前のようなやつが盗賊をやっても、一生…ゴホッ…金持ちになれない…ゴホゴホッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170437
					],
					"speakerTitle": "イハンティ"
				},
				{
					"id": 761170437,
					"content": "ううっ…ゴホゴホッ…ゲホッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170438
					],
					"speakerTitle": "イハンティ"
				},
				{
					"id": 761170438,
					"content": "分かったから、もう喋るな。戻って医者を呼んでくるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170439
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761170439,
					"content": "大丈夫だ。俺は自分の行くべき場所へ行く。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170440
					],
					"speakerTitle": "イハンティ"
				},
				{
					"id": 761170440,
					"content": "イハンティ…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170441
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761170441,
					"content": "ヤフォダ、親分が決めた「掟」を知っているよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170442
					],
					"speakerTitle": "イハンティ"
				},
				{
					"id": 761170442,
					"content": "…「安息を願う者はそれを手にすべき。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170443
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761170443,
					"content": "そいつを実行してくれ。俺の言っていること、分かるよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170444
					],
					"speakerTitle": "イハンティ"
				},
				{
					"id": 761170444,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170445
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761170445,
					"content": "分かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170446
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761170446,
					"content": "俺を手伝ってくれるのがお前で嬉しいぞ、ヤフォダ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170447
					],
					"speakerTitle": "イハンティ"
				},
				{
					"id": 761170447,
					"content": "だが、俺にはお前に残してやれる宝物なんて何もない。もしいるなら、このぬいぐるみでも持っていけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170448
					],
					"speakerTitle": "イハンティ"
				},
				{
					"id": 761170448,
					"content": "これは…でも、このぬいぐるみって…あんたに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170449
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761170449,
					"content": "ああ、勘違いするなよ。これは自分で作ったものだ。お前が今までに作ったぬいぐるみは、言われたとおり全部燃やしたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170450
					],
					"speakerTitle": "イハンティ"
				},
				{
					"id": 761170450,
					"content": "どうだ。まだ目が見えてた頃に作ったんだが、なかなか器用なもんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170451
					],
					"speakerTitle": "イハンティ"
				},
				{
					"id": 761170451,
					"content": "持っていけ、ヤフォダ。俺からの最後のプレゼントだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170452
					],
					"speakerTitle": "イハンティ"
				},
				{
					"id": 761170452,
					"content": "また、会いにくるからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170453
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761170453,
					"content": "行け。じゃあな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170454
					],
					"speakerTitle": "イハンティ"
				},
				{
					"id": 761170454,
					"content": "ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イハンティ"
				}
			]
		},
