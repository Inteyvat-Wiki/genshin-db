			"dialogs": [
				{
					"id": 761170201,
					"content": "…チッ、しけてんな。なんにも持ってねぇとはよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170202
					],
					"speakerTitle": "カレヴァ"
				},
				{
					"id": 761170202,
					"content": "おい、カレヴァ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170203
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761170203,
					"content": "誰だ…って、ヤフォダか。珍しいじゃねぇか、なんか用か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170204
					],
					"speakerTitle": "カレヴァ"
				},
				{
					"id": 761170204,
					"content": "別に。あんた、数日前にイハンティってやつのところで、盗みを働いたろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170205
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761170205,
					"content": "この金をやるから、盗った物を渡してくれ。今日のあたいは優しいから、あんたから買ったってことにしといてやるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170206
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761170206,
					"content": "さすが、ネフェルがバックにいるだけあって、実に「文明的」だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170207
					],
					"speakerTitle": "カレヴァ"
				},
				{
					"id": 761170207,
					"content": "もし嫌だと言ったら、どうする気だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170208
					],
					"speakerTitle": "カレヴァ"
				},
				{
					"id": 761170208,
					"content": "ふう…カレヴァ、頼むよ。あんたも、バカな兄弟たちも、一度くらいまともになれって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170209
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761170209,
					"content": "ヤフォダ。わざわざ遠くから盗賊のところに足を運んで、「物を買う」だと…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170210
					],
					"speakerTitle": "カレヴァ"
				},
				{
					"id": 761170210,
					"content": "苦労して手に入れたモノを、お前に差し出せってのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170211
					],
					"speakerTitle": "カレヴァ"
				},
				{
					"id": 761170211,
					"content": "なんか交渉決裂って感じがするぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761170212,
					"content": "ふう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170213
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761170213,
					"content": "あたいが間違ってたよ。ネフェル姐さんのやり方を真似て、交渉なんてするべきじゃなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170214
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761170214,
					"content": "あんたらみたいなアホに理解できる交渉手段は、やっぱり拳だよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170215
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761170215,
					"content": "旅人、一緒にこいつらを倒すぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170216
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761170216,
					"content": "ケッ、見くびりやがって。兄弟たち、かかれ！積年の恨みを今日こそ晴らしてやれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カレヴァ"
				}
			]
		},
