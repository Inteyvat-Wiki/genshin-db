			"dialogs": [
				{
					"id": 750330101,
					"content": "なんで頑張らなきゃいけないんだ？諦めちゃいけないのか？もううんざりだ！姉さん、助けてよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330102
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750330102,
					"content": "無駄に背ばかり伸びて、みっともないな！ちょっと躓いただけで逃げようとするなんて、それでも戦士か？お前が俺の兄だなんて、信じられない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330103
					],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750330103,
					"content": "途方に暮れて誰かに助けを求めたことなんて一度もないと、お前は言いきれるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330104
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750330104,
					"content": "もちろんあるさ。だから、父さんと姉さんに特訓の成果を見てもらうために、こうやって帰ってきたんだ。俺は兄さんみたいな根性なしじゃないからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330105
					],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750330105,
					"content": "アコミト、隊長が脱退申請を承認しなかったのは、一時的な感情に流されないで、ちゃんと考えてから決めてほしかったからだと思うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330106
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750330106,
					"content": "一旦気持ちを落ち着かせて、自分で決めなさい。あとで後悔しないようにね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330107
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750330107,
					"content": "とは言っても、私も退役したばかりで、この先何をすればいいか迷ってるの。あんたに助言する資格はないかもしれないわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330108
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750330108,
					"content": "おまえたち、家族だったんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330109,
						750330110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750330109,
					"content": "びっくり。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330111
					]
				},
				{
					"id": 750330111,
					"content": "旅人とパイモン！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330112
					],
					"speakerTitle": "コヨニ"
				},
				{
					"id": 750330112,
					"content": "一つ悪い知らせがあるんだ——脱退計画は失敗したよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330113,
						750330114
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750330113,
					"content": "やっぱり…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330115
					]
				},
				{
					"id": 750330115,
					"content": "この苦痛から逃れられるにはどうしたらいいんだ？戦士なんてつらすぎるよ。もっと楽に生きる方法はないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330116
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750330116,
					"content": "まだ飛行隊のことで悩んでるのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330117
					],
					"speakerTitle": "コヨニ"
				},
				{
					"id": 750330117,
					"content": "残念だが…アコミト、俺の経験から言わせてもらえば、楽に生きるなんて無理な話だぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330118
					],
					"speakerTitle": "コヨニ"
				},
				{
					"id": 750330118,
					"content": "マターガのアームカバーは直した。マニョーヤ、お前のもついでに直してやろう…おや？お客さんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330119
					],
					"speakerTitle": "コヨニ"
				},
				{
					"id": 750330119,
					"content": "お父さん、こちらの二人は外で訓練してた時に出会った冒険者さん。アコミトもお世話になったそうよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330120
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750330120,
					"content": "どうも、親切な冒険者たちよ。俺のことはコヨニと呼んでくれ。飛行訓練のトレーナーで、この子たちの父親だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330121
					],
					"speakerTitle": "コヨニ",
					"speakerSubtitle": "「花翼の集」トレーニングマスター"
				},
				{
					"id": 750330121,
					"content": "アコミト、すごく悩んでるみたいだからさ、手伝えることがあったら遠慮なく言ってくれよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750330122,
					"content": "感謝する。まあ、アコミトのことは心配いらないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330123
					],
					"speakerTitle": "コヨニ"
				},
				{
					"id": 750330123,
					"content": "えっ？息子を放っとくのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750330124,
					"content": "ハハッ、そういう意味ではない…そうだな、お前たちは冒険者だということだが、それなら冒険者協会に入っているだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330125
					],
					"speakerTitle": "コヨニ"
				},
				{
					"id": 750330125,
					"content": "実に素晴らしい組織だ。冒険者とは世界を探検するために行動する者のことを言うのだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330126
					],
					"speakerTitle": "コヨニ"
				},
				{
					"id": 750330126,
					"content": "具体的な目的は冒険者それぞれだろうがな。モラのため、知識を得るため…ただ単に暇つぶしのためという者もいるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330127
					],
					"speakerTitle": "コヨニ"
				},
				{
					"id": 750330127,
					"content": "そういう人々をまとめ、同じ信条に従わせる組織力は大したものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330128
					],
					"speakerTitle": "コヨニ"
				},
				{
					"id": 750330128,
					"content": "俺は飛行隊の竜騎士を引退してから、部族のトレーナーになったが、六つの部族のトレーナーを集めて協会を作るなんてことは想像もつかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330129
					],
					"speakerTitle": "コヨニ"
				},
				{
					"id": 750330129,
					"content": "えーと…その話とアコミトのことがどう関係あるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330130
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750330130,
					"content": "これが父さんの話し方なの。父さんが飛行隊にいた頃、隊員たちもクク竜も、みんな父さんの話に真剣に耳を傾けてたのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330131
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750330131,
					"content": "部族のトレーナーになってからも、勇士を目指す人たちが相談に来るくらいなんだから。とりあえず、続きを聞いてみましょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330132
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750330132,
					"content": "昔のことだよ、マニョーヤ。とにかく、続けよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330133
					],
					"speakerTitle": "コヨニ"
				},
				{
					"id": 750330133,
					"content": "俺たちトレーナーが訓練場の建設や訓練内容の構想に力を注ぐのは、「勇士」に憧れているからだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330134
					],
					"speakerTitle": "コヨニ"
				},
				{
					"id": 750330134,
					"content": "自分が夢見る最高の勇士が現れるのを待っているんだよ。が、その勇士がどうあるべきかは、誰にも決められない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330135
					],
					"speakerTitle": "コヨニ"
				},
				{
					"id": 750330135,
					"content": "だからトレーナーの協会なんて作れるはずがないんだ。原則や規定といったものを決められないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330136
					],
					"speakerTitle": "コヨニ"
				},
				{
					"id": 750330136,
					"content": "「最高の勇士」は、それを夢見る人によって、顔も性格も違ってくる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330137
					],
					"speakerTitle": "コヨニ"
				},
				{
					"id": 750330137,
					"content": "皆が憧れている勇士だって、強い意志に燃えることもあれば、自己嫌悪に陥ることもある——そして、いつかは老いて死ぬ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330138
					],
					"speakerTitle": "コヨニ"
				},
				{
					"id": 750330138,
					"content": "では——勇士は果たして疲れないのだろうか？そんなことはない。ウォーベンに記録された数多の事例から、自己嫌悪と疲労は誰にでも平等に襲いかかることが証明されている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330139
					],
					"speakerTitle": "コヨニ"
				},
				{
					"id": 750330139,
					"content": "勇士は必ず大柄でなければならないのか？しかし、大きな身体に恵まれながら、吐き気がするほど卑劣な輩がいたとも、ウォーベンには記録されている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330140
					],
					"speakerTitle": "コヨニ"
				},
				{
					"id": 750330140,
					"content": "勇士もいつかは衰える。それが自然の摂理だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330141
					],
					"speakerTitle": "コヨニ"
				},
				{
					"id": 750330141,
					"content": "子供たちは俺のことを勇士と呼んでくれるが、見ての通り、俺は年老いた鳥だ。もう飛べやしない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330142
					],
					"speakerTitle": "コヨニ"
				},
				{
					"id": 750330142,
					"content": "つまらない基準に合った、完璧な顔を持つ勇士など、ナタでは英雄とみなされまい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330143
					],
					"speakerTitle": "コヨニ"
				},
				{
					"id": 750330143,
					"content": "マニョーヤ、アコミト、マターガ…お前たちが花翼の集の英雄となって空高くからの景色を眺めたいと願ったからこそ、俺はお前らを飛行台に連れていった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330144
					],
					"speakerTitle": "コヨニ"
				},
				{
					"id": 750330144,
					"content": "お前らの悩みや欲望は、英雄の長い旅路の一瞬にすぎない。必ずしも解決しなくてはならない問題じゃないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330145
					],
					"speakerTitle": "コヨニ"
				},
				{
					"id": 750330145,
					"content": "飛行隊を離れたら勇士じゃなくなるのか？飛行隊に入ったら必ず勇士になれるのか？そんなことはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330146
					],
					"speakerTitle": "コヨニ"
				},
				{
					"id": 750330146,
					"content": "大志を抱くのは大いに結構。だが、迷ったり落ち込んだりするのも同じようによくあることさ。戦士としていろんな経験を積んで、初めて英雄になれるものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330147
					],
					"speakerTitle": "コヨニ"
				},
				{
					"id": 750330147,
					"content": "自分の様々な感情と向き合い、それに慣れ、さらに乗り越えていくんだ。決して感情に支配されてはならん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330148
					],
					"speakerTitle": "コヨニ"
				},
				{
					"id": 750330148,
					"content": "それでやっと、ナタの英雄になれるんだ。分かったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330149
					],
					"speakerTitle": "コヨニ"
				},
				{
					"id": 750330149,
					"content": "分かったわ、父さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330150
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750330150,
					"content": "アコミト、まだ迷ってるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330151
					],
					"speakerTitle": "コヨニ"
				},
				{
					"id": 750330151,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330152
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750330152,
					"content": "説教を垂れるのは我が家のやり方じゃない。小さい頃、兄弟そろって飛んでいたように、また三人一緒に飛んでみろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330153
					],
					"speakerTitle": "コヨニ"
				},
				{
					"id": 750330153,
					"content": "自分の心と体で決めるんだ。部屋に籠もって頭を抱えてたって、いい考えが浮かぶはずがない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330154
					],
					"speakerTitle": "コヨニ"
				},
				{
					"id": 750330154,
					"content": "わかったよ、父さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330155
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750330155,
					"content": "#トレーニングマスターって、こういうものなのか？オイラ、まったく意味がわからなかったぞ。{NICKNAME}はわかったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330156,
						750330157
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750330156,
					"content": "うん、これから空を飛ぶんだって。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330158
					]
				},
				{
					"id": 750330158,
					"content": "冒険者よ、お前のことはこいつらから聞いた。面白い若者じゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330159
					],
					"speakerTitle": "コヨニ"
				},
				{
					"id": 750330159,
					"content": "マニョーヤと勝負をするほどの勇気を持ち、アコミトを助け、マターガにも認められたお前は本物の勇士だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330160
					],
					"speakerTitle": "コヨニ"
				},
				{
					"id": 750330160,
					"content": "もしよければ、こいつらと一緒に飛んでみてくれないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330161,
						750330162
					],
					"speakerTitle": "コヨニ"
				},
				{
					"id": 750330161,
					"content": "いいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330163
					]
				},
				{
					"id": 750330163,
					"content": "ハハッ、構わない。その気になったら声をかけてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330164
					],
					"speakerTitle": "コヨニ"
				},
				{
					"id": 750330164,
					"content": "こいつらの飛行技術は、花翼の集でもずば抜けている。一緒に飛ぶと気持ちいいと思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "コヨニ"
				},
				{
					"id": 750330162,
					"content": "考えさせて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330163
					]
				},
				{
					"id": 750330157,
					"content": "分からない。奥が深すぎる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330158
					]
				},
				{
					"id": 750330114,
					"content": "（肩をすくめる）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330115
					]
				},
				{
					"id": 750330110,
					"content": "そんな気がしてた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330111
					]
				}
			]
		},
		{
			"id": 7503302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
