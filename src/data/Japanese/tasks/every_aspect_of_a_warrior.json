				{
					"id": 750330601,
					"content": "はぁ…また旅人に負けちまった。こんだけ練習してきたのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330602
					],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750330602,
					"content": "だから言ったろ？勝ちを求め続けたって、終わりなんてないって。何も恐れずにひたすら突っ走るお前には頭が下がるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330603
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750330603,
					"content": "アコミトも小さい頃はそうだったわよ。毎日のように私について回って、すっごいマスターテイマーになるって言ってたじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330604
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750330604,
					"content": "もう、姉さん、からかわないでくれよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330605
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750330605,
					"content": "お前たちは立派な戦士で、俺の誇りだ。どんな戦士も、いつかどこかで、様々な問題に遭遇する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330606
					],
					"speakerTitle": "コヨニ"
				},
				{
					"id": 750330606,
					"content": "自分の心に恥じないように生きてくれる限り、お前たちはいつまでも俺の誇りだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "コヨニ"
				}
