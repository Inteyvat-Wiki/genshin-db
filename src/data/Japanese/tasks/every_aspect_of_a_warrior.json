			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"コヨニ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750330201,
					"content": "この子たちと一緒に飛んでみないか？花翼の集の腕利き飛行士たちと競争できる機会は、そうそうないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330202
					],
					"speakerTitle": "コヨニ"
				},
				{
					"id": 750330202,
					"content": "コース上の<color=#00E1FFFF>炎気球</color>を追いかけ、一番先に追いついた者が勝ちだ。こいつらが小さかった頃は、いつもこうやって訓練させたものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330203
					],
					"speakerTitle": "コヨニ"
				},
				{
					"id": 750330203,
					"content": "<color=#00E1FFFF>炎を乗せた気球は赤い羽で飾ってある</color>。勇士が背負うべき責任と名誉の象徴として、俺が作ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330204
					],
					"speakerTitle": "コヨニ"
				},
				{
					"id": 750330204,
					"content": "見ればすぐに分かるだろう。どうだ、試してみるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330205,
						750330207
					],
					"speakerTitle": "コヨニ"
				},
				{
					"id": 750330205,
					"content": "準備オッケー。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330206
					]
				},
				{
					"id": 750330206,
					"content": "ハハッ、いいだろう。スタート地点に行って準備してくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "コヨニ"
				},
				{
					"id": 750330207,
					"content": "もう少し準備させて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330208
					]
				},
				{
					"id": 750330208,
					"content": "構わない。準備ができたら言ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "コヨニ"
				}
			]
		},
		{
