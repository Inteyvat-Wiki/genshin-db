			},
			"dialogs": [
				{
					"id": 750330401,
					"content": "素晴らしい腕前じゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330402
					],
					"speakerTitle": "コヨニ"
				},
				{
					"id": 750330402,
					"content": "さっきの僕の飛行、君はどう思った？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330403,
						750330404
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750330403,
					"content": "素晴らしかったよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330405
					]
				},
				{
					"id": 750330405,
					"content": "ありがとう…でも、君と比べたらまだまだだってことは分かる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330406
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750330406,
					"content": "アコミト…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330407
					],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750330407,
					"content": "あ、いや、負けたから落ち込んでるわけじゃないんだ。自分が飛べるってことは分かってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330408
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750330408,
					"content": "ただ、つらい日々の中で、自信を失ってしまって…うまく飛べたとしても、自分と素直に向き合えないでいるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330409
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750330409,
					"content": "#でも、{NICKNAME}は僕と違って、どこまでも自由に飛んでいた。傍から見ても分かったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330410
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750330410,
					"content": "現状から逃げないで自分で決めろと、父さんや姉さんは僕に言う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330411
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750330411,
					"content": "もし…僕の体も、頭も、そして心も…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330412
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750330412,
					"content": "自分に向いてない道をこれ以上歩みたくないってのが本音だとしたら、それでも僕を応援してくれるのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330413
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750330413,
					"content": "ええ、あなた自身で決めたことなら。そして、その結果を受け入れる覚悟ができてるならね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330414
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750330414,
					"content": "マターガは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330415
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750330415,
					"content": "ストップ！俺がここで兄さんを責めるとか思ってないだろうな？兄さんの性格はよく知ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330416
					],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750330416,
					"content": "耐えられないならいさぎよく諦めろ。堂々としてればお前だって勇士だ。誰にもとやかく言う資格なんてない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330417
					],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750330417,
					"content": "トレーニングマスターは、戦士のために訓練計画を立てるのが仕事で、本人は訓練に参加しなくていい。楽といえば楽だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330418
					],
					"speakerTitle": "コヨニ"
				},
				{
					"id": 750330418,
					"content": "だが、かつては俺も毎日のように竜と一緒に空を駆け巡っていた。その日々の本当の意味はよく分かっている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330419
					],
					"speakerTitle": "コヨニ"
				},
				{
					"id": 750330419,
					"content": "人のことをとやかく言うのは簡単だが、実際に行動するのは口で言うよりずっと難しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330420
					],
					"speakerTitle": "コヨニ"
				},
				{
					"id": 750330420,
					"content": "トレーナーとして——休暇を取って心身を整えてこい、とアドバイスしよう。たとえ、隊の皆から文句を言われてもだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330421
					],
					"speakerTitle": "コヨニ"
				},
				{
					"id": 750330421,
					"content": "父親としては…お前の意思を理解し、その選択を尊重したいと思っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330422
					],
					"speakerTitle": "コヨニ"
				},
				{
					"id": 750330422,
					"content": "飛行隊を離れることなんて、別に大したことじゃない。花翼の集の戦士の価値を証明できるのは、飛行だけではないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330423
					],
					"speakerTitle": "コヨニ"
				},
				{
					"id": 750330423,
					"content": "ありがとう…絶対反対されるかと思ってた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330424
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750330424,
					"content": "何言ってるの。私たちは家族よ。あんたが困ってたら、手を貸すのは当たり前でしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330425
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750330425,
					"content": "花翼の集の飛行隊に入るのがそんなに難しいなんて。戦士も大変だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330426,
						750330428
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750330426,
					"content": "冒険者も大変だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330427
					]
				},
				{
					"id": 750330427,
					"content": "そうだな。思い返せば、これまでいろんなことがあったけど、全部乗り越えてきたもんな。なんか誇らしいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330430
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750330430,
					"content": "確かに勇士になるのは容易ではない。だが、勇士から英雄に成長するのはもっと厳しいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330431
					],
					"speakerTitle": "コヨニ"
				},
				{
					"id": 750330431,
					"content": "俺はこれまで数多くの勇士を見てきた。その人が英雄の器であるかどうかは、大方見分けがつく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330432
					],
					"speakerTitle": "コヨニ"
				},
				{
					"id": 750330432,
					"content": "若者よ、その目を見れば分かる——これまで数多の試練を乗り越えてきたのだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330433,
						750330434
					],
					"speakerTitle": "コヨニ"
				},
				{
					"id": 750330433,
					"content": "想像以上かもね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330435
					]
				},
				{
					"id": 750330435,
					"content": "やはり俺の目に狂いはなかった。お前の歩む道は、これから先もずっと遠くへと伸びているだろう。お前のような未来の英雄の役に立ちたいと、俺は願っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330436
					],
					"speakerTitle": "コヨニ"
				},
				{
					"id": 750330436,
					"content": "こうやって家族みんなでお前と知り合えたのも何かの縁だ。大したことはできないが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330437
					],
					"speakerTitle": "コヨニ"
				},
				{
					"id": 750330437,
					"content": "ここの訓練コースを使いたい時は、俺に一声かけてくれれば、いつでも使っていいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330438
					],
					"speakerTitle": "コヨニ"
				},
				{
					"id": 750330438,
					"content": "ありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330439
					]
				},
				{
					"id": 750330439,
					"content": "礼などいらない。お前が英雄になって、空で輝く瞬間を見られることを楽しみにしている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "コヨニ"
				},
				{
					"id": 750330434,
					"content": "（沈黙する。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330435
					]
				},
				{
					"id": 750330428,
					"content": "誰もが勇士になれるわけじゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330429
					]
				},
				{
					"id": 750330429,
					"content": "確かに厳しそうだよな。勇士になるために毎日訓練するなんて、オイラには絶対に無理だぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330430
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750330404,
					"content": "悪くなかったよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330405
					]
				}
			]
