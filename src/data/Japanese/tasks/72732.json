				"points": []
			},
			"dialogs": [
				{
					"id": 727320101,
					"content": "荒瀧派、対決しに来たよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320102
					],
					"speakerTitle": "「怪力三十三」"
				},
				{
					"id": 727320102,
					"content": "なんだ？「花角玉将」のやつ、また子供と戦わせるつもりか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320103
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727320103,
					"content": "人手不足だからって、適当に誤魔化したりしてねぇよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320104
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727320104,
					"content": "…あんたはどうでもいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320105
					],
					"speakerTitle": "「怪力三十三」"
				},
				{
					"id": 727320105,
					"content": "きゃっきゃっと騒ぐやつは、だいたい雑魚だから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320106
					],
					"speakerTitle": "「怪力三十三」"
				},
				{
					"id": 727320106,
					"content": "#この金髪のお{M#兄}{F#姉}ちゃんからは、強者の風格が滲み出てる。{M#彼}{F#彼女}こそがあんたたち荒瀧派の親分でしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320107
					],
					"speakerTitle": "「怪力三十三」"
				},
				{
					"id": 727320107,
					"content": "えへへ、おまえ見る目あるな！もっとこいつを褒めてやれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 727320108,
					"content": "ああッ？何バカなこと言ってやがる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320109
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727320109,
					"content": "俺様のダチ公は確かに強ぇが、今回は荒瀧派の助っ人だ！荒瀧派の名が示してるように、親分はいつだってこの荒瀧一斗様だぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320110,
						727320111
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727320110,
					"content": "#{M#俺}{F#私}の名前にも期間限定の肩書きが欲しい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727320112
					]
				},
				{
					"id": 727320112,
					"content": "そうだな。荒瀧派の実力はひとまず置いとくとして、親分っていったいどんな気分なんだ？オイラも気になってきたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 727320113,
					"content": "もしオイラたちの願いを聞き入れてくれたら、オイラも「荒瀧（三日限定）パイモン」とか、「荒瀧派パイモン（臨時親分）」とか名乗れるな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 727320114,
					"content": "おいおいおい！お前ぇら！相手に振り回されんな！こいつは明らかに仲間割れさせようとしてるだろ！これはこいつの罠だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320115
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727320115,
					"content": "俺様がお前の親分に勝ったら、今の言葉を後悔して、慌てて取り消すことになるだろうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320116
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727320116,
					"content": "諦めなさい…あんたたち荒瀧派の事情なんて、あたしの知ったことじゃないから。あたしはただ強い相手と勝負したいだけなの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320117
					],
					"speakerTitle": "「怪力三十三」"
				},
				{
					"id": 727320117,
					"content": "#お{M#兄}{F#姉}ちゃんの虫相撲の腕、あたしに見せてちょうだい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「怪力三十三」"
				},
				{
					"id": 727320111,
					"content": "親分の座に何日か座らせてくれない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727320112
					]
				}
			]
		}
	]
}