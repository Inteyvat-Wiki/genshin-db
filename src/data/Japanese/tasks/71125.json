				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711250401,
					"content": "#何しろ、{M#俺}{F#私}は経験豊富な冒険者だから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711250402
					]
				},
				{
					"id": 711250402,
					"content": "#では、実験は{NICKNAME}とパイモンに任せよう。研究プロジェクトの存亡は、君たちにかかってる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アナトール"
				}
			]
		},
		{
			"id": 7112505,
			"completionStepIds": [
				7112501
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7112501",
							"2"
						],
						"stepId": 7112501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パトリック",
					"アナトール"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711250501,
					"content": "さあさあ、アナトール、早く旅費を渡してくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250502
					],
					"speakerTitle": "パトリック"
				},
				{
					"id": 711250502,
					"content": "#分かったよ。ただし、僕が払うのは{NICKNAME}とパイモンが協力して浮いた分だけだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250503
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 711250503,
					"content": "他の部分については、君の商品設計案を見てから決めることにしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250504
					],
					"speakerTitle": "アナトール"
				},
				{
