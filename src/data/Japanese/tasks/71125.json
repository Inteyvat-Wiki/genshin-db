				"points": [
					{
						"sceneId": 3,
						"position": [
							-211.69,
							323.075,
							1775.736
						],
						"pointId": 310600186
					},
					{
						"sceneId": 3,
						"position": [
							-210.303,
							323.046,
							1774.581
						],
						"pointId": 310600187
					}
				]
			},
			"dialogs": [
				{
					"id": 711250101,
					"content": "パトリック、もうやめよう！この実験の方向性は、科学院の指示を完全に背いてしまっている…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250102
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 711250102,
					"content": "科学院の指示？審査の書類に書かれた「本プロジェクトでは、経済面を含む諸々の効果が見込める技術の実用化を図るべきだ」ってやつか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250103
					],
					"speakerTitle": "パトリック"
				},
				{
					"id": 711250103,
					"content": "彼らは、儲かるかどうかが知りたいだけだろ？そんなことはほっといて、私たちは引き続き実験を行ってデータを集めればいい。アナトール、振晶を買うためにも経費をもう少しくれないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250104
					],
					"speakerTitle": "パトリック"
				},
				{
					"id": 711250104,
					"content": "経費はもう残り少ない。もし使い果たしたら、実験の協力者を雇うモラはどこから捻出するんだ？君が直接実験に参加するつもりか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250105
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 711250105,
					"content": "覚えてるか、アナトール？「実験の野外実施における研究監督員は、必要時に研究者の研究を手伝わなければならない…」んだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250106
					],
					"speakerTitle": "パトリック"
				},
				{
					"id": 711250106,
					"content": "実験のほうはアナトールに任せた。それに、結構な額の旅費をもらってるんだろ？少しばかり食事を抜けば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250107
					],
					"speakerTitle": "パトリック"
				},
				{
					"id": 711250107,
					"content": "おいおい、経費を捻出するために同僚に苦労を押し付けるつもりか。まったくパトリック、なんてことを考えるんだ！この経費は、僕が腌篤鮮を食べるために残しといたモラだ。君みたいなひどいやつには絶対に渡さない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250108
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 711250108,
					"content": "そうだそうだ！仕事は手を抜いてもいいけど、食事を抜くなんて絶対にダメだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711250109,
					"content": "ああ、まさにその通り。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250110
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 711250110,
					"content": "おや…ああ、やっぱり。深い真理を語る人が現れたと思ったら、君はかの有名な…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250111
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 711250111,
					"content": "おう！オイラがかの有名なパイモンだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711250112,
					"content": "#じゃあ、こちらがかの有名な{NICKNAME}だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250113,
						711250114
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 711250113,
					"content": "#{M#俺}{F#私}がかの有名な旅人！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711250116
					]
				},
				{
					"id": 711250116,
					"content": "とにかく、パイモンの言う通り、食費を節約するわけにはいかない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250117
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 711250117,
					"content": "じゃあ、どうすればいいのさ？モラ不足で実験ができなければ、「経済面を含む『諸々』の効果」の代わりに、私の「悲惨な人生」そのものが現実になる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250118
					],
					"speakerTitle": "パトリック"
				},
				{
					"id": 711250118,
					"content": "はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250119
					],
					"speakerTitle": "パトリック"
				},
				{
					"id": 711250119,
					"content": "ああ、そういうことだったのか。フォンテーヌ人二人がここでなにしてるんだろって、さっきから気になってたんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711250120,
					"content": "「モラモラ」の研究をしてたんだな？へへっ、それってもしかしてモラが永遠に湧き出てくる研究なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711250121,
					"content": "#わぁ、{M#俺}{F#私}もその研究に混ぜて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711250122
					]
				},
				{
					"id": 711250122,
					"content": "そんな研究してるわけないだろ！だが、今の「諸々」の研究が、いずれ「モラモラ」に繋がると私は信じてる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250123
					],
					"speakerTitle": "パトリック"
				},
				{
					"id": 711250123,
					"content": "そのためには、まず経費の問題をどうにかしないと。それから、売れる発明品の設計も…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250124
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 711250124,
					"content": "ゴホンッ、偉大な発明は偉大な研究の副産物に過ぎない…研究をしていれば、奇抜な発明のアイデアがエイのように脳皮質から飛び出てくるはずだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250125
					],
					"speakerTitle": "パトリック"
				},
				{
					"id": 711250125,
					"content": "確かに、そうだったら万々歳だけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250126
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 711250126,
					"content": "ちょっと待った。なんだか、だんだん気になってきたぞ。いったいどんな研究をしてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711250127,
					"content": "ん？ああ、「振晶」という特殊な鉱石に関する研究をしてるんだよ。この「振晶」は、以前いろんな鉱石の性質をテストするときに発見した璃月の鉱石だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250128
					],
					"speakerTitle": "パトリック"
				},
				{
					"id": 711250128,
					"content": "「振晶」には、「発振晶」と「受振晶」という二種類がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250129
					],
					"speakerTitle": "パトリック"
				},
				{
					"id": 711250129,
					"content": "「発振晶」は特定の刺激を受けるとエネルギーを放出し、「受振晶」が共鳴を起こす。それによって特殊な効果が現れるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250130
					],
					"speakerTitle": "パトリック"
				},
				{
					"id": 711250130,
					"content": "たしかに面白い現象だが、鉱石研究に対するフォンテーヌ科学院の態度は…ある理由によって、前よりも熱が冷めてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250131
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 711250131,
					"content": "それにレモンドさんは、この研究プロジェクトに「経済効果」がないと考えてるらしい。まあ、一言で言えば、モラにならないってことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250132
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 711250132,
					"content": "まったく、なんて浅はかなんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250133
					],
					"speakerTitle": "パトリック"
				},
				{
					"id": 711250133,
					"content": "はぁ…てなわけで、パトリックの経費申請はうやむやにされてね。経費の代わりに手に入ったのは、栄誉称号だけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250134
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 711250134,
					"content": "最初は、この栄誉称号が信用の証明書代わりになって、北国銀行でモラを借りられるんじゃないかとも思ったんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250135
					],
					"speakerTitle": "パトリック"
				},
				{
					"id": 711250135,
					"content": "フォンテーヌ科学院のエンジニアって聞いたとたん、北国銀行の職員の口元に浮かんでいた笑みが春の雪のように融けてなくなった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250136
					],
					"speakerTitle": "パトリック"
				},
				{
					"id": 711250136,
					"content": "まあ、科学院の人たちが昔から何度も使ってきた手法だから、通用するほうがおかしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250137
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 711250137,
					"content": "見ての通り——経費は底をついて、実験に協力してくれる冒険者も雇えない…それに、設計や発明のアイデアも皆無って状況だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250138
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 711250138,
					"content": "そもそも、繁雑な工程を要する実験と実験場を準備する傍ら、発明品の設計を…しかも経費もない状況で異郷に身を置きながら進めるなんてこと、とてもじゃないが難易度が高い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250139
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 711250139,
					"content": "#そうだったのか。なぁ{NICKNAME}、オイラたちが手を貸してやろうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250140
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711250140,
					"content": "パイモンに大発明家になってもらおう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711250141
					]
				},
				{
					"id": 711250141,
					"content": "発明のことはよくわかんないけど、実験の部分ならオイラたちも手伝えるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250142
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711250142,
					"content": "ほ、本当に手を貸してくれるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パトリック"
				},
				{
					"id": 711250114,
					"content": "#{M#俺}{F#私}はそれよりもうちょい有名！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711250115
					]
				},
				{
					"id": 711250115,
					"content": "こんなことで張り合ってどうすんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250116
					],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
