					"パトリック",
					"アナトール"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711250301,
					"content": "#何せ、{M#俺}{F#私}は名誉上級研究員だから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711250302
					]
				},
				{
					"id": 711250302,
					"content": "そ、それは驚いたな。科学院が栄誉称号を贈る範囲がこうも拡大していたなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250303
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 711250303,
					"content": "実験の協力を申し出てくれたその親切さは、栄誉称号を惜しみなく与えてもいいレベルだろう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パトリック"
				}
			]
		},
		{
			"id": 7112504,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
