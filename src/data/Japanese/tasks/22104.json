			"dialogs": [
				{
					"id": 221040101,
					"content": "参ったわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040102
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 221040102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221040103
					]
				},
				{
					"id": 221040103,
					"content": "あらいらっしゃい、ごめんね、気づかなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040104
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 221040104,
					"content": "周辺の怪物がどんどん増えてきてね。旅館に入ってくることはないって旦那はいつも言ってるけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040105
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 221040105,
					"content": "でもいざという時彼一人しか…とても心配だわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040106
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 221040106,
					"content": "もしお時間があれば、周りを見てきてくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040107,
						221040108
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 221040107,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221040109
					]
				},
				{
					"id": 221040109,
					"content": "手伝ってくれてありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040113
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 221040113,
					"content": "とにかく、頼むわね、報酬はちゃんと払うから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 221040108,
					"content": "この旅館…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221040110
					]
				},
				{
					"id": 221040110,
					"content": "えっと…普通の旅館よ、ちょっと離れた場所にあって、お客さんの多いただの旅館よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040111
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 221040111,
					"content": "でも旅人にとっては、食事や寝る場所があるのはいいことでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040112
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 221040112,
					"content": "私も夫もそう考えてる、とてもシンプルよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040113
					],
					"speakerTitle": "ヴェル·ゴレット"
				}
			]
		},
