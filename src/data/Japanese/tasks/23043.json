						230430402,
						230430403
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 230430402,
					"content": "<color=#00E1FFFF>ブトルス</color>の居場所について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430404
					]
				},
				{
					"id": 230430404,
					"content": "彼の具体的な居場所がわからない？じゃあ…彼のいる場所を地図に記しておきましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430405
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 230430405,
					"content": "これでよし、と。じゃあお願いします、旅人さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アザライ"
				},
				{
					"id": 230430403,
