			"dialogs": [
				{
					"id": 230430201,
					"content": "どうでした？発注できましたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430202,
						230430203
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 230430202,
					"content": "<color=#00E1FFFF>ラマ</color>の居場所について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430204
					]
				},
				{
					"id": 230430204,
					"content": "彼女の具体的な居場所がわからない？じゃあ…彼女のいる場所を地図に記しておきましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430206
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 230430206,
					"content": "これでよし、と。じゃあお願いします、旅人さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アザライ"
				},
				{
					"id": 230430203,
					"content": "<color=#00E1FFFF>ジュート</color>の居場所について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430205
					]
				},
				{
					"id": 230430205,
					"content": "彼の具体的な居場所がわからない？じゃあ…彼のいる場所を地図に記しておきましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430206
					],
					"speakerTitle": "アザライ"
				}
			]
		},
		{
			"id": 2304303,
