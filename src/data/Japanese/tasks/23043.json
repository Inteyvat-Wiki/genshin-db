			"dialogs": [
				{
					"id": 230430501,
					"content": "いらっしゃい！色々使える香料はいかがかですか？お値段もお手頃ですよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430502
					],
					"speakerTitle": "ラマ"
				},
				{
					"id": 230430502,
					"content": "アザライの注文について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430503
					]
				},
				{
					"id": 230430503,
					"content": "え？アザライから注文を頼まれて来たんですか？それはいいのですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430504
					],
					"speakerTitle": "ラマ"
				},
				{
					"id": 230430504,
					"content": "これまではエルマイト旅団の人に仕入金を託してたのに、今回は何故冒険者のあなたに頼んだんでしょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430505
					],
					"speakerTitle": "ラマ"
				},
				{
					"id": 230430505,
					"content": "コホン！えっと、今回の仕入金はどのくらいですか？どれどれ…わぁ、かなりありますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430506
					],
					"speakerTitle": "ラマ"
				},
				{
					"id": 230430506,
					"content": "えーっと、うちで香料を仕入れてくれたら、ロングセラー商品を提供できますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430507
					],
					"speakerTitle": "ラマ"
				},
				{
					"id": 230430507,
					"content": "売値については…前と同じように安めにしておくことをお勧めします。その方が売れやすいでしょうから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430508,
						230430510
					],
					"speakerTitle": "ラマ"
				},
				{
					"id": 230430508,
					"content": "じゃあここで注文する。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430509
					]
				},
				{
					"id": 230430509,
					"content": "ええ、毎度ありがとうございます！準備できたら、こちらから荷物を運ばせますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ラマ"
				},
				{
					"id": 230430510,
					"content": "他をあたってみる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430511
					]
				},
				{
					"id": 230430511,
					"content": "わかりました…もしうちで注文したくなったら、戻ってきて声をかけてくださいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ラマ"
				}
			]
		},
