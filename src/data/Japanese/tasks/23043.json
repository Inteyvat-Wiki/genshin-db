			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アザライ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230430101,
					"content": "やはり、レイフに頼んで誰か探してもらわないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430102
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 230430102,
					"content": "何を悩んでるの…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430103
					]
				},
				{
					"id": 230430103,
					"content": "ああ旅人さん、何かお探しですか？今、一部の品は在庫を切らしておりますが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430104
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 230430104,
					"content": "それで悩んでるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430105
					]
				},
				{
					"id": 230430105,
					"content": "そうなんですよ…この村は砂漠の中にありますから、商品を仕入れるにはもともと不便なんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430106
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 230430106,
					"content": "仕入れたい品があるときは、まず外に出る人に頼んで注文してもらって、それからレイフたちと一緒に荷物を村まで運び込まなければなりません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430107
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 230430107,
					"content": "そんな調子なので、商売のコストも上がってきてしまいます。生計を維持するために、俺も商品を少し高めの金額で売るしかありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430108
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 230430108,
					"content": "幸い村の人も理解してくれて、うちの商売をひいきにしてくれていますが。そうでなければこんな小さな店、とっくに潰れていたでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430109
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 230430109,
					"content": "しかし…はぁ、村の外に出る予定の人がいつでも見つかるわけでもありませんし、レイフたちも、いつも手が空いているわけではありません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430110
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 230430110,
					"content": "運が悪いと、在庫の少ない商品の中には品切れになるものもあって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430111,
						230430114
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 230430111,
					"content": "その商品って…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430112
					]
				},
				{
					"id": 230430112,
					"content": "日用品ですよ。仕入れが遅いわけじゃないんですが、売れるのが速くて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430113
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 230430113,
					"content": "もともと小さな商売ですので、商品を大量に仕入れるわけにもいかないですし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430117
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 230430117,
					"content": "コホン、それはさておき。旅人さんは村の外に出かけられる予定はありませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430118
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 230430118,
					"content": "香料を仕入れたいのですが、誰かに発注に行ってもらわないといけなくて…手伝っていただけませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430119,
						230430120
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 230430119,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430122
					]
				},
				{
					"id": 230430122,
					"content": "そうですね…<color=#00E1FFFF>ラマ</color>が売っている香料は値段も妥当で、品質も…まあまあです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430123
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 230430123,
					"content": "<color=#00E1FFFF>ジュート</color>が売り出した新しい香料は、品質がとても良いようです。試しに仕入れてみたいのですが、値段がどうなのかわかりません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430124
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 230430124,
					"content": "でも、今回仕入れに使える予算はこれだけでして。果たしてどちらから仕入れたらよいのやら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430125
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 230430125,
					"content": "旅人さん、この二軒の香料の売れ行きを見て、どちらかに発注をお願いいたします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430126
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 230430126,
					"content": "ああそれから、前に別の方に発注をお願いしたときは、商品が安い方に発注するよう頼みました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430127
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 230430127,
					"content": "今回も、商品が比較的安い店に注文を入れてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430128
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 230430128,
					"content": "アアル村で商売をするなら、やはり「薄利多売」の原則を守ったほうがいいでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430129,
						230430130
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 230430129,
					"content": "まず<color=#00E1FFFF>ラマ</color>の方に行ってみよう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430131
					]
				},
				{
					"id": 230430131,
					"content": "手伝って下さり、ありがとうございます。彼女がいる場所を地図に記しておきますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430133
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 230430133,
					"content": "じゃあよろしくお願いします。何か質問があれば、いつでも戻ってきて尋ねてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アザライ"
				},
				{
					"id": 230430130,
					"content": "まず<color=#00E1FFFF>ジュート</color>の方に行ってみよう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430132
					]
				},
				{
					"id": 230430132,
					"content": "手伝って下さり、ありがとうございます。彼がいる場所を地図に記しておきますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430133
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 230430120,
					"content": "お店の香料は品切れなの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430121
					]
				},
				{
					"id": 230430121,
					"content": "品切れとまではいきませんが…こういう売れ行きのいい商品は、多めに用意しておいた方がいいんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430122
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 230430114,
					"content": "長期的なパートナーを見つけられたら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430115
					]
				},
				{
					"id": 230430115,
					"content": "ハハハ…俺も考えたことはありますが、周りを見てくださいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430116
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 230430116,
					"content": "正直言って、この村で商品を扱うのは簡単なことじゃありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430117
					],
					"speakerTitle": "アザライ"
				}
			]
		},
		{
