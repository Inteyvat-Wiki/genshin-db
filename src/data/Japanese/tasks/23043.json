			"trigger": {
				"objectNames": [
					"アザライ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230430301,
					"content": "やはり、レイフに頼んで誰か探してもらわないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430302
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 230430302,
					"content": "何を悩んでるの…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430303
					]
				},
				{
					"id": 230430303,
					"content": "ああ旅人さん、何かお探しですか？今、一部の品は在庫を切らしておりますが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430304
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 230430304,
					"content": "それで悩んでるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430305
					]
				},
				{
					"id": 230430305,
					"content": "そうなんですよ…この村は砂漠の中にありますから、商品を仕入れるにはもともと不便なんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430306
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 230430306,
					"content": "仕入れたい品があるときは、まず外に出る人に頼んで注文してもらって、それからレイフたちと一緒に荷物を村まで運び込まなければなりません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430307
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 230430307,
					"content": "そんな調子なので、商売のコストも上がってきてしまいます。生計を維持するために、俺も商品を少し高めの金額で売るしかありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430308
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 230430308,
					"content": "幸い村の人も理解してくれて、うちの商売をひいきにしてくれていますが。そうでなければこんな小さな店、とっくに潰れていたでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430309
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 230430309,
					"content": "しかし…はぁ、村の外に出る予定の人がいつでも見つかるわけでもありませんし、レイフたちも、いつも手が空いているわけではありません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430310
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 230430310,
					"content": "運が悪いと、在庫の少ない商品の中には品切れになるものもあって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430311,
						230430314
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 230430311,
					"content": "その商品って…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430312
					]
				},
				{
					"id": 230430312,
					"content": "日用品ですよ。仕入れが遅いわけじゃないんですが、売れるのが速くて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430313
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 230430313,
					"content": "もともと小さな商売ですので、商品を大量に仕入れるわけにもいかないですし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430317
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 230430317,
					"content": "コホン、それはさておき。旅人さんは村の外に出かけられる予定はありませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430318
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 230430318,
					"content": "魚の干物を仕入れたいのですが、誰かに発注に行ってもらわないといけなくて…手伝っていただけませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430319,
						230430320
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 230430319,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430322
					]
				},
				{
					"id": 230430322,
					"content": "そうですね…<color=#00E1FFFF>ブトルス</color>の魚の干物は値段も妥当で、味も…まあまあです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430323
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 230430323,
					"content": "<color=#00E1FFFF>ジャハンギル</color>は最近、新しい方法で魚の干物を作っているようです。香料が沢山使われていて、とても美味しいそうです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430324
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 230430324,
					"content": "試しに仕入れてみたいのですが、値段がどうなのかわかりません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430325
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 230430325,
					"content": "でも、今回仕入れに使える予算はこれだけでして。果たしてどちらから仕入れたらよいのやら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430326
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 230430326,
					"content": "旅人さん、この二軒の魚の干物、その売れ行きを見て、どちらかに発注をお願いいたします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430327
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 230430327,
					"content": "ああそれから、前に別の方に発注をお願いしたときは、商品が安い方に発注するよう頼みました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430328
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 230430328,
					"content": "今回も、商品が比較的安い店に注文を入れてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430329
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 230430329,
					"content": "アアル村で商売をするなら、やはり「薄利多売」の原則を守ったほうがいいでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430330
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 230430330,
					"content": "というわけで、よろしくお願いしますね、旅人さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430331,
						230430332
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 230430331,
					"content": "まず<color=#00E1FFFF>ブトルス</color>の方に行ってみよう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430333
					]
				},
				{
					"id": 230430333,
					"content": "手伝って下さり、ありがとうございます。彼がいる場所を地図に記しておきますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430334
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 230430334,
					"content": "じゃあよろしくお願いします。何か質問があれば、いつでも戻ってきて尋ねてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アザライ"
				},
				{
					"id": 230430332,
					"content": "まず<color=#00E1FFFF>ジャハンギル</color>の方に行ってみよう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430333
					]
				},
				{
					"id": 230430320,
					"content": "みんな自分で干してるんだと思ってた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430321
					]
				},
				{
					"id": 230430321,
					"content": "アハハ…砂漠で魚を天日干しにするのは、いい考えとは言えませんね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430322
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 230430314,
					"content": "長期的なパートナーを見つけられたら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430315
					]
				},
				{
					"id": 230430315,
					"content": "ハハハ…俺も考えたことはありますが、周りを見てくださいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430316
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 230430316,
					"content": "正直言って、この村で商品を扱うのは簡単なことじゃありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430317
					],
					"speakerTitle": "アザライ"
				}
			]
		},
