			"dialogs": [
				{
					"id": 250340501,
					"content": "#{M#お兄ちゃん}{F#お姉ちゃん}、助けてくれてありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340502
					],
					"speakerTitle": "トゥラテ"
				},
				{
					"id": 250340502,
					"content": "キュー、キュー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340503
					],
					"speakerTitle": "チーカ"
				},
				{
					"id": 250340503,
					"content": "#ここは集落から遠いから、イラパお姉ちゃんを呼んでくることもできなくて…{M#お兄ちゃん}{F#お姉ちゃん}が来てくれなかったら、きっとチーカはさらわれてた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340504
					],
					"speakerTitle": "トゥラテ"
				},
				{
					"id": 250340504,
					"content": "二人はどうしてここに？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340505
					]
				},
				{
					"id": 250340505,
					"content": "山登りの訓練だよ。でも途中で二人ともお腹が空いちゃって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340506
					],
					"speakerTitle": "トゥラテ"
				},
				{
					"id": 250340506,
					"content": "果物を採ってたら、いつの間にか遠くまで来ちゃってたんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340507
					],
					"speakerTitle": "トゥラテ"
				},
				{
					"id": 250340507,
					"content": "お腹いっぱいになった頃には、こんな遠くにいて…帰ったらまたお母さんに怒られちゃう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340508
					],
					"speakerTitle": "トゥラテ"
				},
				{
					"id": 250340508,
					"content": "助けてくれて本当にありがとう！さっき摘んだ「ショコアトゥルの種」をあげるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340509
					],
					"speakerTitle": "トゥラテ"
				},
				{
					"id": 250340509,
					"content": "さあ、早く帰ろう。行くよ、チーカ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340510
					],
					"speakerTitle": "トゥラテ"
				},
				{
					"id": 250340510,
					"content": "キュッ！キュ、キュキューッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "チーカ"
				}
			]
