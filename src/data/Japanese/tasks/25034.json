			"dialogs": [
				{
					"id": 250340101,
					"content": "チーカが嫌がってる！どっか行け！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340102
					],
					"speakerTitle": "トゥラテ"
				},
				{
					"id": 250340102,
					"content": "このくそガキ…お前、この竜を知ってんのか？どういう関係だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340103
					],
					"speakerTitle": "不機嫌そうな賊"
				},
				{
					"id": 250340103,
					"content": "キュー…キュー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340104
					],
					"speakerTitle": "チーカ"
				},
				{
					"id": 250340104,
					"content": "見ろよ、竜がイライラしちまってるじゃねぇか。とっとと失せろ！俺らはガキは殴らねぇ主義なんでな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340105
					],
					"speakerTitle": "不機嫌そうな賊"
				},
				{
					"id": 250340105,
					"content": "野郎ども、袋を持ってこい。ふん、この竜はいい値が付きそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340106
					],
					"speakerTitle": "不機嫌そうな賊"
				},
				{
					"id": 250340106,
					"content": "来るな！これ以上近づいたら容赦しないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340107
					],
					"speakerTitle": "トゥラテ"
				},
				{
					"id": 250340107,
					"content": "容赦しない？お前が？はははは、野郎ども、聞いたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340108
					],
					"speakerTitle": "不機嫌そうな賊"
				},
				{
					"id": 250340108,
					"content": "おお怖、俺っちビビっちまったぜ。そっちが先に挑発してきたんだから…怪我をしても文句はねぇよなぁ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340109
					],
					"speakerTitle": "不機嫌そうな賊"
				},
				{
					"id": 250340109,
					"content": "キュッ！キュ、キュキューッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340110
					],
					"speakerTitle": "チーカ"
				},
				{
					"id": 250340110,
					"content": "チッ、この竜なかなか手強いぜ…ガキンチョ、大人しく一眠りしな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340111,
						250340112
					],
					"speakerTitle": "不機嫌そうな賊"
				},
				{
					"id": 250340111,
					"content": "一眠りするのはそっちのほうだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340113
					]
				},
				{
					"id": 250340113,
					"content": "#{M#お兄ちゃん}{F#お姉ちゃん}、助けて！こいつらチーカをさらおうとしてるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340114
					],
					"speakerTitle": "トゥラテ"
				},
				{
					"id": 250340114,
					"content": "キューッ！キューッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340115
					],
					"speakerTitle": "チーカ"
				},
				{
					"id": 250340115,
					"content": "…通りすがりの冒険者か。こうしよう。目を瞑ってくれたら、ことが済んだ後、礼として分け前をやろう。どうだ、悪くないだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340116,
						250340117
					],
					"speakerTitle": "不機嫌そうな賊"
				},
				{
					"id": 250340116,
					"content": "チーカを傷つけることは許さない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340118
					]
				},
				{
					"id": 250340118,
					"content": "どうやら交渉の余地はねぇみてぇだな。いいぜ、お望み通り拳で語ってやろうじゃねぇか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340119
					],
					"speakerTitle": "不機嫌そうな賊"
				},
				{
					"id": 250340119,
					"content": "野郎ども、かかれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "不機嫌そうな賊"
				},
				{
					"id": 250340117,
					"content": "泥船に乗れってこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340118
					]
				},
				{
					"id": 250340112,
					"content": "悪いけど止めさせてもらう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340113
					]
				}
			]
		},
