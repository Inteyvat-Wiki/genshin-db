				]
			},
			"dialogs": [
				{
					"id": 700500501,
					"content": "…ほら、だからただのフツーの子猫だって言っただろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700500502,
					"content": "そんなまさか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500503
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 700500503,
					"content": "ニャ？ニャ…ニャニャ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500504,
						700500506
					],
					"speakerTitle": "戸惑っている子猫"
				},
				{
					"id": 700500504,
					"content": "#ねぇ{M#君}{F#あなた}、玄文獣を知らない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500505
					]
				},
				{
					"id": 700500505,
					"content": "ミャオ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500508
					],
					"speakerTitle": "戸惑っている子猫"
				},
				{
					"id": 700500508,
					"content": "子猫はあきれ顔で身を翻して去っていった…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700500509
					]
				},
				{
					"id": 700500509,
					"content": "もしかして…ねえ、あの子猫って玄文獣の幼体じゃないかな？ああやって翹英荘に潜伏して、大人になると茶樹を根こそぎかっさらってしまうの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500510
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 700500510,
					"content": "ギハーロさん、またあんたなの…言ったでしょ、玄文獣はあんな温厚な野獣じゃないって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500511
					],
					"speakerTitle": "洪分"
				},
				{
					"id": 700500511,
					"content": "あれ、洪分さん。まぁなんて偶然。どうしてここに？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500512
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 700500512,
					"content": "あのねぇ…この辺で「犯罪」の話ばっかりするのはやめてくれる？子供たちが本気にしたらどうするのよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500513
					],
					"speakerTitle": "洪分"
				},
				{
					"id": 700500513,
					"content": "二人は知り合い？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500514
					]
				},
				{
					"id": 700500514,
					"content": "ええ。ここに来たとき、このお嬢さんに荷物の運搬をお願いしたの。それと、民話のことも色々教えてもらったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500515
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 700500515,
					"content": "何回も言ったのよ。玄文獣は村には来ないってね。でもギハーロさんは信じてくれなくて、それどころか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500516
					],
					"speakerTitle": "洪分"
				},
				{
					"id": 700500516,
					"content": "来ないなら、来ないなりの取材方法があるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500517
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 700500517,
					"content": "また出た…ねえ、ギハーロさん。忠告したでしょ。何があっても、村を出て勝手に歩き回ったら駄目だからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500518
					],
					"speakerTitle": "洪分"
				},
				{
					"id": 700500518,
					"content": "玄文獣は実在する猛獣なの。もし出くわしてしまったら…ふぅ…お願いだから、一人で村を離れないようにしてよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500519
					],
					"speakerTitle": "洪分"
				},
				{
					"id": 700500519,
					"content": "洪分はお手上げといった様子で去っていった。さっきの子猫よりもぐったりしているようだった…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700500520
					]
				},
				{
					"id": 700500520,
					"content": "仕方ない、洪分さんにあそこまで言われたら、他の場所で取材するしかないわね。行くわよ。ついて来て。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 700500506,
					"content": "ごめん、猫違いだった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500507
					]
				},
				{
					"id": 700500507,
					"content": "ミャア…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500508
					],
					"speakerTitle": "戸惑っている子猫"
				}
			]
		},
		{
			"id": 7005006,
			"completionStepIds": [
				7005006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7005006",
							"2"
						],
						"stepId": 7005006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ギハーロ"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2276.275,
							287.313,
							1542.857
						],
						"pointId": 311400058
					}
				]
			},
			"dialogs": [
				{
					"id": 700500601,
					"content": "これを見て。どう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500602
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 700500602,
					"content": "茶釜だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500603
					]
				},
				{
					"id": 700500603,
					"content": "その通り！茶…茶なんだっけ？とにかく…風変わりよね！しかも、村のど真ん中に置かれてるのよ。きっと特別な意味があるんだわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500604
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 700500604,
					"content": "うーん…もしかして、玄文獣がその中に住んでたりとか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500605,
						700500606
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 700500605,
					"content": "それを書いたら、伝奇小説になっちゃうよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500607
					]
				},
				{
					"id": 700500607,
					"content": "それを書いたら、おまえの小説は仙人とかが出てくる感じになっちゃいそうだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500608
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700500608,
					"content": "そういうテーマの犯罪小説って、なんか…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500609
					]
				},
				{
					"id": 700500609,
					"content": "…おっ！あなたたちのその表情、いいわね。玄文獣をテーマに犯罪小説を書いたら、すごく「荒唐無稽」な事件になりそうだと思ったんでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500610
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 700500610,
					"content": "え？ま、まぁちょっとはそう思ったかな。とにかくさ、そんなテーマでストーリーが展開する犯罪小説なんてありえないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500611
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700500611,
					"content": "待って、まさか…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500612
					]
				},
				{
					"id": 700500612,
					"content": "#そう。鋭いわね、{NICKNAME}。さすがだわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500613
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 700500613,
					"content": "その通り。「ありえないほど荒唐無稽な事件」を描きたいの。洪分さんとあなたたちの反応がおもしろかったから、小説に書かせてもらうわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500614
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 700500614,
					"content": "玄文獣はね…私の構想では「犯罪者」なの。伝説では村の悪人を丸呑みにすると言われているのに、誰も本物の「玄文獣」を見たことがない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500615
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 700500615,
					"content": "ある祭日に、殺害された村人の遺体が郊外で見つかった。どうやら猛獣に襲われたらしい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500616
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 700500616,
					"content": "でも翌日の祝典の場で、主人公は死んだはずの被害者の姿を見かける。その後、また死亡者が出て…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500617
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 700500617,
					"content": "それで？その後は！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500618
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700500618,
					"content": "まだ考えてないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500619
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 700500619,
					"content": "…もう帰るね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500620
					]
				},
				{
					"id": 700500620,
					"content": "あっ、待ってよ。本を書き終えたら、必ずあなたたちに二冊贈呈するから。まだ大きな頼みごとが一つ残ってるの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500621
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 700500621,
					"content": "洪分さんが一人で村を出るなって、しつこく言ってたでしょう？私、ちゃんと忠告は聞き入れるつもりよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500622
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 700500622,
					"content": "でも今は…あなたたちがいる。つまり私は「一人きり」とは言えないし、これなら村の外を見物することもできる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500623
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 700500623,
					"content": "もちろん、そんなに遠くまで行く気はないわ。私の頼みを聞いてくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500624,
						700500625
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 700500624,
					"content": "いいよ…小説の結末を読むためなら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500627
					]
				},
				{
					"id": 700500627,
					"content": "じゃあ、まずはあっちに向かいましょう。行ってみたい場所があるの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 700500625,
					"content": "報酬は規定通り払ってもらうよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500626
					]
				},
				{
					"id": 700500626,
					"content": "それはもちろん。安心して！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500627
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 700500606,
					"content": "それが犯罪小説と何の関係があるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500607
					]
				}
			]
		},
		{
