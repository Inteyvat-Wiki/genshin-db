					}
				]
			},
			"dialogs": [
				{
					"id": 700501201,
					"content": "ギハーロ！なんでこんなとこにいるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700501202,
					"content": "…ううん、違う。急に手がかりが見つかるなんて唐突すぎる。それに一人で一晩中ここに縛られてるのに、考え事なんてできる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501203
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 700501203,
					"content": "うわぁ…完全に自分の世界に入っちゃってるぞ。重要なアイデアでも思いついたのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700501204,
					"content": "というより大きな壁にぶち当たったのかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501205
					]
				},
				{
					"id": 700501205,
					"content": "#…{NICKNAME}、パイモン、ちょうどいい所に来てくれた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501206
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 700501206,
					"content": "私を木の杭に縛りつけてくれない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501207
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 700501207,
					"content": "へ？オイラの聞き間違いか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700501208,
					"content": "お願い。両手を縛って、吊り上げる姿勢にして木からぶら下げてほしいの。うーん…まぁ同じ「木」なんだから、似たようなものになるはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501209
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 700501209,
					"content": "#{M#君}{F#あなた}の描く容疑者にはなりたくない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501210
					]
				},
				{
					"id": 700501210,
					"content": "安心して。免責同意書は記入済みよ。当期間に事故が生じた場合、一切の責任は私本人が負うってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501211
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 700501211,
					"content": "そういう問題じゃないぞ。なんで急に縛れなんて言うんだよ？別に罪も犯してないのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700501212,
					"content": "でも私の小説の主人公がここで村人に両手を縛り上げられて、屋外に一晩中放置されて「玄文獣」の審判を待つことになるのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501213
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 700501213,
					"content": "その後、この状況を事前に予期してた主人公がある手段を使って一命をとりとめ、無事に一夜を過ごし、すべての真相をあばくの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501214
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 700501214,
					"content": "…でも、私には一晩中縛られてる人がどんな感じか全然分からなくって。口調や考え方、どう動くのか…分からないことだらけ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501215
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 700501215,
					"content": "だから縛り上げて、ここに一晩放置してもらいたいの。そうすれば、その感覚を身をもって体験できるでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501216,
						700501217
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 700501216,
					"content": "ダメ。それは危険すぎる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501218
					]
				},
				{
					"id": 700501218,
					"content": "うーん。もう一つ手はあるわ。でもそのやり方では効果があるかどうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501219
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 700501219,
					"content": "その方法というのは、「両手を高く掲げた」姿勢でここに一晩中立ってるというものなんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501220
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 700501220,
					"content": "というかさ…その小説、書くのやめたほうがいいぞ。そんなことしてたら、他人にすぐ誤解されちゃうと思うぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501221
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700501221,
					"content": "#{M#君}{F#あなた}の小説の主人公は悲惨すぎる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501222
					]
				},
				{
					"id": 700501222,
					"content": "お願い！ここはすごく大事なポイントなの。それに小説は完成間近だし！このやり方なら、あなたたちも罪を犯すことにはならないから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501223
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 700501223,
					"content": "もとからやるつもりなんてないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501224
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700501224,
					"content": "最初からやるつもりないから！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501225
					]
				},
				{
					"id": 700501225,
					"content": "あっ…えっと、そんなに面倒なことじゃないのよ。ただ私のそばで見守ってくれたらいいだけ。取材の途中で誰かに連れていかれたり…野獣にさらわれたりしないように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501226
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 700501226,
					"content": "うーん、そうね…小説の雰囲気からすると、やっぱり一番上まで登るべきね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501227
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 700501227,
					"content": "え？ちょっと待てって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501228
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700501228,
					"content": "あなたたちはギハーロと一緒に茶畑の最上段まで登った…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700501229
					]
				},
				{
					"id": 700501229,
					"content": "ふぅ…ちょ、ちょっと寒いわね…でも、これこそがリアルな感じなのよね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501230
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 700501230,
					"content": "ほんとに両手を上げたまま、ここに一晩中立ってるつもりか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501231
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700501231,
					"content": "ええ、もう決めたことよ。小説の執筆にその程度の代償はつきものだから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501232
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 700501232,
					"content": "じゃあ、そばで見守っていてね。一晩だけでいいの…一晩だけで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 700501217,
					"content": "他に安全な方法はないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501218
					]
				}
			]
		},
