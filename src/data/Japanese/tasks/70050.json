					}
				]
			},
			"dialogs": [
				{
					"id": 700501001,
					"content": "ん？ギハーロは？さっきまでここにいたのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501002,
						700501003
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700501002,
					"content": "玄文獣がくわえて行ったのかな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501004
					]
				},
				{
					"id": 700501004,
					"content": "そんな怖い話するなってば！きっと小説のプロットを考えながら、あちこち走り回ってるんじゃないか。近くを捜してみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501005
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700501005,
					"content": "そこの高くなってる茶畑から捜そうか。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501006
					]
				},
				{
					"id": 700501006,
					"content": "手始めに高いとこを捜すんだな。よし、そうしよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700501003,
					"content": "彼女の書いた小説が現実になったとか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501004
					]
				}
			]
		},
		{
			"id": 7005012,
			"completionStepIds": [
				7005012
			],
