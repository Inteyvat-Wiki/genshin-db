			"dialogs": [
				{
					"id": 700501501,
					"content": "…こんな状態では、主人公の彼は一人で村に帰れないはず…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501502
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 700501502,
					"content": "ギハーロ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700501503,
					"content": "ひとまず彼女を起こしてあげよう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501504
					]
				},
				{
					"id": 700501504,
					"content": "ギハーロを起こし、しっかり地面に座らせた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700501505
					]
				},
				{
					"id": 700501505,
					"content": "こんな感覚だったのね…とても辛かったわ。体も疲れたし、頭も回らなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501506
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 700501506,
					"content": "取材は成功だったってこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501507
					]
				},
				{
					"id": 700501507,
					"content": "もちろん。取材は大成功よ。縛られて野外で一晩吊るされるのがどんな感覚かやっと分かったわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501508
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 700501508,
					"content": "おまえの小説の主人公って、めちゃくちゃ根性があるんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501509
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700501509,
					"content": "そうよ。主人公が「玄文獣」を追い払う方法もすでに考えてあってね。それで物語を終わらせれば、きっと…きっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501510
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 700501510,
					"content": "おお！なんかすっごい方法なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501511
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700501511,
					"content": "きっと…いいと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501512
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 700501512,
					"content": "ギハーロはまたぐたりと地面に倒れ込んだ…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700501513
					]
				},
				{
					"id": 700501513,
					"content": "うわぁ！ギハーロ、おいっ…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501514
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700501514,
					"content": "どんな方法か話してから倒れてよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501515
					]
				},
				{
					"id": 700501515,
					"content": "と、とにかくお医者さんに診せないと…村に連れて行こうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501516
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700501516,
					"content": "やっぱり洪分の言う通りだったな。ギハーロは翹英荘を出るべきじゃなかったんだ…",
					"roleType": "TALK_ROLE_NPC",
