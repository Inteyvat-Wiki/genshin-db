			"dialogs": [
				{
					"id": 700500801,
					"content": "これは「提灯」？お魚の提灯みたいね。おもしろいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500802
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 700500802,
					"content": "この持ち手は、提灯を持ち上げるために使うのかしら？うーん…こういう取り外し式の構造だと、デザインとしておかしくなければ、こっそり長さを足しても誰にもバレない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500803
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 700500803,
					"content": "中のスペースも広いし、簡単に物を入れられる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500804
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 700500804,
					"content": "ストップ！アイデアは心の中に留めて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500805
					]
				},
				{
					"id": 700500805,
					"content": "え？あ…ああ！アハハッ、おもしろいものを見ると、つい考えてることが口から出ちゃって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500806
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 700500806,
					"content": "「提灯」という要素を足せば、小説によりリアリティが出せると思うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500807
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 700500807,
					"content": "#{NICKNAME}、そこの大きな「魚灯籠」を撮影してくれない？参考用に写真が欲しいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500808,
						700500809
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 700500808,
					"content": "#{M#俺}{F#私}の撮影技術がまた上達しちゃうね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500810
					]
				},
				{
					"id": 700500810,
					"content": "それじゃ撮影よろしくね…そうそう、撮る時は提灯の全体を映してちょうだい。それが私にとってはすごく大事だから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500811
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 700500811,
					"content": "…「サイズ」という要素をうまく活用してトリックを作ると、おもしろいかも。うーん、でも重さの問題はどうやって解決しようかしら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 700500809,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500810
					]
				}
			]
		},
		{
