			"dialogs": [
				{
					"id": 210230201,
					"content": "早く階段を直さないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230202
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210230202,
					"content": "支配人だよね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210230203
					]
				},
				{
					"id": 210230203,
					"content": "ええ、何かご用でも？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230204
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210230204,
					"content": "支配人宛の荷物があるんだ、下の人に渡すように言われたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 210230205,
					"content": "おや…これは客商が私に宛てた荷物のようですね…どうして彼は自分で来ないのでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230206
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210230206,
					"content": "荷物の受け入れ？ハハッ、きっと面倒くさがってるだけでしょうね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230207
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210230207,
					"content": "すみませんね、せっかくお客様がいらしたのに、階段が壊れたままだなんて、どう修理するか思案しているところなんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230208
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210230208,
					"content": "荷物の件もありがとうございます。これは報酬です、どうかお受け取りください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230209
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210230209,
					"content": "本当は彼のために用意したものですが、彼があなたにお願いしたわけですから、この報酬はあなたが受け取って当然です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230210
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210230210,
					"content": "さて、私も階段の修理の準備をしませんと。どうぞ自由に旅館を回っていいですから、何かあったらいつでも言ってください",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "淮安"
				}
			]
		}
	]
