			"dialogs": [
				{
					"id": 6080101,
					"content": "ふぅ、風花祭中にこんなにビリビリしたのは久しぶりだわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080102
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 6080102,
					"content": "師匠、昔はよくやってた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080103
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 6080103,
					"content": "ビリビリを？そんなわけないでしょう？ふふっ…まあ、たま～によ。いいストレス発散になるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080104
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 6080104,
					"content": "そういえばこの間、先生の手紙でも同じことを聞かれたわ。「優しいおもてなし」を心掛けてるって返事したけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080105
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 6080105,
					"content": "生徒が先生のやり方を真似るのはよくあることでしょう？あの人は素論派の心優しい教授だから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080106
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 6080106,
					"content": "今回だって、優しくビリビリさせたのよ。ジンがこの場にいても、止めなかったと思うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080107
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 6080107,
					"content": "優しくビリビリ、そんなことできるのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080108
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 6080108,
					"content": "リサ、元気そうで良かったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080109
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 6080109,
					"content": "ええ。だって身体を動かすのは健康にいいでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リサ"
				}
			]
