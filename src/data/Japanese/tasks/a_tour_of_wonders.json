				"points": []
			},
			"dialogs": [
				{
					"id": 705310101,
					"content": "先輩っ！ちょっと待ってください！先輩も「召喚王グランプリ」に参加しにいらっしゃったんですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310102
					],
					"speakerTitle": "オンネア"
				},
				{
					"id": 705310102,
					"content": "もしお時間があるようでしたら、冒険者協会主催の「諸景巡行」についてご紹介してもいいですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310103,
						705310104
					],
					"speakerTitle": "オンネア"
				},
				{
					"id": 705310103,
					"content": "えっと、時間ならあるけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705310105
					]
				},
				{
					"id": 705310105,
					"content": "ありがとうございます！じゃあ、今回協会で開催する「諸景巡行」について簡単にご紹介しますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310106
					],
					"speakerTitle": "オンネア"
				},
				{
					"id": 705310106,
					"content": "簡単に言うと、冒険者協会はモンド各地に数多くの「巡景台」を設置したんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310107
					],
					"speakerTitle": "オンネア"
				},
				{
					"id": 705310107,
					"content": "先輩はそれらの「巡景台」を見つけて、台上に置いてある記念スタンプを、協会の配布した「巡景ノート」に押してください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310108
					],
					"speakerTitle": "オンネア"
				},
				{
					"id": 705310108,
					"content": "すべての「巡景台」を見つけて、記念スタンプをぜんぶ集めれば…挑戦成功です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310109
					],
					"speakerTitle": "オンネア"
				},
				{
					"id": 705310109,
					"content": "冒険者協会らしいイベントだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705310110
					]
				},
				{
					"id": 705310110,
					"content": "へへ…「巡景台」の設置場所についても、協会でじっくり検討したんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310111
					],
					"speakerTitle": "オンネア"
				},
				{
					"id": 705310111,
					"content": "まあ…一部の「巡景台」はちょっと辺鄙なところに設置されているので、その周辺には魔物が出るかもしれませんけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310112
					],
					"speakerTitle": "オンネア"
				},
				{
					"id": 705310112,
					"content": "でも、先輩の腕前なら、そんな魔物たちなんて楽勝でしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310113
					],
					"speakerTitle": "オンネア"
				},
				{
					"id": 705310113,
					"content": "では、早速「巡景ノート」をお渡ししますね。どうぞお楽しみください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "オンネア"
				},
				{
					"id": 705310104,
					"content": "先に内容を言って…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705310105
					]
				}
			]
		}
	]
}