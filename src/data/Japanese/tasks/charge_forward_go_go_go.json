			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"マターガ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750290201,
					"content": "素晴らしい！お前は俺を超えた。最高だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290202
					],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750290202,
					"content": "俺がここで一人で特訓しているのも、自分自身の記録を打ち破るためだ。残念ながら一度も達成していないがな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290203
					],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750290203,
					"content": "だが、お前は見事成し遂げた。俺もそろそろ世界に出るべきなのかもな。外には、俺よりはるかに優秀な勇士が多くいるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290204
					],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750290204,
					"content": "彼らと切磋琢磨してもっと腕を上げれば、いつかきっと父さんや姉さんにも認めてもらえるはずだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290205
					],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750290205,
					"content": "アコミトはどうでもいいがな。志のないあいつと兄弟だなんて、恥ずかしい限りだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290206
					],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750290206,
					"content": "アコミト…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290207
					]
				},
				{
					"id": 750290207,
					"content": "いや、何でもない、無駄話はここまでだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290208
					],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750290208,
					"content": "勇士よ、これからも自分を磨き続けたまえ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290209
					],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750290209,
					"content": "全力で前へ突き進む者だけが、レジェンドになれる！——これが俺からお前へのはなむけの言葉だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マターガ"
				}
			]
		},
		{
			"id": 7502905,
			"completionStepIds": [
				7502904,
				7502906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
