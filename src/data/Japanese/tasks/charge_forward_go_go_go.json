			"dialogs": [
				{
					"id": 750290101,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290102,
						750290103
					],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750290102,
					"content": "こんにちは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290104
					]
				},
				{
					"id": 750290104,
					"content": "ふははははっ！！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290105
					],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750290105,
					"content": "うわっ——び、びっくりしたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750290106,
					"content": "ここに来たってことは、お前らも特訓に参加したいんだな！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290107
					],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750290107,
					"content": "人であれ竜であれ、向上心ある勇士はひかれ合うものだからな！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290108
					],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750290108,
					"content": "時間を無駄にしたくない。さっそく特訓開始だ！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290109,
						750290110
					],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750290109,
					"content": "やっぱりここにも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290111
					]
				},
				{
					"id": 750290111,
					"content": "オイラたち、まだなにも言ってないぞ。いきなり特訓ってなんの話だよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750290112,
					"content": "そんなこと言い出すってことは…もしかしてトレーニングマスターなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750290113,
					"content": "トレーニングマスターなんて、誰でもなれるわけじゃない。俺はそこまですごくない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290114
					],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750290114,
					"content": "でも、お前ら下から一気に登ってきただろ？俺の勇士特訓に参加するためじゃないのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290115,
						750290116
					],
					"speakerTitle": "マターガ",
					"speakerSubtitle": "「花翼の集」の戦士見習い"
				},
				{
					"id": 750290115,
					"content": "たまたま通っただけ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290117
					]
				},
				{
					"id": 750290117,
					"content": "竜を操る能力があるのに向上心がないなんて…宝の持ち腐れだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290118
					],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750290118,
					"content": "同じ志を持つ勇士だと思ったのに…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290119
					],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750290119,
					"content": "俺の判断が甘かった…なんて恥だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290120
					],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750290120,
					"content": "英雄の国「ナタ」って言うだけあって、みんな熱血だな。子供までこんな調子だなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290121,
						750290122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750290121,
					"content": "大げさだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290123
					]
				},
				{
					"id": 750290123,
					"content": "違う！勇士を目指す者は怠惰に陥ってはならない！気迫と度胸、志のない人は絶対に大成しないんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290124
					],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750290124,
					"content": "それに俺はもう十二歳だ。齢二桁に突入した時から、「子供」なんて卒業した。でも、さっきの発言は許してやる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290125
					],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750290125,
					"content": "牛乳を飲んでも身長こそ伸びなかったが——俺の意志は、折れず曲がらず、どんな障害をも打ち砕く！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290126
					],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750290126,
					"content": "身長だって、そのうち伸びるさ。お前らも別に背が高いわけじゃないしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290127
					],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750290127,
					"content": "あ、熱いやつだな…でもなんで突然こっちに火の粉を飛ばしてくるんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750290128,
					"content": "フンッ！肉体の力が体型に影響されるのは事実だが、勇士たる者、そんな制限…造作もない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290129
					],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750290129,
					"content": "精神は肉体を超える。強い信念を持ち、夢に向かって進む自分を信じるべきだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290130
					],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750290130,
					"content": "俺の言ってることの意味は、冒険者のお前らでもわかるだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290131
					],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750290131,
					"content": "言ってることはもっともなんだけどさ、なんかこいつ…オイラたちのこと見下してないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290132,
						750290133
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750290132,
					"content": "同感。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290134
					]
				},
				{
					"id": 750290134,
					"content": "怠惰なお前らに志の重要性を説明してるんだ。お前らみたいに緊張感のないやつが、英雄になれるわけがない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290135
					],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750290135,
					"content": "勇士として、いや…人間として、高い志を胸に訓練場で汗を流さない人生なんて、失敗だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290136
					],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750290136,
					"content": "勇敢に空を飛べない人生もトレーニングマスターに認められない人生も、失敗そのものだ！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290137
					],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750290137,
					"content": "だから訓練を頑張るんだ！分かったか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290138
					],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750290138,
					"content": "わ、わかったって！うぅ…こいつ、声はでっかいし、完全に間違ったことを言ってるわけでもないし、ぜんぜん言い返せないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290139
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750290139,
					"content": "よろしい。特訓を受ける気になったら、俺のところに来てくれ！ミッションは、竜に乗って指定のコースを駆け、できるだけ高い得点を取ることだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290140
					],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750290140,
					"content": "俺は、参加者のパフォーマンスを各チェックポイントから観察して採点する。最終得点は4つのランクに分けられる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290141
					],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750290141,
					"content": "頑張れ！最高ランクは無理でも、せめてその次のランクを取るんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290142
					],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750290142,
					"content": "燃える意志で俺の影を追え！前へ突き進むんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290143
					],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750290143,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290144
					],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750290144,
					"content": "返事は！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290145,
						750290150
					],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750290145,
					"content": "は、はい！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290146
					]
				},
				{
					"id": 750290146,
					"content": "声が小さい！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290147
					],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750290147,
					"content": "はい！！！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290148
					]
				},
				{
					"id": 750290148,
					"content": "ここは志を持つ未来の勇士たちが自分を磨く場所だ。自分を奮い立たせ、世界に向かって挑戦しろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290149
					],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750290149,
					"content": "特訓を受ける準備ができたら、俺のところに来てくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750290150,
					"content": "はい！でも訓練は嫌です！！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290151
					]
				},
				{
					"id": 750290151,
					"content": "何だと！？これだけ説いてもなお、惰性で生きていくのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290152
					],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750290152,
					"content": "実に深刻だ。だがまいつか情けない自分に耐えられなくなる時が来るぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290153
					],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750290153,
					"content": "怖気づいて逃げてばかりいたら、何も掴めやしない！前へ突き進む者だけに笑う資格があるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290154
					],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750290154,
					"content": "いいか、俺の言葉をしっかり胸に刻んでおけ。自分を磨く気になってからでも遅くない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750290133,
					"content": "ひどい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290134
					]
				},
				{
					"id": 750290122,
					"content": "極端的だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290123
					]
				},
				{
					"id": 750290116,
					"content": "好奇心旺盛な冒険者だから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290117
					]
				},
				{
					"id": 750290110,
					"content": "どんな特訓？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290111
					]
				},
				{
					"id": 750290103,
					"content": "こんにちは。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290104
					]
				}
			]
		},
		{
			"id": 7502902,
			"completionStepIds": [
				7502904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
