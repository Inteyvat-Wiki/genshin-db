			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"マターガ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750290501,
					"content": "勇士よ！このコースの手応えはどうだった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290502,
						750290504
					],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750290502,
					"content": "前よりうまくできた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290503
					]
				},
				{
					"id": 750290503,
					"content": "当たり前だ！うまくならなくてどうする！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290506
					],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750290506,
					"content": "なんていうか…マターガの辞書には「突き進め」とか「努力を怠るな」とかしか載ってないみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290507
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750290507,
					"content": "その通り。俺の辞書は人より薄い！なぜなら、奮闘と努力以外のことは一切認めないからだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290508
					],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750290508,
					"content": "お前たちはもっと訓練が必要だ。俺だってそうだ。竜と一緒に飛べるだけでは、万能の勇士とは言えないからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290509
					],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750290509,
					"content": "俺はもっと大きな舞台で自分を磨かなければならない！だから、しばらくここを離れるつもりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290510
					],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750290510,
					"content": "安心しろ！コースはそのまま残してやる。この飛行台は解体して持っていくけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290511,
						750290513
					],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750290511,
					"content": "どこに行くつもり？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290512
					]
				},
				{
					"id": 750290512,
					"content": "そうだな…父さんと姉さんにでも会いに行こうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290515
					],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750290515,
					"content": "あれ？急にしおらしくなったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290516
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750290516,
					"content": "何か文句があるのか！家族を大事にし、尊重するのも勇士の美徳だ！なんとも幼稚な発言だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290517
					],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750290517,
					"content": "俺の父さんは部族屈指のトレーニングマスターで、姉さんは最強の竜騎士だ！俺は二人を誇りに思っている！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290518
					],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750290518,
					"content": "わかったって。別にからかったわけじゃないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290519
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750290519,
					"content": "これからも頑張ってね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290520
					]
				},
				{
					"id": 750290520,
					"content": "ああ、お前もな！もう一つ、はなむけの言葉を贈ってやろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290521
					],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750290521,
					"content": "…諦めず、血と涙を惜しまず、努力して英雄になれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750290513,
					"content": "どんな訓練をするの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290514
					]
				},
				{
					"id": 750290514,
					"content": "そうだな…まずは父さんと姉さんの意見を聞いてみるか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290515
					],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750290504,
					"content": "最近あまり練習する時間がなくて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290505
					]
				},
				{
					"id": 750290505,
					"content": "この怠け者が！ボーっと過ごして人生を無駄にしたのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290506
					],
					"speakerTitle": "マターガ"
				}
			]
		},
