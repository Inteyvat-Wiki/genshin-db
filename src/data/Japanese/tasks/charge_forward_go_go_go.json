						750290602
					],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750290602,
					"content": "——なんて、言うと思ったか？勘違いするな。偉大な勇士の辞書に「悪くない」とか「まあまあ」なんて言葉はない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290603
					],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750290603,
					"content": "あるのは「最高」のみ！これに達しないものはすべて失敗だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290604
					],
					"speakerTitle": "マターガ"
				},
				{
					"id": 750290604,
					"content": "勇気を振り絞って挑み続けろ！俺を超えるまでな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マターガ"
				}
			]
		},
