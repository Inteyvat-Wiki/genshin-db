			},
			"dialogs": [
				{
					"id": 750291301,
					"content": "召竜台、開放中。マターガの特訓への参加を希望する人、または竜は召竜台までお越しください。いついかなる時も、決して努力を怠るべからず！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750291302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750291302,
					"content": "今日頑張らないと、明日は飯抜きだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750291303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750291303,
					"content": "前へ突き進み、竜の如く飛べ！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
