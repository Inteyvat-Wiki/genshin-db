				]
			},
			"dialogs": [
				{
					"id": 760100601,
					"content": "ねえ、今の…見たかい！？何が起こったのか分からないけど、ぼうっとしてたらいきなり大きな石が飛んでいったんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100602
					],
					"speakerTitle": "ペカニー"
				},
				{
					"id": 760100602,
					"content": "前にあったことを話した…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760100603
					]
				},
				{
					"id": 760100603,
					"content": "へえ！何が起きているのかは分からないけど、そんな奇跡が起きるということは…君たちは月の{RUBY#[D]クータル}少女に愛されし人ということだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100604
					],
					"speakerTitle": "ペカニー"
				},
				{
					"id": 760100604,
					"content": "月神様、月神様…どうかご加護を！よし…これで今日はきっと大漁のはずだ！ あの鬱陶しい吟遊詩人がペットを連れて歌い出さない限りは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100605
					],
					"speakerTitle": "ペカニー"
				},
				{
					"id": 760100605,
					"content": "さあ、約束の報酬だ！魚はまったく釣れないけど、それ以外の小物なら結構かかってるんだ。中にはきっと価値のあるものも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100606
					],
					"speakerTitle": "ペカニー"
				},
				{
					"id": 760100606,
					"content": "まあ、ヒーシ島でモラは役に立たないし、全部君たちにあげよう。これからは一人でゆったりと釣りをさせてもらうよ。この度はありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ペカニー"
				}
			]
		}
	]
