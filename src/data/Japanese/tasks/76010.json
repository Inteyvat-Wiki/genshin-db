			"dialogs": [
				{
					"id": 760100201,
					"content": "二十五、二十六…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100202
					],
					"speakerTitle": "ペカニー"
				},
				{
					"id": 760100202,
					"content": "なにを数えてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760100203,
					"content": "シッ…！静かに…はぁ、まあいいか。どっちみち釣れなかったし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100204
					],
					"speakerTitle": "ペカニー"
				},
				{
					"id": 760100204,
					"content": "見ればわかるだろう？釣りの時間を計ってるんだ。そうじゃなければ釣り竿で何をしてると思ったんだい？まじないかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100205,
						760100207
					],
					"speakerTitle": "ペカニー"
				},
				{
					"id": 760100205,
					"content": "霜月の子の人ならあり得るかも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760100206
					]
				},
				{
					"id": 760100206,
					"content": "過大評価しすぎだよ。僕はせいぜい半分霜月の子の人間ってとこだし、侍祭のはしくれでもない。要するにクーヴァキを使えない凡人さ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100210
					],
					"speakerTitle": "ペカニー"
				},
				{
					"id": 760100210,
					"content": "まあそんなことはいいや。釣りで秒数を気にするやつなんて初めて見たぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760100211,
					"content": "ああ、重要なのは釣りの技術であって、岸に立っている時間の長さじゃない。イルマリ爺さんはそこを理解していないから、まったく魚が釣れないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100212
					],
					"speakerTitle": "ペカニー"
				},
				{
					"id": 760100212,
					"content": "ん？そういえば君たちはトレジャーハンターかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100213
					],
					"speakerTitle": "ペカニー"
				},
				{
					"id": 760100213,
					"content": "違うぞ。オイラたちは冒険者で…えっ、もしかしてなにかさせるつもりか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760100214,
					"content": "トレジャーハンターでも冒険者でも、報酬を受け取って仕事をしてくれるなら誰だって構わないよ。もし時間があったら、ちょっと手伝ってほしいことがあるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100215
					],
					"speakerTitle": "ペカニー"
				},
				{
					"id": 760100215,
					"content": "見てのとおり、僕の釣りの腕前はヒーシ島で一番なんだ。歴代の詠月使でさえも、釣りに関して僕の右に出る者はいない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100216
					],
					"speakerTitle": "ペカニー"
				},
				{
					"id": 760100216,
					"content": "そ、そうなのか？そりゃすごい…って、あれ？よく考えたら別にすごくないよな。詠月使の本業は釣りじゃないし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100217
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760100217,
					"content": "ところが、僕はこんなにすごいのに最近全然魚が釣れないんだよ！どうしてだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100218
					],
					"speakerTitle": "ペカニー"
				},
				{
					"id": 760100218,
					"content": "明らかに原因は僕じゃなく、環境にある。呪われたケラティの眼と同じで、ここの水中には魚群に影響を与える何かがあるに違いないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100219
					],
					"speakerTitle": "ペカニー"
				},
				{
					"id": 760100219,
					"content": "よ、よくわからない推測だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100220
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760100220,
					"content": "そこで、君たちにはこの辺りの水域を調査して、いったい何が魚がかかるのを邪魔しているのかを調査してほしいんだ。報酬はしっかり用意するから安心してくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100221
					],
					"speakerTitle": "ペカニー"
				},
				{
					"id": 760100221,
					"content": "まあ、報酬をくれるって言うなら見てみるけど…でも、変なものが見つかるかどうかまでは保証できないからな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760100207,
					"content": "もしかして最高の仲間を探してるとか…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760100208
					]
				},
				{
					"id": 760100208,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100209
					],
					"speakerTitle": "ペカニー"
				},
				{
					"id": 760100209,
					"content": "いや、誰でも釣りで最高の仲間を釣れるってわけじゃ…って、そういう問題じゃないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100210
					],
					"speakerTitle": "パイモン"
				}
			]
		},
