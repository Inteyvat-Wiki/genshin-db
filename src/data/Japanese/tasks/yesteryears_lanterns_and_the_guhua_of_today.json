			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"シニャク"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413370701,
					"content": "ある時、霄灯を飛ばそうとしていたら、血気盛んな兄弟子から勝負を申し込まれたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370702
					],
					"speakerTitle": "シニャク"
				},
				{
					"id": 413370702,
					"content": "私が返事をする間もなく、姉妹弟子がその兄弟子の足元に水をかけました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370703
					],
					"speakerTitle": "シニャク"
				},
				{
					"id": 413370703,
					"content": "その水で地面が滑って、兄弟子が剣を出す前に、お尻から転んでしまって…それがおかしくて笑っていたら、私も転んでしまったのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370704
					],
					"speakerTitle": "シニャク"
				},
				{
					"id": 413370704,
					"content": "その兄弟子は怒るどころか、私を指してゲラゲラと笑い始めて…結局、周りにいたみんなもつられて大笑いしていました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370705
					],
					"speakerTitle": "シニャク"
				},
				{
					"id": 413370705,
					"content": "その兄弟子が今どこにいるのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シニャク"
				}
			]
		},
		{
			"id": 4133708,
			"completionStepIds": [
				4133714
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4133714",
