			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"シニャク"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413370801,
					"content": "以前は私も希望を持っていました。新しく古華派に入った少年が、才能と気質に溢れていて、門派を立て直すことのできる逸材だったのですが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370802
					],
					"speakerTitle": "シニャク"
				},
				{
					"id": 413370802,
					"content": "今はどこにいるのか分かりません…結局、門派を立て直すことを他人に背負わせてはいけませんね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370803
					],
					"speakerTitle": "シニャク"
				},
				{
					"id": 413370803,
					"content": "ですので、彼の気の向くままにさせた方がいいと思ったのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シニャク"
				}
			]
		},
		{
			"id": 4133709,
			"completionStepIds": [
				4133715
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
