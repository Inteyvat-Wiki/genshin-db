				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"シニャク"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413370601,
					"content": "あなたたちは…霄灯を飛ばしに来たのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370602
					],
					"speakerTitle": "シニャク"
				},
				{
					"id": 413370602,
					"content": "霄灯を飛ばすこの場所を知っているのは、古華派の弟子しかいませんが、あなたたちに印象はありません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370603
					],
					"speakerTitle": "シニャク"
				},
				{
					"id": 413370603,
					"content": "頼まれて来た。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370604
					]
				},
				{
					"id": 413370604,
					"content": "まだここを覚えている古華派の人がいたのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370605
					],
					"speakerTitle": "シニャク"
				},
				{
					"id": 413370605,
					"content": "私がここに来た時は周囲に誰もいなくて、すこし寂しく思いましたが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370606
					],
					"speakerTitle": "シニャク"
				},
				{
					"id": 413370606,
					"content": "まだここを覚えてくれている人がいると分かって、少しほっとしました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370607
					],
					"speakerTitle": "シニャク"
				},
				{
					"id": 413370607,
					"content": "以前の古華派はここで霄灯を？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370608
					]
				},
				{
					"id": 413370608,
					"content": "はい…あの頃はいつも、霄灯を作ってから、師匠の後ろについてここに来ていたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370609
					],
					"speakerTitle": "シニャク"
				},
				{
					"id": 413370609,
					"content": "あの頃は…山に霄灯がずらりと並んでいて、とても綺麗でした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370610
					],
					"speakerTitle": "シニャク"
				},
				{
					"id": 413370610,
					"content": "それが今は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370611
					],
					"speakerTitle": "シニャク"
				},
				{
					"id": 413370611,
					"content": "…昔の事はさておき、急いでいないのなら、歩きながら少し話をしましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シニャク"
				}
			]
		},
		{
			"id": 4133707,
			"completionStepIds": [
				4133713
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4133713",
