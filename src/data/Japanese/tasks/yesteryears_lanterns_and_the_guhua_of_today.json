					"nextDialogs": [
						413371003
					]
				},
				{
					"id": 413371003,
					"content": "なるほど、シニャク…覚えているよ。あの頃は彼女にお世話になったこともある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371004
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 413371004,
					"content": "彼女も古華派を覚えていたのか…それはよかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371005
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 413371005,
					"content": "小鳥について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413371006
					]
				},
				{
					"id": 413371006,
					"content": "あぁ、小鳥は頭痛が治ったらしい。さっきは山風のせいかもしれない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371007
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 413371007,
					"content": "兄さん、さっき言ってた「シニャク」って人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371008
					],
					"speakerTitle": "小鳥"
				},
				{
					"id": 413371008,
					"content": "古華派の姉弟子なの？綺麗？兄さんと仲いいの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371009
					],
					"speakerTitle": "小鳥"
				},
				{
					"id": 413371009,
					"content": "えっと…仲いいとまではいかないが、シニャクは傷薬を作るのが得意だったんだ。だから、傷を治すためによく彼女のところに行っていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371010
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 413371010,
					"content": "はははっ、そういえば、古華派の中で彼女を好きな人は結構いたな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371011
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 413371011,
					"content": "兄さんは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371012
					],
					"speakerTitle": "小鳥"
				},
				{
					"id": 413371012,
					"content": "あっ…あ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371013
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 413371013,
					"content": "兄さんとそのシニャクっていう姉弟子は何の関係だったの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371014
					],
					"speakerTitle": "小鳥"
				},
				{
					"id": 413371014,
					"content": "その…別にそこまで親しくもなかったかな、うん…同じ門派の同志だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371015
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 413371015,
					"content": "そっか…じゃあ兄さんと私の関係は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371016
					],
					"speakerTitle": "小鳥"
				},
				{
					"id": 413371016,
					"content": "はははっ、もちろん同じ門派の同志さ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371017
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 413371017,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371018
					],
					"speakerTitle": "小鳥"
				},
				{
					"id": 413371018,
					"content": "小鳥？小鳥…ど…どうしたんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孫宇"
				}
