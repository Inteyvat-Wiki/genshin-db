			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"孫宇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413370401,
					"content": "ありがとう、これで立派な霄灯が作れるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370402
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 413370402,
					"content": "霄灯ができた。小鳥、願い事を書くといい、君の字はとても綺麗だから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370403
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 413370403,
					"content": "はいはい、書けばいいんでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370404
					],
					"speakerTitle": "小鳥"
				},
				{
					"id": 413370404,
					"content": "小鳥…なんだか…不機嫌じゃないか？どうしたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370405
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 413370405,
					"content": "別に、不機嫌じゃないわ。兄さんのために霄灯を飛ばせて、嬉しくてしょうがないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370406,
						413370407
					],
					"speakerTitle": "小鳥"
				},
				{
					"id": 413370406,
					"content": "ゴホンッ…どこで飛ばす？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370408
					]
				},
				{
					"id": 413370408,
					"content": "あぁ、君の言った通りだ。もう霄灯を飛ばす準備をしないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370409
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 413370409,
					"content": "じゃあ、兄さん自分で行ってきて。私は山登りで疲れたから…やりたくないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370410
					],
					"speakerTitle": "小鳥"
				},
				{
					"id": 413370410,
					"content": "そんな…さっきここで休憩したじゃないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370411
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 413370411,
					"content": "頭も痛いの。山風に吹かれたせいかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370412
					],
					"speakerTitle": "小鳥"
				},
				{
					"id": 413370412,
					"content": "あ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370413,
						413370414
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 413370413,
					"content": "…飛ばすのを手伝うよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370415
					]
				},
				{
					"id": 413370415,
					"content": "…はぁ…何度もすまないね。今日は特別な場所で飛ばそうと思っていたんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370416
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 413370416,
					"content": "まだ古華派が…あった頃、いつも海灯祭になると、師匠が私たちをその場所に連れていって、皆で灯を飛ばしてたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370417
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 413370417,
					"content": "今は落ちぶれて、あの場所も、もう古華派の人が霄灯を飛ばすことはない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370418
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 413370418,
					"content": "もし手伝ってくれるというのなら、私たちの代わりにそこで霄灯を飛ばしてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370419
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 413370419,
					"content": "今場所を教えるよ。私は妹弟子の面倒を見る…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孫宇"
				},
				{
					"id": 413370414,
					"content": "手伝う！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370415
					]
				},
				{
					"id": 413370407,
					"content": "ゴホンッ…そろそろ飛ばさないと。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370408
					]
				}
			]
		},
		{
			"id": 4133706,
			"completionStepIds": [
				4133706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
