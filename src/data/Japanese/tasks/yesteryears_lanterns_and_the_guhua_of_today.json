			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"シニャク"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413370901,
					"content": "私が古華派を抜けた時、もう門派の弟子はほとんど残っていませんでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370902
					],
					"speakerTitle": "シニャク"
				},
				{
					"id": 413370902,
					"content": "師匠は私を責めることなく、ちゃんとした生活を送りなさいとだけ言ってくれました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370903
					],
					"speakerTitle": "シニャク"
				},
				{
					"id": 413370903,
					"content": "しかし、今の生活がちゃんとしたものかどうか私にも分からないのです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370904
					],
					"speakerTitle": "シニャク"
				},
				{
					"id": 413370904,
					"content": "もしかすると、今の私はただその日暮らしをしているだけなのかもしれません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370905
					],
					"speakerTitle": "シニャク"
				},
				{
					"id": 413370905,
					"content": "そういえば、孫宇という古華派の弟子が門派の復興を試みていると聞きました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370906
					],
					"speakerTitle": "シニャク"
				},
				{
					"id": 413370906,
					"content": "私も彼のように勇気があれば…よかったのですが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370907
					],
					"speakerTitle": "シニャク"
				},
				{
					"id": 413370907,
					"content": "すみません。一人でこんなにも喋ってしまって。久しぶりに外に出たので、ついたくさん話してしまいました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370908
					],
					"speakerTitle": "シニャク"
				},
				{
					"id": 413370908,
					"content": "落ち込んでいるように見える。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370909
					]
				},
				{
					"id": 413370909,
					"content": "だ、大丈夫です。毎年この祭りになると、昔を思い出して…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370910
					],
					"speakerTitle": "シニャク"
				},
				{
					"id": 413370910,
					"content": "そろそろ時間も遅くなってきたので、ここで。海灯祭を楽しんでください。霄灯を飛ばすことをあなたに頼んだ人にも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370911
					],
					"speakerTitle": "シニャク"
				},
				{
					"id": 413370911,
					"content": "その人にも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370912
					],
					"speakerTitle": "シニャク"
				},
				{
					"id": 413370912,
					"content": "その…海灯祭を楽しんでと伝えてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370913
					],
					"speakerTitle": "シニャク"
				},
				{
					"id": 413370913,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYSECOND|INFO_FEMALE_PRONOUN_GIRLSECOND]}も海灯祭を楽しんで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370914
					]
				},
				{
					"id": 413370914,
					"content": "はい、ありがとうございます。お気を付けて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シニャク"
				}
			]
		},
