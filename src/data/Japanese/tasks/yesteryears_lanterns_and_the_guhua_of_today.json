			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"孫宇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413370201,
					"content": "この近くで霄灯を飛ばせば、仙人にも届くかな？でも材料が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370202
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 413370202,
					"content": "なにしてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370203
					]
				},
				{
					"id": 413370203,
					"content": "失礼、今妹弟子と霄灯のことについて考えてたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370204
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 413370204,
					"content": "でも、今手元にある霄灯の材料が足りなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370205
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 413370205,
					"content": "もしよかったらだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370206
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 413370206,
					"content": "古華派古華派、いつも古華派…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370207
					],
					"speakerTitle": "小鳥"
				},
				{
					"id": 413370207,
					"content": "せっかくの海灯祭なのに、願い事まで古華派…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370208
					],
					"speakerTitle": "小鳥"
				},
				{
					"id": 413370208,
					"content": "私たちは古華派の人間だ…古華派を復興するのは、当然の責務だろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370209
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 413370209,
					"content": "はいはい、兄さんが言うなら別に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370210
					],
					"speakerTitle": "小鳥"
				},
				{
					"id": 413370210,
					"content": "はぁ…そこの旅人、もしよかったら、霄灯の材料を探してきてくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370211,
						413370213
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 413370211,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370212
					]
				},
				{
					"id": 413370212,
					"content": "本当にありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370216
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 413370216,
					"content": "ゴホンッ…さっき確認したんだが、清心が1つ足りない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370217
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 413370217,
					"content": "以前採った物は時間が経ちすぎて、もう使えなくなってしまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370218
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 413370218,
					"content": "霄灯を作るのに清心がいるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370219
					]
				},
				{
					"id": 413370219,
					"content": "ははっ、以前古華派の弟弟子や妹弟子たちと一緒にふざけた時に考えた方法なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370220
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 413370220,
					"content": "霄灯に花の香りをつけるのも、中々悪くない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370221
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 413370221,
					"content": "私はここで待ってるから、材料を見つけてきてくれ、頼んだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孫宇"
				},
				{
					"id": 413370213,
					"content": "妹弟子が何か言いたそうだけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370214
					]
				},
				{
					"id": 413370214,
					"content": "なんでもないわ、兄さんが言うなら私は別に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370215
					],
					"speakerTitle": "小鳥"
				},
				{
					"id": 413370215,
					"content": "はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370216
					],
					"speakerTitle": "孫宇"
				}
			]
		},
