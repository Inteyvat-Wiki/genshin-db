			"dialogs": [
				{
					"id": 706570101,
					"content": "こんにちは、西風騎士団のリジーだよ。もう知ってると思うけど、風花祭期間、モンドでは様々なイベントが開催されるんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570102,
						706570103
					],
					"speakerTitle": "リジー"
				},
				{
					"id": 706570102,
					"content": "聞いたことある…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706570104
					]
				},
				{
					"id": 706570104,
					"content": "モンドに来たお客さんに風花祭を楽しんでもらうことが、私の仕事なの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570105
					],
					"speakerTitle": "リジー"
				},
				{
					"id": 706570105,
					"content": "イベントの開催地点は城内とは限らないから、誰かが紹介しないと面白い遊びを逃しちゃう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570106
					],
					"speakerTitle": "リジー"
				},
				{
					"id": 706570106,
					"content": "今回私がおすすめするのはこれ！——「百発百中」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570107
					],
					"speakerTitle": "リジー"
				},
				{
					"id": 706570107,
					"content": "その名の通り、宙に舞う的を射撃する遊びだよ。速くて正確に撃てれば、ハイスコアを獲得できるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570108,
						706570109
					],
					"speakerTitle": "リジー"
				},
				{
					"id": 706570108,
					"content": "面白そう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706570110
					]
				},
				{
					"id": 706570110,
					"content": "大丈夫、位置は記してあげるから、自分で試してみればすぐ分かるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570111
					],
					"speakerTitle": "リジー"
				},
				{
					"id": 706570111,
					"content": "獲得したポイントに応じて、それぞれ価値の違う報酬が手に入るんだ。遊びで体験するもよし、本気でハイスコアを狙うもよし、どっちでも面白いよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570112,
						706570113
					],
					"speakerTitle": "リジー"
				},
				{
					"id": 706570112,
					"content": "興味が湧いてきた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706570114
					]
				},
				{
					"id": 706570114,
					"content": "うん、とりあえず試してみてよ！他にも気になるイベントがあれば、紹介してあげるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570115
					],
					"speakerTitle": "リジー"
				},
				{
					"id": 706570115,
					"content": "楽しく遊んでね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リジー"
				},
				{
					"id": 706570113,
					"content": "説明ありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706570114
					]
				},
				{
					"id": 706570109,
					"content": "難しそう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706570110
					]
				},
				{
					"id": 706570103,
					"content": "初耳だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706570104
					]
				}
			]
		}
	]
