			"dialogs": [
				{
					"id": 747050101,
					"content": "…私はこれだと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050102
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 747050102,
					"content": "確かに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050103
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 747050103,
					"content": "どうして？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050104
					],
					"speakerTitle": "千織"
				},
				{
					"id": 747050104,
					"content": "この尾びれの色を見ろ。この水槽の中で、これよりお洒落なのはいない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050105
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 747050105,
					"content": "色はちょっと派手だけど…まあいいわ。誉め言葉として受け取っておいてあげる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050106
					],
					"speakerTitle": "千織"
				},
				{
					"id": 747050106,
					"content": "わあ！人がいっぱいだな！みんなアクアリウムを見に来てくれたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747050107,
					"content": "うん、ちょうどワンシーン撮り終えたところでね。休憩時間に鑑賞しに来たんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050108
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 747050108,
					"content": "なんの話をしてたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747050109,
					"content": "どの魚が千織に似てるか、という話だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050110
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 747050110,
					"content": "おまえらまで…！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747050111,
					"content": "ああ…ふふっ、さっきおしゃべりしていた時にコロンビーナさんとそういう話をしてて、面白いと思ってね。気づいたら、盛り上がっていたんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050112
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 747050112,
					"content": "こういうのってうつるんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747050113,
					"content": "あ！あの魚、君に似てるわね、シュヴルーズ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050114
					],
					"speakerTitle": "千織"
				},
				{
					"id": 747050114,
					"content": "というと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050115
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 747050115,
					"content": "暇さえあれば水槽の中をぐるぐる泳ぎ回ってて、トレーニングしてるでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050116
					],
					"speakerTitle": "千織"
				},
				{
					"id": 747050116,
					"content": "…お前の中で、私はそんなイメージなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シュヴルーズ"
				}
			]
		}
	]
}