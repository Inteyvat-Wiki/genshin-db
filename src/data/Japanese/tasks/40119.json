			},
			"dialogs": [
				{
					"id": 401190201,
					"content": "あっ、エウルアもコレイも、もう戻ってきてたんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401190202,
					"content": "ええ、そちらの公演が終わる頃、シズクちゃんからイディアさんのメッセージを受け取ったから、先にここでみんなを待ってたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190203
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 401190203,
					"content": "じゃあ、レッシグさんは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190204
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190204,
					"content": "レッシグさんは力仕事をぜんぶ引き受けてくれたんだ。力尽きて、今は部屋でぐっすり寝てるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190205
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 401190205,
					"content": "うぅ、なんか申し訳ないですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190206
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190206,
					"content": "すべては償いだと思えばいいわ。終わらせないと、彼も安心して眠れないってこと。元々そうすべきことでもあるんだから、彼のことは気にしなくていいのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190207
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 401190207,
					"content": "そうですか…それじゃ、私たちは急いで「ヴェルーリヤ·ミラージュ」のコアを修復しましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190208
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190208,
					"content": "ここってオイラたちがシズクちゃんに初めて会った場所じゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401190209,
					"content": "そうですよ、「ヴェルーリヤ·ミラージュ」のコアは一番大きな「集流映写灯」であり、そして蜃境全体が一番大きな「先成図」なんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190210
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190210,
					"content": "あたしたちが見たすべては、これが生成したものってことか？本当に不思議だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190211
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 401190211,
					"content": "前と同じように、コアの「先成図」を使ってこれを修復すればいいんだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401190212,
					"content": "はい、その通りです。パイモンさんは理解が早いですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190213
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190213,
					"content": "えへへ、これだけ何度も修復すれば、覚えちゃうもんだって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401190214,
					"content": "それじゃ始めましょうか。これが最後のステップです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190215
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190215,
					"content": "おう！なんだか急にやる気が湧いてきたぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
