			},
			"dialogs": [
				{
					"id": 401190401,
					"content": "成功したぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401190402,
					"content": "でも、ホイールは回らなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190403
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 401190403,
					"content": "パーツは蜃境のコアに戻りましたし、ホイールの形もこれで修復されました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190404
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190404,
					"content": "はは、だからぜんぶ問題なしですよ。傷が徐々に癒えていくのと同じで、もしかしたらいつかの真夜中に突然「コアホイール」はそっと回り始めるのかもしれませんね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190405
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190405,
					"content": "ほう？イディアなら、今すぐ動かせるもんだと思ってたんだがな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190406
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401190406,
					"content": "それは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190407
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190407,
					"content": "ん？？？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401190408,
					"content": "蜃境の元の姿も、イディアさんが隠している美しい姿も、どちらもとても楽しみですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190409
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 401190409,
					"content": "クレーもイディアお姉ちゃんが魔法を使うところを見てみたい！きっとすっごいんでしょ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190410
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401190410,
					"content": "お、おまえたち、なに言ってるんだ…？なんでクレーまで知ってる風なんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190411
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401190411,
					"content": "やっぱりパイモンは気付かなかったんだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401190412
					]
				},
				{
					"id": 401190412,
					"content": "つまり…「マスコットの正体」よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190413
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 401190413,
					"content": "だから、前にも言ったでしょう？イディアさんは決してご自分が思っているような存在ではないと。イディアさんにはイディアさんだけの特殊な力がある…薄々気付いていた人もいたようですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190414
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 401190414,
					"content": "「軍師」さんは最初から気付いてたのか？あたしはエウルアと話してるときに気づいたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190415
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 401190415,
					"content": "一見のんびりしてるように見える「軍師」のお嬢さんが、真相に気付いた最初の人ってことか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190416
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401190416,
					"content": "君もよく知ってそうじゃない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190417
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 401190417,
					"content": "みんな…全部知ってるんですか？…誓って、わざとみんなに隠そうとしたんじゃありません！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190418
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190418,
					"content": "ただ…蜃境に迷い込んだ旅者にとっては、今の姿のほうが、本来の姿より親しみやすいでしょう？わ、私…怯えた目で見られたくないんです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190419,
						401190420
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190419,
					"content": "今まで深く考えてなかった！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401190421
					]
				},
				{
					"id": 401190421,
					"content": "え？一体なんなんだよ？みんな何で分かったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190422
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401190422,
					"content": "うーん…そうですね、蜃境の住民たちは神の目を持っていないはずですが、彼らからは水元素の力を感じました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190423
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 401190423,
					"content": "小説を読んでボーっとしていたら、ふとある可能性を思いついたんです。水形幻霊は様々な姿に変身できる…ならきっと、普通の人間の姿にも変身できますよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190424
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 401190424,
					"content": "本当に鋭いですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190425
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190425,
					"content": "では、改めて自己紹介をさせてください——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190426
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190426,
					"content": "私は先代の水神が亡くなった時、ここに流されてきた純水精霊——イディアです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190427
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190427,
					"content": "純水精霊だったんだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401190428
					]
				},
				{
					"id": 401190428,
					"content": "イディアお姉ちゃん、すっごく綺麗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190429
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401190429,
					"content": "うぅ…いきなり本来の姿で話すのって、ちょっと恥ずかしいですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190430
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190430,
					"content": "こんな美しい姿なんだから、自信をもって人に見せられるじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190431
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 401190431,
					"content": "私にそんな勇気はありませんから…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190432
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190432,
					"content": "え？それじゃ、今まで会った人たちって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190433
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401190433,
					"content": "要するに、「水形住民」の「原型」となった人々はもうここにはいないんだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190434
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401190434,
					"content": "はい、彼らがここを出たくなったら、私は彼らを砂漠の果てまで送るんです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190435
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190435,
					"content": "実はこの「パーツ」も、彼らが残してくれたプレゼントでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190436
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190436,
					"content": "でも、彼らがここに入ってくる理由がとても気になって…だから私は「集流映写灯」を使って、彼らの願いを具現化したんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190437
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190437,
					"content": "「願いを叶えられるのは、瓶の中でだけ——」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190438
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 401190438,
					"content": "そういうことです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190439
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190439,
					"content": "本当に眩しい光だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190440
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401190440,
					"content": "ということは、蜃境のコアから外れた部品は、持ち主のもとに戻ったわけではなかったのですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190441
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 401190441,
					"content": "部品の落ちた位置に、関係している「持ち主」と「エリア」が具現化されたということなのでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190442
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 401190442,
					"content": "でも、今「パーツ」は全部回収しちゃったよな。もしかして、彼らも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190443
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 401190443,
					"content": "安心してください、彼らは消えませんよ…私が覚えている限りは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190444
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190444,
					"content": "批評し合っても、一緒にはしゃいでもいい…この幻境の中で、彼らは永遠に私の友達なんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190445
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190445,
					"content": "「びゅんびゅん爆速車」も「監督」のお兄ちゃんも、すっごく面白かった！クレーは忘れないよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190446
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401190446,
					"content": "あたしもだ。この不思議な冒険のことは絶対忘れないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190447
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 401190447,
					"content": "はは…さてと、じゃあそろそろホイールを再び回しますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190448
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190448,
					"content": "任せたよ、水みたいに優しい「マスコット」さん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190449
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 401190449,
					"content": "ド、ドキドキするぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190450
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401190450,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190451
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190451,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190452
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190452,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401190453
					]
				},
				{
					"id": 401190453,
					"content": "えっ…まさか、反応がないなんて…もしかして、この前蜃境が故障したせいで力が足りないのかもしれません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190454
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190454,
					"content": "ああ、やっちゃいました…さっきみんなにちやほやされたそばから…私も図々しく大口を叩いちゃいましたし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190455
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190455,
					"content": "うぅ…身を隠せる瓶をください！百年隠れておきます～～！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190456
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190456,
					"content": "えっと…おまえはすでに瓶の中なんだけどな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190457
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401190457,
					"content": "どうしよう…これじゃみんなに「蜃境」の本来の姿を見せることなんて出来っこありません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190458
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190458,
					"content": "…いえ、私に策があります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190459
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 401190459,
					"content": "「軍師」さん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190460
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190460,
					"content": "イディアさん、もしよかったら、蜃境のコアにある「蜃楼玉匣」を貸してくれませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190461
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 401190461,
					"content": "その名前、聞き覚えがありますね。ちょっと待ってくださいね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190462
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190462,
					"content": "ほら、これでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190463
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190463,
					"content": "わぁ！すごくおっきな貝がら！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190464
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401190464,
					"content": "心海が言ってた古代の祭器は、ここに隠されてたのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190465
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401190465,
					"content": "ええ、これはかつて曚雲神社に祀られていた祭器で、「蜃」という妖怪の残骸で作られています。行き来する祈願者の願いを聞いて、蜃気を溜めるんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190466
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 401190466,
					"content": "数百年前、最後のヤシオリ守りがこれを持ったまま戦いへと身を投じましたが、ついに戻らず…この祭器も失われていました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190467
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 401190467,
					"content": "対になっている宝珠は「玉匣」の在り場所を感知できるはずでしたが、「玉匣」が「蜃境のコア」に隠されてしまうと、宝珠も輝きを失ってしまいました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190468
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 401190468,
					"content": "えっ、どうして？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190469
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401190469,
					"content": "もし奥のほうの部屋に音を閉じ込めたら、外からは聞こえなくなるだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190470
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401190470,
					"content": "あっ！クレー分かった！この貝がらは遊び盛りで、だから反省室に閉じ込められちゃったんだね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190471
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401190471,
					"content": "私も分かりました！最近は蜃境のコアが老朽化してました…だから「軍師」さんは宝珠を手にここまで辿りつけたんですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190472
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190472,
					"content": "（トレジャーコンパスみたい…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401190473
					]
				},
				{
					"id": 401190473,
					"content": "…本題に戻りますね。本来、神社に奉納されなくなれば、この祭器はすぐに霊気を失ってしまうはずでした…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190474
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 401190474,
					"content": "しかし、この蜃境の中では、数え切れないほどの人々が自分の願いや贈り物を残した…それらがこの祭器の「供物」となっていたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190475
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 401190475,
					"content": "これって…そんなにすごいものなんですか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190476
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190476,
					"content": "はい、きっとイディアさんが「蜃境」を修復するのを手伝ってくれますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190477
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 401190477,
					"content": "でも…私はどうすれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190478
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190478,
					"content": "簡単ですよ、願いでこれを呼び覚ませばいいのです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190479
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 401190479,
					"content": "例えば…私は珊瑚宮心海、海祇島の「現人神の巫女」です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190480
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 401190480,
					"content": "私の願いは、自分の思考や判断を通して、海祇島の皆さんや私の大切な人たちが…もっと、もっと幸せに暮らせるようになることです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190481
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 401190481,
					"content": "イディアさん、あなたの願いは何ですか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190482
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 401190482,
					"content": "私の願い？私は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190483
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190483,
					"content": "私の願いは、「ヴェルーリヤ·ミラージュ」にやってきた旅の人たちが、蜃境の中だけでなく…蜃境の外でも、本当に叶えたい願いを叶えられますようにってことです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190484
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190484,
					"content": "私は知ってます…蜃境の外で猛スピードで走る乗り物のレールを敷くなんて言うのはばかげた考えに過ぎないってことも、メイモムは結局帰って学者を続けていくんだろうってことも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190485
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190485,
					"content": "ゾシモスの執筆レベルにはまだまだ改善の余地があるし、フォンテーヌに戻ったら絶対に色々と苦労するのも分かってます。夢を追うのはそう簡単なことじゃないんです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190486
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190486,
					"content": "それでも私は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190487
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190487,
					"content": "彼らの願いが叶うことを、心から願ってます…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190420,
					"content": "多少感づいてはいたけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401190421
					]
				}
			]
		},
