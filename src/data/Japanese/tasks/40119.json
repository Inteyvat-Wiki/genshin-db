				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"クレー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401190801,
					"content": "みんなを蜃境から送り出した後は、いつも一人でここに来るんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190802
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190802,
					"content": "蜃境で色んなものを作り出せて…みんな最初はとても嬉しそうでした…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190803
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190803,
					"content": "でも、それらを外に持ち出せないって分かった途端、彼らは悩んでしまって…惜しそうな顔や、悔しそうな顔で帰っていくんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190804
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190804,
					"content": "イディアお姉ちゃんは悲しい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190805
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401190805,
					"content": "…たまに寂しく感じることもありますが、悲しくはありませんよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190806
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190806,
					"content": "蜃境を離れる時、自分が作ったものを全部壊してしまう人もいます…でも、そうじゃない人もいる。例えば、あなたたちが見たあの住民たちのように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190807
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190807,
					"content": "彼らは蜃境を離れる時、私に頼みました——水形幻霊に「自分」を模倣してもらって、蜃境にある創造物を維持して欲しいって。まるで、彼らの夢を見守るみたいにです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190808
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190808,
					"content": "なんだかロマンチックだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190809
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401190809,
					"content": "でしょ？彼らが外で元気に過ごしてるのかどうかは分かりません。でも、彼らは夢を叶えて、この蜃境にいるような自分になれたかもしれないと思うと、私はとても嬉しいんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190810
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190810,
					"content": "まるで、夢の終着駅で彼らを待ってるみたいに思えて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190811
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190811,
					"content": "イディアはいい人だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401190812
					]
				},
				{
					"id": 401190812,
					"content": "え…そうですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190813
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190813,
					"content": "私はただ、すべての夢や願いは、瓶の中にある光のようだと思ってるんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190814
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190814,
					"content": "夢を追い求める途中だろうと、すでに夢を叶えていようと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190815
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190815,
					"content": "自分だけのこの光を思い出した時に笑顔でいられるのなら、それだけでいいんです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190816
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190816,
					"content": "クレーは今、とっても楽しいよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190817
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401190817,
					"content": "はは、それじゃ、私もアリスさんに恩返しできたって言えますかね。砂漠ってとこは、どうしたって汚い泥のスープみたいな場所ですけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190818
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190818,
					"content": "そんなこと言うんだったら、泥水精霊ってあだ名で呼んでやる！へへっ、イディアは泥水精霊だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190819
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401190819,
					"content": "よくも私を笑ってくれましたね！パックリ飲み込んでやりますから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190820
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190820,
					"content": "…みんなに恥ずかしいところを見せてしまいましたが、運行を再開した蜃境はますます賑やかになっていきますから。みんな、ゆっくり休んで行ってくださいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190821
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190821,
					"content": "みんなの夢のために！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401190822
					]
				},
				{
					"id": 401190822,
					"content": "うん！クレー、みんなで集まりたい——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190823
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401190823,
					"content": "みんなで一緒に「びゅんびゅん爆速車」に乗ろう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "クレー"
				}
			]
		},
