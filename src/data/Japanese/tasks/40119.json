			},
			"dialogs": [
				{
					"id": 401190601,
					"content": "わぁ、イディアお姉ちゃんまたこの姿に戻ったね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190602
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401190602,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190603
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190603,
					"content": "大丈夫？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401190604
					]
				},
				{
					"id": 401190604,
					"content": "ちやほやされたからって調子に乗って、一気に恥ずかしいことをいっぱい言っちゃいました…わ、私、生きていく勇気がなくなっちゃいましたよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190605
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190605,
					"content": "そんなことを言わないでください。とても素晴らしい願いですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190606
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 401190606,
					"content": "そう、イディアさんは自分のためじゃなく、他の人のために願い事をしたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190607
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 401190607,
					"content": "あたしの友達の中にも、そういう人がいるんだ！他の人の願いのために行動し、人の笑顔のためにたゆまぬ努力を続ける人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190608
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 401190608,
					"content": "そういうことをできるのが…一番高潔なんだと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190609
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 401190609,
					"content": "それ以上褒めないでください。わ、私…本当に慣れてないんです…恥ずかしすぎます…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190610
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190610,
					"content": "私のような者も、こんなに沢山の人に褒めてもらえるなんて…まるで夢みたいです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190611
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190611,
					"content": "でもこれで、蜃境もやっと元通りね。あいつの借りもちゃんと返せたってことかしら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190612
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 401190612,
					"content": "うぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190613
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401190613,
					"content": "どうしたんだい、クレー？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190614
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401190614,
					"content": "クレー、突然いっぱい願いが出来ちゃった！「びゅんびゅん爆速車」に乗りたい！それに、大きな輪っかの上に行ってみたいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190615
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401190615,
					"content": "イディアお姉ちゃん、あそこに行く方法はある？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190616
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401190616,
					"content": "方法はありますけど、全員は乗れませんよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190617
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401190617,
					"content": "#クレーが一人で行っても面白くないよ…うぅ、栄誉騎士の{M#お兄ちゃん}{F#お姉ちゃん}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190618
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401190618,
					"content": "同行いたします、「魔女」さま。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401190619
					]
				},
				{
					"id": 401190619,
					"content": "本当か？あれ、結構高そうに見えるけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190620
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401190620,
					"content": "うっかり落ちてしまったらどうするんだ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190621
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401190621,
					"content": "…パイモンは飛んでるでしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401190622
					]
				},
				{
					"id": 401190622,
					"content": "オ、オイラはおまえのことを心配してるんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190623
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401190623,
					"content": "大丈夫、私も一緒に行きますよ。あっちに行くのも久しぶりです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イディア"
				}
			]
		},
		{
			"id": 4011908,
			"completionStepIds": [
				4011908
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4011908",
							"2"
						],
						"stepId": 4011908,
						"stateName": "QUEST_STATE_UNFINISHED"
