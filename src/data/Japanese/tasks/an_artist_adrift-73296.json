			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ジュリアン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732960801,
					"content": "どうだ？素晴らしい景色だろ？ペッパーも喜んでるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960802
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732960802,
					"content": "こんな景色を見ていると、言葉なんか必要ないって思えて来るな。キャタピラーの言った通り、鉄格子の向こうに広がるのは別世界だった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960803
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732960803,
					"content": "鉄格子…確かジュリアンは、フォンテーヌでは狭い所に住んでたって言ってたよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960804
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732960804,
					"content": "コホン…スメールの自然に恵まれた場所だよね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960805
					]
				},
				{
					"id": 732960805,
					"content": "…おう、その通りだぞ！正々堂々と画家になるって決めたんなら、住む環境を変えてみるのもいいんじゃないか。えーと、そうだ…視野を広げるってやつだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960806
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732960806,
					"content": "ジュリアンはもう諦めるって言ってたけど…結論を急ぐこともないだろ！もっとゆっくり考えてみてもいいじゃないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960807
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732960807,
					"content": "いま目の前に広がってるみたいな景色とか、もっと素晴らしい景色がまだまだ沢山あるんだ。それを見たら…インスピレーションがジャンジャン沸くかもしれないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960808
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732960808,
					"content": "色を見分けることについては…おまえも言ってただろ、「ちょっと違った景色が映るだけだ」って…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960809
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732960809,
					"content": "「でも、美しさは共通」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960810
					]
				},
				{
					"id": 732960810,
					"content": "そうだろ、ジュリアン？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960811
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732960811,
					"content": "確かに…君たちの言葉にも一理ある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960812
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732960812,
					"content": "おまえが自分で言ってたことだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960813
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732960813,
					"content": "俺が…ハハ、俺も心の中では分かってたのかもな。ただ…つい間違った道を選んでしまった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960814
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732960814,
					"content": "ペッパーがおまえをこの道に連れてきたおかげで、オイラたちは会えたんだから、完全に「間違った道」でもないんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960815
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732960815,
					"content": "純水精霊の巡礼の道を一緒に見つけてやれなかったのは残念だけど…うぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960816
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732960816,
					"content": "それって本当に実在するのかな…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960817
					]
				},
				{
					"id": 732960817,
					"content": "巡礼の道は本当にあると、俺は今でも信じているよ。でも…そこにたどり着けるかどうかは、もう重要なことじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960818
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732960818,
					"content": "ずっと探し続けていた答えを、やっと見つけたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960819
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732960819,
					"content": "君たちには心から感謝している。あぁ、どうやってお礼をすれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960820
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732960820,
					"content": "この前の不思議な鳥の卵を買っておけばよかった…一日厄払いをしてくれる不思議な道具らしいから、君たち冒険者にはぴったりだったのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960821,
						732960823
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732960821,
					"content": "それはとても残念。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960822
					]
				},
				{
					"id": 732960822,
					"content": "#{NICKNAME}、そんな不思議な道具があるって信じてるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960825
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732960825,
					"content": "俺はもうしばらくここにいるよ。ここにいると心が落ち着くし、思考を巡らせるにはピッタリだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960826
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732960826,
					"content": "なんか、特別な絵が描けるような予感までしてきた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960827
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732960827,
					"content": "心から礼を言うよ——友の旅に幸あらんことを！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732960823,
					"content": "ありがとう。でもお礼なんていいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960824
					]
				},
				{
					"id": 732960824,
					"content": "なんでだ！厄払いはできなくたって…も…もしかしたら普通の鳥の卵より百倍美味しいかもしれないんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960825
					],
					"speakerTitle": "パイモン"
				}
			]
		},
