			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ジュリアン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732960201,
					"content": "#パイモン、{NICKNAME}…来てくれたのか！やはり外で頼りになるのは友人だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960202
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732960202,
					"content": "道案内するって約束しただろ？これぐらい朝飯前だぞ！今日の朝ご飯は…もう食べたけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732960203,
					"content": "でも、本当にフォンテーヌに帰るのか？せっかくスメールまで来たんだろ。スメールには素晴らしい景色がいっぱいあるんだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960204,
						732960206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732960204,
					"content": "雨林の景色がオススメ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960205
					]
				},
				{
					"id": 732960205,
					"content": "木がいーっぱいあって、川も流れてるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732960208,
					"content": "確かにそそられるけど…まだ、景観を楽しむ心の準備ができてないんだ。この旅は失敗だったけど、教訓も得られた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960209
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732960209,
					"content": "えーと…じゃあ…この近くにも素晴らしい景色があるんだ！見ないのは勿体なすぎるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732960210,
					"content": "パイモンがオススメするんだから間違いない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960211
					]
				},
				{
					"id": 732960211,
					"content": "二人がそこまで言うなら、これ以上遠慮するのも失礼だね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960212
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732960212,
					"content": "へへ、オイラはテイワット屈指のガイドなんだぜ。道案内なら任せてくれ！おまえら、しっかりついてこいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732960206,
					"content": "砂漠の景色は格別だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960207
					]
				},
				{
					"id": 732960207,
					"content": "砂がいーっぱいあって、遺跡もいーっぱいあるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960208
					],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7329603,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
