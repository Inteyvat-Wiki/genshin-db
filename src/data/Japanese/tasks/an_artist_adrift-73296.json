			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ジュリアン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732960301,
					"content": "画家は筆を動かす前にまず色んな角度から観察するって聞いたんだけど…これってオイラの固定観念じゃないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732960302,
					"content": "一緒にこの近くを回ってみるか？もっと高い所に行けば視野も開けるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732960303,
					"content": "いい提案だね。こっちは準備できてるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960304
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732960304,
					"content": "#そうだ、目的地までかけっこしようぜ？{NICKNAME}、準備はいいか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7329604,
			"completionStepIds": [
				7329604
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7329604",
