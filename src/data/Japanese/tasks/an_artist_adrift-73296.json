					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732961404
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732961404,
					"content": "まずは身体の回復に専念するよ。",
