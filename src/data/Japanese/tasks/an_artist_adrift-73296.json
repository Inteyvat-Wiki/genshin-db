			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ジュリアン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732960401,
					"content": "自然豊かな場所なら…絵のインスピレーションを得たり、写生のアイデアをひらめいたりするのにピッタリだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732960402,
					"content": "それこそ固定観念だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960403
					]
				},
				{
					"id": 732960403,
					"content": "うっ…でももしオイラが画家だったら、筆が乗ると思うぜ。ここの景色は、見るからに生命力に満ちてて、凄く綺麗な色合いだし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732960404,
					"content": "コホン。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960405
					]
				},
				{
					"id": 732960405,
					"content": "あっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732960406,
					"content": "ごめん…わざとじゃないんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960407
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732960407,
					"content": "ハハ、気にしないでくれ。俺の目にはちょっと違った景色が映るだけだ。でも、美しさは共通だろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960408
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732960408,
					"content": "うん！オイラ、ここの景色が気に入ったぜ。なんか心まで浄化されそうな感じだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960409
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732960409,
					"content": "パイモンの心は浄化する必要なんかないでしょ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960410
					]
				},
				{
					"id": 732960410,
					"content": "友よ、俺のような見知らぬ人に、初めの頃は嘘までついてたやつなんかに、ここまで優しくしてくれて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960411
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732960411,
					"content": "二人こそ、純粋で綺麗な心の持ち主だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960412
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732960412,
					"content": "へへっ…そこまで褒められると照れるな。そうだ、もっと素晴らしい景色もあるんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732960413,
					"content": "#{NICKNAME}、オイラがなんのことを言ってるか分かるだろ？ジュリアンにも見せてやろうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
