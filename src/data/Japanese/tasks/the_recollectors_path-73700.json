				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ズルヴァーン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 737000101,
					"content": "あっという間に訓練も後半に入ったわネ。どう、順調？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000102,
						737000103
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 737000102,
					"content": "佳境に入った。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737000104
					]
				},
				{
					"id": 737000104,
					"content": "でも確かに、ソルシュが過去を振り返るときは、本当にあれでよかったのかって考えてるっぽかったよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737000105,
					"content": "会話はソルシュにとっていい勉強になるでショウ。相手が「スケプティック団」のつまらない輩じゃない場合は特にネ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000106
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 737000106,
					"content": "#先輩、その言い方はちょっと独断がすぎるんじゃないでしょうカ…「謁賛主」の{NICKNAME}は確かに優秀デスが、「スケプティック団」だって、全員が全員そういうわけでは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000107
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737000107,
					"content": "ええ、ゴマすり屋さんで嘘つきなコトを除けば、もしかしたら見落としてしまったわずかな美徳があるかもしれないわネ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000108
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 737000108,
					"content": "うぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000109
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737000109,
					"content": "#どうやら納得がいかないみたいネ。なら、{NICKNAME}とパイモンの判断に委ねようかしら？もちろん、あなたが語り終わった後でネ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 737000103,
					"content": "もっと頑張れる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737000104
					]
				}
			]
		},
		{
			"id": 7370006,
			"completionStepIds": [
				7370006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7370006",
							"2"
						],
						"stepId": 7370006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ソルシュ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 737000601,
					"content": "静かだな…誰もいない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000602
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737000602,
					"content": "ラシュヌがいるにしても、きっと静かにしてるんでしょうネ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000603
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737000603,
					"content": "うん、でもあいつがいるんだったら音量を抑えないとな。あいつ、いつも眠そうだし、前回オイラたちのコリュの太鼓に起こされたときも、ちょっと不機嫌そうだったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737000604,
					"content": "無口なやつほど怒ると怖いって言うけど、怒り爆発モードのラシュヌはどんな感じなんだろうな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000605
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737000605,
					"content": "だったら、我が「謁賛主」が一番怖いんじゃナイかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000606
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737000606,
					"content": "え？こいつのことはオイラが一番知ってるぜ。無口なやつだけど、すっごく優しいもんな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000607,
						737000609
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737000607,
					"content": "じゃあ本気で怒るよ。うがーーー！！！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737000608
					]
				},
				{
					"id": 737000608,
					"content": "ほら、ちっとも怖くないだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000611
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737000611,
					"content": "まあいいワ、そろそろ本題に戻りまショ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000612
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737000612,
					"content": "あなたたちの目の前にあるのは「バルソム」という木で、ラシュヌはこの木の眷属なノ。でも、彼女は今ここにはいナイ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000613
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737000613,
					"content": "それでそれで？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000614
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737000614,
					"content": "それでおしまい。ラシュヌと「バルソム」については、特に補足事項ナシ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000615
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737000615,
					"content": "何か隠してる感じがするぞ…あ、そうだ、コリュの太鼓についてだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000616
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737000616,
					"content": "な、何も隠したりなんかしてないわヨ。コリュの太鼓については…あなたたちだって見たことあるデショ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000617
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737000617,
					"content": "たしか、あの時ラシュヌがコリュの太鼓をあちこちに捨てたって言ったら、ナセジュナがびっくりしてたよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000618
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737000618,
					"content": "オイラの記憶が正しければ、あのときソルシュはあたふたして、ナセジュナの質問に答えられなかったんだったよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000619
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737000619,
					"content": "今考えたら、スケプティック団の文献や書籍って本当にでたらめなんじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000620
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737000620,
					"content": "楽譜通りの演奏でラシュヌを起こせはした。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737000621
					]
				},
				{
					"id": 737000621,
					"content": "うーん、ズルヴァーンがスケプティック団を信用しないのも分かる気がするぜ。よく考えたら、あいつらって本当に役に立ってるのかよ？あいつらから手に入れた手がかりだって半分は嘘だったし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000622
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737000622,
					"content": "う…うぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000623
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737000623,
					"content": "確かに今のスケプティック団には当てにならない団員がいくらかいるワ。でも、どんな立派な大木でも、枯れた枝や葉っぱぐらいあるものデショ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000624
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737000624,
					"content": "そういう枯れた枝葉が全部落ちてしまえば、の…残るのはきっと、ちゃんとした…はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000625
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737000625,
					"content": "…どうしてスケプティック団は今みたいな状態になっちゃったのかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000626
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737000626,
					"content": "#{M#俺}{F#私}もそれが知りたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737000627
					]
				},
				{
					"id": 737000627,
					"content": "スケプティック団の人間とずっと一緒にいたせいで、かえって彼らの色んな変化に気づくことができなかったワ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000628
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737000628,
					"content": "あなたたちのような、よその人間と話して初めて、もう過去のスケプティック団とは全然違うんだってことが分かったワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000629
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737000629,
					"content": "何百年も経ってるし、「スケプティック団」っていう名前こそ変わってないけど、メンバーは何世代も交代してるわけだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000630
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737000630,
					"content": "私の追い求める名声も、人間の「謁賛主」によって伝承されるハズの名声も、最後には同じ結果になるのかしら…何もかもが変わって、最後に残るのは、空虚な称号だけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000631
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737000631,
					"content": "先輩が私に悟らせたかったのはこういうことなノ？そんなハズ…でも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000632
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737000632,
					"content": "…おい、そんなに落ち込むなよ。ズルヴァーンも…そういう意味じゃなかったのかもしれないし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000633
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737000633,
					"content": "ソルシュが落ち込んでるのを見たら、なんかオイラまで申し訳ない気持ちになってきたぞ…後でズルヴァーンに慰めてもらおう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737000609,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737000610
					]
				},
				{
					"id": 737000610,
					"content": "#…何か言えよ！{NICKNAME}！じっと黙りこくってると本当にちょっと怖いぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000611
					],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
}