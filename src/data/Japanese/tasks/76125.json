				},
				{
					"id": 761250215,
					"content": "みんなが悲しそうにしてるのを見たら…オイラ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761250216,
					"content": "いや、しっかりしないとな…",
