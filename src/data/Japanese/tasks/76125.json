					"nextDialogs": [
						761250218
					]
				},
				{
					"id": 761250218,
					"content": "（…たらればを言ってもしょうがない。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250219
					]
				},
				{
					"id": 761250219,
					"content": "（コロンビーナはみんなにこんな思いをさせるために犠牲を払ったんじゃない。それに…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250220
					]
				},
				{
					"id": 761250220,
					"content": "#{M#俺}{F#私}は…諦めてない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250221
					]
				},
				{
					"id": 761250221,
					"content": "コロンビーナの仲間は、きっと誰一人諦めてないから…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250222
					]
				},
				{
					"id": 761250222,
					"content": "#少しだけ待ってて。約束はできないけど、{M#俺}{F#私}にできることは全部やってみるから…",
