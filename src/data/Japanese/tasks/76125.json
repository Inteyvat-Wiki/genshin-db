						761250228
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761250228,
					"content": "なにかやってほしいことはあるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250229
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761250229,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250230
					],
					"speakerTitle": "月霊"
				},
				{
					"id": 761250230,
					"content": "～！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250231
					],
					"speakerTitle": "月霊"
				},
				{
					"id": 761250231,
					"content": "こいつはたしか…ライアーが好きだったよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250232
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761250232,
					"content": "なんか、そわそわしてるぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250233
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761250233,
					"content": "ライアーを弾いてやったらどうだ？お馴染みの曲を聞いたら、気持ちが落ち着くかもしれないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250234
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761250234,
					"content": "お馴染みの曲…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250235
					]
				},
				{
					"id": 761250235,
					"content": "コロンビーナがよく口ずさんでたあの歌…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250236
					]
				},
				{
					"id": 761250236,
					"content": "…寝たぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250237
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761250237,
					"content": "こいつら、あまり眠れてなかったかもな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250238
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761250238,
					"content": "起こさないように、そっと行こうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250239
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761250239,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250240
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 761250240,
					"content": "サンドローネ！？なんでここに…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250241
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761250241,
					"content": "お散歩のついでよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250242
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 761250242,
					"content": "コロンビーナはまだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250243
					]
				},
				{
					"id": 761250243,
					"content": "やっぱりね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250244
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 761250244,
					"content": "奇跡には代償が必要だもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250245
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 761250245,
					"content": "この後、どこに行くんだ？あ、いや…せっかくだし、もし方向が同じなら一緒にって思って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250246
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761250246,
					"content": "よしましょう。今日は機嫌が悪いから、口を出る言葉に制御が効かないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250247
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 761250247,
					"content": "言っとくけど、慰めはいらないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
