					"ジャザリー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730261301,
					"content": "手順通りにやれと言っただろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261302
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730261302,
					"content": "#{M#俺}{F#私}たち、操作した覚えないけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730261303
					]
				},
				{
					"id": 730261303,
					"content": "アーム全体が落ちたぞ。どう見ても、このロボット自体の問題だろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730261304,
					"content": "分かった。とにかく事故レポートをまとめよう。ふう…私の論文に影響が出ないといいんだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261305
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730261305,
					"content": "いずれにしても、遺跡巨像を再起動させる手段はなさそうだ。君たちがこれ以上ここにいても意味がない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261306
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730261306,
					"content": "君たちは、地下遺跡の汚染調査のために来たんだったな。今や遺跡巨像にはなんの期待もできないがね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261307
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730261307,
					"content": "だが、さっきまでの苦労が、なにか突破口をもたらすかもしれんぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261308
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730261308,
					"content": "君たちに着いて行って、迷惑をかけるようなことはやめておこう。それに私にはまだ研究が残っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261309
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730261309,
					"content": "用が済んだら、また会いに来るといい…私が遺跡巨像破損の咎で、処分されていなければの話だが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261310
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730261310,
					"content": "その頃には、君たちの混沌の炉心研究プロジェクトも正式に申請できるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261311
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730261311,
					"content": "プロジェクトの責任者は当然私ということになろう。だが、経費は君たちと折半だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261312
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730261312,
					"content": "探求心さえ持ち続けていれば、どんな人間でも学問の道を歩める。それを目標に精進したまえ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジャザリー"
				}
			]
		}
	]
}