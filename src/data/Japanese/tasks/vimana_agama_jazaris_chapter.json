			},
			"dialogs": [
				{
					"id": 730260701,
					"content": "どこもかしこも精密な機械ばかりだ…まさに人類文明の傑作だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260702
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260702,
					"content": "これは貴重な研究データだぞ。急いで記録せねば。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジャザリー"
