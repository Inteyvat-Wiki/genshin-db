			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730261101,
					"content": "うーん…この黒い石板くらいしか、価値のありそうなものはないみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730261102,
					"content": "石板を舐めるものじゃないぞ。制御システムを起動すれば、それを使って直接外を見られるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261103
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730261103,
					"content": "どうやら制御システムも正常に動きそうだ。まったく、亡国カーンルイアの技術力には驚かされてばかりだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261104
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730261104,
					"content": "こんなチャンスは生涯巡って来ないと思っていた。このプロジェクトのレポートさえ出せば、「カビカバス賞」受賞も時間の問題だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261105
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730261105,
					"content": "だったら、早くこのロボットを起動させようぜ。オイラもう、これ以上は待てないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261106,
						730261107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730261106,
					"content": "どんとこい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730261108
					]
				},
				{
					"id": 730261108,
					"content": "焦るなよ。手順通りに操作すればいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730261107,
					"content": "善は急げ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730261108
					]
				}
			]
		},
		{
