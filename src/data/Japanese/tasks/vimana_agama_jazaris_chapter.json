			},
			"dialogs": [
				{
					"id": 730260101,
					"content": "前に入った大きなロボットと大差ないな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730260102,
					"content": "前？君たちは他の遺跡巨像の中に入ったことがあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260103
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260103,
					"content": "おお！この前砂漠で、アフラトゥってやつから、似たような機械の調査を受けたことあるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730260104,
					"content": "アフラトゥ？くぅ、もしかして彼も「遺跡巨像における研究の権威」という名を狙っているんじゃないよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260105
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260105,
					"content": "そうじゃないと思うけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260106
					]
				},
				{
					"id": 730260106,
					"content": "確か、やつは因論派の学者だよな。こんなものに興味はないはずだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260107
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260107,
					"content": "よく考えたら、まったく可能性がないわけでもない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260108
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260108,
					"content": "何しろ、それは「諸君、カーンルイア千年の歴史が我々を見ている！」という名言を発した賢者イスカンデルがいた学派だからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260109
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260109,
					"content": "研究権威とかはともかく、この前調査したやつと比べて、ここは本当に長い間誰も来てないみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730260110,
					"content": "それはもちろんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260111
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260111,
					"content": "『亡国カーンルイア·遺跡巨像に関する研究』によれば、我々の前にここの実地調査をした学者はカビカバスといったらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260112
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260112,
					"content": "君たちは知らないだろうがね、カビカバスは妙論派史上、最も偉大と称される学者だ。弱冠三十歳にして、ハーバッドの天才と呼ばれた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260113
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260113,
					"content": "彼の業績からすれば、賢者になる日も近いと思われた。だがフィールドワーク中に事故に遭い、重要な研究成果も行方知れずとなってしまった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260114
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260114,
					"content": "それを境に妙論派は没落していった。彼がもう少し長く生きていれば、私も経費のことばかり気にせずに済んだろうに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260115
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260115,
					"content": "ついでに言うと、カビカバスの研究を発展させるのが私の夢なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260116
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260116,
					"content": "うぅ、とにかく次は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260117,
						730260119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730260117,
					"content": "封鎖された入口をこじ開ける。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260118
					]
				},
				{
					"id": 730260118,
					"content": "だよな。だったらまずは、このデカブツを起動させないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730260121,
					"content": "その通りだ。遺跡巨像を起動して貴重な実験データを入手すれば、研究の突破口を開くことが出来る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260122
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260122,
					"content": "先人を超えるには、大きなことを成し遂げないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260123
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260123,
					"content": "それじゃオイラたちは今、操縦室に行ってこのデカブツを起動すればいいってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730260124,
					"content": "それなんだが…確かに操縦室に入って「離隔バルブ」を開けば、遺跡巨像が起動できる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260125
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260125,
					"content": "しかし前にも言ったはずだが、遺跡機械は、全て炉心の漆黒の力で動いている。そしてこの遺跡巨像の炉心は…地下に封印されている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260126
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260126,
					"content": "つまり操縦室に入ったとしても、普通のやり方では起動できないということだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260127
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260127,
					"content": "目の前の昇降装置すら動かせないんだ。てっぺんにある操縦室になど、到底たどり着けやしない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260128
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260128,
					"content": "うーん、じゃあ…これからどうする？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260129,
						730260131
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730260129,
					"content": "叩いてみようか。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260130
					]
				},
				{
					"id": 730260130,
					"content": "おい！教令院から研究に関する最高権限は与えられているとはいえ、破壊行為はご法度だぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260132
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260132,
					"content": "ほら、よく「扉が閉まるとき、窓が開かれる」と言うだろう？カーンルイア人もその辺りのことは考慮していたようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260133
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260133,
					"content": "恐らくその頃はまだ、漆黒の力を掌握しきれていなかったんだろう——教令院の研究で、初期に生産された遺跡機械には予備の動力系統が搭載されていたことが判明している。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260134,
						730260140
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260134,
					"content": "動力系統？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260135
					]
				},
				{
					"id": 730260135,
					"content": "そうだ。ほとんど無限に力を提供する炉心とは異なり、動力系統は複数の小型エネルギー中継装置によって構成されている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260136
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260136,
					"content": "装置の動力は、地脈から抽出された、純粋なエネルギーブロックだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260137
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260137,
					"content": "因論派学者は、その動力系統を、亡国カーンルイアが初号機を作るよりも前から幅広く活用されていたものだと考えている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260138
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260138,
					"content": "先ほど入ってくるときに確認したのだが、この遺跡巨像も初期に生産されたタイプだ。間違いなく予備の動力系統を搭載していると思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260139
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260139,
					"content": "コア動力室は下層部にある。まずはどうにかしてそこへ辿り着こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260140,
					"content": "どうすればいいのか言って。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260141
					]
				},
				{
					"id": 730260141,
					"content": "あ、ああ。コア動力室は下層部にある。まずはどうにかしてそこへ辿り着かないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260131,
					"content": "つまり普通じゃないやり方があるんだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260132
					]
				},
				{
					"id": 730260119,
					"content": "学術研究を進める。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260120
					]
				},
				{
					"id": 730260120,
					"content": "ん？オイラたち、地下遺跡を調べに来たんだろ？研究も大事だけど、あのデカブツを起動させるのが先だぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260121
					],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7302605,
			"completionStepIds": [
				7302605
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302605",
							"2"
						],
						"stepId": 7302605,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730260501,
					"content": "中は思ったより広いな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730260502,
					"content": "そりゃあそうだろう。待てよ、これでやっとあの名ゼリフが言えるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260503
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260503,
					"content": "「諸君、カーンルイア数千年の歴史が我々を見ている！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260504
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260504,
					"content": "はは、いささか調子に乗りすぎたか。因論派の賢者、イスカンデルの名言さ。君たち、まさか彼の伝記すら読んでないとは言わないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260505,
						730260506
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260505,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260508
					]
				},
				{
					"id": 730260508,
					"content": "文献は数えきれないほど読んできたが、やはり実物を目にすると興奮を抑えきれんな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260509
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260509,
					"content": "なんか、ツル草だらけだな。ほんとに長い間、誰も足を踏み入れてないみたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260510
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730260510,
					"content": "『亡国カーンルイア·遺跡巨像に関する研究』によれば、我々の前にここの実地調査をした学者はカビカバスといったらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260511
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260511,
					"content": "君たちは知らないだろうがね、カビカバスは妙論派史上、最も偉大と称される学者だ。弱冠三十歳にして、ハーバッドの天才と呼ばれた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260512
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260512,
					"content": "彼の業績からすれば、賢者になる日も近いと思われた。だがフィールドワーク中に事故に遭い、重要な研究成果も行方知れずとなってしまった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260513
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260513,
					"content": "それを境に妙論派は没落していった。彼がもう少し長く生きていれば、私も経費のことばかり気にせずに済んだろうに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260514
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260514,
					"content": "ついでに言うと、カビカバスの研究を発展させるのが私の夢なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260515
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260515,
					"content": "なるほどな、でも夢の話はあとだ。とにかく次は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260516,
						730260518
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730260516,
					"content": "封鎖された入口をこじ開ける。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260517
					]
				},
				{
					"id": 730260517,
					"content": "だよな。だったらまずは、このデカブツを起動させないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260520
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730260520,
					"content": "その通りだ。遺跡巨像を起動して貴重な実験データを入手すれば、研究の突破口を開くことが出来る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260521
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260521,
					"content": "先人を超えるには、大きなことを成し遂げないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260522
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260522,
					"content": "じゃあ、早くあのデカブツを動かそうぜ。押すとピカッて光るような、装置かなんかがあるんだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260523
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730260523,
					"content": "装置か…あるにはあるな。文献には、操縦室で「離隔バルブ」を開けば、遺跡巨像が起動できる、とある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260524
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260524,
					"content": "しかし前にも言ったはずだが、遺跡機械は、全て炉心の漆黒の力で動いている。そしてこの遺跡巨像の炉心は…地下に封印されている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260525
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260525,
					"content": "つまり操縦室に入ったとしても、普通のやり方では起動できないということだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260526
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260526,
					"content": "目の前の昇降装置すら動かせないんだ。てっぺんにある操縦室になど、到底たどり着けやしない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260527
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260527,
					"content": "うーん、じゃあ…これからどうする？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260528,
						730260530
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730260528,
					"content": "叩いてみようか。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260529
					]
				},
				{
					"id": 730260529,
					"content": "おい！教令院から研究に関する最高権限は与えられているとはいえ、破壊行為はご法度だぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260531
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260531,
					"content": "ほら、よく「扉が閉まるとき、窓が開かれる」と言うだろう？カーンルイア人もその辺りのことは考慮していたようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260532
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260532,
					"content": "恐らくその頃はまだ、漆黒の力を掌握しきれていなかったんだろう——教令院の研究で、初期に生産された遺跡機械には予備の動力系統が搭載されていたことが判明している。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260533,
						730260539
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260533,
					"content": "動力系統？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260534
					]
				},
				{
					"id": 730260534,
					"content": "そうだ。ほとんど無限に力を提供する炉心とは異なり、動力系統は複数の小型エネルギー中継装置によって構成されている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260535
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260535,
					"content": "装置の動力は、地脈から抽出された、純粋なエネルギーブロックだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260536
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260536,
					"content": "因論派学者は、その動力系統を、亡国カーンルイアが初号機を作るよりも前から幅広く活用されていたものだと考えている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260537
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260537,
					"content": "先ほど入ってくるときに確認したのだが、この遺跡巨像も初期に生産されたタイプだ。間違いなく予備の動力系統を搭載していると思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260538
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260538,
					"content": "コア動力室は下層部にある。まずはどうにかしてそこへ辿り着こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260539,
					"content": "どうすればいいのか言って。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260540
					]
				},
				{
					"id": 730260540,
					"content": "あ、ああ。コア動力室は下層部にある。まずはどうにかしてそこへ辿り着かないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260530,
					"content": "つまり普通じゃないやり方があるんだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260531
					]
				},
				{
					"id": 730260518,
					"content": "学術研究を進める。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260519
					]
				},
				{
					"id": 730260519,
					"content": "ん？オイラたち、地下遺跡を調べに来たんだろ？研究も大事だけど、あのデカブツを起動させるのが先だぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260520
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730260506,
					"content": "#{M#君}{F#あなた}は妙論派の学者じゃなかった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260507
					]
				},
				{
					"id": 730260507,
					"content": "学派の垣根にとらわれるなど、愚の骨頂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260508
					],
					"speakerTitle": "ジャザリー"
				}
			]
		},
		{
			"id": 7302606,
			"completionStepIds": [
				7302603
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302603",
							"2"
						],
						"stepId": 7302603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730260601,
					"content": "うわっ、ほんとに起動した！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260616
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730260616,
					"content": "どうだ？この巨像の中の機械や中継装置、機械扉に至るまでが、すべてエネルギーブロックを動力にできるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260602
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260602,
					"content": "あれ？でも、しんと静まり返ってるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260603
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730260603,
					"content": "いや、それはこの予備の動力系統が、複数の小型エネルギー中継装置で構成されているからだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260604
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260604,
					"content": "つまり下層部から、すべてのエネルギー中継装置が連動しなければ、動力系統は作動しないのだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260605
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260605,
					"content": "すべての…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260606
					]
				},
				{
					"id": 730260606,
					"content": "この遺跡巨像の損傷具合からすると、フルパワー運転は明らかに難しそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260607
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260607,
					"content": "だが君たちが中継装置を起動している間に、動力室でこれを見つけた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260608
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260608,
					"content": "どうやら遺跡巨像の構造図のようだ。恐らくメンテナンス担当の乗務員が忘れていったものだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260609
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260609,
					"content": "この構造図を見る限りでは、主な中継装置を連動させることで機械は動き始めるはず…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260610
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260610,
					"content": "…少なくとも昇降装置を動かして、操縦室の辺りには行ける。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260611
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260611,
					"content": "なんか自信なさそうだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260612
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730260612,
					"content": "まあ、今は他に手がない。とにかく、昇降装置とリンクしている装置を動かしてみてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260613
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260613,
					"content": "え？一緒に来ないのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260614
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730260614,
					"content": "私はここに残って写…いや、遺跡巨像の内部構造を調べよう。これも大事な仕事だからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260615
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730260615,
					"content": "それに、学者の私が行っても役に立たないだろう？技術的な問題があったときは、聞きに来るといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジャザリー"
				}
			]
		},
		{
			"id": 7302607,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
