	"talks": [
		{
			"id": 7106402,
			"completionStepIds": [
				7106410
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106408",
							"3"
						],
						"stepId": 7106408,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710640201,
					"content": "（小さな石碑、文字が書かれている…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640202
					],
					"speakerTitle": "石碑"
				},
				{
					"id": 710640202,
					"content": "…「層岩巨淵の一戦を終え、我が四肢は麻痺してしまった。もはや話すことしかできないが、他の者に頼んでこれを刻む。」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640203
					],
					"speakerTitle": "石碑"
				},
				{
					"id": 710640203,
					"content": "…「塵戦の中、一命は取り留めたものの、亡き同胞を想うと、夜も眠れぬ。このような残躯となり果てて、共に行けぬ己が誠に歯がゆい。」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640204
					],
					"speakerTitle": "石碑"
				},
				{
					"id": 710640204,
					"content": "…「自死を試み、失敗に終わった。これが帝君のお耳に入り、叱責されて目が覚めた。」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640205
					],
					"speakerTitle": "石碑"
				},
				{
					"id": 710640205,
					"content": "…「帝君の仁慈にはまことに感服するばかりである。故に、この千岩軍の鎧を返そうと心に決めた。我が念はもう果たせそうになく、我が身に置いても塵が積もるのみ、縁ある者に授けよう。」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640206
					],
					"speakerTitle": "石碑"
				},
				{
					"id": 710640206,
					"content": "…「みなの者、もうこの一生では機会がないが、来世でも同胞となれたなら、共に盃を交わしつつ、また璃月の敵に抗おうぞ。」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "石碑"
				}
			]
		},
		{
			"id": 7106403,
			"completionStepIds": [
				7106411
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106411",
							"2"
						],
						"stepId": 7106411,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"望"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710640301,
					"content": "まさか本当に見つけるなんてな…これが「千岩軍の宝」か…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640302
					],
					"speakerTitle": "望"
				},
				{
					"id": 710640302,
					"content": "中に何が入ってるかは知らないが…宝を見つける者が現れて、当時それを残した千岩軍も嬉しく思っていることだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640303
					],
					"speakerTitle": "望"
				},
				{
					"id": 710640303,
					"content": "あの災いから五百年が経った。思えば五百年前、ここは無数の人々が犠牲となった戦場だったんだ。考えさせられるな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640304
					],
					"speakerTitle": "望"
				},
				{
					"id": 710640304,
					"content": "当時、岩王帝君と共に戦った無数の民たちは、自分たちが後世に何千年も残る大義に参加していると思えただろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640305
					],
					"speakerTitle": "望"
				},
				{
					"id": 710640305,
					"content": "彼らは自分の責務に、何の疑いも抱かなかったのだろうか…？「神の目」を手に入れることもできなかった凡人が、何故かつて彼らに眼差しを送らなかった神に忠誠を誓い、死ぬまで戦えたんだ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640306,
						710640307
					],
					"speakerTitle": "望"
				},
				{
					"id": 710640306,
					"content": "神は彼らのそばにずっといたから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710640308
					]
				},
				{
					"id": 710640308,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640309
					],
					"speakerTitle": "望"
				},
				{
					"id": 710640309,
					"content": "ああ、その通りだ。「神の目」があっても、なくても…人々は無限の可能性を秘めた未来のために努力する。それこそが、力となるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640310
					],
					"speakerTitle": "望"
				},
				{
					"id": 710640310,
					"content": "俺たちも同じさ。過ぎ去ったよき日々のためでなく、今の自分たちのためでもない…共に支え合いながら、この時代に自分たちの痕跡と声を残すためだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640311
					],
					"speakerTitle": "望"
				},
				{
					"id": 710640311,
					"content": "もしかしたら今後、層岩巨淵も俺たちの記念碑になるかもしれないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640314
					],
					"speakerTitle": "望"
				},
				{
					"id": 710640314,
					"content": "この無数の杭の跡は、何世代にもわたる鉱夫たちの汗と涙で…俺たちが選んだ険しい道を見届けてくれた証でもある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640312
					],
					"speakerTitle": "望"
				},
				{
					"id": 710640312,
					"content": "この記念石と同じように、この先百年、いや、千年もここに聳え立ち、戦士たちが忘れ去られていないことを証明するだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640313
					],
					"speakerTitle": "望"
				},
				{
					"id": 710640313,
					"content": "ははっ、俺はそれを見届けることはできそうにないな…だがその時になって、俺たち貧乏鉱夫のためにここで苦い酒を一杯注いでくれる人がいたら、俺は心底満足さ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "望"
				},
				{
					"id": 710640307,
					"content": "彼らは自分の選択に忠実だった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710640308
					]
				}
			]
		},
