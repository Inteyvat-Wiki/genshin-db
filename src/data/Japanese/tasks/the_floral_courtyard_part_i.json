				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"柴染"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726870101,
					"content": "こんにちは、ゆかりある方々。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870102
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870102,
					"content": "お二方の所作からは淡い香りが漂ってきます。それはきっと、趣あるものから受けた良い影響でしょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870103
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870103,
					"content": "#えっ、オイラたちからいい匂いがするのか？{NICKNAME}、おまえのニオイ、嗅がせてみろよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726870104,
					"content": "ホントだ！おまえから松茸の肉巻きの匂いがするぞ！このお姉さん、よく人を見てるな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870105,
						726870106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726870105,
					"content": "そういう匂いじゃないと思うけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870107
					]
				},
				{
					"id": 726870107,
					"content": "う～ん、このいつもの感じ…オイラ、分かったぞ！このお姉さんも、オイラたちに手伝ってほしいことがあるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726870108,
					"content": "お二方とも仕事を全うされている案内人。確かに、お二方のおかげで多くのお客さんがいらしてくれてはいますが、あなたたちにもお客人として、このお祭りを楽しんでいただきたいのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870109
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870109,
					"content": "もし時間がありましたら、こちらを試してみませんか？あなたたちだけの「花影瑶庭」を作ってみてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870110
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870110,
					"content": "「花影瑶庭」ってなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726870111,
					"content": "#{M#俺}{F#私}も詳しく知りたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870112
					]
				},
				{
					"id": 726870112,
					"content": "見ての通り、私は花職人です。このフラワースタンドに展示されているのは、「生け花」で作られた「花庭」となります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870113
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870113,
					"content": "丁寧に剪定された花を花器に入れ、様々な飾りを加えれば、机の上がまるで庭園のようになります。これが「花影瑶庭」、花芸の結晶です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870114
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870114,
					"content": "社奉行の協力を得て、私は「花影瑶庭」をいくつか持参して容彩祭に来ました。花芸の素晴らしさがお客人たちに伝われば幸いです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870115
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870115,
					"content": "もし「花影瑶庭」に興味がありましたら、今すぐ体験できますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870116
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870116,
					"content": "これが花芸の作品か…本当にきれいで、作る工程も優雅だな。でも、なんだか難しそうだぞ…オイラたちにできるかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870117,
						726870118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726870117,
					"content": "パイモンは少し不器用だからね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870119
					]
				},
				{
					"id": 726870119,
					"content": "心配する必要はありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870120
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870120,
					"content": "お客人たちに花芸の魅力を十分に感じていただけるよう、事前にいくつかの部分を作っておきました。「花影瑶庭」の作業を簡略化してあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870121
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870121,
					"content": "「御花」、「背景」、「敷物」を選び、適切に組み合わせるだけで、「花影瑶庭」は完成します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870122
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870122,
					"content": "もちろん、花芸の「表現」を体験するのが何よりも大切です。ですので、あなたたちの発想力を試すために、私は四つの「花題」を用意しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870123
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870123,
					"content": "「花題」を毎日こなすと、その記念に「花庭」と花材を持ち帰ることができます。それから、他にも賞品をお贈りしましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870124
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870124,
					"content": "ホントか？こんないい話があるなんて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726870125,
					"content": "#{NICKNAME}、このお姉さん、頑張って花芸を宣伝しているみたいだし、手伝ってやろうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870126,
						726870127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726870126,
					"content": "美しい花芸のために…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870128
					]
				},
				{
					"id": 726870128,
					"content": "よし！じゃあ、さっそく…えーっと、どうしたらいいんだっけ？ああ、そうだ！オイラたちの「花影瑶庭」を作るんだったな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870129
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726870129,
					"content": "お二方が花芸へと向けるお心と熱意に、感謝いたします…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870130
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870130,
					"content": "それではさっそく始めましょう。今日の「花題」は「揺れる紫櫻、澄んだ砂に薄香の花」となります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870131
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870131,
					"content": "花題の意味を理解した上で、花材と花器に注目して、あなたたちの「花影瑶庭」を作ってみてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870127,
					"content": "賞品のためにも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870128
					]
				},
				{
					"id": 726870118,
					"content": "パイモンは大雑把な作業のほうが得意。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870119
					]
				},
				{
					"id": 726870106,
					"content": "そうじゃないよ、パイモン…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870107
					]
				}
			]
		},
		{
			"id": 7268705,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7268702",
							"2"
						],
						"stepId": 7268702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"柴染"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726870201,
					"content": "容彩祭にいらしている方たちに、「花影瑶庭」の素晴らしさを伝えられるよう、これから数日間、私はここで案内をしてまいります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870202
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870202,
					"content": "お二方も「花題」を毎日解くのを忘れないでください。合計で四つの「花題」を用意していますので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870203
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870203,
					"content": "もちろん、何かご質問がありましたら、私もできる限りお答えいたします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870204,
						726870210,
						726870222
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870204,
					"content": "ここのお花について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870205
					]
				},
				{
					"id": 726870205,
					"content": "私が使っている花材はすべて、「咲耶の花屋」が提供してくれたものです。「咲耶の花屋」が栽培しているお花は、手頃な価格ながらもどれも質がいいんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870206
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870206,
					"content": "あなたたちは、すでに咲耶さんと会ったことがあるかもしれませんね。私たちは同じ先生のもとで「生け花」を学びました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870207
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870207,
					"content": "花芸について、咲耶さんも深い見識を持っています。ただ、容彩祭に大勢の人が来ることを聞いた途端、少し緊張してしまったようです。こういった環境では、落ち着いて生け花ができないとか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870208
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870208,
					"content": "ですので、私が代わりに「咲耶の花屋」を皆さんに勧めています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870209
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870209,
					"content": "機会があったら、オイラたちも手伝ってやるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870219
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726870219,
					"content": "他に何か質問はありますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870220
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870220,
					"content": "ありがとう、柴染さん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870221
					]
				},
				{
					"id": 726870221,
					"content": "いえ、どういたしまして。時間がありましたら、いつでも来てください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870210,
					"content": "社奉行について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870211
					]
				},
				{
					"id": 726870211,
					"content": "社奉行は、これまで稲妻の花芸事業を支えてきてくれました。もっと言うと、今回の催しのために出資してくださった貴人は、まさにあの白鷺の姫君なのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870212
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870212,
					"content": "白鷺の姫君は幼少の頃より、花芸に対して素晴らしい才を見せていました。私はあの方が花を生ける姿を見たことがあり、その心得についても語り合ったことがあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870213
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870213,
					"content": "私のほうが年上ではありますが、生け花の技術も花芸に対する理解も、あの方には及びません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870214
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870214,
					"content": "状況が許す限り、白鷺の姫君は「生け花」の持つ芸術性を広めるため、資金を毎年提供してくれます。時には、自分の貯蓄を使うこともあるようです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870215
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870215,
					"content": "白鷺の姫君は、以前このように自分の胸の内を打ち明けたことがありました——「生け花」をより多くの人に知ってもらい、花芸に興味を持っていただいて、それに精通してほしいと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870216
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870216,
					"content": "綾華、稲妻の花芸のためにそんなに頑張ってたんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870217
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726870217,
					"content": "彼女の願いが叶うといい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870218
					]
				},
				{
					"id": 726870218,
					"content": "ありがとうございます。お二方とも思いやりに溢れた方々なのですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870219
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870222,
					"content": "もう大丈夫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870223
					]
				},
				{
					"id": 726870223,
					"content": "時間がありましたら、いつでも来てください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柴染"
				}
			]
		}
	]
}