	"talks": [
		{
			"id": 7370101,
			"completionStepIds": [
				7370101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7370101",
							"2"
						],
						"stepId": 7370101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ズルヴァーン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 737010101,
					"content": "あら、ソルシュったら、元気がなさそうネェ。訓練で難関にでもぶつかったのかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010102
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 737010102,
					"content": "難関っていうか、困ってるっていうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737010103,
					"content": "先ほど話したことについて、ズルヴァーンに説明した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						737010104
					]
				},
				{
					"id": 737010104,
					"content": "なるほどネェ。人類が残す記録が、実際とは異なっているということは、珍しいことではないワ。元々忘れっぽくて、頑なな種族ですものネ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010105
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 737010105,
					"content": "でもね、世の中はおおよそそういうものだワ。傍観者は全体を俯瞰できるけれど、その細部までを熟知することは難しい。一方で、当事者は己の見解に囚われがちネ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010106
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 737010106,
					"content": "うーん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737010107,
					"content": "あまり慰めにはなってない気がする。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737010108
					]
				},
				{
					"id": 737010108,
					"content": "優しい言葉でソルシュを慰めてほしいのかしら？でも忘れないでちょうだいネ、これは彼女の訓練なの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010109
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 737010109,
					"content": "困難にぶつかった時は自分で工夫を凝らして解決を図る。これこそが訓練の目的じゃない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010110
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 737010110,
					"content": "一理あるな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737010111,
					"content": "これぐらいのことも乗り越えられないなら、ソルシュは花霊の勇者の称号にふさわしいとは言えないし、「二本角の花冠」の重さにも耐えられないと思うワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010112
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 737010112,
					"content": "そうなったら、いくら慈悲深い私でも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010113
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 737010113,
					"content": "は、花冠を没収されるのでしょうカ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010114
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737010114,
					"content": "罰の詳細は、本当に失敗した時に明かしまショウ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010115
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 737010115,
					"content": "うぅ…ソルシュの頭頂部を寒くさせないためにも、もっと頑張らないと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7370106,
			"completionStepIds": [
				7370106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7370106",
							"2"
						],
						"stepId": 7370106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ソルシュ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 737010601,
					"content": "見慣れた風景のはずなのに、なんだか複雑な気持ちだワ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010602
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737010602,
					"content": "えーと…ポジティブに考えれば、ソルシュが前より成長したってことだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010603
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737010603,
					"content": "成長か、はたまた退化なのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010604
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737010604,
					"content": "元気出せよ、ソルシュ！そんなしょんぼりした姿、おまえらしくないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010605
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737010605,
					"content": "そうだ、せっかくここまで来たんだし、「スケプティック団」設立当初の歴史を話してくれよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010606
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737010606,
					"content": "今はこんな有り様とは言え…設立当初はそれなりに良いところがあったんじゃないのか？じゃないと、ズルヴァーンがあいつらを助けたり、ソルシュが惹きつけられたりすることもないはずだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010607
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737010607,
					"content": "分かったワ。どうしても聞きたいのなら…でも前も言った通り、私が生まれたのはスケプティック団の設立後のことヨ。だから当時のことは、私も聞いた話でしか知らないワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010608
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737010608,
					"content": "全てが起こる前——その災難がもうすぐ起きるコトを伝えようとした純白の群れがいたそうなノ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010609
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737010609,
					"content": "でも情報を伝えるだけでは、災厄の降臨を阻止することはできなかった。間もなく、大地は漆黒の波に呑み込まれ、万物の命は恐怖に震えたワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010610
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737010610,
					"content": "この間、風蝕ウェネトの結晶を見たデショ？あのように、どんなに屈強な命あっても、あの災難から逃れることはできなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010611
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737010611,
					"content": "比べれば軟弱極まりない人類が、一目散に逃げたとしても責められはしないワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010612
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737010612,
					"content": "でも、その中には災厄の渦中を目指して突き進む人間もいた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010613
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737010613,
					"content": "それが当時のスケプティック団だったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010614
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737010614,
					"content": "そう。そしてその筆頭がナガルジュナだったノ。彼らは元々森の中の学者だったんだケド、災厄の余波を鎮圧するため、この地に根を下ろした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010615
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737010615,
					"content": "そうそう、それから金髪の人間もいた…先輩はあまり言及してなかったケド、少なくとも「面白い」人間だったに違いないワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010616
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737010616,
					"content": "#うーん…何百年も前の人じゃなかったら、{NICKNAME}とどっちが面白いか、対決してほしかったけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010617,
						737010618
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737010617,
					"content": "対決して何の意味が…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737010619
					]
				},
				{
					"id": 737010619,
					"content": "——続けるわヨ。私が生まれた頃には、災厄の余波もだいぶ落ち着いていたワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010620
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737010620,
					"content": "そしたら、ソルシュがやることってあまりなかったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010621
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737010621,
					"content": "うぅ…そうでもないワ。穢れが完全になくなることはないもの。でも…神鳥「シームルグ」のような壮絶な犠牲を払う必要はなくなったワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010622
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737010622,
					"content": "それに私よりも前に、ミヒルやラシュヌたちが既に、それぞれの役割を果たしていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010623
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737010623,
					"content": "ナガルジュナの後、先輩は次第にスケプティック団の人間との交流を断っていったケド、スケプティック団の人間は相変わらず花霊のことを気にしていたワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010624
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737010624,
					"content": "無理もナイと思う。彼らにとって、我ら花霊は頌歌の主人公なんだもノ。憧れの気持ちを抱くのも当たり前ネ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010625
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737010625,
					"content": "あの頃、彼らが声高らかに詩を詠みあげるのをよく見かけたワ。そうして神鳥の献身も、だんだん鮮明に見えてきた気がした。でも、先輩はいつもさらっと流すだけ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010626
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737010626,
					"content": "それって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010627
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737010627,
					"content": "人間の甘言につられた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737010628
					]
				},
				{
					"id": 737010628,
					"content": "そんなハズないワ。私は神鳥の慈悲と覚悟に感動したカラ、模倣することを決めたのヨ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010629
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737010629,
					"content": "スケプティック団の人間と付き合ったのは、彼らが過去のことを隠さずに教えてくれたからヨ…ま、まあ適度な褒め言葉もなくはなかったケド。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010630
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737010630,
					"content": "同じ話でも、ちょっと尾ひれをつけたほうが聞き手を惹きつけるもんだしな。オイラも面白い話を聞くのが大好きだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010631
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737010631,
					"content": "あっ！でも、真実の歴史を記録するって目的だったら、かなり問題だけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010632
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737010632,
					"content": "そうね…私もスケプティック団も、尾ひれをつけるのに慣れすぎてしまったのカモ。その結果が今に繋がっているんだと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010633
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737010633,
					"content": "スケプティック団の文献書籍には、単なる事実の記録のほかに、修飾語や主観的な解釈が溢れかえるようになった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010634
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737010634,
					"content": "…そして私は、行動よりも名声を重要視してしまうようになったノ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010635
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737010635,
					"content": "ソルシュ…遂に悟ったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010636
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737010636,
					"content": "少なくとも来た時と比べたら元気になったみたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737010637
					]
				},
				{
					"id": 737010637,
					"content": "うんうん、いいことだよな。へへ、これならズルヴァーンも花冠を没収だなんて言わないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010638
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737010638,
					"content": "ソルシュの訓練も残りあとちょっとだ。きっとズルヴァーンに認めてもらえるぞ！",
