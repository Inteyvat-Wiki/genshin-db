				"points": []
			},
			"dialogs": [
				{
					"id": 230360101,
					"content": "カイヴァンさん、新型の釣り餌をもう一度試してください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360102
					],
					"speakerTitle": "ホーベット"
				},
				{
					"id": 230360102,
					"content": "何回も試したが、全部同じ結果だったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360103
					],
					"speakerTitle": "カイヴァン"
				},
				{
					"id": 230360103,
					"content": "あれ？おまえら、また一緒に釣りをしてるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230360104,
					"content": "旅人、また会ったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360105
					],
					"speakerTitle": "カイヴァン"
				},
				{
					"id": 230360105,
					"content": "お二人とも、こんにちは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360106,
						230360107
					],
					"speakerTitle": "ホーベット"
				},
				{
					"id": 230360106,
					"content": "魚が釣れない原因は突き止めた？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230360108
					]
				},
				{
					"id": 230360108,
					"content": "はは、それがまったくないのさ。学者と釣り竿、釣り餌、やり方…いろんな点を改良した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360109
					],
					"speakerTitle": "カイヴァン"
				},
				{
					"id": 230360109,
					"content": "水場を変えてみたり、竿の角度も調整した…魚だらけの池も当然試したぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360110
					],
					"speakerTitle": "カイヴァン"
				},
				{
					"id": 230360110,
					"content": "だが…何をどうやっても、魚以外のものしか釣れないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360111
					],
					"speakerTitle": "カイヴァン"
				},
				{
					"id": 230360111,
					"content": "安心してください、カイヴァンさん。あの学者さんも研究を続けると約束してくれたじゃないですか。きっと原因を突き止めてくれますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360112
					],
					"speakerTitle": "ホーベット"
				},
				{
					"id": 230360112,
					"content": "ほら、新型の釣り餌も設計して、私をあなたの記録係に任命しました。釣りに関することは、それはもう細部まで記録していますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360113
					],
					"speakerTitle": "ホーベット"
				},
				{
					"id": 230360113,
					"content": "本当に原因を突き止められればいいんだが…とはいえ、それまでは自分のやり方で釣りを続けるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360114
					],
					"speakerTitle": "カイヴァン"
				},
				{
					"id": 230360114,
					"content": "旅人、もし暇だったら、釣り餌の材料を探してくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カイヴァン"
				},
				{
					"id": 230360107,
					"content": "学者に相談して、収穫はあった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230360108
					]
				}
			]
		},
