			"dialogs": [
				{
					"id": 230360601,
					"content": "よし、それじゃあ釣りをはじめるぞ。今度は必ず大物がかかる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360602
					],
					"speakerTitle": "カイヴァン"
				},
				{
					"id": 230360602,
					"content": "カイヴァンは釣り餌を作り、釣りを始めた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230360603
					]
				},
				{
					"id": 230360603,
					"content": "しばらくすると、びしょびしょの箱が釣れた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230360604
					]
				},
				{
					"id": 230360604,
					"content": "これは…見てみましょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360605
					],
					"speakerTitle": "ホーベット"
				},
				{
					"id": 230360605,
					"content": "おや？中身が…落とし物のようですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360606,
						230360607
					],
					"speakerTitle": "ホーベット"
				},
				{
					"id": 230360606,
					"content": "さすがカイヴァン。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230360608
					]
				},
				{
					"id": 230360608,
					"content": "うぅ…カイヴァンさんと一緒に、あの学者さんのもとで釣り餌を改良して以降、ずっと外で釣りをしていますが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360609
					],
					"speakerTitle": "ホーベット"
				},
				{
					"id": 230360609,
					"content": "カイヴァンさんは毎回毎回、変なものばかりを釣り上げるのです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360610
					],
					"speakerTitle": "ホーベット"
				},
				{
					"id": 230360610,
					"content": "落とし物、川底の鉱石、船から落ちた貨物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360611
					],
					"speakerTitle": "ホーベット"
				},
				{
					"id": 230360611,
					"content": "ある時は、うっかり水に落ちた冒険者が、カイヴァンさんの釣り糸を頼りに岸に上がってきたこともありました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360612
					],
					"speakerTitle": "ホーベット"
				},
				{
					"id": 230360612,
					"content": "しかし、こと魚に関しては、何一つ釣り上げられないのです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360613
					],
					"speakerTitle": "ホーベット"
				},
				{
					"id": 230360613,
					"content": "俺の釣り人生は、とうに終わりを告げたんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360614
					],
					"speakerTitle": "カイヴァン"
				},
				{
					"id": 230360614,
					"content": "カ、カイヴァンさん！そんなに落ち込まないでください！ほ…ほら、この落とし物の持ち主はきっと困っているはずです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360615
					],
					"speakerTitle": "ホーベット"
				},
				{
					"id": 230360615,
					"content": "落とし物が釣れたと知ったら、きっと喜びますよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360616
					],
					"speakerTitle": "ホーベット"
				},
				{
					"id": 230360616,
					"content": "それに、これを冒険者協会に届け出れば、報酬がもらえるかもしれません！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360617
					],
					"speakerTitle": "ホーベット"
				},
				{
					"id": 230360617,
					"content": "俺は…ただ…魚を…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360618
					],
					"speakerTitle": "カイヴァン"
				},
