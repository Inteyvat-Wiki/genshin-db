			"dialogs": [
				{
					"id": 3880301,
					"content": "ふう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3880302
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3880302,
					"content": "ヒルチャール…普通は元素濃度の高いエリアでしか活動しないんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3880303
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3880303,
					"content": "ここにいたら、体への負担が大きいはずなのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3880304
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3880304,
					"content": "アビス教団が裏で手を回したんだろう。しかし、僕たちがここに来ることに確証はなかったはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3880305
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3880305,
					"content": "僕たちの行動を阻止するため、おそらく教団はあちこちに兵を投下している。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3880306
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3880306,
					"content": "じゃあ、早速——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3880307
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3880307,
					"content": "今回の観客は「風」だけだし、弦を弾くスピードを速めてもいいよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウェンティ"
				}
			]
