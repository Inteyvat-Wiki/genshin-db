			"dialogs": [
				{
					"id": 3880101,
					"content": "暴風の<color=#00E1FFFF>障壁</color>だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3880102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3880102,
					"content": "うわぁ…もし、これに巻き込まれたらケガじゃすまないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3880103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3880103,
					"content": "僕に任せて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3880104
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3880104,
					"content": "今は普通のライアーしかないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3880105
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3880105,
					"content": "これくらいの風の障壁なら、「天空」を使うまでもない——って、ん？何あれ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3880106
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3880106,
					"content": "敵襲だ！全員戦闘準備！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジン"
				}
			]
		},
