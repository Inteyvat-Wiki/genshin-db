					"フェドフ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733410101,
					"content": "こんにちハ。あなたが噂に聞く異郷の「祭主」ネ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733410102
					],
					"speakerTitle": "フェドフ"
				},
				{
					"id": 733410102,
					"content": "異郷の「祭主」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733410103
					]
				},
				{
					"id": 733410103,
					"content": "そう。花霊と絆を結んだ勇士ガ、花海を訪れてるって噂を聞いたノ。前回、儀式が行われタのはもう何百年と前のことだワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733410104
					],
					"speakerTitle": "フェドフ"
				},
				{
					"id": 733410104,
					"content": "昔、花霊と人間はともに「甘露花海」で暮らしていたノ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733410105
					],
					"speakerTitle": "フェドフ"
				},
				{
					"id": 733410105,
					"content": "黒淵の脅威に立ち向かわなければならなかったにも関わらズ、「万種母樹」と霊光による庇護のお陰デ、花海は穢れの浸蝕を受けずに済んダ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733410106
					],
					"speakerTitle": "フェドフ"
				},
				{
					"id": 733410106,
					"content": "あれカラ長い長い月日が経った今でも、私の記憶の中で一番美しいのハ、あの時の花海なのヨ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733410107,
						733410108
					],
					"speakerTitle": "フェドフ"
				},
				{
					"id": 733410107,
					"content": "#{M#君}{F#あなた}は誰？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733410110
					]
				},
				{
					"id": 733410110,
					"content": "私は「甘露の池」の管理を任された花霊ヨ。花海がズルヴァーン様の指示で閉鎖されてカラ、私は一度もここを離れたことがないノ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733410111
					],
					"speakerTitle": "フェドフ"
				},
				{
					"id": 733410111,
					"content": "「甘露の池」とは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733410112
					]
				},
				{
					"id": 733410112,
					"content": "「甘露の池」ハ、私たち花霊に命を与えた場所であり、神様が残してくださった「原初の水」ヨ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733410113
					],
					"speakerTitle": "フェドフ"
				},
				{
					"id": 733410113,
					"content": "大地に散らばった「霊光」百種も、甘露によってその命と力を与えられたものなノ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733410114
					],
					"speakerTitle": "フェドフ"
				},
				{
					"id": 733410114,
					"content": "私たちは最後まで力を使い果たすと、純粋な記憶だけを残しテ「浄光の羽根」と化すのヨ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733410115
					],
					"speakerTitle": "フェドフ"
				},
				{
					"id": 733410115,
					"content": "そして最後には霊光に属する全ての記憶さえモ、「甘露の池」を通じて「万種母樹」へと還ってゆク。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733410116
					],
					"speakerTitle": "フェドフ"
				},
				{
					"id": 733410116,
					"content": "甘露の潤いがある限リ、どんな苦しみや悲しみも全テ浄化されるノ。そうして最後には再ビ、純粋な霊光の眷属になるのヨ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733410117
					],
					"speakerTitle": "フェドフ"
				},
				{
					"id": 733410117,
					"content": "力を使い果たした霊光の眷属を花海へと返してくれる人、それが「祭主」なノ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733410118
					],
					"speakerTitle": "フェドフ"
				},
				{
					"id": 733410118,
					"content": "けれど、人間の勇士がしかるべき責務を放棄したせいデ、穢れと戦って力尽きた花霊は二度と花海に返ることができなくなってしまっタ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733410119
					],
					"speakerTitle": "フェドフ"
				},
				{
					"id": 733410119,
					"content": "そして今、再び人間の勇士が現れタ。各地に散らばった「浄光の羽根」も、これでようやく此処に還ってこられるワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733410120
					],
					"speakerTitle": "フェドフ"
				},
				{
					"id": 733410120,
					"content": "「甘露の池」に奉納さえすれバ、どんな追憶も受け入れらレ、水と樹の恩恵を受けることができル。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733410121
					],
					"speakerTitle": "フェドフ"
				},
				{
					"id": 733410121,
					"content": "これも神様の慈悲あってのコト。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フェドフ"
				},
				{
					"id": 733410108,
					"content": "言ってることがよく分からないけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733410109
					]
				},
				{
					"id": 733410109,
					"content": "私には分かるワ。あなたは確かに、花霊との間に「ラウ{RUBY#[S]繋がり}パ」を築いた人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733410110
					],
					"speakerTitle": "フェドフ"
				}
			]
		}
	]
}