				]
			},
			"dialogs": [
				{
					"id": 401440101,
					"content": "あら、可愛い子ちゃん。今日はどうしたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440102
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 401440102,
					"content": "お目当ては本かしら？それとも、お姉さんに会いに来てくれたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440103,
						401440105
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 401440103,
					"content": "リサさんに会いに来た。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440104
					]
				},
				{
					"id": 401440104,
					"content": "ふふっ、相変わらず優しい子ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440107
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 401440107,
					"content": "でも、あいにく今は仕事があって、しばらくはアフタヌーンティーに招待してあげられないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440108
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 401440108,
					"content": "えっ！リサさんが真面目に仕事してるなんて、珍しいな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401440109,
					"content": "確かにそうね。前回こうして研究に没頭したのは、まだ教令院にいた頃だったもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440110
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 401440110,
					"content": "久しぶりに真面目に考え事をしたら、ちょっと疲れちゃったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440111,
						401440112
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 401440111,
					"content": "もしかして論文を書いてるの…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440113
					]
				},
				{
					"id": 401440113,
					"content": "ふふっ、そんなに興味があるのなら、あなたも参加してみない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440114
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 401440114,
					"content": "お姉さんと一緒に、学生時代をもう一度体験してみるのはどうかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440115
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 401440115,
					"content": "急に仕事を押し付けるなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401440116,
					"content": "まあ、嫌なの？お姉さんと一緒に困難を乗り越える、せっかくのチャンスなのに。ちなみに、報酬もかなり豪華なのよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440117,
						401440118
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 401440117,
					"content": "詳しく聞かせて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440119
					]
				},
				{
					"id": 401440119,
					"content": "あなたも知っていると思うけど、騎士団はずっと錬金術の研究をしてるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440120
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 401440120,
					"content": "でも、大半の研究は実験室で行われるでしょう？だから人々は錬金術のことを、あまり詳しく知らないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440121
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 401440121,
					"content": "多額の資金を費やした研究は、結局あまり多くの役割を果たせていなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440122
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 401440122,
					"content": "そこで、ジンは錬金術の成果を一般人に広めることにしたの。ひとまず、「錬金薬」をね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440123
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 401440123,
					"content": "わたくしは普段、図書館のことだけでなく、騎士団が提供する薬剤の管理を手伝っているわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440124
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 401440124,
					"content": "薬剤学はわたくしの研究分野の一つなの。ジンからすると、わたくしはこの仕事にぴったりだと思ったんでしょうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440125
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 401440125,
					"content": "ただ、人々が日々必要としているものを提供するって観点から見れば、素材を少し調整して、錬成方法も適度に簡略化する必要があるわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440126
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 401440126,
					"content": "そうなると…簡単だと思っていた研究が、ちょっと複雑になってきたのよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440127
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 401440127,
					"content": "つまり、オイラたちにその研究を手伝ってほしいのか？でも錬金術の理論なんて、オイラたちよく知らないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401440128,
					"content": "ふふっ、違うわ。お姉さん、もっとあなたたちに相応しい仕事を思いついちゃったのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440129
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 401440129,
					"content": "錬成技術の研究は着実に進んでいるけれど、実際に使った人々からのフィードバックが得られなければ、みんなのニーズに答えられるかどうかは分からない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440130
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 401440130,
					"content": "でも、薬を開発しながら意見を集めるとなると、より効率的な方法が必要になってくるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440131
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 401440131,
					"content": "そこで、わたくしはひらめいたの——直接錬金薬を売るお店を開けばいいのよ。そうすれば、薬を作りながら、日常的な需要についても調査できるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440132
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 401440132,
					"content": "おおっ、さすがリサさんだぞ！二つの仕事をいっぺんにやるってことか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440133
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401440133,
					"content": "そういうこと。そして、この仕事に一番ぴったりなのが、我らが騎士団のエリート——旅人よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440134
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 401440134,
					"content": "教令院にいた頃も、よく学生同士で研究を手伝い合ったものだわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440135
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 401440135,
					"content": "可愛い子ちゃん、こんな青春を体験してみたくない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440136
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 401440136,
					"content": "なんかいい感じに言ってるけど、ほんとはサボりたいだけなんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440137,
						401440139
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401440137,
					"content": "リサさんのためだと思って…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440138
					]
				},
				{
					"id": 401440138,
					"content": "ふふっ、分かってたわ。やっぱりあなたってとっても頼りになるわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440141
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 401440141,
					"content": "仕事が一段落したら、お姉さんが直々に報酬を用意してあげるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440142
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 401440142,
					"content": "もう、お店を開くための事前準備は終わってるの。あとのことは、向こうに着いてから話しましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リサ"
				},
				{
					"id": 401440139,
					"content": "自分へのチャレンジだと思って…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440140
					]
				},
				{
					"id": 401440140,
					"content": "ええ、気合い十分ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440141
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 401440118,
					"content": "どんな仕事かによるけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440119
					]
				},
				{
					"id": 401440112,
					"content": "もしかして何か研究してるの…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440113
					]
				},
				{
					"id": 401440105,
					"content": "ちょうど通りかかったから…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440106
					]
				},
				{
					"id": 401440106,
					"content": "それで、お喋りしに寄ってくれたのね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440107
					],
					"speakerTitle": "リサ"
				}
			]
		},
		{
			"id": 4014402,
