			"dialogs": [
				{
					"id": 401440601,
					"content": "栽培にも慣れてきたみたいね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440602
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 401440602,
					"content": "そうそう、後方支援部隊の騎士が着いたの。彼女が定期的に新しい物資を補給してくれるから、あとで挨拶しておいてちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440603
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 401440603,
					"content": "あとのことはあなたに任せるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440604
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 401440604,
					"content": "リサさんは何担当なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440605
					]
				},
				{
					"id": 401440605,
					"content": "そうだぞ、なんでオイラたちだけが忙しくしてるんだ…リサさんはなにしてるんだよ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440606
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401440606,
					"content": "わたくし？もちろん、可愛い子ちゃんが経営と錬金術のコツをうまく掴めるように、サポートしているのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440607
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 401440607,
					"content": "お姉さん、ずっと応援しているわ。頑張ってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440608
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 401440608,
					"content": "やっぱりな…オイラ、こうなるってわかってたぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
