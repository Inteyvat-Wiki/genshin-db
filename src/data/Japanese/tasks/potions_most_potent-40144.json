			"dialogs": [
				{
					"id": 401440701,
					"content": "栄誉騎士さん、そして侍従のパイモンさん、こんにちは！後方支援部隊の騎士、フレダです。どうぞよろしくお願いします！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440702
					],
					"speakerTitle": "フレダ"
				},
				{
					"id": 401440702,
					"content": "おお、オイラの名前ってもうそんなに知られてるのか…って、侍従なんかじゃないぞ！オイラはこいつの仲間だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440703
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401440703,
					"content": "すみません、うっかりしていました。流行りの小説の呼び方がうつってしまって…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440704
					],
					"speakerTitle": "フレダ"
				},
				{
					"id": 401440704,
					"content": "貴方たちの功績はもはや、伝説みたいなものです。本当に羨ましい…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440705
					],
					"speakerTitle": "フレダ"
				},
				{
					"id": 401440705,
					"content": "私も各地を冒険する流浪の騎士になりたいです。そういう暮らしはきっと面白いだろうなって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440706,
						401440708
					],
					"speakerTitle": "フレダ"
				},
				{
					"id": 401440706,
					"content": "これから機会があるかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440707
					]
				},
				{
					"id": 401440707,
					"content": "はい、私もそう願っています！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440710
					],
					"speakerTitle": "フレダ"
				},
				{
					"id": 401440710,
					"content": "とにかく、今は目の前の仕事をきっちり終わらせましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440711
					],
					"speakerTitle": "フレダ"
				},
				{
					"id": 401440711,
					"content": "代理団長から、貴方たちの経営を全力でサポートするようにと指示を受けました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440712
					],
					"speakerTitle": "フレダ"
				},
				{
					"id": 401440712,
					"content": "何か必要なものがあれば、いつでも言ってくださいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440713,
						401440715
					],
					"speakerTitle": "フレダ"
				},
				{
					"id": 401440713,
					"content": "物資の購入について。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440714
					]
				},
				{
					"id": 401440714,
					"content": "最近、新しい物資が届いたばかりです。必要なものがないか、ぜひご確認ください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フレダ"
				},
				{
					"id": 401440715,
					"content": "さようなら。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440716
					]
				},
				{
					"id": 401440716,
					"content": "経営がうまく行きますように！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フレダ"
				},
				{
					"id": 401440708,
					"content": "実はそんなに楽なものじゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440709
					]
				},
				{
					"id": 401440709,
					"content": "そうですね。小説に出てくるそういう騎士はみんな、危険だらけの毎日を生きています…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440710
					],
					"speakerTitle": "フレダ"
				}
			]
