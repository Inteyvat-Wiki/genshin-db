					"nextDialogs": [
						4900332
					],
					"speakerTitle": "アビスの魔術師"
				},
				{
					"id": 4900333,
					"content": "待て！くっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900334
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 4900334,
					"content": "追うぞ…ゴホッ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900335
					],
					"speakerTitle": "ジン"
				},
				{
