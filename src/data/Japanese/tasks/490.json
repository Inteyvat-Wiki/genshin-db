					"nextDialogs": [
						4900337
					]
				},
				{
					"id": 4900337,
					"content": "ジンを狙った罠かも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4900338
					]
				},
				{
					"id": 4900335,
					"content": "ジン、やっぱり…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900336
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4900338,
					"content": "ダメだ、私は行かなくては…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900339
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 4900339,
					"content": "はぁ、また無理してるな。安心しろ、オイラたちがとっちめてきてやる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900340
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4900340,
					"content": "いや、君たちを信頼していない訳ではないんだ…ただ、目の前の敵を置いて逃げるのは、職責を果たさぬことと同じだから…",
