					"nextDialogs": [
						4900342
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4900342,
					"content": "理解してくれてありがとう。ああ、お願いしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジン"
				}
