			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"バーバラ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4900101,
					"content": "バーバラ、戻ってきたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4900102,
					"content": "おかえりなさい、お疲れ様。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900103
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 4900103,
					"content": "ジンの調子は良くなった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4900104
					]
				},
				{
					"id": 4900104,
					"content": "バーバラもお疲れ様。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4900105
					]
				},
				{
					"id": 4900105,
					"content": "大丈夫だよ、患者さんの介抱は元々私の仕事だから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900106
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 4900106,
					"content": "ジンももう意識を取り戻したから安心して。まだ体調は万全じゃないけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900107
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 4900107,
					"content": "本当か！？よかったな、ジンに会っても大丈夫か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4900108,
					"content": "実は今、大聖堂を出ていったばかりなの。もう少し休んでって言ったのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900109
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 4900109,
					"content": "…ジンが「もう大丈夫だ」って言って聞かなくて。多分、また<color=#00E1FFFF>ヴァネッサ様のところ</color>に行ったんだと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900110
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 4900110,
					"content": "「ヴァネッサ様」のところ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4900111,
					"content": "えっと、大英雄ヴァネッサ様を象徴する、<color=#00E1FFFF>風立ちの地にあるあの木</color>のことだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900112
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 4900112,
					"content": "ジンは何か迷いを感じた時、いつもそこに行くから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900113
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 4900113,
					"content": "そんなことまで知ってるなんて、バーバラはジンのことに詳しいんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4900114,
					"content": "…そ、それはジンがここを出る時にそう言ってただけだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900115
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 4900115,
					"content": "ジンの体はまだ本調子じゃないんでしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4900116
					]
				},
				{
					"id": 4900116,
					"content": "ジンを一人にして大丈夫？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4900117
					]
				},
				{
					"id": 4900117,
					"content": "私も心配なんだけど、仕事がまだ終わってないから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900118
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 4900118,
					"content": "分かった、ジンのことはオイラたちに任せろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4900119,
					"content": "ありがとう！それなら安心できるよ。あなたたちに…そしてジンに、風神のご加護があらんことを。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "バーバラ"
				}
			]
		},
		{
			"id": 49003,
			"completionStepIds": [
				49003
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"49003",
							"2"
						],
						"stepId": 49003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ジン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4900301,
					"content": "ジン、体は大丈夫なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4900302,
					"content": "ああ、もう平気だ。君たちがここに来るとは思わなかった。気遣いに感謝する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900303
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 4900303,
					"content": "本当か？さっきジンの後ろ姿を見た時…疲れてるように見えたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4900305,
					"content": "騎士団のみんなをもっと頼っていい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4900306
					]
				},
				{
					"id": 4900306,
					"content": "こっちをもっと頼ってくれ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4900307
					]
				},
				{
					"id": 4900304,
					"content": "少し無理しすぎじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4900307,
					"content": "ああ…君たちのその気持ちだけで、十分に元気が湧いてくるよ。ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900308
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 4900308,
					"content": "しかし、この程度のことをひとりで片付けられないとは…私ではヴァネッサ様のようにモンドを守れないだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900309
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 4900309,
					"content": "ジンは、ヴァネッサにすごく憧れてるんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4900310,
					"content": "ああ、最初の騎士団団長であるヴァネッサ様は強くてお優しい方だ。私は、その歩みをずっと追いかけてきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900311
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 4900311,
					"content": "「獅牙騎士」の勇猛さをもってして旧貴族の支配を撤廃し、「蒲公英騎士」として西風騎士団を作り上げ、モンドを守ってきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900312
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 4900312,
					"content": "「蒲公英騎士」って…ジンのことじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4900313,
					"content": "「蒲公英騎士」も「獅牙騎士」も、歴代の騎士団が継承してきた称号だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900314
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 4900314,
					"content": "ほぇー、そうなのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900315
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4900315,
					"content": "じゃあ、今のジンは優しい「蒲公英騎士」であり、強い「獅牙騎士」でもあるんだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900316
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4900316,
					"content": "ヴァネッサ様の称号を継承できたのは、とても光栄なことだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900317
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 4900317,
					"content": "私にとって、それは責任を意味する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900318
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 4900319,
					"content": "「獅牙騎士」もジンにぴったり。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4900320
					]
				},
				{
					"id": 4900320,
					"content": "やはり「蒲公英騎士」の方がジンらしい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4900321
					]
				},
				{
					"id": 4900318,
					"content": "なにせ、その名を名乗るには「強さ」が必要だから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900319
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 4900321,
					"content": "そうだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900322
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4900322,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900323
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 4900323,
					"content": "ジン？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900324
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4900324,
					"content": "そこにいるのは誰だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900325
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 4900326,
					"content": "フン…やはり気付かれたか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900327
					],
					"speakerTitle": "アビスの魔術師"
				},
				{
					"id": 4900327,
					"content": "弱っている騎士団長を倒すチャンスだったというのに、まさか邪魔者が入るとは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900328
					],
					"speakerTitle": "アビスの魔術師"
				},
				{
					"id": 4900328,
					"content": "…ジンが不調だって話、やつらに漏れてたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900329
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4900329,
					"content": "こんなタイミングを狙ってくるなんて、ヒキョーだぞ！",
