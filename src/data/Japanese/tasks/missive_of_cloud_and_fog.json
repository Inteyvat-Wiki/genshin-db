			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ニムロド"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414111401,
					"content": "はぁ、どうしたことか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111402
					],
					"speakerTitle": "ニムロド"
				},
				{
					"id": 414111402,
					"content": "おまえがニムロドか？ガイアから用事があるって聞いたんだけど、アイツは今忙しいからオイラたちが代わりに手伝うよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414111403,
					"content": "ん？旅人、君か。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111404
					],
					"speakerTitle": "ニムロド"
				},
				{
					"id": 414111404,
					"content": "俺の女房に風花祭のプレゼントを用意したいんだが、酒仲間のガイアにアドバイスをもらいたくてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111405
					],
					"speakerTitle": "ニムロド"
				},
				{
					"id": 414111405,
					"content": "その…お、俺は酒が大好きだから、いつも酒場に入り浸ってるんだ…でも女房は酒を飲むのに反対しててな、いつもそれで喧嘩してる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111406
					],
					"speakerTitle": "ニムロド"
				},
				{
					"id": 414111406,
					"content": "おまえも飲んだくれだったのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111407
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414111407,
					"content": "分かるよ、酒はいいものだからね！でも君の飲み方は…うん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111408
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 414111408,
					"content": "頭では分かってるんだ。だからこそ、申し訳ないと思ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111409
					],
					"speakerTitle": "ニムロド"
				},
				{
					"id": 414111409,
					"content": "旅人、悪いけど材料集めを手伝ってくれないか？手作りのプレゼントを女房に送りたくてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111410
					],
					"speakerTitle": "ニムロド"
				},
				{
					"id": 414111410,
					"content": "こういうのは自分で集めるべきなんだが、酒を飲み過ぎて眠ってしまって…起きた時にはもうセレモニーが始まってたんだ！自分一人の力じゃ、もう間に合いそうにない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111411
					],
					"speakerTitle": "ニムロド"
				},
				{
					"id": 414111411,
					"content": "無茶苦茶すぎるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111412
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414111412,
					"content": "セレモニー期間中に他の人に頼るなんて、未婚のモンド人なら絶対にありえないことだよ。ニムロド、結婚しててよかったね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111413
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 414111413,
					"content": "ああ…本当にすまない、返す言葉もない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111414
					],
					"speakerTitle": "ニムロド"
				},
				{
					"id": 414111414,
					"content": "仕方ないな。なにが必要なんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111415
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414111415,
					"content": "俺は城内で木材を集める。植物は野外でしか採れないから、頼まれてくれるか。イグサが2つ必要なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111416
					],
					"speakerTitle": "ニムロド"
				},
				{
					"id": 414111416,
					"content": "イグサと木材でなにができるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111417
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414111417,
					"content": "木材を使って小さな小屋を作るんだ。それに煌びやかな花と手作りの家具を付け加えて…女房に送る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111418
					],
					"speakerTitle": "ニムロド"
				},
				{
					"id": 414111418,
					"content": "とても温かなプレゼントだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111419
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 414111419,
					"content": "ほんの気持ちさ、ははっ。女房と出会ったばかりの頃は、いつも手作りのプレゼントを送っていた。それを女房も気に入ってくれてて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111420
					],
					"speakerTitle": "ニムロド"
				},
				{
					"id": 414111420,
					"content": "ゴホンッ！悪い、昔のことだ、気にするな。とにかく、頼んだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111421
					],
					"speakerTitle": "ニムロド"
				},
				{
					"id": 414111421,
					"content": "運が良かったな、オイラたちみたいな頼もしい助っ人が来てくれて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111422
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414111422,
					"content": "さあ、行こう！材料を集めるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
