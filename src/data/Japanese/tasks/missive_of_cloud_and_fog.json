			"dialogs": [
				{
					"id": 414110301,
					"content": "ありがとう、本当にありがとう！これがあれば、すぐに作業を始められる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110302
					],
					"speakerTitle": "ニムロド"
				},
				{
					"id": 414110302,
					"content": "プレゼントだけじゃなくて、これからは奥さんのことも大切にしろよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414110303,
					"content": "ああ、必ずそうする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110304
					],
					"speakerTitle": "ニムロド"
				},
				{
					"id": 414110304,
					"content": "俺の作ったプレゼント、気に入ってくれるといいなあ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110305
					],
					"speakerTitle": "ニムロド"
				},
				{
					"id": 414110305,
					"content": "気持ちのこもったプレゼントを嫌う人はいない。だから安心して。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110306
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 414110306,
					"content": "オイラたちの努力を無駄にしないよう、ちゃんと作れよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
