						414110706
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414110706,
					"content": "やあ二人とも、久しぶり。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110707
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 414110707,
					"content": "ここで何してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414110708
					]
				},
				{
					"id": 414110708,
					"content": "本当に久しぶりだな。見ての通り、リサと一緒に見回りをしている最中だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110709
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 414110709,
					"content": "可愛い子ちゃんとそのお友達じゃない。ここに来る途中、怪しい人を見かけなかったかしら？もし見かけたなら騎士団に報告してくれると助かるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110710
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 414110710,
					"content": "図書館司書も見回りするのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110711
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414110711,
					"content": "普段はしないわ。でも風花祭は人手不足だから、わたくしみたいにか弱い人でも、見回りを手伝わされるのよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110712
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 414110712,
					"content": "リサ、か弱い人はそのような強力な雷元素の力を使えない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110713
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 414110713,
					"content": "しかし、安心してくれ。たとえリサが酔っ払いのケンカを電撃で仲裁するのが好きだとしても…私がしっかり見張っておく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110714
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 414110714,
					"content": "ジンが嫌なら、もうしないわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110715
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 414110715,
					"content": "本当か？それはよかった。もう少しで、私と同行する資格を図書館司書さんから剥奪していたところだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110716
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 414110716,
					"content": "見回りってそんなに刺激的な活動だったんだな。勉強になったぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
