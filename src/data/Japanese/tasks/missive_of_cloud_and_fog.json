			"dialogs": [
				{
					"id": 414110501,
					"content": "帰ったぞ！ガイア、課題は終わったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414110502,
					"content": "さあ、課題を取りに来たよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110503
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 414110503,
					"content": "おかえり、ちょうど終わったところだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110504
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 414110504,
					"content": "早く早く、課題課題～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414110505,
					"content": "はいよ、笑うんじゃないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110506
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 414110506,
					"content": "ふむ…ふむ。うん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110507
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 414110507,
					"content": "吟遊野郎、評価は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110508
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414110508,
					"content": "ガイア、この詩を読んでもいいかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110509
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 414110509,
					"content": "もちろん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110510
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 414110510,
					"content": "ゴホンッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110511
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 414110511,
					"content": "「mi muhe ye\\nヒルチャールの言語で\\n愛してる。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110512
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 414110512,
					"content": "ん？んん？？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110513
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414110513,
					"content": "おしまい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110514
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 414110514,
					"content": "それだけ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110515
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414110515,
					"content": "主旨がはっきりしていて、感情も完璧。この長さで十分伝わると思うが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110516
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 414110516,
					"content": "えええ！？これじゃヒルチャール語のレッスンになってるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110517,
						414110518
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414110517,
					"content": "伝わってるのかな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414110519
					]
				},
				{
					"id": 414110519,
					"content": "アハハッ、俺らしい詩だと思わないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110520
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 414110520,
					"content": "いい加減な詩だと思うけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110521
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 414110521,
					"content": "ガイアはヒルチャール語ができたのか？なんか変わってるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110522
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414110522,
					"content": "ハハッ、西風騎士団騎兵隊長の知識の広さを侮ってもらっちゃ困る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110523
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 414110523,
					"content": "よし、じゃあそろそろ次の…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110524
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 414110524,
					"content": "——！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110525
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 414110525,
					"content": "今、怪しい人影が見えた、少し見に行ってくる。旅人、もう一つ用事を頼みたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110526
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 414110526,
					"content": "教会から狩りの許可の申請が来ている、この許可書類を大聖堂まで届けてほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110527
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 414110527,
					"content": "はぁ、またおつかいかよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414110518,
					"content": "勉強になった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414110519
					]
				}
			]
		},
