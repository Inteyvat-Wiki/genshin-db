			"dialogs": [
				{
					"id": 414110701,
					"content": "リサ、たとえ相手が騒ぎを起こしている酔っ払いでも、放電を使って懲らしめることはしないと約束してくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110702
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 414110702,
					"content": "それは誤解よジン。あなたが前に見たあれは、あっちから求めてきたのよ。だから、そういうことが好きな人もいるのかと思って…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110703
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 414110703,
					"content": "リサ！",
