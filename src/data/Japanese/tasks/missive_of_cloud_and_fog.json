			"dialogs": [
				{
					"id": 414111501,
					"content": "吟遊野郎はもう着いてると思うから、オイラたちも中に入ろうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414111502,
					"content": "止まってくれ！ここに何か用か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111503
					],
					"speakerTitle": "アトス"
				},
				{
					"id": 414111503,
					"content": "ガイアはいるか？アイツに用があるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414111504,
					"content": "ガイア隊長なら、ジン団長の執務室で勤務中だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111505
					],
					"speakerTitle": "アトス"
				},
				{
					"id": 414111505,
					"content": "えっ、どうしてジン団長の執務室に？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111506
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414111506,
					"content": "風花祭セレモニーは、我々西風騎士団が主催している。セレモニー期間中は、ジン団長が直々に外回りを行う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111507
					],
					"speakerTitle": "アトス"
				},
				{
					"id": 414111507,
					"content": "だから溜まった書類仕事は、ガイア隊長が代理で処理することになっているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111508
					],
					"speakerTitle": "アトス"
				},
				{
					"id": 414111508,
					"content": "なるほど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
