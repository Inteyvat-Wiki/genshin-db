					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 414111023,
					"content": "そちらのシスターさんも、一緒にどう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111024
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 414111024,
					"content": "私は遠慮するわ…大した事件でもないみたいだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111025
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 414111025,
					"content": "ん？なにか言ったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111026
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414111026,
					"content": "なんでもないわ。いってらっしゃい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111027
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 414111027,
					"content": "バーバラさん、具合はどう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111028
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 414111028,
					"content": "うん！わ、私は大丈夫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111029
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 414111029,
					"content": "ロサリアさんの言う通り、考えて怯えるくらいなら、犯人を突き止めた方がいいもんね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111030
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 414111030,
					"content": "そうだな、一緒に行こう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111031
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414111031,
					"content": "みんなありがとう。じゃあ、今から地図の場所に行ってみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111032
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 414111032,
					"content": "よし、バーバラ、いっくよ——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 4141113,
			"completionStepIds": [
				4141113
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4141113",
							"2"
						],
						"stepId": 4141113,
						"stateName": "QUEST_STATE_UNFINISHED"
