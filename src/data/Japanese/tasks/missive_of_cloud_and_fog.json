				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"バーバラ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414111302,
					"content": "なんだこれ？早く開けてみよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414111303,
					"content": "私、私…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111304
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 414111304,
					"content": "これほど精巧なギフト箱がこんな荒野にあるなんて、実に興味深いね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111305
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 414111305,
					"content": "……あれ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111306
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 414111306,
					"content": "わぁ、丁寧に作られた風車アスターの花冠だ！紙の星もいっぱいあるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111307,
						414111308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414111307,
					"content": "いたずらかな？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414111309
					]
				},
				{
					"id": 414111309,
					"content": "どうやら、「犯人」はバーバラさんのファンみたいだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111310
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 414111310,
					"content": "もう一枚紙があるぞ？なにか書いてあるな…どれどれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414111311,
					"content": "「このような方法で気を引いてすみません、あなたの美徳と可愛さに誠意を込めて風の花を献上します。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414111312,
					"content": "え？脅迫状じゃなかったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414111313,
					"content": "神、大切な人、愛する人に対し、最大限の気持ちを込めて花を送る。それこそが、風花祭のテーマだからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111314
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 414111314,
					"content": "この特別な日に、愛と祝福の花を君に送るため、こんな手段を使ったわけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111315
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 414111315,
					"content": "怖そうな内容だったけど、誠意が込められたプレゼントだったってことだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111316
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 414111316,
					"content": "うぅ、そんな…だとしても非常識だぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111317
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414111317,
					"content": "あははっ、そうだね。でもそういう人、一人心当たりがあるけど？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111318
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 414111318,
					"content": "誰のことだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111319
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414111319,
					"content": "#（{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}も分かったような。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414111320
					]
				},
				{
					"id": 414111320,
					"content": "シーッ…まだ言わないでおこう。パイモンに当てさせよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111321
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 414111321,
					"content": "えぇ！なんでだよ——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414111308,
					"content": "注意を引くため？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414111309
					]
				}
			]
		},
		{
			"id": 4141114,
			"completionStepIds": [
				4141114
			],
			"beginWay": "TALK_BEGIN_MANUAL",
