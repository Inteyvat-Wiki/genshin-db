			"dialogs": [
				{
					"id": 414110101,
					"content": "ヤッホー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414110102,
					"content": "旅人、パイモン、来たね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110103
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 414110103,
					"content": "いいタイミングに来た、ちょうどお前たちのことを考えてたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110104
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 414110104,
					"content": "ガイア、課題は終わったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414110105,
					"content": "失望させてしまうかもしれないが、まだ手を付けてすらいないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110106
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 414110106,
					"content": "課題を提出しない生徒は、いい生徒じゃないね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110107
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 414110107,
					"content": "ガイア、忙しいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414110108,
					"content": "ああ、見ての通り、ジン団長の代わりに様々な事務を処理していてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110109
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 414110109,
					"content": "セレモニー期間中はモンド城も賑わうから、雑用仕事も多くなるんだ。もうずっと忙しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110110
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 414110110,
					"content": "旅人、一つ手伝ってもらえないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110111
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 414110111,
					"content": "知り合いの酒仲間に用事を頼まれてるんだ。しかし俺は動けそうにない…代わりに行ってきてくれないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110112
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 414110112,
					"content": "酒仲間って、酒場で知り合った友達のこと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110113
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 414110113,
					"content": "ああ。仕事終わりに酒場で一杯やっている内に、友達もたくさんできてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110114
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 414110114,
					"content": "ニムロドっていうんだが、普段は酒場の近くにいる。この時間は多分、ヒマを持て余しているだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110115
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 414110115,
					"content": "俺はここに残って課題をやってるから、ニムロドのことは頼むよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110116,
						414110117
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 414110116,
					"content": "課題がんばって、ガイア。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 414110117,
					"content": "分かった、この祭りに馴染むためにも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
