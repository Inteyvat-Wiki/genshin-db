					]
				},
				{
					"id": 761430512,
					"content": "リスク？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430513
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 761430513,
					"content": "その中の情報を見れば、分かるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430514
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 761430514,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430515
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 761430515,
					"content": "オイラはよくわからないんだけど…クロタマゴの使命って、一体なんなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430516
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761430516,
					"content": "クロタマゴが情報を読み取っている間に、パイモンにすべてを話した。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761430517
					]
				},
				{
					"id": 761430517,
					"content": "星海に情報を送る？それが観月者計画だったのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430518
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761430518,
					"content": "それじゃリスクって…これでテイワットのことがバレちゃうかもしれないってことだよな？どうしてこんなことに…うぅ、困ったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430519
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761430519,
					"content": "クロタマゴ…大丈夫か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430520
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761430520,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430521
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 761430521,
					"content": "ああっ、そんなに悲しむなよ！みんなで、もう少し話し合わないか？なっ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430522
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761430522,
					"content": "ほら、お菓子でも食べようぜ！半分こにしよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430523
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761430523,
					"content": "ううん、悲しんでなんてないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430524
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 761430524,
					"content": "泣いてるじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430525
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761430525,
					"content": "悲しくないし、涙も流してない。これは…ただ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430526
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 761430526,
					"content": "先輩たちにお酒を捧げてるんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430527
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 761430527,
					"content": "コロンビーナ、旅人、パイモン。ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430528
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 761430528,
					"content": "あなたたちは私の友達でしょ。友達を困らせたくないから、私は…この使命を放棄する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430529
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 761430529,
					"content": "クロタマゴ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430530
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761430530,
					"content": "大丈夫だよ、パイモン。観月者計画を実行するのは私が初めてってわけじゃないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430531
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 761430531,
					"content": "先輩たちは、ずっと前に星海へ向けて私たちの声を発信したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430532
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 761430532,
					"content": "その勇気に満ちた声はきっと遥か遠く、星海の深淵まで届いてるはずだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430533
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 761430533,
					"content": "その声がある限り、星海が完全な静寂に包まれることはない。それだけで十分なの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430534
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 761430534,
					"content": "旅人…考えはまとまった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430535,
						761430546
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 761430535,
					"content": "最後にもう一度だけ実行してもいいのかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761430536
					]
				},
				{
					"id": 761430536,
					"content": "うん、私もそう思うな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430537
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 761430537,
					"content": "ほ、本当に？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430538
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 761430538,
					"content": "本当にそんな危険を冒してもいいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430539
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761430539,
					"content": "これまでにも、この計画は何度も実行されてる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430540
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 761430540,
					"content": "テイワットを隠す偽りの空は、すでに何度も開かれてるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430541
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 761430541,
					"content": "霜月は数千年の間、偽りの空の外に存在してた…今の月にも、アビスの汚染の痕跡はないし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430542
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 761430542,
					"content": "おおっ？つまり、想像してたより危険じゃないかもしれないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430543
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761430543,
					"content": "可能性はいろいろあるね。アビスが常にここを見張ってるわけじゃないのかもしれないし、高天の主が別の対策を取ったのかもしれない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430544
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 761430544,
					"content": "それに、リスクを最小限に抑えるために…私も月神の力で、ニンニンが発信する情報を隠すよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430545
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 761430545,
					"content": "ん？それってどういう意味だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430549
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761430549,
					"content": "クーヴァキと古月の力は、どちらも本質的には光界の力。私の力を、ニンニンの情報に溶け込ませることができるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430550
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 761430550,
					"content": "そして、その情報が偽りの空を越えた後、私はその力で近くの状況を観測できる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430551
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 761430551,
					"content": "もし危険が迫りそうなら、私が情報を消去する。そうすれば、私たちが発見されることはないから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430552
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 761430552,
					"content": "おおっ、それはいい手かもな！でも、おまえの力は…ずっと維持できるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430553
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761430553,
					"content": "うーん…私の力にも限界があるから、ある程度の距離までしか維持できないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430554
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 761430554,
					"content": "全力で、私が到達できる限界までそれを送る…そうすれば、発信源も簡単には特定されないよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430555
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 761430555,
					"content": "それならいけそうだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761430556
					]
				},
				{
					"id": 761430556,
					"content": "でも…それであなたが傷ついたりしないの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430557
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 761430557,
					"content": "安心して。私たちを支えてるのは、月そのものだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430558
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 761430558,
					"content": "じゃあクロタマゴ、心の準備はいいか？一度決めたら、もう後戻りできないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430559
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761430559,
					"content": "…もう一つだけ聞いてもいい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430560
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 761430560,
					"content": "ん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430561
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 761430561,
					"content": "どうしてみんな、私のためにそこまでしてくれるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430562
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 761430562,
					"content": "私たち、友達だもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430563
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 761430563,
					"content": "それだけ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430564
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 761430564,
					"content": "それだけで十分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430565,
						761430566
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 761430565,
					"content": "観月者…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761430567
					]
				},
				{
					"id": 761430567,
					"content": "オ、オイラも！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430568
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761430568,
					"content": "わかった…うん、準備はできてるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430569
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 761430569,
					"content": "私は、この瞬間のために生まれてきたんだもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430570
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 761430570,
					"content": "うん…星の海にキミの声を響かせて。テイワットの月光が、キミを遠くへ送り届けてくれるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430571
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 761430571,
					"content": "えっと…こんにちは…みなさん、こんにちは！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430572
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 761430572,
					"content": "神秘に満ちた広大な星の海に、このメッセージを送ることができて…とても嬉しく思います…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430573
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 761430573,
					"content": "このメッセージが届くかはわかりません…でも少なくとも、冷たい宇宙の静寂を少しでも打ち払うことができればと思うのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430574
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 761430574,
					"content": "もし、これを聞いている「あなた」がいるのなら、それはきっと特別な引力が存在し、月のように私たちを捉えたということでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430575
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 761430575,
					"content": "だから、あなたたちの文明に知ってほしいのです…この果てしない星空の下で、あなたたちは決して孤独ではないのだと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430576
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 761430576,
					"content": "私たちの時代はまもなく幕を下ろします…ですが、私たちの勇気、信念、叡智は、このささやかなメッセージと共に星の海に響き渡るのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430577
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 761430577,
					"content": "たとえ儚くとも、それは私たちの光であり…あなたたちを鼓舞することを願っています——この星空の下で、あなたたちは決して独りで未知と暗闇に立ち向かっているわけではないのだと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430578
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 761430578,
					"content": "どうかこれからも、星の海に向けてあなたたちの声を響かせ続けてください。それが、あなたたちの光にもなりますように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430579
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 761430579,
					"content": "一筋の光はとてもか弱く、たやすく闇に飲み込まれてしまいます。ですが、それが消える前に別の光が灯れば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430580
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 761430580,
					"content": "そうすればいつの日かきっと、その光が夜の帳を切り裂く曙光となるはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430581
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 761430581,
					"content": "最後に…私たちは…宇宙の片隅の…ちっぽけな観月{RUBY#[S]星空}者…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430582
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 761430582,
					"content": "私たちの名前は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430583
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 761430583,
					"content": "イビニベルン…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430584
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 761430584,
					"content": "ウージエン…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430585
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 761430585,
					"content": "マーゴジェティ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430586
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 761430586,
					"content": "ルシャリム…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430587
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 761430587,
					"content": "ニンシジア…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430588
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 761430588,
					"content": "この声が聞こえるすべての「あなた」へ…敬意を…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430589
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 761430589,
					"content": "みんな…ありがとう…いつか星空の下で…また会おうね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430590
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 761430590,
					"content": "クロタマゴは、使命を果たしたんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430591
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761430591,
					"content": "あいつの帽子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430592
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761430592,
					"content": "大丈夫？コロンビーナ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761430593
					]
				},
				{
					"id": 761430593,
					"content": "私は平気。でもここからは、力が限界に達するまで、集中しなきゃいけない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430594
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 761430594,
					"content": "じゃあ、早く静かな場所を探しに行こうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430595
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761430595,
					"content": "じゃあな、クロタマゴ。オイラ、おまえのこと…ずっと忘れないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430596
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761430596,
					"content": "（…シグナルのノイズが響く…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430597
					],
					"speakerTitle": "端末"
				},
				{
					"id": 761430597,
					"content": "（…観月者モジュールが起動したことで、偶然にも封印されていたデータが開かれたようだ…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430598
					],
					"speakerTitle": "端末"
				},
				{
					"id": 761430598,
					"content": "…こちらは…号…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430599
					],
					"speakerTitle": "端末"
				},
				{
					"id": 761430599,
					"content": "…メッセージを…受信…応答します…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761431201
					],
					"speakerTitle": "端末"
				},
				{
					"id": 761431201,
					"content": "…正確な座標を…特定できないから…この返信が届くまで…どれほどの時間がかかるか分からない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761431202
					],
					"speakerTitle": "端末"
				},
				{
					"id": 761431202,
					"content": "#{M#…それでも俺は…今この瞬間に…応答したかったんだ…}{F#…それでも私は…今この瞬間に…応答したかったの…}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761431203
					],
					"speakerTitle": "端末"
				},
				{
					"id": 761431203,
					"content": "#{M#…俺たちは宇宙を…長く孤独に旅してきた…そんな中届いた君たちの声は…まるで暗闇の森で突然燃え上がった…篝火のようだった…}{F#…私たちは宇宙を…長く孤独に旅してきた…そんな中届いたあなたたちの声は…まるで暗闇の森で突然燃え上がった…篝火のようだった…}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761431204
					],
					"speakerTitle": "端末"
				},
				{
					"id": 761431204,
					"content": "#{M#…それはとても無謀だけど…勇敢な行為で…俺たちに勇気と温もりを…与えてくれた…}{F#…それはとても無謀だけど…勇敢な行為で…私たちに勇気と温もりを…与えてくれた…}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761431205
					],
					"speakerTitle": "端末"
				},
				{
					"id": 761431205,
					"content": "#{M#…俺は信じてる…この瞬間…星海と運命の引力が…俺たちを繋いだんだって…}{F#…私は信じてる…この瞬間…星海と運命の引力が…私たちを繋いだんだって…}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761431206
					],
					"speakerTitle": "端末"
				},
				{
					"id": 761431206,
					"content": "#{M#…いつの日か…君たちの…星を…探しに行くよ…残念だけど…今はまだ少し…厄介な問題が…残って…}{F#…いつの日か…あなたたちの…星を…探しに行くよ…残念だけど…今はまだ少し…厄介な問題が…残って…}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761431207
					],
					"speakerTitle": "端末"
				},
				{
					"id": 761431207,
					"content": "（…干渉ノイズ…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761431208
					],
					"speakerTitle": "端末"
				},
				{
					"id": 761431208,
					"content": "#{M#…お兄ちゃん！そっちはどう？}{F#…蛍、そっちはどう？}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761431209
					],
					"speakerTitle": "端末"
				},
				{
					"id": 761431209,
					"content": "#{M#…蛍、すぐ行くよ…}{F#…お兄ちゃん、すぐに…}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761431210
					],
					"speakerTitle": "端末"
				},
				{
					"id": 761431210,
					"content": "（…干渉ノイズ…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761431211
					],
					"speakerTitle": "端末"
				},
				{
					"id": 761431211,
					"content": "#{M#…それでは…君に敬意を…}{F#…それでは…あなたに敬意を…}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761431212
					],
					"speakerTitle": "端末"
				},
				{
					"id": 761431212,
					"content": "#{M#…君の言う通り…星の海は果てしなく広がってて…俺たちは決して孤独じゃない…}{F#…あなたの言う通り…星の海は果てしなく広がってて…私たちは決して孤独じゃない…}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761431213
					],
					"speakerTitle": "端末"
				},
				{
					"id": 761431213,
					"content": "…いつかまた、星空の下で会えますように…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "端末"
				},
				{
					"id": 761430566,
					"content": "すべての「あなたたち」に敬意を。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761430567
					]
				},
				{
					"id": 761430546,
					"content": "残念だけど、危険を冒すわけにはいかない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761430547
					]
				},
				{
					"id": 761430547,
					"content": "もし、私が月神の力で、ニンニンが送る情報を隠せるとしたら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430548
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 761430548,
					"content": "どういうこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761430549
					]
				}
