					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761430306
					]
				},
				{
					"id": 761430306,
					"content": "うん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430307
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 761430307,
					"content": "ん？侵入者を検知したのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430308
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 761430308,
					"content": "でも、あれだけじゃ私たちを止められないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "コロンビーナ"
