			"dialogs": [
				{
					"id": 761430101,
					"content": "旅の終点に着いたね。観月者計画を始めるには、彼女が不可欠なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430102
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 761430102,
					"content": "彼女は誰？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761430103
					]
				},
				{
					"id": 761430103,
					"content": "観月者計画の最後の継承者が、ここに残した痕跡だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430104
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 761430104,
					"content": "彼女がすべて説明してくれるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430105
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 761430105,
					"content": "やあ！こんにちは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430106
					],
					"speakerTitle": "ニンシジアの痕跡"
				},
				{
					"id": 761430106,
					"content": "えっと、こんにちは…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761430107
					]
				},
				{
					"id": 761430107,
					"content": "私はニンシジア。ニンニンってあだ名で呼んでもいいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430108
					],
					"speakerTitle": "ニンシジアの痕跡"
				},
				{
					"id": 761430108,
					"content": "あなたの名前は？イビニベルン？ウージエン？マーゴ？それともルシャリム？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430109
					],
					"speakerTitle": "ニンシジアの痕跡"
				},
				{
					"id": 761430109,
					"content": "#{M#俺}{F#私}は{NICKNAME}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761430110
					]
				},
				{
					"id": 761430110,
					"content": "ふふっ、返事はしなくていいよ。残念ながら私はもう、この世にいないからね。これはただのメッセージ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430111
					],
					"speakerTitle": "ニンシジアの痕跡"
				},
				{
					"id": 761430111,
					"content": "でも逆に考えれば、実はちっとも残念じゃないんだ。あなたがここに来たということは、計画が成功して、私たちの使命を受け継いでくれたってことだからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430112
					],
					"speakerTitle": "ニンシジアの痕跡"
				},
				{
					"id": 761430112,
					"content": "きっと、まだたくさん疑問があるんでしょ？たとえば——自分はいったい何者なのか、とか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430113
					],
					"speakerTitle": "ニンシジアの痕跡"
				},
				{
					"id": 761430113,
					"content": "教えてあげる。あなたは月の意志によって創り出された新たな生命であり、観月者計画の重要な要素の一つ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430114
					],
					"speakerTitle": "ニンシジアの痕跡"
				},
				{
					"id": 761430114,
					"content": "じゃあその計画って一体何？って考えてるでしょ…焦らないで、私の話を聞いて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430115
					],
					"speakerTitle": "ニンシジアの痕跡"
				},
				{
					"id": 761430115,
					"content": "まずは、月の三女神に感謝してね。彼女たちは私たちの僭越を許して、月の根源たる創生の力を貸してくれたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430116
					],
					"speakerTitle": "ニンシジアの痕跡"
				},
				{
					"id": 761430116,
					"content": "次に、私の先生であるルシャリムに感謝を。彼はみんなの研究成果を継承しただけじゃなく、みんなの古月の力の情報を集めることにも成功したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430117
					],
					"speakerTitle": "ニンシジアの痕跡"
				},
				{
					"id": 761430117,
					"content": "そのおかげで、私はこの月心の海に情報を集約することができた。そうして、根源の創生の力が発動した時、「ポンッ」と——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430118
					],
					"speakerTitle": "ニンシジアの痕跡"
				},
				{
					"id": 761430118,
					"content": "かわいくて黒い月霊、つまりあなたが誕生したの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430119
					],
					"speakerTitle": "ニンシジアの痕跡"
				},
				{
					"id": 761430119,
					"content": "あなたは情報の海に眠る誰かの名前を受け継ぐかもしれないし、受け継がないかもしれない。でも、自分に使命があることくらいは思い出せるはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430120
					],
					"speakerTitle": "ニンシジアの痕跡"
				},
				{
					"id": 761430120,
					"content": "クロタマゴはそうやって生まれたんだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761430121
					]
				},
				{
					"id": 761430121,
					"content": "そうそう、マーゴ先輩にも感謝しなきゃね。彼女はあの星海からの来訪者の本質——ある種の情報生命体であることを解き明かしてくれた。彼女の研究が、あなたの誕生の礎になったんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430122
					],
					"speakerTitle": "ニンシジアの痕跡"
				},
				{
					"id": 761430122,
					"content": "それから、ウージエン先輩。彼は自らの命を捧げて、あの来訪者が代表する文明が、最後に星の海に向けて送ったメッセージを伝えてくれた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430123
					],
					"speakerTitle": "ニンシジアの痕跡"
				},
				{
					"id": 761430123,
					"content": "そして、最初の観月者であるイビニベルン。彼は私たちを月へと導き、私たちの目を開かせ、疲れも知らずに光り輝く星空を見つめ続けた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430124
					],
					"speakerTitle": "ニンシジアの痕跡"
				},
				{
					"id": 761430124,
					"content": "最後に…継承者、あなたにも感謝させて。まもなくあなたは自らの身を捧げて、観月者の高塔へと向かい、計画の最終段階を始動させるんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430125
					],
					"speakerTitle": "ニンシジアの痕跡"
				},
				{
					"id": 761430125,
					"content": "あなたの使命は、私たちがかつて受け取ったメッセージを宇宙へ発信し続けること。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430126
					],
					"speakerTitle": "ニンシジアの痕跡"
				},
				{
					"id": 761430126,
					"content": "「一筋の光はとてもか弱く、たやすく闇に飲み込まれてしまう。だが、それが消える前に別の光が灯れば…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430127
					],
					"speakerTitle": "ニンシジアの痕跡"
				},
				{
					"id": 761430127,
					"content": "「そうすればいつの日かきっと、その光が夜の帳を切り裂く曙光となる。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430128
					],
					"speakerTitle": "ニンシジアの痕跡"
				},
				{
					"id": 761430128,
					"content": "ここまで話せば、もう理解できたかな？ちょうどこっちも、そろそろ時間切れみたい…でも大丈夫、私もすぐにみんなのところに行くから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430129
					],
					"speakerTitle": "ニンシジアの痕跡"
				},
				{
					"id": 761430129,
					"content": "そう考えると、あなたが受け継ぐのは私の名前だったりして。ふふっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430130
					],
					"speakerTitle": "ニンシジアの痕跡"
				},
				{
					"id": 761430130,
					"content": "そろそろ、お別れだね。行って、あなたの使命を果たして。最後に…あなたとすべての観月{RUBY#[S]星空}者に敬意を。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430131
					],
					"speakerTitle": "ニンシジアの痕跡"
				},
				{
					"id": 761430131,
					"content": "…そういうこと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430132
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 761430132,
					"content": "星空を探求したすべての学者たち、彼らの情報がこの海に眠ってる。そして月の意志によって、いつかクロタマゴの姿で生まれ変わるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430133
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 761430133,
					"content": "彼らは本能的に互いを取り込んで、より多くの情報を得ようとするの…ぼんやりと脳裏に浮かぶ使命が、鮮明に理解できるまで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430134
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 761430134,
					"content": "それから私たちが歩んできた道をもう一度たどって、ここですべてを知るんだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430135
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 761430135,
					"content": "自分自身を鍵に、イビニベルンの目の観月者モジュールを開いて…そして、もう一度宇宙へメッセージを送るの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430136
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 761430136,
					"content": "最後は生命の循環に還るんだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761430137
					]
				},
				{
					"id": 761430137,
					"content": "うん。この循環は、今まで何度も起きてるのかもね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430138
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 761430138,
					"content": "でも、未知の星海に向かって声を発するのは、必ずしも安全とは限らない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430139
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 761430139,
					"content": "龍族の学者もきっとそれに気づいてて、月幕計画の研究を始めたんだと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430140
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 761430140,
					"content": "そしてニンニンの時代、世界はふたりの至高者の争いによって、滅びかけてた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430141
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 761430141,
					"content": "でも今のテイワットは平穏を取り戻してる。少なくとも、今はね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430142
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 761430142,
					"content": "（もしシグナルを発信することで、星海に潜む悪意に気づかれてしまったら…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761430143
					]
				},
				{
					"id": 761430143,
					"content": "約束通り、鍵と情報はニンニンに渡すね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430144
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 761430144,
					"content": "キミは、ニンニンが使命を果たすのを止めるべきだと思う？それとも、背中を押してあげるべきかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430145
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 761430145,
					"content": "少し考える時間が欲しい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761430146
					]
				},
				{
					"id": 761430146,
					"content": "うん、分かるよ。じゃあ、最初の観月者の高塔に戻ろうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430147
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 761430147,
					"content": "パイモンとニンニンは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761430148
					]
				},
				{
					"id": 761430148,
					"content": "大丈夫、マーゴが二人を迎えに行ってくれるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430149
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 761430149,
					"content": "あそこまではまだ距離があるから…ゆっくり考えてみて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430150
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 761430150,
					"content": "そろそろ、ここを出ようか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "コロンビーナ"
				}
			]
		},
