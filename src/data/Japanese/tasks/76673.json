						],
						"pointId": 14939
					},
					{
						"sceneId": 3,
						"position": [
							5480.907,
							194.819,
							9712.115
						],
						"pointId": 14940
					},
					{
						"sceneId": 3,
						"position": [
							5481.945,
							194.575,
							9709.521
						],
						"pointId": 14942
					}
				]
			},
			"dialogs": [
				{
					"id": 766730201,
					"content": "若者は気品漂う美しい魔女に驚き、長い沈黙の後、真剣に語りかけた——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730202
					],
					"speakerTitle": "観察"
				},
				{
					"id": 766730202,
					"content": "「ああ、悠久の魔女、美しき魔女、聡明なる魔女よ！あなたに会うと、思わず心が揺れ動く。あなたの願いを私の願いとしよう。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730203
					],
					"speakerTitle": "観察"
				},
				{
					"id": 766730203,
					"content": "魔女は微かな笑みが浮かべた——「ならば、あたしのために出来る限りのことをしなさい。導きはすぐそこまで来ている、報酬は未来で待ち受けているわ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730204
					],
					"speakerTitle": "観察"
				},
				{
					"id": 766730204,
					"content": "導きって…この光ってる球のことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7667303,
			"completionStepIds": [
				7667303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7667303",
							"2"
						],
						"stepId": 7667303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 766730301,
					"content": "「秘密の小屋…？」若者は困惑した。「それはいったいどこに？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730302
					],
					"speakerTitle": "観察"
				},
				{
					"id": 766730302,
					"content": "若者の問いかけに、魔女は珍しく動揺の混じった声で答えた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730303
					],
					"speakerTitle": "観察"
				},
				{
					"id": 766730303,
					"content": "（うーん、設定として少しシャイ過ぎるかしら…まあいいわ、とりあえずこれでいきましょう。きっと九先生が手直ししてくれるわ。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730304
					],
					"speakerTitle": "観察"
				},
				{
					"id": 766730304,
					"content": "「コホン、無礼な質問はやめなさい。魔女の小屋は今建設中よ。その豪華な姿を見ればきっと呆然とするでしょうね。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730305
					],
					"speakerTitle": "観察"
				},
				{
					"id": 766730305,
					"content": "「これはあなたへの試練。大魔女の領地建設に、全力を尽くしなさい。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "観察"
				}
			]
		},
		{
			"id": 7667304,
			"completionStepIds": [
				7667303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7667303",
							"2"
						],
						"stepId": 7667303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 766730401,
					"content": "「さあ、魔女の悩みを知った若者よ。ニコラ・ココは今まさに、神聖なる領地を建設しているわ。あなたの助けが必要よ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730402
					],
					"speakerTitle": "観察"
				},
				{
					"id": 766730402,
					"content": "魔女は笑いながら若者にお茶を淹れた。「さて、どうする？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730403,
						766730404
					],
					"speakerTitle": "観察"
				},
				{
					"id": 766730403,
					"content": "もちろん協力する！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730405
					]
				},
				{
					"id": 766730405,
					"content": "ちょっと待った！独り言を言ってる正体不明のやつだぞ！？慎重になったほうがいいんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766730406,
					"content": "あれ…？でも、このティーカップ、見覚えがあるような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730407,
						766730408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766730407,
					"content": "やっと気付いたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730409
					]
				},
				{
					"id": 766730409,
					"content": "ニコラ・ココ…あ！もしかして、魔女N——ニコのことなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730410
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766730410,
					"content": "正解。さっきの物語はどうだったかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730411
					],
					"speakerTitle": "観察"
				},
				{
					"id": 766730411,
					"content": "どうだったもなにも…まだ話の途中だろ？若者と魔女は、結局どうなったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730412
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766730412,
					"content": "まだ考えていないわ。魔女の小屋を修理してから考える。その時になれば、またインスピレーションが湧くかもしれないからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730413
					],
					"speakerTitle": "観察"
				},
				{
					"id": 766730413,
					"content": "あたしの声が聞こえたということは、あなたたちはナド・クライにいるのよね。あたしの代わりに、ちょっといろいろ集めてくれるかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730414,
						766730416
					],
					"speakerTitle": "観察"
				},
				{
					"id": 766730414,
					"content": "集めるって何を？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730415
					]
				},
				{
					"id": 766730415,
					"content": "家を作るのと同時に、新しい彫像も作るつもりなの。でも、まだインスピレーションが湧かないから、素敵な写真を撮ってきてもらおうと思って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730418
					],
					"speakerTitle": "観察"
				},
				{
					"id": 766730418,
					"content": "しょうがないな、オイラたちに任せろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730419
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766730419,
					"content": "何かいいものがないか見てくるから、待っててくれ。彫像が完成したら、さっきの話を最後まで聞かせてくれよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766730416,
					"content": "それって彫像と関係ある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730417
					]
				},
				{
					"id": 766730417,
					"content": "ええ、家を作るのと同時に、新しい彫像も作るつもりなの。でも、まだインスピレーションが湧いてこないから、ちょっと写真を撮ってきてもらえないかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730418
					],
					"speakerTitle": "観察"
				},
				{
					"id": 766730408,
					"content": "この人は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730409
					]
				},
				{
					"id": 766730404,
					"content": "偉大なる魔女ニコラ・ココの導きに従う！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730405
					]
				}
			]
		},
