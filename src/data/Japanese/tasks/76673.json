			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 3,
						"position": [
							5461.151,
							198.892,
							9742.186
						],
						"pointId": 14953
					}
				]
			},
			"dialogs": [
				{
					"id": 766730101,
					"content": "若者は歩き続けた。すると魔女の領地には、よく出来た彫刻がたくさんあることに気付いた。「これは何？」と若者が尋ねる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730102
					],
					"speakerTitle": "観察"
				},
				{
					"id": 766730102,
					"content": "「魔女の敵よ。魔女の力を欲したせいで、石に変えられてしまったの。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730103
					],
					"speakerTitle": "観察"
				},
				{
					"id": 766730103,
					"content": "この設定は悪くないわね。まあ、あたしが今思いついたものだけど。魔女は強くて危険な存在であるべき…危険ゆえに謎めいている。世の中、多少は神秘的な要素がないと、全てが暗澹としてつまらなくなってしまうわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730104
					],
					"speakerTitle": "観察"
				},
				{
					"id": 766730104,
					"content": "（でも、すぐ人を石に変えてしまうなんて、酷すぎたかも？こんな変なヤツ、周りに誰もいなくなっちゃうわね…やっぱりさっきの台詞は警告ってことにしましょう。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730105
					],
					"speakerTitle": "観察"
				},
				{
					"id": 766730105,
					"content": "その言葉を聞いて、若者は冷や汗をかいた。すると、魔女の笑い声が再び聞こえてきた。「ふふっ、騙されたわね。彫刻にして時間の流れを止めているだけよ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730106
					],
					"speakerTitle": "観察"
				},
				{
					"id": 766730106,
					"content": "「あなたには彫刻を完成させてほしいの。魔女の小屋にはもっと可愛い子たちが必要だから。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "観察"
				}
			]
		},
		{
			"id": 7667302,
			"completionStepIds": [
				7667302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
