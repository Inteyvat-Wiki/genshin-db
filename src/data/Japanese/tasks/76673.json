			"dialogs": [
				{
					"id": 766730501,
					"content": "ちょうどいい時に来てくれたわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730502
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 766730502,
					"content": "あなたたちが撮った写真、とても気に入ったわ。どれも興味深い対象ね。彫刻道具の用意はもうできているから、一緒に試してみない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730503
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 766730503,
					"content": "彫刻道具って、ここにあるブロックのことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766730504,
					"content": "そう、彫像はこの石材の中にあるの。余分な部分を取り除くだけでいいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730505
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 766730505,
					"content": "理解しやすいよう、彫刻の方法に関する説明も作っておいたから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730506
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 766730506,
					"content": "手本を見せてあげるわ。まずは、基本的な造形を大胆に描く——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730507
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 766730507,
					"content": "石に書かれている数字は、一つの列に残すべき数を表すの。例えばこうやって…それからこう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730508
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 766730508,
					"content": "おおっ！だんだんそれっぽくなってきたな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730509
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766730509,
					"content": "これで分かったかしら？こうして彫れば、基本的な形が出来てくるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730510
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 766730510,
					"content": "あとは、ちょっと手を加えてあげれば…ほら！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730511
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 766730511,
					"content": "ええっ、待てよ！一瞬まばたきしただけで…なにがどうなったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730512
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766730512,
					"content": "ここは雰囲気だけ見てくれればいいわ。偉大な魔女は簡単に手の内を明かさないのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730513
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 766730513,
					"content": "とにかく、仕上げはあたしに任せて。彫刻の方法はもう理解してくれたかしら？あとは、お願いね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730514
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 766730514,
					"content": "おう！じゃあ、試してみようぜ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730515
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766730515,
					"content": "うわぁ！なんだよこれ、急に難しすぎないか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730516
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766730516,
					"content": "ん？ああ、ごめんなさい、取り違えてしまったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730517
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 766730517,
					"content": "これはあたしが作る分。あなたたちはこっちね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730518
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 766730518,
					"content": "び、びっくりした…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
