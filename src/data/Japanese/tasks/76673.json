						],
						"pointId": 15006
					},
					{
						"sceneId": 3,
						"position": [
							5480.359,
							194.706,
							9710.449
						],
						"pointId": 15007
					},
					{
						"sceneId": 3,
						"position": [
							5482.168,
							194.832,
							9712.457
						],
						"pointId": 15008
					}
				]
			},
			"dialogs": [
				{
					"id": 766731132,
					"content": "次は、ニコに仕上げをしてもらって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731133
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766731133,
					"content": "余分な石は全部取り払えた？見せて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731134
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 766731134,
					"content": "へへっ、これで完成だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731101
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766731101,
					"content": "あれ？魔女の小屋だ！いつの間に！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766731102,
					"content": "これが魔女の力…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766731103
					]
				},
				{
					"id": 766731103,
					"content": "「これが魔女の力…？」若者は不思議そうに目を見開いた。「なんてすばらしい…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731104
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 766731104,
					"content": "やっとこの前の話の続きを聞かせてくれる気になったのか。それで、魔女と若者はその後どうなるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766731105,
					"content": "こうして、幸せに暮らしましたとさ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731106
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 766731106,
					"content": "…おしまい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731107
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 766731107,
					"content": "…え？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731108,
						766731109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766731108,
					"content": "途中の話は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766731110
					]
				},
				{
					"id": 766731110,
					"content": "仕方ないわね。そんなに聞きたいのなら、最初から話してあげる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731111
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 766731111,
					"content": "「あなたの願いを私の願いにしよう。」若者はそう誓うことで、大魔女ニコラ・ココの関心を引くことに成功したわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731112
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 766731112,
					"content": "二人は徐々に親しくなっていった。しかし、招かれざる客が突如として現れ、強引に魔女を攫っていったの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731113
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 766731113,
					"content": "若者が驚いていると、新たな魔女アリナスが現れ、若者と契約を結び、若者も魔法を手に入れた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731114
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 766731114,
					"content": "そして厳しい特訓を経た若者は、今回の出来事の背後に、実は別の陰謀があることに気が付く！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731115
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 766731115,
					"content": "大魔女ニコラ・ココは、なんと宇宙から来た生命体であり、ニャンコ星の国王ニャントラス三世の娘だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731116
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 766731116,
					"content": "魔女のフリをした彼女たちの本当の目的は、世界中の人々にニャンコ星を信仰させることだったの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731117
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 766731117,
					"content": "「偉大なる魔女よ、ずっと私を騙していたの？」心が張り裂けそうになり、若者は震える声で言った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731118
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 766731118,
					"content": "「もう帰りなさい。ニャンコ星とあなたたちは、いずれ戦う運命にあるの。あたしたちは、最初から敵同士だったのよ…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731119
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 766731119,
					"content": "魔女は背を向けた。誰にもその涙を見せないように…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731120
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 766731120,
					"content": "しかし、若者は勇敢にも魔女の腕を掴み、決して別れないと誓った。魔女は若者の決意に心を打たれ、反旗を翻す決心をする！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731121
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 766731121,
					"content": "ちょうどその時、若者を助けたアリナスは、国王の側に立っていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731122
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 766731122,
					"content": "アリナスはニャントラス三世の次女で、若者を助けたのは、姉が裏切るように仕向けて、王位継承権を奪い取るため——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731123
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 766731123,
					"content": "ニコは紆余曲折に満ちた物語をとうとうと語り始めた。中にはおかしな展開もたくさんあり、最後は主人公さえも人間ではなくなっていた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						766731124
					]
				},
				{
					"id": 766731124,
					"content": "とにかく、こういう感じよ。最終的に、猫になった若者と魔女は、一丸となって陰謀を打ち砕くの。そして魔女の小屋に戻り、世間から離れて平和な暮らしを送りましたとさ。めでたしめでたし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731125
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 766731125,
					"content": "ううっ…いい話だな…愛と戦いの物語だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766731126,
					"content": "全然違う話になってるけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766731127
					]
				},
				{
					"id": 766731127,
					"content": "仕方がないでしょう？どんなものも、一度創造されてしまえば、いつかは創造者の手から離れてしまう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731128
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 766731128,
					"content": "私たち「天の使い」も、かつては人類を導く役割を担っていたけど、一部の者たちが「別の道」を選んだことで、同族全員が罰を受けることになったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731129
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 766731129,
					"content": "たとえ天理であっても、天理が創造したものを完全に支配することはできない…ましてや、あたしなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731130
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 766731130,
					"content": "運命は予測できないものなのよ。それでもやはり、あたしが見届けた人たちには、いい結末を迎えてほしい。物語の中のキャラクターたちであってもね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731131
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 766731131,
					"content": "一通り物語を語ったら、燃え尽きてしまったわ。今度また素敵な物語が出来たら、聞かせてあげる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731135
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 766731135,
					"content": "アリナスはニャントラス三世の次女で…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731136
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 766731136,
					"content": "若者を助けたのは、姉が裏切るように仕向けて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731137
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 766731137,
					"content": "王位継承権を奪い取るため——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ニコ"
				},
				{
					"id": 766731109,
					"content": "省略しすぎ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766731110
					]
				}
			]
		},
