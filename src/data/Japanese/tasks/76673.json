			},
			"dialogs": [
				{
					"id": 766730901,
					"content": "ニコ、戻ったぞ——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730902
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766730902,
					"content": "もう終わったの！？さすがね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730903
					],
					"speakerTitle": "観察"
				},
				{
					"id": 766730903,
					"content": "へへっ、写真はどうやって渡せばいいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730904
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766730904,
					"content": "一旦あなたたちが持っておいて。二日後くらいにはあたしもそっちに着くから、その時にまた彫刻について話しましょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730905
					],
					"speakerTitle": "観察"
				},
				{
					"id": 766730905,
					"content": "本当か？じゃあ、楽しみにしてるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
