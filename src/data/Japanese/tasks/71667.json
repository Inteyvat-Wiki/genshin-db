			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ランジット"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716670101,
					"content": "ああ。二人とも、待ってたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670102
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 716670102,
					"content": "爆炎樹と友達になれた？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716670103
					]
				},
				{
					"id": 716670103,
					"content": "はぁ、本当に大変だったよ。君の「交涉」のおかげで、あいつは大人しくなってくれたが、それもほんのちょっとの間だけでね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670104
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 716670104,
					"content": "元気を取り戻した途端、すぐにまた私を死に追いやろうとしてきた。本当に怖かったよ…。どうやら、君たちのほうが正しかったようだ。爆炎樹と友達になるのは、やはり無理がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670105
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 716670105,
					"content": "あっ！でも爆炎樹の実は、なかなか美味かったぞ。炎元素の味がするんだ。これならナタの友人たちも気に入ってくれるはずだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670106
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 716670106,
					"content": "どんな味がするんだ？まったく想像がつかないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716670107,
					"content": "食べてみるか？食べたいなら今から…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670108
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 716670108,
					"content": "い、いやいや、いいぞ！…で、次はエンシェントヴィシャップに挑戦しに行くんだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716670109,
					"content": "ああ。今回は行けそうな気がするんだ。なにせ、エンシェントヴィシャップは、テペトル竜とかなり似てるからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670110
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 716670110,
					"content": "私みたいにスメールからナタに行く場合、その道中で初めて会うのがテペトル竜だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670111
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 716670111,
					"content": "へぇ、そうなんだな。でも、なんか今回もうまくいかなそうな気がするけど…そもそも、なんでベビーヴィシャップにしないんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716670112,
					"content": "…丸っこい腹がないからだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670113
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 716670113,
					"content": "なんだって？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716670114,
					"content": "ベビーヴィシャップには丸っこい腹がないと言ったんだ。おそらく、いつも尋常じゃないスピードでグルグルしてるから、脂肪が落ちてるんだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670115
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 716670115,
					"content": "はぁ…それと一番の理由はやっぱり、インパクトが足りない点だな。竜と一緒に暮らしてるナタの友人たちからしたら、きっとベビーヴィシャップなんて見向きもしない相手のはずだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670116
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 716670116,
					"content": "それに比べて、エンシェントヴィシャップは違う。物語の中に登場すれば、強敵と言えるような立派な存在だ。敵が強ければ強いほど、それに勝てる主人公もより強く見えるものだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670117
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 716670117,
					"content": "さて、話はここまでにしよう。エンシェントヴィシャップがこの先で私たちを待ってるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670118,
						716670119
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 716670118,
					"content": "じゃあ、行こう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 716670119,
					"content": "他に用事があるから、またあとで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716670120
					]
				},
				{
					"id": 716670120,
					"content": "ああ。じゃあ、ここで待ってるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ランジット"
				}
			]
		}
	]
}