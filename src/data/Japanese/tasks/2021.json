	"talks": [
		{
			"id": 202102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"202102",
							"2"
						],
						"stepId": 202102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
