			"dialogs": [
				{
					"id": 730420601,
					"content": "楽しかった！金色のナラと遊べて、アランカンタはとても嬉しい！それにナラは速くてすごい！本物のリシュボラン虎と同じ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420602
					],
					"speakerTitle": "アランカンタ"
				},
				{
					"id": 730420602,
					"content": "他のアランナラや本物のリシュボラン虎と遊ぶのも楽しい。でも、新しい友達、ナラの友達と一緒に遊ぶのはもっと楽しい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420603
					],
					"speakerTitle": "アランカンタ"
				},
				{
					"id": 730420603,
					"content": "なんでリシュボラン虎はアランナラを追いかけるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730420604
					]
				},
				{
					"id": 730420604,
					"content": "リシュボラン虎とアランナラはみんな友達。友達は一緒に遊ぶ。でもアランカンタは気づいた。ナラはリシュボラン虎が怖い。だからウツァヴ祭のため、新しい遊びを考えた！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420605
					],
					"speakerTitle": "アランカンタ"
				},
				{
					"id": 730420605,
					"content": "ありがとう、ナラ。アランナラの花、金色のナラにあげる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランカンタ"
