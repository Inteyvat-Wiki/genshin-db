			"dialogs": [
				{
					"id": 730420101,
					"content": "金色のナラ、アランカンタはキミの話をたくさん聞いた。キミはいいナラ。アランカンタとゲームをしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420102
					],
					"speakerTitle": "アランカンタ"
				},
				{
					"id": 730420102,
					"content": "アランカンタのゲームは簡単で、面白い！ナラに「ルール」を説明する…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420103
					],
					"speakerTitle": "アランカンタ"
				},
				{
					"id": 730420103,
					"content": "アランカンタがたくさんの草の粒を出す。これは「アランナラ」が輪の中に隠している。ナラは大きくて強い「リシュボラン虎」になって、「アランナラ」を追いかけて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420104
					],
					"speakerTitle": "アランカンタ"
				},
				{
					"id": 730420104,
					"content": "「ちょっと」の間に「リシュボラン虎」が、全部の「アランナラ」に追いつけばナラの「勝ち」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420105
					],
					"speakerTitle": "アランカンタ"
				},
				{
					"id": 730420105,
					"content": "どう？ナラはアランカンタとゲームをしたい？",
					"roleType": "TALK_ROLE_NPC",
