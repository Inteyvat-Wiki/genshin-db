			"dialogs": [
				{
					"id": 722441101,
					"content": "#ひい、ふう、みい……よし、{NICKNAME}、これで七つの墓石の弔いが終わったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722441102,
					"content": "石の祠に戻って、あの残魂に教えてあげよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
