			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"久利由売",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722440101,
					"content": "ん？主らのような身なりをした者は久方ぶりじゃな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440102
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440102,
					"content": "言動からして、白夜国の民ではないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440103
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440103,
					"content": "もしや、異邦より落ちた旅の者か。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440104
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440104,
					"content": "そう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440105
					]
				},
				{
					"id": 722440105,
					"content": "まさか、白夜国に外と繋がる道があったとはのう…驚きじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440106
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440106,
					"content": "そういえば、妾は生まれた時からずっと白夜国にいるため、外の者を見たことがない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440107
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440107,
					"content": "かつて、外の風景を見たいと妾に言った者がおったが、妾はずっとそれを冗談だと思っておった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440108
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440108,
					"content": "はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440109
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440109,
					"content": "旅人よ、実は頼みがあるのじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440110
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440110,
					"content": "白夜国の至る所に、「太陽{RUBY#[D]パエトーン}の子」の遺品である召し物を納めた御陵墓石が七つある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440111
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440111,
					"content": "太陽の子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722440112,
					"content": "そう、白夜国では大日御輿を崇めておる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440113
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440113,
					"content": "数年に一度、生まれたばかりの子供が太陽の子として選ばれ、国を司る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440114
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440114,
					"content": "そして、その太陽の子は…全部で七人おる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440115
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440115,
					"content": "白夜国に異郷の旅人が来るのは、とても珍しいことじゃ。頼む、あの子らの墓へ行って弔ってやってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440116
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440116,
					"content": "でも…どうしてオイラたちみたいなよそ者に、弔いに行かせるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722440117,
					"content": "普通、こういうのって知り合いが行ったほうがいいだろ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722440118,
					"content": "一般的には確かにそうじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440119
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440119,
					"content": "はぁ…ただ、白夜国の民で、あの子らを弔ってやろうと思う者はおらぬじゃろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440120
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440120,
					"content": "それどころか、それらの御陵墓石は長いこと祀られてもおらん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440121
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440121,
					"content": "えっ…どうしてなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722440122,
					"content": "この国の人たちは、太陽の子が嫌いなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722440123,
					"content": "嫌いというより…憎んでおる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440124
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440124,
					"content": "先ほども言ったが、太陽の子は生まれた時から太陽の子じゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440125
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440125,
					"content": "そんな子供が、いったいどうして国を治められるというのか。本当に国を掌握しておったのは、太陽の子の背後にいた大人たちじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440126
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440126,
					"content": "太陽の子は、ただ彼らの操り人形に過ぎぬ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440127
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440127,
					"content": "だが…貪欲な大人たちは、人々を抑圧し、太陽の子を操って数々の残虐非道な行いをしてきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440128
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440128,
					"content": "その結果、民は憤怒した。そして、その数々の罪を太陽の子に着せたのじゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440129
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440129,
					"content": "そんな、どうして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440130
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722440130,
					"content": "太陽の子はなにも悪くないのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440131
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722440131,
					"content": "…いや、そうでもない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440132
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440132,
					"content": "白夜国の民にとって、太陽の子の無知こそが罪だったのじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440133
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440133,
					"content": "無知により犯した罪で他人を傷付けた時、その者は本当に無罪だと言えるのじゃろうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440134
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440134,
					"content": "それは難しいじゃろう。残した傷は、取り返しのつかぬものなのじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440135,
						722440136
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440135,
					"content": "だったら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440137
					]
				},
				{
					"id": 722440137,
					"content": "これは…妾の個人的な頼みじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440138
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440138,
					"content": "妾は名を久利由売という。大日御輿にて、太陽の子の起居を担当しておった女官じゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440139
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440139,
					"content": "あの子らの行いが間違いであったと知っておる。じゃが…あの子らが操られておったことも、同じように知っておる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440140
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440140,
					"content": "あの子らを小さな頃から見てきたのは妾じゃ。悲哀を感じることはあれど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440141
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440141,
					"content": "…憎むことはできぬ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440142
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440142,
					"content": "それに妾は職務上、太陽の子と日常的に接触しておったが、周囲の厳しい監視を受けておった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440143
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440143,
					"content": "あの子らの傍にいた時、何一つ言うことを許されんかったのじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440144
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440144,
					"content": "あの子らが助けを必要としていた時、妾に多くの言葉を投げかけてきた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440145
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440145,
					"content": "だというのに、妾はそれに応えることができなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440146
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440146,
					"content": "もしも…もしもあの時、捨て身の覚悟であの子らに言葉をかけていたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440147
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440147,
					"content": "すべてが…変わっておったかもしれぬ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440148
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440148,
					"content": "妾は、今さらあの子らに合わせる顔がない…ここから弔うことしかできぬ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440149
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440149,
					"content": "弔いの件、頼んでもよいか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440150
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440150,
					"content": "ただ…あの子らの墓の前で…「珊瑚真珠」を1つ置くだけでよい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440153
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440153,
					"content": "これで、石の祠にある魂の灯に火をつけられる。魂を導く地への道を開き、あの子らの魂に安らぎをもたらすためにも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440151
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440151,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440152
					]
				},
				{
					"id": 722440152,
					"content": "ありがとう。では…頼んだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440136,
					"content": "なんで弔う必要があるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440137
					]
				}
			]
		},
