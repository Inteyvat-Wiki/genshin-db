		},
		{
			"id": 7224412,
			"completionStepIds": [
				7224425
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224425",
							"2"
						],
						"stepId": 7224425,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"久利由売"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722441201,
					"content": "ああ…比螺夢門、主は読書が好きで、いつも外の世界のことを言っておったな。あの時、妾は信じてやれなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441202
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722441202,
					"content": "主の言葉に対し、いつも笑いながら首を横に振っていた。今になってやっと分かった、妾は主を信じてやるべきじゃったと…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441203
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722441203,
					"content": "いつも言っておったな…もし機会があったら、大日御輿から逃げ出し、外の地で冒険すると…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441204
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722441204,
					"content": "比螺夢門よ、もう主を束縛する者は誰もおらぬ。行くがよい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441205
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722441205,
					"content": "それと、御琉部栖…妾はもう一度、主の歌が聞きたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441206
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722441206,
					"content": "主の清らかで澄んだ歌声を聞けば、誰もが心の中で主と共に歌わずにはいられぬ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441207
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722441207,
					"content": "帰日の祭の前夜、主は妾の声が聞きたいと言い、どうしても妾に歌ってほしいとせがんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441208
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722441208,
					"content": "どんなに下手でも、主は笑わないと約束してくれたな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441209
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722441209,
					"content": "あの時、主はもう知っておったのか…帰日の祭が自らの最期だということを…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441210
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722441210,
					"content": "じゃが…妾は最後の最後まで…くっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441211
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722441211,
					"content": "久利由売？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722441212
					]
				},
				{
					"id": 722441212,
					"content": "ああ、すまぬ。見苦しいところを見せたな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441213
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722441213,
					"content": "太陽の子に仕える女官は、自らの純潔を守るため…生涯嫁いではならぬことになっている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441214
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722441214,
					"content": "じゃから、妾は自分の子を持たなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441215
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722441215,
					"content": "この子供らは妾が世話をして、成長を見守ってきた。いつの間にか、血縁よりも身近な存在になっておった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441216
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722441216,
					"content": "ありがとう、旅人。手綱を探してきてくれて、本当にありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441217
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722441217,
					"content": "この手綱は、太陽の子ら全員の手を経てきたものじゃ。これが持つ記憶なら、魂を完全に補うことができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441218
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722441218,
					"content": "たとえ、その記憶がどちらの面であってもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441219,
						722441220
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722441219,
					"content": "どちらの面であっても？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722441221
					]
				},
				{
					"id": 722441221,
					"content": "うむ、記憶は二種類に分けられる。一つは自身の記憶、もう一つは他人が持つ自身に関する記憶じゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441222
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722441222,
					"content": "存在を補うには、手綱が持つ太陽の子たち自身の記憶と…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441223
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722441223,
					"content": "白夜国から罪を着せられた子供たちという姿…つまり、罪悪の子としての記憶もある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441224
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722441224,
					"content": "妾の記憶だけでは、あの子らの魂を完全に補うことはできぬ。それゆえ、白夜国の民の記憶にも頼る必要があった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441225
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722441225,
					"content": "あの子らは、自らに着せられた罪によって白夜国に記憶され、残影を残すことができた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441226
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722441226,
					"content": "ありがとう、旅人…妾の願いが叶った…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441227
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722441227,
					"content": "やっと…少し…安心できる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441228
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722441228,
					"content": "これで…もう一度…子供たちと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722441220,
					"content": "記憶に面とかあるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722441221
					]
				}
			]
		},
