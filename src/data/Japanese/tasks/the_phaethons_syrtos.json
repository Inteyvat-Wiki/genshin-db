					"久利由売"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722440301,
					"content": "ああ、七つの魂の灯に、光が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440302
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440302,
					"content": "どうやら、弔いは終わったようじゃな。主らの手助け、心に刻んでおく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440303
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440303,
					"content": "では、主らのために…魂を導く地への通路を開こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440304
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440304,
					"content": "異郷の旅人よ、妾の勝手な頼みで主に迷惑をかけたが…それでも、主には安魂の儀を見届けてほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440305
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440305,
					"content": "まずは、この通路を進んでおくれ。妾はその先で主を待っておる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "久利由売"
				}
			]
		},
