					"nextDialogs": [
						722440604
					]
				},
				{
					"id": 722440604,
					"content": "阿倍良久の命から受け取ったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440605
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440605,
					"content": "しかし、妙じゃな…その方は確か…白夜国建立時の重鎮だったはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440606
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440606,
					"content": "その方は白夜国の王位、つまり太陽の子の座を奪おうと企み、謀反の罪に問われた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440607
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440607,
					"content": "じゃが…主らがその方から手綱をもらったとなると、何やら知られざる事情があったようじゃな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440608
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440608,
					"content": "手綱が手に入ったのは、運命と言えよう…またあの子らの顔が…脳裏に浮かんでくる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440609
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440609,
					"content": "これで妾にもやっと、贖罪の機会が訪れた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440610
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440610,
					"content": "旅人、この手綱を…魂を導く地の池に投げ入れておくれ。そうすれば、残魂を復元できる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440611
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440611,
					"content": "あの子らの魂を健やかな状態で、往生の道に送ってあげたいのじゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
