					"久利由売"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722440401,
					"content": "旅人よ、来たか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440402
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440402,
					"content": "ここは魂を導く地じゃ。妾の最後の執念が残る場所でもある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440403
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440403,
					"content": "太陽の子は一定の年齢になると、儀式に従い、誕生の日に大日御輿に入る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440404,
						722440405
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440404,
					"content": "大日御輿に入る？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440406
					]
				},
				{
					"id": 722440406,
					"content": "そう、大日御輿に入ること、それは「帰日の祭」と呼ばれておる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440407
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440407,
					"content": "太陽の子が大日御輿から生まれ、混沌の世に染まってしまう前に、太陽の御座へと帰るのじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440408
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440408,
					"content": "大日御輿の熱は、白夜の国をも照らすほどのもの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440409
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440409,
					"content": "結局、太陽の子が魂を導く地に帰ってきても、散り散りになった魂でしかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440410
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440410,
					"content": "じゃが、妾はそれでも思うのじゃ…もしかしたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440411
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440411,
					"content": "もしかしたら？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440412
					]
				},
				{
					"id": 722440412,
					"content": "もしかしたら、魂を導く地を開けば、妾の記憶であの子らの残魂を補えるかもしれぬと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440426
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440426,
					"content": "妾が調べてみよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440427
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440427,
					"content": "ああ…比螺夢門…御琉部栖…妾はここにおる。主らはまだ帰ってこぬのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440428
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440428,
					"content": "…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440429
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440429,
					"content": "どう？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440430
					]
				},
				{
					"id": 722440430,
					"content": "はぁ…七人の太陽の子のうち、比螺夢門と御琉部栖は妾が直々に育てた子じゃ。もし、その二人ですら応じてくれぬというのなら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440413
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440413,
					"content": "じゃが、妾一人の記憶だけでは、足りぬようなのじゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440414
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440414,
					"content": "何か媒介となるものがあったらどんなによかったことか…太陽の子の身分を証明する手綱があれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440415
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440415,
					"content": "しかし残念なことに、あの手綱はとっくに失われておる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440416
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440416,
					"content": "はぁ…この白夜の国は、まだあの子らを恨んでおるのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440417
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440417,
					"content": "どうやら、あの子らの残魂を解放するなど、妾の過ぎた妄想だったようじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440418
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440418,
					"content": "旅人よ、妾の最後のお願いじゃ…「神輿手綱」がどこにあるか、探してきてはくれぬか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440419
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440419,
					"content": "とはいえ、見つかる可能性が低いうえに、もう主には色々と手伝ってもらっておる…これ以上頼みごとをするのが、図々しいことだというのも重々承知しておる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440420
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440420,
					"content": "じゃが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440421,
						722440422
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440421,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440423
					]
				},
				{
					"id": 722440423,
					"content": "ああ…本当にありがとう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440424
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440424,
					"content": "手綱は失われてから、すでに長い時が経っておる。だから、今さら急いでも結果に変わりはないじゃろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440425
					],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440425,
					"content": "手がかりが見つかったら、妾に教えてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "久利由売"
				},
				{
					"id": 722440422,
					"content": "最善を尽くす。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440423
					]
				},
				{
					"id": 722440405,
					"content": "それってつまり…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440426
					]
				}
			]
		},
