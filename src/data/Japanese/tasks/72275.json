	"talks": [
		{
			"id": 7227501,
			"completionStepIds": [
				7227501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7227501",
							"2"
						],
						"stepId": 7227501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"烏帽子",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722750101,
					"content": "この身が顕現したということは、血枝珊瑚は海祇の手に渡ったということですね。安心しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750102
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750102,
					"content": "私はエレボス、稲妻式の名を烏帽子と申します。珊瑚宮の補佐官であり、淵下宮の巫女の一人です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750103
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750103,
					"content": "あなたが、珊瑚の枝を手にした勇者ですね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750104
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750104,
					"content": "うん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750105
					]
				},
				{
					"id": 722750105,
					"content": "先に断っておきますが、これからお話しすることは、複雑すぎてどこから話せばいいのか困るほどのものです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750106
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750106,
					"content": "そうなのか、なら最初から順に話してくれ。オイラたち、最後までちゃんと聞くからさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722750107,
					"content": "ありがとうございます。では、事情を説明したいと思います。すべては、海祇大御神が海淵の門を開いたことから始まりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750108
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750108,
					"content": "淵下宮の深部には天然の鍾乳洞があり、海祇島へ繋がっています。そして海祇島は、海祇によって約束された地上の楽土でもあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750109
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750109,
					"content": "我々は大御神の命により、鳴神の文化を学び、その土地と外交関係を築きました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750110
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750110,
					"content": "ちなみに、鳴神島の人々は我々のことを「海祇美人」と呼んでいました。なぜなら、我々海祇人の肌はきめ細かく、隠しきれない七種の穢れが目立たないためです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750111
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750111,
					"content": "我々も先祖も淵下宮で生活していたことにより、日差しを浴びる機会がなく…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750112,
						722750113
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750112,
					"content": "要点だけ話してほしい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750114
					]
				},
				{
					"id": 722750114,
					"content": "あっ、すみません。以前諸国と外交を行っていた頃、珊瑚宮の補佐官として色々と案内していたので…つい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750115
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750115,
					"content": "話を戻します。あの時、私と珊瑚宮様の間に、意見の食い違いが生じていました。海祇大御神の仲介により、今の案が生まれたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750116
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750116,
					"content": "淵下宮には、「罪影」と呼ばれる現象があります。それによって「過去」や「歴史」、「真相」といったものが永遠に残り続けます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750117
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750117,
					"content": "だからでしょう、我々が望むのは「心に銘じる」ことではなく、「忘れる」ことだと珊瑚宮様は考えたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750118
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750118,
					"content": "（ここで言ってる珊瑚宮って、たぶんすごく昔の珊瑚宮の巫女のことだろうな…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722750119,
					"content": "珊瑚の枝の試練も、あとから来た者が極力真相を知ることがないよう設計されています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750120
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750120,
					"content": "しかし、私は真相を残すべきだと思いました。その結果、海祇大御神が新たに試練を追加し、それを通過した者にだけ秘密を明かすことにしたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750121
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750121,
					"content": "この試練、お受けいただけますでしょうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750122,
						722750123
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750122,
					"content": "試練を受ける。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750124
					]
				},
				{
					"id": 722750124,
					"content": "はい。では、追加の試練を開始させていただきます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750123,
					"content": "秘密に興味がある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750124
					]
				},
				{
					"id": 722750113,
					"content": "その話は置いといて、要点を…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750114
					]
				}
			]
		},
		{
			"id": 7227502,
			"completionStepIds": [
				7227506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7227506",
							"2"
						],
						"stepId": 7227506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"烏帽子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722750201,
					"content": "これであなたは、すべての地走官の承認を得ました。彼らは海祇の意志を代表しています。つまり、あなたはすべてを知る権利を得たということです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750202
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750202,
					"content": "あなたは海祇の民を救った救世主であり、海祇に認められたお方。あなたはすべてを知るべきでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750203
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750203,
					"content": "ですが、これらの真相は決して外の者に漏らさないでください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750204
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750204,
					"content": "何か知りたいことはございますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750205,
						722750206,
						722750207,
						722750208,
						722750209
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750205,
					"content": "アビサルヴィシャップについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750210
					]
				},
				{
					"id": 722750210,
					"content": "アビサルヴィシャップは原初の元素生物です。長いこと深海で生息していたため、天が振りかざす力に支配されることはありませんでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750211
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750211,
					"content": "アビサルヴィシャップはとても賢く、進化することに長けています。我々との戦いの歴史においても、他の元素に進化した品種が確認されています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750212
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750212,
					"content": "もしもアビサルヴィシャップが言語を会得した場合、リザードマンに進化してもおかしくはありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750213
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750213,
					"content": "「聖土化」とは、アビサルヴィシャップの生息地の拡大を意味します。つまり、三界にある原初の元素力が強くなるということです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750214
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750214,
					"content": "我々にできるのは、海祇大御神の生命力でやつらの第二眷属を呼び覚まし、荒れ狂う元素力を変換させること、それだけです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750204
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750206,
					"content": "海祇大御神について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750215
					]
				},
				{
					"id": 722750215,
					"content": "海祇大御神はその厄運から、「天の秩序」の管轄外であるこの場所に落ちました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750216
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750216,
					"content": "このことは、我々白夜国の民にとって間違いなく幸運でした。我々のために数々のことを成してくれたのですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750217
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750217,
					"content": "しかし我々と接触したことにより、あの方は自身が誕生するよりも前の真相に触れてしまったのです。それにより天からの勅令を受け、自らを犠牲にすることを余儀なくされました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750218
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750218,
					"content": "その犠牲の真相を、誰にも知られてはなりませんでした…そうすることでしか、白夜の民は新たな「七の秩序」の下で生きることを許されなかったのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750204
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750207,
					"content": "日月よりも前のことについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750219
					]
				},
				{
					"id": 722750219,
					"content": "白夜国が海淵へと落ちる前、統一された文明は確かに存在していました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750220
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750220,
					"content": "そして大戦が起こることで、天は崩落し、地は裂開。この土地もその時、漆黒の海淵へと落ちたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750221
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750221,
					"content": "天の秩序は、このことを知る者が大地に残っていることを望みませんでした。我々も帰路を探そうと試みましたが、失敗に終わっています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750222
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750222,
					"content": "それから長い時を経て、ようやく天の禁令の力が弱まり、海祇大御神がここに落ちたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750204
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750208,
					"content": "大日御輿について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750223
					]
				},
				{
					"id": 722750223,
					"content": "大日御輿は賢者·アブラクサスが設計した建造物で、海淵に光をもたらす力があります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750224
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750224,
					"content": "それ以外にも、様々な機能を有しています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750225
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750225,
					"content": "あれは、実に優れたものです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750204
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750209,
					"content": "他に用はない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750226
					]
				},
				{
					"id": 722750226,
					"content": "はい。淵下宮で起こったことについては、永遠の秘密。どうか心の中にしまっておいてくださいね。",
					"roleType": "TALK_ROLE_NPC",
