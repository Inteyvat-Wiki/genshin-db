			"dialogs": [
				{
					"id": 760240501,
					"content": "よく分からないまま、ひとまず女の子の近くへ向かった…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760240502
					]
				},
				{
					"id": 760240502,
					"content": "宝盗イタチには気をつけてね。あいつら、モレー谷に居座ってけっこう経つの。もし当たったりしたら、あなたたちも影のない人になっちゃうよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240503
					],
					"speakerTitle": "アウニ"
				},
				{
					"id": 760240503,
					"content": "宝盗イタチ？どこに宝盗イタチがいるんだ？それに影のない人っていったい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760240504,
					"content": "うわっ！まさか、宝盗イタチが機械をいじって、オイラたちを攻撃しようとしてるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760240505,
					"content": "人間に飼われてたから、人間より頭がいいかもしれないよ。そのせいで、大きい人たちはみんな追い払われちゃったんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240506
					],
					"speakerTitle": "アウニ"
				},
				{
					"id": 760240506,
					"content": "大きい人たちも試してたけど、全部失敗したみたい。<color=#00E1FFFF>エネルギー貯蔵コアを取り除く</color>だけでいいって話だけど、いつも最後の一歩で失敗するの。言うほど簡単じゃないってことだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240507
					],
					"speakerTitle": "アウニ"
				},
				{
					"id": 760240507,
					"content": "#うーん、つまりエネルギー貯蔵コアを取っちゃえば、宝盗イタチを止められるってことだよな？{NICKNAME}、オイラたちでやってみるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240508
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760240508,
					"content": "このまま放っておいたら危ないぜ。こんな小さな子供までいるんだし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240509
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760240509,
					"content": "パイモンの頼みなら、もちろんいいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240510
					]
				},
				{
					"id": 760240510,
					"content": "よし。じゃあ、おちびちゃんはここに隠れて…そういえば、名前はなんていうんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240511
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760240511,
					"content": "…「おちびちゃん」って一番小さい子のことじゃないの？よくわかんないけど…あたしはアウニ。「アウニお姉さん」って呼んで。じゃないと変だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240512
					],
					"speakerTitle": "アウニ"
				},
				{
					"id": 760240512,
					"content": "#ええと…なんて呼ぶかは後にしようぜ！{NICKNAME}、まずは宝盗イタチを止めるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
