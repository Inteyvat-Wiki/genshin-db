			"dialogs": [
				{
					"id": 760240401,
					"content": "そういえば今気づいたけど、宝盗イタチたちが逃げてった方向って、あっちの丘のほうだったよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760240402,
					"content": "うん。あれも宝盗イタチの兄貴を訓練してた大きな人が持ってきた物なの。前に宝盗イタチの兄貴が、あれを使って大きい人たちを攻撃したんだけど、みんなころげまわってたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240403,
						760240404
					],
					"speakerTitle": "アウニ"
				},
				{
					"id": 760240403,
					"content": "想像しづらい光景だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240406
					]
				},
				{
					"id": 760240406,
					"content": "#うーん、とりあえず丘に行って調べてみようぜ。宝盗イタチが待ち伏せしてるかもしれないし、転げ落ちないよう気を付けろよ、{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760240404,
					"content": "その時、現場にいればなぁ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240405
					]
				},
				{
					"id": 760240405,
					"content": "手伝いたかったのか？…いや、ただ野次馬になりたかっただけだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240406
					],
					"speakerTitle": "パイモン"
				}
			]
