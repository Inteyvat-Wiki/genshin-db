			"dialogs": [
				{
					"id": 760240101,
					"content": "ふん！もう大人しく捕まるんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760240102,
					"content": "宝盗イタチの兄貴をこんなに近くで見るのって初めて…パイモンも、ちゃんと「兄貴」って呼ぶんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240115
					],
					"speakerTitle": "アウニ"
				},
				{
					"id": 760240115,
					"content": "なっ…あんな悪党、誰が宝盗イタチの「兄貴」だなんて呼ぶか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760240118,
					"content": "それもそうだね。悪い子はお兄ちゃんにはなれないもん。きっとお葬式に来てくれる人もいない…そもそも開かれないかもね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240132
					],
					"speakerTitle": "アウニ"
				},
				{
					"id": 760240132,
					"content": "そうだ、前にヘルカから聞いたことがあるの。変わったお肉を食べるのが好きな変わり者がいるんだって…たとえば、宝盗イタチのお肉とか。それに、標本をコレクションするのが好きな人も…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240133
					],
					"speakerTitle": "アウニ"
				},
				{
					"id": 760240133,
					"content": "思ったんだけど、標本になった場合も、お肉になった場合も、お葬式は必要なさそうだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240134
					],
					"speakerTitle": "アウニ"
				},
				{
					"id": 760240134,
					"content": "うわあ…アウニ、さらっと恐ろしいことを口にしてるぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240135
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760240135,
					"content": "（とても怖がっているようだ…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240136
					],
					"speakerTitle": "「宝盗イタチの兄貴」"
				},
				{
					"id": 760240136,
					"content": "待てっ、逃げるな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240137
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760240137,
					"content": "あれ？逃げたわけじゃないのか。あそこでオイラたちを待ってる？よし、行ってみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7602402,
