			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アウニ"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							1648.494,
							213.477,
							9656.33
						],
						"pointId": 11564
					},
					{
						"sceneId": 3,
						"position": [
							1651.032,
							213.487,
							9656.428
						],
						"pointId": 360700011
					},
					{
						"sceneId": 3,
						"position": [
							1650.233,
							213.48,
							9657.646
						],
						"pointId": 360700069
					}
				]
			},
			"dialogs": [
				{
					"id": 760240201,
					"content": "#{NICKNAME}{M#お兄ちゃん}{F#お姉ちゃん}、あの大きい人たちより強いんだ。大きければ強いってわけじゃないんだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240202
					],
					"speakerTitle": "アウニ"
				},
				{
					"id": 760240202,
					"content": "#ふふん、そうだぞ！そんなに背は高くないけど、{NICKNAME}は自分より何倍も大きい魔物だってへっちゃらなんだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240203,
						760240205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760240203,
					"content": "パイモンに比べたらまだまだだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240204
					]
				},
				{
					"id": 760240204,
					"content": "えっ？そ、そんなに褒められても…しょうがないなぁ、今度美味しいものを見つけたら、ちょっと多めに分けてやるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760240206,
					"content": "#じゃあ、{NICKNAME}{M#お兄ちゃん}{F#お姉ちゃん}なら、宝盗イタチをモレー谷から追い出せるよね？ここはあいつらの家じゃないのに、好き勝手暴れてるんだもん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240207
					],
					"speakerTitle": "アウニ"
				},
				{
					"id": 760240207,
					"content": "やるはずだったお葬式もできなくなっちゃったし、モレーおじいさんなんて、あいつらのせいで死んじゃったかもしれないんだよ。あ、でも改めてお葬式を開くなら、先に家族を見つけてあげないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240208
					],
					"speakerTitle": "アウニ"
				},
				{
					"id": 760240208,
					"content": "えっ！？宝盗イタチが…そういえば、その葬式のこと、さっきは聞けなかったけど…ま、まさか本当にここで葬式をやる気か？なんでこんな場所を選んだんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760240209,
					"content": "もちろんここでやるよ。準備は済ませてあるし、お葬式で歌う歌も決めてあるんだから。ほら、見せてあげる。でも、安らかに眠らせてあげたいから、大きな声は出さないでね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240210
					],
					"speakerTitle": "アウニ"
				},
				{
					"id": 760240210,
					"content": "アウニはポケットから小さなマッチ箱を取り出した。開くと、そこには小さな花柄の布に横たわる、きれいな色のカブトムシがいた。その周りには、白い花びらまで添えられていた…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760240211
					]
				},
				{
					"id": 760240211,
					"content": "彼はもう永遠の眠りについちゃったから、お葬式を開いてあげたいんだ。でも、選んだ場所はどこも宝盗イタチが占領してたの。マシンが置かれてる丘の上もそう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240212
					],
					"speakerTitle": "アウニ"
				},
				{
					"id": 760240212,
					"content": "モレーおじいさんの家族は逃げちゃったか、死んじゃったかのどっちかだと思う。家が宝盗イタチに踏み荒らされちゃったんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240213
					],
					"speakerTitle": "アウニ"
				},
				{
					"id": 760240213,
					"content": "#（{NICKNAME}、アウニの言う「モレーおじいさん」ってたぶん…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240214,
						760240216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760240214,
					"content": "（小動物か何かだろうね。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240215
					]
				},
				{
					"id": 760240215,
					"content": "（オイラもそう思うぞ。アウニには動物の友達がいたんだな。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760240218,
					"content": "よし！そういうことなら、オイラたちでアウニの代わりに、悪さを働く宝盗イタチを捕まえてやろうぜ！モレーおじいさんの家族のことは…宝盗イタチを捕まえてから一緒に探せばいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240219
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760240219,
					"content": "#わぁ、{NICKNAME}{M#お兄ちゃん}{F#お姉ちゃん}とパイモンは優しいんだね。お葬式には絶対呼んであげるからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240220
					],
					"speakerTitle": "アウニ"
				},
				{
					"id": 760240220,
					"content": "そ、それは別にいいぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240221
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760240221,
					"content": "わかった。じゃあ、この前買った飴細工を…あれっ、もうなくなってたみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240222
					],
					"speakerTitle": "アウニ"
				},
				{
					"id": 760240222,
					"content": "でも、ユルヴァお兄ちゃんがくれたお小遣いがまだあるし…うーん、じゃあこのお小遣いあげるから、飴細工を買って食べるといいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240223
					],
					"speakerTitle": "アウニ"
				},
				{
					"id": 760240223,
					"content": "人に何か頼むときは、ちゃんと報酬を用意してお礼も言わないとね、うん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240224,
						760240226
					],
					"speakerTitle": "アウニ"
				},
				{
					"id": 760240224,
					"content": "パイモン、小さな子から飴を奪うなんて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240225
					]
				},
				{
					"id": 760240225,
					"content": "その言い方だと、オイラが悪人みたいだろ！それにしても、アウニはまだ小さいのに、すごく礼儀正しいんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240227
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760240227,
					"content": "ありがとう。でも飴細工を買うためのモラは、一人一個分までだよ。褒めてもおまけはないからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240228
					],
					"speakerTitle": "アウニ"
				},
				{
					"id": 760240228,
					"content": "そこは現実的なんだな…それで、さっきのおまえの話からすると、悪さを働いてる宝盗イタチは一匹だけじゃないんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240229
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760240229,
					"content": "うん。さっき逃げていったのは、あたしが前に見た宝盗イタチの兄貴とは違うやつだよ。どれくらい子分がいるのかは、あたしもわからないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240230
					],
					"speakerTitle": "アウニ"
				},
				{
					"id": 760240230,
					"content": "でも、あっちにもここと同じ弾を撃ってくるクロウマシンがあるから、そこで宝盗イタチの子分を見つけられるかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240231
					],
					"speakerTitle": "アウニ"
				},
				{
					"id": 760240231,
					"content": "#よし、今度こそ逃がさないぞ、宝盗イタチめ！{NICKNAME}、オイラたちで悪どい宝盗イタチを懲らしめてやろうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760240226,
					"content": "アウニは礼儀正しいんだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240227
					]
				},
				{
					"id": 760240216,
					"content": "（以前ここに住んでた人かもね。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240217
					]
				},
				{
					"id": 760240217,
					"content": "（え？誰かがここで長く暮らしてたって感じはしないぞ…たぶんアウニは動物の友達のことを言ってるんじゃないか？ほら、カブトムシのためにお葬式を開くくらいだし。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760240205,
					"content": "たとえ小さな魔物でも容赦はしないよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240206
					]
				}
			]
		},
