			"dialogs": [
				{
					"id": 760241501,
					"content": "わぁ、モレーファミリーだ。おじいさん、パパとママ、モレーにちびモレー…他のモレーたちもみんな揃ってる。一人もいなくなってないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241502
					],
					"speakerTitle": "アウニ"
				},
				{
					"id": 760241502,
					"content": "クンクンモグラのことだったのか！でも、アウニはどうやって見分けてるんだ？全員、同じに見えるけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760241503,
					"content": "みんなそれぞれ性格が違うんだ。長く一緒にいれば、わかるようになるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241504
					],
					"speakerTitle": "アウニ"
				},
				{
					"id": 760241504,
					"content": "まあ、みんな物乞いをするっていう、共通の悪い癖はあるけど。はあ、かわいそうな子たち。もし人類がこの世からいなくなったら、どうするんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241505
					],
					"speakerTitle": "アウニ"
				},
				{
					"id": 760241505,
					"content": "…人類がいなくなる？そうなった後も、クンクンモグラは健在なのか？ま、まさか…あり得ないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241506
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760241506,
					"content": "リンネアお姉ちゃんが言ってた。動物は色々な原因で滅びるものだって。だったら、人間も絶滅するかもしれないでしょ？パイモンはどうしてそう思わないの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241507,
						760241509
					],
					"speakerTitle": "アウニ"
				},
				{
					"id": 760241507,
					"content": "#{M#俺}{F#私}はモグラより長生きすると思うけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760241508
					]
				},
				{
					"id": 760241508,
					"content": "それじゃあ、アウニの質問の答えにはなっていないだろ。うーん、そう考えると人間って危険な立場に置かれてるんだな。人間の生命を脅かす存在ってたくさんいるし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241512
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760241512,
					"content": "それはそうと…モグラの一家は全員見つけたけど、三匹の宝盗イタチはどうすりゃいいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241513
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760241513,
					"content": "どうしたらいいか分からないなら、「フラッグシップ」の人に任せればいいよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241514
					],
					"speakerTitle": "アウニ"
				},
				{
					"id": 760241514,
					"content": "宝箱だぞ！うーん、これって賄賂ってやつなのか？まぁいいや！くれるんなら遠慮なく貰っとくぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241515
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760241515,
					"content": "#{NICKNAME}、あいつらもちゃんと反省してるみたいだし、今回は見逃してやろうぜ。べ、別に宝箱に免じてってわけじゃないからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760241509,
					"content": "虫は人間が誕生する前からいるらしい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760241510
					]
				},
				{
					"id": 760241510,
					"content": "人間が絶滅してもきっと健在だろうね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760241511
					]
				},
				{
					"id": 760241511,
					"content": "虫に負けるなんて…なんだか悔しい感じがするぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241512
					],
					"speakerTitle": "パイモン"
				}
