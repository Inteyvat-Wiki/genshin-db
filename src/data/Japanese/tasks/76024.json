			},
			"dialogs": [
				{
					"id": 760240801,
					"content": "そうだ、お葬式をあげなくちゃ。他のホラガイ団メンバーも呼ぶべきかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240802,
						760240805,
						760240808
					],
					"speakerTitle": "アウニ"
				},
				{
					"id": 760240802,
					"content": "ホラガイ団について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240803
					]
				},
				{
					"id": 760240803,
					"content": "あなたも入りたいの？それなら「スペランザ」にいるユルヴァお兄ちゃんに会ってみて。あっ、でも投票をするってなると、ヘルカがいないんだよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240804
					],
					"speakerTitle": "アウニ"
				},
				{
					"id": 760240804,
					"content": "でも大丈夫。ユルヴァお兄ちゃんなら、別の方法を知ってるはずだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アウニ"
				},
				{
					"id": 760240805,
					"content": "クンクンモグラについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240806
					]
				},
				{
					"id": 760240806,
					"content": "たぶん、ずっと人間と一緒に暮らしてきたから、人間みたいな行動をとるようになったんだと思う。宝盗イタチもそうだし、ナタの竜もそうらしいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240807
					],
					"speakerTitle": "アウニ"
				},
				{
					"id": 760240807,
					"content": "でも、それって良いことなのかな、悪いことなのかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アウニ"
				},
				{
					"id": 760240808,
					"content": "またね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240809
					]
				},
				{
					"id": 760240809,
					"content": "うん、気をつけてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アウニ"
				}
			]
