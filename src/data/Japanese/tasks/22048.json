			"dialogs": [
				{
					"id": 220480101,
					"content": "神社がまた乱れてるにゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480102
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220480102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220480103
					]
				},
				{
					"id": 220480103,
					"content": "にゃおーん、主らか、ちょうどいい時に来た。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480104
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220480104,
					"content": "神社の周りがまた乱れてるにゃ。落ち葉もたまってるし、汚いにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480105
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220480105,
					"content": "これじゃ神社に来た人間をおもてなしすることはできにゃい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480106
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220480106,
					"content": "主ら、前と同じように、神社を掃除してくれにゃいか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480107,
						220480112
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220480107,
					"content": "大祐と悦子は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220480108
					]
				},
				{
					"id": 220480108,
					"content": "うちは自分からあの緑色の二人に声をかけることはにゃい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480109
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220480109,
					"content": "あの背の高い人間、うちを見る眼差しがとても変にゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480110
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220480110,
					"content": "もう一人の緑色の人間も、いつもやる気がなさそうにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480111
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220480111,
					"content": "にゃおーん、どう考えても、頼りにならない人間にゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480115
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220480115,
					"content": "とにかく、主らに任せた。前と同じように、長い棒で「掃除」してくれ。いいにゃ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480116,
						220480117
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220480116,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220480118
					]
				},
				{
					"id": 220480118,
					"content": "とにかく、このことは頼んだにゃ。うちは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480119
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220480119,
					"content": "うちはここで主らを待つことにするにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220480117,
					"content": "なんとなく分かった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220480118
					]
				},
				{
					"id": 220480112,
					"content": "大島さんに頼んだら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220480113
					]
				},
				{
					"id": 220480113,
					"content": "あの石人間はずっと忙しくしているにゃ。いつも何かを叩いてる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480114
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220480114,
					"content": "石はもうできたはずなのに、なんでまだ叩いてるにゃ。おかしいにゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480115
					],
					"speakerTitle": "「寝子」"
				}
			]
		},
