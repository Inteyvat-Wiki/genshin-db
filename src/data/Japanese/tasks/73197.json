						731970102
					],
					"speakerTitle": "箴言板"
				},
				{
					"id": 731970102,
					"content": "まさに「日光の下に新しいことはない」、でございます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "箴言板"
				}
			]
		},
