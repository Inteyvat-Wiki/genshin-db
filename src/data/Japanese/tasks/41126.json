			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"嘉義"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411260101,
					"content": "はあ、どうしたものか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260102
					],
					"speakerTitle": "嘉義"
				},
				{
					"id": 411260102,
					"content": "何があったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260103
					]
				},
				{
					"id": 411260103,
					"content": "空から降る隕石は、君も見ただろ。城内は問題ないが、外はめちゃくちゃでな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260104
					],
					"speakerTitle": "嘉義"
				},
				{
					"id": 411260104,
					"content": "それに隕石は、道を塞ぐこと以外にも、魔物を狂暴にしたりして、通行人や商人を襲ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260105
					],
					"speakerTitle": "嘉義"
				},
				{
					"id": 411260105,
					"content": "総務司も空いてる千岩軍は全部向かわせたが、何せ璃月が大きすぎてな、主要な道と村の安全しか確保できてない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260106
					],
					"speakerTitle": "嘉義"
				},
				{
					"id": 411260106,
					"content": "俺は軽策荘の護衛を申請したんだが、なぜかここに配置された…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260107
					],
					"speakerTitle": "嘉義"
				},
				{
					"id": 411260107,
					"content": "旅人、軽策荘に行ってこの手紙を、六っていう女の子に渡してくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260108
					],
					"speakerTitle": "嘉義"
				},
				{
					"id": 411260108,
					"content": "俺の娘でな。元々家で何日か一緒に過ごす約束をしたんだが、今回の出来事で、帰れそうにない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260109,
						411260111
					],
					"speakerTitle": "嘉義"
				},
				{
					"id": 411260109,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260110
					]
				},
				{
					"id": 411260110,
					"content": "じゃあ頼んだよ。あぁ、なんでこんなことに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260115
					],
					"speakerTitle": "嘉義"
				},
				{
					"id": 411260115,
					"content": "でも、あっちから来た護衛が言うには、軽策荘の近くにも魔物がたくさん集まってるらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260116
					],
					"speakerTitle": "嘉義"
				},
				{
					"id": 411260116,
					"content": "その…見たところ、君は冒険者だろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260117
					],
					"speakerTitle": "嘉義"
				},
				{
					"id": 411260117,
					"content": "手紙を送る時に、軽策荘の近くの魔物も一緒に片付けてくれないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260118
					],
					"speakerTitle": "嘉義"
				},
				{
					"id": 411260118,
					"content": "千岩軍は主な道だけを守る…もし他の魔物が軽策荘に入ったらまずい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260119,
						411260121
					],
					"speakerTitle": "嘉義"
				},
				{
					"id": 411260119,
					"content": "分かった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260120
					]
				},
				{
					"id": 411260120,
					"content": "ありがとう、じゃあ頼んだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嘉義"
				},
				{
					"id": 411260121,
					"content": "これは追加依頼として…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260122
					]
				},
				{
					"id": 411260122,
					"content": "うん、それは…安心してくれ。それ相応の報酬を用意する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260123
					],
					"speakerTitle": "嘉義"
				},
				{
					"id": 411260123,
					"content": "では頼んだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嘉義"
				},
				{
					"id": 411260111,
					"content": "仕方ないよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260112
					]
				},
				{
					"id": 411260112,
					"content": "分かってる、でも…毎回休日に限って、こんな事が起きるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260113
					],
					"speakerTitle": "嘉義"
				},
				{
					"id": 411260113,
					"content": "本当についてない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260114
					],
					"speakerTitle": "嘉義"
				},
				{
					"id": 411260114,
					"content": "じゃあ頼んだよ、この手紙を軽策荘の六に渡してくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260115
					],
					"speakerTitle": "嘉義"
				}
			]
		},
