			"dialogs": [
				{
					"id": 732150501,
					"content": "こんにちは、金色のナラ！それに、小さな白いふわふわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150502
					],
					"speakerTitle": "アランナキン"
				},
				{
					"id": 732150502,
					"content": "ふん、オイラは小さくないぞ！おまえ、自分を見てみろよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732150503,
					"content": "ふん、ボクだって小さくないさ！えっと…そうだ、キミたちどうしてここに来たの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150504
					],
					"speakerTitle": "アランナキン"
				},
				{
					"id": 732150504,
					"content": "アランナキンたちに会いに来ただけ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150505
					]
				},
				{
					"id": 732150505,
					"content": "おう、なにしろ、これまでたくさん悪いものを倒し、一緒に歌を歌って、「ムーティーマ」を救ってやったからな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150506
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732150506,
					"content": "「マウティイェマ」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150507
					],
					"speakerTitle": "アランナキン"
				},
				{
					"id": 732150507,
					"content": "おう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150508
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732150508,
					"content": "うぅ…ごめん、キミたちの言ってること、本当のようだね。でも、ボクは何も思い出せなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150509
					],
					"speakerTitle": "アランナキン"
				},
				{
					"id": 732150509,
					"content": "うぅ…！大丈夫、大丈夫だぞ！悲しむなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150510
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732150510,
					"content": "（本当になにも覚えてないのか…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
