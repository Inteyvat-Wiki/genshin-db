			},
			"dialogs": [
				{
					"id": 732150201,
					"content": "こんにちは、こんにちは！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150202
					],
					"speakerTitle": "アランナキン"
				},
				{
					"id": 732150202,
					"content": "こんにちは、チビっこ！オイラたちのことをまだ覚えてるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732150203,
					"content": "ぐぬぬ。白いふわふわ、ボクはチビっこじゃない！ボクが教えてあげた歌は覚えているかい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150204
					],
					"speakerTitle": "アランナキン"
				},
				{
					"id": 732150204,
					"content": "もちろん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150205
					]
				},
				{
					"id": 732150205,
					"content": "よかった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150206
					],
					"speakerTitle": "アランナキン"
				},
				{
					"id": 732150206,
					"content": "それじゃ、約束。たとえボクが自分の歌を忘れたとしても…キミたちは覚えていてくれよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランナキン"
				}
			]
		},
