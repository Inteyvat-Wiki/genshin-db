				"points": []
			},
			"dialogs": [
				{
					"id": 732150101,
					"content": "こんにちは、友達のナラ！うぅ…何か言いたかった気がするんだけど、思い出せない…でも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150102
					],
					"speakerTitle": "アランナガ"
				},
				{
					"id": 732150102,
					"content": "大丈夫だ、また会えてオイラたちも嬉しいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732150103,
					"content": "ウン、ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150104,
						732150106
					],
					"speakerTitle": "アランナガ"
				},
				{
					"id": 732150104,
					"content": "「マウティイェマ」について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150105
					]
				},
				{
					"id": 732150105,
					"content": "もう喋らない、カノジョ。だけど、元気みたい。それに回復してる、森も…ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランナガ"
				},
				{
					"id": 732150106,
					"content": "忘れることについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150107
					]
				},
				{
					"id": 732150107,
					"content": "忘れる…？うん。力が尽きてしまった、「クサヴァ」。だから、記憶は流れていく。少しずつ、露のように…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランナガ"
				}
			]
		},
