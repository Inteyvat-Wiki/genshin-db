			},
			"dialogs": [
				{
					"id": 732150301,
					"content": "よう、ありがとな！金色のナラと白いふわふわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150302
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 732150302,
					"content": "何しに来たんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150303
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 732150303,
					"content": "また一緒に遊ぶって言ってただろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732150304,
					"content": "うぅ、ボク、そんなこと言ったっけか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150305,
						732150307
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 732150305,
					"content": "言ったよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150306
					]
				},
				{
					"id": 732150306,
					"content": "そっか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150309
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 732150309,
					"content": "とにかく、ありがとな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランガル"
				},
				{
					"id": 732150307,
					"content": "どうしたの、悩み事でもあるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150308
					]
				},
				{
					"id": 732150308,
					"content": "うぅ…ないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150309
					],
					"speakerTitle": "アランガル"
				}
			]
		},
