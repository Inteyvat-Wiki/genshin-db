			"dialogs": [
				{
					"id": 732150401,
					"content": "こんにちは、金色のナラと白いふわふわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150402
					],
					"speakerTitle": "アランナガ"
				},
				{
					"id": 732150402,
					"content": "こんにちは！元気か！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732150403,
					"content": "元気だよ、でも、何故ここに、キミたち？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150404
					],
					"speakerTitle": "アランナガ"
				},
				{
					"id": 732150404,
					"content": "え…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732150405,
					"content": "うぅ…困る、ボクたち。何か理由があるはずだけど、なぜキミたちが来たのか、わからない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150406
					],
					"speakerTitle": "アランナガ"
				},
				{
					"id": 732150406,
					"content": "オイラたちはここをよく知ってるんだぞ。それに、おまえたちとたくさん冒険をしてきた！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150407
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732150407,
					"content": "…？うぅ…そうだったの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150408
					],
					"speakerTitle": "アランナガ"
				},
				{
					"id": 732150408,
					"content": "前、一緒に経験したことも、こいつはもう覚えてないんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
