			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"モナ",
					"楓原万葉",
					"フィッシュル",
					"オズ",
					"辛炎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400760901,
					"content": "わっ！こ、これは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760902
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400760902,
					"content": "またモンドの家屋でござるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760903
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400760903,
					"content": "どうして私の家が——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760904
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400760904,
					"content": "家？これはあなたの家なの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760905
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400760905,
					"content": "おや、これはまた意外ですね…メギストス卿はかなり質素な生活を送ってきたと聞いていましたが、この邸宅は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760906
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 400760906,
					"content": "床に置かれた本にラベルが貼ってあるぞ。「希少品、たった99万モラ…」えっ！？そんなに高いのかよ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760907
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400760907,
					"content": "こっちにも、見るからに高そうな上製本がたくさんあるぜ…これが占星術師の部屋なのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760908
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400760908,
					"content": "部屋のしつらえも実によく出来ている…決して安くはないでござるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760909,
						400760910
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400760909,
					"content": "モナ、こんなにお金持ちだったの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400760911
					]
				},
				{
					"id": 400760911,
					"content": "私は時折手元に現金がないだけで、本当に貧乏というわけではありませんよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760912
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400760912,
					"content": "そうだったの？あなたにご飯を奢ったり、わたくしの家に招いてご馳走したりしたのに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760913
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400760913,
					"content": "お嬢様、お言葉が。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760914
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 400760914,
					"content": "あっ、コホンッ！汝は聖なる恵みを受け、わたくしと共に幽夜浄土の城へ行き、断罪の皇帝と皇后に謁見したではないか。かように重大な事を、忘れるとは何事か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760915
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400760915,
					"content": "あっ、そうでした。お母さまの作ってくださったシチューとコールドカット、とても美味しかったです！あぁ、また食べたくなってきました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760916
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400760916,
					"content": "メギストス卿、今はそんなことを言っている場合ではありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760917
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 400760917,
					"content": "モンドの料理か？アタイも食べてみたいぜ！聞いた話によると、モンドには美食がたくさんあるんだろ、特に肉料理が！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760918
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400760918,
					"content": "ふふん、ならば汝らにも栄誉を与えよう。今度、わたくしに同行して皇帝と皇后に謁見してもいいわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760919
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400760919,
					"content": "いいのか？おい、オイラたちも行こうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760920
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400760920,
					"content": "そういえば、拙者も友人の家へ行くのは久方ぶりでござる。ここはご厚意に甘えさせていただくとしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760921
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400760921,
					"content": "ふむ、手土産など用意したほうがよいだろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760922
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400760922,
					"content": "あのお二方は気さくで親切ですので、そういうことはお気になさいません。どうぞ、お構いなく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760923
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 400760923,
					"content": "もし行くのでしたら、絶対にあのコールドカットを食べてみてください。得意料理だそうで、とても美味しいですよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760924
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400760924,
					"content": "それよりも、今は目下の謎を解決したほうがいいのではないでしょうか？実は、部屋に入ってから、あの置物が気になっていたのですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760925
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 400760925,
					"content": "ああ、そうでしたね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "モナ"
				},
				{
					"id": 400760910,
					"content": "おみそれしました…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400760911
					]
				}
			]
		},
		{
			"id": 4007613,
			"completionStepIds": [
				4007613
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007613",
							"2"
						],
						"stepId": 4007613,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"モナ",
					"辛炎",
					"フィッシュル",
					"楓原万葉",
					"オズ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400761301,
					"content": "ここに戻ってきたってことは…もう完全に幻境を離れたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400761302,
					"content": "おかしいですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761303
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400761303,
					"content": "私の幻境には、ファデュイや装置の手がかりがありませんでした…まさか、彼らとは無関係なのでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761304
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400761304,
					"content": "それとも、私たちに関係するこれらの幻境は、「過程」ではなく「結果」だった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761305
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400761305,
					"content": "えっと、どういう意味だ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400761306,
					"content": "つまり、これらの幻境は、謎を解決する手がかりに導いてくれる存在ではなく、単なる結果だったのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761307
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400761307,
					"content": "誰かが何かをやって、これらの幻境が誕生した。ただの副産物ですので、当然ながら私たちに何かを示すことはできません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761308
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400761308,
					"content": "言い換えれば、これらの幻境はアタイたち自身にしか関係ないってことだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761309
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400761309,
					"content": "純粋なる自我の結晶…ふむ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761310
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400761310,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761311
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400761311,
					"content": "皆の者、このことについては原点に戻ったほうが良さそうでござるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761312
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400761312,
					"content": "初めて島に上陸したあの日、拙者は旅人と共にファデュイの拠点を調べた。そこには、奇妙な装置があり、横にいたファデュイは意識がもうろうとしていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761313
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400761313,
					"content": "うん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400761314
					]
				},
				{
					"id": 400761314,
					"content": "拙者たちと交渉した研究員が言うには、あの装置は彼らファデュイによる発明品。それだけでなく、拙者たちの邪魔は決してしないという約束までしてくれたでござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761315
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400761315,
					"content": "そうそう、あの帽子をかぶった太っちょのやつ、なんか眠たそうで、訳のわからないこと言ってたな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761316
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400761316,
					"content": "もしかすると、「精神の乱れ」と「幻境の創造」は、装置によってもたらされた二つの結果なのではないだろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761317
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400761317,
					"content": "そしてそれらすべては、あの破損した装置と関係がある。しかし二つの違いを生むのは装置ではなく、影響を受けた者たちだった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761318
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400761318,
					"content": "……！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761319
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400761319,
					"content": "確かに、夢と幻覚は区別がつきにくいものです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761320
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400761320,
					"content": "私たちと彼らに違う点があるから、受けた影響の結果も違った…そう言いたいのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761321
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400761321,
					"content": "いかにも。ここ数日の観察からして…拙者たちとあの者らの違いは、拙者たちのほうがより強固な意志を持っている点でござろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761322
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400761322,
					"content": "…うん、ありえるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761323
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400761323,
					"content": "意志の固い人は狂気に陥ることがないから、ただ幻覚を生むだけ。その反対で打たれ弱い人は、ああいった安定した幻境を残すことができない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761324
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400761324,
					"content": "つまり、オイラたちは今すぐファデュイの拠点に戻って、あの装置を破壊しなきゃいけないってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761325
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400761325,
					"content": "いえ、「破壊」ではなく「修復」ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761326
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400761326,
					"content": "お嬢様は、むやみに未知の装置を壊すと深刻な事態を引き起こすかもしれないので、まずは修復を試みたほうがいいとおっしゃっています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761327
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 400761327,
					"content": "うむ、慎重に越したことはないでござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761328
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400761328,
					"content": "私の予想が正しければ、あの装置は人の脳に影響を与える可能性があります。用心して対処しましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761329
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400761329,
					"content": "よし、善は急げだ！今すぐ行こうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 4007615,
			"completionStepIds": [
				4007615
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007615",
							"2"
						],
						"stepId": 4007615,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"フィッシュル",
					"オズ",
					"モナ",
					"楓原万葉",
					"辛炎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400761501,
					"content": "なんて輝かしい景色なの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761502
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400761502,
					"content": "さすがは天才占星術師と言ったところでしょうか、メギストス卿。幽夜浄土の有史以来、あなたはもっとも優秀な大魔道士です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761503
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 400761503,
					"content": "ありがとうございます。ですが幽夜浄土の歴史はそれほど長くないのでは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761504
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400761504,
					"content": "…星は宝石の如く、月は真珠の如し。これは拙者が見てきた中で、もっとも壮大な星空でござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761505
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400761505,
					"content": "すっごくキレイだぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761506
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400761506,
					"content": "こんな幻境を持ってるなんて、モナの心にはきっと果てしなく広い星の海があるんだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761507
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400761507,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761508
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400761508,
					"content": "モナ、どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400761509
					]
				},
				{
					"id": 400761509,
					"content": "…これこそきっと、私たちが望んでいるものなんだと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761510
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400761510,
					"content": "この星空はとても美しい。それどころか、私が普段占いで見る景象よりも華やかです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761511
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400761511,
					"content": "この中のすべての星が、正しい位置にある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761512
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400761512,
					"content": "…これは間違いなく私の幻境であり、ここでのみ、このような奇観を見ることができます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761513
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400761513,
					"content": "奇観？どういうことだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761514
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400761514,
					"content": "知っていますか？テイワットの星空は、まるでこの世のすべての答えを隠しているかのように、霊妙なものなんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761515
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400761515,
					"content": "「失踪した息子はいつ戻ってくるんだ？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761516
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400761516,
					"content": "「あの人は私を愛しているの？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761517
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400761517,
					"content": "「病気は治るのだろうか？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761518
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400761518,
					"content": "どのようなことであろうと、すべてあなたの星屑の軌跡に記録される。しかし、世界中の人々のうち、かなりの割合の方が軌道から逸れてしまうのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761519
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400761519,
					"content": "あなたを表す星が軌道上にあれば、それはあなたが健康や幸福、安寧を得ることを意味します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761520
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400761520,
					"content": "逆に、あなたの星が軌道から逸れていたら、すべてが良くないほうに傾くということ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761521
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400761521,
					"content": "ですので、占いの結果にある星空は、決してこのようなものではありません。星たちは時に迷子になり、時に墜落する…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761522
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400761522,
					"content": "…私は皆さんが幸福を得られることを、そしてすべての方が軌道上にいられることを願っています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761523
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400761523,
					"content": "そのために、私はアドバイスをして、真実を伝えるのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761524
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400761524,
					"content": "これらが無駄なのは知っています。人の運命は夜空に顕現する。私もただその中の一つに過ぎず、何も変えることはできません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761525
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400761525,
					"content": "それでも…占星術以外に、真実の言葉を示すこと以外において、私はまだ非現実的な幻想を抱いているのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761526
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400761526,
					"content": "人はいつも真実の道の上を生きなければなりません。しかし…身の程知らずだとしても、それでも私は「奇跡」を期待しています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761527
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400761527,
					"content": "この広大な星の海には、あなたと、私と、彼と、すべての人の星があります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761528
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400761528,
					"content": "星と星は、一体どれほどの偶然があれば巡り合えるのでしょう？これらの巡り合いは、運命の中でもっとも美しい「奇跡」なのでしょうか？…私には分かりません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761529
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400761529,
					"content": "でも、テイワットの星空には常にあなたと私の居場所があります。たとえ占星術が絶対的な理性だとしても…運命は無常で、残酷で、ロマンあるものなんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761530
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400761530,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761531
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400761531,
					"content": "モナ、昔からずっと考えてきたようだけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400761532
					]
				},
				{
					"id": 400761532,
					"content": "もう答えは見つけた？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400761533
					]
				},
				{
					"id": 400761533,
					"content": "…私は、私の星の中に何が隠されているのか分かった気がします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761534
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400761534,
					"content": "——「今から、私は自分で自分の運命を掴みます」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "モナ"
				}
			]
		},
