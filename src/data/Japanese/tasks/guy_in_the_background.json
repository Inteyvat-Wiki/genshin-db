			"dialogs": [
				{
					"id": 2005402101,
					"content": "そうだね…「牢固な矢先」を探してきてほしいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005402102
					],
					"speakerTitle": "ゲイル"
				},
				{
					"id": 2005402102,
					"content": "ヒルチャールが落とすかもって騎士団の同僚から聞いたんだ。ハハッ、実戦の機会がないから聞いただけだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005402103
					],
					"speakerTitle": "ゲイル"
				},
				{
					"id": 2005402103,
					"content": "割と手に入れやすいらしいけど、俺はそんな簡単なこともできないからさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005402104
					],
					"speakerTitle": "ゲイル"
				},
				{
					"id": 2005402104,
					"content": "いつも父さんに「一族の未来は任せたぞ」って言われてるんだけど、なんか申し訳ないよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005402105
					],
					"speakerTitle": "ゲイル"
				},
				{
					"id": 2005402105,
					"content": "見つけたら、手紙と一緒に父さんに届けてほしい。頼む。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005402106
					],
					"speakerTitle": "ゲイル"
				},
				{
					"id": 2005402106,
					"content": "そうだ、手紙は開封しないでくれ。父さんはそういうのに敏感だから…開けたら偽物だって思ってしまうかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ゲイル"
				}
			]
		},
