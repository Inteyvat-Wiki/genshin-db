			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ゲイル"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 2005401101,
					"content": "はあ、毎日門番してるだけで、仕事内容とか何も書けないよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005401102
					],
					"speakerTitle": "ゲイル"
				},
				{
					"id": 2005401102,
					"content": "む、むしろ仕事がないほうが正しいのでは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005401103
					],
					"speakerTitle": "ゲイル"
				},
				{
					"id": 2005401103,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						2005401104
					]
				},
				{
					"id": 2005401104,
					"content": "ああ…父さんのことだよ。トゥナーと言って、アカツキワイナリーで働いてるんだ。俺が西風騎士になった後、すごく喜んでくれてね、手紙で仕事について聞かれるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005401105
					],
					"speakerTitle": "ゲイル"
				},
				{
					"id": 2005401105,
					"content": "でも俺はただの門番だよ、しかも誰も通らない側門を守ってるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005401106
					],
					"speakerTitle": "ゲイル"
				},
				{
					"id": 2005401106,
					"content": "父さんはいつか偉くなる日を楽しみにしてるって言ってくれたけど…門番が偉くなるわけがないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005401107
					],
					"speakerTitle": "ゲイル"
				},
				{
					"id": 2005401107,
					"content": "でも父さんは体がよくないから、もし俺がただの門番だって知ったら、怒ってまた体を壊すかもしれない。だから、騎士団の精鋭たちと野外で戦ってるっていつも手紙に書くんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005401108
					],
					"speakerTitle": "ゲイル"
				},
				{
					"id": 2005401108,
					"content": "手紙に書いてるだけで、何の証拠もないから、いつか疑われるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005401109
					],
					"speakerTitle": "ゲイル"
				},
				{
					"id": 2005401109,
					"content": "君は冒険に出かけてるんだよね。なにか戦利品を探してきてくれないかな？手紙と一緒に父さんに送りたいんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005401110,
						2005401111
					],
					"speakerTitle": "ゲイル"
				},
				{
					"id": 2005401110,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						2005401112
					]
				},
				{
					"id": 2005401112,
					"content": "ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ゲイル"
				},
				{
					"id": 2005401111,
					"content": "自分で行ったほうが…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						2005401113
					]
				},
				{
					"id": 2005401113,
					"content": "門番は将来有望って言えないけど、一応騎士団の仕事だから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005401114
					],
					"speakerTitle": "ゲイル"
				},
				{
					"id": 2005401114,
					"content": "仕事を疎かにできないし…この仕事がなくなったら、今度こそ父さんに怒られるよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ゲイル"
				}
			]
		},
		{
