			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ダナ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736950201,
					"content": "おっ、もう「文物模型」を全部見つけたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950202
					],
					"speakerTitle": "ダナ"
				},
				{
					"id": 736950202,
					"content": "そいつはすごいな！君には考古学の才能がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950203
					],
					"speakerTitle": "ダナ"
				},
				{
					"id": 736950203,
					"content": "では、こちらの報酬を受け取ってくれ。我が学院のイベントに参加してくれたお礼だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950204
					],
					"speakerTitle": "ダナ"
				},
				{
					"id": 736950204,
					"content": "今回の体験で、君が考古学の楽しさを味わってくれたら嬉しいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950205
					],
					"speakerTitle": "ダナ"
				},
				{
					"id": 736950205,
					"content": "現実の考古学においては、地道で大変な作業が殆どだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950206
					],
					"speakerTitle": "ダナ"
				},
				{
					"id": 736950206,
					"content": "重要な文化遺産が発掘されたその瞬間、全ての努力は報われるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950207,
						736950208
					],
					"speakerTitle": "ダナ"
				},
				{
					"id": 736950207,
					"content": "発掘できなかった時は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736950209
					]
				},
				{
					"id": 736950209,
					"content": "その時は…文字通り「骨折り損のくたびれもうけ」ってことになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950210
					],
					"speakerTitle": "ダナ"
				},
				{
					"id": 736950210,
					"content": "実際、そんなくたびれもうけのほうが日常さ。重要な文化遺産を発掘するチャンスなんて、ほんのわずかにあるかどうかだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950211
					],
					"speakerTitle": "ダナ"
				},
				{
					"id": 736950211,
					"content": "考古学を研究する上では、そういう状況に慣れること、そしてポジティブな考え方を持ち続けることが大事なんだ。でなければ、なかなか長続きしないのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ダナ"
				},
				{
					"id": 736950208,
					"content": "まあ、そういう時もあるだろう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736950209
					]
				}
			]
		},
