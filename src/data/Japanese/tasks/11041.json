					"アルベド"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110410401,
					"content": "あれがアルベドか？なんでこんな場所にいるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110410402,
					"content": "アルベドは絵を描くのが好きで、様々な場所でスケッチしていると聞いたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410403
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 110410403,
					"content": "ここは視界が開けているし、風景も悪くない、素材としては申し分ないからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410404
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 110410404,
					"content": "でも…ヒルチャールたちに気付いてないってことはないよな？襲われたりしたら大変だぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110410405,
					"content": "うわっ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 1104106,
			"completionStepIds": [
				1104106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104106",
							"2"
						],
						"stepId": 1104106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アルベド"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110410601,
					"content": "誰だい？なぜヒルチャールを驚かしたのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410602
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110410602,
					"content": "絵が完成してよかった、あやうく特別なヒルチャールを見逃すところだったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410603,
						110410604
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110410603,
					"content": "ヒルチャールの絵を描いてたんだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410605
					]
				},
				{
					"id": 110410605,
					"content": "けど、なんでヒルチャール？みんな似たような顔じゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410606
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110410606,
					"content": "うーん…説明するには複雑だから、ボクの絵を直接見てみるといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410607,
						110410608
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110410607,
					"content": "これは…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410609
					]
				},
				{
					"id": 110410609,
					"content": "おお、真面目に描いた作品もあれば、適当に描かれたものもあるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410610
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110410610,
					"content": "それらはどこにでもいるヒルチャールだ、時間をかける価値はない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410611
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110410611,
					"content": "でもこいつを見て、体格も毛髪も姿勢も、他とは違う生命力を感じるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410612
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110410612,
					"content": "繰り返される原始的な集団の暮らしの中で、そういった特殊性は進化を意味する。進化は無から有へ、既知から未知へ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410613
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110410613,
					"content": "待って、それ長くなるやつよね、私は興味ないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410614
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 110410614,
					"content": "人も見つけたし、私はここで失礼するわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410615
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 110410615,
					"content": "あっ、こいつに聞きたいことはないのか？おーい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410616
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110410616,
					"content": "はぁ。変わったやつだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410617
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110410617,
					"content": "シスターロサリアがここまで案内してくれたようだね。うーん、礼を言いそびれてしまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410618
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110410618,
					"content": "ところで、キミたちはわざわざボクを探しに来たのかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410619
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110410619,
					"content": "おう、モンドでスクロースって人に会ってな、おまえの力になってほしいって言われたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410620
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110410620,
					"content": "なるほど、彼女がキミたちを紹介したのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410621
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110410621,
					"content": "では、ボクの推測が正しければ、キミが話題のあの「栄誉騎士」なんだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410622
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110410622,
					"content": "龍災でのキミの働き、元素力に対する理解、それからいろいろと不思議なところも耳にしたよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410623
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110410623,
					"content": "結論から話そう、可能性はひとつ——キミは「別の世界」からやってきた、そうだね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410624,
						110410625
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110410624,
					"content": "うん、そうだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410626
					]
				},
				{
					"id": 110410626,
					"content": "よかった。キミの協力があれば、ボクの研究も大きく進むはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410627,
						110410628
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110410627,
					"content": "研究？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410629
					]
				},
				{
					"id": 110410629,
					"content": "あっ、すまない、戸惑ってるだろうね。どこから話そうか…ふむ、まずは生命の本質からにしようか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410630
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110410630,
					"content": "待て待て、さっそく理解できなそうな内容だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410631
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110410631,
					"content": "うん…確かに。言葉で説明するよりも、直接見せた方がいいかもね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410632
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110410632,
					"content": "例えば、生命を目覚めさせ、この枯れた枝を「再生」させるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410634
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110410634,
					"content": "そんなことできるのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410635,
						110410636
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110410635,
					"content": "錬金術は不思議だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410637
					]
				},
				{
					"id": 110410637,
					"content": "しかし…特殊な種があるんだが、今の方法では全然効果がなくてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410639
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110410639,
					"content": "キミと同じ、それは別の世界のもので——それを咲かす方法こそ、ボクが直面している課題だ。キミに助けてほしい内容でもある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410640
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110410640,
					"content": "おまえができないなら、オイラたちにもどうしようもないと思うけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410641
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110410641,
					"content": "いいや、ボクであっても、この世界以外の命を想像することはできない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410642
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110410642,
					"content": "でも、同じ異世界から来たキミを観察すれば、いろいろとアイデアが沸いてくると思うんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410643
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110410643,
					"content": "「研究対象」にしたいってこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410644
					]
				},
				{
					"id": 110410644,
					"content": "#どうしよう？{NICKNAME}？なんか怪しくないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410645,
						110410647
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110410645,
					"content": "危険性はある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410646
					]
				},
				{
					"id": 110410646,
					"content": "まさか、キミの安全は最大限に確保するから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410649
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110410649,
					"content": "善は急げ、場所を変えて研究を始めようか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410650
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110410650,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410651
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 110410651,
					"content": "アルベドと旅人、気が合うみたいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410652
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 110410652,
					"content": "あの二人はどちらも「異端」。モンドの平和に…影響を与えるかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 110410647,
					"content": "報酬はある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410648
					]
				},
				{
					"id": 110410648,
					"content": "モラ、知識、キミの知りたいこと、もしくはボクの知ってる答え、それでどうかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410649
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110410636,
					"content": "錬金術は便利だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410637
					]
				},
				{
					"id": 110410628,
					"content": "よく分からないけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410629
					]
				},
				{
					"id": 110410625,
					"content": "物知りなのは本当なんだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410626
					]
				},
				{
					"id": 110410608,
					"content": "前衛美術？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410609
					]
				},
				{
					"id": 110410604,
					"content": "風景画だと思ってた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410605
					]
				}
			]
		}
	]
}