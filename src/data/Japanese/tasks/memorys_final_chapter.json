					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730590201,
					"content": "アランナガ、来た。ナラたちが来たぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590202
					],
					"speakerTitle": "アランナキン"
				},
				{
					"id": 730590202,
					"content": "うんうん、今行くぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590203
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730590203,
					"content": "#おお、ナラ{NICKNAME}、白いふわふわ。歓迎する、ボクたち三つ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590204
					],
					"speakerTitle": "アランナガ"
				},
				{
					"id": 730590204,
					"content": "来た、月が。来た、花を植える時間が。準備はいいかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590205
					],
					"speakerTitle": "アランナガ"
				},
				{
					"id": 730590205,
					"content": "準備オッケー。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730590206
					]
				},
				{
					"id": 730590206,
					"content": "うん、オイラも！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730590207,
					"content": "じゃあ…アランナキン、アランガル。始めよう、儀式を。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590208
					],
					"speakerTitle": "アランナガ"
				},
				{
					"id": 730590208,
					"content": "「帰ろう、帰ろう、花園の夢、森の記憶…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590209
					],
					"speakerTitle": "アランナガ"
				},
				{
					"id": 730590209,
					"content": "「迎えよう、ボクら」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590210
					],
					"speakerTitle": "アランナキン"
				},
				{
					"id": 730590210,
					"content": "「深き睡夢に、消えぬ喜び」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590211
					],
					"speakerTitle": "アランナキン"
				},
				{
					"id": 730590211,
					"content": "「祝おう、ボクら」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590212
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730590212,
					"content": "「ザクロが歌い、リンゴがパチパチ手を叩く！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590213
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730590213,
					"content": "アランナラたちは乾燥した花を植えた。歌声が風に揺れ、花が奇跡のように息を吹き返した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730590214
					]
				},
				{
					"id": 730590214,
					"content": "うわぁ…三つの花が生き返ったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590215
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730590215,
					"content": "そうさ。これは…慈悲だ、「マウティイェマ」。つまり、カノジョは記憶に、再生のチャンスを与えようとしてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590216
					],
					"speakerTitle": "アランナガ"
				},
				{
					"id": 730590216,
					"content": "そう！ボクたちがキミたちを忘れてしまっても、記憶は…えっと、葉脈や根系に溶けて、緑の葉っぱや年輪になる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590217
					],
					"speakerTitle": "アランナキン"
				},
				{
					"id": 730590217,
					"content": "ひょっとしたら、ぷくぷくの虫になって他の虫に食べられて、食べた虫が草木に栄養を残して、ボクたちみんなを育ててくれるのかもな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590218
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730590218,
					"content": "でも…おまえたちはやっぱりオイラたちを忘れる。そうだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590219
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730590219,
					"content": "うん…だってキミやボクのものじゃないんだ、記憶は。…過去に経験したこと、ボクら、もう森のあらゆる草木に分けてしまった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590220
					],
					"speakerTitle": "アランナガ"
				},
				{
					"id": 730590220,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730590221
					]
				},
				{
					"id": 730590221,
					"content": "でもそれでもいい。ボクたちはまた新しく友達になった。そうだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590222
					],
					"speakerTitle": "アランナキン"
				},
				{
					"id": 730590222,
					"content": "そう！新しい友達だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランガル"
				}
			]
		},
