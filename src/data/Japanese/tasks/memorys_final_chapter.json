				"points": []
			},
			"dialogs": [
				{
					"id": 730590101,
					"content": "「ザクロが歌い、リンゴがパチパチ手を叩く…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590102
					],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730590102,
					"content": "あれっ、ハイヤームさんじゃないか！なんでここに？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730590103,
					"content": "やあやあ、どうも。白いお子ちゃまと…ん…すまない、どうにも頭がしゃっきりせんのだ。時間が経つと、すぐに名前を忘れてしまう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590104
					],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730590104,
					"content": "#{NICKNAME}って呼んで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730590105
					]
				},
				{
					"id": 730590105,
					"content": "ははっ…君たちはこの間の…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590106
					],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730590106,
					"content": "そう！オイラたちは「ジエマン」——勇敢な若者だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730590107,
					"content": "ふむ…では教えてくれんかの。「アランナラ」、彼らはわしを覚えていたかね？わしらみんなを？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590108
					],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730590108,
					"content": "えっと…それが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590109,
						730590112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730590109,
					"content": "#うん、{M#君}{F#あなた}を覚えてたよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730590110
					]
				},
				{
					"id": 730590110,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730590111,
					"content": "そうか…じゃがわしには彼らの姿も、わしを恋しがる声も、もう認識できん…実に残念じゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590114
					],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730590114,
					"content": "ほほっ…わしにはもう彼らは見えんからのう。年を取りすぎたんじゃ。今や、姿も声も認識できない…全ては過ぎ去ってしまったこと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590115
					],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730590115,
					"content": "ゴホゴホッ…失礼。ではわしはこれで。もう、奇跡を待つしかないんじゃろうな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590116
					],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730590116,
					"content": "奇跡は理解することも、追い求めることもできない。ただ待つのみじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590117
					],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730590117,
					"content": "ハイヤームはよろよろと立ち去った…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 730590112,
					"content": "忘れちゃってた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730590113
					]
				},
				{
					"id": 730590113,
					"content": "でも…オイラたち、また一から友達になれるぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590114
					],
					"speakerTitle": "パイモン"
				}
			]
		},
