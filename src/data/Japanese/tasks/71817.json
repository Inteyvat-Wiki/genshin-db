			},
			"dialogs": [
				{
					"id": 718170201,
					"content": "ダメだ、もう手が疲れて鍋が持てない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170202
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718170202,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718170203
					]
				},
				{
					"id": 718170203,
					"content": "あぁ旅人、ちょうど手伝いが必要なところだったんだ…悪いが手伝ってくれるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170204
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718170204,
					"content": "なんの手伝い？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718170205
					]
				},
				{
					"id": 718170205,
					"content": "海灯祭期間は、みんな家に帰っててな、人手が全然いない。もう忙しくて仕方ないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170206
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718170206,
					"content": "だが心配するな、難しいことじゃない。ただ料理を運んだり、材料を集めてもらいたいだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170207
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718170207,
					"content": "少し待ってくれ、今やることを確認する…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "言笑"
				}
			]
		},
