			"dialogs": [
				{
					"id": 718170601,
					"content": "やっと来ました…もう帰ろうかと思ってましたよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170602
					],
					"speakerTitle": "ヘルダーリン"
				},
				{
					"id": 718170602,
					"content": "何が食べたいですか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718170603
					]
				},
				{
					"id": 718170603,
					"content": "璃月は海鮮料理が美味しいと聞きましたので…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170604
					],
					"speakerTitle": "ヘルダーリン"
				},
				{
					"id": 718170604,
					"content": "しかし、最近は菜食主義を試みているので、お肉は食べられません。その…海鮮料理の味がする野菜料理はありますか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170605
					],
					"speakerTitle": "ヘルダーリン"
				},
				{
					"id": 718170605,
					"content": "前に万民堂で辛い料理を食べてから、あれが病みつきでね。辛くないと食べられない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170606
					],
					"speakerTitle": "キャスパー"
				},
				{
					"id": 718170606,
					"content": "海鮮は遠慮しておくよ。私は鳥肉がいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170607
					],
					"speakerTitle": "キャスパー"
				},
				{
					"id": 718170607,
					"content": "璃月の料理は詳しくないから、おすすめする料理でいいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キャスパー"
				}
			]
		},
