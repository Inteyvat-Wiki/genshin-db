			"dialogs": [
				{
					"id": 718170301,
					"content": "しまった、下にいるお客さんの注文を忘れてた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170302
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718170302,
					"content": "下に外国から来たお客さんが2人いる、ヘルダーリンとキャスパーだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170303
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718170303,
					"content": "大分待って気分を悪くしてると思うから、まずは副菜を<color=#00E1FFFF>2つ</color>出してくれ。<color=#00E1FFFF>美味しそうな鳥肉と野生キノコの串焼き</color>でいいだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170304
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718170304,
					"content": "それを出したら、主菜は何が食べたいか聞いてきてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170305
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718170305,
					"content": "さあ、早く行ってくれ、お客さんを待たせてしまう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "言笑"
				}
			]
