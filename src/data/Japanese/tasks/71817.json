			"dialogs": [
				{
					"id": 718170101,
					"content": "まずいな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170102
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718170102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718170103
					]
				},
				{
					"id": 718170103,
					"content": "海灯祭だからみんな家に帰っててな、人手が減って忙しいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170104
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718170104,
					"content": "今はこんなこと話してる暇はない。早く準備しないと、夜になったらお客さんが来る。水を飲む暇もないとは正にこのことだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170105
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718170105,
					"content": "そんなに気にかけてくれるなら、夜手伝ってくれよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170106
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718170106,
					"content": "はぁ、一人増えるだけでも助かるんだ。まったく、毓華は一体どこに行ったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "言笑"
				}
			]
		},
