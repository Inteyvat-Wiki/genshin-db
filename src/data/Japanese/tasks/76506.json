			"trigger": {
				"objectNames": [
					"ドリー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765060101,
					"content": "あらあら、旅人とパイモンじゃありませんの！こんなところで会うなんて奇遇ですわ。きっとこれは幸運の兆しですの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060102
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 765060102,
					"content": "ドリー！一人でなにしてるんだ？もしかして、屋台でなにか売ってるのか？あれ、でも商品が見当たらないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765060103,
					"content": "ごめんなさい。かの有名な旅商人ドリーは、本日休業中ですの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060104
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 765060104,
					"content": "今は、ナド・クライの地元の人たちのように、この「楽園」で平凡で自由な一日を過ごしているのですわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060105
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 765060105,
					"content": "えっ、本当か？商売やモラ稼ぎをしてないドリーって、砂漠の雨ぐらい珍しいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765060106,
					"content": "うふふふ、たとえ休暇を楽しんでいても、私のお店と、私の働き者な従業員たちが、絶えず私のためにモラを稼いでくれているんですの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060107
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 765060107,
					"content": "私の口座の数字がぐんぐん増えていっている限り、何も心配しなくていいのですわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060108
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 765060108,
					"content": "ところで…何かお困りごとですの？休暇中ではありますが、仕事の依頼であれば断りませんわよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060109,
						765060110
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 765060109,
					"content": "この辺りを見てまわってただけだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765060111
					]
				},
				{
					"id": 765060111,
					"content": "あらあら、ナド・クライならではの風景を記録しようとしていたのですね！でしたら、私のところに来て正解ですわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060112
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 765060112,
					"content": "さすがに生粋のナド・クライ人にはかないませんが、素敵な撮影スポットなら、オススメをたくさん教えて差し上げられますわよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060113
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 765060113,
					"content": "せっかくですから、私がガイドになって差し上げますわ！お友達価格ということで、一日五十万モラでどうでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060114
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 765060114,
					"content": "うわ…さすがドリーだぞ。結局オイラたちのモラをどう懐に入れるかの話になるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765060115,
					"content": "あらあら…ただ一番大切なお客様に、ナド・クライで忘れられない素敵な思い出を残してもらいたくて提案しただけですわよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060116,
						765060117
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 765060116,
					"content": "そこまで言うなら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765060118
					]
				},
				{
					"id": 765060118,
					"content": "あら？あらららら？私の写真？…面白い提案ですわね。でも、商業宣伝には使わないでくださいまし。私の肖像権はお高いですわよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060119
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 765060119,
					"content": "安心してくれ。ただ昔からの知り合いを撮りたいだけだから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765060120,
					"content": "#うふふ、わかりましたわ。{NICKNAME}がそこまで言うのでしたら、特別にモデルになって差し上げますの。優雅で気品あるように撮ってくださいまし！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060121
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 765060121,
					"content": "ええと…では、写真のテーマは「ドリー・サングマハベイ様の楽園バカンス」でお願いしますわ。素敵だと思いませんこと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ドリー"
				},
				{
					"id": 765060117,
					"content": "ドリーの写真を撮ってもいい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765060118
					]
				},
				{
					"id": 765060110,
					"content": "ついでにいい被写体を探してるんだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765060111
					]
				}
			]
		},
