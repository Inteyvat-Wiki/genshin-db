	"talks": [
		{
			"id": 7365201,
			"completionStepIds": [
				7365201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7365201",
							"2"
						],
						"stepId": 7365201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ハジャナド",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736520101,
					"content": "遅かったじゃない、ずっと待ってたのよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520102
					],
					"speakerTitle": "ハジャナド"
				},
				{
					"id": 736520102,
					"content": "それじゃ、「リメルトタブレット」の効果について詳しく話してくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520103
					],
					"speakerTitle": "ハジャナド"
				},
				{
					"id": 736520103,
					"content": "ハジャナド、興奮してるみたいだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736520104
					]
				},
				{
					"id": 736520104,
					"content": "じゃあ、まずは短所から言うぞ。覚悟しろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736520105,
					"content": "「リメルトタブレット」の短所と長所について、ハジャナドに詳しく説明した。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						736520106
					]
				},
				{
					"id": 736520106,
					"content": "なるほど…わかったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520107
					],
					"speakerTitle": "ハジャナド"
				},
				{
					"id": 736520107,
					"content": "今の爆発だと薬の混ぜ具合を正確にコントロールできないから、効果が安定しないのね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520108
					],
					"speakerTitle": "ハジャナド"
				},
				{
					"id": 736520108,
					"content": "小型爆弾にカバーを取り付け、衝撃波を収束して、タブレットをプリセットする際の配列を最適化する…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520109
					],
					"speakerTitle": "ハジャナド"
				},
				{
					"id": 736520109,
					"content": "うん、改良に時間は掛からなそう。問題は資金ね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520110
					],
					"speakerTitle": "ハジャナド"
				},
				{
					"id": 736520110,
					"content": "いざという時のために予算を残しておいてよかった。これから一日一食にして、古い機材を売り払えば足りるはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520111
					],
					"speakerTitle": "ハジャナド"
				},
				{
					"id": 736520111,
					"content": "一日一食しか食べないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736520112,
					"content": "いやいや、そんなの絶対に耐えられないぞ！資金が足りないなら、なんでもっと早く言わなかったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736520113,
					"content": "ああ、安心して、報酬はきっちり支払うから。それは予算の中から一番に確保してあるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520114
					],
					"speakerTitle": "ハジャナド"
				},
				{
					"id": 736520114,
					"content": "以前は一日一食が当たり前だったの。週に三食しか食べない時期もあったから、もう慣れっこよ。大丈夫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520115
					],
					"speakerTitle": "ハジャナド"
				},
				{
					"id": 736520115,
					"content": "なにもそこまで頑張らなくても…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736520116
					]
				},
				{
					"id": 736520116,
					"content": "すっごく気になるから、はっきり答えてほしいんだけど——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736520117,
					"content": "ハジャナドさんは、どうしてそこまでして有名な学者になりたいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736520118,
					"content": "研究が好きだから？自分の才能を証明したいから？それとも錬金術でモラをいっぱい稼ぎたいからか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736520119,
					"content": "えっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520120
					],
					"speakerTitle": "ハジャナド"
				},
				{
					"id": 736520120,
					"content": "そんなこと急に聞かれても、なんて答えたらいいか…もしかしたら、昔いじめられてたのが悔しかったからかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520121
					],
					"speakerTitle": "ハジャナド"
				},
				{
					"id": 736520121,
					"content": "それに自分の能力を証明できれば、生活も楽になるしね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520122
					],
					"speakerTitle": "ハジャナド"
				},
				{
					"id": 736520122,
					"content": "そんな理由で…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736520123,
					"content": "研究を始めたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736520124
					]
				},
				{
					"id": 736520124,
					"content": "そうよ。知識がすべてのこの国では、学術的な才能があれば成り上がれるもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520125
					],
					"speakerTitle": "ハジャナド"
				},
				{
					"id": 736520125,
					"content": "私に天性の才能はないし、知能指数だって至って普通。だからマイナーな研究をして、全力で成果を上げるしかないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520126
					],
					"speakerTitle": "ハジャナド"
				},
				{
					"id": 736520126,
					"content": "一人で研究に没頭していると、人との付き合い方がわからなくなって、変人っぽくなってしまって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520127,
						736520128
					],
					"speakerTitle": "ハジャナド"
				},
				{
					"id": 736520127,
					"content": "世の中いい人のほうが圧倒的に多い。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736520129
					]
				},
				{
					"id": 736520129,
					"content": "そうだぞ。今はすごい目標があるんだから、もっとドーンと構えていればいいんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520130
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736520130,
					"content": "平常心で落ち着いて話し合えば、研究に協力してくれる人は大勢いるはずだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520131
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736520131,
					"content": "ありがとう。ただ、それは私もわかってるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520132
					],
					"speakerTitle": "ハジャナド"
				},
				{
					"id": 736520132,
					"content": "気づいたのよ。錬金術の研究は最高に面白くて、世間とか生活とか、そんなことを考えるよりずっと楽だって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520133
					],
					"speakerTitle": "ハジャナド"
				},
				{
					"id": 736520133,
					"content": "あなたたちに出会ってから、私も自分を見つめ直したの。確かに私は、もう少し自分の心を整えるべきね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520134
					],
					"speakerTitle": "ハジャナド"
				},
				{
					"id": 736520134,
					"content": "とにかく、「リメルトタブレット」の実験に協力してくれて、ありがとう。そろそろ町に戻って論文を書かなきゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520135
					],
					"speakerTitle": "ハジャナド"
				},
				{
					"id": 736520135,
					"content": "約束の報酬よ。それと…これもあげるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520136
					],
					"speakerTitle": "ハジャナド"
				},
				{
					"id": 736520136,
					"content": "これは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736520137
					]
				},
				{
					"id": 736520137,
					"content": "一番お気に入りの錬金釜。必死で貯金して買ったんだけど、もったいなくて結局ずっと使えなかったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520138
					],
					"speakerTitle": "ハジャナド"
				},
				{
					"id": 736520138,
					"content": "おい！そんな大事なもの、なんで急に手放そうと思ったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520139
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736520139,
					"content": "「リメルトタブレット」は従来の薬と違って、新しく設計した機材で作る必要があるの。だから、その錬金釜は使えないのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520140
					],
					"speakerTitle": "ハジャナド"
				},
				{
					"id": 736520140,
					"content": "それに、報酬の中には約束も含まれてるでしょう？この錬金釜は、実験に立ち会ってくれたお礼よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520141
					],
					"speakerTitle": "ハジャナド"
				},
				{
					"id": 736520141,
					"content": "よかったら使って…お茶とかスープを作るのはどうかしら？抽出を促進する機能が付いてるから、美味しいスープができるはずよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520142
					],
					"speakerTitle": "ハジャナド"
				},
				{
					"id": 736520142,
					"content": "そこまで言われたら…断るのも悪いよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520143
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736520143,
					"content": "頑張ってね、ハジャナド。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736520144
					]
				},
				{
					"id": 736520144,
					"content": "もちろん！いい知らせを待っててね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520145
					],
					"speakerTitle": "ハジャナド"
				},
				{
					"id": 736520145,
					"content": "ハジャナドは立ち去った。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						736520146
					]
				},
				{
					"id": 736520146,
					"content": "#なあ、{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520147
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736520147,
					"content": "オイラたち、いいことをしたんだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520148,
						736520149
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736520148,
					"content": "普段の冒険と同じ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736520150
					]
				},
				{
					"id": 736520150,
					"content": "おう、今は慌てて結論を出さなくてもいいと思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520151
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736520151,
					"content": "オイラたちが忘れた頃に、学者になったハジャナドから急に招待状が届くかもしれないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520152
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736520152,
					"content": "まあ、無駄話はこのくらいにして、そろそろ行こうぜ。この錬金釜でお茶を淹れてみよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736520149,
					"content": "#{M#俺}{F#私}たちも平常心を保たないとね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736520150
					]
				},
				{
					"id": 736520128,
					"content": "過去に囚われる必要はない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736520129
					]
				}
			]
		}
	]
}