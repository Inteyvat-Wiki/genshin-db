						],
						"pointId": 310702021
					}
				]
			},
			"dialogs": [
				{
					"id": 711440301,
					"content": "#盤石を彫ったような顔立ち、並々ならぬその雰囲気…さては、君が噂の智将{NICKNAME}だな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440302
					],
					"speakerTitle": "蘇定"
				},
				{
					"id": 711440302,
					"content": "その名はかねがね伺っていた。冒険者協会を通して君に会議への出席依頼の手紙を出そうと考えていたところだったが、まさか君から察して来てくれるとは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440303,
						711440304
					],
					"speakerTitle": "蘇定"
				},
				{
					"id": 711440303,
					"content": "智将？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711440305
					]
				},
				{
					"id": 711440305,
					"content": "#す、すごくかしこまった言い方だな。{NICKNAME}のことを…プロの戦士だとでも思ってるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711440306,
					"content": "戦士というだけではない。五つの国を渡り歩きながら、数え切れないほどの魔物や強者と戦ったその実績は、各国の部隊によって記録され、繰り返し分析されている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440307
					],
					"speakerTitle": "蘇定"
				},
				{
					"id": 711440307,
					"content": "西風騎士団、千岩軍、幕府の武士、三十人団、そして執律庭に至るまで、各所の作戦部隊は君の戦力と策略について最高の評価を下している——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440308
					],
					"speakerTitle": "蘇定"
				},
				{
					"id": 711440308,
					"content": "#「{NICKNAME}は、前線での戦いはもちろん、後方の指揮も務められるほどの十分な才能の持ち主だ。可能ならば、積極的に手を組むべきである。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440309
					],
					"speakerTitle": "蘇定"
				},
				{
					"id": 711440309,
					"content": "というわけで、千岩軍の参謀部を代表して君に伺いたい。五国共同で開催する兵棋演習で、上級顧問を務めてくれないだろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440310
					],
					"speakerTitle": "蘇定"
				},
				{
					"id": 711440310,
					"content": "上級顧問にはそれに相応しい額の報酬を支払う。参加期間中の給与は、千岩軍隊長と同じくらいになるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440311
					],
					"speakerTitle": "蘇定"
				},
				{
					"id": 711440311,
					"content": "さすが千岩軍…話し方までドストレートだな…それにしても、隊長レベルの報酬ってたしかに魅力的だぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440312,
						711440313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711440312,
					"content": "でも、まだ状況を把握できてない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711440314
					]
				},
				{
					"id": 711440314,
					"content": "案ずるな。これから君たちに説明しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440315
					],
					"speakerTitle": "蘇定"
				},
				{
					"id": 711440315,
					"content": "君たちも知っている通り、テイワットの荒野をうろつく魔物の数は未だ多く、短時間で根絶やしにすることは難しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440316
					],
					"speakerTitle": "蘇定"
				},
				{
					"id": 711440316,
					"content": "魔物の脅威に効率よく対応するため、近隣諸国の部隊は、よく見かける魔物の情報をまとめている。その脅威レベルを細かく評価し、一部をお互い共有しているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440317
					],
					"speakerTitle": "蘇定"
				},
				{
					"id": 711440317,
					"content": "そして千岩軍の参謀部では、盤上の駒を様々な魔物に見立て、それらとの戦いを想定することで、できる限り各種魔物の戦力を分析しようと試みている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440318
					],
					"speakerTitle": "蘇定"
				},
				{
					"id": 711440318,
					"content": "今回の「合同演習」には様々な作戦部隊が参加していてな。色々な角度から駒を駆使し、最適な魔物討伐の方法を研究しているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440319
					],
					"speakerTitle": "蘇定"
				},
				{
					"id": 711440319,
					"content": "#{NICKNAME}はどの部隊にも所属していないし、類まれなる戦術の天才。分析において新たな視点を与えてくれるに違いない。演習の幅も効率も大いに向上するだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440320
					],
					"speakerTitle": "蘇定"
				},
				{
					"id": 711440320,
					"content": "なんとなくわかってきた気がするぞ。ええと、つまり…一番安全で有効な魔物の倒し方を話し合うために、会議を開くってことだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440321
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711440321,
					"content": "やっとオイラたちがよく知ってる分野の話になったぞ！オイラたち、色んな場所で危険なやつらにたくさん遭遇してきたし、それに棋戯とかのボードゲームも遊んだことがあるぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440322
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711440322,
					"content": "前みたいにゲームをやるだけで、いろんな国の安全を守るための手助けができて、報酬までもらえるなら…一石{RUBY#[D]いっせきたちょう}多鳥じゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440323,
						711440325
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711440323,
					"content": "気軽に遊びながら大いに貢献！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711440324
					]
				},
				{
					"id": 711440324,
					"content": "ああ、その勢いだ。淡々と挑戦に立ち向かい、息をするように腕を振って危機を解決する…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440327
					],
					"speakerTitle": "蘇定"
				},
				{
					"id": 711440327,
					"content": "盤面の準備はできているから、いつでも演習を開始できる。君の才能が光る戦略の立て方を、ぜひ拝見させていただきたい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘇定"
				},
				{
					"id": 711440325,
					"content": "今回は真剣に取り組んだほうがよさそう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711440326
					]
				},
				{
					"id": 711440326,
					"content": "そう気を張らないでくれ。普段魔物と戦うときと同じ心構えで十分だ。君はいかなる波乱にも動じないと、みな口を揃えて称えているぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440327
					],
					"speakerTitle": "蘇定"
				},
				{
					"id": 711440313,
					"content": "兵棋演習について全く知らない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711440314
					]
				},
				{
					"id": 711440304,
					"content": "会議？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711440305
					]
				}
			]
		}
	]
}