			"dialogs": [
				{
					"id": 221050101,
					"content": "参ったわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050102
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 221050102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221050103
					]
				},
				{
					"id": 221050103,
					"content": "旅館の周りが少しおかしい気がするの。どこがおかしいかは分からないけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050104
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 221050104,
					"content": "それに、うちの旅館にいる人は神経質な人ばかりだもの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050105
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 221050105,
					"content": "何かあったら、扉や窓は壊されるし、ひどいときは壁もボロボロになるのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050106
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 221050106,
					"content": "まあ、お客さんは修理代を払ってくれるけど、見た目がボロボロだと、さすがにまずいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050107
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 221050107,
					"content": "周辺を見てきてくれるかしら？何か変なものがいたら…代わりに処理してちょうだい、私はここでお客さんの対応してるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050108,
						221050109
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 221050108,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221050110
					]
				},
				{
					"id": 221050110,
					"content": "頼んだわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 221050109,
					"content": "その客…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221050111
					]
				},
				{
					"id": 221050111,
					"content": "客？気にしないで。長年野外で生きてきた人だから、神経質なのも仕方がないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050112
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 221050112,
					"content": "では、頼んだわ。周りを見るだけだから、変なことは起きないはずよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴェル·ゴレット"
				}
			]
		},
