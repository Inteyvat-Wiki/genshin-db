			"dialogs": [
				{
					"id": 230338201,
					"content": "いいです！とてもいいですね！この写真なら、朝霧さんに参考として送るには十分なはずです。これで、挿し絵の問題はしばらく気にしなくて済みます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230338202
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230338202,
					"content": "旅人さん、ありがとうございます！お礼にこれを受け取ってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230338203
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230338203,
					"content": "私は教令院に戻って、写真をどうやって朝霧さんに送ればよいか聞いてみます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230338204
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230338204,
					"content": "最近、朝霧さんに挿し絵を依頼する人が増えてきましたから、私も早く予約しませんと！ふふ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230338205
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230338205,
					"content": "うーん、これはいいですね…あっ、それも素敵です…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "福本"
				}
			]
