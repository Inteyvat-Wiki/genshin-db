			"dialogs": [
				{
					"id": 230338101,
					"content": "はぁ、学者たちはもっと体に気を付けないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230338102
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230338102,
					"content": "学者がどうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230338103
					]
				},
				{
					"id": 230338103,
					"content": "まったく…「七聖召喚」の件ですが、従事している学者たちは不眠不休で研究をしていて、「七聖召喚」のルールを完成させる前に体を壊してしまうのではないかと、心配なんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230338104
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230338104,
					"content": "まあ…ゲームのルールについて大枠は決まったらしいので、やっと参考になりそうなものができつつあるのですが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230338105
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230338105,
					"content": "とはいえ学者たちが何をしているのかは全く分かりませんので…ここは彼らに頑張ってもらうほかありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230338106
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230338106,
					"content": "私のほうは…引き続き挿絵の問題を解決しなければなりませんしね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230338107
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230338107,
					"content": "前回の旅人さんのおかげで、朝霧さんはすでに良い挿し絵を何枚か描いてくれました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230338108
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230338108,
					"content": "もしよろしければ、もう一度モデルになってくれませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230338109,
						230338110
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230338109,
					"content": "わかった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230338113
					]
				},
				{
					"id": 230338113,
					"content": "旅人さん、モデルの件は頼みましたよ！報酬はきちんと用意しますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230338114
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230338114,
					"content": "いいロケ地を見つけました。すぐ近くにありますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230338115
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230338115,
					"content": "写真機の片付けを終えたら出発しましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "福本"
				},
				{
					"id": 230338110,
					"content": "あとどれくらい必要？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230338111
					]
				},
				{
					"id": 230338111,
					"content": "あら、それはせっかくのスメールですから、当然しっかり取材しておきませんと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230338112
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230338112,
					"content": "ついでに…私の編集担当から逃げ…コホン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230338113
					],
					"speakerTitle": "福本"
				}
			]
		},
