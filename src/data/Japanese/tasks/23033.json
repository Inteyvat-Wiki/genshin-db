					"content": "前回の旅人さんのおかげで、朝霧さんはすでに良い挿し絵を何枚か描いてくれました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230338408
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230338408,
					"content": "もしよろしければ、もう一度モデルになってくれませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230338409,
						230338411
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230338409,
					"content": "分かった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230338410
					]
				},
				{
					"id": 230338410,
					"content": "ありがとうございます！報酬はちゃんと用意しますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230338414
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230338414,
					"content": "いいロケ地を見つけました。すぐ近くにありますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230338415
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230338415,
					"content": "写真機の片付けを終えたら出発しましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230338416
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230338411,
					"content": "いつ稲妻に戻るの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230338412
					]
				},
				{
					"id": 230338412,
					"content": "そうですね…素材が充分集まったら戻ります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230338413
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230338413,
					"content": "これほど優れた題材ですから、あと数冊は書いてみたいんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230338414
					],
					"speakerTitle": "福本"
				}
			]
		},
