				"objectNames": [
					"福本"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230330801,
					"content": "ここです。えっと…そうですね、まずは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330802
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330802,
					"content": "ざっくり言うと、キャラクターが窮地に陥ったときのポーズが欲しいんです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330803
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330803,
					"content": "ざっくりしすぎてるぞ！それでどんなポーズをとれっていうんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330804
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230330804,
					"content": "まあまあ…ぱっと浮かんだ印象でポーズを取って頂ければいいですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330805
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330805,
					"content": "旅人さん、窮地に陥った時、あなたならどうやってその状況を切り抜けますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330806,
						230330812
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330806,
					"content": "もちろん、戦うこと。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230330807
					]
				},
				{
					"id": 230330807,
					"content": "肝の据わったよい返事です！窮地に陥った瞬間、戦うことを覚悟する…良いですね！それでは、力を込めて戦闘のポーズをお願いします！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330808
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330808,
					"content": "つまり…窮地に陥ってしまったので、抵抗せざるをえないという感じですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330809
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330809,
					"content": "この戦いは、生存のための抵抗である！生きるためには、選択せざるを得ない！…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330810
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330810,
					"content": "コホンッ！これは私がキャラクターに設定したセリフです…とにかく、こんな感じなんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330811
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330811,
					"content": "そんなこと言うやつが出てくるのかよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230330812,
					"content": "自ら窮地に陥るようなことはしない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230330813
					]
				},
				{
					"id": 230330813,
					"content": "おお！その言葉、威厳があって良いですね！小説のキャラクターに合っています！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330814
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330814,
					"content": "それでは、威厳を感じるポーズでお願いします！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "福本"
				}
			]
		},
		{
			"id": 2303310,
