			"dialogs": [
				{
					"id": 230338501,
					"content": "旅人さん！またお会いましたね。前回はあなたのおかげで、朝霧さんの挿し絵の件がうまく行きました。ありがとうございます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230338502,
						230338503
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230338502,
					"content": "役に立ててよかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230338504
					]
				},
				{
					"id": 230338504,
					"content": "小説家の私にとって、素材は多ければ多いほどいいですからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230338505
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230338505,
					"content": "それに、スメールはとても面白いところでしょう？まだこの目で見ていない新鮮なものがたくさん残っています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230338506
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230338506,
					"content": "朝霧さんの体調が良ければ、彼女にスメールに来てもらって、現地取材しようと誘いたいくらいです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230338507
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230338507,
					"content": "コホンッ、本題に戻りましょう。旅人さん、もう一度モデルになってもらえませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230338508
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230338508,
					"content": "今回は特別な要求はないので、あなたが戦う様子を見せてもらえば大丈夫ですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230338509,
						230338510
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230338509,
					"content": "カードゲームの小説だよね…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230338511
					]
				},
				{
					"id": 230338511,
					"content": "ご存じないかもしれませんが、単にカードゲームで遊ぶだけのお話ですと、訴求できる市場はかなり限られてしまいます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230338512
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230338512,
					"content": "とはいえ、カードゲームに戦いの要素を加えるだけではやや時代遅れだと思っています。キャラクターが馬に乗って、速さを競いながらカードゲームをするというのも考えました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230338513
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230338513,
					"content": "ですが、馬に乗ってカードゲームをする理由をまだ思い付いていないので…とりあえず、カードゲームの過程で戦闘に発展する小説を書くことにしました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230338514
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230338514,
					"content": "ロケ地はすでに決めているので、さっそく行きましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "福本"
				},
				{
					"id": 230338510,
					"content": "カードと戦いにどんな関係が…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230338511
					]
				},
				{
					"id": 230338503,
					"content": "今日も取材に来たの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230338504
					]
				}
			]
