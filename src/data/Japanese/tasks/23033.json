			},
			"dialogs": [
				{
					"id": 230338001,
					"content": "はぁ、学者たちはもっと体に気を付けないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230338002
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230338002,
					"content": "学者がどうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230338003
					]
				},
				{
					"id": 230338003,
					"content": "まったく…「七聖召喚」の件ですが、従事している学者たちは不眠不休で研究をしていて、「七聖召喚」のルールを完成させる前に体を壊してしまうのではないかと、心配なんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230338004
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230338004,
					"content": "まあ…ゲームのルールについて大枠は決まったらしいので、やっと参考になりそうなものができつつあるのですが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230338005
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230338005,
					"content": "とはいえ学者たちが何をしているのかは全く分かりませんので…ここは彼らに頑張ってもらうほかありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230338006
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230338006,
					"content": "私のほうは…引き続き挿絵の問題を解決しなければなりませんしね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230338007
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230338007,
					"content": "前回の旅人さんのおかげで、朝霧さんはすでに良い挿し絵を何枚か描いてくれました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230338008
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230338008,
					"content": "もしよろしければ、もう一度モデルになってくれませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230338009,
						230338011
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230338009,
					"content": "そうだろうね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230338010
					]
				},
				{
					"id": 230338010,
					"content": "ありがとうございます！報酬はちゃんと用意しますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230338017
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230338017,
					"content": "いいロケ地を見つけました。すぐ近くにありますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230338018
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230338018,
					"content": "写真機の片付けを終えたら出発しましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "福本"
				},
				{
					"id": 230338011,
					"content": "「有名人」はまだ紹介されていないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230338012
					]
				},
				{
					"id": 230338012,
					"content": "それは…連絡してくれたようなんですが、セノさんもティナリさんも仕事が忙しくて、モデルをやる時間がないらしいんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230338013
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230338013,
					"content": "でも、セノさんは「七聖召喚」の達人だと聞きました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230338014
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230338014,
					"content": "もし彼がカードを持って、テーブルでかっこいいポーズをしてくれれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230338015
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230338015,
					"content": "いえ、やはり現実的に考えましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230338016
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230338016,
					"content": "旅人さん、モデルの件は頼みましたよ！報酬はきちんと用意しますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230338017
					],
					"speakerTitle": "福本"
				}
			]
		},
