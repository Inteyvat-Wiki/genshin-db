			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"福本"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230330601,
					"content": "どうしよう、まさかスメールの人たちに騙されたなんてことは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330602
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330602,
					"content": "お金を騙し取られたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230330603
					]
				},
				{
					"id": 230330603,
					"content": "！び…びっくりしました！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330604
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330604,
					"content": "はぁ、お金を取られたわけではないのですが、ただ教令院の人たちにスメールまで来るように言われて…きっと、騙されたんです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330605
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330605,
					"content": "まだ自己紹介をしていませんでしたね…私は福本、稲妻の小説家です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330606
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330606,
					"content": "騙されたって？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230330607
					]
				},
				{
					"id": 230330607,
					"content": "話すと長くなりますが…教令院が開発したカードゲーム——「七聖召喚」について聞いたことありますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330608,
						230330609
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330608,
					"content": "し…七聖召喚？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230330610
					]
				},
				{
					"id": 230330610,
					"content": "聞いたことないんですか？そんな…私の書いた『召喚王』を読まれたことは？「八重堂」では売れている部類に入るのですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330611
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330611,
					"content": "うぅ…『召喚王』も読んだことはありませんか？だ、大丈夫です、それはひとまず置いておいて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330612
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330612,
					"content": "とにかく、スメールの教令院の方が「七聖召喚」というカードゲームを開発した、ということだけ知っておいてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330613
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330613,
					"content": "その「七聖召喚」ですが、宣伝のため「八重堂」を通して私にお願いが来たんです。カードゲームのルールをベースにした娯楽小説を書いてほしいと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330614
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330614,
					"content": "しかしながら、開発者である学者たちさえ「七聖召喚」のルールを完全に把握しておらず、かつスメールと稲妻が遠いためにやり取りが難しく…となかなか筆が進みませんでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330615
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330615,
					"content": "幸い「八重堂」の先生方が手伝ってくれたおかげで、『召喚王』は完成しました。売上はなかなかのもので、当初の計画通り「七聖召喚」の売上にも寄与できたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330616
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330616,
					"content": "そして、話はここからなのですが…あの学者たちが、「七聖召喚」のルールを見直した新しいバージョンを出すと言ってきたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330617
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330617,
					"content": "私にも、新しい「七聖召喚」に基づいて『召喚王』の続きを書くよう頼んできました。そのうえで、直接交流する機会を持ちたいということで、スメールまでお招きいただいたのですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330618
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330618,
					"content": "稲妻から遠路はるばる来たというのに、学者たちは…まだ新しい「七聖召喚」のルールを決められておらず、私にしばらくスメールに滞在してほしいとのことでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330619
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330619,
					"content": "お詫びとして、教令院の有名人を何人か取材させてくれるという約束だったのですが…例えば、あのセノさんや、ティナリさんなど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330620
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330620,
					"content": "怒りたいのはやまやまでしたが、学者たちは皆ひどい寝不足に苛まれている様子で、私を案内してくれた学者も、まともに立つことができないくらいでしたから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330621
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330621,
					"content": "はぁ、私もまだあらすじを決めていませんし、少しくらいは待てると思い…しばらくスメールに滞在することにしました。彼らが、新しいルールを決めるまで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330622
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330622,
					"content": "そして、今日は取材に来たのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330623
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330623,
					"content": "旅人さん、手伝ってくれますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330624,
						230330625
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330624,
					"content": "何を手伝うのか先に言って…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230330626
					]
				},
				{
					"id": 230330626,
					"content": "実は、『召喚王』という本をより魅力的にするために、特別に朝霧さんに挿し絵を描いてもらえないか頼みました！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330627
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330627,
					"content": "いくつか重要なシーンはすでに思いついてたのですが、文字以外にも、朝霧さんに具体的な動きの参考となるものを提供しなければなりません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330628
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330628,
					"content": "でも、私にはまったく戦闘の経験がありませんから…ポーズはすべて様になりませんし、気合いが入っているふうには到底見えません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330629
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330629,
					"content": "旅人さん、あなたは豊富な戦闘の経験がありますから、モデルになってくれませんか？ほら、「写真機」も借りてきました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330630,
						230330631
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330630,
					"content": "そうだろうね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230330633
					]
				},
				{
					"id": 230330633,
					"content": "旅人さん、手伝ってくれてありがとうございます！いいロケ地を見つけたので、そちらへ行きましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "福本"
				},
				{
					"id": 230330631,
					"content": "いい写真を撮ってね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230330632
					]
				},
				{
					"id": 230330632,
					"content": "問題ありません、任せてください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330633
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330625,
					"content": "カードゲームは得意じゃない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230330626
					]
				},
				{
					"id": 230330609,
					"content": "カードゲーム？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230330610
					]
				}
			]
		},
		{
			"id": 2303308,
			"completionStepIds": [
				2303308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
