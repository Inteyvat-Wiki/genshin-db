			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"福本"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230330501,
					"content": "いいですね、とてもいいですよ！この写真があれば、朝霧さんは何枚でも描けるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330502,
						230330503
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330502,
					"content": "「七聖召喚」をプレイしたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230330504
					]
				},
				{
					"id": 230330504,
					"content": "ふふ…あなたのお願いは、私が代わりに学者たちに伝えておきます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330505
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330505,
					"content": "一応、学者たちの研究も進んではいるようです。議論に冗談が混じるようになりましたから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330506
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330506,
					"content": "すぐにケンカが始まった最初の頃に比べれば…ずいぶん進歩したといえるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "福本"
				},
				{
					"id": 230330503,
					"content": "「七聖召喚」を楽しみにしている。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230330504
					]
				}
			]
		},
		{
