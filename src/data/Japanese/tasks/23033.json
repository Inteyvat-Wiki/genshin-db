				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"福本"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230330101,
					"content": "旅人さん！またお会いましたね。前回はあなたのおかげで、朝霧さんの挿し絵の件がうまく行きました。ありがとうございます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330102,
						230330103
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330102,
					"content": "役に立ててよかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230330104
					]
				},
				{
					"id": 230330104,
					"content": "そうなんです…教令院の学者たちはまだ、制作の細かいところについて議論しています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330105
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330105,
					"content": "ある学者によれば…新バージョンを作るには、ゲームの遊び方とリソースの仕組みの双方に創意を求める必要があるとのことです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330106
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330106,
					"content": "また、カードゲームのカードには素敵な挿絵が必要だと考える学者もいます。彼は予算を、もっと画家を雇うことに使うべきだと主張しています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330107
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330107,
					"content": "さらに突拍子もない学者が、「七聖召喚」の制作に関わったすべての学者同士で、対戦会を開きたいというようなことを言っていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330108
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330108,
					"content": "チャンピオンになった方の意見はより重用されるとのことでしたが…私に言わせれば、この人は単純に「七聖召喚」をやりたがっているだけに見えますね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330109
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330109,
					"content": "実際のところ…彼らの議論の内容についてはほとんど分からなかったので、取材を理由に逃げてきたんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330110
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330110,
					"content": "旅人さん、もう一度モデルになってくれませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330111
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330111,
					"content": "今回は特別な要求はないので、あなたが戦う様子を見せてもらえば大丈夫ですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330112,
						230330113
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330112,
					"content": "カードゲームの小説だよね…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230330114
					]
				},
				{
					"id": 230330114,
					"content": "ご存じないかもしれませんが、単にカードゲームで遊ぶだけのお話ですと、訴求できる市場はかなり限られてしまいます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330115
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330115,
					"content": "とはいえ、カードゲームに戦いの要素を加えるだけではやや時代遅れだと思っています。キャラクターが馬に乗って、速さを競いながらカードゲームをするというのも考えました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330116
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330116,
					"content": "ですが、馬に乗ってカードゲームをする理由をまだ思い付いていないので…とりあえず、カードゲームの過程で戦闘に発展する小説を書くことにしました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330117
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330117,
					"content": "ロケ地はすでに決めているので、さっそく行きましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "福本"
				},
				{
					"id": 230330113,
					"content": "カードと戦いにどんな関係が…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230330114
					]
				},
				{
					"id": 230330103,
					"content": "今日も取材に来たの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230330104
					]
				}
			]
		},
		{
			"id": 2303303,
			"completionStepIds": [
				2303303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
