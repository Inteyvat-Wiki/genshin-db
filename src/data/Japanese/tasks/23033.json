				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230331001,
					"content": "いいです！とてもいいですね！この写真なら、朝霧さんに参考として送るには十分なはずです。これで、挿し絵の問題はしばらく気にしなくて済みます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230331002
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230331002,
					"content": "旅人さん、ありがとうございます！お礼にこれを受け取ってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230331003
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230331003,
					"content": "私は教令院に戻って、写真をどうやって朝霧さんに送ればよいか聞いてみます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230331004
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230331004,
					"content": "最近、朝霧さんに挿し絵を依頼する人が増えてきましたから、私も早く予約しませんと！ふふ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230331005
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230331005,
					"content": "うーん、これはいいですね…あっ、それも素敵です…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "福本"
				}
			]
		},
