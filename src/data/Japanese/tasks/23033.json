			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"福本"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230330301,
					"content": "ここです！ほら、何匹かスライムがいるでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330302
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330302,
					"content": "旅人さんが一番かっこいいと思う方法で、スライムを一気に倒してみてください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330303
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330303,
					"content": "これ、カードゲームの小説に使えるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230330304
					]
				},
				{
					"id": 230330304,
					"content": "安心してください。小説では大概のことをカードゲームで解決しますが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330305
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330305,
					"content": "稀にカードゲームではどうにもならないことが起きます。そんな時、キャラクター達はより「現実的な」手段に訴えるほかなくなるのです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330306
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330306,
					"content": "頼みましたよ！旅人さん。私はここでちゃんと見ていますからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "福本"
				}
			]
		},
		{
			"id": 2303305,
			"completionStepIds": [
				2303305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
