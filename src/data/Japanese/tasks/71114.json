			},
			"dialogs": [
				{
					"id": 711149940,
					"content": "宝盗団を全員撃退したあと、宝盗団に取り囲まれていた人たちを近くの亭子に連れていき、一息ついた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 711140801,
					"content": "ああ、ありがとう！本当にありがとう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140802
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 711140802,
					"content": "#{M#君}{F#あなた}は…邱社長？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140803
					]
				},
				{
					"id": 711140803,
					"content": "#あ、あなたは{NICKNAME}！こんな偶然があるなんて…また世話になっちゃったわね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140804
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 711140804,
					"content": "フォンテーヌで映影の撮り方を勉強してたんじゃなかったのか？なんでもう璃月に戻ってるんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140805
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711140805,
					"content": "もうマスターしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140806
					]
				},
				{
					"id": 711140806,
					"content": "マスターしたっていうより…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140807
					],
					"speakerTitle": "弈豊"
				},
				{
					"id": 711140807,
					"content": "お金を稼がざるを得ない状況って言うべきですかね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140808
					],
					"speakerTitle": "興曄"
				},
				{
					"id": 711140808,
					"content": "あんたたちねえ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140809
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 711140809,
					"content": "ガイサートさんは正真正銘のプロです。私たちへの指導もすごく的確でしたよ。でも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140810
					],
					"speakerTitle": "弈豊"
				},
				{
					"id": 711140810,
					"content": "彼の下でオレたちが撮った映影は、意義とか概念の表現に偏りすぎてて、具体的なこととか筋書きについては…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140811
					],
					"speakerTitle": "興曄"
				},
				{
					"id": 711140811,
					"content": "ガイサートさんの言葉を借りると、「ああいうものは第一線から退かせる」んだそうで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140812
					],
					"speakerTitle": "弈豊"
				},
				{
					"id": 711140812,
					"content": "でも、オレたちの撮りたいのは翹英荘の茶葉を宣伝するための映影でしょ？このまま学んでいても目的からどんどん離れていっちゃうなと。だから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140813
					],
					"speakerTitle": "興曄"
				},
				{
					"id": 711140813,
					"content": "そう！そこで私たちはしばらく勉強を中断して、まずはドキュメンタリー映影を撮影してみて、実践で自分たちの学習成果を検証してみようと思ったのよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140814
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 711140814,
					"content": "…まぁ、資金が底をつきそうっていうのもあるんですけどね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140815
					],
					"speakerTitle": "弈豊"
				},
				{
					"id": 711140815,
					"content": "計画は万事順調だって言ったはずでしょ。この映影の撮影が上手くいけば、資金は戻ってくるんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140816
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 711140816,
					"content": "で、その後すぐに吊り橋の上で宝盗団に挟まれてしまい、こうしてあなたに助けていただいたわけです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140817,
						711140818
					],
					"speakerTitle": "弈豊"
				},
				{
					"id": 711140817,
					"content": "ここは…翹英荘からはちょっと遠くない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140819
					]
				},
				{
					"id": 711140818,
					"content": "翹英荘を撮るのに、何でここにいるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140819
					]
				},
				{
					"id": 711140819,
					"content": "はぁ…そりゃあ、迫力を出すために壮大な景色を映影に取り入れたかったからに決まってるでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140820
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 711140820,
					"content": "撮影に夢中になりすぎたせいで宝盗団に隙を突かれちゃってね。ここまで逃げてきたんだけど…結局行く手を阻まれたってわけ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140821
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 711140821,
					"content": "待てよ…斡流が前に言ってたプロの撮影師って、まさか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140822
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711140822,
					"content": "そうですよ、邱社長たちのことです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140823
					],
					"speakerTitle": "斡流"
				},
				{
					"id": 711140823,
					"content": "斡流さん、い、いきなりどこから出てきたの？ぜんぜん気づかなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140824
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 711140824,
					"content": "隠れるのは得意ですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140825
					],
					"speakerTitle": "斡流"
				},
				{
					"id": 711140825,
					"content": "顔見知りだったんだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140826
					]
				},
				{
					"id": 711140826,
					"content": "斡流さんはプロの水文学者ですもの。この辺の地形のことなら手に取るようにわかるでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140827
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 711140827,
					"content": "ロケーションの事については、何度もアドバイスをもらってるのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140828
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 711140828,
					"content": "できることなら、斡流さんをうちの映影チームに引き入れたいわ！まぁ、時間のあるときにまた考えてみるって断られちゃったんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140829
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 711140829,
					"content": "あのー…社長、さっき逃げてくるとき、写真とか機材の入った箱を置いてきちゃったみたいです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140830
					],
					"speakerTitle": "弈豊"
				},
				{
					"id": 711140830,
					"content": "その箱に…撮り終えた映影フィルムも一部、入ってたと思うんですけどー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140831
					],
					"speakerTitle": "興曄"
				},
				{
					"id": 711140831,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140832
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 711140832,
					"content": "#斡流さん！{NICKNAME}、パイモン！改めてありがとう！じ…時間があったら翹英荘に会いにきてちょうだいね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140833
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 711140833,
					"content": "何にしても…命を救ってくれたことに対する恩返しがしたいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140834
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 711140834,
					"content": "じゃあ、お先に失礼するわね！ほらっ、急いで！箱をどこに置いたのよ！走るわよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140835
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 711140835,
					"content": "邱社長たちは慌てふためいてその場を去っていった…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						711140836
					]
				},
				{
					"id": 711140836,
					"content": "邱社長たちの箱って…ホントについてないよなぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140837
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711140837,
					"content": "でも「好事魔多し」とも言いますから。邱社長たちはきっと素晴らしい映影を撮影できると思いますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140838
					],
					"speakerTitle": "斡流"
				},
				{
					"id": 711140838,
					"content": "では、先に報酬をお渡ししますね。あとで最後の一台を設置し終えたら…私も時間を作って邱社長と話してみます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140839
					],
					"speakerTitle": "斡流"
				},
				{
					"id": 711140839,
					"content": "でないと三人とも、また撮影のためにどこかへ行ってしまうかもしれませんからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140840
					],
					"speakerTitle": "斡流"
				},
				{
					"id": 711140840,
					"content": "そういえば、さっき時間があったら翹英荘に会いに来てと仰ってましたよね…後で私、向かってみます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "斡流"
				}
			]
		},
