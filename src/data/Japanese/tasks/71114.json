			"dialogs": [
				{
					"id": 711140901,
					"content": "うーん、やっぱり先に翹英荘の中の景色を撮ろうかしら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140902,
						711140903
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 711140902,
					"content": "大丈夫？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140904
					]
				},
				{
					"id": 711140904,
					"content": "#あら、{NICKNAME}にパイモン！ふふっ、あなたたちのおかげで機材とフィルムは無事手元に戻ってきたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140905
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 711140905,
					"content": "でも、次はあそこに行ってロケがしたいのよね。冒険者を何人か雇ってついてきてもらう必要がありそうだわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140906
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 711140906,
					"content": "それで、おまえらのお茶を宣伝する映影の撮影はどんな感じなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140907
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711140907,
					"content": "えっと…今回の作品は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140908
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 711140908,
					"content": "出だしは順調です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140909
					],
					"speakerTitle": "興曄"
				},
				{
					"id": 711140909,
					"content": "良い方向性です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140910
					],
					"speakerTitle": "弈豊"
				},
				{
					"id": 711140910,
					"content": "まだ撮影を始めたばかりってこと…！？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140911
					]
				},
				{
					"id": 711140911,
					"content": "だって、私たちはいま資金がちょっと…ちょっとね。ガイサートさんへ支払わなきゃいけない額は、彼の学問レベルと同じで高いから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140912
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 711140912,
					"content": "今までも小規模の作品を撮って小金を稼いだことはあるけど、こういう大型ドキュメンタリーの撮影って、すごくお金がかかるのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140913
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 711140913,
					"content": "それに、社長はスポンサーになりたいっていう企業からの誘いをいくつか断りましたしね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140914
					],
					"speakerTitle": "興曄"
				},
				{
					"id": 711140914,
					"content": "それと、提携のお誘いもね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140915
					],
					"speakerTitle": "弈豊"
				},
				{
					"id": 711140915,
					"content": "あなたたちに何がわかるの！？それは、私たちだけのアイデアで素晴らしい作品を撮るためよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140916
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 711140916,
					"content": "でも社長。オレたち、一番最初の目的だってお金のためだったじゃないですかー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140917
					],
					"speakerTitle": "興曄"
				},
				{
					"id": 711140917,
					"content": "あ…あなたたちにとってはどうだっていい事でしょ！ほら、撮影機材をセットしてきなさい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140918
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 711140918,
					"content": "#{NICKNAME}、これはお礼の報酬よ。何度も助けてくれてありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140919
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 711140919,
					"content": "いい作品が撮れたらきっとあなたを招待するわ。その時は、お茶でもごちそうさせて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140920
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 711140920,
					"content": "弈豊、興曄！光源の角度はいい？通しで撮るわよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140921
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 711140921,
					"content": "社長、別に対話シーンを撮るんじゃないんですから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140922
					],
					"speakerTitle": "興曄"
				},
				{
					"id": 711140922,
					"content": "景色を一発で撮影できるかどうかなんて、運任せみたいなものでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140923
					],
					"speakerTitle": "弈豊"
				},
				{
					"id": 711140923,
					"content": "と…とにかく機材をセットしてきなさい！ここで待ってるから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "邱社長"
				},
				{
					"id": 711140903,
					"content": "機材は無事だったみたいだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140904
					]
				}
			]
		},
