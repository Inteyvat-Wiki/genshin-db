				]
			},
			"dialogs": [
				{
					"id": 711140401,
					"content": "…こうすれば行けるはず…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140402
					],
					"speakerTitle": "斡流"
				},
				{
					"id": 711140402,
					"content": "旅人さん！計器の設置が終わったんですね。本当にありがとうございます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140403
					],
					"speakerTitle": "斡流"
				},
				{
					"id": 711140403,
					"content": "この計器の設置が済んだら、報酬をお渡ししますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140404
					],
					"speakerTitle": "斡流"
				},
				{
					"id": 711140404,
					"content": "さっきついでに頼んでくれてよかったのに。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140405
					]
				},
				{
					"id": 711140405,
					"content": "お気遣いありがとうございます。ただ、この計器だけはちょっと特殊で…調整が必要な箇所が多いので、あなたに操作をお願いするのはご迷惑だと思うんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140406
					],
					"speakerTitle": "斡流"
				},
				{
					"id": 711140406,
					"content": "あの崖の上に計器を設置し終わったら、報酬をお渡ししますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140407
					],
					"speakerTitle": "斡流"
				},
				{
					"id": 711140407,
					"content": "なんだかややこしそうだな…おまえは、ずっとこういう仕事をしてるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711140408,
					"content": "今回は計器を陸地に設置するだけですけど…違う研究では、計器を大きな川のど真ん中に沈める方法を見つけないといけないってこともあったんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140409
					],
					"speakerTitle": "斡流"
				},
				{
					"id": 711140409,
					"content": "船に乗ればいいんじゃないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140410
					]
				},
				{
					"id": 711140410,
					"content": "ええ、計器を川の中に沈めるだけでいいのなら、船から計器を水中に落として、その場を去るのでもよかったでしょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140411
					],
					"speakerTitle": "斡流"
				},
				{
					"id": 711140411,
					"content": "でも、その時の視察で計測したかったのは水流の強さだったので、特殊な計器を常に水流の中心に置きつづける必要があったんです。つまり、上に浮き上がっても底に沈んでもダメで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140412
					],
					"speakerTitle": "斡流"
				},
				{
					"id": 711140412,
					"content": "幸い、そこには吊り橋がかかっていたので良かったですけど。もしあれが無かったら、誰かに頼んで両側の山の間にロープを引いてもらう必要がありました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140413
					],
					"speakerTitle": "斡流"
				},
				{
					"id": 711140413,
					"content": "その後、計器をロープで吊るし上げて、もう一本のロープで引っ張って川の中心まで運び、水の中に下ろすんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140414
					],
					"speakerTitle": "斡流"
				},
				{
					"id": 711140414,
					"content": "コホン…まぁこの話はいいでしょう。今はそういう状況じゃないわけですし…あとで吊り橋に行くことにはなりますけどね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140415
					],
					"speakerTitle": "斡流"
				},
				{
					"id": 711140415,
					"content": "こっちですよ、吊り橋までもうすぐです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "斡流"
				}
			]
		},
