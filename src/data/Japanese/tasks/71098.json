					"nextDialogs": [
						710980711
					]
				},
				{
					"id": 710980711,
					"content": "聞きに行こう。もしかしたら、なにか新しい料理の研究をしてるのかも…へへっ、オイラたち試食できるかもしれないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
