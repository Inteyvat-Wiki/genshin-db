					"ガルシア",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710980101,
					"content": "あのう、今日含めて連続で六日間、大根入りの野菜スープを食べていますよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980102
					],
					"speakerTitle": "路通"
				},
				{
					"id": 710980102,
					"content": "金銭面だけでなく、胃腸のほうの事情も無視できなくなってきてると思うのですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980103
					],
					"speakerTitle": "路通"
				},
				{
					"id": 710980103,
					"content": "そうか、まさにその通りだ！親愛なる路通よ、相変わらず鋭いな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980104
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 710980104,
					"content": "俺たちは胃腸に問題を抱えているから、味を正しく判断できていないのかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980105
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 710980105,
					"content": "となれば路通、検証係が必要だ！第三者の立場から見てくれる人物を見つけなければならない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980106
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 710980106,
					"content": "お褒めいただき、ありがとうございます。ただ、私が言いたいのはそういうことではなく…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980107,
						710980108
					],
					"speakerTitle": "路通"
				},
				{
					"id": 710980107,
					"content": "何してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980109
					]
				},
				{
					"id": 710980109,
					"content": "おっ…ははっ！ほら、検証係が来てくれたぞ！しかも二人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980110
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 710980110,
					"content": "えっ？け…検証係？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710980111,
					"content": "#{M#俺}{F#私}たちのこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980112
					]
				},
				{
					"id": 710980112,
					"content": "そうだ。君、大根入りの野菜スープを食べたことは？味と作り方は知ってるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980113
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 710980113,
					"content": "あのう、まずは事情を説明したほうがいいのでは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980114
					],
					"speakerTitle": "路通"
				},
				{
					"id": 710980114,
					"content": "#おう、食べたことあるぞ！{NICKNAME}が作ってくれるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710980115,
					"content": "パイモン、まずは事情を聞かないと。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980116
					]
				},
				{
					"id": 710980116,
					"content": "では、引き受けてもらいたい依頼について説明させてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980117
					],
					"speakerTitle": "路通"
				},
				{
					"id": 710980117,
					"content": "私の名前は路通、彼は私のボスでフォンテーヌから来たガルシアさんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980118
					],
					"speakerTitle": "路通"
				},
				{
					"id": 710980118,
					"content": "ガルシアさんは今…その…「ナンバリングマシン」というものを研究しています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980119
					],
					"speakerTitle": "路通"
				},
				{
					"id": 710980119,
					"content": "具体的に説明しますと、さまざまな計算が楽になる道具です。この認識で合っていますか、ガルシアさん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980120
					],
					"speakerTitle": "路通"
				},
				{
					"id": 710980120,
					"content": "完璧だ、親愛なる路通よ。「ナンバリングマシン」の機能はまさにその通り。実にシンプルなものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980121
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 710980121,
					"content": "そう、シンプル…シンプルでなければならないというのに、あの変換器は複雑すぎる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980122
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 710980122,
					"content": "でも、それと大根入りの野菜スープになんの関係があるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710980123,
					"content": "その質問については、ガルシアさんにご説明いただくのがよろしいかと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980124
					],
					"speakerTitle": "路通"
				},
				{
					"id": 710980124,
					"content": "だが、どうやってシンプルに…ん？ああ、分かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980125
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 710980125,
					"content": "まずは、もっとも初歩的なところからいこう。君たちは「方程式」というものを知っているか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980126
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 710980126,
					"content": "方程式？えっと、聞いたことないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710980127,
					"content": "よく分からない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980128
					]
				},
				{
					"id": 710980128,
					"content": "そうか。いや、問題ない…方程式とは…そうだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980129
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 710980129,
					"content": "様々な値の関係を表すために用いられる、一定の汎用性を持つものだと理解してくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980130
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 710980130,
					"content": "え、えっと…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980131
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710980131,
					"content": "なんだかすごそう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980132
					]
				},
				{
					"id": 710980132,
					"content": "ざっくり言うと、「ナンバリングマシン」を使って、大根入りの野菜スープのレシピ式を書こうとしているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980133
					],
					"speakerTitle": "路通"
				},
				{
					"id": 710980133,
					"content": "ガルシアさんは、正しい方程式さえ見つかれば、「大根入りの野菜スープ」の作り方を…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980134
					],
					"speakerTitle": "路通"
				},
				{
					"id": 710980134,
					"content": "ある種の「汎用」的に使える工程として、転用することができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980135
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 710980135,
					"content": "つまり…「凡庸」な人でも使える工程です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980136
					],
					"speakerTitle": "路通"
				},
				{
					"id": 710980136,
					"content": "この工程通りにすれば、誰でもおいしく「大根入りの野菜スープ」を作れるようになるんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980137
					],
					"speakerTitle": "路通"
				},
				{
					"id": 710980137,
					"content": "なんだか、めんどくさそうだな…料理の作り方なんて、直接誰かに聞けば済むことだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980138
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710980138,
					"content": "残念ながら、その方法は料理の才能があることを前提としています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980139
					],
					"speakerTitle": "路通"
				},
				{
					"id": 710980139,
					"content": "私やガルシアさんのように料理の才能がまったくない人間が、いくら料理人にきっちり教わったとしても、その真髄を理解することはできません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980140
					],
					"speakerTitle": "路通"
				},
				{
					"id": 710980140,
					"content": "まあ、これについては、この旅館にいる言笑さんもよく知っているかと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980141,
						710980143
					],
					"speakerTitle": "路通"
				},
				{
					"id": 710980141,
					"content": "「方程式」を求めるのを手伝うってこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980142
					]
				},
				{
					"id": 710980142,
					"content": "いや、君たちの頭を悩ませるつもりはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980145
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 710980145,
					"content": "君たちには、第三者の立場から「検証係」になってほしいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980146
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 710980146,
					"content": "簡単に言うと、ガルシアさんが方程式通りに作った「大根入りの野菜スープ」を食べていただき、その感想を教えてほしいんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980147
					],
					"speakerTitle": "路通"
				},
				{
					"id": 710980147,
					"content": "つまり、美味しいものを試食しろってことだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980148
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710980148,
					"content": "そのまとめ方はいくら何でも雑すぎる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980149
					]
				},
				{
					"id": 710980149,
					"content": "そんな細かいこと気にすんなよ。とにかく、「方程式」で作った大根入りの野菜スープなんか食べたことないし、オイラたちが手伝ってやろうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980150
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710980150,
					"content": "では、よろしくお願いしますね。先ほど言笑さんにお願いして、ご好意で厨房を使わせていただけることになりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980151
					],
					"speakerTitle": "路通"
				},
				{
					"id": 710980151,
					"content": "ガルシアさん、この実験も前回と同じステップで進めますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980152
					],
					"speakerTitle": "路通"
				},
				{
					"id": 710980152,
					"content": "ん？ああ！すまない、また考え事をしていた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980153
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 710980153,
					"content": "方程式の引数が頭の中でごっちゃになってしまってな、上手くまとまらないんだ…ああ、前回と同じ三つのステップで進めよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 710980143,
					"content": "料理を教えてほしいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980144
					]
				},
				{
					"id": 710980144,
					"content": "いや…そうではない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980145
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 710980108,
					"content": "大根入りの野菜スープの「方程式」について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980109
					]
				}
			]
		},
		{
