						710981502
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 710981502,
					"content": "失礼だが…これはどうやって作ったんだ？材料の正確な分量は？調味料は何をどう入れた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981503,
						710981504
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 710981503,
					"content": "そ、そんなに近寄らないで！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710981505
					]
				},
				{
					"id": 710981505,
					"content": "ああ…これは失礼。それよりも、どうやってこの料理を作ったのか教えてくれないか？俺に新たなアイデアが降りてくるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981506
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 710981506,
					"content": "大根入りの野菜スープの調理方法を詳しく説明した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710981507
					]
				},
				{
					"id": 710981507,
					"content": "なるほど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981508
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 710981508,
					"content": "はぁ、料理の味というものには、本当にたくさんの変数が関わっているんだな。より正確に計算するには、計算量を増やす必要があるということか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981509
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 710981509,
					"content": "だが、さらに計算するとなると、「ナンバリングマシン」を改良しなければならない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981510
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 710981510,
					"content": "教令院の図書館の資料が、俺に良い刺激を与えてくれるといいんだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981511
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 710981511,
					"content": "どうして、「ナンバリングマシン」を作ろうと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710981512
					]
				},
				{
					"id": 710981512,
					"content": "ああ、いい質問だな。しかしその質問に答える前に、まず俺から一つ質問させてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981513
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 710981513,
					"content": "俺が作ったこの「ナンバリングマシン」に、「思想」はあると思うか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981514,
						710981515
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 710981514,
					"content": "どういう意味？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710981516
					]
				},
				{
					"id": 710981516,
					"content": "そうだ。まずはこの質問について考えてみてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981517
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 710981517,
					"content": "次に会う時、これについて君と議論がしたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981518
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 710981518,
					"content": "とりあえず今は、データの整理をしなければな…さあ路通、始めるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981519
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 710981519,
					"content": "はい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981520
					],
					"speakerTitle": "路通"
				},
				{
					"id": 710981520,
					"content": "旅人さん、こちらを受け取ってください。ガルシアさんはいつもこんな感じなので、大目に見ていただけると助かります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981521
					],
					"speakerTitle": "路通"
				},
				{
					"id": 710981521,
					"content": "スメールに行くの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710981522
					]
				},
				{
					"id": 710981522,
					"content": "はい。情報収集をするために、ガルシアさんは教令院へ行くことにしたんです。私は雇われて同行することになりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981523
					],
					"speakerTitle": "路通"
				},
				{
					"id": 710981523,
					"content": "旅人さん、さようなら。またスメールでお会いできたらいいですね。ガルシアさんも喜ばれると思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "路通"
				},
				{
					"id": 710981515,
					"content": "「ナンバリングマシン」に「思想」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710981516
					]
				},
				{
					"id": 710981504,
					"content": "ま、まずは距離を保とう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710981505
					]
				}
			]
		}
	]
}