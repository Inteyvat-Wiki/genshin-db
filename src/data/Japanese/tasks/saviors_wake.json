					"nextDialogs": [
						740770704
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740770704,
					"content": "結社はマシナリーを嫌ってるのに…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740770705
					]
				},
				{
					"id": 740770705,
					"content": "どうして塔にはこんなに沢山歯車があるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740770706
					]
				},
				{
					"id": 740770706,
					"content": "面白い質問ですね。でもボクが答えられるのはただの推論に過ぎませんよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770707
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740770707,
					"content": "ここのテーマは「歯車」ではなく、「時計」だと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770708
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740770708,
					"content": "ジェイコブやナルツィッセンクロイツにとっても、時計が鳴り響くことにはおそらく特別な意味があるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770709
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740770709,
					"content": "特別な意味？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740770710
					]
				},
				{
					"id": 740770710,
					"content": "時計が鳴り響くと、世界が終わり、冒険が終わる…または夢から、目が覚める。それを知るすべはありませんけどね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キャタピラー"
				}
			]
		},
