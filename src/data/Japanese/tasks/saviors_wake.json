			"dialogs": [
				{
					"id": 740772501,
					"content": "#{NICKNAME}、ページには何が挟んであるでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740772502
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740772502,
					"content": "わあ、鍵だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740772503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740772503,
					"content": "その通りです。セイモアに超音波画像診断機能で簡単に検証してもらいましたが、確かにあの扉の鍵でした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740772504
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740772504,
					"content": "フォンテーヌ政府が昔捜査したんなら、どうして本に隠された鍵がずっと見つかってないんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740772505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740772505,
					"content": "その答えは、もしかすると…実際には、そもそも捜査されていなかったのかもしれませんね。先ほどここのノートを調べてみて、大体の理由は分かりました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740772506
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740772506,
					"content": "なぜ彼が、扉だけをそっと閉じて離れたのかがね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740772507
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740772507,
					"content": "えっ、それってどういう意味だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740772508
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740772508,
					"content": "いえ、何でもありません。さて、この辺で切り上げましょう。いつ起動してもおかしくないクロックワークもありますからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740772509
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740772509,
					"content": "そろそろ行かないと。",
