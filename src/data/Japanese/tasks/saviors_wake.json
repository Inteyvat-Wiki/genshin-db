			"dialogs": [
				{
					"id": 740770801,
					"content": "こんにちは、何かお手伝いしましょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770802
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 740770802,
					"content": "警備ロボについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740770803
					]
				},
				{
					"id": 740770803,
					"content": "ご心配なく。すべて非活性状態にあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770804
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 740770804,
					"content": "それに長い年月を経た今、初期モデルのこれらがよみがえる確率は100%ではありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770805
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 740770805,
					"content": "私のそばにいた方々の記録によれば、下の階の入り口を開くと、これらをアクティブ化するシーケンスが起動します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770806
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 740770806,
					"content": "その時はおおよそ60%の確率で起動が成功します。残りの40%は、100%起動できないというわけでもありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770807
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 740770807,
					"content": "えっと…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740770808
					]
				},
				{
					"id": 740770808,
					"content": "少なくとも、長い時間はこちらの戦闘準備の負担を減らしてくれた可能性があります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770809
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 740770809,
					"content": "そのロジック、分かりにくいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740770810
					]
				},
				{
					"id": 740770810,
					"content": "#申し訳ございません、{NICKNAME}様。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "セイモア"
				}
			]
		},
