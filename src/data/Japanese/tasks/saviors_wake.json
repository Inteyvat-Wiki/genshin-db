			"dialogs": [
				{
					"id": 740770201,
					"content": "こいつら…なかなかの規模ですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770202
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740770202,
					"content": "キャタピラーがまた元に戻ったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740770203,
					"content": "戦闘準備をしなければなりませんからね。ほら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770204
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740770204,
					"content": "これはこの塔を封鎖した時に残された安全設備でしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770205
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740770205,
					"content": "一番下の階へ行こうとすると、この覚醒シーケンスを起動させてしまうかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770206
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740770206,
					"content": "ご推測の通りです。検証しましたが、これらのクロックワーク·マシナリーは覚醒して再起動する可能性があります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770207
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 740770207,
					"content": "言い換えれば、覚醒しない可能性もあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770208
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 740770208,
					"content": "こいつらって、ずっとここにいるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740770209,
					"content": "長い年月が経ちましたが、水仙十字聖剣が修復されるのはこれが初めてですからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770210
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740770210,
					"content": "当初の設計に間違いがなければ、最後の封印を解く鍵は聖剣そのものです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770211
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740770211,
					"content": "準備ができたら、早速始めましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キャタピラー"
				}
			]
		},
