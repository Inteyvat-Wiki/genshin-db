			"dialogs": [
				{
					"id": 740772101,
					"content": "#騎士{NICKNAME}、まだ何か聞きたいことがあるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740772102
					],
					"speakerTitle": "アン"
				},
				{
					"id": 740772102,
					"content": "これが終わったら、何かやりたいことある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740772103
					]
				},
				{
					"id": 740772103,
					"content": "実はそこまで考えてないんだ。何だかあたし、もう行く場所がないみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740772104
					],
					"speakerTitle": "アン"
				},
				{
					"id": 740772104,
					"content": "真実を知ったからには、もうプティ·シュちゃんとアルの傍には戻れないもん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740772105
					],
					"speakerTitle": "アン"
				},
				{
					"id": 740772105,
					"content": "あたしはどこへ行けばいいのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740772106
					],
					"speakerTitle": "アン"
				},
				{
					"id": 740772106,
					"content": "まあいっか。これからのことはまたあとで考えよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アン"
				}
			]
		},
