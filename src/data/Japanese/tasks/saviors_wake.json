			"dialogs": [
				{
					"id": 740770401,
					"content": "#騎士{NICKNAME}、パイモン、キャタピラー、セイモア…みんな大丈夫？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770402
					],
					"speakerTitle": "アン"
				},
				{
					"id": 740770402,
					"content": "ええ。さらに奥へ向かう入り口が、もうすぐ開きそうですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770403
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740770403,
					"content": "行きましょう、機を逃してはいけません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770404
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740770404,
					"content": "でも、まだいっぱいクロックワーク·マシナリーがいるぞ…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740770405,
					"content": "早く！ここはボクとセイモアに任せてください。水仙十字結社で会いましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770406
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740770406,
					"content": "頼んだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740770407
					]
				},
				{
					"id": 740770407,
					"content": "ご心配なく。戦力評価の結果、生還率は100%です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770408
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 740770408,
					"content": "キャタピラーとセイモアに頷いてみせた後、封印が解除された瞬間を狙って飛び込んだ。\\nその向こうには…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
