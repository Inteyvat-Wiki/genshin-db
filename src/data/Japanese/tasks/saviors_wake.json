				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740771201,
					"content": "#{NICKNAME}、みんななんで夢に入り浸るのが好きなんだろうな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740771202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740771202,
					"content": "「マリアン」はみんなが傍にいる夢を見たし、ナルツィッセンクロイツは世界を救う夢の中に生きてたよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740771203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740771203,
					"content": "#{M#俺}{F#私}だけがいつも明日の心配をしてるから…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740771204
					]
				},
				{
					"id": 740771204,
					"content": "…パイモンが理解できないのも無理はない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740771205
					]
				},
				{
					"id": 740771205,
					"content": "オ、オイラは今を生きるタイプなんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740771206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740771206,
					"content": "夢はいつか覚める。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740771207
					]
				},
				{
					"id": 740771207,
					"content": "夢が覚めたら、選択肢は二つしかないよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740771208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740771208,
					"content": "さっさと二度寝して、夢の続きを見れるか試してみる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740771209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740771209,
					"content": "それか、目覚めた世界で、ちゃんと自分と向き合うんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740771210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740771210,
					"content": "夢が覚めたからには、朝ごはんを食べないとな。鳥肉と野生キノコの串焼きで自分を労わろうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740771211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740771211,
					"content": "今日もまたすっきり目覚めて、勇気を出して現実の一日と向き合わなきゃいけないぞ。自分を元気づけてやろうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740771212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740771212,
					"content": "わあ、ほんとに伏線だった！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740771213
					]
				},
				{
					"id": 740771213,
					"content": "伏線？なんの話だよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
