					"id": 740770508,
					"content": "心配しないで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740770510
					]
				},
				{
					"id": 740770510,
					"content": "未来に向かって進まないと。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740770511
					]
				},
				{
					"id": 740770511,
					"content": "うん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770512
					],
					"speakerTitle": "アン"
				},
				{
					"id": 740770512,
					"content": "この先はなにが待ってるんだろうな…慎重に進もう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
