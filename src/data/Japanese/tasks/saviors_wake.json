					"nextDialogs": [
						740772303
					]
				},
				{
					"id": 740772303,
					"content": "すべてが終わった後ということですか？もしもう一度マリアンお嬢様とお会い出来たら、私は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740772304
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 740772304,
					"content": "マメールお嬢様に会いに行くことを了承していただけるようお願いし、二人と一緒に世界を一周したいと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740772305
					],
					"speakerTitle": "セイモア"
				},
				{
