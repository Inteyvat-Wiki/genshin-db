			"dialogs": [
				{
					"id": 740770101,
					"content": "塔の高さから考えれば、恐らくもうすぐ一番下の階に着くと思います。さらにその下へ行けば、ナルツィッセンクロイツと対面することになるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770102
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740770102,
					"content": "滅びか、救いか…あるいはナルツィッセンクロイツの方法による救いか…世界もその答えを迎えるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770103
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740770103,
					"content": "あいつらの考えるような方法で災難を逃れるなんて嫌だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740770104,
					"content": "#どうしても逃れたいなら、{NICKNAME}にテイワットから連れ出してもらった方がいいぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740770105,
					"content": "#{M#俺}{F#私}はみんなを救いたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740770106
					]
				},
				{
					"id": 740770106,
					"content": "おいっ、オイラだってみんなを見殺しにするとは言ってないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740770107,
					"content": "ここにはギミックもなさそうですし、追手もいません。少し休みましょうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770108
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740770108,
					"content": "うん、準備を整えよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740770109
					]
				},
				{
					"id": 740770109,
					"content": "皆様、下の階に通じるこの扉には、鍵がかかっているようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770110
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 740770110,
					"content": "私がエンジンをオーバーランさせて、無理矢理扉を突き破りましょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770111
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 740770111,
					"content": "大丈夫です。どちらにせよここで少し休むつもりでしたから、今は少し注意しながら、鍵を探してみましょうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770112
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740770112,
					"content": "もし最終的に鍵が見つからなかったら、そのときはボクが扉を壊します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キャタピラー"
				}
			]
		},
