				{
					"id": 105020206,
					"content": "草スライムだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020207
					]
				},
				{
					"id": 105020207,
					"content": "と…とりあえず片付けよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 105020203,
					"content": "それは絶対に草スライムだ。",
					"roleType": "TALK_ROLE_PLAYER",
