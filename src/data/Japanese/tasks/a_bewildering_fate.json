			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"モナ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105020401,
					"content": "やっと戻ってきましたか、待ちくたびれました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020402
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020402,
					"content": "暇つぶしにこれを読んでいたのですが、訳の分からない日記で全然面白くありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020403
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020403,
					"content": "クレーちゃんのカバンから落ちた本だったので、古代の知識でも書いてあるかと期待したのですが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020404
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020404,
					"content": "それより、箱は見つかりました？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020405
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020405,
					"content": "見つけたよ！ほら、壊れてない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020406
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 105020406,
					"content": "よかったです——ちょ、ちょっと待ってください！？どうして鍵が掛かってないんですか！中身は…そんなっ！空っぽ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020407
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020407,
					"content": "なんだって——！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 105020408,
					"content": "クレーはね、この箱にクレーが集めた宝物を入れてたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020409
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 105020409,
					"content": "はい！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020410
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020410,
					"content": "お姉ちゃんがこの箱を欲しいっていうから、クレーの宝物は出しておいたの。だから今は空っぽ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020411
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 105020411,
					"content": "この箱を入れ物として使っていたってことですか！？…じゃ、じゃあ最初に入っていた物は？それが欲しいんです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020412
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020412,
					"content": "あれ、箱に入ってたものが欲しかったの？…なら、そう教えてくれたらよかったのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020413
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 105020413,
					"content": "…ま、まさか壊してないですよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020414
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020414,
					"content": "だいじょうぶ！壊してないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020415
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 105020415,
					"content": "ふう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020416
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020416,
					"content": "元々入ってたものは、お姉ちゃんがいま手に持ってる本だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020417
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 105020417,
					"content": "えぇ——ッ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020418
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020418,
					"content": "そ、そんな…この本、この日記って…おばばが…50年前のおばばが書いた日記！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020419
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020419,
					"content": "50年が過ぎた今、少女時代の黒歴史を回収するつもりだったということですか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020420
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020420,
					"content": "しまった！どうりで…！どうりで何があっても中は見ちゃいけない、見たらおしまいだっておばばが言っていたわけです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020421
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020421,
					"content": "クレー、またトラブル起こしちゃった…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020422
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 105020422,
					"content": "だって！箱が欲しいって言ったのはお姉ちゃんだもん、中身の話をしなかったから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020423
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 105020423,
					"content": "クレー、何も知らないよ！さ、先に帰るね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020424,
						105020425
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 105020424,
					"content": "感動の結末だ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020426
					]
				},
				{
					"id": 105020426,
					"content": "いや…でもモナが日記を見たことさえ言わなければ、師匠に知られる心配もないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020427
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 105020427,
					"content": "それは無理です、占星術の前で嘘は通じません。あなたたちも経験したでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020428
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020428,
					"content": "ああ…全財産を使ってモンドまで来たのに、知識を得るどころか戻れなくなるなんてどうすればいいんですか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020429
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020429,
					"content": "さすがに可哀想だな…そうだ、本の内容を全部忘れた頃に戻ったらどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020430
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 105020430,
					"content": "そう簡単に忘れられませんよ…それにモンドに残りたくとも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020431,
						105020433
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020431,
					"content": "メンツがあるから？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020432
					]
				},
				{
					"id": 105020432,
					"content": "はい、俗世人と一緒に生活を続ければ、占星術師としての心を維持できなくなってしまいます…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020435
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020435,
					"content": "仕方ないだろ。それが嫌なら師匠のところに戻るしかないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020436
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 105020436,
					"content": "も、もう言わないでください！こ、こうなったら、しょうがありません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020437
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020437,
					"content": "決めました。しばしモンドに滞在することにします。おばばが天寿を全うすれば、私も自由の身になれます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020438,
						105020439
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020438,
					"content": "あまりにも固い覚悟だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020440
					]
				},
				{
					"id": 105020440,
					"content": "ですが、占星術の研究はどうしましょう…いや、まず住むところを探さないといけませんね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020441
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020441,
					"content": "それなら、<color=#00E1FFFF>冒険者協会のキャサリン</color>に聞いてみたらどうだ。何か助けてくれるかもしれないぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020442
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 105020442,
					"content": "冒険者協会？…そうですね、依頼をこなせば、あれが…もらえますからね…分かってますよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020443,
						105020444
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020443,
					"content": "うん、分かってる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020445
					]
				},
				{
					"id": 105020445,
					"content": "えっと、ありがとうございます…その、私…いや、何でもありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020444,
					"content": "そのつもりだった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020445
					]
				},
				{
					"id": 105020439,
					"content": "それって「しばし」なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020440
					]
				},
				{
					"id": 105020433,
					"content": "お金がない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020434
					]
				},
				{
					"id": 105020434,
					"content": "そう…ち、違います！あなた、本当に空気読まない人ですね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020435
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020425,
					"content": "クレーに怒っても仕方ない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020426
					]
				}
			]
		},
		{
