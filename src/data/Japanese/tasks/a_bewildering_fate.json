			},
			"dialogs": [
				{
					"id": 105020501,
					"content": "モナの出自と境遇について…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020502
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 105020502,
					"content": "なるほど、事情は分かりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020503
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 105020503,
					"content": "今、モンドには空いている<color=#00E1FFFF>魔法実験室</color>が1部屋あります。ただ、何者かによって封印が施されているのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020504
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 105020504,
					"content": "封印を解くことができる者もこのモンドには数名いますが、その人たちは自分の実験室を持っているので興味がないようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020505
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 105020505,
					"content": "もしその占星術師さんが封印を解くことができたら、きっと部屋の主も彼女が使うのを快諾してくれると思いますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020506,
						105020507
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 105020506,
					"content": "モナならきっとできる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020508
					]
				},
				{
					"id": 105020508,
					"content": "分かりました。では、さっそく部屋の場所を案内しますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 105020507,
					"content": "モナを連れていってみる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020508
					]
				}
			]
		},
		{
			"id": 1050206,
			"completionStepIds": [
				1050211
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
