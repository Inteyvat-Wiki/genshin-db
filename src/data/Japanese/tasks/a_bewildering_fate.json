			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"モナ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105020101,
					"content": "もうすぐ継承者に会えますね、心の準備はいいですか？師匠に恥かかせないでくださいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020102,
						105020103
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020102,
					"content": "占いはできないよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020104
					]
				},
				{
					"id": 105020104,
					"content": "それなら…って、ダメです！弟子のふりといえども、何も知らないわけにはいきません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020105
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020105,
					"content": "部外者に教えてはいけないという決まりがありますが…あなただったら、別に問題ないですよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020106
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020106,
					"content": "私の占星術は「水占の術」。その名の通り、水面に映る星空を観察することで行います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020107
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020107,
					"content": "手本を見せるので、よく見ていてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020108
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020108,
					"content": "現在の星像と動きを見るに…うん、例の継承者は西風騎士団の人で、若く有能な…女性…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020109
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020109,
					"content": "その情報だと…えっと…まさかリサさんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 105020110,
					"content": "もうすぐここで会えます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020111
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020111,
					"content": "よし、これぐらいの情報があれば十分ですよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020112,
						105020113
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020112,
					"content": "そ、それで終わり？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020114
					]
				},
				{
					"id": 105020114,
					"content": "まあ、一番基本となる占星術でも、一目見て分かるようなものじゃありませんからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020115
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020115,
					"content": "この辺は追々ゆっくりと説明します。どうやら彼女が来たようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020116
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020116,
					"content": "#わあ、栄誉騎士の{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}！それとパイモンちゃん、おかえりなさい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020117
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 105020117,
					"content": "——彼女こそ！例の偉大なる学識の継承者です！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020118,
						105020119
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020118,
					"content": "…クレーが！？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020120
					]
				},
				{
					"id": 105020120,
					"content": "けい…しょうしゃ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020121
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 105020121,
					"content": "そうです、星の海の秘密を知り尽くした占星術師とは、ずばりこの私のこと！私がここに来ると分かったから、あなたもここに来たんですよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020122
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020122,
					"content": "星の海？星の海ってなに？そこにも魚がいるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020123
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 105020123,
					"content": "魚…？いやいや、とぼけないでください。まさか私との勝負が怖いんじゃないですよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020124
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020124,
					"content": "お姉ちゃんこそ、一体なにを言ってるの？クレー、分からないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020125,
						105020126
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 105020125,
					"content": "このままだとキリがない！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020127
					]
				},
				{
					"id": 105020127,
					"content": "私の占星術が外れるなんてことありません…うーん、念の為聞きますが、あなたのお母さんは「アリス」さん、そうですね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020128
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020128,
					"content": "そうだよ。あっ！お姉ちゃん、ママのお友達なんだね。でも、ママは今とても遠いところに行ってるよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020129
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 105020129,
					"content": "ええ、知ってます——それが占星術の結果ですから。でも彼女がここを発つ前、神秘学の知識を全部あなたに教えていますよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020130
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020130,
					"content": "神秘学…知識…？よく分からないけど、ボンボン爆弾の作り方ならママから教わったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020131
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 105020131,
					"content": "クレーのお母さんが、モナの師匠の「友人兼ライバル」だったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020132
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 105020132,
					"content": "そうです。師匠は占星術が得意でしたが、それ以外はからっきしでした。ですが、アリスさんは違います。彼女はあらゆる神秘学の知識を知り尽くす天才でした…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020133
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020133,
					"content": "そうだったのか…でもクレーはまだ小さいし、たとえそういう知識を聞かされていたとしても理解できてないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020134
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 105020134,
					"content": "そうですね。血筋は引いていても、知識までは引き継げていなかったようです…参りましたね、これじゃ勝負になりません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020135
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020135,
					"content": "そうだ、クレーちゃん。アリスさんが出発する前、「50年の約束」と箱のことを教えてもらっていませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020136
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020136,
					"content": "うん！それなら知ってるよ！お姉ちゃんはあの箱を取りに来たんだね！探すから、ちょっと待ってて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020137
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 105020137,
					"content": "これじゃない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020138
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 105020138,
					"content": "これも違う…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020139
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 105020139,
					"content": "違う違う、これも違う…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020140
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 105020140,
					"content": "あっ！思い出した！クレーの新しい宝物と一緒に<color=#00E1FFFF>風立ちの地</color>に隠したんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020141,
						105020142
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 105020141,
					"content": "まさか爆弾じゃないよね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020143
					]
				},
				{
					"id": 105020143,
					"content": "取ってくるから、ちょっと待っててね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020144
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 105020144,
					"content": "おいおい！カバンは置きっぱなしでいいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020145
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 105020145,
					"content": "私が片付けるから、あなたたちはあの子を追ってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020146
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020146,
					"content": "はぁ、あの子そそっかしいですね。箱は大丈夫でしょうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020142,
					"content": "どうしていつも大事な物を外に隠すの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020143
					]
				},
				{
					"id": 105020126,
					"content": "だから、絶対違うって…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020127
					]
				},
				{
					"id": 105020119,
					"content": "絶対に違うと思う！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020120
					]
				},
				{
					"id": 105020113,
					"content": "まだよく見れてないのに！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020114
					]
				},
				{
					"id": 105020103,
					"content": "占星術はできないよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020104
					]
				}
			]
		},
		{
			"id": 1050202,
			"completionStepIds": [
				1050204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1050204",
							"2"
						],
						"stepId": 1050204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"クレー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105020201,
					"content": "ついたついた、ここだよ。宝物を掘り出そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020202,
						105020203
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 105020202,
					"content": "それはきっと草スライムだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020204
					]
				},
				{
					"id": 105020204,
					"content": "そんなことないよ！クレーは印をつけておいたから、間違えたりしないよ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020205
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 105020205,
					"content": "わっ、草スライム！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020206
