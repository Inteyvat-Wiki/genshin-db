	"talks": [
		{
			"id": 1050201,
			"completionStepIds": [
				1050202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
