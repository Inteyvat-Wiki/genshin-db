			"dialogs": [
				{
					"id": 105020301,
					"content": "あったあった、この箱だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020302
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 105020302,
					"content": "爆発に巻き込まれなくてよかったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 105020303,
					"content": "回収完了！あのお姉ちゃんに返そう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "クレー"
