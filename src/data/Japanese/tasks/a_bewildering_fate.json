				"objectNames": [
					"モナ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105020601,
					"content": "この封印を施した人物は…只者じゃありません、強行突破はほぼ不可能ですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020602
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020602,
					"content": "ですが！だからこそ面白いです、私の占星術の知識を使うに値します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020603
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020603,
					"content": "どれどれ～、ふむふむ…なるほど、これがこうなって、それから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020604
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020604,
					"content": "よしっ、開きました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020605
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020605,
					"content": "おお、すごいな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020606
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 105020606,
					"content": "あとはキャサリンに報告すれば、ここに泊まらせてもらえると思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020607
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 105020607,
					"content": "その必要はないぞ。礼を言わせてくれ、ありがとう君たち。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020608
					],
					"speakerTitle": "ゲーテ"
				},
				{
					"id": 105020608,
					"content": "このお方は…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020609
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020609,
					"content": "ああ、私がこの部屋の所有者のゲーテだ。先ほど冒険者協会の前を通った時に、キャサリンから君たちのことを聞いてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020610
					],
					"speakerTitle": "ゲーテ"
				},
				{
					"id": 105020610,
					"content": "まさかこんなに早く、この厄介な封印を解いてくれるとは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020611
					],
					"speakerTitle": "ゲーテ"
				},
				{
					"id": 105020611,
					"content": "それってつまり、ここに泊まっていいってことですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020612
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020612,
					"content": "ああ、もちろんだ。どうせ今までずっと放置していたんだし、誰かの役に立つならむしろ嬉しいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020613
					],
					"speakerTitle": "ゲーテ"
				},
				{
					"id": 105020613,
					"content": "お礼として、この部屋を格安で君に貸そう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020614
					],
					"speakerTitle": "ゲーテ"
				},
				{
					"id": 105020614,
					"content": "か、貸す！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020615
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020615,
					"content": "賃貸だなんて聞いていません、それに私は協力してあげたのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020616
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020616,
					"content": "協力？ああ、もちろん分かっている。君には本当に感謝しているさ、だからこその特別価格だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020617
					],
					"speakerTitle": "ゲーテ"
				},
				{
					"id": 105020617,
					"content": "わ、私が言いたいのはですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020618
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020618,
					"content": "モナは誤解してたみたいだな、でも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020619,
						105020620
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 105020619,
					"content": "これが一番いい選択かもしれない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020621
					]
				},
				{
					"id": 105020621,
					"content": "はあ…仕方ないです、この部屋を借ります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020622
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020622,
					"content": "よしっ！決まりだ。手続きの準備をしてくるから、ここで少し待っていてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020623
					],
					"speakerTitle": "ゲーテ"
				},
				{
					"id": 105020623,
					"content": "今回はありがとうございました。それと…ごめんなさい、あなたとの約束、しばらく叶いそうにありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020624
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020624,
					"content": "占星術用の設備も、新たな知識も得られなかった私では、あなたの「運命」を見るのにもう少し時間が必要です…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020625
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020625,
					"content": "でも約束します。準備が整ったら、真っ先にあなたのことを占ってあげますから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020626,
						105020628
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020626,
					"content": "メリットしかない旅だった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020627
					]
				},
				{
					"id": 105020627,
					"content": "ありがとうございます。あなたと旅を共にできたのは私の運命——それも「良い運命」だったのかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020630
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020630,
					"content": "あなたたちの冒険が上手くいくことを願っていますね！私も…これからのことを考えようと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020631
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020631,
					"content": "占星術を金儲けに使わないとなると、どうやって生きていくんだろうな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020632
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 105020632,
					"content": "…やっぱ、たまに彼女の安否を確認しに行った方がいいよな？空腹で倒れてたらまずいし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 105020628,
					"content": "とりあえず頑張って生きて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020629
					]
				},
				{
					"id": 105020629,
					"content": "はい…この先どうすればいいか分かりませんが…頑張ってみます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020630
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105020620,
					"content": "モラを稼げる方法はたくさんある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020621
					]
				}
			]
		},
