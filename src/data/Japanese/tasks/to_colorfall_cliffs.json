			},
			"dialogs": [
				{
					"id": 150400301,
					"content": "わぁ、すごい！「海の花園」がやっとそれっぽくなったよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400302
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150400302,
					"content": "みんな、お疲れさまだぞ！あとはあのスタッフに声をかければいいんだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150400303,
					"content": "皆さま…はぁ、はぁ…お待ちを…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400304
					],
					"speakerTitle": "ティクラック"
				},
				{
					"id": 150400304,
					"content": "噂をすればだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150400305,
					"content": "大丈夫だから、ゆっくり話してくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400306
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150400306,
					"content": "はぁ…はい！私はカラフル崖のメインアトラクション「ふわふわ風乗りアシャ」の担当スタッフです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400307
					],
					"speakerTitle": "ティクラック"
				},
				{
					"id": 150400307,
					"content": "さっきまで高いところにいたんですが、ここの草原が急に花の海になったのが見えたんです！すっごく芸術的で…びっくりして望遠鏡を落とすところでした！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400308
					],
					"speakerTitle": "ティクラック"
				},
				{
					"id": 150400308,
					"content": "皆さんは…カラフル崖の救世主です！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400309
					],
					"speakerTitle": "ティクラック"
				},
				{
					"id": 150400309,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400310
					],
					"speakerTitle": "アシャ"
				},
				{
					"id": 150400310,
					"content": "お安い御用だぜ。へへっ、やったのはほとんどあの二人だけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150400311,
					"content": "お二人とも、よかったらうちのアトラクションを楽しんでいかれませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400312
					],
					"speakerTitle": "ティクラック"
				},
				{
					"id": 150400312,
					"content": "というより——ここのランドマークに色を塗っていただけませんか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400313
					],
					"speakerTitle": "ティクラック"
				},
				{
					"id": 150400313,
					"content": "ええ、すごそうだな…ほんとにいいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400314
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150400314,
					"content": "もちろん、きっと…いえ、絶対大丈夫です！むしろ…お願いですから引き受けてください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400315
					],
					"speakerTitle": "ティクラック"
				},
				{
					"id": 150400315,
					"content": "同僚がお世話になったんですし、代わってお礼させていただきたいんです！この体験は報酬よりも貴重だと思いますよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400316
					],
					"speakerTitle": "ティクラック"
				},
				{
					"id": 150400316,
					"content": "でも、やっぱり…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400317
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150400317,
					"content": "もちろん引き受けるぜ！へへっ、どうやって行けばいいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400318
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150400318,
					"content": "ついてきてください。熱気球に乗っていきますよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ティクラック"
				}
			]
		},
