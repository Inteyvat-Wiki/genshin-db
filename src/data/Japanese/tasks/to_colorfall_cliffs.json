				},
				{
					"id": 150400704,
					"content": "もちろんです。山に遮られていない開けた場所なら、ひゅうひゅう丘の屋上プールからでも、ティティ島の海岸からでも見えますよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400705
					],
					"speakerTitle": "ティクラック"
				},
				{
					"id": 150400705,
					"content": "二人とも、いい感じに仕上げてね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400706
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150400706,
					"content": "わぁ…テンション上がってきたぜ。どんな色にしようかな…オレのラッキーカラーか、それとも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400707
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150400707,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400708
					],
					"speakerTitle": "アシャ"
				},
				{
					"id": 150400708,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400709
					],
					"speakerTitle": "アシャ"
				},
				{
					"id": 150400709,
					"content": "～♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400710
					],
					"speakerTitle": "アシャ"
				},
				{
					"id": 150400710,
					"content": "えーと、けっこう長い文章だったみたいだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400711
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150400711,
					"content": "チャスカ、見てたよな？また通訳してくれよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400712
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150400712,
					"content": "うーん…情報量が多すぎる。どれくらいの可能性があるのか、計算しないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400713
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150400713,
					"content": "オレ、たぶんわかったぜ。アシャはオレと同じチームに入って、旅人とバトルしたいって言ってるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400714
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150400714,
					"content": "仲間と協力して、困ってる人を助けるのは好きだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400715
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150400715,
					"content": "勝ち負けのある挑戦こそ平凡なイベントをワクワクする冒険に変えるから、その刺激を楽しみたいんだってさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400716
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150400716,
					"content": "そ、そこまでたくさん喋ってたか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400717
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150400717,
					"content": "ははっ、たぶんな！オレの解釈も入ってるけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400718
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150400718,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400719
					],
					"speakerTitle": "アシャ"
				},
				{
					"id": 150400719,
					"content": "この反応、あってるみたいだね。どんどん仲良くなってるじゃん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400720
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150400720,
					"content": "まぁまぁ、アシャ。オレも同じ気持ちだけど…旅人にオレたちの考えを押し付けるわけにはいかないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400721
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150400721,
					"content": "友達の気持ちと意見は尊重しないとだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400722
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150400722,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400723,
						150400726,
						150400729
					],
					"speakerTitle": "アシャ"
				},
				{
					"id": 150400723,
					"content": "ずっと団長に挑んでみたかったんだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400724
					]
				},
				{
					"id": 150400724,
					"content": "上等だ！受けて立つ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400725
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150400725,
					"content": "なんてな…お前のその顔を見たら、自信満々に言えないぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400732
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150400732,
					"content": "両チーム、準備はできましたか？それではこちらへ！私が審判を務めますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ティクラック"
				},
				{
					"id": 150400726,
					"content": "ベネットとアシャが楽しければいい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400727
					]
				},
				{
					"id": 150400727,
					"content": "いや、オレたちだけが楽しむのはダメだ！オレは旅人にも楽しんでほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400728
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150400728,
					"content": "行くぞ！肩の力は抜いていこうぜ。楽しむのが一番だからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400732
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150400729,
					"content": "五人同時にかかってきたって負けないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400730
					]
				},
				{
					"id": 150400730,
					"content": "自信満々だな！よーし、オレも全力で行くぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400731
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150400731,
					"content": "おい！オイラはずっとおまえの味方だっただろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400732
					],
					"speakerTitle": "パイモン"
				}
			]
