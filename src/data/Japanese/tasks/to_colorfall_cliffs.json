			"dialogs": [
				{
					"id": 150400601,
					"content": "はぁー！いい試合だった！相手してくれてありがとうな。おかげでオレもアシャも思いっきり楽しめたぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400602,
						150400603,
						150400604
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150400602,
					"content": "互角だったね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400606
					]
				},
				{
					"id": 150400606,
					"content": "お疲れさま～！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400607
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150400607,
					"content": "旅人さん、おめでとうございます。恩人さんとアシャも、素晴らしいチームワークでしたね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400608
					],
					"speakerTitle": "ティクラック"
				},
				{
					"id": 150400608,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400609
					],
					"speakerTitle": "アシャ"
				},
				{
					"id": 150400609,
					"content": "実を言うと、最初は本当にアシャたちの言葉を解読できるなんて信じてなかったんですが…この試合を通して思い知りましたよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400610
					],
					"speakerTitle": "ティクラック"
				},
				{
					"id": 150400610,
					"content": "あたしもあたしも！手に汗握っちゃった。「帰火聖夜の巡礼」の決勝戦を観戦してるみたいだったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400611
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150400611,
					"content": "同感だ。試合が白熱した時には、私も何発か撃ちたくなってしまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400612
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150400612,
					"content": "チャスカの弾って、色塗れるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400613
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150400613,
					"content": "塗れるものもあるが、何色になるかは保証できない。それに、私の銃じゃ「ひゅるひゅる墜落アシャ」と化していただろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400614
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150400614,
					"content": "えっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400615
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150400615,
					"content": "ふふっ、これで「ふわふわ風乗りアシャ」の完成まであと一歩ですね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400616
					],
					"speakerTitle": "ティクラック"
				},
				{
					"id": 150400616,
					"content": "それではお二人とも、光を灯してください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400617
					],
					"speakerTitle": "ティクラック"
				},
				{
					"id": 150400617,
					"content": "（幻写霊を灯すシーン）",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150400618
					]
				},
				{
					"id": 150400618,
					"content": "素敵だったでしょう？オススメの写真スポットがあるので、ご紹介しますよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ティクラック"
				},
				{
					"id": 150400603,
					"content": "すごい連携だったね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400606
					]
				},
				{
					"id": 150400604,
					"content": "パイモンに手伝ってもらえばよかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400605
					]
				},
				{
					"id": 150400605,
					"content": "今更オイラのことを思い出しても遅いんだからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400606
					],
					"speakerTitle": "パイモン"
				}
			]
