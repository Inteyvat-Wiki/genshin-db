			"dialogs": [
				{
					"id": 150400101,
					"content": "着いた！ここが地図にあった「海の花園」だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400102
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150400102,
					"content": "す、すっごい…緑だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150400103,
					"content": "花園というより「草園」だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400104
					]
				},
				{
					"id": 150400104,
					"content": "へへっ、想像とは確かに違ったけど…よくあることだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400105
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150400105,
					"content": "実際の観光スポットが宣伝と違うってことだよね。これはさすがにクレームレベルなんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400106
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150400106,
					"content": "あたしがクレームを入れなかったら、あたしにお客さんからクレームが入っちゃうよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400107
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150400107,
					"content": "あ、いや、オレの言い方が悪かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400108
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150400108,
					"content": "実際の現実とオレの想像はよくズレる、って言いたかったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400109
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150400109,
					"content": "それって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150400110,
					"content": "ああ、例えば山頂に登って景色を眺めようとしたら、突然濃霧が立ち込めて、山を下りる道すら見えなくなったり…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400111
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150400111,
					"content": "テントに戻ったら、中に炎スライムが入りこんでて、オレが集めた木材をいつの間にか全部燃やしてたり…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400112
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150400112,
					"content": "なんだか、かわいそう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400113
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150400113,
					"content": "もう慣れっこだ。これも全部旅を彩るスパイスだからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400114
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150400114,
					"content": "この辺りは広くて…うん、空気も綺麗だし、魔物もいない…これで十分ラッキーさ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400115
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150400115,
					"content": "一番ラッキーなのは、お前がそういう心構えを持ち続けられるやつだってことだと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400116
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150400116,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400117
					],
					"speakerTitle": "アシャ"
				},
				{
					"id": 150400117,
					"content": "おっ、アシャが何か見つけたみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400118
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150400118,
					"content": "鳴き声でわかるのかよ！短期間で打ち解けすぎだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150400119,
					"content": "（読み物を読んだ…）",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150400120
					]
				},
				{
					"id": 150400120,
					"content": "これがいわゆる「ライバル」か…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150400121,
					"content": "人間なら話せばわかるかもしれないが、片方がアシャだとな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400122
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150400122,
					"content": "よし、助けてやろうぜ！アシャ、準備はいいか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400123
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150400123,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400124
					],
					"speakerTitle": "アシャ"
				},
				{
					"id": 150400124,
					"content": "え？オイラ、なにか聞き逃したか？なんでいきなりやる気満々なんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150400125,
					"content": "だって、アシャたちの得意なことは「ペイント」だろ？見ればわかるさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400126
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150400126,
					"content": "そうだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150400127,
					"content": "それに、アシャの心は単純だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400128
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150400128,
					"content": "スタッフに迷惑をかけようと思ったわけじゃなくて、ただこの何の変哲もない草原が嫌だったんだと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400129
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150400129,
					"content": "それに、二人は意思の疎通がうまくいってなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400130
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150400130,
					"content": "ああ。オレたちが草原を綺麗な色にペイントして、みんなが「花園」に持つイメージと合わせれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400131
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150400131,
					"content": "アーティストのアシャが認めてくれて、スタッフの悩みも解決できるかも！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400132
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150400132,
					"content": "そう！そういうことだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400133
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150400133,
					"content": "いい考えだな。「調停者」の素質がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400134
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150400134,
					"content": "#{M#俺}{F#私}もやる！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400135
					]
				},
				{
					"id": 150400135,
					"content": "～♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400136
					],
					"speakerTitle": "アシャ"
				},
				{
					"id": 150400136,
					"content": "ははっ、くすぐったいぞ。やめろって…ん、どうした？遠くに行くのか？それならみんなに一言伝えないと——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400137
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150400137,
					"content": "おーい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400138
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150400138,
					"content": "なぁ、「通訳」さん。なに言ってるかわかるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400139
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150400139,
					"content": "「運びたいものがある」か、「助けが必要な人が近くにいる」だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400140
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150400140,
					"content": "その二つ、全然違うけど…って、なんでわかるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400141
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150400141,
					"content": "うん…見てたら、竜と似たボディーランゲージを使ってることに気づいた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400142
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150400142,
					"content": "えっ…それほんと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400143
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150400143,
					"content": "うちの「母さん」は、翼を上げることで「今日は早めの夕飯にするからさっさと帰ってきなさい」と「お前、わかってるだろうな」の全く違う二つを表現する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400144
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150400144,
					"content": "それってどうやって見分けてるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400145
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150400145,
					"content": "子供のころは見分けられなくて、早めに帰った結果お仕置きされてた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400146
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150400146,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400147
					],
					"speakerTitle": "アシャ"
				},
				{
					"id": 150400147,
					"content": "頑丈で速い…これがナタの熱気球か！すごいぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400148
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150400148,
					"content": "みんな、戻ったぞ——！上を見てくれ——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ベネット"
				}
			]
		},
