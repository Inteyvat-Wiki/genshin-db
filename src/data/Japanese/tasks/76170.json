			},
			"dialogs": [
				{
					"id": 761700101,
					"content": "月蛍だけじゃなく、子猫まで食べられちゃうのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700102
					],
					"speakerTitle": "ミッコ"
				},
				{
					"id": 761700102,
					"content": "うぅ…ユルヴァお兄ちゃん、今度パブロフを散歩に連れていくときは、しっかり守ってあげてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700174
					],
					"speakerTitle": "メイジー"
				},
				{
					"id": 761700174,
					"content": "心配ないさ、パブロフは子猫よりずっと大きいんだよ。それに、所詮植物なんだから大丈夫だって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700103
					],
					"speakerTitle": "ユルヴァ"
				},
				{
					"id": 761700103,
					"content": "確か、ある新人の冒険者も十六倍マンドラゴラに出くわす前は同じようなことを言ってたっけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700104
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761700104,
					"content": "えっ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700105
					],
					"speakerTitle": "ユルヴァ"
				},
				{
					"id": 761700105,
					"content": "十六倍マンドラゴラ…かっけー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700106
					],
					"speakerTitle": "ミッコ"
				},
				{
					"id": 761700106,
					"content": "やっふぅ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700107
					],
					"speakerTitle": "ルミ"
				},
				{
					"id": 761700107,
					"content": "遠くからでもにぎやかにしてるのが分かったぞ！どんな面白い話を…って、授業中か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761700108,
					"content": "うん、リンネアお姉ちゃんが最近の調査で発見したことを教えてくれてるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700109
					],
					"speakerTitle": "メイジー"
				},
				{
					"id": 761700109,
					"content": "#面白そうだね、{M#俺}{F#私}たちも参加していい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761700110
					]
				},
				{
					"id": 761700110,
					"content": "もちろんです。どうぞお座りください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700111
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761700111,
					"content": "そうそう、十六倍マンドラゴラだけじゃなく、海を望めぬ峰にはもう一つ代表的な植物が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700112
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761700112,
					"content": "ヴィンテル草だよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700113
					],
					"speakerTitle": "ユルヴァ"
				},
				{
					"id": 761700113,
					"content": "ピンポーン！その通り、ヴィンテル草だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700114
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761700114,
					"content": "あーっ、ずりいぞ！リンネアがまだ最後まで言い切ってないのに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700115
					],
					"speakerTitle": "ミッコ"
				},
				{
					"id": 761700115,
					"content": "あ…悪い悪い。つい、な。まだまだ答えるチャンスはあるから、焦るなって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700116
					],
					"speakerTitle": "ユルヴァ"
				},
				{
					"id": 761700116,
					"content": "問題はたくさん用意してきてるから安心して！積極的に答えた人には、飴細工をプレゼントするからね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700117
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761700117,
					"content": "へえ、ご褒美があるのか！旅人、オイラたちも頑張ろうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700118,
						761700119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761700118,
					"content": "相手が子供でも手加減はしないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761700122
					]
				},
				{
					"id": 761700122,
					"content": "話を戻すね。実はヴィンテル草には、とても面白い話があるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700123
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761700123,
					"content": "伝説によれば、ヴィンテル草は「ヴィンテル王」に関係があるんだって。で、彼には兄弟がいて、その兄弟の象徴となる植物はみんなもよく知ってるはずだけど…何だと思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700124,
						761700127,
						761700130
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761700124,
					"content": "…スイートフラワー？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761700125
					]
				},
				{
					"id": 761700125,
					"content": "確かによく知ってる植物だな！でも、それはないんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761700126,
					"content": "ブッブー！正解は「ソマルの実」でした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700132
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761700132,
					"content": "ソマルの実かあ！まあ、カーチャとアイノが作るソマルケーキがめちゃくちゃ美味しいってことしか知らないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700133
					],
					"speakerTitle": "ミッコ"
				},
				{
					"id": 761700133,
					"content": "ソマルの実は「ヴィンテル王」の兄弟、「ソマル王」の象徴なの。この双子の兄弟は、生まれた時から争い続けてたって伝説があってね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700134
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761700134,
					"content": "彼らは交互に相手を殺し、また交互に蘇っては、それぞれの季節を支配する…その循環は、世界の終わりまで続くと言われてるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700135
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761700135,
					"content": "かわいそう…血のつながった兄弟なのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700136
					],
					"speakerTitle": "メイジー"
				},
				{
					"id": 761700136,
					"content": "それ、カーチャが話してるのを聞いたことあるな。仲がいいかどうかは関係なくて、むしろ血がつながってるからこそ争いが起きることもあるんだ、って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700137
					],
					"speakerTitle": "ミッコ"
				},
				{
					"id": 761700137,
					"content": "つまり、移ろう季節についての物語だよね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761700138
					]
				},
				{
					"id": 761700138,
					"content": "鋭いですね！その通りです。スネージナヤの学者たちもそのように考えてるんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700139
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761700139,
					"content": "でも、ヴィンテル草は寒さに強いという特性から、この物語以外にも、ライトキーパーの象徴として扱われることが多いんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700140
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761700140,
					"content": "「花散れども…」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761700141
					]
				},
				{
					"id": 761700141,
					"content": "「葉は約束を守る」！前に聞いたことがあるぜ、ヴィンテル草のことわざだよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700142
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761700142,
					"content": "それ、とても古いことわざなんですよ。今では口にする人も少なくなりましたが…まさかそんなことまで知ってるとは！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700143
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761700143,
					"content": "へへっ、オイラたちは一流の冒険者だからな。いわゆる…「見聞が広い」ってやつだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700144
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761700144,
					"content": "ライトキーパーって、あの黒い服を着てる人たちのことだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700145
					],
					"speakerTitle": "ミッコ"
				},
				{
					"id": 761700145,
					"content": "あの人たちも寒さに強いのか？でも、あの服は暖かそうに見えるけどな…薄着じゃないと説得力がないんじゃねーのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700146
					],
					"speakerTitle": "ミッコ"
				},
				{
					"id": 761700146,
					"content": "そうじゃなくて、ライトキーパーはヴィンテル草みたいに、寒い風のような困難にも屈してないって意味じゃないかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700147
					],
					"speakerTitle": "メイジー"
				},
				{
					"id": 761700147,
					"content": "あっ！その通りだよ。でも、どうしてメイジーはそんな風に思ったの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700148
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761700148,
					"content": "えへへ、前にヘルカがフォンテーヌから送ってくれた画集に、フォンテーヌの花には花言葉があるって書いてあってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700149
					],
					"speakerTitle": "メイジー"
				},
				{
					"id": 761700149,
					"content": "ヴィンテル草にも花言葉があるとしたら、「不屈」と「最後まで諦めない勇気」がぴったりだと思ったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700150
					],
					"speakerTitle": "メイジー"
				},
				{
					"id": 761700150,
					"content": "メイジーったら、すっかり応用力が身についてるんだね。すごいよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700151
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761700151,
					"content": "ミッコの考え方はユニークで、とても面白いね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700152
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761700152,
					"content": "#先生、先生！{M#俺}{F#私}とパイモンはどう？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761700153
					]
				},
				{
					"id": 761700153,
					"content": "うーん、もしお二人が次に出す難問に答えられるなら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700154
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761700154,
					"content": "なんでも聞いてくれよ！こいつなら絶対に解けるはずだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700155
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761700155,
					"content": "自信満々ですね。では、とっておきの問題を出しましょう。宿影花の花の色は、なぜ赤と青なのでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700156,
						761700158
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761700156,
					"content": "「バラは赤く、スミレは青い」だから…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761700157
					]
				},
				{
					"id": 761700157,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700160
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761700160,
					"content": "うーん…なんでだろうな？宿影花以外にも、ナド・クライで赤いものと青いものを見かけたよな？今思えば、結構たくさんあった気がするぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700161
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761700161,
					"content": "ここと他の国で違うところがあるとすれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700162
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761700162,
					"content": "不思議なクーヴァキの力だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761700163
					]
				},
				{
					"id": 761700163,
					"content": "おい、なんでもかんでもクーヴァキを理由にするなよな。とっておきの難問なんだから、もっと複雑な理由があるはずだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700164
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761700164,
					"content": "ピンポーン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700165
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761700165,
					"content": "や！ほ～ぅ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700166
					],
					"speakerTitle": "ルミ"
				},
				{
					"id": 761700166,
					"content": "本当にそうだったのかよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700167
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761700167,
					"content": "ナド・クライの人にとっては当たり前のことでも、遠くからやってきた冒険者にとってはそうではありませんから、難問と言えるかもしれませんね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700168
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761700168,
					"content": "ですが、よく問題のうわべに惑わされることなく真相を見抜きましたね。まさしく冒険者に向いてます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700169
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761700169,
					"content": "さて、今日の問題はこれで終わり。答えてくれたみんなには飴細工をプレゼントするよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700170
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761700170,
					"content": "えぇ？ちょっと待ってくれよ、オイラだけもらえないのか！不正解でも、なにか答えとけばよかったな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700171
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761700171,
					"content": "安心してください、パイモンの分もありますよ！君と旅人はチームで、私とルミのようなものですからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700172
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761700172,
					"content": "よかったね、パイモン。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761700173
					]
				},
				{
					"id": 761700173,
					"content": "わぁ、リンネア先生、最高だぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761700158,
					"content": "人工栽培された品種なのかな？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761700159
					]
				},
				{
					"id": 761700159,
					"content": "いい着眼点ですね！ですが残念、それは正解ではありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700160
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761700127,
					"content": "きっとミントだよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761700128
					]
				},
				{
					"id": 761700128,
					"content": "ミントとヴィンテル草、どっちも緑色だしな！ん…？それだと、キャベツもヴィンテル草の仲間ってことになるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700129
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761700129,
					"content": "ブッブー！正解は「ソマルの実」でした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700132
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761700130,
					"content": "もしかしてソマルの実かな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761700131
					]
				},
				{
					"id": 761700131,
					"content": "ピンポーン！正解です！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700132
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761700119,
					"content": "子供から飴細工を奪うなんて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761700120
					]
				},
				{
					"id": 761700120,
					"content": "大丈夫ですよ。内緒ですけど、カーチャさんは全員分の飴細工を用意してくれてますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700121
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761700121,
					"content": "おおっ！だったら、オイラたちも本気で答えないとな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700122
					],
					"speakerTitle": "パイモン"
				}
			]
		},
