			"dialogs": [
				{
					"id": 751790901,
					"content": "イ、イザホ、リストの残りがまだこんなにあるんだ。き、君も一緒に探してくれよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790902
					],
					"speakerTitle": "マソス"
				},
				{
					"id": 751790902,
					"content": "はぁ…無駄なことはやめとけよ。オレも確認したけど、積み荷の大半が壊れやすい物だったんだ、ひっくり返ったうえに火山まで噴火してるのに、残ってるわけないだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790903
					],
					"speakerTitle": "イザホ"
				},
				{
					"id": 751790903,
					"content": "しっかり休んで体力を温存しとけよ。姉貴たちが戻ったら出発だ。まだまだ道のりは長いんだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790904
					],
					"speakerTitle": "イザホ"
				},
				{
					"id": 751790904,
					"content": "だ、ダメだ！い、いいよ、君が行かないなら僕が行く…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マソス"
				}
			]
		},
