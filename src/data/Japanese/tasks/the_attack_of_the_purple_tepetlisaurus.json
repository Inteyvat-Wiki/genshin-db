				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2893.348,
							257.691,
							9926.251
						],
						"pointId": 10703
					},
					{
						"sceneId": 3,
						"position": [
							-2892.566,
							257.855,
							9924.833
						],
						"pointId": 10710
					},
					{
						"sceneId": 3,
						"position": [
							-2892.844,
							257.694,
							9921.14
						],
						"pointId": 10983
					}
				]
			},
			"dialogs": [
				{
					"id": 751790101,
					"content": "おい！や、やめろ！これは僕たちのものだ！動くな！ぼ、僕は「夜巡者の戦争」に参加できるほどの実力を持ってるんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790102
					],
					"speakerTitle": "マソス"
				},
				{
					"id": 751790102,
					"content": "も、もし僕たちのものを奪おうとするなら、ただじゃおかないからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790103
					],
					"speakerTitle": "マソス"
				},
				{
					"id": 751790103,
					"content": "はぁ…今日はなんだってんだよ？火山は噴火するし、紫色のテペトル竜まで…まったく、極めつけに追い剥ぎまでやってくるなんて、本当についてねぇな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790104
					],
					"speakerTitle": "イザホ"
				},
				{
					"id": 751790104,
					"content": "マソス、この人結構強そうだし、勝てそうにないって。やめとこうぜ…それに、その場で試合を観てただけで、出場したわけじゃないだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790105
					],
					"speakerTitle": "イザホ"
				},
				{
					"id": 751790105,
					"content": "イザホ、き、君ってやつは！そんなのダメだ、これはみんなのものなんだぞ！そ、それに、僕たちが二人でかかれば、一人くらいなら勝てるかもしれないじゃないか…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790106
					],
					"speakerTitle": "マソス"
				},
				{
					"id": 751790106,
					"content": "二人でやるなんて誰が言ったよ？殴られたいんなら一人で行けって。勝手にオレまで巻き込むなよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790107
					],
					"speakerTitle": "イザホ"
				},
				{
					"id": 751790107,
					"content": "#{M#兄さん}{F#姉さん}、これいらねぇから、欲しけりゃやるよ。その代わり、さっきの無礼は大目に見てくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790108,
						751790109
					],
					"speakerTitle": "イザホ"
				},
				{
					"id": 751790108,
					"content": "たぶん何か誤解してる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790111
					]
				},
				{
					"id": 751790111,
					"content": "誤解だぞ！オイラたちは困ってる人を助ける、いい冒険者なんだ。怪しい悪者なんかじゃないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751790112,
					"content": "ぼ、僕がどうして君たちを信じなきゃいけないんだ！い、痛っ！イザホ、どうして僕を殴るんだ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790113
					],
					"speakerTitle": "マソス"
				},
				{
					"id": 751790113,
					"content": "向こうにその気があったとっくにやられてるっての。それに、こんなとこで無駄口叩く必要なんかねぇしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790114
					],
					"speakerTitle": "イザホ"
				},
				{
					"id": 751790114,
					"content": "実は、オレたちのキャラバンがついさっきバラバラにされちまったんだ。お前たちが冒険者なら、ボスに伝えてくれねぇか？オレたちがここで待ってるって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790115
					],
					"speakerTitle": "イザホ"
				},
				{
					"id": 751790115,
					"content": "箱の中の物は、そのお礼だと思って受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790116
					],
					"speakerTitle": "イザホ"
				},
				{
					"id": 751790116,
					"content": "そんなの楽勝だぜ。オイラたちに任せろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751790109,
					"content": "話が早くて助かるよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790110
					]
				},
				{
					"id": 751790110,
					"content": "おい！なんだよその言い方！オイラたちが悪者みたいになっちゃうだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790111
					],
					"speakerTitle": "パイモン"
				}
			]
		},
