			"dialogs": [
				{
					"id": 751790401,
					"content": "おい！きみ、そう、きみのことだ！外は危険だ、早く中へ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790402
					],
					"speakerTitle": "ティズロ"
				},
				{
					"id": 751790402,
					"content": "まったく…道中ひどい有様だったのを見てなかったのか？火山が噴火しているうえに、魔物が道を塞いでいるんだ。こんな状況で先に進むのは無謀すぎる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790403
					],
					"speakerTitle": "ティズロ"
				},
				{
					"id": 751790403,
					"content": "いいか、よく聞くんだ。ここで少しの間待って、うちのキャラバンと一緒に行動したほうがいい。そうすればお互いに助け合えるからな。とにかく、ひとりで進むのはあまりにも危険だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790404,
						751790408
					],
					"speakerTitle": "ティズロ"
				},
				{
					"id": 751790404,
					"content": "魔物？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790405
					]
				},
				{
					"id": 751790405,
					"content": "テペトル竜の群れだ、それも異常に強い力をもってる！きっとアビスに汚染されたんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790406
					],
					"speakerTitle": "ティズロ"
				},
				{
					"id": 751790406,
					"content": "尻尾を軽く振っただけでオレたちの荷車をバラバラにしたんだ。あれは間違いなくライノ竜をも凌ぐ力さ…普通の人間がどうにかできる相手じゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790407
					],
					"speakerTitle": "ティズロ"
				},
				{
					"id": 751790407,
					"content": "忠告しておく。絶対にあいつらと戦おうとするなよ。もし遭遇しても、できるだけ距離を取って避けるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ティズロ"
				},
				{
					"id": 751790408,
					"content": "#大丈夫、{M#俺}{F#私}なら倒せるから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790409
					]
				},
				{
					"id": 751790409,
					"content": "…はぁ、分かったよ。くれぐれも気をつけるんだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ティズロ"
				}
			]
		},
