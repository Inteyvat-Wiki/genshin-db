					"nextDialogs": [
						751790202,
						751790204
					],
					"speakerTitle": "ザッシュ"
				},
				{
					"id": 751790202,
					"content": "大丈夫？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790203
					]
				},
				{
					"id": 751790203,
					"content": "だ、大丈夫だ。ちょっと走りすぎて、心臓がバクバクしてるだけ。少し休めば平気だから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ザッシュ"
				},
				{
					"id": 751790204,
					"content": "ゆっくり休んで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790205
					]
				},
				{
					"id": 751790205,
					"content": "おう…あ、ありがとな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ザッシュ"
				}
			]
		},
