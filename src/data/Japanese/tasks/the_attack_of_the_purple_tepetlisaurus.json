			},
			"dialogs": [
				{
					"id": 751790301,
					"content": "当たり前だ。これっぽっちじゃ、命の恩人への礼としてはショボすぎるだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790302,
						751790303
					],
					"speakerTitle": "イザヤ"
				},
				{
					"id": 751790302,
					"content": "確かにちょっと足りない気もする。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790304
					]
				},
				{
					"id": 751790304,
					"content": "はははっ、あんたみたいな裏表のない人、あたしは好きだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790306
					],
					"speakerTitle": "イザヤ"
				},
				{
					"id": 751790306,
					"content": "ゴホン、とにかく、これはあたし個人からの感謝の気持ちだ。まとめて受け取っとくれ！これでテペトル仔竜に飯でも買ってやったらいいさ。遠慮はいらないよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790307
					],
					"speakerTitle": "イザヤ"
				},
				{
					"id": 751790307,
					"content": "キュイッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790308
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751790308,
					"content": "さてと、あたしたちは落としてきたもんを拾いに行くとするかね。それじゃ、縁があったらまた会おう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イザヤ"
				},
				{
					"id": 751790303,
					"content": "これで十分だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790305
					]
				},
				{
					"id": 751790305,
					"content": "チッ、素直になりなよ、つまらない。それに、貰えるもんは貰っとくもんだ！じゃないとあたしがケチだなんて言われちまうだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790306
					],
					"speakerTitle": "イザヤ"
				}
			]
		},
