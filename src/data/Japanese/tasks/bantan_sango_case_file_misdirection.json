				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"龍二"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220350204,
					"content": "今回は十分大きい騒ぎにすることが出来ました。天野さんと安藤さんにも協力してもらったので、あの犯人の耳にもきっと届きます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350205
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220350205,
					"content": "あとどれくらい時間がかかるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220350206
					]
				},
				{
					"id": 220350206,
					"content": "もうすぐです。所長の準備が整い次第、この事件に終止符を打つことができます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350207
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220350207,
					"content": "旅人、報酬を受け取ってください。ご協力ありがとうございました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350208
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220350208,
					"content": "これは所長自ら指定した報酬ですので、適切な内容だと思います。どうぞお受け取りください、今度もまたお願いするかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龍二"
				}
			]
		},
