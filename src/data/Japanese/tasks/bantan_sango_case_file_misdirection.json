	"talks": [
		{
			"id": 2203501,
			"completionStepIds": [
				2203501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2203501",
							"2"
						],
						"stepId": 2203501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"龍二"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220350101,
					"content": "旅人、またお会いしましたね。前回のご協力のおかげで、所長は既に犯人を特定しています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350102
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220350102,
					"content": "しかし、その犯人に法的な裁きを与えるためには、もう少し準備が必要です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350103
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220350103,
					"content": "所長は他の処理をしていますので、私たちは前回の続きをしましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350104,
						220350107
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220350104,
					"content": "また宝盗団を探すの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220350105
					]
				},
				{
					"id": 220350105,
					"content": "その通りです。我々が相手にする宝盗団は犯人と関係ないかもしれませんが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350106
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220350106,
					"content": "しかし、どうせその宝盗団たちも普段から悪さをしているのです。今回も引き続き、彼らに「協力」してもらいましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350112
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220350112,
					"content": "拠点は所長が記載してくれています。町からそう離れてはいません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350113
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220350113,
					"content": "城内には…既に所長が、天野さんと安藤さんに協力してくれるよう説明しています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350114
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220350114,
					"content": "そして…事件を解決したら、功績はすべて彼らに譲ると所長が約束しました。これで彼らもきっと、喜んで協力してくれるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350115
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220350115,
					"content": "計画は所長に任せておきました。私たちは引き続き、宝盗団と「交流」しに行きましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350116
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220350116,
					"content": "場所はあなたの地図に記しました。では、出発しましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龍二"
				},
				{
					"id": 220350107,
					"content": "犯人を騙し続けるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220350108
					]
				},
				{
					"id": 220350108,
					"content": "そうです。犯人に、我々がまだ宝盗団を狙っていると思わせ続ける必要があります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350109
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220350109,
					"content": "これにより、所長の計画の準備時間を確保することが出来ます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350110
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220350110,
					"content": "どうせその宝盗団たちも普段から悪さをして来ているのです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350111
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220350111,
					"content": "今回も引き続き彼らに「協力」してもらいましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350112
					],
					"speakerTitle": "龍二"
				}
			]
		},
		{
			"id": 2203502,
			"completionStepIds": [
				2203508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2203508",
							"2"
						],
						"stepId": 2203508,
						"stateName": "QUEST_STATE_UNFINISHED"
