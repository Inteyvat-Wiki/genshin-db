			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ソルシュ",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732320301,
					"content": "ここって、あの大きな切り株の上か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732320302,
					"content": "せっかくでっかい穴を通ってここまで来たっていうのに、なんでまた道が塞がれてるんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732320303,
					"content": "「二本角の花冠」を手に入れたカラ、もう母樹に拒否されるはずないのに…くっ…うぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320304
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 732320304,
					"content": "おい、どうしたんだよソルシュ！なんか辛そうだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732320305,
					"content": "ううっ…「二本角の花冠」だワ…何かが流れ込んでくる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320306
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 732320306,
					"content": "うわっ、ソルシュ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732320380,
					"content": "絡み合った古樹の根、その交差した部分の一つひとつから微かな光が放たれている。\\n根の隙間で明滅する光と共に、過去の記憶が蘇ってきた。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 732320381,
					"content": "荒れ果てた山々の中、勇士たちはそれぞれの武器を手に持ち、その後ろに花霊たちが並んでいる。\\n迫りくる黒雲に向かって、彼らは一歩も退かなかった。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 732320382,
					"content": "漆黒の深淵の底で、巨大な機械が微かな光を放つ。\\n彼らは燃え盛る黒炎の中で、逃げ惑う人々を守っていた。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 732320383,
					"content": "無限に続く荒野で、覆面の剣士と片腕の賢者が背中を合わせて立っている。\\n霊光の祝福を受け、潮のように押し寄せる魔物と対峙していた。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 732320384,
					"content": "霊光はすべての人のために、先に進む道を示したが——それは帰る道でもあった。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 732320385,
					"content": "無数の光が小さな光の粒となり、母樹の下から昇っていく。\\nやがて、漆黒の空に火が灯った。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7323206,
			"completionStepIds": [
				7323206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7323206",
							"2"
						],
						"stepId": 7323206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ソルシュ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732320601,
					"content": "おーい！早く目を覚ませって、ソルシュ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320602
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732320602,
					"content": "う…うぅん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320603
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 732320603,
					"content": "ふぅ、やっと目を覚ました。さっき上にいた時、急に気絶したからオイラびっくりしたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732320604,
					"content": "ええ…気にしないで、大丈夫だカラ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320605
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 732320605,
					"content": "あの後、母樹が道を開いてくれたんだ。で、ここまで来たんだけど…もしかしてここって…ズルヴァーンの言ってた、巨蓮「ガオケレナ」なのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320606
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732320606,
					"content": "それで、ソルシュはさっきどうしたんだよ。花冠になにか問題でもあったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320607
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732320607,
					"content": "大地が母樹に帰る記憶を見ていたノ。無数の花霊、ダーリの機械と人間の勇士が、魔物と戦ってみんな犠牲になっていたワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320608
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 732320608,
					"content": "覆面の剣士、片腕の賢者、そして元祖の花霊が、深淵の底カラ湧き出た魔物を退治していた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320609
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 732320609,
					"content": "彼らの意思は最後、霊光となって母樹に帰り、それから雨になってまた大地に降り注いでいたワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320610
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 732320610,
					"content": "ダーリの機械って…もしかして、本当にナセジュナの言ってた通りなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320611
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732320611,
					"content": "やっぱりズルヴァーンに聞く必要がある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732320612
					]
				},
				{
					"id": 732320612,
					"content": "だな。でも、これからどうするんだ。たしかズルヴァーンは穢れを祓うって言ってたよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320613
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732320613,
					"content": "神様の「神識」が存在する「染境」に入って、穢れに囚われた「慈心」を解放するのヨ。そうすれば、「神識」をもう一度呼び起こせるワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320614
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 732320614,
					"content": "私が見た記憶の中で、そこは果てのない虚無の空間だったわネ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320615
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 732320615,
					"content": "それで、どうやって中に入ればいいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320616
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732320616,
					"content": "私についてきテ、古代の英雄たちの「心の動き」を辿れば、そこに行けるはずヨ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ソルシュ"
				}
			]
		},
