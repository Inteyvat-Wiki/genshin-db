				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ズルヴァーン",
					"ソルシュ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732321801,
					"content": "「アブゾーアの儀」が終わった。甘露の流れに沿って、ソルシュと共に「万種母樹」を離れ——花海へと戻った…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732321802
					]
				},
				{
					"id": 732321802,
					"content": "ズルヴァーンは、既にあなたたちの帰りを待ってくれていた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732321803
					]
				},
				{
					"id": 732321803,
					"content": "よもや、本当に「アブゾーアの儀」をやり遂げるとはネェ。この功績は古代の英雄たちにも並ぶものヨ、本当に驚いたワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321804
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732321804,
					"content": "まったく驚いた顔してないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321805
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732321805,
					"content": "「焚真の天象」が消えて、大地も浄化されたワ。まさか、犠牲を払わずにできるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321806
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 732321806,
					"content": "すっごい大雨が降った後に、空のでっかい穴がなくなって、枯れた母樹も大木に戻ったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321807
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732321807,
					"content": "これでもう穢れの侵食に耐えなくて済むはずだ。神様もきっと、苦しみから解放されたと思うぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321808
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732321808,
					"content": "それで、五百年前のことは…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732321809
					]
				},
				{
					"id": 732321809,
					"content": "そうそう、さっきソルシュが母樹の中で過去の記憶を見たんだ。当時、最初に魔物に抵抗したスケプティック団の先人の中に、カーンルイア人がいたって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321810
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732321810,
					"content": "ふむ、そうまくし立てるんじゃないヨ。既に過去の記憶に触れたのなら、私は物語じゃなく、真実を教えてあげるワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321811
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732321811,
					"content": "…これは遥か昔のコト——当時、私が初めて花海で目覚めた時、この小さな土地だけが清浄を保っていた。空は黒淵の異象に覆われ、外は魔物の国となっていたノ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321812
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732321812,
					"content": "神鳥の遺志に従い、私は霊光の力をずっと集め、そして花海を離れて地上の魔物を鎮めていたワ。荒野で、あの金髪の男と出会うまでネ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321813
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732321813,
					"content": "その人の身体は、既に半分が魔物のようになっていた…にも関わらず、魔物の気配はしなかったワ。私が彼を見つけた時、その手には指輪が一つ、固く握られていたのを覚えているワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321814
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732321814,
					"content": "そして、私は彼を花海に連れてくることにしたノ。彼は目が覚めると、自分のことをダーリの剣士だと言っていたワ——呪いを背負っているから、生き残れたともネ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321815
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732321815,
					"content": "それからしばらく、その覆面の剣士と行動を共にしたノ。彼と一緒に、花海に攻めてくるディフたちを迎え撃ったワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321816
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732321816,
					"content": "呪いを背負っている…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732321817
					]
				},
				{
					"id": 732321817,
					"content": "そう…あの災難に見舞われて、ダーリ人はみんな呪いを受けたそうヨ。けど、その影響は人によって違ったみたいネ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321818
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732321818,
					"content": "そして、そのすぐ後——砂漠の東から学者装束の人たちがやってきたノ。そのリーダーは片腕の賢者だったワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321819
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732321819,
					"content": "彼らは、かつてダーリ人の勇士と一緒に戦った者だと言っていたワ。彼らの話によると、あの勇士たちは汚名を着せられると知りつつも、内なる願いに従って行動する人たちだったそうヨ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321820
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732321820,
					"content": "そして、彼らはその勇士たちの遺志を背負い、黒淵の災禍を完全に消し去ろうとしたノ。それを成すために、彼らは勇士たちがかつて歩んだ道を辿って、ここまで来たと言っていたワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321821
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732321821,
					"content": "その後、私たちは一緒にダーリ人が残した遺跡に足を踏み入れ、かつて魔物に抵抗していた時の機械を見つけたワ。その機械たちも、昔は学者たちと同じ戦団に所属していたそうヨ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321822
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732321822,
					"content": "最後は、片腕の賢者がダーリ人の残した文献を頼りに、黒淵を抜けて万種母樹に入る方法を見つけたワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321823
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732321823,
					"content": "私たちは母樹に入り——甘露を使って、天上と地上の穢れを浄化したノ。それ以降、花海から続々と花霊が生まれるようになって、地上の魔物も徐々に姿を消したワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321824
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732321824,
					"content": "#そして、覆面の剣士はあなたと同じような金色の髪を持つ{M#少女}{F#少年}と一緒に花海を離れたノ。一方、賢者は一人で地下の遺跡に入ると、二度と帰って来なかったワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321825
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732321825,
					"content": "残された人たちは新たに誕生した花霊と絆を結び、自らを「スケプティック団」と称すようになったワ。それ以降、ここで暮らしているノ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321826
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732321826,
					"content": "今、再び金髪の勇士が花海に来たコト…それは、確実にまた何かが回り始めたことを暗示しているワ。もちろん、あの頃とは別人だけどネ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321827
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732321827,
					"content": "これも、あなたたちを選んだ理由なノ。あなたたちがいれば、花霊と一緒に戦ってくれる勇士を探さなくて済むからネ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321828
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732321828,
					"content": "人間を導くのって、そりゃあもう大変だし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321829
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732321829,
					"content": "花霊って、どうしてみんなそう面倒くさがり屋なんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321830
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732321830,
					"content": "こら、白フラ！私を巻き込まないでちょうダイ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321831
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 732321831,
					"content": "「アブゾーアの儀」も終わったことだし、ここもしばらくは穢れに脅かされずに済むワ。私も、この機会にしっかりと休めるわネ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321832
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732321832,
					"content": "それとソルシュのことだけど、あなたたちに任せるワ。旅の途中で彼女に色々と教えてあげて、これも「謁賛主」の仕事だカラ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321833
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732321833,
					"content": "白フラに教えられたくなんかないワ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321834
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 732321834,
					"content": "へへっ、ちゃんといい子にするんだぞ、ソルシュ！でもズルヴァーン、なんかもう二度と会えないみたいな話し方してないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321835
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732321835,
					"content": "どうせ、もうここを離れるでショウ？あなたたちみたいな人は、みんな同じだからネェ。永遠に足を止めることがないんだモノ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321836,
						732321837
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732321836,
					"content": "また戻ってくる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732321838
					]
				},
				{
					"id": 732321838,
					"content": "おや…けど、そういった言葉はもう信じないことにしているノ。だって、初めて聞くわけじゃないしネ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321839
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732321839,
					"content": "そういえば、あの覆面の剣士は今頃どうしているんだろうネェ…もしあの人に会うことがあったら、よろしく伝えておいてちょうダイ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321840
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732321840,
					"content": "あなたたちはいずれも旅をする者。だから、いつかきっと会えるワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321841
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732321841,
					"content": "ほらほら、早くあなたたちがいるべき場所に戻りなサイ。私のことは心配しなくても平気ヨ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732321837,
					"content": "この先もまだ会う機会はある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732321838
					]
				}
			]
		},
