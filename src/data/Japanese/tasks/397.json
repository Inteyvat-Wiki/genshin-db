			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ディルック"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3970201,
					"content": "アビス教団…人類を目の敵にする怪物たち、地下の情報網でもヤツらの情報はめったに掴めない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970202
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3970202,
					"content": "少し面倒だったが、何とか手がかりを手に入れた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970203
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3970203,
					"content": "もう手がかりを掴めたのかい？さすが顔の広いディルックだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970204
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3970204,
					"content": "そういえばさ、風神バルバトス様はなんで人間の力を借りてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3970205,
					"content": "ははっ、どう説明したらいいかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970206
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3970206,
					"content": "人々の言う七神、その本質は「俗世の七執政」というべきなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970207
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3970207,
					"content": "俗世を七つに分け、それぞれが治める、それがボクたち神としての責務。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970208
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3970208,
					"content": "神の責務を果たすことで神の力を蓄える。だけど、ボクは統治とか嫌なんだ…モンドの人々もそういうの好まないと思うし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970209
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3970209,
					"content": "「君たちが王のいない自由な城を作ればいい」——バルバトス様の理念を私たちはちゃんと覚えている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970210
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3970210,
					"content": "ジン団長ってば信仰深い！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3970211,
					"content": "単に誰かさんが自由すぎて、仕事をサボっていただけとか考えないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3970212,
					"content": "コホン、とにかく、こんなに長くモンドに戻ってなかったボクのことだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970213
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3970213,
					"content": "今のボクは紛れもなく、七神の中でも最弱だよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970214,
						3970215
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3970214,
					"content": "よく言うよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970216
					]
				},
				{
					"id": 3970216,
					"content": "そんなに褒めないでよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970217
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3970217,
					"content": "はぁ…こんな風神様がいるとは、いいんだか悪いんだか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970218
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3970218,
					"content": "七国と七神の話はさておき、まずは人類共通の敵について話そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970219
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3970219,
					"content": "今回調べた<color=#00E1FFFF>アビスの魔術師の痕跡</color>は、<color=#00E1FFFF>ワイナリー</color>のすぐ近くにあった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970220
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3970220,
					"content": "そいつを取り逃がしてはいけない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970221
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3970221,
					"content": "探し出そう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 3970215,
					"content": "さすが「自由の都」の神。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970216
					]
				}
			]
		},
		{
			"id": 39704,
			"completionStepIds": [
				39704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"39704",
							"2"
						],
						"stepId": 39704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ウェンティ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3970401,
					"content": "ん？これは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970402
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3970402,
					"content": "アビスの魔術師を倒した後、何かエネルギーが散らばった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970403
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3970403,
					"content": "このエネルギーは、ボクとトワリンの繋がりを根絶させるためのものみたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970404
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3970404,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970405
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3970405,
					"content": "<color=#00E1FFFF>「風龍廃墟」</color>を知っているかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970406,
						3970408
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3970406,
					"content": "知らない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970407
					]
				},
				{
					"id": 3970407,
					"content": "そう、でもジン団長とディルックなら知ってると思うんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970410
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3970410,
					"content": "今のトワリンは、その廃墟を巣にしている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970411
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3970411,
					"content": "モンドの周りを封鎖する暴風のように、廃墟の入口にも特殊な障壁があるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970412
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3970412,
					"content": "でも今、アビスの魔術師から散ったエネルギーを使うことで、魔力の織りなす韻律をボクは読み取ることができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970413
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3970413,
					"content": "その韻律はヒルチャールの合唱より耳障りだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970414
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3970414,
					"content": "それでも暴風の障壁を突破して、<color=#00E1FFFF>「風龍廃墟」</color>の内部に行くには十分だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970415
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3970415,
					"content": "つまり、トワリンに正面から挑むのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970416
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3970416,
					"content": "僕は異論ないが…戦いを回避したいと言っているのはジンだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970417
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3970417,
					"content": "いや、選択肢がない以上、私がその責任を背負う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970418
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3970418,
					"content": "もし、トワリンの討伐が唯一の救いの道であるなら、私が先陣を切る騎士となろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970419
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3970419,
					"content": "——大丈夫、まだその段階までは行ってないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970420
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3970420,
					"content": "ん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970421
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3970421,
					"content": "ウェンティ殿、それは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970422
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3970422,
					"content": "つまり、天空のライアーは切り札じゃないってことさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970423
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3970423,
					"content": "#本当の切り札は——{NICKNAME}だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970424
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3970424,
					"content": "#{NICKNAME}が？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970425,
						3970427
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3970425,
					"content": "涙の結晶を浄化したから？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970426
					]
				},
				{
					"id": 3970426,
					"content": "そうだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970430
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3970430,
					"content": "涙の結晶にあった不純物とトワリンを取り巻く呪いは、同じ類の邪悪なる力だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970431
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3970431,
					"content": "だからさ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970432
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3970432,
					"content": "吟遊野郎、それは危ないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970433
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3970433,
					"content": "トワリンが激怒した時のことを思い出してみろ。動く前にトワリンに食われるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970434,
						3970435
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3970434,
					"content": "強いから大丈夫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970436
					]
				},
				{
					"id": 3970436,
					"content": "…ふっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970437
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3970437,
					"content": "面白い計画だ、やってみる価値はある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970438
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3970438,
					"content": "私も共に行くぞ、栄誉騎士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970439
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3970439,
					"content": "敵は…アビスの怪物と龍！威圧感がすごそうだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970440
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3970440,
					"content": "人間にだって人間の本気がある。さあ、行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970441
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3970441,
					"content": "よし——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970442
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3970442,
					"content": "英雄の詩篇も、いよいよ決戦の章だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3970435,
					"content": "みんなの力が必要だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970436
					]
				},
				{
					"id": 3970427,
					"content": "腕が立つから？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970428
					]
				},
				{
					"id": 3970428,
					"content": "#うーん…もちろん、{NICKNAME}の戦力にも期待してるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970429
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3970429,
					"content": "でも君は、もっと貴重な能力を持っているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970430
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3970408,
					"content": "モンドで誰かが言ってた気がする。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970409
					]
				},
				{
