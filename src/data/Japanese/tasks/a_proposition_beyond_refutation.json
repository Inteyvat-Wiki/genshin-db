					}
				]
			},
			"dialogs": [
				{
					"id": 700920201,
					"content": "テイワットで最もドラマチックな場所——エピクレシス歌劇場…の魔法模擬空間へようこそ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920202
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 700920202,
					"content": "今回の課題は「討論」に合わせて、こんな魔法空間を作ったの。結構よくできてるでしょ？真心をたっぷり込めて、儀式感が出るように仕上げたんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920203
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 700920203,
					"content": "討論…って、前もあたしに完敗してただろう。また恥をかきたいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920204
					],
					"speakerTitle": "プルーネ"
				},
				{
					"id": 700920204,
					"content": "ふふっ…プルーネちゃんったら、十二歳レベルの議題に対して十六歳レベルの聡明さを発揮するんだもの。あの時は驚かされちゃった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920205
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 700920205,
					"content": "あなたが反論せずにはいられない性格ってことを考慮して…今回は、絶対に論破不可能なテーマを考えてきたの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920206,
						700920207
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 700920206,
					"content": "ごめん、ちょっといいかな…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700920208
					]
				},
				{
					"id": 700920208,
					"content": "討論を素晴らしいものにするためには、公平で公正な審査員が欠かせないでしょ？あなたたちなら適任だし、プルーネちゃんだって反対しないはずよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920209
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 700920209,
					"content": "じゃあ…パイモンはあの位置でいいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700920210
					]
				},
				{
					"id": 700920210,
					"content": "さっきからずっと、高所の貴賓席からポーズを決めてるけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920211,
						700920212
					],
					"speakerTitle": "プルーネ"
				},
				{
					"id": 700920211,
					"content": "その台詞、聞き覚えが…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700920213
					]
				},
				{
					"id": 700920213,
					"content": "へへっ…まさかこんな場所に転送されるなんてな。思わずオイラたちの友達——フォンテーヌの大スターを真似ちゃったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700920214,
					"content": "パイモンは白熱する討論をじっくり見物したいでしょう？そこは一番よく見渡せる特等席よ。気に入ってもらえた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920215
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 700920215,
					"content": "へぇ、ここからだとこんな風に見えるんだな…でも、本当にオイラがここに座っていいのか？なんか、偉そうにしてるみたいで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700920216,
					"content": "ここは魔法で作られた空間で、全てが魔女の思い通りなの。警備員が入ってきてあなたたちを捕まえたりはしないから、安心してね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920217
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 700920217,
					"content": "高いところにお座りのパイモ～ン、特別観覧席はお気に召したかしら～？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920218
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 700920218,
					"content": "は、迫力満点だぞ！こんな場所に座るのは初めてだから、なんて言えばいいかわからないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920219
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700920219,
					"content": "じゃあ早く慣れてね。これから、あなたの拍手と歓声が必要になってくるんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920220
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 700920220,
					"content": "茶番はもう十分なのだ…さっさと終わらせるぞ。で、テーマは何なんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920221
					],
					"speakerTitle": "プルーネ"
				},
				{
					"id": 700920221,
					"content": "ずばり、「クレーは悪い子である」よ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920222
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 700920222,
					"content": "えっ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920224
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700920224,
					"content": "えっ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700920225
					]
				},
				{
					"id": 700920225,
					"content": "これが、あなたが反論するテーマだよ。もし「クレーは悪い子じゃない」って証明できたら、ささやかなプレゼントをあげる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920226
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 700920226,
					"content": "おまえからのプレゼントなんていらないのだ！クレーはおまえの娘だろう、そんなテーマ出すな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920227
					],
					"speakerTitle": "プルーネ"
				},
				{
					"id": 700920227,
					"content": "おまえは…とんでもない悪人だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920228
					],
					"speakerTitle": "プルーネ"
				},
				{
					"id": 700920228,
					"content": "うふふ、「蛙の子は蛙」って言うでしょ。あなたが私を悪人だって決めつけるなら、私の子供は悪い子ってことになるわよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920229
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 700920229,
					"content": "異議ありなのだ！そんなわけあるか。おまえ自身の品性や素行に問題があるのであって…それが遺伝するなんて科学的根拠はないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920230
					],
					"speakerTitle": "プルーネ"
				},
				{
					"id": 700920230,
					"content": "それに、重要なのは遺伝じゃなく育った環境だ。モンドの人たちはおまえよりずっとまともだし、あの人たちに囲まれて育つクレーが悪い子なわけない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920231
					],
					"speakerTitle": "プルーネ"
				},
				{
					"id": 700920231,
					"content": "でも、クレーはお魚ドカーンが大好きなのよ？これは、悪い子だっていう有力な証拠になるんじゃない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920232
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 700920232,
					"content": "そ…それは…子供だからしょうがないのだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920233
					],
					"speakerTitle": "プルーネ"
				},
				{
					"id": 700920233,
					"content": "港の漁船だって魚を捕るだろう。クレーは、なんで魚を捕るのはよくてドカーンはダメなのか、区別がついてないだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920234
					],
					"speakerTitle": "プルーネ"
				},
				{
					"id": 700920234,
					"content": "その割には、毎回反省室に入れられても懲りずにドカーンしてるけど？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920235
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 700920235,
					"content": "あいつは毎回素直に反省室に入ってるし、逃げようとしたことなんてないのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920236
					],
					"speakerTitle": "プルーネ"
				},
				{
					"id": 700920236,
					"content": "ちゃんと罰を受け入れて、責任逃れもしてない。そんな子に「悪い子」なんてレッテルを貼っちゃ駄目だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920237
					],
					"speakerTitle": "プルーネ"
				},
				{
					"id": 700920237,
					"content": "それに、前回反省室に入れられてからのクレーは、「お魚をドカーンしたい」と口にすることはあっても、勝手にそれを実行に移したことは一度もない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920238
					],
					"speakerTitle": "プルーネ"
				},
				{
					"id": 700920238,
					"content": "最近のドカーンは、あいつが信頼を寄せる人物が「そそのかして」、「甘やかした」せいだ。その人物とは…「混沌」の化身とも言える母親だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920239
					],
					"speakerTitle": "プルーネ"
				},
				{
					"id": 700920239,
					"content": "えっへん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920240
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 700920240,
					"content": "つまり、おまえこそ「悪い子」…じゃない、「悪い大人」のレッテルを貼られるべきなのだ！…いや、こんな子供みたいな大人がいてたまるか！「悪い大きな子」だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920241
					],
					"speakerTitle": "プルーネ"
				},
				{
					"id": 700920241,
					"content": "形勢逆転！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700920242
					]
				},
				{
					"id": 700920242,
					"content": "プルーネ、すごい気迫だぞ…見事に反論をきめたな！ここからアリスはどう返すんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920243
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700920243,
					"content": "だとしても、それはクレーに「悪気がなかったこと」の証明でしかないのよ。みんながクレーを「悪い子」じゃないと思ってる根拠としては、イマイチね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920244
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 700920244,
					"content": "減らず口を…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920245
					],
					"speakerTitle": "プルーネ"
				},
				{
					"id": 700920245,
					"content": "じゃあ、よーっく聞くのだ。これについては、おまえは確実に反論できないはずだぞ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920246
					],
					"speakerTitle": "プルーネ"
				},
				{
					"id": 700920246,
					"content": "クレーは可愛いから、何をしても許されるのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920247
					],
					"speakerTitle": "プルーネ"
				},
				{
					"id": 700920247,
					"content": "その通り！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700920248
					]
				},
				{
					"id": 700920248,
					"content": "そうだぞ！可愛いクレーがちょっとぐらいイタズラしたって、オイラなら全然許せるぞ。とにかく、オイラにとってクレーは悪い子なんかじゃないからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920249
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700920249,
					"content": "おまえがクレーの悪いところを百個挙げようと、あたしはあいつのいいところを百一個以上挙げられる。おもちゃを友達に貸してあげたり、遊びたくてもみんなが忙しい時は、大人しく待ってたり…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920250
					],
					"speakerTitle": "プルーネ"
				},
				{
					"id": 700920250,
					"content": "何より、あいつは誰に対しても優しくて、誰もがいい人だと思ってる…自分のママを敵視してる、あたしのことまでもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920251
					],
					"speakerTitle": "プルーネ"
				},
				{
					"id": 700920251,
					"content": "とにかく、あんなに可愛い子を「悪い子」呼ばわりするのは、あたしが許さないのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920252
					],
					"speakerTitle": "プルーネ"
				},
				{
					"id": 700920252,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920253
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 700920253,
					"content": "ああもう、降参！降参よ！ママとして、その意見には同意せざるを得ないじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920254
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 700920254,
					"content": "それに、ずっと聞きたかった言葉がようやく聞けた。あなたは、心からクレーを最高の友達だと思ってるみたいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920255
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 700920255,
					"content": "うちの子、すっごく可愛いでしょ？それに、言ったじゃない。あの子と一緒にいることで、あなたも幸せな気分になれるのよ、って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920256
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 700920256,
					"content": "…なに得意げになってるんだ？おまえの悪ふざけのせいで、あたしはわざわざモンドまで来る羽目になったんだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920257
					],
					"speakerTitle": "プルーネ"
				},
				{
					"id": 700920257,
					"content": "ふふっ。クレーにこんなに素敵なお友達がついててくれるなら、これからは心配する必要もなさそう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920258
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 700920258,
					"content": "あなたたちがどう成長していくのか、楽しみね。さすがに、クレーも私と同じ年齢になる頃にはお魚ドカーンを卒業してるだろうし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920259
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 700920259,
					"content": "ん？…おい、ちょっと待つのだ。「今回の課題は、プルーネのクレーに対する真心をテストしてたのよ」とか、しょうもないこと言い出すんじゃないだろうな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920260
					],
					"speakerTitle": "プルーネ"
				},
				{
					"id": 700920260,
					"content": "大正解～。それじゃ、挑戦の結果発表まで飛ばしちゃいましょっか。審査員の先生、お願いしま～す。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920261
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 700920261,
					"content": "コホン…えー、「プルーネの魔女の課題への挑戦結果は…合格です！これより、魔女の祝福を授けます」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700920262
					]
				},
				{
					"id": 700920262,
					"content": "「クレーと同じように、健やかで、ご飯をた～っくさん食べて、悩みは少なく、幸せな子供でありますように」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700920263
					]
				},
				{
					"id": 700920263,
					"content": "あなたもクレーも、とてもいい子でしょ。だから、たまに間違ったことをしちゃったり、わがままを言っても許されるのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920264
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 700920264,
					"content": "え？あ…ありがとう…？でも、それとこれとは話が別なのだぞ。あたしを子供扱いするなって何度も言ってるのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920265
					],
					"speakerTitle": "プルーネ"
				},
				{
					"id": 700920265,
					"content": "あたしが魔女ハンターだってこと、忘れてないだろうな？和解するつもりなんか一切ないぞ！おまえは負けたんだから、こんなぬいぐるみでごまかさずに大人しく出てくるのだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920266
					],
					"speakerTitle": "プルーネ"
				},
				{
					"id": 700920266,
					"content": "今日は、とっても楽しかった！また時間がある時にからかいに来るからね。バイバ～イ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920267
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 700920267,
					"content": "聞いてるのか！？…あっ！逃げるな——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "プルーネ"
				},
				{
					"id": 700920212,
					"content": "この場面も見覚えがある！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700920213
					]
				},
				{
					"id": 700920207,
					"content": "#{M#俺}{F#私}がここにいていいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700920208
					]
				}
			]
		},
