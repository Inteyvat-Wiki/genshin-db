			"dialogs": [
				{
					"id": 700920101,
					"content": "プルーネの課題…いや、課題っていうより挑戦状みたいだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700920102,
					"content": "「うふふ、小さな魔女ハンターさん。私を倒す方法は思いついたかしら？かっこよく挑戦の宣誓を叫んだら、大魔王がやっつけに行くからね♪」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700920103,
					"content": "…間違いなくアリスが書いた文章だな。「魔女ハンター」って書いてなきゃ、クレー宛てに書いたのかと勘違いしそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700920104,
					"content": "プルーネはずっとアリスを敵視してるからな…こんな挑発を受けたら、カンカンに怒っちゃうんじゃないか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700920105,
					"content": "アリス、絶対わざとやってるよね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700920106
					]
				},
				{
					"id": 700920106,
					"content": "プルーネには、余計な部分を省いて伝えようぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700920107,
					"content": "あたしに何を伝えるって？見せるのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920108
					],
					"speakerTitle": "プルーネ"
				},
				{
					"id": 700920108,
					"content": "うわあっ！ち、ちがうんだ…落ち着いて話を…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700920109,
					"content": "…くだらないのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920110
					],
					"speakerTitle": "プルーネ"
				},
				{
					"id": 700920110,
					"content": "…えっ？意外と冷静だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700920111,
					"content": "ふん…あいつの幼稚な手口にはもう飽き飽きだぞ。大げさに見せかけてるけど、こんなの子供騙しの悪ふざけに過ぎない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920112
					],
					"speakerTitle": "プルーネ"
				},
				{
					"id": 700920112,
					"content": "叫べって言われて、素直に叫ぶやつなんているわけないだろう…周りに変な目で見られるだけだ。あたしは騙されないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920113
					],
					"speakerTitle": "プルーネ"
				},
				{
					"id": 700920113,
					"content": "そんなの、街中で「あたしは大バカ者なのだ」って叫んでるようなものだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920114
					],
					"speakerTitle": "プルーネ"
				},
				{
					"id": 700920114,
					"content": "あたしは大バカ者なのだ！あたしは大バカ者なのだ！あたしは大バカ者なのだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920115
					],
					"speakerTitle": "レコーダー"
				},
				{
					"id": 700920115,
					"content": "な、なんだ！？なんであっちからあたしの声が！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920116
					],
					"speakerTitle": "プルーネ"
				},
				{
					"id": 700920116,
					"content": "はっはっは！自分が大バカ者だなんて叫んでるのは、どこのどいつだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920117
					],
					"speakerTitle": "何も知らない通行人"
				},
				{
					"id": 700920117,
					"content": "自分を大バカ者だなんて、言ってて恥ずかしくないの？あはは、罰ゲームか何か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920118
					],
					"speakerTitle": "野次馬の通行人"
				},
				{
					"id": 700920118,
					"content": "きっと子供の悪ふざけよ。騙されたおバカな子が言わされてるのね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920119
					],
					"speakerTitle": "理性的な通行人"
				},
				{
					"id": 700920119,
					"content": "くそっ…やめろ、やめるのだぁ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920120
					],
					"speakerTitle": "プルーネ"
				},
				{
					"id": 700920120,
					"content": "あたしは大バカ者なのだ！あたしは大バカ者なのだ！あたしは大バカ者なのだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920121
					],
					"speakerTitle": "レコーダー"
				},
				{
					"id": 700920121,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920122
					],
					"speakerTitle": "プルーネ"
				},
				{
					"id": 700920122,
					"content": "落ち着けって、プルーネ！壊さなくてもいいだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920123,
						700920124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700920123,
					"content": "やめよう、プルーネ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700920125
					]
				},
				{
					"id": 700920125,
					"content": "ああもう…！ア——リ——ス——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920126
					],
					"speakerTitle": "プルーネ"
				},
				{
					"id": 700920126,
					"content": "はいは～い、みんな～。ふふっ、あんな宣言をするなんて笑っちゃうじゃない。あ、おめでとう、プルーネちゃん。見事に魔女の課題のスタートを切れたみたいね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920127
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 700920127,
					"content": "今回の挑戦のために、いかにも儀式～！…って感じの魔法空間を用意したのよ。けど、魔法の読み込みにちょっと時間がかかっちゃうのが難点なのよね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920128
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 700920128,
					"content": "そこで、宣誓を読み込み中の効果音にして、あなたの士気を高めるためにリピート再生することにしたの。どう？気に入ってもらえたかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920129
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 700920129,
					"content": "あたしは大バカ者なのだ！あたしは大バカ者なのだ！あたしは大バカ者なのだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920130
					],
					"speakerTitle": "レコーダー"
				},
				{
					"id": 700920130,
					"content": "違う！それは宣誓じゃないのだ！早くこのふざけた効果音を止めろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920131
					],
					"speakerTitle": "プルーネ"
				},
				{
					"id": 700920131,
					"content": "あらあら、私の勘違いだったのね。でも、効果音は挑戦魔法の一部なのよね…止めちゃうと、挑戦をあきらめることになるのよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920132
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 700920132,
					"content": "本当に？本当にいいのね？じゃあ、さようなら…また機会があれば——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920133
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 700920133,
					"content": "ま…待て！やっと捕まえたのに、逃がすはずがないだろう！あぁ、もう…その、おまえのポンコツ魔法は読み込みにどれくらいかかるんだ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920134
					],
					"speakerTitle": "プルーネ"
				},
				{
					"id": 700920134,
					"content": "とっくに終わってるわよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アリス"
				},
				{
					"id": 700920124,
					"content": "全部レコーダーだよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700920125
					]
				}
			]
		},
