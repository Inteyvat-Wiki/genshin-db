				"points": []
			},
			"dialogs": [
				{
					"id": 190570701,
					"content": "先ほどは失礼なことを言ってしまい、申し訳ございません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570702
					],
					"speakerTitle": "悦"
				},
				{
					"id": 190570702,
					"content": "あら、平蔵さんについて知りたいのですか？彼は私みたいな人間を嫌っているのでしょうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570703
					],
					"speakerTitle": "悦"
				},
				{
					"id": 190570703,
					"content": "あまり表には出さず、友好的に話しはしますが、詐欺師に対する態度は他の罪状の時とかなり違います…何だか、詐欺師を特に嫌っているみたい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570704
					],
					"speakerTitle": "悦"
				},
				{
					"id": 190570704,
					"content": "もしかしたら彼も騙された経験があるのでしょうか？信じられないわ、平蔵さんを騙せる人がいるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "悦"
				}
			]
		},
		{
			"id": 1905708,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
