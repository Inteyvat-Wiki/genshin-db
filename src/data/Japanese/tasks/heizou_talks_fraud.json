				"objectNames": [
					"伊庭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190570901,
					"content": "あの平蔵って子は相当手ごわいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570902
					],
					"speakerTitle": "伊庭"
				},
				{
					"id": 190570902,
					"content": "おや？お前たちはワシの過去のことについて知りたいのか？大した話じゃないがな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570903
					],
					"speakerTitle": "伊庭"
				},
				{
					"id": 190570903,
					"content": "あの時は平蔵が調査していると聞いて、もうダメだとあきらめて、全て吐いたのじゃ。何しろ、相手はあの「嵐」だからのう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570904
					],
					"speakerTitle": "伊庭"
				},
				{
					"id": 190570904,
					"content": "「嵐」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190570905
					]
				},
				{
					"id": 190570905,
					"content": "平蔵の別名じゃ、聞いたことがないのか？牢屋の囚人たちはみなそう呼ぶ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570906
					],
					"speakerTitle": "伊庭"
				},
				{
					"id": 190570906,
					"content": "逃げるのも隠れるのも不可能。犯罪者にとって、平蔵は嵐のような災害なんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570907
					],
					"speakerTitle": "伊庭"
				},
				{
					"id": 190570907,
					"content": "はぁ、こんな結果になると知っていれば、あの時は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊庭"
				}
			]
		}
	]
