			"trigger": {
				"objectNames": [
					"鹿野奈々"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190570801,
					"content": "旅人さん、こんにちは。平蔵が迷惑をかけたようですが、大目に見てやってください。ちょっと癖が強いけど、悪意はないんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570802
					],
					"speakerTitle": "鹿野奈々"
				},
				{
					"id": 190570802,
					"content": "もしあなたを怒らせたりしたら、遠慮なく叱ってやってください。口答えをされたら、私がそうお願いしたと言っていいですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鹿野奈々"
				}
			]
		},
		{
			"id": 1905709,
			"completionStepIds": [],
