					"玉霞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701410401,
					"content": "洞窟内の気流について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701410402
					]
				},
				{
					"id": 701410402,
					"content": "そんな高いところまで行ったの？流石ね。ただ…奇妙な気流に封印された洞窟？ふむ、少し考えさせて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701410403
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701410403,
					"content": "前に高い場所まで辿り着けた運のいい冒険隊がいたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701410404
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701410404,
					"content": "彼らが言うには近くでは確認できなかったけど、確かに強い奇妙な気流が流れている洞窟があったそうよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701410405
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701410405,
					"content": "通常なら、そういった場所は気流があったとしても、そこまで強くならないはず。今でも原因は分からないままよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701410406
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701410406,
					"content": "奇妙な気流以外にも、雪山には奇妙な氷がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701410407
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701410407,
					"content": "その氷は砕くのも難しく、火で燃やしても溶けない。私たちの探索の大きな障害になっているの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701410408
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701410408,
					"content": "その氷を壊す方法が見つからなくて、仕方なく回り道している状況よ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701410409
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701410409,
					"content": "そして、氷の側には青色の植物が大量に生えているの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701410410
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701410410,
					"content": "なんとなく氷に閉じ込められているものは確認できるけど、氷を溶かす方法はないから見ることしかできないわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701410411
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701410411,
					"content": "興味があるのなら、青色の植物を辿ってその氷を見に行くといいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701410412
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701410412,
					"content": "ふむ…確か雪山の<color=#00E1FFFF>「積雪の道」</color>、<color=#00E1FFFF>「雪葬の都·近郊」</color>それと<color=#00E1FFFF>「星蛍の洞窟」</color>周辺にその植物がたくさんあったわ。そこに行ってみるといいかもね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701410413
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701410413,
					"content": "奇妙な強い気流、奇妙な氷、そして奇妙な植物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701410414
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701410414,
					"content": "ははは、これが探検小説なら、この3つの物は繋がっているのかもしれないわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701410415
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701410415,
					"content": "でも現実の探検は堅実なものよ…雪山に入るのなら、十分に準備をしておきなさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玉霞"
				}
			]
		},
