					"玉霞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701410101,
					"content": "雪山の状況について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701410102
					]
				},
				{
					"id": 701410102,
					"content": "雪山の状況？ここの環境はモンドのどこよりも危険だとしか言えないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701410103
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701410103,
					"content": "劣悪な環境以外にも、この山には奇妙な…氷がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701410104
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701410104,
					"content": "その氷は砕くのも難しく、火で燃やしても溶けない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701410105
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701410105,
					"content": "そして、いくつかの道はその氷に塞がれているわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701410106
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701410106,
					"content": "その氷に道を塞がれ、回り道もできずに引き返した探検隊もいくつもあるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701410107
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701410107,
					"content": "はあ、いつになったらその氷を壊す方法が見つかるのかしら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701410108
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701410108,
					"content": "氷を見てみたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701410109
					]
				},
				{
					"id": 701410109,
					"content": "氷を見るだけよね？それなら確か雪山の周りに似た氷があったはずよ。中に何が閉じ込められてるかは不明だけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701410110
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701410110,
					"content": "側まで見に行ってもいいけど、絶対に奥に入らないで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玉霞"
				}
			]
		},
