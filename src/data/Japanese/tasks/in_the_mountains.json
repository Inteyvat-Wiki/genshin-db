					"玉霞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701411201,
					"content": "この雪山は本当に危険だ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701411202
					]
				},
				{
					"id": 701411202,
					"content": "あれ？帰って来たの。どう、氷は見つかったでしょう。えっと…何があったの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701411203
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701411203,
					"content": "洞窟内の気流について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701411204
					]
				},
				{
					"id": 701411204,
					"content": "そんな高いところまで行ったの？流石ね。ただ…奇妙な気流に封印された洞窟？ふむ、少し考えさせて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701411205
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701411205,
					"content": "あ…そう言えば、前に山頂付近まで辿り着けた運のいい冒険隊がいたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701411206
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701411206,
					"content": "彼らが言うには近くでは確認できなかったけど、確かに山頂付近に強い奇妙な気流が流れている洞窟があったそうよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701411207
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701411207,
					"content": "通常なら、そういった場所は気流があったとしても、そこまで強くならないはず。今でも原因は分からないままよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701411208
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701411208,
					"content": "奇妙な気流以外にも、雪山には奇妙な氷がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701411209
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701411209,
					"content": "その氷は砕くのも難しく、火で燃やしても溶けない。私たちの探索の大きな障害になっているの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701411210
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701411210,
					"content": "その氷を壊す方法が見つからなくて、仕方なく回り道している状況よ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701411211
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701411211,
					"content": "そして、氷の側には青色の植物が大量に生えているの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701411212
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701411212,
					"content": "なんとなく氷に閉じ込められているものは確認できるけど、氷を溶かす方法はないから見ることしかできないわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701411213
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701411213,
					"content": "興味があるのなら、青色の植物を辿ってその氷を見に行くといいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701411214
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701411214,
					"content": "ふむ…確か<color=#00E1FFFF>「雪葬の都·近郊」</color>と<color=#00E1FFFF>「星蛍の洞窟」</color>周辺にその植物がたくさんあったわ。そこに行ってみるといいかもね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701411215
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701411215,
					"content": "奇妙な強い気流、奇妙な氷、そして奇妙な植物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701411216
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701411216,
					"content": "ははは、これが探検小説なら、この3つの物は繋がっているのかもしれないわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701411217
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701411217,
					"content": "でも現実の探検は堅実なものよ…雪山に入るのなら、十分に準備をしておきなさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玉霞"
				}
			]
		},
