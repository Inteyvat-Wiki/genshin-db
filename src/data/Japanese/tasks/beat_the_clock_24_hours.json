			"dialogs": [
				{
					"id": 750140801,
					"content": "（うーん…ここからだとよく見えないけど、これ以上近づくと見つかっちゃいそうだ。…今くらいの距離を保って、なにを話してるか聞こうぜ。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750140802
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750140802,
					"content": "前回の品は素晴らしいものだった。今回も頼むよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750140803
					],
					"speakerTitle": "コヤン"
				},
				{
					"id": 750140803,
					"content": "お安い御用だ。今回もいつも通りで？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750140804
					],
					"speakerTitle": "パラン"
				},
				{
					"id": 750140804,
					"content": "ああ。飛行コンテストの前に届けてくれ。きっと必要になる人がいる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750140805
					],
					"speakerTitle": "コヤン"
				},
				{
					"id": 750140805,
					"content": "問題ない。あっちも話がまとまったみたいだし、そろそろ撤収するか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750140806
					],
					"speakerTitle": "パラン"
				},
				{
					"id": 750140806,
					"content": "（え？もう行くのか？思ったのとは違ったけど…とりあえず戻ろうぜ。見つからないように気をつけるんだぞ。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
