			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"雷電将軍"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20200301,
					"content": "いったい、何があなたを再び私のところまで来させたのでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200302
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 20200302,
					"content": "その愚かな勇気は、人々を庇うため？それとも…私に謁見するのが目的ですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200303,
						20200304
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 20200303,
					"content": "ファデュイが雷電将軍を誘導した。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200305
					]
				},
				{
					"id": 20200305,
					"content": "おや？よもやそんなことを言うために、私を永遠の冥想から呼び起こしたとでも言うのですか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200306
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 20200306,
					"content": "だとすれば私も見くびられたものです。目狩り令に関することはもちろん知っていますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200307
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 20200307,
					"content": "外のことも知ってるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200308
					]
				},
				{
					"id": 20200308,
					"content": "いいえ、私が知っているのは「永遠」についてのみ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200309
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 20200309,
					"content": "目狩り令の発令も、私が黙認したことです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200310
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 20200310,
					"content": "あのファデュイたちの行いは、「永遠」の脅威にはなっていません。さもなければ…とっくに粛清していますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200311,
						20200312
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 20200311,
					"content": "でも目狩り令は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200313
					]
				},
				{
					"id": 20200313,
					"content": "願いとは元々「永遠」にそぐわないものです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200314
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 20200314,
					"content": "あなたはまだ気づいていないかもしれませんが、願いを追い求めるというのは…たくさんのものを失うことなのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200315
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 20200315,
					"content": "神の目を接収すること自体は、命を奪うことではありません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200316
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 20200316,
					"content": "命を落としたのは、むしろ願いを追い求めた者たちではありませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200317
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 20200317,
					"content": "哲平…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200318
					]
				},
				{
					"id": 20200318,
					"content": "旅人さん、あなたは確かに特別な存在として私の目に映っています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200319
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 20200319,
					"content": "あなたの身には数え切れないほどの不確定要素があります。言い換えれば、あなたは「永遠」から最もかけ離れた存在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200320
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 20200320,
					"content": "であれば、私は別にあなたに理解してもらおうとは思いません。あくまでも世のために「永遠」の道を歩んでいく、ただそれだけです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200321
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 20200321,
					"content": "ここは将軍の「一心浄土」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200322
					]
				},
				{
					"id": 20200322,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYSECOND|INFO_FEMALE_PRONOUN_GIRLSECOND]}の意識で構成された空間だよね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200323
					]
				},
				{
					"id": 20200323,
					"content": "そう、そんなことも知っているのですか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200324
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 20200324,
					"content": "まあ別に構いません。おおかた…私の意志を動揺させる隙を探っているのでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200325
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 20200325,
					"content": "もう言葉は意味がなさそうだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200326
					]
				},
				{
					"id": 20200326,
					"content": "直接この手で「論破」する。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200327
					]
				},
				{
					"id": 20200327,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200328
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 20200328,
					"content": "いいでしょう、「永遠に背く者」。あなたの覚悟を…見せてもらいます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 20200312,
					"content": "稲妻の民はたくさんのものを失った。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200313
					]
				},
				{
					"id": 20200304,
					"content": "目狩り令は発令されるべきじゃなかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200305
					]
				}
			]
		},
		{
			"id": 202005,
			"completionStepIds": [
				202005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"202005",
							"2"
						],
						"stepId": 202005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"八重神子",
					"雷電将軍"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20200501,
					"content": "汝の負けじゃ、影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200502
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200502,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200503
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 20200503,
					"content": "…ええ、私の負けです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200504
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 20200504,
					"content": "どうして自らの民を、彼らの願いの力を信じてやれぬのじゃ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200505
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200505,
					"content": "あれらの願いは、距離や空間、さらには時間をも越え、すでに何人にも止められぬもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200506,
						20200507,
						20200508
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200506,
					"content": "人々が全力で進む時…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200509
					]
				},
				{
					"id": 20200509,
					"content": "それが汝が璃月の旅で得た収穫か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200510
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200510,
					"content": "うん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200511
					]
				},
				{
					"id": 20200511,
					"content": "人間が前へ進み、神が後ろに置いて行かれる国か…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200512
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200512,
					"content": "しかして、なぜ妾たちがそう自分勝手に…前へ進むことを一方的に放棄させることができる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200513
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200513,
					"content": "…前に進むことで生じた損失を、あなたも共に見てきたはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200514
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 20200514,
					"content": "永遠…そう、永遠にのみ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200515
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 20200515,
					"content": "天理…妾にとっては皆目見当もつかぬものじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200516
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200516,
					"content": "兎にも角にも、汝は自分の愛する稲妻を永遠に守り続けたいだけなんじゃろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200517
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200517,
					"content": "その言い方はあまりにも軽薄です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200518
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 20200518,
					"content": "しかしこの国は、果たして永遠に存在する価値のあるものなんじゃろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200519
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200519,
					"content": "願いを失い、変化を失い、ただ存在するだけの国。そんなものは抜け殻にすぎぬ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200520
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200520,
					"content": "ふっ、であれば、滅んでも問題はないじゃろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200521
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200521,
					"content": "神子、その妄言を撤回してください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200522
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 20200522,
					"content": "未来永劫変わることのない永遠、私が臣民に誓った約束です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200523
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 20200523,
					"content": "しかし汝の臣民が必要としているのは、汝の約束などではなく、汝の「眼差し」じゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200524
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200524,
					"content": "…神の目ですか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200525
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 20200525,
					"content": "人の寿命は百年のみ、彼らに過去を背負えるほどの力はありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200526
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 20200526,
					"content": "私はすべてを経験したからこそ、彼らを正しい「永遠」へと導くことを選んだのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200527
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 20200527,
					"content": "はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200528
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200528,
					"content": "…じゃが「永遠」は汝にとって、あまりにも残酷すぎるぞ、影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200529
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200529,
					"content": "私？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200530
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 20200530,
					"content": "汝は俗世の者どもに目を向けぬようになっただけでなく、己すら見つめることをやめた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200531
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200531,
					"content": "何百年もの間、ここで一人…寂しかったじゃろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200532
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200532,
					"content": "しかし、これは必要なことで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200533
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 20200533,
					"content": "前へ進まなければ、逃すものも多いじゃろう…ここで永遠に留まる汝も、失い続けていると言えるのではないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200534
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200534,
					"content": "そんな孤独に耐えながら、その時間軸を永遠のために無限まで伸ばすなんぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200535
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200535,
					"content": "妾に話せ、なぜここの空がかつてあれほどまでに暗く淀み…そしてなぜ、いま再び光を放っているのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200536
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200536,
					"content": "ここは汝の「一心浄土」、汝の内なる世界。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200537
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200537,
					"content": "であれば…もうとっくにここの孤独に耐えられず、本心では妾に会えて嬉しく思っておるのではないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200538
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200538,
					"content": "私は…何も言うことはありません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200539
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 20200539,
					"content": "ふふ、妾にはあるぞ、数えきれぬほどの話が。そうじゃ、せっかくじゃからここ数百年間の出来事を汝に話そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200540
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200540,
					"content": "数百年もの出来事を話すなんて、どれほどの時間を使うつもりですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200541
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 20200541,
					"content": "仙狐の記憶力はいいんじゃ。数百年の些細なことまで覚えておるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200542
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200542,
					"content": "じゃから、話すのにも数百年かかるじゃろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200543
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200543,
					"content": "ふ…ふふっ…神子、実はもう…こうして会うことは二度とないと思っていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200544
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 20200544,
					"content": "あなたに会えたのは、永遠の中に生じた変数であり…驚きでもあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200545
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 20200545,
					"content": "ふふ、やっと素直に認めおったか、なら引き続き友でいてやってもいいぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200546
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200546,
					"content": "まったく、子供じみた会話ですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200547
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 20200547,
					"content": "ですが、あなたたちの計画に負けたからには、あなたたちの意志に従って、目狩り令を廃止しましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200548
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 20200548,
					"content": "しかし「永遠」について、この国が果たして前へ進むべきかどうかについては、再び考える必要があります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200549
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 20200549,
					"content": "ふふ、最初から最後まで、子供じみていたのは汝の方じゃったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200507,
					"content": "神の予想すら超えることができる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200509
					]
				},
				{
					"id": 20200508,
					"content": "そして、神に取って代わることさえも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200509
					]
				}
			]
		},
