			"dialogs": [
				{
					"id": 20210101,
					"content": "雷電将軍の「一心浄土」でなにやってたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20210102,
					"content": "目狩り令が本当に廃止になるなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210103,
						20210104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20210103,
					"content": "八重神子のおかげ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210105
					]
				},
				{
					"id": 20210105,
					"content": "そうなのか…オイラ心配してたんだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20210106,
					"content": "さっき神子がオイラたちのことを呼んでたぞ、お礼を言うためかな？えへへ…早く行ってみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20210104,
					"content": "人々の願いが届いた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210105
					]
				}
			]
		}
	]
