			},
			"dialogs": [
				{
					"id": 401111501,
					"content": "#「西風騎兵隊長VS天才不敗少年{NON_BREAK_SPACE}湖の都で新鋭登場」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111502
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 401111502,
					"content": "うーん、この見出しだと、見栄えは十分だけど「インパクト」が足りないかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111503
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 401111503,
					"content": "#「西風騎士団トップレベルの頭脳派{NON_BREAK_SPACE}僅か5ラウンドで橋の少年に敗れたり」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111504
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 401111504,
					"content": "「麦の穂のような輝かしい逆転勝利」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111505
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 401111505,
					"content": "うん、やっぱり、最初の案を採用しようかしら…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シャルロット"
				}
			]
		},
