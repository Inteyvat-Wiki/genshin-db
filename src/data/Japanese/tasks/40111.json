			"trigger": {
				"objectNames": [
					"シャルロット",
					"千"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401113301,
					"content": "すみません、フォンテーヌから来た「スチームバード新聞社」の記者、シャルロットという者なのですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113302
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 401113302,
					"content": "少しお時間をいただいてもよろしいでしょうか？簡単なインタビューをさせてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113303
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 401113303,
					"content": "はぁ、まあいいけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113304
					],
					"speakerTitle": "千"
				},
				{
					"id": 401113304,
					"content": "あなたは連戦連勝を重ねてきましたが、最後の大一番で往生堂の堂主胡桃に敵わず、優勝を逃してしまいました。相当無念だったとお見受けします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113305
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 401113305,
					"content": "試合の感想をお聞かせいただけないでしょうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113306
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 401113306,
					"content": "…それは——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113307
					],
					"speakerTitle": "千"
				},
				{
					"id": 401113307,
					"content": "記者さん、君が欲しいのは新聞に載せるような答えか？それとも私の本音だろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113308
					],
					"speakerTitle": "千"
				},
				{
					"id": 401113308,
					"content": "もちろん、あなたの本音です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113309
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 401113309,
					"content": "はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113310
					],
					"speakerTitle": "千"
				},
				{
					"id": 401113310,
					"content": "札遊びというものは、七割が技術で三割が運だという…だが、一振りで同じ色のサイコロを六個も揃えられるなんて…ただの冒険者である私が…いや、たとえ私が仙人だったとしても、勝てるわけないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "千"
				}
			]
		},
		{
			"id": 4011151,
			"completionStepIds": [],
