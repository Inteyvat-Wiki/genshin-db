			},
			"dialogs": [
				{
					"id": 401115301,
					"content": "綺良々が彼女のことを「妖狐様」って呼んでるのって、何か訳でもあるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115302
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 401115302,
					"content": "詳しく教えてくれないかしら。いつか原稿を書く時に役立つかもしれないから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115303
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 401115303,
					"content": "えっ？いざそれを話すとなると、何か間違ったことを言っちゃわないか不安になってきた。何しろ、わたしってまだ妖怪としての歴がぜんぜん浅いから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115304
					],
					"speakerTitle": "綺良々"
				},
				{
					"id": 401115304,
					"content": "そっか、それじゃあ、油揚げと狐って何の関係があるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115305
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 401115305,
					"content": "もう…きみがそんなこと聞くからお腹が空いてきちゃったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115306
					],
					"speakerTitle": "綺良々"
				},
				{
					"id": 401115306,
					"content": "稲妻の油揚げラーメンを食べに行こう。食べながら説明してあげるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "綺良々"
				}
			]
		}
	]
