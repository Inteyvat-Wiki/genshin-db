					}
				]
			},
			"dialogs": [
				{
					"id": 401113101,
					"content": "そういえば、北斗姉さんも「七聖召喚」ってできるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113102
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 401113102,
					"content": "うむ、姉君の腕前は南十字船隊の中でも一、二を争うものでござるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113103
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 401113103,
					"content": "じゃあさ、もしよかったら私に紹介してくれないかな？前々から北斗姉さんには憧れてて、友達になりたいと思ってたんだ。でも、なかなかその機会がなくって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113104
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 401113104,
					"content": "構わぬでござるよ。ただ、その時はどうかお手柔らかに頼むでござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "楓原万葉"
				}
			]
		},
		{
			"id": 4011132,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
