			"trigger": {
				"objectNames": [
					"荒瀧一斗",
					"久岐忍"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401115101,
					"content": "狐女とあのなんとかの宮のなんとか海の試合を見て、俺様も燃えてきたんだ！額にある汗もふつふつと沸き立ってやがる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115102
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401115102,
					"content": "はいはい。親分がどんだけ興奮しているかは、離島中のみんなが知っているはずだ。けど、荒瀧派のみんながまだ待っている、そろそろ帰ろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115103
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 401115103,
					"content": "ちょっと待ってくれ、もう少しくらい待たせたって大丈夫だろ。最後の最後に、ダチ公と一勝負してぇんだ…これしきの頼み、別に構わねぇだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115104,
						401115107
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401115104,
					"content": "それじゃあ、一勝負しよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401115105
					]
				},
				{
					"id": 401115105,
					"content": "ダチ公！やっぱりお前こそ俺様の本当の親友だ！燃え盛る俺様の札遊び魂を分かってくれるヤツは、お前ぇしかいねぇ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115106
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401115106,
					"content": "…まったく、しょうがないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 401115107,
					"content": "今回はやめておく。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401115108
					]
				},
				{
					"id": 401115108,
					"content": "…くっ、分かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115109
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401115109,
					"content": "漢たるもの、泣くべからず。お前を責めたりなんかしねぇぞ、ダチ公！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "荒瀧一斗"
				}
			]
		},
