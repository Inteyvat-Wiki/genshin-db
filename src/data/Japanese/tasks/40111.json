				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凝光"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401113201,
					"content": "「七聖召喚」の民間大会がかなり盛り上がっていると聞いたわ。札遊びが好きなプレイヤーの中には、公式と民間の大会両方に申し込んでいる人も多くいるそうよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113202
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 401113202,
					"content": "私の場合…たまに流行に乗るのも悪くないけど、やっぱり棋戯のほうが性に合っているわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113203
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 401113203,
					"content": "そもそも、これらの遊戯はただ形式が違うだけ。友人との集いのほうこそが、より貴重なものよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凝光"
				}
			]
		},
		{
			"id": 4011133,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
