			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ガイア"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401111301,
					"content": "よっ、まだ何か話したいことでもあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111302,
						401111306,
						401111310
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401111302,
					"content": "「七聖召喚」について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401111303
					]
				},
				{
					"id": 401111303,
					"content": "最近、このカードゲームは本当に大人気でな。まるで生活の一部になってるみたいだ。どこに行っても遊んでる人がいる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111304
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401111304,
					"content": "そして、ゲーム中に頭の回転を鈍らせないために、酒をやめたっていう人まで現れた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111305
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401111305,
					"content": "ふふ、ディオナが知ったら喜ぶだろうな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111306,
						401111310
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401111306,
					"content": "騎士団のみんなについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401111307
					]
				},
				{
					"id": 401111307,
					"content": "安心しろ、みんな元気にしてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111308
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401111308,
					"content": "一緒にカードゲームをやろうとジンを誘ったことがあるんだが、その日は結局途中で呼び出されちまってな、残りは俺一人でやることになった。まあ、仕方ないさ。人には「それぞれの役割」があるからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111309
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401111309,
					"content": "でも今回の大会が成功して、みんなが楽しんでるところを見れば、ジンもほっとするだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111302,
						401111310
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401111310,
					"content": "またいつか。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401111311
					]
				},
				{
					"id": 401111311,
					"content": "ああ、機会があったら、お前とも「七聖召喚」をやりたいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ガイア"
				}
			]
		},
