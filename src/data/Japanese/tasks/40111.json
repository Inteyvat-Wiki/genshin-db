				"points": []
			},
			"dialogs": [
				{
					"id": 401115201,
					"content": "九条さん、少しお時間よろしいでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115202
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 401115202,
					"content": "ああ、優勝おめでとう、珊瑚宮心海。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115203
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 401115203,
					"content": "九条さんが助言してくれたおかげです、本当にありがとうございました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115204
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 401115204,
					"content": "気にするな。それに勝敗を左右するのは、互いの腕と策略があってのこと、それは誰もが知っている。とにかく、素晴らしい戦いだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115205
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 401115205,
					"content": "九条さんが参加していなかったのが実に残念です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115206
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 401115206,
					"content": "きっとお前には勝てないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115207
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 401115207,
					"content": "そんなことありませんよ。九条さんも私と同じなのではないでしょうか——対局で腕を磨いたり、対策を講じたり、他のプレイヤーと友人のように手合わせしたりするのを期待しているのでは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115208
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 401115208,
					"content": "…そうかもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115209
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 401115209,
					"content": "分かった。ならば、お前が鳴神島を離れる前に「七聖召喚」で一戦交えよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115210
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 401115210,
					"content": "ええ、喜んで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚宮心海"
				}
			]
		},
