			"dialogs": [
				{
					"id": 401111401,
					"content": "さっきの試合、素晴らしかったな。あのティミーくんだが…すごいポテンシャルを持ってやがる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111402
					],
					"speakerTitle": "アイヒェンドルフ"
				},
				{
					"id": 401111402,
					"content": "まさか本当にティミーくんが勝つとはね…私も…負けて惜しくはない、栄誉ある敗北だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "レナード"
				}
			]
		},
