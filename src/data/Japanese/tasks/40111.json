					"ティミー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401111101,
					"content": "ボクが勝ったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111102,
						401111106
					],
					"speakerTitle": "ティミー"
				},
				{
					"id": 401111102,
					"content": "おめでとう、ティミー！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401111103
					]
				},
				{
					"id": 401111103,
					"content": "ありがとう。これで、ママも喜んでくれるかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111104
					],
					"speakerTitle": "ティミー"
				},
				{
					"id": 401111104,
					"content": "大会に出るよう、グレイスママがボクの背中をずっと押してくれてたんだ。だから、賞品はすべてママに贈るつもり！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111105
					],
					"speakerTitle": "ティミー"
				},
				{
					"id": 401111105,
					"content": "今のボクの姿を、パパにも見てもらえたらな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ティミー"
				},
				{
					"id": 401111106,
					"content": "さようなら。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401111107
					]
				},
				{
					"id": 401111107,
					"content": "うん、バイバイ。「七聖召喚」って楽しいなぁ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ティミー"
				}
			]
		},
		{
			"id": 4011112,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4011101",
							"2"
						],
						"stepId": 4011101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ミカ",
					"ホフマン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401111201,
					"content": "もう終わった？お、遅れちゃった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111202
					],
					"speakerTitle": "ミカ"
				},
				{
					"id": 401111202,
					"content": "ミカ、見られなくて残念だったな。ガイア隊長が…まさか負けるとは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111203
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 401111203,
					"content": "ええっ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111204
					],
					"speakerTitle": "ミカ"
				},
				{
					"id": 401111204,
					"content": "兄さん、一体何があったの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111205
					],
					"speakerTitle": "ミカ"
				},
				{
					"id": 401111205,
					"content": "ああ、俺は「七聖召喚」にあんまり詳しくないから、みんなの話を聞きながら戦況を理解したんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111206
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 401111206,
					"content": "最初、ガイア隊長はすぐ相手のカードを一枚倒して、優位に立ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111207
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 401111207,
					"content": "でも、それはどうやら相手の戦略だったらしい。あのティミーという子は、前の数ラウンドで集めた手札を使い…最後に驚くべき威力で畳み掛けた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111208
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 401111208,
					"content": "いや…あの勝負はそもそも、ガイア隊長が「後手」を引いた時点で、既に決まっていたのかもしれない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111209
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 401111209,
					"content": "はぁ、一杯やりたくなってきた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111210
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 401111210,
					"content": "兄さん、落ち着いて。今はやけ酒している場合じゃないでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111211
					],
					"speakerTitle": "ミカ"
				},
				{
					"id": 401111211,
					"content": "僕の知っているガイア隊長なら、自分のために悲しむ顔なんて見たくないと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111212
					],
					"speakerTitle": "ミカ"
				},
				{
					"id": 401111212,
					"content": "それより僕たちもカードゲームを覚えてみよ？次はガイア隊長と対戦できるかもしれないし！へへ…ひどく負けちゃいそうだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111213
					],
					"speakerTitle": "ミカ"
				},
				{
					"id": 401111213,
					"content": "ああ、その通りだな、ミカ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ホフマン"
				}
			]
		},
		{
			"id": 4011113,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
