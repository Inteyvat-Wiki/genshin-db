			},
			"dialogs": [
				{
					"id": 766550101,
					"content": "フリンズ、来てくれたんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766550102,
					"content": "お疲れ様です。あなたたちのおかげで、灯台が息を吹き返したようですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550103
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 766550103,
					"content": "へへっ、お安い御用だぜ。でも、オイラたちがいくら頑張っても、灯台の明かりが届かない場所はあるし、相変わらず暗いな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766550104,
					"content": "そうですね。外の世界と違って、この墓場は永遠に夜に留まっているかのようです——あの戦いが終わった夜に。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550105
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 766550105,
					"content": "僕はこの環境を変えたいと思っていませんでしたが、あなたたちが灯台を灯してくれたおかげで、時間が動き出した気がします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550106,
						766550108
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 766550106,
					"content": "フリンズの暮らしに影響はない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766550107
					]
				},
				{
					"id": 766550107,
					"content": "僕に迷惑をかけたのでは、と心配されているのでしたら、どうかご安心ください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550110
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 766550110,
					"content": "命とは輪廻するものです。僕たちがいなくても、島の亡霊たちは少しずつ消えていき、いずれ地脈へと還ります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550111
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 766550111,
					"content": "ですから、島全体を照らせなかったからといって、残念に思わないでください。亡霊の数が減っていけば、島を覆っている霧も薄れていくでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550112
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 766550112,
					"content": "太陽は必ず昇るものです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 766550108,
					"content": "そんなつもりじゃ…ごめん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766550109
					]
				},
				{
					"id": 766550109,
					"content": "どうか謝らないでください。こういう変化は嫌いじゃありませんから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550110
					],
					"speakerTitle": "フリンズ"
				}
			]
		}
	]
}