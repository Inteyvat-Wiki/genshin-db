			"trigger": {
				"objectNames": [
					"アランラジャ",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730470101,
					"content": "#ナラ{NICKNAME}、パイモン、また会ったの。ほっほっほ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470102
					],
					"speakerTitle": "アランラジャ"
				},
				{
					"id": 730470102,
					"content": "アランラジャ、なんだか楽しそうだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730470103,
					"content": "ほっほっほ…こんなにたくさんのアランナラが帰ってきてくれて、ヴァナラーナがにぎやかになって本当に楽しいんじゃよ。いやはや、ワシ自身がウツァヴ祭に参加できるとは思わなんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470104,
						730470105
					],
					"speakerTitle": "アランラジャ"
				},
				{
					"id": 730470104,
					"content": "参加したことなかったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730470107
					]
				},
				{
					"id": 730470107,
					"content": "ワシの物語の中で、かつて一度だけ参加したことがある。ただ、それはずいぶんと昔の物語じゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470108
					],
					"speakerTitle": "アランラジャ"
				},
				{
					"id": 730470108,
					"content": "ワシ、アランムフクンダ、アランラナ、アランジ…ワシらは多くのアランナラ、そしてナラヴァルナと共にウツァヴ祭を祝った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470109
					],
					"speakerTitle": "アランラジャ"
				},
				{
					"id": 730470109,
					"content": "それはとても辛い時期じゃった。じゃが、ウツァヴ祭の間だけは、みんな笑って歌っておった。ワシはこの物語が大好きじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470110
					],
					"speakerTitle": "アランラジャ"
				},
				{
					"id": 730470110,
					"content": "あれ？だったらアランラジャは参加したことがあるんじゃないか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730470111,
					"content": "うむ、物語の中では、確かに参加した。ただし、ワシはもう覚えておらん。その物語は、アランラナたちが後でワシに教えてくれたものじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470112
					],
					"speakerTitle": "アランラジャ"
				},
				{
					"id": 730470112,
					"content": "うーん…アランラジャの話し方って、お爺ちゃんみたいだな。つまり、歳を取ったせいで忘れちゃったんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730470113,
					"content": "#それで間違ってはおらぬかもしれん…ときにナラ{NICKNAME}、パイモン、これを受け取ってくれんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470114
					],
					"speakerTitle": "アランラジャ"
				},
				{
					"id": 730470114,
					"content": "小さな花…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730470115,
					"content": "うむ。未来への旅の途中、この花がおヌシらと共にあらんことを。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470116,
						730470117
					],
					"speakerTitle": "アランラジャ"
				},
				{
					"id": 730470116,
					"content": "ありがたく受け取るよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730470118
					]
				},
				{
					"id": 730470118,
					"content": "ナラの時間はアランナラに比べあまりに貴重じゃ。これ以上足止めはできん。楽しんでいっておくれ。あとアランカヴィを訪ねてやってほしい。ウツァヴ祭の儀式の準備をしているはずじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランラジャ"
				},
				{
					"id": 730470117,
					"content": "ありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730470118
					]
				},
				{
					"id": 730470105,
					"content": "#{M#俺}{F#私}も楽しいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730470106
					]
				},
				{
					"id": 730470106,
					"content": "オイラも楽しいぜ！でも、アランラジャは今までウツァヴ祭に参加したことなかったんだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470107
					],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
}