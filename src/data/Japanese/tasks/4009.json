			},
			"dialogs": [
				{
					"id": 40091201,
					"content": "さて、見送りはここまでにしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40091202
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40091202,
					"content": "おう！えっと…ありがとな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40091203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 40091203,
					"content": "礼はいい。だが覚えておけ、情報を共有するかどうかはあんた次第だ。これからあんたが取る行動は、あいつらに影響を及ぼす可能性が高い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40091204
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40091204,
					"content": "#（つまり、{M#俺}{F#私}がメロピデ要塞の秘密を伝えるかどうかで、リネたちが次に取る行動は決まるということ。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40091205
					]
				},
				{
					"id": 40091205,
					"content": "（…もし真相をリネに伝える場合、争っている場合じゃないことを彼に理解してもらう必要がある。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40091206
					]
				},
				{
					"id": 40091206,
					"content": "おう、その辺はちゃんと考えるつもりだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40091207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 40091207,
					"content": "うん、そうする。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40091208
					]
				},
				{
					"id": 40091208,
					"content": "ああ、これからの展開を楽しませてもらうとしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リオセスリ"
				}
			]
		}
	]
