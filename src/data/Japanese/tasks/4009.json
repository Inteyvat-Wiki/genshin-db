			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"フレミネ",
					"リネット",
					"リネ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 40090101,
					"content": "リネ…えっと、ごめんなさい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090102
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 40090102,
					"content": "私もごめん、お兄ちゃん。もっと慎重に動くべきだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090103
					],
					"speakerTitle": "リネット"
				},
				{
					"id": 40090103,
					"content": "そんなこと言わないで。全部僕が悪いんだ…慎重にすべきだったのは僕のほうだよ。二人はあと少しで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090104
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 40090104,
					"content": "ぼくがもう少し有能だったら、今ごろ「公子」様を見つけられてたかもしれない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090105
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 40090105,
					"content": "違う、そんなこと言わないで！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090106
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 40090106,
					"content": "えっ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090107
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 40090107,
					"content": "あっ…ごめん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090108
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 40090108,
					"content": "つまり、私たちみんな慎重じゃなかった。そういうことでしょ？これは連帯責任だね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090109
					],
					"speakerTitle": "リネット"
				},
				{
					"id": 40090109,
					"content": "うん、そう！連帯責任！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090110
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 40090110,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090111
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 40090111,
					"content": "お兄ちゃん、心配してくれてるのは分かってる。私たちも今、お兄ちゃんのことが心配だもん。だから、そんな顔しないで…元気出して。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090112
					],
					"speakerTitle": "リネット"
				},
				{
					"id": 40090112,
					"content": "…ああ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リネ"
				}
			]
		},
