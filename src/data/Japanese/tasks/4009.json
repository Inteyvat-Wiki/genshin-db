			"dialogs": [
				{
					"id": 40090901,
					"content": "ここだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090902
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40090902,
					"content": "公爵！ちょうどいいところにいらっしゃいました。最新のデータはすでに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090903
					],
					"speakerTitle": "ジュリエ"
				},
				{
					"id": 40090903,
					"content": "待ってください、ジュリエ。他の人が！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090904
					],
					"speakerTitle": "ルールヴィ"
				},
				{
					"id": 40090904,
					"content": "あれ？ジュリエとルールヴィ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090905
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 40090905,
					"content": "慌てるな。この二人はもう俺らの計画を知ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090906
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40090906,
					"content": "何ですって？誰にも計画を漏らしてはいけないと、おっしゃっていましたよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090907
					],
					"speakerTitle": "ルールヴィ"
				},
				{
					"id": 40090907,
					"content": "そうですよ。それに、この人たちは信用できるんですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090908
					],
					"speakerTitle": "ジュリエ"
				},
				{
					"id": 40090908,
					"content": "結果はもう目に見えてるだろ？この二人はあんたらが思ってる以上に情報を知ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090909
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40090909,
					"content": "…分かりました。あなたがそこまでおっしゃるのなら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090910
					],
					"speakerTitle": "ジュリエ"
				},
				{
					"id": 40090910,
					"content": "…そうですね。二人から悪意は感じませんし…たぶん信じてもいいのでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090911
					],
					"speakerTitle": "ルールヴィ"
				},
				{
					"id": 40090911,
					"content": "さて、改めて紹介しよう。こいつはジュリエくん、フォンテーヌ科学院で最高位の研究員の一人だ。昔はエドウィンくんのもとで働いてた。あんたら、エドウィンくんのことは知ってるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090912,
						40090914
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40090912,
					"content": "知ってる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40090913
					]
				},
				{
					"id": 40090913,
					"content": "そりゃよかった。説明する手間が省けた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090916
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40090916,
					"content": "彼の専攻はアルケウムと重力機械だ。ジュリエくんはその助手で、関連技術が頭に入ってる。俺はジュリエくんを技術顧問として雇ってるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090917
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40090917,
					"content": "ま…まさか、メロピデ要塞を吹っ飛ばすつもりか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090918
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 40090918,
					"content": "ほう…そりゃ魅力的な言葉だな。つい想像したくなる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090919
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40090919,
					"content": "僕も、ちょっと心が動きかけたかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090920
					],
					"speakerTitle": "ジュリエ"
				},
				{
					"id": 40090920,
					"content": "皆さん、変なことを考えないように！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090921
					],
					"speakerTitle": "ルールヴィ"
				},
				{
					"id": 40090921,
					"content": "この真面目なのがルールヴィさん。同じく俺が雇った技術顧問だ。偶然にも、ジュリエくんはエドウィンくんの助手で、そして彼女は元々ジュリエくんの助手だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090922
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40090922,
					"content": "そんなことってあるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090923
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 40090923,
					"content": "どういう意図が？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40090924
					]
				},
				{
					"id": 40090924,
					"content": "見ろ、やっぱりみんなそれを聞く。あんたら、実は仕事を理由に逢い引きしたいだけなんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090925
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40090925,
					"content": "なっ…公爵、逢い引きだなんてありえません！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090926
					],
					"speakerTitle": "ルールヴィ"
				},
				{
					"id": 40090926,
					"content": "そうです！僕がとち狂わない限り！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090927
					],
					"speakerTitle": "ジュリエ"
				},
				{
					"id": 40090927,
					"content": "ああ、ああ、分かった。今のは聞かなかったことにしてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090928
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40090928,
					"content": "さっ、二人とも付いてこい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090929
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40090929,
					"content": "わっ、また上に開く扉だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090930
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 40090930,
					"content": "そう褒めるな。メロピデ要塞に対して、いらん自負が生まれてくる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090931
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40090931,
					"content": "へへっ…だって、本当にすごいと思ったから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090932
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 40090932,
					"content": "ここは普通の部屋？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40090933
					]
				},
				{
					"id": 40090933,
					"content": "では、もう少し手品を——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090934
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40090934,
					"content": "披露しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090935
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40090935,
					"content": "これは…！？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40090936
					]
				},
				{
					"id": 40090936,
					"content": "これって…船か？かなりデカいぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090937
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 40090937,
					"content": "それに、ここって見たことない生産エリアだよな…いったいどうなってるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090938
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 40090938,
					"content": "あんたらは、フォンテーヌの歴史についてどれくらい知ってる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090939
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40090939,
					"content": "えっと…あんまりよく知らないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090940
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 40090940,
					"content": "となると、レムリアの物語も知らないだろうな。ざっくり話そう——古代フォンテーヌはレムリア王朝の統治を受けていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090941
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40090941,
					"content": "言い伝えによると、レムリアの帝王レムスは天啓を受け、金の蜂に化身した予言者シビラを訪ねた。レムスは金の蜂と大船フォルトゥナ号と共に、海上に自分の国を建てたという。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090942
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40090942,
					"content": "彼はその国をレムリアと名付け、フォルトゥナ号に乗って新たな島や部落を探し回った。そして、その者たちに帝国の統治下に入るよう呼びかけた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090943
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40090943,
					"content": "その物語にも船が出てくるんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090944
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 40090944,
					"content": "ああ、水と関連する場所なら船は必ず出てくるもんだ。人々は船が希望へと導いてくれると信じてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090945
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40090945,
					"content": "じゃあ、おまえも信じてるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090946
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 40090946,
					"content": "俺は半々ってところだ。だが、あんたも知っての通り、俺は工場一つを動かせるほどの材料と技術、人材を持ってる。試してみても損はないさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090947
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40090947,
					"content": "あのゲートの下に胎海があるかもしれないと思い至った時から、俺はこの考えを持つようになった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090948
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40090948,
					"content": "つまり、その伝説のフォルトゥナ号に影響されたってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090949
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 40090949,
					"content": "天災を目前にして、フォンテーヌ人にはこういった手段が必要だからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090950,
						40090951
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40090950,
					"content": "こんな壮大な計画…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40090952
					]
				},
				{
					"id": 40090952,
					"content": "もしここの囚人どもが、この巨大な船の裏にある真実を知ったらどうなると思う？本物の災いが訪れる前に、メロピデ要塞で暴動が起きて壊滅するだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090953
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40090953,
					"content": "管理者である俺が、そんな考えなしの行動など認めるはずもない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090954
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40090954,
					"content": "さて、ずいぶんと会話も弾んだことだ。お茶を三杯は飲まないとな。他に聞きたいことはあるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090955
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40090955,
					"content": "どうやらないようだ。では、外まで送るとしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40090951,
					"content": "どうしてこっそりやってるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40090952
					]
				},
				{
					"id": 40090914,
					"content": "知らない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40090915
					]
				},
				{
					"id": 40090915,
					"content": "エドウィンくんは、爆発でフォンテーヌ科学院を丸ごと吹き飛ばした男だ。彼は頭のネジが抜けてることで有名だけど…まあ、君はこの国の人間じゃないし、知らなくてもおかしくないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090916
					],
					"speakerTitle": "ジュリエ"
				}
			]
		},
