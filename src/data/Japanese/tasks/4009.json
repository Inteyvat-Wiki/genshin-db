			"dialogs": [
				{
					"id": 40090201,
					"content": "今、いいかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090202
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 40090202,
					"content": "ああ、どうやらフレミネくんの容態は落ち着いたようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090203
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40090203,
					"content": "もちろん、じゃなきゃ医務室を離れたりしないのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090204
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 40090204,
					"content": "で、そっちの二人が来るのは想定してたんだが、看護師長は何しに？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090205
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40090205,
					"content": "クロリンデさんの様子を見に来たの。具合はどう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090206
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 40090206,
					"content": "ああ、特に問題はない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090207
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 40090207,
					"content": "できれば、一度診察させて。すぐ終わるから、このあと数分だけ時間をもらってもいい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090208
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 40090208,
					"content": "分かった、感謝する。じゃあ、私は先に——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090209
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 40090209,
					"content": "そろそろ弁解してくれるよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 40090210,
					"content": "くくっ、弁解？その言い方は気に入らないな。「説明」ってことでどうだい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090211
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40090211,
					"content": "詳しく聞かせて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40090212
					]
				},
				{
					"id": 40090212,
					"content": "だが、どこから話したものか…ああ、あんたらが最も知りたいことからにしよう。さあ、質問してくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090213
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40090213,
					"content": "おう…じゃあ聞かせてもらうぞ。おまえは、最初からリネたちの目的を知ってたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 40090214,
					"content": "いいや、彼らがファデュイに所属し、「召使」の命令でメロピデ要塞に潜入したことしか知らなかった。具体的な目的は、あんたらの行動が進むにつれて見えてきたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090215
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40090215,
					"content": "目的も知らなかったのに、わざわざ警戒してたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 40090216,
					"content": "彼らが現れた理由は決していいもんじゃない——俺はこういうのに鼻が利いてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090217
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40090217,
					"content": "どうして、彼らの行動を止めなかったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40090218
					]
				},
				{
					"id": 40090218,
					"content": "最初は、「公子」がなぜ失踪したのか調べるのが目的だと思ってたからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090219
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40090219,
					"content": "リネくんは、俺が彼を逃がしたと考えていたようだが…俺らは彼の行動を止めもしなければ、容認もしていなかったというのが正しい。「公子」は自ずと協力者を見つけて、自然と離れていったのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090220
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40090220,
					"content": "スネージナヤの執行官がフォンテーヌで失踪したとなれば、きっと「召使」はそれをネタにするだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090221
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40090221,
					"content": "俺も、あの執行官がどこに行ったのかちょうど気になっていた。どっちみち調べる必要があるのなら、ファデュイの人間に調べてもらったほうが得だろ？俺はただ、結果を待てばいいんだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090222
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40090222,
					"content": "漁夫の利、ってわけか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090223
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 40090223,
					"content": "別に構わないだろ？まあ、その後の状況が変わったのは少し残念だったが…おそらく、フレミネくんからも聞いてるはずだ——メロピデ要塞周辺の海水に変化が起きてるとな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090224
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40090224,
					"content": "「禁域」こそが、リネくんのもともとの調査目的。ここに来てから、あんたらもそれに巻き込まれることになった。だから、あんたらの身の安全とメロピデ要塞のトラブルを未然に防ぐため、俺も手を出し始めたってわけさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090225
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40090225,
					"content": "おまえが昔、犯罪者だったって噂は本当なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090226
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 40090226,
					"content": "何を言ってる？俺はメロピデ要塞の管理者であって、ずっとここにいる。服役するのと何ら変わりないだろ？ただここの者たちが、俺に服従してるだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090227
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40090227,
					"content": "そういえば、クロリンデは誰が呼んだんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090228
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 40090228,
					"content": "もちろん、俺だ。金を出して、彼女にメロピデ要塞まで出張に来てもらった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090229
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40090229,
					"content": "クロリンデさんは決闘代理人——つまり、第三の勢力だ。今後起こり得る危機をどうにかするには、ずば抜けた実力を持った助っ人が必要だったんでな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090230
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40090230,
					"content": "例えば、フレミネを助けるとかか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090231
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 40090231,
					"content": "ああ、そう理解してくれていい。フレミネくんは確かに優秀だ。あんなに劣悪な条件じゃなければ、今ごろ失踪した人に追いついてただろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090232,
						40090233
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40090232,
					"content": "「禁域」は本当に存在するの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40090234
					]
				},
				{
					"id": 40090234,
					"content": "それはあんたには関係ない。ヌヴィレットさんの依頼も、「公子」の行方を掴むことだけだったはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090235
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40090235,
					"content": "俺は、「禁域」が「公子」の失踪と関係ないことだけを証明すればいい。これに関しちゃ、フレミネくんはまさにその証人だろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090236
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40090236,
					"content": "けど、オイラたちの調査はもう医務室まで進んでたんだ。それに、おまえもさっきあれこれ質問しただろ…なのにオイラたちの最後の質問にはまだ答えてないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090237
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 40090237,
					"content": "おっと、悪い。そんなに答えが気になっていたとは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090238
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40090238,
					"content": "そりゃそうだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090239
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 40090239,
					"content": "たとえ、目を背けたくなるような真実であってもか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090240
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40090240,
					"content": "…うん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40090241
					]
				},
				{
					"id": 40090241,
					"content": "ついて来い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40090233,
					"content": "その中には何があるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40090234
					]
				}
			]
		},
