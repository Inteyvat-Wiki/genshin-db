			"dialogs": [
				{
					"id": 40090601,
					"content": "ここが「禁域」か？こんな奥まったところに隠してあるのに…見た感じ、特別なところはないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090602
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 40090602,
					"content": "あれは…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40090603
					]
				},
				{
					"id": 40090603,
					"content": "すごいデカい扉だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 40090604,
					"content": "これと似た扉が合計で三つある。通常であれば、誰も足を踏み入れられない区域だ…俺以外はな。その名の通り、まさに「禁域」ってわけさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090605
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40090605,
					"content": "だがあんたらはきっと、ここの情報をファデュイの子たちにも共有するんだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090606
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40090606,
					"content": "まあ、確かに隠そうとは思ってないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090607
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 40090607,
					"content": "ふっ、そうすべきかどうかは、ここを見てから決めるといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リオセスリ"
				}
			]
		},
