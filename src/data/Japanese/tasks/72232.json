			},
			"dialogs": [
				{
					"id": 722320601,
					"content": "「一刻も早く撤退するように。『ネイサン』の秘密報告書を回収した稲妻の新兵を首席執行官に引き渡しなさい。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320602
					],
					"speakerTitle": "バレンカの「指示」"
				},
				{
					"id": 722320602,
					"content": "「将来のトラブルを防ぐためにも、ヤシオリ島事件の内幕を明らかにしてはいけない。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320603
					],
					"speakerTitle": "バレンカの「指示」"
				},
				{
					"id": 722320603,
					"content": "「新兵自体は、『ファデュイ』の共通の目的にとって価値はない、訓練する必要もない。しかし、科学研究のための生きるサンプルとしては便利である。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "バレンカの「指示」"
				}
			]
		}
	]
