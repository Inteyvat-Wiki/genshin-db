			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"？？？",
					"思鶴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722320401,
					"content": "そこの平民たち、止まれ！身の安全のため、ここから立ち去るんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320402
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722320402,
					"content": "すみません、私たちは平民ではありません。それに、ここへ来たのには理由があります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320403
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320403,
					"content": "ファデュイの情報官と交渉しに来た。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722320404
					]
				},
				{
					"id": 722320404,
					"content": "何を言っているのか分からないな…ここは私有地だ、もう話しかけないでくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320405
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722320405,
					"content": "こんなに派手な服を着て、持っている武器は幕府軍のものとも珊瑚宮軍のものとも違う…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320406
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320406,
					"content": "すぐにでも逃げ出すような様子と怪しい者の表情…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320407
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320407,
					"content": "あなたたちはもっと偽装に力を入れた方がいいですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320408
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320408,
					"content": "俺が冗談を言うやつに見えるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320409
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722320409,
					"content": "#ええ、冗談はここまでにしましょう。私たちは蛇骨鉱坑から来ました。{NICKNAME}さん、彼に証明してください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320410
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320410,
					"content": "ワロタ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722320411
					]
				},
				{
					"id": 722320411,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320412
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722320412,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320413
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320413,
					"content": "ファデュイへようこそ。俺はお前たちの案内役、海務准尉のバレンカだ。これからは俺のことを「長官」と呼んでくれ、分かったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320414
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722320414,
					"content": "俸禄や職位を失った勘定奉行の元官員たちが、すぐに俺たちの欲しいものを手に入れるだろうと彼らから言われたのだが、まさかお前たち二人だけとは。もっと大勢の人がいると思ったぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320415
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722320415,
					"content": "一人は毒舌な巫女、もう一人は…外国人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320416
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722320416,
					"content": "お前たち武士じゃなかったのか？ふん、柊慎介のやつ、人を見る目は実に面白い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320417,
						722320418
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722320417,
					"content": "確かに。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722320419
					]
				},
				{
					"id": 722320419,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320420
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722320420,
					"content": "長官…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722320421
					]
				},
				{
					"id": 722320421,
					"content": "この前…経営陣が交代しました。だから結果的には、新しい仕事を得た人もいれば、海に落ちて何も残らない人もいるというわけです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320422
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320422,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320423
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722320423,
					"content": "長官…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320424
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320424,
					"content": "うん、そうだな。以前お前たちに何があったかはまったく興味がない、俺が欲しいのは結果だけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320425
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722320425,
					"content": "さあ、「ネイサン」が残した報告書を渡して、船に乗るんだ。簡単な命令だが、きちんと実行して欲しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320426
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722320426,
					"content": "これです…長官。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722320427
					]
				},
				{
					"id": 722320427,
					"content": "よし。お前たちのここでの仕事は終わった。他に質問は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320428
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722320428,
					"content": "長官、このあとまだ任務はありますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320429
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320429,
					"content": "俺には関係ない。俺はただ責任を持って、お前たちをスネージナヤまで送るだけだ。その後の行動は上の判断に任せる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320430
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722320430,
					"content": "上からは何も言われていないのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320431
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320431,
					"content": "お前には関係ないだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320432
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722320432,
					"content": "はい、長官のおっしゃる通りです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320433,
						722320434
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320433,
					"content": "（もうやっていい？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722320435
					]
				},
				{
					"id": 722320435,
					"content": "（もう少し待ってください。彼から情報をもっと聞き出したいです。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320436
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320436,
					"content": "俺はまだここにいるんだぞ。お前たち何をこそこそ話してんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320437
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722320437,
					"content": "すみませんが、今後実行する任務について詳しく知りたいので、ご説明いただけますでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320438
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320438,
					"content": "お前たちに任務を説明する義務はない。任務を実行するか、俺にお仕置きされてから実行するか、その二択だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320439
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722320439,
					"content": "すみません、伝わっていなかったかもしれませんね。私が言いたかったのは…コホン、「あなたの知っていることをすべて話してもらえませんか」、です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320440
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320440,
					"content": "何かを忘れていないか…新兵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320441
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722320441,
					"content": "何も忘れていません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320442
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320442,
					"content": "そのまったくの逆で、はっきりと覚えていますよ。隣にいるこの方が珊瑚宮の将領であることを。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320443
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320443,
					"content": "お前…珊瑚宮！？やはりそうだったのか…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320444
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722320444,
					"content": "ええ、あなた凄いですね…しかし、もう聞き飽きました！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320445
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320445,
					"content": "ヤシオリ島での秘密行動や、海祇島の急進派を煽って鎮め物を破壊させた証拠、主を失った武士と手を結んだ証拠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320446
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320446,
					"content": "それと先ほど、珊瑚宮の巫女に対する侮辱はすべて記録しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320447
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320447,
					"content": "最初のいくつかの事件は外交問題として珊瑚宮の記録に入るでしょう。そして最後の問題は、「長官」に責任を負って欲しいものです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320448
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320448,
					"content": "ちなみに、最初から忠告しましたが、あなたたちは偽装にもっと気をつけたほうがいいですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320449
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320449,
					"content": "#やってください、{NICKNAME}さん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320434,
					"content": "（まだおままごとを続けるの？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722320435
					]
				},
				{
					"id": 722320418,
					"content": "説明するのが難しい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722320419
					]
				}
			]
		},
		{
			"id": 7223205,
			"completionStepIds": [
				7223207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7223207",
							"2"
						],
						"stepId": 7223207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"思鶴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722320501,
					"content": "内情を知る人をためらいもなく犠牲にするとは…面白いですね。「ファデュイ」はこんな組織だったんですか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320502
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320502,
					"content": "全然面白くない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722320503
					]
				},
				{
					"id": 722320503,
					"content": "自分と違う考え方を持つ人は、私にとって面白い存在です。ただ、良い意味での面白いと、そうでないものがあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320504
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320504,
					"content": "あ、お忙しい中、現人神の巫女様のために事を解決していただき、ありがとうございました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320505
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320505,
					"content": "「ネイサン」という証拠を掴んだ今、「ファデュイ」に対する戦いはひとまず勝ったと言えるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320506
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320506,
					"content": "「ネイサン」について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722320507
					]
				},
				{
					"id": 722320507,
					"content": "モンド人と自称するあの人は…もしかしたら、本当にモンドで生まれたファデュイのメンバーかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320508
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320508,
					"content": "彼は「ファデュイ」の恐ろしさを見事に表現しています。正面からの戦闘ではなく、抜け目のない内部分裂によって状況をかき乱し、混乱に乗じて利益を得ることです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320509
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320509,
					"content": "彼らは、私たちの克服すべき障害が自分自身の中にあることを知っています…どんなに抑えようとしても、血で復讐するという悪質な考えを根絶することは困難です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320510
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320510,
					"content": "ですから、「義軍」を装い、共感できるスローガンを掲げて…冷たい心を持ったネイサンは、軍の中で最も過激な人たちを破滅に導きました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320511
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320511,
					"content": "もちろん、彼は無事に脱出することができませんでした。罰を受けましたが、私からすれば、暗い牢獄に放り込むだけでは罰として軽すぎる思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320512
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320512,
					"content": "あと、ヤシオリ島の住民たち…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722320513
					]
				},
				{
					"id": 722320513,
					"content": "そうですね。ネイサンの報告書にもありました。彼の目には、住民の命は報告書の中の単なる数字に過ぎません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320514
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320514,
					"content": "この災難は…恥ずかしながら、現人神の巫女様の計画をかき乱し、激しい争いを招きました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320515
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320515,
					"content": "しかし、私たちは人々の心を救い、平和を勝ち取ることができたのです。生き残った私たち一人一人が亡くなった人たちの意志に応え…過ちを改めながらこの地に立つことができました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320516
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320516,
					"content": "「戦争は苦く涙の川であり、渡る船はなく、激しい勢いで流れゆく。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320517
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320517,
					"content": "これは我々の氏族の島唄の一節…現人神の巫女様が戦争を好まないのは、もしかしたらこのことが原因なのかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320518
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320518,
					"content": "残念ですが、哲平がこれを一緒に見届けることはできませんでした…本当に…残念です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320519
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320519,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320520
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320520,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722320521
					]
				},
				{
					"id": 722320521,
					"content": "コホンッ…ファデュイはきっと、この短期間に消えた前哨を調査するために戻ってくるでしょう。しかし、珊瑚宮を狙ってくるような愚か者ではないはずです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320522
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320522,
					"content": "もちろん、このようなことは私より、現人神の巫女様のほうがより先のことを見ています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320523
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320523,
					"content": "とにかく…悲しいことは置いといて、ファデュイ残党の件は解決できましたね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320524
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320524,
					"content": "あ、美味しいうなぎの蒲焼を知っていますので、今度一緒に食べに行きませんか？「メカジキ」二番隊の「長官」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "思鶴"
				}
			]
		},
