	"talks": [
		{
			"id": 7223201,
			"completionStepIds": [
				7223201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7223201",
							"2"
						],
						"stepId": 7223201,
