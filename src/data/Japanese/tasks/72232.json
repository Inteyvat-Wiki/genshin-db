			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"思鶴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722320101,
					"content": "#こんにちは、{NICKNAME}さん。今お時間よろしいでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320102
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320102,
					"content": "お邪魔して申し訳ありませんが、緊急事態なんです…現人神の巫女様が、あなたを見つけるよう指示しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320103,
						722320105
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320103,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}は「メカジキ」二番隊の隊長だからね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722320104
					]
				},
				{
					"id": 722320104,
					"content": "おっしゃる通りです。この件もあなたなら、見事に成し遂げられるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320106
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320106,
					"content": "あなたのおかげで、私たちは幕府との戦いに逆転することができました。現状から見れば、長期的な休戦が続くでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320107
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320107,
					"content": "私たちは平和を取り戻し、「目狩り令」を阻止しました。搾取してきた悪奉行が倒され…大御神の遺骨も安らぎを得ました。これらはすべて、あなたのおかげです。改めて礼を言わせてください…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320108
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320108,
					"content": "しかし、ファデュイの残党は未だヤシオリ島周辺での偵察を諦めていません。たとえ戦争で一人の「執行官」を失い、もう一人の「執行官」が行方不明になったとしても…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320109
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320109,
					"content": "ファデュイについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722320110
					]
				},
				{
					"id": 722320110,
					"content": "海祇島は長い間、情報が遮断されており、この戦争が彼らと接触するきっかけを作ったと言っても過言ではありません。このような形で出会うのは最悪の状況でした…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320111
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320111,
					"content": "彼らは戦争を長引かせようとしています。双方の憎しみを煽って戦争の激しさを増やしています…幕府よりも危険な敵です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320112
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320112,
					"content": "もし戦争が長期化すれば、それによって引き起こされる深刻な経済的困窮と社会的緊張は、両陣営の隙間を縫う「ファデュイ」の影響拡大を大いに促進するでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320113
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320113,
					"content": "幸い、現人神の巫女様が彼らの詭計を見抜き、あなたを始めとする多くの兵士たちが戦った結果…ファデュイの計画を阻止することができました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320114
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320114,
					"content": "どうすればいい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722320115
					]
				},
				{
					"id": 722320115,
					"content": "情報によると、ヤシオリ島にはまだファデュイに洗脳された幕府軍が潜んでいて、情報収集や何かを企んでいるらしいです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320116
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320116,
					"content": "現人神の巫女様から、この件に関してはあなたが最適な方と言われました。あなたにお願いするしかありません…大御神が殉職された場所に行き、その人たちを一緒に探していただけますでしょうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320117
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320117,
					"content": "まずは私が話をしてみます。それでも悔い改めようとしないのであれば、あなたに、力ずくで彼らを止めていただきたいと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320118
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320118,
					"content": "そんな簡単なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722320119
					]
				},
				{
					"id": 722320119,
					"content": "簡単…ですか？さすがです、これくらいは大したことではないのですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320120
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320120,
					"content": "ただ、難しいのは…あなたがあまりにも有名で、相手にばれてしまう可能性があることです。突然のことで、変装する時間もありませんし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320121
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320121,
					"content": "これがある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722320122
					]
				},
				{
					"id": 722320122,
					"content": "質素な変装ですね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320123
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320123,
					"content": "#うぅ、なぜか分かりませんが、私もあなたに気づきませんでした。「メカジキ」二番隊の隊長{NICKNAME}と比べると、オーラが明らかに違います…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320124
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320124,
					"content": "それでは、準備ができましたら出発しましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320105,
					"content": "何があったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722320106
					]
				}
			]
		},
		{
			"id": 7223202,
			"completionStepIds": [
				7223202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7223202",
							"2"
						],
						"stepId": 7223202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"橫暴な武士",
					"思鶴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722320201,
					"content": "止まれ、庶民！ここは幕府の所轄、無関係な人はさっさと立ち去れ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320202
					],
					"speakerTitle": "橫暴な武士"
				},
				{
					"id": 722320202,
					"content": "庶民？私は珊瑚宮の特使として、大御神が殉職された場所の現状を視察するために来た思鶴です。上司から聞いていないのでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320203
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320203,
					"content": "珊瑚宮の人？いや、知らされていない。速やかに去るが良い！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320204
					],
					"speakerTitle": "橫暴な武士"
				},
				{
					"id": 722320204,
					"content": "これでは、双方の休戦協定と矛盾してしまいます。武士さん、名乗ってください。あなたの無礼をあなたの上司に伝えます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320205
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320205,
					"content": "悪いが、そんな必要はないと思うぜ、珊瑚宮の姉ちゃん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320206
					],
					"speakerTitle": "橫暴な武士"
				},
				{
					"id": 722320206,
					"content": "それよりも、鉱坑には近づかない方がいい。もしこれ以上挑発するなら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320207
					],
					"speakerTitle": "橫暴な武士"
				},
				{
					"id": 722320207,
					"content": "休戦協定を破った罪が、一般人には背負いきれないものだということを、知ることになるぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320208
					],
					"speakerTitle": "橫暴な武士"
				},
				{
					"id": 722320208,
					"content": "その通りです。休戦協定を破った罪は、一般人には背負いきれないもの…だからこそ、神体を冒涜するのをやめ、大御神が殉職した場所から去っていただきたいのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320209
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320209,
					"content": "はっ！「神体」？「殉職した場所」？ふんっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320210
					],
					"speakerTitle": "橫暴な武士"
				},
				{
					"id": 722320210,
					"content": "ええ。私たちはすでに、あなたたちがここから規律よく離れられるための十分な時間を与えました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320211
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320211,
					"content": "ハハッ、海祇島の人たち、面白いことを言う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320212
					],
					"speakerTitle": "橫暴な武士"
				},
				{
					"id": 722320212,
					"content": "これが、お前たちの戦う目的か？死んだ神のために？言っておくが、お前たちの大蛇はな、とっくに鉱坑の光る石になって、我々の剣になったんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320213
					],
					"speakerTitle": "橫暴な武士"
				},
				{
					"id": 722320213,
					"content": "昔は大蛇に屈していたんだろう？だったら今は大蛇の遺骨で鋳造された剣に屈すれば、どちらも同じ運命だと思わないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320214
					],
					"speakerTitle": "橫暴な武士"
				},
				{
					"id": 722320214,
					"content": "武士さん、言葉には気をつけてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320215
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320215,
					"content": "俺たちもお前たちに選択肢を与えてるんだ、そうだろ？将軍様についていくのが嫌なら、従順な庶民として生きるのは当然じゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320216
					],
					"speakerTitle": "橫暴な武士"
				},
				{
					"id": 722320216,
					"content": "当時、将軍様の情けで生かされていたのに、今度は恩を仇で返すとは…一時的な抵抗が自分たちに良い結果をもたらせるとでも思ってるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320217
					],
					"speakerTitle": "橫暴な武士"
				},
				{
					"id": 722320217,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320218
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320218,
					"content": "ふん、自分のやったことをよく見ろ…「目狩り令」を覆してどれだけの命を奪った？どれだけの税源を奪った！？税源がなくなった今、俺らは何を食えばいいと言うんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320219
					],
					"speakerTitle": "橫暴な武士"
				},
				{
					"id": 722320219,
					"content": "柊様がお前たちのせいで退位されなかったら、俺たちまともな武士もこんな無様な生き方をしなくて済んだはずだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320220
					],
					"speakerTitle": "橫暴な武士"
				},
				{
					"id": 722320220,
					"content": "いや、なぜ俺がお前たちにこんなことを話している…島の貧しい田舎者は、やはり何もわかっていない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320221
					],
					"speakerTitle": "橫暴な武士"
				},
				{
					"id": 722320221,
					"content": "とにかく、お前たちの顔を見るだけでうんざりだ。喧嘩を売るつもりがないなら…さっさと立ち去れ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320222
					],
					"speakerTitle": "橫暴な武士"
				},
				{
					"id": 722320222,
					"content": "「柊様」…ですか。ふふ、私は休戦協定を破るつもりはありません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320223
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320223,
					"content": "ただ、現人神の巫女様から与えられた任務は、平和を乱そうとする者を一掃することです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320224
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320224,
					"content": "#{NICKNAME}さん、もう手を上げていいですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320225,
						722320227
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320225,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722320226
					]
				},
				{
					"id": 722320226,
					"content": "なに…お前…敵襲だ！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "橫暴な武士"
				},
				{
					"id": 722320227,
					"content": "でも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722320228
					]
				},
				{
					"id": 722320228,
					"content": "とにかく、まずは彼を征服してください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320229
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320229,
					"content": "やはりな…敵襲だ！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "橫暴な武士"
				}
			]
		},
		{
