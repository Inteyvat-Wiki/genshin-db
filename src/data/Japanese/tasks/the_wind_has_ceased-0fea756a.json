			"dialogs": [
				{
					"id": 700650101,
					"content": "まったく、死に急ぐ奴には何を言っても無駄だのう。今は山には入るなと言っておろうに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650102
					],
					"speakerTitle": "マーオン"
				},
				{
					"id": 700650102,
					"content": "まあまあ、マーオンさん、そう熱くならずに。落ち着いて話そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650103
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 700650103,
					"content": "さっきまでは私と「闇夜の露」で仲良く話してたのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650104
					],
					"speakerTitle": "レブハルト"
				},
				{
					"id": 700650104,
					"content": "私が風止みの山に行くって聞いたとたん、私を掴んで離さなくなっちゃって…揉めてるうちに、こんなところまで来ちゃった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650105
					],
					"speakerTitle": "レブハルト"
				},
				{
					"id": 700650105,
					"content": "あれ、ホフマンじゃないか！なんだ、なにかあったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700650106,
					"content": "見ての通り、マーオンさんが風止みの山には近づかないよう、みんなを説得しているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650107
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 700650107,
					"content": "紹介するよ。こちらは冒険者のレブハルトだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650108
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 700650108,
					"content": "わしはあそこで恐ろしい目にあったんじゃ！聞きたいか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650109
					],
					"speakerTitle": "マーオン"
				},
				{
					"id": 700650109,
					"content": "はぁ、この調子じゃ今日は帰れそうにないや。はいはい、聞いてあげる。さっきの酔っ払いの戯言の続きだと思って…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650110
					],
					"speakerTitle": "レブハルト"
				},
				{
					"id": 700650110,
					"content": "で、何がどう危険なの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650111
					],
					"speakerTitle": "レブハルト"
				},
				{
					"id": 700650111,
					"content": "療養所には本当に幽霊がいるんじゃ！この目で見たんじゃ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650112
					],
					"speakerTitle": "マーオン"
				},
				{
					"id": 700650112,
					"content": "ゆ、幽霊…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700650113,
					"content": "昨日の夜…こんなことがあったんじゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マーオン"
				}
			]
		}
	]
