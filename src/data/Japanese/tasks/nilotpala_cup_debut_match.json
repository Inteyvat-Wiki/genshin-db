				"points": []
			},
			"dialogs": [
				{
					"id": 400821401,
					"content": "そっち、たくさんの人が集まってるぞ。なにかを見てるみたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400821402,
					"content": "観客たちが自由にコメントして交流できるように、主催側がいくつかの掲示板を用意したみたい。確かに大会の人気を盛り上げられそうだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821403
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400821403,
					"content": "私とテンテンヨーヨー獣のことも、皆に討論されるかな？この経歴が論文に使えたらよかったんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821404
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400821404,
					"content": "いいと思うぞ！論文にはたくさんの資料が必要だって聞いたしな…考えただけで頭が痛くなるぜ。レイラは今、資料提供者になったんだから、好きなだけ書けばいいよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400821405,
					"content": "素敵な発想だけど…私は明論派の学生で、この資料を使うのは生論派くらいかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821406,
						400821407
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400821406,
					"content": "分野が変われば知識も一新する。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400821408
					]
				},
				{
					"id": 400821408,
					"content": "うん…レイラは生論派の学生に資料を提供できるだろ？もしかしたら、モラ…あっいや、資料代が稼げるかもしれないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821409
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400821409,
					"content": "モラはともかく…まあ、交換材料として、生論派の学生に程度の高い文献を調べてもらえば、テンテンヨーヨー獣の仲間が何を好むものなのか、とかが分かるかもね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821410
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400821410,
					"content": "範囲が絞られて、一気に楽になったよ。じゃないと、百種類以上のものを買って、一つ一つテンテンヨーヨー獣に試食させることになったかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821411
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400821411,
					"content": "想像しただけで、疲れて気絶しちゃいそう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821412
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400821412,
					"content": "そんな発想もあるのか！さすがだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400821413,
					"content": "じゃあ、ポコポコビーニーの好みも頼んでいいか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821414
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400821414,
					"content": "うん、頑張ってみるね…帰ったらすぐ手紙を書いて、アムリタ学院に届けてもらうよう頼むから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821415
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400821415,
					"content": "（セノの部下？会場を監視してる…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400821416
					]
				},
				{
					"id": 400821416,
					"content": "童よ、ベスト32の対戦表が公開されたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821417
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400821417,
					"content": "えっ？もう次の対戦で、左右加さんと対決するのかよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821418
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400821418,
					"content": "うふふっ…一番期待しておった場面じゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821419
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400821419,
					"content": "なんでそんなに嬉しそうなんだよ！すっごく期待してた作者がオイラたちに負けるのが怖くないのか？もしそうなったら、八重堂のスメールでの旅は終わっちゃうんだぜ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821420
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400821420,
					"content": "手加減はするでないぞ？左右加に優勝などは望んでおらぬ。汝らに倒されれば、それをきっかけに何かを悟るかもしれんじゃろ～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821421
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400821421,
					"content": "何せ、順風満帆の経歴は人を頑なにしてしまう。自分だけが正しいと思い込ませてしまうんじゃ。時には、挫折の方がよっぽど大切じゃぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821422,
						400821423
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400821422,
					"content": "分かった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400821424
					]
				},
				{
					"id": 400821424,
					"content": "いい返事じゃ。次の対戦、汝らの吉報を楽しみにしておるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400821423,
					"content": "編集長様のお望みなら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400821424
					]
				},
				{
					"id": 400821407,
					"content": "違う領域ってことは、商機かも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400821408
					]
				}
			]
		}
	]
