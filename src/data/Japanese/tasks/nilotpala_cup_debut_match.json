			"trigger": {
				"objectNames": [
					"ダッシュデーツ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400820301,
					"content": "あらっ！予選の相手がこんなにも平凡だなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400820302
					],
					"speakerTitle": "ダッシュデーツ"
				},
				{
					"id": 400820302,
					"content": "ほら、かかってきなさい。鮮やかなダッシュであなたたちを破ってあげるわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400820303
					],
					"speakerTitle": "ダッシュデーツ"
				},
				{
					"id": 400820303,
					"content": "緊張するな、ポコポコビーニー。たかだか予選の相手だ、こいつらを踏み台にして這い上がろうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 4008207,
			"completionStepIds": [
				4008207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008207",
							"2"
						],
						"stepId": 4008207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ダッシュデーツ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400820701,
					"content": "ポコポコビーニー、ナイスだぞ！それにみんなも、よくやった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400820702
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400820702,
					"content": "そんな…ダッシュ攻撃が負けるなんて…みんな、撤退よ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ダッシュデーツ"
				}
			]
		},
		{
			"id": 4008208,
			"completionStepIds": [
				4008208
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008208",
							"2"
						],
						"stepId": 4008208,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"八重神子",
					"レイラ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400820801,
					"content": "キノコンに指示を出して相手とバトルするのって、なんだか面白いぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400820802
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400820802,
					"content": "さっきのテイマー、キノコンたちとの連携も上手くとれてたし、いい勝負だったよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400820803,
						400820804
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400820803,
					"content": "パイモンも参戦したいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400820805
					]
				},
				{
					"id": 400820805,
					"content": "そういう意味じゃなくて！対戦相手とキノコンの連携が、ある種の「流派」みたいだっただろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400820806
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400820806,
					"content": "オイラたちもポコポコビーニーとうまく連携できればいいよな。目配せ一つで、次にやることを察してくれたりとか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400820807
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400820807,
					"content": "それは「仲間たちの阿吽の呼吸」に頼るのじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400820808
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400820808,
					"content": "神子！それとレイラ！対戦はうまく行ったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400820809
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400820809,
					"content": "テンテンヨーヨー獣とキノコの仲間たちがあれほど強かったなんて…私が反応するよりも前に、相手が倒されてたよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400820810
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400820810,
					"content": "それで会場に戻ったら、八重お姉さんの対戦相手が魂が抜けたように逃げ出したのを見て…ちょうど、八重お姉さんはあなたたちに相談したいことがあるらしくて、私もついてきたってわけなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400820811
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400820811,
					"content": "レイラちゃんは無事に予選を勝ち抜き、左右加もわずかな差ではあるが相手を上回ったんじゃ。妾は少し残念じゃった…何せ、対戦相手が全然楽しませてくれなかったからのう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400820812
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400820812,
					"content": "まあ、始まったばかりだからな。もし予選の時点で苦戦する相手に出会うほどだったら、この大会の難易度は高すぎるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400820813
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400820813,
					"content": "ところで、神子はなにを相談したいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400820814
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400820814,
					"content": "ふむ、パイモンも少しは学んだようじゃな…忠告しようとしたことにまで気が付いておったとは。今後、相手はどんどん強くなる。一時も警戒を緩めぬようにするんじゃぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400820815
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400820815,
					"content": "さて、予選を突破した勢いに乗って、キノコンと「特別修行」を行い——仲間たちとの連携を強めておくというのはどうじゃ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400820816
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400820816,
					"content": "おお、先見の明があるな！それじゃ、さっそく出発してキノコンの仲間たちと特別修行をしようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400820804,
					"content": "必殺、「爆裂銀光轟々拳」！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400820805
					]
				}
			]
		},
		{
			"id": 4008210,
			"completionStepIds": [
				4008210
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
