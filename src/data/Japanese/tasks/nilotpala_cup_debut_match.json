				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ハニヤー",
					"八重神子",
					"レイラ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400821001,
					"content": "また君たち？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821002
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400821002,
					"content": "ハニヤー？おまえ、子供たちを救ったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821003
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400821003,
					"content": "たまたまよ。子供たちが出場選手を真似しようとして、野生のキノコンに囲まれたの。幸い私の耳に入ったから、命は助かったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821004
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400821004,
					"content": "危なすぎだろ、「叡智宝珠」も取らずキノコンに近寄るなんて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821005
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400821005,
					"content": "でも気持ちは分かるわ。私だって昔、キノコンの可愛さに惑わされたもの…幸い、家族の教えと先祖の苦労を思い出して、軽率には近づかなかったけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821006
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400821006,
					"content": "みんな元々は知っているの…キノコンは危ない魔物だって。だけど最近は「サウマラタ蓮杯」の影響で、警戒心が緩まってきてる。これはエルヒンゲンの配慮不足のところね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821007,
						400821008
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400821007,
					"content": "大会の人気すぎたから…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400821009
					]
				},
				{
					"id": 400821009,
					"content": "この茶番を早く終わらせるわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821010
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400821010,
					"content": "「叡智宝珠」はキノコンの大規模退治に向いてる。私が優勝者になれば、このアイテムを好きに支配できるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821011
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400821011,
					"content": "ハニヤー、なに言ってるんだ？茶番って…キノコンの退治って？おまえ、炎1の前でこんなひどいことを言って、こいつが傷つかないとでも思ってるのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821012
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400821012,
					"content": "おまえだって大会に参加しただろ？オイラたちを指導して、楽しんでたじゃないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821013
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400821013,
					"content": "「炎1」が同類の犯した過ちを認識できるなら、私のことを応援してくれるはずよ。でも彼は人の感情を理解できない…ただの、アイテムにコントロールされた「駒」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821014
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400821014,
					"content": "君たちに色々教えた理由は…気付いてるんでしょ？私はただ、君たちの実力を見込んで、私の目標実現に協力してもらいたかっただけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821015
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400821015,
					"content": "だけど今、君たちはキノコンの側に立ってる。この馬鹿馬鹿しいゲームにハマった君たちは、「ゴールド流星」と「シルバー伴星」の称号に相応しくない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821016
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400821016,
					"content": "おい、行くなよ、ハニヤー！オイラたちはさっき、「叡智宝珠」を止めてキノコンたちと遊んでたんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821017
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400821017,
					"content": "聞く気はないみたい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400821018
					]
				},
				{
					"id": 400821018,
					"content": "ほほう、鮮やかな性格の者じゃな？言動に適度な粘りもあって、面白い展開の匂いがするぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821019
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400821019,
					"content": "神子？レイラ？おまえらも呼び声に気付いたか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821020
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400821020,
					"content": "ちょうどさっき、彼女のことを話しておったのじゃ。レイラちゃんによると、ハニヤーは汝らを対戦に導いた者じゃが、汝らがレイラちゃんに出会った後、突如離れていったらしいの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821021
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400821021,
					"content": "今から見れば、彼女は典型的な「迷いキャラ」だったんじゃ。ある個体が犯した過ちを群れの全員のせいにして、相手を徹底的に排除する…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821022
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400821022,
					"content": "「迷いキャラ」にとって、それは一番効果的で確実な方法なんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821023,
						400821024
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400821023,
					"content": "キノコンによる災害を経験したみたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400821025
					]
				},
				{
					"id": 400821025,
					"content": "確かに暴走したキノコンが環境を破壊した例はあるよ…でも、ある研究が、それは野生動物と同じように、ただ本能に従った結果の行為だって証明してる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821026
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400821026,
					"content": "この種はもう長いこと存在してるの。一気に排除したりなんかしたら、雨林の生態系にどんな影響が出るか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821027
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400821027,
					"content": "レイラの言う通りだ、極端なやり方はダメだ！ハニヤーがどんな目に遭ってきたにせよ、その無茶な行為は阻止しすべきだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821028
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400821028,
					"content": "「彼女の優勝者への道を阻む」か？汝らの反応は予想通りじゃな。あの女子は強力な優勝候補…実力は申し分ない。汝ら、準備はよいか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821029,
						400821030
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400821029,
					"content": "トレーニングの強度を上げる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400821031
					]
				},
				{
					"id": 400821031,
					"content": "神子、オイラたちを連れて来たのって、キノコンの仲間とお互いに知り合って、より連携が取れるようにするためだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821032
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400821032,
					"content": "待てよ…まさか、最初からこんなことを予想してたわけじゃ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821033
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400821033,
					"content": "ふふっ、すべてを思い通りに操っては、いささか興ざめじゃろ？此度の汝らとハニヤーの出会いは、思いがけぬ驚きをもたらしてくれた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821034
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400821034,
					"content": "さて、今日の修行はここまで。予選は全部終わっておるはずじゃ、今後の日程を確認しに行くとしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400821030,
					"content": "阿吽の呼吸を鍛え続ける。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400821031
					]
				},
				{
					"id": 400821024,
					"content": "ああいう考えに至ったきっかけがある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400821025
					]
				},
				{
					"id": 400821008,
					"content": "新たな問題が発生した…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400821009
					]
				}
			]
		},
		{
			"id": 4008212,
			"completionStepIds": [
				4008212
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008212",
							"2"
						],
						"stepId": 4008212,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"八重神子",
					"レイラ",
					"襲われた子供"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400821201,
					"content": "うむ、ここはなかなかの景色じゃ。空気から雨林の匂いがしておる——人里離れた静かな場所じゃから、邪魔する者もおらぬぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821202
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400821202,
					"content": "思い切りキノコンと遊び、休む時はスメールの美食を楽しむとしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821203
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400821203,
					"content": "やったぜ！お菓子、お菓子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400821204,
					"content": "って、待った。オイラたち、修行しに来たんだろ？もしかして神子は特別なレシピでお菓子を…それを食べたら、キノコンの仲間たちと心が繋げたりして？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400821205,
					"content": "たとえ妾にそのような能力があったとしても、無駄遣いはダメじゃろ？普通のドライフルーツやお菓子を持って来ただけじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821206
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400821206,
					"content": "「鬼の特訓メニュー」か何かを用意したとでも思っておったか？そんなもの、汝らに必要ありはせん。ずっと気を張り詰めておると、かえって大事なものを見逃してしまうじゃろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821207
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400821207,
					"content": "キノコンと仲良くしたいのならば、友として扱い、楽しい思い出を残すべきじゃ。友と一緒に遊んで暮らすこそが、「阿吽の呼吸の修行」と言えよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821208
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400821208,
					"content": "もし童が、汝の筋肉を石のように鍛え上げ、「ヒルチャール暴徒を一発でぶっ飛ばせ」と要求してきたら…汝は喜んで従うかの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821209
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400821209,
					"content": "筋肉質パイモン…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400821210
					]
				},
				{
					"id": 400821210,
					"content": "な、なんでそんな目でオイラを見るんだ！もしそんなことしたら…オ、オイラ、三日…いや、五日くらいおまえを無視するぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400821211,
					"content": "ほれ見たことか。汝と童ほど付き合いが深くとも、鍛錬を強要されるのは嫌じゃろう？ましてやキノコンの仲間とは知り合ったばかりなのじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821212
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400821212,
					"content": "うぅ、完全に神子に言いくるめられたような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400821213,
					"content": "八重お姉さんの言葉は確かに一理あるね。私も試してみたい…もし「叡智宝珠」を止めたとしても、あるいは宝珠が故障したとしても——キノコの仲間は私の言いつけを聞いてくれるのかどうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821214
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400821214,
					"content": "叡智宝珠を止める？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400821215
					]
				},
				{
					"id": 400821215,
					"content": "そう。友達っていうのは、ゆっくりお互いを知ってから、一歩一歩信頼関係を築いていくものでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821216
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400821216,
					"content": "いつもアイテムに頼ってテンテンヨーヨー獣と交流するわけにもいかないし…それに今は、少なからず命令しているような感じもあって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821217
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400821217,
					"content": "ほう？「純粋な感情は、余計なもので留めてはいけない」と…レイラちゃんの考えは王道じゃの～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821218
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400821218,
					"content": "でも、それってキノコンへのコントロールを解除したいってことだろ？…本当に大丈夫なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821219,
						400821220
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400821219,
					"content": "試す価値はあると思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400821221
					]
				},
				{
					"id": 400821221,
					"content": "うむ。レイラちゃん、やってみるがよい。心配せずとも、妾と童たちが後片付けしてやろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821222
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400821222,
					"content": "よし、じゃあ皆準備してね——止めるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821223
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400821223,
					"content": "あれ？確かに大丈夫そうだぞ！「叡智宝珠」を止めても、テンテンヨーヨー獣は勝手に動き回るだけで…前みたいに近くの人に襲い掛かって来ないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821224
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400821224,
					"content": "「叡智宝珠」がキノコンたちの性格を穏やかにし、交流の橋を作ってくれたようじゃな。何らかの技術で強引にコントロールしたというわけではなさそうじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821225
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400821225,
					"content": "この仮説が正しければ、レイラちゃんの望みは叶うかもしれぬ——キノコンたちと仲良くなれば、「叡智宝珠」を使わなくても、何の支障もなしにコミュニケーションが取れるようになるはずじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821226
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400821226,
					"content": "神子、よく言ったぜ！不思議な技術なんてどうでもいい、オイラはこの仮説のほうが気に入った！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821227
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400821227,
					"content": "私、頑張るよ！テンテンヨーヨー獣の好きなものを調べて、「全能商人」を探して、好きなお菓子をいっぱい買ってあげるの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821228
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400821228,
					"content": "オイラも！本来のポコポコビーニーと交流したいぞ！試しに「叡智宝珠」を止めてみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821229
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400821229,
					"content": "（「叡智宝珠」がこんなに効果的なのは何故？学会ですら把握できないほどの強力な技術を、カウトリヤは持ってるってこと…？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400821230
					]
				},
				{
					"id": 400821230,
					"content": "テンテンヨーヨー獣、そっちで水遊びしたいの？みんな、キノコの仲間を連れて一緒に来る？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821231
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400821231,
					"content": "気を付けたほうがよいぞ、水に立つ時は「百雷遮羅」から離れるんじゃ。さもないと、特別な足の按摩体験をさせられることになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821232,
						400821233
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400821232,
					"content": "ポコポコビーニーはプカプカ水キノコン。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400821234
					]
				},
				{
					"id": 400821234,
					"content": "そういや忘れてたぜ…ポコポコビーニーには新しい体験をさせてあげようぜ？例えば…木に登って、頂上辺りで景色を楽しむとか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821235
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400821235,
					"content": "レイラ、神子、先に行っていいぞ。ポコポコビーニーはずっと水辺で生きてたから、水遊びには飽きてるかもだろ。新しいことを体験させたいんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821236
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400821236,
					"content": "なるほど…だったら、後でまたここで落ち合おう。そっちも楽しんできてね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821237
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400821237,
					"content": "レイラと八重神子はキノコンを連れて遠いところへ遊びに行った。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400821238
					]
				},
				{
					"id": 400821238,
					"content": "さて、ポコポコビーニー、なにして遊ぶ？なんだっていいぞ！おまえの言うことが分かるかもしれないから、オイラたちに教えてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821239
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400821239,
					"content": "ええ！無視するのかよ…！うぅ、こいつと仲良くするために、食べ物をたくさん押し付けてやるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821240
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400821240,
					"content": "助けて、助けてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821241
					],
					"speakerTitle": "襲われた子供"
				},
				{
					"id": 400821241,
					"content": "話が違うじゃんか！何でキノコン、こんなに狂暴なんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821242
					],
					"speakerTitle": "襲われた子供"
				},
				{
					"id": 400821242,
					"content": "聞こえたか？誰かが助けを求めてるみたいだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821243
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400821243,
					"content": "ヤバそうだぜ、早く行ってみよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400821233,
					"content": "ポコポコビーニーはいつも水遊びしてる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400821234
					]
				},
				{
					"id": 400821220,
					"content": "どうなるか気になる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400821221
					]
				}
			]
		},
		{
			"id": 4008213,
			"completionStepIds": [
				4008202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008202",
							"2"
						],
						"stepId": 4008202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"エルヒンゲン",
					"カウトリヤ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400821301,
					"content": "予選はもうすぐだぞ。エルヒンゲンが開始前のスピーチをしてるみたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400821302,
					"content": "各出場選手および観客の皆さん、「サウマラタ蓮杯テイマー大会」がまもなく始まります。皆さんが今日のバトルを楽しみ、何らかの収穫を得られることを心から願っています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821303
					],
					"speakerTitle": "エルヒンゲン"
				},
				{
					"id": 400821303,
					"content": "また、バトルには純粋な競争心を持って臨み、友好的に競技を行ってください。ベストを尽くせばそれで良し——不必要に気負い、死闘を繰り広げる必要はありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821304
					],
					"speakerTitle": "エルヒンゲン"
				},
				{
					"id": 400821304,
					"content": "私は、人と危険生物が共存する道を模索してきました。そして今、あなたたちの手にある「叡智宝珠」は、私にその可能性を見せてくれました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821305
					],
					"speakerTitle": "エルヒンゲン"
				},
				{
					"id": 400821305,
					"content": "この大会を通じて、より多くの者に「テイム」の可能性を示し、未来の世界に闘いを回避する手段を提供することで、野外での活動がより安全になることを期待しています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821306
					],
					"speakerTitle": "エルヒンゲン"
				},
				{
					"id": 400821306,
					"content": "へえ！エルヒンゲンはその目標のために、自分の全財産を譲るつもりなのか？あいつにはあいつなりの理想があるみたいだな！それに比べて、カウトリヤはなんていうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400821307,
					"content": "エルヒンゲンさん、お言葉ありがとうございます！コホンッ、それでは、私からも簡単に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821308
					],
					"speakerTitle": "カウトリヤ"
				},
				{
					"id": 400821308,
					"content": "テイマーたちよ、あなたたちの手に取っている「叡智宝珠」は画期的な産物であり、教令院数百年の技術の集大成と言えましょう。これには九つの偉大なるポイントがあり…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821309
					],
					"speakerTitle": "カウトリヤ"
				},
				{
					"id": 400821309,
					"content": "カウトリヤさん、皆さんがうずうずしていらっしゃいますから、詳しい説明はまたの機会に。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821310
					],
					"speakerTitle": "エルヒンゲン"
				},
				{
					"id": 400821310,
					"content": "コホンッ！では機会があれば、また詳しく解説いたしましょう！とにかく、その先端技術はバトルで身をもって感じられるはずです。自分の「叡智宝珠」を信じて、思い切りバトルしましょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821311
					],
					"speakerTitle": "カウトリヤ"
				},
				{
					"id": 400821311,
					"content": "完全な技術オタクっていうか、場所も状況も関係なく意見を口に出しちゃうやつなんだな…エルヒンゲンが空気を読んでくれたおかげで、時間を浪費せずにすんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400821312,
					"content": "予選はいよいよだ！初対戦に備えようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400821313,
					"content": "（セノ？この大会を知ってたんだ？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
