			},
			"dialogs": [
				{
					"id": 710350201,
					"content": "お前か、なぜ来た？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350202
					],
					"speakerTitle": "魈"
				},
				{
					"id": 710350202,
					"content": "魈も銅雀に会いに来たの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350203
					]
				},
				{
					"id": 710350203,
					"content": "我はただ、ここを通りかかっただけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350204
					],
					"speakerTitle": "魈"
				},
				{
					"id": 710350204,
					"content": "こんなところに来て、何かあったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350205
					],
					"speakerTitle": "魈"
				},
				{
					"id": 710350205,
					"content": "オイラたち、銅雀さんに会いに来たんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710350206,
					"content": "でも前に来た時と同じで、この辺ってすごく荒れてるな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710350207,
					"content": "お寺があって、彫像もあるのに…どうして誰もここをキレイにしないんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710350208,
					"content": "忘れられてしまったのかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350209
					]
				},
				{
					"id": 710350209,
					"content": "そんな…夜叉は璃月港を守った大英雄なんだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710350210,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350211
					],
					"speakerTitle": "魈"
				},
				{
					"id": 710350211,
					"content": "魈…おまえ、また不機嫌になってないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710350212,
					"content": "いや、夜叉は守護者としての義務を果たしたまでだ。人の評価など求めてはいない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350213
					],
					"speakerTitle": "魈"
				},
				{
					"id": 710350213,
					"content": "まっ、その話は置いといて…とりあえずチ虎魚焼きを食べようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710350214,
					"content": "魈も食べたかったら、オイラたちのを半分ずつ分けてやってもいいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350215
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710350215,
					"content": "必要ない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350216
					],
					"speakerTitle": "魈"
				},
				{
					"id": 710350216,
					"content": "た、助けてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350217
					],
					"speakerTitle": "平安"
				},
				{
					"id": 710350217,
					"content": "ん？今なんか声が聞こえたような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710350218,
					"content": "助けを乞う声のようだ、あそこか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350219
					],
					"speakerTitle": "魈"
				},
				{
					"id": 710350219,
					"content": "早く行こう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350220
					]
				},
				{
					"id": 710350220,
					"content": "えっ？チ虎魚焼きは？オイラまだ食べ終わってないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
