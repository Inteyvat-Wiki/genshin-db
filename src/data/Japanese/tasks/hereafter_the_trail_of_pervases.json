			},
			"dialogs": [
				{
					"id": 710350101,
					"content": "お二人さん、注文は何にするんだい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350102
					],
					"speakerTitle": "卯師匠"
				},
				{
					"id": 710350102,
					"content": "チ虎魚焼き三つ、持ち帰りで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350103
					]
				},
				{
					"id": 710350103,
					"content": "まいどあり！そこで少し待ってな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350104
					],
					"speakerTitle": "卯師匠"
				},
				{
					"id": 710350104,
					"content": "三つ？おまえとオイラ…あともう一つは誰の分だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350105,
						710350106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710350105,
					"content": "銅雀に会いに行きたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350107
					]
				},
				{
					"id": 710350107,
					"content": "銅雀って、前に七星灯と香炉をくれたあの銅雀さんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710350108,
					"content": "たしかに、銅雀さんはチ虎魚焼きの味が恋しいって言ってたな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710350109,
					"content": "でも、銅雀さんはもう行っちゃったはずだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710350110,
					"content": "銅雀がいなくても見に行きたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350111
					]
				},
				{
					"id": 710350111,
					"content": "そうだな。うん、行ってみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710350112,
					"content": "前にあそこで銅雀さんと会った時、お寺はボロボロで、近くに宝盗団の痕跡があったよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710350113,
					"content": "銅雀さんの彫像が壊されてなきゃいいけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710350114,
					"content": "はいよっ！ご注文のチ虎魚焼き三つだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350115
					],
					"speakerTitle": "卯師匠"
				},
				{
					"id": 710350115,
					"content": "#おおっ、いい匂いだな！{NICKNAME}、さっそく出発しようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710350106,
					"content": "銅雀はチ虎魚焼きが好物。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350107
					]
				}
			]
		},
