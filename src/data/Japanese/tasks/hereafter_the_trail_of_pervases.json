				"points": []
			},
			"dialogs": [
				{
					"id": 710350301,
					"content": "ああ、仙人様、それに英雄様も！感謝します。またお会い出来て光栄です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350302
					],
					"speakerTitle": "平安"
				},
				{
					"id": 710350302,
					"content": "オイラたちを知ってるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710350303,
					"content": "仙人様を忘れるだなんて、とんでもない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350304
					],
					"speakerTitle": "平安"
				},
				{
					"id": 710350304,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYSECOND|INFO_FEMALE_PRONOUN_GIRLSECOND]}は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350305
					]
				},
				{
					"id": 710350305,
					"content": "私は平安です！覚えていないのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350306,
						710350308
					],
					"speakerTitle": "平安"
				},
				{
					"id": 710350306,
					"content": "「掇星攫辰天君」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350307
					]
				},
				{
					"id": 710350307,
					"content": "ひんっ！？じょ、冗談はよしてください。「掇星攫辰天君」だなんて、本物の仙人様がここにいるんですよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350310
					],
					"speakerTitle": "平安"
				},
				{
					"id": 710350310,
					"content": "私は今、夜叉を祀る「銅雀」のお寺へ向かおうとしていたんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350311
					],
					"speakerTitle": "平安"
				},
				{
					"id": 710350311,
					"content": "しかし山に入ってしばらく経ったところで、宝盗団に襲われてしまいまして…仙人様、お助けいただき感謝いたします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350312
					],
					"speakerTitle": "平安"
				},
				{
					"id": 710350312,
					"content": "ちょっと待った。おまえ銅雀さんのお寺に行って、なにするつもりだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710350313,
					"content": "まさか…銅雀さんの彫像を狙ってるんじゃないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350314
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710350314,
					"content": "とんでもない！そんなバチ当たりなこと、考える訳ないじゃないですか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350315
					],
					"speakerTitle": "平安"
				},
				{
					"id": 710350315,
					"content": "じゃあ、何が目的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350316
					]
				},
				{
					"id": 710350316,
					"content": "私はただ…お寺を修繕したいだけなんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350317
					],
					"speakerTitle": "平安"
				},
				{
					"id": 710350317,
					"content": "今日来たのも、お寺の現状を確認し、必要な建材を買うためでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350318
					],
					"speakerTitle": "平安"
				},
				{
					"id": 710350318,
					"content": "まさか途中で宝盗団に狙われ、逃げ回るはめになるとは思いませんでしたが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350319
					],
					"speakerTitle": "平安"
				},
				{
					"id": 710350319,
					"content": "そして、逃げているうちに道に迷ってしまい、その後のことは見ての通りです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350320
					],
					"speakerTitle": "平安"
				},
				{
					"id": 710350320,
					"content": "とりあえず、お寺で詳しく話を聞こう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350321
					]
				},
				{
					"id": 710350321,
					"content": "そうですね。ここで話すのもなんですし、お寺へ向かいましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350322
					],
					"speakerTitle": "平安"
				},
				{
					"id": 710350322,
					"content": "詳しいことは、そこに着いてからで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350323
					],
					"speakerTitle": "平安"
				},
				{
					"id": 710350323,
					"content": "先に行くがいい。我は他に用がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350324
					],
					"speakerTitle": "魈"
				},
				{
					"id": 710350324,
					"content": "え？行っちゃうのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350325
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710350325,
					"content": "もう…いなくなっちゃった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710350308,
					"content": "覚えてる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350309
					]
				},
				{
					"id": 710350309,
					"content": "それはよかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350310
					],
					"speakerTitle": "平安"
				}
			]
		},
		{
			"id": 7103504,
