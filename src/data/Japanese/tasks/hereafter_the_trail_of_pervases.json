			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"平安",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710350401,
					"content": "このお寺、相変わらずの荒れ具合ですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350402
					],
					"speakerTitle": "平安"
				},
				{
					"id": 710350402,
					"content": "それで、どうして急にお寺の修繕なんかしようと思ったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710350403,
					"content": "コホンッ、話すと長くなってしまうのですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350404
					],
					"speakerTitle": "平安"
				},
				{
					"id": 710350404,
					"content": "私は仙人を演じるため、さまざまな参考資料を集めてきました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350405
					],
					"speakerTitle": "平安"
				},
				{
					"id": 710350405,
					"content": "あの日、私は仙人の教訓を肝に銘じ、正しき道に立ち返ることを誓いましたよね？そして、家にある参考資料をすべて捨てようと思ったのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350406
					],
					"speakerTitle": "平安"
				},
				{
					"id": 710350406,
					"content": "しかし、参考資料を破棄しようとした時、あることを思いつきました。その資料と私がかつて使った人を騙す手段を整理して、人々に配ってみようと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350407
					],
					"speakerTitle": "平安"
				},
				{
					"id": 710350407,
					"content": "そうすれば、詐欺の防止に貢献できるかもしれないと思いました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350408
					],
					"speakerTitle": "平安"
				},
				{
					"id": 710350408,
					"content": "意外にも、私が作った冊子は多くの人の役に立つことができました。総務司からも礼を言われたほどです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350409
					],
					"speakerTitle": "平安"
				},
				{
					"id": 710350409,
					"content": "すると、私が書いた内容だけでなく、違う内容もそこに追加して欲しいとの依頼が来ました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350410
					],
					"speakerTitle": "平安"
				},
				{
					"id": 710350410,
					"content": "それで、かなりの報酬をいただくことになったのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350411
					],
					"speakerTitle": "平安"
				},
				{
					"id": 710350411,
					"content": "また私はその冊子だけでなく、「護法夜叉」に関する本も書いています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350412
					],
					"speakerTitle": "平安"
				},
				{
					"id": 710350412,
					"content": "目的はもちろん、「護法夜叉」の物語を世に広めることです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350413
					],
					"speakerTitle": "平安"
				},
				{
					"id": 710350413,
					"content": "こうすることで、私の民俗学の知識を正しいことに活かすことができると考えました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350414
					],
					"speakerTitle": "平安"
				},
				{
					"id": 710350414,
					"content": "この「銅雀」に縁のあるお寺も、「護法夜叉」に関する本を執筆する時に発見したものです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350415
					],
					"speakerTitle": "平安"
				},
				{
					"id": 710350415,
					"content": "このお寺は夜叉である「銅雀」を祀るため、ご先祖様が建てたという記録が残っています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350416
					],
					"speakerTitle": "平安"
				},
				{
					"id": 710350416,
					"content": "やっとの思いで見つけたのですが、まさかこのように荒れ果てたお寺だとは想像もしていませんでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350417
					],
					"speakerTitle": "平安"
				},
				{
					"id": 710350417,
					"content": "私は悩んだ末、お寺の修繕にかかるお金を自ら捻出することにしました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350418
					],
					"speakerTitle": "平安"
				},
				{
					"id": 710350418,
					"content": "なにせ、こうして正しい道に戻れたのも、仙人のおかげですからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350419
					],
					"speakerTitle": "平安"
				},
				{
					"id": 710350419,
					"content": "お寺の修繕も、これまで私が犯してきた悪事の償いになります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350420
					],
					"speakerTitle": "平安"
				},
				{
					"id": 710350420,
					"content": "うーん…嘘はついてないみたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350421
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710350421,
					"content": "#{NICKNAME}、おまえはどう思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350422,
						710350424
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710350422,
					"content": "たぶん嘘じゃなさそう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350423
					]
				},
				{
					"id": 710350423,
					"content": "たぶんとはなんですか。正真正銘、本当のことです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350426
					],
					"speakerTitle": "平安"
				},
				{
					"id": 710350426,
					"content": "はぁ、まあいいです。好きに思ってくれて構いません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350427
					],
					"speakerTitle": "平安"
				},
				{
					"id": 710350427,
					"content": "まだ信じられないのでしたら、修繕が始まった頃にまた見に来てください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "平安"
				},
				{
					"id": 710350424,
					"content": "前は詐欺師だったし…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350425
					]
				},
				{
					"id": 710350425,
					"content": "でも、今はもう違います！私は仙人の前で誓いを立て、真人間になりましたからね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350426
					],
					"speakerTitle": "平安"
				}
			]
		},
