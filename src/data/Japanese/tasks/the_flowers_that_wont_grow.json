					"ヴァルダン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230230401,
					"content": "土壌の質だけでなく、「水」にも問題があるのかもしれん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230402
					],
					"speakerTitle": "ヴァルダン"
				},
				{
					"id": 230230402,
					"content": "薔薇を深く植えすぎて、水分を十分に吸収しきれていない可能性があるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230403
					],
					"speakerTitle": "ヴァルダン"
				},
				{
					"id": 230230403,
					"content": "旅人、お願いだ。一緒にこの薔薇に水を撒いてくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴァルダン"
				}
			]
		},
		{
			"id": 2302306,
			"completionStepIds": [
				2302306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2302306",
							"2"
						],
						"stepId": 2302306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ヴァルダン",
					"ガルゲン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230230601,
					"content": "ふう…よし、と。土壌の水分は、これでしばらく持つだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230602
					],
					"speakerTitle": "ヴァルダン"
				},
				{
					"id": 230230602,
					"content": "旅人、ありがとう。お前がいなければ、今ごろクタクタになってただろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230603
					],
					"speakerTitle": "ガルゲン"
				},
				{
					"id": 230230603,
					"content": "妙だな？今回はかなり水を撒いたはずだが、やっと土に水が染み込んだようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230604
					],
					"speakerTitle": "ヴァルダン"
				},
				{
					"id": 230230604,
					"content": "いつもの2倍は撒いたんじゃないだろうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230605
					],
					"speakerTitle": "ヴァルダン"
				},
				{
					"id": 230230605,
					"content": "そんなに？…父さん、あんまり疲れすぎて、何か錯覚してるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230606
					],
					"speakerTitle": "ガルゲン"
				},
				{
					"id": 230230606,
					"content": "2倍も撒いたら土は水浸しだ。でも、この土の湿り具合はちょうどいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230607
					],
					"speakerTitle": "ガルゲン"
				},
				{
					"id": 230230607,
					"content": "うーむ、それはそうなんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230608
					],
					"speakerTitle": "ヴァルダン"
				},
				{
					"id": 230230608,
					"content": "薔薇がうまく育つといいね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230609
					]
				},
				{
					"id": 230230609,
					"content": "安心してくれ。「ビマリスタン」の患者たちや医者のためにも、薔薇は一生懸命世話する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230610
					],
					"speakerTitle": "ヴァルダン"
				},
				{
					"id": 230230610,
					"content": "これはお礼だ。受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230611
					],
					"speakerTitle": "ヴァルダン"
				},
				{
					"id": 230230611,
					"content": "うーむ…しかし、本当に今回は水をたくさん撒いた気がするんだがなあ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴァルダン"
				}
			]
		},
