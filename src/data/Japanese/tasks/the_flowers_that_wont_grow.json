					"ヴァルダン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230230101,
					"content": "父さん、このままじゃマズい。薔薇が全然うまく育たない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230102
					],
					"speakerTitle": "ガルゲン"
				},
				{
					"id": 230230102,
					"content": "急いで手を打たねば、今年は期日通りに薬草を納入できないぞ…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230103
					],
					"speakerTitle": "ヴァルダン"
				},
				{
					"id": 230230103,
					"content": "土壌は問題ないし、雑草や害虫も駆除しているのに、これは一体…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230104
					],
					"speakerTitle": "ガルゲン"
				},
				{
					"id": 230230104,
					"content": "なにか悩んでるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230105
					]
				},
				{
					"id": 230230105,
					"content": "ん？薬草を買いに来たんじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230106
					],
					"speakerTitle": "ヴァルダン"
				},
				{
					"id": 230230106,
					"content": "実は、うちは定期的に「ビマリスタン」に薬草を卸してるんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230107
					],
					"speakerTitle": "ヴァルダン"
				},
				{
					"id": 230230107,
					"content": "中でも、とっておきなのがこの「スメールローズ」だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230108
					],
					"speakerTitle": "ヴァルダン"
				},
				{
					"id": 230230108,
					"content": "薔薇も薬になるんだ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230109
					]
				},
				{
					"id": 230230109,
					"content": "まあ、詳しいとこは「ビマリスタン」の医者に聞いてほしいんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230110
					],
					"speakerTitle": "ヴァルダン"
				},
				{
					"id": 230230110,
					"content": "この薔薇と他の薬を調合すると、熱中症や胃の病に効くとか。他にも効能はあるらしいが…俺は門外漢だからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230111,
						230230113
					],
					"speakerTitle": "ヴァルダン"
				},
				{
					"id": 230230111,
					"content": "そういうことなら、手伝うよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230112
					]
				},
				{
					"id": 230230112,
					"content": "それはありがたい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴァルダン"
				},
				{
					"id": 230230113,
					"content": "この薔薇はどうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230114
					]
				},
				{
					"id": 230230114,
					"content": "よく分からんのだが、成長が遅いんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230115
					],
					"speakerTitle": "ヴァルダン"
				},
				{
					"id": 230230115,
					"content": "今までの経験上、こういう時はたいてい土か害虫が問題なんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230116
					],
					"speakerTitle": "ヴァルダン"
				},
				{
					"id": 230230116,
					"content": "以前同じ土に薬草を植えたときは、とてもうまく育ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230117
					],
					"speakerTitle": "ヴァルダン"
				},
				{
					"id": 230230117,
					"content": "害虫も毎日駆除しているし、虫が原因とも思えない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230118
					],
					"speakerTitle": "ガルゲン"
				},
				{
					"id": 230230118,
					"content": "だが、もう原因を突き止めている時間がないんだ。このままでは、期日までに薔薇を「ビマリスタン」に納入できない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230119
					],
					"speakerTitle": "ガルゲン"
				},
				{
					"id": 230230119,
					"content": "だから、とにかく特製の肥料を使って、土を肥やそうと考えているんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230120
					],
					"speakerTitle": "ヴァルダン"
				},
				{
					"id": 230230120,
					"content": "他の畑の世話が忙しくてな、肥料の材料を集める時間が全く取れない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230121
					],
					"speakerTitle": "ヴァルダン"
				},
				{
					"id": 230230121,
					"content": "旅人、「ビマリスタン」の患者たちのためだと思って…ここはひとつ、手を貸してくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230122
					],
					"speakerTitle": "ヴァルダン"
				},
				{
					"id": 230230122,
					"content": "手伝うよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230123
					]
				},
				{
					"id": 230230123,
					"content": "それはありがたい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230124
					],
					"speakerTitle": "ヴァルダン"
				},
				{
					"id": 230230124,
					"content": "ちょっと状況を確認してみよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴァルダン"
				}
			]
		},
