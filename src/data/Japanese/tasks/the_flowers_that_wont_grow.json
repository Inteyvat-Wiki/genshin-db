			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ヴァルダン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230230301,
					"content": "これだけあれば十分だ。本当にありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230302
					],
					"speakerTitle": "ヴァルダン"
				},
				{
					"id": 230230302,
					"content": "この特製肥料にかかれば、土壌の改良なんて朝飯前だ。薔薇はきっとうまく育つだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230303
					],
					"speakerTitle": "ヴァルダン"
				},
				{
					"id": 230230303,
					"content": "他の肥料のように、撒いても効き目ナシ、なんてことにならないといいけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230304
					],
					"speakerTitle": "ガルゲン"
				},
				{
					"id": 230230304,
					"content": "前にも肥料を撒いてみたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230305
					]
				},
				{
					"id": 230230305,
					"content": "普通の肥料を撒いてみたんだが、あまり…というか、全く効き目がなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230306
					],
					"speakerTitle": "ヴァルダン"
				},
				{
					"id": 230230306,
					"content": "でも、他の畑にはかなり効いたんだよな…一体なにが起きてるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230307
					],
					"speakerTitle": "ガルゲン"
				},
				{
					"id": 230230307,
					"content": "とにかく、これは謝礼だ。どうか受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴァルダン"
				}
			]
		},
		{
			"id": 2302304,
			"completionStepIds": [
				2302304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
