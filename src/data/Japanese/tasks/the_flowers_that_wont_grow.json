			},
			"dialogs": [
				{
					"id": 230230201,
					"content": "特製の肥料だが、量がかなり必要だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230202
					],
					"speakerTitle": "ヴァルダン"
				},
				{
					"id": 230230202,
					"content": "材料はほぼ手元にあるんだが、「ハッラの実」の粉末だけ切らしててな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230203
					],
					"speakerTitle": "ヴァルダン"
				},
				{
					"id": 230230203,
					"content": "旅人、「ハッラの実」をとって来てもらえないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴァルダン"
				}
			]
		},
		{
			"id": 2302303,
			"completionStepIds": [
				2302303
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2302303",
							"2"
