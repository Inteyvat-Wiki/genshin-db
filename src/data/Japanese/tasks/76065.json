					}
				]
			},
			"dialogs": [
				{
					"id": 760650101,
					"content": "来たんだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650102
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760650102,
					"content": "まさかコロンビーナがいるなんて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650103
					]
				},
				{
					"id": 760650103,
					"content": "うん。でもキミも来てくれた。だから、今ここにいるのは「私たち」だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650104
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760650104,
					"content": "#{M#俺}{F#私}が来るのを知ってたような言い方だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650105
					]
				},
				{
					"id": 760650105,
					"content": "いつかは分からないけど、キミは来ると思ってた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650106
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760650106,
					"content": "月とテイワットが引力で繋がってるように、キミも必ず私を見つけてくれる…そうでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650107
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760650107,
					"content": "おいで、一緒に座ろ。キミの場所を空けておいたから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650108
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760650108,
					"content": "この前はキミの宇宙船からテイワットを眺めたよね。今日は星空を見ようよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650109
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760650109,
					"content": "ニンニンや、あの子の先輩たちが心を惹かれたのは、まさにこの星空…あそこにもきっと、特別な引力があるんだと思う。私も感じ取れるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650110
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760650110,
					"content": "ニンニンと、彼女が送ったメッセージは…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650111
					]
				},
				{
					"id": 760650111,
					"content": "心配しないで、危ない目には遭ってないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650112
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760650112,
					"content": "ずっとずっと遠くまで、無事に歩んでいったよ。私が護衛に使った力が、もう感じ取れないくらい遠くに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650113
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760650113,
					"content": "でも、気になることがあるの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650114
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760650114,
					"content": "気になること？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650115
					]
				},
				{
					"id": 760650115,
					"content": "うん、たくさん。たとえば、観月者のメッセージって、他の人も受け取るのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650116
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760650116,
					"content": "受け取った人、あるいは人ではないその存在は…何者なのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650117
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760650117,
					"content": "彼らはどう思うのかな？私たちと同じように、心に愛や憎しみを持ってるのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650118
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760650118,
					"content": "私たちと同じように、深淵に囲まれていても、頭上に広がる綺麗で神秘的な星空に惹かれたりするかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650119
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760650119,
					"content": "私たちと同じように、他の人を探して、手を振りながら「はじめまして」って挨拶するのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650120
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760650120,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650121
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760650121,
					"content": "この星空の奥深くには、まだ闇に呑まれてない文明があるのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650122
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760650122,
					"content": "あると思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650123
					]
				},
				{
					"id": 760650123,
					"content": "ん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650124
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760650124,
					"content": "宇宙船がメッセージを受信したんだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650125
					]
				},
				{
					"id": 760650125,
					"content": "メッセージ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650126
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760650126,
					"content": "肝心な内容はもうほとんど失われてる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650127
					]
				},
				{
					"id": 760650127,
					"content": "でも、知恵を持つ文明によるものだと思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650128
					]
				},
				{
					"id": 760650128,
					"content": "失われてる…届くまで、あまりにも長い道のりだったから…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650129
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760650129,
					"content": "でも、それだけでも十分うれしいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650130
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760650130,
					"content": "#そうだ、{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650131
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760650131,
					"content": "なに？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650132
					]
				},
				{
					"id": 760650132,
					"content": "キミの本来の故郷も、あの奥深くにあるんだよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650133
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760650133,
					"content": "もし、いつかキミが旅を始めた場所に戻って、そこを掃除したくなったら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650134
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760650134,
					"content": "私も喜んで手伝うよ。キミが月を綺麗にしてくれたようにね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650135
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760650135,
					"content": "じゃあ、その時は声をかけるね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650136
					]
				},
				{
					"id": 760650136,
					"content": "パーティーもやる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650137
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760650137,
					"content": "パーティーもやる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650138
					]
				},
				{
					"id": 760650138,
					"content": "それなら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650139
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760650139,
					"content": "「帰郷の夜」っていう名前にするのはどう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650140
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760650140,
					"content": "昼間かもしれないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650141
					]
				},
				{
					"id": 760650141,
					"content": "じゃあ、昼から夜まで遊ぼう。友達もみんな呼んで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650142
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760650142,
					"content": "楽しそうだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650143
					]
				},
				{
					"id": 760650143,
					"content": "いい天気の夜になるといいな。友達みんなが集まる夜に。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "コロンビーナ"
				}
			]
		}
	]
}