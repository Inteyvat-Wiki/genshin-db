				"points": []
			},
			"dialogs": [
				{
					"id": 733220801,
					"content": "セファーナ、オイラたち帰ってきたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220802
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733220802,
					"content": "セファーナ、穢れの浸蝕から全ての「シューニャター花」を救い出せたワ。だから、汝がもう心配する必要はナイ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220803
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 733220803,
					"content": "さすがソルシュお姉さん、本当にすごいデス！今も昔も、すごく頼りになるんですカラ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220804
					],
					"speakerTitle": "セファーナ"
				},
				{
					"id": 733220804,
					"content": "#「謁賛主」{NICKNAME}様も、ゴ迷惑をおかけしました！お礼として、どうゾこれを——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220805
					],
					"speakerTitle": "セファーナ"
				},
				{
					"id": 733220805,
					"content": "「シューニャター花」のお世話をしているとき、道端で拾ったものデス。人間だけじゃなくニャーニャー、ワンワンたちもこのキラキラしたモノが好きだと聞きましタ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220806
					],
					"speakerTitle": "セファーナ"
				},
				{
					"id": 733220806,
					"content": "もしかして…モラか？確かに、オイラは嫌いじゃないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220807
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733220807,
					"content": "ソルシュお姉さんは、お礼ニどんなものが欲しいですカ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220808
					],
					"speakerTitle": "セファーナ"
				},
				{
					"id": 733220808,
					"content": "浅はかネ、セファーナ！偉業を成し遂げるコトは私に与えられた宿命ナノ、お礼など不要ヨ。汝は己の身体と、「シューニャター花」の面倒さえしっかりみていればソレで結構。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220809
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 733220809,
					"content": "つまり…ソルシュのことはいいから、セファーナは自分を大事にしろよ、ってことだよな？やっとお姉さんらしいことを言ったな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220810,
						733220811
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733220810,
					"content": "ソルシュは感情表現が苦手みたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733220812
					]
				},
				{
					"id": 733220812,
					"content": "いい加減ナ解釈をしないデ！私はセファーナの責務について指摘しただけ。もっと気を引き締めるためにネ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220813
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 733220813,
					"content": "汝ら人間にも分かる概念で言うト、「シューニャター花」と我ら花霊は同じ万種母樹の甘露に生まれた、同じルーツを持つ「家族」なノ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220814
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 733220814,
					"content": "「シューニャター花」を守護する花霊は、常に穢れの浸蝕と向き合わないといけないワ。だから、己の健康に留意するのは当然の責任ヨ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220815
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 733220815,
					"content": "確かにセファーナには今回の失態があるケド、長く「シューニャター花」を守ってきタ苦労まで否定されるべきじゃないワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220816,
						733220817
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 733220816,
					"content": "「家族」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733220818
					]
				},
				{
					"id": 733220818,
					"content": "なんだかんだ言って、後輩の面倒見がいいよな？ソルシュにも優しい一面があるってことだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220819
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733220819,
					"content": "優しい一面…確かにその通りデス！ソルシュお姉さんは口では厳しいコトを言いマスが、いつも私を助けてくれる、一番頼りになる先輩なんデス！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220820
					],
					"speakerTitle": "セファーナ"
				},
				{
					"id": 733220820,
					"content": "失礼ネ…妙なお世辞はよしなサイ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220821
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 733220821,
					"content": "おしゃべりばかりシテてもしょうがないワ…今の最優先事項は「焚真の天象」を消すことヨ。この辺でセファーナとはお別れしまショ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220822
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 733220822,
					"content": "暗色の力を駆逐シ、私の偉業を成し遂げた暁には、「甘露花海」に本来の色彩と純潔さが戻るワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220823
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 733220823,
					"content": "アア、ソルシュお姉さん、もう行ってしまわれるンですネ？…全てがうまくいくよう、お祈りしていマス！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220824
					],
					"speakerTitle": "セファーナ"
				},
				{
					"id": 733220824,
					"content": "ソルシュお姉さん、「謁賛主」様、そして白いお仲間様、また来てくださいネ。お待ちしていマス！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220825
					],
					"speakerTitle": "セファーナ"
				},
				{
					"id": 733220825,
					"content": "今度お会いしたときは、ゼヒ「謁賛主」様と白いお仲間様に、ソルシュお姉さんの物語をたくさん聞かせてあげたいデス！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220826
					],
					"speakerTitle": "セファーナ"
				},
				{
					"id": 733220826,
					"content": "フン…また会えるとは限らないわヨ。でも、「謁賛主」に、私の功績を存分に知ってもらう分には構わないワ。より詳細な記録のためにネ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 733220817,
					"content": "それは確かに大切な存在…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733220818
					]
				},
				{
					"id": 733220811,
					"content": "昔からセファーナを大事に思ってるんだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733220812
					]
				}
			]
		},
