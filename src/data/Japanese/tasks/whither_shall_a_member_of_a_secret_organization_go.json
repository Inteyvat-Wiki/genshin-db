	"talks": [
		{
			"id": 7550701,
			"completionStepIds": [
				7550701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7550701",
							"2"
						],
						"stepId": 7550701,
						"stateName": "QUEST_STATE_UNFINISHED"
