				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ヘルカ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 755070101,
					"content": "#{NICKNAME}、パイモン、ありがとう。君たちの助けがなければ、僕はこの任務を果たせなかっただろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755070102
					],
					"speakerTitle": "ヘルカ"
				},
				{
					"id": 755070102,
					"content": "今なら「組織」に招待してくれる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755070103
					]
				},
				{
					"id": 755070103,
					"content": "本当に入るつもりだったのかよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755070104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755070104,
					"content": "うーん…年齢的にちょっと微妙かな。ほかのメンバーの意見も聞かないといけないしね。みんなで投票してゴーサインが出たら、前例がないわけでもないかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755070105
					],
					"speakerTitle": "ヘルカ"
				},
				{
					"id": 755070105,
					"content": "もし後でナド・クライに行けたら、ナシャタウンの「スペランザ」に行ってみて。カーリャは僕たちのメンバーじゃないけど、信頼できる人だよ。きっと力になってくれる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755070106
					],
					"speakerTitle": "ヘルカ"
				},
				{
					"id": 755070106,
					"content": "#おっ、おう。そういえばお前、{NICKNAME}が戦ってる間も、写真を撮ったり、ノートに何か描いたりして…なんかプロっぽかったよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755070107,
						755070108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755070107,
					"content": "まさか戦い方をパクろうとしてたとか…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755070109
					]
				},
				{
					"id": 755070109,
					"content": "そうだな…君たちになら教えてもいいか。僕の役目は百種類の怪物の情報を集める事なんだ。君たちのおかげで、ナタとフォンテーヌについては達成できた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755070110
					],
					"speakerTitle": "ヘルカ"
				},
				{
					"id": 755070110,
					"content": "この後はスメールだね。エルマイト旅団にお願いしてみようかな。あ、でもその前に、完成した図鑑をナシャタウンに送り返さないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755070111
					],
					"speakerTitle": "ヘルカ"
				},
				{
					"id": 755070111,
					"content": "へぇ、怪物図鑑を作ってたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755070112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755070112,
					"content": "うん。ナド・クライにはもう僕の知らない怪物はいないからね。ほかの場所に行ってみたいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755070113
					],
					"speakerTitle": "ヘルカ"
				},
				{
					"id": 755070113,
					"content": "メイジーは臆病なのに、こういう怪物の話が大好きなんだ。昔から完成したてほやほやの図鑑を渡すたびに、目をキラキラさせて喜んでくれてさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755070114
					],
					"speakerTitle": "ヘルカ"
				},
				{
					"id": 755070114,
					"content": "一緒に連れてきたいけど、あの子は体が弱くて、遠くへは行けない。それにカーリャは、図鑑が上手く出来れば、出版もできるかもしれないって言ってた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755070115
					],
					"speakerTitle": "ヘルカ"
				},
				{
					"id": 755070115,
					"content": "出版された図鑑を持ち帰って、サプライズにこっそりあの子の枕の下に隠したりしたら…コホン、話が逸れちゃったね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755070116
					],
					"speakerTitle": "ヘルカ"
				},
				{
					"id": 755070116,
					"content": "へへっ、ヘルカは本当に友達思いなんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755070117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755070117,
					"content": "友達というより、家族…かな。血は繋がってないけどね。アハハ、もう、この話はよそうよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755070118
					],
					"speakerTitle": "ヘルカ"
				},
				{
					"id": 755070118,
					"content": "そうだ、今回の図鑑だけど、君たちにもコピーをあげるよ。写真のバックアップも必要だし、メイジーに送らなきゃならないから、君たちの分は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755070119,
						755070120
					],
					"speakerTitle": "ヘルカ"
				},
				{
					"id": 755070119,
					"content": "写真には心得があるから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755070121
					]
				},
				{
					"id": 755070121,
					"content": "それならよかった。僕もそろそろ次の目的地に向かおうかな。数日後にはここを発つよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755070122
					],
					"speakerTitle": "ヘルカ"
				},
				{
					"id": 755070122,
					"content": "おう！気をつけろよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755070123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755070123,
					"content": "ありがとう。君たちもね！良い旅を！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヘルカ"
				},
				{
					"id": 755070120,
					"content": "「怪物」にはいつでも会えるから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755070121
					]
				},
				{
					"id": 755070108,
					"content": "まさか画家で映影監督だったり…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755070109
					]
				}
			]
		}
	]
}