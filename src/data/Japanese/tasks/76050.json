					"nextDialogs": [
						760500113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760500113,
					"content": "この子たちなりの感謝を示す方法なのかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500114
					]
				},
				{
					"id": 760500114,
					"content": "ちょっと油断してたら、この子たちに埋もれちゃった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500115
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760500115,
					"content": "なんだかんだ、おまえってこいつらのことはベタベタに甘やかしてるよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760500116,
