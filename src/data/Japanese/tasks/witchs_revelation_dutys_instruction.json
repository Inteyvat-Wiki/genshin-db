			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"バーベロス"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 746930101,
					"content": "どうしても、カードの裏面をコピーさせてもらえないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930102
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 746930102,
					"content": "悪いが、そいつは無理だね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930103
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746930103,
					"content": "このかっこよさが気に入ったんだ。せめてもう少し相談を…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930104
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 746930104,
					"content": "無理だね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930105
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746930105,
					"content": "分かった。かっこいいカードの裏面を手に入れるのにも、強力なカードを使うのにも、相応の代償を払う必要がある。そういうことだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930106,
						746930107,
						746930108
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 746930106,
					"content": "全然分かってない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930109
					]
				},
				{
					"id": 746930109,
					"content": "おい！会ったばかりなのに、来た理由を決めつけるなよな！他にも事情があったのかもしれないだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746930110,
					"content": "その通りだ。さすがは俺の友、心が通じ合っているようだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930111
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 746930111,
					"content": "本当にそうだったのかよ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746930112,
					"content": "最近、フォンテーヌで小規模なカード仲間の集まりが開催されていてな。なんでも、そこで限定デザインのカードケースが無料で配られるらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930113
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 746930113,
					"content": "教令院には特に急ぎの用事もなかったから、来てみたというわけさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930114
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 746930114,
					"content": "たとえ急ぎの用事があったとしても、きっと急ぎじゃないことにしちゃうんだろうな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746930115,
					"content": "ああ。たった二週間の残業で、業務はほとんど片付けたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930116
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 746930116,
					"content": "セトスも手伝ってくれたんだが、あいつは書類仕事に向いているな。お礼として、あいつにもカードケースを一つ持って帰ると約束したんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930117
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 746930117,
					"content": "それで大マハマトラよ、カードを引くのかい？引かないのかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930118
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746930118,
					"content": "もちろん引くさ。お前は、このカードから俺の未来を予測できると言ったな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930119
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 746930119,
					"content": "正確にはそういうわけじゃない。だが、そう理解してもらって構わんよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930120
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746930120,
					"content": "なるほど…これが『決闘王』の「運命を賭けたドロー」というやつか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930121
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 746930121,
					"content": "なら…俺のラウンド、ドロー…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930122
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 746930122,
					"content": "セノは大きく息を吸い込み、かっこよくポーズを決めながらカードを引いた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						746930123
					]
				},
				{
					"id": 746930123,
					"content": "逆位置の「節制」だね。スメール教令院の「大マハマトラ」であるおまえがこれを引くのも想定通りだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930124
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746930124,
					"content": "前からセノのこと知ってたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930125
					]
				},
				{
					"id": 746930125,
					"content": "アリスから何度か聞いてるよ。あの堅苦しい教令院に、これほどユーモア溢れる「大マハマトラ」がいるなんて本当に面白いとね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930126
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746930126,
					"content": "褒めてくれてありがとう。カードは引いたが、次はどうすればいい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930127
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 746930127,
					"content": "逆位置の「節制」、あるいは「技」か…おまえには「何もしない」状態を保つことを勧めるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930128
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746930128,
					"content": "おまえは事を急ぎすぎておる。運命という名の丸木橋の上で、今にもバランスを崩しそうなほどにね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930129
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746930129,
					"content": "俺が節制せずカードで遊んでいたからか？セトスとティナリにもそう言われたが、スケジュールは調整してある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930130
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 746930130,
					"content": "…カードゲームの話をしているんじゃないよ。仕事の時間のことだ。「大マハマトラ」であるおまえが全力で取り組むべきことは、「七聖召喚」だけではないだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930131
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746930131,
					"content": "カードゲームを除けば、基本的に俺のスケジュールには一切の調整の余地がないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930132
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 746930132,
					"content": "そういった予定がもたらす重圧を、一人で背負うことに慣れてしまっているんだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930133
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746930133,
					"content": "マハマトラの同僚たちがいる。俺一人が背負っているわけじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930134
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 746930134,
					"content": "それでも、その全員がおまえを頼りにしている。マハマトラだけじゃない、教令院の学者や、スメールの民衆…多くの者が、おまえという「大マハマトラ」を頼りにしているんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930135
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746930135,
					"content": "それを口にする者はいないだろうさ。あるいは、そいつら自身でさえ心の内にある思いに気づいていないのかもしれない…何せ皆、おまえのユーモアに惹きつけられているからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930136
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746930136,
					"content": "だが、おまえは常にその視線を感じておる…ああ、そしておまえと共にある「影」、それもまた重荷の一つだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930137
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746930137,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930138
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 746930138,
					"content": "おまえは先頭を歩くことに慣れ、一つ、また一つと重荷を引き受けてきた…もしかすると、それこそがおまえが「バランスを崩しかけている」原因なのかもしれん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930139
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746930139,
					"content": "俺にはたくさんの友がいる。それに「七聖召喚」もある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930140
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 746930140,
					"content": "どうやら、休むつもりはないようだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930141
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746930141,
					"content": "まだ休める時じゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930142
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 746930142,
					"content": "確かにおまえのような者にとって心の中の戦いが続く限り、たとえ死を迎える日が訪れようとも責務が終わることはないのだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930143
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746930143,
					"content": "この「月諭のアルカナ」を受け取りな。きっとそれがおまえを導き、バランスを取り戻すに足る「理由」へと辿り着かせてくれるはずさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930144
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746930144,
					"content": "その時になれば、おまえの心の中の激戦も、最終決戦へと向かうことだろうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930145,
						746930146
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746930145,
					"content": "セノは負けない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930147
					]
				},
				{
					"id": 746930147,
					"content": "ありがとう、旅人、パイモン。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930148
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 746930148,
					"content": "…感謝する。もらったカードは肌身離さず持ち歩こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930149
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 746930149,
					"content": "…えっ？そこまでする必要あるのか…って、ちょっと待て、まさか——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930150,
						746930151,
						746930152
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746930150,
					"content": "く、来る…！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930153
					]
				},
				{
					"id": 746930153,
					"content": "どうしてそこまでするんだい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930154
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746930154,
					"content": "アルカナは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930155
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 746930155,
					"content": "大切に持ちアルカナいと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "セノ"
				},
				{
					"id": 746930151,
					"content": "切り替え早すぎ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930153
					]
				},
				{
					"id": 746930152,
					"content": "バーベロスさん、待って——",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930153
					]
				},
				{
					"id": 746930146,
					"content": "セノは最強だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930147
					]
				},
				{
					"id": 746930107,
					"content": "全然分からない！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930109
					]
				},
				{
					"id": 746930108,
					"content": "ここまでカードゲームをしに来たの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930109
					]
				}
			]
		},
		{
			"id": 7469302,
