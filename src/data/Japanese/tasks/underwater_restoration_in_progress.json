					}
				]
			},
			"dialogs": [
				{
					"id": 747140101,
					"content": "旅人、パイモン。やっと詳細が分かったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140102
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 747140102,
					"content": "最近、潜水士が増えた理由は、水中の廃棄物を処理して、環境の修復を早めるためだったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140103
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 747140103,
					"content": "それならやっぱり、ぼくは全力で手伝うべきだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140104
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 747140104,
					"content": "水中の汚染が深刻になったら、ロマリタイムフラワーの色もくすんじゃうし、想像したくもない恐ろしいことが沢山起こると思う…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140105
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 747140105,
					"content": "#{M#俺}{F#私}たちも手伝うよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747140106
					]
				},
				{
					"id": 747140106,
					"content": "おう！一緒に頑張ろうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747140107,
					"content": "そうだ、フレミネ。オイラたち、水中ですごそうな…構造物？を見つけたんだ。なにかの楽器の部品みたいなんだけど、おまえも見てみてくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747140108,
					"content": "うん——わあ、すごく精密だね。ぼくも装置についてはある程度研究したことがあるけど、市場に出回ってるもので、こんなに精密で独特なものは見たことがないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140109,
						747140110
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 747140109,
					"content": "ここに置くとなかなかいい感じだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747140111
					]
				},
				{
					"id": 747140111,
					"content": "うん、でも完全に復元するには、まだいくつか部品が足りないみたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140112
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 747140112,
					"content": "ゆっくりやろうぜ。直ったらどんな姿になるのか、気になるしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747140113,
					"content": "じゃあ、ぼくは引き続き手伝ってくるね。二人はもう少し休んでて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140114
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 747140114,
					"content": "おう、おまえもちゃんと休むんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747140115,
					"content": "あら？これ…アナタたちが引き上げたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140116
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 747140116,
					"content": "そうだぞ。サンドローネ、これがなにか知ってるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747140117,
					"content": "ふっ…知っているどころか、昔、庭で毎日これを弾いていたのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140118
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 747140118,
					"content": "えっ！？これ…おまえの物なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747140119,
					"content": "昔はね。これはアランが発明した機械のピアノよ。人が弾くこともできるし、自動演奏もできるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140120
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 747140120,
					"content": "そんなにすごいのか…じゃあ、なんで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747140121,
					"content": "アランの体調が悪くなって、ピアノの音を聞かせられなくなったから、ワタシが処分したのよ。まさかこうして再会できるとはね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140122
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 747140122,
					"content": "きっと、このピアノを手に入れた誰かが、壊れた時に修理できなくて…最終的にこうなったんでしょうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140123
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 747140123,
					"content": "#{M#君}{F#あなた}なら直せる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747140124
					]
				},
				{
					"id": 747140124,
					"content": "当然でしょう。こんなものでワタシが手こずるわけないじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140125
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 747140125,
					"content": "うーん…ただ、いくらなんでもバラバラになりすぎね…ピアノの他の部品を見つけてくれたら、すぐにでも修理できるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140126
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 747140126,
					"content": "よし！じゃあ、潜る時は気を付けておくぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747140110,
					"content": "ここの環境とよく合ってるね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747140111
					]
				}
			]
		}
	]
}