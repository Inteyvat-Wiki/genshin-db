			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"スクロース"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110400501,
					"content": "あれ？ティマイオス、いないみたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110400502,
					"content": "（あれ、この二人は…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400503
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 110400503,
					"content": "あの！えっと…パイモンに旅人さん。その、ティマイオスに何か用事があった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400504
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 110400504,
					"content": "いやいや、いつもならここにいるからちょっと気になっただけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110400505,
					"content": "なるほど。彼ならアルベド先生に呼ばれたよ。代わりに私がここにいるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400506
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 110400506,
					"content": "協力が必要なら私を呼んで。いらないなら…私、そこで本読んでるから、うん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400507
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 110400507,
					"content": "ありがとうな。オイラたち使い方は慣れてるから心配ないぞ、そうだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400508
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110400508,
					"content": "うん、邪魔しないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400509
					]
				},
				{
					"id": 110400509,
					"content": "さすがは、あの風魔龍を倒した人だね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400510
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 110400510,
					"content": "そ、そうだ。あなたなら、きっとアルベド先生の役に立てるかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400511
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 110400511,
					"content": "そういえば、前もおまえとティマイオスから「アルベド先生」って人の話を聞いたけど、そいつもモンド城の錬金術師なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400225,
						110400226
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110400225,
					"content": "知らない名前だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400227
					]
				},
				{
					"id": 110400227,
					"content": "紹介が遅れてごめん、アルベド先生は西風騎士団の首席錬金術師、私とティマイオスの先生でもあるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400228
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 110400228,
					"content": "普段はティマイオスが錬金術を教えてるとこしか見かけないけど、そのアルベドは先生の先生ってことだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400229
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110400229,
					"content": "はい。先生は世界の真相の探究に力を入れてて、成果もたくさん出してるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400230
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 110400230,
					"content": "先生の助けを求めるためにわざわざモンドに来る錬金術師もよく見かけるよ。どんな難題でも先生に聞いたらすぐ解決するの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400231
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 110400231,
					"content": "わぁ、すごい人なんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400232
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110400232,
					"content": "うん。でも最近先生の研究がうまく行ってないみたいで、会う時はいつも元気がないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400233,
						110400234
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 110400233,
					"content": "そんなすごい人の力になれるかな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400235
					]
				},
				{
					"id": 110400235,
					"content": "あなたが体験した冒険はきっと先生も興味があるはずだから、インスピレーションのきっかけになるんじゃないかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400236
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 110400236,
					"content": "先生は礼儀をわきまえた人だし、彼を助けたらきっと相応のお返しをもらえるはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400237,
						110400239
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 110400237,
					"content": "もっと強くなれる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400238
					]
				},
				{
					"id": 110400238,
					"content": "できるかもね。生命の極致を探求するのも先生の研究課題のひとつだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400241
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 110400241,
					"content": "アルベド先生は今ティマイオスと一緒に雪山にいるはず。案内したいけど、錬金場から離れるわけにはいかないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400242
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 110400242,
					"content": "雪山の入口で探してみて。先生は穏やかな若い方で、学者のオーラがあって、それから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400243
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 110400243,
					"content": "…ごめん、どう説明すればいいか分からない。とにかく探してみてちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400244
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 110400244,
					"content": "おう、分かったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110400239,
					"content": "パイモンをもっと強くできる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400240
					]
				},
				{
					"id": 110400240,
					"content": "それに需要を感じないぞ。お返しは、へへっ、やっぱモラがいいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400241
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110400234,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}の錬金術に関する知識は錬金台しか…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400235
					]
				},
				{
					"id": 110400226,
					"content": "どこかで聞いたことあるような。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400227
					]
				}
			]
		}
	]
}