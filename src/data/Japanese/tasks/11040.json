					"スクロース"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110400201,
					"content": "あれ？ティマイオス、いないみたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110400202,
					"content": "（お、お客さん！？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400203
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 110400203,
					"content": "あの、えっと…彼に何か用でも？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400204
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 110400204,
					"content": "いやいや、いつもならここにいるからちょっと気になっただけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110400205,
					"content": "なるほど。彼ならアルベド先生に呼ばれたよ。代わりに私がここにいるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400206
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 110400206,
					"content": "私はスクロース、アルベド先生の助手。錬金術に関する質問なら私に聞いて…力になれるよう頑張るから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400207,
						110400209
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 110400207,
					"content": "もっと自信を持って。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400208
					]
				},
				{
					"id": 110400208,
					"content": "私…こういうのあまり得意じゃないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400211
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 110400211,
					"content": "ご、ごめんなさい、普段は実験室にこもってて、外出も他人と会話することもあまりないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400212
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 110400212,
					"content": "協力が必要なら私を呼んで。いらないなら…私、そこで本読んでるから、うん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400213
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 110400213,
					"content": "#ありがとうな。オイラたち慣れてるから心配はいらないぞ。{NICKNAME}、そうだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400214,
						110400215
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110400214,
					"content": "うん、邪魔することはないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400216
					]
				},
				{
					"id": 110400216,
					"content": "#えっ？{NICKNAME}…まさかあなた、風魔龍を倒したあの伝説の旅人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400217,
						110400218
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 110400217,
					"content": "「伝説の」なんて大げさ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400220
					]
				},
				{
					"id": 110400220,
					"content": "あなたの話をたくさん聞いたよ、いつか近くで研究したいと思ってたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400221
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 110400221,
					"content": "け、研究？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400222
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110400222,
					"content": "あっ、ごめんなさい、気にしないで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400223
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 110400223,
					"content": "でも、あなたならきっとアルベド先生の力になれると思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400224
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 110400224,
					"content": "さっきから「アルベド先生」の話ばかりだな、そいつもモンドの錬金術師か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400225,
						110400226
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110400225,
					"content": "知らない名前だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400227
					]
				},
				{
					"id": 110400227,
					"content": "紹介が遅れてごめん、アルベド先生は西風騎士団の首席錬金術師、私とティマイオスの先生でもあるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400228
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 110400228,
					"content": "普段はティマイオスが錬金術を教えてるとこしか見かけないけど、そのアルベドは先生の先生ってことだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400229
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110400229,
					"content": "はい。先生は世界の真相の探究に力を入れてて、成果もたくさん出してるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400230
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 110400230,
					"content": "先生の助けを求めるためにわざわざモンドに来る錬金術師もよく見かけるよ。どんな難題でも先生に聞いたらすぐ解決するの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400231
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 110400231,
					"content": "わぁ、すごい人なんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400232
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110400232,
					"content": "うん。でも最近先生の研究がうまく行ってないみたいで、会う時はいつも元気がないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400233,
						110400234
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 110400233,
					"content": "そんなすごい人の力になれるかな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400235
					]
				},
				{
					"id": 110400235,
					"content": "あなたが体験した冒険はきっと先生も興味があるはずだから、インスピレーションのきっかけになるんじゃないかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400236
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 110400236,
					"content": "先生は礼儀をわきまえた人だし、彼を助けたらきっと相応のお返しをもらえるはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400237,
						110400239
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 110400237,
					"content": "もっと強くなれる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400238
					]
				},
				{
					"id": 110400238,
					"content": "できるかもね。生命の極致を探求するのも先生の研究課題のひとつだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400241
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 110400241,
					"content": "アルベド先生は今ティマイオスと一緒に雪山にいるはず。案内したいけど、錬金場から離れるわけにはいかないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400242
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 110400242,
					"content": "雪山の入口で探してみて。先生は穏やかな若い方で、学者のオーラがあって、それから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400243
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 110400243,
					"content": "…ごめん、どう説明すればいいか分からない。とにかく探してみてちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400244
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 110400244,
					"content": "おう、分かったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110400239,
					"content": "パイモンをもっと強くできる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400240
					]
				},
				{
					"id": 110400240,
					"content": "それに需要を感じないぞ。お返しは、へへっ、やっぱモラがいいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400241
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110400234,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}の錬金術に関する知識は錬金台しか…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400235
					]
				},
				{
					"id": 110400226,
					"content": "どこかで聞いたことあるような。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400227
					]
				},
				{
					"id": 110400218,
					"content": "記念にサインしてあげようか。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400219
					]
				},
				{
					"id": 110400219,
					"content": "あっ、ありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400220
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 110400215,
					"content": "ちょっと忘れたかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400216
					]
				},
				{
					"id": 110400209,
					"content": "緊張しないで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400210
					]
				},
				{
					"id": 110400210,
					"content": "えっ？わ、私、緊張してるように見える？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400211
					],
					"speakerTitle": "スクロース"
				}
			]
		},
		{
			"id": 1104003,
			"completionStepIds": [],
