			},
			"dialogs": [
				{
					"id": 110400301,
					"content": "ごめんなさい、アルベド先生に関してそういう説明しかできないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400302
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 110400302,
					"content": "肖像画があればいいんだけど、残念ながら私は先生ほどの絵心がないから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "スクロース"
				}
			]
		},
		{
			"id": 1104004,
			"completionStepIds": [
				1104004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104004",
							"2"
						],
						"stepId": 1104004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ロサリア"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110400401,
					"content": "こ、ここにいたんだね、ロサリアさん。合唱がもうすぐ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400402
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 110400402,
					"content": "そういうのには参加しないって言ったよね、もっと大事なことがあるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400403
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 110400403,
					"content": "でも、今回は記念的な行事だし、シスターのみんなには出席してほしくて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400404
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 110400404,
					"content": "それは君の考えだし、「他人の願いを叶える」ことは私の仕事じゃないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400405
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 110400405,
					"content": "そ、それは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400406
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 110400406,
					"content": "君こそ、今回の行事の責任者よね？変だと思わないの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400407
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 110400407,
					"content": "ど、どこか変かな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400408
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 110400408,
					"content": "今からモンドに戻っても開始時間に間に合わないわよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400409
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 110400409,
					"content": "君をはめるために誰かが仕組んだんじゃないの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400410
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 110400410,
					"content": "えっ？そ、そんな！みんなはそういうことしないと思う！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400411
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 110400411,
					"content": "それは証拠次第じゃないかしら。それとも君は他人を疑うことを知らないの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400412
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 110400412,
					"content": "安心して、君がこのまま戻っても誰も怒らないわよ。私が参加すると思ってないでしょうからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400413
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 110400413,
					"content": "これ以上モタモタしてると本当に遅刻しちゃうけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400414
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 110400414,
					"content": "そうだった！大事な記念行事、遅刻したらまずい…じゃあ、戻るね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400415
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 110400415,
					"content": "なんか…あのシスター、詭弁しか言ってなかった気がするなぁ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400416
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110400416,
					"content": "さっきから気付いてるわよ——君たち、誰？何のために盗み聞きしてたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400417
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 110400417,
					"content": "気を付けろ！危険なやつだと思うぞ…少なくとも、ずる賢いのは間違いない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400418
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110400418,
					"content": "あら？長い歴史を持つ西風教会のメンバーよりも、君のような素性の知れない浮遊物の方が危険だと思うけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400419
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 110400419,
					"content": "今の聞こえたのか！？すごい小声で言ったのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400420
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110400420,
					"content": "ふーん、浮遊物を連れた異邦人…なるほど、君が…ふふっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400421
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 110400421,
					"content": "風魔龍を倒した「栄誉騎士」、その肩書きに免じて盗み聞きの件は大目に見てあげるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400422
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 110400422,
					"content": "でないと…君たちの返答次第では、最悪牢屋に入れる可能性もあるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400423
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 110400423,
					"content": "えっ！モンドのシスターは不審者の確保も担当してるのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400424
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110400424,
					"content": "少なくとも見て見ぬふりはできないでしょ？シスターにだって正義感はあるわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400425
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 110400425,
					"content": "うっ、なんだか違和感があるけど、否定もできないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400426
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110400426,
					"content": "君たちこそ、何のために雪山に来たの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400427,
						110400428
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 110400427,
					"content": "アルベドを探しに来た。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400431
					]
				},
				{
					"id": 110400431,
					"content": "彼を探すなら、その足跡を辿ってみるといいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400432
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 110400432,
					"content": "雪が止んでからここを通る人は結構多かったから、まだ残ってるといいんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400433
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 110400433,
					"content": "もしかして、おまえも彼を探しに来たのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400434
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110400434,
					"content": "違うわ、これらの足跡に元素力が残ってたからね。職業病みたいなものよ、警戒しておいて損はないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400435,
						110400436
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 110400435,
					"content": "シスターにしては謎がありすぎる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400437
					]
				},
				{
					"id": 110400437,
					"content": "勝手に思ってなさい。私も彼の様子を見に行くから、行きましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 110400436,
					"content": "探偵みたいだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400437
					]
				},
				{
					"id": 110400428,
					"content": "世界の真相を探しに来た。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400429
					]
				},
				{
					"id": 110400429,
					"content": "でも君は旅人、偉大な錬金術師じゃないよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400430
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 110400430,
					"content": "まあいいわ、誰を探しに来たかは分かった気がする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400431
					],
					"speakerTitle": "ロサリア"
				}
			]
		},
