			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"関垂"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705230401,
					"content": "今回のブリュー祭の名物ドリンクは、軽策荘の岩清水を使った茶とよく合いそうだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230402
					],
					"speakerTitle": "関垂"
				},
				{
					"id": 705230402,
					"content": "やあ、二人ともお手数だったな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230403,
						705230407,
						705230415
					],
					"speakerTitle": "関垂"
				},
				{
					"id": 705230403,
					"content": "#{M#君}{F#あなた}自身について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230404
					]
				},
				{
					"id": 705230404,
					"content": "俺は仲間数人と村に引っ越してきたばかりでね。普段は畑で働く兄弟たちのために食事を作って、畑に届けているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230405
					],
					"speakerTitle": "関垂"
				},
				{
					"id": 705230405,
					"content": "でも俺が作るのは簡単で腹が膨れるだけの料理がほとんどだから、よそから来たお客さんに出すにはちょっとみっともないかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230406
					],
					"speakerTitle": "関垂"
				},
				{
					"id": 705230406,
					"content": "軽策荘は賑やかな都会じゃないけど、美味い物は多いんだ。村をぶらぶらしてみればわかるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "関垂"
				},
				{
					"id": 705230407,
					"content": "茶について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230408
					]
				},
				{
					"id": 705230408,
					"content": "仲間は畑仕事をしていてすごく喉が渇くから、半日でも大量のお茶を飲むんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230409
					],
					"speakerTitle": "関垂"
				},
				{
					"id": 705230409,
					"content": "でも畑と村の茶屋はかなり離れてて、行き来するのは不便でさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230410
					],
					"speakerTitle": "関垂"
				},
				{
					"id": 705230410,
					"content": "凱じぃもあの歳だから、仲間たちにお茶を届けてくれって頼むわけにもいかない。そこで俺がこの仕事を引き受けたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230411
					],
					"speakerTitle": "関垂"
				},
				{
					"id": 705230411,
					"content": "俺と仲間はしばらくよそで暮らしていたせいか、大きな器に入ったお茶はちょっとあっさりしすぎに感じてさ。兄弟たちは時々味の濃いものを飲みたいって言うんだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230412
					],
					"speakerTitle": "関垂"
				},
				{
					"id": 705230412,
					"content": "だからお茶に別の飲み物を加えて、新鮮な風味を出して、あいつらに楽しく飲んでもらおうと思ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230413
					],
					"speakerTitle": "関垂"
				},
				{
					"id": 705230413,
					"content": "もちろん、俺が作ったお茶は兄弟の何人かにしか提供しない。凱じぃの商売を奪うわけにいかないからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230414
					],
					"speakerTitle": "関垂"
				},
				{
					"id": 705230414,
					"content": "暇ができたら、俺たちも凱じぃの茶屋でお茶をいただくついでに、雑用を手伝ってあげるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "関垂"
				},
				{
					"id": 705230415,
					"content": "すぐ戻ってくる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230416
					]
				},
				{
					"id": 705230416,
					"content": "ああ！いい知らせを待ってるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "関垂"
				}
			]
		},
		{
