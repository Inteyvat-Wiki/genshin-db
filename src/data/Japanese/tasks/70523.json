			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"関垂"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705230301,
					"content": "関垂さん、ただいま！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705230302,
					"content": "頼まれてた「バケーションサイダー」百箱、発注してきたぞ。これが受注書だ、受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705230303,
					"content": "ああ良かった！二人のおかげで大助かりだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230304
					],
					"speakerTitle": "関垂"
				},
				{
					"id": 705230304,
					"content": "「バケーションサイダー」をよく研究しないとな。この新鮮なドリンクとお茶をいい割合で混ぜて、最高の喉ごしにして、仲間たちがもっと元気に畑仕事できるようにするよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230305
					],
					"speakerTitle": "関垂"
				},
				{
					"id": 705230305,
					"content": "へえ、カクテルを作るみたいだな。でもお茶で割るなんて…本当に美味しくなるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705230306,
					"content": "安心してくれ。俺は以前よそで料理人をしていたんだが、割ることでコストも味も最高のバランスになるんだ。もう何度も混ぜたことがある！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230307
					],
					"speakerTitle": "関垂"
				},
				{
					"id": 705230307,
					"content": "ちょっと飲んでみたい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230308
					]
				},
				{
					"id": 705230308,
					"content": "今度軽策荘に遊びに来てくれたら、実物でもてなすよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230309
					],
					"speakerTitle": "関垂"
				},
				{
					"id": 705230309,
					"content": "#やった！その時は{NICKNAME}に先に味見してもらおう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705230310,
					"content": "バーテンダー兼料理人さん、頑張ってね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230311
					]
				},
				{
					"id": 705230311,
					"content": "ありがとう！暇ができたらまた来てくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "関垂"
				}
			]
		},
		{
			"id": 7052304,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
