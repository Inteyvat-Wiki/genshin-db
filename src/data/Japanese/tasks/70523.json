			},
			"dialogs": [
				{
					"id": 705230101,
					"content": "よそから来たお客さんかな？軽策荘へようこそ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230102,
						705230103
					],
					"speakerTitle": "関垂"
				},
				{
					"id": 705230102,
					"content": "どうも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230104
					]
				},
				{
					"id": 705230104,
					"content": "まて！オイラが先に自己紹介するぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705230105,
					"content": "#こいつは万能の旅人、{NICKNAME}。オイラはその最高の相棒、パイモンだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705230106,
					"content": "今、他の地方にいるやつらがブリュー祭の名物ドリンクを注文するのを手伝ってるんだ。おまえの依頼を見かけたから、直接商談に来たぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705230107,
					"content": "なるほど！単刀直入に話してくれるのは嫌いじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230109
					],
					"speakerTitle": "関垂"
				},
				{
					"id": 705230109,
					"content": "俺は料理人の関垂。<color=#00E1FFFF>「バケーションサイダー」を100箱</color>仕入れないといけないんだ。お茶で割って、いつも力仕事をしてる仲間たちに存分に飲んでもらおうと思ってさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230110
					],
					"speakerTitle": "関垂"
				},
				{
					"id": 705230110,
					"content": "よし！じゃあ仕事に取りかかるから、仕入れ資金を渡してくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705230111,
					"content": "もう準備できてるよ。この「ブリューゼリー」を持っていってくれ。仕入れた後にきっと余りが出るだろうけど、残りがいくらであろうと、二人の苦労に対する報酬ってことで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230112
					],
					"speakerTitle": "関垂"
				},
				{
					"id": 705230112,
					"content": "確かに受け取ったぞ。じゃあ出発だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705230113,
					"content": "頼もしいな！いい知らせを待ってるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230114,
						705230115
					],
					"speakerTitle": "関垂"
				},
				{
					"id": 705230114,
					"content": "なんてスピーディーな商談…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230116
					]
				},
				{
					"id": 705230116,
					"content": "#ぼさっとしてないで、行くぞ、{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705230117,
					"content": "話したいことがあるなら、発注の後だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705230118,
					"content": "この仕事が早く済めば、オイラたちも早く店をオープンできるからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705230119,
					"content": "開店開店、フフン～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705230115,
					"content": "パイモンもやるね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230116
					]
				},
				{
					"id": 705230103,
					"content": "失礼ですが、あなたは…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230104
					]
				}
			]
		},
		{
			"id": 7052302,
