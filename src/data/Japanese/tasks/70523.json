					"ゲオルグ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705230201,
					"content": "おっ！また来たのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230202
					],
					"speakerTitle": "ゲオルグ"
				},
				{
					"id": 705230202,
					"content": "今回もよその国のやつらの仕入れを手伝ってるのかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230203
					],
					"speakerTitle": "ゲオルグ"
				},
				{
					"id": 705230203,
					"content": "おう！今回は「バケーションサイダー」が百箱だ。依頼人は軽策荘の料理人、関垂さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705230204,
					"content": "こっちはいつでも値段を提示できるぜ、ゲオルグさん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230205,
						705230206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705230205,
					"content": "何だか商談対決みたい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230207
					]
				},
				{
					"id": 705230207,
					"content": "ほう、威勢がいいな。では今回の覚悟を見せてもらおうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ゲオルグ"
				},
				{
					"id": 705230206,
					"content": "受けてみろ、ゲオルグさん！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230207
					]
				}
			]
		},
		{
			"id": 7052303,
			"completionStepIds": [
				7052303
