			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"エフェンディ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736730101,
					"content": "こんにちは。ようこそ、レグザー庁へ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730102
					],
					"speakerTitle": "エフェンディ"
				},
				{
					"id": 736730102,
					"content": "こちらは「三十人団」が互いに連絡を取り合い、事務を斡旋するための場所です。服装を見るに、あなたは彼らのメンバーではないようですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730103
					],
					"speakerTitle": "エフェンディ"
				},
				{
					"id": 736730103,
					"content": "もしかして…募集についての情報を聞いて、応募しにいらしたのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730106,
						736730104
					],
					"speakerTitle": "エフェンディ"
				},
				{
					"id": 736730106,
					"content": "その通り。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736730107
					]
				},
				{
					"id": 736730107,
					"content": "やはりそうでしたか、わかりました。念のため、仕事の状況や内容について改めて説明させていただきます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730108
					],
					"speakerTitle": "エフェンディ"
				},
				{
					"id": 736730108,
					"content": "私はエフェンディと申します。連絡員として教令院から派遣され、教令院と「三十人団」の協力関係をスムーズに進行させる役割を担っております。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730109
					],
					"speakerTitle": "エフェンディ"
				},
				{
					"id": 736730109,
					"content": "ご存知かもしれませんが、「三十人団」は教令院に雇われており、スメールシティ全体を守護する責任があります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730110
					],
					"speakerTitle": "エフェンディ"
				},
				{
					"id": 736730110,
					"content": "また、住民が生活の中で遭遇するトラブルへの対応も彼らの仕事の一つなので、全体的な仕事量が膨大なものになってしまっているのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730111
					],
					"speakerTitle": "エフェンディ"
				},
				{
					"id": 736730111,
					"content": "そのことについて伝令官と相談した結果、彼らの負担を分散させるために、アシスタントを募集することになったのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730112
					],
					"speakerTitle": "エフェンディ"
				},
				{
					"id": 736730112,
					"content": "もちろん、シティの防衛については心配いりません。住民たちの生活に関わる依頼を受けていただくだけで十分です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730113
					],
					"speakerTitle": "エフェンディ"
				},
				{
					"id": 736730113,
					"content": "具体的な依頼の内容については、細々としたものが多いので、わかりやすいように例を挙げて説明しますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エフェンディ"
				},
				{
					"id": 736730104,
					"content": "応募？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736730105
					]
				},
				{
					"id": 736730105,
					"content": "募集要項も読まずにいらしたのですか？まあ、それでも問題はありません。私が説明させていただきます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730108
					],
					"speakerTitle": "エフェンディ"
				}
			]
		},
		{
			"id": 7367302,
			"completionStepIds": [
				7367302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7367302",
							"2"
						],
						"stepId": 7367302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"エフェンディ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736730201,
					"content": "大体こんな感じでしょうか。もし時間があって依頼を受けていただけるようなら、とても助かります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730202
					],
					"speakerTitle": "エフェンディ"
				},
				{
					"id": 736730202,
					"content": "後方勤務官とも交渉して、あなたが依頼を引き受けて達成するたびに、十分な報酬を得られるようにしておきました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730203
					],
					"speakerTitle": "エフェンディ"
				},
				{
					"id": 736730203,
					"content": "こちらの依頼には些細なことも多いのですが、この仕事の重要性を軽視してはなりません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730204
					],
					"speakerTitle": "エフェンディ"
				},
				{
					"id": 736730204,
					"content": "人々が生活の中で直面するトラブルを解決していけば、すべての人から感謝され、尊敬されることでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730205
					],
					"speakerTitle": "エフェンディ"
				},
				{
					"id": 736730205,
					"content": "根気よく続けていけば、住民からの評判も上がり、あなたを受け入れてくれる人も増えるはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730206
					],
					"speakerTitle": "エフェンディ"
				},
				{
					"id": 736730206,
					"content": "その時になりましたら、より複雑で重要な仕事を依頼させていただきます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730207
					],
					"speakerTitle": "エフェンディ"
				},
				{
					"id": 736730207,
					"content": "この仕事に関する説明は以上です。ぜひ、よく考えてみてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730208
					],
					"speakerTitle": "エフェンディ"
				},
				{
					"id": 736730208,
					"content": "依頼を引き受けると決められたときは、いつでも手続きにいらしてくださいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エフェンディ"
				}
			]
		}
	]
}