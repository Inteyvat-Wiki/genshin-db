						10131306
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10131308,
					"content": "「公子」という人に…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10131309
					]
				},
				{
					"id": 10131307,
					"content": "それだけしかないの？なら仕方ないね",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10131308
					],
					"speakerTitle": "阿三"
				},
				{
					"id": 10131309,
					"content": "「公子」？そいつが支払いを持ってくれるって？いや、でも行かないよ。関係のない仕事が増えるだけじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10131310
					],
					"speakerTitle": "阿三"
				},
				{
					"id": 10131310,
					"content": "そうだな、こうしよう。まず今あるお金を払ってもらって、それから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10131311
					],
					"speakerTitle": "阿三"
				},
				{
					"id": 10131311,
					"content": "<color=#00E1FFFF>鉄鉱石</color>を1個くれたら、追加費用なしで「公子」とやらのとこに行くよ。これでどうだい？",
