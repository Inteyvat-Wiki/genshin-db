	"talks": [
		{
			"id": 101301,
			"completionStepIds": [
				101301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101301",
							"2"
						],
						"stepId": 101301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"山ばあや"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10130101,
					"content": "お客さん、もう来たのかい？予約していた7枚の凧はできてるよ。もう受け取るかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130102
					],
					"speakerTitle": "山ばあや"
				},
				{
					"id": 10130102,
					"content": "ああ、頼む。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130103
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10130103,
					"content": "この時期にこういう凧を買うお客さんは珍しい。昔だったら、ちょっと特殊なお客さんが買いに来てくれたけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130104
					],
					"speakerTitle": "山ばあや"
				},
				{
					"id": 10130104,
					"content": "えっと、鍾離は「往生堂」の客卿だから、そういった事情にも詳しいよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10130105,
					"content": "それに、旅の途中で鍾離は色んな事をいっぱい教えてくれた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130106,
						10130107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10130106,
					"content": "服装、日用品、宝石、陶磁器にも詳しい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10130108
					]
				},
				{
					"id": 10130108,
					"content": "ああ…璃月の人々が大好きな経済や政治の話もわかるみたいだけど、それより「使いどころのない」知識のが好きみたいだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10130109,
					"content": "ハハッ…そういう面白いことをお前たちと共有したかったからだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130110
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10130110,
					"content": "子供のおもちゃは面白いものだからね。…私も子供の笑顔を見るのが好きだけど、それとは別の思いもあるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130111
					],
					"speakerTitle": "山ばあや"
				},
				{
					"id": 10130111,
					"content": "子供はいつだって精巧なものを好きになる。しかし、この「精巧」も千年以上の積み重ねであり、その裏にはちゃんと「意味」が存在している。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130112
					],
					"speakerTitle": "山ばあや"
				},
				{
					"id": 10130112,
					"content": "私は璃月で40年凧を作ってきた、だからどんな様式の凧もよく知っている。お客さんが注文した7枚の凧、その意味は普通とは異なるものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130113
					],
					"speakerTitle": "山ばあや"
				},
				{
					"id": 10130113,
					"content": "その通りだ。これは「送仙儀式」に使う飾り物、7枚の凧は…七神を象徴する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130114
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10130114,
					"content": "フフフッ…風神に捧げる凧の模様は、「自由」に色を塗らせてもらったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130115
					],
					"speakerTitle": "山ばあや"
				},
				{
					"id": 10130115,
					"content": "岩神に捧げるものは「契約」通りに描いた。この模様は古くからあって、「黄金屋」でも見ることができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130116
					],
					"speakerTitle": "山ばあや"
				},
				{
					"id": 10130116,
					"content": "うん？「黄金屋」って、最近聞いたな——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130117,
						10130118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10130117,
					"content": "しっ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10130119
					]
				},
				{
					"id": 10130119,
					"content": "ん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10130120,
					"content": "この凧の雷の模様…ふむ、輪転する感じが上手く描かれている。まさに雷神が欲している「永遠」そのものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130121
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10130121,
					"content": "「知恵」に捧げる草の模様、銀木の年輪…それらが巧妙に凧の骨組みと融和されている、素晴らしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130122
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10130122,
					"content": "水面のように均整の取れた「正義」、炎のように熱く燃える「戦争」、それからかつての氷神の…ふむ、細部まで精巧だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130123
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10130123,
					"content": "フフフ、詳しいお客さんからたまに褒められるのも、私の楽しみのひとつだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130124
					],
					"speakerTitle": "山ばあや"
				},
				{
					"id": 10130124,
					"content": "では、品物をいただこう。金に関しては…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130125,
						10130126
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10130125,
					"content": "しまった！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10130127
					]
				},
				{
					"id": 10130127,
					"content": "俺が払うよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130128
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10130128,
					"content": "あっ、「公子」だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130129,
						10130131
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10130129,
					"content": "ここで会う約束をしてた？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10130130
					]
				},
				{
					"id": 10130130,
					"content": "ハハッ、ただの通りすがりだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130133
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10130133,
					"content": "鍾離先生は相変わらずだ。支払いをする時…いや、誰かが支払いをしてくれる時、いつも値段を見ないし、財布の中身も見ない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130134
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10130134,
					"content": "だが、実際は金銭の価値を理解していて、世間の人々の苦しみだって理解している。それなのに「貧乏」というものが分からず、彼自身がそうなりえる可能性を分かってない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130135
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10130135,
					"content": "もしくは金を持っていない自分を想像できない、と言った方がいいかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130136
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10130136,
					"content": "ありえない、よくここまで餓死せずに生きてこれたな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130137
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10130137,
					"content": "…「公子」殿は相変わらず冗談を言うのがお好きだ。さて、凧も手に入れたし次の準備だ、休息は不要だろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130138
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10130138,
					"content": "「送仙儀式」には物だけでなく人手も必要だ。埠頭の付近なら、労働者を雇えるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130139
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10130139,
					"content": "#{NICKNAME}、この金を持ってくといい——あと言わなくても分かるよね？値切りは君自身がすること。鍾離先生に任せてはダメだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130140
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10130140,
					"content": "うん…一歩遅かったな、なにやら面白い情報を聞き逃したみたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130141
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10130141,
					"content": "…今度は、もっとタイミングを見計らって登場しないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10130131,
					"content": "待ち伏せ？",
