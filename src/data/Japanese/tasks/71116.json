			"dialogs": [
				{
					"id": 711160202,
					"content": "アンタらは今日からダチだ。この大恩は忘れないよ。何か助けが必要なときは、ひと声かけとくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160203
					],
					"speakerTitle": "鉄豆"
				},
				{
					"id": 711160203,
					"content": "おお！なかなか義理堅いやつだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160204,
						711160207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711160204,
					"content": "じゃあ率直に言うね、最近懐が寂しくて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160205
					]
				},
				{
					"id": 711160205,
					"content": "モラが必要ってことかい？あはは、それならお安い御用だ。ただちょっと厄介なことに——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160206
					],
					"speakerTitle": "鉄豆"
				},
				{
					"id": 711160206,
					"content": "アタシらのモラは、全部カシラが持ってっちまってんのさ。今じゃこの拠点は一文無しってわけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160210
					],
					"speakerTitle": "鉄豆"
				},
				{
					"id": 711160210,
					"content": "カシラ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160211
					]
				},
				{
					"id": 711160211,
					"content": "アタシら「鉄塩{RUBY#[S]テツエンバン}幇」の首領だよ。あっちの崖の下で、フォンテーヌの連中と「砂をさばいてる」。そんで、アタシらを留守番に残したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160212
					],
					"speakerTitle": "鉄豆"
				},
				{
					"id": 711160212,
					"content": "でもさっきアンタらも見ただろ？あのフォンテーヌのド畜生どもが、カシラが取り込んでる隙にこっそりアタシらの尻毛を抜いて…カチコミをかけてきやがったんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160213
					],
					"speakerTitle": "鉄豆"
				},
				{
					"id": 711160213,
					"content": "うわぁ…尻の毛を抜くって…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711160214,
					"content": "ひっ…！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160215
					]
				},
				{
					"id": 711160215,
					"content": "フン！上等じゃないか、アタシらをいいカモだとでも思ってたのかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160216
					],
					"speakerTitle": "鉄豆"
				},
				{
					"id": 711160216,
					"content": "今ここには敵が押し寄せて来てるし、カシラも罠にはめられるかもしれない。乗りかかった船だ、もう一度助けてくんないかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160217
					],
					"speakerTitle": "鉄豆"
				},
				{
					"id": 711160217,
					"content": "カシラが無事だったら、たんまり礼をするって約束するよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160218
					],
					"speakerTitle": "鉄豆"
				},
				{
					"id": 711160218,
					"content": "どこなの？とりあえず行ってみる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160219
					]
				},
				{
					"id": 711160219,
					"content": "あっちの崖の下に広がってる浜辺さ。行けばすぐ見つかるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160220
					],
					"speakerTitle": "鉄豆"
				},
				{
					"id": 711160220,
					"content": "じゃ、アンタらは先に行っててくれるかい。アタシはここを片付けたら行くよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鉄豆"
				},
				{
					"id": 711160207,
					"content": "困ってる人がいたら助太刀するまで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160208
					]
				},
				{
					"id": 711160208,
					"content": "義侠心あふれるご立派な心がけだねえ。それなら、二人にちょうど相談したいことがあるんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160209
					],
					"speakerTitle": "鉄豆"
				},
				{
					"id": 711160209,
					"content": "カシラのほうがさ、下手すりゃコトだから…助けにいかないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160210
					],
					"speakerTitle": "鉄豆"
				}
			]
		},
