			"dialogs": [
				{
					"id": 711160401,
					"content": "ジョニーのカシラ、俺とお前さんの仲だろう。俺もお前さんらが近頃困ってるってことは知ってるさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160402
					],
					"speakerTitle": "鉄明"
				},
				{
					"id": 711160402,
					"content": "何か問題があるってんなら面と向かって相談してくれりゃあいいのに、こんなことになるなんて…ちょいと気分が悪いじゃねえか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160403
					],
					"speakerTitle": "鉄明"
				},
				{
					"id": 711160403,
					"content": "なあ、親友…分かるだろう？こちらの商売も今までのようには行かなくなってきた。近頃「棘薔薇の会」が勢いづいてきたもんで、うちの舎弟どもは干上がっちまったあげく、捕まって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160404
					],
					"speakerTitle": "ジョニー"
				},
				{
					"id": 711160404,
					"content": "ヒナ鳥たちは腹を空かせて鳴いてる。このままじゃ、糊口をしのぐことすらままならなくなるだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160405
					],
					"speakerTitle": "ジョニー"
				},
				{
					"id": 711160405,
					"content": "俺たちはお互い良い商売ができてる。もし俺たちにもう少し…感謝したくなるような機会を与えてくれれば、あんたも俺の誠意がもっとよく分かるようになると思うんだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160406
					],
					"speakerTitle": "ジョニー"
				},
				{
					"id": 711160406,
					"content": "さもなきゃ…ハハハ、海はこんなに広いんだ。鉄明さん、あんたらも新しい友人がすぐ見つかるぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160407
					],
					"speakerTitle": "ジョニー"
				},
				{
					"id": 711160407,
					"content": "ということは、ジョニーのカシラ、この見積もりがお前さんの本心ということかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160408
					],
					"speakerTitle": "鉄明"
				},
				{
					"id": 711160408,
					"content": "ん？この金額に何か問題でも？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160409
					],
					"speakerTitle": "ジョニー"
				},
				{
					"id": 711160409,
					"content": "この…フォンテーヌ野郎ッ！その目は節穴か！これっぽっちの金で誰が動くってんだ！？デタラメばっかりぬかしやがって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160410
					],
					"speakerTitle": "鉄船"
				},
				{
					"id": 711160410,
					"content": "うるせぇ！お前はすっこんでな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160411
					],
					"speakerTitle": "鉄明"
				},
				{
					"id": 711160411,
					"content": "ジョニーのカシラ、うちの品物はハウス·オブ·ドン·ペッシェに一箱五万八千、ハウス·オブ·デ·ニーロに一箱七万で売ってんだ。どちらもルミドゥースハーバーの地下にその名を轟かせるマフィアさ——まぁ、これは俺が言うまでもないな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160412
					],
					"speakerTitle": "鉄明"
				},
				{
					"id": 711160412,
					"content": "対して、うちの品物をお前さんに売るときは、三箱でたったの十万。しかも専用のルートで受け渡している…なぜここまですると思う？お前さんという友人を大切にしているからさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160413
					],
					"speakerTitle": "鉄明"
				},
				{
					"id": 711160413,
					"content": "道理についてはとやかく言わねぇが…俺はジョニーのカシラがまだよく考えてないだけだって信じてっからよ。どこかで一杯飲んで、また話し合おうじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160414
					],
					"speakerTitle": "鉄明"
				},
				{
					"id": 711160414,
					"content": "ハハッ、その必要はない。璃月人は何よりも契約にこだわり、契約においては何よりも公平を重視するってことは知ってる。道理や人情が公平よりも上だなんて話は聞いたことがない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160415
					],
					"speakerTitle": "ジョニー"
				},
				{
					"id": 711160415,
					"content": "ハハッ、ジョニーのカシラ！そこまで契約を重んじるとは、その精神…うちの舎弟どもにも見習わせるべきだな、ハハハ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160416
					],
					"speakerTitle": "鉄明"
				},
				{
					"id": 711160416,
					"content": "だが——この件では、まずあんたらが契約を尊重してんのかどうかってトコを見ねぇとな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160417
					],
					"speakerTitle": "鉄明"
				},
				{
					"id": 711160417,
					"content": "それはもちろん！あんたが言ったことはごもっともだ。璃月の古い契約にはまったく敬服するばかりだ…ここは敬意を示さねばならないところだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160418
					],
					"speakerTitle": "ジョニー"
				},
				{
					"id": 711160418,
					"content": "ウォーカー、それぞれの品の見積り額をさらに…一モラずつ上げるっていうのは、どう思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160419
					],
					"speakerTitle": "ジョニー"
				},
				{
					"id": 711160419,
					"content": "妥当です、ジョニー様。こちらの璃月の方々はこんなに苦労なさっているのですから、品物一つにつき一モラの報酬を追加でお支払いするべきでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160420
					],
					"speakerTitle": "ウォーカー"
				},
				{
					"id": 711160420,
					"content": "フォンテーヌ野郎が！それは一体どういう意味だ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160421
					],
					"speakerTitle": "鉄船"
				},
				{
					"id": 711160421,
					"content": "なあ親友、遠路はるばるやって来た俺たちの誠意がまだ分からないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160422
					],
					"speakerTitle": "ジョニー"
				},
				{
					"id": 711160422,
					"content": "ジョニーのカシラ、それは絶対に約束は守らないってことかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160423
					],
					"speakerTitle": "鉄明"
				},
				{
					"id": 711160423,
					"content": "おっ？そうなるのか？ウォーカー、お前はどう思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160424
					],
					"speakerTitle": "ジョニー"
				},
				{
					"id": 711160424,
					"content": "そうですね…ジョニー様、私の意見を申し上げるなら…海は広いのだから身の程をわきまえろ、このタコ、と思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160425
					],
					"speakerTitle": "ウォーカー"
				},
				{
					"id": 711160425,
					"content": "ウォーカー、俺はお前が恥ずかしい。どうして俺たちの璃月の友人をそんなふうに侮辱するんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160426
					],
					"speakerTitle": "ジョニー"
				},
				{
					"id": 711160426,
					"content": "最後には彼らの地盤を引き継ぐことになるんだから、我々は感謝すべきだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160427
					],
					"speakerTitle": "ジョニー"
				},
				{
					"id": 711160427,
					"content": "失礼いたしました、ジョニー様。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160428
					],
					"speakerTitle": "ウォーカー"
				},
				{
					"id": 711160428,
					"content": "お前ら…！この恥知らずめ！そんな思惑を持っていやがったのか…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160429
					],
					"speakerTitle": "鉄船"
				},
				{
					"id": 711160429,
					"content": "どうして喧嘩してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160430
					]
				},
				{
					"id": 711160430,
					"content": "おっと？この二人のお子様は誰だ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160431
					],
					"speakerTitle": "ジョニー"
				},
				{
					"id": 711160431,
					"content": "ハハハ、実に面白い。璃月の子供はみんなこんなに度胸があるのか？ウォーカー。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160432
					],
					"speakerTitle": "ジョニー"
				},
				{
					"id": 711160432,
					"content": "こら、チビ助！どっから来た。小遣いをやるから、とっとと帰ってママのところでミルクでも飲んでな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160433
					],
					"speakerTitle": "ウォーカー"
				},
				{
					"id": 711160433,
					"content": "な…！本当に失礼なやつらだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160434
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711160434,
					"content": "お二人は…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160435,
						711160436
					],
					"speakerTitle": "鉄明"
				},
				{
					"id": 711160435,
					"content": "たんまり礼をもらいに来た。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160437
					]
				},
				{
					"id": 711160437,
					"content": "ハハハハ！ってことは…鉄明さんに招かれた助っ人だな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160438
					],
					"speakerTitle": "ジョニー"
				},
				{
					"id": 711160438,
					"content": "鉄明さんのほうもこちらに思うところがあったというわけか？フン、だがこちらも用意がないわけじゃないぞ。ウォーカー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160439
					],
					"speakerTitle": "ジョニー"
				},
				{
					"id": 711160439,
					"content": "出てこい！頃合いだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160440
					],
					"speakerTitle": "ウォーカー"
				},
				{
					"id": 711160440,
					"content": "何だと！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160441
					],
					"speakerTitle": "鉄船"
				},
				{
					"id": 711160441,
					"content": "おやおや？やはりこちらの方が頭数が多いようだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160442
					],
					"speakerTitle": "ジョニー"
				},
				{
					"id": 711160442,
					"content": "鉄明さん、残念だが、事前に部下に仕事を与えていた。今ごろそちらの拠点に残されていた者は、きれいに片付けられているはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160443
					],
					"speakerTitle": "ジョニー"
				},
				{
					"id": 711160443,
					"content": "安心して消えるがいい。そちらの商売は我々がきちんと処理させていただこう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160444
					],
					"speakerTitle": "ジョニー"
				},
				{
					"id": 711160444,
					"content": "ジョニーよ…我ら「鉄塩幇」に、そう簡単に手を出せると思うなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160445
					],
					"speakerTitle": "鉄明"
				},
				{
					"id": 711160445,
					"content": "その言に負けない強運がついてるといいがな。かかれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジョニー"
				},
				{
					"id": 711160436,
					"content": "その人たちにミルクを飲ませてあげたくて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160437
					]
				}
			]
		},
