			"dialogs": [
				{
					"id": 711160601,
					"content": "侠客さんたちよ、心から感謝するぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160602
					],
					"speakerTitle": "鉄明"
				},
				{
					"id": 711160602,
					"content": "どういたしまして！どこで取引するにしても、契約は守らないとな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160603
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711160603,
					"content": "ハハハ、お前さんの言う通りだ。しかし…どうやらお二人さんは、我々の取引についてよく知ってるみてぇだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160604
					],
					"speakerTitle": "鉄明"
				},
				{
					"id": 711160604,
					"content": "鉄豆が教えてくれたんだ。おまえらがここで「砂をさばいてる」とかなんとか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160605
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711160605,
					"content": "でも「砂をさばく」ってどういう意味だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160606
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711160606,
					"content": "何だか正規の取引じゃなさそう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160607
					]
				},
				{
					"id": 711160607,
					"content": "そういうことなら、お二人には改めて感謝しねぇとな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160608
					],
					"speakerTitle": "鉄明"
				},
				{
					"id": 711160608,
					"content": "者ども！こいつらを縛り上げて、海に投げ捨てろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160609
					],
					"speakerTitle": "鉄明"
				},
				{
					"id": 711160609,
					"content": "石を多めに縛りつけておけ。このお二人は我ら鉄塩幇の恩人だ。あんまり苦しまずに済むようにな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160610
					],
					"speakerTitle": "鉄明"
				},
				{
					"id": 711160610,
					"content": "なんだって！？おまえ…オイラたちをどうしようっていうんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160611
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711160611,
					"content": "さっきはお二人さんもよく分かっていたじゃないか？璃月は契約を重んじる国だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160612
					],
					"speakerTitle": "鉄明"
				},
				{
					"id": 711160612,
					"content": "不法組織の取引を見破りゃ、口封じされるのは当然だ——誰でも知っている契約だろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160613
					],
					"speakerTitle": "鉄明"
				},
				{
					"id": 711160613,
					"content": "そんな契約があるもんか！そんな、恩を仇で返すようなのは、契約なんて呼ばないぞ！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160614
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711160614,
					"content": "俺の厚意を無駄にしないこった。俺みずから手を下せば、お前さんらは苦しい思いをすることになるぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160615,
						711160616
					],
					"speakerTitle": "鉄明"
				},
				{
					"id": 711160615,
					"content": "#{M#俺}{F#私}が誰だか分かってるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160617
					]
				},
				{
					"id": 711160617,
					"content": "つべこべ言うな！鉄豆！鉄船！何をぐずぐずしている！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160618
					],
					"speakerTitle": "鉄明"
				},
				{
					"id": 711160618,
					"content": "カシラ…お前はやっぱり仁義なんて持ち合わせてない男だったんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160619
					],
					"speakerTitle": "鉄船"
				},
				{
					"id": 711160619,
					"content": "アタシたちの苦労も無駄じゃなかったよ。アンタみたいな人を、これ以上璃月で好き放題にさせておけない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160626
					],
					"speakerTitle": "鉄豆"
				},
				{
					"id": 711160626,
					"content": "全員捕まえろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160620
					],
					"speakerTitle": "鉄豆"
				},
				{
					"id": 711160620,
					"content": "な…なんだと…！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160621
					],
					"speakerTitle": "鉄明"
				},
				{
					"id": 711160621,
					"content": "悪賊鉄明！その目をかっぴらいてとくと見な！アタシたちが何者か！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160622
					],
					"speakerTitle": "鉄豆"
				},
				{
					"id": 711160622,
					"content": "せ…千岩軍！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160623
					],
					"speakerTitle": "鉄明"
				},
				{
					"id": 711160623,
					"content": "おいおい！どうなってるんだ！？なんで急に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160624
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711160624,
					"content": "ただの新入りだとばかり思っていたが、まさかデコ助だったとは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160625
					],
					"speakerTitle": "鉄明"
				},
				{
					"id": 711160625,
					"content": "俺がおとなしくお縄を頂戴すると思うなよ！とことん抗ってやる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鉄明"
				},
				{
					"id": 711160616,
					"content": "ひえ～！お助けを～！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160617
					]
				}
			]
		},
