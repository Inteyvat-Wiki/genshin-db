			"dialogs": [
				{
					"id": 721280401,
					"content": "これだ！このホラガイだ。宝箱を1つ選んで開けていいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280402,
						721280403
					],
					"speakerTitle": "敬"
				},
				{
					"id": 721280402,
					"content": "1つしか開けちゃダメなの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280404
					]
				},
				{
					"id": 721280404,
					"content": "悪いが、この宝箱は1回で1つしか開けられない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280405
					],
					"speakerTitle": "敬"
				},
				{
					"id": 721280405,
					"content": "さて、早く1つ選んで開けてみろ。へへ、幸運を祈るぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "敬"
				},
				{
					"id": 721280403,
					"content": "全部開けてもいい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280404
					]
				}
			]
		},
		{
