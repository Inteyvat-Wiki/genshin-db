			"dialogs": [
				{
					"id": 721280501,
					"content": "宝箱はもう開けたよな。はははっ、幸運な結果だったといいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280502
					],
					"speakerTitle": "敬"
				},
				{
					"id": 721280502,
					"content": "そのホラガイを集めてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280503
					]
				},
				{
					"id": 721280503,
					"content": "鋭いな。そうだ、このホラガイを集めてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280504
					],
					"speakerTitle": "敬"
				},
				{
					"id": 721280504,
					"content": "でも、その理由まではまだ教えられない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280505,
						721280509
					],
					"speakerTitle": "敬"
				},
				{
					"id": 721280505,
					"content": "何か特別なところでもあるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280506
					]
				},
				{
					"id": 721280506,
					"content": "商売の観点から言えば、もちろん特別なところがある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280507
					],
					"speakerTitle": "敬"
				},
				{
					"id": 721280507,
					"content": "「祟り神の影響を受けたホラガイ」…ははは、きっといい値段で売れる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280508
					],
					"speakerTitle": "敬"
				},
				{
					"id": 721280508,
					"content": "コホンッ！とにかく、ホラガイを俺に渡せば、宝箱を開けられるってことだ。分かったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280511
					],
					"speakerTitle": "敬"
				},
				{
					"id": 721280511,
					"content": "さあ、これで今回の分はもう終わった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280512
					],
					"speakerTitle": "敬"
				},
				{
					"id": 721280512,
					"content": "宝箱を開けたいのなら、しばらく経ってからまたホラガイを持ってきてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "敬"
				},
				{
					"id": 721280509,
					"content": "怪しい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280510
					]
				},
				{
