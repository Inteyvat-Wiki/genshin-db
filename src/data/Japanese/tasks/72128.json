				"points": []
			},
			"dialogs": [
				{
					"id": 721280102,
					"content": "おい、待った。その宝箱は勝手に開けたらだめだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280103,
						721280105
					],
					"speakerTitle": "敬"
				},
				{
					"id": 721280103,
					"content": "#これは{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYSECOND|INFO_FEMALE_PRONOUN_GIRLSECOND]}の宝箱なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280104
					]
				},
				{
					"id": 721280104,
					"content": "もちろん、その宝箱はわざわざ俺がここに置いたものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280106
					],
					"speakerTitle": "敬"
				},
				{
					"id": 721280106,
					"content": "中に入ってるのは、俺が集めた宝ものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280107
					],
					"speakerTitle": "敬"
				},
				{
					"id": 721280107,
					"content": "お前がその宝箱を開けたいのなら、許可をやらなくもない。ただ…その代わり俺に渡してほしいものがある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280108,
						721280110
					],
					"speakerTitle": "敬"
				},
				{
					"id": 721280108,
					"content": "モラが欲しいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280109
					]
				},
				{
					"id": 721280109,
					"content": "はははっ、モラはいらない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280111
					],
					"speakerTitle": "敬"
				},
				{
					"id": 721280111,
					"content": "俺が欲しいのは、ある「ホラガイ」だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280112
					],
					"speakerTitle": "敬"
				},
				{
					"id": 721280112,
					"content": "浜の辺りに、このホラガイがたくさんあるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280113
					],
					"speakerTitle": "敬"
				},
				{
					"id": 721280113,
					"content": "宝箱の中の物が欲しいのなら、ホラガイと交換だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280114
					],
					"speakerTitle": "敬"
				},
				{
					"id": 721280114,
					"content": "だが…中に何が入ってるかは教えない。何が手に入るかは、お前の運次第だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280115
					],
					"speakerTitle": "敬"
				},
				{
					"id": 721280115,
					"content": "どうだ、宝箱を開けたいのなら、ホラガイを俺に渡してくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "敬"
				},
				{
					"id": 721280110,
					"content": "何がほしいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280111
					]
				},
				{
					"id": 721280105,
					"content": "中には何が入ってるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280106
					]
				}
			]
		},
