					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280204
					],
					"speakerTitle": "敬"
				},
				{
					"id": 721280204,
					"content": "中に入ってるのは、俺が集めた宝ものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280205
					],
					"speakerTitle": "敬"
				},
				{
					"id": 721280205,
					"content": "俺にあるものをくれれば、あの宝箱を開ける権利と、その中に入っているお宝をやる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
