		},
		{
			"id": 2100420,
			"completionStepIds": [
				2100420
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2100420",
							"2"
						],
						"stepId": 2100420,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ソラヤー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210042001,
					"content": "魔神でも、逃げられない運命があるんだね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042002
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210042002,
					"content": "四つの遺跡で四つの手がかりを見つけた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210042003
					]
				},
				{
					"id": 210042003,
					"content": "四つの遺跡と四つの手がかり…ちょうど「帰終の忠告」の数と同じだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042004
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210042004,
					"content": "でも、四つの文章はそれぞれ「帰終の忠告」に関係する解釈だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042005
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210042005,
					"content": "正確に解読したければ、「帰終の忠告」の原文が鍵となる。この四つはあくまで参考だね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042006
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210042006,
					"content": "この五つの文章を全て繋げたとして、それをどう解釈すればいいんだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042007
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210042007,
					"content": "「となる」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210042008
					]
				},
				{
					"id": 210042008,
					"content": "集まって一つとなる…まるで、この四つの文章は別の形で結びつけることができると言いたいみたいね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042009
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210042009,
					"content": "待って、確か、この四つの「諫め」はそれぞれ遺跡の中にあるから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042010
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210042010,
					"content": "うーん…一つ考えがある。この四つの「諫め」を解読したければ、もしかしてこれらの「諫め」が存在する<color=#00E1FFFF>「遺跡」</color>も関係してくるのかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042011
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210042011,
					"content": "でも、具体的な解読法はもう少し考えさせて…君も何かアイデアがあるなら、試してみていいからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042012
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210042012,
					"content": "なにせ、君は私みたいな走ったらすぐに疲れる学者じゃないから…はあ、こんなに体力を持ってるなんて、君が羨ましいよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042013
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210042013,
					"content": "さあ、私はここで考えるから、何かアイデアか発見があったら、私に教えて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ソラヤー"
				}
			]
		},
		{
			"id": 2100422,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
