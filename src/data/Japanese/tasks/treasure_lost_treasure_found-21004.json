			},
			"dialogs": [
				{
					"id": 210049001,
					"content": "この璃月の「伝説」に、一体どんな秘密が隠されてるの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210049002
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210049002,
					"content": "「伝説」の詳細について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210049003
					]
				},
				{
					"id": 210049003,
					"content": "君もここの伝説に興味があるの？えっとね、この「伝説」はこう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210049004
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210049004,
					"content": "「知恵と意志、団結と毅然さが水のように集まるところに、大地の宝物を見せよう。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210049005
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210049005,
					"content": "「知恵」、「意志」、「団結」と「毅然さ」は具体的な何かを意味すると思ってね、ずっと手掛かりを探してるんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210049006
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210049006,
					"content": "ある遺跡を見つけてね、しかもあの「伝説」と関連する手掛かりを入手したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210049007
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210049007,
					"content": "もし私の推測が正しければ、あの四つの単語は四つの遺跡のことだと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210049008
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210049008,
					"content": "この四つの遺跡を全部探し出せたら、あの「伝説」を全部解読できるはずだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210049009
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210049009,
					"content": "でも、私は体力があまりないから…遺跡を発見したのはいいけど、そのあと数日も動けなかったからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210049010
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210049010,
					"content": "興味があるなら、君も探してみるといいよ…私より先になにか突破口を見つけるかもしれないし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ソラヤー"
				}
			]
		},
