					"ソラヤー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210040101,
					"content": "「帰終の忠告」…一体何の暗示だろうね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040102,
						210040104
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210040102,
					"content": "準備できた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040103
					]
				},
				{
					"id": 210040103,
					"content": "フフッ、やる気があるね。さあ、この「帰終の忠告」を解読しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040106
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210040106,
					"content": "「知で教え、徳で約束し、骨を固く、心を一つ。この四つは『帰離集』となる」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040107
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210040107,
					"content": "文章を見ると、確かに日常生活に対する「諌め」みたいだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040108
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210040108,
					"content": "でも、これのどこに宝物の手がかりがあるんだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040109
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210040109,
					"content": "…仕方ない、学者の最も不器用で、最も苦労する方法を使ってみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040110
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210040110,
					"content": "まず、あの七つの言葉を発見した場所は、様々な「遺跡」の中でしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040111
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210040111,
					"content": "どう入手すれば分からないなら、引き続き「遺跡」を捜索してみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040112,
						210040116,
						210040122
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210040112,
					"content": "どこで探せば…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040113
					]
				},
				{
					"id": 210040113,
					"content": "うーん…捜索エリアなら、まずは「帰離原」の中にしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040114
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210040114,
					"content": "でも私みたいな学者が、君のスピードに追い付くことは無理だろうからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040115
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210040115,
					"content": "遺跡捜索は君に任せたよ。手がかりが見つかったら、戻って私に教えて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040129
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210040129,
					"content": "そう言えば、この付近である遺跡を発見したんだけど、その中に変わった円盤があって、上に字が刻まれてあって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040130
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210040130,
					"content": "でも、あの時私はマイナーな研究ばかりしてたから、深く調べようとしなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040131
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210040131,
					"content": "今思い返せば、あの遺跡にあった円盤は、この「帰終の忠告」と関係があるのかもしれないね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040132
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210040132,
					"content": "うん…こうしよう、地図に印をつけておくから、時間があったら見に行ってきて。何か手がかりがあるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210040116,
					"content": "ぜ、全部探すの…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040117
					]
				},
				{
					"id": 210040117,
					"content": "違うよ、捜索範囲を璃月全体に広げたら、私たち二人じゃ到底無理よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040118
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210040118,
					"content": "「帰離原」にある「帰離集」の宝物なら、捜索範囲を狭めよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040119
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210040119,
					"content": "捜索エリアはまず「帰離原」の中にしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040120
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210040120,
					"content": "そうだ、私みたいな学者が、君のスピードに追い付くことは無理だろうからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040121
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210040121,
					"content": "遺跡捜索は君に任せたよ。手がかりが見つかったら、戻って私に教えて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040129
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210040122,
					"content": "璃月の遺跡を全部探してくる！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040123
					]
				},
				{
					"id": 210040123,
					"content": "待って！気が早いよ、璃月は広いよ、いつまで探すつもり！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040124
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210040124,
					"content": "宝物の話になるとすぐそうなるから…なんて言えばいいのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040125
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210040125,
					"content": "「帰離原」にある「帰離集」の宝物なら、捜索範囲を狭めよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040126
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210040126,
					"content": "そうだね…捜索エリアはまず「帰離原」の中にしようか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040127
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210040127,
					"content": "もう、最後まで聞いてよ！いい？遺跡を細かく捜索して、何か発見したら、それを私に見せにきて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040128
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210040128,
					"content": "「帰離原」の中で捜索すること、あまり遠くに行かないでね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040129
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210040104,
					"content": "お宝を探しに行こう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040105
					]
				},
				{
					"id": 210040105,
					"content": "お宝の話になると、すごい元気になるよね…まあいいや、この「帰終の忠告」を解読しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040106
					],
					"speakerTitle": "ソラヤー"
				}
			]
		},
