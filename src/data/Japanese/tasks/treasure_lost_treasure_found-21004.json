			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ソラヤー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210045001,
					"content": "どう？宝物は見つかった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045003
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210045003,
					"content": "見つけた、確かに「集まる場所」にあった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210045004
					]
				},
				{
					"id": 210045004,
					"content": "なるほど…「帰終の忠告」にあった通りだね。宝物は「集まる場所」にあったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045005
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210045005,
					"content": "このなぞなぞを作った人は、きっと「帰終」を尊敬してるだろうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045006
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210045006,
					"content": "故郷が滅びても、こういう形で「帰終の忠告」を伝えるなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045007
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210045007,
					"content": "この忠告を作った「帰終」も、きっと彼女の民を愛していたんだろうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045008
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210045008,
					"content": "民に知恵を持ってほしい、道徳で自分たちを約束してほしい、体が強くあってほしい、そして心を一つに、故郷の「帰離集」を守ってほしかったんだね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045009,
						210045016,
						210045021
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210045009,
					"content": "でも失敗した。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210045010
					]
				},
				{
					"id": 210045010,
					"content": "失敗？そう言っても間違ってないね、彼女は死んだ…「帰離集」は滅びて、民たちは離れ離れになった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045011
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210045011,
					"content": "でも、こうして私たちは彼女の「帰終の忠告」を見つけたわけでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045012
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210045012,
					"content": "これはあの「帰終」が民のために作った諫めと祝福だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045013
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210045013,
					"content": "「帰終の忠告」を持って、彼女はこの大地で、民たちと手をつないで前へと進んだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045014
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210045014,
					"content": "たとえ彼女が死んだとしても、彼女の信念と理想は消えたりしない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045015
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210045015,
					"content": "それに、彼女を崇敬した人って賢いよね、こういう「宝物を隠す方法」で「帰終の忠告」を残したなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045028
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210045028,
					"content": "まあ、その人にとって、本当に宝物は金銀財宝か、それともこの「帰終の忠告」そのものかは、分からないけどね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045029
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210045029,
					"content": "ハハッ、私なら金銀財宝よりも、この「諫め」のほうが本当の宝物だと思うな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045030
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210045030,
					"content": "…でも、本当のことを言うと、宝物を捨てて、この「諫め」を選ぶ人はどれくらいいるだろうね？はあ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210045016,
					"content": "優しい魔神だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210045017
					]
				},
				{
					"id": 210045017,
					"content": "「優しい」という言葉を「魔神」に使うなんて、少し違和感がするけどね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045018
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210045018,
					"content": "遥か昔、人々を導いた魔神の中には、本当に「優しい」魔神もいたのかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045019
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210045019,
					"content": "民を守り、民と共にこの大地を歩き、前に進む。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045020
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210045020,
					"content": "…でもこんな優しい魔神も、結局は何も守れなかった。彼女が民のために作った諫めも、「宝物を隠す」形で残されることになるとはね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045029
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210045021,
					"content": "会ってみたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210045022
					]
				},
				{
					"id": 210045022,
					"content": "魔神に会いたいなんて、君も変わってるね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045023
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210045023,
					"content": "でも、もし本当に「帰終」に会ったら、何するの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045024
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210045024,
					"content": "「大変だったね」、「ありがとう」なんて言葉で、彼女を慰めるつもり？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045025
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210045025,
					"content": "私なら、「帰終の忠告」を暗唱したほうがいいと思うよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045026
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210045026,
					"content": "それで彼女の信念と理想は消えてない、彼女の教えを覚えてる人はこの大地にまだいるって彼女に伝えるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045027
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210045027,
					"content": "すべてを失った「帰終」にとって…それが一番いい慰めになると思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ソラヤー"
				}
			]
		},
