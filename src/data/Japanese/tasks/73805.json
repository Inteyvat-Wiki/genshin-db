			"dialogs": [
				{
					"id": 738050101,
					"content": "旅人、ちょっと待って。ここにあなた宛ての手紙が一通あるんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738050102
					],
					"speakerTitle": "マルヤム"
				},
				{
					"id": 738050102,
					"content": "#{M#俺}{F#私}宛ての手紙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738050103
					]
				},
				{
					"id": 738050103,
					"content": "あの「旭東」って璃月人があなたにって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738050104,
						738050105
					],
					"speakerTitle": "マルヤム"
				},
				{
					"id": 738050104,
					"content": "彼はどこに？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738050106
					]
				},
				{
					"id": 738050106,
					"content": "さあ、それは知らないけどね。この前、彼が慌ててこの手紙を預けて行ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738050107
					],
					"speakerTitle": "マルヤム"
				},
				{
					"id": 738050107,
					"content": "なんでも…絶対にあなたへ渡すようにって、私にお金までくれたんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738050108
					],
					"speakerTitle": "マルヤム"
				},
				{
					"id": 738050108,
					"content": "旭東が…慌てて？なにがあいつをそんなに慌てさせたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738050109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 738050109,
					"content": "まさか…あの悪いやつがまた邪魔してきたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738050110,
						738050111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 738050110,
					"content": "まず手紙を見よう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738050112
					]
				},
				{
					"id": 738050112,
					"content": "そうだな…まずはこの手紙を読んでみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 738050111,
					"content": "手紙にはっきり書かれてるかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738050112
					]
				},
				{
					"id": 738050105,
					"content": "彼はどうして手紙を？",
					"roleType": "TALK_ROLE_PLAYER",
