			"trigger": {
				"objectNames": [
					"スクロース"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412130101,
					"content": "アルベド！また来てやったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412130102,
					"content": "ん？いないみたいだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412130103,
					"content": "調査に出かけたのか？それとも秘密のスケッチでもしに行ったのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412130104,
					"content": "あ！あなたたち！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130105
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412130105,
					"content": "スクロースじゃないか。ここで何してるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412130106,
					"content": "研究がひと段落したから、今日は約5時間26分程、暇な時間があるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130107
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412130107,
					"content": "だから、あなたたちにお願いしていたことについて聞きに来たんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130108
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412130108,
					"content": "細かいな！おまえは人間時計なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412130109,
					"content": "いやいやいや、褒められるようなことじゃないよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130110
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412130110,
					"content": "褒めてない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412130111,
					"content": "旅人さん、き、聞いてもいいかな？前にお願いしたアルベド先生の隠し事についてだけど、調査は順調？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130112
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412130112,
					"content": "オイラの感覚が間違っていなければ、それはもう1週間以上も前のことだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412130113,
					"content": "もう忘れてたかと思った。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130114
					]
				},
				{
					"id": 412130114,
					"content": "そんな…！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130115
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412130115,
					"content": "い、1週間以上！？だって、私…あっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130116
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412130116,
					"content": "うぅ、実験に夢中になりすぎて完全に忘れてた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130117
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412130117,
					"content": "時間に厳しいのかルーズなのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412130118,
					"content": "つ、つまり！もう答えが分かったってことだよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130119,
						412130120
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412130119,
					"content": "うん、そうだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130121
					]
				},
				{
					"id": 412130121,
					"content": "よかった、教えてくれるかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130122
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412130122,
					"content": "パイモン、どう思う？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130123
					]
				},
				{
					"id": 412130123,
					"content": "うーん…教えても大丈夫じゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412130124,
					"content": "見せるだけで、触らせなければ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412130125,
					"content": "待って、何を言っているの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130126
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412130126,
					"content": "これは…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130127,
						412130128
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412130127,
					"content": "これがアルベドの隠し事だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130129
					]
				},
				{
					"id": 412130129,
					"content": "これはすごい剣なんだ。でも、絶対に触っちゃダメだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130130
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412130130,
					"content": "んー…これは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130131
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412130131,
					"content": "…！！こ、こんなの！今までに見たことない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130132
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412130132,
					"content": "ふふん、存分に見てくれ！なんだかオイラ、妙に気分がいいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130133
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412130133,
					"content": "すごい、こんな神秘的な武器は初めて見た。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130134
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412130134,
					"content": "剣の中に力が流れているのを微かに感じる…まるで生きているみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130135
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412130135,
					"content": "そんなことまで分かるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130136
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412130136,
					"content": "錬金術を学んでいるおかげかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130137
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412130137,
					"content": "絶対の自信はないけど、確かに何か「流れている」感覚がする。あまり正確な言葉ではないから…ふ、普段の私は使わないけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130138
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412130138,
					"content": "信じて。私、普段はこんな曖昧な言葉は使わないの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130139
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412130139,
					"content": "はいはい、分かったから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130140
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412130140,
					"content": "旅人さん…この剣で戦える？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130141
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412130141,
					"content": "もっと詳しく知りたいけど、私には使えないから。あなたにお願いしたいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130142,
						412130143
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412130142,
					"content": "アルベドには内緒だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130144
					]
				},
				{
					"id": 412130144,
					"content": "それなら人目の付かないような場所を探そう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412130143,
					"content": "見つからない場所に行こう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130144
					]
				},
				{
					"id": 412130128,
					"content": "これが知りたがってたものだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130129
					]
				},
				{
					"id": 412130120,
					"content": "全部分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130121
					]
				}
			]
		},
		{
