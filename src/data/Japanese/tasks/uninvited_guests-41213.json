			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"スクロース"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412130201,
					"content": "すごい、こんな武器初めて見た…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130202
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412130202,
					"content": "あなたもすごいよ。戦う姿も剣を振る気迫も全て完璧だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130203
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412130203,
					"content": "それほどでも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130204
					]
				},
				{
					"id": 412130204,
					"content": "この剣は特別。詳しく研究するつもりはないのに、ついつい目を奪われてしまう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130205
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412130205,
					"content": "それは剣じゃなくて、おまえの性分だと思うぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412130206,
					"content": "危険で魅力的で神秘的な片手剣。うん、間違いない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130207
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412130207,
					"content": "こんな重要な物をあなたに託すなんて、アルベド先生からすごく信頼されているみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130208,
						412130209
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412130208,
					"content": "そんなに信頼されていたとは。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130210
					]
				},
				{
					"id": 412130210,
					"content": "ふふん、これもオイラたちの実力のおかげなんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412130211,
					"content": "私もそう思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130212
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412130212,
					"content": "でも、あなたたちに渡す前の剣は、まだ力を大して吸収していなかったんだよね…どうしてアルベド先生は、これが特別だって気付けたんだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130213
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412130213,
					"content": "閃きに理由は必要ないんだぞ。オイラがニンジンとお肉のハニーソテーが食べたいのと同じだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412130214,
					"content": "あ…そう言えば、今日はまだ何も食べてない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130215
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412130215,
					"content": "実験を終えてすぐここに来たし、雪に埋もれた冒険者を見かけて、助けるのにかなり労力を使ったから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130216
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412130216,
					"content": "(ぐぅー…)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130217
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412130217,
					"content": "お腹が空いたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130218
					]
				},
				{
					"id": 412130218,
					"content": "うわ、わわわ！ち、違うよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130219
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412130219,
					"content": "恥ずかしがるな、素直になれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130220
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412130220,
					"content": "え、えっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130221
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412130221,
					"content": "じゃあ、オイラが言うぞ。お腹空いた！ご飯が食べたいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130222,
						412130223
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412130222,
					"content": "お腹空いた！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130224
					]
				},
				{
					"id": 412130224,
					"content": "おな…お腹空いた、ご飯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130225
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412130225,
					"content": "うわああ、やっぱり恥ずかしい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130226
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412130226,
					"content": "そんなことないぞ。お腹が減ってるときに食べるのが一番うまいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130227
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412130227,
					"content": "え、そうなの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130228
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412130228,
					"content": "そうだぞ！元気出して、食べ物を探しに行こう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130229
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412130229,
					"content": "この雪だらけの場所で、ニンジンとお肉のハニーソテーを食べられたら最高だろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412130223,
					"content": "ご飯が食べたい！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130224
					]
				},
				{
					"id": 412130209,
					"content": "ありがたいことにね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130210
					]
				}
			]
		},
