			"dialogs": [
				{
					"id": 412130501,
					"content": "騒がしいと思ったら、やはりキミたちか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130502
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412130502,
					"content": "何を争っていたんだい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130503
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412130503,
					"content": "ア、アルベド先生…わざとじゃないんです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130504
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412130504,
					"content": "スクロース、キミは資料を整理していたのでは？なぜここにいるのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130505
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412130505,
					"content": "しかも、氷に覆われた場所でこんな危険な相手と戦うなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130506
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412130506,
					"content": "た、戦いました。ごめんなさい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130507
					]
				},
				{
					"id": 412130507,
					"content": "オイラまで申し訳なくなってきたぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130508
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412130508,
					"content": "うあ、あわ、私はただ…ごめんなさい、ごめんなさい、私はたまたまここに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130509
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412130509,
					"content": "ふむ、何かキミの興味を引く物でもあったのかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130510
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412130510,
					"content": "剣のことを彼女に教えたんだ、ごめん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130511
					]
				},
				{
					"id": 412130511,
					"content": "全部教えたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130512
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412130512,
					"content": "剣の力と由来についてしか教えてないし、触らせてないぞ！そこはちゃんと気を付けたからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130513
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412130513,
					"content": "いいさ、どうせ隠し通せなかっただろうしね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130514
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412130514,
					"content": "スクロースの知識と秘密に対する探究心は、非常に錬金術の研究に向いているよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130515
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412130515,
					"content": "はうぅ…もう迷惑かけません！私が新しく開発した「種が4倍大きいスイートフラワー」にかけて誓います！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130516
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412130516,
					"content": "迷惑だなんてことはない。ただ心配だっただけだ。次からは気を付けるんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130517
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412130517,
					"content": "それで、そこにうずくまっている冒険者はどうしたのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130518
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412130518,
					"content": "先ほどの戦闘中、私がパラドさんを守っていたので、たぶん怪我はしてないと思うんですけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130519
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412130519,
					"content": "さ、寒い…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130520
					],
					"speakerTitle": "うっかりパラド"
				},
				{
					"id": 412130520,
					"content": "さっきの戦闘中、じっとしてたから体が冷え切ったみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130521
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412130521,
					"content": "ああ、そんなことになってるなんて思いもしなかった…私のせいで、すみません！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130522
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412130522,
					"content": "アルベド先生、少しパラドさんの様子を見てきます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130523
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412130523,
					"content": "ああ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130524
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412130524,
					"content": "スクロースは頭が固いけど、心の優しい子供だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130525
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412130525,
					"content": "自分より大きい人を子供と呼ぶのは変。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130526
					]
				},
				{
					"id": 412130526,
					"content": "確かに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130527
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412130527,
					"content": "スクロースは目を離すとすぐ変な所に行ってしまうんだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130528
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412130528,
					"content": "若者は皆同じだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130529
					]
				},
				{
					"id": 412130529,
					"content": "そうだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130530
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412130530,
					"content": "彼女もわざとじゃないから怒らないで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130531
					]
				},
				{
					"id": 412130531,
					"content": "心配するな、怒っていないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130532
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412130532,
					"content": "ん？なんか、剣が光ってないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130533
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412130533,
					"content": "おや？また変化が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130534
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412130534,
					"content": "剣の力がさらに強くなっているようだね。何があったんだい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130535
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412130535,
					"content": "さっきファデュイと戦った。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130536
					]
				},
				{
					"id": 412130536,
					"content": "この辺りのファデュイは、只者じゃないようなやつが何人もいるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130537
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412130537,
					"content": "前にはなかった新しい力か…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130538
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412130538,
					"content": "だから、剣が大幅に成長したんだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アルベド"
				}
			]
		},
		{
			"id": 4121306,
			"completionStepIds": [
				4121314
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4121314",
							"2"
						],
						"stepId": 4121314,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アルベド"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412130601,
					"content": "龍の力…龍の生命力は、枯れた植物をここまで復活させられるのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130602
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412130602,
					"content": "実に不思議だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130603
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412130603,
					"content": "ただの枯れ木かと思ったのに、怪物だったのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412130604,
					"content": "丸呑みにされるところだったな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130605
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412130605,
					"content": "でも、なんでよりによって今日、突然こんなことが起きたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130606
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412130606,
					"content": "剣が地面に落ちた衝撃で、力が外に流れ出たのかもしれないね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130607
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412130607,
					"content": "すまない。ここにいさせてくれ！頼む！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130608
					],
					"speakerTitle": "うっかりパラド"
				},
				{
					"id": 412130608,
					"content": "もう絶対に変なことはしないから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130609
					],
					"speakerTitle": "うっかりパラド"
				},
				{
					"id": 412130609,
					"content": "あ、パラドさん…そんな地面に生えてるキノコみたいに膝を抱えなくても…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130610
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412130610,
					"content": "はあ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130611
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412130611,
					"content": "急凍樹がこんな場所で枯れていたのは、もしや穢れた力を吸収できなかったからだろうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130612
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412130612,
					"content": "旅人の能力によって浄化された純粋な元素力は、怪物を復活させただけでなく、強化までしたようだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130613
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412130613,
					"content": "そして、純粋な生命力は再生力も上げるようだ…恐らく、今後も襲ってくるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130614,
						412130615
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412130614,
					"content": "想像より面倒なことになってるようだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130616
					]
				},
				{
					"id": 412130616,
					"content": "ボクもこんなことは初めてだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130617
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412130617,
					"content": "このような珍しい状況に遭遇できたのも、ある意味では収穫かもしれないね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130618
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412130618,
					"content": "スクロース。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130619
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412130619,
					"content": "あ、はい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130620
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412130620,
					"content": "あの冒険者をキャンプ場まで送ってくれるかい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130621
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412130621,
					"content": "分かりました、先生！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130622
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412130622,
					"content": "ここの問題に関しては、すまないが…再びキミにお願いしなければいけないようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130623
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412130623,
					"content": "尽力するよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130624
					]
				},
				{
					"id": 412130624,
					"content": "予想外の面倒事も頼まれるなんて、オイラたちますます強くなってるみたいだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412130615,
					"content": "自分にこんなすごい力があったとは！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130616
					]
				}
			]
		}
	]
}