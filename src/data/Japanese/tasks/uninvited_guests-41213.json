			"dialogs": [
				{
					"id": 412130301,
					"content": "うう…う…ああ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130302
					],
					"speakerTitle": "うっかりパラド"
				},
				{
					"id": 412130302,
					"content": "パラドさん！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130303
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412130303,
					"content": "か、帰ってなかったの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130304
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412130304,
					"content": "モンドのうっかり冒険者じゃないか？サイリュスと一緒に雪山に探検しに来たのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412130305,
					"content": "さささささ寒い——ハックション！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130306
					],
					"speakerTitle": "うっかりパラド"
				},
				{
					"id": 412130306,
					"content": "雪から掘り出してあげた後、ずっとここにいたの！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130307
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412130307,
					"content": "み、道に迷ったな…すまない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130308
					],
					"speakerTitle": "うっかりパラド"
				},
				{
					"id": 412130308,
					"content": "う、ううう…凍え死ぬ、もう動けない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130309
					],
					"speakerTitle": "うっかりパラド"
				},
				{
					"id": 412130309,
					"content": "はあ、パラドさん、雪山の旅を甘く見すぎ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130310
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412130310,
					"content": "連れて帰ろう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130311
					]
				},
				{
					"id": 412130311,
					"content": "でも、この様子じゃ支えてあげないと歩けないよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130312
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412130312,
					"content": "だとしても、放っておけないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412130313,
					"content": "確かに…すみません旅人さん。か、代わりに謝るね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130314
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412130314,
					"content": "他の人の心配をしてる場合か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130315
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 412130315,
					"content": "あ！またファデュイだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130316
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412130316,
					"content": "我々がここに来た理由はわかっているな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130317
					],
					"speakerTitle": "ヴァディム"
				},
				{
					"id": 412130317,
					"content": "剣を渡さない限り、誰も帰さない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130318
					],
					"speakerTitle": "ヴァディム"
				},
				{
					"id": 412130318,
					"content": "だめ、剣を渡さないで！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130319,
						412130320
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412130319,
					"content": "もちろん渡さない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130321
					]
				},
				{
					"id": 412130321,
					"content": "その意気だ！さっさとやっつけよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130322
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412130322,
					"content": "パラドさん、安全な場所に行こう！さあ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130323
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412130323,
					"content": "ふん、誰も逃がさん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130324
					],
					"speakerTitle": "ヴァディム"
				},
				{
					"id": 412130324,
					"content": "その剣は偉大な執行官「淑女」様に献上するのだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴァディム"
				},
				{
					"id": 412130320,
					"content": "誰にも奪わせない！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130321
					]
				}
			]
		},
