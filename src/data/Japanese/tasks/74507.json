				]
			},
			"dialogs": [
				{
					"id": 745070101,
					"content": "あれっ？見間違いじゃないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745070102,
					"content": "いま目の前をフワフワしてたのって…キノコンか？まさかキノコンがフォンテーヌに入ってきたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745070103,
					"content": "#{NICKNAME}、見に行ってみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7450702,
			"completionStepIds": [
				7450702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7450702",
							"2"
						],
						"stepId": 7450702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"トゥレーヌ",
					"ハニヤー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745070201,
					"content": "資質審査はこれで完了、ご協力感謝いたします。あなたの仲間たちは安全で、フォンテーヌ市民や生態環境にとって脅威はないことが証明されました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070202
					],
					"speakerTitle": "トゥレーヌ"
				},
				{
					"id": 745070202,
					"content": "『フォンテーヌ外来種管理法』と『リヨンエリア商業行動規範』に基づいて、活動を続けることを許可します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070203
					],
					"speakerTitle": "トゥレーヌ"
				},
				{
					"id": 745070203,
					"content": "トゥレーヌさん、お手数をおかけしたわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070204
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 745070204,
					"content": "フォンテーヌでイベントを開催するための手続きがこんなにも複雑だとは思わなかった。オルモス港と比べて十項目以上も多いなんて、事前準備が足りなかったわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070205
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 745070205,
					"content": "そんなふうに考えなくてもいいんですよ。あなたやキノコンの仲間たちは特別なゲストですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070206
					],
					"speakerTitle": "トゥレーヌ"
				},
				{
					"id": 745070206,
					"content": "執律庭はキノコンのような外来種に接する機会がほとんどないから、どうしても慎重になるんです。観察と評価に長い時間をかけるのは必然ですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070207
					],
					"speakerTitle": "トゥレーヌ"
				},
				{
					"id": 745070207,
					"content": "それから、あなたの依頼を他の警察隊員にも伝えておきます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070208
					],
					"speakerTitle": "トゥレーヌ"
				},
				{
					"id": 745070208,
					"content": "#もし伝説の「ゴールド流星」と「シルバー伴星」を見つけたら、隊員たちが{M#彼ら}{F#彼女たち}に直接あなたのところに来るようにと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070209
					],
					"speakerTitle": "トゥレーヌ"
				},
				{
					"id": 745070209,
					"content": "「ちびチエキノコン大合戦」の成功と、フォンテーヌ廷での楽しいひと時を過ごせるよう祈っています。必要な時はすぐにお手伝いしますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070210
					],
					"speakerTitle": "トゥレーヌ"
				},
				{
					"id": 745070210,
					"content": "#あ、その必要はないみたいね。{M#彼ら}{F#彼女たち}のほうからやってきたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070211
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 745070211,
					"content": "ちょっと待ってください！あなたの言う「ゴールド流星」と「シルバー伴星」って…この二人…「超最強のリーダー級戦力」のことですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070212
					],
					"speakerTitle": "トゥレーヌ"
				},
				{
					"id": 745070212,
					"content": "わあっ！なんで急に話題をオイラたちに振るんだよ？それになんだそのヘンな呼び名は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745070213,
					"content": "あなたたち、相変わらずね——いつも元気ハツラツって感じ。ひと目見ただけで安心したわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070214,
						745070220
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 745070214,
					"content": "だれ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745070215
					]
				},
				{
					"id": 745070215,
					"content": "お、おまえ誰だ…？オイラたち会ったことあったっけ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745070216,
					"content": "ああ…あなたたちが覚えてないのは無理もないわ、私のミスよ。しっかり連絡を取りつつ、手紙を書くべきだったわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070217
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 745070217,
					"content": "ずっと前にスメールで「サウマラタ蓮杯テイマー大会」が開かれたの。当時の私は偏った考えで大会に参加して、危ないことをしようとしていたわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070218
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 745070218,
					"content": "あなたたちのおかげで私は心を入れ替え、心優しいキノコンの仲間たちを憎むのをやめた…彼らと共に生きるという、正しい道を見つけることができたのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070219
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 745070219,
					"content": "あの大会の最後、あなたが「サウマラタ蓮杯テイマー大会」の最終決定権を握る者となり、そして私は全力で大会を成功に導き続けることを約束したの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070224
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 745070224,
					"content": "もしかしておまえ…ハニヤーか？オイラたちのためにポコポコビーニーや他のキノコンたちの面倒を見てくれた、ハニヤーだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070225
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745070225,
					"content": "そう！その通りよ。久しぶりね、「ゴールド流星」と「シルバー伴星」のお二人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070226,
						745070227
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 745070226,
					"content": "新しい服、きれいだね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745070228
					]
				},
				{
					"id": 745070228,
					"content": "前と違うから全然わからなかったぜ！なんて言うか…結構変わったな！知らない人かと思ったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070229
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745070229,
					"content": "なんでそんな格好してるんだ？もしかして…キノコンたちを連れてフォンテーヌを旅するっていう…特別感を味わうためか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070230
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745070230,
					"content": "オホン…フォンテーヌ廷は旅行客に対してドレスコードは設けていないので、別に質素な狩人の服装をしていても冷遇することはないんですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070231
					],
					"speakerTitle": "トゥレーヌ"
				},
				{
					"id": 745070231,
					"content": "ハニヤーさんの装いは特別感があるだけじゃなく、ものすごくエレガントです！エレガントの極み！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070232
					],
					"speakerTitle": "トゥレーヌ"
				},
				{
					"id": 745070232,
					"content": "ふふっ、ありがとう！あなたたちにそう言われるとますます意欲が湧いてくるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070233
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 745070233,
					"content": "話を戻すけど、私が今回フォンテーヌに来たのは、キノコン公式大会の信頼できる出資者を探すためでね。そのためにまず、キノコンの可愛さを宣伝するウォーミングアップイベントで観客を集めようと考えてるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070234
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 745070234,
					"content": "左右加が言うには、私たちがやっているのはグローバルなビジネスだし、フォンテーヌ人はファッションの細部にまですごくこだわるから、その風習に倣うべきだってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070235
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 745070235,
					"content": "で、彼女がウォーミングアップイベントの計画を準備してくれたの。その上、この衣装を用意して、立ち振る舞いの特訓まで付き合ってくれてね。私を変えてくれたってわけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070236
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 745070236,
					"content": "左右加さん？その人って…オイラたちに負けたあと、ずっとおまえと一緒にあちこち取材をしながらキノコンたちの面倒を見てくれた娯楽小説の作家か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070237
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745070237,
					"content": "へぇ、あの左右加さんが異国のマナーを知ってるなんて！物知りなんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070238
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745070238,
					"content": "それだけじゃないわよ。前に遊んだテーブルゲーム「チエキノコン布陣」のことをまだ覚えてる？最新の「ちびチエキノコン大合戦」もぜひ遊んでみてちょうだい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070239
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 745070239,
					"content": "前回の「チエキノコン布陣」の遊び方は、「ちびチエキノコンたちを指揮してフィールド内の布陣機関を破壊する」というものだったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070240
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 745070240,
					"content": "リリース当初の反応は悪くなかったんだけど、長く遊ぶには魅力が足りなかったのか、すぐに人気が落ちちゃってね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070241
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 745070241,
					"content": "でもね、左右加が色々な文献や小説の描写を結集させて、布陣機関の代わりに強力な相手を模した駒を取り入れたの。ゲームに様々な変化をもたらしてくれたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070242
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 745070242,
					"content": "いま彼女は、『スチームバード新聞』とゲームの宣伝広告の掲載について話し合っているところよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070243
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 745070243,
					"content": "ああ、なるほど…つまりウォーミングアップイベントの「ちびチエキノコン大合戦」っていうのは、このテーブルに置いてあるゲームのことなんだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070244
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745070244,
					"content": "それに強力な相手？えーと、つまり…キノコンの仲間たちの駒を指揮してほかの生き物と戦うんだよな。どっちも動くのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070245
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745070245,
					"content": "なんだかすごく複雑になった気がするぜ…でもこれまでの経験からすると、細かいところをいくつか改善して、ゲームを調整する必要があるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070246,
						745070247
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745070246,
					"content": "ふふん、それなら得意分野！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745070248
					]
				},
				{
					"id": 745070248,
					"content": "コホン。お二人が心配する必要はありませんよ。解決すべき難題はすでに処理しましたからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070249
					],
					"speakerTitle": "トゥレーヌ"
				},
				{
					"id": 745070249,
					"content": "ハニヤーさんと彼女の「ちびチエキノコン大合戦」はフォンテーヌ科学院の…何でしたっけ？そう、フォンタプロジェクトチームの協賛を得て、すべての準備が整っています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070250
					],
					"speakerTitle": "トゥレーヌ"
				},
				{
					"id": 745070250,
					"content": "たとえやり残した細かい仕事があったとしても…特巡隊で最も真面目なこのトゥレーヌが、お二人のようなゲストの手を煩わせるようなことはいたしません！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070251
					],
					"speakerTitle": "トゥレーヌ"
				},
				{
					"id": 745070251,
					"content": "何と言ってもあなたたちは「超最強のリーダー級戦力」であり、ハニヤーさんは国外から来た重要ビジネスのお客様。雑用とかは私のような一般警察隊員に任せておけばいいんです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070252
					],
					"speakerTitle": "トゥレーヌ"
				},
				{
					"id": 745070252,
					"content": "こ、こいつって警察隊員だったのか？ハニヤーが雇った助手かと思ったぜ…頼りになるな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070253,
						745070254
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745070253,
					"content": "これは失礼！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745070255
					]
				},
				{
					"id": 745070255,
					"content": "ああっ！「超最強のリーダー級戦力」が私を認めてくれた…最強戦士から認められたんですね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070256
					],
					"speakerTitle": "トゥレーヌ"
				},
				{
					"id": 745070256,
					"content": "コホン！今はそんなことを言ってる場合じゃありませんね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070257
					],
					"speakerTitle": "トゥレーヌ"
				},
				{
					"id": 745070257,
					"content": "特巡隊の新人として、私には外来生物を監視し、特別な客人のために最高クラスの手助けをして、一般警察隊員の手に負えない問題を解決する義務があります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070258
					],
					"speakerTitle": "トゥレーヌ"
				},
				{
					"id": 745070258,
					"content": "このイベントがフォンテーヌ廷に良好な経済的利益をもたらすことになれば…私も戦闘以外での実績を作れて、隊長に評価されるかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070259
					],
					"speakerTitle": "トゥレーヌ"
				},
				{
					"id": 745070259,
					"content": "そんなに身構えるなよ、単なるゲームだろ？肩の力を抜けって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070260
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745070260,
					"content": "オイラのイメージだとな、優しいキノコンの仲間たちに触れ合うと、悩み事を忘れて楽しい気分にさせてくれるもんだと思うぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070261
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745070261,
					"content": "そうだ！一つ提案があるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070262
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 745070262,
					"content": "これまでに私と左右加で何百回も「ちびチエキノコン大合戦」をプレイしたとはいえ、データも感想も私たち二人分しかなかったの。お客さんたちの考えってそれぞれ異なるでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070263
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 745070263,
					"content": "ちょうど今、素敵な個性と経験を持つ「ゴールド流星」と「シルバー伴星」がいて、トゥレーヌさんも真面目だから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070264
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 745070264,
					"content": "あなたたち二人が何度か対戦をしてくれたら、この遊び方の限界を見つけられて、改善するのに役立つと思うんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070265,
						745070266
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 745070265,
					"content": "やった！新しいゲーム！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745070267
					]
				},
				{
					"id": 745070267,
					"content": "「超最強のリーダー級戦力」のお二人が興味のあるゲームで、私の経歴にも輝かしい記録を残せるのなら…喜んでお供いたします！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070268
					],
					"speakerTitle": "トゥレーヌ"
				},
				{
					"id": 745070268,
					"content": "あっ、でも私は色々な面であなたの足元にも及ばないので…手加減してくださいね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "トゥレーヌ"
				},
				{
					"id": 745070266,
					"content": "ちょうど遊んでみたかった！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745070267
					]
				},
				{
					"id": 745070254,
					"content": "手間をかけるね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745070255
					]
				},
				{
					"id": 745070247,
					"content": "何か手伝えることはある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745070248
					]
				},
				{
					"id": 745070227,
					"content": "物腰が柔らかくなったね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745070228
					]
				},
				{
					"id": 745070220,
					"content": "どこかで会ったことない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745070221
					]
				},
				{
					"id": 745070221,
					"content": "この声、なんか聞き覚えあるんだよな。でもこんな綺麗な格好のお姉さんに会ったことあったっけ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070222
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745070222,
					"content": "うーん、その日焼けした肌…フォンテーヌ人じゃないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070223
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745070223,
					"content": "待てよ！思い出したかも…まさかとは思うけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070224
					],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7450703,
			"completionStepIds": [
				7450704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7450704",
							"2"
						],
						"stepId": 7450704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"トゥレーヌ",
					"ハニヤー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745070301,
					"content": "つ、強い…強すぎる…テーブルゲームとはいえ、一分の隙もありませんでした！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070302
					],
					"speakerTitle": "トゥレーヌ"
				},
				{
					"id": 745070302,
					"content": "も、もう一回やりましょう！ご指導よろしくお願いします！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070303,
						745070304
					],
					"speakerTitle": "トゥレーヌ"
				},
				{
					"id": 745070303,
					"content": "そんなに強かったかな？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745070305
					]
				},
				{
					"id": 745070305,
					"content": "なんだか大げさだなぁ。オイラたちがやってるのは単なるゲームだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745070306,
					"content": "謙遜しないでください！このテーブルゲームは、プレイヤーの「小隊指揮」に対する考えが反映されています——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070307
					],
					"speakerTitle": "トゥレーヌ"
				},
				{
					"id": 745070307,
					"content": "各「ちびチエキノコン」の布陣や、ターゲット、スキル発動のリズム、相互サポートのタイミング…どれも奥が深い！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070308
					],
					"speakerTitle": "トゥレーヌ"
				},
				{
					"id": 745070308,
					"content": "執律庭の小隊指揮訓練を受けたことがないのに、こんなに「共同作戦」の攻撃を仕掛けられるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070309
					],
					"speakerTitle": "トゥレーヌ"
				},
				{
					"id": 745070309,
					"content": "もはやあなたは「超最強のリーダー級戦力」ではなく、名実ともに「超最強のリーダー」ですね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070310
					],
					"speakerTitle": "トゥレーヌ"
				},
				{
					"id": 745070310,
					"content": "あの…執律庭に就職するつもりはありませんか？あなたならきっとすぐに小隊長の座に登り詰め、中核を担う要職につけますよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070311,
						745070317
					],
					"speakerTitle": "トゥレーヌ"
				},
				{
					"id": 745070311,
					"content": "いいよ！給料はいくら？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745070312
					]
				},
				{
					"id": 745070312,
					"content": "それは…明確にはお伝えできませんが、確か数年前の一般警察隊員の月給が三十万モラだったかと…今はもう少し上がっているかも？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070313
					],
					"speakerTitle": "トゥレーヌ"
				},
				{
					"id": 745070313,
					"content": "毎月三十万モラっていうとどのくらいだ？なんだか馴染みのある数字だけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070314,
						745070315
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745070314,
					"content": "パイモンの食事代にもならないね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745070316
					]
				},
				{
					"id": 745070316,
					"content": "そ…それは無理ですよ！執律廷は単なる執行機関ですし、資金のほとんどはフォンテーヌ市民の税金で成り立っているんです。給与だってそこまで高くないし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070323
					],
					"speakerTitle": "トゥレーヌ"
				},
				{
					"id": 745070323,
					"content": "「ゴールド流星」と「シルバー伴星」に対するあなたの敬意は十分わかったわ、トゥレーヌさん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070324
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 745070324,
					"content": "#でも残念だけど…私の知る限り、{M#彼ら}{F#彼女たち}はテイワットの各地を回りながら各国の難題を解決する手助けをしたり、魔物を討伐したりしている…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070325
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 745070325,
					"content": "#{M#彼ら}{F#彼女たち}に助けてもらった身として、より多くの人が{M#彼ら}{F#彼女たち}に助けられることを私も願っているの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070326
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 745070326,
					"content": "そうなんですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070327
					],
					"speakerTitle": "トゥレーヌ"
				},
				{
					"id": 745070327,
					"content": "正義と平和の種をテイワット全土に撒き続けることは、確かにフォンテーヌの治安だけを守ることよりもずっと偉大ですね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070328
					],
					"speakerTitle": "トゥレーヌ"
				},
				{
					"id": 745070328,
					"content": "だったら私が今できることは…このゲームをもっとあなたたちとプレイして、お二人の考えをできる限り理解することです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070329
					],
					"speakerTitle": "トゥレーヌ"
				},
				{
					"id": 745070329,
					"content": "そういえば、もう一つ大事なことを忘れちゃいけないよな。なぁ、ハニヤー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070330
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745070330,
					"content": "うん、ポコポコビーニーのことを聞きたいんでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070331
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 745070331,
					"content": "ポコポコビーニーと喜炎も近くにいるわ。それに、トゥレーヌさんがキノコンの仲間たちの面倒を見てくれる友達をわざわざ手配してくれたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070332
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 745070332,
					"content": "しきたりに倣って、私も今回は特別な「マーベラスゼリー」を用意したわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070333
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 745070333,
					"content": "キノコンの仲間たちと遊びながら、彼らと一緒にお菓子を食べてもいいわよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070334
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 745070334,
					"content": "おおっ！ハニヤーはそんなことまでしっかり準備してたんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070335
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745070335,
					"content": "#{NICKNAME}、もう一回ずつトゥレーヌと「ちびチエキノコン大合戦」をプレイしてから、ポコポコビーニーを見にいこうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745070315,
					"content": "数千万の価値には値しないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745070316
					]
				},
				{
					"id": 745070317,
					"content": "ええっ、仕事したくない！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745070318
					]
				},
				{
					"id": 745070318,
					"content": "#もし同じ場所に留まって毎日出勤することになったら、{NICKNAME}は自分のやるべき事ができなくなっちゃうしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070319
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745070319,
					"content": "オイラだって毎朝起こされて仕事に行くなんてやだし…やっぱり自由なのがいいぜ！好きなところにも行けるし！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070320,
						745070321
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745070320,
					"content": "それに食事も色々選べる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745070322
					]
				},
				{
					"id": 745070322,
					"content": "そうそう！食事のバリエーションは重要だぞ！ずっと同じ場所にいたらそのうち食べ飽きちゃうからな、ときどき変えないと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070323
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745070321,
					"content": "それに食べ物のバリエーションも多様。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745070322
					]
				},
				{
					"id": 745070304,
					"content": "お世辞を言っても何も出ないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745070305
					]
				}
			]
		},
