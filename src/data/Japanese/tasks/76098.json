						760980403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760980403,
					"content": "権限更新完了：上級技師コテルニコフ、避難所メイン制御端末へようこそ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980404
					],
					"speakerTitle": "避難所メイン制御端末"
				},
				{
					"id": 760980404,
					"content": "えっ？この機械、オイラたちをあの浄化システムの修理に派遣されてた修理工として認識してるみたいだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760980405,
					"content": "でも、そのおかげで行ける場所が増えたな！えーと…ここは<color=#00E1FFF>第二研究区</color>か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760980406,
					"content": "（第二研究区の状態を確認する。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760980407
					]
				},
				{
					"id": 760980407,
					"content": "状態レポートを生成中です。しばらくお待ちください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980408
					],
					"speakerTitle": "避難所メイン制御端末"
				},
				{
					"id": 760980408,
					"content": "<color=#00E1FFF>第二研究区</color>：<color=#FF5E41FF>警告</color>。高濃度のアビス汚染と「終末（アポカリプス）の災厄」の活動痕跡を検知しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980409
					],
					"speakerTitle": "避難所メイン制御端末"
				},
				{
					"id": 760980409,
					"content": "<color=#FF5E41FF>終末（アポカリプス）</color>世界浄化システム：<color=#FF5E41FF>故障</color>。上級技師コテルニコフは警備員同行のもと修理に向かってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980410
					],
					"speakerTitle": "避難所メイン制御端末"
				},
				{
					"id": 760980410,
					"content": "警備員なんていないぞ！あれ？ちょっと待てよ、今すごく変な名前が出てきたよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980411,
						760980412
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760980411,
					"content": "アビスの魔物みたいな名前…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760980414
					]
				},
				{
					"id": 760980414,
					"content": "でも、あの「終{RUBY#[D]アポカリプス}末」ってのがアビスの魔物のことだとしたら、この場所の汚染源はそいつってことになるぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980415
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760980415,
					"content": "#そいつをやっつければ、ここのアビスの汚染も完全に排除できるんじゃないか？{NICKNAME}、<color=#00E1FFF>第二研究区</color>に行ってみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760980412,
					"content": "#ちゃんと{M#俺}{F#私}を守ってね、パイモン警備員。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760980413
					]
				},
				{
					"id": 760980413,
					"content": "#へへっ、{NICKNAME}の安全はオイラに任せろ！——って言いたいとこだけど、パイモン警備員も武器を持ってないからな。おまえも気をつけるんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980414
					],
					"speakerTitle": "パイモン"
				}
			]
