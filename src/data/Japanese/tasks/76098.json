			"dialogs": [
				{
					"id": 760982801,
					"content": "グラジーナ…？恥知らずの裏切り者め、よくも我の前に姿を現したな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760982802
					],
					"speakerTitle": "「終末の災厄」"
				},
				{
					"id": 760982802,
					"content": "#うわっ、{NICKNAME}、気をつけろよ！あの魔物、引き寄せられてきたみたいだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760982803
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760982803,
					"content": "いや、違う、グラジーナではない…お前からはやつの匂いがしない。何者だ？生者か、あるいは魔天をさまよう亡霊か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760982804
					],
					"speakerTitle": "「終末の災厄」"
				},
				{
					"id": 760982804,
					"content": "命ある者がこの墓に入れるはずがない…やつらの墓、我らの墓に。答えろ、答えろ！ロートヴァング教授に遣わされたのか？我が主は我を許してくださったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760982805,
						760982817,
						760982820
					],
					"speakerTitle": "「終末の災厄」"
				},
				{
					"id": 760982805,
					"content": "#{M#君}{F#あなた}が「終末」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760982806
					]
				},
				{
					"id": 760982806,
					"content": "<color=#FF5E41FF>終末（アポカリプス）</color>？<color=#FF5E41FF>終末（アポカリプス）</color>か！ふっ…ははは…外の世界を見てみろ、<color=#FF5E41FF>終末（アポカリプス）</color>はすでに訪れている！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760982807
					],
					"speakerTitle": "「終末の災厄」"
				},
				{
					"id": 760982807,
					"content": "ソロヴィ家の坊ちゃまが止めようとした、レッド・ミラーを名乗る偽物のブライヒが止めようとした、裏切り者のグラジーナが止めようとした——だがそれは来た、確かに来たのだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760982808
					],
					"speakerTitle": "「終末の災厄」"
				},
				{
					"id": 760982808,
					"content": "我の主人…ロートヴァング教授…彼は「サンポ・ミル」を用いてあの愚かな世界を薪のように焼き尽くした。そして、この避難所だけが滅却後の魔天に漂っているのだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760982809,
						760982810
					],
					"speakerTitle": "「終末の災厄」"
				},
				{
					"id": 760982809,
					"content": "だから、世界はもう滅びたと思ってるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760982811
					]
				},
				{
					"id": 760982811,
					"content": "「世界」はもはや往日の棺と化した…お前たちがどこから来たのか知らぬが、天蓋の繭から解き放たれた我は、引力にも運命にも縛られはしない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760982812
					],
					"speakerTitle": "「終末の災厄」"
				},
				{
					"id": 760982812,
					"content": "お前はどうだ？お前は主の従者ではないが、あの愚か者どもとも違う…我らに加わり血肉となるか？それとも、今ここで死を迎えるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760982813
					],
					"speakerTitle": "「終末の災厄」"
				},
				{
					"id": 760982813,
					"content": "<color=#00E1FFFF>加わる</color>か…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760982814
					],
					"speakerTitle": "「終末の災厄」",
					"speakerSubtitle": "穏やかな女性の声"
				},
				{
					"id": 760982814,
					"content": "それとも<color=#FF5E41FF>死ぬ</color>か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760982815
					],
					"speakerTitle": "「終末の災厄」",
					"speakerSubtitle": "男性の情熱的な声"
				},
				{
					"id": 760982815,
					"content": "世界は滅びてない。ここは海の底だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760982816
					]
				},
				{
					"id": 760982816,
					"content": "黙れ！それ以上卑劣な嘘を吐くな、冒涜者め！主が我を欺くはずがない。我らは魔天に身を置いている！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760982825
					],
					"speakerTitle": "「終末の災厄」"
				},
				{
					"id": 760982825,
					"content": "滅びし世界に葬られろ。魔天に在り続けるは我らのみ——我が主よ、どうか見届け給え！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760982826
					],
					"speakerTitle": "「終末の災厄」"
				},
				{
					"id": 760982826,
					"content": "#うぅ、しょうがない。{NICKNAME}、とにかくこの植物でなんとかするぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760982810,
					"content": "外の世界はまだちゃんとある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760982811
					]
				},
				{
					"id": 760982817,
					"content": "#意味がわからない。{F#私の}{M#俺の}剣をくらえ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760982818
					]
				},
				{
					"id": 760982818,
					"content": "そうだそうだ、なにを言ってるのか全然…って、剣なんてどこにあるんだよ！入口で没収されただろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760982819
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760982819,
					"content": "案ずるな…案ずるな！愚か者よ——裏切り者のグラジーナが我をここに閉じ込めようと、お前の血肉は「明日」の糧となるのだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760982825
					],
					"speakerTitle": "「終末の災厄」"
				},
				{
					"id": 760982820,
					"content": "#ロートヴァングは死んだ。次は{M#君の番だ。}{F#あなたの番。}",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760982821
					]
				},
				{
					"id": 760982821,
					"content": "ふっ…はは…そのような稚拙な嘘で愚か者を騙すのは、我だけだと思っていたが…まさか我と同じ手口で仕掛けてくるとはな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760982822
					],
					"speakerTitle": "「終末の災厄」"
				},
				{
					"id": 760982822,
					"content": "我は、我らは騙されぬぞ！ロートヴァング教授が死ぬはずがない。さもなければ、なぜテイワットが滅び、我らが魔天を漂うことになろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760982823
					],
					"speakerTitle": "「終末の災厄」"
				},
				{
					"id": 760982823,
					"content": "テイワットは滅びてない。ここは海の底だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760982824
					]
				},
				{
					"id": 760982824,
					"content": "黙れ！それ以上卑劣な嘘を吐くな、冒涜者め！主が我を欺くはずがない…天蓋の繭から解き放たれた我は、引力にも運命にも縛られはしない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760982825
					],
					"speakerTitle": "「終末の災厄」"
				}
			]
		}
	]
