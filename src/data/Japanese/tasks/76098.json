			"dialogs": [
				{
					"id": 760980301,
					"content": "「…ようこそ（…）号避難所へ、遠方よりお越しの皆様…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980302
					],
					"speakerTitle": "古びた端末"
				},
				{
					"id": 760980302,
					"content": "「…もしあなたがこの録音をお聞きになっているのなら、それは<color=#FF5E41FF>終末（アポカリプス）</color>が迫っていることを意味します…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980303
					],
					"speakerTitle": "古びた端末"
				},
				{
					"id": 760980303,
					"content": "わぁっ！びっくりしたぞ…これ、音が出るのか…って、それより、よくわからなかったけどすっごく怖いこと言ってなかったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980304,
						760980305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760980304,
					"content": "#世界の滅亡のことを言ってたみたい{F#だね}{M#だな}…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760980308
					]
				},
				{
					"id": 760980308,
					"content": "「…幸いなことに、あなたはここにたどり着き、私たちもまた…あなたと共に…<color=#FF5E41FF>終末（アポカリプス）</color>後の…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980309
					],
					"speakerTitle": "古びた端末"
				},
				{
					"id": 760980309,
					"content": "「…キーカードを…<color=#00E1FFF>リフト</color>に接続…安全…搭乗…避難所へ…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980310
					],
					"speakerTitle": "古びた端末"
				},
				{
					"id": 760980310,
					"content": "なんだ、壊れちゃったのか？ノイズで声が聞こえなくなったぞ…なにを言ってたんだろうな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760980311,
					"content": "#ここはなんのための場所なんだろう…{NICKNAME}、とりあえず中に入ってみるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760980305,
					"content": "#大丈夫、ただ世界の滅亡が近づいてるだけ{F#だよ}{M#だ}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760980306
					]
				},
				{
					"id": 760980306,
					"content": "なんだ、世界の滅亡か。なら安心だぜ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760980307,
					"content": "って、そんなわけないだろ！「明日の朝ごはんは鳥肉と野生キノコの串焼きだよ」みたいな平然とした口調で言うなよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980308
					],
					"speakerTitle": "パイモン"
				}
			]
		},
