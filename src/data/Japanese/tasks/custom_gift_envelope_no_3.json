			},
			"dialogs": [
				{
					"id": 715350201,
					"content": "旅人、奇遇だな。あんたも海灯祭に遊びにきたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350202
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 715350202,
					"content": "祝灯状を作ってたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715350203
					]
				},
				{
					"id": 715350203,
					"content": "ああ、キャンディスに贈りたくて。でも、まだ納得の行くものが出来てないんだ。ちょうど、新しく作り直そうとしていたところだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350204
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 715350204,
					"content": "キャンディスは来てないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715350205
					]
				},
				{
					"id": 715350205,
					"content": "キャンディスも来るさ。ただ…もうしばらくは無理だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350206
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 715350206,
					"content": "あたしが一緒に璃月に行こうと誘ったんだが、最初は断られたんだ。村を守らなきゃって言われて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350207
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 715350207,
					"content": "一年間頑張ったんだから気分転換しよう、あたしもちょうど璃月に向かうキャラバンを護衛するから、一緒に璃月の海灯祭に参加しよう——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350208
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 715350208,
					"content": "村のことが気がかりなら、旅団の仲間たちに村を守ってもらうから、とまで言ったんだけどさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350209
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 715350209,
					"content": "それでもダメって言うんだ。最終的に、村のやつらにも長いこと説得されて、やっと休みを取ってくれたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350210
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 715350210,
					"content": "ただ、まだやるべきことがあるから、全部済ませてから、ここに来ることになってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350211
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 715350211,
					"content": "ま、仕方ないよな。キャラバンは待ってくれないし…だから先に来て、キャンディスを待ってるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350212
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 715350212,
					"content": "何かプレゼントを買おうと思ってたんだが、いいものがありすぎて、迷いに迷っちまったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350213
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 715350213,
					"content": "結局、ネックレスを選んだんだけどな。璃月の人は海灯祭で贈り物をする時に「祝灯状」っていう特別な手紙を添えるって聞いたから、あたしも自分用に一枚作ってみようと思ってさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350214
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 715350214,
					"content": "でも…さっきも言った通り、どう頑張っても納得行くのが作れないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350215
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 715350215,
					"content": "ちょうどいいところに来てくれたぜ。あんたなら色々知ってるだろ。アドバイスしてくれよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350216
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 715350216,
					"content": "いいよ、ちょっと見せて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
