			"dialogs": [
				{
					"id": 715350401,
					"content": "へえ…やっぱ、器用だな。綺麗だ、ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350402
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 715350402,
					"content": "この祝灯状はあんたからの贈り物ってことで、もらっとくよ。今は良いものを持ってないから、スメールに戻ったら…お返しさせてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350403
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 715350403,
					"content": "祝灯状はもう一通作って、キャンディスが着いたら、ネックレスに添えてプレゼントしようと思ってる。きっと喜んでくれるぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350404
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 715350404,
					"content": "それにしても、あいつ…まだ来ないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ディシア"
				}
			]
		}
