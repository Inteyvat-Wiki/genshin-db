						],
						"stepId": 7113403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"玄機"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711340301,
					"content": "ん？お客さんたちは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340302
					],
					"speakerTitle": "玄機"
				},
				{
					"id": 711340302,
					"content": "材料を持ってきたからお茶を作って。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711340303
					]
				},
				{
					"id": 711340303,
					"content": "えっ？まさか本当に<color=#00E1FFFF>トリックフラワー·炎</color>を片づけたんですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340304
					],
					"speakerTitle": "玄機"
				},
				{
					"id": 711340304,
					"content": "確かにそこそこいたな。でもオイラたちに言わせりゃそんなに大した数じゃなかったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711340305,
					"content": "そこそこいた？あっ、いや、もちろん知ってますよ。ははっ。ご両人は実力があるだけあって大胆なことをされますねえ。いやはや、恐れ入りましたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340306
					],
					"speakerTitle": "玄機"
				},
				{
					"id": 711340306,
					"content": "（二人が無事でよかった…でなきゃ責任を取らされるところだったぞ…次は別の言い訳にしないとダメだな…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340307
					],
					"speakerTitle": "玄機"
				},
				{
					"id": 711340307,
					"content": "ふふん、これでもう断れないだろ。今すぐその特別なあつあつ爆裂スイートフラワーハニーティーってやつを飲ませてくれよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711340308,
					"content": "ゴホゴホッ…分かりました…準備しましょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340309
					],
					"speakerTitle": "玄機"
				},
				{
					"id": 711340309,
					"content": "（くそ…どうやって作るんだ…そこまで難しくはないはずだよな！？たぶん、スイートフラワーとトリックフラワーの蜜を一緒にすればできるだろ！？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340310
					],
					"speakerTitle": "玄機"
				},
				{
					"id": 711340310,
					"content": "玄機は難しい顔をしつつも、二人が持ってきた材料を手にするとそのまま湯呑の中へ放り込んだ。その後、それを少し取り出したが、結局また元に戻した。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						711340311
					]
				},
				{
					"id": 711340311,
					"content": "それから蓋をして、力を込めて振り始めた。やがて奇妙な泡の浮かんだ褐色の液体が二人の目の前に差し出された。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						711340312
					]
				},
				{
					"id": 711340312,
					"content": "何かがおかしいと思ったが、パイモンは受け取ると一気に飲み干してしまった。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						711340313
					]
				},
				{
					"id": 711340313,
					"content": "ゲーッ！なんだよこれ！こんなにまずいの飲んだことないぞ…おまえの茶屋は一体どうやって経営が成り立ってんだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340314
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711340314,
					"content": "あはは…す、すみませんねぇ！お客さんの舌にひどい思いをさせてしまいました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340315
					],
					"speakerTitle": "玄機"
				},
				{
					"id": 711340315,
					"content": "これはお詫びの気持ちです、受け取ってください！舌への償いとして、そして材料を採ってきてくださった報酬としてお渡しします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340316
					],
					"speakerTitle": "玄機"
				},
				{
					"id": 711340316,
					"content": "うっ…わかったよ。おまえ、お茶を淹れるのは下手だけどいいやつだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340317
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711340317,
					"content": "ははっ、とんでもないですよ…とにかく、ご両人のおかげで材料が揃いました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340318
					],
					"speakerTitle": "玄機"
				},
				{
					"id": 711340318,
					"content": "他に用がなければ、なるべく早めにお帰りください。外じゃどんな危険なことがあるか分かりませんからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玄機"
				}
			]
		},
