			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"玄機"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2131.829,
							396.2,
							2597.355
						],
						"pointId": 311500160
					}
				]
			},
			"dialogs": [
				{
					"id": 711340101,
					"content": "おや！お客さん、疲れ果ててますね。お茶を飲んで、足を休ませることができる場所をお探しでは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340102
					],
					"speakerTitle": "玄機"
				},
				{
					"id": 711340102,
					"content": "お茶があるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711340103
					]
				},
				{
					"id": 711340103,
					"content": "ええ、もちろん。この辺じゃ茶屋はここ一軒だけですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340104
					],
					"speakerTitle": "玄機"
				},
				{
					"id": 711340104,
					"content": "どんなお茶があるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711340105,
					"content": "ええっと…ばく…あつあつ爆裂スイートフラワーハニーティーがありますよ。うん、そうですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340106
					],
					"speakerTitle": "玄機"
				},
				{
					"id": 711340106,
					"content": "天然のスイートフラワーとトリックフラワーの蜜を合わせて作った特別な飲み物です。口に入れると濃厚で、後味は爽やか。飲めば疲れが癒える——他じゃどこにも置いてませんよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340107
					],
					"speakerTitle": "玄機"
				},
				{
					"id": 711340107,
					"content": "おお！確かに聞いたことないお茶だな。美味しそうだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711340108,
					"content": "とは言ったものの残念なことに、手元の材料を使い切ってしまったんです。この近所で材料を集めようにも危険でして。スイートフラワーを摘むのもそうだし、神出鬼没の<color=#00E1FFFF>トリックフラワー·炎</color>も何とかしないといけません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340118
					],
					"speakerTitle": "玄機"
				},
				{
					"id": 711340118,
					"content": "もし店を維持するのに十分な材料さえ手に入れば、いくら報酬を払おうとも構いません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340109
					],
					"speakerTitle": "玄機"
				},
				{
					"id": 711340109,
					"content": "だから申し訳ないんですが、今回は他の店に行かれたほうがいいですね。私はこのあと冒険者協会へ行って、材料集めを頼んでから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340110
					],
					"speakerTitle": "玄機"
				},
				{
					"id": 711340110,
					"content": "#いい知らせだ。{M#俺}{F#私}たちがまさに冒険者。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711340111
					]
				},
				{
					"id": 711340111,
					"content": "ええっ…ゴホッ…それは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340112
					],
					"speakerTitle": "玄機"
				},
				{
					"id": 711340112,
					"content": "その通り。何としても爆裂スイートフラワーハニーティーを飲まないとな。材料の問題はオイラたちに解決させてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711340113,
					"content": "あ…あそこのトリックフラワーは暝垣山の石と同じくらい多いんですよ！やっぱり、こんな危険は冒さないほうが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340114
					],
					"speakerTitle": "玄機"
				},
				{
					"id": 711340114,
					"content": "…けど本当にそんなに多いなら、ここはトリックフラワー山って名前がついてたはずだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711340115,
					"content": "おっと…思い出した。実は冒険者協会と協力協定を結んでまして…軽はずみにご両人に頼んでしまっては、よくないかと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340116
					],
					"speakerTitle": "玄機"
				},
				{
					"id": 711340116,
					"content": "おまえ、変なやつだな。目の前にいる冒険者が手伝ってやるって言ってるのに、気が進まないなんてさ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711340117,
					"content": "とにかく、美味しいお茶とはいえタイミングが悪かったですね。ははっ、お客さん、どうぞお帰りください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340119
					],
					"speakerTitle": "玄機"
				},
				{
					"id": 711340119,
					"content": "うぅ…わかったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711340120,
					"content": "#（{NICKNAME}…もしオイラたちが言うことを聞かずに、直接材料を手に入れたら、お茶を飲めるんじゃないか？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711340121,
					"content": "（あいつの言ったお茶、飲んでみたいぞ！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7113403,
			"completionStepIds": [
				7113403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7113403",
