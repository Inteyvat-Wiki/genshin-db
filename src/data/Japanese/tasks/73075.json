				"points": []
			},
			"dialogs": [
				{
					"id": 730750101,
					"content": "#ナラ{NICKNAME}もパイモンも、ありがとう。ヴァナラーナの苗畑にヴィパリャス、たくさん育った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730750102
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730750102,
					"content": "ここのヴィパリャス、みんなご機嫌。だからアランカラも嬉しくてご機嫌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730750103
					],
					"speakerTitle": "アランカラ"
				},
				{
					"id": 730750103,
					"content": "ウツァヴ祭が終わった。金色のナラがヴァーナを離れちゃう前に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730750104
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730750104,
					"content": "ヴィパリャスを一株手に入れた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730750105
					]
				},
				{
					"id": 730750105,
					"content": "#ご機嫌なヴィパリャス、金色のナラにあげる。ナラ{NICKNAME}とパイモンもご機嫌になりますように。このヴィパリャスは枯れない。でも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730750106
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730750106,
					"content": "たまに話しかけてあげて。音楽を聴かせてあげると、もっといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730750107
					],
					"speakerTitle": "アランカラ"
				},
				{
					"id": 730750107,
					"content": "#大地は忘れない、アランナラも忘れない。ナラ{NICKNAME}とパイモンも忘れないで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランナクラ"
				}
			]
		},
		{
			"id": 7307502,
