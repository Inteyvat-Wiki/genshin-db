				"points": []
			},
			"dialogs": [
				{
					"id": 730750201,
					"content": "#ナラ{NICKNAME}のいるウツァヴ祭は、ナラヴァルナとアランナラが一緒に過ごしたウツァヴ祭みたい…こんなに嬉しいのは久しぶりだ。うぅっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730750202
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730750202,
					"content": "ヴィパリャスに「涙」は禁物だ。ウツァヴ祭は楽しいお祭り。アランナクラはヴィパリャスに楽しい音楽を弾いてやれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランカラ"
				}
			]
		}
