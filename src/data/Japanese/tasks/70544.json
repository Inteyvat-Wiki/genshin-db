			"trigger": {
				"objectNames": [
					"フィッシュル"
				],
				"points": [
					{
						"sceneId": 1090,
						"position": [
							18.129,
							0,
							20.305
						],
						"pointId": 14
					},
					{
						"sceneId": 1090,
						"position": [
							16.22,
							0,
							19.822
						],
						"pointId": 15
					},
					{
						"sceneId": 1090,
						"position": [
							16.512,
							0.01,
							21.178
						],
						"pointId": 9
					}
				]
			},
			"dialogs": [
				{
					"id": 705440101,
					"content": "ふふ、「ネコモコの城」なる不可思議な名を持つ類い稀な地だというのに、インテリアがこれほど凡庸とは、いささか貧相ね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440102
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 705440102,
					"content": "少なくとも…グレープカルセドニーで編まれたブランコをいくつか用意すべきだわ！それから純粋な白銀のランプの上には、深海の海塩で精製された蝋燭を置き、夜空の星模様を描いた猫食器を照らさないと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440103
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 705440103,
					"content": "あとは…彫像も必要ね！失われし王朝の古のコインを溶かし、海峡の底に眠る奇妙な真珠と露雫を加え、猫の眷属の彫像を作る——これこそ最良の選択に違いないわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440104
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 705440104,
					"content": "あなたもそう思うでしょう。そちらの猫の眷属さん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440105
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 705440105,
					"content": "えっと、あなたまだ名乗っていなかったわね。言葉をしかと選んで名乗るといいわ！わたくしに名を知ってもらえることは、この上なく光栄なことなのだから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440106
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 705440106,
					"content": "ニャ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440107
					],
					"speakerTitle": "「ボー」"
				},
				{
					"id": 705440107,
					"content": "名前は「ボー」です。高貴なる皇女様！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705440108,
					"content": "「ボー」は物分りがよろしくないようで、皇女様の御言葉を理解できません。皇女様、どうかお許しを…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705440109,
					"content": "って、いやいや！なんでフィッシュルに会うと、いっつも勝手にこういうモードに入っちゃうんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440110,
						705440111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705440110,
					"content": "#いいんじゃない？{M#俺}{F#私}もなりきるよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705440112
					]
				},
				{
					"id": 705440112,
					"content": "やはり予想通り！「猫の魔術師」の二人よ、再び運命の糸に導かれ、わたくしの前にやってきたわね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440113
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 705440113,
					"content": "なんと心震わす運命の再会！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440114
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 705440114,
					"content": "その肩書き…どうやらフィッシュルはもうヴァレリナからオイラたちのことを聞いてるみたいだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705440115,
					"content": "この皇女が幽夜浄土で熟考している間に——もしあなたたちの知恵を拝借できれば、時折過去の見聞から得られる巧みな考えも簡単に実現できるようになるわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440116
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 705440116,
					"content": "そして、わたくしは最も鋭い感覚と聡明な頭脳を持つ猫の眷属を選定し、この皇女に同行させるつもりよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440117
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 705440117,
					"content": "にゃ～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440118
					],
					"speakerTitle": "「ボー」"
				},
				{
					"id": 705440118,
					"content": "フィッシュルも猫を飼うつもりなんだな。まあそれもそっか、ほとんどの人は猫の可愛さを見れば飼いたくなるもんだし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705440119,
					"content": "でも、フィッシュルにはオズがついてるだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705440120,
					"content": "おまえたちの動きってもともと速いし、猫についていけるのか？それとも…オズが猫を乗っけて飛ぶとか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705440121,
					"content": "ふふん、確かにわたくしはこの広大な宇宙をしばし跨ぎ歩いているわ。長い旅路とは言えないけれど、多少仲間が増えることで、見逃しがちな事物を逃さず捉えられるのなら…それはもちろん悪いことではない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440122
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 705440122,
					"content": "オズもきっと猫の眷属と遊びた…コホンッ！協力したがっている。わたくしの気持ちが、常に明月の如く明るく、風のごとく清々しくあることを保つために！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440123
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 705440123,
					"content": "残念ながら、オズが親しみやすい姿を珍しく披露したとしても、その威厳を完全に隠すことはできない。ゆえに、猫の眷属も近づけない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440124
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 705440124,
					"content": "猫がオズから五歩の距離に入ると、猫の眷属たちの体毛は漂うポンポンの実のように、たちまち膨張し、やがて恐怖に呑まれて散り散りに逃げていく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440125
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 705440125,
					"content": "風神を信仰する忠実なシスターが、オズに外で休むよう進言してきたの。確かに一理あったから…わたくしはそれを黙認したわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440126
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 705440126,
					"content": "威厳？ああ、なんだかわかった気がするぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705440127,
					"content": "もしかして、オズの身体は雷元素が充満しすぎてるせいで、「ネコモコの城」に入った途端、猫たちの毛が爆発するってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705440128,
					"content": "でもそうなると、猫はどうやってフィッシュルたちと旅すればいいんだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440129
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705440129,
					"content": "テイワットになにかしら…雷元素を遮断できる素材があればいいんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440130
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705440130,
					"content": "そういう素材で猫に服を作ってあげたら、フィッシュルやオズと一緒に旅ができるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440131
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705440131,
					"content": "ニャ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440132,
						705440133
					],
					"speakerTitle": "「ボー」"
				},
				{
					"id": 705440132,
					"content": "#先に{M#俺}{F#私}にちょうだい！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705440134
					]
				},
				{
					"id": 705440134,
					"content": "でもよく考えたら、元素力って超超すごいんだから、その元素力を遮断できる素材が簡単に手に入るなんてこと…あるわけないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440135
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705440135,
					"content": "オイラたちも変な妄想はやめようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440136
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705440136,
					"content": "甘い！猫の眷属の才能を常識で推し量るべからず！凡人の二言三言では彼らの性質を言い表すことはできないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440137
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 705440137,
					"content": "この世のどこかにはいるかもしれない…水に潜り、烈火に耐え、風に乗って進める猫の眷属。そしてもちろん、雷を恐れない特殊な個体もいるはずよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440138
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 705440138,
					"content": "わたくしが辛抱強く探せば、絶対に見逃すことはない。十年百年待ったとしても、幽夜浄土の時計で言えば一瞬の出来事に過ぎないわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440139
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 705440139,
					"content": "それに、明後日の修行もとても重要よ。「ボー」には十分な素質があると見た。しばらくわたくしと一緒に過ごしていれば、雷の力にも慣れてくるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440140
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 705440140,
					"content": "ちょうど、わたくしは幾千もの雑務を片付けたところ。近頃は暇だから、ここでもう少し猫の眷属たちを観察することにするわ…特に「ボー」を！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440141
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 705440141,
					"content": "ニャッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440142
					],
					"speakerTitle": "「ボー」"
				},
				{
					"id": 705440142,
					"content": "へへっ、じゃあ「ネコモコの城」を楽しんでくれよ、フィッシュル！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705440133,
					"content": "それを着て、雷スライムをグーパンする！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705440134
					]
				},
				{
					"id": 705440111,
					"content": "大猫の魔術師様、謁見に参りました！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705440112
					]
				}
			]
		}
	]
}