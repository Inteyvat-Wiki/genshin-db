			"dialogs": [
				{
					"id": 766760101,
					"content": "最高！今のところ、イベントは文句なしに順調だよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760102
					],
					"speakerTitle": "ヌスタ"
				},
				{
					"id": 766760102,
					"content": "スメールの友人が何人もナタ流のダンスを覚えてくれたんだ。あたしらのダンスがテイワット全土に広がる可能性を感じたよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760103
					],
					"speakerTitle": "ヌスタ"
				},
				{
					"id": 766760103,
					"content": "今後、ナタとスメールの「ダンス交流会」が定例化して、定期的にお互い行き来できたらいいね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760104
					],
					"speakerTitle": "ヌスタ"
				},
				{
					"id": 766760104,
					"content": "じゃあナタの竜たちも「エルマイト旅団」みたいに刀を振り回して踊るのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760105,
						766760106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766760105,
					"content": "あと伝説の剣舞も…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766760107
					]
				},
				{
					"id": 766760107,
					"content": "えっ？それってもしかして…ヌスタたちがシャムシールおじさんと初めて会った時に、おじさんたちが聖骸赤鷲を追い払うためにやった威嚇の動作のこと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760108
					],
					"speakerTitle": "タラネ"
				},
				{
					"id": 766760108,
					"content": "あの動作の由来について、おじさんから何も聞いてないの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760109
					],
					"speakerTitle": "タラネ"
				},
				{
					"id": 766760109,
					"content": "いや、聞いたよ。確か…「熾鬣の獅子と蒼鷺の庇護の二重奏」とかなんとか言ってたね？美しくて力強い名前だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760110
					],
					"speakerTitle": "ヌスタ"
				},
				{
					"id": 766760110,
					"content": "そ、その二つなら聞き覚えがあるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760111,
						766760112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766760111,
					"content": "二人の友達を思い出すね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766760113
					]
				},
				{
					"id": 766760113,
					"content": "#{NICKNAME}とパイモンにはピンときたかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760114
					],
					"speakerTitle": "タラネ"
				},
				{
					"id": 766760114,
					"content": "みんなが聖骸赤鷲に遭遇したあのエリアは、「熾光の猟獣」の駄獣の隊列がよく通ってるところなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760115
					],
					"speakerTitle": "タラネ"
				},
				{
					"id": 766760115,
					"content": "前にも、ディシアさんとキャンディスさんを乗せた駄獣の隊列がアアル村に戻る時に、赤鷲の群れに遭遇したんだけどね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760116
					],
					"speakerTitle": "タラネ"
				},
				{
					"id": 766760116,
					"content": "二人はちょうど体がなまってたから、ウォーミングアップ代わりに、赤鷲たちに全力で立ち向かったんだって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760117
					],
					"speakerTitle": "タラネ"
				},
				{
					"id": 766760117,
					"content": "以来、「熾光の猟獣」のメンバーは二人が技を繰り出す時の動きをマネするようになって、赤鷲はそれを見ただけで逃げ出すようになったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760118
					],
					"speakerTitle": "タラネ"
				},
				{
					"id": 766760118,
					"content": "やっぱりな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766760119,
					"content": "その聖骸赤鷲たちもツイてなかったな。あいつらを相手にするなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760120,
						766760121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766760120,
					"content": "自業自得だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766760122
					]
				},
				{
					"id": 766760122,
					"content": "そりゃすごい！二人とも会いたかったな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760123
					],
					"speakerTitle": "ヌスタ"
				},
				{
					"id": 766760123,
					"content": "今度あたしたちがスメールに行ったら、必ず引き合わせてくれよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760124
					],
					"speakerTitle": "ヌスタ"
				},
				{
					"id": 766760124,
					"content": "武術を教わりたいねぇ。特に強烈なパンチを素早く繰り出す時の、足の裏から太もも、太ももから背中、腕から拳へと力を送り出すリズムについてさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760125
					],
					"speakerTitle": "ヌスタ"
				},
				{
					"id": 766760125,
					"content": "あははっ、きっと飲み会も盛り上がるだろうね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760126
					],
					"speakerTitle": "タラネ"
				},
				{
					"id": 766760126,
					"content": "酔い覚ましのスープを用意しとかなくちゃ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "タラネ"
				},
				{
					"id": 766760121,
					"content": "ディシア、キャンディス、ナイス！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766760122
					]
				},
				{
					"id": 766760112,
					"content": "経緯が見えてきた気がする…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766760113
					]
				},
				{
					"id": 766760106,
					"content": "赤鷲をビビらせたやつ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766760107
					]
				}
			]
		}
	]
}