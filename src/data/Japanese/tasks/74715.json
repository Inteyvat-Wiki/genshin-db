			"trigger": {
				"objectNames": [
					"フレミネ"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							3509.359,
							452.648,
							4162.708
						],
						"pointId": 17298
					}
				]
			},
			"dialogs": [
				{
					"id": 747150101,
					"content": "フレミネ、なんだかすごく疲れてるみたいだな？引き上げ作業でくたびれちゃったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747150102,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150103
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 747150103,
					"content": "潜水用ヘルメットの中に隠れるなよ！オイラたちは友達なんだから、心に溜め込むより、口に出したほうがいいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747150104,
					"content": "…うん、わかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150105
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 747150105,
					"content": "さっき潜って引き上げ作業をしてた時、ちょっと嫌な人を見かけて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150106
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 747150106,
					"content": "嫌な人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747150107,
					"content": "えっと…どこから話せばいいかな。フォンテーヌの法律では、水に沈んだ貨物は、元の持ち主が保険金を受け取った場合には、自由財産になるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150108
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 747150108,
					"content": "だから、ダイビングをお金儲けの手段だと考える人もいて…他の人が失くした物を引き上げて、陸に上がったらそれをモラに換えるんだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150109
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 747150109,
					"content": "それ自体、そんなにハードルの高いことでもないから、潜水士の中には…お金のことしか考えてない人が少なからず紛れ込んでる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150110
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 747150110,
					"content": "そういう人たちは時々、自分たちの商売の邪魔になるってだけで、魚の群れやプクプク獣を乱暴に追い払うんだ…ぼくが一部の依頼を受けないのも、こういう人たちが関係してるって部分があって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150111
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 747150111,
					"content": "そうだったのか…おまえの気持ち、わかるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747150112,
					"content": "さっき水中で、そういう状況に出くわしたんだ。勇気を出して、止めようとしたけど…開き直って、逆に怒られちゃった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150113
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 747150113,
					"content": "そんな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150114,
						747150115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747150114,
					"content": "フレミネは間違ってないよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747150116
					]
				},
				{
					"id": 747150116,
					"content": "二人とも、ありがとう。でも——ぼくにとっては難しくて、とても疲れることだけど、それでも自分の努力で、何かを変えたいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150117
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 747150117,
					"content": "ぼく…水中を泳ぎ回るのが好きなんだ。蒼晶螺の模様を観察したり、ロマリタイムフラワーの呼吸を感じたり…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150118
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 747150118,
					"content": "水中の世界はぼくらを認めた時、優しい応えを返してくれる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150119
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 747150119,
					"content": "これこそがぼくたちの選ぶべき、世界との接し方だと思うんだ。ただ自分勝手に奪うんじゃなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150120
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 747150120,
					"content": "おう、すっごくいいこと言ってると思うぞ！へへっ、やっぱり本当にやりたいこととか言いたいことがある時は、口に出したほうがスッキリするだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747150121,
					"content": "う…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150122
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 747150122,
					"content": "フレミネ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747150123,
					"content": "ごめん…ちょっと恥ずかしくて。とにかく…ぼ、ぼく、これからも頑張るよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150124
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 747150124,
					"content": "そうそう、忘れるところだった…最新の水底調査情報、よかったら受け取って。きっとあなたたちの役に立つと思うから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 747150115,
					"content": "次からは代わりに言ってあげる！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747150116
					]
				}
			]
		}
	]
}