			},
			"dialogs": [
				{
					"id": 240070101,
					"content": "ロウ、何かいいもの見つけた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070102
					],
					"speakerTitle": "ヴェルー"
				},
				{
					"id": 240070102,
					"content": "まだよ。ここには何もないみたい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070103
					],
					"speakerTitle": "ロウ"
				},
				{
					"id": 240070103,
					"content": "何してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070104
					]
				},
				{
					"id": 240070104,
					"content": "#{M#おにいちゃん}{F#おねえちゃん}！今はね、「宝探し」してるんだ。へへ…一緒にやらない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070105,
						240070108
					],
					"speakerTitle": "ヴェルー"
				},
				{
					"id": 240070105,
					"content": "宝探し？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070106
					]
				},
				{
					"id": 240070106,
					"content": "ヴェルーったら適当なこと言っちゃって。実はあたしたち、ここでパーツを拾ってたところだったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070107
					],
					"speakerTitle": "ロウ"
				},
				{
					"id": 240070107,
					"content": "だってパーツは宝物だろ…ん？ここに何かありそうだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070114
					],
					"speakerTitle": "ヴェルー"
				},
				{
					"id": 240070114,
					"content": "うーん…ここには無いみたい。場所を変えてみようかしら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070115
					],
					"speakerTitle": "ロウ"
				},
				{
					"id": 240070115,
					"content": "うん！もっとあっちへ行ってみようよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070116,
						240070117
					],
					"speakerTitle": "ヴェルー"
				},
				{
					"id": 240070116,
					"content": "一緒に行くよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070118
					]
				},
				{
					"id": 240070118,
					"content": "#わあ、{M#おにいちゃん}{F#おねえちゃん}の言い方、おにいちゃんにそっくりだぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070119
					],
					"speakerTitle": "ヴェルー"
				},
				{
					"id": 240070119,
					"content": "じゃあもっと向こうに行ってみようよ。確かこの辺の水中にはパーツがいっぱい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴェルー"
				},
				{
					"id": 240070117,
					"content": "あまり遠くに行っちゃだめだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070118
					]
				},
				{
					"id": 240070108,
					"content": "オーレルはどうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070109
					]
				},
				{
					"id": 240070109,
					"content": "おにいちゃんはドルリューおじさんに会いに、街へ行ったよ。教えてもらいたいことがあるんだって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070110
					],
					"speakerTitle": "ヴェルー"
				},
				{
					"id": 240070110,
					"content": "「ここで大人しくしてろ」って言われたから…ずっとここで「宝探し」してるんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070111
					],
					"speakerTitle": "ヴェルー"
				},
				{
					"id": 240070111,
					"content": "#へへ…{M#おにいちゃん}{F#おねえちゃん}も一緒にやらない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070112
					],
					"speakerTitle": "ヴェルー"
				},
				{
					"id": 240070112,
					"content": "ヴェルーったら適当なこと言っちゃって。実はあたしたち、ここでパーツを拾ってたところだったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070113
					],
					"speakerTitle": "ロウ"
				},
				{
					"id": 240070113,
					"content": "だってパーツは宝物だろ…ん？ここに何かありそうだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070114
					],
					"speakerTitle": "ヴェルー"
				}
