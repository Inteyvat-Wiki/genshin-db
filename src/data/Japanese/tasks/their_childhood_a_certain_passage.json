			"dialogs": [
				{
					"id": 240070501,
					"content": "どれどれ…このギアは使えそうね。こっちのベアリングは切っちゃえば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070502
					],
					"speakerTitle": "ロウ"
				},
				{
					"id": 240070502,
					"content": "こんなの拾ってどうするの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070503
					]
				},
				{
					"id": 240070503,
					"content": "あのね、自分でクロックワーク人形を作ってみたいの。実は…こっそり作り方を勉強したことがあるのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070504
					],
					"speakerTitle": "ロウ"
				},
				{
					"id": 240070504,
					"content": "ちゃんと作り方を身に着けたら、おっきなクロックワーク·マシナリーを作って、パパにサプライズしてあげるの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070505
					],
					"speakerTitle": "ロウ"
				},
				{
					"id": 240070505,
					"content": "パパの部屋で本をいーっぱい読んで、本に書かれた作り方に従って簡単なパーツを作ったこともあるのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070506
					],
					"speakerTitle": "ロウ"
				},
				{
					"id": 240070506,
					"content": "もうちょっと頑張れば、きっと作りたかったクロックワーク·マシナリーを完成させられると思うわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070507
					],
					"speakerTitle": "ロウ"
				},
				{
					"id": 240070507,
					"content": "でも、クロックワークやマシナリーの勉強はシティではできないの。パパにばれたら、サプライズじゃなくなっちゃうもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070508
					],
					"speakerTitle": "ロウ"
				},
				{
					"id": 240070508,
					"content": "そう！だからね、ここにロウがクロックワークを研究するための秘密基地を作るんだ！僕は…ただの助手だけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070509
					],
					"speakerTitle": "ヴェルー"
				},
				{
					"id": 240070509,
					"content": "ほらほら助手さん！ぐずぐずしてないで研究を始めるわよ！今日こそ動く機械アームを完成させるんだから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070510
					],
					"speakerTitle": "ロウ"
				},
				{
					"id": 240070510,
					"content": "はいっ！研究を始めましょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴェルー"
				}
			]
		}
