			"dialogs": [
				{
					"id": 240070401,
					"content": "これって…ぼろぼろの服？完全に色あせちゃってるわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070402
					],
					"speakerTitle": "ロウ"
				},
				{
