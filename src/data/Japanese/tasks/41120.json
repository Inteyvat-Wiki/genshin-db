					"グレイス"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411200701,
					"content": "おかえりなさい。通知は終わった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200702
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 411200702,
					"content": "通知はしたけど、皆しばらく帰ってこない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200703
					]
				},
				{
					"id": 411200703,
					"content": "帰ってこない？一体どれだけ重要な用があれば、こんな時に帰ってこないなんて決断になるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200704
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 411200704,
					"content": "さすが自由の都の人…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200705
					]
				},
				{
					"id": 411200705,
					"content": "はは…は…そうね、彼らは確かに自由なモンド人、自由すぎるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200706
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 411200706,
					"content": "でもこんな時くらいは、自由を求める気持ちを抑えてほしかったわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200707
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 411200707,
					"content": "はぁ…西風騎士団はこの事を処理する暇はないし。私でなんとかするわ、ご苦労様。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200708
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 411200708,
					"content": "皆無事ならいいけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "グレイス"
				}
			]
