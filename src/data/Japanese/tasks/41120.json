			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"リン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411200201,
					"content": "この状況で「サバイバル」を続ける…なかなかスリルがあるわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200202
					],
					"speakerTitle": "リン"
				},
				{
					"id": 411200202,
					"content": "モンド城に避難してください。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200203
					]
				},
				{
					"id": 411200203,
					"content": "避難？あら、心配しなくてもいいわ。いつでも周囲に気を付けてるから、危険はないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200204
					],
					"speakerTitle": "リン"
				},
				{
					"id": 411200204,
					"content": "でも、君は早くモンド城に戻りなさい。隕石に当たったら大変よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200205
					],
					"speakerTitle": "リン"
				},
				{
					"id": 411200205,
					"content": "野外にまだ人が…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200206
					]
				},
				{
					"id": 411200206,
					"content": "野外にいる人？たくさんいるわよ、これを聞いてどうするの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200207,
						411200211
					],
					"speakerTitle": "リン"
				},
				{
					"id": 411200207,
					"content": "避難させる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200208
					]
				},
				{
					"id": 411200208,
					"content": "そうね…そういえば、協会が似たような依頼を出してたから、私も周囲の人に通知したけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200209
					],
					"speakerTitle": "リン"
				},
				{
					"id": 411200209,
					"content": "モンド城の近くにいた人は、もう中に避難してると思うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200210
					],
					"speakerTitle": "リン"
				},
				{
					"id": 411200210,
					"content": "でも人手不足で、冒険者が少ないから、知らされていない人も多いはず。手伝ってくれるなら良いに越したことはないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200215
					],
					"speakerTitle": "リン"
				},
				{
					"id": 411200215,
					"content": "そうね、まだ野外にいる人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200216
					],
					"speakerTitle": "リン"
				},
				{
					"id": 411200216,
					"content": "あ！そうだった、パチさんとドゥーランさんがまだ千風の神殿にいるわ。私からも言ったんだけど、まだあそこで研究を続けてるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200217
					],
					"speakerTitle": "リン"
				},
				{
					"id": 411200217,
					"content": "あとシスターフィンドね。彼女はいつも望風海角にいたから、私も探したんだけど、何回行っても見つからなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200218
					],
					"speakerTitle": "リン"
				},
				{
					"id": 411200218,
					"content": "これくらいしか覚えてないわ。まず彼らにモンド城に避難するよう言って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200219
					],
					"speakerTitle": "リン"
				},
				{
					"id": 411200219,
					"content": "私はここで食糧と必需品を準備してから、周囲を回ってもっと多くの人に避難するよう通知してくるね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200220
					],
					"speakerTitle": "リン"
				},
				{
					"id": 411200220,
					"content": "彼らあまり遠くに行ってないといいんだけど、じゃないと帰ってくるのも大変でしょ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リン"
				},
				{
					"id": 411200211,
					"content": "シスターグレイスが心配してた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200212
					]
				},
				{
					"id": 411200212,
					"content": "シスターグレイス？彼女だったのね…協会が似たような依頼を出してたから、私も周囲の人に通知したけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200213
					],
					"speakerTitle": "リン"
				},
				{
					"id": 411200213,
					"content": "モンド城の近くにいた人は、もう中に避難してると思うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200214
					],
					"speakerTitle": "リン"
				},
				{
					"id": 411200214,
					"content": "でも人手不足で、冒険者が少ないから、知らされていない人も多いはず。手伝ってくれるなら良いに越したことはないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200215
					],
					"speakerTitle": "リン"
				}
			]
		},
		{
			"id": 4112003,
			"completionStepIds": [
				4112003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4112003",
							"2"
						],
						"stepId": 4112003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ドゥーラン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411200301,
					"content": "今は研究してる場合じゃない、早く避難しないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200302
					],
					"speakerTitle": "ドゥーラン"
				},
				{
					"id": 411200302,
					"content": "何回も言ったけど、今回のチャンスはあきらめないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200303
					],
					"speakerTitle": "好奇心旺盛なパチ"
				},
				{
					"id": 411200303,
					"content": "モンド城に避難してください。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200304
					]
				},
				{
					"id": 411200304,
					"content": "また来たの？今は避難してる場合じゃない。この隕石は、私たちが千風の神殿の奥深くに入る絶好のチャンスなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200305
					],
					"speakerTitle": "好奇心旺盛なパチ"
				},
				{
					"id": 411200305,
					"content": "千風の神殿の奥深く？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200306
					]
				},
				{
					"id": 411200306,
					"content": "パチが言うには、隕石が奥深くの神殿…もしくは他の何かに当たれば、僕たちは隕石が空けた道を辿って中にいけるからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200307
					],
					"speakerTitle": "ドゥーラン"
				},
				{
					"id": 411200307,
					"content": "でもそんなのありえない。隕石なんかが当たったら、まず助からない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200308
					],
					"speakerTitle": "ドゥーラン"
				},
				{
					"id": 411200308,
					"content": "やっぱり避難しよう、もし本当に隕石が当たったら、道ができるはずだ。それから探索に来てもいいだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200309
					],
					"speakerTitle": "ドゥーラン"
				},
				{
					"id": 411200309,
					"content": "もし他の人に先を越されたらどうするの？帰りたいなら一人で帰って、私はここにいる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200310
					],
					"speakerTitle": "好奇心旺盛なパチ"
				},
				{
					"id": 411200310,
					"content": "そんな…しかたない。旅人さん、悪いが、僕たちはまだここにいるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200311
					],
					"speakerTitle": "ドゥーラン"
				},
				{
					"id": 411200311,
					"content": "心配しないで、もし危険があれば…ぼ、僕がなんとかする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200312
					],
					"speakerTitle": "ドゥーラン"
				},
				{
					"id": 411200312,
					"content": "そうだ、前に確かシュースターという人がここを通ったよ、凄く怯えていた様子だった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200313
					],
					"speakerTitle": "ドゥーラン"
				},
				{
					"id": 411200313,
					"content": "水をあげたら、自分でモンド城に戻ると言って、急いで走っていったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200314
					],
					"speakerTitle": "ドゥーラン"
				},
				{
					"id": 411200314,
					"content": "でも彼が走り出した先は、モンド城じゃなくて望風海角…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200315
					],
					"speakerTitle": "ドゥーラン"
				},
				{
					"id": 411200315,
					"content": "もしかして…怖がり過ぎて、道を間違えたんじゃないかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200316
					],
					"speakerTitle": "ドゥーラン"
				},
				{
					"id": 411200316,
					"content": "旅人さん、望風海角に行って彼を探してよ、もし魔物に襲われてたらまずい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200317
					],
					"speakerTitle": "ドゥーラン"
				},
				{
					"id": 411200317,
					"content": "僕はここでパチに付き添うよ。何かあったら…えっと、僕がなんとかするから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ドゥーラン"
				}
			]
		},
		{
			"id": 4112004,
			"completionStepIds": [
				4112004
			],
