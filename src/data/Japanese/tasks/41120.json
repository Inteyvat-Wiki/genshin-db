				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411200401,
					"content": "あら？旅人さん、何しにここに？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200402
					],
					"speakerTitle": "フィンド"
				},
				{
					"id": 411200402,
					"content": "どこに行ってたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200403
					]
				},
				{
					"id": 411200403,
					"content": "ごめんなさい、ずっと移動して海面を観察してたの…私に何か用？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200404
					],
					"speakerTitle": "フィンド"
				},
				{
					"id": 411200404,
					"content": "モンド城に避難してください。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200405
					]
				},
				{
					"id": 411200405,
					"content": "避難？そう、隕石のことね。私も知ってるわ、でも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200406
					],
					"speakerTitle": "フィンド"
				},
				{
					"id": 411200406,
					"content": "き、気をつけろ！魔物が囲んできたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 4112006,
			"completionStepIds": [
