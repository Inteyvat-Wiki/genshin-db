			"dialogs": [
				{
					"id": 411200801,
					"content": "うわ！君…あ…魔物じゃないのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200802
					],
					"speakerTitle": "怖がっているシュースター"
				},
				{
					"id": 411200802,
					"content": "モンド城に避難してください。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200803
					]
				},
				{
					"id": 411200803,
					"content": "わ…分かってる！僕も他の人に通知するためにきたんだ、少し回り道をしたけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200804
					],
					"speakerTitle": "怖がっているシュースター"
				},
				{
					"id": 411200804,
					"content": "ここに隠れて何してるの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200805
					]
				},
				{
					"id": 411200805,
					"content": "ぼ…僕はここで休憩中だよ、悪い？もういいから、早くモンド城に避難してよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200806
					],
					"speakerTitle": "怖がっているシュースター"
				},
				{
					"id": 411200806,
					"content": "隕石だの魔物だの…今まだ野外にいる人は、頭がおかしいに決まってる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200807
					],
					"speakerTitle": "怖がっているシュースター"
				},
				{
					"id": 411200807,
					"content": "他に野外にいる人はいる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200808
					]
				},
				{
					"id": 411200808,
					"content": "僕は元々シスターフィンドに避難するよう伝えにきたんだけど…あの望風海角近くにいるシスターね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200809
					],
					"speakerTitle": "怖がっているシュースター"
				},
				{
					"id": 411200809,
					"content": "でも望風海角を探してもシスターフィンドが見つからなくて、他の場所を探そうと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200810
					],
					"speakerTitle": "怖がっているシュースター"
				},
				{
					"id": 411200810,
					"content": "ただ運悪く、魔物に囲まれてしまって。やっとのことで逃げられたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200811
					],
					"speakerTitle": "怖がっているシュースター"
				},
				{
					"id": 411200811,
					"content": "それでまた望風海角に戻ってきたんだけど、それでもシスターフィンドが見つからなくて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200812
					],
					"speakerTitle": "怖がっているシュースター"
				},
				{
					"id": 411200812,
					"content": "はぁ、あのシスターもうモンド城に戻ってるといいけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200813
					],
					"speakerTitle": "怖がっているシュースター"
				},
				{
					"id": 411200813,
					"content": "じゃあ、僕は先にモンド城に戻るよ。君も早く戻った方がいい。今は野外でうろうろしてる場合じゃないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "怖がっているシュースター"
				}
			]
