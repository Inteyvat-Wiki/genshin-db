					"グレイス"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411200101,
					"content": "皆無事ならいいけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200102
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 411200102,
					"content": "なにか心配が？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200103
					]
				},
				{
					"id": 411200103,
					"content": "旅人さんね。あの空から降る隕石は、あなたも見たわよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200104
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 411200104,
					"content": "運よくモンド城には降っていないけれど、野外はもう大混乱よ。まだ野外にいる人々が心配だわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200105
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 411200105,
					"content": "旅人さん、野外にいる人に注意してきてくれないかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200106
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 411200106,
					"content": "彼らが望むなら、モンド城に避難するように言ってちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200107,
						411200109
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 411200107,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200108
					]
				},
				{
					"id": 411200108,
					"content": "では頼んだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200112
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 411200112,
					"content": "先にリンさんに事情を聞くといいわ、野外にまだ人がいるかどうか知ってると思うから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200113
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 411200113,
					"content": "あと、彼女にもモンド城に避難するよう言ってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200114
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 411200114,
					"content": "彼女は「サバイバル」にチャレンジしてるけど、今はそんな場合じゃないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "グレイス"
				},
				{
					"id": 411200109,
					"content": "どうして隕石はモンド城に降らない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200110
					]
				},
				{
					"id": 411200110,
					"content": "運が良いだけかもね。何にしても、今のモンド城が比較的安全な場所なのは確かね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200111
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 411200111,
					"content": "少なくとも…野外にいるよりは安全。そうでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200112
					],
					"speakerTitle": "グレイス"
				}
			]
		},
		{
			"id": 4112002,
			"completionStepIds": [
				4112002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4112002",
