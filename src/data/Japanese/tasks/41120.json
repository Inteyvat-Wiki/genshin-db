					"フィンド"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411200601,
					"content": "ふう…ありがとう、さっきは危なかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200602
					],
					"speakerTitle": "フィンド"
				},
				{
					"id": 411200602,
					"content": "だから、モンド城に避難してください。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200603
					]
				},
				{
					"id": 411200603,
					"content": "ごめんなさい、今はまだ帰れないの。この空から降る隕石、凄く珍しい現象なの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200604
					],
					"speakerTitle": "フィンド"
				},
				{
					"id": 411200604,
					"content": "そんな中、海上に嵐が起きてもおかしくない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200605
					],
					"speakerTitle": "フィンド"
				},
				{
					"id": 411200605,
					"content": "ここで見張って、嵐が起きたらいち早く城に通知しないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200606
					],
					"speakerTitle": "フィンド"
				},
				{
					"id": 411200606,
					"content": "通知に来てくれてありがとう、ご苦労様。もっと気を付けるね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フィンド"
				}
			]
		},
		{
			"id": 4112007,
			"completionStepIds": [
