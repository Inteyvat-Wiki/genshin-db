				{
					"id": 730410101,
					"content": "あっ、金色のナラ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410102
					],
					"speakerTitle": "アランニシャット"
				},
				{
					"id": 730410102,
					"content": "ナラの友達、アランリラと遊ぼう！アランニシャットは弱いから一緒に遊んじゃダメ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410103
					],
					"speakerTitle": "アランリラ"
				},
				{
					"id": 730410103,
					"content": "ぶぅ、前にアランリラはアランニシャットに負けた。なら、アランリラはもっと弱い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410104
					],
					"speakerTitle": "アランニシャット"
				},
				{
					"id": 730410104,
					"content": "分かった、太陽だの月だのはどうでもいい。ここにいいナラの友達がいる。ナラの友達と一緒に遊んで、どっちが強いか勝負しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410105
					],
					"speakerTitle": "アランリラ"
				},
				{
					"id": 730410105,
					"content": "勝負だ。アランニシャットは怖くないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410106
					],
					"speakerTitle": "アランニシャット"
				},
				{
					"id": 730410106,
					"content": "アランリラが先に隠れて、ナラの友達が見つける。アランニシャットが後から隠れて、ナラの友達が見つける。早く見つかったほうの負け。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410107
					],
					"speakerTitle": "アランリラ"
				},
				{
					"id": 730410107,
					"content": "ナラの友達、遊んでくれる？準備ができたらすぐ始めよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランリラ"
				}
