					}
				]
			},
			"dialogs": [
				{
					"id": 761150101,
					"content": "あれ？ネフェル、ヤフォダ！なんでこんなとこにいるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761150102,
					"content": "仕事にきまってるだろ。これまでなかなか手がかりが掴めなかった賞金首を、ついに見つけたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150103
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761150103,
					"content": "ヤフォダから、賞金首である「裂けアゴ」のハルクのことと、これまでに「秘聞の館」が突き止めた情報について教えてもらった…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761150104
					]
				},
				{
					"id": 761150104,
					"content": "結論から言おう。本物の隠者ドーヴェントはほぼ間違いなく殺されてる。そして、今隠者の小屋を占拠してるのは賞金首の「裂けアゴ」のハルクだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150105
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761150105,
					"content": "ヤフォダが見つけた日誌の断片も、ドーヴェントがすべての事情を知った上でハルクを引き取ったことを証明してる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150106
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761150106,
					"content": "驚くことでもない…ハルクはまた昔の悪癖が出ちまったのさ。ドーヴェントを始末して、彼の身分を盗んだんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150107
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761150107,
					"content": "調査した時、顔を合わせたわけじゃないけど…小屋の中にいるあいつがドーヴェントさんなわけないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150108
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761150108,
					"content": "隠者を名乗ってれば、いくらおかしなことをしてても疑われないしね。あのマスクは修行のためなんかじゃない。きっと顎の傷痕を隠すためのものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150109
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761150109,
					"content": "行方不明の行商人のほうだけど、やっぱり、最悪殺されてるかもしれないね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150110
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761150110,
					"content": "こんな悪事を働いておいて、そのうえさらに恩を仇で返すなんて、いったいどんな悪党だよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761150111,
					"content": "あたしの推測では、「流浪の輪」の商品窃盗事件はハルクとは無関係だ。犯行の動機が薄すぎるからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150112
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761150112,
					"content": "十年間、やつは法を犯していなかった。盗んだ商品に、やつが苦労して築き上げたすべてを捨てるほどの価値があったと思うかい？あたしはそう思わない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150113
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761150113,
					"content": "なら、少し仮説を立ててみようじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150114
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761150114,
					"content": "知ってのとおり、事件後、やつはアトラス号の残骸付近に戻って、宝探しに来たトレジャーハンターを襲った。人が窮地に陥ると元いた場所に戻ろうとするのは、一種の本能だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150115
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761150115,
					"content": "やつがまだアトラス号で舵手を務めていたときは、名声も富もそこまで値打ちがなかった。でもね、「流浪の輪」に加わった後はどうだい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150116
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761150116,
					"content": "十年ものあいだ法を犯していなかったにもかかわらず、窃盗事件がひとたび起きれば、人々は依然として疑いの目と言葉を投げかけてくる——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150117
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761150117,
					"content": "それ以上に耐え難かったのは、出自が同じなのに、単なる無名の男だったジュヤニが上手くやっていることだったのかもしれない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150118
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761150118,
					"content": "ジュヤニこそが犯人だって糾弾は、誰の心にも届かなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150119
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761150119,
					"content": "そうしてやつは失意と怒りの中で、一つ目の過ちを犯した。あの事件は、やつの人生のターニングポイントだったんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150120
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761150120,
					"content": "隠者の小屋で起きた事も、似たようなきっかけがあったんだと思うよ…ほんの些細な食い違いが、致命的な衝突を引き起こすことはある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150121
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761150121,
					"content": "#{NICKNAME}、こんな危険なやつを野放しにするわけにはいかないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150122,
						761150123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761150122,
					"content": "#{M#俺}{F#私}に任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761150124
					]
				},
				{
					"id": 761150124,
					"content": "#{NICKNAME}が願い出てくれたことだし、ヤフォダには休んでもらおうかね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150125
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761150125,
					"content": "あたいもけっこう頑張ったからな！遠慮なく休ませてもらうよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150126
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761150126,
					"content": "さて、ここまでの仮説が正しいかどうかは、やつに会えば分かることだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761150123,
					"content": "賞金のため？どっちにしてもやるけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761150124
					]
				}
			]
		},
