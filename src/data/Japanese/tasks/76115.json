							2537.213,
							337.621,
							8984.311
						],
						"pointId": 360500014
					}
				]
			},
			"dialogs": [
				{
					"id": 761150301,
					"content": "昨日の自分と同じことを繰り返すことしか知らないなんて、情けない男だね。予想どおりのつまらない人間だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150302
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761150302,
					"content": "ずっと悪さをしないでやってきたのに…結局、悪人は生まれついての悪人で、改心することはないってことなのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150303,
						761150304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761150303,
					"content": "善良でい続けるのは簡単じゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761150305
					]
				},
				{
					"id": 761150305,
					"content": "選択の権利は常にあったはずだ。さっきだって、やつは間違いを認めて悔い改めることもできたはずだよ。でも、やつは再び間違った選択をした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150306
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761150306,
					"content": "今までがすべて間違っていたから、こんな結果になったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150307
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761150307,
					"content": "#とにかく、これで一つ仕事が片付いた。証拠品は約束通り、{NICKNAME}からレゼックに届けてもらおうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150308
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761150308,
					"content": "#姐さんと{NICKNAME}がいるなら安心だな！これでやっと休めるぞ。",
