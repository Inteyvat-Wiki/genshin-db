			},
			"dialogs": [
				{
					"id": 761150201,
					"content": "…俺はあんたたちに何もしていない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150202
					],
					"speakerTitle": "ドーヴェント"
				},
				{
					"id": 761150202,
					"content": "あたしらが来た理由を分かってるようだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150203
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761150203,
					"content": "…もう過ぎた話だ。今はただ静かに暮らしたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150204
					],
					"speakerTitle": "ドーヴェント"
				},
				{
					"id": 761150204,
					"content": "他人の身分を奪ってまでかい？最初はジュヤニ…次はドーヴェント。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150205
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761150205,
					"content": "だが、下手な演技はいずれ暴かれるものだ。もう次の被害者は出ないだろうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150206
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761150206,
					"content": "…ジュヤニ？やつの身分を奪おうとした？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150207
					],
					"speakerTitle": "ドーヴェント"
				},
				{
					"id": 761150207,
					"content": "あれはやつのものじゃない…どうしてそう言えるんだ？あいつのほうが人に好かれて、他人にへつらうのが得意だからか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150208
					],
					"speakerTitle": "ドーヴェント"
				},
				{
					"id": 761150208,
					"content": "俺たちは同じなんだ！…やつに取られた物は、もともと俺のものだったんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150209
					],
					"speakerTitle": "ドーヴェント"
				},
				{
					"id": 761150209,
					"content": "なら、ドーヴェントさんと行商人は？二人があんたに何をしたってんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150210
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761150210,
					"content": "…彼ら？ああ、あいつらは聞いちゃいけないことを聞いてきた。お前らのようにな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150211
					],
					"speakerTitle": "ドーヴェント"
				},
				{
					"id": 761150211,
					"content": "死ね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ドーヴェント"
				}
			]
		},
