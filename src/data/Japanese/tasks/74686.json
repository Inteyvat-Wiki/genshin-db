				"points": []
			},
			"dialogs": [
				{
					"id": 746860101,
					"content": "ごきげんよう、大冒険者さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746860102
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 746860102,
					"content": "スーパーエディター様と呼んで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746860103
					]
				},
				{
					"id": 746860103,
					"content": "広告エキスパートと呼んで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746860104
					]
				},
				{
					"id": 746860104,
					"content": "ははっ、コマーシャル制作が退屈じゃなかったみたいでよかった！貴重な再会の時なのに、つまらないことをさせてしまったかと少し心配していたから、ほっとしたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746860105
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 746860105,
					"content": "いつも好きな時に会えるわけじゃないからな。世界を股にかける冒険者を見つけるのなんか、空から星をもぎ取るようなものさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746860106
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 746860106,
					"content": "こうしてカフェでばったり出会えることもあれば、誰に聞こうが行方を追えないこともあるからなぁ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746860107
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 746860107,
					"content": "良く言えば、お前に会うたびに波乱万丈な物語を聞けて、退屈しない。悪く言えば、どの出会いが最後の出会いになるかわからない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746860108,
						746860109
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 746860108,
					"content": "そこまでひどくないでしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746860110
					]
				},
				{
					"id": 746860110,
					"content": "ははっ、わかったよ。このまま愚痴り続けたら、よく特集が組まれる寂しい一人暮らしのおじいちゃんみたいになってしまうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746860111
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 746860111,
					"content": "手元のコマーシャルの依頼はほぼ撮影が完了したから、今度は次の長編のために頭を抱えないと。会えない間も、お互い夢のために頑張ろう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746860112
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 746860112,
					"content": "そうだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746860113
					]
				},
				{
					"id": 746860113,
					"content": "ああ、でもやはりこれだけは伝えたい——いつか一緒にご飯でも食べよう！場所はフォンテーヌじゃなくても構わない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746860114
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 746860114,
					"content": "鹿狩り、万民堂、ランバド酒場…キャンプや狩りでも構わないさ…俺がついて行けさえすれば…とにかく、連絡を待っているぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 746860109,
					"content": "ちょくちょく会いに来るよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746860110
					]
				}
			]
		}
	]
}