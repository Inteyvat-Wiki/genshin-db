					"アラニ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715551001,
					"content": "ありがとう、終わったと思ったわ…私は宝盗団たちにずっと後をつけられていたのかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551002
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 715551002,
					"content": "この遺跡に関する研究にもやっと進展があってね、もしお宝を掘り出せたらいいなって思ったら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551003
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 715551003,
					"content": "宝盗団が突然現れて、私をここに連れてきたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551004
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 715551004,
					"content": "宝物の在り処を吐き出せだの、言わなかったら殺すだの、怖かったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551005
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 715551005,
					"content": "でも本当に宝物の手がかりをやつらに教えたら、それこそ口封じされるから言わなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551006
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 715551006,
					"content": "はあ、ソラヤーさんの言うことを聞いて、宝物より学術面の収穫だけを考えるべきだったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551007
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 715551007,
					"content": "でも私の経費も多くないし、交通費すら自腹なんだよね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551008
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 715551008,
					"content": "ひとりでこんな長い間璃月で研究してきたソラヤーさんを尊敬するよ。却下された彼女の論文の数を見ただけで、すごいって思ったもん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551009
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 715551009,
					"content": "これからどうするつもり？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715551010
					]
				},
				{
					"id": 715551010,
					"content": "どうすることもできないよ。学術面の資料は全部揃えたけど、宝物は…いいや、君たちに譲るよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551011
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 715551011,
					"content": "推理の過程は割愛して、とにかく、宝物は霊矩関のど真ん中にあるあの<color=#00E1FFFF>金色の木</color>の下にある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551012
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 715551012,
					"content": "欲しければ取ってくるといいよ。場所をメモしてあげるね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551013
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 715551013,
					"content": "少し休憩したら拠点に戻るよ。宝盗団が来ないうちに、早くここから出たいんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551014
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 715551014,
					"content": "ここから望舒旅館までどれくらい時間がかかるんだろう。ソラヤーさんがまだ旅館にいるといいんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551015
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 715551015,
					"content": "はぁ、ソラヤーさんが私の指導員になってくれないかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アラニ"
				}
			]
		},
