			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"神里綾華"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120040101,
					"content": "うぅ、これからどうしよう…なにか計画とかないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120040102,
					"content": "旅人さん、パイモンさん、お待ちください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040103
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120040103,
					"content": "あれ？綾華？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120040104,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120040105
					]
				},
				{
					"id": 120040105,
					"content": "一つ頼みたいことがあるのですが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040106
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120040106,
					"content": "ご心配なさらずに。今回の依頼は社奉行や神里家とは関係ございません。私個人のお願いです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040107
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120040107,
					"content": "個人…ってことは、プライベートなことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120040108,
					"content": "はい、私のお母様に関することでございます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040109
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120040109,
					"content": "突然で申し訳ないのですが…このことは貴方にしか頼めません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040110
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120040110,
					"content": "詳しく教えて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120040111
					]
				},
				{
					"id": 120040111,
					"content": "先日、古い蔵の中からお母様が残した手記を見つけました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040112
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120040112,
					"content": "そこにはお母様が書き留めた様々な些事が記されていたのですが、その中に私の聞いたことのない人名が、頻繁に出てきていて…とても気になるのです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040113
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120040113,
					"content": "お母さんの友達じゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120040114,
					"content": "綾華でさえ聞いたことない名前なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120040115
					]
				},
				{
					"id": 120040115,
					"content": "はい。両親が亡くなってからすでに何年も経っているとはいえ、関わりがあった人物については私もお兄様も大抵は存じております。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040116
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120040116,
					"content": "ですので…この名前も聞いたことのないお方が非常に気になるのです。ぜひお会いしてみたいと思い…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040117
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120040117,
					"content": "手記には、相手の名前は「椿」と書かれていました。お母様から高く評価されていて、個性的で遊び心溢れる方だったようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040118
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120040118,
					"content": "聞いた感じ女の人の名前だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120040119,
					"content": "はい。その女性に会ってみたいのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040120
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120040120,
					"content": "じゃあ、オイラたちはなにをすればいいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120040121,
					"content": "人探しか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120040122,
					"content": "いえ、手記には彼女の住所が記されていましたので、直接そちらへ赴けばいいでしょう。旅人さんに依頼したいのは…その…一緒に手土産を用意していただきたく思ったからで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040123
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120040123,
					"content": "それと、先ほど言ったことはどうかご内密にお願いします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040124
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120040124,
					"content": "元々このようなことはお兄様と一緒に対応するべきなのですが、今お兄様はとても忙しく…それに、この地にいる他の者にはこのことに関わらせたくないと思いまして。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040125
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120040125,
					"content": "#だから{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}みたいな異郷人の力を借りたいと。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120040126
					]
				},
				{
					"id": 120040126,
					"content": "はい。貴方は礼儀作法に詳しく、人を思いやる心を持った優しいお方です。それにとても頼りになりますし、貴方といると安心できます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040127
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120040127,
					"content": "おう！手土産の用意なら、オイラたちも手伝えるぞ。報酬はそうだな…美味いもんをごちそうしてくれるだけでいいぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120040128,
					"content": "それはよかったです。元々この機会を利用してお二方と一緒に歩きたいと思っていたのです。よろしければ、一緒に行動しましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040129
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120040129,
					"content": "#もちろん！{NICKNAME}、いいよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040130
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120040130,
					"content": "うん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120040131
					]
				},
				{
					"id": 120040131,
					"content": "ありがとうございます！では、さっそく出発しましょう。まずは小倉屋へ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040132
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120040132,
					"content": "おう、行こう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
}