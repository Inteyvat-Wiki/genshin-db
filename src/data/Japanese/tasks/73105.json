				"points": []
			},
			"dialogs": [
				{
					"id": 731050701,
					"content": "アラニ！出てくる気はないのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050702
					],
					"speakerTitle": "ナザム"
				},
				{
					"id": 731050702,
					"content": "出ない！もう学者をやめる、学校もやめる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050703
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 731050703,
					"content": "大金だって払ったんだから、もう放っておいて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050704
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 731050704,
					"content": "頑固な小娘だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050705,
						731050706
					],
					"speakerTitle": "ナザム"
				},
				{
					"id": 731050705,
					"content": "あの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050707
					]
				},
				{
					"id": 731050707,
					"content": "こ、こんにちは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050708
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731050708,
					"content": "ん？あんたたちは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050709
					],
					"speakerTitle": "ナザム"
				},
				{
					"id": 731050709,
					"content": "た、旅人！うぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050710
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 731050710,
					"content": "アラニさん、本当にここにいたのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050711,
						731050712
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731050711,
					"content": "無事でよかった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050713
					]
				},
				{
					"id": 731050713,
					"content": "うぅ…うう…いじめられた！あの論文は、私が先に書いたのに！私が！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050714
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 731050714,
					"content": "稲妻で足止めを食らっていなければ、私の論文が先に通過してたのに！ううぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050715
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 731050715,
					"content": "落ち着けって…これからも論文を書くつもりはあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050716
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731050716,
					"content": "ふぅ…ふぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050717
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 731050717,
					"content": "か、書かない…論文なんてバカが書くものだ！もう学校はやめる！教令院なんてどうでもいい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050718
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 731050718,
					"content": "とにかく、もうナザムにお金を払って私の護衛をするよう頼んだし、帰って論文を書くことは絶対にないから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050719
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 731050719,
					"content": "ふん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050720
					],
					"speakerTitle": "ナザム"
				},
				{
					"id": 731050720,
					"content": "#{M#君}{F#あなた}は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050721
					]
				},
				{
					"id": 731050721,
					"content": "アタシはナザムだ。本業は…ふん、もう分かってるだろうから、無駄話はやめておこう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050722
					],
					"speakerTitle": "ナザム"
				},
				{
					"id": 731050722,
					"content": "あんたのことは知ってる、最近この辺りで活躍してるっていう「旅人」だろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050723
					],
					"speakerTitle": "ナザム"
				},
				{
					"id": 731050723,
					"content": "この小娘を連れ戻すよう頼まれてるなら、まずは彼女を説得してみるといい。私は止めない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050724
					],
					"speakerTitle": "ナザム"
				},
				{
					"id": 731050724,
					"content": "ちょっと！お金なら払ったでしょ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050725
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 731050725,
					"content": "たったあれっぽっちの金で何ができるっていうんだ？数日分の食糧を買っただけでなくなるだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050726
					],
					"speakerTitle": "ナザム"
				},
				{
					"id": 731050726,
					"content": "そ…それでも私は帰らない。帰ったら、また論文のタイトルを考えないといけないし、フィールドワークのために色々な所に行かなくちゃならないし、そうなれば食事や睡眠の質も落ちる一方だし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050727
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 731050727,
					"content": "もしかしたら、わけのわからない人に捕まったり、変な魔物たちに遭遇したりするかもしれない。そうやって論文が完成しないまま、また締切が過ぎるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050728
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 731050728,
					"content": "ううう…嫌だ…もう嫌だよ…それなら宝盗団に捕まったほうがマシ…ううぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050729
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 731050729,
					"content": "旅人、ニルファ先生に伝言を頼んでいい…？メ、メモに書いてあげるから…本当に帰りたくないんだ。だから、これで勘弁して…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050738
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 731050738,
					"content": "アラニは泣きながらメモを書きはじめた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731050730
					]
				},
				{
					"id": 731050730,
					"content": "書けた…はい。ううぅ…どうして、この世界には論文なんてものが存在するんだ…ううぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050731
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 731050731,
					"content": "…はぁ、少し落ち着け。誰もあんたを連れて帰ったりしないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050732
					],
					"speakerTitle": "ナザム"
				},
				{
					"id": 731050732,
					"content": "アラニさん…今は情緒不安定みたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050733
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731050733,
					"content": "アラニさんにはここにいてもらって、オイラたちはニルファさんにメモを渡しに行こうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050734,
						731050735
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731050734,
					"content": "でも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050736
					]
				},
				{
					"id": 731050736,
					"content": "そう心配しなくても、アラニに危害を加えたりはしないさ。彼女の言う通り、もう金はもらったからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050737
					],
					"speakerTitle": "ナザム"
				},
				{
					"id": 731050737,
					"content": "それに…ふっ、やっと学問のできる奴を見つけたんだ。生かしておいたほうが、アタシにとってもメリットがある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ナザム"
				},
				{
					"id": 731050735,
					"content": "宝盗団が…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050736
					]
				},
				{
					"id": 731050712,
					"content": "事情はニルファから聞いた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050713
					]
				},
				{
					"id": 731050706,
					"content": "お邪魔します…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050707
					]
				}
