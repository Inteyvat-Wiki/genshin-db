			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ゴブレイ",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731050501,
					"content": "ご慈悲を！全部誤解なんだ！もうやめてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050502,
						731050505
					],
					"speakerTitle": "ゴブレイ"
				},
				{
					"id": 731050502,
					"content": "誤解じゃないと思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050503
					]
				},
				{
					"id": 731050503,
					"content": "アラニになにをしたんだ？早く言え！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731050504,
					"content": "じゃないと…うう…殴るぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050507
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731050507,
					"content": "ちょ、ちょっと待ってくれ！頼むから話を聞いてくれ、本当に誤解なんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050508
					],
					"speakerTitle": "ゴブレイ"
				},
				{
					"id": 731050508,
					"content": "あの小娘にちょっかいを出すなんて、とんでもない。俺たちじゃ彼女に太刀打ちできないんだから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050509,
						731050510
					],
					"speakerTitle": "ゴブレイ"
				},
				{
					"id": 731050509,
					"content": "どういう意味？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050511
					]
				},
				{
					"id": 731050511,
					"content": "最後まで聞いてくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050512
					],
					"speakerTitle": "ゴブレイ"
				},
				{
					"id": 731050512,
					"content": "つい最近、俺たちは金に困っていて、姉御と一緒に近くで一儲けしようと考えてたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050513
					],
					"speakerTitle": "ゴブレイ"
				},
				{
					"id": 731050513,
					"content": "ふん！どうせ盗みや強盗をするつもりだったんだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050514
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731050514,
					"content": "そ…そりゃあ宝盗団だからな。金儲けっていったら、大体そういう手段になる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050515
					],
					"speakerTitle": "ゴブレイ"
				},
				{
					"id": 731050515,
					"content": "それで、拠点で金儲けの計画を練っていたら、突然大きなリュックを背負った小娘が近くに現れて、俺たちの方に向かって歩いてくるのが見えたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050516
					],
					"speakerTitle": "ゴブレイ"
				},
				{
					"id": 731050516,
					"content": "まるで魂が抜けたような顔をしていたから、俺たちも驚いた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050517
					],
					"speakerTitle": "ゴブレイ"
				},
				{
					"id": 731050517,
					"content": "だから思わず武器を取ろうとしたんだけど、その小娘は急に焚き火の傍に座り込んで、泣きながら大量の本を火の中に投げ込んだんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050518
					],
					"speakerTitle": "ゴブレイ"
				},
				{
					"id": 731050518,
					"content": "あのときの兄弟たち、本当に驚いてたな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050519,
						731050520
					],
					"speakerTitle": "ゴブレイ"
				},
				{
					"id": 731050519,
					"content": "小娘に驚いた…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050521
					]
				},
				{
					"id": 731050521,
					"content": "たしかに俺たちは宝盗団だけど、人の命を奪ったことなんかない。せいぜい盗みを働いたり、宝箱を横取りしたりするくらいだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050522
					],
					"speakerTitle": "ゴブレイ"
				},
				{
					"id": 731050522,
					"content": "そんなこんなで俺たちが状況を理解できずにいたら、その小娘がモラの入った袋を投げつけてきて、自分を檻に閉じ込めるように言ったんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050523
					],
					"speakerTitle": "ゴブレイ"
				},
				{
					"id": 731050523,
					"content": "え…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050524,
						731050525
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731050524,
					"content": "どういうこと…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050526
					]
				},
				{
					"id": 731050526,
					"content": "最初は…誰も彼女に関わろうとしなかった。でも彼女は、自分を飲まず食わずの状態で閉じ込めてくれって言い続けたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050527
					],
					"speakerTitle": "ゴブレイ"
				},
				{
					"id": 731050527,
					"content": "最終的に、木の枝を切って作った檻に彼女を閉じ込めろって、姉御に命令されたのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050528,
						731050529
					],
					"speakerTitle": "ゴブレイ"
				},
				{
					"id": 731050528,
					"content": "その姉御、アラニの言う通りにしたんだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050530
					]
				},
				{
					"id": 731050530,
					"content": "まあ、姉御は学問のある人間を尊敬してるからな。機会があれば自分も学校に行ってみたいって、いつも言ってるし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050531
					],
					"speakerTitle": "ゴブレイ"
				},
				{
					"id": 731050531,
					"content": "コホン、信じられないって言うなら…その小娘はあっちにいるから、自分で確かめてみてくれ。今頃、きっと姉御が彼女を説得してるはずだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050532
					],
					"speakerTitle": "ゴブレイ"
				},
				{
					"id": 731050532,
					"content": "もし小娘を説得して連れ帰ってくれたら、君たちに報酬をやるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ゴブレイ"
				},
				{
					"id": 731050529,
					"content": "#{M#君}{F#あなた}たち、アラニの言う通りにしたんだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050530
					]
				},
				{
					"id": 731050525,
					"content": "彼女を閉じ込めたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050526
					]
				},
				{
					"id": 731050520,
					"content": "#{M#君}{F#あなた}たち、宝盗団じゃないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050521
					]
				},
				{
					"id": 731050510,
					"content": "やっぱり、アラニはそこにいるんだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050511
					]
				},
				{
					"id": 731050505,
					"content": "アラニに何をした！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050506
					]
				},
				{
					"id": 731050506,
					"content": "早く言え！じゃないと…うう…殴るぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050507
					],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7310507,
