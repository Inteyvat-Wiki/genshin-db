						731050805
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731050805,
					"content": "うーん…知り合いとは言えないわね。ただ、彼女は変わった宝盗団のメンバーだって話を聞いたことがあるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050806
					],
					"speakerTitle": "ニルファ"
				},
				{
					"id": 731050806,
					"content": "聞いた話によると、彼女は強盗をするときに被害者に質問をするそうよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050807
					],
					"speakerTitle": "ニルファ"
				},
				{
					"id": 731050807,
					"content": "質問の範囲は文学から元素についてまで、ありとあらゆるものがあって…中には「トンチ」みたいなものもあるんですって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050808
					],
					"speakerTitle": "ニルファ"
				},
				{
					"id": 731050808,
					"content": "ナザムに投げかけられた質問に答えられたら、彼女は奪ったものを返してくれるうえに、シティまで護衛してくれるそうよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050809
					],
					"speakerTitle": "ニルファ"
				},
				{
					"id": 731050809,
					"content": "あいつ、そんなに変わったヤツだったのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050810,
						731050811
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731050810,
					"content": "謎解き大盗賊…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050812
					]
				},
				{
					"id": 731050812,
					"content": "彼女の目的は誰にもわからないの。私が質問の件を知っているのだって、私の先生が野外でナザムに会ったことがあるからよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050813
					],
					"speakerTitle": "ニルファ"
				},
				{
					"id": 731050813,
					"content": "そのときのナザムの質問は、たしか——「空っぽの部屋を一瞬にして満たせるものは？」だったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050814
					],
					"speakerTitle": "ニルファ"
				},
				{
					"id": 731050814,
					"content": "うーん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050815
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731050815,
					"content": "風だ！そうだろ？絶対そうだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050816
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731050816,
					"content": "うーん…蝋燭の光？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050817
					]
				},
				{
					"id": 731050817,
					"content": "私の先生の答えは——「元素力はどこにでも存在する。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050818
					],
					"speakerTitle": "ニルファ"
				},
				{
					"id": 731050818,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050819
					]
				},
				{
					"id": 731050819,
					"content": "いじわるだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050820
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731050820,
					"content": "ふふっ…とにかく、ナザムは私の先生をシティまで送り届け、丁重に別れを告げたそうよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050821
					],
					"speakerTitle": "ニルファ"
				},
				{
					"id": 731050821,
					"content": "彼女がアラニと一緒にいるのなら、あまり心配する必要はないかもしれないわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050822
					],
					"speakerTitle": "ニルファ"
				},
				{
					"id": 731050822,
					"content": "でも、ずっとそこにいるわけにもいかないわ。どうにかして論文の問題を解決してあげないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ニルファ"
				},
				{
					"id": 731050811,
					"content": "彼女は何がしたいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050812
					]
				}
			]
		},
