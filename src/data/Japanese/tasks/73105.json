			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"ニルファ",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731050101,
					"content": "アラニ…どこに行っちゃったの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050102
					],
					"speakerTitle": "ニルファ"
				},
				{
					"id": 731050102,
					"content": "アラニ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050103
					]
				},
				{
					"id": 731050103,
					"content": "うーん…あっ！その名前…覚えてるぞ！いつも論文を書いてるあのお姉さんだろ？海祇島で会ったぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731050104,
					"content": "そういえば、教令院から取材にきたって言ってたな。今頃は帰ってきてるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731050105,
					"content": "でも、かなり焦ってるみたいだ…なにがあったか聞いてみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731050106,
					"content": "もしアラニが教令院に戻ってるなら、挨拶しに行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731050107,
					"content": "こんにちは。アラニについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050108
					]
				},
				{
					"id": 731050108,
					"content": "あなた、もしかして冒険者協会から来た冒険者！？アラニの居場所がわかったの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050109
					],
					"speakerTitle": "ニルファ"
				},
				{
					"id": 731050109,
					"content": "ごめんなさい。何度も催促してしまっているのはわかってるんだけど、本当に彼女のことが心配で…私…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050110
					],
					"speakerTitle": "ニルファ"
				},
				{
					"id": 731050110,
					"content": "お、おい、ちょっと落ち着いてくれ。オイラたちは冒険者協会から来た冒険者じゃない、ただの通りすがりだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731050111,
					"content": "#その…{M#君}{F#あなた}は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050112
					]
				},
				{
					"id": 731050112,
					"content": "えっ、冒険者じゃないの？ごめんなさい、協会から何の返事もないから、つい気が急いてしまったみたい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050149
					],
					"speakerTitle": "ニルファ"
				},
				{
					"id": 731050149,
					"content": "これまでにアラニと経験したことを話した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731050113
					]
				},
				{
					"id": 731050113,
					"content": "あなたが、アラニの言っていた旅人なのね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050114
					],
					"speakerTitle": "ニルファ"
				},
				{
					"id": 731050114,
					"content": "私はニルファ、教令院の学者よ…言わなくても、見た目でわかったかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050115
					],
					"speakerTitle": "ニルファ"
				},
				{
					"id": 731050115,
					"content": "学者といっても、最近は生徒の研究の指導をするのに時間を割いているんだけどね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050116
					],
					"speakerTitle": "ニルファ"
				},
				{
					"id": 731050116,
					"content": "アラニは私の生徒の一人なの。あの子は、ずっと論文に悩まされていたのよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050117
					],
					"speakerTitle": "ニルファ"
				},
				{
					"id": 731050117,
					"content": "#{M#君}{F#あなた}がアラニの言ってた先生なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050118
					]
				},
				{
					"id": 731050118,
					"content": "アラニさんは、自分が書いた論文のほとんどが先生に否定されたから、書き直すことになったって言ってたけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731050119,
					"content": "いや、今はそんなことを言ってる場合じゃないな！それで、アラニさんはどうしたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731050120,
					"content": "あの子…行方不明になったの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050121
					],
					"speakerTitle": "ニルファ"
				},
				{
					"id": 731050121,
					"content": "この前、海祇島の民俗文化に関する論文を持って、稲妻から帰ってきたんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050122,
						731050123
					],
					"speakerTitle": "ニルファ"
				},
				{
					"id": 731050122,
					"content": "アラニは真面目に研究してたから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050124
					]
				},
				{
					"id": 731050124,
					"content": "わかってるわ。彼女の論文は完璧だったし、あらゆる面において高い水準と言えるものだった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050125
					],
					"speakerTitle": "ニルファ"
				},
				{
					"id": 731050125,
					"content": "でも…でも、彼女は帰ってくるのが遅すぎた！以前、前もって私に初稿を送るよう伝えたのに、ずっと連絡がなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050126
					],
					"speakerTitle": "ニルファ"
				},
				{
					"id": 731050126,
					"content": "アラニが完成した論文を持って帰ってきたときには、すでに別の人が彼女と同じ研究内容の論文を提出して、初回判定を通過した後だったのよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050127
					],
					"speakerTitle": "ニルファ"
				},
				{
					"id": 731050127,
					"content": "私も何とかしようと必死になって頑張ったんだけど、結局、彼女の論文は却下されてしまって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050128
					],
					"speakerTitle": "ニルファ"
				},
				{
					"id": 731050128,
					"content": "そんなことって…だって、アラニさんはずいぶん前から取材してたはずだろ？なんでそんなに時間が掛かったんだ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050129
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731050129,
					"content": "待てよ、稲妻といえば…まさか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050130
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731050130,
					"content": "鎖国令？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050131
					]
				},
				{
					"id": 731050131,
					"content": "そんな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050132
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731050132,
					"content": "その結果を、どう伝えたらいいのかわからなくて…何日か時間を置いてから、遠回しに伝えようと思っていたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050133
					],
					"speakerTitle": "ニルファ"
				},
				{
					"id": 731050133,
					"content": "それなのに、どこかの口の軽い誰かが、その結果を彼女に伝えてしまったのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050134
					],
					"speakerTitle": "ニルファ"
				},
				{
					"id": 731050134,
					"content": "そして、彼女は姿を消した…教令院の隅から隅まで探しても、どこにもいなくて…冒険者協会に依頼を出すしかなかったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050135
					],
					"speakerTitle": "ニルファ"
				},
				{
					"id": 731050135,
					"content": "だけど依頼を受けた冒険者も、とある場所でアラニのノートを見つけただけで、本人は見つけられなかったらしいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050136
					],
					"speakerTitle": "ニルファ"
				},
				{
					"id": 731050136,
					"content": "彼らは今もアラニの行方を追っているはずよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050137
					],
					"speakerTitle": "ニルファ"
				},
				{
					"id": 731050137,
					"content": "もう、どうすればいいの…うう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050138,
						731050140
					],
					"speakerTitle": "ニルファ"
				},
				{
					"id": 731050138,
					"content": "#{M#俺}{F#私}もアラニを探す。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050139
					]
				},
				{
					"id": 731050139,
					"content": "おう、オイラたちも手伝うぞ！まずは…そのノートを見つけた場所に行ってみよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050142
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731050142,
					"content": "手伝ってくれるの？ありがとう！本当にありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050143
					],
					"speakerTitle": "ニルファ"
				},
				{
					"id": 731050143,
					"content": "今すぐノートが見つかった場所を地図にマークするわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050144
					],
					"speakerTitle": "ニルファ"
				},
				{
					"id": 731050144,
					"content": "あっ、あと報酬については…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050145,
						731050146
					],
					"speakerTitle": "ニルファ"
				},
				{
					"id": 731050145,
					"content": "その話は後にしよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050147
					]
				},
				{
					"id": 731050147,
					"content": "そう？それじゃ、お願いね。私はここで冒険者協会からの知らせを待ってるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050148
					],
					"speakerTitle": "ニルファ"
				},
				{
					"id": 731050148,
					"content": "アラニ、どうか無事でいて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ニルファ"
				},
				{
					"id": 731050146,
					"content": "アラニに払ってもらう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050147
					]
				},
				{
					"id": 731050140,
					"content": "ノートが見つかった場所は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050141
					]
				},
				{
					"id": 731050141,
					"content": "オイラたちもアラニさんを探すぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050142
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731050123,
					"content": "アラニは一生懸命研究してた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050124
					]
				}
			]
		},
		{
			"id": 7310505,
