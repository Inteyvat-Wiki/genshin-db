					"ニルファ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731053001,
					"content": "アラニ、どうか無事でいて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053002,
						731053005
					],
					"speakerTitle": "ニルファ"
				},
				{
					"id": 731053002,
					"content": "アラニは教令院でどうだったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731053003
					]
				},
				{
					"id": 731053003,
					"content": "アラニは勤勉な子だったわ。たまに…変なところに固執しすぎるきらいがあったけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053004
					],
					"speakerTitle": "ニルファ"
				},
				{
					"id": 731053004,
					"content": "でも、彼女は間違いなく優秀な生徒よ。将来は立派な学者になれると信じてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ニルファ"
				},
				{
					"id": 731053005,
					"content": "教令院は論文の合格率が低いの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731053006
					]
				},
				{
					"id": 731053006,
					"content": "正直なところ、その通りね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053007
					],
					"speakerTitle": "ニルファ"
				},
				{
					"id": 731053007,
					"content": "論文の審査は複雑なの。自分の研究方針や文献の充実を考える以外に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053008
					],
					"speakerTitle": "ニルファ"
				},
				{
					"id": 731053008,
					"content": "同じテーマの論文の数や、研究課題が他の人と被っていないか意識しておく必要があるし、研究を始めてからも、色々な困難に直面する…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053009
					],
					"speakerTitle": "ニルファ"
				},
				{
					"id": 731053009,
					"content": "でも、アラニも運が悪すぎるわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ニルファ"
				}
			]
		},
		{
			"id": 7310531,
			"completionStepIds": [],
