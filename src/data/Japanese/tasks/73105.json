					"ナザム"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731053101,
					"content": "他に何かあるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053102,
						731053108
					],
					"speakerTitle": "ナザム"
				},
				{
					"id": 731053102,
					"content": "どうして彼女に…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731053103
					]
				},
				{
					"id": 731053103,
					"content": "アラニに「優しい」の？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053104
					],
					"speakerTitle": "ナザム"
				},
				{
					"id": 731053104,
					"content": "何か誤解しているようだが…単純な話だ。まず、アラニはアタシに金を払った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053105
					],
					"speakerTitle": "ナザム"
				},
				{
					"id": 731053105,
					"content": "そして、アタシは金を盗っても人に危害を加えることはしない。もしアラニを荒野に置き去りにしたりしたら、アタシの評判が悪くなる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053106
					],
					"speakerTitle": "ナザム"
				},
				{
					"id": 731053106,
					"content": "最後に、彼女は学問のある人間で、輝かしい未来がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053107
					],
					"speakerTitle": "ナザム"
				},
				{
					"id": 731053107,
					"content": "彼女の役に立てば、この泥まみれの宝盗団にいるアタシも…少しは恩恵を受けられるかもしれないだろ？ふん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ナザム"
				},
				{
					"id": 731053108,
					"content": "いくら貰ったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731053109
					]
				},
				{
					"id": 731053109,
					"content": "少なくない額だ。誰かのために「肥料」を作って稼いだ金だと言っていたが…アタシには理解できないし、興味もない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053110
					],
					"speakerTitle": "ナザム"
				},
				{
					"id": 731053110,
					"content": "いずれにしても、金を受け取ったからには彼女の頼みを聞く。ほら、単純な話だろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ナザム"
				}
			]
		},
