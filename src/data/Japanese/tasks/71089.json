				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"瑾武"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710890201,
					"content": "瑾武さん、これを見つけたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710890202,
					"content": "分かった、分かったから落ち着け。何を見つけたんだ？志璇の居場所と関係あるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890203
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710890203,
					"content": "彼女が残した手紙。層岩巨淵の深部に行ったと思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710890204
					]
				},
				{
					"id": 710890204,
					"content": "…感謝する。内容を確認させてもらうぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890205
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710890205,
					"content": "瑾武はその手紙を真剣に読んだ。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710890206
					]
				},
				{
					"id": 710890206,
					"content": "この子ったら…あたしはこんな壮大な問題考えたことすらないから、彼女の選択に口出しできない。でも、もしかしたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890207
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710890207,
					"content": "もしかしたら、あたしはまだ彼女の発見と考えを尊重できていなかったのかもしれない",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890208
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710890208,
					"content": "彼女の地図がなければ、その後の調査は極めて困難だっただろう…でも、私は彼女を気遣うばかりで、彼女の努力や苦労に目を向けてあげられなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890209
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710890209,
					"content": "彼女はあたしたち鉱夫とは端から違っていた。なぜそこに気付かなかったのだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890210
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710890210,
					"content": "彼女はただ、忘れられたくないだけ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710890211
					]
				},
				{
					"id": 710890211,
					"content": "神のご高配を受けていないあたしら一般人はみんなそんな感じよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890212
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710890212,
					"content": "…それでも、彼女ほどの執着を持つ人はいなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890213
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710890213,
					"content": "しかし、あたしは夢見ることをあきらめた…平凡な毎日に慣れきってしまっている自分に気づくと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890214
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710890214,
					"content": "志璇のような若者にあれこれ言う権利はもうない気がする…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑾武"
				}
			]
		}
	]
}