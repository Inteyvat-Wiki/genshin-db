					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710890101,
					"content": "うーん…ずいぶんと長い手紙だな。志璇が残したのものみたいだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710890102,
					"content": "間違いない、これは志璇の手紙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710890103
					]
				},
				{
					"id": 710890103,
					"content": "もう…いったいどこに行ったんだ。とりあえずいったん戻って瑾武に伝えよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7108902,
			"completionStepIds": [
				7108903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7108903",
							"2"
