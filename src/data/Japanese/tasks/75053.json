						750530204
					],
					"speakerTitle": "ムエプ"
				},
				{
					"id": 750530204,
					"content": "竜たちが、戻ってきた後、<color=#00E1FFFF>真ん中にいたやつ</color>がどれだったか、を当てればいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530207,
						750530205
					],
					"speakerTitle": "ムエプ"
				},
				{
					"id": 750530207,
