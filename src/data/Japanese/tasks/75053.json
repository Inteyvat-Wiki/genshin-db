			"dialogs": [
				{
					"id": 750530101,
					"content": "よう、異邦人、なかなか、いい目してるな…「サウリアンシャッフル」、やってみないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530102
					],
					"speakerTitle": "ムエプ"
				},
				{
					"id": 750530102,
					"content": "視力を、鍛えられるし…報酬もあるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530103
					],
					"speakerTitle": "ムエプ"
				},
				{
					"id": 750530103,
					"content": "すごく簡単な紹介だな…なにも言ってないのと同じじゃんかよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750530104,
					"content": "君たちが、やってみるというなら…詳しく、説明しよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530105
					],
					"speakerTitle": "ムエプ"
				},
				{
					"id": 750530105,
					"content": "じゃあ、やってみる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750530106
					]
				},
				{
					"id": 750530106,
					"content": "三匹の、クク竜が…一斉に飛び立つが…真ん中の、竜の動きを、よく観察するんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530107
					],
					"speakerTitle": "ムエプ"
				},
				{
					"id": 750530107,
					"content": "竜たちが、戻ってきた後…<color=#00E1FFFF>真ん中にいた竜</color>がどれか…当てられたら、成功だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530108
					],
					"speakerTitle": "ムエプ"
				},
				{
					"id": 750530108,
					"content": "つまり、三匹は空中で位置を変えるけど、真ん中にいたやつが分かればいいってことだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750530109,
					"content": "その通りだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530110
					],
					"speakerTitle": "ムエプ"
				},
				{
					"id": 750530110,
					"content": "視力が鍛えられるっていうのも納得だぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750530111,
					"content": "とりあえず…簡単なのを…一度、やってみるかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530112
					],
					"speakerTitle": "ムエプ"
				},
				{
					"id": 750530112,
					"content": "それで、問題なければ、正式に…参加したらいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530113
					],
					"speakerTitle": "ムエプ"
				},
				{
					"id": 750530113,
					"content": "挑戦に、成功すれば…報酬は、君のものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530114,
						750530116
					],
					"speakerTitle": "ムエプ"
				},
				{
					"id": 750530114,
					"content": "他に用事があるから、また後で。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750530115
					]
				},
				{
					"id": 750530115,
					"content": "ああ、構わない。私はずっと…ここにいるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ムエプ"
				},
				{
					"id": 750530116,
					"content": "試してみる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750530117
					]
				},
				{
					"id": 750530117,
					"content": "準備できたら…的を…叩いて…始めてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ムエプ"
				}
			]
		},
