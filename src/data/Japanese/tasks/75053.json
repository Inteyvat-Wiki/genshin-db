			"dialogs": [
				{
					"id": 750530301,
					"content": "もう報酬は、ない。だから、もちろん「サウリアンシャッフル」挑戦は、これでおしまいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530302
					],
					"speakerTitle": "ムエプ"
				},
				{
					"id": 750530302,
					"content": "もしかして、他に聞きたい、ことでもあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530303,
						750530307,
						750530311
					],
					"speakerTitle": "ムエプ"
				},
				{
					"id": 750530303,
					"content": "「サウリアンシャッフル」について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750530304
					]
				},
				{
					"id": 750530304,
					"content": "あれは…遥か昔から…部族に伝わる話でな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530305
					],
					"speakerTitle": "ムエプ"
				},
				{
					"id": 750530305,
					"content": "「花翼の集」の民にとって、視力はとても、重要なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530306
					],
					"speakerTitle": "ムエプ"
				},
				{
					"id": 750530306,
					"content": "私の、世代になって…私が主催する、ように…なった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ムエプ"
				},
				{
					"id": 750530307,
					"content": "話し方がたどたどしいけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750530308
					]
				},
				{
					"id": 750530308,
					"content": "昔…高い、ところから…落ちて…怪我をしたんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530309
					],
					"speakerTitle": "ムエプ"
				},
				{
					"id": 750530309,
					"content": "喉、胸…の怪我で…うまく、話せなく…なった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530310
					],
					"speakerTitle": "ムエプ"
				},
				{
					"id": 750530310,
					"content": "だが、今は…不幸だなんて…思ってない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ムエプ"
				},
				{
					"id": 750530311,
					"content": "特にないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750530312
					]
				},
				{
					"id": 750530312,
					"content": "君に祝福を…じゃあな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ムエプ"
				}
			]
