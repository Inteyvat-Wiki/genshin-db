			},
			"dialogs": [
				{
					"id": 745230401,
					"content": "風に乗って…潮の気、遠き商船の木の香り、そして…懐かしい友の気配を感じる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230402
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 745230402,
					"content": "#{NICKNAME}、変わりないでござるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230403,
						745230404
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 745230403,
					"content": "万葉、久しぶりだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230405
					]
				},
				{
					"id": 745230405,
					"content": "「南十字」船隊が補給のため稲妻に停泊しておってな。せっかくの帰郷ゆえ、方々を巡り、故郷の景色をいま一度目に焼き付け、吹く風の音に耳を澄まそうとしていたところでござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230406
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 745230406,
					"content": "離島の風は、どこよりも騒がしい…別れと再会、希望と迷いが入り混じり…多くの物語を運んでくる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230407,
						745230408
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 745230407,
					"content": "写真を撮らせてくれる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230409
					]
				},
				{
					"id": 745230409,
					"content": "ふふ、万物には形があるもの…風もまた然り。されど風の姿というものは、木の葉が舞い、波が立ち、あるいは旅人の衣がはためいた、その一瞬にしか見えぬもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230410
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 745230410,
					"content": "拙者の姿を通して、「風の形」を捉えてもらえれば幸いでござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230411,
						745230412
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 745230411,
					"content": "じゃあ、始めるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230413
					]
				},
				{
					"id": 745230413,
					"content": "うむ、お主の手で、この刹那の詩を集めるがよい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 745230412,
					"content": "さっきみたいに、風を感じててね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230413
					]
				},
				{
					"id": 745230408,
					"content": "#{M#俺}{F#私}もこの風を残したいんだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230409
					]
				},
				{
					"id": 745230404,
					"content": "どうしてここに？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230405
					]
				}
			]
		}
	]
