			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"「寝子」",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721640101,
					"content": "にゃ…あの箱やはり使えるにゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640102
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 721640102,
					"content": "主らか。あの「賽銭箱」、やはり役に立っておるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640103
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 721640103,
					"content": "主らがあれを修理してから、緑っぽい人間が二人神社に来たにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640104
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 721640104,
					"content": "お金を投げ入れるだけでにゃく、あの高くて緑色の人間はうちが話せるのを見るや否や驚いていたにゃ。人間は実に騒ぐのが上手にゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640105
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 721640105,
					"content": "「賽銭箱」は本当にいいものにゃ。もう一つ修理したら、もっと人が増えるのではにゃいか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640106
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 721640106,
					"content": "それはちょっと違う…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640107
					]
				},
				{
					"id": 721640107,
					"content": "そうか。人間の物事は、実に面倒だにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640108
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 721640108,
					"content": "た、たぶん神社の環境と関係あると思うぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721640109,
					"content": "うちの神社がどうしたにゃ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640110,
						721640111
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 721640110,
					"content": "ちょっと汚い…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640112
					]
				},
				{
					"id": 721640112,
					"content": "おや、そうにゃのか？だけど、あい子たちは落ち葉で遊ぶのが好きにゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640113
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 721640113,
					"content": "でもよく考えたら、響もいつも先っぽがトゲトゲした棒で葉っぱを集めてた。響がそれをやるなら、きっと正しいことにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640114,
						721640115
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 721640114,
					"content": "どこを掃除すればいいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640116
					]
				},
				{
					"id": 721640116,
					"content": "うちが人間のこだわりを理解できるわけにゃいだろ。うぅ…でも響なら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640117
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 721640117,
					"content": "響はよく日が昇る前にその棒を地面に振り回してたにゃ。うちはそれを追いかけるのが好きだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640118
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 721640118,
					"content": "でも今やうちは「代理宮司」、そんなことをしてはいけにゃい。うちはそこらのやつとは違う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640119
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 721640119,
					"content": "でも、響は地面に水を撒いていた。水は良くないものにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640120
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 721640120,
					"content": "時々百目鬼がやって来て、交差した鉄でカサカサやると、枝や葉っぱが落ちていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640121,
						721640123
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 721640121,
					"content": "「百目鬼」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640122
					]
				},
				{
					"id": 721640122,
					"content": "すごく背が高く、声が大きい人間にゃ。よく響と一緒に遊んでいた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640125
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 721640125,
					"content": "ふん！あいつはうちの大好きな枝を毎回切る、嫌なやつにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640126
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 721640126,
					"content": "なんて言うか…「掃除」とか「整理」って言ったほうが正しいかもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721640127,
					"content": "地面を掃いたり、水を撒いたり、枝を切ったり…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721640128,
					"content": "身近な仕事ばかりだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640129
					]
				},
				{
					"id": 721640129,
					"content": "これが「掃除」か？なるほど、主らに任せたにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640130
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 721640130,
					"content": "そうだ、カサカサはやらなくてもいいにゃ。今の枝はとても気に入っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640131
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 721640131,
					"content": "棒で落ち葉を集めたり、水を撒いたりするだけでいい。分かったかにゃ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640132,
						721640133
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 721640132,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640144
					]
				},
				{
					"id": 721640144,
					"content": "にゃにゃ、この仕事は響に託されたものにゃ。うちだけが全うできる大事な仕事にゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 721640133,
					"content": "そうだ、「響」は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640134
					]
				},
				{
					"id": 721640134,
					"content": "響は他の誰でもない、浅瀬神社の宮司にゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640135
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 721640135,
					"content": "#じゃあ{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYSECOND|INFO_FEMALE_PRONOUN_GIRLSECOND]}の名前は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640136
					]
				},
				{
					"id": 721640136,
					"content": "うちは「寝子」、響がつけてくれた名前にゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640137
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 721640137,
					"content": "普段は、響が神社に来た人をもてなす。うちが神社の世話をすることはなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640138
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 721640138,
					"content": "うちは昔、名前も「代理宮司」という肩書きもなかった。寝たいときに寝て、遊びたいときに遊んでいたにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640139
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 721640139,
					"content": "それで響が、うちはよく寝るから、「寝子」と呼ぶことにしたそうにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640140
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 721640140,
