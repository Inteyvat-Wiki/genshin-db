						],
						"stepId": 7402303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"サルサ",
					"ウーブ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740230101,
					"content": "ふぅー、これで見た目が良くなったぞ。サルサが見たら、オイラたちのことを誇りに思ってくれるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740230102,
					"content": "ご、強盗、強盗だ——！こんな真っ昼間から強盗が現れるなんて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230103
					],
					"speakerTitle": "ウーブ"
				},
				{
					"id": 740230103,
					"content": "なに！？どこに強盗がいるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740230104,
					"content": "お前たち強盗コンビのことだ！俺の大作を壊すだけでなく、宝箱まで持っていきやがって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230105,
						740230107
					],
					"speakerTitle": "ウーブ"
				},
				{
					"id": 740230105,
					"content": "本当に協会の人の仕業だったんだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230106
					]
				},
				{
					"id": 740230106,
					"content": "俺の仕業？俺が何をしたっていうんだ、言ってみろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230109
					],
					"speakerTitle": "ウーブ"
				},
				{
					"id": 740230109,
					"content": "つまり、この品のないものはおまえの「大作」ってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740230110,
					"content": "失礼な！品のないものとはなんだ。お前らはインスタレーション芸術が分からないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230111
					],
					"speakerTitle": "ウーブ"
				},
				{
					"id": 740230111,
					"content": "フォンテーヌの美的センスの教育は、まだ道半ばということか…ん？でもお前ら、フォンテーヌの人っぽく見えないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230112
					],
					"speakerTitle": "ウーブ"
				},
				{
					"id": 740230112,
					"content": "#オイラたちはフォンテーヌ人じゃないぞ。オイラはパイモン、こいつは{NICKNAME}。おまえと同じ冒険者協会のメンバーだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230113,
						740230115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740230113,
					"content": "そう、邪悪な組織のメンバー…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230114
					]
				},
				{
					"id": 740230114,
					"content": "えっと、でも制服は着てないんだし、邪悪な緑野郎ではないだろ。良かったじゃんか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740230117,
					"content": "俺は冒険者兼インスタレーション芸術家のウーブだ。お前らがふざけたことを言ってるのを見るに、普段からこうやっておかしなことをしてるんだろうな…今回のことは大目に見てやる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230118
					],
					"speakerTitle": "ウーブ"
				},
				{
					"id": 740230118,
					"content": "えっと、本当のことを言うと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740230119,
					"content": "なんだ？感謝の言葉を言うなら今言え、俺は作品を直さないといけないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230120
					],
					"speakerTitle": "ウーブ"
				},
				{
					"id": 740230120,
					"content": "感謝の言葉なんて一文字たりともないから！怒りの言葉ならいっぱいあるけど！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230121
					],
					"speakerTitle": "サルサ"
				},
				{
					"id": 740230121,
					"content": "サルサ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740230122,
					"content": "おチビちゃん、怖がらないで、私がいるから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230123
					],
					"speakerTitle": "サルサ"
				},
				{
					"id": 740230123,
					"content": "邪悪な緑野郎、あんたが設置したワナは全部私たちが破壊したわ！こんなよこしまなもので美しいフォンテーヌを汚そうとする企みは、さっさと諦めなさい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230124
					],
					"speakerTitle": "サルサ"
				},
				{
					"id": 740230124,
					"content": "なんの企みだって？待て、全部破壊したって…お前ら、俺の芸術作品を全部壊したのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230125
					],
					"speakerTitle": "ウーブ"
				},
				{
					"id": 740230125,
					"content": "こ、壊したわけじゃないんだ…すこーし配置を変えただけで…その、周りの景色ともっと合うようにしようと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740230126,
					"content": "お、お前らみたいな凡人のガキンチョに、芸術の何が分かるってんだ！俺のインスタレーション芸術を…俺の作品を…こんなしょっぱいものに変えやがって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230127
					],
					"speakerTitle": "ウーブ"
				},
				{
					"id": 740230127,
					"content": "でも、これって本当に芸術なのか？確かにオイラはそういうのあんまわかんないけど…でも、見ていて変な感じがするものを芸術って言っていいのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740230128,
					"content": "もちろんだとも、芸術の境界とは芸術家が決めるものだ。芸術家が創作した作品は、自ずと芸術と呼ばれる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230129
					],
					"speakerTitle": "ウーブ"
				},
				{
					"id": 740230129,
					"content": "で、その芸術家って？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230130
					],
					"speakerTitle": "サルサ"
				},
				{
					"id": 740230130,
					"content": "もちろん、この俺さ！偉大なインスタレーション芸術家、ウーブのことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230131
					],
					"speakerTitle": "ウーブ"
				},
				{
					"id": 740230131,
					"content": "それなら、「邪悪な組織を打ち倒してフォンテーヌの未来を守る芸術家同盟」の創始者として、私はあれを芸術として認めない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230132
					],
					"speakerTitle": "サルサ"
				},
				{
					"id": 740230132,
					"content": "う、打ち倒し…なんだって…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230133,
						740230135
					],
					"speakerTitle": "ウーブ"
				},
				{
					"id": 740230133,
					"content": "邪悪な組織を打ち倒して。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230134
					]
				},
				{
					"id": 740230134,
					"content": "だいたいが…えーっと、インスタレーション芸術？で景色を破壊する冒険者協会のことを指してるんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230136
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740230136,
					"content": "何の冗談のつもりだ。そのなんとか同盟も聞いたことないし、そこのお嬢ちゃんは何をもって俺の作品を芸術じゃないって言うんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230137
					],
					"speakerTitle": "ウーブ"
				},
				{
					"id": 740230137,
					"content": "私は画家、つまり芸術家なの。だから、言う資格もある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230138
					],
					"speakerTitle": "サルサ"
				},
				{
					"id": 740230138,
					"content": "は？お嬢ちゃん、芸術家はおままごとじゃないぞ。なりたいと思って、なれるもんじゃない。作品があって、それを人々に認められないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230139
					],
					"speakerTitle": "ウーブ"
				},
				{
					"id": 740230139,
					"content": "じゃあ、あんたは何を認められたの？あんたの作品——あのインスタレーション芸術…あの邪悪なワナ？あれのために拍手する人がいるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230140
					],
					"speakerTitle": "サルサ"
				},
				{
					"id": 740230140,
					"content": "凡人が多すぎて、その中の真髄を理解してもらえないんだ。本物の芸術は常に孤高なものなんだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230141,
						740230143
					],
					"speakerTitle": "ウーブ"
				},
				{
					"id": 740230141,
					"content": "まずはみんなが分かる芸術から始めよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230142
					]
				},
				{
					"id": 740230142,
					"content": "そうだぞ。誰もわからなかったら、先進的すぎてるっていうか、そもそも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230145
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740230145,
					"content": "そ、そんなはずがない…俺の作品は完璧だ、問題などあるはずがない。お前らと…そして他のやつらが分かってないだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230146
					],
					"speakerTitle": "ウーブ"
				},
				{
					"id": 740230146,
					"content": "くそっ、俺は諦めないぞ！今に見ておけ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230147
					],
					"speakerTitle": "ウーブ"
				},
				{
					"id": 740230147,
					"content": "ウーブは足をもつれさせながら去っていった…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740230148
					]
				},
				{
					"id": 740230148,
					"content": "本当に諦めの悪い敵ね。でも私もくじけない！フォンテーヌの芸術の未来は私にかかってるんだもの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230149
					],
					"speakerTitle": "サルサ"
				},
				{
					"id": 740230149,
					"content": "みんな、頑張る目標が出来た。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230150
					]
				},
				{
					"id": 740230150,
					"content": "これは良いことなのか？…えっと、たぶん良いことだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740230143,
					"content": "つまり、誰も理解できない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230144
					]
				},
				{
					"id": 740230144,
					"content": "どう解釈しても、失敗作っぽく聞こえるな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230145
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740230135,
					"content": "#どうやら、{M#君}{F#あなた}を倒すべきみたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230136
					]
				},
				{
					"id": 740230115,
					"content": "仲間だね、こんにちは。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230116
					]
				},
				{
					"id": 740230116,
					"content": "名前すら知らないやつを仲間とは呼べないと思うぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740230107,
					"content": "あっ、邪悪な緑野郎だ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230108
					]
				},
				{
					"id": 740230108,
					"content": "はぁ、しかも変なことを言ってくる強盗だとは…今日は厄日か！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230109
					],
					"speakerTitle": "ウーブ"
				}
			]
		},
		{
