			"dialogs": [
				{
					"id": 740230201,
					"content": "うーん、やっぱりここに違和感があるぞ…前に見た品のないものとどこか似てるような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230202
