					"content": "#{NICKNAME}{M#お兄ちゃん}{F#お姉ちゃん}とおチビちゃん、こんにちは！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230302,
						740230304
					],
					"speakerTitle": "サルサ"
				},
				{
					"id": 740230302,
					"content": "同盟の新しいメンバーは見つかった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230303
					]
				},
				{
