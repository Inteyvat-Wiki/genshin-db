				},
				{
					"id": 740230202,
					"content": "<color=#00E1FFFF>なんで水元素の石碑が地面の中に埋まってるんだ</color>？意味がわからないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740230203,
					"content": "#{NICKNAME}、オイラたちで置き直してみようぜ？この前、サルサが教えてくれたみたいに！",
					"roleType": "TALK_ROLE_NPC",
