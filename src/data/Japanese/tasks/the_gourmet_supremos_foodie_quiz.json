				"points": []
			},
			"dialogs": [
				{
					"id": 220220201,
					"content": "モンドの「北地のリンゴと肉の煮込み」ね、旭東のやつ、また変なこと書いてる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220202
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 220220202,
					"content": "「バターは少し高い、獣肉は保存が難しい。生地を捏ねてコシを作り、容器の中に寝かせる。青果と調味料を加えれば、肉の食感がする。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220203
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 220220203,
					"content": "何を書いてるの。バターは別に高くないし、獣肉なら新鮮なものを買えばいいじゃない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220204
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 220220204,
					"content": "まあいいわ…旅人、私が聞きたかったのは、この「北地のリンゴと肉の煮込み」に必要な食材のうち、リンゴ、バターと獣肉以外のもう一つの食材は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220205,
						220220206,
						220220208,
						220220209
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 220220205,
					"content": "杏仁。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220210
					]
				},
				{
					"id": 220220210,
					"content": "あら…そうだったの？メモしておくわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 220220206,
					"content": "コショウ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220207
					]
				},
				{
					"id": 220220207,
					"content": "あら…そうだったの？メモしておくわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 220220208,
					"content": "絶雲の唐辛子。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220210
					]
				},
				{
					"id": 220220209,
					"content": "ハム。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220210
					]
				}
			]
		},
