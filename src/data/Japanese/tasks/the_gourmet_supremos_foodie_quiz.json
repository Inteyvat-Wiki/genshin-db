					"パルヴァネ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220220101,
					"content": "このレシピはこう組み合わせるべき…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220102
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 220220102,
					"content": "何してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220103
					]
				},
				{
					"id": 220220103,
					"content": "レシピの整理をしているの。うーん…全部はまだ覚えきれていないわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220104,
						220220106
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 220220104,
					"content": "直接旭東に聞いたら？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220105
					]
				},
				{
					"id": 220220105,
					"content": "旭東…私がレシピを覚えられないのも、彼がいつも研究している「創作料理」のせいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220109
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 220220109,
					"content": "彼が新しいレシピを手に入れた時、そのレシピの内容に従って料理するのはせいぜい一回か二回程度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220110
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 220220110,
					"content": "その後は、いろんな方法を使ってレシピを「アレンジ」し始めるのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220111,
						220220113
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 220220111,
					"content": "彼はどうしてそんなことするの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220112
					]
				},
				{
					"id": 220220112,
					"content": "本人曰く、料理の材料費を減らすためだとかなんとか…そんなことをしている本当の理由は、私にもよくわからない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220118
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 220220118,
					"content": "いずれにせよ、結果だけを見ると、彼のアレンジは上手くいってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220119
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 220220119,
					"content": "味はオリジナル版とほとんど同じ、だけど、材料費は驚くほど安くなってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220120
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 220220120,
					"content": "一緒に旅をしている理由も、彼のそのとんでもない調理法に興味を持っていたからなの。そして、彼が私を受け入れてくれたのも、私の技術を認めてくれたからだと思うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220121,
						220220123
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 220220121,
					"content": "それで、何を手伝ってほしいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220122
					]
				},
				{
					"id": 220220122,
					"content": "あ…そうだ！旭東のことばかり話してて、大事なことを忘れてしまうところだった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220128
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 220220128,
					"content": "とにかく、旭東は私を毎日のように引っ張り回したの。レシピを修正したり、直接上に書き込みをしたり…中にはレシピの内容をめちゃくちゃにしたものもあった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220129
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 220220129,
					"content": "レシピの元の内容を復元して、副本を保存しておきたいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220130
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 220220130,
					"content": "旅人、もしレシピを覚えていたら、思い出してくれない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220131,
						220220132
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 220220131,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220133
					]
				},
				{
					"id": 220220133,
					"content": "じゃあ、頼んだわ。まず、私はぐちゃぐちゃになったレシピを整理するから、はっきりしないところを修正してくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 220220132,
					"content": "このテイワットの美食家にお任せあれ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220133
					]
				},
				{
					"id": 220220123,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYSECOND|INFO_FEMALE_PRONOUN_GIRLSECOND]}の技術？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220124
					]
				},
				{
					"id": 220220124,
					"content": "以前言ってなかった？私の教令院での研究テーマは「万能調味料」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220125
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 220220125,
					"content": "簡単に説明すると、どんな料理に入れても、その料理が格段に美味しくなるスーパー調味料なの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220126
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 220220126,
					"content": "私が旅をしながら美食に関する資料を集め始めたのも、調味料についてもっと研究するため。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220127
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 220220127,
					"content": "コホン、話し過ぎた。やっぱりレシピについて話そう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220128
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 220220113,
					"content": "具体的にどうやってアレンジするの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220114
					]
				},
				{
					"id": 220220114,
					"content": "うん…彼の目的は、他の料理人たちとは違うの。他の料理人たちは、バリエーションを増やしたり、作った料理をより高く売るためにレシピをアレンジするのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220115
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 220220115,
					"content": "でも、旭東がレシピをアレンジする時は、他とは全く違う方法を使うの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220116
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 220220116,
					"content": "例えば、ジャガイモ…キノコ…と他の安い野菜を使って野菜料理を作ったんだけど、食べてみたら、なんと椒椒鶏の味がしたのよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220117
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 220220117,
					"content": "ジャガイモ、米、ハスの花托、絶雲の唐辛子、練った生地と獣肉で作った簡易版の「仙跳牆」なんて、意外にもオリジナル版と味がほとんど変わらないのよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220118
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 220220106,
					"content": "「全能グルメチーム」でしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220107
					]
				},
				{
					"id": 220220107,
					"content": "その名前を繰り返すのはもうやめて…私の論文にそんな名前を書くなんて御免だわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220108
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 220220108,
					"content": "それに、私がレシピを覚えられないのも、旭東がいつも研究している「創作料理」のせいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220109
					],
					"speakerTitle": "パルヴァネ"
				}
			]
		},
