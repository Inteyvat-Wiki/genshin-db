				"points": []
			},
			"dialogs": [
				{
					"id": 722100401,
					"content": "主ら、あの子らを見つけたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100402
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722100402,
					"content": "見つけた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100403
					]
				},
				{
					"id": 722100403,
					"content": "主ら、どうしていつもうちの話を聞かないにゃ？どうして「飯」のようにいい子にならないにゃ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100404
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722100404,
					"content": "「飯」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100405
					]
				},
				{
					"id": 722100405,
					"content": "たしかに良いものを使って名前をつけてるな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722100406,
					"content": "ニャ、ニャオ…ニャオ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100407
					],
					"speakerTitle": "「八宝」"
				},
				{
					"id": 722100407,
					"content": "ニャオ！ニャー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100408
					],
					"speakerTitle": "「昆布丸」"
				},
				{
					"id": 722100408,
					"content": "うちに口答えするな！今度こそは主らを探しに行かぬ！太陽が昇ってから沈み、月が昇ってからまた太陽が昇るまで、腹を空かせたままでいるといい！そして、自分たちで帰って来い！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100409
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722100409,
					"content": "ニャー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100410
					],
					"speakerTitle": "「昆布丸」"
				},
				{
					"id": 722100410,
					"content": "ふふ、わかればいいにゃ。よしよし、戻って来られてよかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100411
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722100411,
					"content": "主らのおかげにゃ。主らがいなかったら、この子たちは野外で腹を空かせていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100412
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722100412,
					"content": "たぶん自分たちで帰って来られた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100413
					]
				},
				{
					"id": 722100413,
					"content": "とにかく、ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100414
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722100414,
					"content": "気が向いたら、またここに来るにゃ。もしかしたら、また主らに頼むことがあるかもしれにゃい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寝子」"
				}
			]
