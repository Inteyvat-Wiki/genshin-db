					"nextDialogs": [
						722100304
					]
				},
				{
					"id": 722100304,
					"content": "ニャオ？ニャー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100307
					],
					"speakerTitle": "「昆布丸」"
				},
				{
					"id": 722100307,
					"content": "えへへ、やんちゃだけど、最後はおとなしくなったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
