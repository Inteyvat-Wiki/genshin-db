				"points": []
			},
			"dialogs": [
				{
					"id": 722100101,
					"content": "うーん…にゃにゃ、どこに行ったにゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100102
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722100102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100103
					]
				},
				{
					"id": 722100103,
					"content": "主らか。あの子たち、どこに行ったのかわからにゃい。本当に困った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100104
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722100104,
					"content": "外は危険だって何回も教えたはずにゃのに…外には棒を持った毛むくじゃらのものや…丸い水と炎のものもいる…本当に危険にゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100105
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722100105,
					"content": "もしビリビリしたところに行けば、全身の毛が逆立つ。あの感覚を、あの子たちに体験してほしくはにゃい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100106
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722100106,
					"content": "だけどいつもやんちゃな子たちがあちこちを走り回る。連れ戻すのにどれほどの力を費やすか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100107
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722100107,
					"content": "今日も何匹か外に行ってしまったにゃ。心配にゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100108
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722100108,
					"content": "主らも探してほしいにゃ。「昆布丸」と「八宝」を。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100109
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722100109,
					"content": "「昆布丸」って…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100110
					]
				},
				{
					"id": 722100110,
					"content": "いい子にゃ。この代の昆布丸は頭がいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100111
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722100111,
					"content": "「この代」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100112
					]
				},
				{
					"id": 722100112,
					"content": "響が時々口にする言葉にゃ。どんな意味かは知らにゃいが、言っている時の表情から見て、良いものに違いにゃい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100113
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722100113,
					"content": "うちは良いものであの子らに名前をつける。その子たちが大きくなってここを出て行ったら、またその名前をさらに小さい猫につける。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100114
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722100114,
					"content": "「昆布丸」は高い場所で寝るのが好きにゃ。高い場所に行って探すといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100115
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722100115,
					"content": "じゃあ、「八宝」は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100116
					]
				},
				{
					"id": 722100116,
					"content": "賢い子にゃ。魚が好きだから、よく海辺に行って岸に上がった魚を捕る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100117
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722100117,
					"content": "だけど、すごく危険にゃ。水は恐ろしいもの。ずっと昔、「吾輩」という子が水に落ち、危うく命を落としかけた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100118
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722100118,
					"content": "「八宝」は海辺で小魚とカニがないか探してるはずにゃ。塩水のある場所で探すといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100119
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722100119,
					"content": "範囲が広すぎる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100120
					]
				},
				{
					"id": 722100120,
					"content": "とにかく、高い場所、塩水のある場所にゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100121
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722100121,
					"content": "と、とにかく、地図を寝子に見せよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722100122,
					"content": "主ら、察しが悪いにゃ。ほら、ここが高い場所で、ここが塩水のある場所にゃ。きっとこの二つの場所にいるにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100123,
						722100125
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722100123,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100124
					]
				},
				{
					"id": 722100124,
					"content": "それじゃ頼んだにゃ。まったくあの子らは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722100125,
					"content": "猫を捕まえるのは苦手…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100126
					]
				},
				{
					"id": 722100126,
					"content": "大丈夫にゃ。あの子ら人を怖がらない…むしろ、誰かに遊んでもらいたくて、外を走り回ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100127
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722100127,
					"content": "それじゃ頼んだにゃ。まったくあの子らは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寝子」"
				}
			]
		},
