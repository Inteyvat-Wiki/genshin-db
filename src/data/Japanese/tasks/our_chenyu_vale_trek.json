			"trigger": {
				"objectNames": [
					"マリ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711100201,
					"content": "ごきげんよう！あなた方も風景写真コンテストに来たのでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100202
					],
					"speakerTitle": "マリ"
				},
				{
					"id": 711100202,
					"content": "写真機の発祥地であるフォンテーヌから来たカメラマンとして、ひとつアドバイスいたしましょう。写真撮影における真髄中の真髄は、実は写真機にあるのですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100203
					],
					"speakerTitle": "マリ"
				},
				{
					"id": 711100203,
					"content": "そこで、いい人を紹介してあげましょう。私の故郷では、彼が作った写真機は皆に好評で、価格も手頃なんです。私を通せば購入が可能でして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100204
					],
					"speakerTitle": "マリ"
				},
				{
					"id": 711100204,
					"content": "おやおや…そんな興味のなさそうな顔をしないでください。特別に割引してくれるよう頼んであげますから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100205
					],
					"speakerTitle": "マリ"
				},
				{
					"id": 711100205,
					"content": "ああ、ちょっと…逃げないで！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マリ"
				}
			]
		},
