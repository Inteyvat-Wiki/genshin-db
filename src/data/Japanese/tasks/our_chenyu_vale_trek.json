			"dialogs": [
				{
					"id": 711101101,
					"content": "なあ、このペリカンっておまえんちのか？翹英荘の写真を撮るんだけど、一緒に撮ってもいいか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711101102,
					"content": "グルル！グワッグワッ、グルル！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101103
					],
					"speakerTitle": "明鏡"
				},
				{
					"id": 711101103,
					"content": "えっ？なんて言ったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711101104,
					"content": "これはペリカンの言葉で、「いいよいいよ！」って意味なの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101105
					],
					"speakerTitle": "明鏡"
				},
				{
					"id": 711101105,
					"content": "ペリカンの言葉がしゃべれるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711101106
					]
				},
				{
					"id": 711101106,
					"content": "ほんのちょっとだけね…ペリカンたちが食事中にずっと「グルル！グワッグワッ、グルル！」って言ってるのに気づいたから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101107
					],
					"speakerTitle": "明鏡"
				},
				{
					"id": 711101107,
					"content": "きっと嬉しくて「いいねいいね」って言ってるのよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101108
					],
					"speakerTitle": "明鏡"
				},
				{
					"id": 711101108,
					"content": "その後、あたしもこの鳴き方をまねると、ペリカンたちが聞きつけてやって来るの。たぶん食べ物があると思うのね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101109
					],
					"speakerTitle": "明鏡"
				},
				{
					"id": 711101109,
					"content": "写真を撮りたいなら、呼んであげてもいいよ！でも、そろそろあたし家に帰らなきゃいけないんだ。そうじゃなきゃ、いろいろ教えてあげられたんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101110
					],
					"speakerTitle": "明鏡"
				},
				{
					"id": 711101110,
					"content": "自分たちでやってみるから大丈夫だぞ。ありがとな！気をつけて帰るんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711101111,
					"content": "#{NICKNAME}、あっちで試してみようぜ。ペリカンを呼び寄せることができたら、きっとオイラたちの作品も勝算がアップするはずだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
