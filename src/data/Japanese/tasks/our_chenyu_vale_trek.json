			"dialogs": [
				{
					"id": 711100801,
					"content": "えっ…この写真は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100802
					],
					"speakerTitle": "方矩"
				},
				{
					"id": 711100802,
					"content": "どうしたんだ？オイラたちの写真、イマイチだったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100803
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711100803,
					"content": "その逆よ…ここ数日素敵な作品をたくさん見てきたけど、それでもお二人の作品からは新鮮さを感じるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100805
					],
					"speakerTitle": "方矩"
				},
				{
					"id": 711100805,
					"content": "例えばこの翹英荘の写真、ペリカンを入れたことで静かな村に少し活気が添えられ、静と動の対比になっている…本当に趣向を凝らしたアイデアね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100806
					],
					"speakerTitle": "方矩"
				},
				{
					"id": 711100806,
					"content": "私の見立て通りなら、お二人は入選間違いなしよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100807
					],
					"speakerTitle": "方矩"
				},
				{
					"id": 711100807,
					"content": "へへっ！そんなに高い評価をもらえるなんて、ちょっと照れくさいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100808,
						711100810
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711100808,
					"content": "#撮ったのは{M#俺}{F#私}なのに、なんで照れてるの。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100809
					]
				},
				{
					"id": 711100809,
					"content": "おまえの代わりに照れてやってるんだ。謙虚だって知ってるからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100811
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711100811,
					"content": "話を戻すけど、私たちの選考作業は明日の朝までに終わるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100812
					],
					"speakerTitle": "方矩"
				},
				{
					"id": 711100812,
					"content": "明日の朝八時から午後六時まで、入選作品を公開展示する予定なの。場所は合轍駅の外の大通りよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100813
					],
					"speakerTitle": "方矩"
				},
				{
					"id": 711100813,
					"content": "お二人とも、「沈玉の旅」風景写真コンテストに参加してくれてありがとう。忘れずに明日また来てね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100814
					],
					"speakerTitle": "方矩"
				},
				{
					"id": 711100814,
					"content": "おう！最後に賞品をちゃんとゲットしないとな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711100810,
					"content": "#そう言われると{M#俺}{F#私}もなんだか照れくさい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100811
					]
				}
			]
		},
