			"dialogs": [
				{
					"id": 711101001,
					"content": "お二人さん、いらっしゃい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101002
					],
					"speakerTitle": "方矩"
				},
				{
					"id": 711101002,
					"content": "ここに展示されている写真はもう見たかしら？今回の「沈玉の旅」の入選作品は全部で八点で、お二人はその半分を独占していたわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101003
					],
					"speakerTitle": "方矩"
				},
				{
					"id": 711101003,
					"content": "おめでとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101004
					],
					"speakerTitle": "方矩"
				},
				{
					"id": 711101004,
					"content": "おお！すごくないか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101005
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711101005,
					"content": "#{NICKNAME}！だから言ったろ、最終的な結果は四分の四だって！オイラの計算力ってば、ますます冴えわたってきてるぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101006,
						711101007
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711101006,
					"content": "明らかに八分の四だけどね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711101008
					]
				},
				{
					"id": 711101008,
					"content": "ふふっ、昨日の私の見立てと似た感じで、審査員たちはあなたたちのあと二つの作品もとても高く評価しているわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101009
					],
					"speakerTitle": "方矩"
				},
				{
					"id": 711101009,
					"content": "はい、この限定版「沈玉の旅」記念アルバムを受け取ってちょうだい。今回の入選作品がすべて収録してあるわ。あなたたちの貢献を考えれば当然ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101010
					],
					"speakerTitle": "方矩"
				},
				{
					"id": 711101010,
					"content": "これが賞品なのか？すごくきれいだなぁ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101011
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711101011,
					"content": "それと、よければここにあるモラも受け取って。改めてご協力に感謝するわ、個人的な立場からもね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101012
					],
					"speakerTitle": "方矩"
				},
				{
					"id": 711101012,
					"content": "ここは私の故郷であり、あなたたちはその美しい風景を記録し永遠に残してくれた。この写真のおかげで、きっともっとたくさんの人がここを好きになってくれるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101013
					],
					"speakerTitle": "方矩"
				},
				{
					"id": 711101013,
					"content": "お二人とも、本当にありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "方矩"
				},
				{
					"id": 711101007,
					"content": "わあ！パイモンは本当に計算が得意だね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711101008
					]
				}
			]
		},
