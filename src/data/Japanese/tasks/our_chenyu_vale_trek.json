			},
			"dialogs": [
				{
					"id": 711101701,
					"content": "いた！あのフォンテーヌの悪徳商人だ！本当に運が好転し始めたのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101702
					],
					"speakerTitle": "赤井"
				},
				{
					"id": 711101702,
					"content": "すぐに追いかけて捕まえるべきか…いや、でもそれじゃあ、この魅力あふれる沈玉の谷の写真を鑑賞できなくなる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101703
