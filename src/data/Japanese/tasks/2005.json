			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パイモン",
					"大森",
					"悠也",
					"黒澤京之介"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20050101,
					"content": "おかしいぞ、「天領奉行」って将軍の管轄下にあるんだろ。稲妻の治安維持を任されてる。目狩り令もあいつらが執行してるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20050102,
					"content": "なんで自分たちの仲間に手を出してるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20050103,
					"content": "うぅ…わからない…ん？ちょっと待て。あっちでなにか騒ぎが起きてるぞ、行ってみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20050104,
					"content": "今月の御救米、それを渡すかどうか聞いてるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050105
					],
					"speakerTitle": "大森"
				},
				{
					"id": 20050105,
					"content": "俺たちみんなそれを頼りに生きてんだぞ！納得のいく説明をしてもらうまで帰れると思うな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050106
					],
					"speakerTitle": "悠也"
				},
				{
					"id": 20050106,
					"content": "何度も言ったように、俺は御救米なんてものは知らない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050107
					],
					"speakerTitle": "黒澤京之介"
				},
				{
					"id": 20050107,
					"content": "まだ嘘をつくか。命に関わる食料なんだ、お前たち武士に横領されるためのものじゃねぇ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050108
					],
					"speakerTitle": "大森"
				},
				{
					"id": 20050108,
					"content": "武士なら好き勝手できるってのかよ！天領奉行所に行って告発してやる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050109
					],
					"speakerTitle": "悠也"
				},
				{
					"id": 20050109,
					"content": "「御救米」って…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050110
					]
				},
				{
					"id": 20050110,
					"content": "誰だ？黒澤の仲間か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050111
					],
					"speakerTitle": "大森"
				},
				{
					"id": 20050111,
					"content": "いやいや、オイラたちはただの通りすがりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20050112,
					"content": "なんだか騒がしかったから、なにがあったのか見にきたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20050113,
					"content": "そうか。ちょうどよかった、お前たちからも何か言ってやってくれ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050114
					],
					"speakerTitle": "大森"
				},
				{
					"id": 20050114,
					"content": "こいつは黒澤っていう武士で、幕府軍の人間だ。幕府軍はこの近くで御救米を配っていて、こいつがその責任者でな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050115
					],
					"speakerTitle": "大森"
				},
				{
					"id": 20050115,
					"content": "以前はこいつに会えば御救米を分けてくれたのに、急にくれなくなったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050116
					],
					"speakerTitle": "大森"
				},
				{
					"id": 20050116,
					"content": "きっと欲に負けて、食料を横領するつもりなんだよ！その食料がなきゃ、俺たち飢え死にしちまうっていうのに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050117
					],
					"speakerTitle": "大森"
				},
				{
					"id": 20050117,
					"content": "俺たちの気持ちは考えてくれないのか…昔は心優しいお方だと思ってたのに、どうやら他の武士と同じで悪人だったみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050118
					],
					"speakerTitle": "悠也"
				},
				{
					"id": 20050118,
					"content": "どうりで「神の目」も奪われるわけだ。雷電将軍もこんなヤツに国を治める手助けをしてほしくないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050119
					],
					"speakerTitle": "悠也"
				},
				{
					"id": 20050119,
					"content": "こいつが綾華の言ってたやつか。でも、なんで綾華はこんなやつの手助けをオイラたちにさせようとしてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20050120,
					"content": "とりあえずこの黒澤って武士がどう思ってるのか聞いてみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 200502,
			"completionStepIds": [
				200503
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
