			},
			"dialogs": [
				{
					"id": 20050401,
					"content": "あれ、おまえ一人しかいないのか？さっきの二人は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20050402,
					"content": "まだ続けるなら刀を抜くと言ったら二人とも行ったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050403
					],
					"speakerTitle": "黒澤京之介"
				},
				{
					"id": 20050403,
					"content": "やっぱり、こいつは言葉で話すよりも便利だ。もしかすると、俺もこれからは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050404
					],
					"speakerTitle": "黒澤京之介"
				},
				{
					"id": 20050404,
					"content": "そういえば、宝盗団のことはもう調べたのか？俺が嘘をついてないのが分かっただろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050405
					],
					"speakerTitle": "黒澤京之介"
				},
				{
					"id": 20050405,
					"content": "確かに…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050406
					]
				},
				{
					"id": 20050406,
					"content": "大体こんな感じだ。おまえはたしかに「御救米」を配ってたけど、自分のお金で買ったものだったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050407
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20050407,
					"content": "どうして…昔の俺はそんなやつだったのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050408
					],
					"speakerTitle": "黒澤京之介"
				},
				{
					"id": 20050408,
					"content": "まったく覚えがない。今お前たちに言われ振り返ってみても、何も思い出せない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050409
					],
					"speakerTitle": "黒澤京之介"
				},
				{
					"id": 20050409,
					"content": "昔の俺はどうしてそんなことをやってたんだ？骨折り損じゃないか。理解できない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050410
					],
					"speakerTitle": "黒澤京之介"
				},
				{
					"id": 20050410,
					"content": "でも確かに、さっきこの刀を握ってあの二人を脅そうとした時、体が本能的に抵抗するのを感じた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050411,
						20050412
					],
					"speakerTitle": "黒澤京之介"
				},
				{
					"id": 20050411,
					"content": "その刀…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050413
					]
				},
				{
					"id": 20050413,
					"content": "この刀、昔は俺のオヤジが帯刀していたものだったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050414
					],
					"speakerTitle": "黒澤京之介"
				},
				{
					"id": 20050414,
					"content": "小さい頃、オヤジからそれを盗んで、近所のガキたちの前で見せびらかしたのを覚えてる。その後オヤジにこっぴどく叱られたがな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050415
					],
					"speakerTitle": "黒澤京之介"
				},
				{
					"id": 20050415,
					"content": "オヤジは…なんて言ってたっけ…おかしい、また思い出せなくなった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050416
					],
					"speakerTitle": "黒澤京之介"
				},
				{
					"id": 20050416,
					"content": "「神の目」が奪われてから、何か大切なものを忘れたような気がするんだ。記憶の所々に大きな空白があって、どうやっても思い出せない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050417
					],
					"speakerTitle": "黒澤京之介"
				},
				{
					"id": 20050417,
					"content": "ただ、オヤジはこの刀には自分の信条があるって言ってたのを覚えてる。オヤジが亡くなる直前、その刀を俺に渡した…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050418
					],
					"speakerTitle": "黒澤京之介"
				},
				{
					"id": 20050418,
					"content": "その時に言ってくれたんだ、この刀を持てばきっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050419
					],
					"speakerTitle": "黒澤京之介"
				},
				{
					"id": 20050419,
					"content": "あれ、よく見ると刀の柄になにか文字が刻んであるぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050420
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20050420,
					"content": "旅人、なにが刻んであるのかわかるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050421
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20050421,
					"content": "「仁義」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050422
					]
				},
				{
					"id": 20050422,
					"content": "「仁義」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050423
					],
					"speakerTitle": "黒澤京之介"
				},
				{
					"id": 20050423,
					"content": "それだったら、この状況も説明がつくような気がするな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050424
					],
					"speakerTitle": "黒澤京之介"
				},
				{
					"id": 20050424,
					"content": "借金をしてでも他人の幸せを願う。それが俺にとっての最大の願いだったんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050425
					],
					"speakerTitle": "黒澤京之介"
				},
				{
					"id": 20050425,
					"content": "だが「仁義」なんて、何になる？その道に従って自分の金で御救米を買った。結果はどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050426
					],
					"speakerTitle": "黒澤京之介"
				},
				{
					"id": 20050426,
					"content": "天領奉行に神の目を奪われ、俺が助けていた人々からも理解されない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050427
					],
					"speakerTitle": "黒澤京之介"
				},
				{
					"id": 20050427,
					"content": "なのにあいつらに刀を向けた時、それでも心が痛んだ…これ以上の皮肉はないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050428
					],
					"speakerTitle": "黒澤京之介"
				},
				{
					"id": 20050428,
					"content": "俺は善人になんかなれない、悪人にも。じゃあ俺はいったい…いったいどうすればいいんだよ…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050429
					],
					"speakerTitle": "黒澤京之介"
				},
				{
					"id": 20050429,
					"content": "こいつもかわいそうな人だったんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050430
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20050430,
					"content": "借金のことは、トーマに相談してみよう。社奉行なら支援してくれるだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050431
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20050431,
					"content": "大事な刀を売るわけにはいかないからな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050432,
						20050433
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20050432,
					"content": "神の目を失うのって…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050434
					]
				},
				{
					"id": 20050434,
					"content": "おう…願いを失うのって恐ろしいことなんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050435
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20050435,
					"content": "おまえに神の目がなくてよかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050436
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20050436,
					"content": "次の神の目を失った人のところに行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20050433,
					"content": "恐ろしいことなんだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050434
					]
				},
				{
					"id": 20050412,
					"content": "見せてくれる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050413
					]
				}
			]
