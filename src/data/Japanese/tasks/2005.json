			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"賢",
					"忠夫",
					"パイモン",
					"豪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20050201,
					"content": "クソっ…なんでこんな…俺の金が、頑張って盗んできた俺たちの成果が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050202
					],
					"speakerTitle": "賢"
				},
				{
					"id": 20050202,
					"content": "兄貴、なんとかしてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050203
					],
					"speakerTitle": "賢"
				},
				{
					"id": 20050203,
					"content": "ゴホッ…その…いい身のこなしだな…宝盗団に入って俺たちと大事を成す気はないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050204,
						20050205
					],
					"speakerTitle": "忠夫"
				},
				{
					"id": 20050204,
					"content": "黒澤について教えて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050206
					]
				},
				{
					"id": 20050206,
					"content": "黒澤？ああ…覚えてるぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050207
					],
					"speakerTitle": "忠夫"
				},
				{
					"id": 20050207,
					"content": "まさか、あいつに言われて来たのか？クソっ、なんてツイてないんだ。あんなヤツの家なんかに寄るんじゃなかったぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050208
					],
					"speakerTitle": "忠夫"
				},
				{
					"id": 20050208,
					"content": "黒澤の家はどうだったんだよ？食料がたくさんあったんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20050209,
					"content": "食料？んなもんねぇよ。汚ねぇ家ん中だったぜ。そういえば…一つだけ変わった箱があったな。きっと宝が入ってんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050210
					],
					"speakerTitle": "忠夫"
				},
				{
					"id": 20050210,
					"content": "他のヤツらに見られたくなかったから、戻ってから開けようと思ったんだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050211
					],
					"speakerTitle": "忠夫"
				},
				{
					"id": 20050211,
					"content": "そんな時にお前らに捕まっちまった。いっそこの箱で手を打つってのはどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050212
					],
					"speakerTitle": "忠夫"
				},
				{
					"id": 20050212,
					"content": "まだ少しは誠意が残ってるみたいだな、早く開けてみてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20050213,
					"content": "あっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050214
					],
					"speakerTitle": "賢"
				},
				{
					"id": 20050214,
					"content": "これは！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050215
					],
					"speakerTitle": "忠夫"
				},
				{
					"id": 20050215,
					"content": "しゃ、借用書？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050216
					],
					"speakerTitle": "豪"
				},
				{
					"id": 20050216,
					"content": "それにたくさんあるぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050217
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20050217,
					"content": "雑貨店の葵さんから借りたお金の借用書みたいだ。うわっ…結構な大金だぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20050218,
					"content": "いったいどういうことなんだろう…雑貨店に行って聞いてみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050219
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20050219,
					"content": "おい、おまえたちはもう行っていいぞ！もうこんなことやるなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050220
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20050220,
					"content": "へい！ありがとうございやす、若頭！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050221
					],
					"speakerTitle": "賢"
				},
				{
					"id": 20050221,
					"content": "借用書で手を打てたってことは…俺たち儲かったんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050222
					],
					"speakerTitle": "豪"
				},
				{
					"id": 20050222,
					"content": "早くずらかるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "忠夫"
				},
				{
					"id": 20050205,
					"content": "黒澤の家に強盗に行ったらしいけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050206
					]
				}
			]
		},
		{
			"id": 200503,
			"completionStepIds": [
				200504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200504",
							"2"
						],
						"stepId": 200504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"葵"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20050301,
					"content": "なんでもありな「九十九物」。何かお求めですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050302
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050302,
					"content": "それとも…何か聞きたいことでもあるのでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050303
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050303,
					"content": "この借用書…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050304
					]
				},
				{
					"id": 20050304,
					"content": "うふふ、黒澤さんのお友達でしたか。お客様は黒澤さんの代わりに借金を返しに来たのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050305
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050305,
					"content": "いや、オイラたちはただこの「借用書」のことを知りたくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20050306,
					"content": "黒澤さんはどうしてこんなにモラを借りたんだ？ここでなにか貴重な物でも買ったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20050307,
					"content": "そうですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050308
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050308,
					"content": "黒澤さんは定期的にここで大量の食料を購入されています。上からの配給ではなく彼自身のモラで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050309
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050309,
					"content": "しかし近頃は食料も値段が上がり、黒澤さん自身の俸禄では足りなくなったのでしょう。その時から借用書でモラを借りながら、以前と同じ量の食料を交換するようになりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050310
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050310,
					"content": "「御救米」ってそういう経緯だったんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20050311,
					"content": "でも、なんで昔と「同じ」量を買ってたんだ？食料の値段が上がったんなら、少な目に買えばいいだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20050312,
					"content": "考えてもみてください。「御救米」を受け取りに行く人々は、その食料がどれほどの期間持つか事前に考えておくのが普通ですよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050313
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050313,
					"content": "昼夜問わず綿密な計画をしたにもかかわらず、手に入ったのが予想より少なかったら…きっとがっかりするでしょう。黒澤さんはそういう思いをさせたくなかったんだと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050314
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050314,
					"content": "人々の気持ちを大事に思い、借金をしてでも以前と同じ量の食料を換えてきたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050315
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050315,
					"content": "過去に渡してきた食料は、黒澤さんが全部自分で買ったものだったのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050316
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20050316,
					"content": "なのに周囲の人から感謝されるどころか、ずっと責められて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050317
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20050317,
					"content": "人の態度は自身の置かれている状況によって変わるものです。生きるということに関して、ほとんどの人は他の事に気を回す余裕がなくなります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050318
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050318,
					"content": "私からすれば、黒澤さんが「御救米」の出所を最初から話していれば、このような面倒事も減っていたと思います…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050319
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050319,
					"content": "もちろん、減るだけですが。彼がしたことは、端から骨折り損のくたびれ儲けです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050320
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050320,
					"content": "彼がどうしてお金を払って御救米を買ったのか、どうしてそれを公表して感謝されることをしなかったのか…私にも分かりません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050321
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050321,
					"content": "もし気になるのでしたら、黒澤さんに直接聞いてみてはいかがでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050322
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050322,
					"content": "彼自身も覚えてない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050323
					]
				},
				{
					"id": 20050323,
					"content": "ああ…そういえば、彼は「神の目」を押収されたばかりでしたね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050324
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050324,
					"content": "それは厄介ですね…もし借金を返せないのでしたら、彼が大事にしていた刀を売るしかないかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050325
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050325,
					"content": "刀？なんだそれ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050326
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20050326,
					"content": "黒澤さんから聞いていませんか？一年中身に着けているほど、彼には大事な刀があるんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050327
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050327,
					"content": "私もむかし彼にその刀の来歴を聞いたのですが、これは父から譲り受けたもので、どんな高値でも売らないとだけ言われました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050328
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050328,
					"content": "当時は少し残念に思ったほどです。なにせ私は、この世の万物は値段で量ることができ、相応のモラを払えばなんでも買えると思っていましたので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050329
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050329,
					"content": "黒澤さんに刀の事情を聞いてみてください。あなた方の探している答えは、その刀にあるかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050330
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050330,
					"content": "もちろん、その前にこちらでのお会計を済ませてくださいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050331
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050331,
					"content": "でもオイラたちなにも買ってないぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050332
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20050332,
					"content": "うふふ、「情報」も売り物の一つ、そうでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050333
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050333,
					"content": "まあ、確かに黒澤さんの情報は高くはつきませんね。特別秘密にしてくれとも言われていませんし、そうですね…2000モラでどうでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050334
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050334,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050335
					]
				},
				{
					"id": 20050335,
					"content": "少なくとも「御救米」の事情がわかったんだ。それと黒澤さんがずっと持ってる刀のことも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050336
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20050336,
					"content": "本人に聞いてみよう、なにか思い出すかもしれない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
