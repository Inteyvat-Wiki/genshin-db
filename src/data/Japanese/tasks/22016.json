			},
			"dialogs": [
				{
					"id": 220160801,
					"content": "なにかご用ですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160802,
						220160807,
						220160814,
						220160819
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220160802,
					"content": "どうして旭東の誘いに応じたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160803
					]
				},
				{
					"id": 220160803,
					"content": "旭東が言って下さったように、今の私は…空腹にならないために、彼の下で働くのが一番だと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160804
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220160804,
					"content": "それに、ジュリーも旭東も、いい人だと思います。彼らと共に旅ができることを光栄に思っています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160805
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220160805,
					"content": "パルヴァネは…思慮深い人です。私を警戒するのも理に適っていると思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160806
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220160806,
					"content": "しかも、私のことを警戒しているだけで、拒絶しているわけではありません。それで十分です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220160807,
					"content": "ずっと外を彷徨っていたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160808
					]
				},
				{
					"id": 220160808,
					"content": "嘘はついていません。幕府から離れた後、ずっと放浪していました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160809
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220160809,
					"content": "普段は果物で、運が良ければ狩りをして、腹を満たしていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160810
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220160810,
					"content": "たまに、魔物や海乱鬼を退治して、人助けの報酬をもらっていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160811
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220160811,
					"content": "ああ…私のような剣を振るうことしかできない者にとって、仕事を得られる機会は実に少ない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160812
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220160812,
					"content": "しかも、「幕府から離れた」という経歴が、人々に海乱鬼を連想させてしまうのです。それ故、余計に仕事が見つからない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160813
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220160813,
					"content": "稲妻に住む場所がなく、頼れる家族もいない。行き場がないので、外を彷徨う他なかったのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220160814,
					"content": "どうして幕府から離れたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160815
					]
				},
				{
					"id": 220160815,
					"content": "ただ…幕府が稲妻で行っていることに、どうしても賛同できなかったのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160816
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220160816,
					"content": "私はただの武人であり、どのような施策が国のためになるのかも分かりません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160817
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220160817,
					"content": "ただ、あのような施策は自分の考えに反していると思い、辞めることにしました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160818
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220160818,
					"content": "はは、私の考えが古すぎたのでしょうか…お恥ずかしい事を言ってしまいました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220160819,
					"content": "さようなら。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160820
					]
				},
				{
					"id": 220160820,
					"content": "さようなら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "亀井宗久"
				}
			]
		}
