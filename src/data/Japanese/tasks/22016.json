			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"旭東"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220160201,
					"content": "パルヴァネ…それに旅人、どうしたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160202,
						220160205
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220160202,
					"content": "手伝いに来た。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160203
					]
				},
				{
					"id": 220160203,
					"content": "そうか…感謝する。ジュリーのやつ、もっと深いところまで行っちまったみたいで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160204
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220160204,
					"content": "あそこは魔物が多いから、俺たち二人だけじゃ歯が立たない。お前がいてくれて助かるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160210
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220160210,
					"content": "早速出発するぞ、ジュリーは森の中にいるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "旭東"
				},
				{
					"id": 220160205,
					"content": "約束のご馳走をもらいに来た。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160206
					]
				},
				{
					"id": 220160206,
					"content": "問題ないが、俺一人じゃあ、あんなご馳走を作ることはできない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160207
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220160207,
					"content": "旅人、お願いだ。一緒にジュリーを探してくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160208
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220160208,
					"content": "ジュリーのやつ、きっと深いところまで行っちまってる。あそこは魔物が多いから、俺たち二人だけじゃ歯が立たない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160209
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220160209,
					"content": "ジュリーを連れ帰ることができたら、約束してたご馳走を作ってやるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160210
					],
					"speakerTitle": "旭東"
				}
			]
		},
		{
			"id": 2201603,
			"completionStepIds": [
				2201609
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201609",
							"2"
						],
						"stepId": 2201609,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パルヴァネ",
					"旭東",
					"ジュリー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220160301,
					"content": "ちょっとあんた…鍋を壊したら、どうやって料理しろっていうの！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160302
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 220160302,
					"content": "璃月の鋳造技術を甘く見るなよ。これは鍋を振る練習のために作られた特製鉄鍋だ、そう簡単に壊れやしない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160303
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220160303,
					"content": "たった数体の魔物さえ倒せなかったら、鉄鍋とはいえない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160304
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220160304,
					"content": "この鉄鍋に期待しすぎなんじゃないの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160305,
						220160308,
						220160312
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 220160305,
					"content": "旭東はすごかったね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160306
					]
				},
				{
					"id": 220160306,
					"content": "当然よ、こんなの料理人の必修科目みたいなもんだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160307
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220160307,
					"content": "全然聞いたことないんだけど！？何で料理人が鉄鍋で魔物を倒さないといけないわけ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160315
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 220160315,
					"content": "よし、ジュリー、早くここから脱出しよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160316
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220160316,
					"content": "ま、待ってよ、おじさんを助けてあげて！彼、海乱鬼と戦うために一人で森の中に行っちゃったよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160317
					],
					"speakerTitle": "ジュリー"
				},
				{
					"id": 220160317,
					"content": "海乱鬼？魔物じゃないの？どうしてあんな奴らと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160318
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 220160318,
					"content": "あ、後で説明するから…とにかくおじさんを助けてあげて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160319
					],
					"speakerTitle": "ジュリー"
				},
				{
					"id": 220160319,
					"content": "分かったから…旅人、もう少し付き合ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160320,
						220160321
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220160320,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160325
					]
				},
				{
					"id": 220160325,
					"content": "早く出発するぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "旭東"
				},
				{
					"id": 220160321,
					"content": "海乱鬼と戦うの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160322
					]
				},
				{
					"id": 220160322,
					"content": "当然だろ、早くこの鍋を試したいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160323
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220160323,
					"content": "それに、料理人は敵前逃亡なんてしないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160324
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220160324,
					"content": "料理人と鉄鍋にそこまで期待するなって言ったでしょ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160325
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 220160308,
					"content": "その鍋はどこで買えるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160309
					]
				},
				{
					"id": 220160309,
					"content": "ははは、いい質問だ。俺は「寒鋒鉄器」のおじさんに頼んだんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160310
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220160310,
					"content": "おじさんはこいつに、層岩巨淵から採掘された材料を加えていたみたいだ。お前も買いたいのなら、直接頼めばいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160311
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220160311,
					"content": "だが、層岩巨淵は長い間封鎖されていると聞いた。今頼んでも、作れないかもしれない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160315
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220160312,
					"content": "パルヴァネもすごかったね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160313
					]
				},
				{
					"id": 220160313,
					"content": "え？あれか…あははは。私はただ魔物の頭に本を何冊か投げただけよ。魔物を倒せたのはあんたのおかげ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160314
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 220160314,
					"content": "待ってよ、私の『神性と共に』の第六巻は？そ、それも捨てちゃったんだ…まだ読み終わってなかったのに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160315
					],
					"speakerTitle": "パルヴァネ"
				}
			]
		},
		{
			"id": 2201604,
			"completionStepIds": [
				2201608
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201608",
							"2"
						],
						"stepId": 2201608,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"亀井宗久",
					"ジュリー",
					"旭東",
					"パルヴァネ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220160401,
					"content": "コ…コホン、あのような悪党たちにここまで追い詰められるとは、お恥ずかしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160402
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220160402,
					"content": "おじさん、大丈夫…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160403
					],
					"speakerTitle": "ジュリー"
				},
				{
					"id": 220160403,
					"content": "少しやられただけです、大きな問題はありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160404
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220160404,
					"content": "ジュリー、事の経緯を説明してくれないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160405
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220160405,
					"content": "そうだ、ちゃんと説明して。でないと、投げた本が無駄になる…あ、ページもシワシワになっちゃった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160406
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 220160406,
					"content": "簡単だよ…おじさんに食べ物をプレゼントしたかっただけなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160407
					],
					"speakerTitle": "ジュリー"
				},
				{
					"id": 220160407,
					"content": "あんたねぇ…初対面の人を、そこまで信用しないでよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160408
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 220160408,
					"content": "おじさんはいい人だよ！あの時、自分もお腹が空いていたのに、私たちに食べ物を分けてくれたんだもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160409
					],
					"speakerTitle": "ジュリー"
				},
				{
					"id": 220160409,
					"content": "腹ペコの時に食べ物を分けてくれる人は、きっといい人だよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160410
					],
					"speakerTitle": "ジュリー"
				},
				{
					"id": 220160410,
					"content": "善悪に対する考え方が単純すぎる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160411
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 220160411,
					"content": "あんた、テイワットじゃなくて、どっかのおとぎ話の世界に住んでるんじゃない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160412
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 220160412,
					"content": "ははっ、だが俺はジュリーの言う通りだと思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160413
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220160413,
					"content": "空腹の時に品格を保てる人は、きっと悪い奴じゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160414
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220160414,
					"content": "その理屈も単純だね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160415
					]
				},
				{
					"id": 220160415,
					"content": "とにかくジュリー、話を続けてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160416
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220160416,
					"content": "私は試しに鳥肉と野生キノコの串焼きを作って、おじさんと初めて会った場所に行ってみたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160417
					],
					"speakerTitle": "ジュリー"
				},
				{
					"id": 220160417,
					"content": "そうしたら、本当におじさんと会えたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160418
					],
					"speakerTitle": "ジュリー"
				},
				{
					"id": 220160418,
					"content": "でもおじさんを呼ぼうとした時、何人かの海乱鬼と対峙してたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160419
					],
					"speakerTitle": "ジュリー"
				},
				{
					"id": 220160419,
					"content": "それで遠くに隠れようとしたんだけど、海乱鬼に見つかってしまったの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160420
					],
					"speakerTitle": "ジュリー"
				},
				{
					"id": 220160420,
					"content": "続きは私の方で説明しましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160421
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220160421,
					"content": "彼らは、かつての「旧友」でした。当時、私と彼らは、共に幕府に仕えていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160422
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220160422,
					"content": "稲妻に異変が起きた後、私たちは次々と幕府を去り、別の道を歩みました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160423,
						220160425,
						220160427
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220160423,
					"content": "さっきのことが、彼らの生計を立てる手段？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160424
					]
				},
				{
					"id": 220160424,
					"content": "…はい。私たちは刀を振るう以外、取り柄がないので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160432
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220160432,
					"content": "その後、彼らはあのような「海乱鬼」となり、略奪を頼りに生きてきました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160433
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220160433,
					"content": "私は彼らと同じ道を歩みたくないので、仕事を探し、彷徨っていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160434
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220160434,
					"content": "悲しい事に、私が幕府を去った武士だと聞いて、私を雇ってくれるところはありませんでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160435
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220160435,
					"content": "その結果、今のように野外で食料を調達することで、何とか生きてきました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160436
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220160436,
					"content": "しかしここ最近、人手不足のようで、その旧友たちが連日私を誘いに来ていたのですが、全部お断りしました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160437
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220160437,
					"content": "今日…ジュリーさんが現れた時に、彼らは私が他の組織に加入したと勘違いしたようです。それを防ぐため攻撃を仕掛けてきたのでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160438,
						220160440
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220160438,
					"content": "理不尽な連中だ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160439
					]
				},
				{
					"id": 220160439,
					"content": "彼らは理屈が通らない連中です。しかし、彼らのような境遇に身を置くと…確かに道理を通す必要はありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160444
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220160444,
					"content": "そして、おじさんが悪党たちをやっつけに行ったから、私は動かずそこで待っていたの。でも魔物が突然現れて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160445
					],
					"speakerTitle": "ジュリー"
				},
				{
					"id": 220160445,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYSECOND|INFO_FEMALE_PRONOUN_GIRLSECOND]}ならやっつけられるでしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160446
					]
				},
				{
					"id": 220160446,
					"content": "普段なら問題ないよ。でも今朝から何も食べていなかったから、お腹が空いて力が出なかったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160447
					],
					"speakerTitle": "ジュリー"
				},
				{
					"id": 220160447,
					"content": "しかも海乱鬼に見つかった時、鳥肉と野生キノコの串焼きも無くしちゃったの…おじさんが守ってくれなかったらどうなってたんだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160448,
						220160449
					],
					"speakerTitle": "ジュリー"
				},
				{
					"id": 220160448,
					"content": "朝ご飯の大切さが分かる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160450
					]
				},
				{
					"id": 220160450,
					"content": "でも、稲妻にはまだあのような海乱鬼がいるんでしょ？稲妻にはもうしばらく滞在する予定だけど、安全面が心配だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160451
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 220160451,
					"content": "私たちだけじゃあ、弱い魔物なら問題ないけど、武芸の心得がある奴らが相手となると少し不安だね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160452
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 220160452,
					"content": "おい、おじさん、さっき仕事を探してるって言ったよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160453
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220160453,
					"content": "もしよかったら、俺たちと一緒に行動しないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160454
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220160454,
					"content": "やったー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160455
					],
					"speakerTitle": "ジュリー"
				},
				{
					"id": 220160455,
					"content": "しかし、幕府を去った武士かぁ。稲妻で彼を連れてると、厄介ごとに巻き込まれそうな気がする…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160456
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 220160456,
					"content": "…いかにも、私は特殊な身分である故、皆様に迷惑をかけてしまう恐れがあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160457
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220160457,
					"content": "ははは、俺は大丈夫だと思うぞ。俺たちはただ食材を探して料理しているだけだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160458
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220160458,
					"content": "おじさんのような身分なら、幕府や武士と関係のない仕事が適している。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160459
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220160459,
					"content": "もし誰かの護衛や見張り役を務めれば、きっと怪しまれる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160460
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220160460,
					"content": "それに、おじさんみたいないい人の腹を空かせたままでいるのは、良くない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160461
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220160461,
					"content": "料理人として、見ていられないよ。他のことは力になれないかもしれないが、腹いっぱいにさせることくらいはできる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160462
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220160462,
					"content": "あなたは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160463
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220160463,
					"content": "ははっ、どうだいおじさん、俺たちと一緒に来ないか？給料は安いが、食うものに悩むことはなくなるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160464
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220160464,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160465
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220160465,
					"content": "では、ご厚意に甘えさせていただきます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160466
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220160466,
					"content": "やった——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160467
					],
					"speakerTitle": "ジュリー"
				},
				{
					"id": 220160467,
					"content": "これでいいのかな？いいことだよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160468
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 220160468,
					"content": "よーし！みんな疲れただろう、腹も減ってるよな。ここは料理し辛そうだが…食べ物を何とか作ってやるよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160469
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220160469,
					"content": "旅人、お前もご苦労さん。他のことは俺に任せて、料理が出来上がるのを待っててくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160470
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220160470,
					"content": "それじゃあ、始めるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160471
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220160471,
					"content": "これでよしっと…残った米で作った「おにぎり」だ。少し雑だが…腹いっぱいにするには十分だろう。ほら、食べろ食べろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160472
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220160472,
					"content": "ところで旅人、色々と助かった。このレシピをお前にやる。宗久のおじさんからもらったものを写したやつだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160473
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220160473,
					"content": "幕府時代に書き留めたレシピで、かなり独創的なものらしい。興味があったら、研究してみるといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160474
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220160474,
					"content": "さてと、話はこれくらいにして。さあ、食べるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "旭東"
				},
				{
					"id": 220160449,
					"content": "朝ご飯はちゃんと食べてね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160450
					]
				},
				{
					"id": 220160440,
					"content": "彼らは警戒心が強いんだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160441
					]
				},
				{
					"id": 220160441,
					"content": "あのような境遇に身を置いているのです、それも仕方のないこと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160442
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220160442,
					"content": "彼らはプライドを保つために、「従わない」人間である私を処刑したいだけなのでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160443
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220160443,
					"content": "なにしろ、何度も断ったので、恨みを持たれていましたから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160444
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220160425,
					"content": "もしかして、あの海乱鬼たちも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160426
					]
				},
				{
					"id": 220160426,
					"content": "全員ではありません。しかし、みな弱者に刀を振るう臆病者だということに変わりはありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160432
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220160427,
					"content": "なぜ幕府を辞めたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160428
					]
				},
				{
					"id": 220160428,
					"content": "ただ…幕府が稲妻で行っていることに、どうしても賛同できなかったのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160429
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220160429,
					"content": "私はただの武人であり、どのような施策が国のためになるのかも分かりません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160430
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220160430,
					"content": "ただ、あのような施策は自分の考えに反していると思い、辞めることにしました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160431
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220160431,
					"content": "はは、私の考えが古すぎたのでしょうか…お恥ずかしい事を言ってしまいました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160432
					],
					"speakerTitle": "亀井宗久"
				}
			]
		},
		{
			"id": 2201605,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201608",
							"3"
						],
						"stepId": 2201608,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"旭東"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220160501,
					"content": "もう腹いっぱいだ…ゲップ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160502,
						220160513
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220160502,
					"content": "どうして助けたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160503
					]
				},
				{
					"id": 220160503,
					"content": "宗久のおじさんのことか？そりゃあ、俺にも料理人としての責任感ってものがあるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160504
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220160504,
					"content": "冗談だよ。でもおじさんみたいないい人が、お腹を空かせたままでいるなんて嫌なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160505
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220160505,
					"content": "いや、正確に言えば…俺は、誰にも飢えを与えたくない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160506
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220160506,
					"content": "飢えることはものすごく恐ろしいことなんだ。俺も…それを痛感したことがある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160507
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220160507,
					"content": "飢えた人間は…とんでもないことを犯してしまう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160508
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220160508,
					"content": "もしこの世のすべての人に十分な食料を確保できたら、多くの悪事は起こらなくなるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160509
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220160509,
					"content": "俺一人でそれを成し遂げることはできないが、せめて一料理人として、身近な人にはうまい料理を食べさせてやりたいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160510
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220160510,
					"content": "ははは、つまり、みんなにお腹いっぱいになって欲しいんだ、くだらない理想だろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160511
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220160511,
					"content": "素晴らしい理想だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160512
					]
				},
				{
					"id": 220160512,
					"content": "はは、ありがとな。それより…もっと食べろよ！食べ物を粗末にするのは大罪だからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "旭東"
				},
				{
					"id": 220160513,
					"content": "さようなら。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160514
					]
				},
				{
					"id": 220160514,
					"content": "もう行くのか？もっと食べていったらどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "旭東"
				}
			]
		},
		{
			"id": 2201606,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
