			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ジュリー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220160601,
					"content": "へへっ、本当においしいね。もう少し食べたいな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160602,
						220160606,
						220160609
					],
					"speakerTitle": "ジュリー"
				},
				{
					"id": 220160602,
					"content": "どうして彼に食べ物を贈ろうとしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160603
					]
				},
				{
					"id": 220160603,
					"content": "うん…おじさんがお腹を空かせている姿を見たくなかったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160604
					],
					"speakerTitle": "ジュリー"
				},
				{
					"id": 220160604,
					"content": "それに、この前おじさんと会った時、悲しそうな顔をしてた。もしかしたら、空腹のせいかもって思ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160605
					],
					"speakerTitle": "ジュリー"
				},
				{
					"id": 220160605,
					"content": "だから食べ物をプレゼントしてあげたかったの。お腹いっぱいになれば、おじさんも元気になるって思ったから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジュリー"
				},
				{
					"id": 220160606,
					"content": "どうして彼を信じたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160607
					]
				},
				{
					"id": 220160607,
					"content": "それは…冒険者の勘ってやつかな。私って良い人と悪い人を見分けるのが得意なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160608
					],
					"speakerTitle": "ジュリー"
				},
				{
					"id": 220160608,
					"content": "それに、お腹が空いているとき他人に食べ物を分けるって…いい人じゃないとそんなことできないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジュリー"
				},
				{
					"id": 220160609,
					"content": "さようなら。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160610
					]
				},
				{
					"id": 220160610,
					"content": "じゃあね。今後は朝ご飯をちゃんと食べるから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジュリー"
				}
			]
		},
		{
			"id": 2201607,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
