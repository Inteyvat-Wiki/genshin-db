					"パルヴァネ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220160701,
					"content": "まったくこの二人は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160702,
						220160705,
						220160713
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 220160702,
					"content": "まだ信用してないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160703
					]
				},
				{
					"id": 220160703,
					"content": "亀井宗久のこと？当たり前…そんなに親しいわけじゃないし、そう簡単には信用できない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160704
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 220160704,
					"content": "…でも、亀井宗久のことはあまり信用してないけど、旭東の判断は信じる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 220160705,
					"content": "教令院からきたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160706
					]
				},
				{
					"id": 220160706,
					"content": "私…まぁ、そうだね。元々は遊学のために教令院から出て、璃月で旭東と出会ったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160707
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 220160707,
					"content": "彼は旅をしながらレシピを研究する予定で、私の研究テーマも美食に関するものだった。彼と何度か話し合った後、私たちは共に行動するようになったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160708
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 220160708,
					"content": "最初にモンドに行った時、魔物に囲まれてしまったんだけど、運良くジュリーが来て追い払ってくれたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160709
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 220160709,
					"content": "その後、美食の旅の話を聞いたジュリーも、私たちに同行することになったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160710
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 220160710,
					"content": "本人は冒険するつもりだったと言っていたけど、私にはただ美味しいものを食べたいだけに見えたな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160711
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 220160711,
					"content": "次はスメールに行く予定なんだ。私の研究テーマもそろそろ終わりそうだし、教令院に帰ろうかなって思ってたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160712
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 220160712,
					"content": "ふん、スメールに着いたら、スメールならではの美食を味わわせてあげる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 220160713,
					"content": "さようなら。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160714
					]
				},
				{
					"id": 220160714,
					"content": "うん、さようなら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パルヴァネ"
				}
			]
