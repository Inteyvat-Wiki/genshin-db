			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"玉霞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701440101,
					"content": "寒流について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701440102
					]
				},
				{
					"id": 701440102,
					"content": "調査で何か分かったかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440103
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701440103,
					"content": "こういう発見があった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701440104
					]
				},
				{
					"id": 701440104,
					"content": "これはいつ雪山に現れたのかしら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440105
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701440105,
					"content": "調査ありがとう。このことは協会に報告しておくわ。これは報酬よ、ご苦労様。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玉霞"
				}
			]
		},
		{
			"id": 7014402,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"99902",
							"3"
						],
						"stepId": 99902,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"玉霞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701440201,
					"content": "何か依頼があるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701440202
					]
				},
				{
					"id": 701440202,
					"content": "依頼？あぁ君か、ちょうどよかった。いま経験豊富な冒険者を探してたの。奇妙な寒流を調べてもらうためにね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440203
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701440203,
					"content": "寒流？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701440204
					]
				},
				{
					"id": 701440204,
					"content": "そう。以前とあるチームが経験豊富な冒険者たちを引き連れて山に入ったの。進んだルートは最も安全で、危険なエリアも全部回避した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440205
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701440205,
					"content": "でも、何が起きたか知らないけど、途中でいきなり激しい寒流に遭遇して、拠点に引き返した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440206
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701440206,
					"content": "戻ってきた冒険者によると、彼らが歩いた道にその強さの寒流が発生する可能性はなかったらしいの。それに、発生した寒流がいきなりすぎて、とてもじゃないけど自然現象とは思えなかったみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440207
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701440207,
					"content": "その後、山で考察していた人たちからの報告や調査の結果、その寒流の発生源を特定できたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440208
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701440208,
					"content": "でも、度重なる調査で、調査チームの冒険者たちはみんな凍傷になったり体力を失ったりしてこの拠点で休んでるの。これ以上調査に配置できる人員は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440209
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701440209,
					"content": "旅人、もしよかったらだけど、私たちの代わりにあの極寒の元凶を調べてきてもらえないかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440210,
						701440212
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701440210,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701440211
					]
				},
				{
					"id": 701440211,
					"content": "じゃあお願いね。あの極寒は尋常じゃないから、万全な準備を忘れずに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440215
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701440215,
					"content": "じゃあ、そこの調査をお願いね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701440212,
					"content": "報酬は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701440213
					]
				},
				{
					"id": 701440213,
					"content": "あら、素直ね。心配しないで、協会は冒険者を無下にしない。報酬を準備して拠点で待ってるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440214
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701440214,
					"content": "具体的な報酬内容は…調査結果次第ね。それがルールだもの。君も分かるわよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440215
					],
					"speakerTitle": "玉霞"
				}
			]
		},
