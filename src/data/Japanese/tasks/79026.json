			},
			"dialogs": [
				{
					"id": 790260101,
					"content": "いらっしゃい！いらっしゃい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260102
					],
					"speakerTitle": "暮夜劇団団長"
				},
				{
					"id": 790260102,
					"content": "ようこそ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260104
					],
					"speakerTitle": "暮夜劇団団長"
				},
				{
					"id": 790260104,
					"content": "#君があの名高き{NICKNAME}か！それに最高の仲間——パイモン閣下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260105
					],
					"speakerTitle": "暮夜劇団団長"
				},
				{
					"id": 790260105,
					"content": "わぁ！なんでオイラたちの名前を知ってるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790260106,
					"content": "島の賓客のことくらい、知ってるに決まっているさ、何故なら私は…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260107
					],
					"speakerTitle": "暮夜劇団団長"
				},
				{
					"id": 790260107,
					"content": "おまえは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790260108,
					"content": "私こそ、名高き暮夜劇団の団長さ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260109
					],
					"speakerTitle": "暮夜劇団団長"
				},
				{
					"id": 790260109,
					"content": "名高さを自称する人もいるんだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790260110
					]
				},
				{
					"id": 790260110,
					"content": "名高きって言われても、聞いたことないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790260111,
					"content": "構わん構わん！今知ってくれたんだからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260112
					],
					"speakerTitle": "暮夜劇団団長"
				},
				{
					"id": 790260112,
					"content": "念入りな準備を終え、ついに私たちの舞台劇——「剣を持つ王女」が初演を迎えた！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260113
					],
					"speakerTitle": "暮夜劇団団長"
				},
				{
					"id": 790260113,
					"content": "劇は五幕で構成され、それぞれ前半と後半に分かれている…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260114
					],
					"speakerTitle": "暮夜劇団団長"
				},
				{
					"id": 790260114,
					"content": "いいところに来てくれたな！どうぞかけてくれ、序幕がじきに始まるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260115
					],
					"speakerTitle": "暮夜劇団団長"
				},
				{
					"id": 790260115,
					"content": "さて、舞台裏にてまだやることが残っているので、私はこれで失礼するよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260116
					],
					"speakerTitle": "暮夜劇団団長"
				},
				{
					"id": 790260116,
					"content": "暮夜劇団が全力をかけて演じる舞台劇、いざ開幕！とくとご覧あれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "暮夜劇団団長"
				}
			]
		}
	]
}