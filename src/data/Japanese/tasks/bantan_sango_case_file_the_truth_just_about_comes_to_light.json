			"trigger": {
				"objectNames": [
					"龍二"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400330101,
					"content": "あなたたちでしたか、ちょうどいい時に来ましたね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330102
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400330102,
					"content": "先ほど怪しい地点をいくつか調査しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330103
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400330103,
					"content": "そのうちの一つは、あの笠かぶり…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330104
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400330104,
					"content": "コホンッ、あの「黒い影」によって守られています。もし他に問題がなければ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330105
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400330105,
					"content": "昨日言ってた「調査」について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400330106
					]
				},
				{
					"id": 400330106,
					"content": "それについては、まだ何も分かっていません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330107
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400330107,
					"content": "えっ？珊瑚から調査を頼まれたんじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400330108,
					"content": "そうですが…なんと言いますか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330109
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400330109,
					"content": "例えば、「熟したスミレウリ」と「のれんについた泥の手形」は、私にとっては何の関係もない二つの事柄ですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330110
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400330110,
					"content": "珊瑚所長からすれば、どちらも「寄木細工」を解く鍵となるのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330111
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400330111,
					"content": "「熟したスミレウリ」と「のれんについた泥の手形」…いったいなんの関係があるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400330112,
					"content": "ただの例えです。所長の指示に従って、ヤシオリ島と鎮守の森のいくつかの地点を調査しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330113
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400330113,
					"content": "所長が私の調査結果からどのような結論を導き出すのかは、所長にしか分からないことです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330114
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400330114,
					"content": "所長の思考についていけるのは、鹿野院さんしかいないでしょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330115
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400330115,
					"content": "鹿野院？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400330116
					]
				},
				{
					"id": 400330116,
					"content": "天領奉行の方です。以前事件を調査していた時に、お会いしたことがあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330117
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400330117,
					"content": "なんと言うか…オーラが独特な方でした。もし見かけたら、一目で分かると思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330118
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400330118,
					"content": "とにかく、動物たちのことをお願いします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330119
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400330119,
					"content": "オイラ、やっぱり「熟したスミレウリ」が気になるぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 4003303,
			"completionStepIds": [
				4003303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
