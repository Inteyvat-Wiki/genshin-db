			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"龍二"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400330301,
					"content": "お疲れ様でした！よかったです！これで数が足りるはず…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330302
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400330302,
					"content": "おや？いくつか足りません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330303
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400330303,
					"content": "えっ、そんな…なんかどうやっても終わらない気が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400330304,
					"content": "確かに、事件調査には根気が必要な時もあります。もし方向性を間違えてしまえば、今までの苦労が無駄になってしまうでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330305
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400330305,
					"content": "少なくとも今はたくさんの動物たちを取り戻せました。方向性は合っていると思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330306
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400330306,
					"content": "ただ、何か手がかりを見逃しているか、まだ思いついていない点があるのかもしれません。ですが、きっとそれも一時的なものでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330307
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400330307,
					"content": "あっ、わかったぞ！それって、ピキーンって感覚が足りないってことだよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400330308,
					"content": "ピキーンという感覚…そうですね、そうとも言えるでしょう。私たちの進展は決して遅いものではありません、それも旅人さんとパイモンさんのおかげです。そこまで気に病む必要はありませんよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330309,
						400330310
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400330309,
					"content": "（パイモンの言葉が分かるなんて…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400330311
					]
				},
				{
					"id": 400330311,
					"content": "えへへ、おまえの言うことってすごく正しいと思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400330312,
					"content": "そんなことはありませんよ。ただ事件の調査で培ってきた経験に過ぎません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330313
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400330313,
					"content": "謎が深まるほど、探求する価値が高くなります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330314
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400330314,
					"content": "ただ残念ながら、今は他に情報がありません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330315
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400330315,
					"content": "こうしましょう。私は先に珊瑚所長に今の状況を報告してきます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330316
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400330316,
					"content": "珊瑚所長ならきっと、私たちが思いつかなかった点を見つけられるはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330317
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400330317,
					"content": "おう！おまえの言うことは正しいから、言う通りにするぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330318
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400330318,
					"content": "では決まりですね。またいつもの場所で落ち合いましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330319
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400330319,
					"content": "もし私がまた何かの事情で来られない時は、直接珊瑚所長を訪ねてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龍二"
				},
				{
					"id": 400330310,
					"content": "（龍二はもうパイモンを理解してる…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400330311
					]
				}
			]
		},
