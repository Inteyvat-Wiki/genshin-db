			"trigger": {
				"objectNames": [
					"グザヴィエ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721190101,
					"content": "なっ！旅人、どうやら…まずいようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190102
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721190102,
					"content": "中にいるファデュイが核心の近くに突如集まり、何かを見つけたらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190103
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721190103,
					"content": "まさか、彼らは本当に核心の防御を破れるのか…ダメだ、これ以上延ばすといけない。すぐに機能性テストを始めないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190104
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721190104,
					"content": "機能性テスト？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190105
					]
				},
				{
					"id": 721190105,
					"content": "こいつの浄化能力をテストするんだ。中に運んで、こいつが起動しなかったら話にならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190106
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721190106,
					"content": "だから、「オニカブトムシ」を3匹探して来てほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190107
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721190107,
					"content": "それを今の「御影炉心」の周囲に置いて、「祟り神」のエネルギーを纏わせてほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190108
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721190108,
					"content": "その後、回収したオニカブトムシを浄化装置で浄化する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190109
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721190109,
					"content": "これが、私が考えた「機能性テスト」だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190110
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721190110,
					"content": "どこで「オニカブトムシ」を見つければ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190111
					]
				},
				{
					"id": 721190111,
					"content": "ああ…オニカブトムシは雷元素が豊富なエリアに生息している…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190112
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721190112,
					"content": "それに、「御影炉心」の付近にもいると聞いた…本当にすごい虫だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190113
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721190113,
					"content": "直接「御影炉心」のを捕まえた方が…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190114
					]
				},
				{
					"id": 721190114,
					"content": "それでもいいが…直接「御影炉心」の中で「オニカブトムシ」捕まえて、それでテストした場合…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190115
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721190115,
					"content": "正直、こいつの…信憑性がちょっと心配だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190116
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721190116,
					"content": "テストは「少しずつ進む」方がいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190117
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721190117,
					"content": "コホン、とにかく「オニカブトムシ」を3匹探してきてくれ。ここで待ってるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190118,
						721190120
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721190118,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190119
					]
				},
				{
					"id": 721190119,
					"content": "頼んだよ。「オニカブトムシ」を3匹でいいから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721190120,
					"content": "中に入って歩き回った方が早いんじゃ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190121
					]
				},
				{
					"id": 721190121,
					"content": "うっ…テストに関しては、直接中に入って「祟り神」のエネルギーを浴びることでも、テストの対象にはなれるけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190122
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721190122,
					"content": "だが前にも言った通り、この装置の信憑性は…期待通りのものではないかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190123
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721190123,
					"content": "もし浄化の過程で、本当に何か予想外のことが起きたら、お前も…うぅ…予想外の問題に立ち向かうことになる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190124
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721190124,
					"content": "コホン、とにかく「オニカブトムシ」でテストしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190125
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721190125,
					"content": "「オニカブトムシ」は3匹でいい。集めたら、俺のところに持って来てくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "グザヴィエ"
				}
			]
		},
