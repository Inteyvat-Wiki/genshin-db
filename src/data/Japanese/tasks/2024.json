	"talks": [
		{
			"id": 202401,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"202401",
							"2"
						],
						"stepId": 202401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"八重神子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20240101,
					"content": "さっきの話は少し真面目すぎたか。妾にからかわれる方が汝は好きかのう？ふふ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210301,
						20210401,
						20210501,
						20210601,
						20210701
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210301,
					"content": "「人形」の将軍について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210302
					]
				},
				{
					"id": 20210302,
					"content": "「人形」の将軍を作った技術は、今では失われている知識からきたものじゃ。神であるあやつにしか分からぬことなのかもしれぬな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210303
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210303,
					"content": "じゃが…汝らが興味を持ちそうなことは、なくもない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210304
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210304,
					"content": "影が自身の神の体を改造する前、「原型の人形」を創造したことがある…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210305
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210305,
					"content": "じゃ、じゃあ雷電将軍は3人いるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20210306,
					"content": "いや、あの原型はただ実現性を確認するためのもので、見た目も知能も影自身を設計に作られたものではない。言わば試作品じゃな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210307
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210307,
					"content": "当時の計画では、それを直ちに廃棄する予定じゃった。しかし影はそれを残酷と思ったのか、それの体内にある力のみ封印することを選んだんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210308
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210308,
					"content": "その後、あれはただの人のように、己の意志を頼りに稲妻の土地を彷徨い続けた…ファデュイに目をつけられるまでは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210309
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210309,
					"content": "ファデュイ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20210310,
					"content": "そしてその原型の人形は、ファデュイたちに調整され、力の封印が解かれたんじゃ。いや、封印前よりも強大になっているかもしれぬな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210311
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210311,
					"content": "まさか…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210312
					]
				},
				{
					"id": 20210312,
					"content": "うむ、神の造物であり、神の心を奪った者…原型の人形とは「散兵」のことじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210313
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210313,
					"content": "そ、そんなことがあったなんて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210314
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20210314,
					"content": "そうじゃな、偶然と言うべきか、運命と言うべきか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210301,
						20210401,
						20210501,
						20210601,
						20210701
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210401,
					"content": "前任の雷電将軍について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210402
					]
				},
				{
					"id": 20210402,
					"content": "汝のような異郷の者が、雷神が変わったことを知っているとはな…稲妻の民ですら滅多に知られておらぬことじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210403
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210403,
					"content": "鍾…モラクスが言ってたんだ、雷神バアルが亡くなったって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20210404,
					"content": "うむ。じゃが事実を言えば、「バアル」と「バアルゼブル」は双生の魔神なんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210405
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210405,
					"content": "双生の…魔神？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20210406,
					"content": "彼女らは力を合わせて魔神戦争に勝利し、バアルが幕府を設立した後、バアルゼブルはバアルの御側として「影武者」となった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210407
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210407,
					"content": "バアルゼブルは汝らも知っているあの影じゃ。そしてバアルは、名を「眞」と言う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210408
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210408,
					"content": "世間からすれば、両者は常に一体の存在で、互いを補い合い、共に稲妻を治めてきた。よって人々が真相を知る必要もなかったんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210409
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210409,
					"content": "魔神「バアル」の名であれ、雷電将軍の肩書きであれ、常に両者を指すものと見なされていた。あの時までは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210410
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210410,
					"content": "あの時？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210411
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20210411,
					"content": "数百年前、妾が参加しなかった戦争で眞が死んでから、影が表舞台に出るようになったんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210412
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210412,
					"content": "影もショックだっただろうな、姉妹だから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210413,
						20210414
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20210413,
					"content": "数百年前の…戦争…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210415
					]
				},
				{
					"id": 20210415,
					"content": "影が変わったのもあの時からじゃ、あやつが「失ったもの」の中で一番大きかったのじゃろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210416
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210416,
					"content": "そんなことがあったのか…なんかだんだん影のことがわかってきたな…でも「眞」ってどんな神だったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210417
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20210417,
					"content": "彼女とは長い付き合いではなかったが、印象では…優しい神じゃった。常に目の前にある輝かしいものを大切にしていたな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210418
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210418,
					"content": "そうだったのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210301,
						20210401,
						20210501,
						20210601,
						20210701
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20210501,
					"content": "#{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_SISTER]}について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210502
					]
				},
				{
					"id": 20210502,
					"content": "すまぬ、それについては妾もさっぱりじゃ。汝らの言ったあの神についてもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210503
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210503,
					"content": "じゃが、もし汝らが影を疑っているのなら、それは少し考えすぎじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210504
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210504,
					"content": "影は、汝らが会ったという神の特徴と異なるだけでなく、遥か昔に神の心を自ら放棄し、天空の島との繋がりを断ち切っておるんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210505
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210505,
					"content": "会った後に彼女じゃないのは気づいてた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210506
					]
				},
				{
					"id": 20210506,
					"content": "それはよかった。さもなければ、雷神の眷属として、妾たちの関係も微妙なものとなってしまうからのう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210507
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210507,
					"content": "安心しろ、オイラたち、おまえとはケンカしたくないから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210508
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20210508,
					"content": "ふふふ…汝らが目的を達成できることを願おう。すべての真実を知るがよい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210509
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210509,
					"content": "#汝の{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}の痕跡については、妾も持てるすべてのものを利用して調査する。綾人から借りた終末番の手下も含めてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210510
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210510,
					"content": "何か情報を手に入れれば汝に通達しよう。これも報酬の一部じゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210301,
						20210401,
						20210501,
						20210601,
						20210701
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210601,
					"content": "次の旅の地点について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210602
					]
				},
				{
					"id": 20210602,
					"content": "稲妻の後は、そうじゃな…スメールに行くのが楽じゃろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210603
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210603,
					"content": "スメールか、これまでにもたくさんスメールの学者には会ってきたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20210604,
					"content": "うむ、スメールは知恵の神を持つ国。彼らの知恵と知識の探求は止まることを知らぬ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210605
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210605,
					"content": "じゃがその執着は、時に不可解なことに繋がることもある。例えば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210606
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210606,
					"content": "…スメールでは、知識は「資源」として統一管理されているんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210607
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210607,
					"content": "知識が…資源？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210608
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20210608,
					"content": "うむ。じゃが、その決断をしたのが「賢者」たちか「クラクサナリデビ」かは分からぬがな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210609
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210609,
					"content": "「クラクサナリデビ」？なんか可愛い名前だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210610
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20210610,
					"content": "ん？知らぬのか。「クラクサナリデビ」はスメールの信仰する神であり、スメール人が使う彼女への愛称じゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210611
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210611,
					"content": "汝らも彼女に確認したいことがあるんじゃろ？上手くいくことを願ってるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210301,
						20210401,
						20210501,
						20210601,
						20210701
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210701,
					"content": "もう聞くことはない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210702
					]
				},
				{
					"id": 20210702,
					"content": "そうか、分かった。そうじゃ旅人、妾が送った御守りはまだあるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210703
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210703,
					"content": "もちろん、大事にとっておくつもり。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210704
					]
				},
				{
					"id": 20210704,
					"content": "大事にとっておく、それだけか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210705
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210705,
					"content": "妾はてっきり、汝がそれを胸の前の一番目立つ場所にかけ、これは英知と美貌を兼ね備えた八重神子様からの贈り物だということを、これから会う人一人一人に言うのかと思っておったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210706
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210706,
					"content": "誰がそんなことするんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210707
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20210707,
					"content": "ふふ…まあよい。ところで、汝の願いはなんじゃ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210708
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210708,
					"content": "#えっと…{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_SISTER]}を見つけること？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210709
					]
				},
				{
					"id": 20210709,
					"content": "そうか…じゃが、それは汝の小さな目標にすぎぬと妾は思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210710
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210710,
