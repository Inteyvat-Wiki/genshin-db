			"dialogs": [
				{
					"id": 413430701,
					"content": "旅人、蒲公英の種は撒いてくれた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430702
					],
					"speakerTitle": "フレーキ"
				},
				{
					"id": 413430702,
					"content": "撒いたよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413430703
					]
				},
				{
					"id": 413430703,
					"content": "よかった。蒲公英が風に乗ってモンド城に着きますように…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430704
					],
					"speakerTitle": "フレーキ"
				},
				{
					"id": 413430704,
					"content": "でも、璃月に溶け込むって言ったけど…姉さん、結局モンドの習慣が忘れられないじゃないか。だったら今日はモンドの食べ物を——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430709
					],
					"speakerTitle": "ジェリー"
				},
				{
					"id": 413430709,
					"content": "それはだめよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430710
					],
					"speakerTitle": "フレーキ"
				},
				{
					"id": 413430710,
					"content": "えっ…え？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430705
					],
					"speakerTitle": "ジェリー"
				},
				{
					"id": 413430705,
					"content": "——モンドの習慣を忘れないことと、璃月に溶け込むことは関係ないわ。早く霄灯を飛ばしに行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430706
					],
					"speakerTitle": "フレーキ"
				},
				{
					"id": 413430706,
					"content": "願い事は書いた？霄灯を飛ばしたら…海灯祭の特別料理を一緒に食べるわよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430707
					],
					"speakerTitle": "フレーキ"
				},
				{
					"id": 413430707,
					"content": "か、書いたけど、本当に食べるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430708
					],
					"speakerTitle": "ジェリー"
				},
				{
					"id": 413430708,
					"content": "ふん、もちろんよ。璃月海灯祭の特別料理…絶対に味わっておきたいもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フレーキ"
				}
			]
		}
	]
