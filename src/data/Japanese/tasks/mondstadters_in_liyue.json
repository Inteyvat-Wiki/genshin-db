					"フレーキ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413430501,
					"content": "ありがとう。モンドを離れてすぐなのに、こんなに恋しくなるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430502
					],
					"speakerTitle": "ジェリー"
				},
				{
					"id": 413430502,
					"content": "家族が何してるのか気になるわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430503
					],
					"speakerTitle": "フレーキ"
				},
				{
					"id": 413430503,
					"content": "でもせっかくの機会だから…姉さん、なにか願い事ある？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430504
					],
					"speakerTitle": "ジェリー"
				},
				{
					"id": 413430504,
					"content": "私？そうね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430505
					],
					"speakerTitle": "フレーキ"
				},
				{
					"id": 413430505,
					"content": "これでよし。旅人、もう一つお願いしたいことがあるんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430506
					],
					"speakerTitle": "フレーキ"
				},
				{
					"id": 413430506,
					"content": "蒲公英の種を高いところから撒いてほしいの。璃月とモンドの建物はだいぶ違うから、私とジェリーじゃ、どうやって高いところまで行けばいいか分からないのよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430507
					],
					"speakerTitle": "フレーキ"
				},
				{
					"id": 413430507,
					"content": "高いところから蒲公英の種を撒いてくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430508
					],
					"speakerTitle": "フレーキ"
				},
				{
					"id": 413430508,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413430509
					]
				},
				{
					"id": 413430509,
					"content": "じゃあお願いね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フレーキ"
				}
			]
		},
