			},
			"dialogs": [
				{
					"id": 413430301,
					"content": "ありがとう。それで、ここに願い事を書けばいいのかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430302
					],
					"speakerTitle": "フレーキ"
				},
				{
					"id": 413430302,
					"content": "なるほど…じゃあ何を書くか考えなきゃね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430303
					],
					"speakerTitle": "フレーキ"
				},
				{
					"id": 413430303,
					"content": "これでいいと思うわ。そういえば、願いを霄灯に乗せて空まで飛ばす…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430304
					],
					"speakerTitle": "フレーキ"
				},
				{
					"id": 413430304,
					"content": "それで思い出したんだけど、モンドでは悩み事を蒲公英に言って、種を風で飛ばすの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430305
					],
					"speakerTitle": "フレーキ"
				},
				{
					"id": 413430305,
					"content": "確かに、モンドが恋しくなってきた…もう随分蒲公英を見てない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430306
					],
					"speakerTitle": "ジェリー"
				},
				{
					"id": 413430306,
					"content": "旅人、もう一つお願いできないかしら？蒲公英の種を見つけてきてくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430307
					],
					"speakerTitle": "フレーキ"
				},
				{
					"id": 413430307,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413430308
					]
				},
				{
					"id": 413430308,
					"content": "本当に？ありがとう。蒲公英の種が見つかったら私のところまで来てね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フレーキ"
				}
			]
		},
