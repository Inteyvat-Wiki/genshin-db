				"points": []
			},
			"dialogs": [
				{
					"id": 413430101,
					"content": "でも霄灯ってどうやって作るの？…姉さん、知ってる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430102
					],
					"speakerTitle": "ジェリー"
				},
				{
					"id": 413430102,
					"content": "私も知らないわ…誰かに頼んで作ってもらえないかしら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430103
					],
					"speakerTitle": "フレーキ"
				},
				{
					"id": 413430103,
					"content": "霄灯を飛ばしたいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413430104
					]
				},
				{
					"id": 413430104,
					"content": "あら、旅人。霄灯を飛ばす…うん、実は結構気になるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430105
					],
					"speakerTitle": "フレーキ"
				},
				{
					"id": 413430105,
					"content": "先に海灯祭の特別料理を味わいに行くつもりだったんだけど、ジェリーが海灯祭伝統の霄灯飛ばしをしたいって言うのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430106
					],
					"speakerTitle": "フレーキ"
				},
				{
					"id": 413430106,
					"content": "だ…だって！祭りの伝統をやってから、名物料理を食べた方が、祭りに溶け込めると思うんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430107
					],
					"speakerTitle": "ジェリー"
				},
				{
					"id": 413430107,
					"content": "それに霄灯は願い事もできるって聞いたけど…どうやって作るか分からないの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430108
					],
					"speakerTitle": "フレーキ"
				},
				{
					"id": 413430108,
					"content": "旅人、悪いけど霄灯を一つ作ってくれないかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430109
					],
					"speakerTitle": "フレーキ"
				},
				{
					"id": 413430109,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413430110
					]
				},
				{
					"id": 413430110,
					"content": "じゃあお願いね。私たちはここで待ってるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フレーキ"
				}
			]
		},
