			"dialogs": [
				{
					"id": 737080101,
					"content": "ん？いま向こうにキノコンが飛んでったぞ。大丈夫なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737080102,
					"content": "普通に考えて、キノコンが街の中をうろついてるなんて、ちょっと危ないよな！訓練を受けた、すっごく聞き分けのいいやつなら話は別だけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737080103,
					"content": "ん？なんかデジャヴだな。前にも似たようなことなかったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080104,
						737080107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737080104,
					"content": "待って、ポコポコビーニーじゃない！？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080105
					]
				},
				{
					"id": 737080105,
					"content": "そうだ！スメールで出会ったキノコンの仲間のポコポコビーニーだ！きっとあいつだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737080106,
					"content": "ずいぶん久しぶりだな！早く会いに行こうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737080107,
					"content": "話は別って？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080108
					]
				},
				{
					"id": 737080108,
					"content": "ほら…いただろ？ポコポコビーニーだっけ？スメールで知り合ったキノコンの仲間…もしかして、あいつじゃないのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737080109,
					"content": "ずいぶん久しぶりだな！早く会いに行こうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
