			"dialogs": [
				{
					"id": 737080301,
					"content": "ふぅ…やっと着いたな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737080302,
					"content": "けっこう遠かったけど、「懸木の民」の彩晶の頂なら、キノコンの仲間たちにとっても物珍しいはずだよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737080303,
					"content": "風景画が何枚かあるから、キノコンの仲間たちに実際の景色と見比べてもらおうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737080304,
					"content": "よーく観察するきっかけになるぞ。ほら、見比べると、ぱっと見じゃ気づかない細かいところにも目が行くだろ。きっと、じっくり景色を楽しめるぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737080305,
					"content": "♪♫！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080306
					],
					"speakerTitle": "ポコポコビーニー"
				},
				{
					"id": 737080306,
					"content": "♫…♩？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080307,
						737080308
					],
					"speakerTitle": "喜炎"
				},
				{
					"id": 737080307,
					"content": "斬新なやり方だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080309
					]
				},
				{
					"id": 737080309,
					"content": "へへっ、オイラも暇な時はガイドのしおりを読み返して、観光名所とか調べてるんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737080310,
					"content": "それもこれも、最高のガイドでいるためだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737080311,
					"content": "よし、キノコンの仲間にやってみてもらおうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737080308,
					"content": "パイモンも結構考えてるんだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080309
					]
				}
			]
		}
