			"dialogs": [
				{
					"id": 737080201,
					"content": "どうやら伝言は無事に伝わったようね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080202
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 737080202,
					"content": "また会えたわね、「ゴールド流星」、「シルバー伴星」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080203
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 737080203,
					"content": "変わらず元気そうね。なんだか時間が止まってるみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080204,
						737080208
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 737080204,
					"content": "ハニヤー、久しぶり！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080205
					]
				},
				{
					"id": 737080205,
					"content": "本当におまえたちだったんだな！ハニヤーとポコポコビーニー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737080206,
					"content": "どうりで伝言を見た時、なんだか懐かしい感じがしたわけだぜ…オイラとポコポコビーニーの絆は健在だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737080207,
					"content": "～♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080212
					],
					"speakerTitle": "ポコポコビーニー"
				},
				{
					"id": 737080212,
					"content": "実はどう再会するか、色々考えていたのよ。豪華なパーティとか、歓迎式とか、サプライズとかね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080213
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 737080213,
					"content": "でも、それだとかえって他人行儀な気もするし、二人とも忙しいから、あまり長く引き止めるのは迷惑かと思って、自然な形にしたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080214
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 737080214,
					"content": "それに、キノコンの仲間たちも静かな環境が好きだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080215
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 737080215,
					"content": "素晴らしいと思います！このところ散文を読んでいたおかげか、やっと穏やかに過ごすことの価値に気づかれましたね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080216
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 737080216,
					"content": "やっぱり、こうやって気楽にお喋りするのが一番楽しいですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080217
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 737080217,
					"content": "～♫",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080218
					],
					"speakerTitle": "喜炎"
				},
				{
					"id": 737080218,
					"content": "左右加さん！喜炎も久しぶりだな。それと、そっちはたしか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080219
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737080219,
					"content": "私のキノコンの仲間、信風舞姫ですよ。あの時は、ベスト三十二でポコポコビーニーにあっという間に倒されちゃいましたね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080220
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 737080220,
					"content": "おお、さすが左右加さん！よく覚えてるな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080221,
						737080222
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737080221,
					"content": "懐かしい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080223
					]
				},
				{
					"id": 737080223,
					"content": "でも、お二人とも！もう次に会う時間や場所を約束する必要はありませんよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080224
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 737080224,
					"content": "ハニヤーと私でここを買い取って、「ちびチエキノコンの森」に改装したんです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080225
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 737080225,
					"content": "えっ！つまり…ここの施設はテーブルゲームのために一時的に借りたんじゃなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080226
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737080226,
					"content": "そう。これから私たちはずっとバイダ港で生活して、人々にキノコンのテーブルゲームや、動物たちと交流する方法を広めていくつもりなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080227
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 737080227,
					"content": "時間があれば、いつでもキノコンの仲間たちと遊びに来てくださいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080228
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 737080228,
					"content": "～♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080229,
						737080230
					],
					"speakerTitle": "ポコポコビーニー"
				},
				{
					"id": 737080229,
					"content": "やったー！キノコンの仲間と遊び放題！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080231
					]
				},
				{
					"id": 737080231,
					"content": "おおおー！最高だぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080232
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737080232,
					"content": "実は最初のキノコン大会の後、オイラ、ポコポコビーニーと一緒にできる遊びをたくさん考えてたんだ。いろいろ試して行けそうだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080233
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737080233,
					"content": "こんなところで…高かったでしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080234
					]
				},
				{
					"id": 737080234,
					"content": "ご安心を！モラの問題はありません！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080235
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 737080235,
					"content": "ここしばらくは、バルフォアさんの助けのもと、「チエキノコン布陣」と「ちびチエキノコン大合戦」で資金を稼ぐ以外にも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080236
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 737080236,
					"content": "過去の経験を活かして、テイムやキノコンに関する多くの知識を体系的な理論としてまとめ、何冊か本を出したの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080237
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 737080237,
					"content": "資金援助をしてくれた学者もいるのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080238
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 737080238,
					"content": "積み重ねてきた知識でたくさんの人の暮らしを便利にして、その報酬としてモラを貰って…そのモラで、キノコンの仲間たちにより良い暮らしをしてもらう。まさに好循環ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080239
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 737080239,
					"content": "す、すごいな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080240
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737080240,
					"content": "一人前の「テイム理論のプロ」って感じだぞ。どんな問題も解決できそうだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080241
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737080241,
					"content": "左右加がいてくれたおかげよ。彼女の助言があったからこそ、私は学生たちと同じように、学ぶべきスキルを頑張って身につけられたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080242
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 737080242,
					"content": "んもう、こういう時は謙遜するものじゃありませんよ。私はそこまですごくないですから！素直に褒められてください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080243,
						737080244
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 737080243,
					"content": "簡単に言うけど、きっと大変だったよね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080245
					]
				},
				{
					"id": 737080245,
					"content": "確かに、多くの難題に直面したわ。でも、過去の苦しみなんて、時の流れとともに忘れ去ったほうがいいでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080246
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 737080246,
					"content": "一番の心残りは——ここ一年、キノコンの仲間たちをあまり外へ遊びに連れて行ってあげられなかったことよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080247
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 737080247,
					"content": "独自のテイム理論をまとめ始めてからは、ほとんどの時間を洞窟やツリーハウスの中で過ごして、昼夜逆転したような執筆生活を送ってたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080248
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 737080248,
					"content": "ビジネスの付き合いは疲れるし、原稿に追われる日々も本当に大変。左右加の気持ちが、前よりも理解できるようになったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080249
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 737080249,
					"content": "でも、嫌な事ばかりじゃないでしょう？原稿を書き上げた瞬間の達成感と言ったら！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080250
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 737080250,
					"content": "ふふ、同感よ。書き上げるたびに、思いっきり好きなものを食べてお祝いしたくなっちゃうわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080251
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 737080251,
					"content": "でも、キノコンの仲間たちは私たちの食事を楽しめない。もしかするとあの子たちにとって、人との生活は味気ないものなのかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080252
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 737080252,
					"content": "このままじゃ、仲間たちの精神状態にかかわるでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080253
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 737080253,
					"content": "それなら、二人も住む場所が決まってなんとか落ち着いたところみたいだし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080254
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737080254,
					"content": "オイラたち二人がキノコンの仲間たちを連れて遊びに行くってのはどうだ？キノコンたちの気が済むまで遊んだら、送り届けるからさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080255
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737080255,
					"content": "そうすれば、おまえたちは手元の仕事に集中できるし、キノコンの仲間たちも思いっきり遊べるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080256,
						737080257
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737080256,
					"content": "いいアイデアだね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080258
					]
				},
				{
					"id": 737080258,
					"content": "いい考えですね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080259
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 737080259,
					"content": "私は頭が固いので、どこに遊びに行けばいいかとか、よくわからないんですよね…どこに行こうか決める時も、結局いつも本頼りで。その上すごい方向音痴で、実は初めてフォンテーヌに行ったときも、迷子になって笑われちゃったんですよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080260
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 737080260,
					"content": "ハニヤーなんてもっとひどいんですよ、スメールにどんな楽しい場所があるのかさえ知らないんですから。仕事漬けの弊害ですね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080261
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 737080261,
					"content": "前回だって、フォンテーヌにずいぶん長くいたのに、スケジュールをぐちゃぐちゃに組んじゃって、行きたかったスイーツ屋さんに行けなかったんです。ずっと気になってたマカロンも食べ損ねちゃって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080262
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 737080262,
					"content": "コホン…二人なら、きっとキノコンの仲間たちをいろんな場所に連れて行って、思いっきり遊ばせてあげられるはずよ。みんなの世界を広げてあげてちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080263,
						737080264
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 737080263,
					"content": "それなら、気合を入れて探さないとね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080265
					]
				},
				{
					"id": 737080265,
					"content": "ちょっと待って。この写真機を持っていってほしいの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080266
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 737080266,
					"content": "ハニヤーは、一見何の変哲もない写真機を取り出し、ポコポコビーニーの頭の上に乗せた。ポコポコビーニーは意外にも、写真機を落さずしっかりと乗せたままにしている。どうやら物を乗せて飛ぶことには慣れているようだ…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						737080267
					]
				},
				{
					"id": 737080267,
					"content": "見た目はごく普通だけど、特別な記念の品なのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080268
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 737080268,
					"content": "ポコポコビーニーは、アパーム叢林南部で迷子になってた商人の子供を助けたことがあるの。その時商人からたくさんのお礼をもらってね…その中に入ってたのが、この写真機。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080269
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 737080269,
					"content": "この子、この写真機で撮った写真が好きなのよ。だから、遊びに行ったときは、これを使って記念撮影してあげて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080270
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 737080270,
					"content": "専門家のエレーヌさんに改造してもらったから、ポコポコビーニーの好きな湿度の高い環境や、水の中でも使えるようになってるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080271
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 737080271,
					"content": "ポコポコビーニーの勲章ってことだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080272,
						737080273
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737080272,
					"content": "偉いね、ポコポコビーニー！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080274
					]
				},
				{
					"id": 737080274,
					"content": "～♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080275
					],
					"speakerTitle": "ポコポコビーニー"
				},
				{
					"id": 737080275,
					"content": "#オイラと{NICKNAME}は写真のプロだから、任せろ！どんな写真機でも一流のものを撮ってきてやるぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080276
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737080276,
					"content": "#{NICKNAME}、準備が済んだら行こうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080277
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737080277,
					"content": "いつもの荷物だけじゃなくって、キノコンたちのための特別なご飯もいるよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080278
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737080278,
					"content": "よく覚えてたわね。はい、「マーベラスゼリー」を持っていってちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080279
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 737080279,
					"content": "最新版は食感と日持ちにこだわってみたの。どんなに暑い環境でも、そう簡単には腐らないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080280
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 737080280,
					"content": "でも、一度にあげすぎちゃだめですよ。食べすぎ注意です！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080281
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 737080281,
					"content": "へへっ、わかってるって。ゼリーはバッグにしまってっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080282
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737080282,
					"content": "お土産と一緒に帰ってくるから、楽しみに待っててくれよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737080273,
					"content": "ビーニー、すごい！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080274
					]
				},
				{
					"id": 737080264,
					"content": "楽しくて景色もいいところを選ぶよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080265
					]
				},
				{
					"id": 737080257,
					"content": "#{M#俺}{F#私}もキノコンの仲間と遊びたい！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080258
					]
				},
				{
					"id": 737080244,
					"content": "大変な部分が端折られてるような…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080245
					]
				},
				{
					"id": 737080230,
					"content": "これからは頻繁に会えるね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080231
					]
				},
				{
					"id": 737080222,
					"content": "なんだか落ち着くね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080223
					]
				},
				{
					"id": 737080208,
					"content": "こんにちは。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080209
					]
				},
				{
					"id": 737080209,
					"content": "本当にハニヤーとポコポコビーニーだったんだな！サウマラタ蓮杯テイマー大会…懐かしいな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737080210,
					"content": "確かあの後、オルモス港の近くとか、フォンテーヌ廷でも会ったよな？気づけば長い友達だぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737080211,
					"content": "～♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080212
					],
					"speakerTitle": "ポコポコビーニー"
				}
			]
		},
