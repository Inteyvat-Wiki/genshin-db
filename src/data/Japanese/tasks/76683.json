				]
			},
			"dialogs": [
				{
					"id": 766830101,
					"content": "…着弾時点の破壊力は申し分ない。集弾性も理想的だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766830102
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 766830102,
					"content": "チャスカさん。執律庭の武器部門評価基準から判断すると、この武器は「大砲級」の水準に達してる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766830103
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 766830103,
					"content": "ただ…この「銃」を配置するには二組の人手が必要だ。残念だが、実践での操作ハードルが高すぎる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766830104
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 766830104,
					"content": "認めていただき感謝する。実は、実践におけるハードルが高すぎるのは必ずしも悪いこととは言えないんだ。シロネンに「スピリットリボルバー・ライトワンド」を発注した時点ですでに、私たちはこんな共通認識に辿りついてた——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766830105
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 766830105,
					"content": "強力な武器ほど、厳格な使用基準が必要だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766830106
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 766830106,
					"content": "武器自体の操作を難しくするだけでなく、この手の武器には「モラル認証ロック」のような仕組みをつけるべきだとすら思ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766830107
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 766830107,
					"content": "そうじゃないと、武力は必ずしも正しい人間の手に渡るとは限らない。そういうシステムがあれば、強力な武器が悪党に盗まれて、甚大な被害をもたらすのを防げるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766830108
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 766830108,
					"content": "確かに、フォンテーヌでも、盗まれた武器が犯罪に使われるケースは珍しくありません。チャスカさまのご懸念もごもっともですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766830109
					],
					"speakerTitle": "トゥレーヌ"
				},
				{
					"id": 766830109,
					"content": "わぁ！懐かしい顔ぶれだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766830110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766830110,
					"content": "フォンテーヌの執律庭、ナタの「花翼の集」…それにモンドの騎士か？みんな集まって、なにしてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766830111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766830111,
					"content": "交流会？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766830112
					]
				},
				{
					"id": 766830112,
					"content": "また合同演習？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766830113
					]
				},
				{
					"id": 766830113,
					"content": "その通りだ。一目で状況を理解するとはな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766830114
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 766830114,
					"content": "以前、特巡隊はトゥレーヌを璃月へ派遣し、合同演習に参加させたが…その時の演習をきっかけに、各地域で活躍する部隊とよく交流するようになったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766830115
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 766830115,
					"content": "今回はフォンテーヌとモンドの定例会——「射撃推理大会」だ。それぞれの組織に属する戦士たちの、戦場における計画能力向上を目的としている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766830116
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 766830116,
					"content": "西風騎士団の方々が橋渡しをしてくれたおかげで、今回はナタ「花翼の集」の戦士たちも演習に参加してくださっているんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766830117
					],
					"speakerTitle": "トゥレーヌ"
				},
				{
					"id": 766830117,
					"content": "「花翼の集」の戦士たちは飛行中の射撃が得意なんです。新しい戦い方を見れて感激です！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766830118
					],
					"speakerTitle": "トゥレーヌ"
				},
				{
					"id": 766830118,
					"content": "なるほど…騎士たちは遠征の途中でナタの戦士たちと知り合ったのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766830119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766830119,
					"content": "でも、「射撃推理大会」ってどういうことだ？一つ一つの言葉はわかるのに、繋げるとよくわからないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766830120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766830120,
					"content": "射撃って、銃を撃てばそれで終わりでしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766830121
					]
				},
				{
					"id": 766830121,
					"content": "弾丸がどうやって推理するの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766830122
					]
				},
				{
					"id": 766830122,
					"content": "ははっ。もし無限の弾薬が使えたなら、引き金を引きっぱなしにするだけで、大半の敵は簡単に片付くだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766830123
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 766830123,
					"content": "でも、戦闘は長丁場だ。そして射撃手が持ち歩ける弾薬は限られてる。一発一発、可能な限り正確に、戦略を練って撃たないといけない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766830124
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 766830124,
					"content": "だから、射撃手が自身の理解力を高められるよう、騎士団は新型の弾を開発した。原理は少し複雑だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766830125
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 766830125,
					"content": "具体的な原理については、西風騎士団に聞いてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766830126
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 766830126,
					"content": "ごめんごめん！報告書の整理でいっぱいいっぱいで、栄誉騎士と白い助手さんに気づかなかったわ。改めて、こんにちは！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766830127
					],
					"speakerTitle": "ヘドウィグ"
				},
				{
					"id": 766830127,
					"content": "あたしはヘドウィグ、西風騎士団「総務部隊」のメンバーよ。今回の演習の記録担当で、槍職人たちと味方部隊の連携をバックアップしてるの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766830128
					],
					"speakerTitle": "ヘドウィグ"
				},
				{
					"id": 766830128,
					"content": "そういえば、今回の装置は君たちにも関係があるのよ。ダダウパの谷に現れた謎のヒルチャールシャーマン像のこと、覚えてない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766830129
					],
					"speakerTitle": "ヘドウィグ"
				},
				{
					"id": 766830129,
					"content": "うっすら覚えてるよ。けっこう前のことだよね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766830130
					]
				},
				{
					"id": 766830130,
					"content": "覚えてないんだけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766830131
					]
				},
				{
					"id": 766830131,
					"content": "うーん、うっすらとしか覚えてないぞ。なんだっけか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766830132
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766830132,
					"content": "うん。じゃあ事の顛末を、かいつまんで話すわね——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766830133
					],
					"speakerTitle": "ヘドウィグ"
				},
				{
					"id": 766830133,
					"content": "「調査小隊」は結局、その像は古代のヒルチャールシャーマンが造った物だと判断したわ。「スープを分け与える者」チャルデリックが無人の秘境を改造して、陣形のシミュレーションに使ってたらしいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766830134
					],
					"speakerTitle": "ヘドウィグ"
				},
				{
					"id": 766830134,
					"content": "あの時、栄誉騎士がチャルデリックの影を破壊したことで秘境が崩壊して、陣形を監督していた「ウパノの目」が散らばって出てきたのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766830135
					],
					"speakerTitle": "ヘドウィグ"
				},
				{
					"id": 766830135,
					"content": "「支援小隊」はサンプルを回収した後、細かく分解、分析して、半年以上かけて技術を完全に解明してから、璃月の「監視装置」の技術と組み合わせて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766830136
					],
					"speakerTitle": "ヘドウィグ"
				},
				{
					"id": 766830136,
					"content": "新しく「可視榴弾」を作り出したの。遠距離偵察で射撃手が安全な位置から情報を得るために使うことを目的としてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766830137
					],
					"speakerTitle": "ヘドウィグ"
				},
				{
					"id": 766830137,
					"content": "思ったより複雑な話だったぞ…まさか、オイラたちがあんまり気にせずやっつけちゃったやつが、そんなお宝を残してたなんてな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766830138
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766830138,
					"content": "「可視榴弾」は演習においても、射撃手たちに弾が飛んでいる過程の光景を見せ、弾道や障害物への理解を深めさせることができる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766830139
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 766830139,
					"content": "射撃訓練後の反省会と組み合わせれば、より良い射撃角度を「推理」し、目標を攻撃する順序を最適化して、作戦効率を大幅に向上させることができるのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766830140
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 766830140,
					"content": "クク竜に乗って戦う「花翼の集」の竜騎士には、ずっと「どう当たったか確認しづらい」って悩みがあったんだ。空を飛んでる分、ターゲットが遠すぎてな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766830141
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 766830141,
					"content": "この「可視榴弾」があれば、より効率的に「損傷評価」を行える——特巡隊から学んだ「損傷評価」の概念は非常に的確だから、使わせてもらってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766830142,
						766830143
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 766830142,
					"content": "けっこうよさげだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766830144
					]
				},
				{
					"id": 766830144,
					"content": "すでに、演習参加者はそれぞれのトップ——シュヴルーズ隊長とチャスカさんの立てた訓練計画をぜーんぶこなしたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766830145
					],
					"speakerTitle": "ヘドウィグ"
				},
				{
					"id": 766830145,
					"content": "演習サンプルを集めれば、推理大会も無事終わりってとこまで来てるんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766830146
					],
					"speakerTitle": "ヘドウィグ"
				},
				{
					"id": 766830146,
					"content": "せっかく栄誉騎士も来てることだし、よかったら参加してもらわない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766830147
					],
					"speakerTitle": "ヘドウィグ"
				},
				{
					"id": 766830147,
					"content": "大賛成です！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766830148
					],
					"speakerTitle": "トゥレーヌ"
				},
				{
					"id": 766830148,
					"content": "#「千霊映影祭」で初めて知ったんですけど、{NICKNAME}は命中精度もヒラメキもどちらも満点の射手なんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766830149
					],
					"speakerTitle": "トゥレーヌ"
				},
				{
					"id": 766830149,
					"content": "ああ、確かにうってつけだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766830150
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 766830150,
					"content": "#ここ数年で{NICKNAME}の射撃技術がどれほど上達したのか、興味ある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766830151
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 766830151,
					"content": "#演習の観点から見ても、{NICKNAME}は「可視榴弾」のメカニズムを全く知らないはずだから、見事な対照群になってくれるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766830152
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 766830152,
					"content": "オイラたち、「可視榴弾」の誕生とも縁があるみたいだし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766830153
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766830153,
					"content": "せっかくだから、体験してようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766830154,
						766830155
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766830154,
					"content": "それなら、本気で挑まないとね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766830156
					]
				},
				{
					"id": 766830156,
					"content": "おう、できて損はないと思うぞ。この先…銃だけで敵を倒さなきゃいけない時が来るかもしれないしな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766830157
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766830157,
					"content": "やったー！さっそく演習場の準備に取り掛かるわね！標的役のみんなにも教えてこなくちゃ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766830158
					],
					"speakerTitle": "ヘドウィグ"
				},
				{
					"id": 766830158,
					"content": "ルールは簡単！できるだけ少ない「弾道調整」回数で、効率よくすべての標的を倒してね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766830159
					],
					"speakerTitle": "ヘドウィグ"
				},
				{
					"id": 766830159,
					"content": "先に言っておくが、今回の演習は難易度がやや高い。特巡隊の前任射撃教官であるアンジェニーナでさえ、かろうじて合格できた程度だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766830160
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 766830160,
					"content": "だが、お前ならきっと、目をみはるような好成績を収めてくれるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766830161
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 766830161,
					"content": "もちろん、気負う必要はない。射撃には技術だけでなく、羽数枚分ほどの重さのヒラメキと、ほんの少しの運が必要な時もあるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766830162
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 766830162,
					"content": "テストではなく、ちょっとしたゲームだとでも思ってくれればいい。案外、楽しめるかもしれないぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 766830155,
					"content": "#射撃の練習は{M#俺}{F#私}にとってもタメになるし。",
