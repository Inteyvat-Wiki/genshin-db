				"points": []
			},
			"dialogs": [
				{
					"id": 726680101,
					"content": "よかったな。かつて「海中月」を追いかけてた人たちが、みんな自分の願いを叶えられた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726680102,
					"content": "みんな叶えられた？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726680103
					]
				},
				{
					"id": 726680103,
					"content": "ほら、嘉瑋は裕福なお嫁さんをもらっただろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726680104,
					"content": "ナンタックは「海中月」の秘密を書いた本を出して、人気作家になった。内容は間違ってたけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726680105,
					"content": "鯨井さんは稲妻で一番すごい釣り師になった。しかも今日、お父さんが捕まえられなかった「海中月」を捕まえた！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726680106,
					"content": "#だからオイラも、{NICKNAME}の願いが叶えられるって信じてる！えへへ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726680107,
					"content": "パイモンはどんな願い事を祈ったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726680108
					]
				},
				{
					"id": 726680108,
					"content": "言わないぞ！言葉に出したら叶えられないって言うだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726680109,
					"content": "「海中月」はそんなケチじゃないのに。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726680110
					]
				},
				{
					"id": 726680110,
					"content": "うぅ——わかったよ、いいか、一回しか言わないからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726680111,
					"content": "オイラの願いは、おまえの願いを叶えることだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726680112,
					"content": "声が小さい、なんて？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726680113
					]
				},
				{
					"id": 726680113,
					"content": "ふんっ、一回しか言わないから、聞こえてなくても関係ない！オイラ、飴買いに行くぜ～ふふん～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
}