					"マーガレット"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4870301,
					"content": "「リトルプリンス」～！やっと帰ってきてくれた。どこに行ったのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870302
					],
					"speakerTitle": "マーガレット"
				},
				{
					"id": 4870302,
					"content": "かなり探したんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4870303,
					"content": "もう「リトルプリンス」、私を見捨てないでちょうだい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870304
					],
					"speakerTitle": "マーガレット"
				},
				{
					"id": 4870304,
					"content": "おいおい、「二人の世界」に入っちゃったよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4870305,
					"content": "星鉄の弦もあったぞ。ほら、吟遊野郎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4870306,
					"content": "本当に見つけてくれたんだ。もう諦めかけてたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870307
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 4870307,
					"content": "感謝の気持ちに、この弦で「貸切ステージ」を用意してあげたいくらいだ…は…は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870308
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 4870308,
					"content": "は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4870309,
					"content": "くしゅん——っ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870310
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 4870310,
					"content": "ぐすっ…あははっ…「リトルプリンス」がこんなに近くにいると、猫アレルギーがまた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870311
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 4870311,
					"content": "どうりで自分で捕まえられなかったわけだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4870312,
					"content": "えへっ、とにかく助かったよ。じゃあ、お先に…ふぁ、くしゅん——っ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウェンティ"
				}
			]
		},
