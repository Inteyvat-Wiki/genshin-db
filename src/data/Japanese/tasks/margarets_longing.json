			"trigger": {
				"objectNames": [
					"マーガレット"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4871001,
					"content": "私の「リトルプリンス」～！自分で帰ってくるなんてお利口さんね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マーガレット"
				},
				{
					"id": 4871002,
					"content": "はぁ…はぁ…あんなに苦労したのに、結局こうなるのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4871003,
					"content": "もう「リトルプリンス」、私を見捨てないでちょうだい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マーガレット"
				},
				{
					"id": 4871004,
					"content": "おいおい、「二人の世界」に入っちゃったよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4871005,
					"content": "その様子だと、猫がここに戻ってきたのは偶然だったのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 4871006,
					"content": "はははっ…捕まえられなかったからって落ち込まないで、君たちがいなかったらこうはならなかったかもしれないし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 4871007,
					"content": "どれどれ～、うん、星鉄の弦はやっぱりコイツが持ってたね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 4871008,
					"content": "感謝の気持ちに、この弦で「貸切ステージ」を用意してあげたいくらいだ…は…は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 4871009,
					"content": "は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4871010,
					"content": "くしゅん——っ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 4871011,
					"content": "ぐすっ…あははっ…「リトルプリンス」がこんなに近くにいると、猫アレルギーがまた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 4871012,
					"content": "どうりで自分で捕まえられなかったわけだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4871013,
					"content": "えへっ、とにかく助かったよ。じゃあ、お先に…ふぁ、くしゅん——っ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウェンティ"
				}
			]
		},
