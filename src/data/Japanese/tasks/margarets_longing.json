			"dialogs": [
				{
					"id": 4870101,
					"content": "…あの猫、君の猫だったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870102
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 4870102,
					"content": "吟遊野郎！おまえも手伝いに来てたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4870103,
					"content": "手伝い？手伝ってほしいのはボクの方だよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870104
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 4870104,
					"content": "あれ？でも今、マーガレットに「リトルプリンス」のことを聞いてたよな…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4870105,
					"content": "いや、ボクがスペアで持ってた<color=#00E1FFFF>星鉄の弦</color>が盗まれたんだ。その犯人が猫の「リトルプリンス」だったんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870106
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 4870106,
					"content": "モンドの生きとし生けるものが、自由を謳歌するのはいいことなんだけど…ちょっとばかし自由すぎるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870107
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 4870107,
					"content": "ハハハッ、「リトルプリンス」はやんちゃだからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870108
					],
					"speakerTitle": "マーガレット"
				},
				{
					"id": 4870108,
					"content": "これが子供に甘い親というものだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4870109
					]
				},
				{
					"id": 4870109,
					"content": "バルバトスみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4870110,
					"content": "あははっ…素敵な比喩だ。こほん、ひとまず「リトルプリンス」を見つけよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870111
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 4870111,
					"content": "今夜、演奏の予定が入ってるから、早くスペアの弦を取り戻さないと。下手したら、お客さんをがっかりさせちゃう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870112
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 4870112,
					"content": "そもそも、なんで猫が弦を盗むんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4870113,
					"content": "猫は毛糸玉が大好きだからよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870114
					],
					"speakerTitle": "マーガレット"
				},
				{
					"id": 4870114,
					"content": "えーっと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4870115,
					"content": "星鉄の弦には風元素の力が秘められてて、頑丈なんだ。だから、いつもは毛糸玉のようにぐるぐると巻いて持ち歩いてるんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870116
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 4870116,
					"content": "これは吟遊詩人の小さな秘密さ、フフン。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870117
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 4870117,
					"content": "へぇ…弦に風元素の力が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4870118,
					"content": "#よしっ、手がかりゲットだ！{NICKNAME}、さっそく<color=#00E1FFFF>「元素視角」</color>で確認してみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4870119,
					"content": "きっと、何かしら風元素の痕跡が残ってると思うぞ。たとえば…足跡とか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4870122,
					"content": "頼んだわね。「リトルプリンス」は商業エリアと住居エリアの近くにいるはずよ。いい？「リトルプリンス」は黒猫よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マーガレット"
				},
				{
					"id": 4870121,
					"content": "あっ…そうだ、この<color=#00E1FFFF>魚</color>は「リトルプリンス」の大好物だから、持っていけば何かと役立つはずよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マーガレット"
				}
			]
		}
	]
