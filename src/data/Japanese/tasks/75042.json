			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"マンク"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750420101,
					"content": "よう、最近はどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750420102
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750420102,
					"content": "どうした、何か確認したいことでもあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750420103,
						750420108,
						750420115
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750420103,
					"content": "「焔の主の祝福」について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750420104
					]
				},
				{
					"id": 750420104,
					"content": "「焔の主の祝福」…これは先祖返りの一種だと考える者がいる。なぜならその力には、血筋に由来する根源的なものがあると考えられているからだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750420105
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750420105,
					"content": "ただ…龍の遺物研究会の記録によれば、「焔の主の祝福」の印が付いてる仔竜のほとんどが、成長する過程で、体内の制御不能な力に影響されてしまう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750420106
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750420106,
					"content": "力が体の中で暴れまわるせいで、暴走したり、理性を失ったりして、普通の竜とは別のものになってしまうんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750420107
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750420107,
					"content": "クク竜の暴君「ホラワイガ」がいい例だ…ホラワイガは「焔の主の祝福」を受けていたと言われている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マンク"
				},
				{
					"id": 750420108,
					"content": "部族での「処分」について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750420109
					]
				},
				{
					"id": 750420109,
					"content": "つまり、あいつを夜神の国に帰すということだ。あいつは生まれてからずっと、龍や夜神の国に拒まれ続けていたかもしれないが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750420110
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750420110,
					"content": "この世を離れたら、夜に帰らなくてはならない。あいつにとっては冷たい事実だが、夜の国であいつは他の魂と共存できる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750420111
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750420111,
					"content": "勝手だと思われるかもしれないが…それもある種の優しさだと思っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750420112
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750420112,
					"content": "象徴物の手がかりはあるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750420113
					]
				},
				{
					"id": 750420113,
					"content": "あるにはあるが…確かめてみないと。次に俺を訪ねるときは、パカル——こだまの子の族長のところまで来てくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750420114
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750420114,
					"content": "見た目は少し…派手だが…最も固い晶石よりも頼もしい人物だと保証する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マンク"
				},
				{
					"id": 750420115,
					"content": "もう聞きたいことはないから、またね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750420116
					]
				},
				{
					"id": 750420116,
					"content": "友よ、またいつでも来てくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マンク"
				}
			]
		}
	]
}