					"nextDialogs": [
						111030712
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111030712,
					"content": "そうか、うん、なるほど、さすが吾輩。ははは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030713
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111030713,
					"content": "吾輩はきっと夢を見ているんだ！",
