						111030714
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111030714,
					"content": "おいおい…本当にどうしようもないやつだな、これじゃ意味ないんじゃないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030715,
						111030716
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111030715,
					"content": "これは夢じゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030717
					]
				},
				{
					"id": 111030717,
					"content": "ほう、何をする気だ？吾輩の夢の中で吾輩をどうしようと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030718
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111030718,
					"content": "よし…おしおきだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111030716,
					"content": "なぜなら…痛みを感じるから！",
