				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111030201,
					"content": "この香炉…よさそうだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111030202,
					"content": "少なくともこの寺ほどボロボロじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111030203,
					"content": "香炉のあとは…近くにある「七星灯」を集めようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 1110303,
			"completionStepIds": [
				1110303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110303",
							"2"
						],
						"stepId": 1110303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111030301,
					"content": "あれ、いないぞ？さっきまでここにいたのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111030302,
					"content": "物を取ったらすぐに帰ると思っていたが。まさか私のことを気に掛けてくれるなんてな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030330
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111030330,
					"content": "あっ！…さっきの人の声だ！おーい、どこにいるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111030303,
					"content": "私の体は、千年も前にとっくに消えている。君たちが先ほど見たのは「浮世留形法」によって作られた幻影さ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111030304,
					"content": "たった今君たちが「浮世留形法」に使っていた香炉と七星灯を持っていったからね、必然的に私の姿も消えたのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030305,
						111030306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111030305,
					"content": "まさか…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030308
					]
				},
				{
					"id": 111030308,
					"content": "私は元々夜叉の一人だった。岩王帝君が授けてくれた名は「銅雀」、数千年前に力が及ばず戦死した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111030309,
					"content": "今日は私の命日でね。現代の璃月がどうしても見たくて、無作法ながらもこの術を使ったのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111030310,
					"content": "ところで…君たちは「降魔大聖」のところから来たのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111030311,
					"content": "知り合いだったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111030312,
					"content": "君たちから彼の気配を感じてね…それと、その濃い「業障」の気配も…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111030313,
					"content": "そうか…数千年も経つのに、彼はまだあの苦痛に耐えているのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030314
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111030314,
					"content": "…自分が恥ずかしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030315
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111030315,
					"content": "そんなこと言わずに、「銅雀」さんだって璃月のために命を捧げたんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030316
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111030316,
					"content": "命は大切なものだが…「降魔大聖」が負っているものに比べたら、死すら安らぎとも言える。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030317
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111030317,
					"content": "「銅雀」さん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030318
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111030318,
					"content": "はは、すまないね。誕生日は楽しく、命日は悲しく、なんてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030319
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111030319,
					"content": "「浮世留形法」の効力もあとわずかで終わる。二人とも達者で、ついでに彼によろしく言っておいてくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030320,
						111030321
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111030320,
					"content": "はい、必ず！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030322
					]
				},
				{
					"id": 111030322,
					"content": "はぁ、もう一度、「螭虎魚焼き」が食べたかったな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030323
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111030323,
					"content": "「螭虎探しに海潜り、帰って再び妖魔狩る」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030324
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111030324,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030325
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111030325,
					"content": "…もう完全に消えたのかな、「銅雀」って夜叉がいたこと、人々にも知ってもらいたいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030326
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111030326,
					"content": "そろそろ行こうぜ？あとで時間が空いたら、またここに来て焼香をあげよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111030321,
					"content": "「銅雀」さんもお達者で…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030322
					]
				},
				{
					"id": 111030306,
					"content": "オ…オバケ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030307
					]
				},
				{
					"id": 111030307,
					"content": "ははは…それもあながち間違いじゃない。「仙」と「鬼」は紙一重の存在だからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030308
					],
					"speakerTitle": "パイモン"
				}
			]
		},
