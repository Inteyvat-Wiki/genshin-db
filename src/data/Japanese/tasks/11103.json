					"魈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111030501,
					"content": "儀式に使う道具は揃ったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030502
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111030502,
					"content": "この香炉と七星灯、まるで仙法のためだけに作られた物みたいだ…一体どこで手に入れたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030503
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111030503,
					"content": "「銅雀」という夜叉から…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030504
					]
				},
				{
					"id": 111030504,
					"content": "「銅雀」さんがおまえによろしくって言ってたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111030505,
					"content": "「銅雀」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030506
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111030506,
					"content": "…あいつだったのか。確かに、あいつらしいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030507
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111030507,
					"content": "「銅雀」もやはり璃月を放っておけなかったんだろう…今の璃月を見て、彼が安心できていることを願おう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030508
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111030508,
					"content": "では今から儀式の準備をする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030509
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111030509,
					"content": "香炉を真ん中に、七星灯はその周囲に散らせ、極寒の物で点を結ぶ。準備ができたら我を呼べ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030510
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111030510,
					"content": "うむ、それでいい。そしてここからが「夢遊諸境法」の鍵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030511
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111030511,
					"content": "この術には四つの過程がある——献香、冥想、呪文、弓射。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030512
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111030512,
					"content": "あれ…そんなに面倒なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030513
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111030513,
					"content": "この仙法は絶雲の仙人が千年かけて悟り、手にしたもの。その奥深さを軽んじてはいけない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030514
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111030514,
					"content": "さもなくば自身が呑み込まれ、魂が体から離れて戻れなくなる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030515
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111030515,
					"content": "ごめん、また間違ったことを言っちゃったみたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030516
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111030516,
					"content": "「献香」、すなわち香炉の上にお香を一本、岩王帝君への敬畏とする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030517
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111030517,
					"content": "「冥想」、すなわち一切の雑念を遮断し、術の対象を脳の中に具現する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030518
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111030518,
					"content": "「呪文」、すなわち呪文をこう唱える——「帝婆夜叉、三尸押来」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030519
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111030519,
					"content": "「弓射」、すなわち2体の夜叉彫像に一矢放ち、使役の契約とする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030520
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111030520,
					"content": "全てがつつがなくいけば、少し経った頃にあいつの魂がここに現れる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030521,
						111030522
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111030521,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030523
					]
				},
				{
					"id": 111030523,
					"content": "質問がないなら、さっさと始めよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030524
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111030524,
					"content": "じゃあ…とりあえずお香だな？岩王帝君に敬意を示すために…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111030522,
					"content": "（ごくり）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030523
					]
				}
			]
		},
