			"dialogs": [
				{
					"id": 111031101,
					"content": "やっぱりここにいた！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111031102,
					"content": "「禁忌滅却の札」は回収したから、魈が預かっててくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111031103,
					"content": "ご苦労。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031104
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111031104,
					"content": "お客様、ご注文は何になさいますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031105
					],
					"speakerTitle": "秀華"
				},
				{
					"id": 111031105,
					"content": "「螭虎魚焼き」を一つ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031106
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111031106,
					"content": "かしこまりました。少々お待ちください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031107
					],
					"speakerTitle": "秀華"
				},
				{
					"id": 111031107,
					"content": "あれ？今回は杏仁豆腐じゃないのか、魈にしちゃ珍しいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111031108,
					"content": "これは「銅雀」が生きていた時に好きだった食べ物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031109
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111031109,
					"content": "ただ、どんな味がするのか気になってな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031110
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111031110,
					"content": "あぁ、そっか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111031111,
					"content": "「螭虎探しに海潜り、帰って再び妖魔狩る」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031112
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111031112,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031113
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111031113,
					"content": "まだ何か用があるのか？我は一人で食べる方が落ち着くんだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031114,
						111031115
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111031114,
					"content": "じゃあこれで…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111031116
					]
				},
				{
					"id": 111031116,
					"content": "そうだな、オイラたちはクールに去るぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111031115,
					"content": "それじゃ、パイモン…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111031116
					]
				}
			]
		},
