				},
				{
					"id": 111030913,
					"content": "名を…仙人様の名を聞いてもよろしいでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030914,
						111030915
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111030914,
					"content": "「降魔大聖」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030916
					]
				},
				{
					"id": 111030916,
					"content": "あなた様が！本当にあなた様があの！まさか一生の内に「降魔大聖、護法夜叉」ご本人様に会えるとは！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030917
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111030917,
					"content": "魈のことを知ってるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030918
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111030918,
					"content": "もちろん、逆に知り尽くしています！私のおじいさんが民俗学者で、小さい頃から「降魔大聖」の話を聞いてきました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030919
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111030919,
					"content": "今でも夜叉に関する書籍をしきりに集めています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030920
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111030920,
					"content": "しかし、おじいさんの遺物から「禁忌滅却の札」を見つけてからは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030921
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111030921,
					"content": "始めは仙人を真似るのが好きなだけでした、しかしそんなお遊びも時間が経つにつれ、ますますと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030922
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111030922,
					"content": "そうだったのか…じゃあ、おまえは魈のファンってことだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030923
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111030923,
					"content": "ああ、「降魔大聖」に会わせていただけたこと、ありがたき幸せ。私は本当に夢見心地のようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030924
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111030924,
					"content": "オイラたち、そこまで考えてなかったけどな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030925
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111030925,
					"content": "今日これを機に、「降魔大聖」様の前で…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030926
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111030926,
					"content": "今後一切の悪行をやめ、平穏に過ごし、仙人様の名誉を傷つけないことを誓います！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030927
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111030927,
					"content": "その誓言、しかと受け取った…行くがいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030928
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111030928,
					"content": "ありがとうございます…ご慈悲に感謝を、今まで璃月にしてくれたことにも感謝を…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030929
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111030929,
					"content": "あいつの最後の誓言、中々誠実だったな。これでもう悪さはしないと思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030930
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111030930,
					"content": "そうだ、「禁忌滅却の札」の回収がまだだったな。オイラたちにまかせろ。明日の朝、望舒旅館に行って本人から回収するぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111030915,
					"content": "「護法夜叉」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030916
					]
				},
				{
					"id": 111030904,
					"content": "もう「仙人」を自称しない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030905
					]
				},
				{
					"id": 111030905,
					"content": "しない、しないさ、おかげで魂ごと消えかけたんだから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030906
					],
					"speakerTitle": "掇星攫辰天君"
				}
			]
		},
