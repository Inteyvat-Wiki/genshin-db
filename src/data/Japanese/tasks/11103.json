			"trigger": {
				"objectNames": [
					"銅雀"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111030101,
					"content": "川の流れに乗れば魂も揺らぐ、浮世を扇ぐ扇子のように…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030102
					],
					"speakerTitle": "銅雀"
				},
				{
					"id": 111030102,
					"content": "あっごめん、邪魔しちゃったか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111030103,
					"content": "香炉と灯を貸してほしい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030104
					]
				},
				{
					"id": 111030104,
					"content": "…これはこれは珍しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030105
					],
					"speakerTitle": "銅雀"
				},
				{
					"id": 111030105,
					"content": "寺に来ても仙人を求めず、神も拝まない。欲しいものは香炉ときた…くはははは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030106
					],
					"speakerTitle": "銅雀"
				},
				{
					"id": 111030106,
					"content": "無礼なのは承知だ、本当に少し借りるだけだから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111030107,
					"content": "「夢遊諸境法」の儀式に使うんだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030108
					],
					"speakerTitle": "銅雀"
				},
				{
					"id": 111030108,
					"content": "な…なんで知ってるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111030109,
					"content": "私がこの寺にいる時間は、君たちの想像を遥かに上回る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030110
					],
					"speakerTitle": "銅雀"
				},
				{
					"id": 111030110,
					"content": "誠意が届いたからだろうか、「仙法」にも少し心得がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030111
					],
					"speakerTitle": "銅雀"
				},
				{
					"id": 111030111,
					"content": "おっ、そうなのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111030112,
					"content": "まあまあ、持っていきなさい。人のために善行を成すのも、好事の一つだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030113
					],
					"speakerTitle": "銅雀"
				},
				{
					"id": 111030113,
					"content": "…もともと、この地に残っていても、意味はなかったからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030114,
						111030116
					],
					"speakerTitle": "銅雀"
				},
				{
					"id": 111030114,
					"content": "何か事情が？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030115
					]
				},
				{
					"id": 111030115,
					"content": "私のことは気にするな、欲しいものを好きなだけ持っていくといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "銅雀"
				},
				{
					"id": 111030116,
					"content": "あ、ありがとう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030117
					]
				},
				{
					"id": 111030117,
					"content": "よいよい、遠慮するな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "銅雀"
				}
			]
		},
		{
			"id": 1110302,
			"completionStepIds": [
				1110317
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
