			"dialogs": [
				{
					"id": 111031001,
					"content": "「掇星攫辰天君」っていうやつがここにいるって聞いたんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031002
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111031002,
					"content": "「掇星攫辰天君」…あの仮面をかぶった偽仙人のことね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031003
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 111031003,
					"content": "彼が宿泊名簿に書いた名前は「平安」よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031004,
						111031005
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 111031004,
					"content": "名前が普通すぎる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111031006
					]
				},
				{
					"id": 111031006,
					"content": "もう部屋を出たわ、一人で山や川を旅するとかなんとか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031007
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 111031007,
					"content": "そうだ、もし「言葉を話す仙霊」を連れた人が来たら、この封筒を渡すよう預かってるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031008
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 111031008,
					"content": "言葉を話す仙霊？誰のことだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031009
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111031009,
					"content": "うん…彼が言ってた旅人はあなたね。はい、これを。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031010
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 111031010,
					"content": "手紙を残すなんて、新手の詐欺じゃないだろうな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031011
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111031011,
					"content": "とりあえず開けてみようぜ！凄く気になるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031019
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111031019,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031012
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111031012,
					"content": "あ、手紙と一緒に何か入ってるぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031013
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111031013,
					"content": "「禁忌滅却の札」だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031014
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111031014,
					"content": "久しぶりにこんな素直な悪人に会ったぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031015,
						111031016
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111031015,
					"content": "感動した…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111031017
					]
				},
				{
					"id": 111031017,
					"content": "そうだな…あっ、そうだ、はやく「禁忌滅却の札」を魈に届けに行こうぜ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111031016,
					"content": "魈のおかげだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111031017
					]
				},
				{
					"id": 111031005,
					"content": "一般人にしか聞こえない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111031006
					]
				}
			]
		},
