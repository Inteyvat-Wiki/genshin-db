			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790330201,
					"content": "ホラガイって、浮かぶんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330202,
						790330203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790330202,
					"content": "まあ、幻境に影響されたホラガイだから…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790330204
					]
				},
				{
					"id": 790330204,
					"content": "#うーん、本当に奇妙だな…あっ、映像が出たぞ。ほら、{NICKNAME}、腰をかがめて…わぁ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790330205,
					"content": "#{NICKNAME}、動くなよ、後ろに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330206,
						790330207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790330206,
					"content": "な、何か怖いものがあるの…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790330208
					]
				},
				{
					"id": 790330208,
					"content": "あっ、よく見たら、ホラガイから出た映像だったぜ。いきなり後ろに現れたから、びっくりしたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790330209,
					"content": "信号テスト機…二組…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790330210,
					"content": "はぁ、一人で呼び出されて、何か大変な目に遭わされると思ったが…ちょっと面倒な任務を押し付けられただけで、ほっとした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790330211,
					"content": "彼はあなたに叱られるのを怖がってるんだよ。ふふっ、まるで「兄」に叱られるのが怖い「弟」みたい…ね、多分彼はただ、私たちに失望されるのを怖がってるんじゃないかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790330212,
					"content": "皆はただのチームメンバーなのに…時々、『家族』みたいな感じがするんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790330213,
					"content": "家族か…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790330214,
					"content": "聞いちゃいけないことを聞いてしまった感じがするぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330215
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790330215,
					"content": "映像に映ってるやつらは…そんなに「悪い」ファデュイじゃないみたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790330207,
					"content": "怖がらせないでよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790330208
					]
				},
				{
					"id": 790330203,
					"content": "ホラガイの中に空気が入ってるのかも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790330204
					]
				}
			]
		},
		{
			"id": 7903303,
			"completionStepIds": [
				7903305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
