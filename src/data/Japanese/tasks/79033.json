			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790330301,
					"content": "あっ、この二人は地面で横になってるぞ…夜空の星でも見てるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790330302,
					"content": "なんだか変な映像だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790330303,
					"content": "ヤコヴ、何で落ち込んでる？長官に何か言われたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790330304,
					"content": "海が荒れていて、機材を運んでいる時転んじゃったんだ。僕はすばしっこいから、幸いなことに機材は無事だったけどね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790330305,
					"content": "それでも長官に叱られて…僕たちに各島で装置の信号をテストしてこいって。それは一番大変な類の任務なんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790330306,
					"content": "大丈夫だぜ、そんなに悲しむなよ。大変な任務なんかたくさんやってきただろ？だから、落ち込んでないで何か食おう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790330307,
					"content": "高いところを指してるな。なにを食べるつもりなんだ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790330308,
					"content": "待った、もしかして、このホラガイ…位置がズレてるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
}