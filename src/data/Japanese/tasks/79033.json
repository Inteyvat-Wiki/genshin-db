			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790330101,
					"content": "あっ、ちょうど舞台の真ん中に映像が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790330102,
					"content": "この二人、なにしてるんだ…？一人がなにかを言って、もう一人は座ってるな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790330103,
					"content": "あっ、わかったぞ、これはきっと物語を語っている場面なんだ！もう寝る時間だから、あいつは座ってるやつに物語を話して聞かせてるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790330104,
					"content": "ファデュイも眠る前に物語を聞くの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790330105
					]
				},
				{
					"id": 790330105,
					"content": "ファデュイにだって、こういう趣味を持つ人がいるかもしれないだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790330106,
					"content": "アガシャ、ペルシーコフ様から、僕たち四人で信号テストをしろと言われたんだ…エフカに知られたら、また怒られるよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790330107,
					"content": "大丈夫だよ、ヤコヴ。これは上からのご命令なんだから、エフカだってきっとあなたを責めたりしないよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790330108,
					"content": "はぁ、そんなに怖いなら、私が一緒にエフカに会いに行ってあげる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790330109,
					"content": "なんだ、物語じゃないのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790330110,
					"content": "でも、なにがなんだか、意味がわからないんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7903302,
			"completionStepIds": [
				7903307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
