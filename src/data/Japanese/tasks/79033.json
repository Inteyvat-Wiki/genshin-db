	"talks": [
		{
			"id": 7903301,
			"completionStepIds": [
				7903306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
