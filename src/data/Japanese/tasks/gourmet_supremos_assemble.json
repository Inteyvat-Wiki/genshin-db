			"trigger": {
				"objectNames": [
					"旭東"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721680201,
					"content": "パルヴァネ、本当に他の方法はないんだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680202
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721680202,
					"content": "私の本にはこの方法しか載ってないかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680203
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 721680203,
					"content": "あぁ…魔物が道を塞いでるだけだったら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680204
					],
					"speakerTitle": "ジュリー"
				},
				{
					"id": 721680204,
					"content": "探してた「緋櫻毬」ってこれ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680205
					]
				},
				{
					"id": 721680205,
					"content": "おおっ！そう、この艶、俺たちが探してた「緋櫻毬」に違いない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680206
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721680206,
					"content": "よかった！やっと美味しいものを食べられる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680207
					],
					"speakerTitle": "ジュリー"
				},
				{
					"id": 721680207,
					"content": "待って、あの障壁に入れたの？私が教えた方法で？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680208
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 721680208,
					"content": "そうだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680209
					]
				},
				{
					"id": 721680209,
					"content": "どこで「雷櫻の枝」を見つけたのか教えてもらっていい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680210
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 721680210,
					"content": "「雷櫻の枝」に触れて、「雷の種」がどんな風にあんたに付着したの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680211
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 721680211,
					"content": "ごめん、先にノートを出すから…これでよし、「雷の種」に付着されるのはどんな感じ？それと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680212
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 721680212,
					"content": "待ってパルヴァネ、旅人に助けてもらったばっかりだし、お前の研究は一旦置いとこう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680213
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721680213,
					"content": "旅人、感謝するよ。前に約束した報酬はちゃんと渡すから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680214
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721680214,
					"content": "ただ少し待ってほしい。お前が採ってきた「緋櫻毬」で料理を作る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680215
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721680215,
					"content": "前々から稲妻の名物料理「緋櫻天ぷら」の話を聞いてきたが、ようやく作る機会が巡ってきた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680216
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721680216,
					"content": "俺はこれから料理の準備をするから、後でまた来てくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "旭東"
				}
			]
		},
		{
			"id": 7216803,
			"completionStepIds": [
				7216804
			],
			"beginWay": "TALK_BEGIN_AUTO",
