			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"旭東"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721680301,
					"content": "こうやって…こう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680302
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721680302,
					"content": "できた？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680303
					]
				},
				{
					"id": 721680303,
					"content": "最後の一歩…衣を包んで、油で揚げれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680304
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721680304,
					"content": "完成！「緋櫻天ぷら」、さあ召し上がれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680305
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721680305,
					"content": "お、美味しい、ちょっと熱いけど…ふぅ、ふぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680306
					],
					"speakerTitle": "ジュリー"
				},
				{
					"id": 721680306,
					"content": "旭東、「天ぷら」は天つゆにつけて食べるものだって本に書いてあった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680307
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 721680307,
					"content": "天つゆ？それは用意してないな、また今度作ってみるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680308
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721680308,
					"content": "この「緋櫻天ぷら」はお前にあげよう、受け取ってくれ、旅人。手伝ってくれてありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680309
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721680309,
					"content": "あと「緋櫻天ぷら」のレシピも書いておいた、もらってほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680310
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721680310,
					"content": "機会があったら自分で作ってみてくれ、料理は面白いぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680311,
						721680313
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721680311,
					"content": "ありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680312
					]
				},
				{
					"id": 721680312,
					"content": "お礼はいいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680314
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721680314,
					"content": "俺たちはもう少し稲妻にいるよ。後で<color=#00E1FFFF>神無塚</color>の近くにも行くかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680316
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721680316,
					"content": "それにジュリーが、「鳴神大社」にある神櫻を見に行きたいと言っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680317
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721680317,
					"content": "この島の「緋櫻毬」は、すべてあの木から落ちたものらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680318
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721680318,
					"content": "あれほどの花びら、どれだけ大きい木なのか気になるな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680319
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721680319,
					"content": "お前も興味があるなら、そこへ行ってみるといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680320
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721680320,
					"content": "改めて言わせてくれ、本当に助かった、旅人。俺も食い物を探さないと、腹が減って死にそうだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "旭東"
				},
				{
					"id": 721680313,
					"content": "これからどこに行く？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680314
					]
				}
			]
		},
