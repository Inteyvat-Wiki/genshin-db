			},
			"dialogs": [
				{
					"id": 750640801,
					"content": "「ルイ、ルイ！」…おおっ、君らか。びっくりしたじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640802
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750640802,
					"content": "どうだ、気が変わったかな？それとも、挨拶に来ただけか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640803,
						750640806
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750640803,
					"content": "挨拶ついでに、お手伝いするよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640804
					]
				},
				{
					"id": 750640804,
					"content": "キュー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640805
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640805,
					"content": "ハハッ、そりゃありがたい。早速始めよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750640806,
					"content": "通りがかっただけ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640807
					]
				},
				{
