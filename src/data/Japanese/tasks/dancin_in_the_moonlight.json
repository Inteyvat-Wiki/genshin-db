			},
			"dialogs": [
				{
					"id": 750640601,
					"content": "ハハッ、いいぞ！そのままじっとしててくれ…いい子だ。撮るぞ…三、二、一！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640602
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750640602,
					"content": "ほら見てくれ、この傑作！誰が撮ったんだ？このワシだ！このマニフェコ・ド・マニフェサンスが撮ったんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640603
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750640603,
					"content": "本当に感謝する！ハハッ！これが約束した残りの報酬だ！ああ…あと、これもだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640604
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750640604,
					"content": "やった…約束の報酬だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640605
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750640605,
					"content": "え？一モラだけ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640606
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750640606,
					"content": "さて…次は本当の主役の登場だ！堂々と！スターのように舞台へ上がってくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640607
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750640607,
					"content": "ふぅ…終わった！このコピーは君らにやろう。君らはフォンテーヌのどの美術商よりも早くこの傑作を手に入れることができたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640608,
						750640610
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750640608,
					"content": "ありがとう、大事にする。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640609
					]
				},
				{
					"id": 750640609,
					"content": "でも、報酬…報酬が…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640613
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750640613,
					"content": "次はここに行く…地図にマークしといてやろう。ヘヘッ、次もまたどこかで会えるかもな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640614
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750640614,
					"content": "そしてまた、手伝ってもらうかもしれん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640615
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750640615,
					"content": "ううっ…当たり前みたいに言うなよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640616
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750640616,
					"content": "ハハッ、それはワシが決めることじゃねぇ。運命のみぞ知る、だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640617
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750640617,
					"content": "さらばだ、友よ。旅の幸運を祈っている！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640618
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750640618,
					"content": "キュウ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640619
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640619,
					"content": "マニフェコが荷物をまとめ、熱気球に飛び乗った。\\n大きく揺れる熱気球にマニフェコが豪快に笑う。しばらくすると、熱気球はバランスを取り戻し、遠くへ飛んでいった。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 750640610,
					"content": "あんまりお金にならなそうだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640611
					]
				},
				{
					"id": 750640611,
					"content": "グル？キュ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640612
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640612,
					"content": "そうだな…がっかりだぞ…後でもらえる分はてっきり手付金より多いと思ってたから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640613
					],
					"speakerTitle": "パイモン"
				}
			]
		},
