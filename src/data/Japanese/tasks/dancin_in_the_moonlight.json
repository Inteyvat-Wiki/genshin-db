			"dialogs": [
				{
					"id": 750641101,
					"content": "うむ…次は、月明かりを浴びるイクトミ竜…！難しくはないが、理想的な照明の位置を探すのに少々手間取りそうだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641102
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750641102,
					"content": "#あっ…君、手伝ってくれ！{REALNAME[ID(2)|SHOWHOST(true)]}、君だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641103
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750641103,
					"content": "#ぷっ、{REALNAME[ID(2)|SHOWHOST(true)]}はおまえよりちょっと大きいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750641104,
					"content": "キュ？キュウ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641105
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750641105,
					"content": "おお、いいぞ…このタイミングだ…ハハッ、ワシの名作がもうすぐ完成する…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641106
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750641106,
					"content": "ばっちり撮ってくれよ。フォンテーヌの女の子を撮るみたいに！ヘヘッ、今のは映影のセリフなんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750641107,
					"content": "キュー、キュウ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641108
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750641108,
					"content": "ハハッ、安心してくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641109
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750641109,
					"content": "ああ！この角度！完璧だ…！まさにそう、この月明かり！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641110
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750641110,
					"content": "えっと…ふむふむ、光源があと二つほしいな…一つでイクトミ竜の横顔を照らして、暖色系の照明で背景とコントラストをはっきりさせよう。その方が神秘的な雰囲気が出る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641111
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750641111,
					"content": "もう一つでイクトミ竜の背中を全体的に照らそう…特別な意味はないが、とても重要なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641112
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750641112,
					"content": "ああ…そうだ、そのまま…おおっ！いい、いいぞ！夢のようだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641113
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750641113,
					"content": "むっ！？クソッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641114
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750641114,
					"content": "すまんな。ここの空気に含まれる元素の濃度がフォンテーヌと違うからか、機械に何らかの異常が起きちまった…確認するから、ちょっと待っててくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641115
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750641115,
					"content": "ふむふむ…うーん…どれどれ…ここじゃない…ここでもない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641116
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750641116,
					"content": "クソッ！バカもん！あああぁ！ムカつく！この甘ったれめ！穀潰し！調子こいたサボり魔め！あああああーー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641117
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750641117,
					"content": "このっ…このっ…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641118
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750641118,
					"content": "うわあっ！落ち着けって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641119,
						750641120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750641119,
					"content": "煙が出てる！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750641122
					]
				},
				{
					"id": 750641122,
					"content": "ふぅ…こいつは、もう…完全に壊れた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641123
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750641123,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750641124,
					"content": "フン、そんな目で見るな。少なくとも、気分はすっきりしたぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641125
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750641125,
					"content": "はぁ…見ての通り、照明がオシャカだ…こいつにたくさんのモラをかけたというのに…まったくもってがっかりだ。まるでワシの元妻のよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641126
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750641126,
					"content": "ま、待てって！オイラたちも手伝うから、そう早まるなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750641127,
					"content": "はぁ…すまん、取り乱してしまった…ふぅ、何をしようとしてたんだったか…そうだ、イクトミ竜の<color=#00E1FFFF>顔の左側</color>を照らす暖色の照明と、イクトミ竜の<color=#00E1FFFF>背中全体</color>を照らす照明が必要なんだったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641128
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750641128,
					"content": "わかった。それじゃあ、さっそく始めようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641129
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750641129,
					"content": "マニフェコがまた写真機をいじりはじめた。照明をどこに設置したらいいか考えることにした…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 750641120,
					"content": "照明と痴話げんかでもしてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750641121
					]
				},
				{
					"id": 750641121,
					"content": "へっ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641122
					],
					"speakerTitle": "パイモン"
				}
			]
		},
