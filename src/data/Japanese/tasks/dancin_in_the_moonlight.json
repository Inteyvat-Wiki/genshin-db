			"dialogs": [
				{
					"id": 750640412,
					"content": "どうだ！見ろ、この光と影の奇跡を！これぞフォンテーヌの最先端を行く工業製品だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640413
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750640413,
					"content": "オイラたちにとってはもう珍しいもんじゃないけどな！それに、手伝ってほしいこともまだ言われてないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640414,
						750640416
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750640414,
					"content": "何をしてほしいのか、ちゃんと言って。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640415
					]
				},
				{
					"id": 750640415,
					"content": "うーん、オイラたちに写真を撮ってほしいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640418
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750640418,
					"content": "おお…分かった、いいだろう！手付金だ、しっかり受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640419
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750640419,
					"content": "こ、こんなに！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640420
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750640420,
					"content": "キュウ——！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640421
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640421,
					"content": "お察しの通り、ナタの竜の写真を何枚か撮りたい。図鑑に載ってるような三面図じゃなくてな…もっと、こう、生命力あふれる写真を！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640422
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750640422,
					"content": "おお、なるほど！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640423
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750640423,
					"content": "ただ…はぁ、生命力があるものは言うことを聞いてくれないもんだ。君らさえよければだが、手伝ってくれないか？冒険者なら、ワシよりいいのが撮れると思ってな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640424
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750640424,
					"content": "おう、任せろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640425
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750640425,
					"content": "もちろん、君らの能力を超えることまで無理に頼むことはしない。だが少なくとも、近くにいる生物の攻撃からワシを守ることくらいはできるだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640426
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750640426,
					"content": "だから、その手付金はとっといてくれ。実際手伝うかどうかは君らに任せよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640427
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750640427,
					"content": "わぁ…モラがこんなに…本当にいいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640428
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750640428,
					"content": "もちろんだ！その程度のモラで何度も確認することもないだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640429
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750640429,
					"content": "ふふん！ならオイラたちを選んで正解だな！オイラは、ナタで超～有名な竜のマスターテイマーなんだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640430
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750640430,
					"content": "#全然問題ないぞ！オイラと{NICKNAME}がいれば、どんな竜でも手なずけられちゃうんだからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640431
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750640431,
					"content": "テペトル竜なんてお手の物だぞ！クク竜もオイラにかかれば朝飯前だな！イクトミ竜だってお茶の子さいさいだ！あとは…えっと、コホラ竜だろ、ユムカ竜に、イラノ竜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640432,
						750640433
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750640432,
					"content": "イラノ竜？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640434
					]
				},
				{
					"id": 750640434,
					"content": "…ビッグヘッド竜に、リトルハンド竜だろ。それからヒュージアイ竜、コワコワ竜、チョウコワコワ竜、アマリコワクナイ竜、ヘンテコ竜、フツー竜、ガリガリ竜、ポヨンポヨン竜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640435
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750640435,
					"content": "キュイ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640436,
						750640437
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640436,
					"content": "何それ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640438
					]
				},
				{
					"id": 750640438,
					"content": "あと…ガルル竜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640439
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750640439,
					"content": "ガル！ガルル！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640440
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640440,
					"content": "キュイキュイ竜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640441
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750640441,
					"content": "キュイ、キュイ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640442
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640442,
					"content": "と、とにかく、そんなの全部お手のもんだぜ！マスターテイマーのオイラたちを信じろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640443
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750640443,
					"content": "キュウ、キュイ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640444,
						750640447
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640444,
					"content": "もう…手伝うよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640445
					]
				},
				{
					"id": 750640445,
					"content": "#手付金をたんまりもらったし、ちゃんと手伝わなくちゃな！そうだろ、{REALNAME[ID(2)|SHOWHOST(true)]}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640446
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750640446,
					"content": "それは良かった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750640447,
					"content": "ごめん、今は時間がない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640448
					]
				},
				{
					"id": 750640448,
					"content": "でも、もう手付金はもらっちゃったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640449
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750640449,
					"content": "ああ、時間のある時で構わん！ワシだってどうしてもというわけじゃないからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750640437,
					"content": "ちょっと、何言ってるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640438
					]
				},
				{
					"id": 750640433,
					"content": "ちょっと待って…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640434
					]
				},
				{
					"id": 750640416,
					"content": "モラを払ってくれれば手伝うよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640417
					]
				},
				{
					"id": 750640417,
					"content": "オイラたちはスーパークールだからな。モラは先払いだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640418
					],
					"speakerTitle": "パイモン"
				}
			]
		},
