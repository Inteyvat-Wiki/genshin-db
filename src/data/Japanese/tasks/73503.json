			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"デルース"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735030101,
					"content": "ふむ、悪くない場所だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030102
					],
					"speakerTitle": "デルース"
				},
				{
					"id": 735030102,
					"content": "また謎解きの研究をしてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030103
					]
				},
				{
					"id": 735030103,
					"content": "旅人！ちょうどよかった、新しい連続謎解きを作ろうと考えていたところなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030104
					],
					"speakerTitle": "デルース"
				},
				{
					"id": 735030104,
					"content": "ここの地形は少し複雑だ。ほら、港の片側では「聖樹」の巨大な根が一本、水に浸かっている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030105
					],
					"speakerTitle": "デルース"
				},
				{
					"id": 735030105,
					"content": "もう片側には巨大な蓮の葉が一枚、それに出航を待つ船がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030106
					],
					"speakerTitle": "デルース"
				},
				{
					"id": 735030106,
					"content": "旅人、今回の謎解きは、どちらの景色をテーマにしたほうがいいと思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030107,
						735030110,
						735030113
					],
					"speakerTitle": "デルース"
				},
				{
					"id": 735030107,
					"content": "根から始めよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030108
					]
				},
				{
					"id": 735030108,
					"content": "そうか。確かに「聖樹」の巨大な根は目立つ。謎解きの「入り口」として認識されやすいかもしれないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030109
					],
					"speakerTitle": "デルース"
				},
				{
					"id": 735030109,
					"content": "よし！じゃあ根をテーマに謎解きを作ろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030115,
						735030116
					],
					"speakerTitle": "デルース"
				},
				{
					"id": 735030115,
					"content": "ふふん、作ってみよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030115,
						735030116
					]
				},
				{
					"id": 735030116,
					"content": "ふふん、任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030117
					]
				},
				{
					"id": 735030117,
					"content": "おまえ、なんでそんなに楽しそうなんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735030118,
					"content": "できた、見てみて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030119
					]
				},
				{
					"id": 735030119,
					"content": "「知恵が海に帰る場所で、宝は帆の間に隠れている。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030120
					],
					"speakerTitle": "デルース"
				},
				{
					"id": 735030120,
					"content": "いい感じだな！この謎解きなら、「港」を連想させやすい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030121
					],
					"speakerTitle": "デルース"
				},
				{
					"id": 735030121,
					"content": "「知恵が海に帰る」という文言から考えれば、この場所が教令院やスメールシティに関係していることも難なく推測できる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030122
					],
					"speakerTitle": "デルース"
				},
				{
					"id": 735030122,
					"content": "君にこんな才能があるとは思わなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030123
					],
					"speakerTitle": "デルース"
				},
				{
					"id": 735030123,
					"content": "少し待ってくれ。この謎解きを目に付きやすい場所に貼っておく…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030124
					],
					"speakerTitle": "デルース"
				},
				{
					"id": 735030124,
					"content": "えっ、こんなに近くに貼るのか？謎解きが指してる場所も遠くないし、これじゃすぐに見つかると思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735030125,
					"content": "ははは、これは謎を解く人のために、範囲を限定することを目的にしているんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030126
					],
					"speakerTitle": "デルース"
				},
				{
					"id": 735030126,
					"content": "こうでもしなければ、なぞなぞの対象となる範囲が広すぎるからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030127
					],
					"speakerTitle": "デルース"
				},
				{
					"id": 735030127,
					"content": "デルースは謎解きの配置を始めた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						735030128
					]
				},
				{
					"id": 735030128,
					"content": "よし。ここの謎解きはこのくらいにして、次の場所に行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030129
					],
					"speakerTitle": "デルース"
				},
				{
					"id": 735030129,
					"content": "え？次の場所もあるのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735030110,
					"content": "蓮の葉と船のほうが面白そう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030111
					]
				},
				{
					"id": 735030111,
					"content": "確かに…この二つを結び付ければ、特別な面白さが出るかもしれないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030112
					],
					"speakerTitle": "デルース"
				},
				{
					"id": 735030112,
					"content": "問題ない、このテーマで謎解きを作ろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030115,
						735030116
					],
					"speakerTitle": "デルース"
				},
				{
					"id": 735030113,
					"content": "どれも簡単すぎる！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030114
					]
				},
				{
					"id": 735030114,
					"content": "簡単すぎる？それじゃ、君には何か考えがあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030115,
						735030116
					],
					"speakerTitle": "デルース"
				}
			]
		},
		{
			"id": 7350302,
			"completionStepIds": [
				7350302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7350302",
							"2"
						],
						"stepId": 7350302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"デルース"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735030201,
					"content": "よし！ここに二つ目のなぞなぞを配置しよう。この謎解きを解けば、最後の宝箱を見つけられるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030202
					],
					"speakerTitle": "デルース"
				},
				{
					"id": 735030202,
					"content": "俺が考えた最後の宝物の配置場所は…そこだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030203
					],
					"speakerTitle": "デルース"
				},
				{
					"id": 735030203,
					"content": "えっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735030204,
					"content": "えっと…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030205
					]
				},
				{
					"id": 735030205,
					"content": "普通の小さな丘の横に、普通の小さな滝があるだけじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735030206,
					"content": "その通り！しかし、じきに俺たちの謎解きによって普通ではなくなる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030207
					],
					"speakerTitle": "デルース"
				},
				{
					"id": 735030207,
					"content": "よし。旅人、この謎解きに何かアドバイスはあるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030208,
						735030211,
						735030214
					],
					"speakerTitle": "デルース"
				},
				{
					"id": 735030208,
					"content": "遠まわしなのはやめて、直球でいこう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030209
					]
				},
				{
					"id": 735030209,
					"content": "なるほど、そうか。ふむ…謎を解く人は山を越えてここまで来ることになる。確かに疲れを感じてもおかしくはない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030210
					],
					"speakerTitle": "デルース"
				},
				{
					"id": 735030210,
					"content": "よし、それなら簡単なものにしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030219,
						735030220
					],
					"speakerTitle": "デルース"
				},
				{
					"id": 735030219,
					"content": "特に勉強したわけじゃないけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030219,
						735030220
					]
				},
				{
					"id": 735030220,
					"content": "習うより慣れろとしか言いようがない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030221
					]
				},
				{
					"id": 735030221,
					"content": "なるほど。旅人なだけあって、知識が豊富なんだな…よし、さっそく君が書いた謎解きを配置してこよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030222
					],
					"speakerTitle": "デルース"
				},
				{
					"id": 735030222,
					"content": "デルースは謎解きの配置を始めた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						735030223
					]
				},
				{
					"id": 735030223,
					"content": "よし！この告知板なら十分に目立つはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030224
					],
					"speakerTitle": "デルース"
				},
				{
					"id": 735030224,
					"content": "それじゃ、今から最後の宝箱を配置しに行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "デルース"
				},
				{
					"id": 735030211,
					"content": "滝をテーマにしよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030212
					]
				},
				{
					"id": 735030212,
					"content": "ふむ…確かに滝はわかりやすいテーマだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030213
					],
					"speakerTitle": "デルース"
				},
				{
					"id": 735030213,
					"content": "問題ない、それをテーマにしよう。それから、この最後の謎解きの難易度は…少し下げることにしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030219,
						735030220
					],
					"speakerTitle": "デルース"
				},
				{
					"id": 735030214,
					"content": "ふふん、作ってみよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030215
					]
				},
				{
					"id": 735030215,
					"content": "おい！ますます楽しんでないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735030216,
					"content": "できた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030217
					]
				},
				{
					"id": 735030217,
					"content": "「青い傘が宝を懐に珠簾を眺める。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030218
					],
					"speakerTitle": "デルース"
				},
				{
					"id": 735030218,
					"content": "うーん…この謎解き、特別な感じがするな…どこかでこれについて習ったことでもあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030219,
						735030220
					],
					"speakerTitle": "デルース"
				}
			]
		},
		{
			"id": 7350303,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
