			},
			"dialogs": [
				{
					"id": 735030301,
					"content": "「浅海を探る知恵の枝。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "謎解きが入った箱"
				}
			]
		},
		{
			"id": 7350304,
			"completionStepIds": [
				7350304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7350304",
							"2"
						],
						"stepId": 7350304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"デルース"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735030401,
					"content": "これが最後の宝箱だ。今回は謎解きを作らなくていい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030402
					],
					"speakerTitle": "デルース"
				},
				{
					"id": 735030402,
					"content": "だが、何を入れるべきか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030403,
						735030406,
						735030409
					],
					"speakerTitle": "デルース"
				},
				{
					"id": 735030403,
					"content": "価値のあるもの。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030404
					]
				},
				{
					"id": 735030404,
					"content": "そうだな。この宝箱の中身は、少なくとも謎を解いた人の苦労に見合う価値のあるものでなければならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030405
					],
					"speakerTitle": "デルース"
				},
				{
					"id": 735030405,
					"content": "価値といえば、一番わかりやすいのは当然モラだ。よし…モラを多めに入れよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030413
					],
					"speakerTitle": "デルース"
				},
				{
					"id": 735030413,
					"content": "よし、これで今回の「謎解き」は完成だ。手伝ってくれてありがとう、旅人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030414
					],
					"speakerTitle": "デルース"
				},
				{
					"id": 735030414,
					"content": "報酬として、これらを受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030415
					],
					"speakerTitle": "デルース"
				},
				{
					"id": 735030415,
					"content": "はぁ、謎解きについてもっと君と議論したいところだが、用事があって教令院に戻らなければならないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030416
					],
					"speakerTitle": "デルース"
				},
				{
					"id": 735030416,
					"content": "もし旅の途中で新しい謎解きを見つけたり、謎解きが解けなくて悩んだりしたら、ぜひ俺に教えてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030417
					],
					"speakerTitle": "デルース"
				},
				{
					"id": 735030417,
					"content": "俺たちで詳しく話し合って、それから…他の冒険者たちのために、なぞなぞを再配置してやろう。はははっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030418
					],
					"speakerTitle": "デルース"
				},
				{
					"id": 735030418,
					"content": "では、俺はこれで。旅人、君の旅路が順風満帆であることを祈っているよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030419
					],
					"speakerTitle": "デルース"
				},
				{
					"id": 735030419,
					"content": "ナザムという宝盗団が、面倒を起こさなければいいが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "デルース"
				},
				{
					"id": 735030406,
					"content": "実用性のあるもの。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030407
					]
				},
				{
					"id": 735030407,
					"content": "実用性？ふむ…実用性の高いものというと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030408
					],
					"speakerTitle": "デルース"
				},
				{
					"id": 735030408,
					"content": "そうだ！数日前に人からレシピをもらったから、それを報酬として宝箱に入れよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030413
					],
					"speakerTitle": "デルース"
				},
				{
					"id": 735030409,
					"content": "この考え悩む経験こそ、一番の宝物。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030410
					]
				},
				{
					"id": 735030410,
					"content": "ははは、君の言う通りだな！この苦労して考え悩む時間は、まさに値段のつけられない貴重な経験だ。それに比べたら、他のものはほとんど価値がないと言ってもいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030411
					],
					"speakerTitle": "デルース"
				},
				{
					"id": 735030411,
					"content": "ぜんぜん違う！ちゃんとモラやレシピを入れてやれ！無理なら野菜とか果物でもいいから、空っぽのままにはするなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030412
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735030412,
					"content": "冗談だ、冗談。ちゃんと報酬として何か入れるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030413
					],
					"speakerTitle": "デルース"
				}
			]
		},
