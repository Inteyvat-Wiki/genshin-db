			"dialogs": [
				{
					"id": 731951301,
					"content": "「レンジャー長になってから毎日森にいる。時間が経つにつれ、暇すぎてついに暝彩鳥に話しかけるようになってしまった。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951302
					],
					"speakerTitle": "掲示板"
				},
				{
					"id": 731951302,
					"content": "「本当に彼らの言葉を理解できれば、毎日これほど退屈に過ごさずに済むのに」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "掲示板"
				}
			]
		},
		{
			"id": 7319514,
			"completionStepIds": [
