						"stepId": 7319510,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951001,
					"content": "「皆さん、話の上手な講談師をご存じありませんか？ええと、同じ話を寸分違わず繰り返せる方が必要です。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951002
					],
					"speakerTitle": "掲示板"
				},
				{
					"id": 731951002,
					"content": "「実は恐ろしいジンニーに憑りつかれまして、同じ話を毎日同じように繰り返さないと殺すと脅されているんです。かれこれ一ヶ月が経ち、頭がガンガンしてきました。これ以上は耐えられません…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951003
					],
					"speakerTitle": "掲示板"
				},
				{
					"id": 731951003,
					"content": "「なんと奇怪な！プスパカフェにマッダフという講談師がいると聞きました。あなたの力になってくれるかもしれません」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "掲示板"
				}
			]
		},
		{
			"id": 7319511,
			"completionStepIds": [
				7319511
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319511",
							"2"
						],
						"stepId": 7319511,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951101,
					"content": "「私は多くの国で数々のショーを見てきましたが、ニィロウさんのダンスが間違いなくテイワットで一番だと思います。なのに教令院の低俗な学者たちは、まともに観賞もしないくせに毎日口出しばかりして。芸術を侮辱しているとしか思えません」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951102
					],
					"speakerTitle": "掲示板"
				},
				{
					"id": 731951102,
					"content": "「モンドでの経験から言うと、ニィロウさんのために後援会を組織する必要があります。そうすれば、あの芸術を解さない連中もあれこれ言わなくなるでしょう」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951103
					],
					"speakerTitle": "掲示板"
				},
				{
					"id": 731951103,
					"content": "「後援会…モンド人の習慣かなにかか？だが…完璧なパフォーマンスは劇団全員の努力の結果だ。ただ一人に目を向けるのはどうなんだろうな。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951104
					],
					"speakerTitle": "掲示板"
				},
				{
					"id": 731951104,
					"content": "「とはいえ、あたしは芸術というものが、みなを繋ぐ絆たり得ることを信じてる。あんたがニィロウの踊りを好きになってくれて嬉しいよ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951105
					],
					"speakerTitle": "掲示板"
				},
				{
					"id": 731951105,
					"content": "「その優雅な筆跡、あなたはきっとうら若いお嬢さんですね。共に舞踊劇を楽しめる同好の士に出会えてよかった。お嬢さん、一度お会ってお話ししませんか？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951106
					],
					"speakerTitle": "掲示板"
				},
				{
					"id": 731951106,
					"content": "「すまないね、あたしは忙しいんだ。何かあるならマネージャーに話を通してくれ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951107
					],
					"speakerTitle": "掲示板"
				},
				{
					"id": 731951107,
					"content": "「こいつ、でかい壁にぶち当たったな。最後の筆跡は明らかにムキムキな男のそれだ…恐らく、金持ちのお嬢さんのボディガードだろうな。それも砂漠出身の。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "掲示板"
				}
			]
		},
		{
			"id": 7319512,
			"completionStepIds": [
				7319512
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
