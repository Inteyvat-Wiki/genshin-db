			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951201,
					"content": "「ジンニーを呼び出せる魔法のポットを売っています。ここに1モラを入れてください。どんな願いも思いのままです。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951202
					],
					"speakerTitle": "掲示板"
				},
				{
					"id": 731951202,
					"content": "「願いをかなえる魔法のポットです。どんな願いでも構いません。たったの1モラ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951203
					],
					"speakerTitle": "掲示板"
				},
				{
					"id": 731951203,
					"content": "「そうです。私がジンニーです。1モラください、何でも願いをかなえます。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951204
					],
					"speakerTitle": "掲示板"
				},
				{
					"id": 731951204,
					"content": "「最近発生した連続詐欺事件については、レグザー庁が調査中である。各自冷静になるように。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951205
					],
					"speakerTitle": "掲示板"
				},
				{
					"id": 731951205,
					"content": "「被害を受けた民衆は、質問があれば問い合わせるように。相談料は1モラ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "掲示板"
				}
			]
		},
		{
			"id": 7319513,
			"completionStepIds": [
