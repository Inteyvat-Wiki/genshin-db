			},
			"dialogs": [
				{
					"id": 731950101,
					"content": "こちらはワズィール様が設置した掲示板です。スメールシティ内の重要事項がここに掲示されます。質問があればメッセージを残してください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "掲示板"
				}
			]
		},
		{
			"id": 7319502,
			"completionStepIds": [
				7319502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319502",
							"2"
						],
						"stepId": 7319502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950201,
					"content": "「リシュボラン虎処理の専門家招聘に関するお知らせ…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950202
					],
					"speakerTitle": "掲示板"
				},
				{
					"id": 731950202,
					"content": "告知の内容は絵の具で塗りつぶされ、その横に歪で幼稚な字が書かれている…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950203
					],
					"speakerTitle": "掲示板"
				},
				{
					"id": 731950203,
					"content": "「ラージャはみんなと遊びたいだけ！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "掲示板"
				}
			]
		},
		{
			"id": 7319503,
			"completionStepIds": [
				7319503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319503",
							"2"
						],
						"stepId": 7319503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950301,
					"content": "「キノコを食べた後に精霊が踊っているのが見えても、それは正常な現象ですのでご安心ください。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950302
					],
					"speakerTitle": "掲示板"
				},
				{
					"id": 731950302,
					"content": "「ですが、周りの植物がおしゃべりを始めたのに気づいたら、すぐにお近くのレンジャーまで救助の要請を。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "掲示板"
				}
			]
		},
		{
			"id": 7319504,
			"completionStepIds": [
				7319504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319504",
							"2"
						],
						"stepId": 7319504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950401,
					"content": "「原因は不明ですが、最近森の中の『死域』の数とその面積が明らかに拡大しています。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950402
					],
					"speakerTitle": "掲示板"
				},
				{
					"id": 731950402,
					"content": "「『死域』は植物を枯らすだけでなく、動物や人間の命を奪います。そのためレンジャー長が『汚染区域』を設定していますので、決して近寄らないでください。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950403
					],
					"speakerTitle": "掲示板"
				},
				{
					"id": 731950403,
					"content": "「森の中を歩いている際に新しい死域を発見した場合は、お近くのレンジャーまで連絡し、専門家の処理に任せてください。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "掲示板"
				}
			]
		},
		{
			"id": 7319505,
			"completionStepIds": [
				7319505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319505",
							"2"
						],
						"stepId": 7319505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950501,
					"content": "最近、マハマトラは各地のバザールの定期巡回中に、多数の非合法な缶詰知識の取引を摘発した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950502
					],
					"speakerTitle": "掲示板"
				},
				{
					"id": 731950502,
					"content": "缶詰知識の取引は教令院により固く禁じられている。発覚すれば厳重に処罰される。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950503
					],
					"speakerTitle": "掲示板"
				},
				{
					"id": 731950503,
					"content": "また、缶詰知識の使用により生じるいかなる結果も、教令院はその責任を一切負わない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "掲示板"
				}
			]
		},
		{
			"id": 7319506,
			"completionStepIds": [
				7319506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319506",
							"2"
						],
						"stepId": 7319506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950601,
					"content": "「年に一度の『花神誕祭』が近づいています。今年はグランドバザールでも盛大な祭典が行われる予定です。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950602
					],
					"speakerTitle": "掲示板"
				},
				{
					"id": 731950602,
					"content": "「祭典をさらに盛り上げるため、今年は当家のお嬢さまから祭典に参加する業者の皆さまへ、特別手当が支給されます。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950603
					],
					"speakerTitle": "掲示板"
				},
				{
					"id": 731950603,
					"content": "「皆さんで一緒にクラクサナリデビさまの生誕を祝いましょう！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "掲示板"
				}
			]
		},
		{
			"id": 7319507,
			"completionStepIds": [
				7319507
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319507",
							"2"
						],
						"stepId": 7319507,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950701,
					"content": "「当家のお嬢さまが家出をされて、まだ帰って来ません。茶色の髪で紫の上着、水色のロングスカートの少女を見かけたらフーマイ家までご連絡ください。謝礼を差し上げます。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950702
					],
					"speakerTitle": "掲示板"
				},
				{
					"id": 731950702,
					"content": "「ご本人がこの広告をご覧になったら、すぐに家までご連絡ください。旦那様と奥様がご心配されています。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "掲示板"
				}
			]
		},
		{
			"id": 7319508,
			"completionStepIds": [
				7319508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319508",
							"2"
						],
						"stepId": 7319508,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950801,
					"content": "「帰って来た！我が主アフマールが帰って来た！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950802
					],
					"speakerTitle": "掲示板"
				},
				{
					"id": 731950802,
					"content": "「あのお方がこの世に再臨される日、お前ら頭に葉っぱの映えたヤツらはみな報いを受けるぞ！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950803
					],
					"speakerTitle": "掲示板"
				},
				{
					"id": 731950803,
					"content": "この情報は事実ではない。マハマトラはこのデマの出所を調査中である。スメールの内外を問わず、重要な情報はすべてアーカーシャに定期的に投稿される。各自軽々しくデマを信じないように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "掲示板"
				}
			]
		},
		{
			"id": 7319509,
			"completionStepIds": [
				7319509
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319509",
							"2"
						],
						"stepId": 7319509,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950901,
					"content": "「ご友人がた、何かお困りのことはありまして？万能のサングマハベイ様が、心を込めて、様々な解決策をご提供しますわ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950902
					],
					"speakerTitle": "掲示板"
				},
				{
					"id": 731950902,
					"content": "「ちょっとしたモラを払うだけで、あなたの問題をすべて解決して差し上げますの。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950903
					],
					"speakerTitle": "掲示板"
				},
				{
					"id": 731950903,
					"content": "「さあさ、考えるよりまず動け、ですわ。連絡先は…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950904
					],
					"speakerTitle": "掲示板"
				},
				{
					"id": 731950904,
					"content": "ここはワズィール様の設置された掲示板である。規律ある市場取引のため、ここで宣伝をするのは控えるように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "掲示板"
				}
			]
		},
