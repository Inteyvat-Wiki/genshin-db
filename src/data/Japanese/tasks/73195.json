					"nextDialogs": [
						731951502
					],
					"speakerTitle": "掲示板"
				},
				{
					"id": 731951502,
					"content": "逆に彼らから迷惑をかけられた場合は、教令官に報告し教令院に任せるように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
