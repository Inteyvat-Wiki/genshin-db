				"points": []
			},
			"dialogs": [
				{
					"id": 221150301,
					"content": "もう行っちゃった…オイラたちも戻ろうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 221150302,
					"content": "ん？地面になにか…これって常九が落としたものか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 221150303,
					"content": "うーん…とりあえず拾っておこう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 2211505,
			"completionStepIds": [
				2211507
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
