			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"常九"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221150201,
					"content": "はあ…この怪物たち、しつこいな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150202
					],
					"speakerTitle": "常九"
				},
				{
					"id": 221150202,
					"content": "新しい小説の取材に来たのに、取材どころか、怪物に襲われていたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150203
					],
					"speakerTitle": "常九"
				},
				{
					"id": 221150203,
					"content": "君たちがいなかったら、どうすればいいか分からなかった、ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150204
					],
					"speakerTitle": "常九"
				},
				{
					"id": 221150204,
					"content": "若心おばあさんが心配してる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150205
					]
				},
				{
					"id": 221150205,
					"content": "心配？何が心配だ、わしは大人だぞ、自分の世話は自分でできる。まあ…こういう予想外のことも、本当は自分でなんとかできるが、ちょっと骨が折れるだけだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150206
					],
					"speakerTitle": "常九"
				},
				{
					"id": 221150206,
					"content": "でも、礼を言うよ…さて、わしは帰るかな、ばあさんに怒られたくないのでね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "常九"
				}
			]
		},
		{
			"id": 2211503,
			"completionStepIds": [
				2211505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
