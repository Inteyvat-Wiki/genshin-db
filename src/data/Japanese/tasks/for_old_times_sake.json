			"trigger": {
				"objectNames": [
					"若心"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221150101,
					"content": "はあ、常くん…まだ帰ってこないのう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150102
					],
					"speakerTitle": "若心"
				},
				{
					"id": 221150102,
					"content": "常くんは…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150103
					]
				},
				{
					"id": 221150103,
					"content": "常くんは常九のことじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150104
					],
					"speakerTitle": "若心"
				},
				{
					"id": 221150104,
					"content": "普段は常くんて呼んでおるからのう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150105
					],
					"speakerTitle": "若心"
				},
				{
					"id": 221150105,
					"content": "昨日の夜、小説の取材をしてくると言って出かけたんじゃが、その時は気にしてなくて、ただ早く帰るようにって返事したんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150106
					],
					"speakerTitle": "若心"
				},
				{
					"id": 221150106,
					"content": "しかし、今になっても帰ってこなくてのう、何かあったんじゃないかって心配なんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150107
					],
					"speakerTitle": "若心"
				},
				{
					"id": 221150107,
					"content": "もう歳じゃから、自分で探すのも難しい。私の代わりに常くんを探してくれないかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150108,
						221150110
					],
					"speakerTitle": "若心"
				},
				{
					"id": 221150108,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150109
					]
				},
				{
					"id": 221150109,
					"content": "よかった、頼んだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "若心"
				},
				{
					"id": 221150110,
					"content": "どこに行ったか分かる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150111
					]
				},
				{
					"id": 221150111,
					"content": "まあ、北にある「無妄の丘」以外、他にないじゃろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150112
					],
					"speakerTitle": "若心"
				},
				{
					"id": 221150112,
					"content": "見てきてくれないかい？こんなに時間が経ったんじゃから、心配じゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "若心"
				}
			]
		},
		{
			"id": 2211502,
			"completionStepIds": [
				2211504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
