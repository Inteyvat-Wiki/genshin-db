			},
			"dialogs": [
				{
					"id": 221150601,
					"content": "はあ、常くんたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150602
					],
					"speakerTitle": "若心"
				},
				{
					"id": 221150602,
					"content": "常九はもう戻ったよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150603
					]
				},
				{
					"id": 221150603,
					"content": "ああ、彼には会ったよ、ご苦労様。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150604
					],
					"speakerTitle": "若心"
				},
				{
					"id": 221150604,
					"content": "彼は幼い頃から問題児じゃからのう、もう大人って言っておるけど、全然大人になっておらんよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150605
					],
					"speakerTitle": "若心"
				},
				{
					"id": 221150605,
					"content": "まあ、あなたたちが心配することはない、常くんのことじゃからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150606
					],
					"speakerTitle": "若心"
				},
				{
					"id": 221150606,
					"content": "私の代わりに探してくれてありがとう。報酬を受け取っておくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150607
					],
					"speakerTitle": "若心"
				},
				{
					"id": 221150607,
					"content": "他に用事があるんじゃろ、もう行っていいんじゃぞ。常くんのように「頭角を現わす」やら、「見直してもらう」やらで自分を見つめ直す機会を見逃してはならんぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150608
					],
					"speakerTitle": "若心"
				},
				{
					"id": 221150608,
					"content": "はあ…人生というのは難しいのう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "若心"
				}
			]
		},
