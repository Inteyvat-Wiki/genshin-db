			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"常九"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221150501,
					"content": "はあ、どうすればいい小説が書けるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150502
					],
					"speakerTitle": "常九"
				},
				{
					"id": 221150502,
					"content": "これを落とした？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150503
					]
				},
				{
					"id": 221150503,
					"content": "ん？ああ…確かにわしのものだ、ボツになった原稿でね、川に捨てるつもりだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150504
					],
					"speakerTitle": "常九"
				},
				{
					"id": 221150504,
					"content": "拾ってくるなんて…もう字も読めなくなってるのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150505
					],
					"speakerTitle": "常九"
				},
				{
					"id": 221150505,
					"content": "何を書いたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150506
					]
				},
				{
					"id": 221150506,
					"content": "ああ、幼馴染のために書いた話なのだが、これはボツになったものだ。昔、あいつに毎日お話してってせがまれてたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150507
					],
					"speakerTitle": "常九"
				},
				{
					"id": 221150507,
					"content": "その時は書く時間がなくて、序章だけ書いてあいつに渡して、いつか時間がある時にゆっくり書こうと思ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150508
					],
					"speakerTitle": "常九"
				},
				{
					"id": 221150508,
					"content": "しかしあいつはある日急にいなくなって、いくら探してもいなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150509
					],
					"speakerTitle": "常九"
				},
				{
					"id": 221150509,
					"content": "フン、きっとあいつの家族がわしのことをよく思ってなくて、一緒にいてほしくなかったから、軽策荘から引っ越したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150510
					],
					"speakerTitle": "常九"
				},
				{
					"id": 221150510,
					"content": "見てるがいい、いつかわしが成功したら、見直してもらうぞ！そして幼馴染に書いた本を全世界に売るんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150511
					],
					"speakerTitle": "常九"
				},
				{
					"id": 221150511,
					"content": "そうしたらあいつらがどこにいても、わしはもうあの頃のわしじゃないって分かるはずだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150512
					],
					"speakerTitle": "常九"
				},
				{
					"id": 221150512,
					"content": "そして…あいつと再会することだって…でもその前に、まずはこの本を書き終えないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150513
					],
					"speakerTitle": "常九"
				},
				{
					"id": 221150513,
					"content": "…すまない、勝手に喋り出して。はあ、どうすればいい小説を書けるかについて考えておかないとな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "常九"
				}
			]
		},
		{
