			},
			"dialogs": [
				{
					"id": 413590101,
					"content": "「玲瓏霄灯図」へようこそ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590102
					],
					"speakerTitle": "千"
				},
				{
					"id": 413590102,
					"content": "今回も違う図案を用意したの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413590103
					]
				},
				{
					"id": 413590103,
					"content": "もちろん、2回も君に解かれたからね、今回は過去最高に難しい灯に変えてきたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590104
					],
					"speakerTitle": "千"
				},
				{
					"id": 413590104,
					"content": "でも、図案は前と同じく3つに分かれてる。そして今回も、難易度を上げたのは<color=#00E1FFFF>「連動」</color>なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590105
					],
					"speakerTitle": "千"
				},
				{
					"id": 413590105,
					"content": "へへ、自分で体験してみて。今回の図案は<color=#00E1FFFF>「鶴」</color>だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590106
					],
					"speakerTitle": "千"
				},
				{
					"id": 413590106,
					"content": "図案ができたら、宝を探しに行くといいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "千"
				}
			]
		},
