			},
			"dialogs": [
				{
					"id": 413590201,
					"content": "どう？宝探しの旅は順調かな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590202
					],
					"speakerTitle": "千"
				},
				{
					"id": 413590202,
					"content": "宝は全部見つけた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413590203
					]
				},
				{
					"id": 413590203,
					"content": "本当に3つの図案を全部解いたんだね…すごいな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590204
					],
					"speakerTitle": "千"
				},
				{
					"id": 413590204,
					"content": "ゴホン…君みたいな実力のある冒険者には、協会から特別な報酬が用意されている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590205
					],
					"speakerTitle": "千"
				},
				{
					"id": 413590205,
					"content": "向こうにある宝箱は見える？開けるといい、あれは全部君の物だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590206
					],
					"speakerTitle": "千"
				},
				{
					"id": 413590206,
					"content": "あれを取ったら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413590207
					]
				},
				{
					"id": 413590207,
					"content": "もちろん後の人の分はなくなるよ。でも、冒険とはそういうものなんだ。いつでも早い者勝ちさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590208
					],
					"speakerTitle": "千"
				},
				{
					"id": 413590208,
					"content": "じゃあ、引き続き海灯祭を楽しんでね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "千"
				}
			]
		},
