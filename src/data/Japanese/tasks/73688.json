			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"神里綾華"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736880301,
					"content": "見ろ。神里家のお嬢様と旅人が来たぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880302
					],
					"speakerTitle": "由宇"
				},
				{
					"id": 736880302,
					"content": "小説の挿絵であの衣装は見たことあるけど、神里家のお嬢様が着ると、また特別な雰囲気があるわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880303
					],
					"speakerTitle": "紗江"
				},
				{
					"id": 736880303,
					"content": "朝一で並んで、最前列の席を取った甲斐があった。今日の試合はきっと素晴らしいものになるはずだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880304
					],
					"speakerTitle": "松前"
				},
				{
					"id": 736880304,
					"content": "わあ、やっぱ綾華が出てくると、みんなの注目の的になっちゃうんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736880305,
					"content": "皆さん、どうかお静かに。「演武伝心」の模擬試合がまもなく開始します。案内に従って入場していただき、ご着席ください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880306
					],
					"speakerTitle": "玲菜"
				},
				{
					"id": 736880306,
					"content": "神里さん、旅人、お二人も一緒にご入場を。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880307
					],
					"speakerTitle": "玲菜"
				},
				{
					"id": 736880307,
					"content": "旅人さん、準備はできていますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880308,
						736880310
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736880308,
					"content": "問題ない、行こう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880309
					]
				},
				{
					"id": 736880309,
					"content": "ええ、この後の戦い、よろしくお願いいたします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736880310,
					"content": "もうちょっと準備させて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880311
					]
				},
				{
					"id": 736880311,
					"content": "はい、焦らずとも大丈夫です。まだ時間はあります。準備が済みましたら、共に入場しましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "神里綾華"
				}
			]
		},
		{
			"id": 7368804,
			"completionStepIds": [
				7368806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7368806",
							"2"
						],
						"stepId": 7368806,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"神里綾華"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736880401,
					"content": "旅人、綾華、ここだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736880402,
					"content": "素晴らしい試合でした。剣術のことはよく分かりませんけど、会場の緊張感に当てられて、未だに心臓がドキドキしています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880403
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 736880403,
					"content": "だな。敵が技を繰り出すたびに、オイラびくびくしたぞ。でもおまえたち、まるで準備してたかのようにすぐ対応してたな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736880404,
					"content": "旅人、神里綾華、模擬試合の勝利、見事だった。おめでとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880405
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 736880405,
					"content": "わっ、裟羅！おまえも試合を観に来てたのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736880406,
					"content": "ああ、将軍様の命でこの試合を見届けるために来たんだ。二人とも素晴らしい剣術を披露し、それに息もあっていた。観客たちに剣術の美を見せただけではなく、私も多くを勉強させてもらった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880407
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 736880407,
					"content": "それほどでもありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880408
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736880408,
					"content": "お前たちは大会の準備段階から駆け回り、そして今日、演武伝心の大会を無事終了させた。すべては将軍様も見ていらっしゃる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880409
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 736880409,
					"content": "これより天守閣に戻り、将軍様に今回の模擬試合のことをありのまま報告するつもりだ。では、先に失礼させてもらう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880411
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 736880411,
					"content": "ところで、皆さんこれから予定はありますか？烏有亭で打ち上げをするのはいかがでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880412
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 736880412,
					"content": "やった！ここ最近、毎日試合のことばっかりで、ゆっくりご飯を食べられなかったからな！はやく行こうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736880413,
					"content": "ふぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880414
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736880414,
					"content": "どうしたの、綾華？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880415
					]
				},
				{
					"id": 736880415,
					"content": "いえ、今になってようやく試合に勝った実感が湧いてきました。この試合で多くを勉強させてもらったと、九条さんは言いましたが、実は私も同じ感想です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880416
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736880416,
					"content": "観客席にいた皆様は気づいていないかもしれません。ですが、何度も危険を乗り越えることができたのは、貴方が傍にいて、敵の攻撃を引き付けてくれたからです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880417
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736880417,
					"content": "貴方がいなければ…私一人では絶対に勝てませんでした。剣術の腕は、まだまだ貴方には及びませんね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880418,
						736880419
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736880418,
					"content": "綾華にも何度も助けてもらった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880420
					]
				},
				{
					"id": 736880420,
					"content": "そうですか？そんな風に言われると、今からでも貴方と手合わせをしたくなってきました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880421
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736880421,
					"content": "実を言うと、旅人さんと知り合って以来、ずっと貴方と技を磨き合いたいと思っていたのです。今日の模擬試合で、この願いは半分叶ったようなものでしたが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880422
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736880422,
					"content": "今度機会があれば、ちゃんと勝負しよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880423
					]
				},
				{
					"id": 736880423,
					"content": "はい。でも…その前に、ちゃんと自分の剣をしっかり管理してくださいね？いつか私に盗まれたら、貴方の命も、私の手の中に落ちちゃいますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880424
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736880424,
					"content": "ふふっ…ずっとこういうセリフを言ってみたかったんです。おかしかったでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880425,
						736880426
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736880425,
					"content": "オルツィ嬢みたいだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880427
					]
				},
				{
					"id": 736880427,
					"content": "おい、おまえたちゆっくり歩いて、なに内緒話してるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880428
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736880428,
					"content": "いつかちゃんと試合をして、どちらの剣術の腕が上か決めようと話していたんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880429
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736880429,
					"content": "おお、綾華は剣術のことに対して真面目だな。でも綾華と旅人は友達だろ。それでも試合するのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880430
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736880430,
					"content": "友達だからこそ、常に切磋琢磨して、励まし合うのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880431
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736880431,
					"content": "へえ、確かにそれも一理あるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880432
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736880432,
					"content": "旅人さん、先ほどの話は、二人だけの秘密ですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880433
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736880433,
					"content": "ん？綾華、なんか言ったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880434
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736880434,
					"content": "いいえ、行きましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736880426,
					"content": "可愛かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880427
					]
				},
				{
					"id": 736880419,
					"content": "綾華は謙虚すぎる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880420
					]
				}
			]
		},
