				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"神里綾華"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736880101,
					"content": "おぬしの武芸は大したものだ。この勝負、拙者の負けでござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880102
					],
					"speakerTitle": "暁月左衛門十蔵"
				},
				{
					"id": 736880102,
					"content": "かたじけない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880103
					]
				},
				{
					"id": 736880103,
					"content": "皆さん、手に汗を握る一戦を経て、ついに今回の「演武伝心剣術大会」の優勝者が誕生しました——旅人の優勝です！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880104
					],
					"speakerTitle": "玲菜"
				},
				{
					"id": 736880104,
					"content": "明日は、大会最後の模擬試合が開催されます。旅人と神里さんは共に、将軍様の特使である人形からくり剣士「魔偶剣豪」と戦います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880105
					],
					"speakerTitle": "玲菜"
				},
				{
					"id": 736880105,
					"content": "皆さん、またお会いしましょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880106
					],
					"speakerTitle": "玲菜"
				},
				{
					"id": 736880106,
					"content": "旅人さん、素晴らしい試合でしたね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880107
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736880107,
					"content": "おめでとうございます、旅人さん。優勝したのは名実伴った結果でしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880108
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 736880108,
					"content": "でも、明日戦う「魔偶剣豪」ってやつ…以前、ヤシオリ島の外れで会ったのと名前が似てるな。なんだか手強そうだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736880109,
					"content": "心配いりません。特使の実力は相当なものですが、明日の試合では神の目の使用が禁じられていません。私たちは多少主導権を握れると思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880110
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736880110,
					"content": "それに、相手の出方に応じて隙を窺えば、反撃する機会はきっとあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880111
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736880111,
					"content": "綾華がそう言うなら、オイラもなんだか安心してきたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736880112,
					"content": "もちろん最終的に勝てるかどうか、私も確信ありません。しかし全力で戦わなければ、観客たちに最高の試合をお届けすることはできないでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880113,
						736880114
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736880113,
					"content": "きっと勝てると思う、綾華。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880115
					]
				},
				{
					"id": 736880115,
					"content": "お二人とも張り切っていますね。今晩はちゃんと休んで、英気を養っておいてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880116
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 736880116,
					"content": "おう。明日、目が覚めたら綾華の新衣装を見られるな。フォンテーヌの服を着た綾華か…へへ、楽しみだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736880117,
					"content": "ええと、それは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880118,
						736880120
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736880118,
					"content": "#{M#俺}{F#私}も楽しみ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880119
					]
				},
				{
					"id": 736880119,
					"content": "どうして旅人さんまで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880121
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736880121,
					"content": "いいじゃないですか、綾華さん、お二人の期待に応えてあげましょう。私も明日用事さえなければ、一緒に見に行きたかったのですが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880122
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 736880122,
					"content": "ええ、分かりました。では約束です。明日の朝、神里屋敷でお待ちしております。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736880120,
					"content": "迎えに行こうか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880121
					]
				},
				{
					"id": 736880114,
					"content": "素晴らしい試合を届けられると思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880115
					]
				}
			]
		},
		{
			"id": 7368802,
			"completionStepIds": [
				7368803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7368803",
							"2"
						],
						"stepId": 7368803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"宏達",
					"神里綾華"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736880201,
					"content": "二人とも、来たか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880202
					],
					"speakerTitle": "宏達"
				},
				{
					"id": 736880202,
					"content": "げっ、宏達かよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736880203,
					"content": "先日の試合で旅人はもうおまえに勝ったんだ。それに優勝したし、もう言うことないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736880204,
					"content": "安心してくれ。今日は困らせに来たわけじゃなく、謝りに来たんだ。旅人、先日の試合は見事だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880205
					],
					"speakerTitle": "宏達"
				},
				{
					"id": 736880205,
					"content": "君は剣術に精通している。技の出し方もキレはあるが威圧感がなく、品格を伺えるものだ。この前は君のことを軽んじてしまった。無礼な態度を取って申し訳ない。許してくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880206,
						736880207
					],
					"speakerTitle": "宏達"
				},
				{
					"id": 736880206,
					"content": "大丈夫、気にしてない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880208
					]
				},
				{
					"id": 736880208,
					"content": "二人はお嬢様を迎えに来たんだろう？お嬢様は室内で着付けをしていらっしゃる、もうすぐ出てくるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880209
					],
					"speakerTitle": "宏達"
				},
				{
					"id": 736880209,
					"content": "旅人、お嬢様が来る前に不躾なお願いがあるのだが、聞いてくれないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880210
					],
					"speakerTitle": "宏達"
				},
				{
					"id": 736880210,
					"content": "いいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880211
					]
				},
				{
					"id": 736880211,
					"content": "お嬢様は、我々家臣に今日の模擬試合について話さないんだ。だが、最近はどんなに忙しくても、夜になると必ず数時間剣術の鍛錬をなさっていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880212
					],
					"speakerTitle": "宏達"
				},
				{
					"id": 736880212,
					"content": "お嬢様はいつも真面目だ。今日はあくまで模擬試合であって、勝たなくてもいい…とはいえお嬢様の性格だ。絶対に全力を出して、我を忘れるまで戦うだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880213
					],
					"speakerTitle": "宏達"
				},
				{
					"id": 736880213,
					"content": "家臣である俺は、もちろんお嬢様の実力を信じている。ただ…やはり試合ではお嬢様を援護し、守ってほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880214
					],
					"speakerTitle": "宏達"
				},
				{
					"id": 736880214,
					"content": "そうするから安心して。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880215
					]
				},
				{
					"id": 736880215,
					"content": "旅人、お嬢様のこと頼んだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880217
					],
					"speakerTitle": "宏達"
				},
				{
					"id": 736880217,
					"content": "おっ、綾華が出てきたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736880218,
					"content": "わあ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880219
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736880219,
					"content": "その、どうしたのでしょうか。お二人とも黙ってしまって…この衣装、おかしいのでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880220
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736880220,
					"content": "いやいや！綾華、すっごくキレイだぞ…目の前がパッと明るくなった感じがするぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880221,
						736880225
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736880221,
					"content": "とても似合ってる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880222
					]
				},
				{
					"id": 736880222,
					"content": "おう、そうだな。まるでフォンテーヌのお嬢さんみたいだ。雰囲気も活発な感じがするな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880223
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736880223,
					"content": "本当ですか？遊び心があり過ぎて…このような格好は合わないのではないかと心配していたのですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880224
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736880224,
					"content": "でも貴方たちが似合っていると思ってくれたのなら、安心しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880229
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736880229,
					"content": "へへっ、みんなも綾華の姿を見たら、きっと驚くだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880230
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736880230,
					"content": "パイモンさん、ありがとうございます。旅人さん、準備が整いましたので、会場へ向かいましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880231
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736880231,
					"content": "お嬢様、旅人、いってらっしゃい。模擬試合がうまく行くように祈っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宏達"
				},
				{
					"id": 736880225,
					"content": "ぴったりでとても素敵な衣装だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880226
					]
				},
				{
					"id": 736880226,
					"content": "そうだな。それによく見ると、スカートに神里家の椿紋まで刺繍してあるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880227
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736880227,
					"content": "ええ、これは小野寺さんがここ数日で急いでこしらえてくれたものでして。観客たちの投票用紙に書かれた意見をもとに追加したそうです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880228
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736880228,
					"content": "この衣装はぴったりと体に合うよう調整されていて、動きも思ったより不自由はありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880229
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736880207,
					"content": "あの戦いは存分に楽しめた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880208
					]
				}
			]
		},
		{
			"id": 7368803,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
