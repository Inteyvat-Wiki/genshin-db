	"talks": [
		{
			"id": 7368801,
			"completionStepIds": [
				7368801
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7368801",
							"2"
						],
						"stepId": 7368801,
						"stateName": "QUEST_STATE_UNFINISHED"
