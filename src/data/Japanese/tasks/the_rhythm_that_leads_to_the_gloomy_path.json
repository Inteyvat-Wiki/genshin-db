			"dialogs": [
				{
					"id": 730691801,
					"content": "これが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730691802
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730691802,
					"content": "うん、これがヴァソマの実だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730691803
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730691803,
					"content": "ヴァソマの実は、ヴァサラの樹の夢と記憶を集めて結ばれたもの。ボクたちにとっては、力を回復させてくれる貴重な果実。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730691804
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730691804,
					"content": "「アシュヴァッタの樹」にビージャの実を実らせるには、たくさんの力を費やす必要がある。だからボクたちはヴァソマの実でカレを養う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730691805
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730691805,
					"content": "#ナラ{NICKNAME}、ヴァソマの実を大事に取っておいてね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730691806
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730691806,
					"content": "ああ…それならアランマに「お宝」の意味を教えてやるぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730691807
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730691807,
					"content": "お宝ってのは、とても貴重なものって意味だ。ヴァソマの実にはたくさんの夢と記憶が詰まっていて、アランナラの力を回復してくれる。これってすごいし、貴重なものだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730691808
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730691808,
					"content": "ヴァソマの実みたいに貴重で大事なもののことをお宝って言うんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730691809
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730691809,
					"content": "おーっ！お宝ってそういう意味だったんだ…分かったよ！ありがとうパイモン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730691810,
						730691812
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730691810,
					"content": "次はどうすればいい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730691811
					]
				},
				{
					"id": 730691811,
					"content": "うーん…前にアランラジャが言ってたけど、ヴァソマの実は一個だけじゃないんだろ。つまり、別のアシュヴァッタ堂を探さないといけないんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730691814
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730691814,
					"content": "#うん。がんばるよ！ナラ{NICKNAME}、パイモン、後でまた会おう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730691815
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730691815,
					"content": "うん！またな、アランマ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730691812,
					"content": "ありがとうパイモン！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730691813
					]
				},
				{
					"id": 730691813,
					"content": "おまえまでなに言ってんだよ…前にアランラジャが言ってたけど、ヴァソマの実は一個だけじゃないんだよな。つまり、別のアシュヴァッタ堂も探さないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730691814
					],
					"speakerTitle": "パイモン"
				}
			]
