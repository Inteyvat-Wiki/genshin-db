					"アランヤサ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730690301,
					"content": "また会ったな！アランマ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730690302,
					"content": "#うん！ナラ{NICKNAME}にパイモン、こんにちは！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690303
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730690303,
					"content": "あっ、コイツはアランヤサ。アシュヴァッタ堂を探してる時に、ここで会ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690304
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730690304,
					"content": "よろしくな、アランヤサ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730690305,
					"content": "こんにちは！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730690306
					]
				},
				{
					"id": 730690306,
					"content": "#「次に歌うは…一人の{M#少女}{F#少年}が珍しきものを探す詩歌。旅の始まりの時、{M#カノジョ}{F#カレ}の瞳は曇りなき琥珀色だった…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690307
					],
					"speakerTitle": "アランヤサ"
				},
				{
					"id": 730690307,
					"content": "…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690308,
						730690309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730690308,
					"content": "なんなんだ…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730690310
					]
				},
				{
					"id": 730690310,
					"content": "うん。アランヤサは「歌摘み」さ。いつもいろんな歌を集めて回ってる。アランヤサは歌摘みのアランナラの中でも一番度胸があって、よくナラの歌を習ってくるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690311
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730690311,
					"content": "「我らの宿命は、共に生まれた真珠…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690312,
						730690313
					],
					"speakerTitle": "アランヤサ"
				},
				{
					"id": 730690312,
					"content": "会話が成り立たない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730690316
					]
				},
				{
					"id": 730690316,
					"content": "話を戻すと…ここがアシュヴァッタ堂なんだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690317
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730690317,
					"content": "ううん、違う。でも、これもすごい発見だ。ここには、アランナラが長いこと見つけられなかった歌が眠っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690318
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730690318,
					"content": "アランナラの歌摘みは、ずっと歌の美しさを求め続ける。そして終わりの時に、自分だけの歌を残す。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690319,
						730690321
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730690319,
					"content": "それとアシュヴァッタ堂に何か関係が？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730690320
					]
				},
				{
					"id": 730690320,
					"content": "うん！ここには、アランジの残した歌があるみたいだ。だとしたら、この近くにヴァサラの樹があるはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690323
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730690323,
					"content": "ヴァサラの樹…前にアランラジャが言ってたな。あの…なんだっけ、森林書に書いてあった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690324
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730690324,
					"content": "#ヴァサラの樹！ヴァソマの実がもらえるヴァサラの樹だ！オイラたちも手伝おうぜ、{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690325
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730690325,
					"content": "「ああ、その思いはザクロのように赤い実を結ぶ。たとえ運命がキミの両目を覆っても…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690326,
						730690327
					],
					"speakerTitle": "アランヤサ"
				},
				{
					"id": 730690326,
					"content": "それがラナを助けるために必要なら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730690331
					]
				},
				{
					"id": 730690331,
					"content": "まあとにかく、そのバラの中に歌が隠されているんだ。でも…ボクとアランヤサでいくら探しても見つからないんだ。そのバラたちも、ボクたちと話をしてくれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690332
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730690332,
					"content": "#なるほど…{NICKNAME}、オイラたちも探してみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690333,
						730690335
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730690333,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730690334
					]
				},
				{
					"id": 730690334,
					"content": "おう！オイラたち、物探しは得意だもんな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730690335,
					"content": "「私はあなたの詩を灯す。」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730690336
					]
				},
				{
					"id": 730690336,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730690327,
					"content": "「その唇から歌を奪うことはできない…」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730690328
					]
				},
				{
					"id": 730690328,
					"content": "#おーい、{NICKNAME}、どうしたんだよ！なんか変だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690329
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730690329,
					"content": "#ナラ{NICKNAME}はアランヤサと気が合う！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690330
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730690330,
					"content": "あんまりこいつをおだてるなって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690331
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730690321,
					"content": "幸運を祈ってる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730690322
					]
				},
				{
					"id": 730690322,
					"content": "#うん！ありがとうナラ{NICKNAME}。ここには、アランジの残した歌があるみたいだ。だとしたら、この近くにヴァサラの樹があるはず。運がいい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690323
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730690313,
					"content": "「ああ、罪のごとく甘い宿命よ。」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730690314
					]
				},
				{
					"id": 730690314,
					"content": "#おい、{NICKNAME}、マネするなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690315
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730690315,
					"content": "#ナラ{NICKNAME}はすごいね！アランヤサの歌と同じで、ぜんぜん分からないよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690316
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730690309,
					"content": "吟遊詩人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730690310
					]
				}
			]
		},
