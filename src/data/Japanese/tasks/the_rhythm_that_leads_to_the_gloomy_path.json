					"nextDialogs": [
						730690405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730690405,
					"content": "こんにちは！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730690406
					]
				},
				{
					"id": 730690406,
					"content": "#「次に歌うは…一人の{M#少女}{F#少年}が珍しきものを探す詩歌。旅の始まりの時、{M#カノジョ}{F#カレ}の瞳は曇りなき琥珀色だった…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690407
					],
					"speakerTitle": "アランヤサ"
				},
				{
					"id": 730690407,
					"content": "…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690408,
						730690409
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730690408,
					"content": "どうしたの…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730690410
					]
				},
				{
					"id": 730690410,
					"content": "アランヤサは歌摘みのアランナラの中でも一番度胸があって、よくナラの歌を習ってくるんだ。だから、話し方もちょっと変わっててね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690411
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730690411,
					"content": "「我らの宿命は、共に生まれた真珠…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690412,
						730690413
					],
					"speakerTitle": "アランヤサ"
				},
				{
					"id": 730690412,
					"content": "会話が成り立たない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730690416
					]
				},
				{
					"id": 730690416,
					"content": "話を戻すと…アランヤサが歌摘みってことは、この近くにアシュヴァッタ堂があるんだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690417
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730690417,
					"content": "アランジは、ここに最後の歌を残した。つまり、この近くにヴァサラの樹があるはず！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690418
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730690418,
					"content": "#だったら、オイラたちも手伝おうぜ、{NICKNAME}！急いでヴァソマの実を手に入れるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690419
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730690419,
					"content": "「ああ、その思いはザクロのように赤い実を結ぶ。たとえ運命がキミの両目を覆っても…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690420,
						730690421
					],
					"speakerTitle": "アランヤサ"
				},
				{
					"id": 730690420,
					"content": "ラナを助けるために…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730690425
					]
				},
				{
					"id": 730690425,
					"content": "#前みたいに、バラの中に歌が隠されているよ。ナラ{NICKNAME}とパイモンなら、きっと問題なく見つけられる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690426,
						730690428
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730690426,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730690427
					]
				},
				{
					"id": 730690427,
					"content": "おう！頼んだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730690428,
					"content": "「私はあなたの詩を灯す。」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730690429
					]
				},
				{
					"id": 730690429,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730690421,
					"content": "「その唇から歌を奪うことはできない…」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730690422
					]
				},
				{
					"id": 730690422,
					"content": "#おーい、{NICKNAME}、どうしたんだよ！なんか変だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690423
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730690423,
					"content": "#ナラ{NICKNAME}はアランヤサと気が合う！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690424
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730690424,
					"content": "あんまりこいつをおだてるなって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690425
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730690413,
					"content": "「ああ、罪のごとく甘い宿命よ。」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730690414
					]
				},
				{
					"id": 730690414,
					"content": "#おい、{NICKNAME}、マネするなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690415
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730690415,
					"content": "#ナラ{NICKNAME}はすごい！ぜんぜん分からない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690416
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730690409,
					"content": "吟遊詩人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730690410
					]
				}
			]
		},
