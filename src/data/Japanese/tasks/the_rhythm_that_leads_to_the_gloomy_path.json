			"dialogs": [
				{
					"id": 730690501,
					"content": "ああ…これがアランジの歌…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690502
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730690502,
					"content": "ああ…もう一度アナタの歌を聞くことができた。これでやっと約束が果たせる。アランジ、ワタシはキミの歌を携え、ずっと歌い続けよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690503
					],
					"speakerTitle": "アランヤサ"
				},
				{
					"id": 730690503,
					"content": "ありがとう、いいナラ。アランヤサは忘れない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690504
					],
					"speakerTitle": "アランヤサ"
				},
				{
					"id": 730690504,
					"content": "アランヤサのしゃべり方が普通になった…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730690505,
					"content": "#ありがとう、ナラ{NICKNAME}、パイモン！コイツとアランジは親友で、だからずっとその歌を探し続けていたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690506
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730690506,
					"content": "アランジは…憶病な友達で、静かな場所でそっと歌うのが好きだった。そして、カレの歌は未知の道を開くことができる。この歌が分かったからには…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690507
					],
					"speakerTitle": "アランヤサ"
				},
				{
					"id": 730690507,
					"content": "キミたちは、ここのアシュヴァッタ堂へ通じる道を開くことができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690508
					],
					"speakerTitle": "アランヤサ"
				},
				{
					"id": 730690508,
					"content": "うん！後はボクたちに任せて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690509
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730690509,
					"content": "#ええ。ウツァヴ祭で会おう、{M#勇ましき}{F#美しき}ナラ{M#どの}{F#さん}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランヤサ"
				}
			]
		},
