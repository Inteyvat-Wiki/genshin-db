			},
			"dialogs": [
				{
					"id": 730691901,
					"content": "これで二個目のヴァソマの実を手に入れたぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730691902
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730691902,
					"content": "#ナラ{NICKNAME}はすごいね！マラーナをやっつけただけじゃなく、怪物も恐れないなんて。さすがヴァナキを倒せるナラだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730691903
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730691903,
					"content": "ふふん、オイラたち冒険の中で色々なことを乗り越えてきたからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730691904
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730691904,
					"content": "#すごい！じゃあナラ{NICKNAME}とパイモンにもたくさんの記憶、たくさんの物語があるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730691905,
						730691906
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730691905,
					"content": "確かに色々あったよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730691907
					]
				},
				{
					"id": 730691907,
					"content": "#へえ。じゃあ、ナラ{NICKNAME}とパイモンの物語をボクたちに聞かせてほしいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730691908
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730691908,
					"content": "いいぜ！前にもオイラたちの物語を語ったことがあるけど、あれからずいぶん経った気がするよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730691909
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730691909,
					"content": "そう言えば、ヴァサラの樹の夢…夢の中で、遠くにとても大きな紫色の樹が見えたけど、あれってなんだろうな？ヴァナラーナでも見えるみたいだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730691910
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730691910,
					"content": "あれはね、最初の「アシュヴァッタの夢の樹」さ。うーんと…なんて言えばいいかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730691911
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730691911,
					"content": "夢は川に浮かぶ葉っぱみたいなもので、すぐに水と一緒に逃げて行ってしまうんだ。だから、夢を留めておきたければ、夢を根付かせないといけない。そうすれば逃げて行かない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730691912
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730691912,
					"content": "うう…なんて言えばいいかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730691913,
						730691914
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730691913,
					"content": "「アシュヴァッタの夢の樹」は根みたいなもの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730691915
					]
				},
				{
					"id": 730691915,
					"content": "#ナラ{NICKNAME}はかしこいね。この樹があれば、アランナラの夢はずっと残るし、たくさんのアランナラを中に入れたり、出したり、ヴァサラの樹と繋がったりもできる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730691916
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730691916,
					"content": "そうだったのか…つまり夢の中のヴァナラーナが、ずっと夢の中にあるのも、あの樹のおかげってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730691917
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730691917,
					"content": "そう、夢の樹があるから。でも今はマラーナのことが心配だ。みんなと一緒に解決法を考えないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730691918
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730691918,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730691919
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730691919,
					"content": "#でも、まずはビージャの実を実らせてからだ！だって、ナラ{NICKNAME}とパイモン、そしてアランラナの友達を助けないといけないから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730691920
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730691920,
					"content": "そうだな！アランマは引き続きアシュヴァッタ堂を探しに行くのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730691921
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730691921,
					"content": "うん、そのつもり！また会おうね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730691922
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730691922,
					"content": "気を付けろよ、アランマ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730691923
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730691923,
					"content": "#キミたちもね、ナラ{NICKNAME}、パイモン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730691914,
					"content": "「アシュヴァッタの夢の樹」は夢を留めておける？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730691915
					]
				},
				{
					"id": 730691906,
					"content": "大したことない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730691907
					]
				}
