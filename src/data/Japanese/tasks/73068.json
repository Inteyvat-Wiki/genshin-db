					"アランカラ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730680401,
					"content": "アランナクラだ！無事ヴァナラーナに帰ってきたんだな。それと…知らないアランナラも！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730680402,
					"content": "#ナラ{NICKNAME}、それにパイモン！ヴァルナ神器、治った。アランナクラも、苗畑に専念できる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680403
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730680403,
					"content": "こっちはアランカラ。アランナクラとアランカラ、一緒にヴァナラーナの苗畑をお世話してる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680404
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730680404,
					"content": "ここがアランナクラがよく言ってた苗畑かあ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730680405,
					"content": "そう。ここの土、育てるのにいい。ご機嫌なヴィパリャスができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680406
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730680406,
					"content": "不機嫌なヴィパリャスもいるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680407
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730680407,
					"content": "不機嫌はない。ただご機嫌がないだけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680408
					],
					"speakerTitle": "アランカラ"
				},
				{
					"id": 730680408,
					"content": "…ん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680409
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730680409,
					"content": "育てるのにいい土がある、雨と太陽が足りてる、育つのを邪魔されない…それと同じ。不幸じゃない、けどすごく幸せでもない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680410
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730680410,
					"content": "ふうん…普通ってことか？あれ、じゃあここは他の土地となにが違うんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680411
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730680411,
					"content": "ヴァナラーナの土、みんないい。でもここ、特別。それより大事なのは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680412
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730680412,
					"content": "アランカラとアランナクラがお世話してること。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680413
					],
					"speakerTitle": "アランカラ"
				},
				{
					"id": 730680413,
					"content": "お世話って…具体的にはどんな風にだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680414
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730680414,
					"content": "演奏、聴かせよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680415
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730680415,
					"content": "それと、きれいだねって褒める。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680416
					],
					"speakerTitle": "アランカラ"
				},
				{
					"id": 730680416,
					"content": "それが野生と栽培の違い…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680417
					]
				},
				{
					"id": 730680417,
					"content": "分からなくもないな…毎日素敵な音楽を聴いて、きれいだって褒めてもらったら、不機嫌にはなれないもんな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680418
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730680418,
					"content": "#うん、オイラみたいだ。{NICKNAME}に釣りあげられる前は、不機嫌じゃないけど、ご機嫌でもなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680419
					],
					"speakerTitle": "パイモン"
