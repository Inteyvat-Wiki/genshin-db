			},
			"dialogs": [
				{
					"id": 730680201,
					"content": "#ナラ{NICKNAME}とパイモン？アランパンドゥとアシャヴァンレルムに行ったアランナクラ、まだ帰ってこない。今のうち、キノコを食べに行って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランカラ"
				}
			]
		},
		{
			"id": 7306803,
			"completionStepIds": [
				7306803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7306803",
							"2"
						],
						"stepId": 7306803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アランナクラ",
					"アランカラ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730680301,
					"content": "アランナクラだ！無事に戻ってきてよかったぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730680302,
					"content": "#ナラ{NICKNAME}、それにパイモン！ヴァルナ神器、治った。アランナクラも、苗畑に専念できる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680303
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730680303,
					"content": "ここがアランナクラがよく言ってた苗畑かあ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730680304,
					"content": "そう、アランナクラ、アランカラと苗畑のお世話してる。ここの土は育てるのにいい、ご機嫌なヴィパリャスができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680305
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730680305,
					"content": "不機嫌なヴィパリャスもいるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730680306,
					"content": "不機嫌はない。ただご機嫌がないだけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680307
					],
					"speakerTitle": "アランカラ"
				},
				{
					"id": 730680307,
					"content": "…ん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730680308,
					"content": "育てるのにいい土がある、雨と太陽が足りてる、育つのを邪魔されない…それと同じ。不幸じゃない、けどすごく幸せでもない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680309
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730680309,
					"content": "ふうん…普通ってことか？あれ、じゃあここは他の土地となにが違うんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730680310,
					"content": "ヴァナラーナの土、みんないい。でもここ、特別。それより大事なのは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680311
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730680311,
					"content": "アランカラとアランナクラがお世話してること。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680312
					],
					"speakerTitle": "アランカラ"
				},
				{
					"id": 730680312,
					"content": "お世話って…具体的にはどんな風にだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730680313,
					"content": "演奏、聴かせよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680314
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730680314,
					"content": "それと、きれいだねって褒める。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680315
					],
					"speakerTitle": "アランカラ"
				},
				{
					"id": 730680315,
					"content": "それが野生と栽培の違い…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680316
					]
				},
				{
					"id": 730680316,
					"content": "分からなくもないな…毎日素敵な音楽を聴いて、きれいだって褒めてもらったら、不機嫌にはなれないもんな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680317
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730680317,
					"content": "#うん、オイラみたいだ。{NICKNAME}に釣りあげられる前は、不機嫌じゃないけど、ご機嫌でもなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680318
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730680318,
					"content": "#{NICKNAME}と旅を始めてからは…大変なこともあったけど、その分喜びは倍になったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680319
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730680319,
					"content": "パイモンの言う通り。アランカラ、ご機嫌なヴィパリャスできれいな灯り作る。ウツァヴ祭のために。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680320
					],
					"speakerTitle": "アランカラ"
				},
				{
					"id": 730680320,
					"content": "へへっ、アランナクラも帰ってきたことだし、さっさと始めようぜ！ヴィパリャスの種…ヴィパリャスにも種があるんだっけか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680321
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730680321,
					"content": "ヴィパリャス、大地の寝言。大地が夢の中で思い出すこと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680322
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730680322,
					"content": "じゃあ種は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680323
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730680323,
					"content": "ヴィパリャス、種ない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680324
					],
					"speakerTitle": "アランカラ"
				},
				{
					"id": 730680324,
					"content": "ええ？種がなかったら、どうやって植えるんだ…あっ！まさかアランナクラって、手品みたいにヴィパリャスを生やすアランラカラリを持ってるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680325
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730680325,
					"content": "ううん、パイモンは違う…苗畑でヴィパリャスを育てる、ヴァスミリティがいる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680326
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730680326,
					"content": "ヴァ…ヴァ…なんだ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680327
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730680327,
					"content": "ヴァスミリティ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680328
					]
				},
				{
					"id": 730680328,
					"content": "ヴァーナは全部を覚えてる。だからヴァスミリティあれば、大地は夢の中でまた思い出す。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680329
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730680329,
					"content": "苗畑も、ご機嫌なヴィパリャスを育てられる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680330
					],
					"speakerTitle": "アランカラ"
				},
				{
					"id": 730680330,
					"content": "#えっと…その「ヴァスミリティ」は、アランナラしか手に入れられないのか？オイラと{NICKNAME}は、苗畑でヴィパリャスを育てられないのか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680331
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730680331,
					"content": "#金色のナラ、アランナクラや他のアランナラを助けてくれた。アランナラの友達。だからアランナクラは、ナラ{NICKNAME}とヴィパリャスを育てる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680332
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730680332,
					"content": "#ヴァスミリティを泥の土に埋める、ヴィパリャスが生える。ナラ{NICKNAME}、やってみて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680333
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730680333,
					"content": "アランナクラの教えに従い、「ヴァスミリティ」を泥土に埋めた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730680334
					]
				},
				{
					"id": 730680334,
					"content": "これでオッケーか？種を土に埋めて発芽を待つなら、他の植物と変わんないな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680335
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730680335,
					"content": "ヴァスミリティ、種じゃない。パイモンが空飛ぶネコじゃないの、同じ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680336
					],
					"speakerTitle": "アランカラ"
				},
				{
					"id": 730680336,
					"content": "おう…そっか、分かった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680337
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730680337,
					"content": "ところで、苗畑には空き地がいっぱいだな。1、2、3…おお、まだ12か所もヴィパリャスが育てられそうな土地があるぞ。アランナクラ、もっとヴァスミリティを植えないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680338
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730680338,
					"content": "前はあった。でも今はこれ以上ない。また集めないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680339
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730680339,
					"content": "夢境の外にある、12か所の苗畑、そこでヴァスミリティが固まる。それあれば、ヴァナラーナの苗畑、いっぱいヴィパリャスを育てられる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680340
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730680340,
					"content": "#ウツァヴ祭、ヴィパリャスがたくさんいる。ヴァナラーナにはいっぱいあるけど、ご機嫌なヴィパリャスもっとあれば、アランナラは嬉しい。ナラ{NICKNAME}とパイモンも嬉しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680341
					],
					"speakerTitle": "アランカラ"
				},
				{
					"id": 730680341,
					"content": "それなら、ヴァスミリティ集めを手伝うぞ！でもどうやって集めるんだ？アランカラは夢境の外の苗畑にあるって言ってたけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680342
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730680342,
					"content": "金色のナラ、畑巡りをして。でも1回でいい、多すぎるはダメ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680343
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730680343,
					"content": "1回だけ巡る…苗畑の土、ヴァスミリティを作る。前の夜にしとしと雨が降る、ぼんやり夜が明けたみたいに、葉っぱに露がつく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680344
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730680344,
					"content": "…うーん…わけが分からないぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680345
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730680345,
					"content": "でも、今までアランナラと付き合ってきた経験からすれば…夢境の外の苗畑に行けば、アランナクラの言ってることが自然と分かるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680346
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730680346,
					"content": "苗畑を見つけたら、寄ってみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7306804,
