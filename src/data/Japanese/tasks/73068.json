			"trigger": {
				"objectNames": [
					"アランカラ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730680101,
					"content": "やあ！このあたりの土地は他とは違うみたいだな。特別な使い道でもあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730680102,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680103
					],
					"speakerTitle": "アランカラ"
				},
				{
					"id": 730680103,
					"content": "お——い——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680104,
						730680106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730680104,
					"content": "あ——の——！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680105
					]
				},
				{
					"id": 730680105,
					"content": "お——い——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680108
					],
					"speakerTitle": "アランカラ"
				},
				{
					"id": 730680108,
					"content": "な、なんで？ヴァナラーナにどうしてナラが？アランカラを取って食う？アランカラ、キノコほどおいしくない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680109
					],
					"speakerTitle": "アランカラ"
				},
				{
					"id": 730680109,
					"content": "そんなひどい事するわけないだろ。オイラたちは、誰もが認める「アランナラの愉快な仲間」なんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680110,
						730680112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730680110,
					"content": "全くの初耳…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680111
					]
				},
				{
					"id": 730680111,
					"content": "みんな口では言わないけど、心の中ではそう思ってるはずだ。そんなの聞くまでもないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730680114,
					"content": "#とにかく、オイラはパイモン。こっちの金色のは{NICKNAME}。{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}はいいナラだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730680115,
					"content": "おまえ、アランカラだよな？自分でなにしてたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730680116,
					"content": "パイモン、それ聞いてどうする？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680117
					],
					"speakerTitle": "アランカラ"
				},
				{
					"id": 730680117,
					"content": "えっと…ちょっと聞いてみただけだよ！蝶々がいたら追いかけるし、トカゲがいたら捕まえるだろ…本能みたいなもんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730680118,
					"content": "パイモン、空飛ぶネコ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680119
					],
					"speakerTitle": "アランカラ"
				},
				{
					"id": 730680119,
					"content": "ちがーう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730680120,
					"content": "えっと…アランナラの秘密とかなら、全然言わなくていいぞ。オイラたちもそこまで興味ないし…だよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730680121,
					"content": "すごく興味はあるけどね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680122
					]
				},
				{
					"id": 730680122,
					"content": "いや、それはそうなんだけどな…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730680123,
					"content": "「秘密」？アランカラに「秘密」ない。アランカラはなにもしてない。アランカラは待ってた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680124
					],
					"speakerTitle": "アランカラ"
				},
				{
					"id": 730680124,
					"content": "待ってた？他のアランナラをか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730680125,
					"content": "アランナクラは、アランパンドゥとアシャヴァンレルムへ行った。いつ帰るか分からない。ヴァルナ神器がよくないから、苗畑のお世話してる場合じゃない。うん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680126
					],
					"speakerTitle": "アランカラ"
				},
				{
					"id": 730680126,
					"content": "#ナラ{NICKNAME}、農作業…好き？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680127,
						730680129
					],
					"speakerTitle": "アランカラ"
				},
				{
					"id": 730680127,
					"content": "農作業は面倒くさい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680128
					]
				},
				{
					"id": 730680128,
					"content": "ワルカで農作業、大変。でもヴァーナでは違う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680131
					],
					"speakerTitle": "アランカラ"
				},
				{
					"id": 730680131,
					"content": "なんでオイラには聞いてくれないんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680132
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730680132,
					"content": "パイモン、蝶を追いかけて、トカゲ捕まえる。じっとできないなら、農作業ムリ。だから聞かない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680133
					],
					"speakerTitle": "アランカラ"
				},
				{
					"id": 730680133,
					"content": "言い返せない…！とにかく、オイラは過程より、結果が気になるたちなんだ！ここではなにを植えてるんだ？おいしいものか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680134
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730680134,
					"content": "おいしい、でも他の使い道ある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680135
					],
					"speakerTitle": "アランカラ"
				},
				{
					"id": 730680135,
					"content": "でもパイモン、空腹なら苗畑はやめてキノコを食べろ。ヴァーナはキノコが多すぎる、少しは食べて減らすべき。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680136
					],
					"speakerTitle": "アランカラ"
				},
				{
					"id": 730680136,
					"content": "とにかく、アランナクラが帰ってこない。何も始められない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680137
					],
					"speakerTitle": "アランカラ"
				},
				{
					"id": 730680137,
					"content": "#そっか。アランナクラの帰りを待つしかなさそうだな…じゃあ行くか、{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730680129,
					"content": "農作業大好き！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680130
					]
				},
				{
					"id": 730680130,
					"content": "そうか。アランカラもだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680131
					],
					"speakerTitle": "アランカラ"
				},
				{
					"id": 730680112,
					"content": "パイモンの言う通り！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680113
					]
				},
				{
					"id": 730680113,
					"content": "へへっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730680106,
					"content": "ご飯だよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680107
					]
				},
				{
					"id": 730680107,
					"content": "キノコはおいしい！…ナラ？おいしい？違う、ナラは食べられない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680108
					],
					"speakerTitle": "アランカラ"
				}
			]
		},
		{
			"id": 7306802,
