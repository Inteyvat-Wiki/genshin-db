			"dialogs": [
				{
					"id": 740820701,
					"content": "キラキラした雫が祭壇の上に現れた。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740820702
					]
				},
				{
					"id": 740830102,
					"content": "あれ、この雫…まさかこれがお宝なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740830103,
					"content": "あまりそうは見えないね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830104
					]
				},
				{
					"id": 740830104,
					"content": "オイラもそう思うぞ…こんなにあっさり見つかったんだからな…じゃあ、お宝じゃなかったら、これっていったいなんなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830105,
						740830110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740830105,
					"content": "魔王を封じてた重要アイテムかもね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830106
					]
				},
				{
					"id": 740830110,
					"content": "誰かがここに置いてたのかもね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830111
					]
				},
				{
					"id": 740830106,
					"content": "え？じゃあ大変なことになるだろ、早く！元のところに戻すんだ！手遅れになる前に！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740830107,
					"content": "あ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830108
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740830108,
					"content": "おしまいだぁ！魔王が出てきたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740830109,
					"content": "マオウ？メリュジーヌ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830115
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740830111,
					"content": "え？じゃあ、オイラたち泥棒じゃんか！ごめんごめん…早く元の場所に戻そうぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740830112,
					"content": "あ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830113
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740830113,
					"content": "おしまいだぁ！持ち主が戻ってきたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740830114,
					"content": "モチヌシ？メリュジーヌ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830115
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740830115,
					"content": "びっくりしたぞ…メリュジーヌか…どうしてここにいるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740830116,
					"content": "鍵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830117
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740830117,
					"content": "え…なにが鍵なんだ？この雫が鍵なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740830118,
					"content": "パシーフ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830119
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740830119,
					"content": "えっと…この雫がパシーフ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740830120,
					"content": "メリュジーヌ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830121
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740830121,
					"content": "えぇ？どういうことだよ？この雫がメリュジーヌ？頭がくらくらしてきたぞ、一体なんなんだ？おまえこそメリュジーヌだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740830122,
					"content": "パシーフ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830123
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740830123,
					"content": "ん…？おまえがパシーフ？それは名前か？それとも苗字？…聞いたらますますくらくらしてきたぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740830124,
					"content": "よし！おまえをパシーフって呼ぶ！これでいいか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740830125,
					"content": "メリュジーヌ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830126
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740830126,
					"content": "#{NICKNAME}…どうしよう？こいつがなにを言いたいのか全然わからないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740830127,
					"content": "#{M#俺}{F#私}たちの言葉は分かるんだよね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830128
					]
				},
				{
					"id": 740830128,
					"content": "パシーフ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830129
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740830129,
					"content": "この雫が鍵なんだよね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830130
					]
				},
				{
					"id": 740830130,
					"content": "パシーフ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830131
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740830131,
					"content": "#{M#君}{F#あなた}は人間じゃない、でしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830132
					]
				},
				{
					"id": 740830132,
					"content": "パシーフ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830133
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740830133,
					"content": "おい…そんなの見ればわかるだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830134
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740830134,
					"content": "#{M#俺}{F#私}は人間じゃない、でしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830135
					]
				},
				{
					"id": 740830135,
					"content": "メ…メリュジーヌ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830136
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740830136,
					"content": "あ！待て、ちょっとわかったぞ…「パシーフ」がはい、「メリュジーヌ」がいいえって意味じゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830137
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740830137,
					"content": "パシーフ！パシーフ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830138
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740830138,
					"content": "パシーフっておまえの名前じゃなかったのか…ごめんな、間違えちゃって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830139
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740830139,
					"content": "パシーフ…好き…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830140
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740830140,
					"content": "この名前が気に入ったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830141
					]
				},
				{
					"id": 740830141,
					"content": "パシーフ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830142
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740830142,
					"content": "#よかった！じゃあおまえをそう呼ぼう！へへっ、オイラはパイモン！こっちは{NICKNAME}。はじめまして、パシーフ。おまえみたいなメリュジーヌは見たことないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830143
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740830143,
					"content": "#パイモン、パシーフ！{NICKNAME}、パシーフ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830144
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740830144,
					"content": "エリニュス…メリュジーヌ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830145
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740830145,
					"content": "…エリニュスがいいえ？うーん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830146
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740830146,
					"content": "エリニュス島は良くないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830147
					]
				},
				{
					"id": 740830147,
					"content": "エリニュス、メリュジーヌ、今…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830148
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740830148,
					"content": "パシーフ、エリニュス、守る…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830149
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740830149,
					"content": "エリニュス島がまずいことになってるから、守りたいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830150
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740830150,
					"content": "#パイモン、{NICKNAME}、エリニュス、手、おてて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830151
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740830151,
					"content": "うーん…今度は言葉が五つも出てきたぞ…えっと…オイラとこいつと、手を繋ぎたいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830152
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740830152,
					"content": "メリュジーヌ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830153
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740830153,
					"content": "#{M#俺}{F#私}たちの手を借りたいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830154
					]
				},
				{
					"id": 740830154,
					"content": "パシーフ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830155
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740830155,
					"content": "協力してほしいってことか…手を繋ぐのかと思ってたぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830156
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740830156,
					"content": "手、おてて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830157,
						740830161
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740830157,
					"content": "報酬はある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830158
					]
				},
				{
					"id": 740830161,
					"content": "助けるってどうやって？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830162
					]
				},
				{
					"id": 740830158,
					"content": "ホウ…シュウ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830159
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740830159,
					"content": "#まったく、{NICKNAME}。こいつってあんまり話せないだろ、だからきっと他のやつに助けを求めたりするのができないと思うぞ。オイラたちが助けてやろうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830160
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740830160,
					"content": "助けるってどうやって？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830162
					]
				},
				{
					"id": 740830162,
					"content": "鍵、鍵、鍵、数。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830163
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740830163,
					"content": "それで？鍵の数は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830164
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740830164,
					"content": "鍵！鍵！鍵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830165
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740830165,
					"content": "鍵は三本？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830166
					]
				},
				{
					"id": 740830166,
					"content": "パシーフ！鍵、霧…道、南…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830167
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740830167,
					"content": "鍵、泉、北…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830168
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740830168,
					"content": "鍵、柳、東…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830169
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740830169,
					"content": "おお！なるほど…ひとまず覚えておくか…鍵は全部で三本、南の霧の道、北の泉、東の柳…ってことだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830170
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740830170,
					"content": "鍵、鍵、鍵、広場、西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830171
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740830171,
					"content": "西の広場にはさらに鍵が三本あるって？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830172
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740830172,
					"content": "鍵を三本集めて広場に行くってこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830173
					]
				},
				{
					"id": 740830173,
					"content": "#パイモン、メリュジーヌ！{NICKNAME}、パシーフ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830174
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740830174,
					"content": "#あっ、パシーフ！{NICKNAME}がオイラより賢いみたいに言わなくてもいいじゃんか！オイラはこいつと同じくらい賢いぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830175
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740830175,
					"content": "とにかく、オイラたちは鍵を一本手に入れたんだ、あと二本取ってくればいいんだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830176
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740830176,
					"content": "エリニュス、メリュジーヌ…パシーフ、守る！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830177
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740830177,
					"content": "安心しろ。何が起きたかわかんないけど、エリニュス島はオイラたちが守ってやるからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830178
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740830178,
					"content": "でも一つだけ…パシーフ、誰の物じゃない金ピカでまん丸の物、それかひと目見て高そうな箱があったら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830179
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740830179,
					"content": "オイラたちに一言くれると嬉しいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830180
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740820780,
					"content": "パシーフは分かったのか分からなかったのか頭を掻き、嬉しそうにぴょんぴょん飛び跳ねると、少し急ぎ足で去っていった。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740820781
					]
				},
				{
					"id": 740830181,
					"content": "#あ、行っちゃったぞ…よっぽど急いでんだな。{NICKNAME}、残り二本の鍵を探しに行こうぜ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
