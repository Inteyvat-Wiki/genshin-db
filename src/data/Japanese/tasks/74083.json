				},
				{
					"id": 740831003,
					"content": "うわ！パシーフ、どこから現れたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831004
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740831004,
					"content": "トツゼン！パシーフ。",
