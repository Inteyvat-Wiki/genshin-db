			"dialogs": [
				{
					"id": 750240601,
					"content": "ガゥ——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240602
					],
					"speakerTitle": "「マリーゴールド」"
				},
				{
					"id": 750240602,
					"content": "こ、興奮するなって！そいつが怪我をしてないか心配なだけなんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240603,
						750240605
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750240603,
					"content": "決闘しかなさそうだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240604
					]
				},
				{
					"id": 750240604,
					"content": "そんなに早くあきらめるなよ！マリーゴールド、オイラたち、悪気はないんだ。えっと、凶猛さがおまえの本性じゃないことも、オイラたち知ってるぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240606
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750240606,
					"content": "ガゥ！ウゥ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240607
					],
					"speakerTitle": "「マリーゴールド」"
				},
				{
					"id": 750240607,
					"content": "わぁ…もっと怒らせちゃったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750240605,
					"content": "「我が愛しのマリーゴールド」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240606
					]
				}
			]
		},
