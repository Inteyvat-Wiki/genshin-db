			"dialogs": [
				{
					"id": 750240701,
					"content": "（日記が置いてある…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240702,
						750240706,
						750240710,
						750240714
					]
				},
				{
					"id": 750240702,
					"content": "（一つ目のパートを読む。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240703
					]
				},
				{
					"id": 750240703,
					"content": "「…今日は雨の日だ。ナミの大好きな<color=#00E1FFFF>セビチェ</color>を用意した。満足そうに食べるナミの姿を見ると、何をしても報われる気がする…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240704
					],
					"speakerTitle": "誰かの日誌"
				},
				{
					"id": 750240704,
					"content": "「…どんなところで泳いでいても、<color=#00E1FFFF>セビチェ</color>を出せば必ず水から飛び出してくる。それも完璧な弧線を描きながら…！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240705
					],
					"speakerTitle": "誰かの日誌"
				},
				{
					"id": 750240705,
					"content": "「…私への愛情を疑っているわけではないが、時々<color=#00E1FFFF>セビチェ</color>のほうがもっと好きなのではないかと心配になる…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "誰かの日誌"
				},
				{
					"id": 750240706,
					"content": "（二つ目のパートを読む。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240707
					]
				},
				{
					"id": 750240707,
					"content": "「…丸い目、くるっとした尾、元気いっぱいの声…ヒスイよ、この世で君より可愛い竜なんていない…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240708
					],
					"speakerTitle": "誰かの日誌"
				},
				{
					"id": 750240708,
					"content": "「…一度も騙されたことがなく、疑うことを知らない。君なら、この世のすべての生き物と一緒に楽しく遊び、友達になれる…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240709
					],
					"speakerTitle": "誰かの日誌"
				},
				{
					"id": 750240709,
					"content": "「…暇な時間がもっとあれば、一日中君と遊びたいくらいだ。木漏れ日の林を駆け抜ける君の姿は、まるで風の子、無邪気な精霊だ！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "誰かの日誌"
				},
				{
					"id": 750240710,
					"content": "（三つ目のパートを読む。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240711
					]
				},
				{
					"id": 750240711,
					"content": "「…丘陵や谷を歩き回り、君の気配を探し回った。もし私のことが嫌いなら、すぐにでもどこかへ行ってしまっていたはず…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240712
					],
					"speakerTitle": "誰かの日誌"
				},
				{
					"id": 750240712,
					"content": "「…なのに君は私の足取りに合わせてくれた…私にたくさんのグレインの実やキラキラした石を集めてくれた…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240713
					],
					"speakerTitle": "誰かの日誌"
				},
				{
					"id": 750240713,
					"content": "「…愛しのマリーゴールドよ、その硬い殻の下に優しい心があることも、その凶猛さが決して本性ではないことも、私は知っている…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "誰かの日誌"
				},
				{
					"id": 750240714,
					"content": "（やっぱり読むのをやめよう…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
