			"dialogs": [
				{
					"id": 750240822,
					"content": "「マリーゴールド」と呼ばれるテペトル竜は、決闘に負けたあと地面に潜りこんで隠れたようだ。この隙に、あのけが人の様子を調べてみよう…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750240801
					]
				},
				{
					"id": 750240801,
					"content": "外傷はないみたいだけど…おーい、大丈夫か？聞こえるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240802
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750240802,
					"content": "…うぅ、マリーゴールドかい？私のこと、心配してくれているんだね？まったく、優しいやつだ。大丈夫だよ、君と気兼ねなく遊べるように、最近ずっとトレーニングしてるから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240803
					],
					"speakerTitle": "イカヨ"
				},
				{
					"id": 750240803,
					"content": "#オイラはパイモンだ。マリーゴールドなんかじゃないぞ！{NICKNAME}、もしかしてこいつ、さっき倒れたときに頭を打ったんじゃないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240804,
						750240805
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750240804,
					"content": "しばらくしたら目が覚めるかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240806
					]
				},
				{
					"id": 750240806,
					"content": "え？マリーゴールドじゃない…私、今どうなっているんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240807
					],
					"speakerTitle": "イカヨ"
				},
				{
					"id": 750240807,
					"content": "三匹の竜に囲まれ、「マリーゴールド」に倒されたことを詳しく説明した…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750240808
					]
				},
				{
					"id": 750240808,
					"content": "なるほど、迷惑をかけて悪かったね…私の名前はイカヨ。見ての通り、竜を追いかけるのが大好きで…たまに竜に追いかけられることもある冒険者だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240809
					],
					"speakerTitle": "イカヨ"
				},
				{
					"id": 750240809,
					"content": "最近体調を崩したせいで、しばらく寝込んでいたんだ。体力も落ちてしまって、この子たちともちゃんと会えていなくてね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240810
					],
					"speakerTitle": "イカヨ"
				},
				{
					"id": 750240810,
					"content": "今回はキャンプに着く前に囲まれてしまったようだ。きっと、私のことが心配で心配でたまらなかったんだろう。私は幸せものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240811,
						750240812
					],
					"speakerTitle": "イカヨ"
				},
				{
					"id": 750240811,
					"content": "随分とポジティブだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240813
					]
				},
				{
					"id": 750240813,
					"content": "ところで、さっきおまえを助けるために、マリーゴールドとちょっと揉めちゃったんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240814
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750240814,
					"content": "ああ、気にしなくていいよ。あの子にとってはただの遊びみたいなものだから。君たちに負けちゃって、今頃はどこかの隅っこで拗ねてることだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240815
					],
					"speakerTitle": "イカヨ"
				},
				{
					"id": 750240815,
					"content": "見た目とは違って、可愛くて繊細な子なんだ。後でちゃんと慰めておくから、心配しないで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240816
					],
					"speakerTitle": "イカヨ"
				},
				{
					"id": 750240816,
					"content": "それなら大丈夫そうだな。結構心配したけど、無事ならよかったぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240817
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750240817,
					"content": "君たちには心から感謝しているよ。そうだ、たいした物じゃないけど…このセビチェのレシピ、ぜひ受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240818
					],
					"speakerTitle": "イカヨ"
				},
				{
					"id": 750240818,
					"content": "#ナミはこの料理が大好きなんだ。君たちの仲間の{REALNAME[ID(2)|SHOWHOST(true)]}も気に入るかもしれないよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240819
					],
					"speakerTitle": "イカヨ"
				},
				{
					"id": 750240819,
					"content": "キュウ…キュー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240820
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750240820,
					"content": "#ん？おまえも食べたいのか？じゃあ、後で{NICKNAME}に作ってもらおうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240821
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750240821,
					"content": "キュー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
