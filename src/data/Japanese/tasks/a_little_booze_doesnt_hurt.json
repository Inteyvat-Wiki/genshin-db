			"dialogs": [
				{
					"id": 200490101,
					"content": "酒が飲みたいな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490102
					],
					"speakerTitle": "ニムロド"
				},
				{
					"id": 200490102,
					"content": "でもユーリにバレたら何もかも終わりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490103
					],
					"speakerTitle": "ニムロド"
				},
				{
					"id": 200490103,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200490104
					]
				},
				{
					"id": 200490104,
					"content": "ん？あ、ああ、ちょっと酒が飲みたくなっただけだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490105
					],
					"speakerTitle": "ニムロド"
				},
				{
					"id": 200490105,
					"content": "女房のユーリは俺が酒を飲むと怒るから、普段家にいる時は酒を飲めないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490106
					],
					"speakerTitle": "ニムロド"
				},
				{
					"id": 200490106,
					"content": "彼女が買い物にでかける時だけ、こっそり飲むようにしてるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490107
					],
					"speakerTitle": "ニムロド"
				},
				{
					"id": 200490107,
					"content": "酒が好きすぎるのでは…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200490108
					]
				},
				{
					"id": 200490108,
					"content": "おいおい、モンドの人間が酒を飲まないわけがないだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490109
					],
					"speakerTitle": "ニムロド"
				},
				{
					"id": 200490109,
					"content": "頼む、少しユーリの相手をして時間を稼いでほしい。一杯飲みたいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490110
					],
					"speakerTitle": "ニムロド"
				},
				{
					"id": 200490110,
					"content": "ユーリは買い物する時、選択肢が多いほど迷うんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490111
					],
					"speakerTitle": "ニムロド"
				},
				{
					"id": 200490111,
					"content": "だからいっぱい勧められると、ずっと迷い続けるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490112,
						200490114
					],
					"speakerTitle": "ニムロド"
				},
				{
					"id": 200490112,
					"content": "分かった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200490113
					]
				},
				{
					"id": 200490113,
					"content": "ハハハッ、頼んだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ニムロド"
				},
				{
					"id": 200490114,
					"content": "どれくらい飲むの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200490115
					]
				},
				{
					"id": 200490115,
					"content": "ハハハッ、それは君次第だよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490116
					],
					"speakerTitle": "ニムロド"
				},
				{
					"id": 200490116,
					"content": "い、いや、静かに一杯だけ飲めばいいんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490117
					],
					"speakerTitle": "ニムロド"
				},
				{
					"id": 200490117,
					"content": "モンドの酒飲みとして約束する！頼んだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ニムロド"
				}
			]
		},
