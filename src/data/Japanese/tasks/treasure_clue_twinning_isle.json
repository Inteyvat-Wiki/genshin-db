			},
			"dialogs": [
				{
					"id": 790290101,
					"content": "ここに彫像があるぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790290102,
					"content": "はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290103
					],
					"speakerTitle": "夜鴉船長"
				},
				{
					"id": 790290103,
					"content": "なあ、どうしてこんな場所でため息なんかついてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790290112,
					"content": "私は…最近ずっと、この洞窟に住んでいる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290113
					],
					"speakerTitle": "夜鴉船長"
				},
				{
					"id": 790290113,
					"content": "こんな洞窟に住んでるのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790290114,
					"content": "仕方ないのだ！劇団の役者やらが突然島にやってきて、毎日物を叩くものだから全然眠れんのだ…だから、少し静かな場所に移住したわけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290104
					],
					"speakerTitle": "夜鴉船長"
				},
				{
					"id": 790290104,
					"content": "どこからかやって来たヒルチャールの群れが、私の休憩場所を占拠しやがった！だから仕方なく、ここにいるのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290105
					],
					"speakerTitle": "夜鴉船長"
				},
				{
					"id": 790290105,
					"content": "はぁ…だからな、心の中で誓ったさ。もし誰かが助けてくれるなら、そいつに教えようとな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290106
					],
					"speakerTitle": "夜鴉船長"
				},
				{
					"id": 790290106,
					"content": "何を教えるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790290107,
					"content": "伝説の海賊の秘宝に関する手がかりさ！まあ、四分の一しか知らないのだがな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290108
					],
					"speakerTitle": "夜鴉船長"
				},
				{
					"id": 790290108,
					"content": "四分の一の手がかり？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790290109,
					"content": "どうやら、君たちも宝を探しているようだな。どうだ、ヒルチャールを片付けてくれないか。そうしたら、手がかりの位置を教えてやろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290110
					],
					"speakerTitle": "夜鴉船長"
				},
				{
					"id": 790290110,
					"content": "四つの手がかりが集まった日には、かつて海賊がここに残したお宝を見つけられるらしいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290111
					],
					"speakerTitle": "夜鴉船長"
				},
				{
					"id": 790290111,
					"content": "よし、約束だからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
