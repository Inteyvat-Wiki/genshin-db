			"dialogs": [
				{
					"id": 790290801,
					"content": "おお、ヒルチャールをすべて片付けてくれたか！ありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290802
					],
					"speakerTitle": "夜鴉船長"
				},
				{
					"id": 790290802,
					"content": "よし、この海上にただよう謎の霧を抜け、手がかりを見つける方法を教えよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290803
					],
					"speakerTitle": "夜鴉船長"
				},
				{
					"id": 790290803,
					"content": "準備ができたら、岩礁の向こう側で待っててくれ！",
					"roleType": "TALK_ROLE_NPC",
