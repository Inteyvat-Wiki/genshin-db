			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"デピエリ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240090101,
					"content": "旅人！ちょうどいいところに来てくれた。最高の撮影場所を見つけてね。君に少しだけ手伝ってほしい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090102
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240090102,
					"content": "まだ素材集め中？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090103
					]
				},
				{
					"id": 240090103,
					"content": "もちろんさ。あれしきの素材だけじゃ、まだまだ十分じゃない。一枚の写真から一枚の絵を完成させるのには、数がまったく足りないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090104
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240090104,
					"content": "普段、私が写真を参考にして絵を描くと決めた時は、少ない時でも数十枚、多い時では数百枚もの写真が必要になる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090105,
						240090106
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240090105,
					"content": "そんなにたくさん…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090107
					]
				},
				{
					"id": 240090107,
					"content": "前にも言ったように、絵の製作において「創作」は大事なことなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090108
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240090108,
					"content": "もし目に見えるものを、そのまま忠実にキャンバスに表現しただけなら…それは「写真」であって、「絵画」とは言えない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090109
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240090109,
					"content": "画家が真にやるべきは、自身の美的感覚と感受性を活かして目に見えるものを観察し、選択、変形、切り抜きを経て…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090110
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240090110,
					"content": "それぞれの事物の最も「美しい」部分を抽出した後、再びキャンバスの中に刻み込むこと。そうして、初めて一枚の絵の完成となる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090111,
						240090112
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240090111,
					"content": "全然分からない！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090113
					]
				},
				{
					"id": 240090113,
					"content": "君…まあいいだろう。簡単に言うなら、私は写真の中の一番美しい部分だけを参考にしているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090114
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240090114,
					"content": "例えば、この写真の光と影の効果は素晴らしいけど景色はイマイチ…こういう場合、光と影の効果だけを参考にする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090115
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240090115,
					"content": "別の写真では通行人が面白いポーズを取っていて、次の写真には素晴らしい建築物が映っている…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090116
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240090116,
					"content": "まるで、頭の中でジグソーパズルを組み立てるのと同じなのさ。最終的な完成品のクオリティは、完全にその個人の美的感覚と知識に関わっている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090117
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240090117,
					"content": "今の説明は、かなり厳密性に欠けたものだ。実際、私たちは素材の中の景色を変形させたり、抽象化したりするからな…でも、とりあえずはそんなものだと理解すればいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090118,
						240090119
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240090118,
					"content": "それで、引き続き手伝ってほしいわけだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090120
					]
				},
				{
					"id": 240090120,
					"content": "うっ…その通りだ！君の撮影技術は本当に素晴らしい。君が撮ってくれた写真を見た私の仲間たちが、君に会いたいと言い出すほどだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090121
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240090121,
					"content": "君が手伝ってくれれば、きっと超絶素晴らしい絵を描ける気がする！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090122
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240090122,
					"content": "さあさあ、人々が求める美のため、そして私が用意したモラのため——どうかもう一度手を貸してくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240090119,
					"content": "#それで、素材集めを{M#俺}{F#私}に手伝ってほしいと。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090120
					]
				},
				{
					"id": 240090112,
					"content": "もっと分かりやすく言って！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090113
					]
				},
				{
					"id": 240090106,
					"content": "それらの写真は役割がどう違うの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090107
					]
				}
			]
		},
		{
			"id": 2400902,
			"completionStepIds": [
				2400902
			],
			"beginWay": "TALK_BEGIN_NONE",
