			"dialogs": [
				{
					"id": 240091001,
					"content": "ありがとう。これなら腹ごしらえには十分だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091002
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240091002,
					"content": "これは君への報酬だ、どうか受け取ってくれ。早く食べ物を口に入れないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091003
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240091003,
					"content": "今度は…ポケットに入れられる菓子でも持ってこよう…",
