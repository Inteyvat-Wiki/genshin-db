			},
			"dialogs": [
				{
					"id": 240091101,
					"content": "まだ表現力が足りない…いったいどうしてだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091102
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240091102,
					"content": "何か…決定的な何かが欠けている気がする…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091103,
						240091105
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240091103,
					"content": "今、撮影中？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091104
					]
				},
				{
					"id": 240091104,
					"content": "ああ。絵を描くために、写真機を使って素材を集めてるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091107
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240091107,
					"content": "私はデピエリ、画家をやってる。よろしくな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091108
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240091108,
					"content": "え…えっと、こんにちは。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091109
					]
				},
				{
					"id": 240091109,
					"content": "普段なら、新しく出会った友にコーヒーでもご馳走すべきだが、あいにく近くにはコーヒー店がない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091110
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240091110,
					"content": "こうしよう。このフォンタを受け取ってくれ。これで杯を交わせば、正式に知り合ったことになる…ところで君は、フォンテーヌに来たことはあるかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091111
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240091111,
					"content": "フォンテーヌは初めて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091112
					]
				},
				{
					"id": 240091112,
					"content": "じゃ、いろいろな楽しみ方があるぞ。まずは街に行って、頭の上を縦横無尽に伸びる水路を見学するといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091113
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240091113,
					"content": "それから、街を歩きながら精巧に作られたマシナリーを見るのもいい。ま、画家の私に言わせれば…美的価値のあるマシナリーが全くないわけでもない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091114
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240091114,
					"content": "最後にカフェに行ってコーヒーを注文し、座ってゆっくり味わうんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091115
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240091115,
					"content": "コーヒーを飲んでいる時は、もしかしたら誰かに話しかけられるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091116
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240091116,
					"content": "でも、もし話しかけてきた人が「写真機愛好家協会」とかいう団体を名乗ったら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091117
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240091117,
					"content": "絶対に気をつけるんだぞ。彼らはバカなことを言ってくるかもしれない…なにせ、連中の一部は今、バカなマネをしているんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091118,
						240091120
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240091118,
					"content": "彼らは何をしてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091119
					]
				},
				{
					"id": 240091119,
					"content": "何をしているかって？あそこの一部の人間によって、我々フォンテーヌの文明生活が壊滅へと押しやられてるんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091122
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240091122,
					"content": "私が脅かしてると思ってるかい？その協会の人間がどんな発言をしたと思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091123
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240091123,
					"content": "「単に画像について言うなら、写真機で撮った写真は、画家が描いた絵よりずっと上等だ」ってさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091124
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240091124,
					"content": "聞いたか！何が「単に画像について言うなら」だ。なんて愚かな、なのにやつらはそれを真理だと思い込んでいる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091125
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240091125,
					"content": "もし画像をそのまま如実に再現するのが画家の仕事だとしたら、美的感覚も必要ないだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091126
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240091126,
					"content": "まあ、確かに仲間の中には、より極めるために写実を研究している人もいるけど…それも彼らの美的感覚の一種だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091127
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240091127,
					"content": "美的感覚！それこそが大事なんだ。君には分かるかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091128,
						240091129
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240091128,
					"content": "えーっと、全く分からない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091130
					]
				},
				{
					"id": 240091130,
					"content": "画家が目で世界を観察するのは、ただの第一歩に過ぎない。私たちは筆により感性と美を模索してこそ、心の中から素晴らしい絵を生み出すことができるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091131
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240091131,
					"content": "もちろん写真機が好きなすべての人々を、美を知らない愚かで粗暴な連中だと決めつけるつもりはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091132
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240091132,
					"content": "私の周りにも写真機が好きな仲間が大勢いて、よく交流しているんだ。彼らの写真が私にインスピレーションを与える時もあれば、私の絵が彼らにヒントを与える時もある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091133
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240091133,
					"content": "でも芸術について何も知らないくせに、大口を叩く連中が、私はどうしても許せないんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091134
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240091134,
					"content": "やつらは写真が好きな人を侮辱しただけでなく、絵が好きな人まで侮辱している！なんという…ゴホッ…ゴホッ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091135
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240091135,
					"content": "とりあえず、水を飲んで…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091136
					]
				},
				{
					"id": 240091136,
					"content": "ありがとう…この話になると、つい頭に血が上ってな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091137
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240091137,
					"content": "それで私は仲間たちと一緒に、この写真機で一連の写真を撮り、それを参考に一連の絵を描くことに決めた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091138
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240091138,
					"content": "その後、私たちが描いた絵と参考用の写真を並べて画展を開く予定だ。絵と写真の違いを人々に認識してもらうためにな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091139
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240091139,
					"content": "しかし…はぁ、私が撮ったこれらの写真はつまらないものばかりだ。仲間たちが言うには、危険な場所ほど魅力的な景色が隠れているそうだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091140
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240091140,
					"content": "例えば水の中とか、山の頂上とか、ひと気のない密林の中とか…でも、一人じゃそんな所に行く勇気なんてない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091141
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240091141,
					"content": "冒険者に依頼するには、かなり時間がかかるし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091142
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240091142,
					"content": "#えっと…親愛なる{M#紳士}{F#レディー}よ。君さえよければ…この芸術家に雇われてもらえないだろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091143,
						240091144
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240091143,
					"content": "絵を描くこと以外であれば…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091145
					]
				},
				{
					"id": 240091145,
					"content": "心配しないでくれ。君と私は、それぞれ自分の得意なことをやればいいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091146
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240091146,
					"content": "報酬のことも心配いらないさ。私は素材集めのためにいろんな所に行く。その時、よく冒険者に護衛を依頼してたから、彼らのルールはよく知っているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091147
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240091147,
					"content": "しかし今回は急いで出てきたから、冒険者に同行の依頼をするのが間に合わなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091148
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240091148,
					"content": "さて、この件はこれで決まりだな。君の協力も得られたことだし、素晴らしい絵を描ける自信が湧いてきたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240091144,
					"content": "冒険者の得意なことしかできない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091145
					]
				},
				{
					"id": 240091129,
					"content": "えーっと、なんとなく…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091130
					]
				},
				{
					"id": 240091120,
					"content": "#彼らが{M#俺}{F#私}に何かするの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091121
					]
				},
				{
					"id": 240091121,
					"content": "フォンテーヌに対してやったのと同じように——あそこの一部の人間が、本来君が手に入れるべき文明生活を壊滅へと押しやるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091122
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240091105,
					"content": "#{M#君}{F#あなた}は写真愛好家？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091106
					]
				},
				{
					"id": 240091106,
					"content": "愛好家？いやいや、私にとって写真機はただ参考材料を得るための道具にすぎないさ。それよりも、絵筆のほうが私にとっては大切なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091107
					],
					"speakerTitle": "デピエリ"
				}
			]
		},
