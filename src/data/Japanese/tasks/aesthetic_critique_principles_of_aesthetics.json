					"デピエリ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240090901,
					"content": "これは…困ったな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090902,
						240090903
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240090902,
					"content": "今回は何を撮影すればいい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090904
					]
				},
				{
					"id": 240090904,
					"content": "今回は…撮影の代わりに、別の頼みごとがあるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090905
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240090905,
					"content": "ゴホンッ、少し恥ずかしい話なのだが、その…何か食べ物を探してきてくれないか…例えば「ガーリックバゲット」とかを…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090906,
						240090907
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240090906,
					"content": "もしかして…食べ物を持ってきてないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090908
					]
				},
				{
					"id": 240090908,
					"content": "いや、違うんだ！本当はパンをたくさん持ってきていた。ジャムとジャーキーもな。今日食べる分には十分な量だったんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090909
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240090909,
					"content": "食べ物を横に置いたまま、絵を描くのに夢中になってたら…腹が減ったと感じた時には、それがなくなっていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090910
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240090910,
					"content": "動物に持っていかれたのか、それとも腹を空かせた通行人にこっそり盗られたのか分からないけど…はぁ、いずれにせよ、それでそいつらの空腹が満たされてるならいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090911
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240090911,
					"content": "でも、自分の腹を満たすためには別の方法を探さないとな…ただ、まだ十分な素材も手に入ってないし、このまま街に帰りたくはないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090912,
						240090913
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240090912,
					"content": "ちょっと待ってて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090914
					]
				},
				{
					"id": 240090914,
					"content": "ああ、よろしく頼む。「ガーリックバゲット」は街のお店で売ってるはずだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090915
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240090915,
					"content": "ははっ…なんだか身体に力が入らないぞ。腹が減ったせいか、それとも頭を絞りすぎたか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240090913,
					"content": "分かった、持ってきてあげる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090914
					]
				},
				{
					"id": 240090907,
					"content": "もしかして…食べ物を買うモラがないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090908
					]
				},
				{
					"id": 240090903,
					"content": "今回はどこに行って撮影すればいい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090904
					]
				}
			]
		},
		{
