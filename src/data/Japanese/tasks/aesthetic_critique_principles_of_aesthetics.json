			"dialogs": [
				{
					"id": 240090401,
					"content": "どれどれ…仲間にいくつかアドバイスをもらったから、それを全部ノートに書き留めてあるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090402
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240090402,
					"content": "「水中の巨大廃墟！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090403
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240090403,
					"content": "なんでこんなに力を込めて書いてるんだ？紙に穴が開きそうになってる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090404
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240090404,
					"content": "水中の巨大廃墟…確かに独特の美しさがありそうだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090405
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240090405,
					"content": "それじゃ、水中の廃墟の写真を撮ってきてくれないか。大きければ大きいほどいいし、ボロボロであればあるほどいい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "デピエリ"
				}
			]
		},
