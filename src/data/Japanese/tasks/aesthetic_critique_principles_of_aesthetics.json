			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"デピエリ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240090201,
					"content": "どれどれ…仲間にいくつかアドバイスをもらったから、それを全部ノートに書き留めてあるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090202
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240090202,
					"content": "水中植物…揺れる…光と影…変化…何を書いてるんだ？当時の私は酔っ払ってたのか？ああ…そうだ、きっと酔っ払ってたんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090203
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240090203,
					"content": "ゴホンッ、水の中に入って水生植物の写真を撮ってきてくれないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090204
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240090204,
					"content": "どうやら…これを書いた時の私は、水生植物の光と影の変化にかなり興味があったようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "デピエリ"
				}
			]
		},
