					"nextDialogs": [
						240090602
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240090602,
					"content": "これ、なんて書いてあるんだ？う～ん…えっと…水中…でこぼこの岩…岩の上の植物…岩の輪郭…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090603
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240090603,
					"content": "あっ、そうだ！当時の私は、岩の研究にドハマりしていた。岩は自然の美を最も表現するものだと考えてたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090604
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240090604,
					"content": "それじゃ、水の中に入って岩の写真を何枚か撮ってきてほしい。水中の岩はいったいどんな輪郭をしているんだろうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "デピエリ"
				}
			]
		},
