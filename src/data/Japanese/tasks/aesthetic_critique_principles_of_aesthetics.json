					"デピエリ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240090801,
					"content": "写真を撮ってきてくれたのかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090802
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240090802,
					"content": "撮ってきた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090803
					]
				},
				{
					"id": 240090803,
					"content": "ちょっと見せてくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090804
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240090804,
					"content": "完璧な写真だ！まさか、こんな上手に撮影できるとは、本当に素晴らしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090805
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240090805,
					"content": "この写真なら、きっと最高の素材を抜き出せるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090806
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240090806,
					"content": "本当にありがとう。あ、そうだ…モラをどこに置いたっけか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090807
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240090807,
					"content": "あったあった。これをどうか受け取ってくれ！今後もし機会があれば、また撮影を手伝ってほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090808
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240090808,
					"content": "次は…どんな構図にすべきか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "デピエリ"
				}
			]
		},
		{
			"id": 2400909,
			"completionStepIds": [
