			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"ジェイド"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732440101,
					"content": "どうして…あたし、なんで忘れてたんだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440102
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732440102,
					"content": "まだ間に合うといいけど。とりあえず、あいつのテントに行って探してみよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440103
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732440103,
					"content": "ジェイド！あれ、どうしたんだ？どこに行こうとしてるんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732440104,
					"content": "#パイモンに{NICKNAME}…ちょうどよかった。うん、ちょっと急用があって、アデルフィのところに行かなきゃいけないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440105
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732440105,
					"content": "アデルフィ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732440106,
					"content": "そいつってファデュイと手を組んだ裏切り者じゃないか…あっ！わかった、あいつのテントにあるものをあさりに行くんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732440107,
					"content": "違うよ。あいつの残したものなんかにまったく興味ないし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440108
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732440108,
					"content": "裏切り者が残した物をどう処理するかについては、部族で決まったルールがあるの。ふん…そうじゃなかったら、あいつの物なんかきれいさっぱり焼き払うのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440109
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732440109,
					"content": "あいつのテントに行く理由は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440110
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732440110,
					"content": "ブンブンのため…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440111
					]
				},
				{
					"id": 732440111,
					"content": "あっ、そういえばブンブンはアデルフィのところにいるんだよな。どうしよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732440112,
					"content": "うぅ…ジェイド、なんでブンブンをあんなやつに預けたんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732440113,
					"content": "だ…だって、あのときはあいつが裏切るなんて思わなかったから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440114
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732440114,
					"content": "とにかく、アデルフィのところへ急いで行かないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440115
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732440115,
					"content": "#{NICKNAME}、オイラたちも一緒に行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440116,
						732440117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732440116,
					"content": "急いだほうがいい、すぐ行こう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440118
					]
				},
				{
					"id": 732440118,
					"content": "ああ…ブンブン、どうか無事でいてくれよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732440117,
					"content": "今すぐ出発しよう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440118
					]
				}
			]
		},
		{
			"id": 7324403,
			"completionStepIds": [
				7324403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324403",
							"2"
						],
						"stepId": 7324403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ジェイド"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732440301,
					"content": "おい、見ろ。ここになにかあるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732440302,
					"content": "検査記録じゃなさそうだけど、手紙かな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732440303,
					"content": "何の手紙だろ？開けてみて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440304
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732440304,
					"content": "この手紙に書かれた内容によると、ブンブンはただエネルギーがなくなっただけみたいだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732440305,
					"content": "思い返してみると、キングデシェレトの霊廟の扉を開けてくれたり、オイラたちに権限を付与してくれたり、ブンブンにはたくさん助けてもらったもんな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732440306,
					"content": "ブンブンも疲れたんだろうね…あたしたちのためにたくさんエネルギーを消費してくれたから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440307
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732440307,
					"content": "手紙には特殊な「チャージ変換器」があるって書いてあるけど、テントにそれらしきものは見当たらないね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440308
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732440308,
					"content": "もしかして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440309,
						732440312
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732440309,
					"content": "どこかに隠されてる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440310
					]
				},
				{
					"id": 732440310,
					"content": "その可能性は低いかな。ブンブンをメンテナンスするなら、わざわざ隠さずにそのまま使えばいいもん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440311
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732440311,
					"content": "わかった！この取引はまだ成立してないんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440314
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732440314,
					"content": "アデルフィはブンブンを取引現場に連れていってなかった。だから、「チャージ変換器」も手に入ってないんだよ…そうなると、疑問はひとつだけね。アデルフィの取引相手は誰だったか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440315
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732440315,
					"content": "ふんっ、そんなのわかりきったことだよね。彼と部落外でこんな取引をするのは、あいつらしかいない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440316,
						732440318
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732440316,
					"content": "スメールの学者？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440317
					]
				},
				{
					"id": 732440317,
					"content": "ファデュイに決まってる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440320
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732440320,
					"content": "じゃあ、これからどうするんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440321
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732440321,
					"content": "どうするも何も、ファデュイのやつらには手加減なんかいらないよ。取引場所に行って、「チャージ変換器」を奪い取ろう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440322
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732440322,
					"content": "ああ、そうだな！奪い取ってやろう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440323
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732440323,
					"content": "でもブンブンは…ブンブンの今の状態だと同行させるのは無理だよね。ましてや、取引現場に連れていくのは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440324
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732440324,
					"content": "他の場所に置いておくのも、安全じゃないし。ブンブンをひとりぼっちにさせるなんて…そんなの一回だけで十分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440325
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732440325,
