				{
					"id": 732441901,
					"content": "「チャージ変換器」が見つかって、ブンブンを回復できたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441902
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732441902,
					"content": "不安なら、あたしも一緒にいくけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441903,
						732441904
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732441903,
					"content": "ジェイドはここでブンブンと一緒にいて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441905
					]
				},
				{
					"id": 732441905,
					"content": "わかった。ここで君たちが帰ってくるのを待ってる。気を付けて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732441904,
					"content": "すぐ戻ってくるから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441905
					]
				}
			]
		},
