			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 701230201,
					"content": "ここまではとても順調だ。天候もよく、物資も十分にある。魔物も大人しい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230202
					],
					"speakerTitle": "達筆に書かれたノート"
				},
				{
					"id": 701230202,
					"content": "それと、リュックに『イノシシプリンセス』第6巻が入っていた。ジョエルがこっそり入れたんだな、まったくあの子は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230203
					],
					"speakerTitle": "達筆に書かれたノート"
				},
				{
					"id": 701230203,
					"content": "だが、この本は勇敢なイノシシの姫がその友人と雪山を登る物語だ…ちょうど私も雪山を登っている。ここまでの道のりが順調なのは、この本に守られているからかもしれない。ありがとう、ジョエル。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230204
					],
					"speakerTitle": "達筆に書かれたノート"
				},
				{
					"id": 701230204,
					"content": "とにかく、次の拠点に向かおうと思う。そこで物資を補充し記録を取ったら山を降りよう。ジョエルが城内で待っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "達筆に書かれたノート"
				}
			]
		},
		{
			"id": 7012303,
			"completionStepIds": [
				7012303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7012302",
							"3"
						],
						"stepId": 7012302,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 701230301,
					"content": "道中で予想外の危険に会うことはなかった。天候は依然良好。どうやら私はついているらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230302
					],
					"speakerTitle": "達筆に書かれたノート"
				},
				{
					"id": 701230302,
					"content": "これなら、山頂を目指すのもいいかもしれない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230303
					],
					"speakerTitle": "達筆に書かれたノート"
				},
				{
					"id": 701230303,
					"content": "少し試してみるだけだ。何か問題が起こったら、すぐに引き返そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "達筆に書かれたノート"
				}
			]
		},
		{
			"id": 7012304,
			"completionStepIds": [
				7012304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7012303",
							"3"
						],
						"stepId": 7012303,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 701230401,
					"content": "山頂からの吹雪は激しすぎる。なんとか洞窟に逃げ込むのが精一杯だった。物資もほとんど失ってしまった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230402
					],
					"speakerTitle": "乱雑に書かれたノート"
				},
				{
					"id": 701230402,
					"content": "そして原因は不明だが…洞窟外の石が突然崩れ、入り口を塞いでしまった。今度こそお終いかもな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230403
					],
					"speakerTitle": "乱雑に書かれたノート"
				},
				{
					"id": 701230403,
					"content": "だが…まだ1つだけ活路がある気がする。洞窟の反対側は崖になっており、その下は雪が厚く積もっている。崖を少し下ったあとに飛び降りれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230404
					],
					"speakerTitle": "乱雑に書かれたノート"
				},
				{
					"id": 701230404,
					"content": "手元の物資では数日しか持たない。早く行動に移さなくては…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230405
					],
					"speakerTitle": "乱雑に書かれたノート"
				},
				{
					"id": 701230405,
					"content": "ジョエルに雪を見せると約束をした。約束を守らなきゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230406
					],
					"speakerTitle": "乱雑に書かれたノート"
				},
				{
					"id": 701230406,
					"content": "そうだ、誰かこのノートを読んだら、あのボウルに食べ物を置いてくれないか。キツネたちに餌をやってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230407
					],
					"speakerTitle": "乱雑に書かれたノート"
				},
				{
					"id": 701230407,
					"content": "ここに閉じ込められていた時、あのキツネたちがずっと側にいてくれた。可能なら、ジョエルにも会わせてやりたいよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "乱雑に書かれたノート"
				}
			]
		},
		{
			"id": 7012305,
			"completionStepIds": [
				7012305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
