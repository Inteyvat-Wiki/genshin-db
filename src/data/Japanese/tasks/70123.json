			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ジョエル"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701230501,
					"content": "どう？お父さんは見つかった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230502,
						701230511
					],
					"speakerTitle": "ジョエル"
				},
				{
					"id": 701230502,
					"content": "山頂で見つけた物について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701230503
					]
				},
				{
					"id": 701230503,
					"content": "お父さん…いや、お父さんはすごい冒険者なんだ。こんなちっぽけな問題、すぐに解決するに決まってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230504
					],
					"speakerTitle": "ジョエル"
				},
				{
					"id": 701230504,
					"content": "ノートにも書いてあったじゃないか。お父さんは山を降りる方法を見つけたんだ…だからもう無事に山を降りてるはず、そうだよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230505
					],
					"speakerTitle": "ジョエル"
				},
				{
					"id": 701230505,
					"content": "山を降りてるはずだよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701230506
					]
				},
				{
					"id": 701230506,
					"content": "そうだよね…無事に山を降りて、今はどこかで休憩しているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230507
					],
					"speakerTitle": "ジョエル"
				},
				{
					"id": 701230507,
					"content": "それか…山頂の別の場所で新しい拠点を立てて、そこで休憩しているかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230508
					],
					"speakerTitle": "ジョエル"
				},
				{
					"id": 701230508,
					"content": "休憩したらきっと…ボクを迎えに来てくれるはずなんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230509
					],
					"speakerTitle": "ジョエル"
				},
				{
					"id": 701230509,
					"content": "ボクはここでお父さんを待つよ。手伝ってくれてありがとう、これはお礼だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジョエル"
				},
				{
					"id": 701230511,
					"content": "何もなかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701230512
					]
				},
				{
					"id": 701230512,
					"content": "そう…なの？でも西風騎士のおじさんが、お父さんは雪山に入ったって言ってたけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230513
					],
					"speakerTitle": "ジョエル"
				},
				{
					"id": 701230513,
					"content": "見間違えてたのかな？それとも…お父さんが別の場所に拠点を移したとか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230514
					],
					"speakerTitle": "ジョエル"
				},
				{
					"id": 701230514,
					"content": "分かった、ボクはここでもう少し待ってみるよ…お父さんが戻ってきた時に、ボクがいなかったら大変だからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230515
					],
					"speakerTitle": "ジョエル"
				},
				{
					"id": 701230515,
					"content": "手伝ってくれてありがとう。これはお礼だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230516
					],
					"speakerTitle": "ジョエル"
				},
				{
					"id": 701230516,
					"content": "お父さん…どこにいるの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジョエル"
				}
			]
		},
