			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ジョエル"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701230101,
					"content": "お父さん、どこに行っちゃったの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230102
					],
					"speakerTitle": "ジョエル"
				},
				{
					"id": 701230102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701230103
					]
				},
				{
					"id": 701230103,
					"content": "あ…こんにちは、あの…お父さんがいなくなっちゃったの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230104
					],
					"speakerTitle": "ジョエル"
				},
				{
					"id": 701230104,
					"content": "ボクを連れて雪山で雪見をするって言ったのに、約束の日になってもぜんぜん連れにきてくれないの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230105
					],
					"speakerTitle": "ジョエル"
				},
				{
					"id": 701230105,
					"content": "きっとお父さんは、何か珍しいお宝の地図を見つけたから、迎えに来てくれなかったんだ、絶対にそうだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230106
					],
					"speakerTitle": "ジョエル"
				},
				{
					"id": 701230106,
					"content": "だからボク一人で雪山にきたんだ。迎えに来てくれないなら、ボクが探しに行こうと思って…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230107
					],
					"speakerTitle": "ジョエル"
				},
				{
					"id": 701230107,
					"content": "でもお父さんが見つからないんだ。西風騎士のおじさんが、お父さんが山頂に向かったって教えてくれて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230108
					],
					"speakerTitle": "ジョエル"
				},
				{
					"id": 701230108,
					"content": "それで探しに行こうと思ったんだけど、西風騎士のおじさんに止められたんだ。だからここでお父さんを待つしかないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230109
					],
					"speakerTitle": "ジョエル"
				},
				{
					"id": 701230109,
					"content": "でも…でもずっと戻ってこないから、お父さんが心配だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230110
					],
					"speakerTitle": "ジョエル"
				},
				{
					"id": 701230110,
					"content": "雪山に行くのなら、お父さんを探してくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230111,
						701230112
					],
					"speakerTitle": "ジョエル"
				},
				{
					"id": 701230111,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701230113
					]
				},
				{
					"id": 701230113,
					"content": "探してくれるんだね、よかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230114
					],
					"speakerTitle": "ジョエル"
				},
				{
					"id": 701230114,
					"content": "えっと…西風騎士のおじさんがお父さんから聞いた話だと、まず<color=#00E1FFFF>「積雪の道」に沿って上に向かう</color>予定らしい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230115
					],
					"speakerTitle": "ジョエル"
				},
				{
					"id": 701230115,
					"content": "そのあとは、<color=#00E1FFFF>雪山の西山腹</color>付近を見に行ったら、<color=#00E1FFFF>山頂に登る</color>挑戦をするそうだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230116
					],
					"speakerTitle": "ジョエル"
				},
				{
					"id": 701230116,
					"content": "今言った場所を探しに行けば、お父さんが見つかるかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230117
					],
					"speakerTitle": "ジョエル"
				},
				{
					"id": 701230117,
					"content": "ボクと一緒に雪を眺める約束をしたんだ。お父さんは約束を守る人だよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジョエル"
				},
				{
					"id": 701230112,
					"content": "どこに行けばいい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701230113
					]
				}
			]
		}
	]
}