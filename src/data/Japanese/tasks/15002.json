					}
				]
			},
			"dialogs": [
				{
					"id": 150020101,
					"content": "異邦の強者よ、よく来てくれた。ゆっくり休めただろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020102
					],
					"speakerTitle": "トリニダード"
				},
				{
					"id": 150020102,
					"content": "ま…まあな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150020103,
					"content": "ならよかった。こちらの準備も順調だ。あんたの功績を耳にしたやつらもそれなりにいてな。族長を含め、みんな承認してくれたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020104
					],
					"speakerTitle": "トリニダード"
				},
				{
					"id": 150020104,
					"content": "儀式は「マリポ」の継承者が執り行うべきだと主張する者もいたが、そういった考えはあまりに古い。私たちは時代と共に変わっていかなければね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020105
					],
					"speakerTitle": "トリニダード"
				},
				{
					"id": 150020105,
					"content": "キィニチもやりたくないみたいだしな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150020106,
					"content": "ああ。さて、さっそく儀式の詳細を説明しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020107
					],
					"speakerTitle": "トリニダード"
				},
				{
					"id": 150020107,
					"content": "昨日は導火の儀式について伝えたが、今日教えるのは山の王を浄化する方法だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020108
					],
					"speakerTitle": "トリニダード"
				},
				{
					"id": 150020108,
					"content": "どうやって浄化するの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020109
					]
				},
				{
					"id": 150020109,
					"content": "簡単さ、聖火を使えばいい。私たちは長年儀式をやってきたおかげで、その作業に慣れている。あんたにとっても、そう難しいものじゃないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020110
					],
					"speakerTitle": "トリニダード"
				},
				{
					"id": 150020110,
					"content": "そして肝心なのは、聖火を使ってなるべく多くのアビスの力を取り除くことだ。そうすれば山の王の眠りを確実に維持できる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020111
					],
					"speakerTitle": "トリニダード"
				},
				{
					"id": 150020111,
					"content": "本当に眠らせておくのが目的なんだよな…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150020112,
					"content": "もちろん。過去の儀式では、遊火者がいくら力を尽くしてもアビスのエネルギーを一部しか取り除けなかった。この儀式を定期的に行わないといけない理由もそのためだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020113
					],
					"speakerTitle": "トリニダード"
				},
				{
					"id": 150020113,
					"content": "その点、あんたはアビスに対抗することにおいて経験豊富。昨日も聖火を見事に使いこなしていたしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020114
					],
					"speakerTitle": "トリニダード"
				},
				{
					"id": 150020114,
					"content": "あんたなら、山の王の体内にあるアビスのエネルギーをすべて取り除けるかもしれない。そうすれば、私たちはこれから長いこと、脅威に怯えずに済む。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020115
					],
					"speakerTitle": "トリニダード"
				},
				{
					"id": 150020115,
					"content": "旅人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150020116,
					"content": "分かった。他に注意すべきことは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020117
					]
				},
				{
					"id": 150020117,
					"content": "こちらの要求を聞いても動じないとは、相当自信があるようだな、ハハッ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020118
					],
					"speakerTitle": "トリニダード"
				},
				{
					"id": 150020118,
					"content": "他に注意すべき点はない。儀式は三日後だ、時間になったらまた知らせよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020119
					],
					"speakerTitle": "トリニダード"
				},
				{
					"id": 150020119,
					"content": "それまで手が空いているのなら、集落を回ってみるといい。他の重役たちも、あんたの顔をみんなに見せておきたいと思っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020120
					],
					"speakerTitle": "トリニダード"
				},
				{
					"id": 150020120,
					"content": "ああ、あとこれはついででいいんだが…もし部族の人が悩んでいたら、手を貸してやってくれると助かる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020121
					],
					"speakerTitle": "トリニダード"
				},
				{
					"id": 150020121,
					"content": "みんなの悩みごとも解決しなくちゃいけないのか？それって追加料金をもらうべきなんじゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150020122,
					"content": "ハハッ、ちょっとした提案さ。あんたみたいな英雄は、部族内での評判を集めておくべきだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020123
					],
					"speakerTitle": "トリニダード"
				},
				{
					"id": 150020123,
					"content": "ここ数日は私も集落にいる。もし何かあれば、いつでも私のところに来てくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "トリニダード"
				}
			]
		},
