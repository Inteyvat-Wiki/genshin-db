			"dialogs": [
				{
					"id": 150020301,
					"content": "来たか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020302
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 150020302,
					"content": "キィニチ！トリニダードは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150020303,
					"content": "ああ、分かってる。顔に書いてあるからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020304
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 150020304,
					"content": "旅人、パイモン。すまない、二人の出迎えに遅れてしまうとは、族長としての職務を疎かにしてしまったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020305
					],
					"speakerTitle": "ワイナ",
					"speakerSubtitle": "懸木の民の族長"
				},
				{
					"id": 150020305,
					"content": "ワイナ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150020306,
					"content": "話は昨日トリニダードから聞いた。それで二人を呼んでもらったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020307
					],
					"speakerTitle": "ワイナ",
					"speakerSubtitle": "懸木の民の族長"
				},
				{
					"id": 150020307,
					"content": "気にしないで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020308
					]
				},
				{
					"id": 150020308,
					"content": "ははっ、すでにキィニチから聞いてるだろうから、詳細は省こう。二人が廻焔の夜の儀式を執り行うことには賛成だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020309
					],
					"speakerTitle": "ワイナ",
					"speakerSubtitle": "懸木の民の族長"
				},
				{
					"id": 150020309,
					"content": "ただ一つお願いがある。どうか山の王に危害が及ばないようにしてほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020310
					],
					"speakerTitle": "ワイナ",
					"speakerSubtitle": "懸木の民の族長"
				},
				{
					"id": 150020310,
					"content": "「懸木の民」の子供は、部族の英雄伝説を聞きながら育つ。炎を盗むユパンキ、アビスへ向かったブルキナと山の王…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020311
					],
					"speakerTitle": "ワイナ",
					"speakerSubtitle": "懸木の民の族長"
				},
				{
					"id": 150020311,
					"content": "それらは誇りと信念を与えてくれる貴重な歴史だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020312
					],
					"speakerTitle": "ワイナ",
					"speakerSubtitle": "懸木の民の族長"
				},
				{
					"id": 150020312,
					"content": "山の王を殺すことは、私たちの精神を殺すことに等しい。もしそんなことになれば、夜神の国にいる先祖たちに合わせる顔がない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020313
					],
					"speakerTitle": "ワイナ",
					"speakerSubtitle": "懸木の民の族長"
				},
				{
					"id": 150020313,
					"content": "ナンナのことは気の毒だと思ってる。だからトリニダードを責めるつもりもない。けど部族のためにも、山の王にもしものことがあってはならないんだ。それは「懸木の民」の根幹に関わるものだからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020314
					],
					"speakerTitle": "ワイナ",
					"speakerSubtitle": "懸木の民の族長"
				},
				{
					"id": 150020314,
					"content": "どうか二人には、慎重にこの件を考えてほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020315
					],
					"speakerTitle": "ワイナ",
					"speakerSubtitle": "懸木の民の族長"
				},
				{
					"id": 150020315,
					"content": "両立させる方法はないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020316
					]
				},
				{
					"id": 150020316,
					"content": "あるかもしれないが、まだ見つかってない。既に色々と試しもした。ひとまず、今は二人の考えを聞かせて欲しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020317,
						150020319,
						150020321,
						150020323
					],
					"speakerTitle": "ワイナ",
					"speakerSubtitle": "懸木の民の族長"
				},
				{
					"id": 150020317,
					"content": "族長の意見を尊重すべきかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020318
					]
				},
				{
					"id": 150020318,
					"content": "まだ考えがまとまってないのかもしれないが、そう言ってくれて安心した。儀式まであと三日ある。その時までに決めてくれればいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020326
					],
					"speakerTitle": "ワイナ",
					"speakerSubtitle": "懸木の民の族長"
				},
				{
					"id": 150020326,
					"content": "そうだ。キィニチ、さっき…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020327
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150020327,
					"content": "旅人、パイモン、集落を案内する。ついでに少し話そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020328
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 150020328,
					"content": "そうだな…今は気分転換でもして、頭を整理しようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150020319,
					"content": "トリニダードの意見を尊重すべきかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020320
					]
				},
				{
					"id": 150020320,
					"content": "まだ考えがまとまってないのかもしれないが…そうか、実に残念だ…けど儀式まであと三日ある。その時までじっくり考えてほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020326
					],
					"speakerTitle": "ワイナ",
					"speakerSubtitle": "懸木の民の族長"
				},
				{
					"id": 150020321,
					"content": "もう少し考えさせて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020322
					]
				},
				{
					"id": 150020322,
					"content": "分かった。儀式まであと三日ある。その時までに決めてくれればいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020326
					],
					"speakerTitle": "ワイナ",
					"speakerSubtitle": "懸木の民の族長"
				},
				{
					"id": 150020323,
					"content": "パイモン、今夜は他の部族に行ってみよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020324
					]
				},
				{
					"id": 150020324,
					"content": "ほっといても事件は勝手に解決しないぞ…まだ考えがまとまってないのはわかるけど…心配すんな、オイラも一緒に考えてやるから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020325
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150020325,
					"content": "ありがとう。儀式まであと三日ある。その時までに決めてくれればいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020326
					],
					"speakerTitle": "ワイナ",
					"speakerSubtitle": "懸木の民の族長"
				}
			]
		},
