				]
			},
			"dialogs": [
				{
					"id": 150020201,
					"content": "旅人、パイモン。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020202
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 150020202,
					"content": "キィニチ！？こんなところで会うなんて！オイラたち、おまえの話をしてたんだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150020203,
					"content": "こんにちは、また会ったね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020204
					]
				},
				{
					"id": 150020204,
					"content": "単刀直入に聞く。トリニダードの依頼を受けたらしいな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020205
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 150020205,
					"content": "えっ！あの…廻焔の夜のことか？えっと…トリニダードは元々おまえに頼みたかったらしいんだけど…でも…まあ…なんていうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150020206,
					"content": "そう動揺しないでいい。ひとつ言っておきたいことがあってな——トリニダードは本当の目的を隠してるかもしれない。あいつは山の王の問題を永久的に解決させようとしているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020207
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 150020207,
					"content": "永久的に解決？もう廻焔の夜をやらなくてもいいようにするってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150020208,
					"content": "ああ。あいつはお前らの手を借り、山の王を夜神の国に帰すつもりのようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020209
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 150020209,
					"content": "夜神の国に帰す…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150020210,
					"content": "つまり、山の王を殺そうとしてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020211
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 150020211,
					"content": "ひっ！そんな物騒な言い方すんなよ…でも、それってほんとなのか？なんだか信じられないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150020212,
					"content": "なんだ、もっと遠回しに言ってほしかったのか？ふむ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020213
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 150020213,
					"content": "おそらく、トリニダードはこう考えてる…お前らに山の王を倒してもらおうとな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020214
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 150020214,
					"content": "そんな…だって、山の王はおまえたちにとって、「生きた栄誉」なんだろ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020215
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150020215,
					"content": "その栄誉の裏には代償が伴う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020216
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 150020216,
					"content": "ああ。山の王は私たちにとって「生きた栄誉」だ。しかし、その栄誉には代償が伴う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020217
					],
					"speakerTitle": "トリニダード",
					"speakerSubtitle": "懸木の民の族親"
				},
				{
					"id": 150020217,
					"content": "ナンナのような件は、何も今回が初めてではない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020218
					],
					"speakerTitle": "トリニダード",
					"speakerSubtitle": "懸木の民の族親"
				},
				{
					"id": 150020218,
					"content": "竜のナンナが引き金になってる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020219
					]
				},
				{
					"id": 150020219,
					"content": "ああ。ナンナのような件は、これからも続くだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020220
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 150020220,
					"content": "でも…それで山の王を殺すのか？極端すぎるぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020221
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150020221,
					"content": "どうやって山の王を殺すの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020222
					]
				},
				{
					"id": 150020222,
					"content": "アビスに汚染された山の王は、通常の災害とは異なる存在だ。数百年にわたり、邪悪な力の侵蝕を受けてきた山の王の身体は、もはやアビスと一体化してると言っていい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020223
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 150020223,
					"content": "アビスの力は山の王を狂わせた元凶だが、同時にその命も繋ぎ止めてる。つまり、アビスの力を完全に取り除けば、山の王は永遠の眠りに落ちるということだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020224
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 150020224,
					"content": "過去の儀式では、アビスの力を半分ほど取り除くことで、山の王を死なせることなく、目覚めさせない折衷案を取ってきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020225
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 150020225,
					"content": "確かに、具体的にどれくらい取り除けばいいか言われてなかったな…でも後で詳細を話すって言ってたけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020226
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150020226,
					"content": "なら、すぐ分かるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020227
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 150020227,
					"content": "…もし本当に山の王を殺そうとしてるなら、オイラたち、どうすればいいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020228,
						150020229
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150020228,
					"content": "厄介な依頼を引き受けちゃったみたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020230
					]
				},
				{
					"id": 150020230,
					"content": "少しばかり刺激が強かったようだな。とりあえず知らないふりをするといい。トリニダードとの話が終わったら、族長のところに来てくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020231
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 150020231,
					"content": "取引がしたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020232
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 150020232,
					"content": "取引？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020233
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150020233,
					"content": "ああ、悪くない報酬を出すつもりだ。お前らも多くの疑問を抱えてるだろう。それに答えるいい機会にもなる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020234
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 150020234,
					"content": "分かった、あとで行くよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020235
					]
				},
				{
					"id": 150020235,
					"content": "ああ、待ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 150020229,
					"content": "今から辞退しても間に合う？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020230
					]
				}
			]
		},
