				]
			},
			"dialogs": [
				{
					"id": 150020401,
					"content": "キィニチ、トリニダードに頼まれたとき、おまえがどうして受けなかったのかわかったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150020402,
					"content": "厄介な頼みだって知ってたからだろ？しかも「追加料金」を理由にするなんて、ズルいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150020403,
					"content": "厄介なのは本当だ。それに理由も嘘じゃない。この件を解決するには、別で代償が必要になる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020404
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 150020404,
					"content": "何か解決策はあるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020405
					]
				},
				{
					"id": 150020405,
					"content": "試してるところだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020406
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 150020406,
					"content": "本当か？オイラたちにも教えてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020407
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150020407,
					"content": "パイモン、俺に用があったんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020408
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 150020408,
					"content": "あっ、そうだった。ええと、なんだっけ？…あっ！そうそうアハウのことだ。あいつ、本当に失礼なやつだよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020409
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150020409,
					"content": "今日はいないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020410
					]
				},
				{
					"id": 150020410,
					"content": "確かにあいつは性格がひん曲がってる。だから、ある先生にしつけてもらうことにした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020411
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 150020411,
					"content": "しつける？へへっ、あいつが厳しくしつけられてるところ、ちょっと見てみたいな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020412
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150020412,
					"content": "あれ？でもあいつの話だと、おまえたちはアビスの気配を調べてるとか言ってたぞ…この件となにか関係があるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150020413,
					"content": "ああ、それがまさに俺の試してる方法だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020414
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 150020414,
					"content": "俺は竜狩り人だが、時にアビスを狩ることもある。以前、紫の魔犬を追っていたら、ある隠された空間に足を踏み入れてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020415
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 150020415,
					"content": "あとで資料を調べると、そこは獣域と呼ばれる場所だと分かった。獣域の規模は大小さまざまで、その紫の魔犬もそこから出てくるものだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020416
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 150020416,
					"content": "それがどう関係してるんだ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020417
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150020417,
					"content": "獣域を見つけ、その中のものをすべて取り除き、山の王を入れてやれば…生きていても部族を脅かすことがなくなる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020418
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 150020418,
					"content": "いやいや！方法がちょっと雑すぎないか…ほんとに上手くいくのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020419
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150020419,
					"content": "当然、いくつか問題もある。例えば山の王が獣域に長くいた場合、状況が悪化する可能性も否めない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020420
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 150020420,
					"content": "だが一時的な解決策とはいえ、今の俺たちには必要だ。それに部族内の対立は、何も昨日今日に始まったことじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020421
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 150020421,
					"content": "族長はどうしても、山の王を守りたいと考えてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020422
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 150020422,
					"content": "たしかに…ワイナは山の王じゃなくて、あくまで部族の文化と栄誉を守りたいんだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020423
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150020423,
					"content": "ああ。だが一方で、トリニダードは目の前のことや将来のこと、そして身の回りの人のことを大切に思ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020424
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 150020424,
					"content": "これも理解できることだ。家族や友人の命を犠牲にし、過去の栄誉を守ったところで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020425
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 150020425,
					"content": "それがいいことなのか…残された者の代わりに答えることなど誰もできない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020426
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 150020426,
					"content": "本当に難しいな…まぁ、ひとまずその問題は置いとくとして…仮におまえの計画通りに行動する場合、その獣域はどうやって探すつもりなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020427
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150020427,
					"content": "あの犬たちって、急に裂け目から出てきて襲ってくるけど、こっちから攻撃を仕掛けに行ったことなんてないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020428
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150020428,
					"content": "場所の見当はもうついてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020429
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 150020429,
					"content": "本当に探すつもりなの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020430
					]
				},
				{
					"id": 150020430,
					"content": "なら、別の方法があるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020431
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 150020431,
					"content": "ないけど…でも、アビスの力を利用すると、なんだか不幸なことが起きそうな気がして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020432
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150020432,
					"content": "山の王を今の姿にしたのだって、アビスの力だろ。他の人もきっと頷いてくれないんじゃないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020433
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150020433,
					"content": "もし不幸なことが起きたとしたら、それは払うべき代償だったということだ。この世のすべてには値段がついてる。炎を盗むユパンキだって例外じゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020434
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 150020434,
					"content": "今回、山の王が突如暴走したことによって、部族内の対立はより激しくなった。一刻も早く解決しなければ、誰も前に進めない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020435
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 150020435,
					"content": "そうだな…ところで、おまえが言ってた取引ってなんだ？オイラたち、アビスの力のことは別に詳しくないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020436
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150020436,
					"content": "俺のために時間を稼いでくれればそれでいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020437
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 150020437,
					"content": "遊火者をやってくれと、毎日説得に来るやつがいるんだ。だが、そいつらの相手で時間を無駄にしたくない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020438
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 150020438,
					"content": "もし手を貸してくれるのなら、報酬も渡そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020439
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 150020439,
					"content": "報酬って？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020440
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150020440,
					"content": "その働きに見合う報酬だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020441
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 150020441,
					"content": "何をすればいいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020442
					]
				},
				{
					"id": 150020442,
					"content": "これまで同様、部族の人間に顔を覚えてもらう。そして、新たな遊火者が来たと知ってもらえばいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020443
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 150020443,
					"content": "そうすれば、俺は儀式をやるよう言ってくるやつらを避け、獣域を呼び出す方法を考えるのに時間を充てられる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020444
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 150020444,
					"content": "決行は儀式の当日——その日、山の王には棲み処を移ってもらう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020445
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 150020445,
					"content": "めちゃくちゃだな…キィニチ、おまえの「冒険心」ってどうなってんだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020446
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150020446,
					"content": "もし族長やトリニダードたちがこの方法に反対したら、どうなるかちゃんと考えたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020447
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150020447,
					"content": "その時、あいつらはまた同じ陣営となって、俺はその反対側に立つだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020448
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 150020448,
					"content": "部族に必要なのは、あいつらのようなリーダーだ。俺みたいな金で仕事する竜狩り人じゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020449
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 150020449,
					"content": "今回は誰もお金を払ってくれないんでしょ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020450
					]
				},
				{
					"id": 150020450,
					"content": "フッ、同意したってことでいいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020451
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 150020451,
					"content": "とりあえずやってみよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020452
					]
				},
				{
					"id": 150020452,
					"content": "そうだな。もしかしたら、この数日間のうちにもっといい方法が思いつくかもしれないし！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020453
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150020453,
					"content": "ああ。これからしばらく、集落内を歩き回りながら部族のやつらを手伝ってくれ。遊火者のお前なら、きっと人気者になれるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020454
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 150020454,
					"content": "上手くいくことを祈ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キィニチ"
				}
			]
		}
	]
}