			"dialogs": [
				{
					"id": 721590301,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYSECOND|INFO_FEMALE_PRONOUN_GIRLSECOND]}と話したい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721590302
					]
				},
				{
					"id": 721590302,
					"content": "俺は自分の過去を捨てた。これからもこの世に対して何かを訴えたくはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721590303
					],
					"speakerTitle": "「公義」"
				},
				{
					"id": 721590303,
					"content": "話し相手を探すなら、ここに来るべきじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721590304
					],
					"speakerTitle": "「公義」"
				},
				{
					"id": 721590304,
					"content": "行くといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「公義」"
				}
			]
		},
		{
			"id": 7215904,
			"completionStepIds": [
				7215905
