				"points": []
			},
			"dialogs": [
				{
					"id": 721590401,
					"content": "ふふ、まだお前には勝てないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721590402
					],
					"speakerTitle": "「公義」"
				},
				{
					"id": 721590402,
					"content": "まあ、いい。お前の武道はまだ上達していくことだろう。だが俺の心は囚われたままであるため、これ以上奥義を極められはしない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721590403
					],
					"speakerTitle": "「公義」"
				},
				{
					"id": 721590403,
					"content": "もし新しい技を身につけたら、喜んでこの刀で受けよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721590404
					],
					"speakerTitle": "「公義」"
				},
				{
					"id": 721590404,
					"content": "では、またいつの日か。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「公義」"
				}
			]
		},
