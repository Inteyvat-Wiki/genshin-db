			"dialogs": [
				{
					"id": 721590501,
					"content": "どうやら最近、お前は稽古を怠っていたようだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721590502
					],
					"speakerTitle": "「公義」"
				},
				{
					"id": 721590502,
					"content": "武の道は一日怠ると、取り戻すのに十日かかる。お前も分かっているだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721590503
					],
					"speakerTitle": "「公義」"
				},
				{
					"id": 721590503,
					"content": "帰って己を磨け。お前はこの程度の者ではない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「公義」"
