			},
			"dialogs": [
				{
					"id": 718220201,
					"content": "鹿の角…天衡山…うん、もし本当であれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ソラヤー"
