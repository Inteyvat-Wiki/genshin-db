			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ソラヤー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718220101,
					"content": "天衡山…移霄導天真君…うん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220102
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 718220102,
					"content": "何について考えてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220103
					]
				},
				{
					"id": 718220103,
					"content": "璃月海灯祭の歴史と伝説について研究しているの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220104
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 718220104,
					"content": "今年の「明霄の灯」は「移霄導天真君」と言う仙人をモチーフとして作られたらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220105
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 718220105,
					"content": "私が集めた伝説によると、その仙人も「岩王帝君」と共に戦ったという…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220106
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 718220106,
					"content": "具体的な時間と戦った敵は、文献それぞれ異なる言い方があるけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220107
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 718220107,
					"content": "色んな言い伝えと記録を分析すると、その仙人は既に亡くなっている事が分かる。しかも自分の角で天衡山を支えたのだとか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220108
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 718220108,
					"content": "だから私は天衡山に現地調査詩に来たんだ。運が良ければ、何か手がかりを見つけられるかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220109
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 718220109,
					"content": "でも、調査する場所は決めたけど、天衡山には魔物が多いから、そこまでたどり着けないかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220110
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 718220110,
					"content": "旅人、もしよかったら、私の代わりにそこへ行って「土質のサンプル」を持ってきてくれないかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220111
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 718220111,
					"content": "土質の…サンプル？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220112
					]
				},
				{
					"id": 718220112,
					"content": "まぁ…それは教令院の言い方で、そのエリアの土の事だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220113
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 718220113,
					"content": "璃月の伝説では、「移霄導天真君」は自分の角で天衡山を支えた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220114
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 718220114,
					"content": "学術的な面で考えると、土の中にはきっと見たことのない成分が含まれているはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220115
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 718220115,
					"content": "だから、私の代わりに土質を採ってきてほしいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ソラヤー"
				}
			]
		},
		{
			"id": 7182202,
			"completionStepIds": [],
