				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ソラヤー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718220301,
					"content": "土質のサンプルは採れた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220302
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 718220302,
					"content": "持ってきた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220303
					]
				},
				{
					"id": 718220303,
					"content": "ご苦労様、見せて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220304
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 718220304,
					"content": "…うん、この土、特に何もないみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220305
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 718220305,
					"content": "何を見つけたいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220306
					]
				},
				{
					"id": 718220306,
					"content": "伝説によると、「移霄導天真君」は璃月港を守るために、自分の強靭な角で傾き始めた天衡山を支えたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220307
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 718220307,
					"content": "少なくとも、「角」の粉末くらいはあるかと思ってたけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220308
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 718220308,
					"content": "やっぱりただの伝説なんだ…もしくは、あまりにも昔に起こった大戦だから、痕跡もほとんど消えてしまったのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220309
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 718220309,
					"content": "まぁ、天衡山の土質サンプルを回収できただけでも悪くないよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220310
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 718220310,
					"content": "旅人、もうちょっと付き合ってくれる？もう少し上に進みたいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220311,
						718220312
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 718220311,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220313
					]
				},
				{
					"id": 718220313,
					"content": "今度は…高いところから天衡山を見下ろして、地形を観察したいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220314
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 718220314,
					"content": "伝説によると、「岩王帝君」は仙人たちと共に大戦に参戦したらしいの。しかも危うく天衡山を崩れさせるほどだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220315
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 718220315,
					"content": "あんなに激しい戦いだったら…地形から何か手がかりを見つけられるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 718220312,
					"content": "何を探したい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220313
					]
				}
			]
		},
		{
			"id": 7182206,
			"completionStepIds": [
				7182206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182206",
							"2"
						],
						"stepId": 7182206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ソラヤー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718220601,
					"content": "やっとここまでたどり着いた…道がこんなに険しいうえに、魔物までいるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220602
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 718220602,
					"content": "ここら辺の地形…特に特別なところはないみたい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220603
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 718220603,
					"content": "あれ？木の上に何か…霄灯かな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220604
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 718220604,
					"content": "どうしてあんなところに霄灯が？まさかあの仙人を祭るために、誰かがここに来てたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220605
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 718220605,
					"content": "霄灯に何が書いてあるのか確かめてみるね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220606
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 718220606,
					"content": "「いつの世までも平和を。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220607,
						718220608
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 718220607,
					"content": "とても偉大な願い。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220609
					]
				},
				{
					"id": 718220609,
					"content": "確かに。でもこの願い…なんて言うか、大きすぎない？参拝でもないし、「願い事」というには現実味がなさすぎる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220610
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 718220610,
					"content": "なんだか…璃月の伝説に出てくる仙人たちの願いみたい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220611
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 718220611,
					"content": "一体誰が霄灯にこんな願いを？普通じゃないね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220612
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 718220612,
					"content": "まぁとにかく、誰かがここで霄灯を飛ばしたのは事実だから、あの仙人も喜ぶんじゃないかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220613
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 718220613,
					"content": "こんなに遠くまで付き合ってくれてありがとう。私はもう少しここで研究するね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220614
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 718220614,
					"content": "そうだ、これは礼として受け取って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220615
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 718220615,
					"content": "はぁ、璃月にはこんなにも伝説があるのに、私の研究には何の進展もないなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 718220608,
					"content": "参拝に来たわけじゃないみたい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220609
					]
				}
			]
		}
	]
}