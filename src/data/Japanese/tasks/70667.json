			"dialogs": [
				{
					"id": 706660101,
					"content": "突破挑戦する！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706660102
					]
				},
				{
					"id": 706660102,
					"content": "#にゃ…「もうカードプレイヤーランクの突破試練に参加すると言うのか。だが、{NICKNAME}には確かに挑戦資格があると言えよう。では早速…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660103
					],
					"speakerTitle": "「リトルプリンス」"
				},
				{
					"id": 706660103,
					"content": "「今からジョインに突破試練に必要なフィールドをセットしてもらおう。気を付けたまえよ…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「リトルプリンス」"
				}
			]
		},
		{
			"id": 7066702,
			"completionStepIds": [
				7066703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7066703",
