			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「リトルプリンス」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706670201,
					"content": "にゃ！「見事だ。プレイヤーランクの試練突破、おめでとう！これで汝もプロプレイヤーと言えよう！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706670202
					],
					"speakerTitle": "「リトルプリンス」"
				},
				{
					"id": 706670202,
					"content": "「これでさらに多くのプレイヤーに挑む資格が手に入ったわけだが…そうだ、もうできると思うが、もう一度注意しておくぞ。招待ボードでは挑戦状を出せる…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706670203
					],
					"speakerTitle": "「リトルプリンス」"
				},
				{
					"id": 706670203,
					"content": "にゃ…「そうすれば、汝と戦いたいプレイヤーはその挑戦を受けて立つことができる。ふん、相手が誰なのかわからん対戦も、時には面白い…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706670204
					],
					"speakerTitle": "「リトルプリンス」"
				},
				{
					"id": 706670204,
					"content": "「まあ、約束して対戦するというのも、出会いの方法の一つだがな。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680204
					],
					"speakerTitle": "「リトルプリンス」"
				},
				{
					"id": 706680204,
					"content": "にゃ！「ああっ！話がそれてしまった。…プロプレイヤーの特権として、今の汝は美しいカードスキンを購入する資格を手に入れたわけだが…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706670205
					],
					"speakerTitle": "「リトルプリンス」"
				},
				{
					"id": 706670205,
					"content": "#「うんうん…{NICKNAME}、遊び心を忘れることなかれ。『七聖召喚』の楽しさを思う存分享受してくれ！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「リトルプリンス」"
				}
			]
		},
