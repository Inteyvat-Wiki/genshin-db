					"speakerTitle": "「少女」"
				},
				{
					"id": 760540305,
					"content": "ここはどうだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540306
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540306,
					"content": "今回は私の勝ち。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540307
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540307,
					"content": "私の月が三つ繋がったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540308
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540308,
					"content": "うん、これで勝ち。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540309
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540309,
					"content": "月が昇っては沈む…長いね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540310
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540310,
					"content": "私たちの月、お互いに譲らないね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540311
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540311,
					"content": "…引き分けかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540312
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540312,
					"content": "直感よりも思考タイプなんだね。ゆっくり考えていいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540313
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540313,
					"content": "「月」をどうやって「夜空」に置けばいいのかわからなくなった？手伝おうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540314
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540314,
					"content": "このゲーム、つまらなかった？私は面白いけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540315
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540315,
					"content": "ん？もしかして私を見てる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540316
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540316,
					"content": "私の顔に…「月」の答えが書いてある？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540317
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540317,
					"content": "盤面はそっちだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540318
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540318,
					"content": "うん、キミの「月」の勝ち。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540319
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540319,
					"content": "この夜空はキミのものだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540320
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540320,
					"content": "あっ…しまった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540321
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540321,
					"content": "コロンビーナと楽しい時間を過ごした…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760540322
					]
				},
				{
					"id": 760540322,
					"content": "ありがとう、楽しかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540323
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540323,
					"content": "よかったら、また付き合って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540324
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540324,
					"content": "約束の証に、これをあげる。",
