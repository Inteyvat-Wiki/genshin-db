			"dialogs": [
				{
					"id": 722090201,
					"content": "あの絵馬掛け、もうだいぶ長いこと壊れてるみたいだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090202
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722090202,
					"content": "何してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090203
					]
				},
				{
					"id": 722090203,
					"content": "あっ、旅人。僕はいま悦子と神社の周りを調査してるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090204
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722090204,
					"content": "神社の施設はどれもボロボロだけど…必要なものは全部揃ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090205
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722090205,
					"content": "近くの村人もきっとお参りに来るだろう。どうやら神社が廃れたのは、越石村が廃れたことと関係があるのかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大祐"
				}
			]
		},
		{
			"id": 7220903,
			"completionStepIds": [
				7220904
			],
