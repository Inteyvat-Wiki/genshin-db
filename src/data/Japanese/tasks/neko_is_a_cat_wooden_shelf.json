				"points": []
			},
			"dialogs": [
				{
					"id": 722090501,
					"content": "この絵馬掛け本当に悪くないわ…手先が器用なのね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090502,
						722090503
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722090502,
					"content": "ありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090504
					]
				},
				{
					"id": 722090504,
					"content": "でもここの絵馬…どれもかすれて何が描いてあるのか分からない。いったいどれくらいの時間が経ったの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090505
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722090505,
					"content": "悦子！これを見て、すぐそばで何枚かの木板を見つけて、絵馬の形に削ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090506
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722090506,
					"content": "絵馬掛けが直ったんなら、もちろん絵馬をかけるべきだよ。えへへ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090507
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722090507,
					"content": "悦子、何か願い事はある？僕が代わりに描いてあげるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090508
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722090508,
					"content": "この神社に絵馬をかけるの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090509
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722090509,
					"content": "ふふ、奇妙な感じね…絵馬を貸して、私が描くわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090510
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722090510,
					"content": "もう絵馬をかける準備をしてるみたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090511
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722090511,
					"content": "戻って寝子にこのことを伝えよう。きっと喜ぶと思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722090503,
					"content": "ちょっとコツを知ってるだけ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090504
					]
				}
			]
		},
