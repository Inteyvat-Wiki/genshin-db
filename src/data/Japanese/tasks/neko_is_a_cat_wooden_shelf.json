				"points": []
			},
			"dialogs": [
				{
					"id": 722090101,
					"content": "今日も穏やかな日にゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090102
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722090102,
					"content": "来たか。昨日主らが部屋の掃除をしてから、ぐっすり眠れるようになった…にゃおーん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090103
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722090103,
					"content": "あの緑色の二人も、昨日は神社でゆっくり散歩をしていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090104
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722090104,
					"content": "あの緑色の二人以外は、まだ誰も神社にお参りに来ていにゃい…おかしいにゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090105
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722090105,
					"content": "でも、あの二人が散歩をしていたとき、あそこの木の柵に興味津々だったにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090106
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722090106,
					"content": "たしか響が言っていた…あの小さな木板は「絵馬」で、柵みたいなものは「絵馬掛け」というらしい。神社に来る人のほとんどは、それが目当てにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090107
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722090107,
					"content": "ぬぅ…人間も木が好きにゃのか？神社に来る人はみんな、箱にお金を投げた後、そこに行って木板をかける。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090108
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722090108,
					"content": "木が好きなんじゃないと思う…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090109
					]
				},
				{
					"id": 722090109,
					"content": "そうにゃのか？じゃあ人間は馬が好きにゃのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090110,
						722090111
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722090110,
					"content": "なんで馬…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090112
					]
				},
				{
					"id": 722090112,
					"content": "…とにかく、あの木の柵も壊れてて、木板も少なくなってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090113
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722090113,
					"content": "主ら人間が、木や馬となんの関係があるのか知らにゃいが、神社にはあれが必要にゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090114
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722090114,
					"content": "きっとあの柵の木がなくなったせいで、神社に来る人がいないんだにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090115
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722090115,
					"content": "だから、主らが木の柵を修理してくれにゃいか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090116,
						722090121
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722090116,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090117
					]
				},
				{
					"id": 722090117,
					"content": "そういえば…この前「賽銭箱」の修理に使った材料、まだ余ってたよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722090118,
					"content": "うちはそういうのはわからにゃい…主ら人間は、どうしてこうも木が好きにゃ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090119
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722090119,
					"content": "うーん…まあいっか…たしか材料に残りがあったから、近くを探してみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722090120,
					"content": "とにかく、修理のことは主らに任せたにゃ。うちは引き続き神社の整理をするにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090129
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722090129,
					"content": "箱と柵を修理できたら、神社に来る人も多くなるにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722090121,
					"content": "これいつから手入れされてないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090122
					]
				},
				{
					"id": 722090122,
					"content": "だいぶ前に、箱よりも先に壊れたにゃ。その箱すらもずっとずっと昔に壊れたにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090123
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722090123,
					"content": "いつ壊れたのかまったく判断できないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722090124,
					"content": "うちは太陽が昇ったり沈んだりするのを数えることはにゃい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090125
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722090125,
					"content": "とにかく、この前「賽銭箱」の修理に使った材料、まだ余ってたよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722090126,
					"content": "うちはそういうのはわからにゃい…主ら人間は、どうしてこうも木が好きにゃ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090127
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722090127,
					"content": "うーん…まあいっか…たしか材料に残りがあったから、近くを探してみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722090128,
					"content": "とにかく、修理のことは主らに任せたにゃ。うちは引き続き神社の整理をするにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090129
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722090111,
					"content": "馬と関係ない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090112
					]
				}
			]
		},
