			},
			"dialogs": [
				{
					"id": 722090401,
					"content": "やあ、こんにちは、旅人。僕に何か用か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090402
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722090402,
					"content": "絵馬掛けの修理が終わった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090403
					]
				},
				{
					"id": 722090403,
					"content": "えっ？君が直したのか？本当に熱心なんだね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090404
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722090404,
					"content": "代理宮司様の依頼。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090405
					]
				},
				{
					"id": 722090405,
					"content": "ね、寝子さまからの依頼！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090406
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722090406,
					"content": "まさか寝子さま、僕たちの動きに気付いたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090407,
						722090408
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722090407,
					"content": "完全にそうとは言えないけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090409
					]
				},
				{
					"id": 722090409,
					"content": "悦子！一緒に絵馬掛けの方に行ってみよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090410
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722090410,
					"content": "最初は賽銭箱、それから絵馬掛け…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090411
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722090411,
					"content": "その代理宮司様、本気でこの神社を建て直すつもりなの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090412
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722090412,
					"content": "でも、この近くの住民はもうだいぶ前から移住しちゃったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090413
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722090413,
					"content": "言い換えれば、この島には私たち以外、神社にお参りに来る人は誰もいない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090414
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722090414,
					"content": "悦子、それってどういう意味？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090415
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722090415,
					"content": "あの代理宮司様、このことを知っているかしら？この神社を建て直す目的っていったい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090416
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722090416,
					"content": "…ごめんなさい、私の考えすぎかも。絵馬掛けのところに行って、何か問題がないか確かめてみましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090417
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722090417,
					"content": "とにかく、警戒するに越したことはないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090418
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722090418,
					"content": "悦子、寝子さまはただの猫だよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大祐"
				},
				{
					"id": 722090408,
					"content": "間違ってはないかも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090409
					]
				}
			]
		},
