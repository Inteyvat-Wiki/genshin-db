			"dialogs": [
				{
					"id": 722090601,
					"content": "さっき緑色の二人が絵馬をかけ始めているのを見たにゃ。主ら、本当に頼りになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090602
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722090602,
					"content": "あの二人が絵馬をかければ、きっと他の人間にも教える。そうしたら皆この神社に来るにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090603
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722090603,
					"content": "にゃおーん…箱と「掃除」以外に…この柵も重要なものにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090604
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722090604,
					"content": "悪くないにゃ、このままいけば、神社もきっと賑やかににゃる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090605
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722090605,
					"content": "どうして神社を建て直すの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090606
					]
				},
				{
					"id": 722090606,
					"content": "どうしてにゃのか…うちはこの神社の代理宮司、この神社の世話をする必要がある。多くの人に神社に来てもらい、神社を賑やかにするにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090607
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722090607,
					"content": "それに、響が帰ってきたときに神社がボロボロだったら、きっと悲しむ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090608
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722090608,
					"content": "にゃおーん、主らの手助けがあったおかげで、神社の復興もうまくいくにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090609
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722090609,
					"content": "しばらくしてから、また主らに頼むかもしれないにゃ。その時は、断らないでほしいにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寝子」"
				}
