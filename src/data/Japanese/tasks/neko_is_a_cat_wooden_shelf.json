				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722090301,
					"content": "にゃにゃ、あの木の柵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090302
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722090302,
					"content": "もう直した。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090303
					]
				},
				{
					"id": 722090303,
					"content": "よくやったにゃ！これで神社がもっと良いものになったにゃ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090304
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722090304,
					"content": "あの緑色の二人にも一声かけてもらえると助かるにゃ。あの柵はもう修理したから、小さな木板をかけられると伝えてくれにゃ。それから、他の人間にも頼んでお参りに来させるにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090305
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722090305,
					"content": "なんで自分で行かないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090306
					]
				},
				{
					"id": 722090306,
					"content": "あ、あの緑色で、高い人間は本当に怖いやつにゃ。彼は猫の考えを理解している…うちの考えを簡単に見抜くにゃ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090307
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722090307,
					"content": "それに、毎回話すとき、彼はすごく興奮した様子になる…にゃにゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寝子」"
				}
			]
		},
		{
			"id": 7220904,
			"completionStepIds": [
				7220905
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
