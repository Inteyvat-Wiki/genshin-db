					}
				]
			},
			"dialogs": [
				{
					"id": 705510101,
					"content": "こんにちは、旅人さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510102
					],
					"speakerTitle": "エミリエ"
				},
				{
					"id": 705510102,
					"content": "…まさかこうして、モンドであなたの「調合」の才能を拝見できるとは思いませんでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510103,
						705510104
					],
					"speakerTitle": "エミリエ"
				},
				{
					"id": 705510103,
					"content": "エミリエは旅行で来たの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510105
					]
				},
				{
					"id": 705510105,
					"content": "両方です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510106
					],
					"speakerTitle": "エミリエ"
				},
				{
					"id": 705510106,
					"content": "魔女を名乗る女性から、彼女の花屋さんの経営を任されました。それと、キャッツテールからの依頼で、新しいアロマの調合も行いました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510107
					],
					"speakerTitle": "エミリエ"
				},
				{
					"id": 705510107,
					"content": "あなたの手作りドリンクで忙しい一日を締めくくれるなんて、本当に素晴らしい収穫です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510108,
						705510109
					],
					"speakerTitle": "エミリエ"
				},
				{
					"id": 705510108,
					"content": "#じゃあ、{M#俺}{F#私}の腕の見せ所だね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510110
					]
				},
				{
					"id": 705510110,
					"content": "チョイスはお任せします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510111
					],
					"speakerTitle": "エミリエ"
				},
				{
					"id": 705510111,
					"content": "（エミリエは香りに対して人より敏感だから、ごちゃごちゃした匂いのドリンクを作ったら、不快に思うかも。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510112
					]
				},
				{
					"id": 705510112,
					"content": "（いろんな香りと組み合わせられる材料を使いながら、フォンテーヌ風の味を加えよう。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510113
					]
				},
				{
					"id": 705510113,
					"content": "（よし、まずはモンド風アレンジの「七時のルミドゥース」を作ってみようかな。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 705510109,
					"content": "サプライズドリンクを作ってあげる！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510110
					]
				},
				{
					"id": 705510104,
					"content": "エミリエは出張で来たの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510105
					]
				}
			]
		},
		{
			"id": 7055102,
			"completionStepIds": [
				7055106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
