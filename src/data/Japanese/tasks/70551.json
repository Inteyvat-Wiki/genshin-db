			"dialogs": [
				{
					"id": 705510301,
					"content": "どうぞ、エミリエのために改良した「七時のルミドゥース」だよ。名前はまだ決まってないけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510302
					]
				},
				{
					"id": 705510302,
					"content": "より爽やかな色合いになり、漂う香りも控えめで、青緑の印象にぴったりですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510303
					],
					"speakerTitle": "エミリエ"
				},
				{
					"id": 705510303,
					"content": "この表面の美しい粉末は、風車アスターの花びらと葉っぱから作られたのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510304,
						705510305
					],
					"speakerTitle": "エミリエ"
				},
				{
					"id": 705510304,
					"content": "うん、一目で分かったね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510306
					]
				},
				{
					"id": 705510306,
					"content": "いい味がしそうです…それでは、いただきますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510307
					],
					"speakerTitle": "エミリエ"
				},
				{
					"id": 705510307,
					"content": "うん…風車アスターの花言葉は「見える風」です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510308
					],
					"speakerTitle": "エミリエ"
				},
				{
					"id": 705510308,
					"content": "見た目だけでなく、その香りまでもこの一杯に閉じ込めることができたのですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510309
					],
					"speakerTitle": "エミリエ"
				},
				{
					"id": 705510309,
					"content": "私からご提案させていただきたいのですが、この特製ドリンクを「風雲の残り香」と名付けてはいかがでしょうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510310
					],
					"speakerTitle": "エミリエ"
				},
				{
					"id": 705510310,
					"content": "モンドの風と雲が杯の中で舞い、芳しい香りを残すという意味です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510311,
						705510312
					],
					"speakerTitle": "エミリエ"
				},
				{
					"id": 705510311,
					"content": "さすが香水のプロだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510313
					]
				},
				{
					"id": 705510313,
					"content": "そうですか？職業上の習慣だからかもしれませんが、ご満足いただけたなら何よりです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510314
					],
					"speakerTitle": "エミリエ"
				},
				{
					"id": 705510314,
					"content": "では、この特製ドリンク、ゆっくりと味わわせていただきますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510315
					],
					"speakerTitle": "エミリエ"
				},
				{
					"id": 705510315,
					"content": "ありがとうございます。今回のモンドでの旅は、本当に多くの収穫がありました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510316
					],
					"speakerTitle": "エミリエ"
				},
				{
					"id": 705510316,
					"content": "これまでで、最も印象に残る一杯です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510317
					],
					"speakerTitle": "エミリエ"
				},
				{
					"id": 705510317,
					"content": "フォンテーヌに戻りましたら、この記憶を基に、香水とアロマ二つの形で、あなたの傑作を再現してみたいと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510318,
						705510319
					],
					"speakerTitle": "エミリエ"
				},
				{
					"id": 705510318,
					"content": "光栄だよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510320
					]
				},
				{
					"id": 705510320,
					"content": "二つの新商品の調合が完了しましたら、ぜひ最初のお客様になっていただければ幸いです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510321
					],
					"speakerTitle": "エミリエ"
				},
				{
					"id": 705510321,
					"content": "その時は、フォンテーヌ廷でお会いしましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エミリエ"
				},
				{
					"id": 705510319,
					"content": "やった！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510320
					]
				},
				{
					"id": 705510312,
					"content": "センスのある名前だね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510313
					]
				},
				{
					"id": 705510305,
					"content": "そう、モンドならではの花だよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510306
					]
				}
			]
		}
	]
