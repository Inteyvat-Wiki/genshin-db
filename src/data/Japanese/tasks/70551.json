				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"エミリエ"
				],
				"points": [
					{
						"sceneId": 51206,
						"position": [
							2192.554,
							230.089,
							-777.292
						],
						"pointId": 1
					},
					{
						"sceneId": 51206,
						"position": [
							2195.024,
							230.219,
							-779.316
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705510201,
					"content": "まずは試してみる、エミリエ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510202
					]
				},
				{
					"id": 705510202,
					"content": "あなたの動きは、見ていて本当に心地いいですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510203
					],
					"speakerTitle": "エミリエ"
				},
				{
					"id": 705510203,
					"content": "うん…これは「七時のルミドゥース」のローカルバージョンですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510204,
						705510205
					],
					"speakerTitle": "エミリエ"
				},
				{
					"id": 705510204,
					"content": "その通り。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510206
					]
				},
				{
					"id": 705510206,
					"content": "優しく上品で、層のあるはっきりとした味わい…モンドならではの香りが調和して、とても親しみやすい風味ですね。不快に感じる可能性のある味覚成分も避けられています…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510207
					],
					"speakerTitle": "エミリエ"
				},
				{
					"id": 705510207,
					"content": "ですが実は、そこまで慎重にやっていただかなくても大丈夫だったのです。一般的ではない成分であっても、私はほとんど問題なく受け入れられますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510208,
						705510209
					],
					"speakerTitle": "エミリエ"
				},
				{
					"id": 705510208,
					"content": "今のは少し伝統的すぎたかな？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510210
					]
				},
				{
					"id": 705510210,
					"content": "この一杯は素晴らしいものですが、もし可能でしたら、あなたの個性が表れた、より「深い」味わいで、私のモンドに対する印象も深まるような特別なドリンクがあれば、申し分ないです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510211
					],
					"speakerTitle": "エミリエ"
				},
				{
					"id": 705510211,
					"content": "ペースを落として、ゆっくりとお話をしながら、ひらめきを探すのも良いと思いますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510212
					],
					"speakerTitle": "エミリエ"
				},
				{
					"id": 705510212,
					"content": "これって今買ったばかりの花なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510213
					]
				},
				{
					"id": 705510213,
					"content": "花屋さんの経営で貰える報酬の一つです。大切な香水の材料で、キャッツテールからの依頼でも役立ちました——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510214
					],
					"speakerTitle": "エミリエ"
				},
				{
					"id": 705510214,
					"content": "何年も前、私はモンドのセシリアの花について研究していました。その香りは、一部の分野で「モンド」の代名詞となっています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510215
					],
					"speakerTitle": "エミリエ"
				},
				{
					"id": 705510215,
					"content": "ですが、今回は特別な状況でして…セシリアの花の香りが苦手な猫たちもいるものですから、そのことを特に考慮しなければなりません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510216,
						705510217
					],
					"speakerTitle": "エミリエ"
				},
				{
					"id": 705510216,
					"content": "今回はどんな植物の香りを使ったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510218
					]
				},
				{
					"id": 705510218,
					"content": "風車アスターです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510219
					],
					"speakerTitle": "エミリエ"
				},
				{
					"id": 705510219,
					"content": "風車アスターを部位ごとに粉砕して抽出し、花と葉っぱの香りを適度にブレンドしました。蜜酒のような甘い香りでありながら、花と枝のさわやかな香りも感じられます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510220
					],
					"speakerTitle": "エミリエ"
				},
				{
					"id": 705510220,
					"content": "先ほど、キャッツテールで少し実験をしてみたのですが、猫たちの反応も良好でした。お客さんからも、新しい香りは温かみがあり、なおかつ爽やかだとご好評いただいています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510221
					],
					"speakerTitle": "エミリエ"
				},
				{
					"id": 705510221,
					"content": "一見平凡で見過ごされがちな材料から、素晴らしい香りを引き出せるなんて…本当に嬉しいことです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510222
					],
					"speakerTitle": "エミリエ"
				},
				{
					"id": 705510222,
					"content": "今日はいい天気だね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510223
					]
				},
				{
					"id": 705510223,
					"content": "（定番の話題で雑談するのって、こんな感じなんだ…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510224
					]
				},
				{
					"id": 705510224,
					"content": "はい、先ほど低空に薄いベールのような扁平雲が漂っていました…大気の湿度も程よく、風も穏やかです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510225
					],
					"speakerTitle": "エミリエ"
				},
				{
					"id": 705510225,
					"content": "こういった条件下で、人の嗅覚は…過敏になりすぎない程度に活発になります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510226
					],
					"speakerTitle": "エミリエ"
				},
				{
					"id": 705510226,
					"content": "バランスよくブレンドされた香り成分は、自然と環境に溶け込み、人々の記憶に深く染み込んでいくのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510227,
						705510228
					],
					"speakerTitle": "エミリエ"
				},
				{
					"id": 705510227,
					"content": "そんな理論もあるんだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510229
					]
				},
				{
					"id": 705510229,
					"content": "ドリンク作りにも共通するところがあります——ベースとなる程よい度数のお酒を選び、様々な香り成分をよく溶け込ませる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510230
					],
					"speakerTitle": "エミリエ"
				},
				{
					"id": 705510230,
					"content": "適切に仕上げれば、全ての成分が調和して効果を発揮し、味覚に最高の体験をもたらしてくれます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510231,
						705510232
					],
					"speakerTitle": "エミリエ"
				},
				{
					"id": 705510231,
					"content": "分かったかも。味の調和が大切なんだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510233
					]
				},
				{
					"id": 705510233,
					"content": "確かに…そうですね。よく考えてみると、はっきりとした味の層があるのは、私の好みとはちょっと違うかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510234
					],
					"speakerTitle": "エミリエ"
				},
				{
					"id": 705510234,
					"content": "普段どんなものを飲んでるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510235
					]
				},
				{
					"id": 705510235,
					"content": "普段ですか…仕事が終わった後、執律庭のお友達から食事会に誘われることがあるのですが、私はたいていフルーツティーを選びます。食事会の後でもすぐに仕事に戻れる状態でいたいからです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510236
					],
					"speakerTitle": "エミリエ"
				},
				{
					"id": 705510236,
					"content": "翌日がお休みの時は、警官の方々が浮かれているのを見て、私もスモールサイズのフルーツスパークリングをいただくことがあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510237
					],
					"speakerTitle": "エミリエ"
				},
				{
					"id": 705510237,
					"content": "トゥレーヌさんという警察隊員の方が、よく樽熟成のコルテ酒を一緒に飲もうと誘ってくださったのですが、特巡隊へ異動されてからは、もう飲む機会がなくなってしまいました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510238,
						705510239
					],
					"speakerTitle": "エミリエ"
				},
				{
					"id": 705510238,
					"content": "お酒は飲めるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510240
					]
				},
				{
					"id": 705510240,
					"content": "科学的な観点から考えると、アルコールは非常に使用頻度の高い溶剤でして、私は何年も前から高濃度アルコールの匂いに慣れているのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510241
					],
					"speakerTitle": "エミリエ"
				},
				{
					"id": 705510241,
					"content": "そして、少し酔った状態では心境が変化し、それが調香の構想に影響を与えます…結果はどうであれ、新たな試みができるのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510242
					],
					"speakerTitle": "エミリエ"
				},
				{
					"id": 705510242,
					"content": "ですので、アルコール度数の低いお酒であれば問題ありません。ドリンクにほんの少しお酒を加えるだけで十分なのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510243
					],
					"speakerTitle": "エミリエ"
				},
				{
					"id": 705510243,
					"content": "最近、調香の仕事は順調？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510244
					]
				},
				{
					"id": 705510244,
					"content": "はい、お気遣いありがとうございます。すべて順調です。ただ、今回のモンドの旅では予想外の試練に遭遇しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510245
					],
					"speakerTitle": "エミリエ"
				},
				{
					"id": 705510245,
					"content": "最初、私は『芳香物質と人体感覚概論』という古典に基づき、モンド地方で最も伝統的な香りの素材をいくつか選びました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510246
					],
					"speakerTitle": "エミリエ"
				},
				{
					"id": 705510246,
					"content": "しかし、ヴァルベリーをメインにした香りは、酒場においては非常に甘い、眠気を誘う香りだったようで…可愛らしい耳を持つバーテンダーのお嬢さんは、そのまま眠りに落ちてしまいました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510247,
						705510248
					],
					"speakerTitle": "エミリエ"
				},
				{
					"id": 705510247,
					"content": "ヴァルベリーにそんな効果があったんだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510249
					]
				},
				{
					"id": 705510249,
					"content": "要するに、甘さが強ければ強いほど良いというわけではないのです。摂取する甘味の量を適切にコントロールすれば、身体にも思考にもよい影響を与えます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510250
					],
					"speakerTitle": "エミリエ"
				},
				{
					"id": 705510250,
					"content": "私は普段から甘いものはあまり食べませんし、ベリー類など糖分の高い果物もできるだけ控えているのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510251
					],
					"speakerTitle": "エミリエ"
				},
				{
					"id": 705510251,
					"content": "結局、ヴァルベリー由来の成分はすべて除外し、風車アスターに方向転換することで、新たな成果を得ることができました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510252
					],
					"speakerTitle": "エミリエ"
				},
				{
					"id": 705510252,
					"content": "レシピの方向性が見えてきた。待ってて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510253
					]
				},
				{
					"id": 705510253,
					"content": "え？少しお話しただけなのに、もうアイデアが浮かんだのですか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510254
					],
					"speakerTitle": "エミリエ"
				},
				{
					"id": 705510254,
					"content": "もしかしたら、あなたには元々、研究開発の才能があるのかもしれませんね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エミリエ"
				},
				{
					"id": 705510248,
					"content": "ヴァルベリーはアロマに向かなさそうだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510249
					]
				},
				{
					"id": 705510239,
					"content": "お酒が苦手かと思ってたけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510240
					]
				},
				{
					"id": 705510232,
					"content": "#{M#君}{F#あなた}は一体感のある味が好みなんだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510233
					]
				},
				{
					"id": 705510228,
					"content": "初めて聞いたよ、勉強になった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510229
					]
				},
				{
					"id": 705510217,
					"content": "代わりにどんな花を使ったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510218
					]
				},
				{
					"id": 705510209,
					"content": "もっと特別なドリンクのほうがよかった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510210
					]
				},
				{
					"id": 705510205,
					"content": "すぐにわかったね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510206
					]
				}
			]
		},
