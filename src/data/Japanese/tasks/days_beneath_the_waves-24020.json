				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"イヴス"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240200101,
					"content": "本当にツイてないな。もう潜るのはごめんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200102,
						240200103
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240200102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200104
					]
				},
				{
					"id": 240200104,
					"content": "お前か。会えてよかったぜ。ふぅ…あやうく命を落とすとこだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200105
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240200105,
					"content": "さっき、いつものように水中に潜って仕事してたんだ。水草やごみを避けて、何かに引っかけたり刺されたりもせずに順調に進んでたんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200106
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240200106,
					"content": "モノを持ち上げようとした時、水底の泥の中から魔物の群れが現れたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200107
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240200107,
					"content": "どんな魔物かはあまり覚えてないけど、急にぶつかってきてな。慌ててその場から逃げて、上に向かって必死に泳ぐしかなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200108
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240200108,
					"content": "だが間もなくして、今度は変わった形のマシナリーにばったり遭遇したのさ。やつらは俺を見つけるなり、狂ったかのように突っ込んできた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200109
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240200109,
					"content": "どうやって岸まで逃げてきたのかさえ、覚えてない。だが特に怪我もしてないし、潜水服も破れてなくてほっとしたぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200110,
						240200111
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240200110,
					"content": "危険だから、ここを潜るのはよそう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200112
					]
				},
				{
					"id": 240200112,
					"content": "そうもいかないのさ。ここはゴールドマンが指定した場所でな…前もここで仕事してて、怪我をしたり、命を落としたりした人がいたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200113
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240200113,
					"content": "そんな事態が続いた結果、ゴールドマンに給料を減らされると脅されても、誰もここに来ようとしなくなった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200114
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240200114,
					"content": "しばらく経ったら、ゴールドマンは他の手を打ったんだ。ここで働いてくれる人に、三倍の給料を払うとな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200115
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240200115,
					"content": "それで…俺と金欠で困ってる潜水士の何人かが名乗り出て、シフトを組んでここで働くことになった。水中の護身用に矛と銛まで買ったんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200116
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240200116,
					"content": "ただ数日も経ってないのに、それらの武器は折れたり、失くなったりしてな…今、他のやつらが街に行って買いなおしてるところだ。で、俺はここで留守番中ってわけさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200117,
						240200118
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240200117,
					"content": "こんな状況でさっき潜ってたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200119
					]
				},
				{
					"id": 240200119,
					"content": "あいつらが行って結構経ってるのにまだ帰ってこないし、もう仕事を始めないとならん。夜、どんだけ遅くなるか分かんないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200120
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240200120,
					"content": "#{M#俺}{F#私}が手伝って…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200121
					]
				},
				{
					"id": 240200121,
					"content": "ダメだ！絶対ダメ。ここの水中には本当に魔物がいるんだぜ。普通の冒険者の手に負えやしない。お前をそんな危険に晒すわけにはいかん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200122,
						240200123
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240200122,
					"content": "#{M#俺}{F#私}は普通の冒険者じゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200124
					]
				},
				{
					"id": 240200124,
					"content": "お前は…確かに普通には見えないけどよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200125
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240200125,
					"content": "分かった。お前がそう言うなら、目標の位置をマークしておこう。くれぐれも気を付けるんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240200123,
					"content": "#{M#俺}{F#私}が普通の冒険者に見える？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200124
					]
				},
				{
					"id": 240200118,
					"content": "護身用の武器がないのに潜ってたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200119
					]
				},
				{
					"id": 240200111,
					"content": "危険だから、場所を変えたほうがいい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200112
					]
				},
				{
					"id": 240200103,
					"content": "何かあったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200104
					]
				}
			]
		},
		{
			"id": 2402002,
