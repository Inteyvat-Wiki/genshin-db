						],
						"pointId": 13576
					}
				]
			},
			"dialogs": [
				{
					"id": 60110801,
					"content": "フリンズ？クルムカケ工房に来るなんて珍しいね。好きに見て回って。今ちょっと忙しいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110802
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 60110802,
					"content": "アイノさん、あなたに会いに来たんですよ。町で調達したお菓子をお持ちしました——クラシックなバター味です。どこに置きましょうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110803
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 60110803,
					"content": "しーっ！…イネファに聞こえちゃう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110804
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 60110804,
					"content": "…どういう風の吹き回し？まさか…アイノが造った大砲のおかげで問題が起きたから、これからワイルドハントの件はライトキーパーが引き継ぐ…とかじゃないよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110805
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 60110805,
					"content": "誰にも予想できなかったことですし、あなたのような天才技術者を責めるのはお門違いです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110806
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 60110806,
					"content": "そんな人がいたら、もうこの世に技術革命を期待することはできないでしょうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110807
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 60110807,
					"content": "ふん、聞こえのいい言葉だね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110808
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 60110808,
					"content": "少しでも不安が和らげば何よりです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110809
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 60110809,
					"content": "それで、いったい何の用？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110810
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 60110810,
					"content": "もしお時間があれば、このランプの修理をお願いできませんか？前に一度ナシャタウンで修理してもらったのですが、先の戦闘でまた壊れてしまって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110811
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 60110811,
					"content": "ランプぅ？そんなつまらない仕事を天才のアイノに依頼するわけ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110812
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 60110812,
					"content": "ああ、それは失礼いたしました。なら、イネファさんに聞いてみましょう。あと、お菓子も…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110813
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 60110813,
					"content": "ちょ、ちょっと待って！そ…そんなの楽勝って意味だよ。座って待ってて。すぐに終わるから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110814
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 60110814,
					"content": "ありがとうございます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110815
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 60110815,
					"content": "またこういうことがあったら、今度も真っ先にアイノのところに来てよね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アイノ"
				}
			]
		},
