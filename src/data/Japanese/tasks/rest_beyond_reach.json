			},
			"dialogs": [
				{
					"id": 60110601,
					"content": "コロンビーナ！なんでこんなとこにいるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110602
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60110602,
					"content": "え？出かけることを勧めてくれたのはキミたちでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110603
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110603,
					"content": "そうだったな。でも、ファデュイに見つかるのが怖くないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60110604,
					"content": "サンドローネは私を捕まえることに興味ないし、他のファデュイもリスクを冒してまで私を捕まえに来るとは考えにくい。もっと厄介な問題があるからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110605
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110605,
					"content": "（「月の狩人」のことかな…？彼はナド・クライのみんなにとっての脅威だから。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110606
					]
				},
				{
					"id": 60110606,
					"content": "そっか、そうだな。で、散策の感想はどうだ？ナシャタウンは気に入ったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110607
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60110607,
					"content": "うーん…クーヴァキの流れが少し乱れてて、人々は不安がってるみたいだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110608
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110608,
					"content": "でも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110609
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110609,
					"content": "でも？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110610
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60110610,
					"content": "前にご馳走してくれた料理は、ここで買ったの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110611
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110611,
					"content": "（えっ、そんなことかよ！まさか、ベリーとお肉のソテーを食べに来たんじゃないだろうな…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110612
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60110612,
					"content": "えっと、気に入ったならまた連れてってやるぜ。ほかにも、うちじゃ食べられないものがいっぱいあるんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110613
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60110613,
					"content": "…ん？さっきから黙ってるけど、何か気になることでも？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110614,
						60110620,
						60110625,
						60110630
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110614,
					"content": "「月の狩人」について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110615
					]
				},
				{
					"id": 60110615,
					"content": "うん…当時は彼の計画に気付かなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110616
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110616,
					"content": "肉体を得た彼は、今や凄まじい力を持ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110617
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110617,
					"content": "そしてその力には、狂気にも近い「執念」が宿ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110618
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110618,
					"content": "その執念が月のためなのか、それとも他の何かのためなのかは分からない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110619
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110619,
					"content": "それを解明することが、彼に対抗するためのカギになるかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110620,
						60110625,
						60110630
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110620,
					"content": "ファデュイについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110621
					]
				},
				{
					"id": 60110621,
					"content": "サンドローネの生活はとても不規則なの。「博士」はよく手下を遣うし、アルレッキーノは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110622
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110622,
					"content": "えっと、聞きたいのはこういう話じゃなかったかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110623
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110623,
					"content": "実験設計局に行ったことはある？…あの武器は、女皇様が描く未来のための重要な要素なの。あくまで…聞いた話だけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110624
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110624,
					"content": "具体的にどんな計画かって？さあ、興味ないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110614,
						60110625,
						60110630
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110625,
					"content": "「宇宙船」について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110626
					]
				},
				{
					"id": 60110626,
					"content": "キミが望むなら、恒月の「月髄」で探してみるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110627
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110627,
					"content": "でも、前回見た時、キミの宇宙船はわざと隠されたんだろうなって思ったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110628
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110628,
					"content": "キミに…あるいは他の誰にも真実を知られたくないと思った誰かの仕業かも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110629
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110629,
					"content": "そんなことができる人は、そんなに多くない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110614,
						60110620,
						60110630
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110630,
					"content": "もう大丈夫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110631
					]
				},
				{
					"id": 60110631,
					"content": "私は…まだ、自分の月に戻りたいと思ってる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110632
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110632,
					"content": "月には答えが埋まってる。そここそが…私の「家」なの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				}
			]
		},
