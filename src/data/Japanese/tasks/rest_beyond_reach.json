			"dialogs": [
				{
					"id": 60111101,
					"content": "こんなところでお会いできるとは。あんな戦いの後ですから、しっかりメンテナンスや修理をしておかなければと思いまして。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60111102
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 60111102,
					"content": "——すべてを知ったうえで、秘密を守ってくださりありがとうございます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60111103,
						60111104
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 60111103,
					"content": "聞くタイミングがなかったけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60111105
					]
				},
				{
					"id": 60111105,
					"content": "マスター・ライトキーパーに難癖をつけられたくなかったから、検知できるようにしておいたんですよ。そうでなければきっと、ライトキーパーのランプを押し付けてくるでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60111106
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 60111106,
					"content": "ランプを二つも持っているなんて珍妙な姿…美しくありませんからね、ふふふ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 60111104,
					"content": "なんでそのランプも検知されるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60111105
					]
				}
			]
		}
	]
