			"dialogs": [
				{
					"id": 60110501,
					"content": "姐さん…えっと、その…ちょっと確認したいんだけどさ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110502
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 60110502,
					"content": "他のやつと協力する場合、「秘聞の館」はどれぐらい力を出すべきなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110503
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 60110503,
					"content": "ふふっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110504
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 60110504,
					"content": "一割とか？いや、それじゃ少なすぎるか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110505
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 60110505,
					"content": "当ててみな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110506
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 60110506,
					"content": "え、一切力を貸さないのか！？それじゃ、名前だけじゃないかよ？協力してやってるとは言えないって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110507
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 60110507,
					"content": "はぁ、ヤフォダ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110508
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 60110508,
					"content": "正解は——天井もなければ、最低ラインもないんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110509
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 60110509,
					"content": "おおっ！さすが姐さん。先を見据えてるんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110510
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 60110510,
					"content": "って、ちょっと待った！それじゃあ全然答えになってないぞ。いったい何割なんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヤフォダ"
				}
			]
