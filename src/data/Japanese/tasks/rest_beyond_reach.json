			"dialogs": [
				{
					"id": 60111001,
					"content": "ランプの修理なんて朝飯前だよ。ちゃちゃっと終わらせてやる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60111002
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 60111002,
					"content": "みんな自分の行動についてはよく考えるべきだよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60111003
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 60111003,
					"content": "ヒンツァのやつ、頼まれたら何でもかんでも引き受けちゃって…修理どころか、集成制御装置だの大砲だのバリアだの、厄介ものばっかり生み出してるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60111004
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 60111004,
					"content": "こっぴどく叱ってやったよ。これからはちゃんと報告書を提出しなさいって。あいつが何をしてるのか把握しておかないと。はぁ…も、もちろん、アイノにも責任がないわけじゃないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アイノ"
				}
			]
		},
