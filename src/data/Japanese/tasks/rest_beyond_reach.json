			"dialogs": [
				{
					"id": 60110901,
					"content": "あらら？あなたたちがどうしてここに？またお会いできるなんて夢にも思いませんでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110902
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 60110902,
					"content": "今までどこに行ってたんだよ？どうせ逃げてたんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110903
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60110903,
					"content": "んまあっ、とんだお言葉ですわ！ちょっと別のところで商売の話をしていただけですのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110904
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 60110904,
					"content": "このサングマハベイ様の店をたたまずに済んだのも、あなたたちのおかげ…よよよ、本当に嬉しいですわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110905
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 60110905,
					"content": "演技が大げさ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110906
					]
				},
				{
					"id": 60110906,
					"content": "誓って演技などではございませんわよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110907
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 60110907,
					"content": "お手頃なお値段を提案して差し上げても、みんな「秘聞の館」とやらに行ってしまうんですもの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110908
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 60110908,
					"content": "常連さんが一人二人と離れていくものですから、場所を変えて生計を立てるしかなかったのです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110909
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 60110909,
					"content": "「秘聞の館」を気にしすぎでは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110910
					]
				},
				{
					"id": 60110910,
					"content": "気にしないわけがないでしょう？異国で商売をするのはただでさえ難しいもの。そこに手強いライバルが現れたのですわよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110911
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 60110911,
					"content": "はぁ…まあ、これもある意味運命ですから、文句は言いませんわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110912
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 60110912,
					"content": "それに、ここに来たばかりの頃、ネフェルという人には助けられましたからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110913
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 60110913,
					"content": "強いて言えば、彼女にどでかい貸しを作れなかったのが敗因ですわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110914
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 60110914,
					"content": "彼女が欲しがっているものを耳にした時は、必ず真っ先に私に教えてくださいまし！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ドリー"
				}
			]
		},
