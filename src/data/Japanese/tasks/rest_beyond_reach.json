			"dialogs": [
				{
					"id": 60110401,
					"content": "クルムカケが完成しました。熱いうちにお召し上がりください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110402
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 60110402,
					"content": "覚えていてくれたのか…感謝する。この友情の証が末永く変わらぬことを祈って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110403
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 60110403,
					"content": "はい。しかし残念ながら、クルムカケの賞味期限は一週間ほどです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110404
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 60110404,
					"content": "ぬ、私が言ったのはそういうことではなく…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110405
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 60110405,
					"content": "…？あそこにお客様が隠れているようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110406
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 60110406,
					"content": "クルムカケの香りに誘われてきたのだろう…皆、もっと傍に来て構わない。イネファさんは私たちの友達だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110407
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 60110407,
					"content": "はい、皆さんの好みに合わせて穀物を使ったクルムカケを作ることもできますよ。細かくすりつぶせばシェアできます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110408
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 60110408,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110409
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 60110409,
					"content": "何と言っていますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110410
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 60110410,
					"content": "そなたの…居住地について話し合っておる。そなたの家に移住したいようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ラウマ"
				}
			]
