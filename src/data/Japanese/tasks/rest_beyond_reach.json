					"nextDialogs": [
						60110702
					],
					"speakerTitle": "月の狩人"
				},
				{
					"id": 60110702,
					"content": "ここまでついて来られるとはな——正体を明かしたらどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110703
					],
