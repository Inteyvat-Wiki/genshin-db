							1547.907,
							258.402,
							9321.152
						],
						"pointId": 13088
					}
				]
			},
			"dialogs": [
				{
					"id": 60110201,
					"content": "まるで灯台のような方でした…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110202
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 60110202,
					"content": "当たり前のようにすぐそばにいて、周囲に光の恵を与えていました。しかし、人々はいつしか光に慣れ、灯台の存在を忘れてしまったんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110203
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 60110203,
					"content": "やがて、彼自身までもがそう思い込むようになりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110204
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 60110204,
					"content": "「大したことはしてない。それどころか、まだまだ力不足だ。忍耐強く、時を待たないと…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110205
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 60110205,
					"content": "結末は悲しいものになってしまいましたが…人々の進む道を照らしてくれたスーシ隊長を僕は誇りに思っています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110206
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 60110206,
					"content": "光から生まれる影たちも、それを忘れることはないでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110207
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 60110207,
					"content": "残念だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60110208,
					"content": "ランプのフェイの物語を知ってる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110209
					]
				},
				{
					"id": 60110209,
					"content": "あ、それなら僕も聞いたことがあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110210,
						60110211
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 60110210,
					"content": "あの物語と同じことを伝えたい——",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110212
					]
				},
				{
					"id": 60110212,
					"content": "ほう…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110213
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 60110213,
					"content": "…そうかもしれませんね。たとえ今回、月の狩人が目的を果たし、これまでの努力が水の泡になったとしても…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110214
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 60110214,
					"content": "それでも我々は、必ず最後までやつを追い続けるでしょう。たとえ望む結果が得られなかったとしても。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110215
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 60110215,
					"content": "墓守の仕事とも似ていますね——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110216
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 60110216,
					"content": "死者を生き返らせるためではなく、死者に安らぎを与えるために、墓守は存在するのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110217
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 60110217,
					"content": "いい考え方だと思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110218
					]
				},
				{
					"id": 60110218,
					"content": "ええ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110219
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 60110219,
					"content": "えっと、オイラには意味がわからないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110220
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60110220,
					"content": "帰ったら教えてあげるね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110221
					]
				},
				{
					"id": 60110221,
					"content": "おう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110222
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60110222,
					"content": "今回見送るのは「ランプのフェイ」ではありませんからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110223
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 60110223,
					"content": "「光掲げし者たちよ、鮮血を以て名誉を守り、正義を果たさん。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110224
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 60110224,
					"content": "「矢のように過ぎる日々の中で傷だらけになっても…しばし足を止め、愛と憎しみを振り返らん。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110225
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 60110225,
					"content": "「夜、世界が眠りに落ちた時——誰にも見えない灯が、汝のためにゆっくりと光り出すだろう。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110226
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 60110226,
					"content": "今までありがとうございました、スーシ隊長。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 60110211,
					"content": "結果に固執する必要はないと。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110212
					]
				}
			]
		},
