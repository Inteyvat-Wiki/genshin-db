			"dialogs": [
				{
					"id": 60110101,
					"content": "みんなで集まって互いに起きた事や得た情報を共有した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						60110102
					]
				},
				{
					"id": 60110102,
					"content": "何人かの住民が怪我をしたが、幸い被害は最小限に抑えられておる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110103
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 60110103,
					"content": "しかし…完全な体を手に入れた月の狩人の目的については、まだ誰も分からぬのだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110104
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 60110104,
					"content": "まるで、凶暴なクク竜が野放しにされたような状況ですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110105
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 60110105,
					"content": "…皆さん、クク竜をご存じないのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110106
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 60110106,
					"content": "し、知ってるけど、あんまりいい例えじゃない気がするぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60110107,
					"content": "この世界がどうでもいいなら、あたしたちと対立する理由はないはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110108
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 60110108,
					"content": "それがもし復讐のために来たとしても、あたしたちにはどうしようもないね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110109
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 60110109,
					"content": "今からでも退職したら間に合うかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110110
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 60110110,
					"content": "じょ、冗談だよ！もう逃げ道はないってことぐらい分かってるさ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110111
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 60110111,
					"content": "うう…自慢の大砲が問題ばかり起こしちゃうなんて…もういい！すぐに分解する！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110112,
						60110113
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 60110112,
					"content": "アイノのせいじゃないよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110114
					]
				},
				{
					"id": 60110114,
					"content": "うんうん。普通のワイルドハントをぶっ潰す時とかは役に立つんだし、気にするなって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60110115,
					"content": "フリンズ、後でライトキーパーのところに行って事後処理を済ませてきてくれ。すでに話は通してあるから、厄介なことにはならないはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110116
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 60110116,
					"content": "ありがとうございます。色々と力を貸してくださったそうですね。あなたがいなければ、真相にはたどり着けなかったでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110117
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 60110117,
					"content": "もっとあんたが自分を晒け出せてれば、最初から孤軍奮闘しなくて済んだと思うけどね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110118
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 60110118,
					"content": "ふふ、アドバイスありがとうございます。心にとめておきましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110119
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 60110119,
					"content": "スーシ隊長の跡を継ぐことになれば、もっと成長できるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110120
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 60110120,
					"content": "おぉ、おまえ昇格するのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60110121,
					"content": "冗談だよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110122
					]
				},
				{
					"id": 60110122,
					"content": "そうだったのか。気づかなかったの、オイラだけか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60110123,
					"content": "もしお時間があれば、一緒に来ませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110124
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 60110124,
					"content": "あの方を見送りに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 60110113,
					"content": "大砲のせいでもない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110114
					]
				}
			]
		},
		{
