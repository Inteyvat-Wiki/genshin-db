{
	"id": 73703,
	"type": "WQ",
	"name": "鏡よ鏡",
	"description": "野外で、人々を鏡にまつわる怪しい活動に招待しようとしている学者がいると聞いた。何が起きているのか見に行ってみよう…",
	"unlockDescription": "",
	"chapter": "",
	"showType": "QUEST_SHOW",
	"activityId": 5142,
	"mainQuestTag": "MAINQUEST_TAG_GUIDE",
	"suggestTrackMainQuestList": [],
	"prevMainQuestList": [],
	"steps": [
		{
			"id": 7370301,
			"order": 1,
			"listShowType": "QUEST_SHOW",
			"description": "野外にいるスメールの学者のところに行く",
			"finishConditions": [
				{
					"type": "QUEST_CONTENT_COMPLETE_TALK",
					"rawParams": [
						7370301,
						0
					],
					"talkId": 7370301
				}
			]
		}
	],
	"talks": [
		{
			"id": 7370301,
			"completionStepIds": [
				7370301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7370301",
							"2"
						],
						"stepId": 7370301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ラミヤ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 737030101,
					"content": "ねえ。そこの…そこのお二人さん、ちょっと待って…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030102
					],
					"speakerTitle": "ラミヤ"
				},
				{
					"id": 737030102,
					"content": "新しい賞品付きのミニゲームに参加して欲しいの。ふふっ、挑戦をクリアできれば、豊富な実験資金が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030103
					],
					"speakerTitle": "ラミヤ"
				},
				{
					"id": 737030103,
					"content": "実験資金？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737030104,
					"content": "あーいや、ただの言い間違え。ゲームをクリアして、アンケートに答えてくれたら挑戦報酬をあげるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030105
					],
					"speakerTitle": "ラミヤ"
				},
				{
					"id": 737030105,
					"content": "挑戦もすごく簡単なのよ。こんな簡単に報酬をゲットできるチャンス、滅多にないんだから、ふふっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030106
					],
					"speakerTitle": "ラミヤ"
				},
				{
					"id": 737030106,
					"content": "うぅ…なんだか怪しいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030107,
						737030108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737030107,
					"content": "新手の詐欺か何か…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737030109
					]
				},
				{
					"id": 737030109,
					"content": "ちょっとちょっと、そんなピリピリしないでよ。すぐに人のことを疑うもんじゃないわよ？でもまあ、こんなところで通りすがりの人を訳の分からない挑戦に誘うのって、確かに普通じゃないかもね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030110
					],
					"speakerTitle": "ラミヤ"
				},
				{
					"id": 737030110,
					"content": "でも弁解させて——いや、説明させて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030111
					],
					"speakerTitle": "ラミヤ"
				},
				{
					"id": 737030111,
					"content": "いいよ、言い逃れのチャンスをあげる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737030112
					]
				},
				{
					"id": 737030112,
					"content": "二人には分からなかったかもしれないけど…実は私、教令院生論派の学者で、ラミヤって名前なの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030113
					],
					"speakerTitle": "ラミヤ"
				},
				{
					"id": 737030113,
					"content": "学者だっていうのはすぐわかるぞ。だって、教令院の制服を着てるしな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737030114,
					"content": "ふふっ、それはどうかしら。学者に仮装してるやつもいるかもしれないわよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030115
					],
					"speakerTitle": "ラミヤ"
				},
				{
					"id": 737030115,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737030116,
					"content": "何よ、私のことを言ったんじゃないってば！まったく、私はただ好意で注意喚起しただけなのに。私は本当に生論派の学者だし、それどころか、マハマトラたちのノートに記録されてるタイプの学者なんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030117
					],
					"speakerTitle": "ラミヤ"
				},
				{
					"id": 737030117,
					"content": "マハマトラのノートに記録されてるって本当にいいことなのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737030118,
					"content": "コホン。とにかく、二人…ああそうだ、まだ名前を聞けてなかったわね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030119
					],
					"speakerTitle": "ラミヤ"
				},
				{
					"id": 737030119,
					"content": "オイラはパイモンだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737030120,
					"content": "#{M#俺}{F#私}は{NICKNAME}…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737030121
					]
				},
				{
					"id": 737030121,
					"content": "#ふふっ、{NICKNAME}とパイモンね。じゃあこの挑戦が一体どういうものなのか、二人に説明していくわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030122
					],
					"speakerTitle": "ラミヤ"
				},
				{
					"id": 737030122,
					"content": "実は全部、子どもの頃に読んだ物語と関係してることなの。一人の少年が猫になって、猫の国で冒険する話だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030123
					],
					"speakerTitle": "ラミヤ"
				},
				{
					"id": 737030123,
					"content": "その物語がすごくかわいくてね、ふふっ…結局、主人公は美しい猫とイチャイチャしてから、最後は人間の姿に戻ったの。その猫と主人とペットの関係になるって終わり方も悪くなかったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030124
					],
					"speakerTitle": "ラミヤ"
				},
				{
					"id": 737030124,
					"content": "いやいや、その終わり方って、どう考えてもおかしいだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737030125,
					"content": "物語の最後で少年の主人公は、あの美しい猫が実はオスだったことに気が付くんだけど…この終わり方ってすごく文学的だと思う…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030126
					],
					"speakerTitle": "ラミヤ"
				},
				{
					"id": 737030126,
					"content": "ふふっ…話が逸れたわね。とにかく、その物語には色んな動物目線の描写があって、すごく興味を惹かれたのよ。私は学者になってからも、ずっとそれに近い研究をしてきたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030127
					],
					"speakerTitle": "ラミヤ"
				},
				{
					"id": 737030127,
					"content": "研究でできた装置と成熟したアーカーシャ技術を駆使すれば、色んな動物たちの視覚を自分とリンクさせられるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030128
					],
					"speakerTitle": "ラミヤ"
				},
				{
					"id": 737030128,
					"content": "やっとそれっぽい話になってきたな。でも、それってつまり教令院の経費で個人の夢を叶えてるってことだよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030129
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737030129,
					"content": "ハハッ、確かにそうね。でも、私自身のための研究でもあるけど、元々応用の見込みがある研究なのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030130
					],
					"speakerTitle": "ラミヤ"
				},
				{
					"id": 737030130,
					"content": "災害後に救助を求める人々を捜索するときとか時や、崩落した古代遺跡を探査する時、動物たちの方が私たちよりもずっと動きやすいから、もしその視野を借りることができれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030131,
						737030137
					],
					"speakerTitle": "ラミヤ"
				},
				{
					"id": 737030131,
					"content": "入っちゃいけないところにも入れる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737030132
					]
				},
				{
					"id": 737030132,
					"content": "入っちゃいけないところってなんだよ…ラミヤの言ってる使い道はすごく真っ当だったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030133
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737030133,
					"content": "#ふふっ、でもまさにその通りよ。やっぱり{NICKNAME}は鋭い人なのね…人は同類を警戒するけど、動物相手だとそうでもないものだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030134
					],
					"speakerTitle": "ラミヤ"
				},
				{
					"id": 737030134,
					"content": "えええ！本当に変な使い方もしてるのかよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030135
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737030135,
					"content": "冗談冗談。この技術の応用については毎回記録を残してるから、悪いことなんかしたら絶対に捕まるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030136
					],
					"speakerTitle": "ラミヤ"
				},
				{
					"id": 737030136,
					"content": "でも、どう？なんだかすごそうな研究でしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030141
					],
					"speakerTitle": "ラミヤ"
				},
				{
					"id": 737030141,
					"content": "なんかすごそうだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030142
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737030142,
					"content": "元々はゆっくり研究するつもりだった。でも妙論派のやつらも似たような課題に取り組んでて…彼らは小型装置で同じことを実現しようとしてるみたいなのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030143
					],
					"speakerTitle": "ラミヤ"
				},
				{
					"id": 737030143,
					"content": "まさに外道…っ！冷たい装置なんかより、動物の方が可愛いに決まってる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030144
					],
					"speakerTitle": "ラミヤ"
				},
				{
					"id": 737030144,
					"content": "#そうでしょ、{NICKNAME}、パイモン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030145
					],
					"speakerTitle": "ラミヤ"
				},
				{
					"id": 737030145,
					"content": "ええと、それは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030146,
						737030148
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737030146,
					"content": "確かに動物の方がかわいい！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737030147
					]
				},
				{
					"id": 737030147,
					"content": "#{NICKNAME}ならきっと理解してくれると思ってたわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030151
					],
					"speakerTitle": "ラミヤ"
				},
				{
					"id": 737030151,
					"content": "いずれにしても、さっさと成果を出さないと、きっと妙論派に先を越されちゃう。だから仕方なく、こうして野外で通りすがりの人に声をかけて実験してるのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030152
					],
					"speakerTitle": "ラミヤ"
				},
				{
					"id": 737030152,
					"content": "ふふっ、ほらね、全然怪しくなかったでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030153
					],
					"speakerTitle": "ラミヤ"
				},
				{
					"id": 737030153,
					"content": "まあ、確かにまともっぽいな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030154
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737030154,
					"content": "「滅多にない報酬簡単ゲットのチャンス…」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737030155
					]
				},
				{
					"id": 737030155,
					"content": "よし、それじゃあオイラたちは参加するぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030156
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737030156,
					"content": "ふふっ、二人ともありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030157
					],
					"speakerTitle": "ラミヤ"
				},
				{
					"id": 737030157,
					"content": "じゃあ、まずはこれを持ってて。この道具は私が発明した「すりこみの鏡」よ。鏡には装置で関連付けた動物の視野が映ってるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030158
					],
					"speakerTitle": "ラミヤ"
				},
				{
					"id": 737030158,
					"content": "「すりこみの鏡」が映し出すのは、動物たちの身体に取り付けた装置が捉えた映像なの。それで動物たちの居場所を判断して、捕まえて来てくれれば報酬をあげるわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030159
					],
					"speakerTitle": "ラミヤ"
				},
				{
					"id": 737030159,
					"content": "ええと、もし動物たちがあっちこっち走り回ってたらどうするんだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030160
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737030160,
					"content": "大丈夫、ふふっ、あの子たちはみんな訓練を受けてるもの。このエリアの範囲内で移動するだけで、遠くへ行ったりはしないから、そこは安心して。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030161
					],
					"speakerTitle": "ラミヤ"
				},
				{
					"id": 737030161,
					"content": "#おう！{NICKNAME}、今すぐ行こうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737030148,
					"content": "#{M#俺}{F#私}は「ガ——ガ——機械」派。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737030149
					]
				},
				{
					"id": 737030149,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030150
					],
					"speakerTitle": "ラミヤ"
				},
				{
					"id": 737030150,
					"content": "ふん！なんのことだかさっぱり分からないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030151
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737030137,
					"content": "すぐに探し物を見つけられるかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737030138
					]
				},
				{
					"id": 737030138,
					"content": "その通り。例えば、宝盗イタチの視覚を借りれば、もっと迅速に遺跡の発掘ができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030139
					],
					"speakerTitle": "ラミヤ"
				},
				{
					"id": 737030139,
					"content": "鳥の視覚を借りれば、高い空の上から見下ろすことができる。天気が良くって遠くまで見えるときなんかは、地形の測量と観測にすごく役立つわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030140
					],
					"speakerTitle": "ラミヤ"
				},
				{
					"id": 737030140,
					"content": "ふふっ、どう？なんだかすごそうな研究でしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030141
					],
					"speakerTitle": "ラミヤ"
				},
				{
					"id": 737030108,
					"content": "マハマトラに報告しようかな…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737030109
					]
				}
			]
		}
	]
}