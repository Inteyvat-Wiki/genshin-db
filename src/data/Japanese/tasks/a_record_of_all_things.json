			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鍾離"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110240101,
					"content": "前にも言ったが、孤雲閣の下には魔神たちが多く封印されている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240102
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110240102,
					"content": "今の璃月は凡人たちのものだ。遠い昔に生きたヘウリアの「置き土産」を、璃月港に持ち帰るわけにはいかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240103
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110240103,
					"content": "ここで静かに眠らせた方がいい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240104
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110240104,
					"content": "それで、何をすればいい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110240105
					]
				},
				{
					"id": 110240105,
					"content": "俺は一つの時代を終わらせた。その歴史をどう記録すればいいか…ずっと考えていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240106
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110240106,
					"content": "歴史は記録できるが、その信憑性は不確かなものだ。今回の件はその証明になった。歴史を捻じ曲げるほど、時間の力とは強い…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240107
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110240107,
					"content": "本物の歴史を刻むために、より良い「記録」が必要だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240108
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110240108,
					"content": "石に刻むのは良い「記録」だった。しかし変わらない盤石も、世界も、俺も…いつか消えるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240109
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110240109,
					"content": "鍾離…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110240110,
					"content": "だから、お前のことを思い浮かべたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240111
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110240111,
					"content": "お前は様々な世界を旅する者。歴史をお前の記憶に刻めば、それはいつか別の世界にも伝わるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240112
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110240112,
					"content": "旅人としてお前が「記録」すれば、テイワットの時代も歴史も、「バックアップ」を得たのと同じだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240113,
						110240115
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110240113,
					"content": "それが同行して欲しかった理由か。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110240114
					]
				},
				{
					"id": 110240114,
					"content": "任重くして道遠し、か。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110240118,
					"content": "さてと、そろそろ「置き土産」を海に入れるとするか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240119
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110240119,
					"content": "ん？なんで海に入れるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110240120,
					"content": "言っただろう？ここには魔神が多く封印されていると。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240121
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110240121,
					"content": "「群玉閣」に再び封印された、あの「渦の魔神」オセルもな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110240115,
					"content": "宝箱探しのためじゃなかったのか。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110240116
					]
				},
				{
					"id": 110240116,
					"content": "ハハハッ…お前ならテイワットを出た後も、宝を見つけられるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240117
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110240117,
					"content": "俺は「富の神」でもあるからな、効果には期待できるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240118
					],
					"speakerTitle": "鍾離"
				}
			]
		}
	]
}