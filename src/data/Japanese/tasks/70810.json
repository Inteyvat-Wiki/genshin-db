					"nextDialogs": [
						708101702
					]
				},
				{
					"id": 708101702,
					"content": "このドリンク、悪くない…ああ、見た目もいいし、飲んでみるか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101703
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 708101703,
					"content": "冷たくしてからのほうがいい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708101704
					]
				},
				{
					"id": 708101704,
					"content": "あ？冷たいほうがいいのか？仕方ない、持って帰るよ。帰ったほうが氷とか見つけやすいからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101705
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 708101705,
					"content": "さてと、俺らファデュイは約束を守るからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101706
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 708101706,
					"content": "聞きたいことがあったら、俺様に聞くと言い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101707
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 708101707,
					"content": "他の執行官について。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708101708
					]
				},
				{
					"id": 708101708,
					"content": "執行官の方々…俺様も噂ぐらいしか聞いたことがないが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101709
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 708101709,
					"content": "俺様も他の人から聞いただけだから、あまり本気にするなよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101710
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 708101710,
					"content": "執行官第六位の「散兵」様は性格に難ありらしい…あまり気にいられないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101711
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 708101711,
					"content": "理由に関しては…なんというか、「散兵」様は性格が悪いという人もいるし、空気を読まないという人もいるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101712
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 708101712,
					"content": "俺様は執行官の近くで働くやつを知ってるんだが、あいつも他の執行官も「散兵」様のことをあまり好きじゃないと言ったな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101713
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 708101713,
					"content": "でも、「散兵」様は執行官だからな、下っ端の俺らと比べたら十分すごいよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴィクトル"
				}
			]
