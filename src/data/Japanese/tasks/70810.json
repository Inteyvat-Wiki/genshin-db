			"dialogs": [
				{
					"id": 708101601,
					"content": "（「フローラのしおり」を取り出す）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708101602
					]
				},
				{
					"id": 708101602,
					"content": "これは、しおりか…まあいい、装飾品として悪くない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101603
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 708101603,
					"content": "やっぱお前に頼んで正解だった。さあ、知りたいことがあったら俺様に聞くといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101604
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 708101604,
					"content": "もう戻るの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708101605
					]
				},
				{
					"id": 708101605,
					"content": "俺様のことか？ああ、俺様は帰りたいと思ってるよ。モンドは退屈だし、仕事もないしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101606
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 708101606,
					"content": "毎日ここに座ってシスターたちに睨まれるのは嫌なんだ。俺様は悪いことしてないのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101607
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 708101607,
					"content": "でもゲーテホテルの方々は最近外に出ないし、何の情報もないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101608
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 708101608,
					"content": "本音を言うと、「淑女」様の用件が終わったら、さっさと帰りたいんだ。どうせモンドの人たちは俺たちのことが嫌いだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101609
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 708101609,
					"content": "でも上からは何の命令もないからな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴィクトル"
				}
			]
		},
