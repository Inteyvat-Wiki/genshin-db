			"trigger": {
				"objectNames": [
					"ヴィクトル"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708100121,
					"content": "他に質問があるのか？あるなら早く聞いてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100122,
						708100127
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 708100122,
					"content": "どうして自分に頼んだ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708100123
					]
				},
				{
					"id": 708100123,
					"content": "ハッ、いい質問だな。なぜかというと、俺様はファデュイだから、モンドでは肩身が狭いんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100124
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 708100124,
					"content": "前まではシスターに睨まれただけだが、今は西風騎士までも犯罪者を見るような目で俺様を見てやがる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100125
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 708100125,
					"content": "旅人のお前とは話せたが、さすがにモンドの人には頼めないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100126
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 708100126,
					"content": "別に俺様は何もしてないのに、こんなに嫌われなくてもいいのにな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 708100127,
					"content": "城内にいるファデュイはあとどれくらい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708100128
					]
				},
				{
					"id": 708100128,
					"content": "詳細は知らないが、ゲーテホテルにいる方々は外に出ようとしないな、理由は分からないが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100129
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 708100129,
					"content": "きっとお偉いさんが何かを計画してるんだろう…まあ、俺様みたいな下っ端とは関係ないがな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴィクトル"
				}
			]
		},
		{
			"id": 7081003,
			"completionStepIds": [
				7081002
