					"サラ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708100201,
					"content": "モンドの特産について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708100202
					]
				},
				{
					"id": 708100202,
					"content": "モンドの特産ですか？うちの料理はどれもモンドの特産と言えますが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100203
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 708100203,
					"content": "長持ちはできませんし、お土産としては贈ることは難しいですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100204
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 708100204,
					"content": "保存しやすいように加工できますが…そうすると、食感も味も落ちてしまいますからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100205
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 708100205,
					"content": "大丈夫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708100206
					]
				},
				{
					"id": 708100206,
					"content": "分かりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100207
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 708100207,
					"content": "でも、店の在庫は少し前のものですから、プレゼント用でしたら、新しいものを作ったほうがいいかと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100208
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 708100208,
					"content": "えっと、お友達はどちらから来たのでしょうか？どんな料理にするか考えます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100209,
						708100211
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 708100209,
					"content": "スネージナヤから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708100210
					]
				},
				{
					"id": 708100210,
					"content": "スネージナヤ？遠いですね、ちゃんと考えておきますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100213
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 708100213,
					"content": "うーん、スネージナヤの人たちの好みは分かりませんが、絶対に外れない料理なら一つあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100214
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 708100214,
					"content": "そうですね、「満足サラダ」を一つ作ってください。あとは私が処理します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100215
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 708100215,
					"content": "こういう加工は久しぶりですから、道具を探してきますね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "サラ"
				},
				{
					"id": 708100211,
					"content": "ファデュイから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708100212
					]
				},
				{
					"id": 708100212,
					"content": "ファデュイ？スネージナヤのあの…お友達が多いですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100213
					],
					"speakerTitle": "サラ"
				}
			]
		},
