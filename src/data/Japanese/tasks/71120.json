			"dialogs": [
				{
					"id": 711209101,
					"content": "またあんたらかよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209102
					],
					"speakerTitle": "地元のゴロツキ"
				},
				{
					"id": 711209102,
					"content": "友よ、好奇心は抑えておくことだな。俺たちのことを見えてないことにすれば、俺たちもお前たちのことを見えてないことにしてやる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209103,
						711209111
					],
					"speakerTitle": "ぐるぐる蛇"
				},
				{
					"id": 711209103,
					"content": "何を見張ってるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711209104
					]
				},
				{
					"id": 711209104,
					"content": "友よ、俺たちが何をして稼いでるか分かるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209105
					],
					"speakerTitle": "ぐるぐる蛇"
				},
				{
					"id": 711209105,
					"content": "なんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711209106,
					"content": "ゴホゴホッ…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209107
					],
					"speakerTitle": "ぐるぐる蛇"
				},
				{
					"id": 711209107,
					"content": "（お前たち二人にだけ教えてやる。他のやつらには話すなよ…いいか…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209108
					],
					"speakerTitle": "ぐるぐる蛇"
				},
				{
					"id": 711209108,
					"content": "（おう！なんだ！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711209109,
					"content": "お前たちのような暇人を追い払う仕事さ！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209110
					],
					"speakerTitle": "ぐるぐる蛇"
				},
				{
					"id": 711209110,
					"content": "うわぁ！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711209111,
					"content": "洞窟から変な音がする…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711209112
					]
				},
				{
					"id": 711209112,
					"content": "俺のオナラだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209113
					],
					"speakerTitle": "地元のゴロツキ"
				},
				{
					"id": 711209113,
					"content": "あ、ああ…そうだ、こいつがオナラしたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209114
					],
					"speakerTitle": "ぐるぐる蛇"
				},
				{
					"id": 711209114,
					"content": "だ、だったらいいや…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
