			"dialogs": [
				{
					"id": 711200101,
					"content": "おい、近寄るな！ここは主の縄張りだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200102
					],
					"speakerTitle": "地元のゴロツキ"
				},
				{
					"id": 711200102,
					"content": "うわっ！びっくりした！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200103,
						711200106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711200103,
					"content": "#{M#君}{F#あなた}たち、何者？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711200104
					]
				},
				{
					"id": 711200104,
					"content": "それはお前たち次第だな。お行儀よくしてれば友達になってやる！だがあれこれ詮索してくるようなら、悪いが容赦しない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200105
					],
					"speakerTitle": "ぐるぐる蛇"
				},
				{
					"id": 711200105,
					"content": "自分たちの状況が分かったなら、とっとと帰るんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200109
					],
					"speakerTitle": "地元のゴロツキ"
				},
				{
					"id": 711200109,
					"content": "おまえら、怪しすぎるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711200110,
					"content": "怪しい？やれやれ…俺たちは門番をしてるだけさ。きょろきょろしてるお前たちのほうが怪しいだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200111
					],
					"speakerTitle": "ぐるぐる蛇"
				},
				{
					"id": 711200111,
					"content": "もういい、あんたらに話すことはない！俺たちの邪魔をすんじゃねえぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "地元のゴロツキ"
				},
				{
					"id": 711200106,
					"content": "ここがどの「主」の縄張りだって？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711200107
					]
				},
				{
					"id": 711200107,
					"content": "どの「主」か？ふん…聞いたら死ぬほど驚くぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200108
					],
					"speakerTitle": "地元のゴロツキ"
				},
				{
					"id": 711200108,
					"content": "友よ、お前のためだ。知るべきでないことをむやみに聞くのはよせ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200109
					],
					"speakerTitle": "ぐるぐる蛇"
				}
			]
		},
