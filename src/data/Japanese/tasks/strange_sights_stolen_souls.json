					"キャサリン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111200101,
					"content": "キャサリン！なにか新しい依頼はあるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111200102,
					"content": "はい、あなたたちにぴったりの依頼が入っております。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200103
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 111200103,
					"content": "璃月港輝山庁の鉱夫である戴さんより、冒険者協会に人手を借りたいとの依頼がありました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200104
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 111200104,
					"content": "具体的にはなにをやるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111200105,
					"content": "鉱山で働く仲間を見つけ出してほしいとのことです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200106
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 111200106,
					"content": "人探しか？よし、オイラたちの得意分野だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111200107,
					"content": "はい、旅人さんの実力なら問題ありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200108
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 111200108,
					"content": "具体的な依頼内容は、直接会ってお話するそうです。もしこの依頼を引き受けてくださるのでしたら、埠頭付近にいる戴さんにお声がけください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キャサリン"
				}
			]
		},
		{
			"id": 1112002,
			"completionStepIds": [
				1112002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112002",
							"2"
						],
						"stepId": 1112002,
						"stateName": "QUEST_STATE_UNFINISHED"
