					"鍾離"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111200301,
					"content": "前回の続き、岩王帝君は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200302
					],
					"speakerTitle": "田饒舌"
				},
				{
					"id": 111200302,
					"content": "見つけたぞ、鍾離！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111200303,
					"content": "ん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200304
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111200304,
					"content": "お前たちも講談を聞きに来たのか。なかなか粋な心掛けだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200305
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111200305,
					"content": "いや、オイラたちは鍾離を探しに来たんだ。今空いてるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111200306,
					"content": "時間ならあるが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200307,
						111200308
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111200307,
					"content": "依頼を受けて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200309
					]
				},
				{
					"id": 111200309,
					"content": "地質と鉱石に詳しい人が必要なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111200310,
					"content": "地質と鉱石…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200311
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111200311,
					"content": "この大陸中を探し回っても、鍾離より詳しい人なんていないはずだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111200312,
					"content": "その依頼人が、世界一鉱石に詳しい専門家を見つけたらしいんだけど、テイワットで一番詳しいのは鍾離だってことをオイラが証明してやる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111200313,
					"content": "ふむ、何故そうも他人と比べたがる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200314
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111200314,
					"content": "そんなんじゃないけど、ただ戴が勘違いしてるから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200315
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111200315,
					"content": "だからオイラは…アイツに分からせてやろうと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200316
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111200316,
					"content": "ははっ、そういうことなら、一緒に行っても構わない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200317
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111200317,
					"content": "ホントか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200318
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111200318,
					"content": "先に断っておくが、俺は多少知識があるとはいえ、世界一と言えるほどこの道を極めているわけではない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200319
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111200319,
					"content": "知識の海には果てがない、見聞を広めることは良いことだ。俺がいればお前たちも安心できるのだろう？それに、もし本物の専門家に会えるのであれば、俺も切磋琢磨するのにまたとない機会だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200320
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111200320,
					"content": "そ…そんなに謙虚にならなくてもいいと思うけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200321
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111200321,
					"content": "とりあえず、鍾離が同行してくれることになったし、戴のところに戻ろう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111200308,
					"content": "ある特別な仕事があって…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200309
					]
				}
			]
		},
		{
			"id": 1112004,
