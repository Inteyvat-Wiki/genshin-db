			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"戴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111200201,
					"content": "オーイ——おまえが戴か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111200202,
					"content": "おう、俺に何か用か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200203
					],
					"speakerTitle": "戴"
				},
				{
					"id": 111200203,
					"content": "ん？ひょっとして協会からきた冒険者か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200204
					],
					"speakerTitle": "戴"
				},
				{
					"id": 111200204,
					"content": "えっ、分かるのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111200205,
					"content": "その恰好と顔つきを見れば、相当なやり手だっていうのがすぐに分かるさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200206
					],
					"speakerTitle": "戴"
				},
				{
					"id": 111200206,
					"content": "ふふん、なかなか見る目があるな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111200207,
					"content": "ハハハッ、この業界にいると、鑑定の仕事も多く任される。石も人間も、この戴にかかれば一目で見極められるってもんよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200208
					],
					"speakerTitle": "戴"
				},
				{
					"id": 111200208,
					"content": "二人とも少し待っててくれ、もう一人の助っ人がそろそろ来るはずなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200209
					],
					"speakerTitle": "戴"
				},
				{
					"id": 111200209,
					"content": "ちょっと待てよ、仕事はオイラたちに頼むんだろ？他の助っ人と報酬を山分けするなんてことないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111200210,
					"content": "はぁ、正直なところ、今回の一件はかなり厄介なんだ。冒険者だけじゃまだ心許なくてな、それで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200211
					],
					"speakerTitle": "戴"
				},
				{
					"id": 111200211,
					"content": "おいおい、他の人にも頼んだのかよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111200212,
					"content": "オジサン、オイラたちの腕を舐めてもらっちゃ困るぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200213,
						111200214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111200213,
					"content": "パイモン、そんなこと言わない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200215
					]
				},
				{
					"id": 111200215,
					"content": "お前たちはまだ詳しい事情を知らないだろう、今回の一件は鉱山で起きたことでな…しかも、ただ事じゃない。それに鉱山に事故は付き物だ。だから念のため、この業界の専門家にも依頼したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200216
					],
					"speakerTitle": "戴"
				},
				{
					"id": 111200216,
					"content": "鉱石鑑定や地質分析とかは、冒険者には荷が重いだろ？専門家を連れていくのも、いざという時のためさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200217
					],
					"speakerTitle": "戴"
				},
				{
					"id": 111200217,
					"content": "それに、俺が見つけた人は玄人中の玄人。どんな石だろうと、その人なら一目見ただけでお見通しなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200218
					],
					"speakerTitle": "戴"
				},
				{
					"id": 111200218,
					"content": "俺の見立てでは、あの人は世界で一番鉱石に詳しい！そんな専門家を知ってたら、依頼しない手はないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200219
					],
					"speakerTitle": "戴"
				},
				{
					"id": 111200219,
					"content": "ちょっと待て。世界で一番鉱石に詳しい人は、その人じゃないと思うぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200220
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111200220,
					"content": "どうしてだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200221
					],
					"speakerTitle": "戴"
				},
				{
					"id": 111200221,
					"content": "だって、一番詳しい人はオイラたちの友達にいるからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200222
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111200222,
					"content": "それって、もしかして…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200223
					]
				},
				{
					"id": 111200223,
					"content": "（ちょうど彼に聞きたいことがある。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200224
					]
				},
				{
					"id": 111200224,
					"content": "ふふん、上には上がいるってのを教えてやるぜ！ここで待ってろよ、今その人を連れて来るから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111200214,
					"content": "パイモン、負けず嫌いだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200215
					]
				}
			]
		},
