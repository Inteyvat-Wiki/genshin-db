			"dialogs": [
				{
					"id": 111200401,
					"content": "戴、戻ったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111200402,
					"content": "おっ！その人がお前たちの友達か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200403
					],
					"speakerTitle": "戴"
				},
				{
					"id": 111200403,
					"content": "そうだ！この「先生」こそが、世界一鉱石と地質に詳しい人だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111200404,
					"content": "大げさだな、多少その道に覚えがあるだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200405
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111200405,
					"content": "へっ、俺が見つけた人も絶対に引けを取らないと思うぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200406
					],
					"speakerTitle": "戴"
				},
				{
					"id": 111200406,
					"content": "まあ、ここで言い合ってても埒が明かない。彼が来たら、その目で確認してみるといい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200407
					],
					"speakerTitle": "戴"
				},
				{
					"id": 111200407,
					"content": "えっと…ここでいいんだっけか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200408
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111200408,
					"content": "おっ、来たか！紹介しよう、俺が見つけた助っ人、クンジュだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200409
					],
					"speakerTitle": "戴"
				},
				{
					"id": 111200409,
					"content": "クンジュ、こっちは冒険者協会から来た冒険者で、えっと…こちらの先生は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200410
					],
					"speakerTitle": "戴"
				},
				{
					"id": 111200410,
					"content": "ん…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200411
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111200411,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200412
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111200412,
					"content": "彼は鍾離先生、往生堂の客卿。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200413
					]
				},
				{
					"id": 111200413,
					"content": "往生堂の客卿、鍾離先生…その名前、俺も耳にしたことがあるぞ。聞くところによると、知識が豊富で才能溢れる方だとか。まさか、こんなところで本人に会えるとは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200414
					],
					"speakerTitle": "戴"
				},
				{
					"id": 111200414,
					"content": "うん？その顔どこかで…もしかして往生堂で会ったことが？いや、でも僕は往生堂に行ったことがないし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200415
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111200415,
					"content": "戴、さっそく試してみないか？どっちが本物の専門家かを！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200416
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111200416,
					"content": "ここで勝負するつもりだったんだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200417
					]
				},
				{
					"id": 111200417,
					"content": "ん？そう言われても…どう比べたらいいのか、俺には見当もつかないんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200418
					],
					"speakerTitle": "戴"
				},
				{
					"id": 111200418,
					"content": "じゃあ、おまえたち二人で勝負の内容を決めてくれ。鍾離が勝ったら鍾離に手伝わせる。逆にもし鍾離が…って、鍾離が負けるはずないよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200419
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111200419,
					"content": "勝負？いいですよ、望むところです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200420
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111200420,
					"content": "臆することなく臨むか、いいことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200421
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111200421,
					"content": "あははっ、あなたを一目見た時から、この業界の玄人だとお見受けしていました。でも僕より上かどうかは、試してみないと分かりませんよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200422
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111200422,
					"content": "なんだか偉そうだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200423
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111200423,
					"content": "ははっ、本当のことを言っただけです…それに、僕にはこれくらいしか取り柄がないですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200424
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111200424,
					"content": "つまり、クンジュ殿は鑑定士なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200425
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111200425,
					"content": "いえ、そういう訳では。えっと、実はその…記憶が曖昧で、璃月港に何をしに来たかもよく覚えていないんです…ある日、突然戴に声を掛けられまして。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200426
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111200426,
					"content": "僕が石を持ってるのを見て、彼がいくつか質問してきたんです、それに答えたらここに来るようにと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200427
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111200427,
					"content": "んん？そんな曖昧な状態で来たのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200428
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111200428,
					"content": "俺が璃月港に来る途中、クンジュが何か言いながら石の手入れをしてる姿を見たんだ。石について凄く詳しそうだったんでな、気になって質問したんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200429
					],
					"speakerTitle": "戴"
				},
				{
					"id": 111200429,
					"content": "そしたら、鉱夫の俺よりも石に詳しいときた！で、やることがないんだったら、俺のところに手伝いに来ないかと誘ったってわけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200430
					],
					"speakerTitle": "戴"
				},
				{
					"id": 111200430,
					"content": "でも、記憶が曖昧なのに大丈夫か。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200431
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111200431,
					"content": "そこまで酷いわけじゃありません…それに石のことなら、必ずお役に立てると思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200432
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111200432,
					"content": "鍾離先生、この石を見てどう思いますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200433
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111200433,
					"content": "ふむ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200434
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111200434,
					"content": "この石は外側が滑らかで、表面のひび割れは火山の噴火によるものだろう。俺の考えに間違いがなければ、これは他国の石だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200435
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111200435,
					"content": "おぉ！なかなか鋭いですね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200436
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111200436,
					"content": "それもただの石ではない。殻が薄く、線が黒い…おそらく、中には良質な水晶鉱が入っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200437
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111200437,
					"content": "ご名答。この石は火山の周りにあったものです、市場で見つけたので買いました。売り手はこの石の価値に気付いてなかったみたいですけどね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200438,
						111200439
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111200438,
					"content": "水晶鉱はどこにでもあるものじゃない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200440
					]
				},
				{
					"id": 111200440,
					"content": "もちろん、純度や質の高さだけでは珍しいものとは呼べません。お宝と呼べるような価値の高い水晶は、その中に水や砂金を含んでいるんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200441
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111200441,
					"content": "この石の中に隠されている水晶は、形を成す際に水を含んだようです。水が夜の山々の満月のように底に隠され、空を映しながら流れ動く。非常に珍しいことなんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200442
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111200442,
					"content": "そんなに詳しく…まるで、直接見てきたみたいな言い方だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200443
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111200443,
					"content": "オイラたちをからかってるんじゃないよな？だって、まだその石の中身を見てないだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200444
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111200444,
					"content": "いや、彼が言ったことは事実だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200445
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111200445,
					"content": "水晶はそのほとんどが高温環境で生成される。高温と水は相性が悪い、そのため水入り水晶は貴重な品だ。そして、この水晶が含んでいるものはおそらく高山の湖の水、さらに珍しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200446
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111200446,
					"content": "鍾離までそう言うなら…本当なのかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200447
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111200447,
					"content": "鍾離先生のような目を持つ方に会うのは初めてです！僕よりも詳しい…石の中の様子をどうやって知ったんですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200448
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111200448,
					"content": "見識を深めていけば、自然と分かるようになる。大したことではない、クンジュ殿もあまり気にしないでくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200449
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111200449,
					"content": "いえ、そんなことないですよ！これも何かの縁です、ぜひ僕とお友達になってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200450
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111200450,
					"content": "戴、鍾離先生を一緒に連れて行くべきです！僕を信じてください、彼は凄い目利きの持ち主です。こんな人、一生に何人も会えないですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200451
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111200451,
					"content": "分かった、人が多ければそれだけ力になる。全員、俺と一緒に層岩巨淵の鉱山まで来てくれ。行方不明になった仲間たちを探してほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "戴"
				},
				{
					"id": 111200439,
					"content": "なんでこれは良質なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200440
					]
				}
			]
		},
		{
			"id": 1112022,
			"completionStepIds": [],
