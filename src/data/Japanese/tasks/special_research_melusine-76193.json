			"dialogs": [
				{
					"id": 761930130,
					"content": "（えっ？あれはもしかして…メ、メリュジーヌ！？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930101
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761930101,
					"content": "うわあ！本当にメリュジーヌだ！かわいいメリュジーヌ、いい子のメリュジーヌ、小さなメリュジーヌ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930102
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761930102,
					"content": "えっ…？あなたは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930103
					],
					"speakerTitle": "マメール"
				},
				{
					"id": 761930103,
					"content": "あの…触ってもいい？ずっと気になってたの、メリュジーヌみたいにかわいくて賢い子って、触ったらどんな感じなのかなって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930104
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761930104,
					"content": "すべすべなのか、ふわふわなのか、もこもこなのか…へへっ、怖がらなくていいよ、本当にちょっと触るだけだから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930105
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761930105,
					"content": "えっ、えっ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930106
					],
					"speakerTitle": "マメール"
				},
				{
					"id": 761930106,
					"content": "法に触れるような行為はお控えください、お嬢さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930107
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 761930107,
					"content": "マメールお嬢様はフォンテーヌ廷の市民です。許可のない身体的接触は誤解を招き、三年以上の禁固刑および無期限の入国禁止を含む重大な結果をもたらす可能性があります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930108
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 761930108,
					"content": "わああっ！き、機械が、う、動いて喋って——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930109
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761930109,
					"content": "…コホン！ごめんなさい。この子があまりにもかわいかったから、衝動を抑えきれなくて、つい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930110
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761930110,
					"content": "私はリンネア、冒険者協会の顧問をしてます！本当に怪しい者ではないので！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930111
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761930111,
					"content": "否定。自分を「怪しい者」と名乗る怪しい者はいません。これは基本的な論理的推理です、親愛なるリンネア様。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930112
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 761930112,
					"content": "うっ…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930113
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761930113,
					"content": "勝手に人を怪しいなんて言っちゃダメだよ、セイモア。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930114
					],
					"speakerTitle": "マメール"
				},
				{
					"id": 761930114,
					"content": "背はあまり高くないフェイさん、とても綺麗な色。お父{RUBY#[S]エリナス}様とは違うけど、でもあたたかくて、綺麗。だから怪しい人じゃないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930115
					],
					"speakerTitle": "マメール"
				},
				{
					"id": 761930115,
					"content": "否定。紫色を除けば、色は一般的に立場とは無関係です。これは基本的な論理的推理です、マメールお嬢様。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930116
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 761930116,
					"content": "…服の色のことを言ってるんじゃないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930117
					],
					"speakerTitle": "マメール"
				},
				{
					"id": 761930117,
					"content": "え？どうして紫はいいの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930118
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761930118,
					"content": "とにかく…こんにちは、リンネア。私はマメール、フォンテーヌから来た旅行画家よ。こっちはセイモア、私の大切な友達なの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930119
					],
					"speakerTitle": "マメール"
				},
				{
					"id": 761930119,
					"content": "まさか、こんなところで他の人に会えるなんて。リンネアも取材に来たの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930120
					],
					"speakerTitle": "マメール"
				},
				{
					"id": 761930120,
					"content": "取材…なのかな。図鑑の補足も取材って言えると思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930121
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761930121,
					"content": "マメールにピンク色のフロストフィンイルカのことを話した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						761930122
					]
				},
				{
					"id": 761930122,
					"content": "でも…へへっ、もしかしたらメイジーの言う通り、あのフロストフィンイルカは本当に幸運をもたらす動物なのかもね！可愛いメリュジーヌに会えるなんて——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930123
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761930123,
					"content": "法に触れるような行為はお控えください、お嬢さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930124
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 761930124,
					"content": "わ、分かってるよ！むやみに触ったりしないから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930125
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761930125,
					"content": "なるほど。リンネアは動物が好きなの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930126
					],
					"speakerTitle": "マメール"
				},
				{
					"id": 761930126,
					"content": "うん！…はぁ、私もメリュジーヌみたいに水の中を速く泳げたらいいのに！あのフロストフィンイルカたちがとても楽しそうに遊んでるところに、私も混ざりたいな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930127
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761930127,
					"content": "うん…じゃあ、この絵をリンネアに贈ろうかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930128
					],
					"speakerTitle": "マメール"
				},
				{
					"id": 761930128,
					"content": "速く泳げるようにはならないけど、部屋に飾っておけば、「フロストフィンイルカと一緒に遊んでる」気分になれるかもしれないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930129
					],
					"speakerTitle": "マメール"
				},
				{
					"id": 761930129,
					"content": "わあ、ありがとう！すごくきれいな絵だね！戻ったら、「スペランザ」のみんなにも絶対見せるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リンネア"
				}
			]
		}
	]
}