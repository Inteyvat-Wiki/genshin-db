			"dialogs": [
				{
					"id": 1903201201,
					"content": "ふぅー、疲れたぁ、やっと休めるぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201202
					],
					"speakerTitle": "周良"
				},
				{
					"id": 1903201202,
					"content": "ちっとばかしやりすぎたか、何人か腰を抜かしたヤツがいたな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201203
					],
					"speakerTitle": "周良"
				},
				{
					"id": 1903201203,
					"content": "何してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201204
					]
				},
				{
					"id": 1903201204,
					"content": "うわっ、ここは立ち入り禁止だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201205
					],
					"speakerTitle": "周良"
				},
				{
					"id": 1903201205,
					"content": "まあ、いいや、全部聞こえてたんだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201206
					],
					"speakerTitle": "周良"
				},
				{
					"id": 1903201206,
					"content": "俺はここの鬼役で今は休憩中。暑いから衣装を脱いだんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201207,
						1903201208
					],
					"speakerTitle": "周良"
				},
				{
					"id": 1903201207,
					"content": "やっぱり鬼なんていないんだ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201209
					]
				},
				{
					"id": 1903201209,
					"content": "そうだよ、本物の鬼なんかいるわけねぇだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201210
					],
					"speakerTitle": "周良"
				},
				{
					"id": 1903201210,
					"content": "俺たちも、参加者も、本物の鬼が見たいわけじゃねぇんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201211
					],
					"speakerTitle": "周良"
				},
				{
					"id": 1903201211,
					"content": "求めているのはただの雰囲気、あるいはきっかけ。そして最も重要なのは刺激だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201212
					],
					"speakerTitle": "周良"
				},
				{
					"id": 1903201212,
					"content": "高鳴る胸の鼓動、そして恐怖と驚き、普段じゃ言えない言葉を口にできるのが肝試しの醍醐味なんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201213,
						1903201214
					],
					"speakerTitle": "周良"
				},
				{
					"id": 1903201213,
					"content": "確かに。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201215
					]
				},
				{
					"id": 1903201215,
					"content": "よっしゃ！俺もそろそろ仕事に戻るか、あんたも連れと仲良くやれよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "周良"
				},
				{
					"id": 1903201214,
					"content": "（重雲、がっかりするだろうな。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201215
					]
				},
				{
					"id": 1903201208,
					"content": "ただ怖がらせてただけ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201209
					]
				}
			]
		}
	]
}