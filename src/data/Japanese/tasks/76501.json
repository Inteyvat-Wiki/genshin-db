			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ラウマ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765010101,
					"content": "#パイモン、{NICKNAME}。森の鳥たちがそなたたちのことを話しておった。何か用だろうか？それとも…私に道を示してほしいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010102,
						765010103
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 765010102,
					"content": "この辺りを見てまわってただけだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010104
					]
				},
				{
					"id": 765010104,
					"content": "ここは月華に満ちておる。草木も、この地に生息する生き物たちも、外の世界とはまるで異なる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010105
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 765010105,
					"content": "故に、ここでは確かに貴重な写真がたくさん撮れるであろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010106
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 765010106,
					"content": "ぜひ自由にまわっていってくれ。もし気になることがあれば、いつでも私に聞くがよい。できる限り答えよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010107,
						765010108
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 765010107,
					"content": "ここはとても静かだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010109
					]
				},
				{
					"id": 765010109,
					"content": "ああ。ここは私が瞑想する場であり、万物と囁き合い、交流する場でもある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010110
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 765010110,
					"content": "ここに立っているだけで、心が落ち着くのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010111
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 765010111,
					"content": "わぁ、なんだか詩的な感じがするな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010112,
						765010113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765010112,
					"content": "その、実はちょっとお願いがあるんだけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010114
					]
				},
				{
					"id": 765010114,
					"content": "うんうん、ラウマはここに立ってるだけで、すっごく絵になるもんな！写真機で撮ったら、きっとすごく綺麗だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765010115,
					"content": "…写真を？それは私にとって珍しい体験だ。もしこの静けさと私の姿が、そなたの写真機で収めるに値すると感じるのなら、喜んで協力しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010116
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 765010116,
					"content": "これがそなたたちの旅の素敵な思い出になるのであれば、私も嬉しく思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010117
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 765010117,
					"content": "では、私はどうすればよい？視線をどこかに固定したほうがよいか？それとも、いつも通りにしていればよいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010118,
						765010119
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 765010118,
					"content": "いつも通りにしてくれればいいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010120
					]
				},
				{
					"id": 765010120,
					"content": "では、あとは任せよう。目を惹く瞬間を捉えられるよう祈っておる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 765010119,
					"content": "一番素敵な瞬間を捉えてみせるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010120
					]
				},
				{
					"id": 765010113,
					"content": "写真を撮らせてくれない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010114
					]
				},
				{
					"id": 765010108,
					"content": "ラウマは普段この辺りにいるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010109
					]
				},
				{
					"id": 765010103,
					"content": "ついでにいい被写体を探してるんだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010104
					]
				}
			]
		},
