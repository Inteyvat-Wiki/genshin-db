			"trigger": {
				"objectNames": [
					"フェルロイス",
					"シェニー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745110101,
					"content": "お二人さん、こんにちは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110102
					],
					"speakerTitle": "フェルロイス"
				},
				{
					"id": 745110102,
					"content": "おまえたちは…警察隊？オイラたちになにか用か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745110103,
					"content": "えへへ、当ててみて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110104,
						745110105
					],
					"speakerTitle": "シェニー"
				},
				{
					"id": 745110104,
					"content": "まさか街中で屋根の上を走ってたのが…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745110106
					]
				},
				{
					"id": 745110106,
					"content": "そんなことまでしてたの！？ゆっくり話して、今すぐ事件の記録を取るから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110107
					],
					"speakerTitle": "シェニー"
				},
				{
					"id": 745110107,
					"content": "オイラたちにカマをかけてたのかよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745110108,
					"content": "冗談よ。紹介するわ、私はシェニー、こっちは私の先輩、フェルロイス。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110109
					],
					"speakerTitle": "シェニー"
				},
				{
					"id": 745110109,
					"content": "先輩が最近新しい発明品を作ったから、試してくれる人を探してるんだけど、二人は興味あるかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110110
					],
					"speakerTitle": "シェニー"
				},
				{
					"id": 745110110,
					"content": "発明品？どんなのだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745110111,
					"content": "リモート操作ができる砲台だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110112
					],
					"speakerTitle": "フェルロイス"
				},
				{
					"id": 745110112,
					"content": "ほら、今までの砲台って近くで操作する人が必要だったでしょう？でもそれって、敵側からしてみれば、砲台さえ狙えば一網打尽にできるってことになる。でも、リモート操作ができれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110113
					],
					"speakerTitle": "シェニー"
				},
				{
					"id": 745110113,
					"content": "なるべく死傷者を減らすことができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110114
					],
					"speakerTitle": "フェルロイス"
				},
				{
					"id": 745110114,
					"content": "そういうこと！さすがは「フォンテーヌ科学院のオファーを三回も断った」フェルロイス先輩。こんな不思議な発明品をあっという間に作れちゃうなんて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110115
					],
					"speakerTitle": "シェニー"
				},
				{
					"id": 745110115,
					"content": "フォンテーヌ科学院のオファーを三回も断った？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745110116
					]
				},
				{
					"id": 745110116,
					"content": "その…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110117
					],
					"speakerTitle": "フェルロイス"
				},
				{
					"id": 745110117,
					"content": "そうよ！フェルロイス先輩はね、フォンテーヌ科学院に才能を見込まれて、最先端の研究をしないかって大金を積まれて三回もオファーをされたのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110118
					],
					"speakerTitle": "シェニー"
				},
				{
					"id": 745110118,
					"content": "でも先輩は警察隊の仕事が大好きで、ずっとここに残ってくれているの。なんと感動的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110119
					],
					"speakerTitle": "シェニー"
				},
				{
					"id": 745110119,
					"content": "それでも、先輩は自分の才能を無駄にしてしまわないように、時々こういった発明を作ったりして、私たちのいろんな悩みを解決してくれてるの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110120
					],
					"speakerTitle": "シェニー"
				},
				{
					"id": 745110120,
					"content": "なんだかすごそうだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745110121,
					"content": "コホン、とんでもない。シェニー、私の教えを覚えているか？賢い人ほど、謙虚であることの大切さを心得ているものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110122
					],
					"speakerTitle": "フェルロイス"
				},
				{
					"id": 745110122,
					"content": "はい！フェルロイス先輩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110123
					],
					"speakerTitle": "シェニー"
				},
				{
					"id": 745110123,
					"content": "とにかく、二人にはこのリモート砲台の有効性を試してほしい。「場所」と「標的」は、もう用意してあるし、報酬もケチったりしない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110124
					],
					"speakerTitle": "フェルロイス"
				},
				{
					"id": 745110124,
					"content": "へへっ、任せろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745110125,
					"content": "#オイラと{NICKNAME}は今までいろんな変わったものを見てきたんだ。おまえの発明が役に立つかどうか、見極めてやるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745110126,
					"content": "ファイト、お二人さん。ファイト、フェルロイス先輩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110127
					],
					"speakerTitle": "シェニー"
				},
				{
					"id": 745110127,
					"content": "えっと…とにかく、こちらへどうぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フェルロイス"
				},
				{
					"id": 745110105,
					"content": "まさか街中で剣を振るってたのが…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745110106
					]
				}
			]
		}
	]
}