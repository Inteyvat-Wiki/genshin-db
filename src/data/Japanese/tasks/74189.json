			"dialogs": [
				{
					"id": 741890501,
					"content": "ちょっと、お客さん。宝物の「秘密」を知りたくない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890502
					],
					"speakerTitle": "ペルマンジェ"
				},
				{
					"id": 741890502,
					"content": "秘密って？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890503
					]
				},
				{
					"id": 741890503,
					"content": "隠された財宝、それと財宝の扉を開ける鍵よ…どう？興味はあるかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890504,
						741890505
					],
					"speakerTitle": "ペルマンジェ"
				},
				{
					"id": 741890504,
					"content": "また魔物を退治しに行かせるつもりじゃ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890506
					]
				},
				{
					"id": 741890506,
					"content": "そんなわけないでしょ。うちの酒場はお客さんをこき使ったりしないわ。少なくとも…あたしたちは客を使い走りにしない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890507
					],
					"speakerTitle": "ペルマンジェ"
				},
				{
					"id": 741890507,
					"content": "あたしのそばにある「艦砲」と、真正面にある瓦礫が見えるでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890508
					],
					"speakerTitle": "ペルマンジェ"
				},
				{
					"id": 741890508,
					"content": "この大砲を撃ち、砲弾で岩を爆破するだけでいいの。瓦礫から出てきたお宝はあなたの物よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890509
					],
					"speakerTitle": "ペルマンジェ"
				},
				{
					"id": 741890509,
					"content": "この大砲の名前は誰がつけたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890510
					]
				},
				{
					"id": 741890510,
					"content": "操舵手がつけたのよ。この大砲も彼がどこかから引っ張り上げてきたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890511,
						741890512
					],
					"speakerTitle": "ペルマンジェ"
				},
				{
					"id": 741890511,
					"content": "大砲にパーツが欠けてるんでしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890513
					]
				},
				{
					"id": 741890513,
					"content": "誤解してるわね。大砲のパーツは完璧に揃ってるし、エネルギーも十分よ。毎日メンテナンスしてるもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890514
					],
					"speakerTitle": "ペルマンジェ"
				},
				{
					"id": 741890514,
					"content": "でもね、大砲を使う前にいくつかの「問題」に答えてほしいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890515
					],
					"speakerTitle": "ペルマンジェ"
				},
				{
					"id": 741890515,
					"content": "…実はこれは操舵手からの要望よ。彼が言うには、こうして酒場に来た客にやることを用意してあげれば、酒をゆっくり飲んでくれて滞在時間も延びるだろうって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890516
					],
					"speakerTitle": "ペルマンジェ"
				},
				{
					"id": 741890516,
					"content": "それは分からないけど、問題を出してみて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890517
					]
				},
				{
					"id": 741890517,
					"content": "一問目、酒場「ザ·ラスティ·ラダー」にはテーブルがいくつある？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890518
					],
					"speakerTitle": "ペルマンジェ"
				},
				{
					"id": 741890518,
					"content": "二問目は、酒場「ザ·ラスティ·ラダー」にはスタッフが何人いるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890519
					],
					"speakerTitle": "ペルマンジェ"
				},
				{
					"id": 741890519,
					"content": "三つ目の問題よ。酒場「ザ·ラスティ·ラダー」で出していないメニューは何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890520
					],
					"speakerTitle": "ペルマンジェ"
				},
				{
					"id": 741890520,
					"content": "とにかく、三問答えて正解すれば大砲を撃ち、岩を撃ち砕いて、お宝をゲットできるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890521
					],
					"speakerTitle": "ペルマンジェ"
				},
				{
					"id": 741890521,
					"content": "お宝を手に入れた後は、どうなるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890522
					]
				},
				{
					"id": 741890522,
					"content": "…その後は頃合いを見て、今度は洞窟の中にそれなりのお宝を放り込んで岩で入り口を塞ぐわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890523
					],
					"speakerTitle": "ペルマンジェ"
				},
				{
					"id": 741890523,
					"content": "そして、次の客が来るのを待って、また「艦砲」を撃たせてお宝を手に入れさせるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890524,
						741890525
					],
					"speakerTitle": "ペルマンジェ"
				},
				{
					"id": 741890524,
					"content": "お疲れ様。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890528
					]
				},
				{
					"id": 741890528,
					"content": "さあ、問題の答えを探してきて。ここで待ってるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ペルマンジェ"
				},
				{
					"id": 741890525,
					"content": "#{M#君}{F#あなた}の雇い主は良心の欠片もない！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890526
					]
				},
				{
					"id": 741890526,
					"content": "あなたの言ってることは否定できないわね。でも今のところ、操舵手に見つからずに大砲を彼に向ける方法がないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890527
					],
					"speakerTitle": "ペルマンジェ"
				},
				{
					"id": 741890527,
					"content": "それに軽々しく撃てば酒場の他のお客をケガさせちゃうでしょ。そういうのはあたしの道徳観にそぐわないしね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890528
					],
					"speakerTitle": "ペルマンジェ"
				},
				{
					"id": 741890512,
					"content": "大砲に必要なエネルギーが足りてないんでしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890513
					]
				},
				{
					"id": 741890505,
					"content": "また何か探させる気じゃ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890506
					]
				}
			]
		}
	]
}