	"talks": [
		{
			"id": 7350801,
			"completionStepIds": [
				7350801
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7350801",
							"2"
						],
						"stepId": 7350801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"バルフォア",
					"ハニヤー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735080101,
					"content": "#「ゴールド流星」の{NICKNAME}に「シルバー伴星」、ここ数日は本当にありがとな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080102
					],
					"speakerTitle": "バルフォア"
				},
				{
					"id": 735080102,
					"content": "お二人が「チエキノコン布陣」をプレイする度に過程を記録させてもらった。君たちが遊んだ記録からは、様々なデータが得られるんだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080103
					],
					"speakerTitle": "バルフォア"
				},
				{
					"id": 735080103,
					"content": "お二人は「トップレベル」の試遊者だから、この記録を一般の試遊者のものと合わせれば、妥当な改善案を導き出せるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080104
					],
					"speakerTitle": "バルフォア"
				},
				{
					"id": 735080104,
					"content": "もちろん、最終的には君たちから全体に関する意見を聞きたいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080105
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 735080105,
					"content": "君たちの意見がプラスになるのは、「チエキノコン布陣」だけじゃないから。次の大会の遊び方にもある程度影響してくるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080106
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 735080106,
					"content": "ぜひお二人が重視する方向性を教えてくれ。例えば…面白さか、それとも競技性か、だったら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080107,
						735080112,
						735080117
					],
					"speakerTitle": "バルフォア"
				},
				{
					"id": 735080107,
					"content": "仲間たちとの協力を重視してる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735080108
					]
				},
				{
					"id": 735080108,
					"content": "そうだな！試合や戦いも重要だけど…オイラ、これからのチャレンジは、キノコンの仲間たちとの絆が試されるものになってほしいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735080109,
					"content": "キノコンの仲間たちとの絆、ね…わかったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080110
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 735080110,
					"content": "バルフォアさん、この前私が言った、一番重要な理念…まだ覚えてる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080111
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 735080111,
					"content": "わかっているさ！次の大会は、お二人がキノコンの仲間たちと意思疎通したうえで全力を出せるような、協力が試されるチャレンジを設計してみるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080121
					],
					"speakerTitle": "バルフォア"
				},
				{
					"id": 735080121,
					"content": "君たちは、全然変わってないね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080122
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 735080122,
					"content": "とにかく、これで今回の「チエキノコン布陣」テストは無事終了だわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080123,
						735080125
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 735080123,
					"content": "お疲れ様！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735080124
					]
				},
				{
					"id": 735080124,
					"content": "やったな！仕事が終わったから、報酬がもらえるぞ！自分へのご褒美に、美味しいもんを買いに行こうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735080127,
					"content": "ん、待てよ…？オイラたちって、次の大会の主催者なんだよな…？それでハニヤーとバルフォアが次の大会のために準備をしてて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735080128,
					"content": "ハニヤーはオイラたちを手伝ってくれてるだろ、それにバルフォアも…一応オイラたちの従業員ってことで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080129
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735080129,
					"content": "ってことは…うーん…逆にオイラたち、助っ人や従業員に報酬をあげる立場なんじゃないか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080130
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735080130,
					"content": "ちょっとちょっと！君たちって、ほんと優しすぎるんだから！これは私が好きでやっていることだわ。それに、収穫もたくさんあったんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080131
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 735080131,
					"content": "結局のところ、私もビジネスで身を立てているわけだからね。今回のように「チエキノコン布陣」の開発運営に携われる経験は、私たちのような人間にとってすごく貴重なものよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080132
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 735080132,
					"content": "もしこの仕事を公開募集したら、大金を払ってでも権利が欲しいっていう人が大勢現れるはずよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080133
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 735080133,
					"content": "それに「チエキノコン布陣」が収益に繋がるようになれば、バルフォアさんも投資回収の目途が立つし、その大部分は私が預かるんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080134
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 735080134,
					"content": "一部は貯金して、次の大会の予備資金にするわ。それにもう一部はキノコンの仲間たちの世話に使うつもりよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080135
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 735080135,
					"content": "ポコポコビーニーたちだけじゃなくて、信風舞姫のように、他の選手たちから預かった仲間のぶんまで世話できるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080136
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 735080136,
					"content": "つまり、君たちが「チエキノコン布陣」の改良に協力してくれたことで、儲けはたくさん出るし、キノコンの仲間たちの暮らしも保障できるってわけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080137
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 735080137,
					"content": "なるほど…収益とかってのは、よくわかんないけど…ようするに、全員がハッピーってことだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080138
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735080138,
					"content": "なんだかオイラも、もーっと達成感があるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080139
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735080139,
					"content": "#{NICKNAME}、機会があったら、オイラたちもスメールの友達に「チエキノコン布陣」のことを話そうぜ。もっとたくさんの人に、このゲームを知ってもらうんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080140
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735080140,
					"content": "もちろん！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735080141
					]
				},
				{
					"id": 735080141,
					"content": "これからキノコンの仲間たちとシティを出て、助手と合流したら拠点に戻るわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080142
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 735080142,
					"content": "あんまり長く離れてたら、留守番しているキノコンの仲間たちを不安にさせちゃうかもしれないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080143
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 735080143,
					"content": "バルフォアさんにはしばらくここに残って、引き続きテスト版の「チエキノコン布陣」を宣伝してもらうわ。まだ遊びたければ、遊んでいいわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080144
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 735080144,
					"content": "ああ、好きなだけ遊んでいってくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080145
					],
					"speakerTitle": "バルフォア"
				},
				{
					"id": 735080145,
					"content": "えっと…ハニヤー、もう行っちゃうのか？その、ポコポコビーニーたちを連れて行っちゃうのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080146
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735080146,
					"content": "ポコポコビーニーともうちょっと遊びたいぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080147
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735080147,
					"content": "…でもハニヤーに会えて、オイラ、けっこう安心したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080148
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735080148,
					"content": "なんたって、キノコンの仲間たちは元気だったし、オイラたちとの絆も強いままだって確認できたからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080149
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735080149,
					"content": "安心して。案外、またすぐに会えるかもしれないわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080150
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 735080150,
					"content": "君たちはよくあちこちを旅しているけど、私も連絡する方法があるわ。例えば冒険者協会づてに、手紙を渡すとかね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080151
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 735080151,
					"content": "約束するわ。次に会う時は私も、キノコンの仲間たちも、変わらず健康で元気いっぱいだって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080152
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 735080152,
					"content": "いい知らせを待っててね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080153
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 735080153,
					"content": "おう！信じてるぜ、ハニヤー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080154,
						735080155,
						735080156
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735080154,
					"content": "頑張って、ハニヤー。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735080157
					]
				},
				{
					"id": 735080157,
					"content": "#それじゃ、またね。「ゴールド流星」の{NICKNAME}に、「シルバー伴星」のパイモン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 735080155,
					"content": "キノコンの仲間たちをよろしく。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735080157
					]
				},
				{
					"id": 735080156,
					"content": "自分のことも大事にして。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735080157
					]
				},
				{
					"id": 735080125,
					"content": "報酬をお忘れなく。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735080126
					]
				},
				{
					"id": 735080126,
					"content": "そうだそうだ。仕事で稼いだモラで買った食べ物はな、いつもより美味しく感じるんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735080112,
					"content": "華麗に戦うことと爽快感を重視してる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735080113
					]
				},
				{
					"id": 735080113,
					"content": "おう！今回キノコンの仲間たちと再会して、オイラは確信したぞ。あいつらとの絆は、時間が経てば経つほど、薄まるどころか強くなるんだ、ってな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735080114,
					"content": "今度またキノコンの仲間たちと試合をするとき、オイラたちの連携はもっとすごいことになるぜ。華麗な戦いってやつを見せてやるからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735080115,
					"content": "なるほど。適切なチャレンジによって、キノコンの仲間たちが実力を十分に発揮させられるようになる、と考えているわけね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080116
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 735080116,
					"content": "それじゃ次の試合は、もっとチャレンジングな内容を追加するぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080121
					],
					"speakerTitle": "バルフォア"
				},
				{
					"id": 735080117,
					"content": "どっちでも構わない。楽しければ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735080118
					]
				},
				{
					"id": 735080118,
					"content": "おう！結果はどうあれ、キノコンの仲間たちと一緒に遊べて、そんでもって試練や困難を乗り越えられれば、オイラたちは嬉しいぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735080119,
					"content": "わかった。楽しさとチャレンジ性を両立させるわけね。言うだけなら簡単だけど、実行するとなると難しいわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080120
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 735080120,
					"content": "俺に任せてくれ。お二人に満足してもらえるような提案を、全力で作るぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080121
					],
					"speakerTitle": "バルフォア"
				}
			]
		}
	]
}