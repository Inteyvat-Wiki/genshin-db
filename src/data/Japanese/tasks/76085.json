						760850602
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760850602,
					"content": "うん、すごくおいしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850603
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760850603,
					"content": "今まで飲んだ中で、一番好き。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850604
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760850604,
					"content": "本当か！？やっと気に入ってくれたんだな。じーんとするぜ…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850605
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760850605,
					"content": "なんか…ごめんなさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850606
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760850606,
					"content": "まとめると、苦い飲み物とかジュース系はあんまり好きじゃなくて、ミルクもないほうが好きってことか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850607
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760850607,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850608
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760850608,
					"content": "これなら「濃厚じゃない」でしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760850609
					]
				},
				{
					"id": 760850609,
					"content": "好みが分かってきたから、これからはパパっと作れるぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850610
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760850610,
					"content": "…これから？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850611
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760850611,
					"content": "おう！オイラたち、友達だろ？飲みたくなったらいつでも言ってくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850612
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760850612,
					"content": "もしかして、飲み終わったらもうないと思って、さっきからちびちび飲んでたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850613
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760850613,
					"content": "…うん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850614
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760850614,
					"content": "遠慮しなくていいから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760850615
					]
				},
				{
					"id": 760850615,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850616
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760850616,
					"content": "ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
