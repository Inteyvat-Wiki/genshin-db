			"dialogs": [
				{
					"id": 760520401,
					"content": "この香りは知ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520402
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520402,
					"content": "そうなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760520403,
					"content": "サンドローネが部屋で飲んでたから…私がこういう香りの飲み物に興味津々なのを知ってたからか、わざとゆっくりゆっくり飲んでた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520404
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520404,
					"content": "私が…質問するのを待ってるみたいに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520405
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520405,
					"content": "何か質問した？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520406
					]
				},
				{
					"id": 760520406,
					"content": "うん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520407
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520407,
					"content": "なにを聞いたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760520408,
					"content": "「マシンオイルを飲まなくていいの？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520409
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520409,
					"content": "彼女はなんて？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520410
					]
				},
				{
					"id": 760520410,
					"content": "うーん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520411
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520411,
					"content": "すごく嫌な言葉が返ってきたよ。キミたちは言わないでね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520412
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520412,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520413
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520413,
					"content": "一口で興味をなくしちゃったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520414
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760520414,
					"content": "ごめんなさい。苦くて、あまり好きじゃない。だからサンドローネはあんなに渋い顔をしてたんだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520415
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520415,
					"content": "それは別の理由な気がするぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
