			"dialogs": [
				{
					"id": 721080901,
					"content": "うむ。よくやった、あいつらも喜んでた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080902
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 721080902,
					"content": "…ん？ああ、問題ない、お前の代わりに吾輩が聞いてみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080903
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 721080903,
					"content": "「刑部小判」が「お前たちは人間なのに、どうして体に狸の気配があるの？」と聞いてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080904
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 721080904,
					"content": "…たしかにそうだ！本当のことを言え！どうしてお前は我らと同じ匂いを持ってる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080905
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 721080905,
					"content": "えっ？今さらそれを聞くのかよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080906,
						721080907
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721080906,
					"content": "お面の巫女お姉さん…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080908
					]
				},
				{
					"id": 721080908,
					"content": "そうだった！たしかにそんなこともあったな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080909
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721080909,
					"content": "前にお面の巫女お姉さんのところですっごく豪華な料理を食べたんだ。妖狸一族から盗んだ法術で作ったらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080910
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721080910,
					"content": "なに？我らの法術を盗んだだと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080911
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 721080911,
					"content": "ふむ、まさか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080912
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 721080912,
					"content": "なんだ、あのクソ狐。生きていたのなら、さっさと吾輩に挨拶に来ればいいものを。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080913
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 721080913,
					"content": "そのお面を被った巫女が、おまえのことを「旧友」だって言ってたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080914
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721080914,
					"content": "お面？お面も巫女も知らぬぞ。狐は一匹知っているがな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080915
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 721080915,
					"content": "だがそういえば、あのクソ狐も巫女の姿になったことがあったな。その巫女、どんな外見をしていた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080916
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 721080916,
					"content": "白狐のお面を被ってた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080917
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721080917,
					"content": "他には？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080918,
						721080920
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 721080918,
					"content": "黒の短髪だった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080919
					]
				},
				{
					"id": 721080919,
					"content": "巫女の服装をしてたな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080922
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721080922,
					"content": "ぬぬ…知らぬな。吾輩はそのような者は見たことがない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080923
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 721080923,
					"content": "そっか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080924
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721080924,
					"content": "…ん？ふむ、よし、吾輩に任せろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080925
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 721080925,
					"content": "「証城」が「お前たちと遊べて楽しかった、ありがとう！」と言ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080926
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 721080926,
					"content": "オイラも楽しかったぞ！",
					"roleType": "TALK_ROLE_NPC",
