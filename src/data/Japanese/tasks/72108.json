				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721080101,
					"content": "着いた、ここが鎮守の森だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721080102,
					"content": "お面の巫女お姉さんが、旧友がここの奥深くにいるって言ってたな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721080103,
					"content": "じゃあ、さっそく行こうぜ、その奥深くとやらに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7210804,
			"completionStepIds": [
				7210816
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7210816",
							"2"
						],
						"stepId": 7210816,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7210810",
							"3"
						],
						"stepId": 7210810,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721080401,
					"content": "鎮め物を保管してる天狐の像…中が空っぽだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721080402,
					"content": "面姉の「旧友」が隠したのかもしれない。聞いてみよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721080403,
					"content": "…面姉？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080404
					]
				},
				{
					"id": 721080404,
					"content": "さっきオイラがつけたあだ名だ。どうだ、覚えやすいだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080405,
						721080406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721080405,
					"content": "全然。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080407
					]
				},
				{
					"id": 721080407,
					"content": "え、そっか…まあとにかく、手がかりを探そう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721080406,
					"content": "まったく意味わからない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080407
					]
				}
			]
		},
		{
			"id": 7210807,
			"completionStepIds": [
				7210814
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7210814",
							"2"
						],
						"stepId": 7210814,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"五百蔵"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721080701,
					"content": "ぐぅ——僕…わわわ吾輩は五百蔵、煮るなり焼くなり好きにするがいい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080702
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 721080702,
					"content": "うわっ！石像がしゃべった！しかも、ビビってまともに話せないみたいだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080703
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721080703,
					"content": "吾輩は石像などではない！しばらく封印され、このようになっただけだ！吾輩は天下に名を轟かせる妖狸の五百蔵なり！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080704,
						721080705
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 721080704,
					"content": "五百蔵？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080706
					]
				},
				{
					"id": 721080706,
					"content": "なんだ、今の小童は五百蔵の名も知らぬのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080707
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 721080707,
					"content": "『御苑狸劇画』、『五百蔵茶壺』、『隠神大囃子』、『影向山騒動狸合戦』…これらの物語を聞いたことがないのか？ん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080708
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 721080708,
					"content": "吾輩はいったいどれくらいの年月、あやつに封印されていたんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080709,
						721080711
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 721080709,
					"content": "悪気があったわけじゃない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080710
					]
				},
				{
					"id": 721080710,
					"content": "なんだ、吾輩を「懲らしめ」に来たのではないのか、それを早く言え。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080719
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 721080719,
					"content": "ゴホッゴホッ。馬鹿言え！この妖狸大王である吾輩を探しに来た理由は何だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080720,
						721080722
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 721080720,
					"content": "「神櫻大祓」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080721
					]
				},
				{
					"id": 721080721,
					"content": "神鷹大斧？なんだそれ？鬼族の宝具か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080726
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 721080726,
					"content": "もう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080727
					]
				},
				{
					"id": 721080727,
					"content": "うーん、こいつが本当にお面の巫女お姉さんが言ってた旧友なのか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080728
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721080728,
					"content": "とにかく、オイラたちは狐の像に隠された物を探してるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080729
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721080729,
					"content": "えっ——あ、あんなものを探してどうするんだ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080730,
						721080731
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 721080730,
					"content": "あれ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080732
					]
				},
				{
					"id": 721080732,
					"content": "あのクシのせいで、吾輩は封印されたんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080733
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 721080733,
					"content": "…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080734,
						721080735,
						721080736
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 721080734,
					"content": "百年？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080737
					]
				},
				{
					"id": 721080737,
					"content": "そんなの吾輩も知らん！鎮守の森は日の光も月の光も見えない、時間が分かるわけないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080738
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 721080738,
					"content": "当時はな、あのクソ狐をおびき出すために、あちこちで騒ぎを起こしたが、結局意味がなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080739
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 721080739,
					"content": "あの狐の像を壊してうっぷんを晴らしてたら、中にクシがあったんだ。そこでいいことを思いついたのさ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080740
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 721080740,
					"content": "クシは狐の像の中に隠されていた。そして、そこには白辰の形。脳裏に思い浮かんだのは白毛のあいつだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080741
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 721080741,
					"content": "吾輩はすぐにそのクシが大切なものだと気づいた。これを隠して、あのクソ狐をおびき出せばいいと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080742
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 721080742,
					"content": "うんうん、宝で人を引き付けるのはたしかにいい手段だな！それで？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080743
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721080743,
					"content": "その結果、「影向役者三人組」の中の人間に、吾輩と一族のみんなはこってり絞られ、こうして石にされたってわけさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080744
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 721080744,
					"content": "だから、五百蔵は人間を怖がってるのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080745
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721080745,
					"content": "ふん！人間なんて寿命も短いし、変化もできないし、どうしてあのクソ狐が人間を庇うのかまったく理解できない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080746
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 721080746,
					"content": "吾輩を封印したやつも酷い性格をしていた。「うむ。封印される瞬間にいい感じの格好を取れば、観光名所になれるだろう。」とか言ってたな。ああッ！ムカつく！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080747
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 721080747,
					"content": "確かに、いい観光名所…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080748
					]
				},
				{
					"id": 721080748,
					"content": "何？お前まで…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080749
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 721080749,
					"content": "#（おい、{NICKNAME}、怒らせて鎮め物が手に入らなかったらどうするんだよ…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080750,
						721080751
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721080750,
					"content": "凄く強そうな見た目をしてるから…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080752
					]
				},
				{
					"id": 721080752,
					"content": "そ、そうだぞ。おまえの存在が、この暗い森の中に色彩をもたらしてるな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080753
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721080753,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080754
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 721080754,
					"content": "ほう、あとは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080755,
						721080756
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 721080755,
					"content": "神像のように尊い…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080757
					]
				},
				{
					"id": 721080757,
					"content": "おう、だから…封印されるのも悪いことじゃないと思うぞ、相手も悪気はなかったのかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080758
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721080758,
					"content": "もっともらしいことを言っているように聞こえるが、よく考えるとそうでもないような…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080759
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 721080759,
					"content": "そのクシ、貸してくれない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080760
					]
				},
				{
					"id": 721080760,
					"content": "ダメじゃないが、その代わり子供たちに付き合ってもらう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080761
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 721080761,
					"content": "#おう、それなら簡単だ。{NICKNAME}は子供と遊ぶのが上手だからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080762,
						721080763
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721080762,
					"content": "実は子供は苦手…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080765
					]
				},
				{
					"id": 721080765,
					"content": "「証城」と「刑部小判」、そして「吉法師」。森でこの<color=#00E1FFFF>3匹の小狸</color>を見つけて、遊んでやってくれ。何せ吾輩は自由に動けない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080766
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 721080766,
					"content": "あの封印をしたクソ野郎、子供たちを封じる時に適当だったせいか、最近になって何匹か動けるようになってな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080767
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 721080767,
					"content": "…いや、我ら妖狸の強大な法力があれば、人間の封印から逃れることなど造作もない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080768,
						721080770
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 721080768,
					"content": "じゃあ、なんで自分は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080769
					]
				},
				{
					"id": 721080769,
					"content": "コホンッ！さすが強大な法力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080771
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721080771,
					"content": "吾輩ほどではないが、あいつらも少しは法力があり、自身の姿を隠すことができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080772
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 721080772,
					"content": "さあ、早く行け！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 721080770,
					"content": "さすが強大な法力！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080771
					]
				},
				{
					"id": 721080763,
					"content": "うん、だってパイモンとよく遊ぶから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080764
					]
				},
				{
					"id": 721080764,
					"content": "おい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080765
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721080756,
					"content": "七天神像にも劣らない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080757
					]
				},
				{
					"id": 721080751,
					"content": "凄くかっこいい見た目をしてるから…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080752
					]
				},
				{
					"id": 721080735,
					"content": "千年？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080737
					]
				},
				{
					"id": 721080736,
					"content": "百万年？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080737
					]
				},
				{
					"id": 721080731,
					"content": "反応した。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080732
					]
				},
				{
					"id": 721080722,
					"content": "ここの「鎮め物」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080723
					]
				},
				{
					"id": 721080723,
					"content": "蒸し物？食べ物か？我ら妖狸は料理に詳しいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080724
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 721080724,
					"content": "違う、「神櫻大祓」だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080725
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721080725,
					"content": "大福？ああ、確かにもう長いこと大福は食べてない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080726
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 721080711,
					"content": "取り立てに来た。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080712
					]
				},
				{
					"id": 721080712,
					"content": "と、取り立て！？なんのことだ？ちょっと待て、思い出すから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080713
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 721080713,
					"content": "その顔、その姿…ふむ…何か借りていたか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080714
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 721080714,
					"content": "なんか考え始めちゃったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080715
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721080715,
					"content": "おい、初対面の相手にそんな冗談言うなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080716
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721080716,
					"content": "なんだ、冗談だったのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080717
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 721080717,
					"content": "いや、ないならいい、よかった…もう一度確認するが、吾輩は本当に、お前に借りがないんだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080718
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 721080718,
					"content": "…まさか、いろんな人に借りを作ってるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080719
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721080705,
					"content": "天下に名を？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080706
					]
				}
			]
		},
