			"dialogs": [
				{
					"id": 401650401,
					"content": "折り紙モモンガたちは体が軽く、風を利用して木々の間を移動する…それによって独自の生態が形成され…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650402
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 401650402,
					"content": "あっ、しまった…ノートがもうなくなりそうだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "コレイ"
				}
			]
		},
		{
			"id": 4016505,
			"completionStepIds": [
				4016504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4016504",
