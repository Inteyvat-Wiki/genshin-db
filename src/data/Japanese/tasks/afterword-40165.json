						],
						"pointId": 910008016
					}
				]
			},
			"dialogs": [
				{
					"id": 401650701,
					"content": "オズヴァルド·ラフナヴィネス…答えなさい。今この瞬間、三千世界を見渡す断罪の目に映る光景は、決して虚妄などではないのね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650702
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 401650702,
					"content": "はい、見間違いではありません、お嬢様。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650703
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 401650703,
					"content": "ならば、わたくしも幽夜浄土の王室の礼を以て、二人に挨拶をしましょう。千星の国の至高なる夜龍、そしてその傍に立つ笠を被りし従者よ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650704
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 401650704,
					"content": "誰が従者だって？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650705
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650705,
					"content": "お嬢様は「こんにちは、お二人にお会いできて嬉しいです」とおっしゃっています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650706
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 401650706,
					"content": "こんにちは！ボクも会えて嬉しいよ。でも笠っちはボクの友達で、従者じゃないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650707
					],
					"speakerTitle": "ちびドゥリン"
				},
				{
					"id": 401650707,
					"content": "…ふん、わざわざ説明しなくたっていい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650708
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650708,
					"content": "笠っち！ちびドゥリン！やっと見つけたぞ！わっ、それにフィッシュルたちまでここに来てたのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650709
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401650709,
					"content": "ふふん！幽夜浄土の祈聖を受けし異世界の旅人よ！汝がこの星空の下でこの皇女と出会ったのは、間違いなく運命の選択！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650710,
						401650711
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 401650710,
					"content": "皇女様のおっしゃる通りです。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401650712
					]
				},
				{
					"id": 401650712,
					"content": "#栄誉騎士の{M#お兄ちゃん}{F#お姉ちゃん}にパイモンちゃん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650713
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401650713,
					"content": "二人とも久しぶりだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650714
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 401650714,
					"content": "へへっ、クレーはここを楽しんでるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650715
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401650715,
					"content": "うん！クレー、すっごく楽しいよ！かわいい動物さんがいっぱいいて、とーっても長い魔法の列車が走ってて、あとねあとね、うーっんと高い王様のお城も見たの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650716
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401650716,
					"content": "クレーを連れて一回りしたけど、道中でたくさんの収穫があったよ。さすがはアリスさんの魔法だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650717
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 401650717,
					"content": "ママすごいなぁ！クレーもおっきなおうちを作りたい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650718
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401650718,
					"content": "クレーの「ママ」って、もしかしてボクのお母さんの友達？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650719
					],
					"speakerTitle": "ちびドゥリン"
				},
				{
					"id": 401650719,
					"content": "うん！ママが昔よく絵本を読んでくれたよ。ちびドゥリンお兄ちゃんのママが書いたお話は、すごくおもしろかった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650720
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401650720,
					"content": "ちびドゥリン…お兄ちゃん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650721
					],
					"speakerTitle": "ちびドゥリン"
				},
				{
					"id": 401650721,
					"content": "お兄ちゃんになったね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401650722
					]
				},
				{
					"id": 401650722,
					"content": "へへ…ありがとうクレー！笠っち、クレーと遊んできてもいい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650723
					],
					"speakerTitle": "ちびドゥリン"
				},
				{
					"id": 401650723,
					"content": "…好きにしたらいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650724
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650724,
					"content": "アルベドお兄ちゃん、アルベドお兄ちゃん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650725
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401650725,
					"content": "行っておいで。あまり遠くには行かないようにね。あとで迎えに行くよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650726
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 401650726,
					"content": "うん！行こう、ちびドゥリンお兄ちゃん！フィッシュルお姉ちゃんも来る？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650727
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401650727,
					"content": "ふふん！この皇女があなたたちの招待を受けてあげる。喜びなさい！たとえあなたたちが霧の中に隠れようと、この断罪の目は威容を見逃さないわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650728
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 401650728,
					"content": "お嬢様は、みんなでかくれんぼをしようとおっしゃっています。お嬢様が鬼です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650729
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 401650729,
					"content": "わーい！かくれんぼ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650730
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401650730,
					"content": "かくれんぼ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650731
					],
					"speakerTitle": "ちびドゥリン"
				},
				{
					"id": 401650731,
					"content": "話を戻すけど笠っちさん、キミが言った預言というのは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650732
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 401650732,
					"content": "あの時、「B」が「M」にこう言ったのを聞いたんだ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650733
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650733,
					"content": "そこまで固執するなら、おまえに一つ秘密を教えてやろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650734
					],
					"speakerTitle": "魔女B"
				},
				{
					"id": 401650734,
					"content": "「R」の子は、いつの日か復活するよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650735
					],
					"speakerTitle": "魔女B"
				},
				{
					"id": 401650735,
					"content": "え？あの星見の魔女が…ドラゴンスパインのドゥリンは復活するって言ったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650736
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401650736,
					"content": "驚いた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401650737
					]
				},
				{
					"id": 401650737,
					"content": "すべて記憶の中の光景だ。間違ってても僕のせいにするなよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650738
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650738,
					"content": "なるほど。ここ最近のドラゴンスパインでの観測結果も、その預言を裏付けているよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650739
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 401650739,
					"content": "以前に比べて、ドゥリンの心臓の動きが徐々に活発になってきているんだ。非常にゆっくりとだけど、すでに傾向は現れ始めている…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650740
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 401650740,
					"content": "そんな…どうすればいいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650741
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401650741,
					"content": "様々な状況に対応するためにいくつかプランを用意しておこう。もちろん、最悪の場合も含めてね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650742
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 401650742,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650743
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650743,
					"content": "ドゥリンの過去を知っている身として、事態が悪化するのはボクも望まない。けど、何事も入念な準備が必要だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650744
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 401650744,
					"content": "もし預言通り、ドゥリンの心臓が元のように動き出したなら…ボクの望みとしては、その時復活するのは「悪龍」ではなく…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650745
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 401650745,
					"content": "ボクの言いたいことが分かるね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650746
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 401650746,
					"content": "まあ…なんとなくは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650747
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401650747,
					"content": "そのためには…笠っちさん、その時が来たら、キミとシムランカのドゥリンの力を貸してほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650748
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 401650748,
					"content": "はあ？僕が？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650749
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650749,
					"content": "キミがこのシムランカの世界でドゥリンを救ったのは、偶然ではないと思うんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650750
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 401650750,
					"content": "もし三女神の行いに意味があるのなら、ロマンチックな解釈を除いて、ある大胆な仮説を立てられる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650751
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 401650751,
					"content": "つまり——投影されたこの空の運命は、あちら側にも影響を与えるかもしれないということだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650752
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 401650752,
					"content": "ドラゴンスパインのドゥリンが復活する日が来たら、ちびドゥリン…そしてその運命と交錯したキミの助けが必要になる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650753
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 401650753,
					"content": "チッ…面倒だね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650754
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650754,
					"content": "確かに容易なことじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650755
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 401650755,
					"content": "アルベドお兄ちゃん！あそこに小さな紙のボートがあったよ！お空をふわふわ飛べるの！クレーと一緒に見に行こう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650756
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401650756,
					"content": "ああ、すぐ行くよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650757
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 401650757,
					"content": "ボクの提案について、どうかもう一度検討してほしい、笠っちさん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650758
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 401650758,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650759
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650759,
					"content": "笠っち、ただいま。ん？何の話をしてたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650760
					],
					"speakerTitle": "ちびドゥリン"
				},
				{
					"id": 401650760,
					"content": "なんでもない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650761
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650761,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650762
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401650762,
					"content": "そう？じゃあ、ボクたちも行こう。みんな新しく作ったボートのところにいるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650763
					],
					"speakerTitle": "ちびドゥリン"
				},
				{
					"id": 401650763,
					"content": "…分かった、すぐに行く。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650764,
						401650765
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650764,
					"content": "#{REALNAME[ID(1)]}…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401650766
					]
				},
				{
					"id": 401650766,
					"content": "ふん、僕が他人のしょうもないことに気を揉むようなやつに見えるかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650767
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650767,
					"content": "（シムランカのドゥリンを救った今、笠っちは現実のドゥリンにも同情するようになってるのかも…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401650768
					]
				},
				{
					"id": 401650768,
					"content": "僕の考えを勝手に想像するな。行くぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650769
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650769,
					"content": "（アルベドが言ったように、その時になったらまた考えよう…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401650770
					]
				},
				{
					"id": 401650770,
					"content": "わぁ！かわいいボート！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650771
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401650771,
					"content": "森の妖精さんと一緒に作ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650772
					],
					"speakerTitle": "ちびドゥリン"
				},
				{
					"id": 401650772,
					"content": "そういえば、砕けた海にいるやつらもだいぶ少なくなってるし、みんな無事にオルビットの街に帰れたみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650773
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401650773,
					"content": "このボートのお名前は？どこにも書いてないよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650774
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401650774,
					"content": "えっ？名前…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650775
					],
					"speakerTitle": "ちびドゥリン"
				},
				{
					"id": 401650775,
					"content": "うん！クレーが見たことあるボートには、みんな名前があったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650776
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401650776,
					"content": "願いを込めるためにね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650777
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 401650777,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650778
					],
					"speakerTitle": "ちびドゥリン"
				},
				{
					"id": 401650778,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650779
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650779,
					"content": "「ドゥリン号」にしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650780
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650780,
					"content": "えっ？ボクの名前を？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650781
					],
					"speakerTitle": "ちびドゥリン"
				},
				{
					"id": 401650781,
					"content": "おおっ！ちびドゥリンの物語がこの世界の外に漕ぎ出して、新たな一ページを迎えられるようにって意味か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650782
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401650782,
					"content": "ふむ、至高なる夜龍の尊き名を付けるなんて、あなたのセンスには脱帽するわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650783
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 401650783,
					"content": "「ドゥリン号」…へへ、じゃあそう呼ぼう！ありがとう、笠っち！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650784
					],
					"speakerTitle": "ちびドゥリン"
				},
				{
					"id": 401650784,
					"content": "あの…笠っち、ひとつお願いがあるんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650785
					],
					"speakerTitle": "ちびドゥリン"
				},
				{
					"id": 401650785,
					"content": "…言ってごらん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650786
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650786,
					"content": "前にお母さんの友達が外に出てもいいって言ってたよね？ボク…笠っちが住む世界を見てみたい、見たらすぐ帰るから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650787
					],
					"speakerTitle": "ちびドゥリン"
				},
				{
					"id": 401650787,
					"content": "…は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650788
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650788,
					"content": "ダ…ダメかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650789
					],
					"speakerTitle": "ちびドゥリン"
				},
				{
					"id": 401650789,
					"content": "いいんじゃないか？シムランカの住民は外に出ていいんだし、ちびドゥリンを連れ回したって問題ないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650790
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401650790,
					"content": "…外でも君のお守りをしろと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650791
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650791,
					"content": "じ…自分のことは自分で守るから。笠っちの言うことをちゃんと聞くし、絶対あちこち飛び回ったりしない！だから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650792
					],
					"speakerTitle": "ちびドゥリン"
				},
				{
					"id": 401650792,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650793
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650793,
					"content": "…外に行ったところで君にあれこれ指示なんてしない。来たければ勝手についてくればいいさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650794
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650794,
					"content": "うん！分かった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650795
					],
					"speakerTitle": "ちびドゥリン"
				},
				{
					"id": 401650795,
					"content": "外に出るなら「ドゥリン号」に乗っていくのはどうだい？命名後の初航海だ、新たな旅の門出に相応しいだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650796
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 401650796,
					"content": "ちびドゥリンお兄ちゃん、もう行っちゃうの？じゃあ…いつかモンドに遊びに来てね！クレーのおうちまでの道を描いてあげるから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650797
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401650797,
					"content": "友と過ごす時間は長き夜の虹のごとく刹那に消えるもの。しかし、幽夜浄土は再会の刻のために高らかに音楽を奏でるでしょう！我らは星の見守る下で再会する運命にあるのだから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650798
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 401650798,
					"content": "お嬢様は「わたくしも、あなたたちが家に来るのをいつでも大歓迎するわ」とおっしゃっています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650799
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 401650799,
					"content": "うん！こんなにたくさんの友達ができて、とっても嬉しいよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650800
					],
					"speakerTitle": "ちびドゥリン"
				},
				{
					"id": 401650800,
					"content": "まったく…いつまで話してるつもりだい？行くなら早く乗ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650801
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650801,
					"content": "旅の無事を祈るよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401650802
					]
				},
				{
					"id": 401650802,
					"content": "ありがとう、みんな！キミたちからもらった祝福はボクにとってかけがえのないもので、どんな童話よりも素敵で素晴らしかったよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650803
					],
					"speakerTitle": "ちびドゥリン"
				},
				{
					"id": 401650803,
					"content": "今度はボクが、みんなの願いを叶えてあげるから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ちびドゥリン"
				},
				{
					"id": 401650765,
					"content": "ドゥリンのことが心配？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401650766
					]
				},
				{
					"id": 401650711,
					"content": "#{M#俺}{F#私}も{M#君}{F#あなた}たちに会えて嬉しい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401650712
					]
				}
			]
		}
	]
}