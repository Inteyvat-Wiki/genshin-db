			"dialogs": [
				{
					"id": 401650301,
					"content": "ここのツリーハウスの構造…本当に変わってる。忘れないうちにメモを取らないと。帰ったら師匠に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650302
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 401650302,
					"content": "コレイ！元気にしてたか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401650303,
					"content": "うわっ！び、びっくりした…た、旅人にパイモン？お前たちも招待されて来たのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650304
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 401650304,
					"content": "…次はちゃんと招待されて来たいけどな…コレイはなにを見てたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401650305,
					"content": "えっと、ここの森の構造と住んでる動物…というより、住民を観察してまとめてたところだ。なんと、ここのみんなは折り紙でできてるんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650306
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 401650306,
					"content": "おお、さすがレンジャーだな！でもここって魔法の世界だし、参考になるかわからないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401650307,
					"content": "あれ…？あの大きな足跡の近くに前から家なんてあったっけ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401650308,
					"content": "あっ、ここに住んでるモモンガたちから聞いたんだけど、小さな龍と笠をかぶった人が建てたらしいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650309
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 401650309,
					"content": "ちびドゥリンと笠っちだ！そいつらがどこに行ったか知らないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401650310,
					"content": "話によると、家を建てた後…オルビット城のほうへ行ったって。ええと…オルビットで名前あってるよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650311
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 401650311,
					"content": "合ってるぜ。えっと…コレイ、その小さな龍のことを住民はどう思ってそうだった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401650312,
					"content": "うーん…あらためて聞かれると、確かにちょっと変な雰囲気だったかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650313
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 401650313,
					"content": "そんな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650314
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401650314,
					"content": "「以前の誤解」とか、「新しい仲間の受け入れ」とか、そんなようなことを話してた気がする…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650315
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 401650315,
					"content": "あたしはここに来て間もないから、この世界で何が起きたのかよく知らないけど、みんな新しい家を建ててくれたことに感謝してたし、歓迎会なんかもやるって言ってたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650316
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 401650316,
					"content": "ふぅ、びっくりしたぜ。その様子だと、ちょっとずつこの森に溶け込んでいってるみたいだな。少なくとも、いい一歩を踏み出せてるっぽいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650317
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401650317,
					"content": "その小さな龍に用があるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650318
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 401650318,
					"content": "おう、あいつはこの世界でできた新しい友達なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650319
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401650319,
					"content": "えっ？そうだったのか！わぁ、ますますお前たちの物語が気になってきた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650320
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 401650320,
					"content": "いや…だめだめ、それはまた今度にしよう。今は一刻も早く、この不思議な世界をたくさん見て回らなきゃ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650321
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 401650321,
					"content": "へへっ、そう焦らなくても大丈夫だぞ。ガイアみたいにのんびり楽しむのも悪くないからな。あっ、そうだ。ガイアが自分の代わりによろしく伝えてくれって言ってたぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650322
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401650322,
					"content": "ガイアさんも来てるのか？うーん…なら、あたしもあいさつに行かないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650323
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 401650323,
					"content": "あいつならきっと酔っぱらうまで酒場にいるだろうし、いくら飲んでも酔わないやつだから、いつ行っても大丈夫だと思うぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650324
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401650324,
					"content": "ははっ…お前の言う通りだな。じゃあ、ガイアさんに会いに行くのは後回しにしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650325
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 401650325,
					"content": "じゃあ、オイラたちはそろそろオルビット城に行こうぜ？ちびドゥリンたちがまだいるといいけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650326
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401650326,
					"content": "あっ、そうそう、最近スメールで面白いことがあったみたいだ。師匠も何だか忙しくしてるし、もし暇があれば見に行ってみたらどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650327
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 401650327,
					"content": "おう！じゃあ、時間を見つけてスメールに戻ってみるぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650328,
						401650329
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401650328,
					"content": "コレイもゆっくり楽しんで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401650330
					]
				},
				{
					"id": 401650330,
					"content": "ああ、またな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "コレイ"
				},
				{
					"id": 401650329,
					"content": "見聞を広める旅行のつもりで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401650330
					]
				}
			]
		},
		{
			"id": 4016504,
