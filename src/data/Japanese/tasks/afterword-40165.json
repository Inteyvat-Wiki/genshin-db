						"pointId": 910001055
					},
					{
						"sceneId": 100,
						"position": [
							365.535,
							538.104,
							211.559
						],
						"pointId": 910001056
					}
				]
			},
			"dialogs": [
				{
					"id": 401650501,
					"content": "んん？私の見間違いでしょうか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650502
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 401650502,
					"content": "信じられません…こんなこと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650503
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 401650503,
					"content": "よっ、モナ！どうしたんだ？ぶつぶつ言ってるのが遠くまで聞こえたぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401650504,
					"content": "また水占の盤に問題が起きたとかか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401650505,
					"content": "おや、あなたたちでしたか、世界を救った英雄。水占の盤は良好ですよ。問題があるのは私の目のほうかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650506
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 401650506,
					"content": "この女神像を見てください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650507
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 401650507,
					"content": "どうかしたのか？別にどっかが欠けてるようにも見えないけど？これって「預言の女神」——おまえの師匠だろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650508
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401650508,
					"content": "いいえ、信じません！あのおばばはこんな見た目じゃありませんから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650509
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 401650509,
					"content": "若い頃の姿なのかも？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401650510
					]
				},
				{
					"id": 401650510,
					"content": "若い頃…ああ…そういえば、おばばが少女の頃に書いていた日記にありました。当時、あの人は流行に敏感だったとか…確かに日記の描写と似ているかもしれません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650511
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 401650511,
					"content": "…この話、おばばに聞かれていないですよね？なんだか背後から不気味な気配がするのですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650512
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 401650512,
					"content": "本人の像の下であれこれ言うのは確かによくないかもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650513
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401650513,
					"content": "でも、モナは師匠の若い頃の姿を見たことがないのに、なんでこの像が「おばば」だってわかったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650514
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401650514,
					"content": "ここに来たときに水占の盤で占ってみたんです。星空の「倒影」が示した結果は非常に驚くべきものでした。なんと、この「シムランカ」という世界の運命は、テイワットを基にしているみたいなんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650515
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 401650515,
					"content": "現実の運命の「投影」、真の世界の「虚像」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650516
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 401650516,
					"content": "ふむ、そうですね…より分かりやすく言うなら、「創造者」は、鏡や湖に映る姿の中にこの世界を創造したと理解すればいいでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650517
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 401650517,
					"content": "なんか聞いてるだけで、すごいのが伝わってくるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650518
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401650518,
					"content": "観測を続けていくうちに、ここの術式がどんどん見覚えのあるものになっていきました。明らかにおばばの手によるものです…ですが、それらは想像以上に複雑で、今の私では解読するだけで精一杯でして。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650519
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 401650519,
					"content": "その後、ある方に話を聞いたんです。「星と軌跡を司る」だなんて、まったく隠す気ゼロですね。自分の創作にすっかり酔いしれてしまっています…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650520
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 401650520,
					"content": "これもあの日記のスタイルを彷彿させます…あ、いえ、この話はやめましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650521
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 401650521,
					"content": "そういえば、モナ、小さな龍を見なかったか？オイラと同じくらいの大きさで、ちっちゃな翼をバタバタさせてるやつなんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650522
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401650522,
					"content": "かつて災いを起こしたあの者ですね？この目で見たわけではありませんが、少し前にオルビットに現れて皆に謝罪し、これまでの罪滅ぼしとして積み木鉱石と植物油をたくさん渡したと聞きました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650523
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 401650523,
					"content": "大半は謝罪を受け入れましたが、今後の行動を見て判断する必要があると言う方もいたそうです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650524
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 401650524,
					"content": "そっか。どこに行けばあいつに会えるかわかるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650525
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401650525,
					"content": "ちょっと待ってくださいね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650526
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 401650526,
					"content": "ふむふむ、彼はいま砕けた海の辺りにいるようです。周りには他にも人がいますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650527
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 401650527,
					"content": "せっかくだし、モナも一緒に行かないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650528
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401650528,
					"content": "いえ、私は遠慮しておきます。若い頃のおばばを知れるいい機会ですし、あの人が敷いた星の軌跡をもう少し研究しておきたいので。あなたたちは楽しんできてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650529,
						401650531
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 401650529,
					"content": "じゃあ、モナも気をつけて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401650530
					]
				},
				{
					"id": 401650530,
					"content": "なぜ気をつける必要があるんです？そう言われると逆におっかなくなってきます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650533
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 401650533,
					"content": "じゃあ行くな！またな、モナ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401650531,
					"content": "モナ、占ってくれてありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401650532
					]
				},
				{
					"id": 401650532,
					"content": "気にしないでください。",
