			"dialogs": [
				{
					"id": 401650101,
					"content": "お二人ともお待たせしました、魔水です！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650102
					],
					"speakerTitle": "シトラス"
				},
				{
					"id": 401650102,
					"content": "ありがとう、美しいお嬢さん。ジン、座って一杯やらないか？お前の分も注文しておいたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650103
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401650103,
					"content": "はぁ、さすがに少し気が緩みすぎではないだろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650104
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 401650104,
					"content": "クレーのことを心配しているのか？大丈夫さ、アルベドがついているんだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650105
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401650105,
					"content": "ジン団長にガイア！なんでおまえたちがここにいるんだ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401650106,
					"content": "おや、誰が来たかと思えば、旅人にパイモンじゃないか？アリスさんの言っていた「サプライズ」とはこれのことだったんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650107
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401650107,
					"content": "二人とも元気にしていただろうか？まさか、ここで出会えるとはな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650108
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 401650108,
					"content": "ひょっとして、ここのやつらが口々に賞賛していた世界を救った勇者ってのは、お前たち二人のことだったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650109
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401650109,
					"content": "全部が全部オイラたちの手柄ってわけじゃないけどな。それにどちらかというと、オイラたちは勇者パーティの一員だったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401650110,
					"content": "ほう、それでも大したことじゃないか！やはり真に優れた騎士は、どこへ行こうと「栄誉」の名を失わないようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650111
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401650111,
					"content": "さっきアリスさんとクレーの話を…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401650112
					]
				},
				{
					"id": 401650112,
					"content": "ああ、アリスさんから招待状をもらったんだ。時間があればクレーを連れて、童話の世界で休暇を取ってみないかという提案つきでね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650113
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 401650113,
					"content": "最初は「童話の世界」っていうのが、どういう意味かピンとこなかったが、今じゃその喩えがぴったりだと思ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650114
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401650114,
					"content": "ここについた途端、クレーが興奮してあちこち走り回るものだから心配していたんだが…アルベドが「クレーの面倒はボクが見るから、キミたちは自由に過ごしていて大丈夫だ」と言ってくれてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650115
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 401650115,
					"content": "せっかくの厚意だ、無下に断るわけにもいかないだろう？だから俺はジンを連れて、この世界の酒場でゆっくりしているのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650116
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401650116,
					"content": "どうせこの機会にお酒を飲みたかっただけだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401650117,
					"content": "ハハッ、せっかくの休暇だ。しっかり楽しまないとな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650118
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401650118,
					"content": "…確かにガイアの言うことももっともだ。私もたまには肩の荷を下ろしてみるべきかもしれない。でないと、アリスさんの厚意を無駄にしてしまう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650119
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 401650119,
					"content": "あっ！そういえば…おまえ、なにを頼んだんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401650120,
					"content": "もちろん、この酒場で一番「混じりっけのない物を一杯」だ。でなきゃ、異世界の風情を感じられないだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650121
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401650121,
					"content": "ぷぷっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401650122,
					"content": "ん？パイモン、なんだその顔は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650123
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401650123,
					"content": "いやいや…なんでもないぞ。おまえのそのモットーに感心してただけだから。ほら飲めよ、グイッとな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401650124,
					"content": "ふむ？ここは慎重にいったほうが良さそうだな。どれどれ、色は悪くない。味は…ブフォ…ゴホゴホッ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650125
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401650125,
					"content": "あっはははっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401650126,
					"content": "…私はやめておこう。だが、飲まないと少しもったいないだろうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650127
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 401650127,
					"content": "くっ、パイモン、こういうことだったのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650128
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401650128,
					"content": "オ…オイラも一度引っかかったんだ！おまえだけがやられたわけじゃないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650129
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401650129,
					"content": "…そういえば、招待されたのは俺たちだけじゃないようだぜ。さっきコレイを見かけた。あっちの大きな木のほうへ行っちまって、声をかけるタイミングがなかったがな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650130
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401650130,
					"content": "ベルウインド王国のほうか？へへっ、懐かしい友達がいっぱい来てるなんて、まるでパーティーみたいだな。じゃあ、オイラたちはコレイにあいさつしに行こうぜ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650131
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401650131,
					"content": "そうか、あいつによろしく伝えておいてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650132,
						401650133
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401650132,
					"content": "分かった、任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401650134
					]
				},
				{
					"id": 401650134,
					"content": "君もよい旅を。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジン"
				},
				{
					"id": 401650133,
					"content": "二人とも、いい休暇を。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401650134
					]
				}
			]
		},
