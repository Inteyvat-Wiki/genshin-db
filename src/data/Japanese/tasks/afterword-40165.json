			"dialogs": [
				{
					"id": 401650201,
					"content": "魔水とはインクのことだったのか…なんとも変わってるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650202
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401650202,
					"content": "シトラスさん、魔水の入っていない飲み物はないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650203
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401650203,
					"content": "もちろんありますよ。何味にしますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650204
					],
					"speakerTitle": "シトラス"
				},
				{
					"id": 401650204,
					"content": "夕暮れの実…ふむ、これにするか。ジン、お前も飲まないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650205
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401650205,
					"content": "…ああ、私もそれを一杯もらおう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650206
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 401650206,
					"content": "はい、夕暮れの実味がお二つですね！すぐにご用意します！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シトラス"
				}
			]
		},
