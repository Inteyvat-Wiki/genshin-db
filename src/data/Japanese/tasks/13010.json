				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130101001,
					"content": "ふぅ…疲れたぜ。これだけ離れれば、もう大丈夫だろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130101002,
						130101004
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130101002,
					"content": "大丈夫だと思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130101003
					]
				},
				{
					"id": 130101003,
					"content": "よっしゃ！ちょっと休憩してから、またセノのところに戻ろうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130101006
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130101006,
					"content": "近くに座り、少しだけ休憩した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130101007
					]
				},
				{
					"id": 130101007,
					"content": "そろそろいい時間じゃないか？オークション会場に戻ろうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130101008
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130101008,
					"content": "セノのほうに収穫があるといいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130101004,
					"content": "もうちょっと離れよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130101005
					]
				},
				{
					"id": 130101005,
					"content": "まだ歩くのか？オイラ…もう疲れたぞ…ここで少し休憩しようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130101006
					],
					"speakerTitle": "パイモン"
				}
			]
		},
