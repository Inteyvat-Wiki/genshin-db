			},
			"dialogs": [
				{
					"id": 130100610,
					"content": "何か分かったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100611
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130100611,
					"content": "うーん…特にこれといったものはないみたいだぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100612
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130100612,
					"content": "ごく普通の缶詰知識だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100613
					]
				},
				{
					"id": 130100613,
					"content": "帰元ノ庭に関する缶詰知識は元々さほど多くなかったのかもしれない。撤退するときに全部持って行ったんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100614
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130100614,
					"content": "だが心配はいらない、もう一つ方法がある。お前らは来た道を戻り、俺はここに隠れる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100615
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130100615,
					"content": "暫くしたらまたここで合流すればいい。収穫はあるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100616
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130100616,
					"content": "だからトラッカーを捨てなかったんだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100617
					]
				},
				{
					"id": 130100617,
					"content": "慌てて撤退したからか、残っている貨物も多い。このままずっと放置するなんてことはあり得ない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100618
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130100618,
					"content": "俺たちが「離れた」のを確認したら、必ず片付けにくるやつがいるはずだ。だからトラッカーをできるだけここから離して、もうここが安全だと誤認させるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100619
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130100619,
					"content": "なるほど！オイラたちをおとりに、やつらをおびき出す作戦だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100620
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130100620,
					"content": "よし。さっそく出発するから、ここはおまえに任せたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100621
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130100621,
					"content": "安心しろ。もしやつらに来る勇気があれば、必ず引き止めておく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "セノ"
				}
			]
		},
