	"talks": [
		{
			"id": 1301002,
			"completionStepIds": [
				1301002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301002",
							"2"
						],
						"stepId": 1301002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"セノ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100201,
					"content": "なんて暑さだ…うぅ、木陰とか、涼しいところはないのか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130100202,
					"content": "少し休憩しよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100203
					]
				},
				{
					"id": 130100203,
					"content": "目標地まではまだまだある…もうちょっと辛抱してくれ。それに周りの環境からすると、ここは良い休憩場所とは言えない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100204
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130100204,
					"content": "うぅ…わかったよ。それにしても、セノは暑くないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130100205,
					"content": "暑いに決まってるだろう。まあ、もう慣れたがな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100206
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130100206,
					"content": "なにか秘訣でもあるのか？オイラ…もうダメかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130100207,
					"content": "できるだけ理性を保ったまま、気力を維持するんだ。気が緩むと、疲れを覚えやすくなってしまうからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100208
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130100208,
					"content": "自分の身体の限界を脳に判断させずに、一歩ずつ歩を進めるんだ。比較的安全な場所に辿り着いたら、また気を抜いていい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100209
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130100209,
					"content": "なるほどな！でも、安全な場所ってどこだ？ここは結構安全に思えるんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130100210,
					"content": "砂漠が続いてるだけで、近くに魔物もいないし——ってうわぁ！サソリだ！毒を持ってそうだけど、一体どこから来たんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130100211,
					"content": "気を付けろ、様子がおかしい——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "セノ"
				}
			]
		},
		{
			"id": 1301004,
			"completionStepIds": [
				1301004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301004",
							"2"
						],
						"stepId": 1301004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"セノ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100401,
					"content": "ふぅ…まさかサソリが出るなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130100402,
					"content": "普通のサソリじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100403
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130100403,
					"content": "見ろ、ハサミに番号がある。これは飼育されてる証だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100404
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130100404,
					"content": "と言うと…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100405
					]
				},
				{
					"id": 130100405,
					"content": "俺たちがオークションに行くことを望まない者がいる。連中はこいつを使って邪魔しようとしてるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100406
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130100406,
					"content": "見渡す限りの砂漠——俺たちがやられても知る者はいない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100407
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130100407,
					"content": "ええっ、危なすぎだろ！油断してなくてよかったぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130100408,
					"content": "でも、一つ気になることがある…砂漠には固定のルートがあるわけじゃないのに、やつらは俺たちが来るのをどうやって——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100409
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130100409,
					"content": "動くな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100410
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130100410,
					"content": "やっぱりか…やつらはこれをお前につけてたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100411
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130100411,
					"content": "なんだそれ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100412
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130100412,
					"content": "妙論派が作った小型トラッカーだよ。装着者のおおよその位置が分かる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100413
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130100413,
					"content": "装置の量産は許可されてないはずだが、どこで手に入れたんだ…？まさか、妙論派の学者までが片棒を担いでるのか？おかしい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100414
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130100414,
					"content": "そんなものまであるのか。でも、なんでこいつに付いてたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100415
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130100415,
					"content": "恐らく傭兵と揉めた時に付けられてたんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100416,
						130100417
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130100416,
					"content": "ごめん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100418
					]
				},
				{
					"id": 130100418,
					"content": "あの時は混沌としてたからな、無理もないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100419
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130100419,
					"content": "セノが気付いてくれてよかったな。それじゃ、さっさとそれを捨てちゃおうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100420
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130100420,
					"content": "…いや、もう少し付けたままにしておこう。後で役に立つかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100421
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130100421,
					"content": "さて、オークションに行こうか。ここで時間を食い過ぎると、また別の危険が生じるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "セノ"
				},
				{
					"id": 130100417,
					"content": "気付かなかった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100418
					]
				}
			]
		},
		{
			"id": 1301006,
			"completionStepIds": [
				1301009
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301009",
							"2"
						],
						"stepId": 1301009,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"セノ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100601,
					"content": "おかしいな、ここがオークションの場所で間違いないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100602
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130100602,
					"content": "一人もいないね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100603
					]
				},
				{
					"id": 130100603,
					"content": "な。もしかして、ちょうど休憩の時間だったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130100604,
					"content": "傭兵を倒した後、俺たちは急いでここまで駆けつけてきた。誰かから報告が行くことを恐れたからだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100605
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130100605,
					"content": "それでも逃げられてしまうとは…恐らくやつらはトラッカーから俺たちの動きを察知し、事前に撤退したんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100606
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130100606,
					"content": "それじゃ、どうすればいいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100607
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130100607,
					"content": "探す。缶詰知識をすべて持って行く余裕はなかったはずだ。残った中から手がかりが見つかるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100608
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130100608,
					"content": "それじゃ、気合いを入れて探そうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 1301007,
			"completionStepIds": [
				1301011
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301011",
							"2"
						],
						"stepId": 1301011,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"セノ",
					"バーハリ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100701,
					"content": "わぁ！本当に現れたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100702
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130100702,
					"content": "おまえが黒幕なのか？知ってることを吐くんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100703,
						130100704
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130100703,
					"content": "この人何か知ってるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100705
					]
				},
				{
					"id": 130100705,
					"content": "さっき現れた時、俺は先手を打たず、しばらく観察していた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100706
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130100706,
					"content": "こいつは黒幕じゃないが、ある程度重要な商人のはずだ。そうだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100707
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130100707,
					"content": "さすがはセノ、察しがいいな…はぁ、君がいると分かっていれば、目先の利益は貪らなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100708
					],
					"speakerTitle": "バーハリ"
				},
				{
					"id": 130100708,
					"content": "利益をむさぼる？どういう意味だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100709
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130100709,
					"content": "君たちが来ると知って、各地の缶詰知識商人はすぐ逃げ出した。すべての貨物を持っていく余裕はなかったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100710
					],
					"speakerTitle": "バーハリ"
				},
				{
					"id": 130100710,
					"content": "それらの缶詰知識は元より主なきもの——つまり、誰よりも早く持って帰れば、大儲けできる。まあ、今さら言っても無駄だがな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100711
					],
					"speakerTitle": "バーハリ"
				},
				{
					"id": 130100711,
					"content": "お前は缶詰知識の製作販売をしている黒幕を知ってるな。俺の手を借りるか、自分で吐くか、決めてもらおう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100712
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130100712,
					"content": "じ、自分で言うよ。でもその前に、場所を変えてくれないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100713
					],
					"speakerTitle": "バーハリ"
				},
				{
					"id": 130100713,
					"content": "ここに残って、君たちと接触しているところを誰かに見られたら、俺だけでなく身内を危険に晒すことになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100714
					],
					"speakerTitle": "バーハリ"
				},
				{
					"id": 130100714,
					"content": "どこならいい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100715
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130100715,
					"content": "アアル村に俺の家がある。そこなら安全だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100716
					],
					"speakerTitle": "バーハリ"
				},
				{
					"id": 130100716,
					"content": "いいだろう。旅人、もうトラッカーを外しても大丈夫だ。では、行こうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "セノ"
				},
				{
					"id": 130100704,
					"content": "この人の「重さ」で足りる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100705
					]
				}
			]
		},
		{
			"id": 1301008,
			"completionStepIds": [
				1301008
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301008",
							"2"
						],
						"stepId": 1301008,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"シミン",
					"バーハリ",
					"セノ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100801,
					"content": "パパ！お帰りなさい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100802
					],
					"speakerTitle": "シミン"
				},
				{
					"id": 130100802,
					"content": "あっ、お客さんなの？こんにちは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100803
					],
					"speakerTitle": "シミン"
				},
				{
					"id": 130100803,
					"content": "この子は俺の娘で、シミンと言うんだ。少々人見知りでね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100804
					],
					"speakerTitle": "バーハリ"
				},
				{
					"id": 130100804,
					"content": "シミン、パパはお客さんたちと話しがあるんだ。いい子だから自分で遊んでいなさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100805
					],
					"speakerTitle": "バーハリ"
				},
				{
					"id": 130100805,
					"content": "う…わかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100806
					],
					"speakerTitle": "シミン"
				},
				{
					"id": 130100806,
					"content": "さて、この業界でセノの名を知らない者はいない。で、お二人は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100807
					],
					"speakerTitle": "バーハリ"
				},
				{
					"id": 130100807,
					"content": "オイラはパイモン、こいつは旅人だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100808
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130100808,
					"content": "正直、単独行動ばかりしているセノにも仲間がいるなんて、思ってもみなかったよ。だから、トラッカーが離れたのを見て、セノが何も手に入れず帰ったと確信したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100809
					],
					"speakerTitle": "バーハリ"
				},
				{
					"id": 130100809,
					"content": "だが、たとえ囚われの身でも、俺は君たちを説得したい——調査はここまでだ、これ以上深掘りしないほうがいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100810
					],
					"speakerTitle": "バーハリ"
				},
				{
					"id": 130100810,
					"content": "なぜだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100811
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130100811,
					"content": "製作、販売、利益の割り振り…各作業には数十人から百人単位の者が関わっている。みんな高い利益を得るために集まってきたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100812
					],
					"speakerTitle": "バーハリ"
				},
				{
					"id": 130100812,
					"content": "この苦労して掴んだサプライチェーンを維持するために、誰もが全力を尽くすだろう。いくら君でも、必ず壁にぶつかる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100813
					],
					"speakerTitle": "バーハリ"
				},
				{
					"id": 130100813,
					"content": "それに、もし成功したとしても、君に感謝する人は誰一人いない。君自身も悲しむことになるだろう——何のためにそこまで一生懸命やったのかと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100814
					],
					"speakerTitle": "バーハリ"
				},
				{
					"id": 130100814,
					"content": "それについて文句はない。誰しも自分のこだわりがあるものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100815
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130100815,
					"content": "はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100816
					],
					"speakerTitle": "バーハリ"
				},
				{
					"id": 130100816,
					"content": "パパ…これ、お茶。お客さんのも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100817
					],
					"speakerTitle": "シミン"
				},
				{
					"id": 130100817,
					"content": "ああ、お客さんにお茶を出すのを忘れてたよ。ありがとうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100818
					],
					"speakerTitle": "バーハリ"
				},
				{
					"id": 130100818,
					"content": "大丈夫…その…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100819
					],
					"speakerTitle": "シミン"
				},
				{
					"id": 130100819,
					"content": "うちのお茶は苦いでしょ。だから、パパからもらったキャンディを入れたの。少しは飲みやすくなるかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100820
					],
					"speakerTitle": "シミン"
				},
				{
					"id": 130100820,
					"content": "本当にいい子だ。キャンディはまだあるかい？ないならまた今度買ってあげよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100821
					],
					"speakerTitle": "バーハリ"
				},
				{
					"id": 130100821,
					"content": "ありがと、パパ…それじゃ、休んでくるね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100822
					],
					"speakerTitle": "シミン"
				},
				{
					"id": 130100822,
					"content": "関わる人は高い利益を得る、そう言ったな？だが…とてもそうは見えない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100823
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130100823,
					"content": "…実は、個人的なお願いがあって、それを君たちに相談したかったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100824
					],
					"speakerTitle": "バーハリ"
				},
				{
					"id": 130100824,
					"content": "娘は生まれた時から難病に悩まされてきた。心臓や肺が普通の子供より弱くてね、ちょっと激しい運動をしただけで意識を失い、命に危険が及ぶんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100825
					],
					"speakerTitle": "バーハリ"
				},
				{
					"id": 130100825,
					"content": "だからあの子には、小さな頃から遊び相手がいなかった。一日中部屋に閉じこもって…かかり続ける薬代の負担もなかなかのものさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100826
					],
					"speakerTitle": "バーハリ"
				},
				{
					"id": 130100826,
					"content": "俺は元々はただの一般商人だったんだ。朝早くから夜遅くまであちこちを走り回ったが、稼いだ金では全然足りなかった。日に日に弱っていくあの子をただ見ていることしかできなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100827
					],
					"speakerTitle": "バーハリ"
				},
				{
					"id": 130100827,
					"content": "だがある日、ある人が金儲けの道を示してくれたんだ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100828
					],
					"speakerTitle": "バーハリ"
				},
				{
					"id": 130100828,
					"content": "それが缶詰知識の商売か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100829
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130100829,
					"content": "そうだ。おかげで俺は大金を手に入れ、やっとあの子の治療をちゃんと始めることができたんだ。元気になっていく姿を見て、俺は誰よりも幸せだと思った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100830
					],
					"speakerTitle": "バーハリ"
				},
				{
					"id": 130100830,
					"content": "俺のような者は他にも沢山いる。缶詰知識の密輸は君たちにとっては許せないことかもしれないが、俺たちにとっては生きるための手段なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100831
					],
					"speakerTitle": "バーハリ"
				},
				{
					"id": 130100831,
					"content": "こんな話をしたのは、ただこれをお願いしたかったからだ——調査をやめてくれ、セノ様。どうか俺たちに生きる道を残してくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100832
					],
					"speakerTitle": "バーハリ"
				},
				{
					"id": 130100832,
					"content": "そんな…つまり、オイラたちが缶詰知識の販売を禁止したら、あの女の子は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100833
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130100833,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100834
					]
				},
				{
					"id": 130100834,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100835
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130100835,
					"content": "それでも俺は、真相を突き止めなきゃならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100836
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130100836,
					"content": "あの子の病気を診てくれる人を探すことはできるが、缶詰知識の密輸に目を瞑ることは決してできない。それとこれとは話が別だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100837
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130100837,
					"content": "…そう言うだろうと思ってた。だが、君の言葉を貰っただけでもう十分だ。どうしても調べたいのなら、家の奥を探してくれていい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100838
					],
					"speakerTitle": "バーハリ"
				},
				{
					"id": 130100838,
					"content": "つい最近仕入れた貨物が置いてある。それを見れば分かるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100839
					],
					"speakerTitle": "バーハリ"
				},
				{
					"id": 130100839,
					"content": "セノと一緒に家の奥の方まで来た…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130100840
					]
				},
				{
					"id": 130100840,
					"content": "うわぁ、こんなに沢山あるのかよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100841
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130100841,
					"content": "これだけの箱が整然と並んでいるとはな。しかもたった一人の商人の拠点に過ぎないのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100842
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130100842,
					"content": "この数、小さな工房じゃ到底生産できない。まさか、本当に教令院が…？いや、これほど大量の貨物が市場に流されているのに、審査しないはずがない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100843
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130100843,
					"content": "なあ！ここら辺の缶詰知識、なんだか違うぞ。もしかして、これが帰元ノ庭を記録した缶詰知識なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100844
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130100844,
					"content": "ああ、恐らくそうだ。待て、これは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100845,
						130100846
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130100845,
					"content": "見たことのない標記だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100847
					]
				},
				{
					"id": 130100847,
					"content": "これはマハマトラの検閲用の印章だ。この印があれば、貨物が検査を通過したという証になる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100848
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130100848,
					"content": "トラッカーを見つけた時、教令院の誰かが関わっているのではと疑ったが、あれだけの数の缶詰知識を教令院から送り出す方法が分からなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100849
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130100849,
					"content": "今ようやくはっきりしたよ。この印章がある貨物は、二次審査を通さずとも、教令院の出入りが自由になる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100850
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130100850,
					"content": "ふん、だから深掘りさせたくなかったんだな…信じられない、規則を破ったのは、マハマトラ自身とはな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100851
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130100851,
					"content": "まだ誤解かも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100852
					]
				},
				{
					"id": 130100852,
					"content": "なあ、一つ頼んでいいか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100853
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130100853,
					"content": "これらの缶詰知識は教令院から出たものだ。帰元ノ庭に関する知識は教令院に封印されている研究資料を参考にしたのかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100854
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130100854,
					"content": "資料室に行って記録を確認すれば、黒幕が分かるはずなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100855
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130100855,
					"content": "だが、俺の今の身分では、気軽に教令院へは行けない。警戒させるだけだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100856
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130100856,
					"content": "この件、お前に調査を頼めないか？ナビルに手紙を書いて、資料室まで案内させる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100857
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130100857,
					"content": "おう、オイラたちに任せろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100858
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130100858,
					"content": "俺はこの間を利用して、やりたいことがある。黒幕の手がかりは教令院を指しているが、明らかに教令院以外の勢力が関わってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100859
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130100859,
					"content": "バーハリから、他の商人の情報を手に入れられるだろう。俺はここに残って事前準備をするから、何か見つけたら、いつでもここに帰ってきてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "セノ"
				},
				{
					"id": 130100846,
					"content": "セノは知ってるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100847
					]
				}
			]
		},
		{
			"id": 1301010,
			"completionStepIds": [
				1301010
			],
