					"content": "何はともあれ、食料をありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621002
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710621002,
					"content": "ここを離れるために力を尽くすよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アントン"
				}
