						710620121
					]
				},
				{
					"id": 710620121,
					"content": "物資、武器、情報、モラ。俺たちはすべてを持っている。助けてくれるなら、報酬としてあげてもいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620122
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710620122,
					"content": "ハハッ、俺たちの乞食隊長様が、自ら屈辱的な役割を引き受けたようだ…なんてありがてぇんだ、これで俺たちの面目も保たれたってもんだぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620123
					],
					"speakerTitle": "ティモール"
				},
				{
					"id": 710620123,
					"content": "皮肉もそこまでにしておけよ。そんなことを言っても、腹は満たせないんだしさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620124
					],
					"speakerTitle": "ダニーラ"
				},
				{
					"id": 710620124,
					"content": "「我らの同志となり、軍靴で万雷の如く大地を揺るがすのだ。共に白夜極星へ向かう者を、我らが見捨てることは絶対にない…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620125
					],
					"speakerTitle": "ティモール"
				},
				{
					"id": 710620125,
					"content": "誰かこいつを黙らせろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620126
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710620126,
					"content": "うぅ…悪いやつらだけど、なんだかかわいそうだな。お腹も空いてるみたいだし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710620127,
					"content": "恥ずかしながら…見ての通り、俺たちは戦闘に臨む力が残ってない。ただ食料が欲しいだけなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アントン"
				}
			]
		},
