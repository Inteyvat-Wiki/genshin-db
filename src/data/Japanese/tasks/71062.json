			},
			"dialogs": [
				{
					"id": 710620137,
					"content": "まずは目的を教えて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620140
					]
				},
				{
					"id": 710620140,
					"content": "お前たちがどのような疑惑を抱こうと…俺たちに課せられた任務は、層岩巨淵の災いの根源に関することのみ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620141
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710620141,
					"content": "災いって…層岩巨淵には別に何も起きてないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620142
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710620142,
					"content": "五百年前の災いは、戦争の序奏に過ぎなかった。漆黒なる強敵に抗う戦いは今も続き、その戦場の一つは俺たちの足元にある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620143
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710620143,
					"content": "あーあ、俺たちの曹長さん、腹が減りすぎてホラを吹き始めたぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620144
					],
					"speakerTitle": "ダニーラ"
				},
				{
					"id": 710620144,
					"content": "ホラ吹きはいつものことだけど…虚言はこれが初めてだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620145
					],
					"speakerTitle": "ティモール"
				},
				{
					"id": 710620145,
					"content": "まあまあ…アントハーが言ったことの道理は間違ってはいない。簡単に言えば…お前たち璃月人は、我々の敵ではないということだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620146
					],
					"speakerTitle": "ラドミール"
				},
				{
					"id": 710620146,
					"content": "少なくとも、俺たち第九中隊の此度の行動における敵じゃない…まあ、散り散りになった他の仲間たちが、同じことを考えてるかは知らんがな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620147
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710620147,
					"content": "人道にのっとって、今回だけ助けてあげる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620148
					]
				},
				{
					"id": 710620148,
					"content": "ありがとう…心から感謝する。この恩は忘れない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アントン"
				}
			]
		},
