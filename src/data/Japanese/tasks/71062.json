					"アントン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620128,
					"content": "それで？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620131
					]
				},
				{
					"id": 710620131,
					"content": "事が終わったら、ここを撤退すると俺が保証する。この…第九特殊中隊の名誉にかけて、そしてスネージナヤの国土を守った先祖の名にかけて誓おう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620132
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710620132,
					"content": "はぁ…かわいそうに、あんなになるまで腹を空かせるなんて…哀れだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620133
					],
					"speakerTitle": "ティモール"
				},
				{
					"id": 710620133,
					"content": "お前も似たようなものだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620134
					],
					"speakerTitle": "ラドミール"
				},
				{
					"id": 710620134,
					"content": "来たときは六十四人いたんだぞ、六十四人だ！それが今は、腹を空かせた四人しか残ってない。オレたちに何ができる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620135
					],
					"speakerTitle": "ダニーラ"
				},
				{
					"id": 710620135,
					"content": "わぁ…いったいどうやったらそんな惨めな状態になるんだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620136
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710620136,
					"content": "それはまた別の話だ…食料がなければ、第九中隊最後の隊員たちも、無事では済まなかろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アントン"
				}
			]
		},
