			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アントン",
					"ラドミール",
					"ダニーラ",
					"ティモール"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710621101,
					"content": "帰ってきたか、どうだ、何か新しい情報はあったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621102
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710621102,
					"content": "補給拠点はすでに放棄されてた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621103
					]
				},
				{
					"id": 710621103,
					"content": "そうか…じゃあ、何か探し出せたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621104
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710621104,
					"content": "璃月港は二度とファデュイを迎え入れない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621105
					]
				},
				{
					"id": 710621105,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621106
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710621106,
					"content": "それ以外に、情報は…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621107
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710621107,
					"content": "うーん…オイラたち、手紙を一通見つけたぜ。おまえ宛てのものみたいだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710621108,
					"content": "これ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621109
					]
				},
				{
					"id": 710621109,
					"content": "ファデュイたちは手紙を読んだ…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710621110
					]
				},
				{
					"id": 710621110,
					"content": "ああ、彦博だ。そうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621111
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710621111,
					"content": "どうした？千岩軍が撤退したのか？私にも見せてくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621112
					],
					"speakerTitle": "ラドミール"
				},
				{
					"id": 710621112,
					"content": "はぁ、どうしたってんだ、あいつらは…俺たちはあいつらのために戦ってるんだぞ！盟友のはずだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621113
					],
					"speakerTitle": "ダニーラ"
				},
				{
					"id": 710621113,
					"content": "今はもう「盟友」などではない！私たちは断交したんだ…正確に言えば、「ファデュイ」である私たちは、璃月と断交した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621131
					],
					"speakerTitle": "ラドミール"
				},
				{
					"id": 710621131,
					"content": "これは裏切りだ！俺たち、璃月人に裏切られたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621132
					],
					"speakerTitle": "ティモール"
				},
				{
					"id": 710621132,
					"content": "もしかしたら、璃月人からしたら逆かもしれないぞ。「ファデュイ」である我々が、あいつらを裏切った、と…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621114
					],
					"speakerTitle": "ラドミール"
				},
				{
					"id": 710621114,
					"content": "冗談じゃない…俺たちは璃月人を守りに来たんだぞ！大尉が出発前に言ったことを覚えてるか？此度の遠征は、陰謀や策略とは無関係だって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621115
					],
					"speakerTitle": "ダニーラ"
				},
				{
					"id": 710621115,
					"content": "だが実際のところ、俺たちは陰謀と策略にはまっちまった…これは俺たちがどうこう出来るような問題じゃないぜ、ダニーラ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621116
					],
					"speakerTitle": "ティモール"
				},
				{
					"id": 710621116,
					"content": "チッ、状況は理解した。ふぅ…決めた、ここを撤退しよう。できるだけ早くだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621117
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710621117,
					"content": "問題ないさ、責任は俺がとる。もし俺たちの中に脱走兵がいたとして、第九中隊に恥をかかせるようなことがあったとしても…その脱走兵は、俺一人だけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621118
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710621118,
					"content": "だがダニーラの言う通り、私たちは璃月人を黒災から守るために来たんだ。このまま何もせず帰るわけにはいかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621119
					],
					"speakerTitle": "ラドミール"
				},
				{
					"id": 710621119,
					"content": "今はプライドを語ってる場合じゃないだろ、ミルカ。まだ分からないのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621120
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710621120,
					"content": "璃月人には俺たちの保護なんていらないんだよ。俺たちは璃月人には歓迎されない！それどころか、あいつらは俺たちの戦友を討ちに来てる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621121,
						710621122
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710621121,
					"content": "ファデュイが璃月の信頼を裏切ったから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621123
					]
				},
				{
					"id": 710621123,
					"content": "撤退の準備をしよう。音を立てず、千岩軍に見つからないように離れるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621124
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710621124,
					"content": "大尉は…もう家に帰らない覚悟で来いと仰っていた。私たちは、少なくとも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621125
					],
					"speakerTitle": "ラドミール"
				},
				{
					"id": 710621125,
					"content": "だが大尉はこうも言っていた。みなの犠牲を、決して無駄にはしないと！そして俺に、中隊をこのまま全滅させるなとも言っていた！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621126
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710621126,
					"content": "俺たちが生きている限り、第九中隊の番号は存在し続ける。分かったか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621127
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710621127,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621128
					],
					"speakerTitle": "ラドミール"
				},
				{
					"id": 710621128,
					"content": "分かった、隊長。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621129
					],
					"speakerTitle": "ラドミール"
				},
				{
					"id": 710621129,
					"content": "ああ、他に質問のあるやつはいるか？これ以上、反対意見を聞くつもりはない。解散！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621130
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710621130,
					"content": "#何はともあれ、{NICKNAME}、手助けに感謝する。モラと物資を受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アントン"
				},
				{
					"id": 710621122,
					"content": "自分たちのこれからを考えた方がいいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621123
					]
				}
			]
		},
