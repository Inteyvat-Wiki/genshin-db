			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パイモン",
					"アントン",
					"ダニーラ",
					"ティモール",
					"ラドミール"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620701,
					"content": "こいつら、めちゃくちゃ弱いぞ…楽勝だったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620702
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710620702,
					"content": "やめてくれ！もうやめてくれ！ただ食料を少し分けてほしいだけなんだ、なんでも言う通りにするから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620703
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710620703,
					"content": "ふんっ…どうやら本当に腹が減ってしょうがないみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620704,
						710620705
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710620704,
					"content": "まずは目的を教えて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620706
					]
				},
				{
					"id": 710620706,
					"content": "お前たちがどんな疑惑を抱こうと…俺たちに課せられた任務は、層岩巨淵の災いの根源に関することのみ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620707
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710620707,
					"content": "災いって…層岩巨淵には別に何も起きてないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620708
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710620708,
					"content": "五百年前の災いは、戦争の前奏に過ぎなかった。漆黒なる強敵に抗う戦いにおいて、その戦場の一つが俺たちの足元にある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620709
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710620709,
					"content": "あーあ、俺たちの曹長さん、腹が減りすぎてホラを吹き始めたぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620710
					],
					"speakerTitle": "ダニーラ"
				},
				{
					"id": 710620710,
					"content": "ホラ吹きはいつものことだけど…虚言はこれが初めてだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620711
					],
					"speakerTitle": "ティモール"
				},
				{
					"id": 710620711,
					"content": "まあまあ…アントハーが言ったことの道理は間違ってはいない。お前たち璃月人は、我々の敵ではないということだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620712
					],
					"speakerTitle": "ラドミール"
				},
				{
					"id": 710620712,
					"content": "少なくとも、この部隊の敵じゃない…まあ、散り散りになった他の仲間たちが、同じことを考えてるかは知らんがな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620713
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710620713,
					"content": "分かった、今回だけ助けてあげる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 710620705,
					"content": "どうやって信用しろと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620706
					]
				}
			]
		},
		{
			"id": 7106209,
			"completionStepIds": [
				7106205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106205",
							"2"
						],
						"stepId": 7106205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アントン",
					"ダニーラ",
					"ティモール",
					"ラドミール",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620901,
					"content": "はぁ…悪いな。俺たちの指揮系統に、些細な…障害が生じてるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620902
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710620902,
					"content": "「些細な」！「障害」だって！？オレたちが今やってることは、仲間同士で傷つけ合うのと同じなんだぞ！部外者が仲間を倒すのを、こうして見てることしかできない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620903
					],
					"speakerTitle": "ダニーラ"
				},
				{
					"id": 710620903,
					"content": "じゃあ、どうしろってんだ？俺たちの食料までやりゃあ気が済むのか？そういう言葉は、まず自分のことを解決してから言うんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620904
					],
					"speakerTitle": "ティモール"
				},
				{
					"id": 710620904,
					"content": "アントハー、もう当たり障りのないことを言うのはよせ…指揮系統が破壊された今、我々はもう終わりなんだ。尉官以上の軍官はみな、犠牲になったか失踪したか…今はもう撤退するしかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620905
					],
					"speakerTitle": "ラドミール"
				},
				{
					"id": 710620905,
					"content": "だが、まだ撤退を拒む者が多くいる…みんな長官の遺物と共に、最後まで戦い抜くと決めてるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620906
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710620906,
					"content": "最後まで戦うんじゃなく、最期がきて餓死する、だろ…協力協定で、上から食料と命令が届くはずなのに、もう長い間音沙汰なしじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620907
					],
					"speakerTitle": "ダニーラ"
				},
				{
					"id": 710620907,
					"content": "俺たちがファデュイと執行官様に忠実なのは間違っちゃいない。だが俺たちゃ何も馬鹿じゃない…こんな状況になった今、撤退が一番の選択だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620908
					],
					"speakerTitle": "ティモール"
				},
				{
					"id": 710620908,
					"content": "つまり、どうしたいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620909
					]
				},
				{
					"id": 710620909,
					"content": "…このことが、お前たちと無関係なのは分かってる。もし立ち去りたいのなら、止めはしない。だが俺たちは今、窮地に立たされているんだ。助けてほしい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620910,
						710620912
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710620910,
					"content": "少し考えさせて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620911
					]
				},
				{
					"id": 710620911,
					"content": "分かった…道中、安全には気を付けろよ。この辺りで散り散りになった仲間たちは、俺たちのように友好的じゃないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620913
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710620913,
					"content": "お前に言うべきことではないかも知れないが…この近くに補給拠点がある。俺たちのために物資を運び、命令の伝達を担う場所だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620914
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710620914,
					"content": "以前、何人かの戦友をそこへ回して、食料を得ようとしたんだが、ずっと帰ってきていない…これ以上のリスクは負えない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620915
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710620915,
					"content": "それに、補給拠点のほうも長いこと人がいない状態だろう…だから、俺たちの代わりに彼らの状況を確かめてきてくれないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620916,
						710620917
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710620916,
					"content": "少し考えさせて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620918
					]
				},
				{
					"id": 710620918,
					"content": "こんなことをお前に頼むなんて、本当に悪いな。だが俺たちには地上の情報が必要だ…じゃないと行動できない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620919
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710620919,
					"content": "もう！そんな難しいこと言うなよ！とにかく、気にかけておくぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710620917,
					"content": "手伝うよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620918
					]
				},
				{
					"id": 710620912,
					"content": "何を手伝ってほしいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620913
					]
				}
			]
		},
		{
			"id": 7106210,
