			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"アントン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620101,
					"content": "ふぅ…道を急いでいたのならすまない。俺はアントン·メルニコフ曹長、第九中隊の…代理隊長だ。アントンと呼んでくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620102
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710620102,
					"content": "こいつらはダニーラ、ティモール、ラドミール、それから…ロマンスキー…彼は今ここではなく、衛生拠点にいる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620103
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710620103,
					"content": "ロマンスキーも、衛生拠点もなくなった。彼は…今朝死んだよ…アントハー。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620104
					],
					"speakerTitle": "ダニーラ"
				},
				{
					"id": 710620104,
					"content": "おい、ダニーラ…何度言ったら分かる。俺のことはアントン曹長と呼べ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620105
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710620105,
					"content": "はっ！隊長！曹長！…ったくアントハー、お前ってやつは…大尉が失踪してから、随分調子づいてきたようだな！ハハハッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620106
					],
					"speakerTitle": "ティモール"
				},
				{
					"id": 710620106,
					"content": "まあまあ、ティモール…お前はきっと腹が減りすぎて頭がおかしくなっているんだ、少しは体力を温存しておけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620107
					],
					"speakerTitle": "ラドミール"
				},
				{
					"id": 710620107,
					"content": "ああ、「代理隊長」アントハー。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620149
					],
					"speakerTitle": "ダニーラ"
				},
				{
					"id": 710620149,
					"content": "「代理隊長」！「代理隊長」！俺たちいつまでこの、ニワトリの羽を令状のように振り回す、見かけ倒しの無能について行けばいいんでしょーか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620150
					],
					"speakerTitle": "ティモール"
				},
				{
					"id": 710620150,
					"content": "おい、ティモール、腹が空き過ぎてとうとう頭がイカレたか。拳でも食らって少し頭を冷やすがいい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620151
					],
					"speakerTitle": "ラドミール"
				},
				{
					"id": 710620151,
					"content": "おっ、上等だぜ！お前には足を食らわせてやんよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620152
					],
					"speakerTitle": "ティモール"
				},
				{
					"id": 710620152,
					"content": "そりゃいいな。理性と忍耐までも胃の中に飲み込んで、すべてを消化すればいい…なんて素晴らしいんだ。これだけ精神をすり減らせば、残りのエネルギーもあと少しでなくなるだろうさ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620108
					],
					"speakerTitle": "ダニーラ"
				},
				{
					"id": 710620108,
					"content": "コホンッ…！静粛に！ケンカがしたいんなら、下に行ってやれ！黒泥から出てくるものとケンカしろ！腹を空かせて行くがいい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620109
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710620109,
					"content": "俺たちが生き残ってここを離れるためには、一致団結が必要だ！もうこれ以上、俺に言わせるな、分かったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620110
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710620110,
					"content": "さあスローガンを言うぞ！一、二、三、我らの他に誰がいる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620111
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710620111,
					"content": "我らの他に誰がいる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620112
					],
					"speakerTitle": "ダニーラ"
				},
				{
					"id": 710620112,
					"content": "我らの他に誰がいる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620113
					],
					"speakerTitle": "ラドミール"
				},
				{
					"id": 710620113,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620153
					],
					"speakerTitle": "ティモール"
				},
				{
					"id": 710620153,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620114
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710620114,
					"content": "コホンッ、ハハハッ…見ての通り、俺たちは今…あまり戦闘できる状態ではない。何せ、ちょっとした挫折に遭遇してしまってな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620115
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710620115,
					"content": "フン…「ちょっとした挫折」！大尉の真似だけは一丁前だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620116
					],
					"speakerTitle": "ラドミール"
				},
				{
					"id": 710620116,
					"content": "大尉がいない今、俺が隊長だ！文句を言うな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620117
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710620117,
					"content": "悪いな…わが友よ。今、切実に君の助けが必要だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アントン"
				}
			]
		},
