			"dialogs": [
				{
					"id": 401460801,
					"content": "錬金ショップの規模はどんどん大きくなっていき——しばらく経った頃、新しい商売のチャンスが訪れた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401460802
					]
				},
				{
					"id": 401460802,
					"content": "他の国から商人が来たみたいだ。見に行ってみようぜ。",
					"roleType": "TALK_ROLE_NPC",
