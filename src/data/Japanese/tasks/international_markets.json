						"position": [
							2506.894,
							205.371,
							-1146.261
						],
						"pointId": 300300750
					}
				]
			},
			"dialogs": [
				{
					"id": 401460101,
					"content": "こんにちは、スメールから来た旅商人のアテフェだよ。お会いできてすっごく光栄！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460102
					],
					"speakerTitle": "アテフェ"
				},
				{
					"id": 401460102,
					"content": "えっ、そんなに遠くから来てくれたのか！いつの間にか、オイラたちのお店ってこんなに有名になってたんだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460103,
						401460105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401460103,
					"content": "パイモンのおかげだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460104
					]
				},
				{
					"id": 401460104,
					"content": "えっへん、今おまえの目の前にいるのは、期待の新星、トップセールスのパイモンだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401460106,
					"content": "あははっ、確かに最近、君たちが錬金薬を売ってるって話は、情報通の商人たちの間じゃ噂になってるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460107
					],
					"speakerTitle": "アテフェ"
				},
				{
					"id": 401460107,
					"content": "こういう珍しい商品に関しては、ほとんどの人がリスクを冒したくないって考える。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460108
					],
					"speakerTitle": "アテフェ"
				},
				{
					"id": 401460108,
					"content": "でも私からすれば…大儲けしたいなら、チャンスを逃すわけにはいかない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460109
					],
					"speakerTitle": "アテフェ"
				},
				{
					"id": 401460109,
					"content": "今、一般人はまだ錬金薬のことをそんなに知らないけど、営業手段に合わせて販路を広めれば、どんどんモラが入ってくることは間違いないと思うよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460110
					],
					"speakerTitle": "アテフェ"
				},
				{
					"id": 401460110,
					"content": "一気に名をあげれば、十倍の値段でも売れるかもしれない…へへっ、今回の商売が成功したら、今年いっぱいは休めるだろうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460111
					],
					"speakerTitle": "アテフェ"
				},
				{
					"id": 401460111,
					"content": "十倍！本気で言ってるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401460112,
					"content": "ははっ、誰かが喜んで買ってくれる限りは、どんなに高くても問題ない。それが「互いの合意の上」ってやつだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460113
					],
					"speakerTitle": "アテフェ"
				},
				{
					"id": 401460113,
					"content": "その発言…モラのことしか頭にないやつのことを思い出しちゃったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401460114,
					"content": "えっと、スメールから来たって言ってたよな。まさかドリーと知り合いとかじゃないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401460115,
					"content": "ドリーっていうと…もしかしてドリー·サングマハベイ様のこと？あの方と知り合いなの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460116,
						401460117
					],
					"speakerTitle": "アテフェ"
				},
				{
					"id": 401460116,
					"content": "#彼女は{M#俺}{F#私}の友達。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460118
					]
				},
				{
					"id": 401460118,
					"content": "すごい！私、サングマハベイ様のファンなの。あの方のビジネスセンスとモラに対する執着は、ずっと私の励みになってるんだ…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460119
					],
					"speakerTitle": "アテフェ"
				},
				{
					"id": 401460119,
					"content": "昔、アルカサルザライパレスを訪れる機会に恵まれたことがあるけど…本当に立派で美しい邸宅だったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460120
					],
					"speakerTitle": "アテフェ"
				},
				{
					"id": 401460120,
					"content": "いつか私もあの方みたいに、数えきれないほどのモラを手に入れたい…へへへ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460121
					],
					"speakerTitle": "アテフェ"
				},
				{
					"id": 401460121,
					"content": "うぅ…完全に夢の世界に浸っちゃってるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460122,
						401460124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401460122,
					"content": "成功を祈るよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460123
					]
				},
				{
					"id": 401460123,
					"content": "ありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460126
					],
					"speakerTitle": "アテフェ"
				},
				{
					"id": 401460126,
					"content": "それじゃ、大儲けの方法について話そうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460127
					],
					"speakerTitle": "アテフェ"
				},
				{
					"id": 401460127,
					"content": "シンプルな話だよ。定期的に仕入れに来るから、必要なポーションを作ってくれれば、私がそれを他の場所に売ってきてあげる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460128
					],
					"speakerTitle": "アテフェ"
				},
				{
					"id": 401460128,
					"content": "協力してくれるなら、販売するものについて詳しく話し合おう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460129,
						401460131
					],
					"speakerTitle": "アテフェ"
				},
				{
					"id": 401460129,
					"content": "リクエストを確認する。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460130
					]
				},
				{
					"id": 401460130,
					"content": "私の勘だと…今回必要なのはこういうポーションだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アテフェ"
				},
				{
					"id": 401460131,
					"content": "また今度にしよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460132
					]
				},
				{
					"id": 401460132,
					"content": "お金儲けのチャンスは、掴み取らないと一瞬で消えちゃうよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アテフェ"
				},
				{
					"id": 401460124,
					"content": "まずは本題に戻ろう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460125
					]
				},
				{
					"id": 401460125,
					"content": "コホンッ、話が逸れちゃったね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460126
					],
					"speakerTitle": "アテフェ"
				},
				{
					"id": 401460117,
					"content": "やり取りをしたことがある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460118
					]
				},
				{
					"id": 401460105,
					"content": "これまでの努力が報われた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460106
					]
				}
			]
		},
