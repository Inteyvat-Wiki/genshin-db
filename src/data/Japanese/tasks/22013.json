			},
			"dialogs": [
				{
					"id": 220130501,
					"content": "こんにちは。お二人さん、私とお喋りしに来たの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130502
					],
					"speakerTitle": "梨絵"
				},
				{
					"id": 220130502,
					"content": "『鬼武道』を読んだことある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130503
					]
				},
				{
					"id": 220130503,
					"content": "もちろん、主人公もとても好きよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130504
					],
					"speakerTitle": "梨絵"
				},
				{
					"id": 220130504,
					"content": "でも最近、なぜか読みづらいと感じていてね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130505
					],
					"speakerTitle": "梨絵"
				},
				{
					"id": 220130505,
					"content": "読みづらい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130506
					]
				},
				{
					"id": 220130506,
					"content": "最近、いくつかの章で、主人公はたくさんの能力に目覚めたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130507
					],
					"speakerTitle": "梨絵"
				},
				{
					"id": 220130507,
					"content": "たくさんの尺を使って能力の覚醒、および使い方について説明してる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130508
					],
					"speakerTitle": "梨絵"
				},
				{
					"id": 220130508,
					"content": "その上、それらの能力名の読み方がどんどん難しくなってきて、なかなか覚えられないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130509
					],
					"speakerTitle": "梨絵"
				},
				{
					"id": 220130509,
					"content": "頑張って読んでいっても、訳の分からない数々の能力が、物語への理解を妨げてくる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130510
					],
					"speakerTitle": "梨絵"
				},
				{
					"id": 220130510,
					"content": "はぁ、しばらく読むのをやめて、もう少し理解しやすい本に変えたいと思ってるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130511
					],
					"speakerTitle": "梨絵"
				},
				{
					"id": 220130511,
					"content": "うぅ…僕は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130512
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220130512,
					"content": "やっぱり帰ろう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130513
					]
				},
				{
					"id": 220130513,
					"content": "分かった…何でこうなるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "順吉"
				}
			]
		},
