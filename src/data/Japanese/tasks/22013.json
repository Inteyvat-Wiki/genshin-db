			"dialogs": [
				{
					"id": 220130601,
					"content": "結果はどうだった？読者たちの感想は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130602
					],
					"speakerTitle": "茂"
				},
				{
					"id": 220130602,
					"content": "…コイツ、なんで雷に打たれたように落ち込んでるんだ…いったいどんな感想を聞いたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130603
					],
					"speakerTitle": "茂"
				},
				{
					"id": 220130603,
					"content": "君って人は…おい、今こそ読者たちの感想に耳を傾けるべきだぞ、順吉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130604
					],
					"speakerTitle": "茂"
				},
				{
					"id": 220130604,
					"content": "どうして、こんなことになっちゃったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130605
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220130605,
					"content": "僕の構想…作風…そんなに魅力がなかったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130606
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220130606,
					"content": "何回も言ったが、設定の追加に頼って物語を進めるのは危険なんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130607
					],
					"speakerTitle": "茂"
				},
				{
					"id": 220130607,
					"content": "斬新な能力で読者たちの興味を惹いても、その真新しさがなくなると、後から退屈が二倍返しでやって来る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130608
					],
					"speakerTitle": "茂"
				},
				{
					"id": 220130608,
					"content": "僕の長年の経験だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130609
					],
					"speakerTitle": "茂"
				},
				{
					"id": 220130609,
					"content": "わ、分かったよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130610
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220130610,
					"content": "今からでも遅くない…出版しちゃった内容はもう仕方ないけど、せめて次の章からは着実に書いてくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130611
					],
					"speakerTitle": "茂"
				},
				{
					"id": 220130611,
					"content": "旅人、感謝する。彼に少しショックを与えてしまったが、今後に繋がると思うんだ。今のままだと、手遅れになるからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130612
					],
					"speakerTitle": "茂"
				},
				{
					"id": 220130612,
					"content": "本当に感謝するぞ、旅人。お礼にこれを受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "茂"
				}
