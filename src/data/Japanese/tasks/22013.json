					"柚子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220130301,
					"content": "やあ、何か用？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130302
					],
					"speakerTitle": "柚子"
				},
				{
					"id": 220130302,
					"content": "『鬼武道』を読んだことある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130303
					]
				},
				{
					"id": 220130303,
					"content": "ん？読んだことあるよ。以前は好きだったんだけど、何と言うか…最近は物語の展開が少しおかしくて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130304
					],
					"speakerTitle": "柚子"
				},
				{
					"id": 220130304,
					"content": "どんな敵が現れても、主人公が都合のいい能力を突然習得して、敵をあっさりと倒してしまうんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130305
					],
					"speakerTitle": "柚子"
				},
				{
					"id": 220130305,
					"content": "以前の『鬼武道』は、知恵を絞って敵を倒す主人公の姿が好きだったんだけど、今は何だか…手を抜いてる感じがする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130306
					],
					"speakerTitle": "柚子"
				},
				{
					"id": 220130306,
					"content": "しかも主人公が覚醒した能力は、ほとんど一度しか使っていない。すごくいい加減な感じがする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130307
					],
					"speakerTitle": "柚子"
				},
				{
					"id": 220130307,
					"content": "この小説の作者は何を考えているのやら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130308
					],
					"speakerTitle": "柚子"
				},
				{
					"id": 220130308,
					"content": "コホッ…も、もう何人かに聞いてみよう…この人はあくまでも一例だから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "順吉"
				}
			]
		},
		{
			"id": 2201304,
