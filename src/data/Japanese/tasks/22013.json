					"長谷川"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220130401,
					"content": "皆様こんにちは、私に何か用ですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130402
					],
					"speakerTitle": "長谷川"
				},
				{
					"id": 220130402,
					"content": "『鬼武道』を読んだことある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130403
					]
				},
				{
					"id": 220130403,
					"content": "ええ、あります、面白い小説でした。登場人物の描写も、物語も素晴らしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130404
					],
					"speakerTitle": "長谷川"
				},
				{
					"id": 220130404,
					"content": "しかし最近…作者は少し手を抜いているように感じます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130405
					],
					"speakerTitle": "長谷川"
				},
				{
					"id": 220130405,
					"content": "コホッ…コホッ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130406
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220130406,
					"content": "何の前兆もなかったのに、いきなり設定が追加されることが何度かありました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130407
					],
					"speakerTitle": "長谷川"
				},
				{
					"id": 220130407,
					"content": "「覚醒」とは言え、このような方法で得た能力は、何と言いますか、安っぽい感じがします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130408
					],
					"speakerTitle": "長谷川"
				},
				{
					"id": 220130408,
					"content": "このような安っぽいシナリオは、主人公のイメージにも悪影響を及ぼします。作者の方に反省して欲しいですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130409
					],
					"speakerTitle": "長谷川"
				},
				{
					"id": 220130409,
					"content": "…旅人、ち、違う人に聞いてみようよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "順吉"
				}
			]
		},
