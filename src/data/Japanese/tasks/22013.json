			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"茂",
					"順吉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220130101,
					"content": "読者の感想を読んでいないのか？最近評価がガタ落ちしてるんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130102
					],
					"speakerTitle": "茂"
				},
				{
					"id": 220130102,
					"content": "慌てることはない。それはきっと、人気が爆発する前の静けさだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130103
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220130103,
					"content": "物語の肝になる部分に突入すれば、きっと評価はガラッと変わる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130104
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220130104,
					"content": "その前に、お前の小説が打ち切りになっちまうぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130105
					],
					"speakerTitle": "茂"
				},
				{
					"id": 220130105,
					"content": "何があったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130106
					]
				},
				{
					"id": 220130106,
					"content": "旅人、やっと来てくれたんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130107
					],
					"speakerTitle": "茂"
				},
				{
					"id": 220130107,
					"content": "前回の取材の後、順吉は『鬼武道』の主人公に、次から次へと大げさな能力を与えたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130108
					],
					"speakerTitle": "茂"
				},
				{
					"id": 220130108,
					"content": "それから、俺たち「八重堂」に、たくさんのクレームが寄せられた。「なぜこのような能力が出て来るのか理解できない」、「作者はただ思ったことを熟考せずに書いてるのか」とか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130109
					],
					"speakerTitle": "茂"
				},
				{
					"id": 220130109,
					"content": "それは主観的なコメントだ。僕が今のペースで書き続ければ、読者たちもきっと理解してくれる——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130110
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220130110,
					"content": "だから、読者が理解する前に、小説が打ち切りになっちまうんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130111
					],
					"speakerTitle": "茂"
				},
				{
					"id": 220130111,
					"content": "まったくもう…確か、この辺りにも何人か『鬼武道』を読んだことがある人が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130112
					],
					"speakerTitle": "茂"
				},
				{
					"id": 220130112,
					"content": "自分のアイデアが読者に受け入れられると思っているのなら、思い切って読者に聞いてみろよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130113
					],
					"speakerTitle": "茂"
				},
				{
					"id": 220130113,
					"content": "行ってやるよ！彼らはきっと僕を理解してくれるはずだ。旅人、証人として一緒に来てくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130114
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220130114,
					"content": "いいだろう、旅人が同行していれば、嘘をつけなくなるからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130115
					],
					"speakerTitle": "茂"
				},
				{
					"id": 220130115,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130116
					]
				},
				{
					"id": 220130116,
					"content": "よし、じゃあ早速行こう。僕は読者の皆さんを信じてる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130117
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220130117,
					"content": "一体、いくつ設定を追加したの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130118
					]
				},
				{
					"id": 220130118,
					"content": "ほ…ほんのちょっとだけだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130119
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220130119,
					"content": "ちょっとだけ？その勢いで追加していってみろ、主人公の能力の数が登場人物の数を超えちまうぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130120
					],
					"speakerTitle": "茂"
				},
				{
					"id": 220130120,
					"content": "コ…コホン！早く出発しよう。読者の皆さんはきっと理解してくれる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "順吉"
				}
			]
		},
