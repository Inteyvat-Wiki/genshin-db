			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"アファン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732060101,
					"content": "来てくれたか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060102
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732060102,
					"content": "種はどうなった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060103
					]
				},
				{
					"id": 732060103,
					"content": "それが、すべての種はまだ土の中だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060104
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732060104,
					"content": "種の表面を確認したが、発芽する気配もない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060105
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732060105,
					"content": "これはいったい何故だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060106
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732060106,
					"content": "種を間違えたということはないと思うぞ。化け爺の手記を頼りに、備品倉庫から掘り出したのだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060107
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732060107,
					"content": "記録によれば、種の保存時間が長くとも、乾燥さえしておれば、腐りはせんらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060108
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732060108,
					"content": "栽培方法も問題ないはず。水やりも肥料もおろそかにしとらん。いったい何故なのだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060109
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732060109,
					"content": "焦るなよ、アファンじいちゃん。もうちょっと待ってみようぜ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732060110,
					"content": "#オイラと{NICKNAME}だって、野外で果物や花を摘んだら、何日も待たないと、また生えてこないしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060111,
						732060112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732060111,
					"content": "辛抱強く。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060113
					]
				},
				{
					"id": 732060113,
					"content": "はぁ、待つしかないか。お前たち、今日は暇か？水やりを頼まれてくれんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060114
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732060114,
					"content": "さっきは苗畑の土をほぐしておったんだが、半日かかってな。水汲みをする気力もなくなってしもうた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060115
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732060115,
					"content": "わかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060116
					]
				},
				{
					"id": 732060116,
					"content": "ありがとうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アファン"
				},
				{
					"id": 732060112,
					"content": "水やりを続けてみるのは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060113
					]
				}
			]
		},
		{
			"id": 7320603,
			"completionStepIds": [
				7320603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320603",
							"2"
						],
						"stepId": 7320603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アファン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732060301,
					"content": "水やりも、肥料の施しも続けとるが、それが果たして実を結ぶかどうかは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060302
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732060302,
					"content": "わしにもわからんな…はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060303
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732060303,
					"content": "今まで何となく生きてきたが、やっと決心がついて何かやろうと思えばこれだ。結局何もできんかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060304
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732060304,
					"content": "化け爺、頼みに応えられんで、すまんな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060305
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732060305,
					"content": "アファンじいちゃん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732060306,
					"content": "若造たち、行きなさい。",
