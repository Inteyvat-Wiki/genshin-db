				"points": []
			},
			"dialogs": [
				{
					"id": 732050501,
					"content": "ローズよローズ、叶えておくれ、わしの願いを…♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050502
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732050502,
					"content": "ん？まだおったのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050503,
						732050513
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732050503,
					"content": "どうしてここに住んでるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050504
					]
				},
				{
					"id": 732050504,
					"content": "ははっ、どうせわしは変なじじいだ。変なじじいに「何故」と聞く者は少ないがな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050505
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732050505,
					"content": "わしは、ずっと故郷を離れてチャンスを掴み取り、何かを成し遂げたかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050506
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732050506,
					"content": "結婚したばかりの頃はエルマイト旅団についていこうとも思ったが、妻に申し訳ないと思い、ここに留まった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050507
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732050507,
					"content": "その後はキャラバンに出会い、商売をしたくなった。最終的にはコストが足りなくてできなかったんだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050508
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732050508,
					"content": "そうしてその後、妻が逝ってしもうてな。わしは心配することもなくなったが、年も年だったから、ここを離れることはついにできんかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050509
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732050509,
					"content": "ずっと今日まで先延ばしにしてきたが、逃したことが多すぎた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050510
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732050510,
					"content": "振り返ってみれば、自分がこの村にも、どこにも属していないことに気が付いてしもうた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050511
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732050511,
					"content": "結局、村の外で一人暮らしをするのが一番しっくりくるのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050512
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732050512,
					"content": "数十年ってこんなもんとはな。まあ、これでいいのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050525
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732050525,
					"content": "花が咲いたら呼びに行こう。明日か、明後日には、多分咲くと思うが、来てくれる時間はあるかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050526
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732050526,
					"content": "いいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050527
					]
				},
				{
					"id": 732050527,
					"content": "そうかそうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050528
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732050528,
					"content": "ローズよローズ、叶えておくれ、わしの願いを…♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アファン"
				},
				{
					"id": 732050513,
					"content": "化け爺について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050514
					]
				},
				{
					"id": 732050514,
					"content": "化け爺について聞くのはよそ者くらいだ。村の子供は全員この名前を知っとるからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050515
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732050515,
					"content": "言うことを聞かない子は、化け爺にさらわれてしまうぞ、と親に聞かされて育つのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050516
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732050516,
					"content": "若者たちは誰も化け爺のことを知らないが、名前を出して脅かすことだけはうまくやっとる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050517
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732050517,
					"content": "わしは小さい頃、化け爺本人に会ったことある。彼は子供嫌いだったが、顔は怖くなかったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050518
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732050518,
					"content": "それがなぜか、いつの間にか化け爺呼ばわりされるようになった。暇人がでたらめを言っとっただけなのだとわしは思っとるが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050519
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732050519,
					"content": "友達じゃなかったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050520
					]
				},
				{
					"id": 732050520,
					"content": "ガキの頃は、よく彼の庭辺りで遊んどったが、見つかったが最後、クワを振り回されて追っ払われたもんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050521
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732050521,
					"content": "多分いたずらをするガキ大将と間違われたのだろう。わしのことなぞ覚えとらんかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050522
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732050522,
					"content": "彼はわしを知らんかったが、わしは彼と、彼の小さな花園のことをずっと覚えとる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050523
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732050523,
					"content": "だから友人と言ったのだ。間違ってはおらんだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050524
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732050524,
					"content": "記憶の中の花園を再現するために、わしはこの花を育てておる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050525
					],
					"speakerTitle": "アファン"
				}
			]
		},
		{
			"id": 7320601,
			"completionStepIds": [
				7320601
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
