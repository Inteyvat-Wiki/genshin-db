				"points": []
			},
			"dialogs": [
				{
					"id": 740539101,
					"content": "誰が来たかと思えば！「フォンテーヌ科学院名誉上級研究員」ではありませんか。いらっしゃい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740539102
					],
					"speakerTitle": "ショワズール"
				},
				{
					"id": 740539102,
					"content": "何かお手伝いできることはありますか？あるいはまた我々の手伝いに来てくださったのかな？ハハハ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740539103,
						740539111,
						740539116
					],
					"speakerTitle": "ショワズール"
				},
				{
					"id": 740539103,
					"content": "科学院の現状について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740539104
					]
				},
				{
					"id": 740539104,
					"content": "すべてが正常！これ以上ないぐらいですよ。自惚れ屋のエドウィンは消えて、手下の泥棒たちももういません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740539105
					],
					"speakerTitle": "ショワズール"
				},
				{
					"id": 740539105,
					"content": "さらに重要なのは、科学院全体が生まれ変わる機会を得たことです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740539106
					],
					"speakerTitle": "ショワズール"
				},
				{
					"id": 740539106,
					"content": "過去の束縛や重荷を捨て去り、再び全身全霊で設立当時の初心に帰る―フォンテーヌ廷全体の民の福祉のために努力するのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740539107
					],
					"speakerTitle": "ショワズール"
				},
				{
					"id": 740539107,
					"content": "科学院の詳細な就業規則編纂のために、今は人手を集めているところです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740539108
					],
					"speakerTitle": "ショワズール"
				},
				{
					"id": 740539108,
					"content": "内容は経費の使用原則、研究資産の管理方法…それに科学研究と仕事の中で守るべき道徳水準です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740539109
					],
					"speakerTitle": "ショワズール"
				},
				{
					"id": 740539109,
					"content": "科学院内の研究に関するあらゆる行為に、根拠となる条文ができるんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740539110
					],
					"speakerTitle": "ショワズール"
				},
				{
					"id": 740539110,
					"content": "ああ…なんと美しい未来！素晴らしい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ショワズール"
				},
				{
					"id": 740539111,
					"content": "レモンドと一緒に科学院を統率するの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740539112
					]
				},
				{
					"id": 740539112,
					"content": "いえ、正確には、私たちは分野の異なる事務を管理しているだけです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740539113
					],
					"speakerTitle": "ショワズール"
				},
				{
					"id": 740539113,
					"content": "レモンドの仕事は科学研究を再び軌道に乗せること。私の担当は科学研究以外の事務。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740539114
					],
					"speakerTitle": "ショワズール"
				},
				{
					"id": 740539114,
					"content": "例えば人手の分配ですね。経費の裁可、新四半期の財政予算分配、訪問者の新たな受付、それにレモンドとともに記者たちを追い返すこと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740539115
					],
					"speakerTitle": "ショワズール"
				},
				{
					"id": 740539115,
					"content": "ですが我々の仕事の目的はまったく同じです。それはフォンテーヌ科学院の再建、フォンテーヌ廷全体の民の福祉のために努力すること。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ショワズール"
				},
				{
					"id": 740539116,
					"content": "さようなら。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740539117
					]
				},
				{
					"id": 740539117,
					"content": "ご自分の仕事に向かいなさい。フォンテーヌ科学院はいつでもあなたの訪問を歓迎しますよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ショワズール"
				}
			]
		}
	]
