	"talks": [
		{
			"id": 7405389,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7417201",
							"2"
						],
						"stepId": 7417201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"レモンド"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740538901,
					"content": "何か手伝うことはあるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538902,
						740538917,
						740538930,
						740538946,
						740538949,
						740538968
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 740538902,
					"content": "どうしてナッカーが死んでいないと思うの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740538903
					]
				},
				{
					"id": 740538903,
					"content": "科学院の利益と…私の個人的な考えから言えば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538904
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 740538904,
					"content": "彼とあの「アルケウム動力コア」が爆発で徹底的に灰になっていてほしいと、心から願うよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538905
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 740538905,
					"content": "これで、エドウィン·イースティングハウスの科学院に残った最後のわずかな影響力も、完全に消え失せるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538906
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 740538906,
					"content": "だが前にも言ったように、あの爆発の実態は小範囲のアルケウムの欠片の共鳴だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538907
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 740538907,
					"content": "それに…爆発区域内のアルケウムの欠片は、ほとんどがエネルギーの枯渇した廃石だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538908
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 740538908,
					"content": "理論上、大型アルケウムが制御を失い、それらの廃石に共鳴が発生したとしても、これほど強力な爆発は起きないはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538909
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 740538909,
					"content": "唯一の可能性としては——誰かがその他区域内のまだエネルギーが枯渇していないアルケウムを置き、ここに積み上げた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538910
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 740538910,
					"content": "それから、故意にその大型アルケウムをオーバーロードさせ、それらアルケウムを共鳴させ爆発を引き起こし、何らかの痕跡を隠そうとした——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538911
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 740538911,
					"content": "ナッカーさんはずっとエドウィンに従って研究していたし、アルケウムの性質についても十分知っていた。こんなことは屁でもないはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538912
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 740538912,
					"content": "だがこれらは単なる私の初歩的推理だ。今後の…科学院による捜査を待とう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538913
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 740538913,
					"content": "でも彼が何故このコアを盗もうとするの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740538914
					]
				},
				{
					"id": 740538914,
					"content": "この「アルケウム動力コア」は、現時点ではフォンテーヌ科学院の最先端技術だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538915
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 740538915,
					"content": "売り払うにしろ、何かの開発プロジェクトに使うにしろ…フン、どちらも悪くない選択肢だろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538916
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 740538916,
					"content": "だが、彼の学術水準を考えれば…この「アルケウム動力コア」を高値で売ったというほうが近いんじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "レモンド"
				},
				{
					"id": 740538917,
					"content": "「アルケウム動力コア」について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740538918
					]
				},
				{
					"id": 740538918,
					"content": "私の口から聞かずとも、きっとナッカーさんか、クロニエさんから聞いているだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538919
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 740538919,
					"content": "私とエドウィン·イースティングハウスの研究プロジェクトはある方面で重なっていたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538920
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 740538920,
					"content": "ふむ、この言い方は正確じゃない…実際にはこの「アルケウム動力コア」がまさに、私とエドウィンが共同で研究した成果なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538921
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 740538921,
					"content": "理論上は、この動力コアに最大値のエネルギーを注入し続ければ、コアはやすやすと「実験用フィールド生成装置」を駆動でき、最大限の出力で動かすことができる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538922
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 740538922,
					"content": "このコアを作った時、我々は同じ問題に気付いた。私たちは最大値のエネルギーを注入する方法をほとんど見つけられなかったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538923
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 740538923,
					"content": "私とエドウィンはプネウムシア対消滅エネルギーとアルケウムエネルギーを合わせたり、あるいは大量のアルケウムを繋げて超大型のエネルギーユニットを作ったりしてみたが…よい結果は得られなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538924
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 740538924,
					"content": "そんな時私たちはあの巨大アルケウムを見つけた…あれはずっと不活性状態だったが、私とエドウィンはこの鉱石が今までにないほどの純度を持っていることを確信した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538925
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 740538925,
					"content": "この鉱石は少し処理すれば、きっと我々の必要とする大量のエネルギーを放出してくれる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538926
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 740538926,
					"content": "それから、私とエドウィンは対立し始めた。私は保守的な解決策を提案したんだが、彼は…問題をもっと早く解決しようとしていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538929
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 740538929,
					"content": "その後どうなったかは、君も知っているだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "レモンド"
				},
				{
					"id": 740538930,
					"content": "エドウィンについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740538931
					]
				},
				{
					"id": 740538931,
					"content": "彼は科学研究分野の天才だった。全くの誇張無しで、その才能は我らの初代院長、アラン·ギヨタンに次ぐものだろうと言える。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538932
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 740538932,
					"content": "だが彼は同時に…人情味に欠けた怪物でもあった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538933
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 740538933,
					"content": "科学研究以外、どんなものも彼にとってはまるで意味を持たなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538934
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 740538934,
					"content": "研究の進捗を進めるためならエドウィンはどんなこともできたし、どんな代償も支払った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538935
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 740538935,
					"content": "研究成果以外に多くの報酬を要求することはなかったし、こう言っていたこともある…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538936
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 740538936,
					"content": "「私は何の報酬も要らない。私にとっては、研究そのものが最高の報酬なのだ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538937
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 740538937,
					"content": "だが、純粋な研究者だったエドウィンと違い、その下にいたやつらは、フン…抜け目ない連中ばかりだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538938
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 740538938,
					"content": "研究資産を密売する者、研究成果を盗む者、エドウィンの名を騙って、外で詐欺行為をはたらく者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538939
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 740538939,
					"content": "フォンテーヌ科学院の名声は、こうして彼らによって少しずつ汚されていった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538940
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 740538940,
					"content": "だが先ほど言ったように、研究が進められれば、エドウィンは構わなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538941
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 740538941,
					"content": "そうして、彼らはエドウィンの名の下で、徐々に科学院のリソースを蝕んでいったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538942
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 740538942,
					"content": "科学院のほうも、エドウィンのプロジェクトの人員や経費を絶えず調べざるを得なかった。何度も審査責任者になったのが、ショワズールさんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538943
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 740538943,
					"content": "だが彼らはこれらの行為を「官僚化的圧力」そして「研究員に対する不信任」だと称した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538944
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 740538944,
					"content": "科学院には問題が増えるばかりで…なのに、誰にも解決方法はわからなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538945
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 740538945,
					"content": "だが今はもう…こういった問題は存在しなくなった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "レモンド"
				},
				{
					"id": 740538946,
					"content": "科学院の現状について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740538947
					]
				},
				{
					"id": 740538947,
					"content": "フフ、それは技術的な問題じゃなく、運営の問題について聞きたいんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538948
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 740538948,
					"content": "私より、ショワズールさんに聞いたほうがいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "レモンド"
				},
				{
					"id": 740538949,
					"content": "なんでナッカーがコアを盗んだと思うの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740538950
					]
				},
				{
					"id": 740538950,
					"content": "以前、クロニエさんが廃墟の中で撮った写真を見せてもらったのを覚えているかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538951
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 740538951,
					"content": "その中の一枚に、ナッカーさんが抑制器の前で操作しているものがあった。ぼけていたが…私にははっきりわかった。あの動作は絶対、操作マニュアルの中には無かったものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538952
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 740538952,
					"content": "それだって、なんの説明にもならないぞ。ひょっとすると…泥棒が隣の山の頂上から飛んできて、このコアを盗んでいったのかもしれないじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538953
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740538953,
					"content": "はは、絶対にありえない。この廃墟内のアルケウムのエネルギーフローこそ、最高の防犯措置なんだ。何せ、一般人なら耐えられない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538954
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 740538954,
					"content": "それに、「実験用フィールド生成装置」の発動したタイミングがよすぎる…これが偶然だとは考えられない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538955
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 740538955,
					"content": "不十分な憶測にすぎないが、ナッカー…あるいは「コアを盗み取った人間」はとうに「アルケウム動力コア」を除去して、予備エネルギーを起動させているのかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538956
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 740538956,
					"content": "だが「プネウムシア対消滅エネルギーコア」はエネルギーとしては効率の悪い部類に入る。エネルギー放出を維持しなければ、デカブツを起動させられるようなレベルには達しない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538957
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 740538957,
					"content": "だからその人物はわざとあの大型アルケウムを活性化させ、大きくも小さくもない、だが極めて人目を引く爆発を引き起こした——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538958
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 740538958,
					"content": "そして科学院から人が派遣されてきたら、まずはアルケウム抑制器を修理する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538959
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 740538959,
					"content": "「実験用フィールド生成装置」の予備エネルギーを取りに行く必要があると気づいた時には、「実験用フィールド生成装置」のチャージも終わっている…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538960
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 740538960,
					"content": "技術面から考えれば、これは大いに実行し得ることだ。そしてフォンテーヌ科学院内でこんなことができるのは私とエドウィン、それにナッカーさんだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538961
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 740538961,
					"content": "エドウィンにこんなことをする機会はなかったはずだ…残される容疑者は私とナッカーさんの二人のみ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538962
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 740538962,
					"content": "#{M#君}{F#あなた}って可能性もある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740538963
					]
				},
				{
					"id": 740538963,
					"content": "そうだ、「ナッカーは嘘つきだ」って言ってたおまえも、ずっと嘘をついてただろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538964
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740538964,
					"content": "自作自演で、オイラたちを騙して陰でなにかを手に入れようとしていたのかもしれないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538965
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740538965,
					"content": "ふむ、その指摘もまったく的外れというわけではないな。私も後で院内の信頼調査を申請しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538966
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 740538966,
					"content": "だが私は…犯人はナッカーさんである可能性のほうが高いと思う。これが本当に彼の仕業だとすれば、今回の事件で最大の利益を得るのは彼だからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538967
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 740538967,
					"content": "仮に私が彼とともに容疑者としてリストアップされたとしても…彼が犯人である可能性のほうがずっと高い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "レモンド"
				},
				{
					"id": 740538968,
					"content": "さようなら。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740538969
					]
				},
				{
					"id": 740538969,
					"content": "さようなら。よい一日を。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "レモンド"
				}
			]
		},
		{
			"id": 7405391,
