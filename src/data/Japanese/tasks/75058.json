			"dialogs": [
				{
					"id": 750013301,
					"content": "おかしいぞ。どうしてここにある柱の下には「光の刻印」が出てないんだ？他のやつと同じように、金色の模様が集まってるのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750013302,
					"content": "ということは、ここの「光の刻印」は押し出されただけでなく、断片化してしまったということだ…厄介だな。散らばった「光の刻印」の破片を、早急に探さねばならん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013303
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750013303,
					"content": "それじゃあ、散らばった「光の刻印」はどこにあるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750013304,
					"content": "…私にもわからない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013305
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750013305,
					"content": "ええ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750013306,
					"content": "散らばっても力に縛られているから、今も近くにあるはずだ。探しに行った方がいいな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013307
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750013307,
					"content": "キュイッ、キュイッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013308
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013308,
					"content": "#どうした、あっちに行きたいのか？いま{NICKNAME}とオイラにはやらなきゃいけない大事なことがあるんだ。また後で遊んでやるからさ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750013309,
					"content": "キュイッ…キュイッ！キュイッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013310
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013310,
					"content": "刻印があそこにあるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750013311
					]
				},
				{
					"id": 750013311,
					"content": "キュイッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013312
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013312,
					"content": "ふむ、今でも「光の刻印」の力を感知できる竜がいると聞いたことはあったが、ただの噂だと思っていた…まさか本当だったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013313
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750013313,
					"content": "#やはり{REALNAME[ID(2)|SHOWHOST(true)]}は普通のテペトル竜の子供ではないようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013314
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750013314,
					"content": "おまえ、そんな能力持ってたのか！オイラと比べて、案内役としてはまだまだだけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013315
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750013315,
					"content": "キュー？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013316,
						750013318
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013316,
					"content": "パイモンが嫉妬してる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750013317
					]
				},
				{
					"id": 750013317,
					"content": "そんなことないぞ！オイラは見た目以上に心が広いんだからな！こ、これがオイラなりの褒め方ってだけだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013320
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750013320,
					"content": "キュ…キュウ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013321
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013321,
					"content": "って、こいつには言ってもわからないよな。まったく、おまえがもっと賢かったらよかったぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013322
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750013322,
					"content": "いつか理解できるときが来るよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750013323
					]
				},
				{
					"id": 750013323,
					"content": "うむ。だが、部族で竜の世話をする人々によれば、竜と気持ちを通わせるには、長い時間をかける必要があるらしいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013324
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750013324,
					"content": "竜と打ち解ける秘訣は、辛抱強く継続的にコミュニケーションを続けることだ。人が竜を理解しようとする場合も、竜が人を理解しようとする場合のどちらでもとても長い時間が必要だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013325
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750013325,
					"content": "#そっか…さっきオイラが{REALNAME[ID(2)|SHOWHOST(true)]}の言おうとしてることを理解できなかったのと同じなのかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013326
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750013326,
					"content": "#ごめんな、{REALNAME[ID(2)|SHOWHOST(true)]}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013327
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750013327,
					"content": "キュイッ、キュイッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013328
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013328,
					"content": "今回は反応が早いな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013329
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750013329,
					"content": "よし。じゃあさっきおまえが行きたがってた場所で、金色の模様がないか探してみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750013318,
					"content": "パイモンに褒められてるよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750013319
					]
				},
				{
					"id": 750013319,
					"content": "そうだけど、だからって調子に乗るのはダメだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013320
					],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
}