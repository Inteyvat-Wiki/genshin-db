			"dialogs": [
				{
					"id": 741430501,
					"content": "ラノール！ラノール！大丈夫か！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430502
					],
					"speakerTitle": "アーンショウ"
				},
				{
					"id": 741430502,
					"content": "おじいちゃん！わたし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430503
					],
					"speakerTitle": "ラノール"
				},
				{
					"id": 741430503,
					"content": "あ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741430504,
					"content": "#ああ…良かった。ありがとう、{NICKNAME}にパイモン。あんたらのおかげじゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430505,
						741430506
					],
					"speakerTitle": "アーンショウ"
				},
				{
					"id": 741430505,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741430507
					]
				},
				{
					"id": 741430507,
					"content": "でも…いや、さっきのは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430508
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741430508,
					"content": "パイモン。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741430509
					]
				},
				{
					"id": 741430509,
					"content": "…で、でも…うぅ、わかったよ！いやぁ——ラノールが無事でホントに良かったな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430510
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741430510,
					"content": "#…ありがとう、おじいちゃん。それから{NICKNAME}{M#お兄ちゃん}{F#お姉ちゃん}とパイモンお姉ちゃんも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430511
					],
					"speakerTitle": "ラノール"
				},
				{
					"id": 741430511,
					"content": "もう勝手に離れるんじゃないぞ！はぁ、肝を冷やしたわい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430512
					],
					"speakerTitle": "アーンショウ"
				},
				{
					"id": 741430512,
					"content": "すまんかったな、本当に！わしの事情であんたを走り回らせてしまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430513
					],
					"speakerTitle": "アーンショウ"
				},
				{
					"id": 741430513,
					"content": "いえいえ、いいのよ。その子が無事ならそれで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430514
					],
					"speakerTitle": "シャーリーン"
				},
				{
					"id": 741430514,
					"content": "（ラノール、大丈夫か…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430515
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741430515,
					"content": "#（キャタピィお兄ちゃんが言ってたことと、{NICKNAME}{M#お兄ちゃん}{F#お姉ちゃん}がおじいちゃんにどうして何も言わないのか、わたし理解できたよ。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430516
					],
					"speakerTitle": "ラノール"
				},
				{
					"id": 741430516,
					"content": "（だからね…わたしもおじいちゃんには何も言わないし、心配させるようなことはしない。だって、わたしはいい子だもん。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430517
					],
					"speakerTitle": "ラノール"
				},
				{
					"id": 741430517,
					"content": "（そっか、ラノールはお利口だな。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430518
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741430518,
					"content": "（……）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430519
					],
					"speakerTitle": "ラノール"
				},
				{
					"id": 741430519,
					"content": "（ううん、わたしちっともお利口なんかじゃないよ。キャタピィお兄ちゃんが最後に言った言葉の意味も、どうしてわたしに感謝したのかもわからなかったもん。いつも助けてくれたのはお兄ちゃんのほうだったのに。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430520
					],
					"speakerTitle": "ラノール"
				},
				{
					"id": 741430520,
					"content": "（大きくなったら、キャタピィお兄ちゃんを探してちゃんと聞くんだ。そのときは、お兄ちゃんとたくさんお話しをして、ケーキを食べさせてあげるの。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430521
					],
					"speakerTitle": "ラノール"
				},
				{
					"id": 741430521,
					"content": "#（{NICKNAME}{M#お兄ちゃん}{F#お姉ちゃん}、パイモンお姉ちゃん。わたしが大きくなったら、一緒にキャタピィお兄ちゃんを探しにいってくれる？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430522,
						741430523
					],
					"speakerTitle": "ラノール"
				},
				{
					"id": 741430522,
					"content": "大きくなったらまた言ってね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741430524
					]
				},
				{
					"id": 741430524,
					"content": "うん、じゃあ約束ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430525
					],
					"speakerTitle": "ラノール"
				},
				{
					"id": 741430525,
					"content": "ラノールたちはその場を離れていった。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 741430523,
					"content": "いいよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741430524
					]
				},
				{
					"id": 741430506,
					"content": "礼はいらないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741430507
					]
				}
			]
