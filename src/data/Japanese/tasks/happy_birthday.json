			"dialogs": [
				{
					"id": 741430201,
					"content": "おーい、あんたたち！はぁ、わ…わしの…はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430202
					],
					"speakerTitle": "アーンショウ"
				},
				{
					"id": 741430202,
					"content": "うわっ、どうしたんだよアーンショウじいちゃん！そんなに息を切らして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741430203,
					"content": "ラノールが、ラノールがヒルチャールにさらわれた！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430204
					],
					"speakerTitle": "アーンショウ"
				},
				{
					"id": 741430204,
					"content": "ええっ！？大変じゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741430205,
					"content": "あっちの方に向かったようだ！わしは人を呼んでくるから、あんたらは後を追ってくれんか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430206
					],
					"speakerTitle": "アーンショウ"
				},
				{
					"id": 741430206,
					"content": "わかった！旅人、急ごうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7414304,
			"completionStepIds": [],
