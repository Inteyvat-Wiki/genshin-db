						],
						"pointId": 6841
					}
				]
			},
			"dialogs": [
				{
					"id": 741430401,
					"content": "おや、あなたたちは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430402
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 741430402,
					"content": "なんだ！キャタピラーだったのかよ！まったくもう、心配させやがって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741430403,
					"content": "#わぁ！{NICKNAME}{M#お兄ちゃん}{F#お姉ちゃん}にパイモンお姉ちゃん！えへへ、大好きな人がみんな来てくれるなんて、今日は嬉しいなぁ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430404
					],
					"speakerTitle": "ラノール"
				},
				{
					"id": 741430404,
					"content": "おじいちゃんがね、おっきくて甘い「誕生日ケーキ」を作ってくれたの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430405
					],
					"speakerTitle": "ラノール"
				},
				{
					"id": 741430405,
					"content": "おお！今日はラノールの誕生日なのか！おめでとう！え～っと…ケーキはまだ残ってる、よな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741430406,
					"content": "あ…もう全部食べちゃったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430407
					],
					"speakerTitle": "ラノール"
				},
				{
					"id": 741430407,
					"content": "なんだよ、ケチ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741430408,
					"content": "キャタピラー…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741430409
					]
				},
				{
					"id": 741430409,
					"content": "大丈夫？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741430410
					]
				},
				{
					"id": 741430410,
					"content": "ええ、心配いりませんよ。今日は良い日ですし、興ざめするような話は控えておきましょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430411
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 741430411,
					"content": "#何はともあれ、ありがとうございます、{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430412
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 741430412,
					"content": "なんの話をしてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741430413,
					"content": "ははっ、何でもないんです。ただ、チーム「ちびっこ」の仲間たちが前に集まったのは、もう…すごく昔のことだなって思って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430414
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 741430414,
					"content": "でも変なの。どうしてキャタピィお兄ちゃんはわたしをここに連れてきたの？それにおじいちゃん、キャタピィお兄ちゃんを見て怖がってたみたい。勇者や姫、王子もね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430415
					],
					"speakerTitle": "ラノール"
				},
				{
					"id": 741430415,
					"content": "おじいちゃん、わたしからキャタピィお兄ちゃんの話を聞くといつも「今度、家に連れてきなさい」って言ってたのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430416
					],
					"speakerTitle": "ラノール"
				},
				{
					"id": 741430416,
					"content": "まあ…今の見た目だとな…なぁキャタピラー、なんで前みたいに人間の姿にならないんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430417
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741430417,
					"content": "望んでないわけじゃないんです。ただ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430418
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 741430418,
					"content": "ただ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430419
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741430419,
					"content": "今の姿もとっても素敵だよ！さっきキャタピィお兄ちゃんの肩の上に座って、バブルオレンジを摘んだの。お兄ちゃん、風みたいに速く走れて本当にすごいんだから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430420
					],
					"speakerTitle": "ラノール"
				},
				{
					"id": 741430420,
					"content": "…ラノール、よく覚えていてほしい。もしボクに似た「人」を見かけても、絶対に近づかないですぐに逃げるんだよ。そういう人はすごく危険な存在だから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430421
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 741430421,
					"content": "そうなの？でも、キャタピィお兄ちゃんは少しも怖くないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430422
					],
					"speakerTitle": "ラノール"
				},
				{
					"id": 741430422,
					"content": "ラノール、ボクと約束してほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430423
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 741430423,
					"content": "はじめはキャタピラーが「小細工」を使って、ラノールを納得させようとしているのかと思った。\\nでも彼はそうすることなく、真剣な面持ちでラノールの返答を待っている。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741430424
					]
				},
				{
					"id": 741430424,
					"content": "でも…うん、わかった。約束する、キャタピィお兄ちゃん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430425
					],
					"speakerTitle": "ラノール"
				},
				{
					"id": 741430425,
					"content": "けど…これから、どうやってキャタピィお兄ちゃんを見分ければいいの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430426
					],
					"speakerTitle": "ラノール"
				},
				{
					"id": 741430426,
					"content": "あ、そうだ！キャタピィお兄ちゃん。わたしメロピデ要塞を離れてから、外の世界がこんなにも広いことを初めて知ったの。毎日違う方向へ歩いても、まだ一度も壁を見たことがないんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430427
					],
					"speakerTitle": "ラノール"
				},
				{
					"id": 741430427,
					"content": "太陽が出ると暑くなって、夜は陽が落ちて涼しくなる。そうだ！夜になると、湖に風が吹いて涼しくなるんだよ。扇風機とは違うよね。これはどうして？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430428
					],
					"speakerTitle": "ラノール"
				},
				{
					"id": 741430428,
					"content": "あとね、勇者がわたしとおじいちゃんのそばで伏せていると、よくわたしたちを見上げるの。それから姫が寝てるとき、たまに後ろ足で物を蹴ったりするんだ。面白いんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430429
					],
					"speakerTitle": "ラノール"
				},
				{
					"id": 741430429,
					"content": "それから、それから…靴を履いてないときに草原を歩くと、草が足の指の間に入ってきてちょっとチクッてするの。草のことは本で読んだことあったけど、柔らかいんだと思ってた！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430430
					],
					"speakerTitle": "ラノール"
				},
				{
					"id": 741430430,
					"content": "あとね、エティヌおじさんがくれたお花は外にもたくさん咲いてるんだよ。あとお花には根っこもあって、土の中にしっかりと生えてるの。それはどうして？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430431
					],
					"speakerTitle": "ラノール"
				},
				{
					"id": 741430431,
					"content": "この世界って本当に大きくて不思議で、違う色をした光がたくさんある。キャタピィお兄ちゃんに教えたいことがいーっぱいあるし、教えてもらいたいこともいーっぱいあるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430432
					],
					"speakerTitle": "ラノール"
				},
				{
					"id": 741430432,
					"content": "けどね、見分けがつかないなら、どうやってお兄ちゃんを探したらいいの？魔法使いの弟子みたいに、ずーっと魚を探すことになっちゃう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430433
					],
					"speakerTitle": "ラノール"
				},
				{
					"id": 741430433,
					"content": "あの物語をまだ覚えていたんだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430434
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 741430434,
					"content": "忘れるわけないよ！わたし、キャタピィお兄ちゃんが帰ってきて、最後まで話してくれるのをずっと待ってたんだから。結局、最後は魚を見つけられたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430435
					],
					"speakerTitle": "ラノール"
				},
				{
					"id": 741430435,
					"content": "それはね、ずーっと後になって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430436
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 741430436,
					"content": "愚かな魔法使いの弟子は勇気を出して大魔法使いに別れを告げ、工房を出て魚を探す旅に出るんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430437
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 741430437,
					"content": "でも、彼は広い海を見たことがない。魚の言う「故郷」がどんな場所なのか見当もつかなかった。だから、彼は道を尋ねることにした…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430438
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 741430438,
					"content": "川沿いの葦{RUBY#[S]あし}に尋ねると、葦{RUBY#[S]あし}は彼の話す物語を聞いて身をよじって笑った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430439
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 741430439,
					"content": "「お前が探してるのは海だ。」と葦{RUBY#[S]あし}は言った。「川より何百倍も何千倍も広いところで、川が流れていく場所さ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430440
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 741430440,
					"content": "彼は川の流れに沿って進み、ついに海を見つけた。でも海は広すぎて、すっかり迷子になってしまったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430441
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 741430441,
					"content": "そこで彼は、埠頭でひと休みする紫金オオズグロカモメに尋ねた。紫金オオズグロカモメは彼の話す物語を聞くと、驚いてあんぐりと口を開いた。くわえていたフライドポテトを落としてしまうほどね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430442
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 741430442,
					"content": "「君、それは無理だよ。」とカモメが言った。「海でただの魚を一匹探すなんて、誰もやったことがない。それに、その魚はもしかしたらとっくに…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430443
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 741430443,
					"content": "魔法使いの弟子はパンでカモメの口を塞いだ。彼とやかましい仲間たちには取り合おうとせず、再び海岸線に沿って移動し、尋ねながら探し続けた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430444
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 741430444,
					"content": "彼は愚かな弟子だったから、愚かな方法でしか探す術を持たなかった。彼は長い時間をかけてダイビングを習得し、何度も何度も海の奥深くへ潜っていった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430445
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 741430445,
					"content": "きっと最後は見つけたんだよね！強く望んで努力することを諦めなければ、絶対に願いは叶うんでしょ！おじいちゃんがそう教えてくれたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430446
					],
					"speakerTitle": "ラノール"
				},
				{
					"id": 741430446,
					"content": "ラノールはハッピーエンドが好きなんだね…うん、アーンショウおじいちゃんの言うとおりだ。弟子は愚かだったけど、その最も愚かな彼の方法で、最後にはその魚を見つけた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430447
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 741430447,
					"content": "魚を見つけたとき、彼は家族と一緒に水中を泳いでいて、その群れは自在に形を変えていた。でも弟子は、たくさんいる同じ種類の仲間たちの中からひと目で彼を見つけたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430448
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 741430448,
					"content": "「やっと見つけた…」弟子は願いを叶えたのに、なぜか彼の心は想像していたほど躍ることもなく、むしろ戸惑いを感じていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430449
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 741430449,
					"content": "魚の群れは不思議そうに彼を取り囲み、一部始終を話してほしいと彼に促した。彼はたどたどしくこれまでに起こったすべてのことを説明し、最後には肩の荷が下りたかのように水中で長々と泡を吐いた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430450
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 741430450,
					"content": "「僕は二回謝らなきゃいけない。」と弟子は言った。「一つは、君に助けを求められたときに勇気を出すことができなかったこと。もう一つは、いきなり君を訪ねたこと…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430451
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 741430451,
					"content": "「こうしてやっとまた君に会えて気づいたんだ。僕はなんて身勝手なんだろうって…僕はただ、君に直接謝ることができたら、過去の自分を許すことができるだろうとしか考えてなかった。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430452
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 741430452,
					"content": "「それがどうしたんだい？」と魚から予想外の答えが返ってきた。「確かに君は昔、僕を助けられなかった。けど、今は故郷の家族のもとに帰ってこれたよ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430453
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 741430453,
					"content": "「僕は何も傷ついていないんだから、君も誰かに許しを請う必要なんてないんだ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430454
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 741430454,
					"content": "「こんな些細なことのために長い時間と労力を費やすなんて、真っ直ぐな人間と言うべきか、愚かと言うべきか…でも、君が愚かだとしても、僕らはその愚かな人間と友達になるのは嫌じゃないよ…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430455
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 741430455,
					"content": "わあっ！じゃあ、二人は最後に友達になれたんだ？その後はどうなったの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430456
					],
					"speakerTitle": "ラノール"
				},
				{
					"id": 741430456,
					"content": "その後？…彼らは、お互い一番の友達になりましたとさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430457
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 741430457,
					"content": "えっ？終わりか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430458
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741430458,
					"content": "えっと、物語はこれで終わりなの？キャタピィお兄ちゃん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430459
					],
					"speakerTitle": "ラノール"
				},
				{
					"id": 741430459,
					"content": "うん、ボクの物語はもう終わり。いいところで物語が終わらなかったら、それ以降は蛇足だからね。英雄が悪龍になってしまうよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430460
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 741430460,
					"content": "ボクも昔、同じようにいつまでも終わってほしくないお話を聞いたことがあるよ。けど、その結末はひどいもので、話に出てくる人たちがみんな心を痛めてしまう、ひどい物語だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430461
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 741430461,
					"content": "でもね、ボクの大切なラノール。キミの「人生という名の冒険の物語はまだ続いてる」んだ。誕生日おめでとう。いつか、ラノールの物語をボクに聞かせてくれるかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430462
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 741430462,
					"content": "うん。うん…約束するね、キャタピィお兄ちゃん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430463
					],
					"speakerTitle": "ラノール"
				},
				{
					"id": 741430463,
					"content": "絶対お兄ちゃんを見つけるから。それからいっぱいお話を聞かせてあげるの。それからね、大きくて甘い誕生日ケーキも作ってあげる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430464
					],
					"speakerTitle": "ラノール"
				},
				{
					"id": 741430464,
					"content": "はははっ、誕生日ケーキは遠慮しておくよ。ボクは自分の誕生日を知らないんだ。目覚めた日のことしか知らなくて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430465
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 741430465,
					"content": "…ありがとう、ラノール。だって——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キャタピラー"
				}
			]
		},
