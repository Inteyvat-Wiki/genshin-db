				]
			},
			"dialogs": [
				{
					"id": 762020901,
					"content": "ところで…なんでニコはオイラたちに贈り物をするのに、あんなにワクワクしてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020902
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762020902,
					"content": "そりゃオイラだって、おまえにプレゼントをする時はリアクションが気になるけどさ…あいつの場合はなんか違う気がしないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020903
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762020903,
					"content": "それって、聞いていいことなのかな？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762020904
					]
				},
				{
					"id": 762020904,
					"content": "あたしは気にしないわ。聞けば、天の使い一族に多少幻滅すると思うけれど。せいぜい、善良な存在ばかりだっていう思い込みが覆されて、真実を知ることになるだけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020905
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762020905,
					"content": "パイモンの疑問に答えるとね、それはあたしたちが導く相手に共感できるからではないのよ。あたしたちが背負う任務と命令によるものなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020906
					],
					"speakerTitle": "ニコ",
					"speakerSubtitle": "ニコ"
				},
				{
					"id": 762020906,
					"content": "えっ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020907
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762020907,
					"content": "——もっと言うと、天の使いが誕生した時のことから話さないとね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020908
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762020908,
					"content": "天の使いは地上の生きとし生ける全てを愛する使命を授けられたけれど、後の魔神たちとは異なって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020909
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762020909,
					"content": "あたしたちは感情に対する感受性は乏しく、その多くは機械的に天空の命令を遂行していたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020910
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762020910,
					"content": "「教え」だけじゃなく、「導き」もあたしたちの重要な任務…そしてそれは、知恵を失ったかつての仲間たちに残された、数少ない本能の一つでもあるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020911
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762020911,
					"content": "その任務が達成された時、あたしたちはある種の安堵にも似た喜びを得られるのよ。それは、あたしたちが日常で感じられる中で、最も強烈な感情体験とも言えるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020912
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762020912,
					"content": "それって…なんだかかわいそうな気がするぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020913
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762020913,
					"content": "そうかもしれないわね。でも、あたしはそれを憐れむべきことだとは思いたくないわ。たとえ高天の主でさえ、今この瞬間のあたしの気持ちが本物であることを、否定できないのだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020914
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762020914,
					"content": "いずれにせよ、あたしたちは良いことを成し遂げた。そうでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ニコ"
				}
			]
		},
