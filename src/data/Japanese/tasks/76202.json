					}
				]
			},
			"dialogs": [
				{
					"id": 762020301,
					"content": "風が吹き付けてきた。\\n不思議なことに、その風からはツインベリーロールやソマルケーキ、カリカリステーキ、そしてフラワーベリーキャンディの匂いがした。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						762020302
					]
				},
				{
					"id": 762020302,
					"content": "んぐっ！いきなり甘い風が喉に飛び込んできたぞ！ゲホッ、ゲホッ…あれ？ここ…どこだ？ティーポットとティーカップがすごく大きく見えるけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762020303,
					"content": "まさか…オイラたちが小さくなったのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762020304,
					"content": "ニコの魔法みたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762020305
					]
				},
				{
					"id": 762020305,
					"content": "ごめんなさい、動物の役者は呼べなかったの。あたしったら、普段は石の役者ばかり相手にしているから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020306
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762020306,
					"content": "あれ？ニコも小さくなるのか。おまえは大きいままだと思ったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762020307,
					"content": "しゃがんでいても天を衝く巨大な魔女のニコ…？いやいや、あたしは今の姿で十分満足よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020308
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762020308,
					"content": "とにかく、偉大な魔女のお茶会へようこそ！さあ、お茶を淹れましょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ニコ"
				}
			]
		},
		{
			"id": 7620204,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7620203",
							"2"
						],
						"stepId": 7620203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ニコ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 762020401,
					"content": "さっきの話、よく理解できなかった？もう、難しく考えなくていいの。要するに、頑張って宝物を探して、手に入れればいいだけよ。あなたたちの得意分野じゃない！",
