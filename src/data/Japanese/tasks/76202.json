			},
			"dialogs": [
				{
					"id": 762020201,
					"content": "いらっしゃい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020202,
						762020203
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762020202,
					"content": "こんにちは、ニコ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762020204
					]
				},
				{
					"id": 762020204,
					"content": "うわっ、おしゃれで立派な家だな！内装もすっごく綺麗だぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762020205,
					"content": "ふふっ、お目が高いわね。そう言ってもらえると、この数日間、時間を見つけては心を込めてデザインした甲斐があったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020206
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762020206,
					"content": "——もっと言うと、この秘密の小屋が完成した時のことから話さないとね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020207
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762020207,
					"content": "もともと調子がいいうちに、他にもいくつか魔女の小屋を建てようと思っていたのだけれど…誰一人新しいアイデアを出してくれないし、時間が経つうちにやる気がなくなっちゃったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020208
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762020208,
					"content": "「楽しいだけじゃなく、達成感も得られる方法はないかしら…」と考えていたら、ぴかーんとひらめいたのよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020209
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762020209,
					"content": "ま、待て待て！突然答えが出たのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762020210,
					"content": "そんなこと、どうだっていいでしょう？ほら、もう目の前にあるわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020211
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762020211,
					"content": "この扉の向こうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762020212,
					"content": "実は、この扉だけじゃないの。けれど、あながち間違いではないわね。何事にも順序があるし、まずはここから始めましょうか。準備はいい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020213
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762020213,
					"content": "ちょ…ちょっと待ってくれ、喋るのが速すぎて、理解が追いつかないぞ…オイラたちはなにを準備すればいいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762020214,
					"content": "ああ、緊張しないで。何も準備しなくていいのよ。今のは、形式的に聞いてみただけだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020215
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762020215,
					"content": "見たところ…あなたたちは、まどろっこしい説明よりも、探索の過程で楽しさを見出すほうが好きなタイプじゃないかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020216,
						762020217
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762020216,
					"content": "それはそうだけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762020218
					]
				},
				{
					"id": 762020218,
					"content": "ふふっ、嬉しいこと言ってくれるじゃない。それじゃあ本当に、本当に、遠慮なく説明させてもらうわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020219
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762020219,
					"content": "あたしたち天の使いのことは、よく知っているわよね。人を宝探しに導く時のあの満足感ったら…いつやっても、あれには夢中になっちゃうの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020220
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762020220,
					"content": "人のためになることをするのなら、まずは自分の友達のことを優先すべきだって思ったのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020221
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762020221,
					"content": "そこで、ひらめいたの。この小屋を、みんなが楽しめる遊び心いっぱいの場所にするってね。そして、それぞれの部屋に宝物も隠しておいたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020222
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762020222,
					"content": "実を言うとね、数多くの天の使いの中でも、特にあたしは物を隠すのが得意なのよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020223
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762020223,
					"content": "もしあたしが本気で宝箱を埋めて、案内もしなければ、たとえあなたたちでも数か月かけたって見つけられっこないと思うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020224
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762020224,
					"content": "コホン…話が逸れちゃったわね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020225
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762020225,
					"content": "とにかく、あなたたちを困らせるつもりはないし、あたしのささやかな趣味のために、荒野を駆け回る必要もないわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020226
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762020226,
					"content": "この部屋の中で、宝物を象徴する羽根を三枚見つけ出せたらクリアよ！その時は…ふふっ、必ずあたしの前で宝箱を開けてちょうだい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020227
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762020227,
					"content": "わかったぞ！もうお宝が待ちきれないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020228
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762020228,
					"content": "あたしも待ちきれないわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762020217,
					"content": "でも、ニコの説明も聞いておきたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762020218
					]
				},
				{
					"id": 762020203,
					"content": "招待してくれてありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762020204
					]
				}
			]
		},
