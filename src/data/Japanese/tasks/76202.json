			"dialogs": [
				{
					"id": 762020601,
					"content": "いきなり滑り落ちるなんてな…びっくりしたぞ。わぁっ、すっごく大きいぞ…これは…マンドラゴラの彫像か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020602
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762020602,
					"content": "カタカタ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020603
					],
					"speakerTitle": "ドアを調べる"
				},
				{
					"id": 762020603,
					"content": "ごめんなさい、ちょっと待っててね。何か間違えてしまったのかしら…そんなはずはないのだけれど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020604
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762020604,
					"content": "カタッ——カタッ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020605
					],
					"speakerTitle": "ドアを調べる"
				},
				{
					"id": 762020605,
					"content": "動いたぞ！オイラたちを攻撃するつもりみたいだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020606
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762020606,
					"content": "ふう、これでよしっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762021401,
					"content": "ニコ、なに言ってるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762021402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762021402,
					"content": "え？この程度の攻撃、痛くも痒くもないでしょう？まさに旅人の腕の見せ所じゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762021403
					],
					"speakerTitle": "ニコ"
				}
			]
		},
		{
			"id": 7620209,
