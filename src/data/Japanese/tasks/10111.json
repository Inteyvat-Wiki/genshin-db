					"ジャック"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101110401,
					"content": "ハッ…ハッ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110402
					],
					"speakerTitle": "スタンレー"
				},
				{
					"id": 101110402,
					"content": "死ぬかと思った！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110403
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 101110403,
					"content": "確かにあと少しでそうなるところだったね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110404
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101110404,
					"content": "そうだ、君が冒険者のジャックだね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110405
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101110405,
					"content": "そうだけど、君は…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110406
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 101110406,
					"content": "おまえを探してたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110407
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101110407,
					"content": "エリンから伝言を預かっててね。今日は冒険の計画について話し合えそうにないから、また別の日にしようって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110408
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101110408,
					"content": "ああ…そうなんだ。申し訳ない、ここまで来てもらった上に…助けてもらうなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110409
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 101110409,
					"content": "フンッ！お節介なヤツめ！助けてもらわなくとも、このスタンレーなら容易く切り抜けられたんだがな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110410
					],
					"speakerTitle": "スタンレー"
				},
				{
					"id": 101110410,
					"content": "おおっ、おまえがモンドですごく有名な、「燼寂海」に行ったことがある伝説の大冒険者なのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110411
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101110411,
					"content": "そうだ、俺こそがスタンレーだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110412
					],
					"speakerTitle": "スタンレー"
				},
				{
					"id": 101110412,
					"content": "ははっ、こんな伝説級の人に会えるなんて嬉しいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110413
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101110413,
					"content": "じゃあ、みんなこれからどうする？先に進む？それとも戻る？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110414,
						101110417
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101110414,
					"content": "スタンレーさんはどう思う？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110415
					]
				},
				{
					"id": 101110415,
					"content": "#フフ、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOY|INFO_FEMALE_PRONOUN_GIRLE]}よ、お前たちと一緒にいるのはモンドの大冒険者スタンレーだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110416
					],
					"speakerTitle": "スタンレー"
				},
				{
					"id": 101110416,
					"content": "戻る必要がどこにあると？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110419
					],
					"speakerTitle": "スタンレー"
				},
				{
					"id": 101110419,
					"content": "じゃあ全員一致ということで、先に進もう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101110417,
					"content": "ジャックはどう思う？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110418
					]
				},
				{
					"id": 101110418,
					"content": "先に進もう、スタンレーさんもいるし、きっと大丈夫さ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110419
					],
					"speakerTitle": "ジャック"
				}
			]
		},
		{
			"id": 1011106,
			"completionStepIds": [
				1011106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
