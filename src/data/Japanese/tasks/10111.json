			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ウェンティ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101110601,
					"content": "旅人、小さな発見があったんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110602
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101110602,
					"content": "探測器をつけてみてくれるかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110603
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101110603,
					"content": "えっ？スタンレーにも「空想の友達」がいる！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101110604,
					"content": "彼の友達はベテランの戦士みたいだ…体中傷だらけで、表情も毅然としてるね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110605,
						101110608
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101110605,
					"content": "まるで彼の話に出てくる彼自身みたいだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110606
					]
				},
				{
					"id": 101110606,
					"content": "彼の空想の友達は、まさか理想の自分自身だというのかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110607
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101110607,
					"content": "面白い。けど、真相は本当にそうなのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110611
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101110611,
					"content": "じゃあ、俺は先に行くぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110612
					],
					"speakerTitle": "スタンレー"
				},
				{
					"id": 101110612,
					"content": "はい、スタンレーさん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110613
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 101110613,
					"content": "あの、君たちちょっと時間あるかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110614
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 101110614,
					"content": "ん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110615
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101110615,
					"content": "実は数日前、スタンレーさんが酔っぱらって秘密を教えてくれたんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110616
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 101110616,
					"content": "スタンレーさんが当時冒険で使っていた武具はなんと、大英雄ヴァネッサ様の遺物<color=#00E1FFFF>「煌めく勇気の剣」</color>と<color=#00E1FFFF>「輝く意志の盾」</color>だったらしい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110617
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 101110617,
					"content": "しかも、この二つの武具は今もモンドにあって、どうやら<color=#00E1FFFF>ダダウパの谷</color>にあるみたいなんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110618
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 101110618,
					"content": "君たち強いし、一緒にこの二つの武具を探しに行ってくれないかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110619,
						101110621
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 101110619,
					"content": "そんなすごい武具があるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110620
					]
				},
				{
					"id": 101110620,
					"content": "もちろんさ！なんたってあのスタンレーさんなんだから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110623
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 101110623,
					"content": "もしそんなすごいものを見つけたら、きっと両親も僕の冒険者になりたいっていう夢を応援してくれるはずだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110624
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 101110624,
					"content": "今の僕じゃ実力はまだまだだし、両親にも反対されてるけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110625
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 101110625,
					"content": "お願いだ、どうか助けて欲しい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110626
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 101110626,
					"content": "こんな身勝手な考え、スタンレーさんには言えないから…でも使い終わったらすぐ彼に返却するって約束するよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110627
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 101110627,
					"content": "可哀想だな…おい、助けてやろうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110628,
						101110629
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101110628,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110630
					]
				},
				{
					"id": 101110630,
					"content": "吟遊野郎も来るか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110631
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101110631,
					"content": "うーん…そうだね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110632
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101110632,
					"content": "一昨年、人づてに貴重な名酒を手に入れたんだ。武具探しを手伝ってくれたら、その酒を君にあげよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110633
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 101110633,
					"content": "<color=#00E1FFFF>ダダウパの谷</color>だね！？善は急げだ、すぐに出発しよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101110629,
					"content": "見て見ぬふりはできないね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110630
					]
				},
				{
					"id": 101110621,
					"content": "そんなすごい武具をどうして外に？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110622
					]
				},
				{
					"id": 101110622,
					"content": "すごい人は多少変わった癖があるからね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110623
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 101110608,
					"content": "そういえば、彼の話は少しおかしい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110609
					]
				},
				{
					"id": 101110609,
					"content": "おや？君もそう思ってたのかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110610
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101110610,
					"content": "どうやら、スタンレーの話には何か秘密があるみたいだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110611
					],
					"speakerTitle": "ウェンティ"
				}
			]
		}
	]
}