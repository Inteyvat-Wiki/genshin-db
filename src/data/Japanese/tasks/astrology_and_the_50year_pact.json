					"nextDialogs": [
						105000227,
						105000229
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 105000227,
					"content": "さすがパイモン！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000228
					]
				},
				{
					"id": 105000228,
					"content": "相棒として頼もしいだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000231
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 105000231,
					"content": "何か策があるみたいですね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000232
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105000232,
					"content": "おう、すぐ戻るから待っとけ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 105000229,
					"content": "まさかスライムを食べたくて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000230
					]
				},
				{
					"id": 105000230,
					"content": "あーっ、細かいことは気にするな。",
