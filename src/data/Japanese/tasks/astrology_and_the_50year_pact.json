			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"モナ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105000902,
					"content": "久しぶり。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000904
					]
				},
				{
					"id": 105000903,
					"content": "モナだ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000904
					]
				},
				{
					"id": 105000901,
					"content": "あなたの秘密をあっさりと見抜いた私のこと、まだ思い出せないんですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000902,
						105000903
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105000904,
					"content": "あっ、思い出したぞ！あの占星術師だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000905
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 105000905,
					"content": "そう、そうです、アストローギスト·モナ·メギストスです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000906
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105000906,
					"content": "今回ここに来たのは、私の師匠の箱を取り戻すため一緒にモンドへ来てもらいたいからです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000907
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105000109,
					"content": "あれは師匠とその友人が50年前に交わした約束。ただ師匠は歳で、体も老いてしまったので、私が代わりに取りに行くことになりまして。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000110
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105000110,
					"content": "箱を取り戻すって…オイラたちとは関係ないだろ？なんでオイラたちも一緒に行かなきゃいけないんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 105000111,
					"content": "それは…ほら、箱を保管してる人と勝負するためです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000112
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105000911,
					"content": "実力を証明したいのか…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000912
					]
				},
				{
					"id": 105000913,
					"content": "つまり、メンツの問題だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000914
					]
				},
				{
					"id": 105000112,
					"content": "師匠とその友人は生涯をかけて神秘学について競い合ってきました。ですが、勝負がつかなかったそうなんです。だから今回、私が勝てたら師匠よりもすごいってことになるじゃないですか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000113,
						105000115
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105000114,
					"content": "コホン、正確に言うと、「占星術」の実力と地位を証明したいんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000117
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105000116,
					"content": "何言ってるんですか！私はこれをきっかけに、自分の「占星術」の実力と地位を証明したいんです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000117
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105000117,
					"content": "ですが、私が占ってみたところ、師匠の友人は現在モンドにいないみたいなのです。いま箱を保管してるのはその継承者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000118
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105000118,
					"content": "きっと私のように、その継承者も自分の師匠より優れていることでしょう。決して油断はできません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000119
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105000918,
					"content": "…占いはできないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000919
					]
				},
				{
					"id": 105000920,
					"content": "#どうして急に{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}の事を？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000921
					]
				},
				{
					"id": 105000119,
					"content": "今回の勝負は何が何でも勝ちたい！と色々考えた結果、あなたのことを思い出したのです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000120,
						105000122
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105000121,
					"content": "なんで急にこいつのことを思い出したんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 105000123,
					"content": "師匠から受け継いだ知識は代々伝承していかなければなりません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000124
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105000124,
					"content": "もし向こうの継承者に会う時、私が弟子を連れていったら、それだけで一歩リードできてるじゃありませんか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000125
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105000924,
					"content": "断る。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000926
					]
				},
				{
					"id": 105000925,
					"content": "いつモナの弟子に？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000926
					]
				},
				{
					"id": 105000125,
					"content": "それにあなたはモンドの英雄、肩書きとしては申し分なしです。だから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000126,
						105000127
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105000128,
					"content": "だから本当の弟子じゃなくて、弟子のふりをしてくれればいいんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000129
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105000129,
					"content": "ふふ、それに私と一緒に箱を取り戻すことは、あなたにとってもメリットがあるんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000130
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105000130,
					"content": "向こうの継承者に会ったら、知識の交流をすることになります。そしたら、あなたの運命がよりはっきり見えるようになるかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000131
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105000131,
					"content": "今まではっきりと見えなかったことが、見えるようになるなんてこともあります。たとえば神や家族のこと、その答えが見つかるかもしれませんよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000132
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105000133,
					"content": "条件としては申し分ない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000135
					]
				},
				{
					"id": 105000134,
					"content": "…付き合うしかない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000135
					]
				},
				{
					"id": 105000132,
					"content": "た、確かに国をひとつずつ探していく手間が省けるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000133,
						105000134
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 105000135,
					"content": "ふっふ～ん、それこそ賢い選択です。では参りましょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000136
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105000136,
					"content": "でもここを出る前に、ちょっと寄りたいところがあるんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "モナ"
				}
			]
		}
	]
}