					"nextDialogs": [
						105000317
					]
				},
				{
					"id": 105000317,
					"content": "苦労したのはオイラたちなのに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000318
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 105000318,
					"content": "弟子は弟子らしくするのです、師匠から手柄を横取りしちゃいけません。",
