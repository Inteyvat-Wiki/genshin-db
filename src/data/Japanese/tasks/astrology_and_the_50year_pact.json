			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"朱店主"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105000201,
					"content": "（こんなところに宿屋を開くなんて、人気が出ないのも当然だな…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 105000202,
					"content": "モナさん、ちょうど良いところに来てくれました！ここへ来る途中、玉石の指輪を見ませんでしたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000203
					],
					"speakerTitle": "朱店主"
				},
				{
					"id": 105000203,
					"content": "えっと、玉石の指輪ですか？見てないですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000204
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105000204,
					"content": "どうしよう…私の大事な指輪がスライムに呑み込まれてしまったんです。あれは母がくれたものなのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000205
					],
					"speakerTitle": "朱店主"
				},
				{
					"id": 105000205,
					"content": "ん？モナがいるし、心配いらないだろ。彼女の占星術なら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 105000206,
					"content": "ダメですよ、占星術は真実を洞察して運命を見通すための由緒ある知識。無闇やたらと使うようなものじゃありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000207
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105000207,
					"content": "でも、ここの店主には世話になったんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 105000208,
					"content": "これはプライド、つまり心の問題です。占星術ならどんな問題でも解決できると思っていたら、占星術師はいずれ星空に見捨てられてしまいます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000209
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105000209,
					"content": "結果、占いは未来を導く力を失い、二度と迷霧を見通せなくなります。だから、この信条を曲げることは決してできません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000210
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105000210,
					"content": "そんなすごい能力を持っていて金儲けに使わないなんて、もったいないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 105000211,
					"content": "はぁ、協力してくれたらお礼に2万モラを用意していたんですが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000212
					],
					"speakerTitle": "朱店主"
				},
				{
					"id": 105000212,
					"content": "に、2万ですか…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000213,
						105000214
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105000213,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000215
					]
				},
				{
					"id": 105000215,
					"content": "いえ、なんでもありませんよ？ただ、こうも簡単に2万モラが手に入るなんて、指輪を拾った人はラッキーだなと思っただけです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000216,
						105000217
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105000216,
					"content": "占星術師のプライドを語ったばかり。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000218
					]
				},
				{
					"id": 105000218,
					"content": "こほん…それはそうですが、でも…店主が汗水たらして稼いだお金を出してまで探したい指輪です、きっと何か特別な思い入れがあるのでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000219
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105000219,
					"content": "このまま放っておくのもよくありませんね、うん。探してあげましょう。占星術を使わなくとも、きっと方法があるはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000220
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105000220,
					"content": "モナの考えがなんとなく読めてきたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000221
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 105000221,
					"content": "#{NICKNAME}、この件はあなたに任せます！これは師匠から弟子への最初の任務です！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000222,
						105000223
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105000222,
					"content": "仕方がない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000224
					]
				},
				{
					"id": 105000224,
					"content": "う～ん…スライムに呑み込まれたっていうなら、「元素の餌」で周りのスライムを誘い出してみるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000225
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 105000225,
					"content": "覚えてるか？ディルックの旦那のとこで精製した「元素の餌」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000226
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 105000226,
					"content": "実は…へへ、ちょっとくすねておいたんだ！",
