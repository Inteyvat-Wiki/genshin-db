						230000601
					]
				},
				{
					"id": 230000601,
					"content": "うん？雷神に庇護された稲妻か…キャラバンの人から聞いた話では、そこで神が下した「目狩り令」に逆らった人々がいたようだ。いい題材になりそうだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000602
					],
					"speakerTitle": "マッダフ"
				},
				{
					"id": 230000602,
					"content": "とはいえ、キャラバンから聞けたのは、断片的で信じがたい噂話ばかりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000603
					],
					"speakerTitle": "マッダフ"
				},
				{
					"id": 230000603,
					"content": "例えば…「とある異邦人がファデュイの執行官に決闘を申し込み、一太刀のもと相手を灰にしてしまった！」とか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000604,
						230000605
					],
					"speakerTitle": "マッダフ"
				},
				{
					"id": 230000604,
					"content": "確かに決闘で勝った…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000606
					]
				},
				{
					"id": 230000606,
					"content": "#ええと、そして「{M#彼}{F#彼女}は将軍の圧政に立ち向かい、あの『無想の一太刀』から無傷で生還した！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000607,
						230000608
					],
					"speakerTitle": "マッダフ"
				},
				{
					"id": 230000607,
					"content": "確かに生還したけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000609
					]
				},
				{
					"id": 230000609,
					"content": "#なんてこった！じゃあこれはどうだ？…「{M#彼}{F#彼女}は千手百目神像から力を引き出し、神の意志をも変えてみせた…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000610,
						230000611
					],
					"speakerTitle": "マッダフ"
				},
				{
					"id": 230000610,
					"content": "確かに将軍の心を変えた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230000611,
					"content": "勝利の鍵はみんなの「願い」だった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230000608,
					"content": "その『一太刀』を受け止めたのは違う人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000609
					]
				},
				{
					"id": 230000605,
					"content": "裁きを下したのは将軍だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000606
					]
				}
			]
		},
