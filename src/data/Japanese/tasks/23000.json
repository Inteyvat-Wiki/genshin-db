			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"マッダフ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230000301,
					"content": "まったく、まだ話も始まってないのに、お客が全員行ってしまったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000302
					],
					"speakerTitle": "マッダフ"
				},
				{
					"id": 230000302,
					"content": "まずいな、このままだと本当にコーヒーさえ買えなくなってしまう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000303
					],
					"speakerTitle": "マッダフ"
				},
				{
					"id": 230000303,
					"content": "何かトラブルでもあったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000304
					]
				},
				{
					"id": 230000304,
					"content": "えっと、君は…旅人？はぁ…見ての通り、僕は普段このカフェで物語をみなに聞かせて、コーヒー代を稼いでいる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000305
					],
					"speakerTitle": "マッダフ"
				},
				{
					"id": 230000305,
					"content": "しかし、最近は聞きに来る人も段々減ってきていて…このままだと、僕はコーヒーさえ買えなくなるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000306,
						230000307
					],
					"speakerTitle": "マッダフ"
				},
				{
					"id": 230000306,
					"content": "モンドの吟遊詩人みたいなものかな…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000308
					]
				},
				{
					"id": 230000308,
					"content": "えっと…この目で見たことはないけど…聞く限りは、近いかもしれないかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000309
					],
					"speakerTitle": "マッダフ"
				},
				{
					"id": 230000309,
					"content": "でもさ、いくら古代英雄の伝説が面白くたって、こう毎日語ったら飽きるよな…やはり、何か新しい話を探さないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000310
					],
					"speakerTitle": "マッダフ"
				},
				{
					"id": 230000310,
					"content": "はぁ、できればスメール以外の話がいいな。一つには珍しくて面白い、二つには…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000311
					],
					"speakerTitle": "マッダフ"
				},
				{
					"id": 230000311,
					"content": "脚色しやすくて、それを誰にもツッコまれないものがいい…みんな聞いたことがない話なら、好きにできるもんな…おっと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000312
					],
					"speakerTitle": "マッダフ"
				},
				{
					"id": 230000312,
					"content": "でもその前に、僕自身が話す物語について理解しないとな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000313
					],
					"speakerTitle": "マッダフ"
				},
				{
					"id": 230000313,
					"content": "ほら、実は僕だって、世界各地の物語をそれなりに集めたんだ。風魔龍についてとか、送仙儀式のこととか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000314
					],
					"speakerTitle": "マッダフ"
				},
				{
					"id": 230000314,
					"content": "けど、これらの物語はすべて他人から聞いたもの…絶対に尾ひれがついているから、鵜呑みにするわけにもいかないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000315
					],
					"speakerTitle": "マッダフ"
				},
				{
					"id": 230000315,
					"content": "旅人、冒険者協会から聞いたんだが、君はあちこちを旅している…そうだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000316
					],
					"speakerTitle": "マッダフ"
				},
				{
					"id": 230000316,
					"content": "僕に聞かせてくれないか？君が世界各地で広めた見聞を、ありのまま！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000317
					],
					"speakerTitle": "マッダフ"
				},
				{
					"id": 230000317,
					"content": "そうすれば、僕も集めた物語にほんの少し手を加えつつ、事実からあまりかけ離れないようにできる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000318
					],
					"speakerTitle": "マッダフ"
				},
				{
					"id": 230000318,
					"content": "もちろん、物語で得たぶんの報酬は、君にも分けてあげるから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000319,
						230000321
					],
					"speakerTitle": "マッダフ"
				},
				{
					"id": 230000319,
					"content": "まあ、それなら大丈夫…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000320
					]
				},
				{
					"id": 230000320,
					"content": "じゃあ頼むよ！どの見聞を聞かせてくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000325
					],
					"speakerTitle": "マッダフ"
				},
				{
					"id": 230000325,
					"content": "物語ならどこでも聞けるんじゃない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000326
					]
				},
				{
					"id": 230000326,
					"content": "それはそうだけど…僕も、世界各地の物語をそれなりに集めたんだ。風魔龍についてとか、送仙儀式のこととか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000327
					],
					"speakerTitle": "マッダフ"
				},
				{
					"id": 230000327,
					"content": "でも、これらの物語が僕の耳に入るまでに、どれだけの人を経たかなんてわからないだろ？絶対に尾ひれがついているし、鵜呑みにはできない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000328
					],
					"speakerTitle": "マッダフ"
				},
				{
					"id": 230000328,
					"content": "君のような、実際に世界各地を駆け巡ってきた旅人が教えてくれるからこそ、僕の集めた物語に、事実からかけ離れすぎない程度の脚色ができる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000321
					],
					"speakerTitle": "マッダフ"
				},
				{
					"id": 230000321,
					"content": "尾ひれっていうのは、例えばどの程度？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000322
					]
				},
				{
					"id": 230000322,
					"content": "それは…まあその、聞けばでたらめってわかる程度…かな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000323
					],
					"speakerTitle": "マッダフ"
				},
				{
					"id": 230000323,
					"content": "あはは…例えば背中に翼を生やした騎士が、剣を手にたった一人で魔神を鎮圧した、とか…そのあたりはまた後で…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000324
					],
					"speakerTitle": "マッダフ"
				},
				{
					"id": 230000324,
					"content": "じゃあ、はじめようか。どの見聞を聞かせてくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マッダフ"
				},
				{
					"id": 230000307,
					"content": "璃月の講談師みたいなものかな…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000308
					]
				}
			]
		},
		{
			"id": 2300004,
			"completionStepIds": [
				2300001
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
