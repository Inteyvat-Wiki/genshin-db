			"dialogs": [
				{
					"id": 230001701,
					"content": "よお！君も来ていたのか、旅人。どうだった、今日の物語は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001702,
						230001703
					],
					"speakerTitle": "マッダフ"
				},
				{
					"id": 230001702,
					"content": "なかなか面白かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230001704
					]
				},
				{
					"id": 230001704,
					"content": "はは、他の客もそう言ってくれた。新たな時代には、新たな英雄や物語が現れる…これは本当なんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001705
					],
					"speakerTitle": "マッダフ"
				},
				{
					"id": 230001705,
					"content": "彼らのおかげで、僕らも仕事を続けていけるわけだ…もちろん、君にも感謝している。これで、ようやく少しはマシなコーヒーを飲めそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001706
					],
					"speakerTitle": "マッダフ"
				},
				{
					"id": 230001706,
					"content": "素材を提供してくれて感謝する。どうか、この報酬を受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001707
					],
					"speakerTitle": "マッダフ"
				},
				{
					"id": 230001707,
					"content": "これからも、何か物語があればぜひ聞かせてほしい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マッダフ"
				},
				{
					"id": 230001703,
					"content": "悪くない物語だった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230001704
					]
				}
			]
