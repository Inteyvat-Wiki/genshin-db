			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"マッダフ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230000500,
					"content": "以前、璃月にいた時…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000501
					]
				},
				{
					"id": 230000501,
					"content": "ほう？璃月か…キャラバンの人から聞いた話では、そこでは神の逝去をきっかけに、諸勢力が闘争を繰り広げたと聞いたぞ。いい題材になりそうだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000502
					],
					"speakerTitle": "マッダフ"
				},
				{
					"id": 230000502,
					"content": "とはいえ、キャラバンから聞けたのは、断片的で信じがたい噂話ばかりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000503
					],
					"speakerTitle": "マッダフ"
				},
				{
					"id": 230000503,
					"content": "例えば…「とある旅人が送仙儀式を主催し、各勢力が我先に取り入ろうと躍起になった…」とか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000504,
						230000505
					],
					"speakerTitle": "マッダフ"
				},
				{
					"id": 230000504,
					"content": "確かに送仙儀式に参加していた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000506
					]
				},
				{
					"id": 230000506,
					"content": "#ええと、そして…「{M#彼}{F#彼女}は渦の魔神と海上で相対し、かの群玉閣さえ凄まじい剣気に圧されて、そのまま海に落ちてしまった！」…とも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000507,
						230000508
					],
					"speakerTitle": "マッダフ"
				},
				{
					"id": 230000507,
					"content": "確かに魔神と対峙していた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000509
					]
				},
				{
					"id": 230000509,
					"content": "#なんてこった！じゃあこれはどうだ？…「最後に、{M#彼}{F#彼女}は己の力で仙人と凡人の間のわだかまりを解消し、璃月港が新たな時代に進むきっかけを作った！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000510,
						230000511
					],
					"speakerTitle": "マッダフ"
				},
				{
					"id": 230000510,
					"content": "確かにわだかまりを解消した…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230000511,
					"content": "璃月にいた全員の努力のおかげだった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230000508,
					"content": "群玉閣こそが、魔神を退ける鍵だった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000509
					]
				},
				{
					"id": 230000505,
					"content": "実は、誰かさんと一緒に使い走りをしていた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000506
					]
				}
			]
		},
