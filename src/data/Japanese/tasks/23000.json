			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"マッダフ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230000400,
					"content": "以前、モンドにいた時…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000401
					]
				},
				{
					"id": 230000401,
					"content": "ふむ？風神の加護を受けたモンドか…キャラバンの人から聞いた話では、そこには嵐を巻き起こす巨龍がいたそうだね？これはいい題材になるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000402
					],
					"speakerTitle": "マッダフ"
				},
				{
					"id": 230000402,
					"content": "とはいえ、キャラバンから聞けたのは、断片的で信じがたい噂話ばかりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000403
					],
					"speakerTitle": "マッダフ"
				},
				{
					"id": 230000403,
					"content": "例えば…「背中に翼を生やした旅人が空を駆け、一万メートルの高空で巨龍を追いかけた！」とか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000404,
						230000405
					],
					"speakerTitle": "マッダフ"
				},
				{
					"id": 230000404,
					"content": "確かに空中で追いかけてた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000406
					]
				},
				{
					"id": 230000406,
					"content": "#えっと、そして…「{M#彼}{F#彼女}は一人で教会に潜入し、風神の偉大な力が宿る強大な武器を盗んだ！」…とも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000407,
						230000408
					],
					"speakerTitle": "マッダフ"
				},
				{
					"id": 230000407,
					"content": "確かに教会に潜入したけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000409
					]
				},
				{
					"id": 230000409,
					"content": "#なんだって…！じゃあ、これはどうだ？「最後に、{M#彼}{F#彼女}は巨龍の弱点を見破り、古き傷跡を砕き、龍血を浴びて不死身となった！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000410,
						230000411
					],
					"speakerTitle": "マッダフ"
				},
				{
					"id": 230000410,
					"content": "確かにどこかを狙う必要があった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230000411,
					"content": "心を蝕む毒血を浄化しただけ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230000408,
					"content": "「天空のライアー」は武器なんかじゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000409
					]
				},
				{
					"id": 230000405,
					"content": "実は、風の翼を使ってた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000406
					]
				}
			]
		},
		{
			"id": 2300005,
			"completionStepIds": [
				2300001
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
