			},
			"dialogs": [
				{
					"id": 402270101,
					"content": "うーん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270102
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 402270102,
					"content": "よう！アイノ、イネファ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402270103,
					"content": "こんにちは、旅人さん、パイモンさん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270104
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 402270104,
					"content": "オイラたち、ネフェルからの依頼で出展者たちの登録作業を任されてるんだ。カチャカチャ・クルムカケ工房も出展者だよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402270105,
					"content": "はい、アイノは今「パチパチ守衛団」の最終チューニングを行っています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270106
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 402270106,
					"content": "パチパチ…おお、それが工房の展示物なんだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402270107,
					"content": "モグラなどの動物がよく工房に物を盗みに来るので、アイノは工房の資産を守るために、モグラたちを模した防衛装置一式を製作したのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270108
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 402270108,
					"content": "以前にも一度テストを行い、「非常に良好」という結果が出たので、アイノは装置一式を全面的にアップグレードし、今回出展することに決めたようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270109
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 402270109,
					"content": "じゃあ出品するのはアイノの作品なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402270110,
					"content": "工房からの直接注文を除き、アイノが自分の作品を販売することは滅多にありません。取引に出すのは設計図ですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270111
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 402270111,
					"content": "なるほどな…ところで！おまえたち、移動の準備はできてるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402270112,
					"content": "ヤフォダが呼んでたぞ。あいつ、おまえたちのためにいい場所を取っといてくれたんだぜ。ずっと空けたままだと面倒になるかもしれないから、早く来てほしいんだってさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402270113,
					"content": "もう～、言ったでしょ。全部ちゃんとチューニングしてからじゃないと運べないの！いくら急かしたって無駄だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270114
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 402270114,
					"content": "アイノがそんなに真剣になるなんて珍しいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402270115,
					"content": "近頃の工房は深刻な資金不足問題に直面しています。今回の出展には経済状況を改善したいという意図があるため、この慎重さは合理的であると言えます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270116
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 402270116,
					"content": "資金不足…？なにかすっごくお金のかかる研究でもしてるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402270117,
					"content": "不足しているのは「研究資金」ではなく、「甘いもの資金」です。甘いものの過剰購入により研究資金に穴が生じた事例が、計四十七回も確認されています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270118
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 402270118,
					"content": "そこで私は、工房運営の観点から、「研究資金」と「甘いもの資金」を区分し、勝手な流用を禁じました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270119
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 402270119,
					"content": "しかし近頃、アイノはまるまる一ヶ月分の「甘いもの資金」を使い切ってしまったのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270120,
						402270121
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 402270120,
					"content": "なるほどね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402270122
					]
				},
				{
					"id": 402270122,
					"content": "完成！パチパチ守衛団、しっかり活躍してね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270123
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 402270123,
					"content": "会場への案内をお願いします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イネファ"
				},
				{
					"id": 402270121,
					"content": "さすがアイノ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402270122
					]
				}
			]
		},
