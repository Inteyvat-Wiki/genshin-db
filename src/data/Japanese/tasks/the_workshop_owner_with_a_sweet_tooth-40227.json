			"dialogs": [
				{
					"id": 402270201,
					"content": "アイノとイネファを見本市会場まで案内した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402270202
					]
				},
				{
					"id": 402270202,
					"content": "えーっと…実演用の足場はここに置こうっと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270203
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 402270203,
					"content": "アイノの新作防衛装置…気になるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402270204,
					"content": "いつでも遊びに来てよ！絶対キミたちをガッカリさせないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270205
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 402270205,
					"content": "ご案内ありがとうございました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270206
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 402270206,
					"content": "どういたしましてだぞ！出展者はアイノとイネファで登録していいんだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402270207,
					"content": "…アイノは出展者とは言えません。アイノは賑やかな雰囲気が好きではないので、見本市が始まり次第工房に戻り、私が店番をする予定です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270208
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 402270208,
					"content": "そっか、そうだよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
