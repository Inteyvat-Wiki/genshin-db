			"dialogs": [
				{
					"id": 706970101,
					"content": "旅人！まさかこんなとこで会えるなんて思てへんかったわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970102
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 706970102,
					"content": "うち、こんな寒いところは初めてやねん…あれもこれもみんな新鮮や。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970103
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 706970103,
					"content": "雪合戦やろ？雪だるまやろ？そや、漫画もあったなぁ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970104
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 706970104,
					"content": "稲妻でめっちゃ人気の『炎魂戦記』がモンドでも読まれてるなんて、びっくりしたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970105
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 706970105,
					"content": "ナタから来た知り合いと漫画の話でめっちゃ盛り上がってな、勢いで漫画の登場人物の模型作ってしもてん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970106
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 706970106,
					"content": "そういや、旅人は『炎魂戦記』って知ってる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970107
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 706970107,
					"content": "宵宮と「炎魂戦士特戦隊」について話した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706970108
					]
				},
				{
					"id": 706970108,
					"content": "ええっ、あんたも好きなん！？めっちゃ嬉しいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970109
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 706970109,
					"content": "よかったら、この模型もらってくれへん？「炎魂戦士特戦隊」に炎魂戦士フィエテナ——ぴったりやろ！",
					"roleType": "TALK_ROLE_NPC",
