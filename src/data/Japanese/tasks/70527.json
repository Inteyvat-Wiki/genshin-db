			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ナザファリン",
					"サラ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705270101,
					"content": "こんにちはー！どうしたんだ？なにか美味しいもんの話でもしてるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270102,
						705270103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705270102,
					"content": "こんにちは。サラ、ナザファリン。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705270107
					]
				},
				{
					"id": 705270107,
					"content": "またお会いしましたね、お二人とも。確かに食べ物に関する話をしていたのですが…はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270108
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 705270108,
					"content": "なにがあったんだ？言ってみろよ。オイラたちが手伝えることかもしれないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705270109,
					"content": "#美味しいもんに関係することなら、オイラたち絶対に黙って見てるだけなんてことはしないからな！えへへ、そうだろ、{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270110,
						705270111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705270110,
					"content": "そう、美味しいもののために！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705270112
					]
				},
				{
					"id": 705270112,
					"content": "ああ、クラクサナリデビ様よ。このお二人は、相変わらずとてもお優しいのですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270113
					],
					"speakerTitle": "ナザファリン"
				},
				{
					"id": 705270113,
					"content": "前回、困っていたところをお二人に助けていただいた後、私はスメールに戻って、璃月の調味料市場に関する研究レポートをまとめました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270114
					],
					"speakerTitle": "ナザファリン"
				},
				{
					"id": 705270114,
					"content": "ただ、それがまさか有名なサングマハベイ様のお眼鏡にかなうとは思ってもいませんでした。彼女は私が研究した調味料のレシピを買い取りたいと、そうおしゃってくださったのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270115
					],
					"speakerTitle": "ナザファリン"
				},
				{
					"id": 705270115,
					"content": "あの心優しい大商人は、今後の研究にも出資してくれるとおっしゃってくれました！ああ、なんと幸運でしょう！私は迷うことなく、すぐそれに応じました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270116
					],
					"speakerTitle": "ナザファリン"
				},
				{
					"id": 705270116,
					"content": "そして、友人のパルヴァネにもこのことを手紙で伝えました。彼女も私の決断を応援してくれています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270117
					],
					"speakerTitle": "ナザファリン"
				},
				{
					"id": 705270117,
					"content": "つまり、今はモンドで調味料の研究をしてるってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705270118,
					"content": "ええ、パイモン様は話の要点を掴むのが早いですね。本来なら、今ごろはもうモンドで調味料の研究を始めている予定だったのですが、ただ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270119
					],
					"speakerTitle": "ナザファリン"
				},
				{
					"id": 705270119,
					"content": "ナザファリンさんは、鹿狩りに協力してもらいたいそうです。こちらが出す料理にその秘密のレシピを入れて、お客さんに食べていただきたいと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270120
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 705270120,
					"content": "ですが鹿狩りには、レストランとしての基準があります。新たな調味料を入れてしまえば、多くの常連さんから苦情を言われてしまうでしょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270121
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 705270121,
					"content": "はぁ…実はお二人がここに来るまで、私たちは何度も話し合いをしたのですが、特に良い案も出てこず…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270122
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 705270122,
					"content": "ジン団長なら、こういう複雑な問題を解決するのが得意そうなので、お願いしてみようかとも考えましたが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270123
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 705270123,
					"content": "待て待て！ジン団長は忙しいから、こんな些細なことで迷惑かけちゃダメだぞ！こういうのは、オイラたちに任せとけ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705270124,
					"content": "ああ、以前も言いましたが、お二人はやはりこのナザファリンを救いに来た大英雄なのですね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270125
					],
					"speakerTitle": "ナザファリン"
				},
				{
					"id": 705270125,
					"content": "助かりました。それでは、さっそくこの鍋をお受け取りください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270126
					],
					"speakerTitle": "ナザファリン"
				},
				{
					"id": 705270126,
					"content": "前回と同じように調味料を作り、料理に加えた後、ご友人に試食してもらえればと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270127
					],
					"speakerTitle": "ナザファリン"
				},
				{
					"id": 705270127,
					"content": "へへっ、じゃあ前と同じで、まずはこの最高の仲間であるオイラが試食してやるぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705270111,
					"content": "まあ、パイモンのために。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705270112
					]
				},
				{
					"id": 705270103,
					"content": "こんにちは。この人は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705270104
					]
				},
				{
					"id": 705270104,
					"content": "こんにちは。ああ、クラクサナリデビ様よ。この方々は、私のことを覚えていらっしゃらないのでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270105
					],
					"speakerTitle": "ナザファリン"
				},
				{
					"id": 705270105,
					"content": "私の存在など、まるで砂粒のように…風に吹き飛ばされてしまったと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270106
					],
					"speakerTitle": "ナザファリン"
				},
				{
					"id": 705270106,
					"content": "ですが、私は覚えております。以前、お二人に璃月で調味料作りを手伝っていただいたこと、それから皆さんに試食をしていただいたご恩を！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270107
					],
					"speakerTitle": "ナザファリン"
				}
			]
		}
	]
}