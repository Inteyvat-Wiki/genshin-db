			"dialogs": [
				{
					"id": 401480101,
					"content": "おう、今日も頼んだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480102
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401480102,
					"content": "今までの経験もあり、あなたとパイモンはこれまで以上に手際よく仕事をこなした…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401480103
					]
				},
				{
					"id": 401480103,
					"content": "おお…ますます手際がよくなってきたな。これならもうどんな厄介なお客が来ようと問題にはなら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480104
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401480104,
					"content": "——ストップ！おまえがそう言うと、なんか面倒なことが起こる気がするんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401480105,
					"content": "ハッ。そんなこと、あるわけないだろ！俺は別に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480106
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401480106,
					"content": "——ガッハハハハハッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480107
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401480107,
					"content": "いやぁ、まさか璃月で会えるとは思わなかったぜ！えっと、こういうのなんて言うんだっけか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480108
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401480108,
					"content": "「邂逅相遇」だ、親分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480109
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 401480109,
					"content": "そうだそうだ、それだよ！だよな——綾人の兄貴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480110
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401480110,
					"content": "ふふ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480111
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 401480111,
					"content": "——牛使い野郎！なんでおまえが！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401480112,
					"content": "あん？お前ぇは…「空を翔ける白鉄チビ助」？それにダチ公じゃねぇか！今日はツイてるぜ、こんなに多くのダチに会えるなんてなぁ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480113
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401480113,
					"content": "おまえ、帰ったらしばらく働いて金を集めるって言ってたよな…なんでまた来たんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401480114,
					"content": "ガハハッ、俺様の腕がありゃ、金儲けなんてやろうと思えばすぐにできんだろ？今回は美味いもんを飲み食いしに来たんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480115
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401480115,
					"content": "ゴホン…それとついでに、玉将が璃月でどうしてるか見てやろうと思ってな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480116
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401480116,
					"content": "（忍が目で合図をしてきた…今は追求しないでおこう…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480117
					]
				},
				{
					"id": 401480117,
					"content": "じゃあ綾人さんはどうして？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480118
					]
				},
				{
					"id": 401480118,
					"content": "…少し前に璃月で「虫相撲大会」を開催した人がいると聞いて、せっかくなので観にきたのです。残念ながらもう終わっていたようですが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480119
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 401480119,
					"content": "なにぃ？あの大会を見逃すなんてよ！そりゃもったいなすぎるだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480120
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401480120,
					"content": "ええ。しかし幸い一斗くんに会えましたから、当時の盛況ぶりが聞けそうですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480121
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 401480121,
					"content": "ガハハ！別に構わねぇぜ。食いながら話そう。ここの料理人は？早く料理人を呼んでこい。ダチたちにご馳走を用意するからよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480122
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401480122,
					"content": "#{M#俺}{F#私}が料理人だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480123
					]
				},
				{
					"id": 401480123,
					"content": "…は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480124
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401480124,
					"content": "おい、牛使い野郎はよく本に出てくるみたいな、「手で合図したら誰かが出てきてくれる」ってシチュエーションを真似したいだけだと思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401480125,
					"content": "…料理長もいるけどね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480126
					]
				},
				{
					"id": 401480126,
					"content": "あぁ…ガハハッ！ダチ公！冗談がうまいじゃねぇか。なら早くその料理長を出してくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480127
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401480127,
					"content": "あなたとパイモンは厨房に戻り、言笑に経緯を説明して表に出てきてほしいと頼んだ…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401480128
					]
				},
				{
					"id": 401480128,
					"content": "えぇと…それで、お客さんは何を注文したいんだ？賓客を喜ばせたいなら「金玉満堂」や「繁絃急管」があるが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480129
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401480129,
					"content": "…親分、予算のことも忘れるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480130
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 401480130,
					"content": "あ、ああ…えぇっと…もっとよ…こう…気取ってねぇようなやつは無いか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480131
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401480131,
					"content": "気取ってない？そうだな…足るを知り、常に楽しむと書いて「知足常楽」という料理がある。この料理なら、香り豊かで味わい深く、たらふく食えるうえに、安くて美味い料理だが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480132
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401480132,
					"content": "「知足常楽」？いい名前だぜ！こりゃご馳走に違えねぇ…ならそれに決めた！ここにいるのはみんなダチ公だ、派手な料理で着飾る必要なんざねぇ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480133
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401480133,
					"content": "一斗くんは見る目がありますね。あまりにも大げさに作り込まれた料理は、私も好まないのです。ふむ…これが知己というものでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480134
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 401480134,
					"content": "…チキ？ガハハッ！そうだ！チキだよチキ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480135
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401480135,
					"content": "マジか…まぁ、おまえらが楽しければいいや…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
