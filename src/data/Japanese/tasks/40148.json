			"dialogs": [
				{
					"id": 401489701,
					"content": "「天地鳴動」、「百花は一刀に如かず」…璃月にもこれほど多くの虫相撲の強者がいたとは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401489702
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 401489702,
					"content": "本気で虫相撲を観にきたわけじゃないよね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401489703
					]
				},
				{
					"id": 401489703,
					"content": "ふふっ、だとすれば、私は相当出遅れたことになりますね。ただ、公務での訪問の合間に気分転換で出歩いているだけですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401489704
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 401489704,
					"content": "海灯祭の時は会えなかったね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401489705
					]
				},
				{
					"id": 401489705,
					"content": "旅には人それぞれ、こだわりというものがあります。祭りを楽しむ者もいれば、人混みを避けたがる者もいるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401489706
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 401489706,
					"content": "そしてそんな時だからこそ、このような面白い出来事に巡り会えました。包んでいただいた豆腐については…そうですね、あとでトーマに食べてもらいましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "神里綾人"
				}
			]
