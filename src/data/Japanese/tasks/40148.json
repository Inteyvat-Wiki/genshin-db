						],
						"pointId": 310400536
					}
				]
			},
			"dialogs": [
				{
					"id": 401480201,
					"content": "お…お待たせ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401480202,
					"content": "ほほ～う、これが「知足常楽」か？腹いっぱいになりそうな量だな、いいじゃねぇか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480203
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401480203,
					"content": "ほらほらダチ公、お前も座れって。ここにいるのはみんなダチだ！遠慮なんていらねぇぞ！じゃあさっそく…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480204
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401480204,
					"content": "ゴホン！親分、「郷に入っては郷に従え」と言うだろう。璃月の食卓での礼式に従い、ここはまず主賓に味わってもらうべきでは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480205
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 401480205,
					"content": "んん？忍、お前そういう面倒な規則みたいなのが大嫌いじゃなかったか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480206,
						401480207
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401480206,
					"content": "#今は{M#俺}{F#私}もゲストだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480208
					]
				},
				{
					"id": 401480208,
					"content": "おお？ダチ公まで…そうか～あまりにいい匂いで我慢できなかったんだろ～？よし！お前ぇらがそう言うなら、俺様が一番最後に食べるぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480209
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401480209,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480210
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 401480210,
					"content": "あなたとパイモン、綾人、忍は順番に箸を進め、皿にのった「お肉」はかなり減ってきた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401480211
					]
				},
				{
					"id": 401480211,
					"content": "…ふふっ、そういうことでしたか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480212
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 401480212,
					"content": "——俺様の番だな！一番デケェのをいただくぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480213
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401480213,
					"content": "ま、待て！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401480214,
					"content": "ん？今度はなんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480215,
						401480216
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401480215,
					"content": "パイモン、ここは任せた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480217
					]
				},
				{
					"id": 401480217,
					"content": "で…できるだけやってみるぞ…えー…あっ！オイラ、この料理の由来を紹介するの忘れてたぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401480218,
					"content": "料理の由来？そんなんいるか？食ったら終わりじゃねぇか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480219
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401480219,
					"content": "えーっとな…聞かずに食べちゃうなんて、ガイドのいない旅行と一緒だぞ！由来を聞いてから食べれば、もっと美味しく味わえてだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480220
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401480220,
					"content": "確かに。お茶も、種類によって味わい方が異なります。説明を聞かずに味わえば、料理人の誠意を無駄にしてしまうのではないですか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480221
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 401480221,
					"content": "ダチ公の誠意だと？そりゃあ確かに裏切れねぇよな…なら聞かせてくれよ、ほら！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480222
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401480222,
					"content": "よし！じゃあ、まずはこの料理の材料から…あー…いや、先に望舒旅館とか…荻花洲の歴史についてだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480223
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401480223,
					"content": "（旅人、今だ！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480224
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 401480224,
					"content": "（了解！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480225
					]
				},
				{
					"id": 401480225,
					"content": "パイモンが一斗の気を引いている間に、あなたと忍は料理をあっという間に平らげた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401480226
					]
				},
				{
					"id": 401480226,
					"content": "…荻花洲…そんな感動的な物語があったなんてな…今はこんなにいい暮らしができてるんだ。それこそ、「知足常楽」——満足するべきだよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480227
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401480227,
					"content": "（しまった…豆腐の話題を出さないようにしてたら、いつの間にか話が脱線してたぞ…でもあとちょっとだ！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480228
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401480228,
					"content": "（でも、もうこれ以上食べられない…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480229
					]
				},
				{
					"id": 401480229,
					"content": "あっ！忍、それにダチ公！いつ食い始めたんだよ？あとちょっとしか残ってねぇぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480230
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401480230,
					"content": "——もう何があっても譲らねぇからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480231
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401480231,
					"content": "待ってくれ！親分、実はそれは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480232
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 401480232,
					"content": "一斗くん、お待ちを。不躾なお願いですが、これを譲っていただけませんか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480233
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 401480233,
					"content": "今回は急ぎの外出でしたので、家の者たちを連れてくることができませんでした。みな、貴方の高名はよく耳にしており、以前から荒瀧派に思いを馳せていたのですが…残念ながら、今回は同席するご縁に恵まれませんでした…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480234
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 401480234,
					"content": "ですが、こちらの…「知足常楽」を持ち帰れば、きっと…みな喜んでくれることでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480235
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 401480235,
					"content": "そりゃあ…まあな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480236
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401480236,
					"content": "親分、璃月では「他人のためにひと肌脱ぐ」事が重んじられている…それに、料理を待っている間、魚料理をいくつも食べただろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480237
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 401480237,
					"content": "——綾人さんと私の分まで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480238
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 401480238,
					"content": "なに？ありゃお前らの分だったのかよ…話に夢中になりすぎて全然気づかなかったぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480239
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401480239,
					"content": "…ゴホン。じゃあ綾人の兄貴、俺の代わりにみんなによろしく伝えといてくれ！おーいだんな！これ、持ち帰りで頼む——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401480216,
					"content": "あれをもう一度やって…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480217
					]
				},
				{
					"id": 401480207,
					"content": "#{M#俺}{F#私}も味見してみたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480208
					]
				}
			]
		},
