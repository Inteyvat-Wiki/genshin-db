			"dialogs": [
				{
					"id": 401480401,
					"content": "お前の友だちは個性的だな…まぁ、この「知足常楽」はそこまで難しくないから、今回は何も問題ないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480402
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401480402,
					"content": "そう言えば、なんで「知足常楽」って言うんだ？たらふく食えるってことは、肉とかたくさん食べられるんだろ？「足るを知る」って名前と全然合ってないじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401480403,
					"content": "別に肉を入れるとは言ってないだろ…この料理は見た目が肉に見えるだけで、実際は豆腐を使って肉の見た目、香り、味を作り出してるんだ。だから「知足常楽」なのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480404
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401480404,
					"content": "豆腐！？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480405
					]
				},
				{
					"id": 401480405,
					"content": "あっ！そういや牛使い野郎…豆がダメなんじゃなかったか？どうしよう…変えてもらったほうがいいよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401480406,
					"content": "…何か問題でも起きたのか？「豆腐」とか何とか聞こえてきた気がするが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480407
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 401480407,
					"content": "おい待て、厨房は料理人の聖域だぞ。部外者は…ええい、今は言ってられんな…お前らの親分に料理を変更してもらうよう言ってくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480408
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401480408,
					"content": "…ガハハ！綾人の兄貴を一番よく分かってんのはこの俺様だ！「知足常楽」ってのはまさに、俺らの友情の証だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480409
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401480409,
					"content": "…おい！まだかよ！早くしてくれよ。「赤紅一杵冒険譚」が話し終わっちまうだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480410
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401480410,
					"content": "…見ての通り、おそらく難しいでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480411
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 401480411,
					"content": "ちくしょう…完全に舞い上がってるぞ。あいつ…面子か満腹なら、絶対面子を選ぶよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480412,
						401480413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401480412,
					"content": "仕方ない、作るしか…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480414
					]
				},
				{
					"id": 401480414,
					"content": "ああ。私は親分にそれをたくさん食べさせて腹を満たしておくから…その時になったら機をうかがって行動しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 401480413,
					"content": "あとでつまめるものを一緒に出そう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480414
					]
				}
			]
		},
