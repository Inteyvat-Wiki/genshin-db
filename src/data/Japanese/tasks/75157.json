			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"コヌラフ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751570101,
					"content": "うぅ…こんな檻に閉じ込められるなんて。「謎煙の主」の一員として築いてきた尊厳が台無しだわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570102
					],
					"speakerTitle": "コヌラフ"
				},
				{
					"id": 751570102,
					"content": "はぁ…もう…部族の顔に泥を塗りまくりね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570103
					],
					"speakerTitle": "コヌラフ"
				},
				{
					"id": 751570103,
					"content": "あれ？今回はどうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751570104
					]
				},
				{
					"id": 751570104,
					"content": "あっ、恩人様…また会ったね。うぅ、みっともない姿を見られちゃったわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570105
					],
					"speakerTitle": "コヌラフ"
				},
				{
					"id": 751570105,
					"content": "恩人様、この前会った時に、私はコヌラフで、「謎煙の主」の見習い祭司だって言ったの、覚えてるよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570106
					],
					"speakerTitle": "コヌラフ"
				},
				{
					"id": 751570106,
					"content": "今は祭司の修行をしてて…えっと、部族の年長者に言われたの——先祖のサンハジは他の部族とよく戦闘をめぐって賭け事をしたらしいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570107
					],
					"speakerTitle": "コヌラフ"
				},
				{
					"id": 751570107,
					"content": "それで、「お前も賭け事をして、勝利をその手に掴んでこい！それでこそ、真の謎煙の主だ！」って言われたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570108
					],
					"speakerTitle": "コヌラフ"
				},
				{
					"id": 751570108,
					"content": "ちょうどここを通りかかった時、試合をしてたから、賭けをしたの。連勝のテペトル竜とか、ここ十年で最強のクク竜とか、笑わせるわよね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570109
					],
					"speakerTitle": "コヌラフ"
				},
				{
					"id": 751570109,
					"content": "最強は「謎煙の主」のイクトミ竜に決まってるでしょ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570110
					],
					"speakerTitle": "コヌラフ"
				},
				{
					"id": 751570110,
					"content": "でも結果は、ぼろ負け…本当にボロボロ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570111
					],
					"speakerTitle": "コヌラフ"
				},
				{
					"id": 751570111,
					"content": "イクトミ竜に賭けた分の借金を背負って、こんなところに閉じ込められる羽目に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570112
					],
					"speakerTitle": "コヌラフ"
				},
				{
					"id": 751570112,
					"content": "「フン、イクトミ竜が優勝したら、十倍払ってやるぜ。それまで、檻の中で大人しくしてるんだな！」って言われちゃった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570113
					],
					"speakerTitle": "コヌラフ"
				},
				{
					"id": 751570113,
					"content": "あぁ、どうしよう…イクトミ竜が現れて、あの二頭の竜をぶん殴ってくれればいいのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570114
					],
					"speakerTitle": "コヌラフ"
				},
				{
					"id": 751570114,
					"content": "そしたら檻から出て、十倍のモラを手に入れられるのに…あっ、でも一番大事なのはあの二つの部族に、偉大なる謎煙の主の素晴らしいイクトミ竜のすごさを分からせることだわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570115
					],
					"speakerTitle": "コヌラフ"
				},
				{
					"id": 751570115,
					"content": "うぅ…もし恩人様がそういうイクトミ竜を見つけてくれたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570116
					],
					"speakerTitle": "コヌラフ"
				},
				{
					"id": 751570116,
					"content": "はぁ、無理よね。謎煙の主でもない恩人様に見つけられるはずがない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570117
					],
					"speakerTitle": "コヌラフ"
				},
				{
					"id": 751570117,
					"content": "頑張ってみるよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751570118
					]
				},
				{
					"id": 751570118,
					"content": "ほ、本当ですか、恩人様。じゃあ、いいお知らせをま、待ってるわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "コヌラフ"
				}
			]
		},
