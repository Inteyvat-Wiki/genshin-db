				"points": []
			},
			"dialogs": [
				{
					"id": 760034015,
					"content": "カーチャの料理もおいしいし…ノヴォキッチェヴに帰るのはもうちょっと後でもいいかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760034016,
						760034002,
						760034011
					],
					"speakerTitle": "ニェドチカ"
				},
				{
					"id": 760034016,
					"content": "ニェドチカ、また会ったね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760034017
					]
				},
				{
					"id": 760034017,
					"content": "あっ！今ここで勝負するってこと？き、奇襲なんて卑怯よ！どうしても勝負したいなら、時間を決めて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760034018
					],
					"speakerTitle": "ニェドチカ"
				},
				{
					"id": 760034018,
					"content": "ナ、ナシャタウンをろくに回れてなかったから、もうちょっとのんびり遊びたかったの。ねぇ、勝負の件はまた今度じゃだめ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ニェドチカ"
				},
				{
					"id": 760034002,
					"content": "ノヴォキッチェヴについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760034003
					]
				},
				{
					"id": 760034003,
					"content": "あそこで暮らしてた時は、ただただ窮屈だって感じてた。でも、離れたら離れたで、恋しくなっちゃって…家からこんなに離れたの、初めてよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760034004
					],
					"speakerTitle": "ニェドチカ"
				},
				{
					"id": 760034004,
					"content": "ほかの場所にも、ノヴォキッチェヴみたいにフェイがたくさん暮らしてるのかと思ってた。スネージナヤ・グラードにもフェイがたくさんいるでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760034005
					],
					"speakerTitle": "ニェドチカ"
				},
				{
					"id": 760034005,
					"content": "でも、ナド・クライに来てからは一回も見てないわ。パイモンも自分は違うって言ってるし…ここの気候が嫌なのかしら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760034013
					],
					"speakerTitle": "ニェドチカ"
				},
				{
					"id": 760034013,
					"content": "ここには吹雪もないし、カイロが無いと外を一歩も歩けないこともないしね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760034014
					],
					"speakerTitle": "ニェドチカ"
				},
				{
					"id": 760034014,
					"content": "そうだ、ナド・クライでノヴォキッチェヴ産のお酒を見たの。鉱業と同じくらい酒造業で有名なのは知ってたけど、改めてここで見ると…ちょっと感動？しちゃったかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ニェドチカ"
				},
				{
					"id": 760034011,
					"content": "またね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760034012
					]
				},
				{
					"id": 760034012,
					"content": "うん！それまで、お互いの幸運を祈ってるから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ニェドチカ"
				}
			]
		},
