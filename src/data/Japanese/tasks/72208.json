			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"イペ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722080101,
					"content": "ははっ、技術は悪くないが、まだまだ改善の余地がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080102,
						722080103
					],
					"speakerTitle": "イペ"
				},
				{
					"id": 722080102,
					"content": "えっ！？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080104
					]
				},
				{
					"id": 722080104,
					"content": "おや、すまないすまない…あいさつを忘れていた…他の人を驚かせてしまうな…はははっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080105
					],
					"speakerTitle": "イペ"
				},
				{
					"id": 722080105,
					"content": "なんで楽しそうなの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080106
					]
				},
				{
					"id": 722080106,
					"content": "しょうがないだろ、たまに子供をからかうのは結構面白い…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080107
					],
					"speakerTitle": "イペ"
				},
				{
					"id": 722080107,
					"content": "コホンッ、釣りの話に戻ろうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080108,
						722080109
					],
					"speakerTitle": "イペ"
				},
				{
					"id": 722080108,
					"content": "大事な話？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080110
					]
				},
				{
					"id": 722080110,
					"content": "恥ずかしい話なんだが…前に釣りをしていた時、マキリからもらったお守りを落としてしまってな…中には彼女の祖霊と雷鳥様の祝福があるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080111
					],
					"speakerTitle": "イペ"
				},
				{
					"id": 722080111,
					"content": "そんな大事な物を失くしたことを、船に乗る時に彼女に知られたら大変だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080112
					],
					"speakerTitle": "イペ"
				},
				{
					"id": 722080112,
					"content": "金色の船乗りは、探してくれる人を見つけてくると言っていたが…まだ誰も来てない…だから君、せっかく来たんだ、俺を助けてくれないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080113,
						722080114
					],
					"speakerTitle": "イペ"
				},
				{
					"id": 722080113,
					"content": "結構頼りになる人だと思ったのに…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080115
					]
				},
				{
					"id": 722080115,
					"content": "よく釣りをする場所はこの辺だ…だが記憶が曖昧で、探す必要があるかもしれない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080116,
						722080117
					],
					"speakerTitle": "イペ"
				},
				{
					"id": 722080116,
					"content": "昔の記憶にあった場所なら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080118
					]
				},
				{
					"id": 722080118,
					"content": "うーん…何を言ってるんだ？外の人はそうやって場所を見つけるのか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080119
					],
					"speakerTitle": "イペ"
				},
				{
					"id": 722080119,
					"content": "まあ…とにかく、正しい場所を見つけたら、直接捜索するといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080120
					],
					"speakerTitle": "イペ"
				},
				{
					"id": 722080120,
					"content": "どうやって探せばいい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080121
					]
				},
				{
					"id": 722080121,
					"content": "うーん…釣りで？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080122
					],
					"speakerTitle": "イペ"
				},
				{
					"id": 722080122,
					"content": "…分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080123
					]
				},
				{
					"id": 722080123,
					"content": "雷鳥様と祖霊の加護があらんことを！頼んだぞ、外から来た友よ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イペ"
				},
				{
					"id": 722080117,
					"content": "「羽毛」を使えば見えるかも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080118
					]
				},
				{
					"id": 722080114,
					"content": "しょうがないな…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080199
					]
				},
				{
					"id": 722080199,
					"content": "アウタケ平原の西側に、三重の滝に面した小さな島がある…その島のさらに西の海だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080115
					],
					"speakerTitle": "イペ"
				},
				{
					"id": 722080109,
					"content": "なんだまだ釣りのことを…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080110
					]
				},
				{
					"id": 722080103,
					"content": "あいさつしてから現れて！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080104
					]
				}
			]
		},
