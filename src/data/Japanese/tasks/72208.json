				{
					"id": 722080201,
					"content": "ありがとう！これで心置きなく船に乗れるよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080202
					],
					"speakerTitle": "イペ"
				},
				{
					"id": 722080202,
					"content": "あの船はどこに向かうの…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080203
					]
				},
				{
					"id": 722080203,
					"content": "金の大地、夢の大地。霧のない国…我々は夢でまた会うだろう、友よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イペ"
