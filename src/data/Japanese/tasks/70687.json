			},
			"dialogs": [
				{
					"id": 706870101,
					"content": "お客さん、どうぞこちらへ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870102
					],
					"speakerTitle": "子オオカミ"
				},
				{
					"id": 706870102,
					"content": "魔女の姉ちゃんの友達に占いの得意な魔女がいるんだけど、その姉ちゃんが二人にプレゼントを用意してくれたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870103
					],
					"speakerTitle": "子オオカミ"
				},
				{
					"id": 706870103,
					"content": "わぁ～きれいな水晶玉だな！高級そうだし、マーガレットに売ったら一千万…いや、二千万モラは稼げるかも——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706870104,
					"content": "あっ…い、今のは冗談だぞ。それで、これはなにに使うものなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706870105,
					"content": "占いの得意な魔女の姉ちゃんは、「魔法使いがいるなら、ちゃんとした水晶玉を用意せんとな」って言ってた。これがあれば、お客さんはこれまで見たこともない、超すごい舞台が見られるんだって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870106
					],
					"speakerTitle": "子オオカミ"
				},
				{
					"id": 706870106,
					"content": "どういう意味かは、俺にもよく分かんない。俺はただのドアボーイだからな。水晶玉と睨めっこしてみたけど、自分の姿しか見えなかったよ、クーン…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870107
					],
					"speakerTitle": "子オオカミ"
				},
				{
					"id": 706870107,
					"content": "あ、そうだ。この箱も魔女の姉ちゃんからのプレゼントだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870108
					],
					"speakerTitle": "子オオカミ"
				},
				{
					"id": 706870108,
					"content": "「隠れた舞台の上で、まるで運命のように予測のつかない見事なパフォーマンスを披露した者は、この箱に収める貴重なものを手に入れられる」…って言ってたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870109
					],
					"speakerTitle": "子オオカミ"
				},
				{
					"id": 706870109,
					"content": "き、貴重なもの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706870110,
					"content": "あんまりドアボーイが話しても、物語の楽しみが減るだけだろう？さあ、お客さんたち。いつもみたいに、新たな舞台へ進んでくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "子オオカミ"
				}
			]
		}
	]
}