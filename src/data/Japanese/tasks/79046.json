			"dialogs": [
				{
					"id": 790460901,
					"content": "動けない石の状態で、シズクちゃんに薬を飲ませられるのか？水で流し込むこともできないよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460902
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790460902,
					"content": "もしかして、この薬って塗り薬だったり？さっそく試してみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7904610,
			"completionStepIds": [
				7904610
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7904610",
							"2"
						],
						"stepId": 7904610,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790461001,
					"content": "うわっ、さすがにこの数の視線を避けるのは無理だろ！こんなのズルだぞ、ズル！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461002
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790461002,
					"content": "この幽霊の仕掛け、全部蹴っ飛ばしてやりたいぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461003
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790461003,
					"content": "待った、シズクちゃん、なにする気だ？そっちは幽霊に見られるぞ！危ない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461004
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790461004,
					"content": "騒々しいやつめ、とち狂ったか？それとももう希望を捨て、仲間と向こうの世界で再会でもしたくなったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461005
					],
					"speakerTitle": "怒った幽霊の親玉"
				},
				{
					"id": 790461005,
					"content": "いや、自分の体を使って視線を遮ろうとしている…よくそんな古典的な自己犠牲を思いついたもんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461006
					],
					"speakerTitle": "愉快な幽霊の親玉"
				},
				{
					"id": 790461006,
					"content": "事態は急展開を迎える！そばを離れた水形幻霊は幽霊たちの前に立つと、身を挺して死角を作り、ゆっくりと石像になっていく！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461007
					],
					"speakerTitle": "スピーカーから流れる傍白"
				},
				{
					"id": 790461007,
					"content": "シズクちゃん…オイラたちがカギを手に入れられるよう…自分から石になりに行ったのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461008,
						790461009
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790461008,
					"content": "シズクちゃんはまだ治せる！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790461010
					]
				},
				{
					"id": 790461010,
					"content": "ああ、そうだな！幽霊に見られた時間はそんな長くない。きっと大丈夫なはずだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461011
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790461011,
					"content": "もしかして、シズクちゃんはそれも計算してたのか？頭いいんだな、それにすごく勇敢だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461012
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790461012,
					"content": "#{NICKNAME}、あまりシズクちゃんを長く待たせないようにしないと！早くカギを見つけて薬を手に入れようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790461009,
					"content": "急がないと！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790461010
					]
				}
			]
		},
		{
			"id": 7904611,
			"completionStepIds": [
				7904612
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
