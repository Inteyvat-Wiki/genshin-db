			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790461101,
					"content": "スピーカーから流れる傍白が目の前の奇妙な光景を語り出す——\\n二人の智者が薬を優しく水形幻霊の石像にかけると、不思議なことが起きた…\\n時間がまるで逆流するかのように、石化した水形幻霊が元に戻っていく…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						790461102
					]
				},
				{
					"id": 790461102,
					"content": "うぅ…完全に石になるのってこんな感じだったんだ…気持ち悪いよ。仲間たちにこれ以上こんな思いさせたくない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461103
					],
					"speakerTitle": "はぐれ水形幻霊"
				},
				{
					"id": 790461103,
					"content": "シズクちゃん、どうして黙って突っ走ったんだよ、びっくりしたんだからな！すぐに薬を手に入れられたからよかったけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790461104,
					"content": "さっきあの幽霊たちが変な叫び声を上げてて、ボク怖くて、全然声を出せなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461105
					],
					"speakerTitle": "はぐれ水形幻霊"
				},
				{
					"id": 790461105,
					"content": "それにキミたちは智者様だから、きっとボクが言わなくても分かると思ったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461106
					],
					"speakerTitle": "はぐれ水形幻霊"
				},
				{
					"id": 790461106,
					"content": "ボクが完全に石になっても、きっと薬を手に入れたらキミたちは真っ先にボクを助けてくれるはず。状況は何も変わらないから、焦る必要もなかったんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461107
					],
					"speakerTitle": "はぐれ水形幻霊"
				},
				{
					"id": 790461107,
					"content": "えーっと…オイラってば感情移入しすぎかな？シズクちゃんをこんなに心配するなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461108,
						790461109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790461108,
					"content": "感情移入できるのはいいこと。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790461110
					]
				},
				{
					"id": 790461110,
					"content": "うっ…遊びに来たはずなのに、演技にのめり込みすぎちゃって、ちょっと恥ずかしいかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790461111,
					"content": "とにかく…オイラたちは成功したんだし、この薬を持って、おまえの仲間たちを助けに行こうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790461112,
					"content": "ありがとう、本当にありがとう。ボク…感謝してもしきれないよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461113
					],
					"speakerTitle": "はぐれ水形幻霊"
				},
				{
					"id": 790461113,
					"content": "ボクと仲間たちは、キミたちからの恩をずっと忘れないから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461114,
						790461115
					],
					"speakerTitle": "はぐれ水形幻霊"
				},
				{
					"id": 790461114,
					"content": "大丈夫、気にしないで！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790461116
					]
				},
				{
					"id": 790461116,
					"content": "あの悪いやつら、またイタズラしてくるかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790461117,
					"content": "今度から森で遊ぶ時は、もうこの城に来ないようにな。ちゃんと気を付けるんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790461118,
					"content": "めでたしめでたし！二人の智者による周到な策と水形幻霊の勇気が見事に組み合わさり、幽霊がかけた呪いの危機を打ち破ることに成功した！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461119
					],
					"speakerTitle": "スピーカーから流れる傍白"
				},
				{
					"id": 790461119,
					"content": "智者たちの訪れは幽霊たちのイタズラを抑止し、はぐれ水形幻霊とその仲間たちはまた楽しく遊べるようになったという。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461120
					],
					"speakerTitle": "スピーカーから流れる傍白"
				},
				{
					"id": 790461120,
					"content": "薄暗く不気味な森も、静かで平和な姿を取り戻した…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461121
					],
					"speakerTitle": "スピーカーから流れる傍白"
				},
				{
					"id": 790461121,
					"content": "「呪いの瞳に固まりて」これにて終幕——ご覧いただきありがとうございました！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461122
					],
					"speakerTitle": "スピーカーから流れる傍白"
				},
				{
					"id": 790461122,
					"content": "やったー、オイラたち「呪いの瞳に固まりて」を演じきったな！へへっ、すっかり感情移入しちゃったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790461123,
					"content": "う～ん、今思うとセリフと傍白がしっかりしてれば、観客の感情をちゃんと動かせるんだな…ダイアはいったいどこでこんな技術を学んだんだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790461124,
					"content": "ダイアに会う機会があったら、その時にじっくり聞いてみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790461115,
					"content": "大げさだよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790461116
					]
				},
				{
					"id": 790461109,
					"content": "パイモンが楽しめてる証拠。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790461110
					]
				}
			]
		},
