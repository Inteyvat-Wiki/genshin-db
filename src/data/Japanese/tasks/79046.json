			"dialogs": [
				{
					"id": 790460101,
					"content": "演劇参加者スタンバイ、全仕掛け運行正常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460102
					],
					"speakerTitle": "楽園のお知らせスピーカー"
				},
				{
					"id": 790460102,
					"content": "演劇「ダイアの三日空想」、「呪いの瞳に固まりて」の章——これより開幕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460103
					],
					"speakerTitle": "楽園のお知らせスピーカー"
				},
				{
					"id": 790460103,
					"content": "不気味な深い森の外れ——知恵と度胸を兼ね備えた二人の智者が、はぐれ水形幻霊と出会った…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460104
					],
					"speakerTitle": "スピーカーから流れる傍白"
				},
				{
					"id": 790460104,
					"content": "助けて…仲間を見捨てたくないの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460105
					],
					"speakerTitle": "はぐれ水形幻霊"
				},
				{
					"id": 790460105,
					"content": "えっ？シズクちゃんって喋れるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460106,
						790460107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790460106,
					"content": "スピーカーが代わりに喋ってる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460108
					]
				},
				{
					"id": 790460108,
					"content": "なるほど、このシズクちゃんが演劇の重要な役者ってことか。オイラたちも合わせたほうがいいのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790460109,
					"content": "幸い、水形幻霊の言語について研究を重ねていた二人の智者。そのため、水形幻霊の助けを求める言葉を理解できた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460110
					],
					"speakerTitle": "スピーカーから流れる傍白"
				},
				{
					"id": 790460110,
					"content": "まさに運命の巡り合わせ！このようなドラマチックな出会い、水形幻霊を見捨てる理由などどこにあろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460111
					],
					"speakerTitle": "スピーカーから流れる傍白"
				},
				{
					"id": 790460111,
					"content": "オイラたちにも新しい設定があるみたいだな？なんだかすごそうだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460112,
						790460113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790460112,
					"content": "演劇に戻ろう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460114
					]
				},
				{
					"id": 790460114,
					"content": "ボクたち…森で迷子になって、古い城を見つけたの。でも、うっかり城の中の幽霊を起こしちゃって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460115
					],
					"speakerTitle": "はぐれ水形幻霊"
				},
				{
					"id": 790460115,
					"content": "二人の幽霊の親玉に呪いをかけられたんだ…幽霊たちに見られると、石になっちゃうの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460116
					],
					"speakerTitle": "はぐれ水形幻霊"
				},
				{
					"id": 790460116,
					"content": "ボクはなんとか逃げ出したけど、他の仲間たちはみんな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460117
					],
					"speakerTitle": "はぐれ水形幻霊"
				},
				{
					"id": 790460117,
					"content": "ぐすっ…みんなきっとすごく苦しんでる…これってボクたちのせいなの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460118
					],
					"speakerTitle": "はぐれ水形幻霊"
				},
				{
					"id": 790460118,
					"content": "そんなことないぞ。寝起きでムカムカしてたにしろ、こんな風にいじめるなんて良くないと思うぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790460119,
					"content": "まったく…迷子のシズクちゃんを石に変えるとか、もはやいじめってレベルじゃないぞ。その幽霊たちってみんな、すっごい悪いやつらだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460120,
						790460121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790460120,
					"content": "こっぴどく懲らしめれば…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460122
					]
				},
				{
					"id": 790460122,
					"content": "それは無理だよ。幽霊の親玉たちは姿を見せないんだ。それに城だってすごく大きい。だから、いくら強くてもあいつらを見つけられないの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460123
					],
					"speakerTitle": "はぐれ水形幻霊"
				},
				{
					"id": 790460123,
					"content": "でも、ある幽霊によると古城の奥深くに宝箱があって、その中に呪いを解く古の薬が入ってるんだって。それが唯一の希望なんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460124
					],
					"speakerTitle": "はぐれ水形幻霊"
				},
				{
					"id": 790460124,
					"content": "ただ、宝箱のある部屋は密室で鍵がかかってる。近くでカギを探さないといけないみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460125
					],
					"speakerTitle": "はぐれ水形幻霊"
				},
				{
					"id": 790460125,
					"content": "でも、ボクには呪いがある…一人で古城に戻ったら、きっと他の幽霊に見られて、石になって永遠に固まっちゃう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460126
					],
					"speakerTitle": "はぐれ水形幻霊"
				},
				{
					"id": 790460126,
					"content": "そんなに難しくなさそうだな！オイラたちが付いていってやるぞ。古城でカギを探して、その薬を手に入れようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790460127,
					"content": "おまえを…えっと、幽霊に見られないようにすればいいんだよな？ふふん、楽勝だぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790460128,
					"content": "うん、キミたちは…智者様だから、きっと良い方法を思いつくはず…どうか助けて、お願い…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460129,
						790460130
					],
					"speakerTitle": "はぐれ水形幻霊"
				},
				{
					"id": 790460129,
					"content": "パイモン、すぐ役に入ったね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460131
					]
				},
				{
					"id": 790460131,
					"content": "へへっ、シンプルだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460132
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790460132,
					"content": "親玉をボコボコにはできなそうだけど、他の幽霊たちを全員懲らしめて、シズクちゃんの仲間たちも助けよう。簡単だぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460133
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790460133,
					"content": "安心してくれ、シズクちゃん。オイラたちが一緒にその薬を見つけて、おまえにかけられた呪いを解いてやる。仲間も助けてやるからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790460130,
					"content": "ストーリーの展開をちゃんと掴めてる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460131
					]
				},
				{
					"id": 790460121,
					"content": "仲間を助けられる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460122
					]
				},
				{
					"id": 790460113,
					"content": "仲間がどうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460114
					]
				},
				{
					"id": 790460107,
					"content": "シズクちゃんのセリフだと思えば良い。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460108
					]
				}
			]
		},
