			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"エラ·マスク",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700240202,
					"content": "本当によかった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240204
					]
				},
				{
					"id": 700240203,
					"content": "大丈夫…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240204
					]
				},
				{
					"id": 700240201,
					"content": "ふぅ…危なかったわ。あなたたちが来てくれてよかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240202,
						700240203
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 700240204,
					"content": "はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240205
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 700240205,
					"content": "さっきまで順調だったのに…どこで間違えたのかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240206
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 700240206,
					"content": "とにかく…助けてくれてありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240207
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 700240207,
					"content": "なんか落ち込んでるみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700240208,
					"content": "さっき起きた出来事はあなたたちも見たでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240223
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 700240223,
					"content": "単独でヒルチャールと交流するのは、やっぱりリスクが高いわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240209
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 700240210,
					"content": "そうなんだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240212
					]
				},
				{
					"id": 700240211,
					"content": "何か手伝えることはある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240212
					]
				},
				{
					"id": 700240209,
					"content": "ヒルチャールと交流する機会…無駄にしたら悔しいもの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240210,
						700240211
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 700240212,
					"content": "このままじゃ、辞書の編集作業がまた遅れちゃう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240224
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 700240213,
					"content": "手伝うよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240214
					]
				},
				{
					"id": 700240224,
					"content": "誰か私の代わりに本の内容を検証してくれたらいいのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240213
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 700240214,
					"content": "ほ、本当！？よかった。じゃあこの本を持っていって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240215
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 700240215,
					"content": "なんか…いきなり人使いが荒くなったな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700240217,
					"content": "理論上…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240218
					]
				},
				{
					"id": 700240216,
					"content": "交流が上手くいかなかったら、このハンドブックを見れば解決できる…理論上はね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240217
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 700240218,
					"content": "えっ、じゃあ自分でもなにを書いてるのかわからないのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240219
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700240219,
					"content": "素人ならではの質問ね。実際に検証してみなきゃ、研究が論理的かどうか分かるはずもないじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240225
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 700240225,
					"content": "まぁいいわ。これ以上言っても分からないだろうから。とにかく、今回は助けてくれて本当にありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240220
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 700240221,
					"content": "よろこんで！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 700240222,
					"content": "せっかくここまで来たから…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 700240220,
					"content": "あなたたちさえよければ、私も一緒にヒルチャールと交渉してもいいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240220,
						700240221
					],
					"speakerTitle": "エラ·マスク"
				}
			]
		}
	]
}