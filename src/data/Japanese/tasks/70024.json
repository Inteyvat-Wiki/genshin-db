			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"キャサリン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700240101,
					"content": "旅人さん、こちらへ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240102
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 700240102,
					"content": "時間を取らせてしまって申し訳ないのですが、新しい依頼はいかがでしょうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240103,
						700240104
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 700240103,
					"content": "話してみて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240105
					]
				},
				{
					"id": 700240105,
					"content": "協会が近頃受け取った報告によりますと、野外のヒルチャールが集まって輸送ルートを妨害しているようなのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240106
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 700240106,
					"content": "それで冒険者の方々を手配したのですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240107
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 700240107,
					"content": "その方たちによりますと、集まったヒルチャールの中に、いつも変わったヒルチャールがいるようなのです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240108
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 700240108,
					"content": "ですので、その変わったヒルチャールが今回の騒動と関係していると判断しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240114
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 700240114,
					"content": "その変わったヒルチャールを捕まえてください。それができなかった場合、少なくとも追い払う必要があります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240109
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 700240109,
					"content": "旅人さん、この依頼を受けていただけますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240110,
						700240111
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 700240110,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240112
					]
				},
				{
					"id": 700240112,
					"content": "ありがとうございます。いくつかのポイントをマップに記しておきました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240113
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 700240113,
					"content": "その場所にヒルチャールが出没していますので、そこで調査をしてきてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240115
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 700240115,
					"content": "もし変わったヒルチャールに遭遇したら…お気を付けください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 700240111,
					"content": "気にかけておく。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240112
					]
				},
				{
					"id": 700240104,
					"content": "どんな依頼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240105
					]
				}
			]
		},
		{
			"id": 7002402,
			"completionStepIds": [
				7002404
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7002404",
							"2"
