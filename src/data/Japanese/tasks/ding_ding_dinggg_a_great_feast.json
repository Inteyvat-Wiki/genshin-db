			"dialogs": [
				{
					"id": 402070201,
					"content": "よう、イネファ！——あれ？ヤフォダじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402070202,
					"content": "ここ数日頑張ったんだから、あたいもケーキの一切れぐらい貰ってもいいだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070203
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 402070203,
					"content": "ケーキが食えるのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402070204,
					"content": "ええ、お二人ともちょうどいいところにいらっしゃいました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070205
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 402070205,
					"content": "アイノはずっと皆さんに感謝してましたよ。カンカン・アマサヒカエメも救出できた事ですし、せっかくですから今日はこの子に腕をふるってもらいましょうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070206
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 402070206,
					"content": "カチャ…カチャ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070207
					],
					"speakerTitle": "カンカン・アマサヒカエメ"
				},
				{
					"id": 402070207,
					"content": "わぁ、これがカンカン・アマサヒカエメの本来の姿か！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402070208,
					"content": "コアにほぼ損傷がなかったため、アイノが体を作り直したのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070209
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 402070209,
					"content": "ギィ…ギィ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070210
					],
					"speakerTitle": "カンカン・アマサヒカエメ"
				},
				{
					"id": 402070210,
					"content": "出来立てお菓子がそろそろ出てくるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402070211,
					"content": "カチャ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070212
					],
					"speakerTitle": "カンカン・アマサヒカエメ"
				},
				{
					"id": 402070212,
					"content": "自分で食べちゃったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402070213,
					"content": "料理を作った人が料理を出す前につまみ食いするなんて、よくあることだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070214
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 402070214,
					"content": "カンカン・アマサヒカエメは食べ終わった後に改めてお菓子を焼くので、ご心配なく。少々お待ちくださいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070215
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 402070215,
					"content": "わかったぞ…お菓子を食べるのに、アイノはいないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402070216,
					"content": "アイノはさっき新しいロボットの案を思いついたようで、作業場に潜り込んでしまいました。いつもこうなんです…私がここに来た時から、ずっと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070217
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 402070217,
					"content": "アイノはなんでこんなにロボットを作るのが好きなんだろうな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402070218,
					"content": "うーん…その答えを出すには、データベースから膨大な量の履歴を検索する必要がありますが——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070219
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 402070219,
					"content": "当初、アイノはお菓子より夢中になれるものがあることに、驚いていたようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070220
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 402070220,
					"content": "アイノは幸運です。周りの人は生計を立てるのに精一杯で時間の余裕がないにもかかわらず、彼女の趣味を応援してくれました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070221
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 402070221,
					"content": "ある日、素晴らしい先生と出会ったことで、アイノの「好きなこと」はやっと才能として認められたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070222
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 402070222,
					"content": "アイノはかつての仲間のように、ようやく自分が最もやりたい、最も得意なことを見つけられました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070223
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 402070223,
					"content": "天才が自分のやりたいことを見つけた後は、もうだれにも止められません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070224
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 402070224,
					"content": "アイノは自分の幼馴染たちと離れてカチャカチャ・クルムカケ工房を創設し、様々なロボットを作るようになりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070225
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 402070225,
					"content": "当時のアイノは、自分の発想を実現することを渇望していました。それは天才としての本能だったと言えるかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070226
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 402070226,
					"content": "へえ…それであいつはロボットを作るのが好きなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070227
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402070227,
					"content": "いいえ。私の経験と照らし合わせると、ほかにも理由があると思うのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070228
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 402070228,
					"content": "私が目覚めるよりも前から、アイノは彼女の持てる全ての技術を駆使して全てのロボットに個性を与え、仲間だと思うようにしていました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070229
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 402070229,
					"content": "特殊な出自だからといって、私が工房の中で特別扱いされていることはありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070230
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 402070230,
					"content": "原因を分析。恐らくアイノは天才の道を長く歩みすぎたために、振り返っても誰もいない現実に孤独を感じていたのでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070231
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 402070231,
					"content": "したがって、私やカンカン・アマサヒカエメ、そしてほかの工房の一員となったロボットたちは、アイノの才能を証明する存在というだけではありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070232
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 402070232,
					"content": "私たちはアイノの家族であり、彼女に求められた仲間なのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070233
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 402070233,
					"content": "これが私の考える、アイノとロボットの関係です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070234
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 402070234,
					"content": "なるほどな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070235
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402070235,
					"content": "だから、アイノにとっては、カンカン・アマサヒカエメが周りをおびやかす力を持っているかどうかなんてどうでもいい——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070236
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 402070236,
					"content": "カンカン・アマサヒカエメは工房の一員として迎えられるべき存在だ…その事実だけで、アイノはあそこまで頑張れるのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070237
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 402070237,
					"content": "うんうん、オイラも納得だぞ！アイノみたいなやつがなんでナド・クライに残ってるのか、不思議だよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070238
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402070238,
					"content": "…パイモンさんの言葉のロジックが理解できません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070239
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 402070239,
					"content": "だって、ナド・クライは色んなやつがいて、悪だくみで溢れてるだろ。ここに残ってるのはみんな、一筋縄ではいかないやつばっかりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070240
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402070240,
					"content": "もしほかのやつがアイノの技術を持ってたら、きっとほかのやつらを脅すために、ロボットを強い兵器に改造して、利用してたよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070241
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402070241,
					"content": "でも、アイノは…殺戮マシーンをケーキを焼く機械にできるようなやつだ。そんなやつ、ナド・クライとは相容れないんじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070242
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402070242,
					"content": "いいえ、私の思考モジュールは真逆の見解を弾き出しています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070243
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 402070243,
					"content": "私は、ナド・クライで多くの人と接触してきました。しかし、ほとんどは「ナド・クライ人」として定義できません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070244
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 402070244,
					"content": "パイモンさんを驚かせているアイノこそ、「ナド・クライ人」の定義に最もあてはまる存在です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070245
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 402070245,
					"content": "チリン…チリン…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070246
					],
					"speakerTitle": "カンカン・アマサヒカエメ"
				},
				{
					"id": 402070246,
					"content": "お菓子ができたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070247
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 402070247,
					"content": "ええ。切り分けるので、お待ちください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070248
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 402070248,
					"content": "クリームが一番たくさんついてるやつがいい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070249
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 402070249,
					"content": "はい、皆さん。ご賞味あれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070250
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 402070250,
					"content": "——んっまい！！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
}