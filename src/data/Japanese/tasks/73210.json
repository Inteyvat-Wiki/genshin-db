				"points": []
			},
			"dialogs": [
				{
					"id": 732100501,
					"content": "うーん…ここにはどんな宝物があるんだろうな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732100502,
					"content": "棚には薄い冊子がたくさん置いてあった。二人で確認してみたが、カルテや財務記録といった病院の書類だった。\\nがっかりして棚を閉めた。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732100503
					]
				},
				{
					"id": 732100503,
					"content": "ふん、てっきり特別な宝物が隠されてるかと思ったのに…これじゃ、いつも冒険で見かける樽とか木箱以下じゃないか！あれでさえ、キャベツとか鳥肉が入ってるのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732100504,
					"content": "え、これは何だ？この中から落ちてきたみたいだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732100505,
					"content": "どれどれ…宝物の手がかりがあるかもしれないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100507
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732100507,
					"content": "うわぁ、「魔鱗病」って怖いな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100508
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732100508,
					"content": "他の書類には何て書いてあるんだ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100510
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732100510,
					"content": "うーん…全然わからなかったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100511,
						732100513
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732100511,
					"content": "#{M#俺}{F#私}にも分からなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100512
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732100512,
					"content": "オイラには「神様の声の導き」ってとこしか…まさか、本当に変な声が聞こえてきて、オイラたちを導いてくれるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100515
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732100515,
					"content": "「地下水脈か生物活動」かも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732100516
					]
				},
				{
					"id": 732100516,
					"content": "うん！確かに、地下に遺跡とかがあるかもしれないぜ！何か音が聞こえてきたら、見てみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732100513,
					"content": "わからない方がいいかも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732100514
					]
				},
				{
					"id": 732100514,
					"content": "ええ？おまえにはわかったのか？オイラには「神様の声の導き」ってとこしか…まさか、本当に変な声が聞こえてきて、オイラたちを導いてくれるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100515
					],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
