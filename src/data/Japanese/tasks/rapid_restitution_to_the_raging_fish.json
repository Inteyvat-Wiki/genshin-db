			"dialogs": [
				{
					"id": 747110101,
					"content": "よし！順調みたいね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110102
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 747110102,
					"content": "凶暴化したお魚たちを治療するお仕事の、最終段階よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110103
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 747110103,
					"content": "病気の魚たちを見落としてないか、最終確認するほかに、もう一つ特別な任務があるの——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110104
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 747110104,
					"content": "影響を受けた水域で、専用の探査装置を見つけ出して、設備に記録されていた資料を回収してほしいのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110105,
						747110106
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 747110105,
					"content": "そこから規則性を見出して…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747110107
					]
				},
				{
					"id": 747110107,
					"content": "その通りよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110108
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 747110108,
					"content": "船の持ち主とか潜水士とかにも注意を呼びかけて、今回の教訓を伝えていかないとな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747110109,
					"content": "うん、それと漁師さんや観光客さん…船に乗る人や、ダイビングをする人たち——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110110
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 747110110,
					"content": "水域に関わる人たちはみんな、気をつけてって呼びかけましょう。「勝手に物を捨てて、環境をめちゃくちゃにしちゃダメ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110111
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 747110111,
					"content": "「じゃないと、怒ったお魚たちがキミの船をひっくり返しに来ちゃうかも」——ってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 747110106,
					"content": "同じような問題を防ぐってこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747110107
					]
				}
			]
		}
	]
}