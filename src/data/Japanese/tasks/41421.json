			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 414210601,
					"content": "ここの水、甘い。エンドラー見つけた、同類。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210602
					],
					"speakerTitle": "エンドラー"
				},
				{
					"id": 414210602,
					"content": "エンドラー、同類、水を美味しくする。水苦いのは、ローデシアのせい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210603
					],
					"speakerTitle": "エンドラー"
				},
				{
					"id": 414210603,
					"content": "たしか、清泉町には泉の精霊にまつわる伝説があったよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414210604,
					"content": "でもまずは泉に行ってボトルの苦い水を替えてこよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 4142107,
			"completionStepIds": [
				4142107
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4142107",
							"2"
						],
						"stepId": 4142107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"フィンチじいさん"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414210701,
					"content": "…お前さんは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210702
					],
					"speakerTitle": "フィンチじいさん"
				},
				{
					"id": 414210702,
					"content": "おいエンドラー、出てきちゃダメじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210703
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414210703,
					"content": "私はエンドラー、純水の精霊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210704
					],
					"speakerTitle": "エンドラー"
				},
				{
					"id": 414210704,
					"content": "そういえば、このおじいさんは泉の精霊を信じてた人だよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210705
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414210705,
					"content": "…ふむ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210706
					],
					"speakerTitle": "フィンチじいさん"
				},
				{
					"id": 414210706,
					"content": "お前さんは彼女とそっくりだ。だいぶ小さいがな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210707
					],
					"speakerTitle": "フィンチじいさん"
				},
				{
					"id": 414210707,
					"content": "エンドラー、小さい。エンドラー、勉強する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210708
					],
					"speakerTitle": "エンドラー"
				},
				{
					"id": 414210708,
					"content": "だが、こうして俺の目の前に現れたってことは、あの出会いは夢じゃなかったわけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210709
					],
					"speakerTitle": "フィンチじいさん"
				},
				{
					"id": 414210709,
					"content": "彼女、まだいる。名前は、知らない。エンドラーに、教えてくれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210710
					],
					"speakerTitle": "エンドラー"
				},
				{
					"id": 414210710,
					"content": "エンドラー、彼女に会う。エンドラー、話できる。なにか伝えることは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210711
					],
					"speakerTitle": "エンドラー"
				},
				{
					"id": 414210711,
					"content": "それって、俺の伝言を彼女に伝えてくれるってことかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210712
					],
					"speakerTitle": "フィンチじいさん"
				},
				{
					"id": 414210712,
					"content": "そう、そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210713
					],
					"speakerTitle": "エンドラー"
				},
				{
					"id": 414210713,
					"content": "…うむ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210714
					],
					"speakerTitle": "フィンチじいさん"
				},
				{
					"id": 414210714,
					"content": "もう…俺はだいぶ年を取った…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210715
					],
					"speakerTitle": "フィンチじいさん"
				},
				{
					"id": 414210715,
					"content": "…よろしく伝えてくれるだけでいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フィンチじいさん"
