			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 414210501,
					"content": "うわっ、なにか落ちてきたぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414210502,
					"content": "エンドラー、水ない、死にそう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210503
					],
					"speakerTitle": "エンドラー"
				},
				{
					"id": 414210503,
					"content": "エンドラー、それがおまえの名前か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414210504,
					"content": "苦み、敵意。エンドラーを殺す。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210505
					],
					"speakerTitle": "エンドラー"
				},
				{
					"id": 414210505,
					"content": "どうすればおまえを助けられるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210506
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414210506,
					"content": "甘い水がある、ところに行く。泉に、行く。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210507
					],
					"speakerTitle": "エンドラー"
				},
				{
					"id": 414210507,
					"content": "エンドラー、水使って、歩く。水がない、エンドラー、どこにも行けない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210508
					],
					"speakerTitle": "エンドラー"
				},
				{
					"id": 414210508,
					"content": "どうやって泉に連れていくんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210509
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414210509,
					"content": "ここに水が入ってる水筒がある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210510
					]
				},
				{
					"id": 414210510,
					"content": "でもそれ苦い水だぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210511
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414210511,
					"content": "エンドラー、がまん、できる。でも、少しだけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210512
					],
					"speakerTitle": "エンドラー"
				},
				{
					"id": 414210512,
					"content": "おう、じゃあなるべく早く、泉に向かおうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210513
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414210513,
					"content": "でもこいつ、水スライムを辿ってこんな遠くまで来たのか。なんだかオイラたちと似てるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 4142106,
			"completionStepIds": [
				4142106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4142106",
