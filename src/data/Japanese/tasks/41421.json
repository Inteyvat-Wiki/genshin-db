						414211003
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414211003,
					"content": "純水の動物と交わることで、知ってる単語が増えた。清泉町の情報が分かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414211004
					],
					"speakerTitle": "エンドラー"
				},
				{
					"id": 414211004,
					"content": "「生命の小川は、さらさらと流れる」、少し悲しくて、分からない…理解できない詩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414211005
					],
					"speakerTitle": "エンドラー"
				},
				{
					"id": 414211005,
					"content": "これから分かってくるかもしれない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414211006
					]
				},
				{
					"id": 414211006,
					"content": "エンドラーもっと勉強する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414211007
					],
					"speakerTitle": "エンドラー"
				},
				{
					"id": 414211007,
					"content": "ローデシア最近怒ってる。もしちゃんと向き合って話したら、解決できるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
