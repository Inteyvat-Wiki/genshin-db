			"trigger": {
				"objectNames": [
					"キャサリン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414210101,
					"content": "旅人さん、こんにちは。近頃はどうお過ごしですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210102
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 414210102,
					"content": "またなにか変なことでも起きたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414210103,
					"content": "以前と比べると、それほど大したことではありません。しかし、今回はモンドの経済に関わることですので、少々厄介ではあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210104,
						414210105
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 414210104,
					"content": "どんなこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210106
					]
				},
				{
					"id": 414210106,
					"content": "近頃、ワイナリー付近の水源が突然苦くなってしまったのです。このままでは、この先何年も醸造業が大ダメージを受けてしまいます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210107
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 414210107,
					"content": "具体的なことは、ワイナリーのコナーさんにお尋ねください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 414210105,
					"content": "モンドの経済？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210106
					]
				}
			]
		},
		{
			"id": 4142102,
			"completionStepIds": [
				4142102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4142102",
							"2"
						],
						"stepId": 4142102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"コナー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414210201,
					"content": "協会が手配した人って君たちか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210202
					],
					"speakerTitle": "コナー"
				},
				{
					"id": 414210202,
					"content": "そうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414210203,
					"content": "じゃあ安心したよ。このことは俺の口から言うより、実際に体験してみてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210204
					],
					"speakerTitle": "コナー"
				},
				{
					"id": 414210204,
					"content": "この水は近くで汲んできたものだ。すでに浄水作業は済んでる、絶対に問題はない。味見してみてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210205
					],
					"speakerTitle": "コナー"
				},
				{
					"id": 414210205,
					"content": "オイラもオイラも！飲みたいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414210206,
					"content": "（ゴクッ…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210207
					]
				},
				{
					"id": 414210207,
					"content": "うぇっ…苦い…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414210208,
					"content": "この苦みは浄水作業で取ることができない。成分の問題ではなく、元素力によるものだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210209
					],
					"speakerTitle": "コナー"
				},
				{
					"id": 414210209,
					"content": "こんな水じゃ酒は作れない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210210
					],
					"speakerTitle": "コナー"
				},
				{
					"id": 414210210,
					"content": "じゃあ魚も大変なんじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414210211,
					"content": "それも試したよ。魚の肉も苦かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210212
					],
					"speakerTitle": "コナー"
				},
				{
					"id": 414210212,
					"content": "…そういう意味じゃない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414210213,
					"content": "とにかく、こういった事態だ。手がかりがあるとすれば、北に向かって調査するべきだと俺の勘が言ってる。璃月の碧水川と軽策荘の水はどうなってるんだろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "コナー"
				}
			]
		},
		{
			"id": 4142105,
			"completionStepIds": [
				4142105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
