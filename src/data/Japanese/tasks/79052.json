					}
				]
			},
			"dialogs": [
				{
					"id": 790520201,
					"content": "コースの傾斜がもっと大きければ、もっと刺激的な体験になるかもな。空中で旋回する角度は…ケホッ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790520202
					],
					"speakerTitle": "ハッド"
				},
				{
					"id": 790520202,
					"content": "あっ、ハッドだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790520203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790520203,
					"content": "アンタたちか…ケホッ、ヴェルーリヤ·ミラージュを楽しんでるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790520204,
						790520205
					],
					"speakerTitle": "ハッド"
				},
				{
					"id": 790520204,
					"content": "楽しく遊べてる！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790520206
					]
				},
				{
					"id": 790520206,
					"content": "それなら良かった、ケホケホ…アンタたちが楽しく遊べているなら、俺も安心だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790520208
					],
					"speakerTitle": "ハッド"
				},
				{
					"id": 790520208,
					"content": "ああ、そういえば…ケホケホケホ、実験用の小型爆速車のコースがあるんだが…試してみないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790520209
					],
					"speakerTitle": "ハッド"
				},
				{
					"id": 790520209,
					"content": "実験用？もしかして、爆速車も実験が要るのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790520210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790520210,
					"content": "そうだ、俺の後ろを見てくれ。ここが「びゅんびゅん爆速車」の実験場所だ。へへっ、「激流ツイスター」をまだ覚えてるか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790520211
					],
					"speakerTitle": "ハッド"
				},
				{
					"id": 790520211,
					"content": "あのコースはここで生まれたんだ…ケホケホ、先成図と集流映写灯があっても、コースの設計が基準をクリアしてなければ、正しく成型はできないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790520212
					],
					"speakerTitle": "ハッド"
				},
				{
					"id": 790520212,
					"content": "だから先に設計と実験をして、フィードバックをもとに修正を加えるのが大切だ…た、ただ、ここにあるのは多少…ジェローニの言葉を借りれば、刺激的すぎるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790520213
					],
					"speakerTitle": "ハッド"
				},
				{
					"id": 790520213,
					"content": "勾配のテストをするために、この小型試験場にはコースが3つ設置されている、ケホケホ…外の「びゅんびゅん爆速車」よりちょっと早いぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790520214
					],
					"speakerTitle": "ハッド"
				},
				{
					"id": 790520214,
					"content": "それぞれ「まだ平気コース」、「ちょい酔うコース」と「は、早すぎる！コース」だ。ケホ…ああ、ついでに言っとくと、コースの名前は全部フェルディナンドが考えたやつだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790520215
					],
					"speakerTitle": "ハッド"
				},
				{
					"id": 790520215,
					"content": "えっと…フェルディナンドのやつ、大丈夫か…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790520216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790520216,
					"content": "あいつは問題ない。ただ、その、新鮮な空気を吸う必要があるだけさ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790520217
					],
					"speakerTitle": "ハッド"
				},
				{
					"id": 790520217,
					"content": "本題に戻ろう、コースはどれも…ケホッ、外の「びゅんびゅん爆速車」のコースより速い。だからまず「まだ平気コース」からスタートすることをお勧めするよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790520218
					],
					"speakerTitle": "ハッド"
				},
				{
					"id": 790520218,
					"content": "どうだい？挑戦してみる勇気はあるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790520219,
						790520220
					],
					"speakerTitle": "ハッド"
				},
				{
					"id": 790520219,
					"content": "すぐに始めよう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790520221
					]
				},
				{
					"id": 790520221,
					"content": "よし、気合入ってるな。3つのコースを担当している「水形幻霊」のところへ行ってくれ。アンタのために喜んでコースを開けてくれるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ハッド"
				},
				{
					"id": 790520220,
					"content": "まだ他に用事がある…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790520222
					]
				},
				{
					"id": 790520222,
					"content": "急ぐ必要はない、ケホッ…3つのコースを担当する「水形幻霊」は試験場のすぐ傍にいる。時間がある時に行ってもらえれば良いさ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ハッド"
				},
				{
					"id": 790520205,
					"content": "咳は少し良くなった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790520207
					]
				},
				{
					"id": 790520207,
					"content": "ケホケホ…多分、もう治らないかもな。でも平気さ。たかが咳だ、俺のコース設計への情熱は止められない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790520208
					],
					"speakerTitle": "ハッド"
				}
			]
		}
	]
}