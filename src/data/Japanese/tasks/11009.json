			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凝光"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110090101,
					"content": "今日、皆を招いたのは、とある重要なことを知らせるためよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090102
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110090102,
					"content": "すでに知っている人もいると思うけど、近々群玉閣を再建するつもりなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090103
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110090103,
					"content": "群玉閣を再建？とんでもない規模の工事になりそうだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090104
					],
					"speakerTitle": "宏飛"
				},
				{
					"id": 110090104,
					"content": "確かにそういった噂を耳にしたことがある。どうりで建材の値段が急騰したわけだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090105
					],
					"speakerTitle": "昌貴"
				},
				{
					"id": 110090105,
					"content": "群玉閣は凝光様にとって特別な意味を持つもの。もし、この件でお役に立てれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090106
					],
					"speakerTitle": "志成"
				},
				{
					"id": 110090106,
					"content": "凝光様、俺らに手伝えることはありますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090107
					],
					"speakerTitle": "宏飛"
				},
				{
					"id": 110090107,
					"content": "そう慌てないでちょうだい。数日前、この噂が広まったことで、各方面からこれについて関わりたいという連絡が入ったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090108
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110090108,
					"content": "さしあたり手元にいくつか案件があるから、あなたたちにも任せたいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090109
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110090109,
					"content": "現状、既に立地の選定は終わったわ。必要な建材の準備も完了してる。でもそれ以外に三つ、ある肝心なものが準備できていないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090110
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110090110,
					"content": "その三つが「鳴霞浮生石」、「千奇核心」、そして「仙家呪符」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090111
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110090111,
					"content": "その…僭越ながら申し上げますが、浮生の石以外の二つは聞いたこともないのですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090112
					],
					"speakerTitle": "昌貴"
				},
				{
					"id": 110090112,
					"content": "「鳴霞」という銘は、十分な大きさの浮生の石に与えられるわ。これは群玉閣が宙に浮くための基盤となるものよ。そして千奇核心は、群玉閣内部の機械構造の核となる部分ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090113
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110090113,
					"content": "仙家呪符は、機械装置と仙人の術法を結びつける役割を持っている。他の二つ同様、必要不可欠なものね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090114
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110090114,
					"content": "三つとも希少な素材ではあるけど、あなたたちの人脈と能力をもってすれば、見つかるのも時間の問題よね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090115
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110090115,
					"content": "でも兵は神速を貴ぶもの、何よりも効率が大事よ。見つけてくれたら、いい値で買い取らせてもらうわ。それと、三つの素材を集めるのが早かった三名には、私に質問する機会をあげる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090116
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110090116,
					"content": "もちろん、どのような質問にも答えるわ。この見返りは、きっとみんなを満足させることでしょうね、ふふっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090117
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110090117,
					"content": "先ほどの品々を見つけ出すのは至難の業。しかし、来年の璃月港の計画について聞くことができたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090118
					],
					"speakerTitle": "昌貴"
				},
				{
					"id": 110090118,
					"content": "その価値は計り知れないものになる。凝光様から情報を得た者こそが、市場の機先を制することになるはず…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090119
					],
					"speakerTitle": "志成"
				},
				{
					"id": 110090119,
					"content": "はははっ、ツイてるぞ！つい最近、浮生の石に関する噂を聞いたばかりなんだ。こうしちゃいられん、俺は先に失礼させてもらうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090120
					],
					"speakerTitle": "宏飛"
				},
				{
					"id": 110090120,
					"content": "くっ…俺たちも行くとしよう。先を越されるわけにはいかない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090121
					],
					"speakerTitle": "昌貴"
				},
				{
					"id": 110090121,
					"content": "群玉閣の再建かぁ…これってかなり重要なことなんじゃないか、オイラたちも行ってみよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110090122,
					"content": "先ほどの話、あなたたちも聞いていたようね？どうかしら、興味はある？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090123
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110090123,
					"content": "本当にどんな質問にも答えるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090124
					]
				},
				{
					"id": 110090124,
					"content": "この私が知っていることであれば何でも、真実を教えるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090125
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110090125,
					"content": "#{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_SISTER]}の情報を聞けるかも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090126
					]
				},
				{
					"id": 110090126,
					"content": "本当か？じゃあ、オイラは凝光がどうやって商売しているのか聞きたいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110090127,
					"content": "その秘密がわかれば、オイラたちもう二度とモラに困らなくて済むだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110090128,
					"content": "ふふっ、もちろん教えることは可能よ。ただし、それはあなたたちの働き次第ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090129
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110090129,
					"content": "群玉閣の再建に使われる土地はかなり広大なもの。今回、黄金屋の近くにある廃鉱場にその場所を手配したわ。集めた素材は、すべてそこに送り届けてちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090130
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110090130,
					"content": "私は別件があるから、あなたたちと一緒に行くことはできないけど、到着したら私の秘書に話を聞いてみるといいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090131
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110090131,
					"content": "そう滅多にない機会よ、あまり時間をかけ過ぎると他の人に先を越されちゃうから気をつけて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090132
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110090132,
					"content": "凝光ってやっぱ忙しそうだな…オイラたちもさっそく出発しようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090133
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110090133,
					"content": "とりあえず玉京台を離れて…って、ん？あそこ見てみろよ、なんだか妙な感じだぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090134
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110090134,
					"content": "姉ちゃん、ずいぶんと優雅な佇まいだな、それに気品もある。こりゃあ、群玉閣の再建争いで独走するんじゃねぇか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090135
					],
					"speakerTitle": "刀傷の劉"
				},
				{
					"id": 110090135,
					"content": "俺ら再建に必要な素材の情報を持ってるんだ…どうだ、あっちの静かなところでゆっくり話でも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090136
					],
					"speakerTitle": "刀傷の劉"
				},
				{
					"id": 110090136,
					"content": "必要ない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090137
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090137,
					"content": "そう言うなって。ほら、悪いようにはしねぇから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090138
					],
					"speakerTitle": "刀傷の劉"
				},
				{
					"id": 110090138,
					"content": "おい、ボサッとすんな、早くついて来い！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090139
					],
					"speakerTitle": "刀傷の劉"
				},
				{
					"id": 110090139,
					"content": "は…はい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "強"
				}
			]
		},
		{
			"id": 1100902,
			"completionStepIds": [
				1100902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1100902",
							"2"
						],
						"stepId": 1100902,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"申鶴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110090201,
					"content": "ヒッヒッヒッ、もう逃げ場はないぞ、姉ちゃん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090202
					],
					"speakerTitle": "刀傷の劉"
				},
				{
					"id": 110090202,
					"content": "なにも俺らは悪人じゃねえ。安心しな、ちょっとばかしモラを払えば、貴重な情報が手に入るんだ。お互いに損はしない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090203
					],
					"speakerTitle": "刀傷の劉"
				},
				{
					"id": 110090203,
					"content": "親分、なんだか嫌な予感がします。彼女、明らかに他の人とは違う雰囲気というか…髪も白いし、見た感じ普通の人間じゃないですよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090204
					],
					"speakerTitle": "強"
				},
				{
					"id": 110090204,
					"content": "それが何だってんだ？久々の上物だ、こいつから搾り取らねぇで、どうやって借金を返すってんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090205
					],
					"speakerTitle": "刀傷の劉"
				},
				{
					"id": 110090205,
					"content": "言ったはずだ。主らの情報など必要ない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090206
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090206,
					"content": "先ほどの言葉が聞こえていなかったのなら、最後にもう一度だけ忠告する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090207
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090207,
					"content": "あのなぁ…姉ちゃんよ、ガキじゃあるまいし、これくらい分かってほしいんだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090208
					],
					"speakerTitle": "刀傷の劉"
				},
				{
					"id": 110090208,
					"content": "お前が必要かなんて関係ないんだよ。おとなしくモラを渡せば、済む話なんだからさぁ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090209
					],
					"speakerTitle": "刀傷の劉"
				},
				{
					"id": 110090209,
					"content": "我は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090210
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090210,
					"content": "おっと、下手な言い訳はするなよ！お前がモラを持ってることぐらい分かる、さっきこの目で見たからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090211
					],
					"speakerTitle": "刀傷の劉"
				},
				{
					"id": 110090211,
					"content": "琉璃亭で卓に乗り切らないほどの料理を注文してただろ。でも、ほんの少し口にしただけで箸を置いていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090212
					],
					"speakerTitle": "刀傷の劉"
				},
				{
					"id": 110090212,
					"content": "そして新月軒や万民堂でも、同じように看板料理を全部注文したが、どれも一口しか食べてなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090213
					],
					"speakerTitle": "刀傷の劉"
				},
				{
					"id": 110090213,
					"content": "金持ちの嬢ちゃんでもない限り、そんな贅沢なことできやしない。そんなにモラを持ってんだから、少しぐらい分けてくれてもいいだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090214
					],
					"speakerTitle": "刀傷の劉"
				},
				{
					"id": 110090214,
					"content": "師匠には璃月港で騒ぎを起こすなと、そう言われたが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090215
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090215,
					"content": "まあいい。もしかしたら…これも運命なのかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090216
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090216,
					"content": "親分、何か様子が変ですよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090217
					],
					"speakerTitle": "強"
				},
				{
					"id": 110090217,
					"content": "ビビる必要はねぇ。俺らは情報を売ろうとしてるだけだ、法には触れてないだろ。コイツが手を出してきたら、逆に訴えてやるさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090218,
						110090219
					],
					"speakerTitle": "刀傷の劉"
				},
				{
					"id": 110090218,
					"content": "見つけた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090220
					]
				},
				{
					"id": 110090220,
					"content": "ん？はぁ、またお前らか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090221
					],
					"speakerTitle": "鄭"
				},
				{
					"id": 110090221,
					"content": "千岩軍？どうして千岩軍がここに…まさか、お前が通報したのか？ちっ、余計な真似を。俺は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090222
					],
					"speakerTitle": "刀傷の劉"
				},
				{
					"id": 110090222,
					"content": "黙れ！また人を脅迫しているんだろう、ついて来てもらうぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090223
					],
					"speakerTitle": "鄭"
				},
				{
					"id": 110090223,
					"content": "あ、えっと…そう怖い顔しないでくれよ。ちゃんと説明する…落ち着いてくれって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090224
					],
					"speakerTitle": "刀傷の劉"
				},
				{
					"id": 110090224,
					"content": "白髪の女性に絡んでいた男たちは、千岩軍に連行されて行った。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						110090225
					]
				},
				{
					"id": 110090225,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090226,
						110090227
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090226,
					"content": "大丈夫？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090228
					]
				},
				{
					"id": 110090228,
					"content": "…申鶴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090229
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090229,
					"content": "しん…かく？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090230
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110090230,
					"content": "我の名だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090231
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090231,
					"content": "おおっ、申鶴っていうのか！オイラはパイモン、こいつは旅人だ、よろしくな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090232
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110090232,
					"content": "主らの名は知っている。先刻は、助けてくれて感謝するぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090233
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090233,
					"content": "無論、我一人でも解決できたがな。あやつの首根っこをとっ捕まえて、頭部を地面に三回叩き付けてやれば、諦めると我は判断していた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090234
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090234,
					"content": "うわぁ！そ、そんな暴力を振るっちゃダメだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090235
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110090235,
					"content": "ここは璃月港だから、璃月の法律をちゃんと守らないと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090236
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110090236,
					"content": "法…律？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090237
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090237,
					"content": "申鶴は法律を知らないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090238
					]
				},
				{
					"id": 110090238,
					"content": "うむ。確かに、聞いたことはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090239
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090239,
					"content": "そうなのか、じゃあこれまで——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090241
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110090241,
					"content": "何か音が聞こえた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090242
					]
				},
				{
					"id": 110090242,
					"content": "ああ、我の腹の音だ。腹が空いているからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090243
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090243,
					"content": "あっさりと認めたぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090244
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110090244,
					"content": "そういえば、申鶴はいろんな店で料理を注文して、一口ずつしか食べなかったって、さっきの人たちが言ってたけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090245
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110090245,
					"content": "そんなんじゃお腹が空くに決まってるだろ！なにか食べたいものはないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090246
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110090246,
					"content": "清心、琉璃百合、琉璃袋…それらを普段は食している。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090247
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090247,
					"content": "どれも薬材だけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090248
					]
				},
				{
					"id": 110090248,
					"content": "薬材？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090249
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090249,
					"content": "どうやら、よく分かってないみたいだな…近くに不卜廬があるし、そこに連れて行ってお腹いっぱい食べさせてやろうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090250
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110090250,
					"content": "お腹がペコペコなままだと、力が出ないからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110090227,
					"content": "安心して、もう大丈夫だから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090228
					]
				},
				{
					"id": 110090219,
					"content": "あの人たち、まだ押し売りしてる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090220
					]
				}
			]
		},
		{
			"id": 1100903,
