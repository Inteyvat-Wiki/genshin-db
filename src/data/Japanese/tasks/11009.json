			"trigger": {
				"objectNames": [
					"桂"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110090301,
					"content": "ようこそ、どういった薬をお求めでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090302
					],
					"speakerTitle": "桂"
				},
				{
					"id": 110090302,
					"content": "清心、琉璃百合、琉璃袋、どれも250グラムずつ頼む。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090303
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090303,
					"content": "えっと、それはどういった処方でしょう？まるで薬で食事をするかのような量ですね…どうぞ、今ここにある在庫のすべてです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090304
					],
					"speakerTitle": "桂"
				},
				{
					"id": 110090304,
					"content": "感謝する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090305
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090305,
					"content": "ほ、ほんとに食べてるぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110090306,
					"content": "衆人が驚いて視線を集める中、申鶴はそこにあった薬材を全て平らげてしまった。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						110090307
					]
				},
				{
					"id": 110090307,
					"content": "これで十分だ、馳走になった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090308,
						110090309
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090308,
					"content": "味はどうだった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090310
					]
				},
				{
					"id": 110090310,
					"content": "いや、不味い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090311
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090311,
					"content": "ほのかな清涼感はあるものの、食べ過ぎれば、口の中に残るのは苦味と酸味と渋味のみだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090312
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090312,
					"content": "じゃあ、申鶴はどうしてお店の料理じゃなくて、薬材をわざわざ食べるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110090313,
					"content": "モラをたくさん持ってるんだろ。オイラだったら一番高級なお店に行って、たっくさん料理を注文して、それを一気に食べるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090314
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110090314,
					"content": "それは、今後この地に留まるかどうか、我自身にも分からぬからだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090315
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090315,
					"content": "世の料理は美味なるもの。しかし、いずれ山に戻ってしまえば、その美食への想いが修行の妨げになる恐れがある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090316
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090316,
					"content": "それゆえ、軽く味わうだけにし、どのようなものか知るだけに留めたのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090317
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090317,
					"content": "#山に戻って…{NICKNAME}、間違いない、こいつ仙人だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090318
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110090318,
					"content": "我のことはともかく、主らはこれからどうするのだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090319
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090319,
					"content": "そうだ、忘れるところだった！オイラたち群玉閣を再建するために、その素材集めを競ってるんだったよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090320
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110090320,
					"content": "ここで時間を潰してたら、他の人に先を越されちゃうぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090321
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110090321,
					"content": "そうか。その件なら、我も道すがら耳にした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090322
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090322,
					"content": "へへっ…もし他の人より早く集めることができたら、どんな質問にも答えてくれるらしいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090323
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110090323,
					"content": "まさか、申鶴も参加しに来たのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090324
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110090324,
					"content": "確かに我もその件で来たのだが、そういった競い合いに参加するつもりは毛頭ない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090325
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090325,
					"content": "だが、主たちには世話になった分、我も役に立ちたいと思う。安心するがいい、見返りを求めはしない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090326
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090326,
					"content": "えっ…申鶴はそれでいいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090327
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110090327,
					"content": "でも仙人に手伝ってもらえたら、素材集めも順調に進みそうだよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090328,
						110090329
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110090328,
					"content": "じゃあ、一緒に行動しよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090330
					]
				},
				{
					"id": 110090330,
					"content": "ならば善は急げだ。我に一つ案がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090331
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090331,
					"content": "おう！申鶴の案なら、きっとすごいんだろうな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090332
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110090332,
					"content": "すごいかどうかは分からぬが、十分な効果は期待できるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090333
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090333,
					"content": "我らより先行している者を全員排除すれば、一番になれると思うのだが、どうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090334
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090334,
					"content": "…ダーメーだ！どう考えても、やっちゃいけないことだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090335
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110090335,
					"content": "そうなのか？だが、競い合いとは互いを排斥し合って、裏で策を弄するものだと聞いたが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090336
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090336,
					"content": "オイラたちは正々堂々勝負して、一番になるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090337
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110090337,
					"content": "「鳴霞浮生石」、「千奇核心」、そして「仙家呪符」…順番に探そうぜ。まずは浮生の石からだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090338
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110090338,
					"content": "店の外から何やら話し合う声が聞こえると思ったら、あなたたちでしたか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090339
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110090339,
					"content": "あっ、白朮！どうしたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090340
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110090340,
					"content": "凝光さんから、傷薬をまとめて仕入れたいという依頼があったのです。ただ、どうも店の在庫が足りないようでして、これから調達しに行くところなんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090341
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110090341,
					"content": "凝光は、どうしてそんなに傷薬を必要としてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090342
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110090342,
					"content": "それは私にも分かりません。群玉閣を再建するお話は私も聞いていますが、その現場で使うのでしょうか？ですが、お客様側の事情ですので、あまり深くは追求しないようにしようかと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090343
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110090343,
					"content": "それから、凝光さんは私から七七を借りていきました。ですから、不卜廬は現在かなりの人手不足でして…どうでしょう、あなたたちここで働いてみませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090344
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110090344,
					"content": "悪いな、オイラたち他にやることがあるんだ…そうだ、白朮って物知りだし、「鳴霞浮生石」について聞いたことってないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090345
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110090345,
					"content": "群玉閣の再建に必要な素材でしょうか？確か『七臧山経』にそれについての記述がありましたね。鳴霞浮生石を活性化させれば雲の上まで飛べるとか、非常に貴重なものです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090346
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110090346,
					"content": "文献に記録されている「鳴霞浮生石」は、もうほぼ誰かに採掘されています。これに関しては、私よりも飛雲商会のほうが詳しいでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090347
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110090347,
					"content": "なるほど。じゃあ、飛雲商会に行って聞いてみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090348
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110090348,
					"content": "白朮、ありがとな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090349
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110090349,
					"content": "どういたしまして、上手くいくことを祈っています。他に何か必要なことがあれば、遠慮せず不卜廬にいらしてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "白朮"
				},
				{
					"id": 110090329,
					"content": "よろしく。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090330
					]
				},
				{
					"id": 110090309,
					"content": "本当に美味しいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090310
					]
				}
			]
		},
