				"points": []
			},
			"dialogs": [
				{
					"id": 725000101,
					"content": "大変だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000102
					],
					"speakerTitle": "守"
				},
				{
					"id": 725000102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725000103
					]
				},
				{
					"id": 725000103,
					"content": "親分がまた捕まっちまった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000104
					],
					"speakerTitle": "守"
				},
				{
					"id": 725000104,
					"content": "ついさっき、天領奉行のやつらが掲示板にお知らせを貼ったんだ。で、俺らの祭典が中止されることになった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000105
					],
					"speakerTitle": "守"
				},
				{
					"id": 725000105,
					"content": "詳しいことは分からんが、どうやら親分が天守閣の中でチラシを配ったらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000106
					],
					"speakerTitle": "守"
				},
				{
					"id": 725000106,
					"content": "将軍様もきっと荒瀧極上盛世豪鼓大祭典に参加したいはずだ、とか言ってたそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000107
					],
					"speakerTitle": "守"
				},
				{
					"id": 725000107,
					"content": "え？親分の言ってること、間違ってなくないか。将軍様だって、きっと参加したいだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000108
					],
					"speakerTitle": "晃"
				},
				{
					"id": 725000108,
					"content": "ああ、そうだよな。お前はそう思わないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000109
					],
					"speakerTitle": "元太"
				},
				{
					"id": 725000109,
					"content": "はぁ、俺らの考えなんて今はどうだっていい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000110
					],
					"speakerTitle": "守"
				},
				{
					"id": 725000110,
					"content": "とにかく、親分はその場で見張りの奥詰衆に捕まって、天領奉行に連行されちまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000111
					],
					"speakerTitle": "守"
				},
				{
					"id": 725000111,
					"content": "どうしたらいい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725000112
					]
				},
				{
					"id": 725000112,
					"content": "大丈夫、忍の姉御が解決してくれるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000113
					],
					"speakerTitle": "守"
				},
				{
					"id": 725000113,
					"content": "親分は軍事機密区域を荒らした疑いで、奥詰衆に連行された。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000114
					],
					"speakerTitle": "守"
				},
				{
					"id": 725000114,
					"content": "その後、あの九条裟羅様が親分の容疑を公序良俗違反に変えたそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000115
					],
					"speakerTitle": "守"
				},
				{
					"id": 725000115,
					"content": "くそッ！あの九条の天狗め、よくも親分にそんな重い罪を！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000116
					],
					"speakerTitle": "元太"
				},
				{
					"id": 725000116,
					"content": "おい、バカ！これは罪が軽くなったんだよ。これなら所内で指導を受けるだけで済むはずだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000117
					],
					"speakerTitle": "守"
				},
				{
					"id": 725000117,
					"content": "祭典のほうは、親分が出所するまで再開できないだろうけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000118
					],
					"speakerTitle": "守"
				},
				{
					"id": 725000118,
					"content": "旅人、心配しないでくれ。忍の姉御が上手いこと処理してくれる、きっと大丈夫だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000119
					],
					"speakerTitle": "守"
				},
				{
					"id": 725000119,
					"content": "ひとまず、俺らの祭典を支援してくれてありがとな。親分が出てきたら、きっとお前のところに直接礼をしに行くはずだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000120
					],
					"speakerTitle": "守"
				},
				{
					"id": 725000120,
					"content": "お前の旅が俺らの祭典と同じように、より良くなることを願ってるぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000121
					],
					"speakerTitle": "守"
				},
				{
					"id": 725000121,
					"content": "良くなることを願ってるぜ！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "守"
				}
			]
		}
	]
}