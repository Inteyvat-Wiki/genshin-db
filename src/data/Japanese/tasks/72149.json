			"trigger": {
				"objectNames": [
					"露子",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721490201,
					"content": "#おかえりなさい、{NICKNAME}さん。どうされましたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490202
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721490202,
					"content": "依頼について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490203
					]
				},
				{
					"id": 721490203,
					"content": "もう4つの「御霊真珠」を手に入れたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721490204,
					"content": "本当ですか？素晴らしいです、ありがとうございます！ではこれから、最後の「心」の封印を解けば、あと少しで解決ですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490205
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721490205,
					"content": "お二方には私と一緒に行っていただく必要があります。どうかご理解ください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490206
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721490206,
					"content": "#もうここまで来たんだ、もうちょっと歩いたって気にしないぜ！そうだよな、{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490207,
						721490208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721490207,
					"content": "うん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490209
					]
				},
				{
					"id": 721490209,
					"content": "ではさっそく、出発しましょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "露子"
				},
				{
					"id": 721490208,
					"content": "別に気にしない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490209
					]
				}
			]
		},
		{
			"id": 7214903,
			"completionStepIds": [
				7214906
			],
