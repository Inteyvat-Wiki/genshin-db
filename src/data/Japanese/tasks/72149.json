					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721490301,
					"content": "うーん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490302
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721490302,
					"content": "露子さん…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490303
					]
				},
				{
					"id": 721490303,
					"content": "あっ、すみません、考え事をしていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490304
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721490304,
					"content": "「月浴淵の鍵」を入手するため、手伝っていただいてありがとうございます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490305
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721490305,
					"content": "「げつよくえんのかぎ」…言いにくいな…なんなんだそれ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721490306,
					"content": "あははっ、「淵の鍵」で大丈夫ですよ。外国の方に、読みの正確さを求めることはしません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490307
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721490307,
					"content": "淵下宮の入り口を開けるために必須となる物です。大御神様の流れる血によって構成されています…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490308
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721490308,
					"content": "伝説ではそう言われています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490309
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721490309,
					"content": "そっか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721490310,
					"content": "また迷信だね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490311
					]
				},
				{
					"id": 721490311,
					"content": "そんなことはありません、その逆です…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490312
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721490312,
					"content": "これから現人神の巫女様に報告し、承認をもらってから、霊脈の流れが正確になるのを待つ必要があります…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490313
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721490313,
					"content": "その後でやっと、淵下宮に入ることができるのです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490314
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721490314,
					"content": "じゃあ、オイラたちがしてきたことは、なんだったんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490315
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721490315,
					"content": "収穫がなかったというわけではありません！そうですよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490316
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721490316,
					"content": "例えば…あなたたちは珊瑚宮側と深い友情を手に入れました！海祇島は今後もあなたたちを歓迎いたします！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490317
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721490317,
					"content": "なんだよ！嘘くさいな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490318
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721490318,
					"content": "…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490319
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721490319,
					"content": "文献によれば、「御霊真珠」は誠実な者の召喚にのみ応え、「月浴淵の鍵」は心が清らかな者にのみ集まるといいます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490320
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721490320,
					"content": "私はそのような文書を信じていませんが、あなたが海祇島に転機をもたらすことを信じていますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490321
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721490321,
					"content": "では、淵下宮の刻がおとずれし時に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490322,
						721490323
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721490322,
					"content": "また会おう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490325
					]
				},
				{
					"id": 721490325,
					"content": "では、また。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "露子"
				},
				{
					"id": 721490323,
					"content": "もう一回おみくじを引く？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490324
					]
				},
				{
					"id": 721490324,
					"content": "うふふ、私のくじ運はとても良いんですよ。きっとまたお会いできます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490325
					],
					"speakerTitle": "露子"
				}
			]
		},
