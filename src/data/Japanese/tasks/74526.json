			"dialogs": [
				{
					"id": 745260401,
					"content": "#あっ、{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745260402,
						745260403
					],
					"speakerTitle": "ニィロウ"
				},
				{
					"id": 745260402,
					"content": "ニィロウはダンスの練習中？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260404
					]
				},
				{
					"id": 745260404,
					"content": "ううん、そんなことないよ。雨上がりのパティサラが、花びらに露を乗せた姿から、新しいダンスを考えてたところなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745260405
					],
					"speakerTitle": "ニィロウ"
				},
				{
					"id": 745260405,
					"content": "でもまだちゃんと形になってなくて、動きに優雅さが足りないんだ。それに、他にも何か欠けてる気がして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745260406,
						745260407
					],
					"speakerTitle": "ニィロウ"
				},
				{
					"id": 745260406,
					"content": "すごくきれいなイメージだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260408
					]
				},
				{
					"id": 745260408,
					"content": "私を撮ってくれるの？でも、さっきも言ったけど、このダンスはまだちゃんと踊れなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745260409,
						745260410
					],
					"speakerTitle": "ニィロウ"
				},
				{
					"id": 745260409,
					"content": "ダンスを完成させるための練習…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260411
					]
				},
				{
					"id": 745260411,
					"content": "うーん…分かった。想いを込めて踊るから…そのレンズで、花が咲き誇る一瞬を切り取ってね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ニィロウ"
				},
				{
					"id": 745260410,
					"content": "それも芸術だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260411
					]
				},
				{
					"id": 745260407,
					"content": "ねえ、写真を撮らせてもらえないかな？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260408
					]
				},
				{
					"id": 745260403,
					"content": "邪魔しちゃった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260404
					]
				}
			]
		}
	]
