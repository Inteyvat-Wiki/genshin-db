							9843.676
						],
						"pointId": 1
					}
				]
			},
			"dialogs": [
				{
					"id": 80160401,
					"content": "ふぅ…スッキリ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160402
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 80160402,
					"content": "さすが黒曜石の老婆だな。アンタがいるって分かってたら、「謎煙の主」へ支援に来ることの必要性を考え直してたのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160403
					],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 80160403,
					"content": "どこへ来るか、考え直したほうがよかったのはアビス教団のほうよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160404
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 80160404,
					"content": "経験からして、さっき連中が襲ってきた方角にアビス教団の拠点があるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160405
					],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 80160405,
					"content": "この勢いで畳みかけて、一気にやつらの拠点を叩いちゃおうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160406
					],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 80160406,
					"content": "ここで戦闘があったのですね？手は必要ですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160407
					],
					"speakerTitle": "ストゥーラ"
				},
				{
					"id": 80160407,
					"content": "「謎煙の主」の戦士たちも来たぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80160408,
					"content": "あれだけの大戦の後だ、みんなの連携も抜群だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160409
					],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 80160409,
					"content": "みんな、いいか！この勢いで一気に攻め込むぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イアンサ"
				}
			]
		},
		{
			"id": 801605,
			"completionStepIds": [
				801605
			],
			"beginWay": "TALK_BEGIN_MANUAL",
