						],
						"pointId": 1
					}
				]
			},
			"dialogs": [
				{
					"id": 80160501,
					"content": "あれ、シトラリじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80160502,
					"content": "キミたち、どうしてココに？もしかして増援？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160503
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 80160503,
					"content": "ああ、炎神様の指示でな。状況はどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160504
					],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 80160504,
					"content": "おまえが家に引きこもらずに、こんなとこにいるなんて…よっぽどヤバい状況なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80160505,
					"content": "ヤバい…ってほどじゃないけど、ちょっとイライラしちゃって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160506
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 80160506,
					"content": "各部族の中でも「謎煙の主」が集中的にコーゲキされてるって言うじゃない…ワタシたちが弱いとでも思われてるのかしら？むぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160507
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 80160507,
					"content": "考えれば考えるほどムカついてきちゃって、家にいても全然本に集中できないし…もうっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160508
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 80160508,
					"content": "なるほどな、それで怒ってたのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160509
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80160509,
					"content": "「アビス教団」なんて、名前からしてセンスゼロよね。読者にとってわかりやすいってトコだけがとりえの、三流小説の悪役みたい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160510
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 80160510,
					"content": "#{M#妹さん}{F#お兄さん}の組織、ひどい言われようだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160511,
						80160512
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80160511,
					"content": "#{M#俺}{F#私}も常々そう思ってた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160513
					]
				},
				{
					"id": 80160513,
					"content": "#ん？え…！？つまり、{M#妹さん}{F#お兄さん}はアビス教団側の人なの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160514
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 80160514,
					"content": "（ムカついてたからって、さすがに言い過ぎたかも…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160515
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 80160515,
					"content": "みんな、迎撃が先だ。あとで話そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160516
					],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 80160516,
					"content": "ナイスタイミング！いいストレス発散になりそうね！ついでに気まずい空気もなんとかなりそう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160517
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 80160517,
					"content": "最後のは言わなくてよかったんじゃないか…？とにかく、みんな行こうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80160512,
					"content": "#{M#もし俺なら、とっくに改名してる。}{F#もし私なら、とっくに改名してる。}",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160513
					]
				}
			]
		},
