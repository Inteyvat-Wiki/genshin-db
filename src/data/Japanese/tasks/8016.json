			"dialogs": [
				{
					"id": 80160701,
					"content": "拠点を制圧したぞ。みんな、よく頑張ったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160702
					],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 80160702,
					"content": "アビス教団のやつら、大したことなかったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160703
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80160703,
					"content": "満足できる結果でもなかったケドね。「謎煙の主」の実力を認めさせて、ちゃんと謝ってもらうつもりだったのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160704
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 80160704,
					"content": "ま、いっか。さっさと帰って祝い酒でも飲んで、モヤモヤを吹っ飛ばしましょっと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160705
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 80160705,
					"content": "拠点を排除したから、しばらくは周辺のやつらも大人しくなるだろうな。でも…まだ気を抜かない方がよさそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160706
					],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 80160706,
					"content": "気づいたか？普通なら、拠点の攻略が終盤に近づくほど、敵の抵抗は激しくなるはずなのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160707
					],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 80160707,
					"content": "さっきの戦い…本気で抵抗してたのはほんの一部だけで、他の連中は何かを察したかのように、撤退していっただろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160708
					],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 80160708,
					"content": "ナニか問題でもあるの？拠点を戦略的に放棄しただけじゃない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160709
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 80160709,
					"content": "いや、そうは見えなかったな。何てったって、国相手に戦争を仕掛けてきたんだぞ。猛烈な勢いで侵攻してきたにしては、さっきの動きはどうも違和感がある…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160710
					],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 80160710,
					"content": "つまり、アビス教団は何か企んでるってこと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160711
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 80160711,
					"content": "情報が出揃ってないから、確かなことは言えないけど…警戒を怠らず、防御をしっかり固めておこう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160712
					],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 80160712,
					"content": "（結局、アビス教団の目的については何も分からなかった。情報が足りなすぎる…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160713
					]
				},
				{
					"id": 80160713,
					"content": "#{M#（もし蛍に会えたら、俺の問題もナタの問題も、解決できるかもしれない。）}{F#（もしお兄ちゃんに会えたら、私の問題もナタの問題も、解決できるかも。）}",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160714,
						80160715
					]
				},
				{
					"id": 80160714,
					"content": "「豊穣の邦」にもう一度行ってくる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160716
					]
				},
				{
					"id": 80160716,
					"content": "やっぱり鍵のことが気になるのか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160717
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80160717,
					"content": "もし鍵を手がかりに兄妹の居場所が分かれば、やっと会えるかもしれないし…戦いだって早く終わるかもしれないもんな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160718
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80160718,
					"content": "え、もう行っちゃうの？一段落祝いに一杯やろうって誘おうか、迷ってたトコロだったのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160719
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 80160719,
					"content": "ここにはシトラリばあさまもアタシもいる。安心して行ってきな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 80160715,
					"content": "あの鍵が、唯一の手がかりだから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160716
					]
				}
			]
		},
