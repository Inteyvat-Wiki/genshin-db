					}
				]
			},
			"dialogs": [
				{
					"id": 80160301,
					"content": "炎神様！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160302
					],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 80160302,
					"content": "ほう？君の方から来るとはな。ちょうど人を遣ろうとしていたところだ、イアンサ。旅人もいるなんて、なおさら好都合だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160303
					],
					"speakerTitle": "マーヴィカ"
				},
				{
					"id": 80160303,
					"content": "状況は分かりましたか？伝達使から何か報告は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160304
					],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 80160304,
					"content": "ナタの各地にアビス教団の者が一斉に現れた。明らかに組織的かつ計画的な動きだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160305
					],
					"speakerTitle": "マーヴィカ"
				},
				{
					"id": 80160305,
					"content": "数も相当多いとみえる。アビス教団の勢力が知らないうちにここまで拡大していたなんて、この件がなければ知る由もなかっただろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160306
					],
					"speakerTitle": "マーヴィカ"
				},
				{
					"id": 80160306,
					"content": "つまり…総力を挙げて攻めてきたのですか？でも、目的は一体…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160307
					],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 80160307,
					"content": "私も疑問に思っている。アビス教団はこれまでナタでほとんど動きをみせなかったし、何か因縁があるわけでもない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160308
					],
					"speakerTitle": "マーヴィカ"
				},
				{
					"id": 80160308,
					"content": "まさか…ナタに敗れた「アビス」の仇を討つため…なんてことはないですよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160309
					],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 80160309,
					"content": "理由としてはちょっと弱い気もするけど、あいつらなら十分あり得るぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80160310,
					"content": "まだ断定はできん。相手の真の目的を探る必要があるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160311
					],
					"speakerTitle": "マーヴィカ"
				},
				{
					"id": 80160311,
					"content": "それで、勝てそうなのか？被害はどんな感じなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80160312,
					"content": "確かに連中は総力戦を仕掛けてきた。だが、アビス教団が今相手にしているのは、真のアビスと戦い、勝利を掴んだばかりのナタの勇士たちだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160313
					],
					"speakerTitle": "マーヴィカ"
				},
				{
					"id": 80160313,
					"content": "しかも、そんな勇士たちが国中にいる——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160314
					],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 80160314,
					"content": "ああ。アビス教団の戦力は本物の「アビス」とは雲泥の差だ。あの終わりなき猛攻のような気迫は感じられないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160315
					],
					"speakerTitle": "マーヴィカ"
				},
				{
					"id": 80160315,
					"content": "だが、「戦争」と同じように重く受け止め、被害を最小限にとどめなければならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160316
					],
					"speakerTitle": "マーヴィカ"
				},
				{
					"id": 80160316,
					"content": "各部族にはすでに防衛態勢を整えてもらっている。旅人、今回の件はナタの問題だ。君は私と共に聖火競技場に留まってくれても——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160317
					],
					"speakerTitle": "マーヴィカ"
				},
				{
					"id": 80160317,
					"content": "#いや、今回の件は{M#俺}{F#私}に関係がある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160318
					]
				},
				{
					"id": 80160318,
					"content": "どういうことだ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160319,
						80160320
					],
					"speakerTitle": "マーヴィカ"
				},
				{
					"id": 80160319,
					"content": "今、アビス教団を統治しているのは…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160321
					]
				},
				{
					"id": 80160321,
					"content": "そうなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160322
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80160322,
					"content": "まさか…そんな関係があったとはな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160323
					],
					"speakerTitle": "マーヴィカ"
				},
				{
					"id": 80160323,
					"content": "#それで、君は{M#彼女}{F#彼}の目的を知っているのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160324
					],
					"speakerTitle": "マーヴィカ"
				},
				{
					"id": 80160324,
					"content": "#{M#俺}{F#私}もそれを探ろうとしてる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160325
					]
				},
				{
					"id": 80160325,
					"content": "今、二人の関係はそんなに良くないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160326
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80160326,
					"content": "#一体なにが起きたのか、{M#妹さん}{F#お兄さん}に会って確かめようとしてるんだけど…向こうはずっとこいつを避けてるみたいでさ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160327
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80160327,
					"content": "なるほど、兄妹ゲンカか…うん、よくあることだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160328
					],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 80160328,
					"content": "だな…って、おい！ほんとに状況をちゃんと理解してるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160329
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80160329,
					"content": "さすが君たちだな。兄妹ゲンカ一つで、世界の運命さえも揺るがすとは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160330
					],
					"speakerTitle": "マーヴィカ"
				},
				{
					"id": 80160330,
					"content": "今回の襲撃については君も予想だにしていなかった…そして君は、これまでと同様ナタを応援してくれる——そう思っていいだろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160331,
						80160332
					],
					"speakerTitle": "マーヴィカ"
				},
				{
					"id": 80160331,
					"content": "もちろん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160333
					]
				},
				{
					"id": 80160333,
					"content": "ハハハッ、それなら安心だ。一瞬、板挟みになるかと思ってドキッとしたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160334
					],
					"speakerTitle": "マーヴィカ"
				},
				{
					"id": 80160334,
					"content": "現時点の情報によれば、アビス教団は「謎煙の主」のほうへ武力を集中させているようだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160335
					],
					"speakerTitle": "マーヴィカ"
				},
				{
					"id": 80160335,
					"content": "ここに残るつもりがないなら、「謎煙の主」を支援してくれると助かる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160336
					],
					"speakerTitle": "マーヴィカ"
				},
				{
					"id": 80160336,
					"content": "もちろん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160337
					]
				},
				{
					"id": 80160337,
					"content": "アタシも一緒に行くぞ。今のところ、「豊穣の邦」への攻撃は落ち着いてるからな。戦力は必要なところに分配するべきだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160338
					],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 80160338,
					"content": "ああ、任せたぞ。助けが必要になったら、すぐに知らせてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マーヴィカ"
				},
				{
					"id": 80160332,
					"content": "アビス教団には一発お見舞いしたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160333
					]
				},
				{
					"id": 80160320,
					"content": "#{M#俺の妹}{F#私のお兄ちゃん}だから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160321
					]
				}
			]
		},
