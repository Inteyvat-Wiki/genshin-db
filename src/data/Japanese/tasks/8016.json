			"trigger": {
				"objectNames": [
					"イアンサ"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2649.083,
							279.082,
							10084.27
						],
						"pointId": 351500003
					}
				]
			},
			"dialogs": [
				{
					"id": 80160101,
					"content": "我らが英雄「トゥマ{RUBY#[S]希望}イニ」とパイモンじゃないか。こんなところで会えるとはな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160102
					],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 80160102,
					"content": "イアンサ！ここでなにしてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80160103,
					"content": "ね…念のため言っとくけどな！オイラたち、別におまえを探しに来たわけじゃないからな！おまえのダイエットとか筋トレには、今んとこぜんっぜん興味ないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80160104,
					"content": "ハハッ、分かってるって。アタシも鬼コーチじゃないからな。教え子の意志はちゃんと尊重するぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160105
					],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 80160105,
					"content": "ま、でも適度な有酸素運動は「百利あって一害なし」だ。軽く動くだけでも違うんだぞ。例えば、アタシの代わりにこの辺りの見回りをしてくれる、とかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160106,
						80160107
					],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 80160106,
					"content": "それ、トレーニングっていうより…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160108
					]
				},
				{
					"id": 80160108,
					"content": "ああ、冗談だ。実は助っ人が欲しくてさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160109
					],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 80160109,
					"content": "今、「豊穣の邦」ではボディビル大会の準備をしてるんだけど、追い込みトレーニングをしたいからって理由で当直を抜けるやつが多すぎて、見回りの人手が足りないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160110
					],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 80160110,
					"content": "だからって、おまえが見回りしてるのかよ？大会に向けて準備しなくていいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80160111,
					"content": "最高のコンディションを作るには、日ごろからのトレーニングが大事だ。直前になって焦ったってしょうがないだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160112
					],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 80160112,
					"content": "それに…見ての通り、アタシの体格じゃメジャーな階級には出られないし、出られる階級には張り合える相手がいないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160113
					],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 80160113,
					"content": "そういうことか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80160114,
					"content": "な、なんでこっちを見るんだよ！オイラを出場させる気じゃないだろうな？そもそも同じ階級にはならないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80160115,
					"content": "なぁ旅人、さっさと手伝ってやろうぜ。じゃないと大会に引きずり出されそうだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80160116,
					"content": "へへっ、目配せだけで依頼を受けてもらえちゃうなんてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160117,
						80160118
					],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 80160117,
					"content": "まあいいよ、パイモンの願いだし。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160119
					]
				},
				{
					"id": 80160119,
					"content": "二人ともありがとな。とりあえず、辺りに異常がないか確認してくれれば十分だ。簡単に見回ってくれればそれでいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160120
					],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 80160120,
					"content": "アタシはあっちを見回ってくる。あとで「豊穣の邦」で落ち合おう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160121
					],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 80160121,
					"content": "まかせろ！また後でな、イアンサ。オイラたち、ぶらぶらするのは得意なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80160118,
					"content": "まあいいよ、イアンサの願いだし。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160119
					]
				},
				{
					"id": 80160107,
					"content": "助っ人じゃ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160108
					]
				}
			]
		},
		{
