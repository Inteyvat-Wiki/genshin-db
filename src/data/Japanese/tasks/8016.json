			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ヒルチャール"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2695.591,
							282.595,
							9928.808
						],
						"pointId": 351500004
					}
				]
			},
			"dialogs": [
				{
					"id": 80160201,
					"content": "あれ、ヒルチャールがいるぞ。休んでるのかな？攻撃してくる気配はないみたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80160202,
					"content": "なんでこんなところに隠れてるんだ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80160203,
					"content": "あっ、起こしちゃったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80160204,
					"content": "ん？逃げたぞ…へへ、ナタの有名人、オイラたちのオーラに威圧されたのかもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80160205,
					"content": "何か落ちてる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160206
					]
				},
				{
					"id": 80160206,
					"content": "あのキラキラのやつか？きっとヒルチャールが落としていったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80160207,
					"content": "うーん…宝物を拾ったと思ってここに隠そうとしたところを、オイラたちに見つかって慌てて落としたんだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80160208,
					"content": "ちょっと見せてくれ！まぁ、ヒルチャールのことだし、どうせ大したものじゃないだろうけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80160209,
					"content": "…！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160210
					]
				},
				{
					"id": 80160210,
					"content": "どうしたんだ？真剣な顔して。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80160211,
					"content": "普通の鍵じゃないか。でも、確かに変わってるな——ナタっぽくはないし…うーん…どこの国のやつだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160212,
						80160213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80160212,
					"content": "これは…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160214
					]
				},
				{
					"id": 80160214,
					"content": "宇宙船スリープポッド？えっ、なんの宇宙船だ？スリープポッドって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160215
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80160215,
					"content": "ちょ、ちょっと待てよ！宇宙船スリープポッド？ま、まさか！おまえがテイワットに来た時に乗ってた宇宙船のことか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80160216,
					"content": "うん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160217
					]
				},
				{
					"id": 80160217,
					"content": "でも、なんでその鍵がこんなところに！？お、おまえが落としたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160218,
						80160219
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80160218,
					"content": "自分のはここにある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160220
					]
				},
				{
					"id": 80160220,
					"content": "うーん、完全に同じものみたいだな…おまえのものじゃないってことは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160221,
						80160222
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80160221,
					"content": "鍵は全部で二本しかない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160223
					]
				},
				{
					"id": 80160223,
					"content": "やっぱりな…うーん、オイラ、今やっとおまえが「宇宙人」…じゃなくて「降臨者」なんだなって実感したぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160224
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80160224,
					"content": "状況を整理して、論理的に考えると…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160225
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80160225,
					"content": "#ヒルチャールがこの鍵を拾って隠してたってことは、おまえの{M#妹さん}{F#お兄さん}がこの近くで落としたってことだよな…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160226
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80160226,
					"content": "#つまり、{M#妹さん}{F#お兄さん}は最近この辺りに来てたんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160227,
						80160228
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80160227,
					"content": "ってことは…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160229
					]
				},
				{
					"id": 80160229,
					"content": "#そうだな…何気なくイアンサの見回りを手伝っただけなのに、とんだ大発見だったぜ。{M#妹さん}{F#お兄さん}の手がかりまで見つかるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160230
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80160230,
					"content": "このままここで手がかりを探すか？それとも先に「豊穣の邦」に戻ってイアンサに報告したほうがいいのか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160231
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80160231,
					"content": "ここにいたのか、お疲れ様。しっかり見回ってくれてるみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160232
					],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 80160232,
					"content": "イアンサ！なんでここに？「豊穣の邦」で落ち合う約束だっただろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160233
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80160233,
					"content": "ちょうど大発見があって、おまえを探しに行こうかって話してたところだったんだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160234
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80160234,
					"content": "見回る必要はなくなったって伝えに来たんだ。ついさっき、ボディビル大会が中止になってな。もうすぐパトロール隊が見回りを引き継いでくれる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160235
					],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 80160235,
					"content": "急に中止だなんて、なにがあったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160236
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80160236,
					"content": "「アビス教団」が攻めてきたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160237
					],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 80160237,
					"content": "えっ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160238
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80160238,
					"content": "こんなに早く予想が的中するなんて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160239
					]
				},
				{
					"id": 80160239,
					"content": "#{M#（…蛍がまた動き出したみたいだな。）}{F#（…お兄ちゃんがまた動き出したみたい。）}",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160240
					]
				},
				{
					"id": 80160240,
					"content": "#{M#（今度こそチャンスを逃さず、ちゃんと話さないと。）}{F#（今度こそチャンスを逃さず、ちゃんと話さないと。）}",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160241
					]
				},
				{
					"id": 80160241,
					"content": "アビス教団の名は知ってたが、これほど大規模で広範囲な動きを見せるのは初めてだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160242
					],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 80160242,
					"content": "まるで…ナタ相手に戦争を仕掛けようとしてるような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160243
					],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 80160243,
					"content": "デカいとは言っても、所詮ただの「教団」だろ？それが「戦争の国」ナタと戦うつもりだなんて、信じられないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160244
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80160244,
					"content": "アビス教団って、普段はコソコソ行動してるイメージだよな。オイラたちも、こんな状況は初めてだぞ…一体なにをしようとしてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160245
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80160245,
					"content": "豊穣の邦の情報だけじゃ、戦況はハッキリしないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160246
					],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 80160246,
					"content": "防衛は今のところ問題なさそうだ。アタシは聖火競技場に行って炎神様に状況を確認してくる。あそこがナタの中枢だからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160247
					],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 80160247,
					"content": "一緒に来てくれるか？ナタの英雄がいてくれたら、心強い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160248,
						80160249
					],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 80160248,
					"content": "#{M#俺}{F#私}も状況を確認しにいきたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160250
					]
				},
				{
					"id": 80160250,
					"content": "よし、じゃあ一緒に行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 80160249,
					"content": "アビス教団についてなら少し知ってるから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160250
					]
				},
				{
					"id": 80160228,
					"content": "「アビス教団」も来てた可能性が高い。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160229
					]
				},
				{
					"id": 80160222,
					"content": "#{M#俺と蛍が一つずつ持ってる。}{F#私とお兄ちゃんが一つずつ持ってる。}",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160223
					]
				},
				{
					"id": 80160219,
					"content": "…いつもちゃんと持ち歩いてるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160220
					]
				},
				{
					"id": 80160213,
					"content": "…宇宙船スリープポッドの鍵。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160214
					]
				}
			]
		},
		{
			"id": 801603,
