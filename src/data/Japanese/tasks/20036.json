			"trigger": {
				"objectNames": [
					"グローリー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200360101,
					"content": "…グッドウィン…いつ帰って来てくれるのでしょうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360102
					],
					"speakerTitle": "グローリー"
				},
				{
					"id": 200360102,
					"content": "こんにちは…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360103
					]
				},
				{
					"id": 200360103,
					"content": "この声…遠くから来た旅人でしょうか？きっと風神様の風があなたを連れてきたのでしょう…どうか私の願いを聞いてくれませんか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360104
					],
					"speakerTitle": "グローリー"
				},
				{
					"id": 200360104,
					"content": "私の…えっと、恋人の西風騎士、グッドウィンがモンドを出てから随分時間が経ちました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360105
					],
					"speakerTitle": "グローリー"
				},
				{
					"id": 200360105,
					"content": "彼からの連絡は一切ありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360106
					],
					"speakerTitle": "グローリー"
				},
				{
					"id": 200360106,
					"content": "グッドウィンが心配です。彼はヒルチャールたち、そしてアビス教団と戦うと言っていました。もし怪我したらどうしようと思って…それにもし、彼が優しい女性騎士と出会ったら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360107
					],
					"speakerTitle": "グローリー"
				},
				{
					"id": 200360107,
					"content": "ご、ごめんなさい！話しすぎましたね！蒲公英は人々の思いを風に乗せて遠くへ連れていくと母さんから聞きました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360108
					],
					"speakerTitle": "グローリー"
				},
				{
					"id": 200360108,
					"content": "どうか…私の代わりに風立ちの地で蒲公英を三つ集めてくれませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360109,
						200360110
					],
					"speakerTitle": "グローリー"
				},
				{
					"id": 200360109,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360111
					]
				},
				{
					"id": 200360111,
					"content": "ありがとうございます。あなたに風神のご加護があらんことを。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "グローリー"
				},
				{
					"id": 200360110,
					"content": "他に用事がある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360112
					]
				},
				{
					"id": 200360112,
					"content": "お願いします！あなたのような旅人にとっては簡単なことのはずです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "グローリー"
				}
			]
		},
		{
			"id": 2003602,
