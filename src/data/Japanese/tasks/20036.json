			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"グローリー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200360201,
					"content": "おかえりなさい。蒲公英は集めましたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360202
					],
					"speakerTitle": "グローリー"
				},
				{
					"id": 200360202,
					"content": "集めた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360203
					]
				},
				{
					"id": 200360203,
					"content": "ありがとうございます。蒲公英を私の手の上に置いてもらえませんか？目が見えないので、落としたくないのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360204
					],
					"speakerTitle": "グローリー"
				},
				{
					"id": 200360204,
					"content": "これで十分？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360205
					]
				},
				{
					"id": 200360205,
					"content": "蒲公英を私の手に置いてください。そうすれば感じることができます…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360206
					],
					"speakerTitle": "グローリー"
				},
				{
					"id": 200360206,
					"content": "これで十分です。グッドウィンに話したいことを蒲公英に伝えないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360207
					],
					"speakerTitle": "グローリー"
				},
				{
					"id": 200360207,
					"content": "えっと、少し耳を塞いでくれませんか？恋人の内緒話ですから…ふふっ、あなたにもこういう経験がありますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360208
					],
					"speakerTitle": "グローリー"
				},
				{
					"id": 200360208,
					"content": "できました。この蒲公英の種を風神の石像に持って行ってください。そしたら風神様の風がそれを遠くへ運んでくれますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360209
					],
					"speakerTitle": "グローリー"
				},
				{
					"id": 200360209,
					"content": "風神様、どうかグッドウィンの傍に運んでください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "グローリー"
				}
			]
		},
		{
			"id": 2003603,
			"completionStepIds": [
				2003606
