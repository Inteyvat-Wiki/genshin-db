			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"グローリー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200360301,
					"content": "もうできましたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360302
					],
					"speakerTitle": "グローリー"
				},
				{
					"id": 200360302,
					"content": "上は風が強い…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360303
					]
				},
				{
					"id": 200360303,
					"content": "それでいいのです。蒲公英が遠く飛べますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360304
					],
					"speakerTitle": "グローリー"
				},
				{
					"id": 200360304,
					"content": "そしたらグッドウィンも私の言葉を感じ取れるかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360305
					],
					"speakerTitle": "グローリー"
				},
				{
					"id": 200360305,
					"content": "手を出してください…はい、これはお礼です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360306
					],
					"speakerTitle": "グローリー"
				},
				{
					"id": 200360306,
					"content": "グッドウィンに話したいことがたくさんあります。またお願いするかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "グローリー"
				}
			]
		}
	]
