				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721830101,
					"content": "これは…種？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721830102,
					"content": "「鳴草」の種だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830103
					],
					"speakerTitle": "斑目百兵衛"
				},
				{
					"id": 721830103,
					"content": "この植物について知ってるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830104
					]
				},
				{
					"id": 721830104,
					"content": "ああ、多少なら。以前この植物を見たことがあって、他人からその不思議な点について聞いたことがある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830105
					],
					"speakerTitle": "斑目百兵衛"
				},
				{
					"id": 721830105,
					"content": "たしか…風のない時でも、この植物は微かに雷鳴の音を響かせるらしい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830106
					],
					"speakerTitle": "斑目百兵衛"
				},
				{
					"id": 721830106,
					"content": "綺麗な植物？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830107
					]
				},
				{
					"id": 721830107,
					"content": "見た目だけなら…綺麗と言えるかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830108
					],
					"speakerTitle": "斑目百兵衛"
				},
				{
					"id": 721830108,
					"content": "「鳴草」を植えたいのか？でも、この辺りには適した土地がないと思うが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830109
					],
					"speakerTitle": "斑目百兵衛"
				},
				{
					"id": 721830109,
					"content": "自分の土地を持ってる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830110
					]
				},
				{
					"id": 721830110,
					"content": "そ、そうか？流石だ…封地まで持っていたのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830111
					],
					"speakerTitle": "斑目百兵衛"
				},
				{
					"id": 721830111,
					"content": "ならば一つ聞いてもいいか、その封地はどこに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830112,
						721830115
					],
					"speakerTitle": "斑目百兵衛"
				},
				{
					"id": 721830112,
					"content": "稲妻じゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830113
					]
				},
				{
					"id": 721830113,
					"content": "おお！君がモンドと璃月で成した快挙なら耳にしたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830114
					],
					"speakerTitle": "斑目百兵衛"
				},
				{
					"id": 721830114,
					"content": "あれほどの快挙、封地を賜わるのもおかしくない。流石だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830120
					],
					"speakerTitle": "斑目百兵衛"
				},
				{
					"id": 721830120,
					"content": "なぁ、おまえの言った「土地」って、ばあやからもらった「塵歌壺」だよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721830121,
					"content": "あそこって本当に種を植えたりできるのか？ばあやも言ってなかったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830122,
						721830124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721830122,
					"content": "帰って聞いてみる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830123
					]
				},
				{
					"id": 721830123,
					"content": "よしっ、帰ったら聞いてみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721830124,
					"content": "仙人は強い。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830125
					]
				},
				{
					"id": 721830125,
					"content": "そ、そうだな？ばあやは確かに強いけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721830126,
					"content": "よしっ、帰ったら聞いてみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721830115,
					"content": "壺の中にある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830116
					]
				},
				{
					"id": 721830116,
					"content": "壺の…中？冗談はよしてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830117
					],
					"speakerTitle": "斑目百兵衛"
				},
				{
					"id": 721830117,
					"content": "君がモンドと璃月で成した快挙なら耳にしたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830118
					],
					"speakerTitle": "斑目百兵衛"
				},
				{
					"id": 721830118,
					"content": "その封地も璃月かモンドにあるのだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830119
					],
					"speakerTitle": "斑目百兵衛"
				},
				{
					"id": 721830119,
					"content": "はぁ、流石だな君は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830120
					],
					"speakerTitle": "斑目百兵衛"
				}
			]
		},
		{
			"id": 7218302,
