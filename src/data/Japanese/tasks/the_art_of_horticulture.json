			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ピンばあや"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721830201,
					"content": "うん？子供たちや、このばあやに何か用かい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830202
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 721830202,
					"content": "「鳴草」の種について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830203
					]
				},
				{
					"id": 721830203,
					"content": "種…ああ、この種を「塵歌壺」の中に植えたいんだね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830204
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 721830204,
					"content": "できなくはないよ、大きくはなくとも正真正銘の天地じゃからのう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830205
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 721830205,
					"content": "じゃが、今日持ってきたのはこの一種類だけのようじゃが、植えるのはこれだけかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830206
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 721830206,
					"content": "そ、そうだ！種を収集する方法を知らないんだった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721830207,
					"content": "この種を全部植えたら、次はどこで他の種を探せばいいんだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721830208,
					"content": "ほぉっほぉっ、焦ることない。ばあやがちょうど何年か前に使ってた匣がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830209
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 721830209,
					"content": "昔、花を移す時にこの匣を使っておった、この匣で花を保管すると良い、長持ちするじゃろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830210
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 721830210,
					"content": "それに、花をこの匣に植えると、種がいくつか手に入るんじゃ…これで栽培も容易になるじゃろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830211
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 721830211,
					"content": "今は昔ほど使い易くはないが…「種を出す」能力は残っておる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830212
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 721830212,
					"content": "まぁ…ばあやは長いことこの匣を使ってないから…子供たちにあげよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830213
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 721830213,
					"content": "花でも草でも、たとえ農作物でも、この匣は役立つじゃろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830214
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 721830214,
					"content": "ありがとう、ばあや！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830215
					]
				},
				{
					"id": 721830215,
					"content": "ありがとう、ばあや！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721830216,
					"content": "ほぉっほぉっ、礼ならいらないよ、早く試してみると良い。栽培はそう簡単なものではい、心してやるんじゃぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830217
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 721830217,
					"content": "ばあやはやっぱすごいな…そうだ、匣を試す前に、先に壺に戻って種を植えてみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721830218,
					"content": "ああ、早く大きくなるといいな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
}