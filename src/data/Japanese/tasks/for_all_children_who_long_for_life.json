				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パイモン",
					"アランマ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730370101,
					"content": "これは一体…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730370102,
					"content": "あれは前の戦争が終わった場所なんだ。ボクら…いや、カレらはマラーナの化身を抑え、四重の封印を使ってここに閉じ込めた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370103
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730370103,
					"content": "こわっ…じゃあ、マラーナの化身はこの中にいるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730370104,
					"content": "マラーナは自分の上に生えていたヴァサラの樹を侵蝕し、そこから血肉を吸い肉体を得た。このまま放っておけば、それが地上の命すべてを侵蝕することになる。",
