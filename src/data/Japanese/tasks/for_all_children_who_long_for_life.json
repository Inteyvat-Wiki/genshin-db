			},
			"dialogs": [
				{
					"id": 730370301,
					"content": "アランマ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730370302,
					"content": "アランマはもう新しいアシュヴァッタの樹になった。まだ小さいけど、どっしりと根を張っていて、とても強い。何度も月が過ぎたら、きっと大きくてきれいになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370303
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730370303,
					"content": "アランラナは言ってたよな。思い出と夢がアランナラの力になる、それはとても貴重なものだって。記憶を捨てたら、ラナのことも忘れるんだろ？それにヴィマラ村の子供たちのことも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730370304,
					"content": "うん。でも友達は思い出より大事。記憶はどれだけ失っても、また蓄積できる。でも友達は失くしたら、もう戻らない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370305
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730370305,
					"content": "アランラナはナララナを助けたい。カノジョの名前はアランラナと同じ。アランラナの友達。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370306
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730370306,
					"content": "それにアランラナが忘れても、キミは覚えてる。キミが覚えてれば、キミの記憶はいつか大きな実になる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370307
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730370307,
					"content": "…分かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730370308,
					"content": "#{M#俺}{F#私}たちはどうすれば？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370309
					]
				},
				{
					"id": 730370309,
					"content": "#アランラナが教えた「大夢のメロディー」、ナラ{NICKNAME}は覚えてるよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370310
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730370310,
					"content": "アランラナとアランマに向かって、その歌を奏でればそれでいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランラナ"
				}
			]
		},
