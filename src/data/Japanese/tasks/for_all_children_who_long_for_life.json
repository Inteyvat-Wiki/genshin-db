			"dialogs": [
				{
					"id": 730370801,
					"content": "#ナラ{NICKNAME}、急いで。アランラナがナララナのところに施したアランラカラリは、そう長くは持たない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370802
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730370802,
					"content": "準備はいい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370803
					]
				},
				{
					"id": 730370803,
					"content": "うん、心配は不要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランラナ"
				}
			]
		},
		{
			"id": 7303711,
			"completionStepIds": [
				7303703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7303703",
