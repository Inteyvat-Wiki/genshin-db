			"dialogs": [
				{
					"id": 730370401,
					"content": "「ビージャの実」を手に入れた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730370402
					]
				},
				{
					"id": 730370402,
					"content": "とうとう手に入れたぞ。貴重なビージャの実…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370403,
						730370405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730370403,
					"content": "大変だった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370404
					]
				},
				{
					"id": 730370404,
					"content": "ああ、これをラナに届ければいいんだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730370406,
					"content": "…キミたちは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730370405,
					"content": "これをラナに届ければいいんだよね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370406
					]
				}
			]
		},
		{
			"id": 7303705,
			"completionStepIds": [
				7303708
