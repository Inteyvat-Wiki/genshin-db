				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パイモン",
					"アランマ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730370101,
					"content": "これは一体…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730370102,
					"content": "あれは前の戦争が終わった場所なんだ。ボクら…いや、カレらはマラーナの化身を抑え、四重の封印を使ってここに閉じ込めた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370103
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730370103,
					"content": "こわっ…じゃあ、マラーナの化身はこの中にいるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730370104,
					"content": "マラーナは自分の上に生えていたヴァサラの樹を侵蝕し、そこから血肉を吸い肉体を得た。このまま放っておけば、それが地上の命すべてを侵蝕することになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370105
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730370105,
					"content": "アイツの力はまだ不完全だ。マラーナの化身を倒すなら、今が絶好のチャンスのはず。そしてアイツに勝てば、ビージャの実が手に入る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370106
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730370106,
					"content": "#ナラ{NICKNAME}、パイモン、行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370107
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730370107,
					"content": "アランマの話し方がまた元に戻った気がする…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7303702,
			"completionStepIds": [
				7303708
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7303708",
							"2"
						],
						"stepId": 7303708,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"302821",
							"0"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アランマ",
					"パイモン",
					"アランラナ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730370201,
					"content": "#ボクらはマラーナの化身を倒した。森もこれで少し平和になるだろう。「ボクら」と言っても、ほとんどアナタの努力や勇気のおかげだ。ありがとう、ナラ{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370202,
						730370205
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730370202,
					"content": "花冠とみんなの応援のおかげだよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370203,
						730370204
					]
				},
				{
					"id": 730370203,
					"content": "それが諦めない勇気をくれた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370207
					]
				},
				{
					"id": 730370207,
					"content": "花のひとつひとつにアランナラの小さな心がこもってるからね。全部の花を繋げた花冠は、「マハヴァナ{RUBY#[D]アランナラの宇宙}ラーナパナ」の扉と言っても過言じゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370208
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730370208,
					"content": "だからボクらはアナタと心が通じる。アナタの苦しみを感じて応援したり、力を貸したり、悪夢を防いだり、暗い日々に打ち勝つのを助けたり、心の穴を埋めたりできる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370209
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730370209,
					"content": "ボクらを夢見たり、ボクらの姿が見えない人は、運命を受け入れ、前進を諦めた人。恐れや苦しみに浸る人は、心が硬くなって花の助けを得られない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370210
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730370210,
					"content": "#ナラ{NICKNAME}が正直で善良な人だから、ナラ{NICKNAME}がナラ{NICKNAME}だから、花冠はその力を発揮できるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370211
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730370211,
					"content": "#ナラ{NICKNAME}はアランナラの友達。だからボクらはアナタ一人にマラーナや悪と戦ったり、世界を明るくてきれいなものに変えたりする責任を負わせはしない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370212
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730370212,
					"content": "#{NICKNAME}はオイラの最高の仲間だ。最高にいいヤツに決まってるだろ！これで死域の問題にケリがついたよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730370213,
					"content": "マラーナの化身を消せば、マラーナ自身も再び眠りに落ちる。でもいつかはまた目覚める。それは数十年、いや数百年後かもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370214
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730370214,
					"content": "だって、サルバの中にはもうマラーナの記憶があるから。それを完全に取り除かない限り、万物の中に残る「死」の記憶がいつかまたアイツを蘇らせる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370215
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730370215,
					"content": "#…でも、それはまだずっと先の話。将来またナラ{NICKNAME}やナラヴァルナに似た太陽のようにキラキラ輝く人が現れる。だからボクは心配してない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370216
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730370216,
					"content": "森の前途は明るい。森の子供たちは、太陽の光や雨露を思う存分浴びられる。残りのマラーナを消せば、それが叶う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370217
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730370217,
					"content": "うーん…まぁとにかくマラーナの化身は倒したんだし、次にやることはアシュヴァッタの樹とビージャの実のことだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730370218,
					"content": "うん、少し待ってて。アランラナを呼んでくる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370219
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730370219,
					"content": "アランラナ…そっか、アランラナの記憶がないと、「ビージャの実」は実らないもんな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370220
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730370220,
					"content": "でも、アランラナはヴィマラ村の近くにいるんだろ？どうやって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370221
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730370221,
					"content": "消えた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370222
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730370222,
					"content": "うわっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370223
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730370223,
					"content": "#ナラ{NICKNAME}、パイモン。アランラナは感じる。キミたちはマラーナの化身と戦った。キミたちとアランマは、勇気に溢れた者だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370224,
						730370227
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730370224,
					"content": "どうやってあんな遠い所から来たの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370225
					]
				},
				{
					"id": 730370225,
					"content": "ボクはアランムフクンダの記憶をもらった。だから、サルバを使って森を高速移動する方法を理解したんだ。そのアランラカラリを「転送」と呼ぶ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370226
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730370226,
					"content": "アランマはすごい。アランムフクンダの記憶もキミのものになれて、きっと喜んでる。アランラナはもう長い間「転送」をしたことがなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370228
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730370228,
					"content": "次は新しいアシュヴァッタの樹を植えるんだろ？確かアランマが前に「種」の話をしてたよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370229
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730370229,
					"content": "種は芽を出し、大樹になり、たわわに実をつけることを知っている…ありがとう、アランマ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370230
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730370230,
					"content": "うん。ボクは新しいアシュヴァッタの樹になって、アナタの思い出と夢をビージャの実にする。ボクの木の根を使って、マラーナに侵蝕された夢の間に新しい橋をかける。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370231
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730370231,
					"content": "なんの話をしてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370232,
						730370234
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730370232,
					"content": "アランマが種なんだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370233
					]
				},
				{
					"id": 730370233,
					"content": "ボクはヴァソマの実、アシュヴァッタの樹、アランムフクンダの記憶と力を吸収した。今この森でボクより強い「種」はいない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370236
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730370236,
					"content": "え？どういうことだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370237
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730370237,
					"content": "元々は自分の目や体を通して自分だけの記憶を蓄積して、数十年、数百年後に土地に戻り、美しいヴァサラの樹になるつもりだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370238
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730370238,
					"content": "アナタたちがいなかったら、ボクはマラーナの化身を共に倒し森を癒すという栄誉には恵まれなかった。こんなにたくさんの記憶を蓄積して、ヴァサラの樹の王者になることもなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370239
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730370239,
					"content": "え、まさか…アシュヴァッタ堂のヴァサラの樹も、元はアランナラだったの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370240
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730370240,
					"content": "カレらはアランジ、アランヤマ、アランマハ。そして、ヴァソマの実はカレらの記憶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370241
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730370241,
					"content": "アランマが木に変わったら、もう動いたり、話したり、歌ったりできなくなるのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370242
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730370242,
					"content": "種として地上で生きた時間は短かったけど、アナタたちと一緒に過ごした時間は今までの何十倍、いや何百倍も充実してた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370243
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730370243,
					"content": "なんだよそれ…オイラ、もっとアランマと遊びたかったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370244
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730370244,
					"content": "#そっか。その気持ちは分かる。パイモンとナラ{NICKNAME}はボクの友達。それは永遠に変わらない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370245
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730370245,
					"content": "記憶と力を手に入れてから、ボクはサルバの中でたくさんの景色を見たり、いろんな物語を聞いたりできるようになった。だからボクにひとつお話をさせて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370246
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730370246,
					"content": "うん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370247
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730370247,
					"content": "金色の砂嵐に覆われた永遠のオアシス、そこには生命の痕跡もなく、アランナラに出会うという幸運に恵まれることもない。草木を仕切る最古の支配者は、黄砂に埋もれたままだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370248
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730370248,
					"content": "かつてオアシスを覆っていた緑は枯れ果て、手からこぼれ落ちる砂に変わった。まるでマラーナがこうささやくように。「あらゆる幸福は、いつの日か死に絶える」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370249
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730370249,
					"content": "でも夜がどんなに暗くても、そこに星は瞬き、太陽はまた昇る。死がすべてを支配したいとどれだけ望んでも、生命が消えることはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370250
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730370250,
					"content": "大地に落ちた枯葉が萃華の木の養分になり、その実が駄獣やキツネ、イノシシの餌になり、その動物たちがまたリシュボラン虎の餌になり、森に命が満ちるように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370251
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730370251,
					"content": "かつて毒血が大地を黒く染めた。アランナラはナラと同じように、終わりの日は近いと思った。でも今その記憶はすべて消え失せ、森はマハールッカデヴァータの時代よりさらに生い茂ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370252
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730370252,
					"content": "最後に残ったのは幸福だった。たとえ別れの日が来ても、またサルバで会える。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370253
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730370253,
					"content": "いつかボクの夢とアナタの夢、ボクの記憶とアナタの記憶、ボクらはまた交錯し、サルバの無数の小枝で花を咲かせる。それは素敵なことだと思わないかい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370254
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730370254,
					"content": "うん…でも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370255
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730370255,
					"content": "パイモン。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370256
					]
				},
				{
					"id": 730370256,
					"content": "う、うん…分かってるってば！アランマ、おまえは最高の「種」だ。だからきっと大きくてきれいな木になれる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370257
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730370257,
					"content": "#だから、だからさ、たとえ木になってもオイラや{NICKNAME}のこと、一緒に冒険したこと忘れるなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370258,
						730370259,
						730370260
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730370258,
					"content": "ありがとう、アランマ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370261
					]
				},
				{
					"id": 730370261,
					"content": "#うん。ありがとう、パイモン、ナラ{NICKNAME}。知り合えて嬉しかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370262
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730370262,
					"content": "アランラナ、アナタの記憶を一番きれいで大きなビージャの実にするから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370263
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730370263,
					"content": "うん、アランマ、キミを信じてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730370259,
					"content": "さようなら、アランマ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370261
					]
				},
				{
					"id": 730370260,
					"content": "これでおしまいだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370261
					]
				},
				{
					"id": 730370234,
					"content": "いったい、何の話をしてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370235
					]
				},
				{
					"id": 730370235,
					"content": "ボクがアシュヴァッタの樹の種だ。ボクはヴァソマの実、アシュヴァッタの樹、アランムフクンダの記憶と力を吸収した。今この森でボクより強い「種」はいない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370236
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730370227,
					"content": "この次は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370228
					]
				},
				{
					"id": 730370204,
					"content": "それが立ち上がる力をくれた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370207
					]
				},
				{
					"id": 730370205,
					"content": "どういたしまして。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370206
					]
				},
				{
					"id": 730370206,
					"content": "#さっきはまさに危機一髪だったな…{NICKNAME}の花冠があってほんとによかった！けどそれ、ホントにすごい花冠だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370207
					],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7303703,
