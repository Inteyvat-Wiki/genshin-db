			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"イアーラ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740290301,
					"content": "イアーラは弱ったマンマルタコをバケツに入れた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740290302
					]
				},
				{
					"id": 740290302,
					"content": "華麗な魚釣り術…でも「アレ」はきれいじゃなくなった。どうして？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290303
					],
					"speakerTitle": "イアーラ"
				},
				{
					"id": 740290303,
					"content": "ごめん…イアーラの言う「アレ」がマンマルタコとは思わなくて、ついうっかり…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290304,
						740290306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740290304,
					"content": "責任はこっちにある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740290305
					]
				},
				{
					"id": 740290305,
					"content": "#{NICKNAME}がせっかちなのがいけないんだ！止めなかったオイラも悪いけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740290308,
					"content": "#{NICKNAME}先生とパイモン先生、謝らないで。「アレ」がバケツの中にいる。それだけでもう十分だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290309
					],
					"speakerTitle": "イアーラ"
				},
				{
					"id": 740290309,
					"content": "そっか…でもなんでここにマンマルタコが？水に押し流されて来ちゃったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740290310,
					"content": "外から捕まえてきたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290311
					],
					"speakerTitle": "イアーラ"
				},
				{
					"id": 740290311,
					"content": "え？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740290312,
					"content": "釣り竿で魚の釣り方を確かめたくて…それで「アレ」、つまりマンマルタコを捕まえに行ったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290313
					],
					"speakerTitle": "イアーラ"
				},
				{
					"id": 740290313,
					"content": "「アレ」をこの中に入れておけば、いつでも釣りができるでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290314
					],
					"speakerTitle": "イアーラ"
				},
				{
					"id": 740290314,
					"content": "中々の妙案だと思ったのに、いくら待っても「アレ」が針に食いつかなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290315
					],
					"speakerTitle": "イアーラ"
				},
				{
					"id": 740290315,
					"content": "わざわざマンマルタコを捕まえて水に放し、釣り竿で釣る練習をするってのがそもそも気になるけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290316
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740290316,
					"content": "でもさっきオイラたちが撒いたエサに反応して、「アレ」が水面に浮かんできただろ？今までエサをいっぱい撒いてみようとは思わなかったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290317
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740290317,
					"content": "ひき肉、パンくず、ワーム、ミント、パーツ…色んなエサを試してみた…でも「アレ」は食べたらすぐに沈んでいった。だからエサは役に立たないと思ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290318
					],
					"speakerTitle": "イアーラ"
				},
				{
					"id": 740290318,
					"content": "えっ？パーツ！？それはどう考えてもエサじゃないだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290319,
						740290321
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740290319,
					"content": "変なものを水産品に食べさせないで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740290320
					]
				},
				{
					"id": 740290320,
					"content": "そうだそうだ！でもその水産品って言い方は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290323
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740290323,
					"content": "うーん。パーツは貴重品だし、マンマルタコが食べないなら、なんとかして取り出さないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290324
					],
					"speakerTitle": "イアーラ"
				},
				{
					"id": 740290324,
					"content": "#そうだ、{NICKNAME}先生とパイモン先生の協力に感謝して、パーツをあげるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290325
					],
					"speakerTitle": "イアーラ"
				},
				{
					"id": 740290325,
					"content": "…いや、いいよ。別にたいした協力もしてないし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290326
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740290326,
					"content": "え？お世話になる人のことは、「先生」と呼べってデラロッシュが言ってた。「有料で相談」したら、相手は喜ぶよって。そうじゃないの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290327
					],
					"speakerTitle": "イアーラ"
				},
				{
					"id": 740290327,
					"content": "この乾燥したパーツをあげる。メリュシー村では役に立つよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290328
					],
					"speakerTitle": "イアーラ"
				},
				{
					"id": 740290328,
					"content": "イアーラがそう言うなら…ありがたく受け取るぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290329
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740290329,
					"content": "#うん。また{NICKNAME}先生とパイモン先生に華麗な釣り技を教えてもらいたいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イアーラ"
				},
