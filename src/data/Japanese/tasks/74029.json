			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"イアーラ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740290101,
					"content": "なんでこんなところに釣り竿が？まさか釣りか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740290102,
					"content": "水辺と釣り竿があれば、釣りに決まってるでしょ。外の世界から来たのにそんなことも知らないとは、「世も末」だね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290103,
						740290105
					],
					"speakerTitle": "イアーラ"
				},
				{
					"id": 740290103,
					"content": "世も末とか、言い過ぎでしょ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740290104
					]
				},
				{
					"id": 740290104,
					"content": "そうだぞ！それにオイラたち、釣りに関してはずぶの素人じゃないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740290107,
					"content": "いや、そうじゃなくて…メリュジーヌは釣り竿で釣りなんかしないと思ってたからさ。それに…えっと、なんか違和感があるな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740290108,
					"content": "違和感って？外の人から教わった通りにやってるよ？デラロッシュはいい人だ。魚釣りを教えてくれて、釣り竿までくれたし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290109
					],
					"speakerTitle": "イアーラ"
				},
				{
					"id": 740290109,
					"content": "彼女の釣り竿は結構凄いやつみたいだけど、彼女は「プロ」で、わたしはただの「アマチュア」だから、これで十分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290110
					],
					"speakerTitle": "イアーラ"
				},
				{
					"id": 740290110,
					"content": "うーん…でも、ずっと待ってるのに、どうして釣れないんだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290111
					],
					"speakerTitle": "イアーラ"
				},
				{
					"id": 740290111,
					"content": "#へへっ、それなら{NICKNAME}先生とパイモン先生が原因を分析してやるぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740290112,
					"content": "#{NICKNAME}先生とパイモン先生って、デラロッシュよりすごいの？彼女はきれいな釣り竿を持ってるプロなのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290113
					],
					"speakerTitle": "イアーラ"
				},
				{
					"id": 740290113,
					"content": "へへっ、じゃあいっちょ、オイラたちの実力を見せつけてやるぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740290114,
					"content": "でも、ここに魚なんている？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740290115
					]
				},
				{
					"id": 740290115,
					"content": "あっ！言われてみれば確かに…違和感の正体はそれだ！魚なんてどこにもいないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740290116,
					"content": "魚…水中にいるのは水産品だけじゃないってデラロッシュが言ってた。えっと、「アレ」は魚の仲間なのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290117
					],
					"speakerTitle": "イアーラ"
				},
				{
					"id": 740290117,
					"content": "…「アレ」が魚じゃないから、わたしのやり方では釣れないのかも？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290118
					],
					"speakerTitle": "イアーラ"
				},
				{
					"id": 740290118,
					"content": "#{NICKNAME}先生…それにパイモン先生！教えて。どうすれば「アレ」を釣れるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290119
					],
					"speakerTitle": "イアーラ"
				},
				{
					"id": 740290119,
					"content": "お、おう！イアーラってすごく礼儀正しいんだな…もちろんいいぜ！でもその「アレ」って一体…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740290120,
					"content": "「アレ」は水中をすいすい泳ぐんだ。つるつるしてて、とても捕まえづらい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290121,
						740290123
					],
					"speakerTitle": "イアーラ"
				},
				{
					"id": 740290121,
					"content": "そう聞くと魚っぽいね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740290122
					]
				},
				{
					"id": 740290122,
					"content": "他の水生生物の可能性もあるよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740290125,
					"content": "うーん…とにかく、水中に棲む生き物だってことは確かだろ。水面からは姿が見えないから、深くに隠れてるのかもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740290126,
					"content": "こういうときは、やっぱり「撒き餌」だ！食べ物で水の底にいる「アレ」をおびき寄せようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740290127,
					"content": "でも「アレ」は、もうお腹いっぱいのはず…他のエサに替えたら食いつくかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290128
					],
					"speakerTitle": "イアーラ"
				},
				{
					"id": 740290128,
					"content": "そうだ！水にエサを撒いて釣り竿を立てれば、あとは釣れるのを待つだけだ。「アレ」がなにかはまだわかんないけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290129
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740290129,
					"content": "#華麗な竿さばき…わたしももう一回やってみよう。エサは{NICKNAME}先生とパイモン先生に任せる。わたしは釣り竿を見張りつつ準備するね。プロみたいなきれいな釣り竿じゃないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290130
					],
					"speakerTitle": "イアーラ"
				},
				{
					"id": 740290130,
					"content": "おう。エサ撒きなんて簡単なことはオイラたちに任せろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740290123,
					"content": "そう聞くとメリュジーヌっぽいね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740290124
					]
				},
				{
					"id": 740290124,
					"content": "イアーラが他のメリュジーヌと魚釣りごっこをしてる…それは変だろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740290105,
					"content": "パイモンは釣りが何か、当然知ってるよね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740290106
					]
				},
				{
					"id": 740290106,
					"content": "#おう！だってオイラ、{NICKNAME}に釣り竿で釣りあげられたんだぞ…って、ちっがーう！問題はそこじゃない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290107
					],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
