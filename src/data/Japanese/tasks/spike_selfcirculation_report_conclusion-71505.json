			"trigger": {
				"objectNames": [
					"ホッセイニ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715050101,
					"content": "#{NICKNAME}、やっと来てくれた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050102
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715050102,
					"content": "調整はうまくいったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715050103
					]
				},
				{
					"id": 715050103,
					"content": "調整は終わった。少しばかり不安もあるが、ここまで来たらもうスパイクを坑道の奥に置くしかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050104
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715050104,
					"content": "へディーヴに薬を作ってもらった。図と昊にも渡すつもりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050105
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715050105,
					"content": "#{NICKNAME}、スパイクを起動して、地脈にある黒泥が湧き出る部分を封鎖するんだ…必ずやり遂げてくれよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050106
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715050106,
					"content": "元々はヘディーヴからの頼みで助けに来ただけだった。あの時、私はこう思ったんだ——もし、この問題を解決できなかったら、スパイクを持ってスメールに帰ればいいだけだって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050107
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715050107,
					"content": "何しろ、「プルシナスパイク」に関する実験は数多く行ってきた。詳細なデータを記載したレポートを書き上げるのも簡単な話だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050108
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715050108,
					"content": "けど図と昊、それにここで生活している人たちは…一生、この危険な黒泥と共に生きていくことになるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050109
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715050109,
					"content": "もし、私の研究が彼らの役に立たないのなら…ただレポートを一枚書き上げるだけだとしたら、これはあまりに無意味だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050110
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715050110,
					"content": "だから、私は何としても地脈から湧き出る黒泥を解決すると決めた。それに、この黒泥に触れたことで…スメール学者の私にとってある意味、警醒となった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050111
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715050111,
					"content": "#君の実力は信じているが、黒泥が湧き出てくるところはとても危険だ。くれぐれも気を付けてほしい、{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050112,
						715050113
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715050112,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715050114
					]
				},
				{
					"id": 715050114,
					"content": "ハハハ…ゴホッ、ゴホッ…ゴホッ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050115
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715050115,
					"content": "#君のことを言っているんだ、{NICKNAME}。噴出口で「プルシナスパイク」を起動すれば、黒泥による魔物への影響を小さくすることができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050116
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715050116,
					"content": "でも、あの黒泥に引き寄せられた魔物はあまりに多い…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050117
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715050117,
					"content": "だから、身の安全を最優先に。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715050113,
					"content": "スパイクが壊れないよう気を付けるよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715050114
					]
				}
			]
		}
	]
}