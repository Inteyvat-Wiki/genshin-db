			"dialogs": [
				{
					"id": 30011101,
					"content": "あ、旅人さん。君たちも戻って来たんですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011102
					],
					"speakerTitle": "ナスリン"
				},
				{
					"id": 30011102,
					"content": "こんばんは、コレイを見かけなかったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30011103,
					"content": "コレイなら、さっき部屋に戻るのを見ましたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011104
					],
					"speakerTitle": "ナスリン"
				},
				{
					"id": 30011104,
					"content": "そっか…どうやら今日は無理みたいだな、また明日にしようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
