				},
				{
					"id": 30011005,
					"content": "わっ…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011006
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30011006,
					"content": "やばい、落ちちゃったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011007
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30011007,
					"content": "平気平気、油紙で何重にも包んであるから、中のピタは汚れたりしてないはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011008
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30011008,
					"content": "ふっ…焦ったぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011009
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30011009,
					"content": "コレイと一緒に食事を楽しんだ…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						30011010
					]
				},
				{
					"id": 30011010,
					"content": "これ、うまいぞ！コレイって料理の腕がいいんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011011
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30011011,
					"content": "油紙で包んであってよかったぜ。じゃないと、オイラは心が痛むあまり、眠れなくなるところだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011012
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30011012,
					"content": "ははっ、それは大げさだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011013
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30011013,
					"content": "でも、そんなに気に入ってくれたんなら、今度レシピを書き写してやるよ。コツも書いておくから、安心してくれ。すぐ覚えるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011014
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30011014,
					"content": "ありがとな、コレイ！へへっ、おまえみたいに真面目なやつでも、うっかりしちゃうことがあるんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011015
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30011015,
					"content": "ははっ、まあ、ちょっとな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011016
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30011016,
					"content": "でも、ティナリは厳しすぎるんじゃないのか？ものにも触れさせてくれないなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011017
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30011017,
					"content": "#オイラだって飛んでる時、たまに机の上にあるものを倒しちゃうけど、{NICKNAME}はぜったいにオイラを責めたりしないぞ。要するに、誰にだってうっかりすることくらいあるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011018
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30011018,
					"content": "いや、そうじゃないんだ！お前たちも師匠と長く付き合えば、本当はいい人だって分かるはずだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011019
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30011019,
					"content": "師匠は、ある古くて神秘的な一族の出だって、先輩に聞いた。一族の人たちはみんな頭が切れて、ほとんどが人嫌いらしいけど、師匠はとても温かくて親切な人だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011020
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30011020,
					"content": "そうだ、「教令院」って聞いたことないか？せ…生何とか派ってやつ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011021
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30011021,
					"content": "とにかく、師匠は植物に詳しいだろう。それで学院の賢者は何度も手紙を送ってきて、教令院で働かないかって師匠を誘ってた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011022
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30011022,
					"content": "でも、師匠は「スメールシティは騒がしくて耳に悪い」って理由で断ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011023,
						30011026
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30011023,
					"content": "確かにティナリが言いそう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30011024
					]
				},
				{
					"id": 30011024,
					"content": "ははっ、だろう。でも、その手紙を読んだ賢者様は、きっと怒ったと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011025
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30011025,
					"content": "教令院にだって行けたはずなのに、師匠はレンジャー長を選んだ。毎日、森の住民を助けたり、部下たちに色んな知識を授けたりしてきたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011029
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30011029,
					"content": "ピタの作り方だって、師匠に教えてもらったんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011030
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30011030,
					"content": "本当か？それは予想外だったぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011031
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30011031,
					"content": "うぅ…そういえば昨日、気を失ったおまえを見つけた後、あいつはなんにも疑わずに治療してくれて…ガンダルヴァー村まで運んでくれたのもティナリだったんだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011032
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30011032,
					"content": "けど、やっぱりあいつのことはちょっと気に入らないぜ。だってあいつは道中、オイラをずっと非難するような目で見てたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011033
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30011033,
					"content": "パイモン、いったい何したの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30011034
					]
				},
				{
					"id": 30011034,
					"content": "あっ、ごめん。それは師匠が悪かったかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011035
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30011035,
					"content": "あの時パイモンが「どうしよう、こいつ、死ぬのか！？」って喚き続けてたから。どんなになだめても無駄で、師匠…怒っちゃって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011036
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30011036,
					"content": "おい、おまえ、笑うな！おまえのことを心配してたんじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011037
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30011037,
					"content": "ぷっ…ははははっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011038
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30011038,
					"content": "えっ、なんでコレイまで——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011039
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30011039,
					"content": "あああ、ムカつく！ふん、おまえたちの頭を鳥の巣にしてやるぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011040
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30011040,
					"content": "あたしに触んな！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011041,
						30011042
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30011041,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30011043
					]
				},
				{
					"id": 30011043,
					"content": "コレイ、その…ごめん、オイラそんなつもりじゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011044
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30011044,
					"content": "あっ、あたしは…今…いや、そうじゃない、そうじゃないんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011045
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30011045,
					"content": "コレイ、どうしたんだ？大丈夫？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011046
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30011046,
					"content": "あっ…うん、平気だ。もう大丈夫…本当にごめんなさい、びっくりしたよな、ははっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011047
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30011047,
					"content": "そうだ、そろそろいい時間だし、早くガンダルヴァー村に戻ろう。師匠たちも、もう帰って来てるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011048
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30011048,
					"content": "今のはなんだったんだ…？コレイ、大丈夫かな？あっ、足が速すぎて、もう見えなくなっちゃったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30011042,
					"content": "コレイ、どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30011043
					]
				},
				{
					"id": 30011026,
					"content": "耳…！あの耳の触り心地、とても良さそう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30011027
					]
				},
				{
					"id": 30011027,
					"content": "だよな！あたしもそう思う…コホンッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011028
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30011028,
					"content": "と、とにかく、教令院にだって行けたはずなのに、師匠はレンジャー長になることを選んだ。毎日、森の住民を助けたり、部下たちに様々な知識を授けたりしてきたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011029
					],
					"speakerTitle": "コレイ"
				}
			]
		},
