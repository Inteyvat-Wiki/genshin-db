			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"コレイ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30010101,
					"content": "よし、次は右…うん、問題なさそうだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010102
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30010102,
					"content": "でも、気を付けたほうがいい。分かった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010103
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30010103,
					"content": "うん、分かった。ところで師匠、まだ今日の巡回ルート図をもらってないけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010104
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30010104,
					"content": "今日は遠いから付いて来なくてもいいよ。それに、あいつらがまたルート上に現れるかもしれないしね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010105
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30010105,
					"content": "うぅ、あたしも神の目を持ってるのに、全然役に立ててない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010106
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30010106,
					"content": "そんなこと言うなよ。それは君が今考えるべきことじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010107
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30010107,
					"content": "君たち、来たの。体の調子はどう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010108
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30010108,
					"content": "何か手伝うことはある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010109
					]
				},
				{
					"id": 30010109,
					"content": "そうそう、ここに残るって決めたからには、オイラたちも役に立ちたいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30010110,
					"content": "君たちって暇に耐えられないタイプなの？まあ、じゃあ今日はコレイと、ガンダルヴァー村の南側を見回りして来てもらおうかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010111
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30010111,
					"content": "もし体力に自信があるなら、七天神像の掃除も任せていい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010112
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30010112,
					"content": "ティナリさん、俺たちは準備できたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010113
					],
					"speakerTitle": "アミル"
				},
				{
					"id": 30010113,
					"content": "すぐ行く——僕たちは先に森に入るから、後はコレイから聞いて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010114
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30010114,
					"content": "うん、あたしに任せて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010115
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30010115,
					"content": "コレイ、今日はなにをするんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30010116,
					"content": "さっき、ティナリは七天神像の掃除って言ってたよな。レンジャーがそんなことまでするとは思ってなかったぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30010117,
					"content": "うん。実は、レンジャーがやることの範囲って結構広いんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010118
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30010118,
					"content": "道路状況の確認や森林施設の整備、火災予防に、旅の人や住民たちの手助けとか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010119
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30010119,
					"content": "師匠は、雨林にある危険なエリアの処理もしてるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010120
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30010120,
					"content": "とりあえず、道の街灯を確認しながら七天神像まで行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "コレイ"
				}
			]
		},
		{
			"id": 300105,
			"completionStepIds": [
				300103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"300103",
							"2"
						],
						"stepId": 300103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"コレイ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30010501,
					"content": "七天神像はあの巨大な岩の上だ。お前たちもこの道を通ったなら、気付いたんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010502
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30010502,
					"content": "ちょっと高いよな。登るのがきつかったら、無理しなくていいよ。師匠は気にしないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010503,
						30010504
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30010503,
					"content": "大丈夫、登るのは得意だから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010505
					]
				},
				{
					"id": 30010505,
					"content": "そうか？じゃあ任せる。神像の周りのスペースは少ないから、気を付けて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010506
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30010506,
					"content": "#{NICKNAME}、オイラも一緒に行くぜ。高い場所を掃除してやれるしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010507
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30010507,
					"content": "ところでコレイ、草神ってどんな神なのか知らないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010508
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30010508,
					"content": "それって「マハールッカデヴァータ」のこと？それとも「クラクサナリデビ」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010509
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30010509,
					"content": "え？「マハールッカデヴァータ」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010510
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30010510,
					"content": "あっ、もしかして、前の草神の名前なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010511
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30010511,
					"content": "そうだよ。「マハールッカデヴァータ」はスメールの初代草神様だ。彼女が雨林を創り、砂漠の防砂壁を置いてくれたおかげで、みんな平和に暮らせるようになった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010512
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30010512,
					"content": "スメール人にとって、彼女は知恵と博愛、全能の象徴だよ。でも、彼女は何百年か前の災いで姿を消しちゃったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010513,
						30010514
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30010513,
					"content": "（雷電眞みたいにかな…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010515
					]
				},
				{
					"id": 30010515,
					"content": "その後、賢者たちが新しい草神様を見つけて、彼女をスメールに迎え入れたんだって師匠からは聞いた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010516
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30010516,
					"content": "神が再び降臨したことを祝って、賢者たちは彼女を「クラクサナリデビ」と呼んで、スラサタンナ聖処に住まわせたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010517
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30010517,
					"content": "うんうん、それで？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010518
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30010518,
					"content": "それから、うーん…あとはよく知らない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010519
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30010519,
					"content": "えっ、おまえも知らないのか？もしかして、コレイはスメール人じゃなかったり？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010520
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30010520,
					"content": "いや、あたしはスメール人なんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010521
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30010521,
					"content": "オイラたちは赤の他人だし、話しにくいのか？もしそうだったら、気にしなくていいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010522
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30010522,
					"content": "いやいや、違うんだ。隠すつもりはないよ。それにお前たちはあたしにとって、赤の他人なんかじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010523
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30010523,
					"content": "その…お、お前たちも、アンバーのことは知ってるだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010524
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30010524,
					"content": "ええっ、それってまさか——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010525,
						30010526
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30010525,
					"content": "西風騎士団の偵察騎士？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010527
					]
				},
				{
					"id": 30010527,
					"content": "そう、そのアンバーだ！以前、モンドにしばらく留まってたことがあるんだ。その頃、あたしはアンバーに色々助けられて…彼女があたしを変えたと言っても過言じゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010528
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30010528,
					"content": "アンバーは本当にすごいよ！日々の暮らしへの愛に満ちていて、正義感が強いんだ。行動力はもちろん思いやりにも溢れていて、いつも人のため、炎みたいに輝いてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010529
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30010529,
					"content": "あたしから言わせれば、彼女ほど偵察騎士に適任な人はいないよ。だってモンドに足を踏み入れるほとんどの人は、最初にアンバーに出会う。彼女の熱意に触れて、あの土地を好きになるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010530
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30010530,
					"content": "あっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010531,
						30010532
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30010531,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010533
					]
				},
				{
					"id": 30010533,
					"content": "うーん、偵察騎士の仕事はそれじゃないだろっていつも思ってたけど、おまえが本当にアンバーを好きなことは十分感じ取れたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010534
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30010534,
					"content": "コホン…ご、ごめん。変なこと言っちゃって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010535
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30010535,
					"content": "へへっ、気にするなよ。おまえがアンバーの友達だって分かって、なんだか親近感がわいたぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010536
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30010536,
					"content": "でも、なんでオイラたちがアンバーと知り合いだってことを知ってるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010537
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30010537,
					"content": "ああ、実はスメールに帰った後も、アンバーとは手紙でやり取りしてきたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010538
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30010538,
					"content": "手紙には、モンド城が飛龍に襲われた時、金髪の旅人と空飛ぶ仲間がその危機からモンドを救ってくれたこととかも書かれてた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010539
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30010539,
					"content": "だから、昨日はお前たちを見た瞬間、すぐに分かったんだ。でも、あの時は旅人が昏睡状態から目覚めたばかりだったから、言わないことにした…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010540
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30010540,
					"content": "そうだったのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010541
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30010541,
					"content": "ああ！だから安心してくれよ、お前たちのことは絶対信じる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010542
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30010542,
					"content": "草神様のことももっと教えてあげたいところなんだけど、長い間スメールにいなかった上、本とかもあまり読めてなくて…ごめん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010543
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30010543,
					"content": "大丈夫だ。さっき教えてくれた情報はすごく価値のあったものだったぞ。なにしろオイラたちは、「マハールッカデヴァータ」や「スラサタンナ聖処」すら知らなかったからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010544
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30010544,
					"content": "少しでも役に立ててよかった。でも、どうして草神様の情報を知りたいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010545
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30010545,
					"content": "旅の目的をざっとコレイに話した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						30010546
					]
				},
				{
					"id": 30010546,
					"content": "そうだったのか。教えてくれてありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010547
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30010547,
					"content": "そうかしこまるなよ。オイラたち、友達だろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010548
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30010548,
					"content": "パイモンの言う通り。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010549
					]
				},
				{
					"id": 30010549,
					"content": "よし！それじゃ、上で神像をきれいにしようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010550
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30010550,
					"content": "うん、よろしくな。あたしはそこの雨除けテントを確認しに行くから、終わったらここら辺で落ち合おう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30010532,
					"content": "コレイってそんなだっけ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010533
					]
				},
				{
					"id": 30010526,
					"content": "モンド城の熱心な飛行愛好者？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010527
					]
				},
				{
					"id": 30010514,
					"content": "（カーンルイアの時かな…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010515
					]
				},
				{
					"id": 30010504,
					"content": "これくらい、ちょちょいのちょい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010505
					]
				}
			]
		},
