			},
			"dialogs": [
				{
					"id": 766530401,
					"content": "やっと来たか。こんな滅多にない依頼だってのに、忘れてたわけじゃねぇよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530402
					],
					"speakerTitle": "ゴウデンティ"
				},
				{
					"id": 766530402,
					"content": "ちょっと待ってね。依頼の内容を確認させてくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530403
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 766530403,
					"content": "…俺はゴウデンティ、クーヴァキ実験設計局から派遣された代表だ。これで思い出したか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530404
					],
					"speakerTitle": "ゴウデンティ"
				},
				{
					"id": 766530404,
					"content": "か、肩書きが長い…依頼内容を言ってよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530405
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 766530405,
					"content": "おま…ちっ、もう一度言ってやる。最近、クーヴァキ実験設計局から暴走した偵察ユニットが飛び出して、あちこちふらついてる。俺の任務はそれらを回収することだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530406
					],
					"speakerTitle": "ゴウデンティ"
				},
				{
					"id": 766530406,
					"content": "だが、偵察ユニットは高いところを飛び回ってるせいで、俺一人じゃ手が回らない。だから依頼したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530407
					],
					"speakerTitle": "ゴウデンティ"
				},
				{
					"id": 766530407,
					"content": "回収とは言っても、その場で破壊してもいい。俺たちの目標は、偵察ユニットをよそ者の手に渡らないようにすることだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530408
					],
					"speakerTitle": "ゴウデンティ"
				},
				{
					"id": 766530408,
					"content": "あっ、思い出した。その偵察ユニットって高く飛ぶから、普通の人間じゃ届かないんだよね。でも、アイノは月霊の道を人工的に作る方法を知ってるから大丈夫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530409
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 766530409,
					"content": "#{NICKNAME}は月霊の力を借りられるんだよね？なら、月霊の道を使って空に飛び上がってもらって、偵察ユニットを全部倒せばオッケーだよね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530410
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 766530410,
					"content": "#おう！{NICKNAME}に任せれば大丈夫だぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530411,
						766530412
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766530411,
					"content": "楽勝だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766530413
					]
				},
				{
					"id": 766530413,
					"content": "ああそれと、依頼料はモラじゃなくて、偵察ユニットの部品だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530414
					],
					"speakerTitle": "ゴウデンティ"
				},
				{
					"id": 766530414,
					"content": "この点は依頼の時にもはっきり伝えたはずだ。今さら変更しろと言っても無理だからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530415
					],
					"speakerTitle": "ゴウデンティ"
				},
				{
					"id": 766530415,
					"content": "部品で払うのか？さっき、偵察ユニットをよそ者の手に渡したくないって言ってたのに？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530416
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766530416,
					"content": "だから、これは滅多にない依頼なのさ。何事も臨機応変が肝心だ。大変な仕事をしてもらうわけだし、部外者どうこうってのには目をつぶらねぇとな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530417
					],
					"speakerTitle": "ゴウデンティ"
				},
				{
					"id": 766530417,
					"content": "なんだかモヤモヤするな。モラを払いたくないだけじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530418
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766530418,
					"content": "モラよりも断然いいよ！あの偵察ユニットの部品は貴重だからね。アイノの今後の研究にも必要なんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530419
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 766530419,
					"content": "アイノがそう言うなら…わかったぞ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766530412,
					"content": "ちょっとむずかしいかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766530413
					]
				}
			]
		}
	]
}