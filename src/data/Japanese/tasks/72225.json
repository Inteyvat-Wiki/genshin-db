					"ク"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722250301,
					"content": "止まり木が元気になった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250302
					],
					"speakerTitle": "ルー"
				},
				{
					"id": 722250302,
					"content": "なんとか止まり木の奉納が完了したか、大変だったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250303
					],
					"speakerTitle": "ク"
				},
				{
					"id": 722250303,
					"content": "ふふん、オイラたちはこういうことの専門家だからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722250304,
					"content": "「導光の儀式」と似たようなもの。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250305
					]
				},
				{
					"id": 722250305,
					"content": "問題を一つ解決するために、まずは三つの場所にある問題を解く…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722250306,
					"content": "なんか、おまえと一緒にいると、いつもこういうのに遭遇するよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722250307,
					"content": "他のことはよく分からないけど、大人たちはいつもこう言ってるよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250308
					],
					"speakerTitle": "ルー"
				},
				{
					"id": 722250308,
					"content": "「三の法則」って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250309
					],
					"speakerTitle": "ルー"
				},
				{
					"id": 722250309,
					"content": "三の法則…どういう意味だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722250310,
					"content": "えっと…どんなことでも、同じことを三回やらないと結果が分からないって意味だったかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250311
					],
					"speakerTitle": "ルー"
				},
				{
					"id": 722250311,
					"content": "例えば、吉兆が三回現れれば幸運が訪れる。その反対に、凶兆が三回現れると必ず悪いことが起こるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250312
					],
					"speakerTitle": "ルー"
				},
				{
					"id": 722250312,
					"content": "何かをやる時も、三回困難に遭遇したら四回目は成功できるってことだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250313
					],
					"speakerTitle": "ルー"
				},
				{
					"id": 722250313,
					"content": "でも、それなら「四の法則」じゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250314
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722250314,
					"content": "あ、そっか！パイモンは算数が得意だね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250315
					],
					"speakerTitle": "ルー"
				},
				{
					"id": 722250315,
					"content": "ふふん、当然だろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250316,
						722250318
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722250316,
					"content": "重要なところはそこじゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250317
					]
				},
				{
					"id": 722250317,
					"content": "ところで、クのケガは大丈夫なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250319
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722250319,
					"content": "心配いらないよ。クお兄ちゃんはいつもこうなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250320
					],
					"speakerTitle": "ルー"
				},
				{
					"id": 722250320,
					"content": "恥ずかしい限りだが…祭典に影響がないことを祈ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250321
					],
					"speakerTitle": "ク"
				},
				{
					"id": 722250321,
					"content": "じゃないと、ルーに申し訳が立たない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250322
					],
					"speakerTitle": "ク"
				},
				{
					"id": 722250322,
					"content": "そんなことないよ。クお兄ちゃんはいつも僕に良くしてくれてるでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250323
					],
					"speakerTitle": "ルー"
				},
				{
					"id": 722250323,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250324
					],
					"speakerTitle": "ク"
				},
				{
					"id": 722250324,
					"content": "#{NICKNAME}{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYE|INFO_FEMALE_PRONOUN_SISTERA]}、パイモン、先に行ってて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250325
					],
					"speakerTitle": "ルー"
				},
				{
					"id": 722250325,
					"content": "僕はもう少しクお兄ちゃんのそばにいるよ。それから、奉納の後処理もしないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ルー"
				},
				{
					"id": 722250318,
					"content": "クのケガについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250319
					]
				}
			]
		},
