			"dialogs": [
				{
					"id": 722250201,
					"content": "止まり木の奉納をお願い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250202
					],
					"speakerTitle": "ルー"
				},
				{
					"id": 722250202,
					"content": "僕はここでクお兄ちゃんと一緒にいるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ルー"
				}
			]
		},
		{
