			"dialogs": [
				{
					"id": 722250101,
					"content": "くっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250102
					],
					"speakerTitle": "ク"
				},
				{
					"id": 722250102,
					"content": "#{NICKNAME}{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYE|INFO_FEMALE_PRONOUN_SISTERA]}、パイモン！よかった、ちょうどいいところに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250103
					],
					"speakerTitle": "ルー"
				},
				{
					"id": 722250103,
					"content": "何かあったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250104
					]
				},
				{
					"id": 722250104,
					"content": "足を捻挫してしまったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250105
					],
					"speakerTitle": "ク"
				},
				{
					"id": 722250105,
					"content": "クお兄ちゃんがまたケガをしちゃったんだ。代わりに、止まり木の奉納をしてくれないかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250106,
						722250108
					],
					"speakerTitle": "ルー"
				},
				{
					"id": 722250106,
					"content": "その展開は予想してなかった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250107
					]
				},
				{
					"id": 722250107,
					"content": "いいぞ、オイラたちに任せろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722250109,
					"content": "ありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250110
					],
					"speakerTitle": "ルー"
				},
				{
					"id": 722250110,
					"content": "そうだ、ルーも「元素」の感知が得意なんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722250111,
					"content": "なんで自分で止まり木の奉納をしないんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722250112,
					"content": "えっと…前に僕も祭典でいろいろ試したんだけど、最終的にはどれもうまくいかなくって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250113,
						722250115,
						722250116
					],
					"speakerTitle": "ルー"
				},
				{
					"id": 722250113,
					"content": "どうして？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250114
					]
				},
				{
					"id": 722250114,
					"content": "僕にもわからない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250117
					],
					"speakerTitle": "ルー"
				},
				{
					"id": 722250117,
					"content": "しょうがないな、止まり木はオイラたちに任せろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722250115,
					"content": "じゃあ、任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250117
					]
				},
				{
					"id": 722250116,
					"content": "ルーはケガ人を看ててあげて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250117
					]
				},
				{
					"id": 722250108,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250109
					]
				}
			]
		},
		{
