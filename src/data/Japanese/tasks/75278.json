			},
			"dialogs": [
				{
					"id": 752780101,
					"content": "あの、二人とも！ちょっと待って…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780102
					],
					"speakerTitle": "「シトン」"
				},
				{
					"id": 752780102,
					"content": "どうしたんだ、なにか用か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752780103,
					"content": "「パインの花の咲き誇る奇跡の瞬間、その笑顔に聖なる火を灯す！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780104
					],
					"speakerTitle": "「シトン」"
				},
				{
					"id": 752780104,
					"content": "えっ、ええー？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752780105,
					"content": "「のびのびリゾートの名のもとに、歓迎のダンスを——輝け！アイドルピピルパン！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780106
					],
					"speakerTitle": "「シトン」"
				},
				{
					"id": 752780106,
					"content": "あっ！そのセリフ、また来たな！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752780107,
					"content": "#えへへ、シトンだよ。覚えてる？久しぶりだね、{NICKNAME}{M#お兄}{F#お姉}ちゃん、パイモンお姉ちゃん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780108
					],
					"speakerTitle": "「シトン」"
				},
				{
					"id": 752780108,
					"content": "な、なあんだ、シトンだったのか。また怖いやつかと思ったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780109,
						752780110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752780109,
					"content": "何か嬉しいことでもあった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752780111
					]
				},
				{
					"id": 752780111,
					"content": "エへへ、あのね、今はパパ自ら指導してくれてるの。あたしを一人前の役者に鍛え上げてくれるって…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780112
					],
					"speakerTitle": "「シトン」"
				},
				{
					"id": 752780112,
					"content": "口じゃ厳しいけど、結局おまえに目をかけてるんだな！おかしなことを教えなきゃもっとよかったんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752780113,
					"content": "そうだ、これ、あげる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780114
					],
					"speakerTitle": "「シトン」"
				},
				{
					"id": 752780114,
					"content": "こ、これはおまえのステージ衣装だろ？これがなかったら、おまえは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752780115,
					"content": "エへへ、心配いらないよ。パパがもっと体にピッタリ合うステージ衣装を作ってくれたから！今度はもう舞台で転んだりしないよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780116
					],
					"speakerTitle": "「シトン」"
				},
				{
					"id": 752780116,
					"content": "前のステージ衣装…友情の証に、受け取ってくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780117
					],
					"speakerTitle": "「シトン」"
				},
				{
					"id": 752780117,
					"content": "次に会うときは、新しいステージ衣装を着て、二人のために歓迎のダンスを捧げるね！だからまた絶対に来て応援して。待ってるから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780118
					],
					"speakerTitle": "「シトン」"
				},
				{
					"id": 752780118,
					"content": "おう、約束だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752780119,
					"content": "シトン！特訓の時間だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752780120,
					"content": "#ウン、もう時間がないから、筋トレに行くね！{NICKNAME}{M#お兄}{F#お姉}ちゃん、パイモンお姉ちゃん、またね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780121
					],
					"speakerTitle": "「シトン」"
				},
				{
					"id": 752780121,
					"content": "おう、またな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752780122,
					"content": "（本当に行くの？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752780123
					]
				},
				{
					"id": 752780123,
					"content": "そりゃ行くさ！まあ…その時は普通の「アイドル」のパフォーマンスが見られればいいな、とは思うけどな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752780110,
					"content": "最近どう？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752780111
					]
				}
			]
		}
	]
}