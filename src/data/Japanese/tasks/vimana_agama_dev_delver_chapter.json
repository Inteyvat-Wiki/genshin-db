			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アランラキャ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730270401,
					"content": "これでやっと一段落だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730270402,
					"content": "思い返すと、ずいぶん長い冒険だったよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270403,
						730270406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730270403,
					"content": "ジャザリーさんに聞かせてあげたら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730270404
					]
				},
				{
					"id": 730270404,
					"content": "だな。炉心の件を知ったら、オイラたちのために経費とかを申請してくれるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730270405,
					"content": "#でもオイラ、教令院とかいうのには入りたくない。{NICKNAME}もそうだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270409
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730270409,
					"content": "「マラーナの化身」とアビス教団の関係は結局はっきりしなかったけど、森の「病」を治せてほんとによかったぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270410
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730270410,
					"content": "うううっ、アランラキャからもお礼を言うよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270411
					],
					"speakerTitle": "アランラキャ"
				},
				{
					"id": 730270411,
					"content": "お礼なんていいよ、アランラキャ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730270412
					]
				},
				{
					"id": 730270412,
					"content": "でもこれから、アランラキャはどうするんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730270413,
					"content": "アランラキャはウツァヴ祭に参加する。でも、アランラキャは森の「病気」を心配してる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270414
					],
					"speakerTitle": "アランラキャ"
				},
				{
					"id": 730270414,
					"content": "森に病をもたらす悪いものが戻ってくるかもしれない。アランラキャ、森を守る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270415
					],
					"speakerTitle": "アランラキャ"
				},
				{
					"id": 730270415,
					"content": "だからウツァヴ祭が終わった後、アランラキャはまたここに戻ってこなくちゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270416
					],
					"speakerTitle": "アランラキャ"
				},
				{
					"id": 730270416,
					"content": "アランナラも苦労するね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730270417
					]
				},
				{
					"id": 730270417,
					"content": "助けが必要な時は、オイラたちを呼びに来いよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270418
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730270418,
					"content": "うんうん、アランラキャ分かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270419
					],
					"speakerTitle": "アランラキャ"
				},
				{
					"id": 730270419,
					"content": "へへっ、元気でな。また会おうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730270406,
					"content": "ロインジャさんに聞かせてあげたら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730270407
					]
				},
				{
					"id": 730270407,
					"content": "うん、ロインジャさんは絶対「実に興味深い話ですな」って言うよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730270408,
					"content": "オイラたちが森を救っちゃうなんて、びっくりだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270409
					],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
}