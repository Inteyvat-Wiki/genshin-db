				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アランラキャ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730270201,
					"content": "あれ？アランラキャ、なんでここに？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730270202,
					"content": "アランラキャ、花を植えた後、ずっとここでキミたちを待ってた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270203
					],
					"speakerTitle": "アランラキャ"
				},
				{
					"id": 730270203,
					"content": "そしたらさっき、急に大鉄山から何かが落ちてきて、アランラキャに当たりそうになった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270204
					],
					"speakerTitle": "アランラキャ"
				},
				{
					"id": 730270204,
					"content": "うわっ、アランラキャ、ごめんな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730270205,
					"content": "パイモン、何で謝る？アランラキャは大丈夫。アランラキャは走るのが速い。だから当たらなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270206
					],
					"speakerTitle": "アランラキャ"
				},
				{
					"id": 730270206,
					"content": "とにかく無事でよかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730270207
					]
				},
				{
					"id": 730270207,
					"content": "デカいロボットの折れたアームが地下遺跡の入口にぶつかって、穴が開いたみたいだ。結局は役に立ったってわけか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730270208,
					"content": "さっそく降りてみようぜ。悪いものが待ち構えてるかもしれないけどな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730270209,
					"content": "アランラキャも一緒に行く！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランラキャ"
				}
			]
		},
		{
			"id": 7302703,
			"completionStepIds": [
				7302705
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302705",
							"2"
						],
						"stepId": 7302705,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730270301,
					"content": "あの中で光ってるやつ、あれがきっとジャザリーさんの言ってたデカブツの混沌の炉心だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730270302,
					"content": "木の枝とツル草で封印されてはいるけど、なにかが漏れ出してる感じがするぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730270303,
					"content": "ううっ、汚いもの。アランラキャ感じる。あれが森を病気にするヤツだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270304
					],
					"speakerTitle": "アランラキャ"
				},
				{
					"id": 730270304,
					"content": "そうだな…アビスの魔術師が大勢大樹に集まって、なにをする気かは知らないけど、なんだか胸騒ぎがするぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730270305,
					"content": "炉心の封印は破壊されたって、ジャザリーさんが言ってたぞ。まさか、アビスの魔術師の仕業じゃないだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730270306,
					"content": "とにかくアランラキャは外に隠れてろ。オイラたちがやっつけてくるから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7302704,
			"completionStepIds": [
				7302714
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
