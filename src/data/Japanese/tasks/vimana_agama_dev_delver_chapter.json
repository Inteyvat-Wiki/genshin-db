			},
			"dialogs": [
				{
					"id": 730270101,
					"content": "探求心さえ持ち続けていれば、どんな者にも学問の扉は開かれる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270102
					],
					"speakerTitle": "ジャザリー"
				},
				{
					"id": 730270102,
					"content": "その信念を胸に精進するのだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジャザリー"
				}
			]
		},
		{
			"id": 7302702,
			"completionStepIds": [
				7302702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302702",
							"2"
