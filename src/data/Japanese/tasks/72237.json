			"trigger": {
				"objectNames": [
					"安貞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722370301,
					"content": "お前たちは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370302
					],
					"speakerTitle": "安貞"
				},
				{
					"id": 722370302,
					"content": "おまえが安貞か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722370303,
					"content": "ああ、そうだが…なんだか妙だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370304
					],
					"speakerTitle": "安貞"
				},
				{
					"id": 722370304,
					"content": "たしか…ずっとあいつらを追っていて、コアを引き抜いた後、拠点に捨てたのまでは覚えている。だが、大怪我をしていたせいか徐々に眠くなっていき…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370305
					],
					"speakerTitle": "安貞"
				},
				{
					"id": 722370305,
					"content": "目が覚めたらお前たちがいた。そして体の具合も良くなってる。これは、死ぬ寸前の幻覚か何かか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370306
					],
					"speakerTitle": "安貞"
				},
				{
					"id": 722370306,
					"content": "…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722370307
					]
				},
				{
					"id": 722370307,
					"content": "それよりも、お前たちは俺を連れ戻しに来たのか？あいにく、俺はもう自分の潔白を証明している。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370308
					],
					"speakerTitle": "安貞"
				},
				{
					"id": 722370308,
					"content": "図書館の本を盗んだのは、カーンルイアのやつらだ。確かに俺はやつらを迎えた際に護衛をしていたが、やつらと共謀するなど断じてありえない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370309
					],
					"speakerTitle": "安貞"
				},
				{
					"id": 722370309,
					"content": "俺はここで使節団の痕跡を調べ、やつらを全員倒した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370310
					],
					"speakerTitle": "安貞"
				},
				{
					"id": 722370310,
					"content": "だが、やつらの巨大機関を止めるために、長い時間を費やしてしまってな。コアを引き抜くことには成功したが、俺も重傷を負ってしまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370311
					],
					"speakerTitle": "安貞"
				},
				{
					"id": 722370311,
					"content": "動力を失った機械は、失われた本の上に倒れた。だから、もう取り戻すことはできない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370312
					],
					"speakerTitle": "安貞"
				},
				{
					"id": 722370312,
					"content": "白夜国の地走官ってすごいんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722370313,
					"content": "お前たちは地走官かその候補なんだろ？いや、まあどうだっていいか。その昔、地走官はアビサルヴィシャップと対抗する勇士だったんだ。その後、法の執行者、つまり幽冥判官となった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370314
					],
					"speakerTitle": "安貞"
				},
				{
					"id": 722370314,
					"content": "コアは拠点にある。信じられないのなら、自分で見に行ってくるといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安貞"
				}
			]
		},
		{
			"id": 7223704,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
