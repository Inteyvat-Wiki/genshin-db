			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"安貞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722370401,
					"content": "鳴神島の使節団から聞いた話なんだが、鳥という生き物には翼があって、空を高く飛べるらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370402
					],
					"speakerTitle": "安貞"
				},
				{
					"id": 722370402,
					"content": "なんて幻想的だろうか、想像できるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370403
					],
					"speakerTitle": "安貞"
				},
				{
					"id": 722370403,
					"content": "あれを神の使者だと言う者もいる。人の運命を告げにやって来る使者だと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370404
					],
					"speakerTitle": "安貞"
				},
				{
					"id": 722370404,
					"content": "処罰による追放で荒野に死した者がいれば、鳥はその死骸をつついて食う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370405
					],
					"speakerTitle": "安貞"
				},
				{
					"id": 722370405,
					"content": "俺はその生物に憧れを持っている。もし今後、日の目を見ることができたら、必ず鳥を飼うと決めているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安貞"
				}
			]
		},
		{
			"id": 7223705,
			"completionStepIds": [
				7223708
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7223708",
							"2"
						],
						"stepId": 7223708,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"安貞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722370501,
					"content": "お前たち、本は手に入れたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370502
					],
					"speakerTitle": "安貞"
				},
				{
					"id": 722370502,
					"content": "手に入れたぞ。安貞はホントに無実だったんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722370503,
					"content": "さっきの口ぶりからして、お前たちは地走官じゃないようだな。俺の無罪を正式に承認してもらえないのが少し残念だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370504
					],
					"speakerTitle": "安貞"
				},
				{
					"id": 722370504,
					"content": "潔白を証明できる、いい機会だったんだがな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370505
					],
					"speakerTitle": "安貞"
				},
				{
					"id": 722370505,
					"content": "気力はまだ残ってるが、さっきまで血を流し過ぎたせいか力が入らない…今の光景は、本当に死ぬ寸前の幻覚なのかもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370506
					],
					"speakerTitle": "安貞"
				},
				{
					"id": 722370506,
					"content": "うわー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370507
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722370507,
					"content": "はぁ…見知らぬお前に尋ねるのもどうかと思うが、白夜国よりかけられた冤罪は、罪として数えられるだろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370508
					],
					"speakerTitle": "安貞"
				},
				{
					"id": 722370508,
					"content": "…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722370509
					]
				},
				{
					"id": 722370509,
					"content": "もし今の俺が、このような気持ちのせいで、常世大神に罪影にされたら——それは罪なのだろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370510
					],
					"speakerTitle": "安貞"
				},
				{
					"id": 722370510,
					"content": "俺は…有罪なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370511
					],
					"speakerTitle": "安貞"
				},
				{
					"id": 722370511,
					"content": "あなたに罪はない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722370512
					]
				},
				{
					"id": 722370512,
					"content": "#おい、{NICKNAME}、慎重に話すんだぞ。もしあのことに気づかれたら…消えちゃうんだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370513
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722370513,
					"content": "あなたは安貞が残した残影。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722370514
					]
				},
				{
					"id": 722370514,
					"content": "…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370515
					],
					"speakerTitle": "安貞"
				},
				{
					"id": 722370515,
					"content": "#あなたは無罪だと、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}が皆に伝える。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722370516
					]
				},
				{
					"id": 722370516,
					"content": "ふふっ、そうか。俺はただの…生前の影だったか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370517
					],
					"speakerTitle": "安貞"
				},
				{
					"id": 722370517,
					"content": "俺は…無罪か。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安貞"
				},
				{
					"id": 722370518,
					"content": "安貞の残影が断章を読み始めた——\\n「いったいどの掟を破ったのか…不幸な者はなぜ神々を頼らなければならないのか？\\n敬虔であるがゆえに罪を負うようになった。そんな行動、意味があるのだろうか。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安貞"
				}
			]
		}
	]
}