			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"大島純平"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722130301,
					"content": "はぁ、かなづちも彫刻刀もないんじゃ、どうすれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130302
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722130302,
					"content": "何か問題でも？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130303
					]
				},
				{
					"id": 722130303,
					"content": "ああ、君たちか。いや…俺の不注意だ…ここに来る時、道具の確認をきちんとしてなかったんだ…しかも仕事に夢中で、かなづちと彫刻刀を壊してしまって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130304
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722130304,
					"content": "鳴神島に戻って道具を買おうとしたんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130305
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722130305,
					"content": "なんて言うか…彫刻を彫ることは、一気にやった方がいいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130306
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722130306,
					"content": "かなづちと彫刻刀は壊れたが、この先どう彫るか計画することはできる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130307
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722130307,
					"content": "今この彫刻を離れて、鳴神島に行ったら…彫刻を彫る感覚を一からやり直さないといけない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130308
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722130308,
					"content": "それに、この石は成分が非常に固い、一般の道具では、すぐに壊れてしまうだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130309
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722130309,
					"content": "はぁ…もう他に方法もない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130310
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722130310,
					"content": "旅人、本当に悪いんだが、鉄の塊を3つ探してきてくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130311
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722130311,
					"content": "今は自分の手で、頼りになる道具を作るしかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130312,
						722130314
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722130312,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130313
					]
				},
				{
					"id": 722130313,
					"content": "おう！じゃあ任せたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722130314,
					"content": "自分で…作るの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130315
					]
				},
				{
					"id": 722130315,
					"content": "俺はたたら砂で仕事してたんだ、鍛治も当然できる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130316
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722130316,
					"content": "だが、神社に炉を置くことはできない。代理宮司様が怒るうえに…ははっ、なんてったって猫だからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130317
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722130317,
					"content": "とにかく、鉄の塊を3つ探してきてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大島純平"
				}
			]
		},
