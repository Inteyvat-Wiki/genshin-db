			},
			"dialogs": [
				{
					"id": 722130501,
					"content": "良かった、これで足りるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130502
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722130502,
					"content": "あとで適した場所に炉を設置して、道具を作る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130503
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722130503,
					"content": "俺の代わりに代理宮司様に伝えてくれ、俺は先にここで準備を始める。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大島純平"
				}
			]
		},
		{
			"id": 7221306,
			"completionStepIds": [
				7221304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221304",
