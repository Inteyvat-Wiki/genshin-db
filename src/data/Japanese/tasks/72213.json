			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「寝子」",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722130601,
					"content": "にゃにゃ、何か用か？うちは十分な「ほーしゅー」を用意すると決めたにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130602,
						722130603
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722130602,
					"content": "「報酬」ね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130605
					]
				},
				{
					"id": 722130605,
					"content": "とにかく、石人…大島さんの道具が壊れたんだ。でもオイラたちが修理用の材料を集めたから、なにも問題ないと思うぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130606
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722130606,
					"content": "問題？何か問題でもあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130607,
						722130608
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722130607,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130609
					]
				},
				{
					"id": 722130609,
					"content": "ならいいにゃ。あいつの作る石、凄く期待してるにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130610
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722130610,
					"content": "響が言っていたにゃ。うちの形をした石ができれば、きっと良いことが起こると。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130611
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722130611,
					"content": "楽しみにゃ。いったいどんな良いことが起こるにゃ…まさか、響が帰ってくるのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722130608,
					"content": "問題ない、全部計画通り。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130609
					]
