			"trigger": {
				"objectNames": [
					"「寝子」",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722130101,
					"content": "「ほーしゅー」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130102
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722130102,
					"content": "彫刻はどうなった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130103
					]
				},
				{
					"id": 722130103,
					"content": "あの石人間は本当に凄いにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130104
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722130104,
					"content": "もうできたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130105
					]
				},
				{
					"id": 722130105,
					"content": "そうではにゃいが、瞬く間に大きな石を持ってきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130106
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722130106,
					"content": "しかもずっと、「やといぬし」とか「ほーしゅー」を口にしながら、石を叩いてるにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130107
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722130107,
					"content": "そういえば、主に聞くが、「やといぬし」と「ほーしゅー」はどんな意味にゃ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130108
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722130108,
					"content": "「雇い主」と「報酬」でしょ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130109
					]
				},
				{
					"id": 722130109,
					"content": "その人の労働に報いるために、良いものをあげるってことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722130110,
					"content": "そうにゃのか？人間はそんなことを気にするのか…ならば、あいつにうちの耳を触らせてあげるにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130111
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722130111,
					"content": "そ、それじゃ足りないと思うぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722130112,
					"content": "足りにゃいのか？ではうちが…美味しいものを食べさせてあげるにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130113
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722130113,
					"content": "彼が欲しいのはお金だと思う…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130114
					]
				},
				{
					"id": 722130114,
					"content": "お金？それは「賽銭箱」に入れるものじゃにゃいのか？そんなものが好きだにゃんて、人間は変だにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130115
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722130115,
					"content": "お金は重要。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130116
					]
				},
				{
					"id": 722130116,
					"content": "ふん、主もこれまでうちをたくさん助けてくれた、主のことは信じる。あとで、あいつとも話をするにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130117
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722130117,
					"content": "だけど今、石人間はもう石を叩いたりしていにゃい。短い木の棒を持ってる。何をしようとしてるかは分からにゃい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130118
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722130118,
					"content": "木の棒？彫刻ってかなづちとか彫刻刀を使うんじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722130119,
					"content": "まさか道具が壊れたんじゃ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130120
					]
				},
				{
					"id": 722130120,
					"content": "#{NICKNAME}、大島さんのところに行ってみよう！なにか手伝えることがあるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
