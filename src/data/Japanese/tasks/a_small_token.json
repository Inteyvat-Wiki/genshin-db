			"dialogs": [
				{
					"id": 752380201,
					"content": "ふん…旅人…次会った時は許さないんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380202,
						752380203
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 752380202,
					"content": "（もう少し、座っていようかしら。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380204
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 752380204,
					"content": "もうこんな時間？ギヨタンさん、気をつけて帰ってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 752380203,
					"content": "そろそろお茶会はお開きにしましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380204
					],
					"speakerTitle": "「傀儡」"
				}
			]
		}
	]
