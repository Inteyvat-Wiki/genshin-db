			"dialogs": [
				{
					"id": 752380101,
					"content": "このお茶、アナタのお口に合ったかしら？それとも、お酒を用意したほうがよかった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380102
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 752380102,
					"content": "いいえ、お茶でいいの。昼間からお酒を飲むことに罪悪感がないわけじゃないし…できるだけ控えるって決めたのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380103
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 752380103,
					"content": "それにしてもギヨタンさん、どうして遠路はるばるナタまで？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380104
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 752380104,
					"content": "あちこち巡って、友人を訪ねているだけよ。千霊祭の時は、仕事を引き受けてくれてありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380105
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 752380105,
					"content": "そのためだけに…わざわざ来てくれたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380106
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 752380106,
					"content": "それに、アナタは何も言わなかったけど…以前、アナタたちに不愉快な思いをさせたことは承知しているわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380107
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 752380107,
					"content": "え？ああ…ロボットのイネファと、キミの部下のあの件？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380108
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 752380108,
					"content": "ふふっ…でも、人生ってそういうモノじゃない？かつての敵のボスが仲間になったり、時には仲間どころか雇い主になったり…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380109
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 752380109,
					"content": "よければ受け取ってちょうだい。ささやかだけど、ワタシの気持ちよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380110
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 752380110,
					"content": "こ…これは娯楽小説の…限定版、いや、愛蔵版じゃない！？しかもワタシの好きなジャンルだし…ど、どうしてこれを…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380111
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 752380111,
					"content": "旅人にアナタが好きそうなものを聞いて、参考にしたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380112
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 752380112,
					"content": "た、旅人が…！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380113
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 752380113,
					"content": "（もう…！この純粋に嬉しいとは言い切れない、複雑なキモチはなんなの！？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380114
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 752380114,
					"content": "（ワタシの好きなモノを覚えててくれたのは嬉しいけど…それなら他の人にペラペラ喋る前に、直接プレゼントしに来てよね！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380115
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 752380115,
					"content": "お気に召したかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380116
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 752380116,
					"content": "あ…ありがとう。ギヨタンさん、気を遣わせちゃったわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380117
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 752380117,
					"content": "喜んでもらえたなら、次も何冊か持ってくるわ。また旅人と一緒に行って、選ぶのを手伝ってもらうことになるでしょうけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380118
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 752380118,
					"content": "いいい、一緒に！？一緒に…本屋を回って選んだの！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380119
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 752380119,
					"content": "#{M#ええ。彼、アナタのために真剣にその本を選んでたわよ。もしかしたら、今度は…}{F#ええ。彼女、アナタのために真剣にその本を選んでたわよ。もしかしたら、今度は…}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380120
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 752380120,
					"content": "今度なんてダメダメ！ゼッタイにダメ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380121
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 752380121,
					"content": "え…えぇ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「傀儡」"
				}
			]
		},
