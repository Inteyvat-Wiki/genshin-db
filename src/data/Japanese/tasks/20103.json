			"dialogs": [
				{
					"id": 201031101,
					"content": "どう？ヒルチャールに読み聞かせたかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031102
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 201031102,
					"content": "読み聞かせたよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031103
					]
				},
				{
					"id": 201031103,
					"content": "どうだった？その様子じゃ、悪くなかったでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031104
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 201031104,
					"content": "いい感じだった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031105
					]
				},
				{
					"id": 201031105,
					"content": "私の理解は合ってるってことね、よかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031106
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 201031106,
					"content": "これでヒルチャール語の研究がまた一歩前進したわけね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031107
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 201031107,
					"content": "いつか、ヒルチャールたちと自由に交流し、そしてその口からヒルチャールの秘密を全部聞き出すの。そしたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031108
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 201031108,
					"content": "…「マスク」という名字に相応しい人になれる気がする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031109
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 201031109,
					"content": "そうだ、これを受け取って、お礼よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エラ·マスク"
				}
			]
		},
