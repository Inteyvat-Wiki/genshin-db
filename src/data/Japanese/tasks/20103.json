				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"エラ·マスク"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201030101,
					"content": "また会ったね、私のことを覚えてる？忘れたとしても…さすがにヒルチャールと行った「友好的交流」は覚えてるでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030102
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 201030102,
					"content": "うっ、そんな顔で見ないで。言葉の学習は練習の積み重ねなんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030103
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 201030103,
					"content": "安心して、あなたの努力を無駄にしてないよ。前回戻った後、私のヒルチャール語の会話レベルはすごく上がったわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030104
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 201030104,
					"content": "ただ、会話レベルも大事だけど、筆記レベルも大事よ。だから、厳密な研究を経て…ヒルチャール語で詩を書いてみたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030105
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 201030105,
					"content": "でも…この詩の中で、まだ意味が確定できない言葉がいくつかあって、「検証」してきてくれないかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030106,
						201030111
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 201030106,
					"content": "…「検証」って？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201030107
					]
				},
				{
					"id": 201030107,
					"content": "も、もちろんそれを読んで、ヒルチャールに聞かせて、どういう反応するか見るのよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030108
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 201030108,
					"content": "心配しないで！疑問のある言葉は、<color=#00E1FFFF>標記していて</color>、意味はそんなに変わらないと思うから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030109
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 201030109,
					"content": "もうターゲットも選んであるわ。あのヒルチャールたちは優しそうに見えるし、読んで、聞かせてみるといいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030110
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 201030110,
					"content": "じゃあ、お願いね！私が書いた詩をヒルチャールに聞かせて、詳細を私に教えて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 201030111,
					"content": "…またヒルチャールに聞かせる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201030112
					]
				},
				{
					"id": 201030112,
					"content": "そう、もう分かってるのね。安心して、疑問のある言葉は、<color=#00E1FFFF>マークしてある</color>から、意味はそんなに変わらないと思うけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030113
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 201030113,
					"content": "もうターゲットも選んであるわ。あのヒルチャールたちは優しそうに見えるし、読んで、聞かせてみるといいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030114
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 201030114,
					"content": "じゃあ、お願いね！私が書いた詩をヒルチャールに聞かせて、詳細を私に教えて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030115
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 201030115,
					"content": "な、なにか予想外のことがあっても、あなたたちならうまく対応できると信じてる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エラ·マスク"
				}
			]
		},
