			"dialogs": [
				{
					"id": 201031201,
					"content": "どう？私の詩をヒルチャールに読み聞かせたかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031202
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 201031202,
					"content": "読み聞かせたよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031203
					]
				},
				{
					"id": 201031203,
					"content": "どうだった？うっ、その様子じゃ…かなりまずかったようね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031204
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 201031204,
					"content": "少しトラブルが…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031205
					]
				},
				{
					"id": 201031205,
					"content": "私がつけたマークを見なかったの？それとも、それすら間違ってるの…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031206
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 201031206,
					"content": "ごめんね、私もまだまだ勉強しないといけないようね。手伝ってくれてありがとう、お礼代わりにこれを受け取って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031207
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 201031207,
					"content": "…もっと頑張らないと、「マスク」という名に恥をかかせてしまうわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エラ·マスク"
				}
			]
