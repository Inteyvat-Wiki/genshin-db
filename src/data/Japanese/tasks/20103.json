			},
			"dialogs": [
				{
					"id": 201031501,
					"content": "私が書いた詩、ヒルチャールたち気に入ってくれるかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031502,
						201031509,
						201031515
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 201031502,
					"content": "どうしてヒルチャール語で詩を？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031503
					]
				},
				{
					"id": 201031503,
					"content": "うん…正直に言うと、まだヒルチャール語を全部把握したわけじゃないの。文法とか、文型とか、単語の組み合わせとか、まだ全部理解してないわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031504
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 201031504,
					"content": "これらの内容は頑張って書いたものだけど、ヒルチャールからすると、不器用なものでしかないかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031505
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 201031505,
					"content": "それに、一つの言葉が違うと、文章の意味が全て変わってしまうかも…そういう微妙な変化は、実践、つまりヒルチャールと交流しないと、絶対に分からないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031506
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 201031506,
					"content": "でも、「ヒルチャールからヒルチャール語を勉強する」なんて、普通の人は受け入れられないでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031507
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 201031507,
					"content": "でも私は受け入れられる…というより、ヒルチャール語を学ぶために、ヒルチャールを理解するために、私は受け入れないといけないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031508
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 201031508,
					"content": "それにね、詩でモンド周辺のヒルチャールたちと交流することが、一番いい形だと思ってるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 201031509,
					"content": "そのマーク…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031510
					]
				},
				{
					"id": 201031510,
					"content": "マークのことね。うん…こう説明しよう、この詩の単語は、本から見つけたものよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031511
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 201031511,
					"content": "本で見た使い方をマネして、文章を作ってみたけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031512
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 201031512,
					"content": "言語自体とても複雑なものでしょ…同じ単語でも、違う環境にあると、その意味は変化するかもしれないし、文章の意味に影響するかもしれない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031513
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 201031513,
					"content": "これらの文章は、私が書いた詩の中で、比較的に意味がわかるものばかりよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031514
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 201031514,
					"content": "他の「詩」とか、自分で書いたのにどう訳していいかわからないものだってあるわ…それは見せないでおく…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 201031515,
					"content": "マークを見ると、もう大体理解できてるでしょ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031516
					]
				},
				{
					"id": 201031516,
					"content": "それはあくまで「大体」よ。ヒルチャールと友好的に交流したいとはいえ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031517
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 201031517,
					"content": "もし間違えたら、ヒルチャールは説明させる時間をくれないでしょうし、急に襲ってきたら、ただじゃすまされないよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031518
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 201031518,
					"content": "だから、あなたにお願いするしかないよ、へへっ…だ、大丈夫、私がマークした通りにすれば、問題はないはずだから、安心して。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031519
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 201031519,
					"content": "うん、たぶん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エラ·マスク"
				}
			]
