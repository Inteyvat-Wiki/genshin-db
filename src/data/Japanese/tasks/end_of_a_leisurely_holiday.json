			"dialogs": [
				{
					"id": 765100101,
					"content": "…これで秘密の軍事兵器なんかじゃないって証明できたでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100102
					],
					"speakerTitle": "エドラー"
				},
				{
					"id": 765100102,
					"content": "うーん、確かに。これ以上難しくならない限り、ただのお遊びね。ま、頑張って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100103
					],
					"speakerTitle": "ヴィスラヴァ"
				},
				{
					"id": 765100103,
					"content": "うわっ！またピリピリしてきた…なんかこの感じ、今にも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765100104,
					"content": "戦いが始まりそう？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100105
					]
				},
				{
					"id": 765100105,
					"content": "#ええ…{NICKNAME}さんもいることだし、この際、公平に戦いましょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100106
					],
					"speakerTitle": "ヴィスラヴァ"
				},
				{
					"id": 765100106,
					"content": "はぁ、一体どこからそんな執念が湧いてくるのか…もしかして、前回の決着が簡単につきすぎたから？まあ、それなら付き合ってあげてもいいけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100107
					],
					"speakerTitle": "エドラー"
				},
				{
					"id": 765100107,
					"content": "#{NICKNAME}さん、どっちが先に降参するか、よく見ててよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100108
					],
					"speakerTitle": "エドラー"
				},
				{
					"id": 765100108,
					"content": "ふん、口先だけじゃないといいけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100109,
						765100110
					],
					"speakerTitle": "ヴィスラヴァ"
				},
				{
					"id": 765100109,
					"content": "エドラーのほうが強そう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100111
					]
				},
				{
					"id": 765100111,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100112
					],
					"speakerTitle": "エドラー"
				},
				{
					"id": 765100112,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100113
					],
					"speakerTitle": "ヴィスラヴァ"
				},
				{
					"id": 765100113,
					"content": "……！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100114
					]
				},
				{
					"id": 765100114,
					"content": "うわわっ！あいつら、一局交えるって意味じゃなかったのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765100115,
					"content": "三秒だけあげるから、降参したら——？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100116
					],
					"speakerTitle": "エドラー"
				},
				{
					"id": 765100116,
					"content": "三、二、一…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100117
					],
					"speakerTitle": "エドラー"
				},
				{
					"id": 765100117,
					"content": "わぁーっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765100118,
					"content": "「カチッ」と金属音が響くと、後は静寂に包まれた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						765100119
					]
				},
				{
					"id": 765100119,
					"content": "パイモンさん、目を開けて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100120
					],
					"speakerTitle": "エドラー"
				},
				{
					"id": 765100120,
					"content": "外野のあなたが一番ビビってたみたいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100121
					],
					"speakerTitle": "ヴィスラヴァ"
				},
				{
					"id": 765100121,
					"content": "な、なに？ヴィスラヴァ、無事だったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100122,
						765100123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765100122,
					"content": "エドラーはヴィスラヴァを脅してただけだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100124
					]
				},
				{
					"id": 765100124,
					"content": "たとえよその土地でも、牢屋に入れられたくはないからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100125
					],
					"speakerTitle": "エドラー"
				},
				{
					"id": 765100125,
					"content": "私が簡単に操れるような商人じゃないってことを分かってもらうためには、虚勢を張るしかなかったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100126
					],
					"speakerTitle": "エドラー"
				},
				{
					"id": 765100126,
					"content": "そうすれば次に会った時、嫌がらせしようなんて思わなくなるでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100127
					],
					"speakerTitle": "エドラー"
				},
				{
					"id": 765100127,
					"content": "#でも、{NICKNAME}はどうやって見抜いたんだ？全然ビビってなかったよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100128,
						765100129
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765100128,
					"content": "エドラーが落ち着いてたから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100130
					]
				},
				{
					"id": 765100130,
					"content": "鋭いね。確かに脅迫は、相手を降参させる一番簡単な方法だよ。でも残念ながら、そう簡単に近道はできるものじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100131
					],
					"speakerTitle": "ヴィスラヴァ"
				},
				{
					"id": 765100131,
					"content": "#ま、今は{NICKNAME}さんもここにいるしね…とにかく私は、ちゃんとここに立ってるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100132
					],
					"speakerTitle": "ヴィスラヴァ"
				},
				{
					"id": 765100132,
					"content": "ただ、次にチャンスがあれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100133
					],
					"speakerTitle": "ヴィスラヴァ"
				},
				{
					"id": 765100133,
					"content": "まさか、あなたのような方にお目にかかれる機会なんて、滅多にないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100134
					],
					"speakerTitle": "エドラー"
				},
				{
					"id": 765100134,
					"content": "…もしあなたが仕事で私に手を出してくるなら、私も自衛するしかないけどね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100135
					],
					"speakerTitle": "エドラー"
				},
				{
					"id": 765100135,
					"content": "でも…もしまた休暇中に会えたら、兵棋演習でもしよう。商売のためにも、付き合ってくれると助かるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エドラー"
				},
				{
					"id": 765100129,
					"content": "「どっちが先に降参するか」って言ってたから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100130
					]
				},
				{
					"id": 765100123,
					"content": "弾は入ってなかったんだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100124
					]
				},
				{
					"id": 765100110,
					"content": "ヴィスラヴァのほうが圧倒しそう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100111
					]
				}
			]
		}
	]
}