			"dialogs": [
				{
					"id": 190010101,
					"content": "バーバラ…何かあったのかしら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010102
					],
					"speakerTitle": "ヴィクトリア"
				},
				{
					"id": 190010102,
					"content": "バーバラがどうかしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190010103
					]
				},
				{
					"id": 190010103,
					"content": "彼女、薬草を採りに行ったきり帰って来ないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010104
					],
					"speakerTitle": "ヴィクトリア"
				},
				{
					"id": 190010104,
					"content": "西風騎士団に報告した方がいいかしら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010105
					],
					"speakerTitle": "ヴィクトリア"
				},
				{
					"id": 190010105,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}が探しに行くよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190010106
					]
				},
				{
					"id": 190010106,
					"content": "確かに…「栄誉騎士」であるあなたなら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010107
					],
					"speakerTitle": "ヴィクトリア"
				},
				{
					"id": 190010107,
					"content": "それに、騎士団に報告するのも面倒だし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010108
					],
					"speakerTitle": "ヴィクトリア"
				},
				{
					"id": 190010108,
					"content": "あなたにお願いしてもいいかしら。確か、奔狼領の近くへ薬草を採りに行くと言ってたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010109
					],
					"speakerTitle": "ヴィクトリア"
				},
				{
					"id": 190010109,
					"content": "そこに行けば、彼女が見つかるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "ヴィクトリア"
				}
			]
		},
