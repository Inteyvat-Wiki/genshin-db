			"dialogs": [
				{
					"id": 200340301,
					"content": "ベネット先輩、相変わらず頼りになるなぁ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340302
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200340302,
					"content": "フィッシュル先輩も…いつもながら気迫がすごかった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340303,
						200340308
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200340303,
					"content": "ベネットについて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340304
					]
				},
				{
					"id": 200340304,
					"content": "ベネット先輩のことをどう思ってるかって？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340305
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200340305,
					"content": "私が協会に入ったばかりの頃、ベネット先輩が色々教えてくれたの。それに、私の手伝いもたくさんしてくれたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340306
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200340306,
					"content": "でも聞いた話だと、ベネット先輩はずっとすごく運が悪いみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340307
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200340307,
					"content": "この世って本当に不公平だよね。あんなにいい人なのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340313
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200340313,
					"content": "ふぅ…依頼はこれで終わりだね。ありがとう、旅人さん。私は帰って協会に報告してくるね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340314
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200340314,
					"content": "でも、もう何日も運搬用の熱気球の護送ばかり…協会には他の依頼がないのかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アナ"
				},
				{
					"id": 200340308,
					"content": "フィッシュルについて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340309
					]
				},
				{
					"id": 200340309,
					"content": "フィッシュル先輩は…うん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340310
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200340310,
					"content": "す、すごく頼りになるよ！弓の腕も凄いし、たくさんの依頼を経験してきた人だもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340311
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200340311,
					"content": "でも…フィッシュル先輩の話は…ちょっと、理解できないかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340312
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200340312,
					"content": "フィッシュル先輩も経験豊富な冒険者…あ、ううん、調査員だと思う！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340313
					],
					"speakerTitle": "アナ"
				}
			]
		},
		{
			"id": 2003404,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
