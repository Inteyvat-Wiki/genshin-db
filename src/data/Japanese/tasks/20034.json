			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アンソニー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200340401,
					"content": "旅人、アナのことを頼むよ。あの子、最近少しはしゃぎすぎてる気がするんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340402
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 200340402,
					"content": "冒険者になってほしくないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340403
					]
				},
				{
					"id": 200340403,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340404
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 200340404,
					"content": "妹の夢は尊重してる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340405
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 200340405,
					"content": "病気が治って、やっと自分の夢を追うチャンスを手に入れたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340406
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 200340406,
					"content": "アナの兄として、俺は…全力でそれを応援するつもりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340407
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 200340407,
					"content": "ただ、それだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アンソニー"
				}
			]
		}
	]
}