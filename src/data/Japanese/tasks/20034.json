				"points": []
			},
			"dialogs": [
				{
					"id": 200340101,
					"content": "よし…今日も任務完了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340102,
						200340106
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200340102,
					"content": "やる気満々だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340103
					]
				},
				{
					"id": 200340103,
					"content": "もちろん。だって冒険者をやるのって、本当に面白いもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340104
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200340104,
					"content": "でも…えへへ、依頼をこなす時、まだちょっと慣れないことがあるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340105
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200340105,
					"content": "旅人さん、また私と一緒に依頼を受けてもらえないかな？他にもあなたに教わりたいことがあるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340108
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200340108,
					"content": "じゃあ、出発しよう。今日の依頼は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340109
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200340109,
					"content": "うん…また運搬用の熱気球の護送…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アナ"
				},
				{
					"id": 200340106,
					"content": "一緒に行こうか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340107
					]
				},
				{
					"id": 200340107,
					"content": "いいの？えへへ、聞いてみたいことがまだまだあるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340108
					],
					"speakerTitle": "アナ"
				}
			]
		},
		{
			"id": 2003402,
			"completionStepIds": [
				2003406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
