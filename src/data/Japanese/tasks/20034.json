			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ベネット",
					"フィッシュル",
					"アナ",
					"オズ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200340201,
					"content": "フィッシュル、走るのが速すぎだぞ！もう少しペースを落とさないと、危険が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340202
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 200340202,
					"content": "わたくしの聖裁の雷は、いかなる邪悪をも野放しにはしない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340203
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 200340203,
					"content": "フィッシュル先輩、それにベネット先輩、こんにちは！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340204
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200340204,
					"content": "アナ、それに旅人じゃないか。協会の依頼か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340205
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 200340205,
					"content": "ああ！わたくしの祝福を受けし者たち…運命の糸を手繰り寄せて、ここまで導かれたのね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340206
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 200340206,
					"content": "「こんな場所であなたたちに会えるなんて奇遇ですね」という意味です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340207
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 200340207,
					"content": "アナと一緒に依頼を受けてきた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340208
					]
				},
				{
					"id": 200340208,
					"content": "はい、旅人さんと一緒に運搬用の熱気球を護送してるところなんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340209
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200340209,
					"content": "でも、急に宝盗団が襲いかかってきて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340210
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200340210,
					"content": "ああ、わりぃわりぃ…全部オレのせいだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340211
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 200340211,
					"content": "フィッシュルと一緒に、宝盗団の調査をする依頼を受けたんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340212
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 200340212,
					"content": "オズが敵の方向を捕えたから、皆でそこに向かおうとした時…オレが道端の枝につまずいて、そのまま転がり落ちちまったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340213
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 200340213,
					"content": "そのせいで宝盗団に気づかれて、逃げられて…その後オレたちはあいつらをずっと追いかけてたってわけだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340214
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 200340214,
					"content": "心配せずとも、蒼紫なる制裁の光は、悪の運命を断ち切るはずよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340215
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 200340215,
					"content": "しかしお嬢様、実際に悪人を捕まえたのは、旅人さんでは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340216
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 200340216,
					"content": "オ、オズ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340217
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 200340217,
					"content": "と、とにかく、今回はお前らに礼を言わないとな。お前らがいてくれて助かったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340218
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 200340218,
					"content": "どうやら、今日のオレは結構ツイてるみたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340219
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 200340219,
					"content": "役に立ててよかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340220
					]
				},
				{
					"id": 200340220,
					"content": "ヘヘッ。じゃあ、オレたちは宝盗団のやつらを連れて協会に帰るぜ。お前たちも、依頼をこなす時は気をつけろよ。特に、足元にはな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ベネット"
				}
			]
		},
