					}
				]
			},
			"dialogs": [
				{
					"id": 760690401,
					"content": "この感覚…俺が見つけられなかった「狼の魂」の破片が具現化したのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690402
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 760690402,
					"content": "誰がお前をここに残した？ここで何を守ってるんだ？さあ…答えてもらおうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690403
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 760690403,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690404
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 760690404,
					"content": "…何度言えば分かる。血に染まった道を歩むのは、私一人で十分だ。貴様らはついてこずともよい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690405
					],
					"speakerTitle": "ローランド"
				},
				{
					"id": 760690405,
					"content": "ははっ、なら俺たちはたまたま一緒になったってことでどうだ？モンドからナド・クライまで、たまたまあんたと同じ道を辿って来ただけさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690406
					]
				},
				{
					"id": 760690406,
					"content": "ああ。たまたまとある騎士に何度も救われ、彼に憧れるようになった…そしていつの間にか、同じような道を歩んでいる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690407
					]
				},
				{
					"id": 760690407,
					"content": "アンタの騎士道を理解できなくたっていい。この旅路の果てで、誰も救うことができなかったとしても…せめて傍で見届けたいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690408
					]
				},
				{
					"id": 760690408,
					"content": "アオーン——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690409
					]
				},
				{
					"id": 760690409,
					"content": "それが貴様らの騎士道だというのなら…私に否定する権利はない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690410
					],
					"speakerTitle": "ローランド"
				},
				{
					"id": 760690410,
					"content": "……",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760690411
					]
				},
				{
					"id": 760690411,
					"content": "厄介な魔物を…倒しきれたのか？住民たちは…もう大丈夫なんだな…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690412
					]
				},
				{
					"id": 760690412,
					"content": "ゴホッ…よかった——しかし私たちはもう、旅の最後までついていけそうにない…無念だ…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690413
					]
				},
				{
					"id": 760690413,
					"content": "ここからは…アンタ一人で行ってくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690414
					]
				},
				{
					"id": 760690414,
					"content": "…結局、私の剣では全てを守ることはできなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690415
					],
					"speakerTitle": "ローランド"
				},
				{
					"id": 760690415,
					"content": "…挙句の果てに、この道に残ったのは私のみ…もとより、こうなる定めだったのかもしれん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690416
					],
					"speakerTitle": "ローランド"
				},
				{
					"id": 760690416,
					"content": "せめてこれらの剣と、この地の狼たちの魂に墓守をさせてやろう——漆黒の魔物どもに、貴様らの安らかな眠りが妨げられぬよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690417
					],
					"speakerTitle": "ローランド"
				},
				{
					"id": 760690417,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690418
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 760690418,
					"content": "なるほど、そういうことか…騎士団の記録には「血染めの騎士」が旅に出た時、それに追随した騎士がいたとあるが、その後の記述は見当たらなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690419
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 760690419,
					"content": "まさか、魔物討伐のためにここで命を落としてたとはな…さすがは西風騎士団の団員だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690420
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 760690420,
					"content": "だが、お前たちの「願い」は、本当にここで終わりなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690421
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 760690421,
					"content": "今なお消えない戦火、剣に宿る想い…「騎士」としての決意を、俺に聞かせてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690422
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 760690422,
					"content": "ボレアスが遺した力で、この戦場を封じよう…あの小さき狼も外から見守ってくれるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690423
					],
					"speakerTitle": "ローランド"
				},
				{
					"id": 760690423,
					"content": "貴様らには「護られる」だけの資格がある——永遠に邪魔されることなく安寧を享受し、永遠に…この世の不条理を目にすることのないように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690424
					],
					"speakerTitle": "ローランド"
				},
				{
					"id": 760690424,
					"content": "さらばだ——我が最後の「戦友」よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690425
					],
					"speakerTitle": "ローランド"
				},
				{
					"id": 760690425,
					"content": "…嫌だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690426
					]
				},
				{
					"id": 760690426,
					"content": "駄目だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690427
					]
				},
				{
					"id": 760690427,
					"content": "オレたちが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690428
					]
				},
				{
					"id": 760690428,
					"content": "…もう一度…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690429
					]
				},
				{
					"id": 760690429,
					"content": "そうだよな——お前たちの「願い」は…こんな陽の当たらない場所で、静かに朽ち果てるようなもんじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690430
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 760690430,
					"content": "なら、往こう！俺と一緒に、再び——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690431
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 760690431,
					"content": "——戦場へ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ファルカ"
				}
			]
		}
	]
}