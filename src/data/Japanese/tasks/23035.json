							"2303503",
							"2"
						],
						"stepId": 2303503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"福本"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230350301,
					"content": "しっ…あ、あの方は、セノ様ではありませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350302
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350302,
					"content": "衣装、髪型、それに、あの髪の色を見てください…まさにカードゲーム小説のベスト主人公ですね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350303,
						230350305
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350303,
					"content": "理屈は全然分からないけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350304
					]
				},
				{
					"id": 230350304,
					"content": "まあ、小説市場における私の直感を信じてください。今はそんなことを言っている場合ではありませんが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350309
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350309,
					"content": "旅人さん、セノさんにモデルをお願いする件…よろしくお願いします！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "福本"
				},
				{
					"id": 230350305,
					"content": "そういう主人公なら確かに沢山知ってるけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350306
					]
				},
				{
					"id": 230350306,
					"content": "本当ですか？よかったです。ちょうど今、『召喚王』の三作目を書こうとしていまして。でも、今回は「七聖召喚」の遊び方をもとに書くつもりはないんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350307
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350307,
					"content": "完全にオリジナルの対戦ルールを作ろうと決めました。例えば…すべてのカードはフィールドに浮かんでおり、プレイヤーは対戦しながらカードを集め続けると同時に、相手がカードを集めるのを阻止しなければならない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350308
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350308,
					"content": "ふふふ！考えるだけでとても面白いですね！…でも、今はそんなことを言っている場合ではありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350309
					],
					"speakerTitle": "福本"
				}
			]
		},
		{
			"id": 2303504,
			"completionStepIds": [
				2303504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2303504",
							"2"
						],
						"stepId": 2303504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"セノ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230350401,
					"content": "…うん、こういうデッキも悪くないかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350402
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 230350402,
					"content": "だが、このデッキだとクイックアタックに対応する能力が弱すぎるか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350403
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 230350403,
					"content": "セノ、何をしてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350404
					]
				},
				{
					"id": 230350404,
					"content": "#{NICKNAME}？まさかこんなところで会えるとは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350405
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 230350405,
					"content": "攻撃のテンポがやや遅い「七聖召喚」のデッキを組もうとしてるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350406
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 230350406,
					"content": "俺の予想では、こういうデッキを組むプレイヤーは豊富なリソースと、様々な強カードを持つはずだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350407
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 230350407,
					"content": "でも正直、こういうデッキを組むのはなかなか難しくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350408
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 230350408,
					"content": "「七聖召喚」プレイヤーの中には、攻撃のテンポが速めのデッキを使うのが好きなプレイヤーもいる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350409
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 230350409,
					"content": "ゲームの序盤から、一気に大量のカードで攻撃を繰り出して、高速で相手を倒すんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350410
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 230350410,
					"content": "でも、俺はこの戦術が好きじゃない。色んな方法でリソースを貯めていく戦術の方が好きだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350411
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 230350411,
					"content": "あらゆるチャンスを捉えて優勢を保ち続け、最終的な勝利を掴み取る…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350412
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 230350412,
					"content": "そうです！まさにその通りです！よかった、本当によかった！セノさんはまさに私の小説の主人公です！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350413
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350413,
					"content": "あっ、すみません！えっと…私は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350414,
						230350415
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350414,
					"content": "こちらは福本さん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350416
					]
				},
				{
					"id": 230350415,
					"content": "こちらは小説『召喚王』の作者。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350416
					]
				},
				{
					"id": 230350416,
					"content": "初めまして、大マハマトラ様。その…私のことはご存じないと思いますが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350417
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350417,
					"content": "お前の小説を読んだことがある。悪くなかったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350418
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 230350418,
					"content": "それは、本当に光栄です！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350419
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350419,
					"content": "あの小説で一番印象に残っているのは、主人公が不利になると、いつも色んな方法でデッキに存在しないカードを手に入れて相手を倒し、勝利を勝ち取るところだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350420
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 230350420,
					"content": "物語作りのために必要なのだと理解はできるが、この勝ち方が「七聖召喚」というゲームの本質から外れていることは確かだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350421
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 230350421,
					"content": "あっ、それは…私もよく「七聖召喚」をプレイしているのですが、実はあまり上手ではなくて…それに、実際の競技の意識でカード対戦を書いても、いい小説にはならないでしょうから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350422
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350422,
					"content": "…そうか。ならちょうどいい、デッキを二セット組んだところなんだ。ここで「七聖召喚」を何回かやってみないか。何かヒントが得られるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350423,
						230350424
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 230350423,
					"content": "（いきなりカードゲームを始めるんだ…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350425
					]
				},
				{
					"id": 230350424,
					"content": "（ただ単にやりたくなっただけなんじゃ…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350425
					]
				},
				{
					"id": 230350425,
					"content": "え？セ、セノ様とゲームをですか？もちろん喜んで。でも、実は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350426,
						230350427
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350426,
					"content": "#{M#俺}{F#私}が説明するよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230350427,
					"content": "福本の頼み事について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230350428,
					"content": "旅人は福本の頼み事について話した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 230350429,
					"content": "『召喚王』の挿し絵のモデルを、俺がか？それはもちろん、問題ないが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350430
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 230350430,
					"content": "よかったです！旅人さん、早く、写真をいっぱい撮ってください！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "福本"
				}
			]
		},
