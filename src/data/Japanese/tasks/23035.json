			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"福本"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230350101,
					"content": "はぁ、稲妻に帰りたい…どうしてこんなことに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350102,
						230350103
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350104
					]
				},
				{
					"id": 230350104,
					"content": "旅人さんでしたか。はぁ…小説はともかく、「七聖召喚」を制作している人たちはそろそろ限界じゃないかと思いますけどね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350105
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350105,
					"content": "私とそこそこ付き合いのある学者によると、「七聖召喚」を制作するとき、彼らはありとあらゆる、さっぱりわけのわからない問題に遭遇したそうです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350106
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350106,
					"content": "例えば、ある日、ハルヴァタット学院のとある学者がこんな問題を提起しました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350107
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350107,
					"content": "カードに書かれた効果説明が長すぎて、長い文章を読むのに慣れていない人たちが「七聖召喚」をプレイする意欲を失くしてしまわないか、って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350108
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350108,
					"content": "学者たちは長い文章を読むのに慣れているため、この問題には敏感ではありません。しかし…確かに、長い文章を読むのが苦手なために、「七聖召喚」をやめてしまうプレイヤーがいるかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350109
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350109,
					"content": "そこで彼は、一部のカードに書いてあるテキストを半分に減らして、読みやすくできないかと提案してきました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350110,
						230350111
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350110,
					"content": "そ、そんなことする必要あるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350112
					]
				},
				{
					"id": 230350112,
					"content": "私は全然問題ではないと思うのですが…学者たちはそれについて真剣に研究しています。何しろ、プレイヤーの体験に関わることなので、できるだけ問題を避けたいって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350113
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350113,
					"content": "はぁ、それより…今はもっと大きな問題があって——この前彼らがしてくれた、モデル探しを手伝ってくれるという約束にも問題が発生したんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350114
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350114,
					"content": "ティナリさんとセノさんに連絡を取って、モデルになってくれるよう手伝ってくれるって言って下さっている学者がいること、前に話しましたよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350115
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350115,
					"content": "でも、彼らはすごく忙しいから…しばらくは協力してもらえなさそうですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350116,
						230350117
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350116,
					"content": "じゃあ、どうするの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350118
					]
				},
				{
					"id": 230350118,
					"content": "私に協力してくれた学者にもこのことはどうしようもないのですが、一つアドバイスを頂けました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350119
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350119,
					"content": "セノさんは時々プスパカフェへカードゲームをプレイしに行くそうです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350120
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350120,
					"content": "だから…先にあのカフェに行って運を試してみたらと言われました。あるいは、彼らの時間が空くまで待って、その時また連絡を取ってくれるそうです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350121
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350121,
					"content": "じゃあ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350122
					]
				},
				{
					"id": 230350122,
					"content": "ええ…彼らの時間が空く頃には、私の小説も書き終えていなければならないでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350123
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350123,
					"content": "だから、やっぱり自分でセノさんを探してみます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350124
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350124,
					"content": "でも、たとえ運よくカフェでセノさんに会えたとしても、どう話しかけたらいいんでしょう。困りました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350128,
						230350129
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350128,
					"content": "役に立てるかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350130
					]
				},
				{
					"id": 230350130,
					"content": "本当ですか！？ぜひご助力ください！でも何故…いえ、余計なことは聞いたりしませんから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350131
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350131,
					"content": "それでは、さっそくプスパカフェに行きましょう。セノ様に会えるといいのですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "福本"
				},
				{
					"id": 230350129,
					"content": "セノをよく知ってる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350130
					]
				},
				{
					"id": 230350117,
					"content": "どうやって連絡を取るの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350118
					]
				},
				{
					"id": 230350111,
					"content": "そんなに長かったっけ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350112
					]
				},
				{
					"id": 230350103,
					"content": "小説がうまくいってないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350104
					]
				}
			]
		},
		{
			"id": 2303503,
			"completionStepIds": [
				2303503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
