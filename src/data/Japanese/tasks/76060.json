			"dialogs": [
				{
					"id": 760600301,
					"content": "うんうん、こんな感じかな。メイラ、おまえはどう思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760600302,
					"content": "～！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600303
					],
					"speakerTitle": "メイラ"
				},
				{
					"id": 760600303,
					"content": "この絵の具でよかったみたいだぞ。へへっ…今回はどんな絵になるだろうな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760600304,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600305
					],
					"speakerTitle": "メイラ"
				},
				{
					"id": 760600305,
					"content": "あれ？もうできたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760600306,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600307
					],
					"speakerTitle": "メイラ"
				},
				{
					"id": 760600307,
					"content": "なんか、ちょっと悲しそうだな。絵のせいか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760600308,
					"content": "あっ、今回もコロンビーナを描いたんだな。これは…月の光を浴びながら散歩してるのか？空を見上げてるみたいだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760600309,
					"content": "たぶん…偽りの空の外にある、あの月を見てるんだと思う。前はよく、こうやって夜に散歩してたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600310
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760600310,
					"content": "前？あっ…そういえば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760600311,
					"content": "（今のコロンビーナは、ほとんどこの庭から出れない…ナド・クライは彼女の生まれた場所なのに…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600312
					]
				},
				{
					"id": 760600312,
					"content": "散歩しながら、いつも考えてたの…あの本物の「霜月」の上には何があるんだろう？って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600313
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760600313,
					"content": "こっちみたいに、動物がたくさんいるのかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600314
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760600314,
					"content": "それとも、なんにもないのかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600315
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760600315,
					"content": "うーん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600316,
						760600319
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760600316,
					"content": "一緒に月に連れて行ってみる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600317
					]
				},
				{
					"id": 760600317,
					"content": "ふふっ、面白い考え方だね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600318
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760600318,
					"content": "でも…月は偽りの空の外にあるから…動物たちを危険な目に遭わせるわけにはいかないよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600322
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760600322,
					"content": "（片方は自由に行動できない「家」…もう片方は何があるのかさえわからない「家」…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600323
					]
				},
				{
					"id": 760600323,
					"content": "（……）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600324
					]
				},
				{
					"id": 760600324,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600325
					],
					"speakerTitle": "メイラ"
				},
				{
					"id": 760600325,
					"content": "メイラもコロンビーナと離れるのはイヤだよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600326
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760600326,
					"content": "私も離れたくない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600327
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760600327,
					"content": "でも、これは私だけの旅だから。自分で答えを探しにいかなきゃいけないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600328
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760600328,
					"content": "案外、素敵な答えかもしれないし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600329
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760600329,
					"content": "じゃ、じゃあその時になったら、メイラと一緒に会いに行くぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600330
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760600330,
					"content": "いいよ。月の上で展示会しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600331
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760600331,
					"content": "わぁ！それ、すっごくいいな！約束だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600332
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760600332,
					"content": "うん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600333
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760600333,
					"content": "できるといいね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760600319,
					"content": "ほかの生き物がいるかもよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600320
					]
				},
				{
					"id": 760600320,
					"content": "うん、そうだといいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600321
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760600321,
					"content": "突然帰ってきた「神」を、みんな歓迎してくれるといいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600322
					],
					"speakerTitle": "「少女」"
				}
			]
		},
