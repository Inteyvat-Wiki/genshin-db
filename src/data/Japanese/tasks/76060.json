			"dialogs": [
				{
					"id": 760600101,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600102
					],
					"speakerTitle": "メイラ"
				},
				{
					"id": 760600102,
					"content": "あれ？メイラじゃないか？またどこかに行ってきたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760600103,
					"content": "うん。帰ってきてからずっとこの調子で、何か考え込んでるみたいなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600104
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760600104,
					"content": "今回はちょっと深いテーマなのかもな。ついにこの世の真理に目覚めた画家——！みたいな感じか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760600105,
					"content": "メイラは今まで結構いろんな絵を描いてくれたよな。この調子で描き続けたら、展示会を開けるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760600106,
					"content": "そしたら、オイラが有名画家メイラの創作過程を解説するぞ！まあ、本当にやるなら、コロンビーナの許可がないといけないけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760600107,
					"content": "えっ？なんで？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600108
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760600108,
					"content": "#メイラはほとんど{M#君}{F#あなた}しか描いてないでしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600109
					]
				},
				{
					"id": 760600109,
					"content": "ああ…大丈夫、私は気にしないから。面白そうだし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600110
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760600110,
					"content": "～！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600111
					],
					"speakerTitle": "メイラ"
				},
				{
					"id": 760600111,
					"content": "おっ！メイラが何を描くか決めたみたいだぞ！ぴったりな絵の具がないか探してみてくれよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760600112,
					"content": "今回は…深くて、静かな色にしようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
