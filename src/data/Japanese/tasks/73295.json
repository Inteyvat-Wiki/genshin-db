			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"犬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732950601,
					"content": "おっ？あれ、ペッパーじゃないか？なにかを見守ってるみたいだぞ…待てよ、こういう光景…どこかで見たような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950602
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732950602,
					"content": "（こちらに気づいて、尻尾を振っている）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950603
					],
					"speakerTitle": "犬"
				},
				{
					"id": 732950603,
					"content": "あっ…あいつ、ジュリアンの絵を守ってるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732950604,
					"content": "ペッパーは短く吠えると、すぐその場を去った…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732950605
					]
				},
				{
					"id": 732950605,
					"content": "また逃げちゃったぞ。前回もそうだったよな…そういえば、ヒルチャールは絵を持っていって、いったいなにに使うんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950606,
						732950608
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732950606,
					"content": "ヒルチャールたちも絵を飾りたいのかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950607
					]
				},
				{
					"id": 732950607,
					"content": "う～ん…本当か…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732950608,
					"content": "まさか本当にトイレットペーパーに…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950609
					]
				},
				{
					"id": 732950609,
					"content": "#うえぇ…{NICKNAME}、汚い想像させるなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7329508,
			"completionStepIds": [
				7329508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7329508",
							"2"
						],
						"stepId": 7329508,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ジュリアン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732950801,
					"content": "やっぱりペッパーは戻ってたんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950802
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732950802,
					"content": "おーい、ジュリアン！絵を見つけてきたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950803
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732950803,
					"content": "あぁ…！二人ともありがとう…こんなくだらない物のために…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950804
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732950804,
					"content": "そんなこと言うなって。おまえはフォンテーヌの有名画家なんだろ？下書きだって結構な価値なんじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950805
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732950805,
					"content": "えーと、ま…まあね。あまり気にしたことはないよ。真の芸術と言うのは、価格で判断できるものじゃないからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950806
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732950806,
					"content": "さすが有名画家、言うこともなんか芸術的で哲学的だな！あ、そうだ。この絵を見つけたとき、ペッパーが傍で見守ってたんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950807
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732950807,
					"content": "前と一緒でね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950808
					]
				},
				{
					"id": 732950808,
					"content": "うんうん！きっとおまえのことを気にかけてるんだと思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950809
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732950809,
					"content": "長いこと面倒を見てくれた飼い主を迷い道に連れ込んだうえに、ヒルチャールの前で俺一人を残して逃げたやつのことを言ってるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950810
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732950810,
					"content": "うっ…き、きっとあいつなりの考えがあるのかもしれないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950811
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732950811,
					"content": "そうそう、ジュリアンは口ではそう言ってるけど、なんだかんだペッパーのこと好きだよな？そうでもなきゃ、特製の写真機でペッパーの写真を撮ってやったりしないだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950812
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732950812,
					"content": "写真？何の話だい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950813
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732950813,
					"content": "スケッチに挟んであった、ペッパーの写真だよ！色が独特だったから、フォンテーヌの特別な写真機かなんかで撮ったんじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950814
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732950814,
					"content": "あ…あれは俺が描いたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950815
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732950815,
					"content": "えっ？さ、さすが有名画家だな！本物そっくりだし、色使いも…すごく芸術的だぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950816
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732950816,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950817
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732950817,
					"content": "（オイラの褒め方、なんか変だったか？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950818,
						732950819
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732950818,
					"content": "#（聞かないで。{M#俺}{F#私}にも分からない。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950820
					]
				},
				{
					"id": 732950820,
					"content": "俺もあんな絵を描きたいだなんて思っていない…俺は…俺はただ一流の画家になりたかっただけだ。それがそんなに難しいことなのか？君たちもそう思うのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950821
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732950821,
					"content": "はぁ…すまない。友人である君たちには、嘘をつくべきじゃなかった。ひとたび嘘をつくと、さらに嘘に嘘を重ねることになる…もううんざりだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950822
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732950822,
					"content": "実は俺は、みんなのように正確に色を見分けることができないんだ。いわば、ただの二流画家だった。だけど…画家の夢を諦めたくなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950823
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732950823,
					"content": "それで…ある友人の力を借りて、本物そっくりの絵を描く能力を手に入れた。とはいえ、色を見分けられないという事実は変わらないけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950824
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732950824,
					"content": "ちょっと待て、「本物そっくりの絵を描く」能力なんて…訓練せずに身につくものなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950825
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732950825,
					"content": "そう、その友人は不思議な力の持ち主なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950826
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732950826,
					"content": "本当？信じられない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950827
					]
				},
				{
					"id": 732950827,
					"content": "むしろ、今の俺は本物そっくりにしか描けないんだ。能力を手に入れた対価なんだろう。常軌を逸した話に聞こえるかもしれないが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950828
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732950828,
					"content": "ジュリアンは即席で冒険家の経験を模写して見せた。\\n手にとって本物と比べてみても、全く見分けがつかない。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732950848
					]
				},
				{
					"id": 732950848,
					"content": "唯一違うところと言えば、写しの方は、読むと頭が空っぽになるような、奇妙な感じがした…\\n読んでも何も頭に入らず、無駄な時間を浪費しただけで、何の経験も得られなかった…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732950849
					]
				},
				{
					"id": 732950849,
					"content": "うーん…本物と見分けがつかないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950829
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732950829,
					"content": "ハハ、当然さ。有名画家にはなれなかったが、贋作を作る腕は一流だからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950830
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732950830,
					"content": "でも、それって違法なんじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950831
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732950831,
					"content": "…そう、だから服役を終了した後は、まともな方法で生計を立てて、正々堂々と画家になる決意をした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950832
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732950832,
					"content": "しかし、本物そっくりにしか描けないせいで…はぁ…これがキャタピラーのくれた能力じゃなかったら、俺はきっとこの能力を呪いと呼んでいただろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950833
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732950833,
					"content": "今の俺は壊れた写真機みたいだ。配色のおかしい「写真」しか撮れない写真機…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950834
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732950834,
					"content": "だから、純水精霊の巡礼の道を辿れば解毒薬が手に入るはずだと…健常者と同じように色が見分けられるようになって、純粋な子供のような素晴らしい想像力を授かれるんじゃないかと期待してたんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950835,
						732950837
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732950835,
					"content": "キャタピラーって？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950836
					]
				},
				{
					"id": 732950836,
					"content": "彼は俺の…信頼する友人さ。彼が俺に教えてくれたんだ。純水精霊の巡礼の道を辿ってスメールに着けば、万病を治し、新たな命を与えてくれる霊薬があるってな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950839
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732950839,
					"content": "…なんか怪しいぞ。おまえのその友人って一体なに者なんだ…おまえ、騙されたんじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950840
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732950840,
					"content": "博識で見識の広いやつなんだ。俺を騙すはずがない…きっと、俺自身の問題だ。さっきも言ったように、どうせ俺の人生は失敗の連続なのさ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950841
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732950841,
					"content": "きっと霊薬は厳重に保護されていて、俺みたいな俗人には到底手の届かない場所にあるに違いない。俺はもう…諦めた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950842
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732950842,
					"content": "犬だって、俺に連れてこられるのが嫌だったのかもしれないな。でなけりゃ、道中邪魔ばかりして、俺を怒らせたりしないだろう。フォンテーヌに置いてくればよかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950843
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732950843,
					"content": "うーん…きっとペッパーはおまえと一緒にいたがってると思うぞ。おまえが描いた絵だって、きっと気に入ってくれてる…だから、まだ諦めるなよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950844
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732950844,
					"content": "慰めてくれるのかい…ありがとう。でも俺はもう希望を捨てた。友よ、君たちには何度も助けてもらったのに、何もお返しできなくて本当にすまない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950845
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732950845,
					"content": "少し休んで身体が回復したら、フォンテーヌに帰るとするさ。その、本当に厚かましいお願いなんだけど…大通りまで案内してもらえないかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950846
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732950846,
					"content": "はぁ…もっと早く諦めて…くだらない意地なんか張っていなければ…今頃正しい道についてただろうに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950847
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732950847,
					"content": "もちろん道案内なら任せてくれ。おまえがそう決めたんなら…とりあえず今はゆっくり休めよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950850
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732950850,
					"content": "ああ、ありがとう、友よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732950837,
					"content": "巡礼の道？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950838
					]
				},
				{
					"id": 732950838,
					"content": "純水精霊が通る道だと、キャタピラーは教えてくれた。巡礼の道の果てはスメールに繋がっていて、そこに行けば万病を治し、新たな命を与えてくれる霊薬があるってな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950839
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732950819,
					"content": "（パイモンの理解の域を超えた芸術だね。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950820
					]
				}
			]
		},
