					"content": "まだ見つかってない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732951203
					]
				},
				{
					"id": 732951203,
					"content": "気にしないでくれ。どうせ…何の価値もないものだ…",
					"roleType": "TALK_ROLE_NPC",
