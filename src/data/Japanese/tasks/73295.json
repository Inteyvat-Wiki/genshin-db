			"dialogs": [
				{
					"id": 732950101,
					"content": "ペッパーにもちょっとやるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732950102,
					"content": "（期待に満ちた目でこちらを見つめている）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "犬"
				}
			]
		},
		{
			"id": 7329504,
			"completionStepIds": [
				7329504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7329504",
							"2"
						],
						"stepId": 7329504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ジュリアン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732950401,
					"content": "おい、大丈夫か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732950402,
					"content": "お…俺は…はぁ…助けてくれてありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950403
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732950403,
					"content": "昨日、素晴らしい夢を見たんだ。夢の中でキャタピラーが巡礼の道の果てに立って、俺に手を振っていた。夢ながら、俺は思ったんだ…巡礼の道だというのに、なぜ洞窟が延々と連なっているんだろうってね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950404
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732950404,
					"content": "でも、その細長い道の果てに立っているのは間違いなくキャタピラーじゃないか。俺は彼に向かって懸命に走り出した。しかしその途中、犬の鳴き声で目が覚めてしまった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950405
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732950405,
					"content": "犬に邪魔されたことはさておき…縁起の良い夢だったから、今日はきっと収穫があると思ってね、画材道具を持って出発したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950406
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732950406,
					"content": "そしたら…道に迷ってさんざん苦労した末に、ヒルチャールに襲われて…逃げ損ねた挙句、スケッチの入ったリュックまで落としてしまった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950407
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732950407,
					"content": "今日もあれこれ無くしまくった一日だったね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950408
					]
				},
				{
					"id": 732950408,
					"content": "俺のせいじゃないだろ？ここいらはフォンテーヌの下水道よりも入り組んでいるんだ…そうだ、スメール人は樹上生活をしていると聞いたんだが、ここはまさか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950409
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732950409,
					"content": "な！？スメール人は一体何を排泄してるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950410
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732950410,
					"content": "おい！多分おまえの想像とはぜんぜん違うぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950411
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732950411,
					"content": "はぁ…どうせ俺の人生は失敗だらけ…ハナっから失敗で始まった人生なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950412
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732950412,
					"content": "どうして今朝は安全な場所から離れてしまったんだろう？良い夢を見たと言ったって、所詮夢じゃないか。本気で信じるかよ、普通。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950413
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732950413,
					"content": "どうして昨日は君たちに困っているって素直に言えなかったんだろう…早めに君たちに道案内してもらっていれば、こんな目に遭わずに済んだのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950414
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732950414,
					"content": "そもそもどうしてフォンテーヌを離れてしまったんだ？フォンテーヌでの生活だって、そこまで苦しくはなかった…むしろ出てきてからのほうが、何一つうまくいってない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950415
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732950415,
					"content": "おい、そんなに落ち込むなよ。写生にいい場所なら、オイラたちが案内してやるからさ！でも、まずはおまえの落とし物を探しに行くべきじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950416
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732950416,
					"content": "ええと…全部見つかるかどうかは分からないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950417
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732950417,
					"content": "ふん、ヒルチャールのやつらがトイレットペーパーにでもしてるかもしれない。ど…どうせ高値が付くわけでもないし、うっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950418
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732950418,
					"content": "もっと素直になったほうがいい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950419
					]
				},
				{
					"id": 732950419,
					"content": "そうだぞ。高値で売れなくたって、おまえにとっては大切な物なんだろ？オイラたちが力を貸すぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950420
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732950420,
					"content": "…そう言えば、ペッパーはどこだ？おまえと一緒じゃなかったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950421
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732950421,
					"content": "ふん、恩知らずが…とっとと逃げてしまいやがった。今頃どこか安全な場所に隠れてのんびりしてるんじゃないかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950422
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732950422,
					"content": "そうなのか？なんか信じられないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950423
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732950423,
					"content": "うーん…じゃ、おまえは一旦キャンプに戻って休憩しながら、傷口の手当をしてろよ！オイラたちがおまえの物を見つけたら、またキャンプで合流しようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950424
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732950424,
					"content": "ありがとう…友よ。やはり頼りになってくれるのは友達だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジュリアン"
				}
			]
		},
		{
			"id": 7329506,
			"completionStepIds": [
				7329506
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
