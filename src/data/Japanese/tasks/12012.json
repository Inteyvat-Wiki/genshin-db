				},
				{
					"id": 120120802,
					"content": "とても待ち遠しそうにしてた。でも知ってるんだ、城内にいるあのいけ好かない男に会いに行くんだってことを…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120803
					],
					"speakerTitle": "聡"
				},
				{
