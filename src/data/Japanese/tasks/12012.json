			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"今谷香里",
					"今谷三郎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120120101,
					"content": "あら、宵宮ちゃん、いらっしゃい。どうぞ上がっていって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120102
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120102,
					"content": "お隣の方はお友達？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120103
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120103,
					"content": "そや、遠いとこからきた旅人や。他の国から今の稲妻に来るなんて大したやつやろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120104
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120104,
					"content": "そうだったの、今は大変な時代だもんね。稲妻人として恥をかかないよう、しっかりおもてなししてあげないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120105
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120105,
					"content": "せやな。それと、二人の花火持ってきたで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120106
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120106,
					"content": "おお、ありがとう。毎年世話になるね、昔はお父さんに、今は宵宮ちゃんに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120107
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120107,
					"content": "生きてるうちに、「長野原花火屋」の次期当主を見れるといいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120108
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120108,
					"content": "大丈夫やて、まだまだ元気やんか、縁起の悪いこと言わんといて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120109
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120109,
					"content": "ふふ、でももう昔ほど元気ってわけじゃないのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120110
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120110,
					"content": "昔は田植えをしたり、水を運んだりしても大丈夫だったのに、今は少し働いただけで腰が痛くなるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120111
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120111,
					"content": "昨日も雑草を抜こうとしたら、腰を痛めちゃってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120112
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120112,
					"content": "そうやったんか。ほな、うちが草刈りしたるで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120113
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120113,
					"content": "はは、大丈夫だよ。せっかく宵宮ちゃんが来たんだ、働かせるわけにはいかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120114
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120114,
					"content": "お茶と菓子を持ってくるから、ゆっくり話そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120115
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120115,
					"content": "気にせんといてよ、昔もよくお手伝いしとったやろ。最近は花火大会で忙しいけど、落ち着いたらまた来るさかい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120116
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120116,
					"content": "そうそう、オイラたちにとってこれくらい朝飯前だ、遠慮するなって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120120117,
					"content": "まあ、本当にいい子たちね、うちの子とは大違い。いい歳して結婚もせず、家にも帰って来ないのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120118
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120118,
					"content": "それじゃあ、お言葉に甘えて手伝ってもらおうかしら。それと草刈りの他にも、このダイコン漬けを村の向こうに住んでる聡さんのとこまで届けてくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120119
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120119,
					"content": "分かった、ほな行ってくるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120120
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120120,
					"content": "ついて来てくれるか、爺ちゃんも婆ちゃんも足が悪いんや。<color=#00E1FFFF>草刈り</color>したら、<color=#00E1FFFF>ダイコン漬け</color>を届けに行くで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宮"
				}
			]
		},
		{
			"id": 1201204,
			"completionStepIds": [
				1201204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201204",
							"2"
						],
						"stepId": 1201204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"聡"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120120401,
					"content": "聡おじちゃん、最近調子はどうや？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120402
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120402,
					"content": "ぼちぼちだよ、特に変わりはない。あんたも相変わらず元気そうで何よりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120403
					],
					"speakerTitle": "聡"
				},
				{
					"id": 120120403,
					"content": "みんなのおかげや、それに商売も順調でな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120404
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120404,
					"content": "こないだ璃月に卸した花火が大好評やったみたいで、注文が増える一方や。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120405
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120405,
					"content": "大変そうだな、龍之介さんと二人でやっていけるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120406
					],
					"speakerTitle": "聡"
				},
				{
					"id": 120120406,
					"content": "無理そうだったら俺に言ってくれよ、手伝いにいくから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120407
					],
					"speakerTitle": "聡"
				},
				{
					"id": 120120407,
					"content": "平気や、花火のことなら無理なことあらへん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120408
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120408,
					"content": "そうそう、これ香里婆ちゃんからのお届けもんや、ダイコン漬け。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120409
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120409,
					"content": "おお、ありがとう。昔はダイコン漬けが苦手だったんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120410
					],
					"speakerTitle": "聡"
				},
				{
					"id": 120120410,
					"content": "香里おばさんのを食べてから、その味を忘れられなくなっちゃってね。今ではすっかり家族全員この味の虜さ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120411
					],
					"speakerTitle": "聡"
				},
				{
					"id": 120120411,
					"content": "家族はみんな元気か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120412
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120412,
					"content": "ああ、みんな変わりないよ。たまに喧嘩もするが、家族ってそういうもんだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120413
					],
					"speakerTitle": "聡"
				},
				{
					"id": 120120413,
					"content": "そばにいてくれれば喧嘩したっていい。離れ離れになるよりましさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120414
					],
					"speakerTitle": "聡"
				},
				{
					"id": 120120414,
					"content": "今谷さんとこはおじさんもおばさんも仲がいいけど、子供が滅多に帰って来ないから、きっと寂しい思いをしてるだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120415
					],
					"speakerTitle": "聡"
				},
				{
					"id": 120120415,
					"content": "見た感じ平気そうやったで、もう慣れてもうたんやろな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120416
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120416,
					"content": "せやけど、おじちゃんが言うことにも一理あるな。これからはもっと遊びに行くようにするわ、話し相手がおったら寂しさも紛れるやろし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120417
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120417,
					"content": "ああ、紺田村のみんなも宵宮ちゃんが来るのを楽しみにしてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120418
					],
					"speakerTitle": "聡"
				},
				{
					"id": 120120418,
					"content": "へへっ、なんや照れるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宮"
				}
			]
		},
		{
			"id": 1201205,
			"completionStepIds": [
				1201205
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201205",
							"2"
						],
						"stepId": 1201205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"今谷香里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120120501,
					"content": "若い子はすごいね、こんなに早く終わらせちゃうなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120502
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120502,
					"content": "若者は体力があって、お年寄りは知識と経験が豊富、せやからどっちもどっちや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120503
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120503,
					"content": "そういえば、今年で夫婦生活も五十年目だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120504
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120504,
					"content": "ええ、一年一年、ただ前を向いて過ごしていたら、いつしか五十年も経ってたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120505
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120505,
					"content": "五十年？そんなに大事な日なのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120506
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120120506,
					"content": "ははは、五十年前、母さんが俺を追いかけてた頃が懐かしい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120507
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120507,
					"content": "もう何でたらめ言ってんのよ、あなたが私のことを追いかけてたんじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120508
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120508,
					"content": "はは、そうだったか。まあとにかく、五十年前の「長野原花火大会」で、俺は母さんに結婚を申し込んだんだ。そして、今こうして一緒に過ごしてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120509,
						120120510
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120509,
					"content": "おめでとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120511
					]
				},
				{
					"id": 120120511,
					"content": "本当は結婚を申し込む勇気がなくて、不安な気持ちのまま長野原に花火を頼んだんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120512
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120512,
					"content": "花火が打ち上げられた瞬間も、どんな言葉でこの気持ちを伝えたらいいのか分からなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120513
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120513,
					"content": "でも空に花火が咲いて、彼女の横顔を眺めていたら…その目に映る光がキラキラと綺麗で…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120514
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120514,
					"content": "気付いたら自然と言葉が出ていた。そして、幸いなことに俺の申し込みを受け入れてくれた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120515
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120515,
					"content": "この五十年、長いようで短かったわ、あっという間だったわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120516
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120516,
					"content": "共に歩んできたこの五十年、ちゃんとお祝いしないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120517
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120517,
					"content": "五十年の節目やって知ってたら、もっと豪華な花火を用意しとったのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120518
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120518,
					"content": "大丈夫よ、昔のままの花火で十分。毎年、花火大会で同じものを見てきたから、逆にそれじゃないと寂しいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120519
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120519,
					"content": "花火を見ると、あの日のことが蘇るの。こんなおばあちゃんになったけど、過去の自分の判断に一度も後悔なんてしたことない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120520
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120520,
					"content": "本当に仲がいいんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120521
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120120521,
					"content": "そうだ、俺たちのことはさておき、今は花火大会で忙しい時期だろう？何か用があったんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120522
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120522,
					"content": "あんな、実はちょっと言いづらいんやけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120523
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120523,
					"content": "朔次郎が…帰ってきたんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120524
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120524,
					"content": "えっ？知り合いやったん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120525
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120525,
					"content": "うちの子の…幼馴染なの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120526
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120526,
					"content": "小さい頃はいつも二人で遊んでたわ。お互い隠し事なんてないくらい仲良しで、一緒に色んな所へ行ってた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120527
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120527,
					"content": "だけどある日、すごい口喧嘩をしてね、それっきり…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120528
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120528,
					"content": "あの頃の朔次郎は外の世界に憧れていた。稲妻はあの子にとって、平穏過ぎたんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120529
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120529,
					"content": "けどうちの佳祐は、小さい頃から俺たちみたいな穏やかな暮らしに憧れてた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120530
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120530,
					"content": "子供というのは、ひょんなことから大喧嘩をする。朔次郎はたった一人でここを離れていったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120531
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120531,
					"content": "そうやったんか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120532
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120532,
					"content": "佳祐は何も言わないが、俺と母さんには分かる。あの子は悲しんでるんだ、それなのに本心を口に出来ず苦しんでる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120533
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120533,
					"content": "意地になってるのかもな。その後、佳祐は天領奉行に入り、滅多に帰ってこなくなった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120534
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120534,
					"content": "他のことなら、私たちが佳祐に頼めば助けてくれるとは思うけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120535
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120535,
					"content": "朔次郎のことになると…難しいだろうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120536
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120536,
					"content": "そんなぁ、こんな偶然ってあるか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120537
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120120537,
					"content": "そうやったんか。朔次郎に帰って来た理由を聞いても、「過ちを犯したから」としか言うてくれへんかったけど、そんな過去があったんやな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120538
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120538,
					"content": "あいつの決心がつかへん理由がやっと分かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120539
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120539,
					"content": "幼い頃は親友だったのに、今は天領奉行と、その天領奉行に追われる身になってるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120540,
						120120541
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120120540,
					"content": "これが運命ってやつかな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120542
					]
				},
				{
					"id": 120120542,
					"content": "分かった、それなら無理に頼んでも逆効果やろな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120543
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120543,
					"content": "朔次郎はうちらで何とかする、だから二人は気にせんといて。この件は、朔次郎と佳祐の二人で解決せなあかんと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120544
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120544,
					"content": "ええ、元通り仲良くなってくれるといいんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120545
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120545,
					"content": "もうこんなにも時間が経ってるんだ。過去の諍いもそろそろ水に流すべきだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120541,
					"content": "予想外過ぎる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120542
					]
				},
				{
					"id": 120120510,
					"content": "羨ましい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120511
					]
				}
			]
		},
		{
			"id": 1201206,
