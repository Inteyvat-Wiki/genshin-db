					"長野原龍之介"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120120601,
					"content": "宵宮、大変や、ついさっき天領奉行の人が大勢来よった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120602
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 120120602,
					"content": "えっ？なんでや、まさかバレてもうたん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120603
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120603,
					"content": "父ちゃん、平気やったか？何もされてない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120604
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120604,
					"content": "花火大会の準備で部屋中が火薬だらけやさかい、素人がいじくりまわしたら火事が起こるかもしれへんって言うたんやが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120605
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 120120605,
					"content": "ぜんぜん聞く耳もたんかった。朔次郎がきっと中におる言うて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120606
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 120120606,
					"content": "せやけど、朔次郎は事前に勘付いて窓から逃げとる。天領奉行に捕まらんで済んだわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120607
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 120120607,
					"content": "あちゃ～、まいったわ、朔次郎まだ決心できてへんはずやのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120608
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120608,
					"content": "父ちゃん、どこに逃げたか分かる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120609
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120609,
					"content": "このままやと天領奉行に捕まってまうで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120610
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120610,
					"content": "天領奉行の人の名前を聞かなかった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120611
					]
				},
				{
					"id": 120120611,
					"content": "せや、名前、名前！急にここに来るなんて、きっとあの佳祐って人や！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120612
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120612,
					"content": "やないと密入国で人を大勢寄こさへんやろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120613
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120613,
					"content": "いや、名前は分からへん、それに顔もよう覚えてへん。ただ、向かった先なら分かるで、城を出ていったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120614
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 120120614,
					"content": "名前は…うん、よう聞こえんくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120615
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 120120615,
					"content": "名前なら、聞こえたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120616
					],
					"speakerTitle": "森彦"
				},
				{
					"id": 120120616,
					"content": "さっき知り合いのとこから鉱石を持ってくる途中、ちょうど見たんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120617
					],
					"speakerTitle": "森彦"
				},
				{
					"id": 120120617,
					"content": "先頭にいた人は、佳祐って呼ばれてたと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120618
					],
					"speakerTitle": "森彦"
				},
				{
					"id": 120120618,
					"content": "やっぱそうやったか！おおきに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120619
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120619,
					"content": "朔次郎はまだ決心できてへん、このまま二人を会わせても問題が悪化するだけや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120620
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120620,
					"content": "#そないなったら取り返しがつかなってしまう。{NICKNAME}、一緒に来てくれへんか、道沿いに手がかりを探すで！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宮"
				}
			]
		},
