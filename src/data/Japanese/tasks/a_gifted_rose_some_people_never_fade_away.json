			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"サバーフ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732090101,
					"content": "お前たちか。ローズもわしらも待っておったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090102
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732090102,
					"content": "サバーフさんも着いてたのか。早いな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732090103,
					"content": "最近はよくここに来ているのです。シャフカットさんが残した手記を全部読みました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090104
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732090104,
					"content": "以前はアアル村での生活を寂しいものだと思っていましたが、今は違うように感じています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090105
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732090105,
					"content": "少なくとも私は一人ではなく、このローズたちと、貴方たち、それにアファンお爺さんと共にある記憶がありますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090106
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732090106,
					"content": "私の日常の中にもまだこのような美しい思いがあると思うと、それほど寂しくなくなりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090107
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732090107,
					"content": "これからは私も一緒にゴールデンローズの世話をするって、アファンお爺さんと約束したんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090108
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732090108,
					"content": "もっと咲かせて、苗畑一面を花畑にしたいです。だから今はまず、このいくつかを咲かせましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090109
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732090109,
					"content": "この前、どのようにして私のスメールローズを咲かせて下さったか、覚えていますか？同じ方法でお願いします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090110
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732090110,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732090111
					]
				},
				{
					"id": 732090111,
					"content": "ええ、頼みましたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "サバーフ"
				}
			]
		},
		{
			"id": 7320903,
