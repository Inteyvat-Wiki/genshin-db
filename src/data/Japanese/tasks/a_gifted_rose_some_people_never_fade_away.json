				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アファン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732090601,
					"content": "こいつらをうまく成長させられれば、これからはもっと多くのゴールデンローズを育てられるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090602
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732090602,
					"content": "まあ、まずはこのこいつらを咲かせてからじゃないと安心できんがな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アファン"
				}
			]
		},
		{
			"id": 7320907,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320908",
							"2"
						],
						"stepId": 7320908,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アファン",
					"サバーフ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732090701,
					"content": "わしはほぼ諦めかけていた。だが、結局この花は咲いてくれた。生きていれば不思議なことに出会えるもんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090702
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732090702,
					"content": "お嬢ちゃんは、まだシャフカットおじさんのことで落ち込んどるのか？もう悩まんでいい。死者の想いを受け継いで生きていくことこそ、最大の慰めになるもんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090703
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732090703,
					"content": "お爺さん…私はもう大人ですよ。幼馴染たちなんて、もしかすると子供たちがお店に香料を買いにいけるくらいの年になっているかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090704
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732090704,
					"content": "でも、確かにその通りですわ。生きている以上は、幸せに生きなければなりませんね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "サバーフ"
				}
			]
		}
	]
}