				"points": []
			},
			"dialogs": [
				{
					"id": 732090426,
					"content": "「ローズよローズ、叶えておくれ、私の願いを。」",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732090427
					]
				},
				{
					"id": 732090427,
					"content": "「花は石から咲き誇り、ゴールデンローズは私に歌う。」",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732090401
					]
				},
				{
					"id": 732090401,
					"content": "金色のローズって、やっぱりキレイだな。咲いてるところを見ると、気分もパッと明るくなるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732090402,
					"content": "ここ数日の苦労は無駄じゃなかった。嬉しいぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090403,
						732090404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732090403,
					"content": "願いがやっと叶ったね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732090405
					]
				},
				{
					"id": 732090405,
					"content": "最後に、わしもいいことが一つできた。シャフカットおじさん、あなたの願いはわしが叶えてやったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090406
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732090406,
					"content": "彼に見てもらえなくて、残念でしたね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090407
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732090407,
					"content": "サバーフ、それは違う。ローズの歌の最後のくだりを覚えておるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090408
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732090408,
					"content": "「私を支える土はない。歌だけが支えてくれる。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090409
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732090409,
					"content": "「歌は牙を剥く運命に勝ち、私の結末に勝ち——」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090410
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732090410,
					"content": "「私に勝ち、私の時間に勝ち、永遠に止まぬ消失に勝つだろう。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090411
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732090411,
					"content": "シャフカットおじさんの人生も、ゴールデンローズも、彼が作ったこの歌も…こうしてわしらの中に残った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090412
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732090412,
					"content": "ええ、そうですね。彼は消失に勝った人です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090413
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732090413,
					"content": "シャフカットさんのお話を教えてくれてありがとうございます。これは私にとって、とても大事なことです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090414
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732090414,
					"content": "彼は私よりも前にいた追放者です。彼の生活の痕跡を見ると、まるで自分が時空を超えたような気がして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090415
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732090415,
					"content": "シャフカットさんのことだけではなく、自分のことも見ているような感じがするのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090416
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732090416,
					"content": "彼と何かを話すことはできませんが、彼の心残りとともに生きていくことはできます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090417
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732090417,
					"content": "彼の分も頑張って生きていくことで、最終的には私も救われるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090418,
						732090419
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732090418,
					"content": "幸せを祈ってる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732090420
					]
				},
				{
					"id": 732090420,
					"content": "貴方たちと出会えて本当に良かったです。ここでの生活も悪くないと感じられるようになりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090421
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732090421,
					"content": "ローズはやはり、幸せをもたらしてくれる花ですね。アファンお爺さん、これからはもっと頑張って、さらにたくさんのローズを育てましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090422
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732090422,
					"content": "ははは、じゃあ、約束だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090423
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732090423,
					"content": "ええ、頑張りますわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732090419,
					"content": "諦めないでね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732090420
					]
				},
				{
					"id": 732090404,
					"content": "すべては報われた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732090405
					]
				}
			]
		},
