			"dialogs": [
				{
					"id": 732090301,
					"content": "「ローズよローズ、叶えておくれ、私の願いを。」",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732090302
					]
				},
				{
					"id": 732090302,
					"content": "「花は石から咲き誇り、ゴールデンローズは私に歌う。」",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7320904,
			"completionStepIds": [
				7320903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
