					"nextDialogs": [
						80120602
					],
					"speakerTitle": "カリベルト"
				},
				{
					"id": 80120602,
					"content": "カリベルト！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120603
					],
					"speakerTitle": "エデ"
				},
				{
					"id": 80120603,
					"content": "見つけた！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120604
					]
				},
				{
					"id": 80120604,
					"content": "カリベルト、止まってくれ！私だ、パパだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120605
					],
					"speakerTitle": "エデ"
				},
				{
					"id": 80120605,
					"content": "もし何か見ていたとしても、それは…それはすべて幻覚で、どれも嘘っぱちだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120606
					],
					"speakerTitle": "エデ"
				},
				{
					"id": 80120606,
					"content": "パパが言っただろ？ここは童話の世界だと。本当のことではない。ほら、私のところに来るんだ、一緒に戻ろう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120607
					],
					"speakerTitle": "エデ"
				},
				{
					"id": 80120607,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120608
					],
					"speakerTitle": "カリベルト"
				},
				{
					"id": 80120608,
					"content": "カリベルト？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120609,
						80120610
					],
					"speakerTitle": "エデ"
				},
				{
					"id": 80120609,
					"content": "反応がない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120611
					]
				},
				{
					"id": 80120611,
					"content": "どういうことだ、あの子は知性を取り戻したというのに…私の話を理解できているはずだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120612
					],
					"speakerTitle": "エデ"
				},
				{
					"id": 80120612,
					"content": "さあ、カリベルト、一緒にお家に帰ろう。…一緒に帰ってくれるな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120613,
						80120614
					],
					"speakerTitle": "エデ"
				},
				{
					"id": 80120613,
					"content": "待って、様子が少しおかしい気がする…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120615
					]
				},
				{
					"id": 80120615,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カリベルト"
				},
				{
					"id": 80120614,
					"content": "まさか、あの力の影響を受けてる…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120615
					]
				},
				{
					"id": 80120610,
					"content": "最初に会った頃と同じだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120611
					]
				}
			]
		},
