			},
			"dialogs": [
				{
					"id": 80120202,
					"content": "どういうことだ！カリベルトはどこに行った！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120203,
						80120204
					],
					"speakerTitle": "エデ"
				},
				{
					"id": 80120203,
					"content": "部屋にはいない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120205
					]
				},
				{
					"id": 80120205,
					"content": "嘘だ、カリベルト…まさか誰かがここに来たのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120206
					],
					"speakerTitle": "エデ"
				},
				{
					"id": 80120206,
					"content": "いや、ドアは破壊されていないし、周りに誰かがいた痕跡もない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120207,
						80120208
					],
					"speakerTitle": "エデ"
				},
				{
					"id": 80120207,
					"content": "自分で出ていった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120209
					]
				},
				{
					"id": 80120209,
					"content": "まずい、カリベルトの今の姿でレンジャーや冒険者に遭遇したら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120210,
						80120211
					],
					"speakerTitle": "エデ"
				},
				{
					"id": 80120210,
					"content": "まずは何とかしてあの子を探そう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120212
					]
				},
				{
					"id": 80120212,
					"content": "待て…誰かが物を動かした形跡がある…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120213
					],
					"speakerTitle": "エデ"
				},
				{
					"id": 80120213,
					"content": "まさか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120214
					],
					"speakerTitle": "エデ"
				},
				{
					"id": 80120214,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120215
					],
					"speakerTitle": "エデ"
				},
				{
					"id": 80120215,
					"content": "鏡が…割れている…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120216
					],
					"speakerTitle": "エデ"
				},
				{
					"id": 80120216,
					"content": "（鏡？あの鏡…前から割れていたはずだけど…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120217
					]
				},
				{
					"id": 80120217,
					"content": "鏡が割れていることにどんな意味が？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120218
					]
				},
				{
					"id": 80120218,
					"content": "おそらく、あの子は仮面を外したんだろう…仮面の下に隠されていた自分の顔を見てしまったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120219
					],
					"speakerTitle": "エデ"
				},
				{
					"id": 80120219,
					"content": "なんということだ、親の教えを守らないとは…急いであの子を追うぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エデ"
				},
				{
					"id": 80120211,
					"content": "ここであれこれ考えてる暇はない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120212
					]
				},
				{
					"id": 80120208,
					"content": "どうして、こんな急に…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120209
					]
				},
				{
					"id": 80120204,
					"content": "もしかして…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120205
					]
				}
			]
		},
