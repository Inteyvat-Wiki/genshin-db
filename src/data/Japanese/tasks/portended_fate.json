			"dialogs": [
				{
					"id": 80120101,
					"content": "どうなっている…ありえん、こんなのありえん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120102,
						80120103
					],
					"speakerTitle": "エデ"
				},
				{
					"id": 80120102,
					"content": "消えた…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120104
					]
				},
				{
					"id": 80120104,
					"content": "ひれ伏していたヒルチャールもいなくなっている…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120105
					],
					"speakerTitle": "エデ"
				},
				{
					"id": 80120105,
					"content": "前に見たのは、すべて幻覚だったというのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120106,
						80120107
					],
					"speakerTitle": "エデ"
				},
				{
					"id": 80120106,
					"content": "その可能性は低い…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120108
					]
				},
				{
					"id": 80120108,
					"content": "確かに…あれが幻覚のはずない。あの偉大で神秘的な力はまだ私の頭の中で、この体の中で響いている…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120109
					],
					"speakerTitle": "エデ"
				},
				{
					"id": 80120109,
					"content": "幻覚でも、偶然でもなく、ましてや夢でもない。あれは確かに存在する「神秘」だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120110
					],
					"speakerTitle": "エデ"
				},
				{
					"id": 80120110,
					"content": "…行こう、旅人。「あれ」が消失したのには、必ず意味があるはずだ…いつの日か再びこの目にする機会があると、私は信じている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120111,
						80120112
					],
					"speakerTitle": "エデ"
				},
				{
					"id": 80120111,
					"content": "本当に頑固な人だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120113
					]
				},
				{
					"id": 80120113,
					"content": "神ではなく…「罪人」か…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エデ"
				},
				{
					"id": 80120112,
					"content": "ひとまず戻ろう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120113
					]
				},
				{
					"id": 80120107,
					"content": "二人とも同時に幻覚を見たとは考えにくい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120108
					]
				},
				{
					"id": 80120103,
					"content": "ここで間違いないはず…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120104
					]
				}
			]
		},
		{
			"id": 801202,
