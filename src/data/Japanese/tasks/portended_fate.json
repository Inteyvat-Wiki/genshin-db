			},
			"dialogs": [
				{
					"id": 80120401,
					"content": "レンジャーだ…まずい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120402
					],
					"speakerTitle": "エデ"
				},
				{
					"id": 80120402,
					"content": "そこの人、見ない顔ね。ここでいったい何をしているの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120403
					],
					"speakerTitle": "レンジャー"
				},
				{
					"id": 80120403,
					"content": "貴様ら、ヒルチャールを見なかったか？こっちにヒルチャールが来たはずだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120404
					],
					"speakerTitle": "エデ"
				},
				{
					"id": 80120404,
					"content": "先に私の質問に答えてもらいましょうか…面倒事に発展させたくなければね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120405
					],
					"speakerTitle": "レンジャー"
				},
				{
					"id": 80120405,
					"content": "こちらが聞いているのだ！ヒルチャールを！見なかったか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120406
					],
					"speakerTitle": "エデ"
				},
				{
					"id": 80120406,
					"content": "エデ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120407
					]
				},
				{
					"id": 80120407,
					"content": "あなた…いったいどうしたのよ。そこまでムキになることないじゃない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120408
					],
					"speakerTitle": "レンジャー"
				},
				{
					"id": 80120408,
					"content": "ヒルチャールなんてどこにもいるでしょう？もちろん見たわよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120409
					],
					"speakerTitle": "レンジャー"
				},
				{
					"id": 80120409,
					"content": "ああ、ついさっきあっちで何体か倒したぞ。ぼーっとしてたやつをな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120410
					],
					"speakerTitle": "レンジャーガード"
				},
				{
					"id": 80120410,
					"content": "貴様ら…貴様らぁぁッ…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120411
					],
					"speakerTitle": "エデ"
				},
				{
					"id": 80120411,
					"content": "おのれレンジャー！おのれ七神の民めッ！カリベルトの死を、その命で償え！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120412
					],
					"speakerTitle": "エデ"
				},
				{
					"id": 80120412,
					"content": "あなた…！外国人がそんな暴言を吐いて、私たちレンジャーを挑発してるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120501
					],
					"speakerTitle": "レンジャー"
				},
				{
					"id": 80120501,
					"content": "レンジャーめ…よくも貴様ら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120502,
						80120503
					],
					"speakerTitle": "エデ"
				},
				{
					"id": 80120502,
					"content": "いい加減にして、エデ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120515
					]
				},
				{
					"id": 80120503,
					"content": "でないとレンジャーと一緒に取り押さえる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120515
					]
				},
				{
					"id": 80120515,
					"content": "あなたの忠告により、両者は一旦落ち着いた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						80120505
					]
				},
				{
					"id": 80120505,
					"content": "まったく意味が分からない。ヒルチャールを数体片付けただけで、そうも怒る必要ないだろう…なんて理不尽なんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120506
					],
					"speakerTitle": "レンジャーガード"
				},
				{
					"id": 80120506,
					"content": "貴様ら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120507
					],
					"speakerTitle": "エデ"
				},
				{
					"id": 80120507,
					"content": "あの子は知性を取り戻したばかりだというのに、どうしてこんな目に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120508
					],
					"speakerTitle": "エデ"
				},
				{
					"id": 80120508,
					"content": "レンジャーよ…本当に、本当に少しも加減しなかったのか？見かけたヒルチャールをすべて倒したと…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120509
					],
					"speakerTitle": "エデ"
				},
				{
					"id": 80120509,
					"content": "そうだよ、訳の分からないやつだな。まあ、しいて言うなら、俺がチームを離れて、その…用を足してた時、たまたま出くわしたヒルチャールがいて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120510
					],
					"speakerTitle": "レンジャーガード"
				},
				{
					"id": 80120510,
					"content": "最初は俺も身構えたんだが、そいつには特に敵意がなかった。ただぼーっとしてて…あっちのほうに行ったから、ほっといてやったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120511
					],
					"speakerTitle": "レンジャーガード"
				},
				{
					"id": 80120511,
					"content": "まだ希望はある！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120513
					]
				},
				{
					"id": 80120512,
					"content": "カリベルトだった可能性が高い！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120513
					]
				},
				{
					"id": 80120513,
					"content": "そうだな、よかった…本当によかった…急ぐぞ、あの子を探しに行こう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120514
					],
					"speakerTitle": "エデ"
				},
				{
					"id": 80120514,
					"content": "ちょっと、このまま何もなしに行くの？まったく、身勝手な人たちね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "レンジャー"
				}
			]
		},
