			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ダインスレイヴ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80120801,
					"content": "…目が覚めた。よかった、やっと目を覚ましたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120802
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80120802,
					"content": "本当に心配したんだからな…あれ、旅人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120803
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80120803,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120804
					]
				},
				{
					"id": 80120804,
					"content": "気を失っている間、何があった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120805
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80120805,
					"content": "俺が付近の地脈を調べたところ、アビスの力の影響により乱れがずっと生じていたようだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120806
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80120806,
					"content": "地脈にはこの世の情報と記憶が流れている。もしや貴様、何かを見たのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120807,
						80120808
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80120807,
					"content": "アビス教団を創立したアルベリヒ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120809
					]
				},
				{
					"id": 80120809,
					"content": "コロタール·アルベリヒのことか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120810
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80120810,
					"content": "やつはアビス教団を創立した後、アビスへの「信仰」から様々なことを為した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120811
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80120811,
					"content": "だが、不死の呪いは最後までやつの肉体と精神を蝕んだ。やつの信仰するアビスが救済を与えることもなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120812
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80120812,
					"content": "そして百年後、やつは完全に正気を失うと姿をくらました。それ以降、やつは二度と姿を見せていない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120813
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80120813,
					"content": "しかし、確かにやつはその手で数々の厄介事を残していった。たとえば貴様たちが目にしたあの「穢れた逆さ神像」も、やつが当時、アビスの力を利用して作った未知の産物だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120814,
						80120815
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80120814,
					"content": "でも結局…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120816
					]
				},
				{
					"id": 80120816,
					"content": "#そう言っていいだろう。でなければ、{M#彼女}{F#彼}がアビス教団の{M#姫}{F#王子}になっているはずがない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120817
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80120817,
					"content": "旅人…大丈夫か？その顔…いったいなにがあったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120818
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80120818,
					"content": "ある物語を…聞いてほしい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120819
					]
				},
				{
					"id": 80120819,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120820
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80120820,
					"content": "あなたの物語を聞いて、ダインスレイヴは深く考え込んだ…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						80120821
					]
				},
				{
					"id": 80120821,
					"content": "#貴様の視点から、数百年前の{M#彼女}{F#彼}の記憶を見るとは…実に奇妙なことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120822
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80120822,
					"content": "やはり「運命の織機」という概念は、あの時代に生まれたものだったか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120823
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80120823,
					"content": "しかも、コロタールの息子であるカリベルトの当時の状態が、それに関係していた可能性が高いようだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120824
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80120824,
					"content": "#ただ、この話を貴様の血縁者から聞いたことは一度もない…つまりその頃から、{M#彼女}{F#彼}は既にこの道を歩むことを決意していたというわけか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120825,
						80120826
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80120825,
					"content": "#{M#俺}{F#私}もすごく知りたい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120827,
						80120828
					]
				},
				{
					"id": 80120827,
					"content": "でも、これだけは言える…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120829
					]
				},
				{
					"id": 80120829,
					"content": "ああ、あいつもきっと長いこと一人で考えていたんだろう。いわば…このことがすべての「始まり」と言っても過言ではないのかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120830,
						80120831
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80120830,
					"content": "そうだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120832
					]
				},
				{
					"id": 80120832,
					"content": "なんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120833
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80120833,
					"content": "ここの畑に何が埋まっているのかを。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120834
					]
				},
				{
					"id": 80120834,
					"content": "畑？急にそんなこと気にしてどうしたんだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120835
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80120835,
					"content": "…ここにか？ならば、掘り返してみるとしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120836
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80120836,
					"content": "少し時間をかけて、ダインと一緒に畑に埋まっていたものを確認した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						80120837
					]
				},
				{
					"id": 80120837,
					"content": "…うぅ、本当に怖かったぞ。おまえら、も…もう埋めなおしたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120838
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80120838,
					"content": "埋めたから目を開けていいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120839
					]
				},
				{
					"id": 80120839,
					"content": "男と女の遺骨が一人ずつ、同じ場所に埋められているとは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120840
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80120840,
					"content": "気になるのは、男の遺骨の埋葬された時期が明らかに女よりも遅い点だ。そして、男の手にはスカーフが一つ握られていた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120841
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80120841,
					"content": "これは何を意味している？貴様はなぜ、この下に遺骨があると知っていた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120842,
						80120843
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80120842,
					"content": "たぶん、この男性の遺骨は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120844
					]
				},
				{
					"id": 80120844,
					"content": "何だと？ありえん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120845
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80120845,
					"content": "こんなこと…コロタール·アルベリヒが最終的に不死の呪いを解かない限り考えられないことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120846
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80120846,
					"content": "おそらく、そういうことなんだと思う…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120847
					]
				},
				{
					"id": 80120847,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120848
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80120848,
					"content": "あらゆる情報が錯綜している。整理するには時間が必要だろう。それにもう一度、俺の記憶から何か見つけられないか骨を折る必要があるな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120849
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80120849,
					"content": "ここで別れるとしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120850
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80120850,
					"content": "えっ、またどっか行っちゃうのか？オイラたちと一緒にいてもいいんだぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120851
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80120851,
					"content": "しばらくは別行動をしたほうがいい。なぜなら…「やつ」がもう貴様のことを見たかもしれん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120852
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80120852,
					"content": "「やつ」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120853,
						80120854
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80120853,
					"content": "それって、まさか…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120855
					]
				},
				{
					"id": 80120855,
					"content": "ああ、やつの正体は大方予想できている…これもまた、手がかりを繋ぐことで確認しなければならないことの一つだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120856
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80120856,
					"content": "機が熟したら、次に会う時に貴様に教えよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120857
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80120857,
					"content": "ところで、その「やつ」が旅人のことを見たかもしれないって言ったけど、どうやって「見た」んだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120858,
						80120859
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80120858,
					"content": "あれはあくまでも記憶の中の出来事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120860
					]
				},
				{
					"id": 80120860,
					"content": "もしあいつなら…そういったことはおそらく、やつを制限する要素にならないはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120861
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80120861,
					"content": "そいつって…いったい、なにもんなんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120862
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80120862,
					"content": "「罪人」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120863
					]
				},
				{
					"id": 80120863,
					"content": "さあ、話はここまでにしよう。貴様の心には休息が必要なはずだ。またいずれ会おう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120864
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80120864,
					"content": "ダインのやつまた行っちゃったな。これでまたオイラたち二人だけになっちゃったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120865
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80120865,
					"content": "そういえばパイモン。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120866
					]
				},
				{
					"id": 80120866,
					"content": "ん？どうかしたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120867
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80120867,
					"content": "すごく恋しかった。",
