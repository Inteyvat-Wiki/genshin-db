							"7050404",
							"2"
						],
						"stepId": 7050404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ロサリア",
					"ガイア"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705040201,
					"content": "あっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040202
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 705040202,
					"content": "どうした、ロサリアの口に合わなかったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705040203,
					"content": "作り直すこともできるけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705040204
					]
				},
				{
					"id": 705040204,
					"content": "大丈夫、君の腕に問題はないわ。ただ、これを飲んでちょっとしたことを思い出しただけよ。お茶を口にする機会ってあまりないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040205
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 705040205,
					"content": "教会に関することか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040206
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 705040206,
					"content": "ええ。前に教会で行事があってね…私は参加しなかったんだけど、バーバラが私の分のお茶とお菓子を残しておいてくれたのよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040207
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 705040207,
					"content": "だけど、お菓子は長いこと置いておくと味が落ちてしまうでしょ。だからいつの間にか片付けられてしまって、残されたお茶だけをいただいたの。そのとき飲んだお茶と同じ味だと思って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040208
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 705040208,
					"content": "ロサリアがこんな表情をするなんて…珍しいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705040209,
					"content": "どうやらモンドに、紅茶愛好家が一人増えたみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040210
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 705040210,
					"content": "あら、それならお酒のほうがいいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040211
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 705040211,
					"content": "ガイアはどう？満足した？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705040212
					]
				},
				{
					"id": 705040212,
					"content": "俺が良くないところを指摘したら、お前は作り直してくれるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040213
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 705040213,
					"content": "ハハハッ、冗談だ。俺がお前に嫌われるようなことをするはずがないだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040214
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 705040214,
					"content": "ったく、ガイアはいっつも話が脱線するよな！よくこんなやつとお酒が飲めるな、ロサリアは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040215
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705040215,
					"content": "そう？私は彼のこういうところを気にしたことないけど。それに飲む時は、いつもお酒の話ばかりだし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040216
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 705040216,
					"content": "それに彼は興味を持った人や物…そう、たとえば君やここのオーナーみたいな人にしか、ちょっかいを出さないもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040217
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 705040217,
					"content": "おいおい、俺たち酒を飲む仲間だろう？そうあっさりと裏切らないでくれよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040218
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 705040218,
					"content": "あら、これが裏切り？別に君は気にしていないでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040219
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 705040219,
					"content": "時折思うの、私の周りには「堅い人」が多すぎるってね。みんながのんびりと過ごしている酒場のほうが、私には合っているわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040220
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 705040220,
					"content": "ん？なんだ、今度は堅いヤツへの愚痴か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040221
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 705040221,
					"content": "そういうことなら、俺の知ってる誰かさんが「モンドの堅物ランキング」トップスリーに入ると思うぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040222
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 705040222,
					"content": "どれくらい堅物かと言うと…そうだな、面と向かってそれを指摘しても眉一つ動かさないくらいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040223
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 705040223,
					"content": "そんなランキングあるのかよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040224
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705040224,
					"content": "ああ。それに…連続飲酒日数ランキング、最長労働時間ランキング、暗黒料理人ランキング、禁忌とされる知識量ランキングとかもあるぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040225
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 705040225,
					"content": "モンド人、ヒマすぎだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040226
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705040226,
					"content": "そんなにヒマを持て余してる人なんて、そういるのかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040227,
						705040228
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 705040227,
					"content": "いや…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705040229
					]
				},
				{
					"id": 705040229,
					"content": "なあ！だったら、オイラとこいつが一緒に入りそうなランキングはないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040230
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705040230,
					"content": "ああ、あるぞ。「ベストバーテンダー」とかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040231
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 705040231,
					"content": "ほ、ほんとか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040232
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705040232,
					"content": "やった！オイラたちの名前もこれで残せるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040233
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705040233,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040234
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 705040234,
					"content": "ふふっ、こういう雰囲気も悪くないわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040235
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 705040235,
					"content": "そうだな。こいつらを見ているだけで飽きない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040236
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 705040236,
					"content": "こんな風に、人に伝染する雰囲気を持っているというのは、酒場のバーテンダーにとって大事なことだ。どうやら…「ベストバーテンダー」の称号をこいつらにやったのも、間違いじゃないみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040237
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 705040237,
					"content": "ん？どうしたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040238
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705040238,
					"content": "いや、なんでもない。今日は美味かったぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040239
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 705040239,
					"content": "それじゃ、私もそろそろ失礼するわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040240
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 705040240,
					"content": "ああ、そうだ。紅茶、美味しかったわ。あとで自分でも淹れてみようかしら…もし朝起きれたらだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040241
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 705040241,
					"content": "それじゃあな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040242
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 705040242,
					"content": "また今度。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 705040228,
					"content": "誰のことか大体分かる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705040229
					]
				}
			]
		}
	]
}