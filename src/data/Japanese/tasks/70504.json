				"points": []
			},
			"dialogs": [
				{
					"id": 705040101,
					"content": "ほう…お前がバーテンダーとは珍しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040102
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 705040102,
					"content": "それじゃあ、午後{RUBY#[D]デス·イン…}の…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040103
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 705040103,
					"content": "さっそく人を困らせるなんて、さすがね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040104
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 705040104,
					"content": "ははっ、こいつがどう対応するか見てみたかっただけさ。それより、ロサリアも飲みに来ていたとは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040105
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 705040105,
					"content": "旅人、酒場には厄介な客が多い。今のうちに経験を積んでおいて損はないと思うぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040106
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 705040106,
					"content": "へぇ、ガイアは相変わらずよく口が回るよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705040107,
					"content": "おっと、勘違いしないでくれよ。俺はお前のためを思って言ってるんだ。むしろ、感謝してくれてもいいんだぜ？たとえば簡単なものを一杯…ムーンリットアレイを作ってくれるとかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040108
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 705040108,
					"content": "ああ、もちろん、ラージサイズで頼む。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040109
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 705040109,
					"content": "私は、お茶の香りを味わえるものならなんでもいいわ。サイズは普通でお願い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040110
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 705040110,
					"content": "分かった、少し待ってて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705040111
					]
				},
				{
					"id": 705040111,
					"content": "ゆっくりでいい。美味いものが出来上がるのを待つ時間も、興奮させてくれるもんだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ガイア"
				}
			]
		},
		{
			"id": 7050402,
			"completionStepIds": [
				7050404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
