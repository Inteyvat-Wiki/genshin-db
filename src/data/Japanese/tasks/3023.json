					"アルハイゼン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30230201,
					"content": "急ぐ必要はない。これだけの大事、すぐに準備することなど不可能だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230202
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30230202,
					"content": "ゆっくりと考え、計画の合理性を保証しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230203
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30230203,
					"content": "そう言ってまた本を読み始めたぞ…おいっ！おまえってやつは！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30230204,
					"content": "本を貸そうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230205
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30230205,
					"content": "いらないぞ、おまえの本はオイラには合わない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30230206,
					"content": "冗談だ。確かに俺の本は君と不釣り合いだ、貸す気はない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230207
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30230207,
					"content": "ああもう——！あったまきたぞ…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 302303,
