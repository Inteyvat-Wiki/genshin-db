				"objectNames": [
					"キャンディス"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30230301,
					"content": "何か私にできることがあれば、必ず言ってくださいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230302
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 30230302,
					"content": "アアル村を離れることはできませんが、あなたたちを見ていると、何だか…私まで緊張してきます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230303
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 30230303,
					"content": "昔、たった一人で戦ったときでさえ、このような湧き立つ感情はありませんでした…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230304
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 30230304,
					"content": "これが、仲間の力というものなのですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キャンディス"
				}
			]
		},
