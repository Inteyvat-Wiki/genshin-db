			"dialogs": [
				{
					"id": 30230401,
					"content": "最近の仕事は厄介なもんばっかだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230402
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 30230402,
					"content": "それに、こんなに難しい仕事なのに、ちっとも経済的利益を生まないなんて…信じられないぜ、まったく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230403
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 30230403,
					"content": "いい方向に考えろよ。もしかしたら、事が終わったらお金持ちになれるかもだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30230404,
					"content": "それもそうだな。ふむ…もし一晩で億万長者になれたら、おまえは何がしたい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230405
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 30230405,
					"content": "美味しい食べ物をたっくさん買うぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30230406,
					"content": "それだけか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230407
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 30230407,
					"content": "えっと…美味しい飲み物も買うとか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30230408,
					"content": "ハハハッ、かわいいじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230409
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 30230409,
					"content": "なら、その美しい夢のために…あたしも手伝おう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230410
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 30230410,
					"content": "あたしたちがこれからやることが、この世界を良くできると願ってるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ディシア"
				}
			]
		}
