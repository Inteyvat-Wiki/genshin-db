			"dialogs": [
				{
					"id": 400040201,
					"content": "#{NICKNAME}、おぉ、久し振りだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040202
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 400040202,
					"content": "ガイア、璃月の海灯祭に行ってきたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400040203,
					"content": "ほぉ、海灯祭か、面白かったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040204
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 400040204,
					"content": "美味しかった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400040205,
					"content": "ならモンドのバドルドー祭も楽しみにしてるといいぜ。きっと失望はさせない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040206
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 400040206,
					"content": "本題に入ろう、パイモン。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040207
					]
				},
				{
					"id": 400040207,
					"content": "あっ、そうだった。ガイア、実はな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400040208,
					"content": "ふむ…提灯を作るための木、紙、油…どう考えても危険だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040209
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 400040209,
					"content": "フフッ、面白い。なぜ俺ならこの暗号が分かると思ったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040210,
						400040215
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 400040210,
					"content": "万能だし信用できるから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040211
					]
				},
				{
					"id": 400040211,
					"content": "そうだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400040212,
					"content": "ハハハッ、褒めすぎだ。俺はそこまですごくないぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040213
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 400040213,
					"content": "出た！「謙虚」という名の騎士の品格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400040214,
					"content": "ハハッ、璃月で口がうまくなったようだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040220
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 400040220,
					"content": "本題に戻ろう。これは国際犯罪組織「宝盗団」の暗号だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040221
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 400040221,
					"content": "興味があるなら、情報提供者との面会を手配するぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040222
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 400040222,
					"content": "西風騎士団は悪人と取引しないんじゃ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040223
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400040223,
					"content": "——これは俺個人の情報屋であり、西風騎士団のではない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040224
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 400040224,
					"content": "夜に風立ちの地へ行け。俺が情報屋を手配しておこう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040225
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 400040225,
					"content": "ありがとう、ガイア。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040226
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400040226,
					"content": "「酒に真の知識あり」、覚えておけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040227
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 400040227,
					"content": "ん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400040215,
					"content": "裏社会でも顔が利くし、頼りになる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040216
					]
				},
				{
					"id": 400040216,
					"content": "その通り！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040217
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400040217,
					"content": "お前、栄誉騎士として言葉は慎重に選んだ方がいいぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040218
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 400040218,
					"content": "裏社会とはなんのことやら。西風騎士団は悪人なんかと取引しないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040219
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 400040219,
					"content": "これは「誠実」という名の騎士の品格だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040220
					],
					"speakerTitle": "ガイア"
				}
			]
		},
