					"エルシー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280201,
					"content": "（『アイ・ハヌムの歌』を渡す。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280202
					]
				},
				{
					"id": 708280202,
					"content": "わぁ、すっごく綺麗な本じゃない！どれどれ、どんな詩が書いてあるのかしら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280203
					],
					"speakerTitle": "エルシー"
				},
				{
					"id": 708280203,
					"content": "「…蛇のいない玉座はなく、棘なき薔薇もなし。苦しみを飲み干すがいい、フェリギスよ。そしてその甘美な瞳で、私と誓いを…ちか…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280204
					],
					"speakerTitle": "エルシー"
				},
				{
					"id": 708280204,
					"content": "…えっと、この字、なんて読むの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280205
					],
					"speakerTitle": "エルシー"
				},
				{
					"id": 708280205,
					"content": "ダメ、難しすぎるわ！舌がこんがらがっちゃいそう！とにかく買って帰って、家でゆっくり読むことにするわね…ありがとう、金髪の冒険者さん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エルシー"
				}
			]
		},
		{
			"id": 7082803,
			"completionStepIds": [
				7082803
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
