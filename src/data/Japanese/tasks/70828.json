				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"エルシー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280301,
					"content": "（『愛、聖なる啓示と美徳の典律』を渡す。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280302
					]
				},
				{
					"id": 708280302,
					"content": "あ、これ知ってるわ！西風教会の詩集でしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280303
					],
					"speakerTitle": "エルシー"
				},
				{
					"id": 708280303,
					"content": "どれどれ…「彼女の魂は焼却された原野の如く、風に向けて熱い歌い上げる。星と月光、そして日輪の狭間で、私の光を焦がした…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280304
					],
					"speakerTitle": "エルシー"
				},
				{
					"id": 708280304,
					"content": "何よこれ、薄気味悪いわ。それに西風教会の人って、明らかに詩が下手じゃない？星と月と太陽が一度に出るなんて、ありえないでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280305
					],
					"speakerTitle": "エルシー"
				},
				{
					"id": 708280305,
					"content": "とにかく、自信はついたわ！いくら何でもこの詩集の作者よりはうまく書けるはず！この本、買わせてもらうわね。ありがとう、金髪の冒険者さん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エルシー"
				}
			]
		},
		{
