			},
			"dialogs": [
				{
					"id": 708280401,
					"content": "（『ロナブイの夢』を渡す。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280402
					]
				},
				{
					"id": 708280402,
					"content": "あら、これはフォンテーヌの詩集ね！どれどれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280403
					],
					"speakerTitle": "エルシー"
				},
				{
					"id": 708280403,
					"content": "…過去に戻り…純水騎士の王庭…侍女に一目惚れ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280404
					],
					"speakerTitle": "エルシー"
				},
				{
					"id": 708280404,
					"content": "ぷっ…あははっ！こんなマヌケな人、本当にいるの？せっかく過去に戻れるチャンスがあったのに、自分の先祖と同じくらいの歳の人と恋愛することしか考えてないなんて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280405
					],
					"speakerTitle": "エルシー"
				},
				{
					"id": 708280405,
					"content": "あっ、そういうことね！これこそが愛の詩なのよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280406
					],
					"speakerTitle": "エルシー"
				},
				{
					"id": 708280406,
					"content": "はあ、理解できたわ。愛というのは人を惑わせるものなのね。とにかく、帰ってじっくり読むことにしようかしら。ありがとう、金髪の冒険者さん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エルシー"
				}
			]
		},
		{
			"id": 7082805,
			"completionStepIds": [
				7082805
			],
