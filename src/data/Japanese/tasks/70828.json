			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"エルシー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280101,
					"content": "あっ！そこの金髪の冒険者さん、ちょっと待って！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280103,
						708280104
					],
					"speakerTitle": "エルシー"
				},
				{
					"id": 708280103,
					"content": "助けが必要？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280102
					]
				},
				{
					"id": 708280102,
					"content": "ああ、違うの、ただ君が愛に関する詩集を持ってないか、聞きたかっただけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280107
					],
					"speakerTitle": "エルシー"
				},
				{
					"id": 708280107,
					"content": "ほら、私って超すごい吟遊詩人なんだから。たぶんモンドの歴史上…バルバトス様を除けば一番の…とにかく、すごくすごい吟遊詩人なの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280108
					],
					"speakerTitle": "エルシー"
				},
				{
					"id": 708280108,
					"content": "なのに、ライナスっていう吟遊詩人が私のことを認めてないみたいで、一日中、詩を読みに来るのよ！どう考えても挑発してきてるでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280109
					],
					"speakerTitle": "エルシー"
				},
				{
					"id": 708280109,
					"content": "さらに腹が立つのは、彼が読む詩は愛だの、恋人だの…この私でさえまったく書いたことのないテーマばかりなのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280110
					],
					"speakerTitle": "エルシー"
				},
				{
					"id": 708280110,
					"content": "だから、私自らモンド中を震撼させるような偉大な愛の詩を書き上げて、彼に本物の才能ってやつを見せつけてやろうと思ったの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280111
					],
					"speakerTitle": "エルシー"
				},
				{
					"id": 708280111,
					"content": "でもね…私はすべての時間を偉大な芸術に捧げてきたから、今まで恋愛を経験する暇なんてなかったのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280112
					],
					"speakerTitle": "エルシー"
				},
				{
					"id": 708280112,
					"content": "そういうわけで、もし愛についての詩集があったら、売ってくれないかしら！私の才能にかかれば、ちょっと目を通すだけで、たちまちインスピレーションが湧いてくるに決まってるわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エルシー"
				},
				{
					"id": 708280104,
					"content": "用事があるから手伝えないよ。じゃあね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280105
					]
				},
				{
					"id": 708280105,
					"content": "手伝ってほしいわけじゃないの！それに、困ったことがあるたびに道端で赤の他人を捕まえて解決してもらおうとしてたら、みんな外を出歩けなくなっちゃうでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280106
					],
					"speakerTitle": "エルシー"
				},
				{
					"id": 708280106,
					"content": "コホン、ただ君が愛に関する詩集を持ってないか、聞きたかっただけよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280107
					],
					"speakerTitle": "エルシー"
				}
			]
		},
		{
			"id": 7082802,
			"completionStepIds": [
				7082802
			],
