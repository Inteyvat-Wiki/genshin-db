			"trigger": {
				"objectNames": [
					"エルシー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280501,
					"content": "はは、ありがとう、金髪の冒険者さん！君は私にとっての大大大英雄よ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280502
					],
					"speakerTitle": "エルシー"
				},
				{
					"id": 708280502,
					"content": "今、私の頭の中で、まるで風龍廃墟の暴風、沈玉の谷の瘴気、セイライ島の雷霆のように、ひらめきが唸りを上げて湧き出してきてるわ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280503
					],
					"speakerTitle": "エルシー"
				},
				{
					"id": 708280503,
					"content": "それはすごく危なそう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280504
					]
				},
				{
					"id": 708280504,
					"content": "ふふーん、待ってて！今すぐ書き留めるわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280505
					],
					"speakerTitle": "エルシー"
				},
				{
					"id": 708280505,
					"content": "ライナスのあの気取った詩なんて相手にもならないわ。この空前の大傑作が完成したら、テイワット中の酒場に私の名前が知れ渡ることになるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エルシー"
				}
			]
		},
		{
			"id": 7082806,
