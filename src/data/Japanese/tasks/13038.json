			"dialogs": [
				{
					"id": 130380201,
					"content": "待たせたな、セトス。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380202
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130380202,
					"content": "考えはまとまった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380203
					],
					"speakerTitle": "セトス"
				},
				{
					"id": 130380203,
					"content": "その前に、僕はちょっと医学をかじったことがあるんだ。バムーンの身体を見せてくれないかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380204
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130380204,
					"content": "ああ。でもこっちにも医者はいるから、小細工しようとしても無駄だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380205
					],
					"speakerTitle": "セトス"
				},
				{
					"id": 130380205,
					"content": "いや、ただ確認したいだけさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380206
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130380206,
					"content": "そう、ついて来て。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380207
					],
					"speakerTitle": "セトス"
				},
				{
					"id": 130380207,
					"content": "静かにね、そっと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380208
					],
					"speakerTitle": "セトス"
				},
				{
					"id": 130380208,
					"content": "ティナリは持ち歩いていた検査器具を取り出すと、バムーンに簡単な診察を行った。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130380209
					]
				},
				{
					"id": 130380209,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380210
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130380210,
					"content": "外で話そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380211
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130380211,
					"content": "バムーンは深い昏睡状態にあって、容体はあまり芳しくない。君たちの医者もたぶん同じ結果を導き出しただろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380212
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130380212,
					"content": "若い頃にひどい怪我を負った後、過労のせいで病気に罹り、歳を取って体が衰えた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380213
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130380213,
					"content": "残念ながら…彼みたいな人は僕もよく診てきた。こういう状態だと普通、長くてあと数日しか持たない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380214
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130380214,
					"content": "…とっくに知ってたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380215
					],
					"speakerTitle": "セトス"
				},
				{
					"id": 130380215,
					"content": "お前はバムーンの継承者だろう？彼のことを尊敬しているようだが、お前らの考え方はまったく同じわけじゃない。お前が懸念している点はもっと多く、より現実的なものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380216
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130380216,
					"content": "条件を言え。バムーンの目がまだ見えてるうちに決着を付けよう。お前もそれを望んでいるのは分かっている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380217
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130380217,
					"content": "そうだぞ。この件がこれ以上引き延ばせないってことは、おまえもわかってるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130380218,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380219
					],
					"speakerTitle": "セトス"
				},
				{
					"id": 130380219,
					"content": "実を言うと、君たち二人はどちらも似たような状況に置かれてる。どちらも自分を育てた人とは違う考えを持ってるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380220
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130380220,
					"content": "しかも、別の世代のトラブルなのに、決着を付けるのはセノとセトス…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380221
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130380221,
					"content": "君の言う通りだ。この件において、双方の立場はすでに変わってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380222
					],
					"speakerTitle": "セトス"
				},
				{
					"id": 130380222,
					"content": "セノ、君の言い分を認めるよ。すべてはヘルマヌビスから始まったこと。なら、あの方の儀式で決着を付けよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380223
					],
					"speakerTitle": "セトス"
				},
				{
					"id": 130380223,
					"content": "ヘルマヌビスが初めてトゥライトゥーラに着いた時、決闘に参加したと言われてる。彼と二人の仲間が連日戦ったことで、人心を取り戻し、それで有志を大勢招いたらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380224
					],
					"speakerTitle": "セトス"
				},
				{
					"id": 130380224,
					"content": "その人たちは後に沈黙の殿の一員となった。これが僕たちの始まりであり、僕たちの儀式——「決闘の儀」だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380225
					],
					"speakerTitle": "セトス"
				},
				{
					"id": 130380225,
					"content": "理に適ってるな。こちらもその方法で構わない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380226
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130380226,
					"content": "君もヘルマヌビスの力を宿していて、沈黙の殿と深い関わりがある。仲間と一緒に決闘に参加するといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380227
					],
					"speakerTitle": "セトス"
				},
				{
					"id": 130380227,
					"content": "三対三だね、いいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380228
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130380228,
					"content": "ただ、条件がある。君たちは攻め手として、三戦全勝しなければならない。それにセノ…君も僕も、自分の持つ跋霊を賭けるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380229
					],
					"speakerTitle": "セトス"
				},
				{
					"id": 130380229,
					"content": "ジュライセンが跋霊を持ち去ったのをじいちゃんは許した。でも、それはじいちゃんが同情から犯した過ちだ…沈黙の殿が越えなければならない壁でもある。この点は絶対に譲れない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380230
					],
					"speakerTitle": "セトス"
				},
				{
					"id": 130380230,
					"content": "望むところだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380231
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130380231,
					"content": "もし俺が勝ったら、沈黙の殿はジュライセン先生を解放し、過去の出来事は水に流してもらう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380232
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130380232,
					"content": "お前が勝ったら、この力を返そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380233
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130380233,
					"content": "ああ、約束だ。じゃ明日の夜八時、儀式ホールで会おう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "セトス"
				}
			]
		},
