					}
				]
			},
			"dialogs": [
				{
					"id": 130380101,
					"content": "約束の時間になって、みんなと合流した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130380102
					]
				},
				{
					"id": 130380102,
					"content": "…よく考えてみた。先生の性格からして、砂漠に一人で来たということはもう戻れない覚悟を決めていたんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380103
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130380103,
					"content": "先生は好き嫌いが激しく、独断的な人だ。おそらく、逃げようと説得するのも難しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380104
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130380104,
					"content": "僕も同意見だよ。ナフィス先生も言ってた、ジュライセン先生は石頭だって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380105
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130380105,
					"content": "ああ、それと他にも思い出したことがある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380106
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130380106,
					"content": "沈黙の殿の情報についてはみんなも知っての通りで、俺に補足できることはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380107
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130380107,
					"content": "加えて、この場所に関する記憶は曖昧でな。おそらく跋霊による影響だろう。ただ、小さい頃によく頭痛がして、熱を出していたのを覚えている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380108
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130380108,
					"content": "急に崇高な感情が湧いたり、ぼんやりとした影が見えたりした。残念だが、どれも断片的なもので、はっきりと記憶には残っていないが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380109
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130380109,
					"content": "子供の頃の俺は、頭の中に強い意志が存在することしか理解していなかった。今思い返してみると、交流ができずとも、ヘルマヌビスは何らかの形で人間を励ましていたんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380110
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130380110,
					"content": "この精神に伝わる力こそ、やつらが信仰しているものなのかもしれない。ヘルマヌビスの意志と力は確かなものだ。だから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380111
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130380111,
					"content": "あいつの脅しに屈するつもりか？もっといい方法はないのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380112,
						130380113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130380112,
					"content": "焦らないで、セノ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380114
					]
				},
				{
					"id": 130380114,
					"content": "ああ、俺も返すつもりは毛頭ない。確かに、七柱の力を今後どうするか、それを左右する資格はやつらにあるかもしれない。だが、スメールを守るためにも、俺にはこの力が必要だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380115
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130380115,
					"content": "——正面から堂々と、この力を再び自分のものにしてみせる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380116
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130380116,
					"content": "そういえば、出発の前にアルハイゼンから助言をもらったんだ。昔の沈黙の殿は古い貴族みたいな組織で、常に礼儀作法に縛られてたって言ってた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380117
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130380117,
					"content": "あとカーヴェが砂漠で仕事中に聞いた話によると、部族のほとんどは独自のルールを持ってるらしい。それから砂漠の人間たちは、自分の血筋と部族に逆らえないってよく言ってるみたいだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380118
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130380118,
					"content": "だから相手の土俵に立って、こっちから先に意見を提案してみるのはどうかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380119
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130380119,
					"content": "おお…そんなやり方が…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130380120,
					"content": "俺も同じことを考えていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380121
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130380121,
					"content": "機先を制して、相手が拒否できない条件を提示すれば、交渉をこちらのものにできるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380122
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130380122,
					"content": "突破口が見えてきた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380123
					]
				},
				{
					"id": 130380123,
					"content": "うん。これでどう切り込んだらいいか見えてきたね。だったら、僕は医学の知識を活かして、おじいさんの身体を診てあげるってセトスに持ちかけてみようかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130380113,
					"content": "きっとまだ何か方法はあるはず！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380114
					]
				}
			]
		},
