			"dialogs": [
				{
					"id": 130380501,
					"content": "第二戦終了。三戦目の選手、前へ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380502
					],
					"speakerTitle": "ドゥアンレ"
				},
				{
					"id": 130380502,
					"content": "準備はできてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380503
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130380503,
					"content": "僕もだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380504
					],
					"speakerTitle": "セトス"
				},
				{
					"id": 130380504,
					"content": "これが此度の儀式の最後です。双方が提示した条件をお忘れなきよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380505
					],
					"speakerTitle": "ドゥアンレ"
				},
				{
					"id": 130380505,
					"content": "準備ができましたら、いつ始めていただいても問題ありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380506
					],
					"speakerTitle": "ドゥアンレ"
				},
				{
					"id": 130380506,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380507
					],
					"speakerTitle": "セトス"
				},
				{
					"id": 130380507,
					"content": "僕はヘルマヌビスの力の適合者であり、沈黙の殿の現首領であるバムーンの孫——セトス。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380508
					],
					"speakerTitle": "セトス"
				},
				{
					"id": 130380508,
					"content": "長きに渡り、我ら沈黙の殿はヘルマヌビスの御心に従い続け、その秘を守ってきた。そして自らを守る力を手に入れるため、窮地に陥ったとき実験を行った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380509
					],
					"speakerTitle": "セトス"
				},
				{
					"id": 130380509,
					"content": "ヘルマヌビスの知恵と力に付き従い、かの魂が光と共に降り立つことを願ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380510
					],
					"speakerTitle": "セトス"
				},
				{
					"id": 130380510,
					"content": "今、僕は力を手に入れるために戦おう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380511
					],
					"speakerTitle": "セトス"
				},
				{
					"id": 130380511,
					"content": "俺は大マハマトラ·セノ——賢者ジュライセンの生徒であり、後継者だ。この力と先生を、そして俺の住む国を守るために戦う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380512
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130380512,
					"content": "お前はどうだ？まだ口にしていない言葉があるだろう？崇高なる決闘である以上、ヘルマヌビスの前で本心を語ってみろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380513
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130380513,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380514
					],
					"speakerTitle": "セトス"
				},
				{
					"id": 130380514,
					"content": "（誰もが…この決闘の行方を気にしてる。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380515
					],
					"speakerTitle": "セトス"
				},
				{
					"id": 130380515,
					"content": "じいちゃんは聡明な指導者でありながら、血に塗れた名を背負う首領でもある。じいちゃんがどう考えてるか分かってるし、僕に対してどんな期待を抱いてるかも知ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380516
					],
					"speakerTitle": "セトス"
				},
				{
					"id": 130380516,
					"content": "僕たちはずっと信仰に縛られてきた。でもある日、僕は雨林に行って、シティに住む人々に出会った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380517
					],
					"speakerTitle": "セトス"
				},
				{
					"id": 130380517,
					"content": "時代は変わって、今のスメール人はより幸せに、自由に暮らしてるようだった。高いところから、シティの風景を眺めてたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380518
					],
					"speakerTitle": "セトス"
				},
				{
					"id": 130380518,
					"content": "君のことを思い出したよ、セノ。君もその力を持ってるのに、僕とはまったく違う人生を送ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380519
					],
					"speakerTitle": "セトス"
				},
				{
					"id": 130380519,
					"content": "ヘルマヌビスの跋霊にはそれぞれ象徴がある。威能、栄光…そして、まだ解明されていないものも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380520
					],
					"speakerTitle": "セトス"
				},
				{
					"id": 130380520,
					"content": "たぶん、僕たちの得た跋霊の象徴が違うから、こんな違いが生まれたのかもしれない。あるいは…君は既に、僕の持っていない答えを見つけたんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380521
					],
					"speakerTitle": "セトス"
				},
				{
					"id": 130380521,
					"content": "俺は戦士である前に、俺という個人だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380522
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130380522,
					"content": "…うん、そうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380523
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130380523,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380524
					],
					"speakerTitle": "セトス"
				},
				{
					"id": 130380524,
					"content": "君も僕もヘルマヌビスの器だけど、完全にそうというわけじゃない。その名は僕たちに影響を与え、僕たちの人生を変えた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380525
					],
					"speakerTitle": "セトス"
				},
				{
					"id": 130380525,
					"content": "君ならきっと、僕の質問に答えられるだろう——この力と信仰以外で、この僕に何ができるかを！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380526
					],
					"speakerTitle": "セトス"
				},
				{
					"id": 130380526,
					"content": "さあ、来い！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380527
					],
					"speakerTitle": "セトス"
				},
				{
					"id": 130380527,
					"content": "おい？大丈夫か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380528
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130380528,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380529
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130380529,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "セトス"
				}
			]
