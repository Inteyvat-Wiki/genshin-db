			},
			"dialogs": [
				{
					"id": 130380301,
					"content": "知恵の頂点であられるヘルマヌビス様——その権威と威厳の前で本日、我々は再び決闘の儀を執り行います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380302
					],
					"speakerTitle": "ドゥアンレ"
				},
				{
					"id": 130380302,
					"content": "これは極めて神聖な儀式であり、決闘の目撃者は横槍を入れることなく、敬意を胸に抱きながら粛と見届けなければなりません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380303
					],
					"speakerTitle": "ドゥアンレ"
				},
				{
					"id": 130380303,
					"content": "そして今回、「沈黙の殿」陣営は守り手となります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380304
					],
					"speakerTitle": "ドゥアンレ"
				},
				{
					"id": 130380304,
					"content": "じいちゃん、来てくれたか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380305
					],
					"speakerTitle": "セトス"
				},
				{
					"id": 130380305,
					"content": "…ゴホッ、ゴホッ…何年も経って、またこの儀式を執り行うとは、セトス。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380306
					],
					"speakerTitle": "バムーン"
				},
				{
					"id": 130380306,
					"content": "自分が何をしてるか分かってるよ、じいちゃん。安心して見ててくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380307
					],
					"speakerTitle": "セトス"
				},
				{
					"id": 130380307,
					"content": "対して、「教令院」陣営は攻め手となります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380308
					],
					"speakerTitle": "ドゥアンレ"
				},
				{
					"id": 130380308,
					"content": "準備は万端だ。実力をもって、主導権をつかみ取る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380309
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130380309,
					"content": "それでは双方、所定の位置へ。出場順を決めてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380310
					],
					"speakerTitle": "ドゥアンレ"
				},
				{
					"id": 130380310,
					"content": "ここでは来る者も去る者も問わず、勝敗が決するまで、ヘルマヌビス様の力を賭けて戦うことになります！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380311
					],
					"speakerTitle": "ドゥアンレ"
				},
				{
					"id": 130380311,
					"content": "#{M#俺}{F#私}が行く。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380312
					]
				},
				{
					"id": 130380312,
					"content": "えっ？もう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130380313,
					"content": "うん。士気が何より大事だから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380314
					]
				},
				{
					"id": 130380314,
					"content": "僕も同意見だ。旅人は強い。先陣を切れば相手の勢いを削げる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380315
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130380315,
					"content": "なら、その次はティナリに任せる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380316
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130380316,
					"content": "うん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380317
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130380317,
					"content": "こっちは決まった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380318
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130380318,
					"content": "こっちもいいよ。さあ、始めよっか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "セトス"
				}
			]
		},
