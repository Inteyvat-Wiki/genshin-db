				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722811601,
					"content": "旅人さん、パイモンさん、お見送りに来てくださりありがとうございます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811602
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 722811602,
					"content": "離島の旅はどうだった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722811603
					]
				},
				{
					"id": 722811603,
					"content": "とても価値あるものでした。「小説観賞会」も成功し、この先行われる正式な会談に希望が持てそうです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811604
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 722811604,
					"content": "それに、ゴローもお手柄でした。海祇島のためにこんなにも沢山の書籍を確保してくれたのですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811605
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 722811605,
					"content": "特賞を引いたのは俺だが、結局は八重神子から贈られた本だ。また機会があれば、きちんと礼を言わなければならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811606
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 722811606,
					"content": "そういえば、昨日八重宮司から手紙を受け取ったそうですが、何が書かれていたのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811607
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 722811607,
					"content": "あっ、すっかり忘れていた！どれどれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811608
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 722811608,
					"content": "ゴローへ。贈呈式と記念撮影があると聞いて汝は、さぞかし動揺し不安にかられたことじゃろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811609
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 722811609,
					"content": "よもや汝がこれらの条件を受け入れた上に、かような要求をしてくるとはな。汝のその勇気、尊重するに値する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811610
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 722811610,
					"content": "これらの書籍は、海祇島への少しばかりの気持ちじゃ。汝への贈り物でもあるゆえ、気に入ってくれることを願う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811611
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 722811611,
					"content": "さて、ここまで読んだ汝は、さぞ妾の親切に感謝し、妾に報いる機会を探しておることじゃろうな。実はその機会は、もうすでに来ておるのじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811612
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 722811612,
					"content": "来月八重堂では、娯楽小説の登場人物に扮した者たちが、ファンと交流するイベントを開催する予定での。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811613
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 722811613,
					"content": "ゴローは忍耐強いうえ、眉目秀麗じゃ。手伝いに来てはくれぬか。汝のためだけに仕立てたものを、妾が特別に用意してやろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811614
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 722811614,
					"content": "ち·な·み·に——女物じゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811615
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 722811615,
					"content": "あぁああああ——あの性悪女め！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ゴロー"
				}
			]
		}
	]
