				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"珊瑚宮心海",
					"ゴロー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722810201,
					"content": "旅人さん、パイモンさん、お久しぶりです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810202
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 722810202,
					"content": "あっ、心海にゴロー！へぇ、海祇島の現人神の巫女と大将も、容彩祭に参加するんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722810203,
					"content": "はい。ですが我々は海祇島の管理者としてではなく、個人としての身分でこの招待をお受けいたしました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810204
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 722810204,
					"content": "近頃は海祇島の事務もさほど多くはありませんし、私も本が買いたかったので、来ることにしたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810205
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 722810205,
					"content": "ゴローは容彩祭には興味が無かったのですが、私が離島に来ると聞いて、一緒に来てくれました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810206
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 722810206,
					"content": "珊瑚宮様が海祇島を離れると聞いてはな。それに、今日は「文通相手」ともお会いになるらしいから、大将として珊瑚宮様をお守りするのは当然だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810207
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 722810207,
					"content": "「文通相手」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722810208,
					"content": "はい、最近知り合って、連絡を取り始めたお方なのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810209
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 722810209,
					"content": "娯楽小説の趣味も似ていて、興味深い考えを思いついては語り合っています。もちろん、意見をぶつけ合う時だってありますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810210
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 722810210,
					"content": "せっかく容彩祭に来るのですから、この機会に「小説観賞会」を開くことにしました。小説について語り合うつもりです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810211
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 722810211,
					"content": "おお、なんかすごく専門的な会だな！そうだ、二人とも小説が好きなんだったら、一緒に作ってみるのはどうだ？稲妻の小説業界を変えられちゃうかもしれないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722810212,
					"content": "ふふ、それは面白い考えですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810213
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 722810213,
					"content": "さて、そろそろ時間です。私とゴローは、待ち合わせの場所へ向かいますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810214
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 722810214,
					"content": "心海、オイラもおまえの文通相手が気になるから、一緒に行ってもいいか？遠くから見るだけで、おまえたちの邪魔はしないからさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810215
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722810215,
					"content": "そうですね…あなたたちなら問題はないでしょう。では、一緒に行きましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚宮心海"
				}
			]
		},
		{
			"id": 7228104,
			"completionStepIds": [
				7228104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7228104",
							"2"
						],
						"stepId": 7228104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"珊瑚宮心海",
					"ゴロー",
					"八重神子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722810401,
					"content": "約束の場所はここです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810402
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 722810402,
					"content": "周りには誰もいないな。どうやら、早く来すぎてしまったようだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810403
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 722810403,
					"content": "おやおや、誰かと思えば汝らではないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810404
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 722810404,
					"content": "み、神子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722810405,
					"content": "（まずい…まさかここで神子に会うなんて！神子と心海はもとは敵対していた陣営にいるし、信仰する神だって違う。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722810406,
					"content": "（この二人…争いが起きないといいんだけど…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810407
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722810407,
					"content": "さすがは鳴神大社の宮司様、相変わらずお高くとまっていらっしゃいますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810408
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 722810408,
					"content": "ふふっ、汝こそ、さすが海祇島の指導者じゃな。姿はクラゲのようにか弱く見えても、言葉には毒が詰まっておる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810409
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 722810409,
					"content": "あわわ…ど、どうすれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810410
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722810410,
					"content": "こんにちは。初めまして、「焜焜油揚げ」さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810411
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 722810411,
					"content": "よろしく頼むぞ、「深海ウシノシタ」殿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810412
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 722810412,
					"content": "うふふふふふっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810413
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 722810413,
					"content": "ええ…一体どういうことだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810414
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722810414,
					"content": "まさか、心海の文通相手っていうのは、神子だったのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810415
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722810415,
					"content": "いやいや、でもこの二人の様子からすると、とっくにお互いの身分を知ってたみたいだよな！ってことは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810416,
						722810417
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722810416,
					"content": "文通相手と会うっていうのは…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722810418
					]
				},
				{
					"id": 722810418,
					"content": "ん？童らが何を言うておるのか、妾には分からぬのう。妾はただ、「深海ウシノシタ」殿と「小説観賞会」を開きに来ただけじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810419
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 722810419,
					"content": "さて、行くとするかの。観賞会は勘定奉行所で行う。景色もよく、茶を飲むのにも最適じゃ。存分に創作を語り合おうぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810420
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 722810420,
					"content": "なんで小説観賞会が勘定奉行所で開かれるんだよ。そんなの信じるほうがおかしいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810421
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722810421,
					"content": "おまえたちが話し合ったりしたら、小説業界が変わるどころか、稲妻全体の情勢が変わっちゃうぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810422
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722810422,
					"content": "ふふ、もうすぐ海祇島は、稲妻の将来について幕府と正式に会談をします。その会談が開かれるまでに、非公式の会合をしておくことも必要なのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810423
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 722810423,
					"content": "そうじゃ、特に妾のような幕府外の者が出向くことで、双方が腹の内を話しやすくなるじゃろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810424
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 722810424,
					"content": "ただ妾たちは、これが初めての対面なのじゃ。民衆に発表するにはまだ早すぎる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810425
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 722810425,
					"content": "そうだったのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810426
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722810426,
					"content": "そういえば、汝らの大将が見えぬが？汝はあやつも来ると言っていたではないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810427
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 722810427,
					"content": "あれ、本当だ。ゴローのやつ、いつの間にかいなくなってる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810428
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722810428,
					"content": "ゴローは私のために本の買い付けをしておりますので、今回の観賞会には参りません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810429
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 722810429,
					"content": "なんと、実に残念じゃ。あやつのモフモフな耳がまた見られると思ったのじゃがのう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810430
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 722810430,
					"content": "旅人さん、少しいいですか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810431
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 722810431,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722810432
					]
				},
				{
					"id": 722810432,
					"content": "実は、以前からなんとなく、ゴローは八重宮司との付き合いが苦手なのではないかと気付いていました。ですので今回離島へ来る際はゴローを連れて来ないつもりでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810433
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 722810433,
					"content": "おそらく、ゴローは先ほど八重宮司を見た瞬間に、本能的に隠れてしまったのでしょう。しかしゴローは責任感が強いため、次に私と顔を合わせるとき、きっと恥ずかしさで身が縮む思いをします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810434
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 722810434,
					"content": "それで、本の買い付けという任務を与えて、心の負担を少し和らげようと思うのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810435
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 722810435,
					"content": "ですがゴローは今までほとんど、買い物をしたことがありません。そこで、あなたに付いていてもらいたいのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810436
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 722810436,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722810437
					]
				},
				{
					"id": 722810437,
					"content": "心海、おまえは安心して神子と話をしてたらいいぞ。本を買うほうは、オイラたちとゴローに任せろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810438
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722810438,
					"content": "はい、よろしくお願いします。買うべき本を、一覧にしておきました。この紙をゴローに渡してください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 722810417,
					"content": "ただの口実だった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722810418
					]
				}
			]
		},
		{
