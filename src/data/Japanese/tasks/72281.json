	"talks": [
		{
			"id": 7228102,
			"completionStepIds": [
				7228102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
