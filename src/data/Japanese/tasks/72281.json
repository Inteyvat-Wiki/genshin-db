				"points": []
			},
			"dialogs": [
				{
					"id": 722810701,
					"content": "リストにあった『影向山の夜』という童話が、ここで売ってるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810702
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 722810702,
					"content": "童話？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810703
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722810703,
					"content": "ああ、海祇島の子供たちへの本なんだ。この本は分かりやすいから字を習うのに最適だと珊瑚宮様が言っていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810704
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 722810704,
					"content": "こんにちは。『影向山の夜』を五冊くれるか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810705
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 722810705,
					"content": "毎度あり！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810706
					],
					"speakerTitle": "福本"
				},
				{
					"id": 722810706,
					"content": "おや、お客さん運が良いですね。ちょうど引換券が当たりましたので、おまけで賞品を差し上げます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810707
					],
					"speakerTitle": "福本"
				},
				{
					"id": 722810707,
					"content": "わぁ、賞品がもらえるのか。よかったな、ゴロー。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810708
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722810708,
					"content": "こちらが賞品の、狐のぬいぐるみです。お受け取りください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810709
					],
					"speakerTitle": "福本"
				},
				{
					"id": 722810709,
					"content": "な、何、狐のぬいぐるみ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810710
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 722810710,
					"content": "はい、どうされました？しっぽの毛が逆立っているみたいですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810711
					],
					"speakerTitle": "福本"
				},
				{
					"id": 722810711,
					"content": "いや、なんでもない。賞品をありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810712
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 722810712,
					"content": "#{NICKNAME}、この狐…のぬいぐるみは、よかったらお前が受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810713
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 722810713,
					"content": "本当にいいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722810714
					]
				},
				{
					"id": 722810714,
					"content": "ああ、本を買うのに付き合ってくれた礼だと思ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810715
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 722810715,
					"content": "はぁ、どうやらゴローは神子を見ちゃったトラウマから、まだ抜け出せてないみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810716
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722810716,
					"content": "この次は…まあ、今回の旅の要ではないが、娯楽小説だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810717
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 722810717,
					"content": "一覧表によると…『沈秋拾剣録』の新刊はすでに、小野寺という編集者に代理で買ってもらっているらしい。あまり先方を待たせないようにしないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810718
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 722810718,
					"content": "その人なら知ってるぞ、オイラたちが連れてってやるぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
