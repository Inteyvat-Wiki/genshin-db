					"ゴロー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722810501,
					"content": "ゴロー、大丈夫か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722810502,
					"content": "はっ！お前たちか…はぁ、まさかあの女が急に現れるとは…あいつとはどう接していいか分からないのだ。気付いたら、もうその辺に隠れてしまっていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810503
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 722810503,
					"content": "俺は珊瑚宮様の安全を守るために来たのに、何もできなかったばかりか、結局負担になってしまうとは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810504
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 722810504,
					"content": "ゴロー、あんまり自分を責めるなよ。実は、心海からおまえに頼みたい重要な任務があるみたいなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722810505,
					"content": "心海の書籍購入リストをゴローに渡した。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722810506
					]
				},
				{
					"id": 722810506,
					"content": "これは珊瑚宮様の買い物一覧表…きっとこれで失敗を取り返せってことだな！よし分かった、あとは俺に任せろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810507
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 722810507,
					"content": "オイラたちも一緒に行くぜ。ちょうど祭りのガイドをしてるんだ。おまえを容彩祭に連れてってやるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810508
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722810508,
					"content": "恩に着る！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ゴロー"
				}
			]
		},
		{
