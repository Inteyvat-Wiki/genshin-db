			"dialogs": [
				{
					"id": 722810901,
					"content": "小野寺さんか？俺は「深海ウシノシタ」さんの『沈秋拾剣録』新刊を取りに来た者だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810902
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 722810902,
					"content": "こんにちは、ご用意してありますよ。「深海ウシノシタ」さんは容彩祭のお客さんだそうですが、船の予定が合わず、サイン即売会には間に合わなかったようですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810903
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 722810903,
					"content": "それ以外にもここに書いてある本で在庫があるものを、それぞれ一冊ずつ頼む。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810904
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 722810904,
					"content": "かしこまりました。どれどれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810905
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 722810905,
					"content": "おや、お客さん、とても幸運ですよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810906
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 722810906,
					"content": "ちょうど『ハマヴァラーン戦記』の百人目の購入者となりました。八重様の直筆書評が入った特別版をお贈りいたします！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810907
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 722810907,
					"content": "な…なぜこうなる！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810908
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 722810908,
					"content": "お客さん、どうされましたか？顔色が悪いようですが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810909
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 722810909,
					"content": "な、なんでもない。ありがとう、その本は受け取っておく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810910
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 722810910,
					"content": "何しろ珊…「深海ウシノシタ」さんから頼まれたものだ。書評の入った特別版ならば、より喜んでもらえるだろう。あははっ、はは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810911
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 722810911,
					"content": "なんか無理してそうだな…幸運なのか不運なのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810912
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722810912,
					"content": "それから実は、ただ今八重堂では抽選会を行っているのですが、この金額なら抽選に参加できますよ。一緒に抽選台へ行きましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小野寺"
				}
			]
		},
