			},
			"dialogs": [
				{
					"id": 722811101,
					"content": "お客さん、こちらで抽選に参加してみてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811102
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 722811102,
					"content": "これを回して暫くすると、玉が出てきます。運が良ければ、当たるかもしれませんよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811103
					],
					"speakerTitle": "村田"
				},
				{
					"id": 722811103,
					"content": "ゴロー、やってみろよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722811104,
					"content": "どれどれ…金色！お客さん、すごいですよ！特賞です！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811105
					],
					"speakerTitle": "村田"
				},
				{
					"id": 722811105,
					"content": "ゴロー、おまえ今日、すごく運が良いみたいだぞ！ところで、特賞はなにがもらえるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722811106,
					"content": "特賞は、八重堂から出版されている娯楽小説の全巻セットです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811107
					],
					"speakerTitle": "村田"
				},
				{
					"id": 722811107,
					"content": "八重神子様ご本人から賞品が贈呈されるだけでなく、八重様と握手して記念撮影ができる機会も！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811108
					],
					"speakerTitle": "村田"
				},
				{
					"id": 722811108,
					"content": "なに？あの女に会わなければならないだけでなく…あ、握手して記念撮影だと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811109
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 722811109,
					"content": "ゴロー、しっかり！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722811110
					]
				},
				{
					"id": 722811110,
					"content": "なに、あの兄ちゃん、八重堂の特賞を当てたのか？運が良すぎるだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811111
					],
					"speakerTitle": "陽太"
				},
				{
					"id": 722811111,
					"content": "娯楽小説全巻セットって、とんでもない金額だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811112
					],
					"speakerTitle": "秋人"
				},
				{
					"id": 722811112,
					"content": "えっと…その、編集さん、一つ相談したいことがある。実は、俺は娯楽小説が欲しいわけではないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811113
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 722811113,
					"content": "えっ、それは…賞品を諦めるということですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811114
					],
					"speakerTitle": "村田"
				},
				{
					"id": 722811114,
					"content": "ゴロー、諦めたりしちゃだめだぞ。神子に会いたくないのなら、オイラたちが方法を考えてやる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722811115,
					"content": "いや、誤解だ！俺は賞品がいらないわけじゃない。もちろん贈呈も撮影も、何だって受け入れる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811116
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 722811116,
					"content": "ただ、八重堂に一つお願いがあるんだ。賞品を、同額の農学書籍に変えてくれないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811117
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 722811117,
					"content": "農学書籍？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722811118,
					"content": "ああ。俺たちの住む海祇島の土地は痩せていて、作物がなかなか育たない。だから俺たちはずっと、住民の暮らしがよりよいものになるよう、新しい農法を模索しているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811119
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 722811119,
					"content": "珊…コホンッ、「深海ウシノシタ」さんが今回容彩祭に来た大事な目的は、作物栽培と養殖に関する書籍を手に入れること。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811120
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 722811120,
					"content": "もしそれらの本を賞品として交換できれば、俺たちは予算を節約できる。そうすれば「深海ウシノシタ」さんも、他にも必要なものをさらに買うことができるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811121
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 722811121,
					"content": "なるほど、お考えは分かりました。でもこれは私ではどうにもなりませんので、八重様に聞いてみる必要があります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811122
					],
					"speakerTitle": "村田"
				},
				{
					"id": 722811122,
					"content": "今から八重様に連絡しますので、お客さんは五歌仙広場で報告をお待ちください。場合によっては、八重様が直々に相談にいらっしゃるかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811123
					],
					"speakerTitle": "村田"
				},
				{
					"id": 722811123,
					"content": "ああ、分かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ゴロー"
				}
			]
		},
		{
			"id": 7228113,
			"completionStepIds": [
				7228113
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7228113",
							"2"
						],
						"stepId": 7228113,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ゴロー",
					"村田"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722811301,
					"content": "さっきのゴロー、すごく勇敢だったな。神子のことが苦手なのに、商品の贈呈を受け入れたばかりか、自分の要望まで言うなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722811302,
					"content": "そうか？あの時はただ珊瑚宮様に任せられたってことと、海祇島の民たちを思い出して、急に勇気が出たんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811303
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 722811303,
					"content": "俺は海祇島の大将なんだ、こんなところで負けちゃだめだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811304
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 722811304,
					"content": "今になって、兵を率いて戦場に出ていた時の感覚を思い出した。たとえ八重神子と直々に交渉することになっても、あいつの気迫に影響されたりしない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811305
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 722811305,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811306
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 722811306,
					"content": "ゴロー、なんかまだ緊張してないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722811307,
					"content": "ははっ、あの女が俺を困らせるような要求をしてこないかと思ってな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811308
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 722811308,
					"content": "皆さん、お待たせしてすみません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811309
					],
					"speakerTitle": "村田"
				},
				{
					"id": 722811309,
					"content": "状況は？八重宮司は何と言ってた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811310
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 722811310,
					"content": "ご要望にお応えして、賞品を娯楽小説から農学関係の書籍へ変更できそうです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811311
					],
					"speakerTitle": "村田"
				},
				{
					"id": 722811311,
					"content": "やったー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722811312,
					"content": "それに、お客さんの利用目的を考慮して、おまけをしてもいいとも仰っていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811313
					],
					"speakerTitle": "村田"
				},
				{
					"id": 722811313,
					"content": "今から私と八重堂の倉庫まで本を選びに行きましょう。お客さんは明日の夜に船に乗ると聞きましたので、選んだ書籍は我々が直接船に運びましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811314
					],
					"speakerTitle": "村田"
				},
				{
					"id": 722811314,
					"content": "直接運ぶ？なら、賞品の贈呈はどうなる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811315
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 722811315,
					"content": "書籍選びは手間がかかりますし、八重様はあなたに容彩祭の良い思い出を持ったまま帰って欲しいとのことで、贈呈式は中止するそうです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811316
					],
					"speakerTitle": "村田"
				},
				{
					"id": 722811316,
					"content": "ですが、八重様から手紙を預かっております。お時間がある時に読んでください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811317
					],
					"speakerTitle": "村田"
				},
				{
					"id": 722811317,
					"content": "まさか八重神子が贈呈式を取り消すなんてな…はぁ、またあいつに酷いことをされるんじゃないかと思っていたが…どうやら俺の心が狭かっただけのようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811318
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 722811318,
					"content": "じゃあ、俺は編集さんと本を選びに行ってくる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811319,
						722811320
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 722811319,
					"content": "明日の夜に会おう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722811321
					]
				},
				{
					"id": 722811321,
					"content": "ああ、明日の夜にまた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 722811320,
					"content": "波止場まで行って見送るから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722811321
					]
				}
			]
		},
		{
			"id": 7228116,
			"completionStepIds": [
				7228116
