			},
			"dialogs": [
				{
					"id": 741460201,
					"content": "#…演算プロセスを中止します。{NICKNAME}様、何かご命令はございますか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460202,
						741460209,
						741460214,
						741460220
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 741460202,
					"content": "今の状況について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741460203
					]
				},
				{
					"id": 741460203,
					"content": "純水精霊·アンおよび水仙十字結社の残党·キャタピラーとやりとりをしたことで、いくつか有用な情報を入手しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460204
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 741460204,
					"content": "私はプロトタイプ4ACV07、ご主人様であるマリアンお嬢様に付き添いお守りするために、ギヨタン様によって設計されました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460205
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 741460205,
					"content": "残念ながら、現在、その他にマリアンお嬢様に関するこれ以上の情報はございません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460206
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 741460206,
					"content": "また、純水精霊·アンが提供された情報はかなり少ないです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460207
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 741460207,
					"content": "水仙十字結社の残党·キャタピラーは、すべての情報を提供していません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460208
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 741460208,
					"content": "分析するにはさらに時間が必要です…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "セイモア"
				},
				{
					"id": 741460209,
					"content": "セイモアについてもっと知りたい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741460210
					]
				},
				{
					"id": 741460210,
					"content": "私はプロトタイプ4ACV07、ご主人様であるマリアンお嬢様に付き添いお守りするために、ギヨタン様によって設計されました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460211
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 741460211,
					"content": "私には、フォンテーヌ自然哲学学院の最先端光学設備、記憶ユニット、ロジックユニット、及び、各種機能モジュールを搭載してあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460212
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 741460212,
					"content": "そのおかげで、マリアンお嬢様の日常生活を記録するだけでなく、エージェント助手として力を発揮することができるようになりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460213
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 741460213,
					"content": "今一番重要な目標は、マリアンお嬢様を探し出し、安全を確保することです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "セイモア"
				},
				{
					"id": 741460214,
					"content": "マリアンについてもっと知りたい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741460215
					]
				},
				{
					"id": 741460215,
					"content": "私が製造された目的は、ご主人様であるマリアンお嬢様に付き添いお守りするためです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460216
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 741460216,
					"content": "今一番重要な目標は、マリアンお嬢様を探し出し、安全を確保することです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460217
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 741460217,
					"content": "純水精霊·アンの一部の行動からは、マリアンお嬢様の過去の行動に相似した特徴を観測しています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460218
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 741460218,
					"content": "但し彼女たちを構成する要素は…ギギ…、ジー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460219
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 741460219,
					"content": "ヒント：定期的に記録スペースの整理を行うことで、当該問題の発生頻度を下げることが可能です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "セイモア"
				},
				{
					"id": 741460220,
					"content": "何でもない、またね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741460221
					]
				},
				{
					"id": 741460221,
					"content": "#かしこまりました。行ってらっしゃいませ、{NICKNAME}様。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "セイモア"
				}
			]
		},
		{
			"id": 7414603,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7414601",
							"2"
						],
						"stepId": 7414601,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"キャタピラー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741460301,
					"content": "どうしたんですか、まだ話したいことがあるんですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460302,
						741460311,
						741460317,
						741460324
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 741460302,
					"content": "今の状況について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741460303
					]
				},
				{
					"id": 741460303,
					"content": "いやぁ、よかったです。数百年を経て、またここは賑やかになってきましたね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460304
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 741460304,
					"content": "…冗談です。こんな風に集まったのには意味があると思いますよ。偶然と片付けるのは、つまらなすぎるし、単純すぎると思いますからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460305
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 741460305,
					"content": "ボクたちの出会いは何かが始まる兆しのはずです。抑圧された存在が芽を出して、弾けようとする直前のような、不思議な現象…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460306
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 741460306,
					"content": "でも話を戻すと、本当に世界の滅亡が訪れるまで、デタラメから意味を見いだして、あれらの不思議な現象は、ある厳粛な時が必ず来る予兆だって確信できる人なんているんでしょうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460307
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 741460307,
					"content": "ナルツィッセンクロイツは例外でしたが…以前はボクも彼を「ご主人様」と呼んでいました。どうであれ、確かに彼は「マスター」と呼ぶにふさわしい人物でした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460308
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 741460308,
					"content": "ボクらの行く道がここ——この終末時計の下で交差してるように、交錯した道を進んで行けば、もしかしたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460309
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 741460309,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460310
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 741460310,
					"content": "…続きは、旅のゴールまでとっておきますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 741460311,
					"content": "キャタピラーについてもっと知りたい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741460312
					]
				},
				{
					"id": 741460312,
					"content": "僕自身のことで話すべきことはないですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460313
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 741460313,
					"content": "本当の自分の奥底にある相反する属性を感じることがあります。それぞれ純粋なものなんだけど、互いには異質なんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460314
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 741460314,
					"content": "だから混ざり合うと、互いに不純物が入ってしまう、分かりますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460315
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 741460315,
					"content": "ボクの自我もしっかりしたものじゃない…勇者だったり、悪龍だったり、他人の言葉で塗り固められた嘘みたいな自我なんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460316
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 741460316,
					"content": "でも唯一正確な答えはあるはず。時計の針がまた動きだし、ボクも一歩を踏み出す準備はできています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キャタピラー"
				},
				{
