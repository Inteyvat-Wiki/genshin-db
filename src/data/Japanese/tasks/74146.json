				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741460101,
					"content": "#騎士{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460102,
						741460107,
						741460114,
						741460120
					],
					"speakerTitle": "アン"
				},
				{
					"id": 741460102,
					"content": "今の状況について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741460103
					]
				},
				{
					"id": 741460103,
					"content": "ぼんやりとしてるけど、いくつか…思い出したかも。これが「記憶」って呼べるかどうかは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460104
					],
					"speakerTitle": "アン"
				},
				{
					"id": 741460104,
					"content": "人の記憶が保存されるのが、脳の中なのか心の中なのか分からないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460105
					],
					"speakerTitle": "アン"
				},
				{
					"id": 741460105,
					"content": "でも純水精霊に脳も心もないみたい、水だけ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460106
					],
					"speakerTitle": "アン"
				},
				{
					"id": 741460106,
					"content": "あたしがあのバカ犬だったら、ただ座って「記憶の断片データを検索します」とか言えば、何でも思い出せるのになぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アン"
				},
				{
					"id": 741460107,
					"content": "アンのことをもっと知りたい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741460108
					]
				},
				{
					"id": 741460108,
					"content": "あなたに話せることが他にもあるのか分からないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460109
					],
					"speakerTitle": "アン"
				},
				{
					"id": 741460109,
					"content": "私は「マリアン」によって創り出された虚像の一部。でも…でも彼女は私を拒絶し、他の人さえも拒絶した…えっと、これは他の存在って意味ね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460110
					],
					"speakerTitle": "アン"
				},
				{
					"id": 741460110,
					"content": "あたしが助けたいプリンセス·リリスはいない、「マリアン」もマリアンじゃない、バカ犬のご主人様でもない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460111
					],
					"speakerTitle": "アン"
				},
				{
					"id": 741460111,
					"content": "なんでか分からないけどバカ犬を見ると、内側から…泡のように感情が湧き上がってくるわ！それを思い出そうとすると、泡がはじけちゃう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460112
					],
					"speakerTitle": "アン"
				},
				{
					"id": 741460112,
					"content": "キャタピラーは何か知ってるみたいだけど、確信を持てないことは話したがらないし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460113
					],
					"speakerTitle": "アン"
				},
				{
					"id": 741460113,
					"content": "名前に「水仙十字」って入ってる場所に来たのに、それでも何も分からないなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アン"
				},
				{
					"id": 741460114,
					"content": "プリンセス·リリスのことを知りたい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741460115
					]
				},
				{
					"id": 741460115,
					"content": "プリンセス·リリスは優しくて勇敢だから、友達を守るために、自ら窮地に陥ったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460116
					],
					"speakerTitle": "アン"
				},
				{
					"id": 741460116,
					"content": "前はね、あたしは彼女の仲間で、守ってくれたから…今度はあたしが助けなくちゃって思ってたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460117
					],
					"speakerTitle": "アン"
				},
				{
					"id": 741460117,
					"content": "けど、あたしに助けてもらいたいなんて思ってないのかも…彼女ってあまりにも優しいから、たとえ自分が窮地に立たされていても、友達を危険に晒したくないと思うんじゃないかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460118
					],
					"speakerTitle": "アン"
				},
				{
					"id": 741460118,
					"content": "でも、もしこれであたしが助けに行かなかったら、あたしは彼女の友達とは言えない。守られる資格なんてない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460119
					],
					"speakerTitle": "アン"
				},
				{
					"id": 741460119,
					"content": "「記憶」…とは曖昧なもの。まるで水中の渦みたいで…だけど感情…そして願いはあんなにもリアルなの。彼女がお話の登場人物に過ぎないと分かってもなお…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アン"
				},
				{
					"id": 741460120,
					"content": "何でもない、先に休んでいいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741460121
					]
				},
				{
					"id": 741460121,
					"content": "#ええ、おやすみなさい、騎士{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アン"
				}
			]
		},
		{
			"id": 7414602,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
