			"dialogs": [
				{
					"id": 740740101,
					"content": "…いや、それよりも、あの倒れている人のほうを気にするべきじゃない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740102
					],
					"speakerTitle": "アン"
				},
				{
					"id": 740740102,
					"content": "え？わっ！一体どうしたんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740740103,
					"content": "申し訳ありません、石碑探しの優先レベルを最高にしていました。それではスキャンを行います…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740104
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 740740104,
					"content": "…申し訳ありません、パイモン様。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740105
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 740740105,
					"content": "どうしたんだ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740740106,
					"content": "まだ息はあるものの、生命の気配はすでに開口部から抜け出てしまっています。私はこの手口をよく知っています…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740107
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740740107,
					"content": "うう、見てられないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740740108,
					"content": "すぐに助けを呼ぼうぜ！このままにしておくわけにはいかないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740740109,
					"content": "みんなで、気絶した人をルミドゥースハーバーへ送って行った。\\nルミドゥースハーバーの人はすぐにやってきて、彼は治療を受けられることになった。\\nそれでようやく安心して、みんなと元居た場所まで戻ってきた。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740740110
					]
				},
				{
					"id": 740740110,
					"content": "よし、石碑を見てみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740740111,
					"content": "「ここは願いの象限。願いの広間、願いの間。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740112
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 740740112,
					"content": "「何時も相いれず」…「一瞬で生まれ、永遠の眠りにもつきそい、離れることなく」…「罪咎に染まるもの」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740113
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 740740113,
					"content": "またなぞなぞですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740114
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740740114,
					"content": "なんでこんな怖いことをする必要があるんだよ…まさか答えと関係があるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740740115,
					"content": "ええ、なぜならフォンテーヌ人は「罪人」、「原罪に染まった」命だからです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740116
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740740116,
					"content": "だから答えは「命」。わかりましたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740117
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740740117,
					"content": "本当にその答えでいいの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740118
					],
					"speakerTitle": "アン"
				},
				{
					"id": 740740118,
					"content": "水仙十字結社の言い回しには慣れているんです。よほどのことがない限り、合っているでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740119
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740740119,
					"content": "よし、急ぎましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キャタピラー"
				}
			]
		},
