			"dialogs": [
				{
					"id": 740741901,
					"content": "装置の上の部分を念入りに調べたが、何も見つからなかった。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740741902
					]
				},
				{
					"id": 740741902,
					"content": "結局、ここにはなにもないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740741903
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740741903,
					"content": "いや…どうやら誰かに持ち去られたようですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740741904
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740741904,
					"content": "それってつまり、オイラたちの計画は失敗したってことじゃないのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740741905
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740741905,
					"content": "「理性」を誕生させるには四つの象限を一つにしなければなりません。残りのいくつかをゲットできれば、ボクたちにもまだチャンスはありますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740741906
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740741906,
					"content": "だったらあたしたち、早く次の場所に行かなくちゃね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アン"
				}
			]
		},
