				},
				{
					"id": 740742102,
					"content": "ここのものも…持って行かれちゃってるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740742103,
					"content": "そのようですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742104
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740742104,
					"content": "一体誰が…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740742105
					]
				},
				{
					"id": 740742105,
					"content": "ジェイコブでしょうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742106
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740742106,
					"content": "エリナスで、私たちはジェイコブと衝突を起こしました。補足：これは比較的最近起こったほうの「エリナス」事件です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742107
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 740742107,
					"content": "扉のところにいた悲劇の被害者を見たとき、彼だと分かりました。案の定、まだ動いていたようですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742108
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740742108,
					"content": "ジェイコブはここのものを持ち去って、一体なにをするつもりなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740742109,
					"content": "簡単なことです——あちらも水仙十字の聖剣を作り直そうとしているんでしょう。水仙十字結社の使命はまだ終わっていませんからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742110
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740742110,
					"content": "さて、ボクたちも最後の一箇所に急ぎましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キャタピラー"
				}
			]
		},
