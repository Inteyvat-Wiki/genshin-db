			"dialogs": [
				{
					"id": 740742001,
					"content": "装置の上の部分を念入りに調べたが、何も見つからなかった。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740742002
					]
				},
				{
					"id": 740742002,
					"content": "ここも、なんにもないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742003
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740742003,
					"content": "キャタピラー、あたしたちは何を探してるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742004
					],
					"speakerTitle": "アン"
				},
				{
					"id": 740742004,
					"content": "水仙十字聖剣を作る材料を探しているんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742005
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740742005,
					"content": "水仙十字結社は地下の国と古代フォンテーヌの神秘主義哲学によって、物質世界に必要な四種類の架空物質を再現しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742006
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740742006,
					"content": "理解できません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742007
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 740742007,
					"content": "神秘的なものはそもそも、体験によってのみ作用するんです。元素力以上に、普通の枠にはまらないものだとも言えます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742008
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740742008,
					"content": "数十年前、私は教令院素論派の入門から中級教材を記録しましたが、元素力はさほど神秘的なものではありませんでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742009
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 740742009,
					"content": "そうですか。とにかく結論から言えば、フォンテーヌに伝わる古来からの手法と地下の古国の技術の結晶というわけです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742010
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740742010,
					"content": "そうして世界には「記憶」、「願い」、「霊魂」、「人格」という四種の物{RUBY#[D]サブスタンス}質が現れました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742011
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740742011,
					"content": "複数の解釈を避けるため、「記憶」「願い」「霊魂」「人格」にそれぞれピースを分けて考えましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742012
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740742012,
					"content": "どうしてそんなもので聖剣を作るんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742013
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740742013,
					"content": "水仙十字結社の神秘主義哲学では、神殿は宇宙の縮図であり、メンバーは神々の代行者であり、聖油は鍛え抜かれた意志ですからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742014
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740742014,
					"content": "そして聖剣はすべてを切り開く「理性」です。これは完璧なる人の意志から生まれる必要があります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742015
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740742015,
					"content": "うさんくさいな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740742016
					]
				},
				{
					"id": 740742016,
					"content": "まあまあ、神秘主義哲学とはこういうものですよ。類似性のあるものは何でも取り入れて、それが魔法になった暁には、すべての偽りが真実に変わるんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742017
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740742017,
					"content": "とにかく、次のところへ急ぎましょうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キャタピラー"
				}
			]
		},
