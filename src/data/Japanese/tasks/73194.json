			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940801,
					"content": "城内の混雑地域では、盗難を防ぐため金銭を多量に持ち歩かないように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940802
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 731940802,
					"content": "また、盗難の被害を受けた際は、付近を巡回しているエルマイト旅団には助けを求めないように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940803
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 731940803,
					"content": "あなたの金銭を奪ったのは、彼らである可能性が高いからだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告知板"
				}
			]
		},
		{
			"id": 7319409,
			"completionStepIds": [
				7319409
			],
			"beginWay": "TALK_BEGIN_MANUAL",
