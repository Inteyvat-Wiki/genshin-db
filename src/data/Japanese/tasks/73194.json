			},
			"dialogs": [
				{
					"id": 731940901,
					"content": "賞金首：カシム",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940902
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 731940902,
					"content": "この自称有名人、かつ自称諸国を渡り歩く大泥棒は、実際には大ぼら吹きの詐欺師であり、エルマイト旅団の実力ランキングでもまったくの無名だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940903
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 731940903,
					"content": "最近この者が関わる詐欺事件が多発しているため、だまされないように十分警戒すること。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告知板"
				}
			]
		},
		{
