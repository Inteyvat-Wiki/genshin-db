			"dialogs": [
				{
					"id": 731941001,
					"content": "賞金首：ムスタ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941002
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 731941002,
					"content": "この者は教令官を偽ってバザール港各所に現れ、恐喝やキャラバンからの略奪を行ったため、現在レグザー庁が調査中である。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941003
					],
					"speakerTitle": "告知板"
				},
				{
