	"talks": [
		{
			"id": 7319401,
			"completionStepIds": [
				7319401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319401",
							"2"
						],
						"stepId": 7319401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940101,
					"content": "こちらは教令官が設置した告知板です。スメールシティ内の重要事項がここに掲示されます。質問があればメッセージを残してください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告知板"
				}
			]
		},
		{
			"id": 7319402,
			"completionStepIds": [
				7319402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319402",
							"2"
						],
						"stepId": 7319402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940201,
					"content": "「聞いたか？あるレンジャーに聞いたんだが、北の森にいつの間にか豪華な宮殿が建ってるらしいぞ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940202
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 731940202,
					"content": "「でも、そこに行ったヤツは最終的に無一文にされて、レンジャー長に発見された時はパンツ一丁だったらしい。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940203
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 731940203,
					"content": "「そいつらに何があったのか聞いても、何も言わずに泣いてるだけなんだとさ。怖すぎないか。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940204
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 731940204,
					"content": "「みんな、無暗に森の中を走り回るんじゃないぞ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告知板"
				}
			]
		},
		{
			"id": 7319403,
			"completionStepIds": [
				7319403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319403",
							"2"
						],
						"stepId": 7319403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940301,
					"content": "スメール内外の重要な告知は、今後アーカーシャを通じて通達されることとなった。各自常に「アーカーシャ端末」を身に着け、重要な告知を見逃さないように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940302
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 731940302,
					"content": "なお、外国の貿易商や高齢者、子供のために、この告知板はしばらく継続される。将来的に撤去される可能性があるため、過度に依存しないように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告知板"
				}
			]
		},
		{
			"id": 7319404,
			"completionStepIds": [
				7319404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319404",
							"2"
						],
						"stepId": 7319404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940401,
					"content": "本年度の「豊沃の恵」の配布が開始された。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940402
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 731940402,
					"content": "配布は原則として、前年度の配布政策と要件を踏襲して行われる。具体的な内容はすでにアーカーシャを通じて通達済みである。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940403
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 731940403,
					"content": "もし前年度から変更があれば、急ぎ近隣の教令官に申し出て、教令院に変更申請を行うこと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告知板"
				}
			]
		},
		{
			"id": 7319405,
			"completionStepIds": [
				7319405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319405",
							"2"
						],
						"stepId": 7319405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940501,
					"content": "最近城内で「魔鱗病」が多発している。もし皮膚のしびれ、手足の脱力などの症状、あるいは体に灰黒色の鱗のような組織が見られた場合、直ちにビマリスタンへ行き治療を受けるように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940502
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 731940502,
					"content": "適切な治療時期を逃すと、病状が悪化し、行動能力を失うなどの重篤な結果を招く可能性があるため、重々注意すること。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告知板"
				}
			]
		},
		{
			"id": 7319406,
			"completionStepIds": [
				7319406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319406",
							"2"
						],
						"stepId": 7319406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940601,
					"content": "注意！！スメールにおけるすべての傭兵業は「エルマイト旅団」が独占的に請け負い、例外は存在しない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940602
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 731940602,
					"content": "うまい話を信じて、身元不明の輩から仲介料をだまし取られないように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940603
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 731940603,
					"content": "ボディガード、守衛、その他の依頼が必要な際は、「三十人団」の伝令官ルコシャ、または教令院の連絡員エフェンディまで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告知板"
				}
			]
		},
		{
			"id": 7319407,
			"completionStepIds": [
				7319407
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319407",
							"2"
						],
						"stepId": 7319407,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940701,
					"content": "ビマリスタンはアムリタ学院傘下の医療サービス機関で、スメール内外の住民に無料で医療を提供しています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940702
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 731940702,
					"content": "当院の就業医はすべて生論派から医師免許を与えられ、診療プランもアーカーシャで複数回の審査を経たものです。住民の皆さまに最も専門的で安全なサービスを提供します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940703
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 731940703,
					"content": "住民の皆さまは、身元不明の医者を信じてお金と大事な命を失うことのないよう、十分お気をつけください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告知板"
				}
			]
		},
		{
			"id": 7319408,
			"completionStepIds": [
				7319408
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319408",
