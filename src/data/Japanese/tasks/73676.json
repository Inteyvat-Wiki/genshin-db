				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"バヌ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736760101,
					"content": "#どう、{M#お兄さん}{F#お姉さん}、未来星は見つかった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760102
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736760102,
					"content": "未来星を六つとも見つけたよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760103
					]
				},
				{
					"id": 736760103,
					"content": "あはっ、良かった、これで大未来星を召喚できるね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760104
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736760104,
					"content": "#{M#お兄さん}{F#お姉さん}、出発前にしっかり準備しておいて。大未来星を召喚するときに予想外のハプニングがあるかもしれないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760105
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736760105,
					"content": "私が特別なことをすると、いつもハプニングが起こるの。私は心の準備ができてるけど、あなたも気をつけてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760106
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736760106,
					"content": "前回は家で大きな黄金の矢を撃ったら、庭で突然爆発が起きたの。もし「リンゴ」が私とシャルマをくわえて逃げてくれなかったら、二人とも悲惨なことになってたと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760107
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736760107,
					"content": "ええっ！？危険すぎだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736760108,
					"content": "でも安心して。一般的には制御可能なトラブルだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760109
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736760109,
					"content": "庭が爆発したんだろ、十分深刻なトラブルじゃんかよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736760110,
					"content": "大丈夫、怖がらないで。準備ができたら、地図の印を付けた場所で合流しよ。私は先に行ってるね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760111
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736760111,
					"content": "#{NICKNAME}、なんだか嫌な予感がするぞ。くれぐれも気をつけないとな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7367603,
			"completionStepIds": [
				7367602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7367602",
							"2"
						],
						"stepId": 7367602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"バヌ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736760301,
					"content": "あっ！最後の仕掛けは一つだけだね。今回の最終試練は簡単そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760302
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736760302,
					"content": "今回？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760303
					]
				},
				{
					"id": 736760303,
					"content": "うん。これまで何回か出会った仕掛けはもっと複雑だったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760304
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736760304,
					"content": "いろんな方法を試してやっと唯一の解除方法に辿り着けるものとか、解き方を間違うと自爆しちゃうものとかもあって、ほんと面倒だったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760305,
						736760306
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736760305,
					"content": "#なんなら{M#君}{F#あなた}がやる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760307
					]
				},
				{
					"id": 736760307,
					"content": "でも私の経験からいうと、この仕掛けはシャルマがよく拾って帰って来る低級の旧式装置と大差ないよ。全部の鍵を差し込むとロックが解除されるタイプのはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760308
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736760308,
					"content": "バヌはいつもこんなヘンテコな仕掛けと付き合ってるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736760309,
					"content": "そうだよ。いつもシャルマと「リンゴ」と一緒にあちこち面白いところに行って、面白いことをしてるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760310
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736760310,
					"content": "今回、未来星を探しに出てきたのも、普段シャルマと一緒に設定を考えるのも、たくさんの意外なことに遭遇するのも、面白くてたまらないんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760311
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736760311,
					"content": "毎日家の玄関の近くをぶらぶらして、毎日同じことをしていたら、つまんないもん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760312
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736760312,
					"content": "#それは同感だな。{NICKNAME}とオイラもよく住み慣れた場所を離れて、目新しい場所に冒険に行くぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736760313,
					"content": "恐ろしい物にもたくさん出くわしたけど、思いがけない喜びがあったり、心を揺さぶられたりすることもあったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760314
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736760314,
					"content": "よかった、私たち、きっといいお友達になれるね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760315
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736760315,
					"content": "でも先に言っておくと、外を駆け回るのは面白いけど危険だってことはわかってるの。だから、しっかり準備はしてるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760316
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736760316,
					"content": "シャルマには、人に助けを求めるときは相手をよく観察するように言われてる。宝盗団、それから知らないエルマイト旅団のおじさんやおばさんたちはダメだって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760317
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736760317,
					"content": "#{M#お兄さん}{F#お姉さん}はいい人に見えたから、助けを求めたの。でもいい人に助けてもらっておいて、ひどい目に遭わせるわけにはいかないでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760318
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736760318,
					"content": "#これが私のルール。だからもし{M#お兄さん}{F#お姉さん}が怖いなら気にしないで、私が自分でこの仕掛けを解いてもいいから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760319,
						736760320
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736760319,
					"content": "まさか、怖いわけない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760321
					]
				},
				{
					"id": 736760321,
					"content": "#それでもいいよ。とにかく{M#お兄さん}{F#お姉さん}、そんなに心配しなくても、未来星を六つ全部仕掛けにはめ込めばいいから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736760320,
					"content": "#少し危険だから、やっぱり{M#俺}{F#私}がやろう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760321
					]
				},
				{
					"id": 736760306,
					"content": "急に用事を思い出した。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760307
					]
				}
			]
		},
		{
			"id": 7367604,
			"completionStepIds": [
				7367604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7367604",
							"2"
						],
						"stepId": 7367604,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"シャルマ",
					"バヌ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736760401,
					"content": "バヌ、ケガはないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760402
					],
					"speakerTitle": "シャルマ"
				},
				{
					"id": 736760402,
					"content": "このくらい、怖くなんかないよ。あなたが書いた本でも、かなわないときはすぐに逃げろって教わったもん。とっくに近くに隠れてたから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760403
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736760403,
					"content": "ところでシャルマ、どうして「リンゴ」まで連れて来たの？彼女は今、きちんとお留守番をしてるはずでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760404
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736760404,
					"content": "「リンゴ」はお前を心配して、ついてきたんだよ。ほら、彼女はお前とママの言うことしか聞かないだろ。私がいくら言っても帰らないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760405,
						736760406
					],
					"speakerTitle": "シャルマ"
				},
				{
					"id": 736760405,
					"content": "ちょっと待って…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760407
					]
				},
				{
					"id": 736760407,
					"content": "バヌは突然飛び出してきたリシュボラン虎と知り合いみたいだな。「リンゴ」って呼んでたぞ…それにリシュボラン虎と一緒に現れたこの人…一体どうなってんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736760408,
					"content": "#{M#お兄さん}{F#お姉さん}、紹介するね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760409
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736760409,
					"content": "この慌てん坊さんがシャルマ。私が貸してあげた『遊学者が知っておくべき50のこと』はシャルマが書いたものなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760410
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736760410,
					"content": "本当は大未来星の召喚の儀式の後にシャルマと「リンゴ」を紹介しようと思ってたんだけど、やっぱり今回もハプニングが起きちゃったね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760411
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736760411,
					"content": "まあ、探す手間が省けたからいっか。今回のハプニングはちょうど良かったね。次もこんなラッキーだといいな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760412
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736760412,
					"content": "初めまして、バヌの生物学的な意味での父親、シャルマです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760413
					],
					"speakerTitle": "シャルマ"
				},
				{
					"id": 736760413,
					"content": "「リンゴ」というのはうちの大事な家族の一員で、優雅なメスのリシュボラン虎なんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760414
					],
					"speakerTitle": "シャルマ"
				},
				{
					"id": 736760414,
					"content": "せ、生物学的な意味での父親だって？えっと…それってどういう意味だ？別の意味では、バヌの父親じゃないっていうのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760415
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736760415,
					"content": "その通り。わたくしが思うには、わたくしとバヌは対等な友人です。日常生活においては、バヌと家事を分担する仲間なんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760416
					],
					"speakerTitle": "シャルマ"
				},
				{
					"id": 736760416,
					"content": "父親というのは、こうした身分のほんの一つにすぎません。わたくしは父親よりも、バヌの友人になりたいのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760417
					],
					"speakerTitle": "シャルマ"
				},
				{
					"id": 736760417,
					"content": "先ほどはずっと仕掛けの下の穴に隠れて、あなた方の会話を聞いておりました。こうしてバヌを助けてくれたことに、心から感激しております。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760418
					],
					"speakerTitle": "シャルマ"
				},
				{
					"id": 736760418,
					"content": "どういたしまして。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760419
					]
				},
				{
					"id": 736760419,
					"content": "そういえば、このやたら丁寧な口ぶり…会ったばかりの頃、バヌがなんであんな話し方をしてたのか分かったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760420
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736760420,
					"content": "バヌの言葉遣いや物事の進め方は確かにわたくしと似ていますが、総じてバヌはわたくしよりはるかに優秀な子どもですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760421
					],
					"speakerTitle": "シャルマ"
				},
				{
					"id": 736760421,
					"content": "例えば、彼女が作るビビンバはわたくしが作ったものより一万倍は美味しい。それだけでもう十分すごいことです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760422
					],
					"speakerTitle": "シャルマ"
				},
				{
					"id": 736760422,
					"content": "従って、わたくしはこのように明るく活発で優秀な子どもと過ごす時間をとても大切にしているのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760423
					],
					"speakerTitle": "シャルマ"
				},
				{
					"id": 736760423,
					"content": "彼女が間もなく教令院に入り、毎日研究室にこもって夜中まで頭をかきむしり、四十歳にもならないうちに白髪になって、長期間の不規則な食生活で栄養不良になるのかと思うと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760424
					],
					"speakerTitle": "シャルマ"
				},
				{
					"id": 736760424,
					"content": "たいへん心が痛みます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760425
					],
					"speakerTitle": "シャルマ"
				},
				{
					"id": 736760425,
					"content": "バヌが教令院に入る前に、あらゆる機会を利用して、バヌのために楽しい思い出を残してやらねばなりません。今回の星探しの旅はそのために設計したものです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760460
					],
					"speakerTitle": "シャルマ"
				},
				{
					"id": 736760460,
					"content": "わたくしは地脈やギミック術に関する知識を少し持っているので、この地にすでに存在する装置を利用して、ちょっとしたアレンジを加えてみました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760461
					],
					"speakerTitle": "シャルマ"
				},
				{
					"id": 736760461,
					"content": "シャルマ、ちょっと聞くけど、この前未来星を探してたときも、さっきのも、魔物は全部シャルマがおびき寄せたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760462
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736760462,
					"content": "いやいやいや、あれは…アクシデントだ。私の配慮不足で、お前を危険な目に遭わせてしまった…それにそちらの旅人まで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760463
					],
					"speakerTitle": "シャルマ"
				},
				{
					"id": 736760463,
					"content": "じ…実は、陰からお前を見守るよう、「リンゴ」に頼んだんだ。そちらの冒険者さんに関しては、腕がかなり優れているようだったので、つい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760464
					],
					"speakerTitle": "シャルマ"
				},
				{
					"id": 736760464,
					"content": "はぁ、シャルマって頼りにならないパパだよね。私と「リンゴ」がいなかったらどうするの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760426
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736760426,
					"content": "#{NICKNAME}とオイラも長い間旅をしてるけど、こんな変わったお父さんは初めて見たな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760427
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736760427,
					"content": "変わっていますか？変わったお父さんというのはまさにわたくしのキャラ設定の一つです。その評価はわたくしにとっては最高の褒め言葉ですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760428
					],
					"speakerTitle": "シャルマ"
				},
				{
					"id": 736760428,
					"content": "それも設定の一部なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760429
					]
				},
				{
					"id": 736760429,
					"content": "そうです。でなければ、この狭い世界で、わたくしは平々凡々な他の人と何の違いもなくなってしまいますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760430
					],
					"speakerTitle": "シャルマ"
				},
				{
					"id": 736760430,
					"content": "わたくしがどんなに奇抜な言動をしても、広い世界では普通の人にすぎません。しかしわたくしは、偉大な賢者では持ちえない、でたらめを言う自由を持っているのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760431
					],
					"speakerTitle": "シャルマ"
				},
				{
					"id": 736760431,
					"content": "おお！なんと愉快なことでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760432
					],
					"speakerTitle": "シャルマ"
				},
				{
					"id": 736760432,
					"content": "#{M#お兄さん}{F#お姉さん}、シャルマの言うことに惑わされないで。彼は何かをごまかそうとするとき、こんなでたらめを言うの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760433
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736760433,
					"content": "シャルマ、ちょっと聞くけど、私の大未来星は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760434
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736760434,
					"content": "前に未来星を六つ集めて、最後の仕掛けを解けば、大未来星を召喚できるって言ってたよね。大未来星はどこにあるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760435
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736760435,
					"content": "安心なさい、今回は絶対にバヌをごまかしたりしないから。ほら、大未来星はここだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760436
					],
					"speakerTitle": "シャルマ"
				},
				{
					"id": 736760436,
					"content": "シャルマはポケットから星螺を取り出してバヌに渡した。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						736760437
					]
				},
				{
					"id": 736760437,
					"content": "これが未来星を集めた後、無限に広がる星の海を越えてバヌのもとにやってきた大未来星だ。ほら、表面に白い星が輝いているだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760438
					],
					"speakerTitle": "シャルマ"
				},
				{
					"id": 736760438,
					"content": "この星はお前たちが集めた未来星が集まってできたもので、これがお前の大未来星だ。その開いた黒い穴に耳をあてて聞いてごらん、星海が話しかけてくるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760439
					],
					"speakerTitle": "シャルマ"
				},
				{
					"id": 736760439,
					"content": "わあ！これが大未来星なんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760440,
						736760441
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736760440,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760442
					]
				},
				{
					"id": 736760442,
					"content": "この人の言ってること、でたらめだぞ。これって璃月の浜辺のどこにでもある星螺じゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760443
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736760443,
					"content": "えっ…シャルマ、「星螺」っていうのは別の設定の名前なの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760444
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736760444,
					"content": "オ、オホン…そう言ってもいい。多くの人の設定では「星螺」と呼ばれ、海に生息している。しかし…わたくしの設定では、その名前は「大未来星」だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760445
					],
					"speakerTitle": "シャルマ"
				},
				{
					"id": 736760445,
					"content": "あっ、わかった。シャルマが教令院のゴミの山からあさってきた物と同じだね。私はあれを「バヌの智慧」って呼んだけど、みんなは「アイシャ混沌探知機」って呼んでるもん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760446
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736760446,
					"content": "ありがとう、シャルマ。この大未来星、とっても気に入った！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760447
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736760447,
					"content": "え、それでごまかせるのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760448
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736760448,
					"content": "ごまかすとは人聞きの悪い。誰しも自分なりの世界の見方があります。わたくしから見れば、これこそが星の海を越えてやって来た大未来星なのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760449
					],
					"speakerTitle": "シャルマ"
				},
				{
					"id": 736760449,
					"content": "様々な世界の見方を受け入れるというのも、面白いではありませんか。ましてバヌもこの名前を認めていることですし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760450,
						736760454
					],
					"speakerTitle": "シャルマ"
				},
				{
					"id": 736760450,
					"content": "まったくの詭弁だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760451
					]
				},
				{
					"id": 736760451,
					"content": "#様々な世界の見方を受け入れるか…じゃあ、{NICKNAME}のバッグに入っているミントをモラと見なしていいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760452
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736760452,
					"content": "どうしたの、パイモン…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760453
					]
				},
				{
					"id": 736760453,
					"content": "へへッ、そう考えると、旅の道中がもっと楽しくなると思ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760458
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736760458,
					"content": "お二人とも安心してください。わたくしとてモラのことででたらめは申しません。お二人に支払うべき委託報酬のことで言い逃れはしませんよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760459
					],
					"speakerTitle": "シャルマ"
				},
				{
					"id": 736760459,
					"content": "こちらをお受け取りください。ここ数日バヌの面倒を見てくださってありがとうございます。このご恩は一生忘れません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シャルマ"
				},
				{
					"id": 736760454,
					"content": "それも一理ある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760455
					]
				},
				{
					"id": 736760455,
					"content": "#真に受けるなよ、{NICKNAME}。もしおまえがモラを別の物と見なして勝手に捨てちゃったら、ひどいことになるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760456
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736760456,
					"content": "じゃあダメだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760457
					]
				},
				{
					"id": 736760457,
					"content": "このシャルマってやつは口がうますぎるから、こっちの頭がはっきりしてるうちに早く依頼報酬について切りだそうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760458
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736760441,
					"content": "あのねバヌ、聞いて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760442
					]
				},
				{
					"id": 736760406,
					"content": "一体どういうこと…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760460
					]
				}
			]
		}
	]
}