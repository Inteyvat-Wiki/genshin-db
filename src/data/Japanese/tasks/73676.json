	"talks": [
		{
			"id": 7367601,
			"completionStepIds": [
				7367601
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7367601",
							"2"
						],
						"stepId": 7367601,
						"stateName": "QUEST_STATE_UNFINISHED"
