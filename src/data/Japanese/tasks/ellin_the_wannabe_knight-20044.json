			"dialogs": [
				{
					"id": 200440101,
					"content": "困った…どうすればいいの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440102
					],
					"speakerTitle": "エリン"
				},
				{
					"id": 200440102,
					"content": "なにしてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200440103
					]
				},
				{
					"id": 200440103,
					"content": "今度の騎士選抜のために、訓練してるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440104
					],
					"speakerTitle": "エリン"
				},
				{
					"id": 200440104,
					"content": "…でも、ジン様のような力がないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440105
					],
					"speakerTitle": "エリン"
				},
				{
					"id": 200440105,
					"content": "だから「力」よりも、「コツ」を身につけたほうがいいかなと思ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440106
					],
					"speakerTitle": "エリン"
				},
				{
					"id": 200440106,
					"content": "たとえば、一気にこの杭を全部破壊する方法とか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440107
					],
					"speakerTitle": "エリン"
				},
				{
					"id": 200440107,
					"content": "時間があったら、一緒に考えてほしいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440108,
						200440109
					],
					"speakerTitle": "エリン"
				},
				{
					"id": 200440108,
					"content": "考えてみる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200440110
					]
				},
				{
					"id": 200440110,
					"content": "うん、ゆっくり考えよう、杭は逃げたりしないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440111
					],
					"speakerTitle": "エリン"
				},
				{
					"id": 200440111,
					"content": "勝手に逃げていくのは使われた時間と命だけだよ、ううっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440114
					],
					"speakerTitle": "エリン"
				},
				{
					"id": 200440114,
					"content": "もっと大きな武器、もしくはジン様のように元素の力を使えば、簡単に杭を全部破壊できるかもしれないね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エリン"
				},
				{
					"id": 200440109,
					"content": "二人で壊す…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200440112
					]
				},
				{
					"id": 200440112,
					"content": "団体戦が得意なの？…いつでも仲間がいる人がうらやましいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440113
					],
					"speakerTitle": "エリン"
				},
				{
					"id": 200440113,
					"content": "私みたいな人はひとりで戦う方法を勉強するしかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440114
					],
					"speakerTitle": "エリン"
				}
			]
		},
