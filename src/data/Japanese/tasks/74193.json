			},
			"dialogs": [
				{
					"id": 741930101,
					"content": "#パイモン！{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930102
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 741930102,
					"content": "おお！パシーフだ！また会えて嬉しいぜ！ここでなにやってんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741930103,
					"content": "パシーフ…仕事！パシーフ…へとへと！パシーフ…休憩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930104
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 741930104,
					"content": "えっと…働いてんのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741930105,
					"content": "幽林の枝…幽林の枝…とてもなくなった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930106
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 741930106,
					"content": "幽林の枝？…ってなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741930107,
					"content": "幽林の枝…情報！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930108
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 741930108,
					"content": "柳、集める。霧の道、処理。泉、発信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930109
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 741930109,
					"content": "幽林の枝、霧の道…情報！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930110
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 741930110,
					"content": "霧の幽林道の情報ってこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930111
					]
				},
				{
					"id": 741930111,
					"content": "パシーフ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930112
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 741930112,
					"content": "幽林の枝…とてもなくなった！とても十分の場所！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930113
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 741930113,
					"content": "パシーフ…探す！パシーフ…へとへと！パシーフ…食べる！パシーフ…休憩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930114
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 741930114,
					"content": "幽林の枝…とても十分ない！でも箱、とても十分！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930115
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 741930115,
					"content": "#あっ…パイモン、ありがとう！{NICKNAME}、ありがとう、あげる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930116
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 741930116,
					"content": "また宝箱を探してくれたのか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930117
					]
				},
				{
					"id": 741930117,
					"content": "パシーフ！箱、お宝、おはな、ピカピカ、あまあま、とても十分！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930118
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 741930118,
					"content": "うわぁ～！他のもあるのか？パシーフ、ホントにありがとな！でも…タダでおまえの物をもらうなんて悪いし、オイラたちの物と交換しようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741930119,
					"content": "こう…かん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930120
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 741930120,
					"content": "オイラたちは友達だろ！友達ってのは真心と真心を交換するもんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741930121,
					"content": "だから、オイラたちが幽林の枝？ってやつを探してくるから、それをおまえの物と交換する…どうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741930122,
					"content": "ついでに食べ物も探してあげる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930123
					]
				},
				{
					"id": 741930123,
					"content": "そっか！パシーフは外で一人で暮らしてるからきっと大変だもんな。オイラたちが代わりに食べ物を探してきてやるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741930124,
					"content": "食べ物！タイダルガ！パシーフ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930125
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 741930125,
					"content": "タイダルガが好きなの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930126
					]
				},
				{
					"id": 741930126,
					"content": "タイダルガ！タイダルガ！タイダルガタイダルガタイダルガ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930127
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 741930127,
					"content": "一日で五回も食べるのか？それとも一回で五つ食べるってことか？すごいぞ…オイラより食べれるのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741930128,
					"content": "幽林の枝の情報も教えてくれ！パシーフ、霧の幽林道に行けば見つけられるってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930129
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741930129,
					"content": "メリュジーヌ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930130
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 741930130,
					"content": "幽林の枝…とてもなくなった！とてもたくさん場所！とてもエリニュス！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930131
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 741930131,
					"content": "幽林の枝はエリニュス中にあるってこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930132
					]
				},
				{
					"id": 741930132,
					"content": "#賢い{NICKNAME}！パシーフ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930133
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 741930133,
					"content": "霧…道、おはなたち、幽林の枝も、おはなたち！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930134
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 741930134,
					"content": "幽林の枝…幽林の枝…枝…枝…枝…枝…数！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930135
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 741930135,
					"content": "なるほど…オイラ一発でわかったぜ！幽林の枝がある場所には、霧の幽林道と同じような花が生えてて、全部で六ケ所ある、そうだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930136
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741930136,
					"content": "賢いパイモン！パシーフ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930137
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 741930137,
					"content": "へへっ！これで大丈夫だな！パシーフ、じゃあおまえはしっかり休んでろよ！オイラたちに任せろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930138
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741930138,
					"content": "#パイモン、{NICKNAME}！いいもの！だから、ゆっくり…ゆっくり！パシーフ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パシーフ"
				}
			]
