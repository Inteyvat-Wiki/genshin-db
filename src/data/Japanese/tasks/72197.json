				"points": []
			},
			"dialogs": [
				{
					"id": 721401701,
					"content": "#{NICKNAME}さん！最近はどうですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401702
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721401703,
					"content": "パイモンにセリフを取られた！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401704
					]
				},
				{
					"id": 721401702,
					"content": "元気だぜ、おまえは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401703
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721401705,
					"content": "パイモン、もっとご飯が食べたいみたいだね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401706
					]
				},
				{
					"id": 721401704,
					"content": "ははっ、おまえの返事が遅かったからだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401705
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721401707,
					"content": "パイモンがその「ご飯」だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401708
					]
				},
				{
					"id": 721401706,
					"content": "もちろん、毎日思ってるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401707
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721401708,
					"content": "おい——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401709
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721401709,
					"content": "ぷっ…あっははははっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401710
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721401710,
					"content": "もう、ケンカしないでください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401711
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721401712,
					"content": "何？言ってみて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401714
					]
				},
				{
					"id": 721401713,
					"content": "可能な限り尽力するよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401714
					]
				},
				{
					"id": 721401711,
					"content": "ボクも元気にやってます、でも一つ頼みたいことがあって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401712,
						721401713
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721401714,
					"content": "#はい、他でもない{NICKNAME}さんに、また晶鉱の採掘を頼みたいんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401715
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721401716,
					"content": "信じてる、でも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401717
					]
				},
				{
					"id": 721401715,
					"content": "今度は信じてください、ちゃ～んと報酬は払いますから…信じてくれさえすれば。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401716
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721401718,
					"content": "どうして？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401720
					]
				},
				{
					"id": 721401719,
					"content": "理由を話してくれるって約束した。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401720
					]
				},
				{
					"id": 721401717,
					"content": "でも…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401718,
						721401719
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721401720,
					"content": "そうだ、晶化骨髄が必要な理由をまだ教えてもらってないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401721
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721401722,
					"content": "でも、幕府が晶鉱の市場を独占してる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401724
					]
				},
				{
					"id": 721401723,
					"content": "晶鉱が売れにくいのは知ってるでしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401724
					]
				},
				{
					"id": 721401721,
					"content": "ええと…旅に出てお母さんを探すにはモラが必要だから、晶鉱で稼ごうと思ってるんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401722,
						721401723
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721401725,
					"content": "いつも危ないことをしてる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401727
					]
				},
				{
					"id": 721401726,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYSECOND|INFO_FEMALE_PRONOUN_GIRLSECOND]}の身の安全が心配。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401727
					]
				},
				{
					"id": 721401724,
					"content": "知ってます、販売先は自分で何とかするんで！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401725,
						721401726
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721401727,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401728
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721401728,
					"content": "長次、オイラたちもう友達だろ、な？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401729
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721401729,
					"content": "今回もおまえを助けてやれるかもしれないぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401730
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721401731,
					"content": "どういう理論…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401732
					]
				},
				{
					"id": 721401730,
					"content": "それに報酬を払うって言ったけど、おまえがピンチなら報酬なんて払えないだろ？だから、オイラたちにも状況を理解する権利がある、な？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401731
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721401732,
					"content": "あっ…パイモンの言う通りですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401733
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721401733,
					"content": "晶鉱を集めるのも、全部モラのためじゃありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401734
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721401734,
					"content": "ずっと思ってたんです…お父さんもお母さんも、みんなみたいに「祟り神」の病気に罹ったら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401735
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721401735,
					"content": "この晶鉱で薬を作れると思ったんです…だって、大蛇の骨から出てきたものだから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401736
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721401736,
					"content": "役に立つかも知れないって、保本さんも言ってました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401737
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721401737,
					"content": "でも…あくまで仮説だろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401738
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721401738,
					"content": "はい、でも他に可能性もないですし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401739
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721401739,
					"content": "お母さん…それにお父さんも見つけることができたら、スメールに連れていきたいです。あそこには奇病を治す方法があると聞きました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401740
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721401740,
					"content": "それまで、治療の希望は捨てられません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401741
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721401742,
					"content": "説明しなくても手伝ってた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401744
					]
				},
				{
					"id": 721401743,
					"content": "晶鉱を上手く活用して欲しい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401744
					]
				},
				{
					"id": 721401741,
					"content": "さあ、ボクの説明は以上です、手伝ってくれますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401742,
						721401743
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721401744,
					"content": "ありがとうございます！この恩は忘れません！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "長次"
				}
			]
		},
		{
			"id": 7219718,
