			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"長次"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721971801,
					"content": "#{NICKNAME}さん、おかえりなさい、晶鉱を取ってきましたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721971802,
						721971803
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721971802,
					"content": "取ってきた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 721971803,
					"content": "これから取りに行く。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721971804
					]
				},
				{
					"id": 721971804,
					"content": "急ぐことありません、ボクもちょうど長く休みを取りたかったところです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "長次"
				}
			]
		},
		{
			"id": 7219719,
			"completionStepIds": [
				7219721
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7219721",
							"2"
						],
						"stepId": 7219721,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"長次"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721401901,
					"content": "これだけあれば十分なはずです。ボクは引き続き冒険に出ますね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401902
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721401903,
					"content": "気を付けて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401905
					]
				},
				{
					"id": 721401904,
					"content": "またいつでも相談して。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401905
					]
				},
				{
					"id": 721401902,
					"content": "心配だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401903,
						721401904
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721401905,
					"content": "はい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401906
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721401906,
					"content": "おい、長次、もうでたらめを言っちゃダメだからな！オイラたちじゃなきゃ…痛い目に遭ってたかもしれないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401907
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721401907,
					"content": "それともし悪いやつらに会ったら、適当に誤魔化せ！本当のことは言うなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401908
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721401909,
					"content": "パイモン、おばあちゃんみたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401910
					]
				},
				{
					"id": 721401908,
					"content": "それと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401909
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721401911,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}は信じてる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401912
					]
				},
				{
					"id": 721401910,
					"content": "こんな小さい子供が一人で冒険に行くって言ってるんだ、誰だって心配するだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401911
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721401912,
					"content": "…まったく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401913
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721401913,
					"content": "あはははっ！ありがとうございます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401914
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721401914,
					"content": "また会えるといいですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401915
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721401915,
					"content": "くれぐれも気を付けろよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401916
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721401916,
					"content": "大丈夫ですよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401917
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721401917,
					"content": "これから、たたら砂に向かうつもりです。お母さんが以前そこで働いていましたので。そこなら、お母さんの行方を教えてくれる人がいるかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401918
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721401918,
					"content": "その後は…何とかして鳴神島へ。そしてスネージナヤの商船に乗って…その先は、臨機応変にってとこですかね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401919
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721401920,
					"content": "自分が何を言ってるか分かってる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401922
					]
				},
				{
					"id": 721401921,
					"content": "それがどんなに危険か分かってる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401922
					]
				},
				{
					"id": 721401919,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401920,
						721401921
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721401922,
					"content": "危険を恐れて何もしないんだったら…この世に冒険者もいませんよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401923
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721401924,
					"content": "仕方ない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401926
					]
				},
				{
					"id": 721401925,
					"content": "気を付けて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401926
					]
				},
				{
					"id": 721401923,
					"content": "むむむ…ああ言えばこう言うな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401924,
						721401925
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721401926,
					"content": "ははは、ご安心を！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401927
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721401927,
					"content": "#{NICKNAME}さんたちもお気を付けて！早く家族を見つけられるといいですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401928
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721401928,
					"content": "おう！そうだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
