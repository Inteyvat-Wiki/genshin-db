			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ガイガックス"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706700101,
					"content": "やあ、「風の行方」に参加しないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706700102,
						706700107
					],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706700102,
					"content": "まだ人を集めてるんだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706700103
					]
				},
				{
					"id": 706700103,
					"content": "君だったか！前回「風の行方」で見せてくれた姿…なかなか上手だったから、かなり印象に残ってるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706700104
					],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706700104,
					"content": "でも、君は結構簡単そうに遊んでいたけど、他の人はそうじゃなかったみたいで。ゲームが難しすぎるとか、レンジャーは逃げにくいとか、ハンターは見つけられないとか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706700105
					],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706700105,
					"content": "その上、ハンターに捕まったレンジャーはゲーム終了までやることがなくて、ただ隣でじっと見ることしかできないから、本当につまらないって愚痴ってきた人までいたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706700106
					],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706700106,
					"content": "はあ、その人たちの言ってることが正しいかどうかもわからないからね。もう少し人を集めて遊んでもらって、その意見を聞きたいと思ったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706700120
					],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706700120,
					"content": "コホンッ。これ以上、長々と話していても仕方ない。まずは実際に遊んでみてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706700121,
						706700122
					],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706700121,
					"content": "「風の行方」を遊ぶ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706700123
					]
				},
				{
					"id": 706700123,
					"content": "分かった。もし「風の行方」を遊びたくなったら、またここに来てくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706700122,
					"content": "離れる",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706700123
					]
				},
				{
					"id": 706700107,
					"content": "「風の行方」って？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706700108
					]
				},
				{
					"id": 706700108,
					"content": "いい質問だ。「風の行方」はモンドの歴史が詰まったゲームなんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706700109
					],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706700109,
					"content": "かつて、このモンド城には「貴族」がいたことを君も知っているね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706700110
					],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706700110,
					"content": "彼らはモンド城で数々の悪行を成し、多くの人々を苦しめた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706700111
					],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706700111,
					"content": "そんな貴族たちの悪事に抗うため、勇敢なモンド人が集まった。そして、秘密の反抗組織を作り上げたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706700112
					],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706700112,
					"content": "その勇敢な者たちはモンドで活動を続け、貴族たちを手こずらせた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706700113
					],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706700113,
					"content": "しかし、貴族たちも黙ってはいなかった。すぐさまそれを鎮圧するために、手下たちを訓練したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706700114
					],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706700114,
					"content": "こうして、反抗組織と貴族たちの対決が、モンドの各地で繰り広げられた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706700115
					],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706700115,
					"content": "「風の行方」は、そんな壮大な歴史に基づいて作られたゲームなんだ！昔はとても人気があったんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706700116
					],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706700116,
					"content": "昔は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706700117
					]
				},
				{
					"id": 706700117,
					"content": "ああ、最近の若者はあまり「風の行方」に興味ないみたいでね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706700118
					],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706700118,
					"content": "だが、このまま「風の行方」が廃れていくのを見ているだなんて耐えられない。そこで、元のルールに少し手を加えて、より分かりやすく、そして面白くしてみた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706700119
					],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706700119,
					"content": "さらに、新しいマップもいくつか用意したんだ。これなら、もっと多くの人に興味を持ってもらえるはずだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706700120
					],
					"speakerTitle": "ガイガックス"
				}
			]
		}
	]
}