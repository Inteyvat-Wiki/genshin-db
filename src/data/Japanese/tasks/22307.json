			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"張順"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223070101,
					"content": "どうしたもんか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070102
					],
					"speakerTitle": "張順"
				},
				{
					"id": 223070102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223070103
					]
				},
				{
					"id": 223070103,
					"content": "俺は南十字船隊の船員だったが、運悪く怪我をしてしまってな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070104
					],
					"speakerTitle": "張順"
				},
				{
					"id": 223070104,
					"content": "船隊を辞めた後、生活に必要な金を作るために、博来という名前の商人に数枚の宝蔵図を抵当に入れたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070105
					],
					"speakerTitle": "張順"
				},
				{
					"id": 223070105,
					"content": "本当に宝物があったら、俺の分を残してくれると約束してくれたが、いつになってもそういう情報がなくて、彼は探してないんじゃないかと思って…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070106
					],
					"speakerTitle": "張順"
				},
				{
					"id": 223070106,
					"content": "このままだとどうにもならないから、すまないが、宝物を探してきてくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070107,
						223070109,
						223070116
					],
					"speakerTitle": "張順"
				},
				{
					"id": 223070107,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223070108
					]
				},
				{
					"id": 223070108,
					"content": "じゃあ頼んだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070120
					],
					"speakerTitle": "張順"
				},
				{
					"id": 223070120,
					"content": "まずは<color=#00E1FFFF>博来</color>から<color=#00E1FFFF>宝蔵図</color>をもらって、<color=#00E1FFFF>宝物</color>を直接<color=#00E1FFFF>彼</color>に持っていってほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070121
					],
					"speakerTitle": "張順"
				},
				{
					"id": 223070121,
					"content": "彼とはもう話を通してある。俺の分は残してくれてるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "張順"
				},
				{
					"id": 223070109,
					"content": "どうして船隊を辞めた？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223070110
					]
				},
				{
					"id": 223070110,
					"content": "自分の体は自分が一番知っている。いつ再発するか分からない古傷のせいで船隊に迷惑をかけたくないから、自分で辞めたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070111
					],
					"speakerTitle": "張順"
				},
				{
					"id": 223070111,
					"content": "その後、溜めた金で事業を展開しようとしたが、なかなかうまく行かなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070112
					],
					"speakerTitle": "張順"
				},
				{
					"id": 223070112,
					"content": "俺が持ってた宝蔵図も、前に船隊と一緒に出航した時に手に入れた戦利品なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070113
					],
					"speakerTitle": "張順"
				},
				{
					"id": 223070113,
					"content": "しかし俺の体は歩くだけで精一杯だというのに、探検なんてとても考えられない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070114
					],
					"speakerTitle": "張順"
				},
				{
					"id": 223070114,
					"content": "生活に必要な金を作るために、俺は博来という名前の商人に数枚の宝蔵図を抵当に入れたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070115
					],
					"speakerTitle": "張順"
				},
				{
					"id": 223070115,
					"content": "でも彼も探検に行けそうにないと思う。なにせ彼は普通の商人だからな…だから、宝探しの件はお前に頼みたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070107,
						223070116
					],
					"speakerTitle": "張順"
				},
				{
					"id": 223070116,
					"content": "豪華な宝物があるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223070117
					]
				},
				{
					"id": 223070117,
					"content": "ハハハッ、それはないと思うぞ。宝蔵図は船隊に配られた戦利品だからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070118
					],
					"speakerTitle": "張順"
				},
				{
					"id": 223070118,
					"content": "本当に豪華な宝物があったら、配る前に船隊の者が謎を解いて宝物を持って帰っただろうからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070119
					],
					"speakerTitle": "張順"
				},
				{
					"id": 223070119,
					"content": "でも、豪華な宝物じゃなくても、多少金にはなるはずだ。少なくとも三人で分けるには十分だ…だから、宝探しの件は頼むよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070120
					],
					"speakerTitle": "張順"
				}
			]
		},
