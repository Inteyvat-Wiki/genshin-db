			"trigger": {
				"objectNames": [
					"アランガル",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730580101,
					"content": "金色のナラ、白いふわふわ！また会ったな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580102
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730580102,
					"content": "うわっ、今度急に出てくる時は先に一声かけろよな！またびっくりしちゃったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580103,
						730580104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730580103,
					"content": "#{M#俺}{F#私}たちは悪いやつじゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580105
					]
				},
				{
					"id": 730580105,
					"content": "へえ…確かに話の筋は通ってる…それで、悪いヤツには見えない金色のナラと、白いふわふわ。もう一回助けてもらえないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580106
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730580106,
					"content": "#喜んで。{M#俺}{F#私}は{NICKNAME}だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580107
					]
				},
				{
					"id": 730580107,
					"content": "オイラはパイモン。今度は忘れるなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730580108,
					"content": "今度…？んん…ゴホンッ、ボクはアランガル！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580109
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730580109,
					"content": "#オイラたち、おまえと一緒にここに来たことあるんだ。おまえは忘れちゃったみたいだけどさ…えっと、うまく説明できないや！{NICKNAME}も一緒に説明してやってくれよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730580110,
					"content": "アランガルに冒険の思い出を話した。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730580111
					]
				},
				{
					"id": 730580111,
					"content": "そうか…覚えてないけど、何故だか信じてみようって気になった…しかもオマエらはボクのあげた花を持ってる。カノジョがそこにいる気配がするよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580112
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730580112,
					"content": "あ、そうだ！悪いナラが野営地を残していった。そこに何があるか見に行きたいんだ。ヤツらの企みが分かるかもしれない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730580104,
					"content": "悪いやつを追い払ってあげた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580105
					]
				}
			]
		},
		{
			"id": 7305802,
			"completionStepIds": [
				7305804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
