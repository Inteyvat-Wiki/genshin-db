			"trigger": {
				"objectNames": [
					"アランガル",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730580201,
					"content": "どうだ？何か見つかったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580202
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730580202,
					"content": "うーん…どこの言葉かはよく分からないけど、命令を見つけたぞ。それとこれ！ドライフラワー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730580203,
					"content": "わあ…！これ、もらっていいか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580204
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730580204,
					"content": "悪いやつの忘れ物だぞ。毒とかあるかもしれないのに…怖くないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730580205,
					"content": "心配するな。この花には見覚えがある…そいつ、会ったことあるはずなんだ…頼むからボクにくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580206
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730580206,
					"content": "どうぞ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580207
					]
				},
				{
					"id": 730580207,
					"content": "#ありがとう！ナラ{NICKNAME}と白いふわふわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580208
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730580208,
					"content": "アランガルは風に乾いた小さな花をマウティーマ稠林まで持っていた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7305804,
