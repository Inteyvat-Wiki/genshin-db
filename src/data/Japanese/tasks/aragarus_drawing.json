			"dialogs": [
				{
					"id": 730580401,
					"content": "悪いナラのキャンプに行ってみたら、ヤツらの目的が分かるはず！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580402
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730580402,
					"content": "悪い奴をどうやって見分けるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580403
					]
				},
				{
					"id": 730580403,
					"content": "#うーん…さあ？うまく説明できないけど、ナラ{NICKNAME}と白いふわふわが悪い奴じゃないのはわかるぞ！アランガルは信じてる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランガル"
				}
			]
		},
