						230381102
					],
					"speakerTitle": "マルフ"
				},
				{
					"id": 230381102,
					"content": "た、旅人くん？どうしてここに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381103
					],
					"speakerTitle": "マルフ"
				},
				{
					"id": 230381103,
					"content": "ザカリヤ先生から薬をもらってきた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230381104
					]
				},
				{
					"id": 230381104,
					"content": "それじゃあ、俺の話も聞いたんだな。恥ずかしい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381105
					],
					"speakerTitle": "マルフ"
				},
				{
					"id": 230381105,
					"content": "それよりまず薬を飲んで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230381106
					]
				},
				{
					"id": 230381106,
					"content": "ああ…わかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381107
					],
					"speakerTitle": "マルフ"
				},
				{
					"id": 230381107,
					"content": "マルフは薬を飲んだ…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230381108
					]
				},
				{
					"id": 230381108,
					"content": "ふぅ…少し気分がよくなった。ザカリヤ先生の医術はやはり、ずば抜けているな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381109
					],
					"speakerTitle": "マルフ"
				},
				{
					"id": 230381109,
					"content": "どうして処方をいじったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230381110
					]
				},
				{
					"id": 230381110,
					"content": "この前お前と一緒に薬を作っただろう？なぜだかわからないが、あの薬にはあまり効き目がなくてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381111
					],
					"speakerTitle": "マルフ"
				},
				{
					"id": 230381111,
					"content": "作り方に間違いがあったか、何か生薬が足りなかったせいじゃないかと考えて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381112
					],
					"speakerTitle": "マルフ"
				},
				{
					"id": 230381112,
					"content": "そこでその…自分の経験に基づいて、薬を煎じ直したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381113
					],
					"speakerTitle": "マルフ"
				},
				{
					"id": 230381113,
					"content": "念のため、まず自分で試しに薬を飲んでみたら、この通りだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381114
					],
					"speakerTitle": "マルフ"
				},
				{
					"id": 230381114,
					"content": "ザカリヤ先生に薬を処方してもらえるよう、さっき別の人に頼んだところだったんだが。こんなに早く薬を届けてもらえるとは思わなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381115
					],
					"speakerTitle": "マルフ"
				},
				{
					"id": 230381115,
					"content": "ありがとう、旅人くん。もう少し休んだら、診療を再開するよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381116
					],
					"speakerTitle": "マルフ"
				},
				{
					"id": 230381116,
					"content": "長い間休診していたから、村ではきっと多くの患者が待っているに違いない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381117
					],
					"speakerTitle": "マルフ"
				},
				{
					"id": 230381117,
					"content": "はあ、でも生薬がまた足りなくなってるみたいだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マルフ"
				}
			]
		}
	]
