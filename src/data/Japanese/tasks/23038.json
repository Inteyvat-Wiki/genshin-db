			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ザカリヤ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230380101,
					"content": "おお、旅人君！早くこちらに来てください。手伝ってもらいたいことがあるんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380102
					],
					"speakerTitle": "ザカリヤ"
				},
				{
					"id": 230380102,
					"content": "何があったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230380103
					]
				},
				{
					"id": 230380103,
					"content": "マルフを覚えていますか？前に処方箋を書いてくれと頼んできた、あのアアル村の医者ですが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380104
					],
					"speakerTitle": "ザカリヤ"
				},
				{
					"id": 230380104,
					"content": "彼、自分で煎じた薬を試しに飲んでみたところ、何日も吐いたり下したりしているそうなんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380105
					],
					"speakerTitle": "ザカリヤ"
				},
				{
					"id": 230380105,
					"content": "聞いてみると、患者に薬湯を飲ませても効果がなかったので、突然の思いつきで自分で処方を変更したのだそうですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380106
					],
					"speakerTitle": "ザカリヤ"
				},
				{
					"id": 230380106,
					"content": "いったい薬湯にどんな生薬を入れたら、こんなことになるんだか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380107
					],
					"speakerTitle": "ザカリヤ"
				},
				{
					"id": 230380107,
					"content": "やれやれ…もし元の薬湯を基本に生薬の割合と薬湯の作り方を調整しただけなら、絶対にそんなことにはならないはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380108
					],
					"speakerTitle": "ザカリヤ"
				},
				{
					"id": 230380108,
					"content": "彼がこんなバカな真似をするのは初めてではありませんが、何でまた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380109
					],
					"speakerTitle": "ザカリヤ"
				},
				{
					"id": 230380109,
					"content": "まあいいです。彼にも彼なりの苦しい胸の内があるのかもしれないですしね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380110
					],
					"speakerTitle": "ザカリヤ"
				},
				{
					"id": 230380110,
					"content": "旅人君、もしよければ、生薬を集めてきてもらえませんか？今度は私が薬を作るので、直接マルフに持って行ってやってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380111,
						230380112
					],
					"speakerTitle": "ザカリヤ"
				},
				{
					"id": 230380111,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230380114
					]
				},
				{
					"id": 230380114,
					"content": "マルフが今回変えた処方箋は、前回頭痛の治療用に私が彼に処方したものです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380115
					],
					"speakerTitle": "ザカリヤ"
				},
				{
					"id": 230380115,
					"content": "赤念の実があと3つ足りなくて…すみませんが、採ってきてくれませんか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ザカリヤ"
				},
				{
					"id": 230380112,
					"content": "前もこんなことがあったの。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230380113
					]
				},
				{
					"id": 230380113,
					"content": "ええ、これでもう何度目になることか。強い薬の処方でなくてよかったです。もしそうだったら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380114
					],
					"speakerTitle": "ザカリヤ"
				}
			]
		},
