			},
			"dialogs": [
				{
					"id": 721230602,
					"content": "まったくお前らも運がないな。こんな筋骨隆々な人と戦うはめになるとは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230603
					],
					"speakerTitle": "秀秋"
				},
				{
					"id": 721230603,
					"content": "恥知らず者ども、ファデュイと結託するなんて、鳴神様の罰がいずれあなたたちに下るでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230604
					],
					"speakerTitle": "幸"
				},
				{
					"id": 721230604,
					"content": "こ、これしきで怯むと思うなよ。俺の商売を台無しにした上、俺を捕まえる気か！そうはさせねぇ！最後の手段がまだある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "秀秋"
				}
			]
		},
		{
			"id": 7212307,
