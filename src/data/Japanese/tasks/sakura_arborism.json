					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"幸"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230301,
					"content": "何か発見はありましたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230302
					],
					"speakerTitle": "幸"
				},
				{
					"id": 721230302,
					"content": "秀秋について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230303
					]
				},
				{
					"id": 721230303,
					"content": "そんなことが？でも宝盗団だけで、本当にここまでひどいことになりますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230304
					],
					"speakerTitle": "幸"
				},
				{
					"id": 721230304,
					"content": "もしかしたら、雷櫻が枯れた原因は他にもあるかもしれません…少し思い当たる点もあるのですが、それが正しいかどうかは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230305
					],
					"speakerTitle": "幸"
				},
				{
					"id": 721230305,
					"content": "どういう意味？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230306
					]
				},
				{
					"id": 721230306,
					"content": "ここは神無塚、字の通り稲妻人の信仰も珊瑚宮の人の信仰もない場所です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230307
					],
					"speakerTitle": "幸"
				},
				{
					"id": 721230307,
					"content": "目狩り令が出された後、幕府軍と抵抗軍がしきりにここで衝突しました。軍にいる人たちにとって、雷櫻への影響は関係ありませんから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230308
					],
					"speakerTitle": "幸"
				},
				{
					"id": 721230308,
					"content": "神子様の言葉を借りるなら、彼らは「頭の中に手柄しかないやつら」なのです、話が通じません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230309
					],
					"speakerTitle": "幸"
				},
				{
					"id": 721230309,
					"content": "神社も予想はしていましたが、雷櫻の状態がここまで悪化するとは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230310
					],
					"speakerTitle": "幸"
				},
				{
					"id": 721230310,
					"content": "とにかく、最優先にすべきことは宝盗団の件を処理することです。旅人、今回もお願いできますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230311,
						721230313
					],
					"speakerTitle": "幸"
				},
				{
					"id": 721230311,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230312
					]
				},
				{
					"id": 721230312,
					"content": "油断しないようにしてください。雷櫻が弱まっている今は危険なのです。何しろ、木の下にはあの方の…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230315
					],
					"speakerTitle": "幸"
				},
				{
					"id": 721230315,
					"content": "あっ、余計なことを言ってしまいました。い、今のは忘れてください。とにかく、お気を付けを。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230316
					],
					"speakerTitle": "幸"
				},
				{
					"id": 721230316,
					"content": "私には状況を整理する時間が必要です。この件はまだ不審な点がありますので。いったい、裏で宝盗団を指揮しているのは誰なのでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230317
					],
					"speakerTitle": "幸"
				},
				{
					"id": 721230317,
					"content": "複雑になってきましたね。なかなかに厄介です…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "幸"
				},
				{
					"id": 721230313,
					"content": "処理するのは簡単だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230314
					]
				},
				{
					"id": 721230314,
					"content": "おそらく、そう簡単にはいきません。雷櫻が弱まっている今は危険なのです。何しろ、木の下にはあの方の…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230315
					],
					"speakerTitle": "幸"
				}
			]
		},
		{
			"id": 7212304,
			"completionStepIds": [
				7212314
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7212314",
							"2"
						],
						"stepId": 7212314,
