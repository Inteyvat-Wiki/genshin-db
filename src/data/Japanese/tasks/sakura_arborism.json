				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"秀秋"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230204,
					"content": "こ、殺さないでくれ。俺は雷櫻とは何の関係もない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230205
					],
					"speakerTitle": "秀秋"
				},
				{
					"id": 721230205,
					"content": "なんでオイラたちが雷櫻のことで来たって知ってるんだ？やっぱり、なにかやましいことがあるんだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721230206,
					"content": "たぶん、この無相の雷みたいなものも、おまえらが悪いことして手に入れたんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721230207,
					"content": "お…お前たちには関係ないだろう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230208
					],
					"speakerTitle": "秀秋"
				},
				{
					"id": 721230208,
					"content": "依頼を受けた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230209
					]
				},
				{
					"id": 721230209,
					"content": "そうだ、オイラたちは依頼を受けて、正義のためにやってるんだ！宝盗団が雷櫻になにをしたのか、これらをどこから持って来たのか、正直に教えろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721230210,
					"content": "正直に言わなければ…ふふん、旅人の剣さばきはすごいから覚悟しとけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721230211,
					"content": "言う！言うから！その、ここの樹は誰も管理してないから、その力を拝借して儲けても大丈夫かと思ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230212
					],
					"speakerTitle": "秀秋"
				},
				{
					"id": 721230212,
					"content": "あるすごい買い手が雷櫻に興味を持ってるんだ、それに雷櫻の力を引き出す方法と工具まで用意してくれた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230213
					],
					"speakerTitle": "秀秋"
				},
				{
					"id": 721230213,
					"content": "買い手の言う通り樹に穴を開けたら…へへっ、工具で雷櫻の力を汲み取るのは簡単だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230214
					],
					"speakerTitle": "秀秋"
				},
				{
					"id": 721230214,
					"content": "そして、その力をこの結晶に注ぎ込んだ。それと引き換えに、天領奉行の屋敷三軒分に匹敵するお宝は手に入れたのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230215
					],
					"speakerTitle": "秀秋"
				},
				{
					"id": 721230215,
					"content": "買い手から貰った報酬はすごかったぜ。お前みたいなヤツじゃ、一生掛けても使いきれないほどだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230216
					],
					"speakerTitle": "秀秋"
				},
				{
					"id": 721230216,
					"content": "大目に見てくれたら、お前にも分け前をやろう。その時は一対九でお前が一割、俺が九割だ。どうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230217,
						721230218
					],
					"speakerTitle": "秀秋"
				},
				{
					"id": 721230217,
					"content": "少なすぎる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230219
					]
				},
				{
					"id": 721230219,
					"content": "は？ちっ、俺が譲歩してやったというのに。買い手が来たら、お前らは泣きながらこの俺様に許しを乞うことになるだろう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230220
					],
					"speakerTitle": "秀秋"
				},
				{
					"id": 721230220,
					"content": "ずいぶんと上から目線だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230221
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721230221,
					"content": "チビ、何を言ってやがる？俺の仲間がすぐに助っ人を連れてくる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230222
					],
					"speakerTitle": "秀秋"
				},
				{
					"id": 721230222,
					"content": "たとえ100人呼んできても、オイラの髪一本触れないぞ。旅人がおまえらを全員追っ払うからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230223
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721230223,
					"content": "山田、このチビはお前らじゃ傷ひとつ付けられないと言ってるぞ。それでも手を出さないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230224
					],
					"speakerTitle": "秀秋"
				},
				{
					"id": 721230224,
					"content": "山田？誰のことだ…まずい！旅人、早く！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230225
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721230225,
					"content": "って、え？誰もいないんじゃないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721230218,
					"content": "夢でも見たんじゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230219
					]
				}
			]
		},
		{
			"id": 7212303,
			"completionStepIds": [
				7212306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7212306",
							"2"
						],
						"stepId": 7212306,
