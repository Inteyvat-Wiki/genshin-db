			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"幸"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230401,
					"content": "雷櫻の状況はどうですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230402
					],
					"speakerTitle": "幸"
				},
				{
					"id": 721230402,
					"content": "全部処理した。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230403
					]
				},
				{
					"id": 721230403,
					"content": "よかった、これで雷櫻も安定するはずです。神子様も安心できます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230404
					],
					"speakerTitle": "幸"
				},
				{
					"id": 721230404,
					"content": "あの無法者たちが利益のため雷櫻の力を盗むなんて、許されることではありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230405
					],
					"speakerTitle": "幸"
				},
				{
					"id": 721230405,
					"content": "宝盗団の拠点には、雷櫻の力を保存する結晶があると言いましたよね？それはとても危険です、なるべく早く処理をしないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230406
					],
					"speakerTitle": "幸"
				},
				{
					"id": 721230406,
					"content": "これまで色々と助けていただき、本当にお世話になりました。あなた一人に行動させるのは申し訳ないですから、今回は私も同行します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230407
					],
					"speakerTitle": "幸"
				},
				{
					"id": 721230407,
					"content": "それでは、さっそく行きましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "幸"
				}
			]
		},
