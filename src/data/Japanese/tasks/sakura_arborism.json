				"points": []
			},
			"dialogs": [
				{
					"id": 721230501,
					"content": "ふん、金儲けの邪魔をしてるのはお前か。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230502
					],
					"speakerTitle": "秀秋"
				},
				{
					"id": 721230502,
					"content": "あなたたち、本当に恐れ知らずですね。雷櫻に手を出せば、神子様が容赦しませんからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230503
					],
					"speakerTitle": "幸"
				},
				{
					"id": 721230503,
					"content": "大口を叩くな。誰を怒らせたのか思い知らせてやる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230504
					],
					"speakerTitle": "秀秋"
				},
				{
					"id": 721230504,
					"content": "旦那、商売の邪魔をしてるのはあそこの旅人です。何とかしないと商売も危ないですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230505
					],
					"speakerTitle": "秀秋"
				},
				{
					"id": 721230505,
					"content": "くく…その貧弱な体で、俺を前にしても見栄を張る勇気があるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ファデュイ先遣隊"
				}
			]
		},
		{
			"id": 7212306,
			"completionStepIds": [
				7212317
			],
			"beginWay": "TALK_BEGIN_AUTO",
