			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"小巻"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721500101,
					"content": "こんにちは、若者よ。その格好、島の外から来たんじゃな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500102,
						721500103
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500102,
					"content": "うん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500104
					]
				},
				{
					"id": 721500104,
					"content": "四方を転々とする旅人かのう？では…この先の道を、占ってみる気はないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500105
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500105,
					"content": "えっ、この先の道を占う…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500106,
						721500107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721500106,
					"content": "この先の道を占う…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500108
					]
				},
				{
					"id": 721500108,
					"content": "ふふ、そう緊張するでない。ごめんね、ちょっと唐突すぎたかもしれんわい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500109
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500109,
					"content": "私が言いたかったのは、我々望瀧村の海祇祠はとても御利益があるから、お前さんを占いに誘いたいということなんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500110
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500110,
					"content": "この先の道が危険であるという意味はない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500111
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500111,
					"content": "もちろん…たった何文字かの言葉で、私たちの道が分かるわけもないわい…ふふ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500112
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500112,
					"content": "ただの占いだったのか…なら安心だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721500113,
					"content": "お金はいる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500114
					]
				},
				{
					"id": 721500114,
					"content": "ふふ、必要ないよ。私たちはこういうことにお金を取ることはない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500115
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500115,
					"content": "祠を手入れする者が、「願い」のために通りかかった旅人からお金を取るなんぞ、大御神の魂を不安定にしてしまうじゃろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500116
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500116,
					"content": "同じ凡人として、他人の「願い」から利益を得ようなど、誰にそんな資格があると言うんじゃ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500117
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500117,
					"content": "うぅ…たしかにその通りだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721500118,
					"content": "それじゃ、お二人さんは占いに興味はないかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500119
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500119,
					"content": "試してみる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500120
					]
				},
				{
					"id": 721500120,
					"content": "ふふ、どうもありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500121
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500121,
					"content": "ここ最近はどこも物騒でね。村の若者も外で忙しくしておる。ここに若者が来るのを見られて、私は嬉しいんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500122
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500122,
					"content": "しかも、外国から来たというのに、海祇島の伝統に尊敬の意を抱いているとは、とても偉いことじゃ。ふふふ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500123
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500123,
					"content": "さあ、お喋りはここまでにして。占いじゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500124
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500124,
					"content": "その前に、お二人さんがよければ、一つ手伝いをしてくれぬか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500125
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500125,
					"content": "なんだよ、やっぱりお金か！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721500126,
					"content": "ふふ、お金じゃないわい…とりあえず話を聞いておくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500127
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500127,
					"content": "望瀧村の祠に御利益があるのは、そこに供養されている「海淵霊草」によるものなんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500128
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500128,
					"content": "その名の通り、この植物は深い海の底に生えておる…そこは、我々の祖先の起源でもあるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500129
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500129,
					"content": "数千年前、村の先人たちがそれを深海から陸地へ移植し、大切に育てたんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500130
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500130,
					"content": "それを村の人々が代々守ってきた…戦乱、天災、大御神逝去の悲劇…その長寿な「霊草」はどんな災いの中もくぐり抜けてきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500131
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500131,
					"content": "水の底に生息する植物には、水源を頻繁に与える必要があった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500132
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500132,
					"content": "漆黒の環境を生きるその生物は、淡い燐光を永遠に放つ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500133
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500133,
					"content": "そのため、光を放つ規則から、願いが実現できるかを判断する。その神秘の中心となるのが、水源となるんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500134
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500134,
					"content": "ふふ、若い巫女たちはいつも占い儀式の信憑性を疑うんじゃ。こんな民間の儀式が正式なものでなく、迷信だと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500135
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500135,
					"content": "彼女らはもっと分かりやすい理論的なものを好み、私たち年寄りが伝えてきた伝説は好まない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500136
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500136,
					"content": "じゃがのう…年寄りの知恵、代々伝わってきた知恵は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500137
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500137,
					"content": "明確な理論に分類されることはできんかもしれぬが、時に無視できない真理が隠れてることがあるんじゃよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500138
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500138,
					"content": "水源について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500139
					]
				},
				{
					"id": 721500139,
					"content": "水源…？おっと！ふふふ…ごめんね、年を取ると、話も長くなってしまうわい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500140
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500140,
					"content": "「霊草」を供養するには、島にある神社奉納池の水が必要じゃ。あそこの水は「願い」を含んでいるからのう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500141
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500141,
					"content": "「願い事」…水にもそんなものがあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500142
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721500142,
					"content": "ふふ、そうじゃ。一人一人の「願い」が奉納池に蓄積し、ハチミツのように水に溶けていく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500143
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500143,
					"content": "誰も見たことはない…しかし水の濃度と甘さで感じ取ることができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500144
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500144,
					"content": "記憶も、信仰も…そういう道理なんじゃよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500145
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500145,
					"content": "それと、水を汲む時は、気を付けるんじゃ…「願い」の効力は、奉納池を離れるとすぐに空気中に消えてしまう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500146
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500146,
					"content": "夢が年を追うごとに消えていくように…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500147
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500147,
					"content": "手触りや重さから、「願い」の衰弱を感じ取ることができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500148
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500148,
					"content": "わっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500149
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721500149,
					"content": "そうなんだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500150
					]
				},
				{
					"id": 721500150,
					"content": "ふふ、ごめんね、また話が逸れちゃったよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500151
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500151,
					"content": "とにかく、水を汲んだら、できるだけ早く帰ってくるんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500152
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500152,
					"content": "じゃないと、「願い」の効力が消えて、「霊草」からも十分な養分が取れないからね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500153
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500153,
					"content": "それが終わったら、私にもう一度声をかけておくれ…「霊草」を供養するにはもう一歩加える必要がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500154
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500154,
					"content": "面倒だな！手伝ってくれる巫女さんとかいないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500155
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721500155,
					"content": "はぁ…今の若い巫女はみんな面倒がって、古臭い伝統なんて信じない。手伝ってくれる人なんて本当に少ないんじゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500156
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500156,
					"content": "「霊草」の光が日に日に暗くなっていくのを見て…私は誰よりもがっかりしてるんじゃよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500157
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500157,
					"content": "でもやっぱり面倒だぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500158
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721500158,
					"content": "巫女さんたちの気持ちが分かった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500159
					]
				},
				{
					"id": 721500159,
					"content": "それで、水を汲んできてくれないかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500160
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500160,
					"content": "手伝うよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500161
					]
				},
				{
					"id": 721500161,
					"content": "それじゃ頼んだよ、本当にありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500107,
					"content": "この先が危険なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500108
					]
				},
				{
					"id": 721500103,
					"content": "こんにちは、おばあさん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500104
					]
				}
			]
		},
		{
			"id": 7215002,
