			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"小巻",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721500201,
					"content": "おかえり。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500202
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500202,
					"content": "必要なものを取ってきた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500203
					]
				},
				{
					"id": 721500203,
					"content": "奉納池の浄水だ、すっごく新鮮だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721500204,
					"content": "本当にありがとう。今すぐ水を「霊草」にあげるからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500205
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500205,
					"content": "この前どこまで言ったか…そうじゃ、「霊草」をさらに輝かせるには、あと一歩必要じゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500206
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500206,
					"content": "深海の水元素が豊富な環境の中でのみ、「霊草」の茎と葉が十分に伸び、「願い」の色の輝きを現すことができるんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500207
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500207,
					"content": "簡単に言えば…北にある洞窟の中に、その生存環境の水質と最も近い水元素が生存しておる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500208
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500208,
					"content": "そして洞窟内も、区域によって濃度が違ってくる…中でも一番理想的な濃度の水元素は、清く透明なものじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500209
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500209,
					"content": "もし他の生物などに邪魔されて、それが濁っていたら…とても厄介じゃな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500210
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500210,
					"content": "はぁ、年を取ると、道理を説明するのも一苦労じゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500211
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500211,
					"content": "やっぱり直接見た方が分かりやすいじゃろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500212
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500212,
					"content": "あの洞窟は我々望瀧村の先祖の秘密と深くかかわっている…ただ惜しいことに、近ごろの戦争のせいで、あそこの水を汲んで「霊草」を育てる若者もほとんどいなくなった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500213
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500213,
					"content": "はぁ…若者といえば…彼らが無事に帰ってこられるといいんじゃが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500214
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500214,
					"content": "ところで、若者よ。もし水を汲みに行くのなら、安全には注意するんじゃよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500215
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500215,
					"content": "おう、安心してくれ、小巻ばあちゃん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500216,
						721500217
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721500216,
					"content": "気をつける。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500218
					]
				},
				{
					"id": 721500218,
					"content": "そうかい、ならいいんじゃ…ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500217,
					"content": "安心して。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500218
					]
				}
			]
		},
		{
			"id": 7215003,
