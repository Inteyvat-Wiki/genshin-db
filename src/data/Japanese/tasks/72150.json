				"points": []
			},
			"dialogs": [
				{
					"id": 721500401,
					"content": "こんにちは、若者よ。その格好、島の外から来たんじゃな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500402,
						721500403
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500402,
					"content": "うん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500404
					]
				},
				{
					"id": 721500404,
					"content": "四方を転々とする旅人かのう？では…この先の道を、占ってみる気はないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500405
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500405,
					"content": "えっ、この先の道を占う…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500406,
						721500407
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721500406,
					"content": "この先の道を占う…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500408
					]
				},
				{
					"id": 721500408,
					"content": "ふふ、そう緊張するでない。ごめんね、ちょっと唐突すぎたかもしれんわい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500409
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500409,
					"content": "私が言いたかったのは、我々望瀧村の海祇祠はとても御利益があるから、お前さんを占いに誘いたいということなんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500410
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500410,
					"content": "この先の道が危険であるという意味はない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500411
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500411,
					"content": "もちろん…たった何文字かの言葉で、私たちの道が分かるわけもないわい…ふふ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500412
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500412,
					"content": "ただの占いだったのか…なら安心だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721500413,
					"content": "お金はいる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500414
					]
				},
				{
					"id": 721500414,
					"content": "ふふ、必要ないよ。私たちはこういうことにお金を取ることはない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500415
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500415,
					"content": "祠を手入れする者が、「願い」のために通りかかった旅人からお金を取るなんぞ、大御神の魂を不安定にしてしまうじゃろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500416
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500416,
					"content": "同じ凡人として、他人の「願い」から利益を得ようなど、誰にそんな資格があると言うんじゃ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500417
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500417,
					"content": "うぅ…たしかにその通りだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500418
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721500418,
					"content": "それじゃ、お二人さんは占いに興味はないかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500419
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500419,
					"content": "試してみる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500420
					]
				},
				{
					"id": 721500420,
					"content": "ふふ、どうもありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500421
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500421,
					"content": "ここ最近はどこも物騒でね。村の若者も外で忙しくしておる。ここに若者が来るのを見られて、私は嬉しいんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500422
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500422,
					"content": "しかも、外国から来たというのに、海祇島の伝統に尊敬の意を抱いているとは、とても偉いことじゃ。ふふふ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500423
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500423,
					"content": "さあ、お喋りはここまでにして。占いじゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500424
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500424,
					"content": "その前に、お二人さんがよければ、一つ手伝いをしてくれぬか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500425
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500425,
					"content": "なんだよ、やっぱりお金か！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500426
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721500426,
					"content": "ふふ、お金じゃないわい…とりあえず話を聞いておくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500427
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500427,
					"content": "望瀧村の祠に御利益があるのは、そこに供養されている「海淵霊草」によるものなんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500428
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500428,
					"content": "その名の通り、この植物は深い海の底に生えておる…そこは、我々の祖先の起源でもあるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500429
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500429,
					"content": "数千年前、村の先人たちがそれを深海から陸地へ移植し、大切に育てたんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500430
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500430,
					"content": "それを村の人々が代々守ってきた…戦乱、天災、大御神逝去の悲劇…その長寿な「霊草」はどんな災いの中もくぐり抜けてきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500431
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500431,
					"content": "水の底に生息する植物には、水源を頻繁に与える必要があった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500432
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500432,
					"content": "漆黒の環境を生きるその生物は、淡い燐光を永遠に放つ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500433
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500433,
					"content": "そのため、光を放つ規則から、願いが実現できるかを判断する。その神秘の中心となるのが、水源となるんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500434
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500434,
					"content": "ふふ、若い巫女たちはいつも占い儀式の信憑性を疑うんじゃ。こんな民間の儀式が正式なものでなく、迷信だと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500435
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500435,
					"content": "彼女らはもっと分かりやすい理論的なものを好み、私たち年寄りが伝えてきた伝説は好まない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500436
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500436,
					"content": "じゃがのう…年寄りの知恵、代々伝わってきた知恵は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500437
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500437,
					"content": "明確な理論に分類されることはできんかもしれぬが、時に無視できない真理が隠れてることがあるんじゃよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500438
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500438,
					"content": "水源について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500439
					]
				},
				{
					"id": 721500439,
					"content": "水源…？おっと！ふふふ…ごめんね、年を取ると、話も長くなってしまうわい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500440
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500440,
					"content": "「霊草」を供養するには、島にある神社奉納池の水が必要じゃ。あそこの水は「願い」を含んでいるからのう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500441
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500441,
					"content": "「願い事」…水にもそんなものがあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500442
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721500442,
					"content": "ふふ、そうじゃ。一人一人の「願い」が奉納池に蓄積し、ハチミツのように水に溶けていく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500443
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500443,
					"content": "誰も見たことはない…しかし水の濃度と甘さで感じ取ることができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500444
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500444,
					"content": "記憶も、信仰も…そういう道理なんじゃよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500445
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500445,
					"content": "それと、水を汲む時は、気を付けるんじゃ…「願い」の効力は、奉納池を離れるとすぐに空気中に消えてしまう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500446
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500446,
					"content": "夢が年を追うごとに消えていくように…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500447
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500447,
					"content": "手触りや重さから、「願い」の衰弱を感じ取ることができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500448
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500448,
					"content": "わっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500449
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721500449,
					"content": "そうなんだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500450
					]
				},
				{
					"id": 721500450,
					"content": "ふふ、ごめんね、また話が逸れちゃったよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500451
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500451,
					"content": "とにかく、水を汲んだら、できるだけ早く帰ってくるんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500452
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500452,
					"content": "じゃないと、「願い」の効力が消えて、「霊草」からも十分な養分が取れないからね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500453
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500453,
					"content": "それが終わったら、私にもう一度声をかけておくれ…「霊草」を供養するにはもう一歩加える必要がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500454
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500454,
					"content": "面倒だな！手伝ってくれる巫女さんとかいないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500455
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721500455,
					"content": "はぁ…今の若い巫女はみんな面倒がって、古臭い伝統なんて信じない。手伝ってくれる人なんて本当に少ないんじゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500456
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500456,
					"content": "露子のこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500457
					]
				},
				{
					"id": 721500457,
					"content": "おう、珊瑚宮にいるあの巫女さん、いっつも人を見下してる感じなんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500458
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721500458,
					"content": "おお、彼女に会ったことがあるのかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500459
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500459,
					"content": "ふふ、彼女はね…実力はあるんじゃが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500460
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500460,
					"content": "ふふ…多くは言わないでおこう。若者も、いつか伝統物語の意味が分かる日が来る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500461
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500461,
					"content": "うーん…なんだよ…全然わからない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500462
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721500462,
					"content": "「霊草」の光が日に日に暗くなっていくのを見て…私は誰よりもがっかりしてるんじゃよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500463
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500463,
					"content": "でもやっぱり面倒だぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500464
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721500464,
					"content": "巫女さんたちの気持ちが分かった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500465
					]
				},
				{
					"id": 721500465,
					"content": "それで、水を汲んできてくれないかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500466
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500466,
					"content": "手伝うよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500467
					]
				},
				{
					"id": 721500467,
					"content": "それじゃ頼んだよ、本当にありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500407,
					"content": "この先が危険なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500408
					]
				},
				{
					"id": 721500403,
					"content": "こんにちは、おばあさん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500404
					]
				}
			]
		},
