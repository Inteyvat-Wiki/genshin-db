				"points": []
			},
			"dialogs": [
				{
					"id": 721500301,
					"content": "おお、お前さんたち、こっちに来て休んでいきなさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500302
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500302,
					"content": "小巻ばあちゃん、前言ってた水、汲んできたぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721500303,
					"content": "これが「最も理想的な水」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500304
					]
				},
				{
					"id": 721500304,
					"content": "そうじゃ、それだけあれば足りる。本当にご苦労さん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500305
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500305,
					"content": "ふふ、だいぶ元気になったみたいじゃな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500306
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500306,
					"content": "「霊草」の光彩から見て…来年はきっと平和で豊かな年になる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500307
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500307,
					"content": "えっ…なんでわかるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721500308,
					"content": "「霊草」の光彩は、水の光沢と人々の「願い」を養分としておる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500309
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500309,
					"content": "この霊光は人々の願いの具現なんじゃ。願いが美しいものであれば、光も鮮やかになり、未来も希望に溢れるものとなる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500310
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500310,
					"content": "より良い明日というものは…誰もが願うことなんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500311
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500311,
					"content": "今の生活がもっと良くなるために、何かしたいと思う願いがあれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500312
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500312,
					"content": "戦争の影響も、どうってことないものとなる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500313
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500313,
					"content": "うーん…それとご利益になにか関係があるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500314
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721500314,
					"content": "もちろん…これは私たち年寄りの知恵なんじゃよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500315
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500315,
					"content": "「願い」は人の行動を導く。そして行動の成果は「願い」を検証する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500316
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500316,
					"content": "私たちが平和を守る限り…暗い日々でも生活の希望を守る限り…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500317
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500317,
					"content": "「霊草」の占いは永遠に御利益のあるものとなる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500318,
						721500319
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500318,
					"content": "適当な感じで迷信を説明してるような…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500320
					]
				},
				{
					"id": 721500320,
					"content": "ふふ、いずれ若者にも分かるよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500321
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500321,
					"content": "それと、水中の「願い」の効力はまだ何日か続くじゃろう、よかったら、いつでも占いに来ておくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小巻"
				},
				{
					"id": 721500319,
					"content": "道理がないわけじゃない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500320
					]
				}
			]
		},
		{
