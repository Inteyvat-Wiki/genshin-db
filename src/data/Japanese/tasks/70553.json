					{
						"sceneId": 51208,
						"position": [
							2198.789,
							230.089,
							-777.793
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705530101,
					"content": "おっ！我らが栄誉騎士もヘルターに「確保」されて、手伝いに駆り出されたってわけか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530102
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530102,
					"content": "さっきドリンクスポットの話をしてた時にメニューを見たんだが、その時から飲みたくてウズウズしてたんだ。成果を確かめるには、今がちょうどいい機会だろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530103
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530103,
					"content": "広場で二杯ほどひっかけてきたばかりだがな…体に障らない範囲なら、酒は飲めるだけ飲むのが俺の信条だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530104
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530104,
					"content": "もう一段落したことだし、これからは気楽に楽しもう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530105,
						705530106
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530105,
					"content": "あくまで対等な雇用関係だよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530107
					]
				},
				{
					"id": 705530107,
					"content": "そりゃすごい。なら、お手並み拝見といこうか！じっくり語り合えて、それでいてパンチの効いた酒を一杯頼む…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530108,
						705530109
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530108,
					"content": "難しすぎる！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530110
					]
				},
				{
					"id": 705530110,
					"content": "何もおかしいことはない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530111
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530111,
					"content": "「パンチの効いた」ってのは一気に飲み干せないってことだ。でも「語り合う」以上、喉が焼けるほど辛くてもいけない。後味は甘めがいいな。その絶妙なバランスが肝心なんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530112
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530112,
					"content": "酒のリストの中で一番のお勧めは「棘の鏡湖」だな。どこの酒場でも出してる、度数の高い定番カクテルだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530113
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530113,
					"content": "もちろん、レシピを知ってるだけじゃダメだ。肝心なのは作り方だからな…バーテンダーによって、頑なに伝統を守る奴もいれば、自分なりの解釈を加える奴もいる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530114,
						705530115
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530114,
					"content": "#じゃあ、{M#俺}{F#私}も作ってみる！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530116
					]
				},
				{
					"id": 705530116,
					"content": "いい気迫だな！腕の見せどころだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530115,
					"content": "レシピを確認したら、すぐ始めるね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530116
					]
				},
				{
					"id": 705530109,
					"content": "本気でそんな試練を課すつもりなの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530110
					]
				},
				{
					"id": 705530106,
					"content": "#{M#俺}{F#私}は天才バーテンダーだからね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530107
					]
				}
			]
		},
		{
			"id": 7055302,
			"completionStepIds": [
				7055306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
