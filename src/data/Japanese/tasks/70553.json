						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ファルカ"
				],
				"points": [
					{
						"sceneId": 51208,
						"position": [
							2200.306,
							230.219,
							-779.82
						],
						"pointId": 1
					},
					{
						"sceneId": 51208,
						"position": [
							2198.789,
							230.089,
							-777.793
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705530201,
					"content": "大団長、この「棘の鏡湖」の出来栄えを確認して！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530202
					]
				},
				{
					"id": 705530202,
					"content": "うん、色合いと香りは申し分ないな。アルコール度数のほうは…一口飲めば分かるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530203
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530203,
					"content": "なかなかいいな、素材の配分もかなり正確だ。だが惜しいことに、ちと「正直すぎる」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530204,
						705530205
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530204,
					"content": "正直？お酒が？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530206
					]
				},
				{
					"id": 705530206,
					"content": "もちろん、素直さの「正直」だ！お前はレシピ通り…いや、むしろ慎重すぎるくらい正確に「棘の鏡湖」を調合した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530207
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530207,
					"content": "まるで心配してるみたいだ…酒の味が少し違うからって、俺が失望すると思うか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530208,
						705530209
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530208,
					"content": "確かに。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530210
					]
				},
				{
					"id": 705530210,
					"content": "俺たちはこれまで肩を並べて戦い、神様でさえ手を焼く厄介事を一緒に片付けてきた。互いに命を預け合う仲だろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530211
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530211,
					"content": "遠慮なんて必要ない。天才バーテンダーの腕を存分に振るって、俺を驚かせてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530212,
						705530213
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530212,
					"content": "じゃあ、思い切って改良してみるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530214
					]
				},
				{
					"id": 705530214,
					"content": "ゆっくりでいいさ、急ぐことはない！話しながら考えてみよう。お前がどんなひらめきを酒に加えるのか楽しみだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530215
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530215,
					"content": "「正直さ」以外に、この「棘の鏡湖」に問題はある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530216
					]
				},
				{
					"id": 705530216,
					"content": "そうだな…もう一つ気になったのは「インパクト」が足りないってことだ。同じレシピでも、材料のブレンド方法一つで味わいが変わってくる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530217
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530217,
					"content": "時には、酒の層を意図的に分けることで、打ち付ける「荒波」のように、二つの味わいを際立たせることもできる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530218
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530218,
					"content": "そういう意味では、お前もかなり繊細な手法を使ってるな。もっと大胆にやってみたらどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530219,
						705530220
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530219,
					"content": "なんとなく…分かったかも？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530221
					]
				},
				{
					"id": 705530221,
					"content": "はっはっは！一発で分かるとは、さすがだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530222
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530222,
					"content": "そのジョッキは…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530223
					]
				},
				{
					"id": 705530223,
					"content": "なかなかいいだろ？ハンマーの頭みたいな形で、酒も飲めるし、釘も打てるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530224
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530224,
					"content": "これは十数人の騎士たちがなけなしの金を出し合って、俺のために用意してくれた贈り物でな、ホフマンがアイデアを出し、チャールズが設計して、ワーグナーが鋳造を手伝った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530225
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530225,
					"content": "みんな、俺と思いっきり酒を飲む日を待ちわびてたんだ。この酒杯こそ、俺があいつらと公平に対決するための大切な「武器」さ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530226,
						705530227
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530226,
					"content": "…公平？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530228
					]
				},
				{
					"id": 705530228,
					"content": "俺は大団長だからな。酒歴はあいつらより長いし、鍛え方も違う。ガタイだって俺のほうがある…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530229
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530229,
					"content": "だから、俺は一杯で多く飲まないと、部下たちに不公平だろ？理にかなってると思わないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530230,
						705530231
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530230,
					"content": "その杯だと「多めの一杯」どころじゃ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530232
					]
				},
				{
					"id": 705530232,
					"content": "もちろん、酒歴が俺と同じくらいのやつもいる。そいつらを甘やかすつもりはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530233
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530233,
					"content": "例えば「ヘーゼル03」とか「ヘーゼル05」とかな。こいつらは昔、俺と一緒に、二発ほど痛いのをイロックにお見舞いしてやった腕利きだ。今そいつらには、ジンの雑務を手伝わせてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530234
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530234,
					"content": "今日仕事終わりの飲み会で、その二人が俺に飲み比べを挑んできたんだが、結局、ダーツに負けすぎて酔い潰れちまったよ、はっはっは！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530235
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530235,
					"content": "もうジンには伝えておいた——絶対に明日、あいつらに休暇の許可をやるなってな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530236
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530236,
					"content": "庭園と酒場じゃ、飲む雰囲気も違うしね。環境に合わせて、植物の香りを取り入れてみるのはどう？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530237
					]
				},
				{
					"id": 705530237,
					"content": "ほう、なかなかセンスがあるじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530238
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530238,
					"content": "この庭園を見てると、昔のことを思い出すんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530239
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530239,
					"content": "若い頃の俺は、遺跡守衛相手に拳や剣の修練をするのが好きでな…ある時、あいつらのミサイルを逸らし損ねて、流れ弾で城壁の見張り塔を吹き飛ばしちまったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530240
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530240,
					"content": "罰として城の周りを五十周走り、見張り塔を修理した後、この庭園で壊れた壁の修復まで手伝わされた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530241,
						705530242
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530241,
					"content": "なかなか大変だったみたいだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530243
					]
				},
				{
					"id": 705530243,
					"content": "若かった頃にやらかした失敗の中でも、特にその一件は印象に残ってる…なんたってあの日、クリプスが泥まみれの俺を見かけちまったんだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530244
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530244,
					"content": "あいつは百年物の酒を二本持ってきて、ディルックに…今のミカよりも若いディルックに…俺の見張りをしてたフェルを引き離させた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530245
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530245,
					"content": "あの日は本当に暑くて…日射病になりそうだった…ふと思いついて、むしり取ったミントの葉を酒瓶にねじ込んでみたら…それが驚くほど美味かったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530246
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530246,
					"content": "クリプスも同じように試したところ、何度も俺を褒めてくれた。そして俺の思いつきを、正式なレシピに加えたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530247
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530247,
					"content": "客からの評判もすこぶるよくてな！その夏から何年過ぎてもクリプスは手紙をよこして、俺に配当を支払うって言ってきてた…さすがに、受け取るわけにはいかなかったが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530248,
						705530249
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530248,
					"content": "随分昔のことみたいだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530250
					]
				},
				{
					"id": 705530250,
					"content": "そうだな、クリプスは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530251
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530251,
					"content": "フェルはもう何年も前に退職したってのに、俺に会うたび険しい顔をしてくるんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530252
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530252,
					"content": "ははっ、あの石頭め…後任のディルックも、その後のガイアも、文句なしの働きぶりだ。新時代は若者が担っていく。いい加減、丸くなってもらいたいもんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530253
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530253,
					"content": "今度機会があったら、ガイアにあいつを連れて行かせて、騎兵小隊の目覚ましい発展ぶりを見せてやるとするか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530254
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530254,
					"content": "そういえば、この庭園もイベントの人気スポットになったよね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530255
					]
				},
				{
					"id": 705530255,
					"content": "はっはっは、この庭園は騎士団が長年手入れしてきた大切な場所だからな。イベントを開くなら、ここが一番ふさわしい場所だろう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530256
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530256,
					"content": "聞いてるぞ。遠征隊が留守にしてる間、お前が奔走してくれたおかげで、みんな羽を伸ばす機会がたくさんあったって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530257
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530257,
					"content": "時々、俺もイベントで撮った写真を見返すんだ。残念ながら、みんなが写ってるわけじゃないがな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530258
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530258,
					"content": "結論としては、もっとモンドに写真機を普及させるべきだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530259
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530259,
					"content": "大団長が遠征に行かなかったら、イベントはどうなってたんだろう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530260
					]
				},
				{
					"id": 705530260,
					"content": "俺がイベントを仕切るってことか？そりゃあ…毎回お題に美酒を絡めるか、イベントの中に宴会をねじ込むことになりそうだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530261
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530261,
					"content": "例えば、今回のドリンクスポットを拡大して、街全体に開放する。そして、各小隊から代表のバーテンダーを一人から数人出して、腕を競い合うってのは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530262,
						705530263
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530262,
					"content": "やっぱりそうなっちゃうか…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530264
					]
				},
				{
					"id": 705530264,
					"content": "はっはっは、そうは言ってもただ妄想だ！あまり派手にやるわけにはいかない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530265
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530265,
					"content": "大宴会なんて開こうもんなら、ジンが剣を持って押しかけてくるからな…いや、フレデリカまで俺の討伐に加わることになるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530266
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530266,
					"content": "たとえナド・クライでも、ルールはルールだ。当番中の隊員は絶対に酔っちゃいけない。もしそれを破れば、職務放棄というとんでもない不始末になりかねないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530267,
						705530268
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530267,
					"content": "それは正しいと思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530269
					]
				},
				{
					"id": 705530269,
					"content": "ああ。遠征隊のメンバーが各小隊に戻るにつれて、この習慣も少しずつ根付いていくことを願おう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530270
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530270,
					"content": "炎水とかサワークリームとか、ナド・クライの特産品がモンドの家庭に浸透して、生活習慣の一部になったようにな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530271
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530271,
					"content": "若い連中も、自然と自制することを覚える必要がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530272,
						705530273
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530272,
					"content": "大団長にこんな一面があったなんて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530274
					]
				},
				{
					"id": 705530274,
					"content": "要するに、酒に弱いくせに強がるなってことだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530275
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530275,
					"content": "俺の三割も飲めないのに、平日を「ほろ酔いで楽しむ」なんて百年早い。絶対に潰れちまう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530276
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530276,
					"content": "あいつらは週末、俺とゆっくり練習だな、はっはっは！全員へべれけにして、一週間は酒を見たくなくなるよう仕込んでやる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530277
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530277,
					"content": "感動するのはちょっと早かったみたい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530278
					]
				},
				{
					"id": 705530278,
					"content": "方向性が見えてきたから、ジョッキ貸して。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530279
					]
				},
				{
					"id": 705530279,
					"content": "おお？もちろんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530280
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530280,
					"content": "この構え、ただものじゃないな…大当たりを引きそうな予感がする…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530273,
					"content": "これが酒豪のメリハリか…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530274
					]
				},
				{
					"id": 705530268,
					"content": "趣味は仕事の邪魔になっちゃいけない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530269
					]
				},
				{
					"id": 705530263,
					"content": "大団長らしいね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530264
					]
				},
				{
					"id": 705530249,
					"content": "#{M#俺}{F#私}がモンドに来るずっと前のことだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530250
					]
				},
				{
					"id": 705530242,
					"content": "大団長にもそんなカッコ悪い時があったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530243
					]
				},
				{
					"id": 705530231,
					"content": "公平の基準を間違えてない…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530232
					]
				},
				{
					"id": 705530227,
					"content": "…対決？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530228
					]
				},
				{
					"id": 705530220,
					"content": "そんな細かいところ、気付かなかった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530221
					]
				},
				{
					"id": 705530213,
					"content": "そう言われたら全力でやるしかないね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530214
					]
				},
				{
					"id": 705530209,
					"content": "大団長は酒通だし、変な調整はできない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530210
					]
				},
				{
					"id": 705530205,
					"content": "お酒の「ストレート」とかけたギャグ…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530206
					]
				}
			]
		},
		{
			"id": 7055303,
