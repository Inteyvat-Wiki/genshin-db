						],
						"pointId": 1
					},
					{
						"sceneId": 51208,
						"position": [
							2198.789,
							230.089,
							-777.793
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705530301,
					"content": "特製カクテルを受け取って、大団長！今回はとことん楽しめるはずだよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530302
					]
				},
				{
					"id": 705530302,
					"content": "どうなってるんだ、この気迫…押し寄せる炎水の香りで、空気に火がつきそうだ…そう来なくちゃな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530303
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530303,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530304
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530304,
					"content": "たまらないな！感じたぞ…遠慮を捨てた、お前の本気の実力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530305
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530305,
					"content": "口に含んだ瞬間、ミントの清涼感が陽動を仕掛け、炎水の気配を一時的に消してる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530306
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530306,
					"content": "そして甘みが消えた頃には、もう炎水が喉を通り過ぎていて、強烈なアルコールの香りが口の中で一気に広がる。これこそ、俺の求めてた刺激だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530307,
						705530308
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530307,
					"content": "それからサワークリームで締めると…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530309
					]
				},
				{
					"id": 705530309,
					"content": "それがまさに絶妙なところだ！炎水は後味が物足りなくて、味がないに等しいとまで批判されてきた。だが、サワークリームがその熱烈なピークを維持してくれるってわけか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530310,
						705530311
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530310,
					"content": "そんなに褒められると照れちゃうな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530312
					]
				},
				{
					"id": 705530312,
					"content": "信じられん…炎水を飲まないバーテンダーが、こんな極上の一品を作るとはな。モンドとナド・クライ、双方で名酒として名を馳せるだけの実力があると思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530313,
						705530314,
						705530315
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530313,
					"content": "「北風騎士」は狼を象徴してるよね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530316
					]
				},
				{
					"id": 705530316,
					"content": "「狼と鉄」…いいじゃないか！上品かつ豪快、まさにお前らしい名前だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530317
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530317,
					"content": "そうだな…これからは騎士団のドリンクスポットを、お前の称号を冠にして「栄誉騎士の特製バー」って呼ぶか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530318
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530318,
					"content": "善は急げだ、早速ヘルターの弟子に掛け合ってくるか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705530314,
					"content": "騎士団は鉄のように不屈…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530316
					]
				},
				{
					"id": 705530315,
					"content": "酒の名前は「狼と鉄」でどう？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530316
					]
				},
				{
					"id": 705530311,
					"content": "大団長と話してたら思いついたんだ。",
					"roleType": "TALK_ROLE_PLAYER",
