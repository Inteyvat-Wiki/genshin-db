			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"バートランド"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726940401,
					"content": "材料集めは順調か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940402
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726940402,
					"content": "全部、収集器に入れた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940403
					]
				},
				{
					"id": 726940403,
					"content": "よし、じゃあ今から集めた素材をこの唯一無二絶対安定…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940404
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726940404,
					"content": "「大工機」な。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726940405,
					"content": "ああ、分かったよ。集めた素材をこの「大工機」に入れよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940406
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726940406,
					"content": "バートランドは収集器を「大工機」に繋げた",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						726940407
					]
				},
				{
					"id": 726940407,
					"content": "それで、次はどうするんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726940408,
					"content": "もしかして、ウィーーンって音を出した後、ピカーンって光っておもちゃが完成するのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940409
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726940409,
					"content": "あっはっはっ、それはもちろん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940410
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726940410,
					"content": "ありえないだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940411
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726940411,
					"content": "何を考えてるんだ。三つの工程のうちまだ一つしか終わってないだろ。おもちゃが完成するのはまだまだ先だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940412
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726940412,
					"content": "そ…そっか。全部の工程を終わらせないといけないんだったんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726940413,
					"content": "そうだ。三つの工程を順に従って行うことで初めて、おもちゃが出来る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940414,
						726940415
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726940414,
					"content": "面倒くさい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940416
					]
				},
				{
					"id": 726940416,
					"content": "言わせてもらうが、おもちゃの製造は忍耐強さが大切だ。どの工程においても、製造者の…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940417
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726940417,
					"content": "製造者の？あっ、わかったぞ。「おもちゃ」を作るんだから、もちろん製造者の情熱を注ぎ込むんだよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940418
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726940418,
					"content": "モラに対する情熱を注ぎ込むんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940419
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726940419,
					"content": "あ…あれ、オイラの想像と違ってたけど…その情熱ならオイラにもあるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940420
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726940420,
					"content": "まったく…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940421
					]
				},
				{
					"id": 726940421,
					"content": "えへへ、ちょっとノッてみただけだって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940422
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726940422,
					"content": "バートランド、この後はなにをすればいいんだ？次の工程に移ればいいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940423
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726940423,
					"content": "そう焦る必要はない。このマシンは調整後のものだから、まだすべての工程をやったことがないんだ。まずは、素材処理に問題がないか確認しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940424
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726940424,
					"content": "観察にはしばらく時間が掛かるから、少し経ったらまた来てくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726940415,
					"content": "複雑…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940416
					]
				}
			]
		},
