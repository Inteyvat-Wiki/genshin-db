			},
			"dialogs": [
				{
					"id": 726940501,
					"content": "一個売ってこれだけのモラを稼げるということは…借金を返済するには二万個売ればいいんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940502
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726940502,
					"content": "これで、借金を返すのは楽勝だ…ん？君たちは？どうかしたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940503,
						726940505
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726940503,
					"content": "何を売ってるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940504
					]
				},
				{
					"id": 726940504,
					"content": "おもちゃを売ろうとしてるんだ。だが…あいにく商品はまだ準備中でな。製造が終わったら、また来てくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726940505,
					"content": "分かった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940506
					]
				},
				{
					"id": 726940506,
					"content": "なら邪魔しないでくれ。今、商品の準備で忙しいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "バートランド"
				}
			]
		}
	]
