			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"キャサリン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726940101,
					"content": "旅人さんにパイモンさん、ちょうどいいところにいらっしゃいました！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940102
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 726940102,
					"content": "ちょうどいいところ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726940103,
					"content": "あなた方にぴったりな依頼があるんです。ちょうど今、連絡を取ろうと思っていたところでして。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940104
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 726940104,
					"content": "オイラたちにぴったりな依頼…まさか、また物探しとか、ヒルチャール退治とかじゃないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940105,
						726940106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726940105,
					"content": "あと屋上のゴミ拾いとか…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940107
					]
				},
				{
					"id": 726940107,
					"content": "いえいえ、今回の依頼は本当にあなた方にぴったりなんです。どう「ぴったり」かと言うと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940108
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 726940108,
					"content": "この仕事は面白そうに見えるだけでなく、報酬も豪華なんです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940109
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 726940109,
					"content": "報酬が豪華！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726940110,
					"content": "面白いってところはスルーなんだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940111
					]
				},
				{
					"id": 726940111,
					"content": "も…もちろん、面白いのが一番大事だぜ。それで、どんな依頼なんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726940112,
					"content": "はい、今回の依頼主は稲妻で商売をされているバートランドさんという方になります。フォンテーヌのメーカーで商品を製造しており、その助手を探しているそうです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940113
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 726940113,
					"content": "冒険者協会に依頼を登録する際、報酬欄をご記入いただくのですが…さすがは商売人、かなりの額を書かれていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940114
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 726940114,
					"content": "ただ、とある理由から、「離島」でしか活動できないようです。具体的なことについては、ご本人からお聞きください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940115
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 726940115,
					"content": "よし、さっそく今から「離島」に行ってその人に会ってみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726940106,
					"content": "あと変な貨物運搬とか…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940107
					]
				}
			]
		},
		{
			"id": 7269402,
			"completionStepIds": [
				7269402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7269402",
							"2"
						],
						"stepId": 7269402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"バートランド"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726940201,
					"content": "ふっふっふっ、これで準備はすべて整った。数千モラのおもちゃが…何万個も売れれば…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940202
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726940202,
					"content": "簡単に何千万モラも手に入る…くくくっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940203
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726940203,
					"content": "なあ、おまえがバートランドか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726940204,
					"content": "ん？ああ、それは俺のことだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940205
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726940205,
					"content": "どうかしたのか。まさか君たちも噂を聞いて、俺の作ったおもちゃを買いに来たのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940206
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726940206,
					"content": "だが残念ながら、今すぐ売るわけにはいかない。まだ大規模な生産がされてないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940207
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726940207,
					"content": "でも焦る必要はないぞ、すでに生産ラインも準備中だ。もし興味があるなら、手付金を払って予約してくれてもいい。製造が完了したら、全額の支払いと引き換えに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940208
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726940208,
					"content": "待て待て、オイラたちはおもちゃを買いに来たんじゃないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726940209,
					"content": "おお、そうだったのか…そういうことはもっと早く言ってくれ、商売に影響を出さないためにもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940210
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726940210,
					"content": "じゃあ、用件を手短に言ってくれ。俺の時間は貴重なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940211
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726940211,
					"content": "わぁ、一気に態度が冷たくなったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940212,
						726940213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726940212,
					"content": "#{M#俺}{F#私}たちは手伝いに来た。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940214
					]
				},
				{
					"id": 726940214,
					"content": "なんだ、手伝いに来た冒険者の人だったのか！よく来てくれた！いやいや、手伝いに来たのならそう言ってくれよ！はははっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940215
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726940215,
					"content": "そう、冒険者協会に依頼を出したのはこの俺だ。君たちのことはどう呼べばいい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940216
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726940216,
					"content": "（態度がまた変わったぞ…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940217
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726940217,
					"content": "オイラはパイモンだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726940218,
					"content": "で、こちらは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940219
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726940219,
					"content": "#{NICKNAME}…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940220
					]
				},
				{
					"id": 726940220,
					"content": "#{NICKNAME}、どこかで聞いたことあるような。もしかして…君たちも以前、指名手配されていたことが？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940221,
						726940223
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726940221,
					"content": "うん、それも一回だけじゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940222
					]
				},
				{
					"id": 726940222,
					"content": "たぶん、天領奉行に指名手配された時に…い、いや、質問に答えるよう連れていかれた時にその名を聞いたのかもしれないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940225
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726940225,
					"content": "天領奉行に連れていかれるなんて、なにやったんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940226
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726940226,
					"content": "大したことじゃない。以前作ったおもちゃに、ちょっとした問題があってな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940227
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726940227,
					"content": "ちょっとした？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940228
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726940228,
					"content": "問題？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940229
					]
				},
				{
					"id": 726940229,
					"content": "あはは…実はおもちゃの中にあったトリガー装置に触れたら、それが爆発したんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940230
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726940230,
					"content": "爆発？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940231
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726940231,
					"content": "そんな大した問題じゃない。誰もケガはしてないし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940232
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726940232,
					"content": "だというのに、天領奉行の同心たちは詳しく聞きもせず、俺のおもちゃをすべて押収した…もしかしたら、「見た目が可愛い爆弾」として売れたかもしれないのに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940233
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726940233,
					"content": "はぁ…実はフォンテーヌから来たばかりの頃、万国商会に開業資金を借りたんだ…でも入国制限を受けてしまい、離島で生きていくしかない状況になった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940234
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726940234,
					"content": "どう考えても自業自得だろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940235
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726940235,
					"content": "あれ？じゃあ、まだ万国商会に借金してるんだよな。だったらなんで、依頼の報酬が豪華なんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940236
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726940236,
					"content": "その点は問題ない。まだ最後の資金が残ってるんだ。もう一回おもちゃを作って大儲けすれば、きっと借金も返せる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940237
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726940237,
					"content": "もちろん、君たちに豪華な報酬を渡すことだって可能だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940238
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726940238,
					"content": "…本当に大丈夫なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940239
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726940239,
					"content": "稲妻のおもちゃ市場を甘く見たらいけない。俺の作ったおもちゃは、爆発するまで大人気だったんだ…それどころか、爆発した後にもっと人気が出た気さえする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940240
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726940240,
					"content": "とにかく、仮に上手くいかなかったとしても、おもちゃと引き換えに久利須会長へは借金を返すさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940241
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726940241,
					"content": "どうか、協力してほしい、あはは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940242
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726940242,
					"content": "でも協力って言っても、具体的になにをすればいいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940243
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726940243,
					"content": "俺は自分で開発したこの「唯一無二絶対安定工程用二代目炉心製造機」を使っておもちゃを製造してる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940244
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726940244,
					"content": "「唯一無二絶対安定工程用二代目炉心製造機」は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940245
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726940245,
					"content": "名前が長すぎる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940246
					]
				},
				{
					"id": 726940246,
					"content": "たしかに。じゃあ…えーっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940247
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726940247,
					"content": "「大工機」って呼ぼうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940248
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726940248,
					"content": "おい待て、それはいくら何でも短すぎる！特別で凄い感じがまったくしないじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940249
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726940249,
					"content": "短いほうが、みんなに覚えてもらいやすいだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940250
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726940250,
					"content": "それに、「大工機」って名前も悪くないと思うぞ。言いやすいし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940251
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726940251,
					"content": "はぁ…分かったよ。確かに以前、ネーミングセンスがないと言われたことがある。今回は君を信じよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940252
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726940252,
					"content": "パイモンのネーミングセンスも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940253
					]
				},
				{
					"id": 726940253,
					"content": "おいっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940254
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726940254,
					"content": "はははっ、とにかく、俺の「大工機」は入れた材料を自動で分析するんだ。そして、その材料にもっとも適した方法で処理し、組み立ててくれる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940255
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726940255,
					"content": "この前は変なからくりを入れてしまったせいで、爆発を起こしてしまった。ゆえに、その失敗を教訓に改良を加えてある…理論上は、もうそのような問題は起きない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940256
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726940256,
					"content": "理論上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940257
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726940257,
					"content": "だから、誰かに試作実験を手伝ってもらいたいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940258
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726940258,
					"content": "製造に必要な材料集めには、三つの段階がある。「原材料収集」、「元素チャージ」、そして「コア活性化」だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940259
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726940259,
					"content": "まず基本的な原材料となる鉱石、果実、花などを集める。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940260
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726940260,
					"content": "その後、製造機能を維持するために元素力をチャージ。最後に、元素生物のコアにあるエネルギーを使って製造動力を維持するんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940261
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726940261,
					"content": "それじゃ、今日はまず一つ目のステップ、「原材料収集」をやってみよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940262
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726940262,
					"content": "さあ、この「素材収集器」を受け取ってくれ。それと集めた物がなんであれ、直接素材収集器に入れるように。他の元素力に汚染されたらいけないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940263
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726940263,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940264
					]
				},
				{
					"id": 726940264,
					"content": "よし、じゃあ俺はもう少しマシンの調整をしてる。材料集めは任せた！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726940223,
					"content": "#{M#俺}{F#私}たち「も」指名手配されたって？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940224
					]
				},
				{
					"id": 726940224,
					"content": "ははっ、まあ話すと長くなるんだが、些細な問題で天領奉行に行ったことがあってな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940225
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726940213,
					"content": "冒険者協会に依頼したよね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940214
					]
				}
			]
		},
