					"content": "来てくれたんだね、これが僕の<color=#00E1FFFF>「元素クルーシブル」</color>さ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110302
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 409110302,
					"content": "話はここまでにして、早速試験を始めよう。",
					"roleType": "TALK_ROLE_NPC",
