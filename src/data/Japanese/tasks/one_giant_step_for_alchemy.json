					"ティマイオス"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 409110102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110103
					]
				},
				{
					"id": 409110101,
					"content": "あっ、旅人、旅人、ちょっと待った…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110102
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 409110103,
					"content": "えっと、少し申し訳ないんだけど…君に頼みたいことがあるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110104
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 409110104,
					"content": "君も知ってると思うけど、僕はずっと錬金術を研究してきた割に、新たな突破の道が開けないんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110105
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 409110105,
					"content": "このまま規則を守って研究してたら、きっと僕の錬金術の腕は進歩しないままだと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110106
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 409110107,
					"content": "生物錬金の研究？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110108
					]
				},
				{
					"id": 409110109,
					"content": "古代の錬金術の研究？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110110
					]
				},
				{
					"id": 409110106,
					"content": "だから、普通とは違った観点で、新しい研究を始めたいんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110107,
						409110109
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 409110108,
					"content": "ああ、それはもう他に研究してる人がいるから、普通と違うとは言えないかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110111
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 409110110,
					"content": "古代錬金術？えっと、それは僕じゃまだ手に負えない分野かな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110111
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 409110111,
					"content": "うん…錬金術に一番大事なものは何か知ってる？そう、「元素」さ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110112
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 409110112,
					"content": "通常の錬金術では、様々な要因により何らかの元素付着のある材料が使用され、純粋な元素力とは異なってしまう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110113
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 409110113,
					"content": "そういう材料を使うと、錬金の過程で不純物が生まれる。そういう不純物は元素反応の効率に影響するんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110114
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 409110114,
					"content": "必要な元素材料が多くなるだけでなく、不純物が錬金過程で直接影響しないように、観察も必要でね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110115
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 409110115,
					"content": "「神の目」を持っていない人にとって、錬金術を行いたいなら、そういったことも受け入れないといけないんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110116
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 409110116,
					"content": "一番の問題は、そういう元素材料の費用が、とてもとても高いことなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110117
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 409110117,
					"content": "一回の錬金術で、その錬金成果よりも材料費のが気になってしまうほどだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110118
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 409110119,
					"content": "「神の目」は持ってないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110120
					]
				},
				{
					"id": 409110121,
					"content": "じゃあ、何か用でも？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110122
					]
				},
				{
					"id": 409110118,
					"content": "はぁ、だから僕の錬金術は限界を突破しないのかもしれないね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110119,
						409110123
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 409110120,
					"content": "うん…それは聞いた。でも君は元素の力を操ることができる、そうだね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110123
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 409110122,
					"content": "君は「神の目」を持ってないのに、元素の力を操れるって聞いたけど、本当かい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110123
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 409110123,
					"content": "実は、新しい錬金炉を研究してるんだ。<color=#00E1FFFF>「元素クルーシブル」</color>と言って、その原理は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110124
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 409110124,
					"content": "えっと、簡単に言うと、純粋な元素を収納し、互いに反応させられる器なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110125
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 409110125,
					"content": "この「元素クルーシブル」で錬金すれば、僕の錬金術の腕も上がるかもしれない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110126
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 409110126,
					"content": "準備は全て済んだけど、あとは純粋な元素を「運ぶ」ために、元素を自由に操れる人がいる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110127
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 409110127,
					"content": "君さえよければ、<color=#00E1FFFF>千風の神殿</color>に来てほしいんだ。設備の組み立ては他の人に頼んだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110128
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 409110128,
					"content": "今回、僕の錬金術に新たな突破の道が開かれるといいんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ティマイオス"
				}
			]
		},
