				],
				"points": []
			},
			"dialogs": [
				{
					"id": 409110401,
					"content": "あと数回起動すれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110402
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 409110402,
					"content": "旅人！ちょうどよかった、「元素クルーシブル」のことはまだ覚えてるかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110403
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 409110403,
					"content": "君が「元素クルーシブル」を起動してくれた後、僕もその近くで多くのデータを入手できたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110404
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 409110404,
					"content": "そして最も大事なのは、それは信頼できることが分かったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110405
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 409110405,
					"content": "こんな頼もしい機材があれば、これからはもっともと実験できるはずだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110406
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 409110406,
					"content": "旅人、君さえよければ、もう一度「元素クルーシブル」を起動してくれるかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110407,
						409110409
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 409110407,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110408
					]
				},
				{
					"id": 409110408,
					"content": "じゃあ頼んだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 409110409,
					"content": "あと何回実験するの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110410
					]
				},
				{
					"id": 409110410,
					"content": "もちろん回数が多いほどいいに決まってるよ。僕みたいに「神の目」を持たない錬金術師はこういう方法しかないからね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110411
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 409110411,
					"content": "では頼んだよ、旅人。「元素クルーシブル」をもう一度起動してほしいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ティマイオス"
				}
			]
		}
	]
