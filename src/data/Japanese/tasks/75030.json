			},
			"dialogs": [
				{
					"id": 750300101,
					"content": "ここにいたんだな、アコミト。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750300102,
					"content": "本当に降りてきたのか？ここはなかなか見つけにくいから、そのうち諦めて帰るかと思ったのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300103
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300103,
					"content": "ちゃんと説明してもらうからな。さっきは竜の密売人とやらに突っかかられて、びっくりしたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750300104,
					"content": "事を明らかにしないと気が済まないようだね。人に相談するほどのことでもないと思って、ここに隠れていたんだけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300105
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300105,
					"content": "君たちにまで迷惑をかけて、この場所も見つかってしまった…分かった、全部話そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300106
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300106,
					"content": "僕は花翼の集のアコミト。先日、飛行試練に合格して、飛行隊の正式隊員になったばかりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300107
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300107,
					"content": "いや、今は…もう脱隊した失翼者と見なされているかな。隊長が僕のことをどう処理するつもりか、考える必要もないけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300108
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300108,
					"content": "さっき聞こえたと思うけど、僕はクク竜の子供を盗んで密売するような、ルール違反は誓ってしていない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300109
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300109,
					"content": "それから、さっきの密売人たちが君たちに復讐することはないから、安心してくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300110
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300110,
					"content": "花翼の集では常識のある人なら、飛行隊に喧嘩を売るなんて真似はしない。さっきの連中は取るに足らないゴロツキだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300111
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300111,
					"content": "僕が一人になった時を狙って襲ってくるような臆病者だ。さっき君たちにやられたんですっかり怯んで、口外する度胸すらないはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300112,
						750300114
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300112,
					"content": "なんであの人たちと衝突してたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750300113
					]
				},
				{
					"id": 750300113,
					"content": "そうだぞ。あいつらはなんで飛行隊員にケンカを売ってきたんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750300116,
					"content": "それは僕自身の問題なんだ…僕は飛行隊に向いてないかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300117
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300117,
					"content": "見習いの頃は正式な隊員を目指して、必死で先輩たちの背中を追いかけて訓練に励んでいた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300118
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300118,
					"content": "でも、日々の訓練でちょっと蹴躓いたら、心が折れて自分の能力を疑うようになって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300119
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300119,
					"content": "両親や姉さんにも相談もできずに、どんどん張りつめて、ちょっとしたことで怒るようになってしまった。しまいには食欲もなくなって、夜も眠れなくなったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300120
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300120,
					"content": "やっとのことで試験に合格して正式な隊員になったら、今度は隊長の背中を追いかけなきゃならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300121
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300121,
					"content": "どこに行っても、僕よりずっと才能があって、僕より頑張ってる人たちがいるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300122
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300122,
					"content": "やっと飛べるようになったホタルが、必死で雀を追いかけて、やっと追いついたと思ったら、今度は流れ星を追いかけなきゃならない、みたいな話さ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300123
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300123,
					"content": "もう疲れたよ。実は、定期的に謎煙の主に相談に行ってるんだけど、モラばかりかかって、改善の兆しは見えないまま。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300124
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300124,
					"content": "そんな折に竜の密売人に話しかけられて、つい勢いで「竜なんかとっとと攫っていけばいい」なんて言っちゃったんだ。でも、やつらが本気で乗っかるとは思いもしなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300125
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300125,
					"content": "それで、ここに隠れてたら、出るに出れなくなっちゃって。はぁ、もううんざりだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300126
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300126,
					"content": "えっと…ほら、みんなそれぞれ悩みがあるだろ？冒険者だって大変なんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750300127,
					"content": "そうだ、冒険者って依頼を受けるんだろう？君たちにお願いがあるんだ。飛行隊を脱退する言い訳を考えてくれないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300128,
						750300133
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300128,
					"content": "本当に失翼者になりたいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750300129
					]
				},
				{
					"id": 750300129,
					"content": "鉱石を処理する時に、原鉱の表面を削るだろう？僕はその削り屑みたいな存在さ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300130
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300130,
					"content": "そこまで悲観的にならなくても…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750300131
					]
				},
				{
					"id": 750300131,
					"content": "もしみんなが宝石になったら、誰一人特別な存在じゃなくなる。だから、僕は削り屑になって人の輝きを際立たせることにしたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300132
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300132,
					"content": "追いつけるはずもない流れ星を、いつまでも追いかけるのは苦痛でしかない。もうごめんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300138
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300138,
					"content": "そうだ、一回だけ一緒に飛んでくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300139
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300139,
					"content": "もし君たちが僕の記録を破れば、通りすがりの冒険者にすら負ける成績だと証明できる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300140
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300140,
					"content": "そしたら教官も僕に、お前は貴重な人材だとか、才能を磨かないのは宝の持ち腐れだとか、言えなくなるだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300141
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300141,
					"content": "さっきはちょっとムカついたけど、なんか、すごく可哀想に思えてきたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300142
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750300142,
					"content": "なんて声をかけてやればいいかも分からないし…せめて依頼を引き受けてやろうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300143,
						750300144
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750300143,
					"content": "うまくいくかな？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750300145
					]
				},
				{
					"id": 750300145,
					"content": "たぶん消えると思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300146
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300146,
					"content": "分かった、手を貸すよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750300147
					]
				},
				{
					"id": 750300147,
					"content": "ありがとう。詳しい説明はちょっと広い場所に移ってからにしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300144,
					"content": "それで悩みが消えるのなら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750300145
					]
				},
				{
					"id": 750300133,
					"content": "素直に辞めますって言うのはだめ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750300134
					]
				},
				{
					"id": 750300134,
					"content": "それは…辞めたいのは本気だけど、他人の期待を裏切る勇気がなくてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300135
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300135,
					"content": "ここ数日休んでしまったことについては、隊長から軽い罰を受けるだけで済むだろうし、先輩たちも僕を気遣ってくれるだろう——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300136
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300136,
					"content": "「大丈夫だ」、「もう少し頑張れ」、「きっとうまくいく」って。でも、そんな風に励まされると、かえって辛いんだ。僕のことなんか、放っておいてほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300137
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300137,
					"content": "みんなが気遣ってくれるから、屑になりたくても忍びなくてさ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300138
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300114,
					"content": "どうして竜を盗むと約束したの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750300115
					]
				},
				{
					"id": 750300115,
					"content": "そうだぞ…飛行隊の竜騎士なら、もっとクク竜を大事にすると思ったのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300116
					],
					"speakerTitle": "パイモン"
				}
			]
		},
