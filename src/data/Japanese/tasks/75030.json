						750301509
					]
				},
				{
					"id": 750301509,
					"content": "え！？じゃあ、少しもらおうかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750301510
					],
					"speakerTitle": "気怠げなクク竜"
				},
				{
					"id": 750301510,
					"content": "#くぅ～…この食感、たまんねー！ありがとな、{M#兄ちゃん}{F#嬢ちゃん}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750301511
					],
					"speakerTitle": "気怠げなクク竜"
				},
				{
					"id": 750301511,
					"content": "地下室への入り方を知ってる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750301512
					]
				},
				{
					"id": 750301512,
					"content": "なんだ、早く言ってくれよ。ここから行けばいい。雑草をはらってやるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "気怠げなクク竜"
				},
				{
					"id": 750301507,
					"content": "大丈夫、寝てていいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750301508
					]
				},
				{
					"id": 750301508,
					"content": "うん？なにか用なら他の竜に頼めよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
