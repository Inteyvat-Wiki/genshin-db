			"dialogs": [
				{
					"id": 750300701,
					"content": "惜しかったね。もう少しだったのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300702
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300702,
					"content": "頑張れ、絶対に諦めるな！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300703,
						750300706
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300703,
					"content": "なんで急に応援してくれるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750300704
					]
				},
				{
					"id": 750300704,
					"content": "ここから出られるかどうか、君たちにかかってるからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300705
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300705,
					"content": "少し休んでからもう一度やってみてくれ、次は絶対にうまくいくさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300708
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300708,
					"content": "心配するな。僕は君を信じている——諦めずにチャレンジし続けるってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300709
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300709,
					"content": "いや、信じないで！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750300710
					]
				},
				{
					"id": 750300710,
					"content": "どんな状況でも君を信じるよ。僕にはもう無理だけど、君ならきっとできるさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300711
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300711,
					"content": "もし君が諦めたら、本当に万事休すだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300706,
					"content": "少し休みたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750300707
					]
				},
				{
					"id": 750300707,
					"content": "なら、休憩後にまた頑張ってくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300708
					],
					"speakerTitle": "アコミト"
				}
			]
		},
