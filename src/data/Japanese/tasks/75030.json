			"dialogs": [
				{
					"id": 750300303,
					"content": "殴られるために、のこのこ出ていくわけないだろう？あれはただの冗談だ。それに、君たちにモラをもらった覚えはないしね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300304
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300304,
					"content": "仔竜を盗んで君たちに渡すのは重大な規則違反だ。そんな馬鹿なことするか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300305
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300305,
					"content": "フン、大した肝っ玉だな。いいだろう、ここでいくらでも待ってやる。お前を助けにくるやつなんざいねぇだろうよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300306
					],
					"speakerTitle": "怒っている竜の密売人"
				},
				{
					"id": 750300306,
					"content": "…そうとも限らないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300307
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300307,
					"content": "…はぁ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300308
					],
					"speakerTitle": "怒っている竜の密売人"
				},
				{
					"id": 750300308,
					"content": "チッ、本当に助っ人が来やがった。ムカつくがしょうがねぇ。こいつらも一緒に懲らしめてやるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300309
					],
					"speakerTitle": "怒っている竜の密売人"
				},
				{
					"id": 750300309,
					"content": "えっ、本当に来たのか…！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300310
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300310,
					"content": "#なんなんだよ、こいつら！しょうがないな、{NICKNAME}、おまえの腕を見せてやれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
