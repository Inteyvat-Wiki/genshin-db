			"dialogs": [
				{
					"id": 750300401,
					"content": "あっぱれだ！僕の最高記録を破ってくれたね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300402
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300402,
					"content": "これで、「僕のことなんか諦めてくれ」って、隊のみんなを説得できる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300403
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300403,
					"content": "本当に助かったよ、ありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300404,
						750300405
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300404,
					"content": "ど、どういたしまして？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750300406
					]
				},
				{
					"id": 750300406,
					"content": "君が助けてくれたこと、ずっと忘れないよ。少し休んだら、すぐ隊長に会いに行く。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300407
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300407,
					"content": "これで自由になれるぞ…！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300405,
					"content": "役に立てたならよかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750300406
					]
				}
			]
		},
		{
			"id": 7503005,
			"completionStepIds": [
				7503005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7503005",
							"2"
						],
						"stepId": 7503005,
						"stateName": "QUEST_STATE_UNFINISHED"
