			"dialogs": [
				{
					"id": 750300201,
					"content": "通常の飛行試練の目標は、竜に乗って既定のコースを飛び、制限時間内にできるだけ点数を稼ぐことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300202
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300202,
					"content": "審査もかなり厳しくてね、教官が各チェックポイントで受験者のパフォーマンスを評価して採点してる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300203
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300203,
					"content": "最終的な成績は得点に基づいて四つのランクに分けられる。せめて二つ目のランクを取ってくれ！僕がうまく脱退できるかは、君にかかっているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300204
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300204,
					"content": "かつて歯を食いしばって頑張っていた僕を追い越してくれ。もう僕は疲れ果てた…他人に頼むしかないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アコミト"
				}
			]
		},
