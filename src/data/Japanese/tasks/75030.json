			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アコミト"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750300501,
					"content": "すぐ飛行隊に戻るよ、本当にありがとう。恩に着るよ…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300502,
						750300503
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300502,
					"content": "うまくいくといいけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750300504
					]
				},
				{
					"id": 750300504,
					"content": "ちゃんとプランを立ててるんだ。もし隊長が「みんな通る道だ。今が踏ん張りどころだ」とか言ってきたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300505
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300505,
					"content": "少し黙ってから、こう言うんだ。「隊長、申し訳ありません。僕は…」ってね。とにかく落ちぶれてる姿を見せることがポイントだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300506
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300506,
					"content": "しょうもない奴だな、って隊長に思わせるためにね。でも、まったく嘘でもないよ。本当につらい思いをしてるんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300507
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300507,
					"content": "もし、隊長が僕の成績がこれだけふるわないにもかかわらず、もう一度チャンスをやるって言ってきたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300508
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300508,
					"content": "泣くふりをする。ただし、目に涙を浮かべる程度に留めるのが大事だ。「ありがとうございます」って短く添えてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300509
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300509,
					"content": "その後、「自分が情けなくてしょうがない」って漏らすんだ。ここのポイントは隊長の話に合わせること。すると、隊長も反論しにくいだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300510
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300510,
					"content": "もし隊長が「もう少し検討する」って言って先輩たちを動員して僕を説得しようとしたら、その時は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300511
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300511,
					"content": "これはちょっと難しいな、どうすればいいか思いつかない。全ての先輩と一人ずつそんなことをしている余裕なんかないだろうし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300512
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300512,
					"content": "てっきり、投げやりになってオイラたちに助けを求めてきたのかと思ったら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300513
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750300513,
					"content": "きっちり考えをまとめてたんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300514
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750300514,
					"content": "苦痛に直面した時に働く心理的な防衛機構さ。苦痛への感知力を鈍らせるために、気が楽になることに自然と意識が向くんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300515
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300515,
					"content": "謎煙の主に相談した時、こういうのを教わったんだ。モラを支払ったからには、何か有益なアドバイスをもらわないとだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300516,
						750300517
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300516,
					"content": "有益でもないような…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750300518
					]
				},
				{
					"id": 750300518,
					"content": "あまり悲観するなって。今度こそ脱退できる予感がするんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300519
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300519,
					"content": "そうだ、行く前に君に話しておかないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300520
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300520,
					"content": "この飛行台は、僕がまだ見習いだった頃、訓練用にと家族が造ってくれたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300521
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300521,
					"content": "もう使うことはないだろうし、解体してしまうつもりだ。これでつらい訓練ともおさらばだしね、はは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300522
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300522,
					"content": "でも、君がいつでもここで訓練できるように、コース設備は残しておくよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300523
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300523,
					"content": "練習したくなったら、いつでも来てくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300524
					],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300524,
					"content": "次に会う時は、僕も君みたいに自由な身になってるといいんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アコミト"
				},
				{
					"id": 750300517,
					"content": "あまり大金を払ってないといいけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750300518
					]
				},
				{
					"id": 750300503,
					"content": "どういたしまして。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750300504
					]
				}
			]
		},
