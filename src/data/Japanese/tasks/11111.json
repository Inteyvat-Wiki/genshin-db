	"talks": [
		{
			"id": 1111101,
			"completionStepIds": [
				1111101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1111101",
							"2"
						],
						"stepId": 1111101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"孟"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111110101,
					"content": "孟、帰ったよ！残念だけど、狼兄貴は見つからなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110102
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110102,
					"content": "そうですか、困りましたね。探せるところはもう探したはずなのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110103
					],
					"speakerTitle": "孟"
				},
				{
					"id": 111110103,
					"content": "狼兄貴って一体誰なんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111110104,
					"content": "そうだな、一から説明しよう。俺の実家は無妄の丘の近くにあってな、小さい頃から仲の良い幼馴染が数人いたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110105
					],
					"speakerTitle": "孟"
				},
				{
					"id": 111110105,
					"content": "その中の一人が狼兄貴、特に俺と仲がよくていつも遊んでいた。けど、ある日突然、不慮の事故で亡くなったんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110106
					],
					"speakerTitle": "孟"
				},
				{
					"id": 111110106,
					"content": "そのことがずっと忘れられなくてな。今も時々、俺は無妄の丘に足を運ぶんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110107
					],
					"speakerTitle": "孟"
				},
				{
					"id": 111110107,
					"content": "だがこの前、無妄の丘から戻ってくると体に違和感を感じたんだ。そして毎晩、夢の中に狼兄貴が現れるようになった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110108
					],
					"speakerTitle": "孟"
				},
				{
					"id": 111110108,
					"content": "それで思ったんだ。もしかしたら、本当に狼兄貴が何かをしているんじゃないかって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110109,
						111110110
					],
					"speakerTitle": "孟"
				},
				{
					"id": 111110109,
					"content": "奇妙な話だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110111
					]
				},
				{
					"id": 111110111,
					"content": "ただの予想だし証拠はないが、どうにも落ち着かない。考えれば考えるほど不安が募る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110112
					],
					"speakerTitle": "孟"
				},
				{
					"id": 111110112,
					"content": "幼馴染の友達がもし悪鬼にでもなっていたら、そんなのどう受け止めればいいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110113
					],
					"speakerTitle": "孟"
				},
				{
					"id": 111110113,
					"content": "彼はそれが原因で往生堂に入ったの。だから、このことに関しては給料も受け取ってない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110114
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110114,
					"content": "でも、孟の心配が的中する可能性はあるの。だって、鬼の霊が現世を彷徨うことは時々あるからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110115
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110115,
					"content": "でも悪鬼は言い過ぎかな。私ですらめったに悪鬼なんて見ないもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110116
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110116,
					"content": "けど、狼兄貴の危険性を否定する材料にはなりません。あいつが誰かを傷つける姿を、俺は見たくないんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110117
					],
					"speakerTitle": "孟"
				},
				{
					"id": 111110117,
					"content": "まあ、こんな感じ。狼兄貴が見つかるまで、孟は仕事に身が入らないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110118
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110118,
					"content": "さっき私たちが訪ねたあの人たちも、その数人いる孟の幼馴染でね。狼兄貴がその中に潜んでるんじゃないかって睨んでたんだけど、ハズレだったみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110119
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110119,
					"content": "無妄の丘を探し、あいつらのところも探した、これで手がかりが全て途絶えた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110120
					],
					"speakerTitle": "孟"
				},
				{
					"id": 111110120,
					"content": "ごめんください、往生堂の方ですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110121
					],
					"speakerTitle": "洛成"
				},
				{
					"id": 111110121,
					"content": "僕は洛成と言います。最近具合が悪くて、何かにまとわりつかれてる気がするんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110122
					],
					"speakerTitle": "洛成"
				},
				{
					"id": 111110122,
					"content": "先日、友達と無妄の丘で肝試しを行ったんですが、帰ったあとに倒れてしまって、それからは毎晩悪夢を見るように。医者に診てもらいましたが、原因は何も分からずじまいでして。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110123
					],
					"speakerTitle": "洛成"
				},
				{
					"id": 111110123,
					"content": "僕、きっと呪われたんです！魔神に！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110124
					],
					"speakerTitle": "洛成"
				},
				{
					"id": 111110124,
					"content": "うん、そうですね、あたり、魔神に呪われてます。それもやばいくらいに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110125
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110125,
					"content": "あなたも知ってますよね！魔神戦争で死んだ伝説の魔神が、この世に苦痛をもたらす呪いをかけたっていう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110126
					],
					"speakerTitle": "洛成"
				},
				{
					"id": 111110126,
					"content": "この呪いを解かないと、五臓六腑がはじけ飛んで、凄惨な死を遂げるとかなんとか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110127
					],
					"speakerTitle": "洛成"
				},
				{
					"id": 111110127,
					"content": "伝説にあった呪いの症状と、今の僕は同じなんです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110128
					],
					"speakerTitle": "洛成"
				},
				{
					"id": 111110128,
					"content": "無妄の丘、呪い…いや、これは呪いじゃなく、たぶん狼兄貴が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110129
					],
					"speakerTitle": "孟"
				},
				{
					"id": 111110129,
					"content": "はぁ、待った待った。二人とも静かに、勝手にしゃべらないで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110130
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110130,
					"content": "おまえにだけは言われたくない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110131
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111110131,
					"content": "往生堂はこういった鬼とか魔神のことに詳しいんですよね！助けてください！まだ死にたくありません！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110132
					],
					"speakerTitle": "洛成"
				},
				{
					"id": 111110132,
					"content": "いいですよ、問題ありません、私に任せてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110133
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110133,
					"content": "でも呪いを解くにはそれに適した場が必要です、準備しないといけません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110134
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110134,
					"content": "新入り、あなたの手が必要だから、私と一緒に来て。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110135
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110135,
					"content": "お、俺も一緒に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110136
					],
					"speakerTitle": "孟"
				},
				{
					"id": 111110136,
					"content": "あなたはまず彼に焚香駆邪を行ってあげて、前に教えたはずだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110137
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110137,
					"content": "準備ができたら私のとこに来て。これが終わったらまた狼兄貴のことについて話そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110138
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110138,
					"content": "分かりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110139
					],
					"speakerTitle": "孟"
				},
				{
					"id": 111110139,
					"content": "じゃあ私たちは行きましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110110,
					"content": "そんなのありえないよね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110111
					]
				}
			]
		},
		{
			"id": 1111102,
			"completionStepIds": [
				1111102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1111102",
							"2"
						],
						"stepId": 1111102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111110201,
					"content": "なあ、コソコソしてなにをする気なんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111110202,
					"content": "何もしないよ、ただここで待ってるだけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110203
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110203,
					"content": "はあ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111110204,
					"content": "まさか魔神の呪いとか本当に信じてるの？あんなもの、とっくになくなってるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110205
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110205,
					"content": "じゃあ、なんでここに？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110206
					]
				},
				{
					"id": 111110206,
					"content": "あの二人を見たでしょ。一人は自分が呪いにかけられたと、もう一人は自分の友達が悪鬼になったと思い込んでる。それで二人とも人の話を聞き入れられない状態になってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110207
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110207,
					"content": "はぁ、だから言ったの。一般人は何も知るべきじゃないって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110208
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110208,
					"content": "こういうことで冷静さを失う人をたくさん見てきた。あの人たちを落ち着かせるためには、あの人たちが思い込んでいるものを見せてあげるしかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110209
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110209,
					"content": "鬼を信じてる人の目の前で、鬼を退治する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110210
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110210,
					"content": "えっと…子供をあやすのと同じ感じか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110211,
						111110213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111110211,
					"content": "一般人に世の真実を教えてあげたら？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110212
					]
				},
				{
					"id": 111110212,
					"content": "そうだぞ、恐怖が未知から来てるものなら、その方がいいと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111110216,
					"content": "そんなの、真実を告げても事態が良くなる保証がないからに決まってるでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110217
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110217,
					"content": "「境界」に近づいた人を離れさせる。心理的な問題は、心理的な手法で対処するのが一番。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110218
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110218,
					"content": "それもそうだな…じゃあ、呪いのことはどう言うんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110219
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111110219,
					"content": "「夜叉」の歴史って、聞いたことある？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110220,
						111110221
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110220,
					"content": "聞いたことない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110222
					]
				},
				{
					"id": 111110222,
					"content": "その昔、彼らは魔神と激しく戦った。魔神は敗れたけど、怨嗟はずっと残り続けた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110223
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110223,
					"content": "その怨嗟が疫病となり、人々を蝕んだ。人々はそれを、「魔神が下した呪い」だと信じて疑わなかったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110224
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110224,
					"content": "たくさんの命が疫病によって奪われ、死んだ体を媒介に疫病はどんどん拡散していった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110225
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110225,
					"content": "後になって、人々はやっと疫病の拡散を阻止する方法を見つけたの。空気を浄化し、死骸を焼く。そして初めてそれを行ったのが、この「往生堂」の創始者なの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110226
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110226,
					"content": "そ、そうだったのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110227
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111110227,
					"content": "うん、それから何年か経ち、疫病は完全に消滅した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110228
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110228,
					"content": "同じような出来事を、「往生堂」は何回も処理してきた。そのおかげで璃月の生と死の均衡を保ってきたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110229
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110229,
					"content": "簡単に言えば、私たちは「守り人」。人々を見守り、人じゃないものも見守る、へへ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110230,
						111110231
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110230,
					"content": "これが「生と死の境界を維持する」こと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110232
					]
				},
				{
					"id": 111110232,
					"content": "だから、「呪い」は全部気のせいなの。もちろん、昔本当にあったことも、一般人には絶対言わないけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110233
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110233,
					"content": "少しここで待ちましょう。あとでこの地脈鎮石を使って一芝居打つから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110234
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110234,
					"content": "やっと来ましたか、ちょうど今準備が終わったところですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110235
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110235,
					"content": "見てください、これが邪を払う特殊な装置。あなたの体から呪いを吸い出し、具現化します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110236
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110236,
					"content": "危険は及ばないから安心してください、この旅人さんは百戦錬磨の実力の持ち主だから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110237,
						111110238
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110237,
					"content": "やっぱり。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110239
					]
				},
				{
					"id": 111110239,
					"content": "あっ、そうだった、言うの忘れてた。あはは、まあ大丈夫でしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110240
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110240,
					"content": "これで本当に解決するんですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110241
					],
					"speakerTitle": "洛成"
				},
				{
					"id": 111110241,
					"content": "堂主を信じろ、あの人は性格こそ変わってるが、やる時はしっかりやる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110242
					],
					"speakerTitle": "孟"
				},
				{
					"id": 111110242,
					"content": "ちょっと、「変わってる」なんて単語で私を語らないでよ？少なくとも天真爛漫で無邪気って言って！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110243
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110243,
					"content": "とりあえず、さっそく始めましょう！新入り、装置を起動して。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110238,
					"content": "戦うなんて聞いてない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110239
					]
				},
				{
					"id": 111110231,
					"content": "そんな歴史があるとは思わなかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110232
					]
				},
				{
					"id": 111110221,
					"content": "少しならある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110222
					]
				},
				{
					"id": 111110213,
					"content": "パイモンは今年で何歳？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110214
					]
				},
				{
					"id": 111110214,
					"content": "どうしていきなりそんなことを聞くんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110215
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111110215,
					"content": "それより、なんで皆に本当のことを言わないんだ、そっちの方が気になるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110216
					],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 1111103,
