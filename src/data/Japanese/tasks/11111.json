		{
			"id": 1111105,
			"completionStepIds": [
				1111105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1111105",
							"2"
						],
						"stepId": 1111105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"胡桃"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111110501,
					"content": "どう、呪いが祓われた気がしませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110502
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110502,
					"content": "します、これ以上にないすっきりした気持ちです！凄く清々しい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110503
					],
					"speakerTitle": "洛成"
				},
				{
					"id": 111110503,
					"content": "ありがとうございました。それからそこの旅人さんも！あなたたちが助けてくれなければ、私は呪いで死んでいたでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110504
					],
					"speakerTitle": "洛成"
				},
				{
					"id": 111110504,
					"content": "じゃあ、今ならもう言っていいですね——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110505
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110505,
					"content": "テッテテー！騙されました！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110506
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110506,
					"content": "え？な、なんですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110507
					],
					"speakerTitle": "洛成"
				},
				{
					"id": 111110507,
					"content": "一般人には分からないでしょうけど、これはただの地脈鎮石で、魔物を引き寄せるものなんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110508
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110508,
					"content": "あの魔物たちも呪いの具現化じゃなくて、本物の魔物です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110509
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110509,
					"content": "あれれ？おかしいですねぇ。何もしてないのに、具合が良くなるだなんて、なんででしょうね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110510
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110510,
					"content": "ま、まさか…実は呪いにかけられてないってこと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110511
					],
					"speakerTitle": "洛成"
				},
				{
					"id": 111110511,
					"content": "では、どうして病気に？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110512
					],
					"speakerTitle": "洛成"
				},
				{
					"id": 111110512,
					"content": "風邪を引いたか、食あたりか、はたまた心理的なものか…私的には最後のやつがよくある原因だと思いますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110513
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110513,
					"content": "まさかそんなことが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110514
					],
					"speakerTitle": "孟"
				},
				{
					"id": 111110514,
					"content": "こんな原因、思いもしませんでした。と、とにかくありがとうございました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110515
					],
					"speakerTitle": "洛成"
				},
				{
					"id": 111110515,
					"content": "礼には及びませんよ、これからはそんなに疑心暗鬼にならないように。私も毎回こんな方法できませんから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110516
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110516,
					"content": "人生とは短きもの、生きている内に生を謳歌してください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110517
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110517,
					"content": "その一言は…少しモヤモヤしますが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110518
					],
					"speakerTitle": "洛成"
				},
				{
					"id": 111110518,
					"content": "で、では僕はこれで。ご迷惑をおかけしました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110519
					],
					"speakerTitle": "洛成"
				},
				{
					"id": 111110519,
					"content": "どうやら狼兄貴が原因じゃなかったんですね。少しほっとしました。しかし、狼兄貴の行方が分からない以上、事態は変わっていません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110520
					],
					"speakerTitle": "孟"
				},
				{
					"id": 111110520,
					"content": "一段落しましたし、引き続き狼兄貴を探しに行きませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110521
					],
					"speakerTitle": "孟"
				},
				{
					"id": 111110521,
					"content": "その必要はないと思うよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110522
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110522,
					"content": "だって、もう本人が来てるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110523
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110523,
					"content": "狼、狼兄貴——！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110524
					],
					"speakerTitle": "孟"
				},
				{
					"id": 111110524,
					"content": "あ、あの…ごめんなさい、お邪魔だったかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110525
					],
					"speakerTitle": "狼兄貴"
				},
				{
					"id": 111110525,
					"content": "あれが狼兄貴？なんで子供なんだ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110526
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111110526,
					"content": "幽霊だもの、当時の姿のままなのは当然だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110527
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110527,
					"content": "えっと、「狼兄貴」って名前とのギャップが大きすぎるんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110528
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111110528,
					"content": "往生堂に連れて行こう。やるべきことがたくさん待ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "胡桃"
				}
			]
		},
