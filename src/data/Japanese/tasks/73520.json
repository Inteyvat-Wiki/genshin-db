			},
			"dialogs": [
				{
					"id": 735200301,
					"content": "ここに木のうろがあるみたいだ。でも中は空っぽで、なにもないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735200302,
					"content": "ん？待て。中にメモがあるみたいだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735200303,
					"content": "「いいナラは、アランカシャップに字を教えてくれた。アランカシャップはいいナラを守る…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735200304,
					"content": "これは…いったいどういう意味なんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
