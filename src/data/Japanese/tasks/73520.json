			"dialogs": [
				{
					"id": 735200101,
					"content": "お二人は、私から情報を購入すると決めたんですの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200102
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 735200102,
					"content": "うーん…おまえのいう独占情報には、確かに興味あるけど…先に値段を教えてくれ！高すぎた買わないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735200103,
					"content": "百万モラですの、値段交渉は受け付けませんわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200104
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 735200104,
					"content": "たかっ！やっぱやめよう！百万モラがあれば、美味しいものがたくさん買えるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735200105,
					"content": "少々お待ちくださいまし。どれどれ…なんと！？パイモンは本日の千一番目のお客様ですわ。もとは百万モラの価値がある特別情報ですが、なんと無料で差し上げちゃいますの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200106
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 735200106,
					"content": "えっ！？そんなうまい話があるのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735200107,
					"content": "待て。まさか罠とかじゃないよな？無料とか言っといて、話していくうちに有料に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735200108,
					"content": "なーら結構ですわ。お次のお客様、どうぞ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200109
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 735200109,
					"content": "いやいやいや。悪かったよ。ちゃんと聞くから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735200110,
					"content": "ドリーの独占情報その一！あなたたちは、才識の冠のことを覚えていますこと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200111
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 735200111,
					"content": "もちろんだぜ。チャンピオンだけが戴く資格がある冠で、なんだかすごく高そうなものらしいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735200112,
					"content": "その通りですわ。サーチェンが教令院に寄付したのは、とても貴重な骨董品だったんですの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200113
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 735200113,
					"content": "それにあの冠は教令院に寄付された後、一度紛失されたことがあったらしいですわよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200114
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 735200114,
					"content": "へえ？オイラたち、そんなの聞いたことないけどな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735200115,
					"content": "うふふっ…誰でも知っていたら、「独占情報」にならないですわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200116
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 735200116,
					"content": "もちろん、この情報はでたらめなんかじゃありませんわよ。ちゃんとした証人がいますの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200117
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 735200117,
					"content": "南の郊外に、カシュミールという若者がいますわ。興味があるのでしたら、彼に聞いてみるといいですわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200118
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 735200118,
					"content": "合言葉は…「二十年前の出来事」ですの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ドリー"
				}
			]
		},
