			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"カシュミール"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735200203,
					"content": "「二十年前の出来事」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735200204
					]
				},
				{
					"id": 735200204,
					"content": "…言いふらすべきじゃなかった。この間は飲み過ぎてぼやいてしまったけど…まさかこんなに人が聞きに来るなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200205
					],
					"speakerTitle": "カシュミール"
				},
				{
					"id": 735200205,
					"content": "そんなに気になるなら、話してあげるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200206
					],
					"speakerTitle": "カシュミール"
				},
				{
					"id": 735200206,
					"content": "二十年前、私はたった六歳の子供だった。当時のことはもうそんなに覚えてない。この前、子供の頃の日記を読み返して、ようやく当時のことを思い出した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200207
					],
					"speakerTitle": "カシュミール"
				},
				{
					"id": 735200207,
					"content": "その年もちょうど学院トーナメントがあって、試合は三回行われた。最後の一回はシティの外でやるから、私は母さんに連れて行って欲しいとねだったんだが、応じてくれなかったからこっそり抜け出したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200208
					],
					"speakerTitle": "カシュミール"
				},
				{
					"id": 735200208,
					"content": "それで？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735200209,
					"content": "それで、シティの外で私は迷子になった。人っ子一人おらず、怖さのあまりつい泣いてしまったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200210
					],
					"speakerTitle": "カシュミール"
				},
				{
					"id": 735200210,
					"content": "そのとき、不思議な生物を見たんだ…もう顔は覚えててないけど、子供だった私はそれを見た途端、泣き止んだのだけは覚えてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200211
					],
					"speakerTitle": "カシュミール"
				},
				{
					"id": 735200211,
					"content": "不思議な生物って、まさか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735200212,
					"content": "（アランナラのことだろう。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735200213
					]
				},
				{
					"id": 735200213,
					"content": "彼らは試合の会場に私を連れていってくれたが、残念なことに試合はもう終わってしまっていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200214
					],
					"speakerTitle": "カシュミール"
				},
				{
					"id": 735200214,
					"content": "しょんぼりしていたとき、不思議な生物の一匹が冠を引きずって歩いているのを見たんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200215
					],
					"speakerTitle": "カシュミール"
				},
				{
					"id": 735200215,
					"content": "冠はとても綺麗で、月明かりの下で輝いてた。私はついそのあとをついていった。するとその小さいのは、冠をとある木のうろに隠したのち、姿を消したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200216
					],
					"speakerTitle": "カシュミール"
				},
				{
					"id": 735200216,
					"content": "冠を触ってみたかったけど、ちょうどその時、遠くから母さんの声がした。私が迷子になったのに気づいて、隣人を呼んで私を探しに来てくれたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200217
					],
					"speakerTitle": "カシュミール"
				},
				{
					"id": 735200217,
					"content": "結局あの冠には触れずじまいだったな。大人になって、学院トーナメントの会場で「才識の冠」を見たとき、ようやくあれと同じものだと気づいたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200218
					],
					"speakerTitle": "カシュミール"
				},
				{
					"id": 735200218,
					"content": "そっか…それで、あの冠が最後にどこに置かれたのかは、覚えてるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200219
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735200219,
					"content": "確か、アビディアの森だった。だが、その後何回も行ってみたんだけど、何の手がかりも見つけられなかったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200220
					],
					"speakerTitle": "カシュミール"
				},
				{
					"id": 735200220,
					"content": "誰かに言っても信じてはもらえないだろうな。はぁ、私自身もはっきりと覚えてるわけじゃない。子供の頃に見た夢だったのかもしれないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200221
					],
					"speakerTitle": "カシュミール"
				},
				{
					"id": 735200221,
					"content": "#うーん…{NICKNAME}、探しに行ってみないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
