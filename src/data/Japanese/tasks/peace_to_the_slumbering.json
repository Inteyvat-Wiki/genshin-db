					"nextDialogs": [
						750040403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750040403,
					"content": "ここへ…来い…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040404
					],
					"speakerTitle": "「夜の毛並みを持つ獣」"
				},
				{
					"id": 750040404,
					"content": "お前たちは、長きに渡り眠る、安息が与えられるべき者たちを連れてきた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040405
					],
					"speakerTitle": "「夜の毛並みを持つ獣」"
				},
				{
					"id": 750040405,
					"content": "彼らは、祈るべきではない霊に祈ってしまったのかもしれん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040406
					],
					"speakerTitle": "「夜の毛並みを持つ獣」"
				},
				{
					"id": 750040406,
					"content": "しかしあれは、手を伸ばしてもなにも見えぬ月のない夜の事だった。ゆえに、夜はすでに彼らを赦している。ただ恨みと穢れのみは永遠に消えることなく、彼らもまた安息の眠りに永遠につけぬのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040407
					],
					"speakerTitle": "「夜の毛並みを持つ獣」"
				},
				{
					"id": 750040407,
					"content": "感謝するぞ、寵愛を受けた人間よ…お前たちが闇に渦巻く彼らの怒りを鎮め、夜の影に導けば、異邦の魂もあるべき場所へ還っていくだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040408
					],
					"speakerTitle": "「夜の毛並みを持つ獣」"
				},
				{
					"id": 750040408,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040409
					],
					"speakerTitle": "「夜の毛並みを持つ獣」"
				},
				{
					"id": 750040409,
					"content": "行くがいい。危険な教唆、陰謀を抱く者が画策する結末には注意するがよい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「夜の毛並みを持つ獣」"
				}
			]
