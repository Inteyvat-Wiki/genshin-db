						750040304
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750040304,
					"content": "は、早く私たちを一緒に封印——教えたように——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040305
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 750040305,
					"content": "ザザッ——離れろ、はな——なぜお前たちは離れない——災厄が——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040306
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 750040306,
					"content": "耳を澄ませると…あの下から聞こえてくるのは、兵士二人の声だけじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040307
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750040307,
					"content": "光を放つ紋様の背後。そのさらに奥から痛ましい叫び声が聞こえる…\\n誰かの怒号。痛みに耐える竜の低いうめき声。\\n肉と血が交じり合う音。形容しがたい粘ついた巨大なものがゆっくりと前進する足音。\\nしかし同時に、それらを外へ押し戻そうと、幾千もの手が抵抗する音も聞こえた…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750040308
					]
				},
				{
					"id": 750040308,
					"content": "聞こえるきこえるキコエル…狭く暗い空間で、永遠に止むことのない戦い。\\nそれは…永遠の終わりまで続く苦しみだ。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750040309,
						750040310
					]
				},
				{
					"id": 750040309,
					"content": "彼らには安息が訪れない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750040311
					]
				},
				{
					"id": 750040311,
					"content": "キュイ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040312
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750040312,
					"content": "あの英雄たち…彼らは今日までずっと戦いを止めなかった…アビスが「光の刻印」から溢れ出ないように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040313
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750040313,
					"content": "私がこれらの物語を語ることには意味がある。私たちは永遠に勇士たちの犠牲を心に刻み、彼らの努力を決して忘れない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040314
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750040314,
					"content": "…しかしこの苦しみはあまりにも重すぎる。物語とは違うのだ。物語では「英雄たちは傷を負ったが、体を震わせるとなにもなかったように立ち上がった」とあるからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040315
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750040315,
					"content": "実際の傷や本当の苦しみはそのように軽いものではない…狭くて光のない世界で、彼らはあまりにも長い間、あれほど大きな苦痛を耐え続けてきたのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040316
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750040316,
					"content": "キュイ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040317
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750040317,
					"content": "そんな…オイラたちになにかできることはないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040318
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750040318,
					"content": "私も彼らになにかしてやりたいが…相手はアビスだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040319
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750040319,
					"content": "おそらく唯一できる事は彼らの意志を継ぎ、再び「光の刻印」を封じることのみ…部族の物語では「陰縫いの針」が落ちたのはこれが初めてではない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040320
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750040320,
					"content": "以前にも間違いなく誰かが来て…同じようにトラオレの碑文を目にしたはずだ。私たちが見たものを、かつて「光の刻印」を修復した人も見たに違いない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040321
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750040321,
					"content": "それでも…部族の物語に変更が加えられたことはない。物語の警告は現実への警告であり、危険もまた現実であるからだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040322
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750040322,
					"content": "私たちにできるのは「光の刻印」を修復してこの場を離れ、すべてを記憶し、ここで見た事を忘れないようにすることだけだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040323
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750040323,
					"content": "でも…あの人たちは英雄なのに、ずっとここで苦しみ続けるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040324
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750040324,
					"content": "パイモンの言う通りだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750040325
					]
				},
				{
					"id": 750040325,
					"content": "英雄はこんな結末を迎えるべきじゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750040326
					]
				},
				{
					"id": 750040326,
					"content": "わかっているさ。私だって今も苦しみ続けている戦士たちに安息を与えてやりたいが…私にはそんな力はない。単なる語り部だからな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040327
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750040327,
					"content": "#{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040328
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750040328,
					"content": "キュ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040329,
						750040330
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750040329,
					"content": "#大丈夫、{M#俺}{F#私}たちならできる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750040331
					]
				},
				{
					"id": 750040331,
					"content": "#…{NICKNAME}、本当に？本当に手を貸してくれるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040332
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750040332,
					"content": "#もちろん、{NICKNAME}なら絶対助けるって思ったぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040333
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750040333,
					"content": "キュイッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040334
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750040334,
					"content": "#アビスは非常に危険な存在だぞ…とはいえ{NICKNAME}の力を疑っているわけではない。ただ…無理はしないでほしくてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040335
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750040335,
					"content": "大丈夫だぞ！オイラたちアビスに関しては経験豊富だからな。それにまだ「光の刻印」だってあるんだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040336
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750040336,
					"content": "ああ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040337
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750040337,
					"content": "まったく、君たちの素晴らしさは私の想像を超えているな。他者の苦しみを取り除くために、自分の力を使うことを惜しまないとは…まったくもって立派な英雄だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040338
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750040338,
					"content": "#そう、私は語り部だ…だから英雄の物語を記録しなければな。異邦より来たる英雄、{NICKNAME}よ。どうか…どうかアビスに打ち勝つ君たちの勇姿を、私に見せてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040339
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750040339,
					"content": "うん、絶対に勝つ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750040340
					]
				},
				{
					"id": 750040340,
					"content": "では…今すぐ「光の刻印」を解くか？それとももう少し準備をするか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040341,
						750040343
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750040341,
					"content": "今すぐ解こう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750040342
					]
				},
				{
					"id": 750040342,
					"content": "#わかった。{NICKNAME}、健闘を…いや。勝利を願っているぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750040343,
					"content": "待ってて、準備してくる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750040344
					]
				},
				{
					"id": 750040344,
					"content": "#わかった。できる限り準備を整えておくといい…気をつけるんだぞ、{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750040330,
					"content": "物語の結末を書き直そう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750040331
					]
				},
				{
					"id": 750040310,
					"content": "彼らは今も戦い続けて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750040311
					]
				}
			]
		},
