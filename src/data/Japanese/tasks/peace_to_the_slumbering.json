					]
				},
				{
					"id": 750040128,
					"content": "そっか…あっ！オイラわかったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040129
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750040129,
					"content": "たぶんその人たちは、ほとんどの英雄と同じで、誰かに褒められるためにすごいことをしたわけじゃないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040130
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750040130,
					"content": "「そういう行動をしたからこそ」英雄になったんだから、他人がどう評価しようが気にしないんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040131
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750040131,
					"content": "……",
