			"dialogs": [
				{
					"id": 750040501,
					"content": "#おお、戻ってきたか！{REALNAME[ID(2)|SHOWHOST(true)]}と一緒に心配していたんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040502
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750040502,
					"content": "ほら、仔竜よ。言っただろう？二人は必ず無事に戻ってくると。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040503
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750040503,
					"content": "キュウ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040504
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750040504,
					"content": "うーん。どこに行ってたのか、オイラたちにも説明のしようがないぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040505,
						750040506
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750040505,
					"content": "すぐにはうまく説明できない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750040508
					]
				},
				{
					"id": 750040508,
					"content": "#ありがとう、{NICKNAME}。まさかこの地のアビスが本当に浄化されるとは思わなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040509
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750040509,
					"content": "まるで…もうここに留まる必要もなくなったかのように「光の刻印」も消えてしまったよ。苦しむ声も安息を得たようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040510
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750040510,
					"content": "金色の光…金色の光が、流れる水のように、地面へ染み込んでいく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040511
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750040511,
					"content": "その光の中で、誰かが手を振っているような気がする…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040512
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750040512,
					"content": "キュイッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040513
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750040513,
					"content": "仔竜よ、君も見たのか？光が君たちを包んですぐに姿が見えなくなったのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040514
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750040514,
					"content": "そっか…オイラたちにはなにも見えなかったけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040515
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750040515,
					"content": "#改めて…心から感謝するよ。{NICKNAME}、パイモン、それから{REALNAME[ID(2)|SHOWHOST(true)]}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040516
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750040516,
					"content": "君たちは本当に素晴らしい英雄だ。ようやく安息を得た戦士たちに代わって感謝する。トラオレの遺志も果たされ、それに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040517
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750040517,
					"content": "あのカーンルイアの兵たち…いや、カーンルイアの英雄たちも、この地のアビスがいなくなった以上、もはや悪名でもって警告を成す必要もないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040518
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750040518,
					"content": "私は必ずや、彼らがこだまの子を救った物語を書こうと思う…実際あの場にいて、彼らの考えが完全に理解できたと感じたときがあったのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040519
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750040519,
					"content": "ここにあるのはあまりにも危険なアビスだ。もし私だったら、やはり恐怖をあおる偽の物語を作っていただろう。将来、部族の人たちが近づかないようにと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040520
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750040520,
					"content": "はぁ…これまではどんな物語を書こうかと頭を悩ませていたが、今は書きたいことが多すぎるな。例えば…金髪の異邦人、空飛ぶ白い精霊、そして小さなテペトル竜が部族を救った物語など。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040521
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750040521,
					"content": "へへっ、そりゃ面白そうだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040522
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750040522,
					"content": "ああ。物語は流れ、変化していく。もしかしたら遠い未来にまで語り継がれた頃には、パイモンも山のように大きなパイモンになっているかもしれんな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040523
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750040523,
					"content": "ふむふむ、山のように大きな勇士パイモン！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750040524
					]
				},
				{
					"id": 750040524,
					"content": "へへん！山のように大きな勇士パイモンは、駄獣くらいおっきな鳥肉のスイートフラワー漬け焼きも一口でパクリだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040525
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750040525,
					"content": "キュイッ！キュイッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040526
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750040526,
					"content": "はは！駄獣ほど大きな鳥肉のスイートフラワー漬け焼きはそう多くないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040527
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750040527,
					"content": "そして二人のカーンルイア兵も…物語が伝え続けられるにつれ、やがて英雄になるだろう。彼らは気にしないかもしれないが、これは間違いなく私のすべき事だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040528
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750040528,
					"content": "#ああ、本当に感謝するよ…{NICKNAME}、パイモン…そして感覚の鋭い{REALNAME[ID(2)|SHOWHOST(true)]}も。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040529
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750040529,
					"content": "キュイッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040530
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750040530,
					"content": "…私は語り部として、必ずや君たちのために最高の物語を書こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040531
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750040531,
					"content": "おっと、そういえば…まずは監視所に戻って見張り番をやらなければ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040532
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750040532,
					"content": "いや…あまりに多くのことがありすぎて忘れるところだったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040533
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750040533,
					"content": "こりゃまずい、これ以上待たせたらユカムに生きたまま皮を剥がされてしまう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040534
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750040534,
					"content": "ああ、急いで見張りに戻ったほうがいいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750040506,
					"content": "光る猫を見た…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750040507
					]
				},
