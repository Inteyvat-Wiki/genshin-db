				"points": []
			},
			"dialogs": [
				{
					"id": 20060501,
					"content": "なんですって？師匠は邪気に取り憑かれたわけじゃない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060502
					],
					"speakerTitle": "菜々子"
				},
				{
					"id": 20060502,
					"content": "師匠は自分から狂ったとでも言うんですか？そんな…私は信じません。きっと何か事情があるに違いありません！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060503
					],
					"speakerTitle": "菜々子"
				},
				{
					"id": 20060503,
					"content": "菜々子、落ち着け…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060504
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060504,
					"content": "申し訳ございません。私の力では、土門さんが取り憑かれているのを確認することはできませんでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060505
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 20060505,
					"content": "しかし、この世界には様々な邪が存在します。その多くは私が今まで見たこともないもので、今の段階で結論を出すことはできません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060506
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 20060506,
					"content": "それに、このことに転機がないとは限りません。先ほど私が得た情報によりますと、八重様があなた方の師匠に会ってみたいとおっしゃっているようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060507
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 20060507,
					"content": "八、八重様が？俺の知ってる、あの八重様がですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060508
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060508,
					"content": "「鳴神大社」の大巫女様…八重様が？よかったです、これで師匠は助かります…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060509
					],
					"speakerTitle": "菜々子"
				},
				{
					"id": 20060509,
					"content": "ええ、八重様は幅広い知識を持ち合わせており、これまでも数々の災厄と邪気を払ってきました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060510
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 20060510,
					"content": "あなた方の師匠が邪気に取り憑かれたのかは分かりませんが、八重様ならきっと正しい答えを導き出せるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060511
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 20060511,
					"content": "その、巫女様、八重様に会うには、何か準備は必要でしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060512
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060512,
					"content": "必要ありません。唯一行うべきは、指定された時間に「鳴神大社」に着くことです。八重様は無駄に待つことを嫌っています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060513
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 20060513,
					"content": "では私はこれで。「鳴神大社」にてお会いしましょう。土門さんがいち早く回復することを祈っています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060514
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 20060514,
					"content": "まさか八重様が俺たちの師匠を気にかけてくれるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060515
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060515,
					"content": "兄さんは師匠の名声が八重様の目に留まらないとでも言いたいのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060516
					],
					"speakerTitle": "菜々子"
				},
				{
					"id": 20060516,
					"content": "いや、そんな！それは誤解だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060517
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060517,
					"content": "ただ、八重様なんだぞ！噂では将軍様と深い関係にある大巫女様だって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060518
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060518,
					"content": "コホンッ…とにかく、明日は君も来てくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060519
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060519,
					"content": "わざわざ遠くから弟子入りに来たんだ。どんな結果になろうと、我々「明鏡止水流」は君に結果をもたらすべきだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060520
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060520,
					"content": "じゃあ、また明日。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20060521
					]
				},
				{
					"id": 20060521,
					"content": "おう、オイラもその「八重様」って人が気になるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060522
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20060522,
					"content": "その人から雷電将軍の情報を聞き出せるかもしれないしな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
