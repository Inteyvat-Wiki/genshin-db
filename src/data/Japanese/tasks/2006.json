			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"純也",
					"菜々子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20060101,
					"content": "3人目の「神の目」を失った人は、たしかこの辺りで有名な剣術家だったよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20060102,
					"content": "「明鏡止水流」の現師範らしいけど、なんかすごそうだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20060103,
					"content": "ここがその人の剣術道場みたいだ。ちょうど人がいるみたいだから、聞いてみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20060104,
					"content": "菜々子、そう悲しむな。師匠ならきっと無事だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060105
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060105,
					"content": "以前道場破りに来たヤツらは、どれだけ強くても師匠が負かして追い返してたじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060106
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060106,
					"content": "それでも私、心配で…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060107
					],
					"speakerTitle": "菜々子"
				},
				{
					"id": 20060107,
					"content": "だって昔はどんなに危険な局面に陥ろうと、師匠は動揺しなかったんですよ。それが今や…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060108
					],
					"speakerTitle": "菜々子"
				},
				{
					"id": 20060108,
					"content": "それは師匠が邪気に取り憑かれたからだ！今回行われる邪気払いの儀式が終われば、師匠もきっと元通りになるさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060109
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060109,
					"content": "あの…なにかあったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20060110,
					"content": "君たちは…誰だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060111
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060111,
					"content": "暇を持て余した野次馬か、それとも師匠が邪気に取り憑かれてる隙を見て騒ぎを起こしに来たのか、どっちかは知らないがとっとと帰ってくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060112
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060112,
					"content": "さもないと、俺の剣で斬らせてもらう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060113
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060113,
					"content": "ち、違うんだ…オイラたち…えっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20060114,
					"content": "弟子入りに来た。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20060115
					]
				},
				{
					"id": 20060115,
					"content": "弟子入り？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060116
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060116,
					"content": "そうそう、オイラたち、「明鏡止水流」がすごいって聞いて、それを学ぶために遥々遠くから弟子入りに来たんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20060117,
					"content": "でもここに着いたら、「邪気」とかなんとかが聞こえてきて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20060118,
					"content": "君たちの服装、確かに現地の人間ではないみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060119
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060119,
					"content": "すまない…最近ここに来て面倒を起こす人が多くてな。俺たちも警戒心が強くなってた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060120
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060120,
					"content": "あいにく俺たちの師匠はいま邪気に取り憑かれてしまって、まだ体が回復してない。いま弟子入りさせることはできない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060121,
						20060122
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060121,
					"content": "回復するまで待つ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20060123
					]
				},
				{
					"id": 20060123,
					"content": "どうやら確かに本気で弟子入りしたいみたいだな。分かった、妹弟子と一緒に君たちに師匠の状況を説明しよう。それを聞いてから帰るかどうか自分たちで決めてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060124
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060124,
					"content": "俺たちの師匠は土門という。この名前は君たちも聞いたことがあるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060125
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060125,
					"content": "独学で剣術を学び、数々の有名な剣術家を負かしてきた。一敗もせずに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060126
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060126,
					"content": "師匠は言ってたよ、自分の目標は「天下一」の剣術家になることだって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060127
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060127,
					"content": "俺たちの修行に付き合ってる時も、自分の剣術を磨き続けてた。そんな師匠の情熱に感化された俺たちは、師匠のあとをひたすら追いかけてたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060128
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060128,
					"content": "それなのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060129
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060129,
					"content": "少し前に、師匠の「神の目」が奪われてから、人が急激に変わってしまったのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060130
					],
					"speakerTitle": "菜々子"
				},
				{
					"id": 20060130,
					"content": "何かおかしなことをずっと言い続けていて、私たちにも剣の修行をするなと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060131
					],
					"speakerTitle": "菜々子"
				},
				{
					"id": 20060131,
					"content": "兄弟子と相談した結果、師匠はきっと邪気に取り憑かれたのだと考え、「鳴神大社」の巫女様に邪気のお祓いを頼んだのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060132
					],
					"speakerTitle": "菜々子"
				},
				{
					"id": 20060132,
					"content": "しかし正直、私も師匠が良くなるかどうか分かりません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060133
					],
					"speakerTitle": "菜々子"
				},
				{
					"id": 20060133,
					"content": "「鳴神大社」ってなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060134
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20060134,
					"content": "鳴神大社を知らないのか？あそこは鳴神島で一番大きな神社で、神社を司る大巫女様は雷電将軍と親密な関係にある人物らしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060135
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060135,
					"content": "俺たちじゃ大巫女様に出向いてもらうのは不可能だが…鳴神大社なら普通の巫女様でも、邪気払いの力があるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060136
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060136,
					"content": "だから安心しろ、菜々子。師匠はきっと良くなる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060137
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060137,
					"content": "邪気払いの儀式は今夜行われる。もし興味があるのなら来てみてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060138
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060138,
					"content": "邪気に取り憑かれる…神の目を奪われるとそんなことになるのか？夜になったら来てみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20060122,
					"content": "弟子入りしないと帰れない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20060123
					]
				}
			]
		},
		{
			"id": 200602,
			"completionStepIds": [
				200603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200603",
							"2"
						],
						"stepId": 200603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"純也",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20060201,
					"content": "シーッ…来たか。君たちが来る直前まで師匠は発狂してたんだが、見ずに済んでよかったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060202
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060202,
					"content": "さっき妹弟子が師匠を支えていったが、どうやら師匠が誰かの名前を呟いてるのが聞こえたらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060203
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060203,
					"content": "その人が誰か聞くと、師匠は急に怯えた表情になり、妹弟子を押しのけたそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060204
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060204,
					"content": "苦しみながら耳を塞いでいたらしい。血眼になって、辺りを見回していた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060205
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060205,
					"content": "ずっと名前を叫んでいたよ。俺たちが知ってる人も知らない人もいた。みんなかつて師匠に負かされた剣術家のようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060206
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060206,
					"content": "その中の一人である安西という人は師匠の元兄弟子だった。だが師匠に敗れてから、あてもなく彷徨い続けてるらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060207
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060207,
					"content": "師匠はさっき彼の名前を何度も叫んでた…はぁ、神社の巫女様が師匠を殴って気絶させなかったら、儀式も続けられなかっただろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060208
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060208,
					"content": "邪気払いの儀式はもう始まってる。ここで結果を待ち、師匠の無事を祈ろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060209
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060209,
					"content": "君たちは少しここで待っててくれ、水を取ってくる。師匠が起きたら飲むだろうから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060210
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060210,
					"content": "…ん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20060211,
					"content": "なんかさっきコソコソしてるやつが走ってったぞ？まさか「邪気払いの儀式」を邪魔しようとしてるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20060212,
					"content": "そうはさせるか。旅人、早く追いかけよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 200604,
			"completionStepIds": [
