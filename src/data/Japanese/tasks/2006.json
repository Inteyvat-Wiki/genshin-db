			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"？？？",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20060401,
					"content": "はぁ…はぁ…お前ら…なんでそんなに足が速いんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060402
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060402,
					"content": "本当に土門の弟子か？土門より速く感じたが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060403
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060403,
					"content": "それとも何年も会わねぇうちに、土門のやつまた実力を上げたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060404
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060404,
					"content": "おい！聞きたいことがあるのはこっちだ、おまえは誰なんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20060405,
					"content": "コソコソしてるし、きっと悪いやつだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20060406,
					"content": "悪いやつ？ふんっ、お前らが生まれてくるずっと昔から、俺と土門は一緒に剣を学んできたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060407
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060407,
					"content": "もう昔のことはあまりしゃべりたくねぇが、俺は土門から兄弟子と呼ばれる立場なんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060408
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060408,
					"content": "兄弟子？まさかおまえ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060409
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20060409,
					"content": "そうだ、俺が安西だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060410
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060410,
					"content": "じゃあ、どうして逃げたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20060411
					]
				},
				{
					"id": 20060411,
					"content": "…土門に会いたくねぇからに決まってるだろ。あいつと関係のあるやつともな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060412
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060412,
					"content": "あの時、俺とあいつは同じ剣術家の師匠の下で、一緒に「明鏡止水流」を学んでた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060413
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060413,
					"content": "俺はあいつより5年も早く入門した。みんなに頼られる兄弟子だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060414
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060414,
					"content": "明鏡止水流は「雑念のない心」を追求する流派だ。そのため門下の弟子たちは名声などに興味を持たなかった、俺も含めてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060430
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060430,
					"content": "しかし土門は違った。あいつが門下に入って最初にやったのは、笑いながら師匠に向かって「どうしたら天下一になれるんですか」と聞いたことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060415
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060415,
					"content": "その時、師匠はあいつを叱った、剣術はそのような名声のためにあるものじゃないと。何日か剣を習っただけで最強になるなど、心に雑念を持っている証拠。そんなんじゃ、剣を学ぶなんて永遠にできない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060416
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060416,
					"content": "当時、俺もそう考えてた…だが、土門の剣術の成長はとてつもなく早く、俺にさえ追いついた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060417
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060417,
					"content": "その時、俺は確信したんだ。土門はとっくに「雑念のない心」という境地に達していたんだと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060418
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060418,
					"content": "あいつの心には「天下一を取る」ことしかなかった。剣術の極みを追い求め、どんなに挫折しようと、あいつは立ち直った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060419
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060419,
					"content": "すごい人なんだな…でもなんでその人に会いたくないんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060420
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20060420,
					"content": "それはあいつが来るまで、俺は自分が「明鏡止水流」を受け継ぐことを目標にしていたからだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060431
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060431,
					"content": "師匠の弟子たちの中で、俺は最も優れた才能を持ち、誰よりも剣の修行をし、みんなの期待を背負ってた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060421
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060421,
					"content": "だが、あいつが来てからすべてが変わった。俺はあいつとの勝負に敗れ、面子も地位も失い、門下を逃げ出したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060422
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060422,
					"content": "あとから聞いた話だが、あいつは師匠とも勝負をしたらしい。師匠はすでに年をとっていて、勝負の中で最後の気力を使い果たしてしまったそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060423
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060423,
					"content": "それから、俺はもうあいつとなんの交流もしてねぇ。だが正直なところ、俺はあいつの剣術とそれを追求する心を認めてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060424
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060424,
					"content": "だから、あいつが発狂したと聞いた時は嘘だと思ってた。あいつが発狂なんかするタマか？「明鏡止水」の極みに達したやつなんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060425
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060425,
					"content": "それでこっそり、本当に狂ったかどうか確かめに来たんだ。なのにあいつ、俺の名前なんか呼んでやがった…俺はてっきりもうとっくに忘れたのかと思ってたぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060426
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060426,
					"content": "とにかく、あいつに害を加えるつもりはねぇよ。ただ確かめに来ただけなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060427
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060427,
					"content": "さあ、もう帰ってくれ。俺から話すことはもうなんもねぇ。邪気払いの儀式も…すでに終わったころだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060428
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060428,
					"content": "おう…どうやら「邪気払いの儀式」を邪魔しに来たわけじゃなかったんだな。誤解だったみたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060429
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20060429,
					"content": "でも、この人を連れて行くべきかどうかは迷うな…とりあえず「邪気払いの儀式」がどうなったか見に行ってみよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 200605,
