				"points": []
			},
			"dialogs": [
				{
					"id": 20060601,
					"content": "あ、あの人が「八重様」か…純也の言ってた通り、すごく強いオーラを放ってるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060602
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20060602,
					"content": "それに、さっきオイラたちのことを見てなかったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060603
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20060603,
					"content": "うーん、オイラの見間違いだったかも…なにせオイラたちとあの人って初めて会ったはずだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20060604,
					"content": "来るな…俺に近づくな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060605
					],
					"speakerTitle": "土門"
				},
				{
					"id": 20060605,
					"content": "もう剣はやめたんだ、許してくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060606
					],
					"speakerTitle": "土門"
				},
				{
					"id": 20060606,
					"content": "見ての通りです、八重様。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060607
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 20060607,
					"content": "土門さんはずっとこの状態です。かつて彼に負けた人が周りで自分を罵っているようで、とても苦しんでいます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060608
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 20060608,
					"content": "八重様、師匠は…邪気に取り憑かれたのでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060609
					],
					"speakerTitle": "菜々子"
				},
				{
					"id": 20060609,
					"content": "師匠は以前このような感じではありませんでした…師匠は昔、どんなことがあっても笑っていたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060610
					],
					"speakerTitle": "菜々子"
				},
				{
					"id": 20060610,
					"content": "…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060611
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20060611,
					"content": "残念じゃが、汝らの師匠から邪気は感じられぬ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060612
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20060612,
					"content": "そんな…では師匠は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060613
					],
					"speakerTitle": "菜々子"
				},
				{
					"id": 20060613,
					"content": "そう、自らこのようになった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060614
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20060614,
					"content": "巨大な重圧に耐えかね、心は崩壊。精神も傷つき、最後には発狂する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060615
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20060615,
					"content": "水に落ちた者のように、足掻けば足掻くほど、暗く冷たき深海に堕ちる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060616
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20060616,
					"content": "「原因」は、おそらく神の目を失ったことじゃろう。神の目を奪われるというのは、「願い」を奪われることと同じじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060617
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20060617,
					"content": "「願い」…しかし八重様、願いを奪われたというのなら、師匠は一般の人に戻るだけなんじゃないですか？どうして発狂なんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060618
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060618,
					"content": "汝らの流派、「明鏡止水流」と言ったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060619
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20060619,
					"content": "いい名じゃが、今のこの世の中、本物の「明鏡止水」などどこにもあらぬ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060620
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20060620,
					"content": "名声に興味ないと自称する者は、弟弟子に破られ門下を去る。年配の剣術家は怒りを抱き、自身の教え子に勝負をしかける。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060621
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20060621,
					"content": "では雑念がないように見える者が、その手で自身の師匠と兄弟子を負かした時、本当に何も感じぬと思うか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060622
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20060622,
					"content": "八重様のおっしゃる意味は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060623
					],
					"speakerTitle": "菜々子"
				},
				{
					"id": 20060623,
					"content": "剣の道とは、千変万化。剣術で天下一を取ることは、凡人にとって容易いものではない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060624
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20060624,
					"content": "その手に剣を持ち、他者の夢を打ち砕いていく必要がある。たとえそれが、彼の近くにいる親しい者であろうとも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060625
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20060625,
					"content": "ゆえに、「天下一を取る」という願いに執着し、苦しみを一時的に忘れることで、先に進むことができたのじゃろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060626
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20060626,
					"content": "その願いが失われた時、彼は自分を否定し始め、恐怖にもがく。そして、このようになる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060627
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20060627,
					"content": "ふふ、そう、あの未熟な妾の友人のように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060628
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20060628,
					"content": "師匠はずっとそのような苦しみを抱えてきたのですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060629
					],
					"speakerTitle": "菜々子"
				},
				{
					"id": 20060629,
					"content": "すまない、ぜんぶ俺のせいなんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060630
					],
					"speakerTitle": "土門"
				},
				{
					"id": 20060630,
					"content": "父さん、師匠、安西さん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060631
					],
					"speakerTitle": "土門"
				},
				{
					"id": 20060631,
					"content": "もういい！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060632
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060632,
					"content": "えっ？さっき会った土門さんの兄弟子？なんでここに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060633
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20060633,
					"content": "オイラたちのあとをこっそりつけて来たのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060634
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20060634,
					"content": "安西…どうして安西が二人…鬼…なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060635
					],
					"speakerTitle": "土門"
				},
				{
					"id": 20060635,
					"content": "俺に復讐しに来たんだろ…分かってるさ…やはり俺はあの時…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060636
					],
					"speakerTitle": "土門"
				},
				{
					"id": 20060636,
					"content": "確かに俺はお前のことを気に食わねぇやつだと思ってる。だが、お前の謝罪なんか聞きたくねぇ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060637
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060637,
					"content": "何年も経ち、もうぜんぶ理解した。はなっからお前は間違ったことなんか何もしてねぇ。間違えてたのは俺なんだ…面子を失うことに耐えかねて、門下から逃げ出した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060638
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060638,
					"content": "お前に負かされたほとんどのやつが、お前を責めたりなんかしねぇと俺は信じてる。それどころか、俺たちは自分たちの願いをお前に託した。お前がさらに高みに行けることを願ってた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060639
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060639,
					"content": "お前の願いが奪われ、俺たちの期待に応えられねぇことはもう知ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060640
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060640,
					"content": "だけどお前はあいつらの願いまで奪っちゃならねぇ！「剣術を磨き、天下一を取る」、お前があいつらに教えたことじゃねぇか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060641
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060641,
					"content": "だがいつの日か、あいつらも俺のように…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060642
					],
					"speakerTitle": "土門"
				},
				{
					"id": 20060642,
					"content": "血をにじませながら天下一を追いかけるかもしれない。最初から間違ってたんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060643
					],
					"speakerTitle": "土門"
				},
				{
					"id": 20060643,
					"content": "いつの日か、あいつらも俺みたいになるっていうのなら…俺は前に進むことをやめ、ここで立ち止まる方がマシだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060644
					],
					"speakerTitle": "土門"
				},
				{
					"id": 20060644,
					"content": "…そいつらの考えを聞いたことはあるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060645
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060645,
					"content": "師匠…師匠は以前、海賊から私を救ってくださいました。私はその時、師匠の後ろを追いかけることに決めたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060646
					],
					"speakerTitle": "菜々子"
				},
				{
					"id": 20060646,
					"content": "将来、師匠のように苦しむのかなんて私には分かりません。ただ私に分かるのは、今の私はまだ止まりたくないということだけです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060647
					],
					"speakerTitle": "菜々子"
				},
				{
					"id": 20060647,
					"content": "いつの日か正々堂々胸を張り、私は師匠の弟子で「明鏡止水流」の伝承者なんだと皆さんに伝えることができると信じています！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060648
					],
					"speakerTitle": "菜々子"
				},
				{
					"id": 20060648,
					"content": "菜々子だけじゃない…俺たち、他のみんなもそう思ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060649
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060649,
					"content": "お前たち…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060650
					],
					"speakerTitle": "土門"
				},
				{
					"id": 20060650,
					"content": "ほら見ろ…自分の願いをそいつらに託してもいいんじゃねぇか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060651
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060651,
					"content": "「願いが奪われる」なんてこと、俺は経験したこともないから分かるはずもねぇ。だがお前に負けたあの時、俺も願いが砕かれる瞬間を感じたことはある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060652
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060652,
					"content": "だからよ…俺が自分の願いをお前に託したように、お前もそいつらに願いを託せ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060653
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060653,
					"content": "俺とお前は違う。俺が去った時、俺にはなんにもなかった。だがお前にはこんなにも優秀な弟子たちがたくさんいるじゃねぇか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060654
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060654,
					"content": "そうか…分かったよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060655
					],
					"speakerTitle": "土門"
				},
				{
					"id": 20060655,
					"content": "すまなかった。「明鏡止水流」の師範だというのに、お前たちに心配をかけてしまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060656
					],
					"speakerTitle": "土門"
				},
				{
					"id": 20060656,
					"content": "今の俺は、天下一になんて興味はない…心にある虚無と苦痛が解消されない限り、再び「雑念のない心」に到達することは不可能だろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060671
					],
					"speakerTitle": "土門"
				},
				{
					"id": 20060671,
					"content": "だがお前たちの師匠として、俺がこの人生で学んだすべてのものをお前たちに教えてやれる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060657
					],
					"speakerTitle": "土門"
				},
				{
					"id": 20060657,
					"content": "この点は、兄弟子にも監督してもらいたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060658
					],
					"speakerTitle": "土門"
				},
				{
					"id": 20060658,
					"content": "もちろん見張っておくさ。また発狂されたら困るのはこっちだからな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060672
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060672,
					"content": "だが俺はもう今の気ままな生活に慣れてる。道場に残るのはやめておこう。たまにお前のところに行って、サボってねぇか見てやる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060659
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060659,
					"content": "何を呆けてるんだ。早く八重様に礼を言って帰るぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060660
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060660,
					"content": "うんうん、奪われた願いを弟子たちに受け継がせる…これで解決したよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060661
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20060661,
					"content": "うん、一段落したかな…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20060662
					]
				},
				{
					"id": 20060662,
					"content": "旅人さん、お待ちを。八重様からお話がございます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060663
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 20060663,
					"content": "…やはり、妾の気のせいじゃなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060664
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20060664,
					"content": "異郷から訪れる風、この海域に新たな望みを吹き付ける…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060665
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20060665,
					"content": "妾たちの出会いは、少々早すぎたかもしれぬ。じゃが、汝がこの島を訪れた時機はちょうどよかったといえよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060670
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20060670,
					"content": "…妾の期待に応えられるよう励むがよい、童よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060666
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20060666,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20060667
					]
				},
				{
					"id": 20060667,
					"content": "んん？あの八重様って人、おまえに興味津々みたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060668
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20060668,
					"content": "不思議なやつだな。さっき言ったことの意味はいったい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060669
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20060669,
					"content": "うーん、これについてはまた今度話そう。今は早く戻って綾華に報告しようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 200607,
