			},
			"dialogs": [
				{
					"id": 4620501,
					"content": "#や！{NICKNAME}、戻ってきたか。その様子だと、手がかりを得たみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620502
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4620502,
					"content": "手に入れたはいいけど、一筋縄じゃいかなそうだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4620503,
					"content": "「湖の城に、六本腕の巨人が三体いる。二体は神の像を守り、一体は神々の財宝を守っている。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4620504,
					"content": "謎解きか、ベタなこった。そうだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620505
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4620505,
					"content": "湖の城はモンドのことで間違いないだろう。で、六本腕の巨人は…六…六に関わるものと言ったら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620506
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4620506,
					"content": "カニ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620507
					]
				},
				{
					"id": 4620507,
					"content": "てことは、六本腕の巨人は巨大なカニか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620508
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4620508,
					"content": "…巨大なカニがいるかどうかはともかく…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620509
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4620509,
					"content": "カニの足は八本だぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620516
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4620516,
					"content": "…それなら風車か？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620517
					]
				},
				{
					"id": 4620517,
					"content": "たぶん…風車？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620518
					]
				},
				{
					"id": 4620518,
					"content": "おお、さすがだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620519
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4620519,
					"content": "風車の羽根はちょうど六枚。それを「六本腕の巨人」として喩えているんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620510
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4620510,
					"content": "ああっ！言われてみれば！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620511
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4620511,
					"content": "あとは簡単だ。三本の風車のうち、神の像の近くにある二本が、神の像を守る「巨人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620512
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4620512,
					"content": "残りの一本が守っているものこそ、おそらく…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620513
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4620513,
					"content": "お宝！オイラでもわかるぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620514
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4620514,
					"content": "ハハッ…上手くいくといいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620515
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4620515,
					"content": "#{NICKNAME}、行こう！その風車のところまで行ってみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 46207,
			"completionStepIds": [
				46207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"46207",
