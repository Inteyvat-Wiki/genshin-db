				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ガイア"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4620701,
					"content": "「彼女は彼のことを愛してなどいなかった。清き泉の情熱はただの虚像。寂しさに震える時こそ、彼女の心が見える。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620702
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4620702,
					"content": "何か分かったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620703
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4620703,
					"content": "お前らが拾ってきたの、ただの恋愛小説の切れ端じゃないだろうな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620704
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4620704,
					"content": "何だ、間違って拾ってきてたのか。どうりで天才のオイラでも解けないわけだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620705
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4620705,
					"content": "ハハッ、冗談だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620706
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4620706,
					"content": "もう、真面目に考えてくれよ、ガイア！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620707
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4620707,
					"content": "確かに、この謎は前回より難しいようだな。清き泉…清泉町のことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620708
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4620717,
					"content": "誰かが泉で水浴びしている時？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4620724,
					"content": "高低差がある時…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4620708,
					"content": "「清き泉の情熱」…どんな時に、清き泉が情熱を帯びるんだろうな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620709
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4620718,
					"content": "…そんな恥じらいのないヤツ、モンドではもう見かけないと思うがな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4620719,
					"content": "まさか…お前の趣味か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4620720,
					"content": "これは失礼、他人の趣味に口を出すべきじゃなかったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4620721,
					"content": "#おい、{NICKNAME}を何だと思ってるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4620723,
					"content": "だったら…泉に高低差がある時とか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4620722,
					"content": "ハハッ、でももしそうなら、情熱的なのは泉じゃなくて、入っている人の方じゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4620725,
					"content": "いい発想だ！例えば、そう、滝とか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4620726,
					"content": "それなら、清泉町の裏山にある滝のことだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4620727,
					"content": "モンドの清き泉が情熱的な一面を見せてくれているのは、あそこだけだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4620709,
					"content": "「滝の心」については、おそらく滝の左側を指すはずだ。ちょうどその位置に崖がある。見回りの時、滝の下から見たことがあるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620710
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4620710,
					"content": "最後の「寂しさに震える時」は、神の目が操る氷元素と何か関係があると思うぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620711
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4620712,
					"content": "助かったよ、ガイアさん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620713
					]
				},
				{
					"id": 4620711,
					"content": "<color=#00E1FFFF>氷元素を扱える仲間</color>を連れてったほうがいいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620712
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4620713,
					"content": "大したことじゃないさ。西風騎士団の一員として、謎の一つや二つくらい解けなきゃ、犯罪者の企みを見抜くこともできないだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620714
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4620714,
					"content": "じゃあ、オイラたちは清泉町に行ってみるよ。せいぜい企みを頑張れよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620715
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4620715,
					"content": "…うん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620716
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4620716,
					"content": "あっ、違った…犯罪者の企みを見抜くのを頑張れよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
