			"trigger": {
				"objectNames": [
					"ヴァル"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4620301,
					"content": "はあ…とんだ目に遭ったわ。<color=#00E1FFFF>あいつ</color>の頼みなんて聞かなきゃよかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620302
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 4620302,
					"content": "あいつ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4620303,
					"content": "ありがとう、助かったよ！西風騎士団の人たちより、よっぽど頼りになるのね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620304
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 4620304,
					"content": "これくらい朝飯前だ！こいつは旅人として毎日いろんな厄介ごとを解決してきてるからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4620305,
					"content": "旅人？じゃあ君だったのね。まさか、<color=#00E1FFFF>待ち合わせ相手</color>に助けられるなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620306
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 4620306,
					"content": "それじゃあ、おまえが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4620307,
					"content": "ふふ…ちょうど、どうお礼をしたらいいか考えてたの。今回の情報はタダでいいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620308
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 4620308,
					"content": "情報屋は人脈を重んじるからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620309,
						4620311
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 4620309,
					"content": "本当にいいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620310
					]
				},
				{
					"id": 4620310,
					"content": "もちろん、君は命の恩人だもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620312
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 4620312,
					"content": "やった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4620313,
					"content": "うん？でも…結局、得するのはガイアじゃないか。情報料は出してもらうはずだったんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620314
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4620314,
					"content": "それじゃあ、よく聞いてね、「アルカディア遺跡」についての情報…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620315
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 4620315,
					"content": "「湖の城に、六本腕の巨人が三体いる。二体は神の像を守り、一体は神々の財宝を守っている。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620316
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 4620316,
					"content": "…え？それだけ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620325
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4620325,
					"content": "この情報が記されている紙には、こんな絵も描いてあったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620317
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 4620317,
					"content": "これは…宝の地図か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620318
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4620318,
					"content": "苦労して手がかりを手に入れたはいいけど、次は謎解きかよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620319
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4620319,
					"content": "#でもこんなもん、{NICKNAME}にかかれば大したことないよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620320,
						4620321
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4620320,
					"content": "もちろん！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620322
					]
				},
				{
					"id": 4620322,
					"content": "まあ、解けなかったら、ガイアに聞いてみよう。あいつ、頭は切れるみたいだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620326
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4620326,
					"content": "この紙はあなたたちにあげる、忘れたらいつでも読み返してみて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620327
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 4620327,
					"content": "へへっ、ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620323
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4620323,
					"content": "「湖の城に、六本腕の巨人が三体いる。二体は神の像を守り、一体は神々の財宝を守っている。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620324
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4620324,
					"content": "…どういう意味だろうな？ガイアの手を借りたくないなら、ひとまずオイラたちで考えてみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4620321,
					"content": "…たぶん…大丈夫…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620322
					]
				},
				{
					"id": 4620311,
					"content": "ありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620312
					]
				}
			]
		},
