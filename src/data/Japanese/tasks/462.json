				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4620401,
					"content": "見せて見せて！何があったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4620402,
					"content": "「彼女は彼のことを愛してなどいなかった。清き泉の情熱はただの虚像。寂しさに震える時こそ、彼女の心が見える。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620407
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4620407,
					"content": "今回も絵がついているな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4620403,
					"content": "何だよ、また謎解きか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4620404,
					"content": "もうだめだ、オイラは疲れた、くらくらする。頭の使いすぎだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4620405,
					"content": "言うほど頭使ってない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620406
					]
				},
				{
					"id": 4620406,
					"content": "とにかく、今回もよろしくな！へへっ、わからなかったら、またガイアに聞いてみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
