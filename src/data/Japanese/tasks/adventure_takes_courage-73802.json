			"dialogs": [
				{
					"id": 738020101,
					"content": "星と深淵を目指せ！ようこそ、冒険者協会へ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020102
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 738020102,
					"content": "こんにちは、キャサリン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 738020103,
					"content": "やあ、キャサリン…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738020104
					]
				},
				{
					"id": 738020104,
					"content": "こんにちは。今日は調子がよさそうですね。依頼を受けにいらしたのですか？それとも他の用件でしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020105
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 738020105,
					"content": "えっと…なぜ私をじっとご覧になっているんでしょう？何か…私にご質問でも？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020106,
						738020107
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 738020106,
					"content": "別に！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738020108
					]
				},
				{
					"id": 738020108,
					"content": "そうですか…そのご様子ですと、冒険には相当慣れておられるようですね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020109
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 738020109,
					"content": "まあそうかな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738020110
					]
				},
				{
					"id": 738020110,
					"content": "では冒険者協会の運営システムはよくご存知でしょうから、余計な説明は省きます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020111
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 738020111,
					"content": "もし協会の仕事に関してご質問がありましたら、お気軽にお問合せください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020112
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 738020112,
					"content": "スメールシティでも、沢山依頼を引き受けてくださいね。あなたのように実力のある冒険者なら、きっとみなさんのお役に立てるはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020113
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 738020113,
					"content": "勇敢に冒険を続けてください。星と深淵を目指せ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 738020107,
					"content": "た、ただ依頼を受けたいなと…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738020108
					]
				}
			]
		}
	]
}