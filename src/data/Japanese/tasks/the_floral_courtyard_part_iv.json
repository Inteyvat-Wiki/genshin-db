	"talks": [
		{
			"id": 7269001,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7269002",
							"2"
						],
						"stepId": 7269002,
						"stateName": "QUEST_STATE_UNFINISHED"
