			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"柴染"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726900101,
					"content": "お二方、ついにこの日が訪れました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900102
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726900102,
					"content": "「花影瑶庭」の構図を作るにあたり、あなたたちはその真髄を究めました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900103
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726900103,
					"content": "ここより先は、花芸における真の試練となります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900104
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726900104,
					"content": "えっ？オイラたちもう花芸の真髄を掴んだのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726900105,
					"content": "真の試練って、つまり一番難しい花題ってことだろ。オイラ、なんだか不安になってきた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726900106,
					"content": "まだ始めてそんなに経ってないのに。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726900107
					]
				},
				{
					"id": 726900107,
					"content": "花材を作る技術でしたら、確かに長い時間をかけて磨き続ける必要があります。ですが、「花庭」の景観と構成を考えるのは、むしろ感覚とひらめきのほうが大事なのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900108
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726900108,
					"content": "後者だけであれば、お二方は驚くべき天賦を見せてくれました。「花題」という鍛錬はもう必要ありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900109
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726900109,
					"content": "これも魅力ある旅を通じて、私が想像もできないような景色を見てきたからなのかもしれません。だから、一般の人とは違う心境を持っているのでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900110
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726900110,
					"content": "そ、そうなのかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726900111,
					"content": "でも確かに、オイラたちって色んなところに行ったよな。旅をすると、ひらめきもたくさん生まれるってことか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726900112,
					"content": "オイラたち、ここ数日花芸を学んできたけど、どれくらいひらめきを使っちゃったんだろうな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900113,
						726900114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726900113,
					"content": "旅はまだまだ続くから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726900115
					]
				},
				{
					"id": 726900115,
					"content": "ああ、確かにそうだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726900116,
					"content": "ありがとな、柴染さん！おまえのおかげで、こんな才能があることにオイラたち初めて気づけたぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726900117,
					"content": "いえ、どういたしまして。では、もっとも美しい「花庭」で、今回の花芸体験を終わらせましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900118,
						726900122
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726900118,
					"content": "うん、花題を出して。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726900119
					]
				},
				{
					"id": 726900119,
					"content": "それでは、本日の花題は——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900120
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726900120,
					"content": "「曲がる枝は虹の如し、鮮やかに彩る」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900121
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726900121,
					"content": "あなたたちの技術の集大成である「花影瑶庭」を楽しみにしています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柴染"
				},
				{
					"id": 726900122,
					"content": "他に用事がある…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726900123
					]
				},
				{
					"id": 726900123,
					"content": "ええ、それでしたら大丈夫です。花を生けるには、心を落ち着かせる必要がありますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900124
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726900124,
					"content": "用事を済ませ、喧噪から離れた時、花題にある「花庭」をより完璧なものにすることができるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柴染"
				},
				{
					"id": 726900114,
					"content": "ひらめきは積み重なっていくから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726900115
					]
				}
			]
		},
		{
			"id": 7269003,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7269003",
