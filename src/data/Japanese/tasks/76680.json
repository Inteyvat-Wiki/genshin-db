					"あかたましっぽ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 766800101,
					"content": "#おや、{NICKNAME}にパイモン！こんにちは！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800102
					],
					"speakerTitle": "青霆"
				},
				{
					"id": 766800102,
					"content": "ここで会ったのもの何かの縁だし、うちのイタチを見ていかない？あかたましっぽっていうんだ。可愛いでしょ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800103
					],
					"speakerTitle": "青霆"
				},
				{
					"id": 766800103,
					"content": "…ニャー？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800104
					],
					"speakerTitle": "あかたましっぽ"
				},
				{
					"id": 766800104,
					"content": "ちょっと、あかたましっぽ、その鳴き声じゃないって！この二人は、アシュル先生の言葉が分からないはずだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800105
					],
					"speakerTitle": "青霆"
				},
				{
					"id": 766800105,
					"content": "…チュン？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800106
					],
					"speakerTitle": "あかたましっぽ"
				},
				{
					"id": 766800106,
					"content": "ヤマガラ語もダメ。バシマさんはもう静養のためにスメールに帰っちゃったんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800107
					],
					"speakerTitle": "青霆"
				},
				{
					"id": 766800107,
					"content": "ごめんね…この子、他の動物と交流しすぎたせいで混乱しちゃって、自分の喋り方に戻れなくなってるみたい。あはは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800108
					],
					"speakerTitle": "青霆"
				},
				{
					"id": 766800108,
					"content": "少し休ませてあげたほうがよさそうだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800109,
						766800110
					],
					"speakerTitle": "青霆"
				},
				{
					"id": 766800109,
					"content": "#{M#君}{F#あなた}も、動物に詳しいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800111
					]
				},
				{
					"id": 766800111,
					"content": "うーん…おまえ、なんだかオイラたちに対して妙に気さくだな。話し方に違和感もないし…まさか、オイラたちのことを調べたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766800112,
					"content": "まあまあ、落ち着いて。私はあなたたちの身内だから——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800113
					],
					"speakerTitle": "青霆"
				},
				{
					"id": 766800113,
					"content": "私は夜蘭ボスの下で働いてる。で、あなたたちはそのボスの最重要格の賓客。私たちがいかに近しいか、これ以上の説明はいらないよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800114,
						766800115
					],
					"speakerTitle": "青霆"
				},
				{
					"id": 766800114,
					"content": "それなら確かに身内だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800116
					]
				},
				{
					"id": 766800116,
					"content": "なんだよ、先に言えよな！ちょっとドキドキしちゃったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766800117,
					"content": "それはそうと、おまえたち、こんな場所でなにやってるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766800118,
					"content": "門番で忙しい…っていうか、私の「門番軍団」がちゃんと任務を遂行できるか確かめてるところだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800119,
						766800120
					],
					"speakerTitle": "青霆"
				},
				{
					"id": 766800119,
					"content": "門番？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800121
					]
				},
				{
					"id": 766800121,
					"content": "身内だからね、こっそり教えてあげる——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800122
					],
					"speakerTitle": "青霆"
				},
				{
					"id": 766800122,
					"content": "この近くの地下に私の物資拠点が隠してあるんだけど…最近、拠点の門がいろんな魔物にこじ開けられちゃってさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800123
					],
					"speakerTitle": "青霆"
				},
				{
					"id": 766800123,
					"content": "そこで大金をはたいて、カチャカチャ・クルムカケ工房の天才機械技師に門番となる機械軍団を作ってもらったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800124
					],
					"speakerTitle": "青霆"
				},
				{
					"id": 766800124,
					"content": "コホン、正確に言うならセキュリティシステムかな。配備場所を選択できて、様々な機能を組み合わせられる防衛用のシステムだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800125
					],
					"speakerTitle": "青霆"
				},
				{
					"id": 766800125,
					"content": "ところで、いいところに来てくれたね。もうすぐ、その天才技師さんが自分の作品で展覧会に出展する予定なんだ。私が作ってもらったのは、そのテストモデルってわけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800126
					],
					"speakerTitle": "青霆"
				},
				{
					"id": 766800126,
					"content": "だから、拠点の前に何層もの防衛線を構築したんだ。魔物を罠に誘い込むためにね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800127
					],
					"speakerTitle": "青霆"
				},
				{
					"id": 766800127,
					"content": "これで、拠点防衛の手段をいくつも試せるだけじゃなく、天才技師さんにいっぱいデータを提供できる…まさに一石二鳥ってこと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800128,
						766800129
					],
					"speakerTitle": "青霆"
				},
				{
					"id": 766800128,
					"content": "なるほど、アイノの傑作を手に入れたんだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800130
					]
				},
				{
					"id": 766800130,
					"content": "あなたもやってみる？これでたくさん魔物をやっつけたんだけど、すごくストレス解消になるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800131
					],
					"speakerTitle": "青霆"
				},
				{
					"id": 766800131,
					"content": "あなたたちは気分転換できるし、私はそこからアイデアを得られるかも！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800132
					],
					"speakerTitle": "青霆"
				},
				{
					"id": 766800132,
					"content": "もちろん、報酬は弾むよ。身内なんだし、普通の顧問の倍は出さないとね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800133,
						766800134
					],
					"speakerTitle": "青霆"
				},
				{
					"id": 766800133,
					"content": "確かに身内なんだし、多めにね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800135
					]
				},
				{
					"id": 766800135,
					"content": "なるほどな…よし！おまえを手伝うことは、夜蘭を手伝うことにもなるし、みんなにとっていいことだから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800136
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766800136,
					"content": "経験豊富なオイラたちが、腕前を見せてやるとしようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766800134,
					"content": "いやいや、そんなの悪いよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800135
					]
				},
				{
					"id": 766800129,
					"content": "なかなか面白そうだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800130
					]
				},
				{
					"id": 766800120,
					"content": "軍団？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800121
					]
				},
				{
					"id": 766800115,
					"content": "#夜蘭の知人なら、{M#俺}{F#私}たちの知人でもあるね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800116
					]
				},
				{
					"id": 766800110,
					"content": "#{M#君}{F#あなた}も動物と友達なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800111
					]
				}
			]
		}
	]
}