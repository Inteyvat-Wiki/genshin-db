			"dialogs": [
				{
					"id": 732750102,
					"content": "ゴールデンローズの芽が出たよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732750103
					]
				},
				{
					"id": 732750103,
					"content": "これは…どこでこの花の種を見つけたのだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750104
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732750104,
					"content": "凄く遠いところで拾った。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732750105
					]
				},
				{
					"id": 732750105,
					"content": "シャフカットおじさんが撒いた種は、本当に砂漠のあちこちに行ったのだな。だが、周りまわってここまで戻ってきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750107
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732750107,
					"content": "これらの花の苗は大事に保存して、全部サバーフのやつに残してやらんと。わしがいなくなったら、花はサバーフに任せる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750108
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732750108,
					"content": "二人とも、ありがとうな。大したお礼はできんが、この果実と花を受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アファン"
				}
			]
		},
