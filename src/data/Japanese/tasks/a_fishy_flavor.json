			"dialogs": [
				{
					"id": 220420401,
					"content": "主ら戻ってきたか。あの子らもなぜか怖がった様子で帰ってきたにゃ、実に変だにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420402
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220420402,
					"content": "まさか、野外で棒を持った毛むくじゃらのやつに遭遇したのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420403
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220420403,
					"content": "まあ、帰ってきてよかった…主ら、どうしたにゃ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420404
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220420404,
					"content": "#実は…{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}が原因で…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420405
					]
				},
				{
					"id": 220420405,
					"content": "…本当に意味のわからない人間にゃ！どうしてそんなことするにゃ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420406
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220420406,
					"content": "あの子らと遊びたかったら、普通の方法を使えばいいにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420407
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220420407,
					"content": "にゃ！どうりであの子らあんなに怖がってたのかにゃ…きちんと慰めてやらにゃいと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420408
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220420408,
					"content": "まったく…やっぱり、すべての人間が響と同じであることを期待してはならにゃい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
