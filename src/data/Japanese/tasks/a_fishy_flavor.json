			"dialogs": [
				{
					"id": 220420101,
					"content": "まったく、世話が焼けるにゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420102
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220420102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420103
					]
				},
				{
					"id": 220420103,
					"content": "主らか、あの子らがまた外に遊びに行った。本当に手のかかる子にゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420104,
						220420105
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220420104,
					"content": "何をすればいいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420106
					]
				},
				{
					"id": 220420106,
					"content": "神社の外には鉄球がかかっている、あの子らも帰り道を見失うことはにゃい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420107
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220420107,
					"content": "まあ、人間の前で騒ぐよりはマシにゃ。もし神社に人間が来たときに騒いでいたら、神社の品格が落ちてしまうにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420108
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220420108,
					"content": "だけど、はしゃぎすぎすると…太陽が沈んでから月が昇るまで、腹を空かせることににゃる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420109
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220420109,
					"content": "主ら、魚をあの子らに持っていってくれぬか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420110,
						220420113
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220420110,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420111
					]
				},
				{
					"id": 220420111,
					"content": "じゃあ地図を寝子に渡そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 220420112,
					"content": "うむ、主は察しがいいにゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420115
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220420115,
					"content": "これでよし、早く行くにゃ。うちはまだ神社の掃除が残ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220420113,
					"content": "地図に印を…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420114
					]
				},
				{
					"id": 220420114,
					"content": "うむ、主は察しがいいにゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420115
					],
					"speakerTitle": "「寝子」"
				},
				{
