			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"志璇",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710360201,
					"content": "#こんにちは！{NICKNAME}先輩、お元気でしたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360202,
						710360204
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710360202,
					"content": "#まあまあ。{M#君}{F#あなた}こそ大丈夫だった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360203
					]
				},
				{
					"id": 710360203,
					"content": "お気遣いありがとうございます。もう大丈夫ですよ、ご心配をおかけしてすみません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360206
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710360206,
					"content": "おいおい、もうあまり走り回るなよ！じゃないとまたこの前みたいに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710360207,
					"content": "もうしませんって。先輩のおかげで、層岩巨淵もすごく安全になりました。地質的特徴も…まあ、だいぶ安定してます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360208
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710360208,
					"content": "でも瑾武姉さんとヘディーヴは、まだあの不思議な結晶の…えっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360209
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710360209,
					"content": "波長？を研究するみたいですよ。ヘディーヴがそう言ってました。おおかたスメールのおかしな専門用語でしょう…とにかく、情報を集めるにはまず、ビーコンを配置しないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360210
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710360210,
					"content": "瑾武姉さんも、最近やっとビーコンを全部組み立てる時間ができたんです。それで、情報を集めるために、私がそれらのビーコンを特定の場所に配置しに行くことになりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360211
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710360211,
					"content": "一定期間で回収すれば、あとの計算は全部ヘディーヴがやってくれます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360212
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710360212,
					"content": "以前はどの区域も危険だったので、限られた拠点内でしか測定できませんでした…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360213
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710360213,
					"content": "ですが、先輩によって道が開かれた今、ビーコンによる実地計測でより正確な情報が手に入るようになりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360214
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710360214,
					"content": "ふぅ…やっぱり、やることがあるって言うのはいいですね。そうだ、先輩も他に用事がないのなら、一緒に来てくださいよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360215,
						710360217
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710360215,
					"content": "じゃあ、行こうか。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360216
					]
				},
				{
					"id": 710360216,
					"content": "はい、行きましょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志璇"
				},
				{
					"id": 710360217,
					"content": "#{M#俺}{F#私}たちに何かメリットはある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360218
					]
				},
				{
					"id": 710360218,
					"content": "おい、なにがなんでも直接的すぎるだろ！まあ、オイラも気になるけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360219
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710360219,
					"content": "あははっ、今回のはあくまでも簡単な行き来ですからね。強いて言うなら、瑾武姉さんからお礼を言われるくらいでしょうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志璇"
				},
				{
					"id": 710360204,
					"content": "#あまりよくないかな。{M#君}{F#あなた}は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360205
					]
				},
				{
					"id": 710360205,
					"content": "まあ…あんまり良いとは言えないですね。リスクのあることは全部先輩に任せちゃってますし、あははっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360206
					],
					"speakerTitle": "志璇"
				}
			]
		},
		{
			"id": 7103603,
			"completionStepIds": [
				7103610
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103610",
							"2"
						],
						"stepId": 7103610,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"志璇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710360301,
					"content": "本当にお疲れ様でした、心ばかりのお礼ですが、受け取ってください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360302
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710360302,
					"content": "そんなに気を遣わなくていいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360303
					]
				},
				{
					"id": 710360303,
					"content": "ふぅ…どうやら近ごろは、層岩巨淵での地形の異変も治まっているようです。つまり、地図の修正も少しだけで済みそうですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360304
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710360304,
					"content": "先輩のおかげで、私たちの仕事もだいぶ楽になりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360305
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710360305,
					"content": "ああ、これ以上先輩を引き留めるのは野暮ですよね。でも、まだ探検を続けたいなら、止めませんから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360306
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710360306,
					"content": "ふぅ…ビーコンの回収はだいぶ先になります。次回も先輩と同行できたらいいのですが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志璇"
				}
			]
		},
		{
			"id": 7104116,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103713",
							"3"
						],
						"stepId": 7103713,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"志璇",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710411201,
					"content": "先輩、何かご用ですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411202,
						710411212,
						710411223,
						710411232
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710411202,
					"content": "地図について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710411203
					]
				},
				{
					"id": 710411203,
					"content": "地図ですか？特に言うこともないですが…冒険者協会に入る前、私は鉱区の製図員だったんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411204
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710411204,
					"content": "もちろん、事務所に座って図を描く製図士のことじゃありませんよ…へへっ、私はまだひよっこでしたから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411234
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710411234,
					"content": "以前、彼らの依頼を受けたことがあります。翹英荘を行ったり来たりして地形を描いたあげく、その建築の計画が取り消しされてしまったという…これもすべて、彼らの一言のせいです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411205
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710411205,
					"content": "彼らは現場の観測を助手に任せ、集められてきた地図の情報を手に入れて初めて、仕事を始めます…でも、私たちのような製図員はそういうわけにはいきません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411206
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710411206,
					"content": "それに…私も半分は鉱夫ですから、昔から危険な地下通路を行ったり来たりしてきましたし、もう慣れちゃったんです。仕事ですから、仕方ありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411207
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710411207,
					"content": "それに…異変が起こってからは、層岩巨淵の地下は…とても不安定で。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411208
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710411208,
					"content": "えっ…不安定？危ないってことなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710411209,
					"content": "はい、地質構造が少しずつ変わってきていて、今日は通路だったところも、来月には石壁になってしまうかもしれません…まるで…そうですね、どう言ったらいいでしょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411210
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710411210,
					"content": "まるで層岩巨淵自身の心に呼応して変化していくかのようにです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411211
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710411211,
					"content": "うぇっ…なんか不気味だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710411212,
					"content": "冒険者としてのキャリアについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710411213
					]
				},
				{
					"id": 710411213,
					"content": "ははっ、「キャリア」だなんて滅相もない！そうかしこまらないでください。私はただの新米冒険者ですから…先輩と比べればまだまだですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411214
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710411214,
					"content": "前に冒険者協会からの依頼をいくつかこなしたことはありますが、まだ経験が浅くて、一人でどこかを探索したこともないですし、ましてや自分の物語をどこかに残したこともありません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411215
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710411215,
					"content": "ですから、この層岩巨淵という場所は、私という人間がここにいたことを後世に覚えていてもらうために、足跡を残せる場所なのかもしれないって、考えていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411216
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710411216,
					"content": "大冒険者のアリスさんが言ったように、層岩巨淵は「私の『ルビコン川』」かもしれません！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411217,
						710411220
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710411217,
					"content": "「ルビコネガワ」…ヒルチャール語？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710411218
					]
				},
				{
					"id": 710411218,
					"content": "聞いたことないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411219
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710411219,
					"content": "うっ…私もよく分かりませんが…アリスさんは世界を行ったり来たりする大冒険者ですので、もしかすると彼女が行った場所の一つかもしれないですね…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志璇"
				},
				{
					"id": 710411220,
					"content": "お～「ルビコネガワ」ね！すごい！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710411221
					]
				},
				{
					"id": 710411221,
					"content": "おい！それがなんなのか、おまえも分かってないんだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411222
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710411222,
					"content": "ははっ、とにかく、励ましてくれてありがとうございます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志璇"
				},
				{
					"id": 710411223,
					"content": "クレイトポンについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710411224
					]
				},
				{
					"id": 710411224,
					"content": "彼は…ふん、信用できませんね。鉱区で宝盗団と長く関わってきましたから、彼らの下心はよく知っています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411225
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710411225,
					"content": "こういう人たちの「やり直す」とか、「足を洗う」とか…信じないほうがいいと思いますよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411226
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710411226,
					"content": "もしあの話を真面目に聞いていたのなら、すでにポケットに汚れた手を入れられているに違いありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411227
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710411227,
					"content": "彼らのでたらめを信じれば、岩王帝君だってあなたの財布を守れなくなるでしょうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411228
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710411228,
					"content": "ふん、別に彼らに偏見を持っているわけではありませんよ…ただ、宝盗団は信用できないということをあなたに注意しておきたいだけです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411229
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710411229,
					"content": "偏見のように聞こえるけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710411230
					]
				},
				{
					"id": 710411230,
					"content": "たぶん…先輩は私よりも知識が豊富だから、宝盗団のやつらにも寛容でいられるんです。でも、私は気を緩めずに彼らを警戒し続けていかないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411231
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710411231,
					"content": "あいつが例の密売人と無関係だって証明できるなら、話は別ですが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志璇"
				},
				{
					"id": 710411232,
					"content": "また後で。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710411233
					]
				},
				{
					"id": 710411233,
					"content": "先輩、いってらっしゃい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志璇"
				}
			]
		}
