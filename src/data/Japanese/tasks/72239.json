			},
			"dialogs": [
				{
					"id": 722390301,
					"content": "お前たちは…誰だ？聞いたことあるような声だが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390302
					],
					"speakerTitle": "須婆達の彦"
				},
				{
					"id": 722390302,
					"content": "えっ？もうオイラたちを忘れたのかよ…そんなにやばい状況なのか？心配だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722390303,
					"content": "すまない、私たちは知り合いなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390304,
						722390305
					],
					"speakerTitle": "須婆達の彦"
				},
				{
					"id": 722390304,
					"content": "さっき会ったばかり。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390306
					]
				},
				{
					"id": 722390306,
					"content": "ああ、思い出したよ…ここにいると魂が摩耗し、記憶が薄れてしまうんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390307
					],
					"speakerTitle": "須婆達の彦"
				},
				{
					"id": 722390307,
					"content": "すまない、私は…はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390308
					],
					"speakerTitle": "須婆達の彦"
				},
				{
					"id": 722390308,
					"content": "何か役に立つ情報は手に入ったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390309,
						722390310
					],
					"speakerTitle": "須婆達の彦"
				},
				{
					"id": 722390309,
					"content": "あなたの名前は須婆達の彦？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390312
					]
				},
				{
					"id": 722390312,
					"content": "須婆達の彦…須婆達の彦！そうだ！私は抵抗軍の大将、スパルタクスだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390313
					],
					"speakerTitle": "須婆達の彦"
				},
				{
					"id": 722390313,
					"content": "つまり須婆達の彦とスパルタクスが、おっさんの名前なのか？さすが大将だな、名前が二つもあるなんて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390314
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722390314,
					"content": "名前を取り戻してくれて感謝する。それと、他のことも思い出した…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390315
					],
					"speakerTitle": "須婆達の彦"
				},
				{
					"id": 722390315,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390316
					],
					"speakerTitle": "須婆達の彦"
				},
				{
					"id": 722390316,
					"content": "「暗黒は太陽の後に訪れ、光は我らの中に。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390317
					],
					"speakerTitle": "須婆達の彦"
				},
				{
					"id": 722390317,
					"content": "それって？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390318
					]
				},
				{
					"id": 722390318,
					"content": "我ら抵抗軍の合言葉だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390319
					],
					"speakerTitle": "須婆達の彦"
				},
				{
					"id": 722390319,
					"content": "名前を取り戻し、記憶も戻った。これこそ、我々の合言葉で間違いない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390320
					],
					"speakerTitle": "須婆達の彦"
				},
				{
					"id": 722390320,
					"content": "今、子供たちが身を隠している場所を教えよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390321,
						722390324,
						722390329
					],
					"speakerTitle": "須婆達の彦"
				},
				{
					"id": 722390321,
					"content": "何か伝えてほしい言葉はある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390322
					]
				},
				{
					"id": 722390322,
					"content": "そうだな…ふむ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390323
					],
					"speakerTitle": "須婆達の彦"
				},
				{
					"id": 722390323,
					"content": "永遠に諦めるなと…希望は心の中にあると…彼らに伝えてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390320
					],
					"speakerTitle": "須婆達の彦"
				},
				{
					"id": 722390324,
					"content": "彼らをここに連れて来る？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390325
					]
				},
				{
					"id": 722390325,
					"content": "いや、それには及ばない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390326
					],
					"speakerTitle": "須婆達の彦"
				},
				{
					"id": 722390326,
					"content": "我々の唯一の利点は、敵が光にあり、我々が影にあること。それに、すべての白夜の民の心は我々と共にある。自らを安易に明かしてはならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390327
					],
					"speakerTitle": "須婆達の彦"
				},
				{
					"id": 722390327,
					"content": "何より今の私は、自分の名前も…彼らの名前も忘れるような状態なのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390328
					],
					"speakerTitle": "須婆達の彦"
				},
				{
					"id": 722390328,
					"content": "永遠に諦めるなと…希望は心の中にあると…彼らに伝えてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "須婆達の彦"
				},
				{
					"id": 722390329,
					"content": "もし彼らがいなかったら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390330
					]
				},
				{
					"id": 722390330,
					"content": "それはない。太陽の子を操る穢れた大人たちが存在する限り、彼らも存在し続ける。もちろん、抵抗も続いていくだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390331
					],
					"speakerTitle": "須婆達の彦"
				},
				{
					"id": 722390331,
					"content": "永遠に諦めるなと…希望は心の中にあると…彼らに伝えてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390332
					],
					"speakerTitle": "須婆達の彦"
				},
				{
					"id": 722390332,
					"content": "それで十分だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "須婆達の彦"
				},
				{
					"id": 722390310,
					"content": "あなたの名前は賊人須？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390311
					]
				},
				{
					"id": 722390311,
					"content": "いや、賊人須じゃなくて、須婆達の彦だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722390305,
					"content": "あなたの身分について調べてた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390306
					]
				}
