			"trigger": {
				"objectNames": [
					"須婆達の彦",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722390101,
					"content": "子供たちよ、決して諦めるな。希望はお前たちの中にある…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390102
					],
					"speakerTitle": "須婆達の彦"
				},
				{
					"id": 722390102,
					"content": "子供たちか？まさか成功したのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390103
					],
					"speakerTitle": "須婆達の彦"
				},
				{
					"id": 722390103,
					"content": "いや…そうか、違うようだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390104
					],
					"speakerTitle": "須婆達の彦"
				},
				{
					"id": 722390104,
					"content": "#{NICKNAME}、この残影…目が見えないみたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722390105,
					"content": "ただ誰であろうと構わない、助けてくれないか。どうか子供たちを見つけてほしい…伝えたいことがあるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390106
					],
					"speakerTitle": "須婆達の彦"
				},
				{
					"id": 722390106,
					"content": "あなたは誰？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390107
					]
				},
				{
					"id": 722390107,
					"content": "私は…私の名前は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390108
					],
					"speakerTitle": "須婆達の彦"
				},
				{
					"id": 722390108,
					"content": "もう…名前は忘れてしまった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390109
					],
					"speakerTitle": "須婆達の彦"
				},
				{
					"id": 722390109,
					"content": "ただ覚えているのは…かつて白夜国のために、希望のために戦ったことのみ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390110
					],
					"speakerTitle": "須婆達の彦"
				},
				{
					"id": 722390110,
					"content": "私は、今でも抵抗軍の人間だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390111
					],
					"speakerTitle": "須婆達の彦"
				},
				{
					"id": 722390111,
					"content": "でも白夜国みたいな地底にある国が、なにに抵抗してるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722390112,
					"content": "それはもちろん、穢れた貴族たちに決まっている！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390113
					],
					"speakerTitle": "須婆達の彦"
				},
				{
					"id": 722390113,
					"content": "やつらは何かと神のお告げを受けたと言うが、ただ自らの欲求を満たすことしか考えていない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390114
					],
					"speakerTitle": "須婆達の彦"
				},
				{
					"id": 722390114,
					"content": "表向きは太陽の子たちの守護者だが、実際は国家の統治者。その本質的は民の血肉を吸う虫だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390115
					],
					"speakerTitle": "須婆達の彦"
				},
				{
					"id": 722390115,
					"content": "必ず、やつらを破滅へと導いてやらねばならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390116
					],
					"speakerTitle": "須婆達の彦"
				},
				{
					"id": 722390116,
					"content": "そういったことははっきり覚えてるのに…自分の名前は忘れてるんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722390117,
					"content": "それは、やつらの手段があまりにも残忍だからだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390118
					],
					"speakerTitle": "須婆達の彦"
				},
				{
					"id": 722390118,
					"content": "先般の失敗により、私はやつらに捕まった。この祭壇で監禁され、拷問を受けた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390119
					],
					"speakerTitle": "須婆達の彦"
				},
				{
					"id": 722390119,
					"content": "ここは悪逆非道な牢獄だ。私の魂は潰れていき、大切なものを失っていくのを感じている…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390120
					],
					"speakerTitle": "須婆達の彦"
				},
				{
					"id": 722390120,
					"content": "優しきお方よ、お願いだ。まだこれらを私が覚えているうちに、どうか子供たちを救ってやってくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390121
					],
					"speakerTitle": "須婆達の彦"
				},
				{
					"id": 722390121,
					"content": "彼らに、諦めるなと…希望は心の中にあると伝えてくれ…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390122
					],
					"speakerTitle": "須婆達の彦"
				},
				{
					"id": 722390122,
					"content": "子供たち？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390123
					]
				},
				{
					"id": 722390123,
					"content": "私について来てくれた若者たちだ。みな賢かった。彼らは私の教え子で、私の後詰めでもあった。私は彼らを自分の子供のように見ていたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390124
					],
					"speakerTitle": "須婆達の彦"
				},
				{
					"id": 722390124,
					"content": "だが邪悪な大人どもが、私から子供たちの情報を聞き出そうとした。もちろん、私は決して口を割らなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390125
					],
					"speakerTitle": "須婆達の彦"
				},
				{
					"id": 722390125,
					"content": "なぜなら私は知っているからだ…希望は彼らにあると…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390126
					],
					"speakerTitle": "須婆達の彦"
				},
				{
					"id": 722390126,
					"content": "でも今の時点ではもう、そいつらっていないんじゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722390127,
					"content": "いや、いる！彼らは皆いい子だ。皆が理想を抱いていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390128
					],
					"speakerTitle": "須婆達の彦"
				},
				{
					"id": 722390128,
					"content": "私でさえ諦めていないのだ…彼らもきっと諦めていない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390129
					],
					"speakerTitle": "須婆達の彦"
				},
				{
					"id": 722390129,
					"content": "どうやったら見つけられるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390130
					]
				},
				{
					"id": 722390130,
					"content": "ああ、覚えている。それなら覚えているぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390131
					],
					"speakerTitle": "須婆達の彦"
				},
				{
					"id": 722390131,
					"content": "彼らが身を隠している場所を教えよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390132
					],
					"speakerTitle": "須婆達の彦"
				},
				{
					"id": 722390132,
					"content": "でも仮に見つけたとして、なんて言ったらいいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390133
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722390133,
					"content": "「オイラたちは、自分の名前を忘れた抵抗軍のおっさんに言われて来たんだ」って言うのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390134
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722390134,
					"content": "いや、それだけでは足りない。私は彼らをしっかり教育してきた。己が何者かを証明できなければ、彼らもお前を信じることはないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390135
					],
					"speakerTitle": "須婆達の彦"
				},
				{
					"id": 722390135,
					"content": "だが今の私は、自分の名前すら思い出せない始末…なんたる屈辱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390136
					],
					"speakerTitle": "須婆達の彦"
				},
				{
					"id": 722390136,
					"content": "#{NICKNAME}、このおっさん、どうやら白夜国で重罪を犯した人みたいだな。たぶん、歴史に名が残ってるかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390137
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722390137,
					"content": "だったら、手がかりは簡単に見つかるはずだ。もしかしたら、この近くにあるかもしれない。探してみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390138
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722390138,
					"content": "もし歴史に名が残るのなら、その名は我々の後継者に書いてもらいたいものだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "須婆達の彦"
				}
			]
		},
		{
			"id": 7223902,
