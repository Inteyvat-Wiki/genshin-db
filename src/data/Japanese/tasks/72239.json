					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722391912,
					"content": "「子供たちよ、永遠に諦めるな、白夜国の希望は、お前たちの中にある」って言ってたな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391913
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722391913,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391914
					],
					"speakerTitle": "アドニス"
				},
				{
					"id": 722391914,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391915
					],
					"speakerTitle": "アドニス"
				},
				{
					"id": 722391915,
					"content": "ああ、なんてことだ…先生…申し訳ありません！これでは、あなたを失望させてしまう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391916
					],
					"speakerTitle": "アドニス"
				},
				{
					"id": 722391916,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391917
					]
				},
				{
					"id": 722391917,
					"content": "抵抗軍はもう存在しない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391918
					],
					"speakerTitle": "アドニス"
				},
				{
					"id": 722391918,
					"content": "えっ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391919
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722391919,
					"content": "先生が捕まった後、抵抗軍の主力はほぼ全滅した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391920
					],
					"speakerTitle": "アドニス"
				},
				{
					"id": 722391920,
					"content": "いつも先生のそばにいた俺たちだけが、動乱の中心から離れた場所にいて、生き残ったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391921
					],
					"speakerTitle": "アドニス"
				},
				{
					"id": 722391921,
					"content": "その後、俺たちは事前に準備しておいた隠れ家に逃げ込み、もう一度力を合わせようと画策した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391922
					],
					"speakerTitle": "アドニス"
				},
				{
					"id": 722391922,
					"content": "俺たちの中には、卓越した策士、専門的な知識を持つ学者、優秀な術師、頼りになる医者がいた…勝機はあるはずだと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391923
					],
					"speakerTitle": "アドニス"
				},
				{
					"id": 722391923,
					"content": "すごく希望がある感じに聞こえるけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391924
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722391924,
					"content": "俺たちもそう思っていた。時間さえあれば、俺たちは必ず再び立ち上がれると。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391925
					],
					"speakerTitle": "アドニス"
				},
				{
					"id": 722391925,
					"content": "だが、それには資金が必要だった。何をしようにも金が必要なのに…俺たちには何もなかったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391926
					],
					"speakerTitle": "アドニス"
				},
				{
					"id": 722391926,
					"content": "そして、誰かがこんなことを口にした——「龍骨花の露玉を売ろう」と。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391927
					],
					"speakerTitle": "アドニス"
				},
				{
					"id": 722391927,
					"content": "龍骨花の露玉って？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391928
					]
				},
				{
					"id": 722391928,
					"content": "龍骨花が特殊な状況下で実らせる、珍しい果実だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391929
					],
					"speakerTitle": "アドニス"
				},
				{
					"id": 722391929,
					"content": "その香りは、心を落ち着かせ、不安と悩みを一掃してくれる。そのため、市場ではかなりの高値で取引されていてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391930
					],
					"speakerTitle": "アドニス"
				},
				{
					"id": 722391930,
					"content": "そんなにすごいものなのか？ウソじゃないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391931
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722391931,
					"content": "すごいだけであればどんなに良かったか…愚かな俺は、その秘められた危険性を見抜けなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391932
					],
					"speakerTitle": "アドニス"
				},
				{
					"id": 722391932,
					"content": "その配合をどこから入手したのか、今となってはもう定かではない。ただ、あれのおかげで大量の資金を得られたのは覚えている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391933
					],
					"speakerTitle": "アドニス"
				},
				{
					"id": 722391933,
					"content": "順調に進んでいた…しかし仲間の中に、戦闘を忌避するものが徐々に現れ始めたんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391934
					],
					"speakerTitle": "アドニス"
				},
				{
					"id": 722391934,
					"content": "そして、そういった者が徐々に増えていき、最終的には退役を申し込む者が現れた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391935
					],
					"speakerTitle": "アドニス"
				},
				{
					"id": 722391935,
					"content": "どうしてそんなことになったんだ？露玉が売れすぎて、戦争をしたくなくなったのか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391948
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722391948,
					"content": "お金による腐食とでも言うのだろうか？いや…俺には知りようもないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391949
					],
					"speakerTitle": "アドニス"
				},
				{
					"id": 722391949,
					"content": "俺が知っているのは、弾圧された者が満足すれば、抵抗を続けられなくなるということ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391936
					],
					"speakerTitle": "アドニス"
				},
				{
					"id": 722391936,
					"content": "崩落はその時から始まり、取り返しがつかなくなっていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391947
					],
					"speakerTitle": "アドニス"
				},
				{
					"id": 722391947,
					"content": "時折、ふと思うんだ。この配合はもしかして…あの卑劣な大人たちがわざと俺たちに流したんじゃないかと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391950
					],
					"speakerTitle": "アドニス"
				},
				{
					"id": 722391950,
					"content": "この売り上げも、卑劣な大人たちが意図して操作したものだと勘繰ってしまう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391937
					],
					"speakerTitle": "アドニス"
				},
				{
					"id": 722391937,
					"content": "はぁ…先生であれば、どう対処したのだろう。始めから芽を摘んでいたのだろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391938
					],
					"speakerTitle": "アドニス"
				},
				{
					"id": 722391938,
					"content": "すみません、先生…俺たちは希望になれなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391939,
						722391940
					],
					"speakerTitle": "アドニス"
				},
				{
					"id": 722391939,
					"content": "それは気の毒だ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391941
					]
				},
				{
					"id": 722391941,
					"content": "先生に会わせる顔などない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391942
					],
					"speakerTitle": "アドニス"
				},
				{
					"id": 722391942,
					"content": "だが何はともあれ、先生のことを教えてくれてありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391943
					],
					"speakerTitle": "アドニス"
				},
				{
					"id": 722391943,
					"content": "俺にあげられるものはないが…もしよかったら、龍骨花の露玉の秘密をお前たちに教えよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391944
					],
					"speakerTitle": "アドニス"
				},
				{
					"id": 722391944,
					"content": "あれを実らせるための特殊な条件とは、常夜霊川——つまり忘川の水で、龍骨花に水やりをすることだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391945
					],
					"speakerTitle": "アドニス"
				},
				{
					"id": 722391945,
					"content": "金に変えるのもいいし、自分用に持っておくのもいいだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391946
					],
					"speakerTitle": "アドニス"
				},
				{
					"id": 722391946,
					"content": "いずれにせよ、前へと進もうとする心だけは忘れないで欲しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アドニス"
				},
				{
					"id": 722391940,
					"content": "先生に会ってみる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391950
					]
				}
			]
		},
		{
			"id": 7223924,
			"completionStepIds": [
