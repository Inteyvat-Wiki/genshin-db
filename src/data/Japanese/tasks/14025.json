			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ヌヴィレット"
				],
				"points": [
					{
						"sceneId": 1083,
						"position": [
							-51.907,
							0.352,
							-15.817
						],
						"pointId": 83
					},
					{
						"sceneId": 1083,
						"position": [
							-38.566,
							0.351,
							-16.329
						],
						"pointId": 84
					},
					{
						"sceneId": 1083,
						"position": [
							-35.909,
							0.334,
							-18.022
						],
						"pointId": 85
					},
					{
						"sceneId": 1083,
						"position": [
							-35.757,
							0.351,
							-14.567
						],
						"pointId": 86
					}
				]
			},
			"dialogs": [
				{
					"id": 140250401,
					"content": "久しぶりにお目にかかる、ヌヴィレット殿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250402
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140250402,
					"content": "面会の申請がこんなにも早く承諾されるとは、パレ·メルモニアの事務の効率には頭が下がるばかりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250403
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140250403,
					"content": "名高い外交官に対し、尊重をもって接するのは当然のことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250404
					],
					"speakerTitle": "ヌヴィレット"
				},
				{
					"id": 140250404,
					"content": "客観的要素からすれば、「神の心を贈与」したときが最後の面会になると思っていたのだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250405
					],
					"speakerTitle": "ヌヴィレット"
				},
				{
					"id": 140250405,
					"content": "それに旅人とパイモンも同行しているとは、どういった用件だろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250406
					],
					"speakerTitle": "ヌヴィレット"
				},
				{
					"id": 140250406,
					"content": "私はまもなくフォンテーヌを離れる予定なのだが、その前に少し気掛かりなことがあってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250407
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140250407,
					"content": "一言二言では説明が難しいゆえ、提案書を用意してきた。お目通しいただけたら幸甚だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250408
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140250408,
					"content": "「召使」は書類を渡すと、優雅な所作でカップを持ち上げ、水の味を吟味した。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						140250409
					]
				},
				{
					"id": 140250409,
					"content": "ご要望の詳細は理解した。ただ、無礼を承知で言わせてもらうが、「召使」殿がそうする理由が分からない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250410
					],
					"speakerTitle": "ヌヴィレット"
				},
				{
					"id": 140250410,
					"content": "ヌヴィレット殿は水を味わう趣味があると聞いた。では、水を例にして説明しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250411
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140250411,
					"content": "家は巨大な湖にも似た場所だ。無数の川が流れ込み、また無数の川がそこから流れ出ていく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250412
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140250412,
					"content": "毎日その湖を眺めていると、流れ出ていくすべての川が海へたどり着くことを願わずにはいられない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250413
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140250413,
					"content": "だが、それは不可能であると現実に知らしめられてきた。ほとんどの川は途中で乾き、もしくは土に染み込んで跡形もなく消えてしまうのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250414
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140250414,
					"content": "そういう「海にたどり着けない水」たちに、存在の意味を与えたいと私は考えている。例えば、両岸の田畑を潤す、もしくは誰かのカップに注がれる甘い泉になる、という存在意味をね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250415
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140250415,
					"content": "なぁ、なに言ってるかわかるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250416,
						140250417
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140250416,
					"content": "さあ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250418
					]
				},
				{
					"id": 140250418,
					"content": "はっきりさせておかなければならないことがある——たとえどんな美辞麗句で誤魔化そうと、「濁った水」を飲みたいと思う者はいない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250419
					],
					"speakerTitle": "ヌヴィレット"
				},
				{
					"id": 140250419,
					"content": "「かつて濁っていた水」と言うべきだろう。水に混じった泥をろ過し、本来の綺麗な状態に戻しておく。だから、その点はご安心いただきたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250420
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140250420,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250421
					],
					"speakerTitle": "ヌヴィレット"
				},
				{
					"id": 140250421,
					"content": "「取引」ということだが、詳細についてお聞かせいただけるかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250422
					],
					"speakerTitle": "ヌヴィレット"
				},
				{
					"id": 140250422,
					"content": "もしヌヴィレット殿が提案を受け入れてくださるのであれば、徐々にフォンテーヌから勢力を撤退させる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250423
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140250423,
					"content": "今後、不可避な場合を除き、フォンテーヌで「特殊任務」を遂行することはないと約束しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250424
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140250424,
					"content": "「ダルドゥフ暗殺事件」のようなことは、今後起こらないということでいいのだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250425
					],
					"speakerTitle": "ヌヴィレット"
				},
				{
					"id": 140250425,
					"content": "寄付金を横領したあの偽善者のことか？彼の死には心から追悼の意を表す。だが、現時点で壁炉の家が関わっていたという証拠はないはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250426
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140250426,
					"content": "無論、もしヌヴィレット殿が提案を受け入れてくだされば、今後そういった厄介事が減るよう力を貸すことはできる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250427
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140250427,
					"content": "一切隙のない物言いだな。いいだろう、その提案を受け入れよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250428
					],
					"speakerTitle": "ヌヴィレット"
				},
				{
					"id": 140250428,
					"content": "ご承諾に感謝する、ヌヴィレット殿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250429
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140250429,
					"content": "では取引成立だ。私たちはそろそろ失礼する。スネージナヤの湧水を二瓶ここに運ばせた。今度お会いしたとき、ぜひ感想を聞かせてもらいたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250430
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140250430,
					"content": "ああ、また。くれぐれも約束を忘れぬよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250431
					],
					"speakerTitle": "ヌヴィレット"
				},
				{
					"id": 140250431,
					"content": "さあ、旅人、パイモン、行くとしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140250417,
					"content": "分かるような、分からないような…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250418
					]
				}
			]
		},
