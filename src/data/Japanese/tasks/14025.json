			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ヌヴィレット"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 140251001,
					"content": "前にも言ったように、私は容易く他人の感情に共鳴ができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140251002
					],
					"speakerTitle": "ヌヴィレット"
				},
				{
					"id": 140251002,
					"content": "しかし、あの執行官とは何度か会ってきたが、何も感じ取ることはできなかった。あの者の心はまるで薄暗く底知れぬ湖面のように、波一つ起きていないのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140251003
					],
					"speakerTitle": "ヌヴィレット"
				},
				{
					"id": 140251003,
					"content": "生まれつきそうなのか、それとも自らの意志で感情をコントロールしているのか…どちらにせよ、危険な人物であることに変わりはないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140251004
					],
					"speakerTitle": "ヌヴィレット"
				},
				{
					"id": 140251004,
					"content": "君たちが同行している理由は聞かないが、くれぐれも身の安全には気をつけてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヌヴィレット"
				}
			]
		}
	]
}