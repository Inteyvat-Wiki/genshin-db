				]
			},
			"dialogs": [
				{
					"id": 140250501,
					"content": "「召使」、さっきのヌヴィレットとの会話、いったいなんの話をしてたんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140250502,
					"content": "湖とか川とか言ってたけど…もしかして、水に関連した工事の話か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140250503,
					"content": "好奇心を搔き立てられたのかな？だが、それよりも大事なことがあるのでは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250504
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140250504,
					"content": "そ、そうだった…リネのほうはどうなったんだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140250505,
					"content": "なにかいい方法を考え中なんだよな？頼んだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250506
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140250506,
					"content": "#（「召使」は気軽そうに振る舞ってるけど、身体から伝わってくる殺意は偽物じゃない。「裏切り」に関わった子供たちを本当に殺すつもり{M#みたいだ}{F#みたい}。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250507
					]
				},
				{
					"id": 140250507,
					"content": "（彼女を止めるにはどうすれば？いや待った、その前に一つ引っ掛かる。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250508
					]
				},
				{
					"id": 140250508,
					"content": "（パレ·メルモニアの入り口で、クリーヴの名前を口にしていたけど、もしかしてクリーヴの居場所をすでに知ってるってこと？「召使」はリネたちの行動を予測してた？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250509
					]
				},
				{
					"id": 140250509,
					"content": "うぉっ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250510
					],
					"speakerTitle": "オレール"
				},
				{
					"id": 140250510,
					"content": "いたたた…あっ、大丈夫か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250511
					],
					"speakerTitle": "オレール"
				},
				{
					"id": 140250511,
					"content": "すまない。新聞を売ることで頭がいっぱいで、前を見てなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250512,
						140250513
					],
					"speakerTitle": "オレール"
				},
				{
					"id": 140250512,
					"content": "こちらこそ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250514
					]
				},
				{
					"id": 140250514,
					"content": "そうだ、お詫びとして、よかったらこの新聞を受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250515
					],
					"speakerTitle": "オレール"
				},
				{
					"id": 140250515,
					"content": "（この人…なんだか見覚えがある気が…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250516
					]
				},
				{
					"id": 140250516,
					"content": "いやいや、それは悪いぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250517
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140250517,
					"content": "気にしないでくれ。まだたくさんあるし、日にちが変わったら、タダであげても誰も欲しがらないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250518
					],
					"speakerTitle": "オレール"
				},
				{
					"id": 140250518,
					"content": "まぁ少しでも多く稼ごうと、多めに仕入れた自分が悪い。今日に限って新聞を買う人が少なくて、まだ売れ残ってるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250519
					],
					"speakerTitle": "オレール"
				},
				{
					"id": 140250519,
					"content": "どうかしたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250520
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140250520,
					"content": "あ、いや、こちらの方にぶつかってしまって…じゃ、俺はこれで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250521
					],
					"speakerTitle": "オレール"
				},
				{
					"id": 140250521,
					"content": "待て。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250522
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140250522,
					"content": "あの…賠償が必要なら、ちょっと今は手持ちがなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250523
					],
					"speakerTitle": "オレール"
				},
				{
					"id": 140250523,
					"content": "新聞を三部いただこう。代金だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250524
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140250524,
					"content": "えっ？あ、ありがとうございます！神のご加護があらんことを！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250525
					],
					"speakerTitle": "オレール"
				},
				{
					"id": 140250525,
					"content": "あなたのような気前のいい人に毎日出会えたらいいのに…ああ、いや、冗談さ。明日は仕入れをほどほどにするよ。もうすぐ結婚するからって焦っちゃいけないな。じゃ、失礼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250526
					],
					"speakerTitle": "オレール"
				},
				{
					"id": 140250526,
					"content": "用事は済んだ。船でポワソン町に戻るとしよう。これで道中、新聞を読んで暇をつぶせる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250527
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140250527,
					"content": "ま、待った…もう少しぶらぶらしてもいいか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250528
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140250528,
					"content": "そうだ、オイラお腹が空いてきた——お腹いっぱいにならないと帰れないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250529
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140250529,
					"content": "（パイモンが戻らせまいと理由を頑張って考えてる。あまり時間は経ってないし、リネたちも大きな進展はないはず。どうすれば…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250530
					]
				},
				{
					"id": 140250530,
					"content": "まだ淡い幻想を抱いているようだな——もう少し時間を稼げれば状況が好転するのではないか、と。私には意味のない悪あがきのようにしか思えないが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250531
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140250531,
					"content": "だが、もし私の言う条件に応じてくれれば、リネたちにもう少し猶予をあげてもいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250532
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140250532,
					"content": "それから、君たちの疑問にも答えよう。例えば、「クリーヴ」の正体について、そして私とはどんな関係だったのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250533
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140250533,
					"content": "きゅ、急に気前よく振る舞うなんて、まさかオイラたちに悪いことをさせようって魂胆じゃないだろうな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250534
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140250534,
					"content": "自身の力を過大評価しているようだな。君たちに悪事を成せるほどの天稟は見受けられなかったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250535
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140250535,
					"content": "うぅ…じゃあ、なにが目的だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250536
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140250536,
					"content": "交渉で最も重要なのは利益の交換だ。一方的な要求や脅迫では、望む結果をもたらすことなどできない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250537
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140250537,
					"content": "そっちの条件を聞かせて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250538
					]
				},
				{
					"id": 140250538,
					"content": "ああ。その条件というのは——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250539
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140250539,
					"content": "「必要なとき、君たちが最も適切だと思う選択をもって、壁炉の家を一度だけ助ける」というものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250540
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140250540,
					"content": "あれ、別に変な条件じゃないな…でも「必要なとき」って、どんなときだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250541
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140250541,
					"content": "そこは君たちの判断に任せよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250542
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140250542,
					"content": "条件を受け入れるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250543
					]
				},
				{
					"id": 140250543,
					"content": "交渉成立だ。ついて来たまえ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140250513,
					"content": "不注意だった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250514
					]
				}
			]
		},
		{
