				]
			},
			"dialogs": [
				{
					"id": 140250201,
					"content": "また会ったな。疲れているように見えるが、昨晩はよく眠れなかったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250202
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140250202,
					"content": "ま、ちょっとな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140250203,
					"content": "悩み事が減れば、ぐっすり眠れるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250204
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140250204,
					"content": "この後の予定は？戻って二度寝をするのか、それとも新しい話題を探すために頭を搾るのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250205
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140250205,
					"content": "些か興味があってね。今日は「公子」もいない。代わりにどんな理由で私をここに引き留めるつもりなのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250206
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140250206,
					"content": "（！！！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250207
					]
				},
				{
					"id": 140250207,
					"content": "な、なんの話だ？オイラたちはただおしゃべりに来ただけだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140250208,
					"content": "ふむ、まだこれといった案が浮かばないのなら、少し付き合ってくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250209
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140250209,
					"content": "そう焦る必要はない。裏で動いている者たちとは出くわさない道で行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250210
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140250210,
					"content": "ああ…今日の海風は本当に気持ちいいなぁ～…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140250211,
					"content": "全部知ってたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250212
					]
				},
				{
					"id": 140250212,
					"content": "子供たちは、大人の目を欺けると思い込みがちだが、小手先の企みなんかは私からすると一目瞭然だ。まぁ、もう少し時間をくれてやろう——何分、私は忍耐強いからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250213
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140250213,
					"content": "私は先に行く。もし付き合ってくれるのなら、パレ·メルモニアの入り口まで来てくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250214
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140250214,
					"content": "君たちがお利口でいてくれたら、あの子たちはまだ生き延びられる望みがあるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250215
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140250215,
					"content": "ど、ど、どうしたらいいんだ！！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140250216,
					"content": "さっきのあいつの口ぶりからして、きっとオイラたちのやってることを見透かしてるよな？しかも、明らかに脅しをかけてきたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250217
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140250217,
					"content": "とりあえず、マジックバードを飛ばそう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250218
					]
				},
				{
					"id": 140250218,
					"content": "おう、リネが早くサインに気付いてくれるといいけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250219
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140250219,
					"content": "やっぱり、パレ·メルモニアには行ったほうがいいよな？あいつにあそこまで言われて行かなかったら、なんかまずい気がするぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250220,
						140250221
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140250220,
					"content": "他に手はなさそう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250222
					]
				},
				{
					"id": 140250222,
					"content": "じゃ急ごうぜ。あいつがしびれを切らして、リネんとこに行っちゃったら、それこそまずいからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140250221,
					"content": "一旦行ってみるしかない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250222
					]
				}
			]
		},
