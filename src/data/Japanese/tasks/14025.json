			"dialogs": [
				{
					"id": 140250801,
					"content": "今日はどこへ行くの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250802
					],
					"speakerTitle": "リネット"
				},
				{
					"id": 140250802,
					"content": "もうちょっと遠くまで行ってみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リネ"
				}
			]
		},
		{
			"id": 1402510,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1402505",
							"2"
						],
						"stepId": 1402505,
						"stateName": "QUEST_STATE_UNFINISHED"
