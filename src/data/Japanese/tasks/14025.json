						],
						"pointId": 340100601
					}
				]
			},
			"dialogs": [
				{
					"id": 140250301,
					"content": "約束の会談まで少し時間がある。ここで話すとしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250302
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140250302,
					"content": "子供たちと仲良くしてくれて私も嬉しく思うよ。子供の成長には、良好な人間関係が必要不可欠だからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250303
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140250303,
					"content": "「召使」…おまえ、あいつらをどうするつもりだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140250304,
					"content": "リネ、リネット、フレミネ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250305
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140250305,
					"content": "それに、フィリオール、ナントゥイユ…かなりの人数だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250306
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140250306,
					"content": "裏切り者に対し、私は常に平等な処置を下す。例外は一切ない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250307
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140250307,
					"content": "も…もしかしてあいつらを「殺す」つもりじゃないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140250308,
					"content": "陳情でもするつもりか？残念ながら、家のルールは誰にも変えることはできない。家では皆自分の言動に責任を負わねばならないのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250309
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140250309,
					"content": "お、おまえはあいつらになんの感情もないのかよ？おまえのことをずっと「お父様」って呼んでて、心から尊敬してるのに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140250310,
					"content": "如何なる組織であっても、感情でルールを変えてしまえば急速に瓦解してしまう。ましてや、ルールに厳しいことで知られる壁炉の家だ。言うまでもないだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250311
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140250311,
					"content": "だが、客人である君たちは処分対象ではない——これが君たちに掛けられる唯一の慰めの言葉だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250312
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140250312,
					"content": "他に方法はないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250313
					]
				},
				{
					"id": 140250313,
					"content": "リネたちは命拾いぐらいできるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250314
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140250314,
					"content": "しかし、フィリオールとナントゥイユを筆頭とする者たち、それにクリーヴも…反逆を企てる者に対しては検討の余地などない。秘密を抱えたまま、生きて家から離れることは許されないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250315
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140250315,
					"content": "そ…そんなのあんまりじゃないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250316
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140250316,
					"content": "では、こうするのはどうだ？客人の顔に免じてもう少し時間をあげるとしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250317
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140250317,
					"content": "もし与えられた期限内にリネたちがクリーヴを消して、証拠を隠滅できたら、目をつぶってやる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250318
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140250318,
					"content": "さもなくば、悪事を企んだやつら全員に厳しい罰を与える。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250319,
						140250320
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140250319,
					"content": "約束だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250321
					]
				},
				{
					"id": 140250321,
					"content": "ああ、約束しよう。それから、これは君たちに返そう。もうなくすなよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250322
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140250322,
					"content": "マジックバードの訓練にはかなりの時間を要する。息の根を止めるのは、少々忍びなくてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250323
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140250323,
					"content": "ど、どこで捕まえたんだ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250324
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140250324,
					"content": "さて、おしゃべりはここまでにして、本題に入ろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250325
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140250325,
					"content": "君たちをここに来させたのは、私にパレ·メルモニアで話し合わなければならない用件があるからだ。君たちとは関係のないことだが、付き合ってもらう。リネたちに状況を知らせようなどとは考えないほうがいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250326
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140250326,
					"content": "ちょうどいい時間だ。行くとしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140250320,
					"content": "必ず約束を守って。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250321
					]
				}
			]
		},
		{
			"id": 1402504,
			"completionStepIds": [
				1402504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
