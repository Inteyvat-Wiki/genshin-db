			"dialogs": [
				{
					"id": 140250102,
					"content": "全員揃ったね。今日も計画通りに動こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250103,
						140250104
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140250103,
					"content": "ちょっと待って。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250105
					]
				},
				{
					"id": 140250105,
					"content": "えっ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250106
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 140250106,
					"content": "「召使」が「博士」と手を組んだことはある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250107
					]
				},
				{
					"id": 140250107,
					"content": "どうしてそんなことを？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250108
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140250108,
					"content": "実は昨日の夜、クリーヴに会ってさ。あいつが教えてくれたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140250109,
					"content": "オイラたち、スメールで「博士」に会ったことがあるんだ。あいつはすごく危ないやつってだけじゃなくて、悪いこともめちゃくちゃやってたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140250110,
					"content": "…「お父様」と「博士」に付き合いがないとは保証できないけど、「お父様」が彼と協力するとは思えないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250111
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140250111,
					"content": "僕たちは同じ派閥じゃないし、互いを信用してない。協力するための基盤がないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250112
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140250112,
					"content": "でも、「お父様」が執行官になったばかりの頃、「博士」が壁炉の家と協力したいと言ってたのは確かだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250113
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140250113,
					"content": "「お父様」はほとんどの提案を断った——秘密の実験を除いて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250114
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140250114,
					"content": "秘密の実験？——もしかして、クリーヴが言ってたのってそれじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140250115,
					"content": "違うと思うよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250116
					],
					"speakerTitle": "リネット"
				},
				{
					"id": 140250116,
					"content": "秘密の実験がなんなのかは知らないけど…それは壁炉の家が単独で行っているものだ。「博士」は研究の方向性を提供しただけだから、協力とは言えない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250117
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140250117,
					"content": "それに機密とされているのは実験内容に関することだけで、実験に参加した人のことはすべて記録されてるから、クリーヴが言ってたのとは全然違う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250118
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140250118,
					"content": "僕たちを信じてくれ。壁炉の家はファデュイに属してるし、君たちが受け入れられないようなことをすることもある。でも僕たちにだって、それなりのルールやモラルはあるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250119
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140250119,
					"content": "ふぅ。それなら安心したぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140250120,
					"content": "正直、もし「召使」が本当に「博士」と手を組んでひどいことをしてたんなら、どう向き合えばいいかわからなかったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140250121,
					"content": "でもまさか、クリーヴは嘘をついたってことか？そんな風には見えなかったけどな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140250122,
					"content": "直接「召使」に聞けたらいいんだけど…きっと、そう簡単には教えてくれないよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140250123,
					"content": "まずは今日の計画を実行しよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250124
					]
				},
				{
					"id": 140250124,
					"content": "「お父様」は昨日帰ってこなかったから、まだ海岸の近くにいるはずだよ。よろしくね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250125
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140250125,
					"content": "リネット、ついてきて。フレミネも気を付けて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250126
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140250126,
					"content": "行動開始だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リネ"
				},
				{
					"id": 140250104,
					"content": "一つ聞きたいことがある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250105
					]
				}
			]
		},
		{
			"id": 1402502,
