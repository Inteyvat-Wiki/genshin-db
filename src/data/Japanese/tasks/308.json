			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"リサ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3081401,
					"content": "東風の龍·トワリン、南風の獅子·ダンディライオン、北風の狼·ボレアス、西風の鷹·セピュロス…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081402
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 3081402,
					"content": "それらはモンドの四方の風の守護者で、風神「バルバトス」の眷属でもあるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081403
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 3081403,
					"content": "トワリン——それが風魔龍の名前よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081404
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 3081404,
					"content": "人々に風魔龍と呼ばれる前、彼の者は「四風守護」の中の「東風の龍（トワリン）」だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081405
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 3081405,
					"content": "四方の風の力の中で、トワリンがそのうち三つの力しか使えない原因がこれよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081406
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 3081406,
					"content": "彼は、初めに「自身の力」を燃やし尽くしてしまったからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081407,
						3081408
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 3081407,
					"content": "どうして？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3081409
					]
				},
				{
					"id": 3081409,
					"content": "たぶん…「憎しみ」だと思うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081410
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 3081410,
					"content": "憎しみ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081411
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3081411,
					"content": "モンドに対する憎しみよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081412
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 3081412,
					"content": "その憎しみを風よりも強い力にし、そして彼は魔龍になった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081413
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 3081413,
					"content": "でも、「四風守護」だったのに、なんで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081414
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3081414,
					"content": "なんで守るべき都市を憎むようになったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081415
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3081415,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081416
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 3081416,
					"content": "モンドの人間としては、とても言いにくいわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081417
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 3081417,
					"content": "これを読むといいわ…百年以上も前の出来事よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リサ"
				},
				{
					"id": 3081408,
					"content": "彼はどうしてそこまで？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3081409
					]
				}
			]
		}
	]
