			},
			"dialogs": [
				{
					"id": 3081301,
					"content": "外でも元素の乱れによるザワめきを感じるわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081302
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 3081302,
					"content": "早くこの神殿を取り戻して、気分をスッキリさせないとね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リサ"
