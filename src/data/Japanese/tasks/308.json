			"dialogs": [
				{
					"id": 3081101,
					"content": "あら、可愛い子ちゃん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081102
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 3081102,
					"content": "危ないのに手伝ってくれるなんて、感激だわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081103
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 3081103,
					"content": "何か分からないことがあったら、お姉さんに聞いてちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081104,
						3081108
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 3081104,
					"content": "図書館司書の仕事は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3081105
					]
				},
				{
					"id": 3081105,
					"content": "あら、いい質問ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081106
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 3081106,
					"content": "基本的に、肉体労働と頭脳労働以外のことかしら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081107
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 3081107,
					"content": "それ以外になにがあるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3081111,
					"content": "だから、あなたたちもわたくしをもっと信じていいわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リサ"
				},
				{
					"id": 3081108,
					"content": "どうして図書館司書が遺跡に…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3081109
					]
				},
				{
					"id": 3081109,
					"content": "あら、いい質問ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081110
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 3081110,
					"content": "それはもちろん、ジンがわたくしを信頼してるからよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081111
					],
					"speakerTitle": "リサ"
				}
			]
		},
