			"dialogs": [
				{
					"id": 705580101,
					"content": "教官、この測量ルートの設計はどうでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580102
					],
					"speakerTitle": "トレス"
				},
				{
					"id": 705580102,
					"content": "この地点の高度…それに障害物…実際の状況とテストの難易度が両立できていて…さらに、ある程度の面白みも含まれていますね！よくできていると思います！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580103
					],
					"speakerTitle": "ミカ"
				},
				{
					"id": 705580103,
					"content": "トレスさんに僕が教えられる知識は、もうほとんどありません。これからは主に復習と応用になりますね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580104
					],
					"speakerTitle": "ミカ"
				},
				{
					"id": 705580104,
					"content": "ですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580105
					],
					"speakerTitle": "トレス"
				},
				{
					"id": 705580105,
					"content": "トレスは何を心配してるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580106
					],
					"speakerTitle": "エルウィン"
				},
				{
					"id": 705580106,
					"content": "もし私が君ほど要領よく学べたら、第8小隊の銃職人たち…特にコッホなんか、私を模範として崇めて、あのサボり魔たちを叱りつけるための比較対象に使おうとするでしょうね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580107
					],
					"speakerTitle": "エルウィン"
				},
				{
					"id": 705580107,
					"content": "エルウィンはもう十分よくやっていますよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580108
					],
					"speakerTitle": "トレス"
				},
				{
					"id": 705580108,
					"content": "今回使った標定物、全部エルウィンが作ったものでしょう？僕が作ったら、えっと…多分、ローエン副隊長に「ガラクタ展示棚」に並べられてしまいますよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580109,
						705580110
					],
					"speakerTitle": "トレス"
				},
				{
					"id": 705580109,
					"content": "何してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705580111
					]
				},
				{
					"id": 705580111,
					"content": "なんでこんなに人が集まってるんだ…騎士団のピクニックか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705580112,
					"content": "あっ、栄誉騎士先輩にパイモンさん、こんにちは！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580113
					],
					"speakerTitle": "ミカ"
				},
				{
					"id": 705580113,
					"content": "こちらはトレスさんです。先日、ローエン副隊長が測量技術の交流と勉強のために彼を呼んだんです。それで、僕たちは一緒に「測量と探し物」というチャレンジを考案しました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580114
					],
					"speakerTitle": "ミカ"
				},
				{
					"id": 705580114,
					"content": "そして、こちらはエルウィンさん。僕と同じ遊撃小隊の隊員で、彼女にはこの二日間で何度も助けてもらいました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580115
					],
					"speakerTitle": "ミカ"
				},
				{
					"id": 705580115,
					"content": "あの名高い栄誉騎士先輩と、お仲間のパイモンさんですね！百聞は一見に如かず、まさに風格を感じます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580116
					],
					"speakerTitle": "トレス"
				},
				{
					"id": 705580116,
					"content": "んー…えっ！？嘘でしょ、一番すごくて、一番有名な大物に会っちゃった…どうしよう、考えて、エルウィン…よく考えるのよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580117
					],
					"speakerTitle": "エルウィン"
				},
				{
					"id": 705580117,
					"content": "えっ？そ、そんなに緊張しなくてもいいんだぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705580118,
					"content": "ああ…ご心配なく。エルウィンは時々「モード」に入り込むだけですから——今は「超尊敬モード」…ですかね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580119
					],
					"speakerTitle": "トレス"
				},
				{
					"id": 705580119,
					"content": "多様な個性をさらけ出すことで、相手に本当の自分を掴ませないということですね…なるほど、また学びを得ました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580120
					],
					"speakerTitle": "トレス"
				},
				{
					"id": 705580120,
					"content": "…トレスは勉強熱心すぎるわ。まだ経験の浅い後輩として、素晴らしい騎士の前で緊張するのは当たり前じゃない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580121
					],
					"speakerTitle": "エルウィン"
				},
				{
					"id": 705580121,
					"content": "それに、サインをもらう絶好のチャンスなんだから…ま、待って、どうやってお願いすればいいのよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580122
					],
					"speakerTitle": "エルウィン"
				},
				{
					"id": 705580122,
					"content": "もう口に出てるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580123,
						705580124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705580123,
					"content": "サインくらい、お安い御用だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705580125
					]
				},
				{
					"id": 705580125,
					"content": "ホントですか！？絶対大切に…今日は本当にツイてるわね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580126
					],
					"speakerTitle": "エルウィン"
				},
				{
					"id": 705580126,
					"content": "あ、そうそう、ミカにも感謝しないと！君に手伝いを頼まれなければ、こんなチャンスに巡り会えなかったわ…次も何かあったら、また手伝いに来るから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580127
					],
					"speakerTitle": "エルウィン"
				},
				{
					"id": 705580127,
					"content": "え？それはありがたい申し出ですが…サインをいただけるのは、栄誉騎士先輩とパイモンさんが気さくで、誠実な方だからですよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580128
					],
					"speakerTitle": "ミカ"
				},
				{
					"id": 705580128,
					"content": "君の功績なんだから、謙遜しないでよ！そんなんじゃ、同僚も給料を受け取りづらくなっちゃうでしょ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580129
					],
					"speakerTitle": "エルウィン"
				},
				{
					"id": 705580129,
					"content": "その点でいえばトレスも同じよね。測量の技術は完璧なのに、いざ話し合いの場になると…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580130
					],
					"speakerTitle": "エルウィン"
				},
				{
					"id": 705580130,
					"content": "あっ、待って！もしここが戦場なら、私は敵として完全に騙されてたってこと！？ということは…これも君たちの策略のうちなの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580131
					],
					"speakerTitle": "エルウィン"
				},
				{
					"id": 705580131,
					"content": "えっ？そういう解釈もできるのか？オイラには思いつかなかったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580132,
						705580133
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705580132,
					"content": "測量に強いこだわりを持ってるんだろうね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705580134
					]
				},
				{
					"id": 705580134,
					"content": "それは過大評価ですよ…実は、測量という仕事をしていると、いつも何かが足りないんじゃないかと感じてしまうんです。その結果が影響するのは、自分だけではありませんから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580135
					],
					"speakerTitle": "ミカ"
				},
				{
					"id": 705580135,
					"content": "教官のおっしゃる通りです。だから僕は…いつも細部までしっかり気を配り、慎重に、慎重に、さらに慎重に…と心がけているんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580136
					],
					"speakerTitle": "トレス"
				},
				{
					"id": 705580136,
					"content": "それならいっそ、栄誉騎士先輩に「測量と探し物」チャレンジを試してもらいましょうよ！トレスの実力が分かるいい機会だし！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580137
					],
					"speakerTitle": "エルウィン"
				},
				{
					"id": 705580137,
					"content": "うーん、それはいい考えかもしれませんね…お二人にお時間があればですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580138
					],
					"speakerTitle": "ミカ"
				},
				{
					"id": 705580138,
					"content": "大丈夫なのか？測量って…なんだか難しそうだけど、専門的な勉強をしたことがなくても参加していいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580139,
						705580140
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705580139,
					"content": "初心者だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705580141
					]
				},
				{
					"id": 705580141,
					"content": "あ、初心者でも大丈夫です…僕たちの目的は「素人でも一度で覚えられる測量ルート」を設計することですから。そうすれば、新兵たちにも分かりやすく指導できるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580145
					],
					"speakerTitle": "ミカ"
				},
				{
					"id": 705580145,
					"content": "前回の合同演習で縁ができたおかげで…各国の友軍にご協力いただき、さまざまな地形や条件下での測量と探索ができるようになりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580146
					],
					"speakerTitle": "ミカ"
				},
				{
					"id": 705580146,
					"content": "もちろん、そのお返しとして、後で僕たちが得た経験や教訓も彼らに共有します。まさに、共に成長するということです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580142
					],
					"speakerTitle": "ミカ"
				},
				{
					"id": 705580142,
					"content": "多様な地形で、測量の複雑度が高くても…誰よりも冒険の経験が豊富な栄誉騎士先輩にとっては、お遊びに過ぎないはずです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580143
					],
					"speakerTitle": "ミカ"
				},
				{
					"id": 705580143,
					"content": "そう言われると、挑戦してみたくなってきたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580144
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705580144,
					"content": "#ま、{NICKNAME}は実践から学ぶのも得意だしな！どんな分野でも、その場でプロになれるぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705580140,
					"content": "パイモンも素人だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705580141
					]
				},
				{
					"id": 705580133,
					"content": "ミカはいつも自分に厳しいんだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705580134
					]
				},
				{
					"id": 705580124,
					"content": "聞こえたよ、受け取り拒否はなしだからね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705580125
					]
				},
				{
					"id": 705580110,
					"content": "賑やかだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705580111
					]
				}
			]
		}
	]
}