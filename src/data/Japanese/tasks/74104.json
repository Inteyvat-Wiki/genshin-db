					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040808,
						741040810
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741040808,
					"content": "檻の傍のエネルギー蓄積装置を起動させて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741040809
					]
				},
				{
					"id": 741040809,
					"content": "う～ん、こっからだとよく見えないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040807
					],
					"speakerTitle": "パイモン"
