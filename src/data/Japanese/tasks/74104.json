					"nextDialogs": [
						741040822
					]
				},
				{
					"id": 741040822,
					"content": "え？わかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040813
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741040816,
					"content": "檻の傍のエネルギー蓄積装置を起動させて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741040817
					]
				},
				{
					"id": 741040817,
					"content": "任せとけ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040823
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741040823,
					"content": "成功だ！見たか？オイラだって力になれるんだぞ、なっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040824
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741040824,
					"content": "それにしても、クイセルのやつ一体どうしたんだ？よくわからないよな…あいつが行ったほうを探してみようぜ。なんかあるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
