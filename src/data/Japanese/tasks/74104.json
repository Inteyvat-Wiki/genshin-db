			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ブリコール",
					"クトロ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741042802,
					"content": "やはり…素晴らしい腕前ですね。今まで見た素材の中でも最高のものです！しかし、私が制御できるレベルを超えています…私の負けです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042803
					],
					"speakerTitle": "クトロ"
				},
				{
					"id": 741042803,
					"content": "なんだこいつ、訳わかんないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042804
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741042804,
					"content": "それもそうでしょう。何しろ彼は以前、その…ええと、「訳のわからない」研究をしていて、フォンテーヌ科学院から追放されたんですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042805
					],
					"speakerTitle": "ブリコール"
				},
				{
					"id": 741042805,
					"content": "あれは「訳のわからない」研究などではない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042806
					],
					"speakerTitle": "クトロ"
				},
				{
					"id": 741042806,
					"content": "いや、あのとき倫理委員会の人にも同じことを言ってたけど、信じてくれた人がいたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042807
					],
					"speakerTitle": "ブリコール"
				},
				{
					"id": 741042807,
					"content": "それって、どんな研究なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741042808
					]
				},
				{
					"id": 741042808,
					"content": "はぁ…そういう情報を知りたいのであれば、ご自分で新フォンテーヌ科学院に行き、関連するコンプライアンスの手続きをしてほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042809
					],
					"speakerTitle": "ブリコール"
				},
				{
					"id": 741042809,
					"content": "なんか面倒くさそうだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042810
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741042810,
					"content": "こっちも手を焼いてるんだ。彼はすでに除名された身ではあるが、僕が調査している資材盗難案件にも関わっていてね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042811
					],
					"speakerTitle": "ブリコール"
				},
				{
					"id": 741042811,
					"content": "ふん、今度は私をメロピデ要塞にでも送るつもりか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042812
					],
					"speakerTitle": "クトロ"
				},
				{
					"id": 741042812,
					"content": "それは僕じゃなくて法律が決めることさ。今回は前みたいに、単純に除名扱いするだけじゃ済まないのが残念だけどね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042813
					],
					"speakerTitle": "ブリコール"
				},
				{
					"id": 741042813,
					"content": "とにかく、お二人には感謝してるよ。僕一人だったら彼を抑えられなかった…あとのことは任せてほしい。彼はきっと相応の懲罰を受けることになるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042814
					],
					"speakerTitle": "ブリコール"
				},
				{
					"id": 741042814,
					"content": "はぁ、これからもここで後処理の仕事をするんだろうな…こんなに大量の資産、一体何枚のレポートになることやら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ブリコール"
				}
			]
		},
