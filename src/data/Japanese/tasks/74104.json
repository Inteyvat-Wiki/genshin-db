					],
					"speakerTitle": "クトロ"
				},
				{
					"id": 741044002,
					"content": "うーん…わかったよ。でも急いでくれよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741044003
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741044003,
					"content": "クイセルと慎重に位置を交換した…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741044004
					]
				},
				{
					"id": 741044004,
					"content": "——しばらく待ったが、彼は一向に戻ってこない。しかも奇妙な話し声まで聞こえてくる…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741044005
					]
				},
				{
					"id": 741044005,
					"content": "まずは檻から脱出する方法を考えよう…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741044006
					]
				},
				{
					"id": 741044006,
					"content": "まぁ、幸い一緒に檻の中には閉じ込められなかったし…うーん、さっきと同じ方法で扉を開ければいいんだよな？ちょっと試してみるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
