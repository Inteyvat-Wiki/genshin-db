	"talks": [
		{
			"id": 7410404,
			"completionStepIds": [
				7410404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7410404",
							"2"
						],
						"stepId": 7410404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"クトロ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741040401,
					"content": "え、えっと…研究の助手に応募した方たちですか？すみません、ちょっと今、手が離せなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040402,
						741040403
					],
					"speakerTitle": "クトロ"
				},
				{
					"id": 741040402,
					"content": "そうだろうね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741040405
					]
				},
				{
					"id": 741040405,
					"content": "そんなことより、なんで檻に閉じ込められてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741040406,
					"content": "研究仲間とちょっと意見が割れてしまい…クトロ…が、しばらく頭を冷やせとここに…そ、そうだ。自己紹介がまだでしたね。私のことは…クイセルと呼んでください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040407
					],
					"speakerTitle": "クトロ"
				},
				{
					"id": 741040407,
					"content": "えっと、つまり…ここはクイセルのクロックワーク工房で…私がそのクイセルです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040408
					],
					"speakerTitle": "クトロ"
				},
				{
					"id": 741040408,
					"content": "#オイラはパイモンで、こっちは{NICKNAME}だ…そういえばさっき口ゲンカする声が聞こえたけど、もう一人の凶暴そうなやつはおまえのパートナーだったんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040409,
						741040411
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741040409,
					"content": "パートナーを替えたら？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741040410
					]
				},
				{
					"id": 741040410,
					"content": "#おう、そうだな！いいパートナーってのはオイラみたいなやつのことを言うんだぞ…{NICKNAME}にはオイラっていうパートナーがいて、ホント運が良かったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741040413,
					"content": "ま、待って！その…ここから出してくれませんか…？近くにあるエネルギー蓄積装置を起動させれば…と、扉が開くはずですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040414
					],
					"speakerTitle": "クトロ"
				},
				{
					"id": 741040414,
					"content": "お、お願いですっ！前に助手に応募してくれた人も彼の怒りっぽい性格に耐えられなくてすぐに辞めてしまい、ここには私たちしか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040415
					],
					"speakerTitle": "クトロ"
				},
				{
					"id": 741040415,
					"content": "#うーん、まぁそういうことなら…{NICKNAME}、こいつを助けてやろうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741040411,
					"content": "頭を冷やすなら邪魔になるし、失礼するよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741040412
					]
				},
				{
					"id": 741040412,
					"content": "おいっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741040403,
					"content": "フラッと寄っただけ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741040404
					]
				},
				{
					"id": 741040404,
					"content": "け、見学ですか？も、もちろんそれも歓迎しますけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040405
					],
					"speakerTitle": "クトロ"
				}
			]
		},
		{
			"id": 7410405,
			"completionStepIds": [
				7410406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7410406",
							"2"
						],
						"stepId": 7410406,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"7410401",
							"0"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"クトロ"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							4944.755,
							367.04,
							4455.18
						],
						"pointId": 6729
					}
				]
			},
			"dialogs": [
				{
					"id": 741040501,
					"content": "扉を開けたぞ！出てこないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741040502,
					"content": "じ、実はもう一つ言いにくいことがあるんですが…もし私が今この檻を出ると、た、たぶん爆発するんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040503
					],
					"speakerTitle": "クトロ"
				},
				{
					"id": 741040503,
					"content": "爆発？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741040504,
					"content": "え、ええ…先ほども言いましたが、研究仲間の彼は、その…怒りっぽい性格でして、檻の下に特殊なトリガー装置を取り付けたんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040505
					],
					"speakerTitle": "クトロ"
				},
				{
					"id": 741040505,
					"content": "はぁ！？じゃあ、どうすればいいんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040506,
						741040508
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741040506,
					"content": "他の重い物を代わりにするとか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741040507
					]
				},
				{
					"id": 741040507,
					"content": "ふ、普通の「重し」では恐らく無理でしょう…これの原理はとても複雑でして、ええと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040510
					],
					"speakerTitle": "クトロ"
				},
				{
					"id": 741040510,
					"content": "#{NICKNAME}さん、私と一時的に代わってくれないでしょうか…檻の中で少しお待ちいただいている間に、私が特殊なトリガー装置を解除しますので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040511
					],
					"speakerTitle": "クトロ"
				},
				{
					"id": 741040511,
					"content": "な、なにせ長年研究を共にしてきたパートナーですから、何を考えているかは手に取るように分かります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040512,
						741040515
					],
					"speakerTitle": "クトロ"
				},
				{
					"id": 741040512,
					"content": "#{M#俺}{F#私}は重くないだろうし、パイモンのほうが…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741040513
					]
				},
				{
					"id": 741040513,
					"content": "オ、オイラは空中に浮かんでるから重さなんてないぞ！ぜ、絶対にないからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040514
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741040514,
					"content": "ええと…このトリガー装置は非常に特殊でして、単純に重量で判断しているわけではないんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040516
					],
					"speakerTitle": "クトロ"
				},
				{
					"id": 741040516,
					"content": "どうか信じてください。少しの間だけ私と代わってくだされば、すぐに装置を解除して戻ってきますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040517
					],
					"speakerTitle": "クトロ"
				},
				{
					"id": 741040517,
					"content": "…その、フォンテーヌ科学院をご存知ですか？もしくはレモンド先生やボシュエ先生の名を聞いたことは？わ、私もあの方たちの指導を受けていた身なんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040518
					],
					"speakerTitle": "クトロ"
				},
				{
					"id": 741040518,
					"content": "こ、こちらの技術的問題は簡単ですし、それほど時間はかかりません。ほんの少しでいいんです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040519
					],
					"speakerTitle": "クトロ"
				},
				{
					"id": 741040519,
					"content": "うーん…わかったよ。でも急いでくれよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040520
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741040520,
					"content": "クイセルと慎重に位置を交換した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741040521
					]
				},
				{
					"id": 741040521,
					"content": "あれっ？また扉が閉まったぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040522
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741040522,
					"content": "ふ、不具合でも起きたんでしょう。ちょ、ちょっと調べに行ってきます…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040523
					],
					"speakerTitle": "クトロ"
				},
				{
					"id": 741040523,
					"content": "嫌な予感が…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741040524
					]
				},
				{
					"id": 741040524,
					"content": "あ、安心してください。すぐに処理しますから。トリガー装置を解除する端末は別の場所にあるので、しばらくここを離れますね。お待ちください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040525
					],
					"speakerTitle": "クトロ"
				},
				{
					"id": 741040525,
					"content": "辛抱強く待つしかなさそうだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040526
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741040526,
					"content": "しばらくして…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741040527
					]
				},
				{
					"id": 741040527,
					"content": "遅いなぁ…なんかトラブルに巻き込まれたんじゃないよな？でも、ここにはあいつと研究仲間しかいないって言ってたし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040528,
						741040530
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741040528,
					"content": "もしかして、他の檻に閉じ込められてたり…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741040529
					]
				},
				{
					"id": 741040529,
					"content": "ええー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040532
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741040532,
					"content": "昔はよく、「善良」とは本当に美しい品性なのか？と思っていました。ただ善良なだけ…それがその人の人生に何の利益をもたらすんでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040533
					],
					"speakerTitle": "クトロ"
				},
				{
					"id": 741040533,
					"content": "…ん？誰の声だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040534
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741040534,
					"content": "そこには元から爆発するようなトリガー装置なんてないんです。まぁ、檻の扉はロックされてしまいましたけど。お二人はそのまま待ち続けるか、何か行動を起こすしかありません…どうします？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040535
					],
					"speakerTitle": "クトロ"
				},
				{
					"id": 741040535,
					"content": "はぁっ？こいつなに言ってんだよ！しかもこの声…さっきのクイセルに似てる気もするし、ケンカしてた声にも似てる気がするぞ…どういうことだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040536
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741040536,
					"content": "まずはここを出る方法を…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741040537
					]
				},
				{
					"id": 741040537,
					"content": "そうだな！でも…檻の中に閉じ込められちゃったし、扉のロックをなんとかしないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040538
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741040538,
					"content": "頼んだよ、パイモン！どうにか助けて！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741040539
					]
				},
				{
					"id": 741040539,
					"content": "え、ええっ！？オイラが！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040540
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741040540,
					"content": "まぁ、幸い一緒に檻の中には閉じ込められなかったし…うーん、さっきと同じ方法で扉を開ければいいんだよな？ちょっと試してみるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741040530,
					"content": "はめられたのかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741040531
					]
				},
				{
					"id": 741040531,
					"content": "オイラたちを騙してたってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040532
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741040515,
					"content": "ちょっと怪しい気が…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741040516
					]
				},
				{
					"id": 741040508,
					"content": "仕方ない。街の人を呼んでくる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741040509
					]
				},
				{
					"id": 741040509,
					"content": "そ、そこまで面倒をかけるわけには…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040510
					],
					"speakerTitle": "クトロ"
				}
			]
		},
