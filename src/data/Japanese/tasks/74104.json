			"dialogs": [
				{
					"id": 741040801,
					"content": "よく見ると、端末とエネルギー蓄積装置が二つずつあるぞ。扉のほうのエネルギー蓄積装置を活性化させれば、ロックは解除されるはずだよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040802
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741040802,
					"content": "えっと…どっちに行けばいいんだ？扉のほうにある端末か？檻のほうにあるやつか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040803,
						741040805
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741040803,
					"content": "扉のほうの端末に行ってみて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741040804
					]
				},
				{
					"id": 741040804,
					"content": "うーん、なんか違うな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040801
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741040805,
					"content": "檻のほうの端末を試してみて。",
