			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"クトロ",
					"ブリコール"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741042501,
					"content": "クイセル！見つけたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741042502,
					"content": "隣にいるのは…クイセルの言ってたイカれた研究仲間のクトロだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741042503,
					"content": "…なんだって？僕はブリコール。クトロはこっちの彼のほうだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042504
					],
					"speakerTitle": "ブリコール"
				},
				{
					"id": 741042504,
					"content": "へ？クイセルって名前じゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741042505,
					"content": "クイセルというのは…便宜上の役に過ぎません。お二人はいくつもの試験を突破したので、もう隠す必要もないでしょう。私の名はクトロ——この工房の本当の主です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042506
					],
					"speakerTitle": "クトロ"
				},
				{
					"id": 741042506,
					"content": "ふふ、お二人は…素材として本当に申し分ない。もし私の研究に協力してくれるなら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042507
					],
					"speakerTitle": "クトロ"
				},
				{
					"id": 741042507,
					"content": "どんな研究なのか聞かせてくれる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741042508
					]
				},
				{
					"id": 741042508,
					"content": "ウソだろ！？こんな怪しいやつに協力する気か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042510
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741042510,
					"content": "ここ、どう見たって正規の工房には見えないぞ！それに人を騙してクロックワーク·マシナリーにオイラたちを攻撃させるなんて…そんなの危険人物じゃんかよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042511
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741042511,
					"content": "そうとも！騙されちゃいけない！彼は…凶悪極まりない悪人なんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042512
					],
					"speakerTitle": "ブリコール"
				},
				{
					"id": 741042512,
					"content": "僕は調査の手がかりをもとにここへやってきてね。けど、まさか除名されたあなたが危険な研究をまだ続けていたとは…しかも、そのためにフォンテーヌ科学院の資産を盗むなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042513
					],
					"speakerTitle": "ブリコール"
				},
				{
					"id": 741042513,
					"content": "これは立派な犯罪だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042514
					],
					"speakerTitle": "ブリコール"
				},
				{
					"id": 741042514,
					"content": "余計な口出しをしないでもらおうか、ブリコール。役立たずの凡人めが…このお二人の客人の真の価値を測り終えたら、お前の処分をしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042515
					],
					"speakerTitle": "クトロ"
				},
				{
					"id": 741042515,
					"content": "客人って…まさかオイラたちのことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042516
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741042516,
					"content": "もちろん。お二人が真の価値を証明するまで、あとひとつ試験が残っていますよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042517
					],
					"speakerTitle": "クトロ"
				},
				{
					"id": 741042517,
					"content": "さあ、お二人の実力を私に見せてください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "クトロ"
				}
			]
		},
		{
			"id": 7410428,
			"completionStepIds": [
				7410428
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7410428",
