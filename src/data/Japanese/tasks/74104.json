					"content": "扉の傍のエネルギー蓄積装置を起動させて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741040811
					]
				},
				{
					"id": 741040811,
					"content": "おう、任せろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040812
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741040812,
					"content": "扉のポートが光ったぞ！あそこからなら別の画面が見られるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040813
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741040813,
					"content": "よし、こっからだと大きい扉が見えるぞ！次はどうしたらいい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040814,
						741040816
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741040814,
					"content": "向かいにあるポートの視点に戻って。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741040815
					]
				},
				{
					"id": 741040815,
					"content": "え？わかった…",
					"roleType": "TALK_ROLE_NPC",
