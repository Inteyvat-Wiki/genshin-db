	"talks": [
		{
			"id": 7114901,
			"completionStepIds": [
				7114901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7114901",
							"2"
						],
						"stepId": 7114901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"萍渓"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711490101,
					"content": "今年の予定は問題ないはず…ふぅ…今回は、刻晴様に直接確認していただかなくても大丈夫そうです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490116
					],
					"speakerTitle": "萍渓"
				},
				{
					"id": 711490116,
					"content": "うっ！そんなこと考えちゃダメ…私は福の神、私は福の神、私は福の神…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490103
					],
					"speakerTitle": "萍渓"
				},
				{
					"id": 711490103,
					"content": "#えっと、{M#君}{F#あなた}は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711490117
					]
				},
				{
					"id": 711490117,
					"content": "私は福の神です！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490118,
						711490119
					],
					"speakerTitle": "萍渓"
				},
				{
					"id": 711490118,
					"content": "そ、そうだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711490120
					]
				},
				{
					"id": 711490120,
					"content": "#おや？{NICKNAME}さんでしたか。来るのがあなたって分かっていたら、あんなに決まり文句を覚えなくて良かったのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490121
					],
					"speakerTitle": "萍渓"
				},
				{
					"id": 711490121,
					"content": "どうやら、璃月の海灯祭を満喫しにいらしたんですね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490122
					],
					"speakerTitle": "萍渓"
				},
				{
					"id": 711490122,
					"content": "ちょうどいいところに来てくれました。ほら、周りの雰囲気をご覧ください。去年の海灯祭よりも賑やかでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490123,
						711490124
					],
					"speakerTitle": "萍渓"
				},
				{
					"id": 711490123,
					"content": "海灯祭はいつも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711490125
					]
				},
				{
					"id": 711490125,
					"content": "ええ、その通りです。「霄灯は高く高く舞い上がる」と言いますからね。何事も常に上を目指すべきでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490126
					],
					"speakerTitle": "萍渓"
				},
				{
					"id": 711490126,
					"content": "あっ、せっかくのお祭りなのに、こんな真面目な話はよしましょう。さあさあ、お祭りの見どころをご案内しますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490127
					],
					"speakerTitle": "萍渓"
				},
				{
					"id": 711490127,
					"content": "えーと、そうですね…あっ、そうだ！海灯祭と言えば、まずは霄灯を飛ばさないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490128
					],
					"speakerTitle": "萍渓"
				},
				{
					"id": 711490128,
					"content": "そうそう、あと今年は璃月港のあちこちに「吉兆の宝樹」を設置しました。その枝を切って整えてあげると、中にある「吉語銭」を貰える、といったものです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490129
					],
					"speakerTitle": "萍渓"
				},
				{
					"id": 711490129,
					"content": "全部でいくつだったか…えーっと…たしか二十一本のはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490130
					],
					"speakerTitle": "萍渓"
				},
				{
					"id": 711490130,
					"content": "そして…実はこの近くにも「吉兆の宝樹」が一本ありまして。興味があれば手入れしてあげてください、そう難しくありませんので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490131
					],
					"speakerTitle": "萍渓"
				},
				{
					"id": 711490131,
					"content": "最後に…もしよろしければ、そこの「掲示板」も見ていただけますか。ほら、すぐ横のです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490132
					],
					"speakerTitle": "萍渓"
				},
				{
					"id": 711490132,
					"content": "近年、海灯祭には外国から多くの観光客が訪れるようになったため、総務司はそういった方々に向けて「掲示板」を設置しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490102
					],
					"speakerTitle": "萍渓"
				},
				{
					"id": 711490102,
					"content": "もし何か問題やトラブルがありましたら、「掲示板」にお書きください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490133
					],
					"speakerTitle": "萍渓"
				},
				{
					"id": 711490133,
					"content": "私たち総務司は、海灯祭に来てくださった皆さまに満足してもらえるよう、全力を尽くす所存です！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490134,
						711490135
					],
					"speakerTitle": "萍渓"
				},
				{
					"id": 711490134,
					"content": "さすが総務司だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711490136
					]
				},
				{
					"id": 711490136,
					"content": "当然のことです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490137
					],
					"speakerTitle": "萍渓"
				},
				{
					"id": 711490137,
					"content": "#そういえば、たしか{NICKNAME}さんは写真を撮るのがお得意でしたよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490138,
						711490139
					],
					"speakerTitle": "萍渓"
				},
				{
					"id": 711490138,
					"content": "いくらかね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711490140
					]
				},
				{
					"id": 711490140,
					"content": "あはは、ご謙遜なさらず。実は…ちょっとしたお願いがありまして。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490141
					],
					"speakerTitle": "萍渓"
				},
				{
					"id": 711490141,
					"content": "簡単なことなのでご安心を！観光客の「記念写真」を撮るだけですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490142
					],
					"speakerTitle": "萍渓"
				},
				{
					"id": 711490142,
					"content": "もともとは撮影スタッフを何人か雇って、「記念撮影」の対応をしてもらう予定だったんですが、今年は観光客が予想以上に多くて、人手が全然足りなくなってしまいまして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490143
					],
					"speakerTitle": "萍渓"
				},
				{
					"id": 711490143,
					"content": "#今から新しいカメラマンを雇うのも間に合わないので、頼れるのはもう{NICKNAME}さんしかいません！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490144
					],
					"speakerTitle": "萍渓"
				},
				{
					"id": 711490144,
					"content": "お願いします！観光客の皆さまのため、海灯祭のため、璃月のために！どうか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490145,
						711490146
					],
					"speakerTitle": "萍渓"
				},
				{
					"id": 711490145,
					"content": "そういうことなら任せて！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711490147
					]
				},
				{
					"id": 711490147,
					"content": "#おお！さすが{NICKNAME}さん！では、お客さまの名前と予約場所をお伝えしますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490148
					],
					"speakerTitle": "萍渓"
				},
				{
					"id": 711490148,
					"content": "それでは、よろしくお願いします。あなたのお手伝いがあれば、今年の海灯祭はきっと完璧なものになるでしょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490149
					],
					"speakerTitle": "萍渓"
				},
				{
					"id": 711490149,
					"content": "あと、こちらの霄灯をどうぞ。海灯祭を祝して！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "萍渓"
				},
				{
					"id": 711490146,
					"content": "海灯祭のためなら！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711490147
					]
				},
				{
					"id": 711490139,
					"content": "まったく得意じゃないけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711490140
					]
				},
				{
					"id": 711490135,
					"content": "さすが璃月…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711490136
					]
				},
				{
					"id": 711490124,
					"content": "前の年よりすごくなってる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711490125
					]
				},
				{
					"id": 711490119,
					"content": "縁起の良さそうな服だね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711490120
					]
				}
			]
		}
	]
}