					"クーシ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750470401,
					"content": "はぁ…体重はキープできてるけど…ん？何か用か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750470402,
						750470405,
						750470409
					],
					"speakerTitle": "クーシ"
				},
				{
					"id": 750470402,
					"content": "#{M#君}{F#あなた}は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750470403
					]
				},
				{
					"id": 750470403,
					"content": "ああ、あたしはここの見張りを担当している哨兵だ。今は休暇中だけどな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750470404
					],
					"speakerTitle": "クーシ"
				},
				{
					"id": 750470404,
					"content": "何かあるなら、隣にいるユカムに聞いてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "クーシ"
				},
				{
					"id": 750470405,
					"content": "何か悩み事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750470406
					]
				},
				{
					"id": 750470406,
					"content": "ああ、実は最近体重が少し増えてきててさ。いつも食べてるグレインの実に、ヘルシーな野菜をたっぷり添えて食べるようにしてるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750470407
					],
					"speakerTitle": "クーシ"
				},
				{
					"id": 750470407,
					"content": "そしたら、仲間のウゥルが真似しはじめて…ここのところ、草ばかり食べてるんだ。竜は雑食っちゃ雑食だけど、草ばっか食べてたら、栄養が足りなくなるだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750470408
					],
					"speakerTitle": "クーシ"
				},
				{
					"id": 750470408,
					"content": "今度あいつとじっくり話してみないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "クーシ"
				},
				{
					"id": 750470409,
					"content": "特に用事はない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750470410
					]
				},
				{
					"id": 750470410,
					"content": "そうか。じゃ、旅を楽しんでくれよ、お客さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "クーシ"
				}
			]
		}
	]
