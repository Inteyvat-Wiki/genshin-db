				"points": []
			},
			"dialogs": [
				{
					"id": 400671201,
					"content": "万葉、見つけたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400671202,
					"content": "ちょうどいいところに来てくれた。拙者は今までの人生を振り返ったところでござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671203
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400671203,
					"content": "楓原家の盆景をどう思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671204,
						400671207
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400671204,
					"content": "長い年月を経た深みがあるね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671205
					]
				},
				{
					"id": 400671205,
					"content": "年月を重ねたものには、心残りがつきもの——楓原家も同じでござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671206
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400671206,
					"content": "しかし構わぬ。別れがあれば再会もある。ここで会えねば、余所で会えることもござろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671209
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400671209,
					"content": "この幻境はとても興味深いですね。演劇のようなシーンは、回数を重ねる度により特別なものになって、心に響きます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671210
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400671210,
					"content": "占星術師は皆、見識が広いでござるな。お主にそう言ってもらえるならば、この幻境にも存在する価値があろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671211
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400671211,
					"content": "ねえ、あなた…ご機嫌いかが？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671212
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400671212,
					"content": "お嬢様は万葉殿に、あまり落ち込みすぎないようにとおっしゃっています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671213
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 400671213,
					"content": "こんな経験を振り返るのなんて、楽しいはずないよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400671214,
					"content": "はは、そうでござるな。皆の気遣いに感謝する。だが拙者にとってはどれも、過ぎたことでござるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671215
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400671215,
					"content": "盆景を目にした瞬間、この可能性に思い至ったのだ…拙者は、お主らを待っていたのだと。だからこそ、拙者だけが終点に残されたのやもしれぬ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400671207,
					"content": "完全とは言えないけど、恥じることはない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671208
					]
				},
				{
					"id": 400671208,
					"content": "そうでござるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671209
					],
					"speakerTitle": "楓原万葉"
				}
			]
		},
		{
