			"dialogs": [
				{
					"id": 400671001,
					"content": "おい、あんた！大丈夫か！こっちに避難するか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671002
					],
					"speakerTitle": "耳を傾ける"
				},
				{
					"id": 400671002,
					"content": "海賊か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671003
					],
					"speakerTitle": "耳を傾ける"
				},
				{
					"id": 400671003,
					"content": "ハ！そう、海賊さ！来るかどうかは自分で決めろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "耳を傾ける"
