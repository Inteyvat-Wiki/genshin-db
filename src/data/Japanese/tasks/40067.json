			},
			"dialogs": [
				{
					"id": 400670301,
					"content": "なんなんだよ、ここ！めちゃくちゃだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400670302,
					"content": "…没落した貴族の家は、こうなってしまうのね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670303
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400670303,
					"content": "あちこち壊れている上、誰もいません。すでに家は終焉を迎えたのでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670304
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400670304,
					"content": "行こうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛炎"
				}
			]
		},
