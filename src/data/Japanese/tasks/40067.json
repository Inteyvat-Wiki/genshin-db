					"耳を傾ける"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400670401,
					"content": "お前が楓原か？早く船に乗り込め、送ってやるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670402
					],
					"speakerTitle": "耳を傾ける"
				},
				{
					"id": 400670402,
					"content": "お主…どうして拙者を助ける？拙者はお尋ね者でござるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670403
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400670403,
					"content": "それはもちろんしゃぶぎ…コ、コホン！お前を稲妻から無事に送り出すようにって、金を出した人がいるからさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670404
					],
					"speakerTitle": "耳を傾ける"
				},
				{
					"id": 400670404,
					"content": "ただ、周りがしてやれることには限りがあるから、後は自分で頑張ってもらわないとな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "耳を傾ける"
				}
			]
		},
		{
			"id": 4006705,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
