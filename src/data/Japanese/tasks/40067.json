				"points": []
			},
			"dialogs": [
				{
					"id": 400671301,
					"content": "ふぁあ～。たくさん歩いて、なんだか眠くなってきた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400671302,
					"content": "みんなも疲れたよな？今日は早く寝たほうがいいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671303
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400671303,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671304
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400671304,
					"content": "ん？どうしました？顔色が悪いですが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671305
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400671305,
					"content": "何でもないわ、少し疲れを感じただけ。今日の旅に疲れ果ててしまったのでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671306
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400671306,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671307
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 400671307,
					"content": "お嬢様、大丈夫ですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671308
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 400671308,
					"content": "オズ、余計なことを言わないで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671309
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400671309,
					"content": "失礼いたしました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671310
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 400671310,
					"content": "……？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671311
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400671311,
					"content": "あんたら、疲れたんならしばらく休めよ。アタイは食料を探しに行くから、体力が残ってるヤツは一緒に来い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671312
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400671312,
					"content": "拙者が行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671313
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400671313,
					"content": "私も手伝えます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671314
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400671314,
					"content": "みんなこんなに積極的なんだし、オイラたちも行こうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671315
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400671315,
					"content": "#{M#俺}{F#私}とパイモンも手伝う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671316
					]
				},
				{
					"id": 400671316,
					"content": "そんなに大人数はいらないぜ、それに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671317
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400671317,
					"content": "皇女殿下が少し落ち込んでるみてーだ。モナ、あんたは彼女のことをよく知ってるだろう。散歩に付き合ってやったらどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671318
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400671318,
					"content": "気づいていましたか。食べ物の準備をしながら、その話をしようと思っていたんです。だったら、私に任せてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671319
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400671319,
					"content": "よし、それじゃ食べ物の準備はアタイたちに任せろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671320
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400671320,
					"content": "モナはこちらに目配せをすると、フィッシュルの傍に行った。残りのみんなで、料理にできる食材を探した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400671321
					]
				},
				{
					"id": 400671321,
					"content": "これだけあれば十分だな。後で焼いて食べようぜ。もし次に人のいねー拠点を見つけたら、鍋がないか探そうぜ。鍋があればちゃんとした料理が作れるしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671322
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400671322,
					"content": "すごい心配りだぞ！辛炎は料理人じゃないのに、人の世話をするのが得意なんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671323
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400671323,
					"content": "へへ、アタイはできることをやっただけさ。褒めすぎなんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671324
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400671324,
					"content": "辛炎殿は「死兆星号」の皆にも認められた、良い仲間でござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671325
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400671325,
					"content": "おう！オイラたちにとっては、万葉も頼もしい仲間だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671326
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400671326,
					"content": "ハハハッ、その通りさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671327
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400671327,
					"content": "ふむ…ならば、頼もしい仲間として、皆と話したいことがあるのだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671328
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400671328,
					"content": "お主らの話を聞いた限り、今日の不思議な幻境は「楓原万葉」のこれまでの人生をもとに作られたものであった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671329
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400671329,
					"content": "…まるで、拙者の夢のように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671330
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400671330,
					"content": "もしかして、本当に「夢」なのかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671331
					]
				},
				{
					"id": 400671331,
					"content": "万葉、あんたは…ずっと自分だけの「盆景」を作りたかったんだろう",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671332
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400671332,
					"content": "うむ…そして、拙者の願いは叶ったか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671333
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400671333,
					"content": "しかし、拙者がこのような状況になったということは、皆にもその可能性があるということではなかろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671334
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400671334,
					"content": "#うん、{M#俺}{F#私}もそう思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671335
					]
				},
				{
					"id": 400671335,
					"content": "アタイもだ。ただ、次の場所が誰の幻境かは分からないけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671336
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400671336,
					"content": "ハ、そう考えると、アタイもあんな夢を見てみたくなったぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671337
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400671337,
					"content": "おまえ、あんな幻境が欲しいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671338
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400671338,
					"content": "もしアタイにあんな領域があるなら、きっと音楽に関係するやつだろ。ハハッ、そしたら腕を振るえるぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671339
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400671339,
					"content": "もしかして、急に演奏を始めたりするんじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671340
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400671340,
					"content": "それは当たり前だろ？音楽をやるやつなら誰でも、この群島の美しい景色を見れば、音楽を奏でたいって思うに決まってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671341
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400671341,
					"content": "なんて楽観的でたくましい心なんだ。オイラちょっと感服したぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671342
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400671342,
					"content": "あ、そうだ！旅人、崖に生えてる果物を食べたいんだけど、一緒に採りに行ってくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671343
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400671343,
					"content": "（ん？もしかして…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671344
					]
				},
				{
					"id": 400671344,
					"content": "ごめん、ちょっと二人で行ってくる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 4006714,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006714",
							"2"
						],
						"stepId": 4006714,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ドド通話機"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400671401,
					"content": "今日の変わった建物と、幻境の…えっと…盆景？とにかくあの変な出来事！このこと、吟遊野郎に教えたほうがいいよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671402,
						400671403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400671402,
					"content": "やっぱりそのことか。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671404
					]
				},
				{
					"id": 400671404,
					"content": "ドドコ——ドドコ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671405
					],
					"speakerTitle": "ドド通話機"
				},
				{
					"id": 400671405,
					"content": "ドドコ——ドドコ——ドドコ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671406
					],
					"speakerTitle": "ドド通話機"
				},
				{
					"id": 400671406,
					"content": "返事がない…おかしいな、なんで返事してくれないんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671407
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400671407,
					"content": "通じないはずないけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671408
					]
				},
				{
					"id": 400671408,
					"content": "吟遊野郎のやつ、またボーっとしちゃってるのか？それとも、演奏してる間は爆弾を持ち歩いてないのか？もしかすると、酔っ払って木の下で居眠りしてたりして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671409
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400671409,
					"content": "うぅ…おかしいぞ。でも仕方ない…また明日、連絡してみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671410
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400671410,
					"content": "旅人、それにパイモン、ここにいましたか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671411
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400671411,
					"content": "モナだ！フィッシュルとの話は終わったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671412
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400671412,
					"content": "あはは、まあ一応は…彼女はちょっと憂鬱なんです。多分…今日見た幻境のせいかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671413
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400671413,
					"content": "フィッシュルは今回の旅に積極的です。でも、自分の幻境を見たくないんじゃないかなと思いますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671414
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400671414,
					"content": "なんで？あいつ、こういうことに憧れてるんじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671415
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400671415,
					"content": "…まだ結論は出せませんが、とにかく気にかけておきます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671416
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400671416,
					"content": "私が言いたかったのは別のことです。先ほど海辺でもう一度ここを占ってみました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671417
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400671417,
					"content": "水占の盤は今回も濁っていましたが、前回と違って、何らかの力を感じられました。位置までは分かりませんが、段々変化してきているような感じがします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671418
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400671418,
					"content": "見えないのにどうやって感じるんだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671419
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400671419,
					"content": "素人にどう説明すれば…あっ！たとえば部屋のどこかに隙間が空いていたとしましょう。位置は分かりませんが、風がそこから入ってくるんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671420
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400671420,
					"content": "すると、部屋の温度もどんどん下がっていくでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671421
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400671421,
					"content": "おう！そう言われると、なんとなく分かった気がするぞ。その亀裂がどこにあるのか探したいんだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671422
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400671422,
					"content": "そうですね。これからの方針を決めるには、まずその亀裂を見つけないといけません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "モナ"
				},
				{
					"id": 400671403,
					"content": "彼に連絡しよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671404
					]
				}
			]
		}
	]
}