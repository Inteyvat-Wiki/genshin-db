			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ドド通話機"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400670201,
					"content": "…まさか、こんなに綺麗な土地で、このような不思議を解決することになるとは思いませんでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670202
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400670202,
					"content": "どうだった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400670203
					]
				},
				{
					"id": 400670203,
					"content": "悪くありません。もし力になってくれるなら、尚いいですが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670204
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400670204,
					"content": "じゃあオイラたち、なにをすればいいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400670205,
					"content": "えっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670206
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400670206,
					"content": "えー…うーん…特にないんじゃないですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670207
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400670207,
					"content": "オ、オイラたちをなめてるのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400670208,
					"content": "いえ、ただ先ほど気づいたんです。あなたは口数の多い方ではありませんが、いつも物事を完璧にこなし、みんなのために色々と動いてくれる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670209
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400670209,
					"content": "あなたのような人は、みんなに一番必要な仲間です。あなたがいれば、心強いので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670210
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400670210,
					"content": "勝手に期待されるのはプレッシャーかもしれませんが、私は…占星術師は観察力を持つべきだと思っています。他の人の長所を発見するのも、観察の一つなんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670211
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400670211,
					"content": "つまり、オイラたちを褒めたいだけってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400670212,
					"content": "事実を述べただけで、褒めてはいません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670213
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400670213,
					"content": "へぇ、モナは認めたくないんだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400670214
					]
				},
				{
					"id": 400670214,
					"content": "褒めたんだろ、素直に認めろよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670215
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400670215,
					"content": "な、何を笑ってるんですか。客観的な評価だって言いましたよね。別に褒めてなんかいません！褒めていませんから——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670216
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400670216,
					"content": "とにかく、引き続き星を観測してみます。旅人、これからもよろしくお願いしますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "モナ"
				}
			]
		},
