					"nextDialogs": [
						721780103
					]
				},
				{
					"id": 721780103,
					"content": "（丹念に手入れされた祠、とても綺麗な状態だ。ここを手入れしている人はさぞかし気を配っているのであろう。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780104
					],
					"speakerTitle": "祠"
				},
				{
					"id": 721780104,
					"content": "（これ以外に、誰かが来た痕跡はない。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780105
					],
					"speakerTitle": "祠"
				},
				{
					"id": 721780105,
					"content": "変だな…誰かが来たみたいだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
