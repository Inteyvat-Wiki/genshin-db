					"nextDialogs": [
						721780204
					]
				},
				{
					"id": 721780204,
					"content": "（綺麗に手入れされた祠、ほんのりと神櫻の香りがする。少し前に誰かがここへお参りに来たのかもしれない。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780205
					],
					"speakerTitle": "祠"
				},
				{
					"id": 721780205,
					"content": "（これ以外に、新しい痕跡はない。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780206
					],
					"speakerTitle": "祠"
				},
				{
					"id": 721780206,
					"content": "神櫻の花びらの香りだ…長次のお母さんが来てたかもしれない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721780207,
					"content": "それも少し前に！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
