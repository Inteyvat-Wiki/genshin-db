			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"キィニチ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 756620101,
					"content": "伝達使から、戦闘準備連絡官が実力者のテスターを見つけたと聞いたが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620102
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 756620102,
					"content": "お前だったのか。よかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620103
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 756620103,
					"content": "チッ、なんでお前まで来やがったんだ？ったく、キィニチと一緒で、依頼となったら見境がねぇんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620104
					],
					"speakerTitle": "アハウ"
				},
				{
					"id": 756620104,
					"content": "おっと、新しい依頼の知らせだ——「口うるさい竜を黙らせてほしい」だとさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620105,
						756620107
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 756620105,
					"content": "#いま{M#俺}{F#私}が出した。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756620106
					]
				},
				{
					"id": 756620106,
					"content": "ぶ…無礼な！…フン、よくも偉大なる聖龍をバカにしてくれたな！ぜってぇ代償を払ってもらうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620109
					],
					"speakerTitle": "アハウ"
				},
				{
					"id": 756620109,
					"content": "#さて、本題に戻ろう。今回は{NICKNAME}にいくつかのステージをテストしてもらいたい。難易度やバランスはお前の期待を裏切らないと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620110
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 756620110,
					"content": "ハッ、オレに言わせりゃ、難易度ゼロだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620111
					],
					"speakerTitle": "アハウ"
				},
				{
					"id": 756620111,
					"content": "「くじで引いたバカな仲間とチームを組んで、目隠しした状態で崖から飛び降りる。」——こういうのならお前も手ごたえを感じるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620112
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 756620112,
					"content": "くじの中にユムカ竜は一割。残りは溶岩の像と岩スライムだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620113,
						756620116
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 756620113,
					"content": "下手したら死ぬね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756620114
					]
				},
				{
					"id": 756620114,
					"content": "フン、オレの従者とこれだけ付き合ってきて、まだ「懸木の民」の趣味が分かってないのか？これはオレからお前への優しいアドバイスだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620115
					],
					"speakerTitle": "アハウ"
				},
				{
					"id": 756620115,
					"content": "なら、手本を見せてもらおうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620120
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 756620120,
					"content": "…こんなへっぽこ挑戦に参加させるなんて、偉大なる聖龍への冒涜だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620121
					],
					"speakerTitle": "アハウ"
				},
				{
					"id": 756620121,
					"content": "とにかく、イラードは俺に十分な報酬を提示してくれた。お前も、楽しみながら報酬を手に入れられることを願ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620122,
						756620123
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 756620122,
					"content": "うん、楽しみ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756620124
					]
				},
				{
					"id": 756620124,
					"content": "うまくいくといいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 756620123,
					"content": "任せて！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756620124
					]
				},
				{
					"id": 756620116,
					"content": "面白いかも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756620117
					]
				},
				{
					"id": 756620117,
					"content": "ほらほら、聞いたか？見る目も知識も考え方も、こいつのほうがお前よりすべてが上だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620118
					],
					"speakerTitle": "アハウ"
				},
				{
					"id": 756620118,
					"content": "まずはアハウ、お手本を見せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756620119
					]
				},
				{
					"id": 756620119,
					"content": "賛成だ。アハウは体が小さくて動きが早いから、魔物に殴られても、地面に投げつけられて穴ができてしまう、なんてことはないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620120
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 756620107,
					"content": "後回しでよさそうだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756620108
					]
				},
				{
					"id": 756620108,
					"content": "フン…偉大なる聖龍の味方をしたからって、礼なんか期待するなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620109
					],
					"speakerTitle": "アハウ"
				}
			]
		}
	]
}