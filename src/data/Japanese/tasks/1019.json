			},
			"dialogs": [
				{
					"id": 10190501,
					"content": "こんなところに秘境の入口があるなんて、不思議だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10190502,
					"content": "入口があんなら出口もあるはずだ。入ってみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190503
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190503,
					"content": "ふむ、本で読んだものと同じだ、周囲にあるのは古くから存在する璃月の岩石だろう。この秘境、恐らくかなり昔からあるようだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190504
					],
					"speakerTitle": "煙緋"
