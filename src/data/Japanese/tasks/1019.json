				},
				{
					"id": 10190507,
					"content": "……！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190508
					]
				},
				{
					"id": 10190508,
					"content": "おおっ！魈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190509
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10190509,
					"content": "降魔大聖？どうしてこんなところに？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190510
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10190510,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190511
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10190511,
					"content": "今しがた降りてきたところだ。轟音が聞こえたゆえ、確かめに来た。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190512
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10190512,
					"content": "うっかり落ちちゃったのか？なら、オイラたちと一緒に行動しないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190513
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10190513,
					"content": "遠慮する、我には他にすべきことがあるからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190514
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10190514,
					"content": "大事なことなの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190515
					]
				},
				{
					"id": 10190515,
					"content": "…人探しだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190516
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10190516,
					"content": "ここはお前たちが来るような場所ではない、早々に立ち去るがいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190517
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10190517,
					"content": "相変わらず風のように現れて、風のように去っていくな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190518
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10190518,
					"content": "さっきのあんちゃん、かなり気合い入ったやつだったな。この俺様と互角にやり合える手練れみてぇだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190519
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190519,
					"content": "牛使い野郎のくせに、その自信どっから来るんだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190520
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10190520,
					"content": "あの方を一人で行かせて、本当にいいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190521
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190521,
					"content": "あいつは一人で行動するのが好きなんだ。それに、人の話なんか聞かないしな…でも、すごいやつだから、放っておいても大丈夫だと思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190522
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10190522,
					"content": "みんな、気を引き締めてちょうだい。この先、何があるか分からないわ。周囲によく注意して、常に心構えをしておいて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190523
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10190523,
					"content": "お前らを仲間と認めはしたが…俺様にはずば抜けた才がある。こいつの注意も案内も俺様には必要ねぇ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190524
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190524,
					"content": "親分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190525
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190525,
					"content": "ああ——ちっ、分かった、分かったよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190526
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190526,
					"content": "オイラは夜蘭がいると、安心感が増すけどな。牛使い野郎、外国から来たんだから、みんなと仲良くしないとダメだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190527
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10190527,
					"content": "空飛ぶチビ助、お前はこの国のやつじゃねぇだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "荒瀧一斗"
				}
