			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"煙緋"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10190201,
					"content": "#ん？おや、{NICKNAME}とパイモン？まさか、こんなところで会うとは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190202
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10190202,
					"content": "どうして、煙緋がここにいるんだ？いつもは璃月港で仕事してるだろ。なんでまた、こんな人のいないところに？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10190203,
					"content": "ああ、実は今回、少し特殊な仕事を受けたんだ…だが、層岩巨淵の底がこんな風になっていたとはね。私もこの目で見るのは初めてだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190204
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10190204,
					"content": "ああっ！それよりも二人にお願いがあるんだ…何者かが私のことを探していてな。もし私のことを聞かれたら、見ていないと答えてくれないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190205
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10190205,
					"content": "え？なにがあったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190206,
						10190207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10190206,
					"content": "#煙緋、まさか{M#君}{F#あなた}…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190208
					]
				},
				{
					"id": 10190208,
					"content": "違うんだ、でも説明すると長くなる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190209
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10190209,
					"content": "とにかく、上手く誤魔化してくれ。じゃあ、またな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190210
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10190210,
					"content": "あっ、おい…煙緋のやつ、ホントに行っちゃったな…どうしよう、オイラなんだか急に怖くなってきたぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10190211,
					"content": "あいつ、法を破ってここまで逃げてきたんじゃないよな？まさか…なにか恐ろしい事件を起こしてたり…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10190212,
					"content": "煙緋は法律家だから、それはないと思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190213
					]
				},
				{
					"id": 10190213,
					"content": "考えが甘いぞ！世の中はな、すっごく複雑なんだ。最悪の事態を想定しておかないと、万が一なにかあったら、オイラたち煙緋の共犯者になっちゃうぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10190214,
					"content": "ああ、いや、ここは煙緋をかばってやるべきか、それとも…うぅ、悩ましい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190215
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10190215,
					"content": "パイモンは内心複雑だけど純粋だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190216
					]
				},
				{
					"id": 10190216,
					"content": "おい！そこのお前！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190217
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190217,
					"content": "あっ！ホントに誰か来たぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10190218,
					"content": "でもこの声、どこかで聞いたことあるような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190219
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10190219,
					"content": "ガーッハッハッ、まさか、こんなところでお前らに会えるとはな。なんだ、休暇でも満喫中か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190220
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190220,
					"content": "一斗だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190221
					]
				},
				{
					"id": 10190221,
					"content": "おっ！お前たち、その様子からして、相変わらず愉快に過ごしてるみてぇだな！俺様もだぜ、ガーッハッハッハ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190222
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190222,
					"content": "あれ、おまえの後ろにいる人って…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190223
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10190223,
					"content": "はじめまして、荒瀧派の久岐忍です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190224
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190224,
					"content": "へへへッ、忘れるところだったぜ。紹介してやる、こいつは俺ら荒瀧派の中でも一番のやり手、忍だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190225
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190225,
					"content": "おおっ！荒瀧派の人だったんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190226
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10190226,
					"content": "こいつは花見坂で活動する凄腕なんだぜ。荒瀧派に入んのも当然の流れだな。しかもだ、荒瀧派の厄介事はいつも忍がやってくれてる。なんなら、お前たちの面倒も忍が見てやってもいいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190227
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190227,
					"content": "#親分の友人ならば、私の友人でもある。{NICKNAME}にパイモン、二人とも会えて光栄だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190228
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190228,
					"content": "おお、いいやつだな！じゃあ、オイラも忍って呼んでいいか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190229
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10190229,
					"content": "忍、初めまして。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190230
					]
				},
				{
					"id": 10190230,
					"content": "ああ、今後ともよろしく頼む。実は…近いうちに、二人には世話になりそうな予感がするんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190231
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190231,
					"content": "でも一斗、さっき荒瀧派の厄介事は忍がやってくれてるって言ったよな？それなら、忍のほうが親分にふさわしくないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190232
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10190232,
					"content": "馬鹿なこと言うんじゃねぇ、パイモン。親分はこの俺様に決まってんだろ！天上天下花見坂荒瀧派の親分は、この俺様以外にありえねぇ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190233
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190233,
					"content": "なるほど、ダメ親分と凄腕の部下ってとこだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190234
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10190234,
					"content": "おい！ふん、まあいい、お前のその小さな脳みそじゃ、理解できないのも無理ないこと。ここは俺様が大人になってやる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190235
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190235,
					"content": "それよりも本題に入ろう。お前ら、桃色の髪をした法…なんとか家を見なかったか？物知りで、小柄で、変な帽子を被ってるやつなんだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190236
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190236,
					"content": "はわっ…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190237
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10190237,
					"content": "璃月の法律家で、名を煙緋という。二人なら知ってると思ったんだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190238
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190238,
					"content": "いや、見たことも会ったこともないぞ！知り合いだなんて、そんなことありえない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190239,
						10190240
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10190239,
					"content": "パイモン…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190241
					]
				},
				{
					"id": 10190241,
					"content": "ほう、会ったことあるみてぇだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190242
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190242,
					"content": "オイラ、な、なにも言ってないぞ！デタラメ言うなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190243
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10190243,
					"content": "ビクビクしてんのが見え見えだぜ。どうやら図星のようだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190244
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190244,
					"content": "嘘をつく時、人は無意識に目が泳ぐものだ、パイモン。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190245
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190245,
					"content": "だが安心してくれ、私たちに悪意はない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190246
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190246,
					"content": "おまえら、煙緋のことを知ってるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190247
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10190247,
					"content": "知ってるもなにも、そいつは俺様の命の恩人なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190248
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190248,
					"content": "命の恩人？あれ…そういえば、二人はなにしに層岩巨淵まで来たんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190249
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10190249,
					"content": "ごめん、パイモンって気付くのが遅いんだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190250
					]
				},
				{
					"id": 10190250,
					"content": "最近、稲妻の鎖国令が解除されたことは知ってるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190251
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190251,
					"content": "忍は卒業証書を取りに璃月に来たんだ。だが、一人で遠出するのは危険だろ？だから、俺もついてきたってわけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190252
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190252,
					"content": "卒業証書？璃月の学校にでも通ってたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190253
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10190253,
					"content": "ああ、璃月の同文学塾で法学を学んでいた。ただ残念ながら、卒業前に一度実家へ帰ったところ、ちょうど鎖国が始まってしまってな…それで卒業証書を貰うのが数年遅れてしまったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190254
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190254,
					"content": "璃月港で用事を済ませるため並んでいたところ、親分が千岩軍と揉めはじめてな。連行されそうになった親分を、通りがかった煙緋さんが助けてくれたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190255
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190255,
					"content": "あの恩人の助けがなけりゃあ、今頃は璃月の牢屋ん中だ。だから、その礼に彼女を手伝ってやりてぇんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190256
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190256,
					"content": "だが、手伝いは不要だと言われちまった。そんなことあり得ると思うか？生きてりゃあ、何かしら困ったことに遭遇するもんだろ。だから、彼女の後を追って、いざという時に助けてやろうと思ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190257,
						10190260
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190257,
					"content": "強引過ぎじゃない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190258
					]
				},
				{
					"id": 10190258,
					"content": "待て待て、俺様は本当に彼女を守ろうとしてるだけなんだ！何やら重要な仕事で急いでるみてぇだったからよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190259
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190259,
					"content": "この世で何か偉業を成し遂げるには、困難は避けて通れねぇ。そんくらいお前も分かんだろ？俺様は良かれと思ってしてんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190264
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190264,
					"content": "#{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190265
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190265,
					"content": "（忍がこちらに合図を送ってる？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190266
					]
				},
				{
					"id": 10190266,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190267
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190267,
					"content": "（一斗を煙緋から遠ざけようとしてる…？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190268
					]
				},
				{
					"id": 10190268,
					"content": "煙緋はあっちへ行った。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190269
					]
				},
				{
					"id": 10190269,
					"content": "おお、そうか、恩に着んぜ！んじゃ、俺たちは探しに行く！出発すんぞ、忍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190270
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190270,
					"content": "恩人さん、俺様が駆けつけるまで持ちこたえろよぉ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190271
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190271,
					"content": "ありがとう、じゃあまた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190272
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190272,
					"content": "さっき、わざと一斗に嘘ついただろ？たぶん、忍はおまえの言ったこと信じてなかったと思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190273
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10190273,
					"content": "それか、一斗があまりにしつこいから、煙緋に迷惑かけないように忍も配慮したのかも…あの忍ってやつ、なかなか切れモノだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190274
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10190274,
					"content": "これでもう煙緋を探すやつはいないはずだ。あとで本人に会ったら、このことを教えてやろうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190275
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10190275,
					"content": "よし。じゃあ、オイラたちは柱がぶつかったところに行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10190260,
					"content": "鬼も恩返しするの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190261
					]
				},
				{
					"id": 10190261,
					"content": "鬼婆婆が言ってたんだ、漢なら恩に報いるべきだってな。たとえ剣の山に登り、火の海に飛び込むことになろうとも、この荒瀧一斗、あの法律家を助けると心に固く決めたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190262
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190262,
					"content": "じゃあ、もし煙緋がおまえの助けを必要としてなかったら、どうするつもりなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190263
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10190263,
					"content": "そ…そんなこと…ハハッ、あり得ねぇな。絶対にあり得ねぇ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190264
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190240,
					"content": "さっきの「はわっ…！」は認めたも同然。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190241
					]
				},
				{
					"id": 10190207,
					"content": "法を破ってはいけない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190208
					]
				}
			]
		},
		{
			"id": 101903,
			"completionStepIds": [
				101903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101903",
							"2"
						],
						"stepId": 101903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"煙緋"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10190301,
					"content": "見ろよ、ちょうど煙緋がいるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10190302,
					"content": "煙緋、おまえの後をつけてたやつらは追っ払ってやったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10190303,
					"content": "なんと、さすがは旅人とパイモン。あの派手な見た目をした兄ちゃんだが、あまりに情熱的で困っていたんだ。普段なら友達になれたかもしれないが、あいにく今日は用事があってな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190304
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10190304,
					"content": "うーん…わざわざこんな変なところに来るなんて、いったいどんな用事なんだ？まさか、おまえも冒険者になりたいとか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10190305,
					"content": "私は法律家だ。たまに遠くへ出張することもある。今回、この層岩巨淵に来たのも、ある「遺言」のためだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190306
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10190306,
					"content": "遺言…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10190307,
					"content": "ああ。とある古書にあったのを見つけたんだ、昔の貴人が残したものだと思う。それによると、失った法宝を取り戻したいらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190308
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10190308,
					"content": "法律家ってそんな仕事もするのか、大変なんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10190309,
					"content": "遺言の内容を執行することも法律家の仕事のひとつだ。もちろん、このような依頼は多くない。それに、層岩巨淵もそう滅多に来られる場所ではない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190310
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10190310,
					"content": "あら？知っていたのね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190311
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10190311,
					"content": "うわっ！誰だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10190312,
					"content": "おっと、やはりここにいたか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190313
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10190313,
					"content": "名のある法律家が層岩巨淵にまでやって来て、私の意見を聞く必要なんてないと思うけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190314
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10190314,
					"content": "夜蘭がいるところで、私みたいなのが好き勝手出来るわけがないだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190315
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10190315,
					"content": "こ、こいつ、いったい何者なんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190316
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10190316,
					"content": "彼女は夜蘭、璃月の…ふむ、一応総務司に務めているってことでいいのか？とにかく、私の友人だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190317
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10190317,
					"content": "ええ、それで構わないわ。この辺りにはたまたま仕事で来ていたの。君たちとは、ちょっとした縁で結ばれたというわけね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190318
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10190318,
					"content": "君たちは私のことを知らないかもしれないけど、私は旅人とパイモンのことをいろいろと耳にしているわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190319
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10190319,
					"content": "その、璃月には友達がたくさんいるから…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190320
					]
				},
				{
					"id": 10190320,
					"content": "私の仕事は層岩巨淵を監察することよ。君たちがここで何かするなら、規則により私も同行させてもらう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190321
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10190321,
					"content": "ただ、今回は他にも仕事があるの。だから、残念だけど最後までは付き合えないかもしれない。くれぐれもトラブルを起こさないよう、慎重に行動してちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190322
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10190322,
					"content": "これは参ったな。頼みたいことがあったんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190323
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10190323,
					"content": "昔のよしみで、この遺言のために少し時間を割いてくれないだろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190324
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10190324,
					"content": "そのお願いを聞くからには、誠意を見せてもらわないとね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190325
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10190325,
					"content": "ああ、もちろんだとも。ガイドの依頼料はもちろんだが、たまたまピンばあやからいい茶葉をもらってね。よければ、お茶をご馳走させてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190326
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10190326,
					"content": "ふふっ、とりあえず、今回の目的を教えてくれるかしら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190327
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10190327,
					"content": "おい！お前ぇら！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190328
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190328,
					"content": "どうして、一斗がここに！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190329
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10190329,
					"content": "#クソッ、わざと違う方向を教えたな！{NICKNAME}、俺様の味方じゃなかったのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190330
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190330,
					"content": "だって二人とも友達だから…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190331
					]
				},
				{
					"id": 10190331,
					"content": "待ちなさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190332
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10190332,
					"content": "ん？誰だお前？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190333
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190333,
					"content": "悪いけど、ここ一帯は層岩という名の要地、部外者は立ち入り禁止なの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190334
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10190334,
					"content": "ふざけんな！警告も柵もねぇくせに入るなだと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190335
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190335,
					"content": "本当に危険な場所は、注意喚起するような掲示を行わないものよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190336
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10190336,
					"content": "ここって、そんな重要な場所だったのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190337
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10190337,
					"content": "確かに特殊な場所ではある…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190338
					]
				},
				{
					"id": 10190338,
					"content": "ああ、ここは気軽に出入りできる場所ではない。だからこそ、二人についてきてほしくなかったんだ。あれほど断ったというのに、無視されるとは残念だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190339
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10190339,
					"content": "璃月に対して数々の貢献をしてくれた旅人、璃月の法律家として名高い煙緋。私はこの二人の立場と行動を信頼しているから、ここでの活動を阻止しなかった。でも、君たちの場合…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190340
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10190340,
					"content": "あぁん、どういう意味だ？この俺様が有名じゃないと？それともなんだ、俺様が何か企んでるとでも思ってんのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190341
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190341,
					"content": "君の素性が不明だから、行動を制限させてもらうだけよ。それに、煙緋は君の助けを必要としているように見えないけど？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190342
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10190342,
					"content": "ハッ！そんなの、どうして分かんだよ？お前はこいつの母ちゃんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190343
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190343,
					"content": "そんなこと一目瞭然じゃないの。君のほうこそ、稲妻から璃月に来たからには、郷に従ってもらいたいものね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190344
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10190344,
					"content": "お前…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190345
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190345,
					"content": "落ち着いてくれ、親分。彼女の言い分は正しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190346
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190346,
					"content": "おいおい、ケンカになりそうだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190347
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10190347,
					"content": "なんとも面倒な…夜蘭とは正面からぶつかってはいけないというのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190348
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10190348,
					"content": "私たちはこの地の事情を知らなかったんだ。そこまで言うのなら、早々に離れよう。ただ、本当に危険な場所なら、警告文ぐらいは出したほうがいいと思うがな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190349
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190349,
					"content": "ご意見ありがとう、考えておくわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190350
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10190350,
					"content": "もし俺たちがここを離れないと言ったらどうする？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190351
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190351,
					"content": "親分！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190352
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190352,
					"content": "あらそう。じゃあ、不愉快なことが起きるかもしれないわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190353
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10190353,
					"content": "あぁ？俺たち二人相手に勝てると思ってんのか？いい度胸じゃねぇか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190354
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190354,
					"content": "旅人と煙緋の友達とはいえ、私の忠告は聞いたほうがいいわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190355
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10190355,
					"content": "ハハッ…面白れぇ、俺様は人に指図されんのが大嫌ぇでなぁ。そんなに自信あんなら、お手並み拝見といこうじゃねぇか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190356
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190356,
					"content": "待ってくれ、親分。ここで争う必要なんかないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190357
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190357,
					"content": "いや、こうなりゃ意地でも中に入ってやる。それを、こいつに何ができるってんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190358
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190358,
					"content": "ふんっ…この私がただのジョークを言っているとでも？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190359
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10190359,
					"content": "まずい、ホントにケンカするつもりだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190360
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10190360,
					"content": "ちょっと待った。事の発端は私にも原因がある、ここは私の顔を立てて…なっ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190361
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10190361,
					"content": "（地面が…揺れてる！？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190362
					]
				},
				{
					"id": 10190362,
					"content": "まずい、これは…あっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190363
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10190363,
					"content": "話を逸らすな！俺様は…くっ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "荒瀧一斗"
				}
			]
		},
		{
			"id": 101904,
			"completionStepIds": [
				101904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101904",
							"2"
						],
						"stepId": 101904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"煙緋"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10190401,
					"content": "いたたた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10190402,
					"content": "いったいなにが起きたんだ！おい、大丈夫か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190403,
						10190404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10190403,
					"content": "大丈夫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190405
					]
				},
				{
					"id": 10190405,
					"content": "くぅぅ…本を下敷きにしただけでは、衝撃を防げなかったか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190406
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10190406,
					"content": "これは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190407
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10190407,
					"content": "ど、どこなんだ、ここ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10190408,
					"content": "いっつつ…おい、みんな！大丈夫か！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190409
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190409,
					"content": "ふぅ…とんだ災難に見舞われたものだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190410
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190410,
					"content": "オイラたち、いったいどれくらい落ちてきたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190411
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10190411,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190412
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10190412,
					"content": "先ほどの口論中に地盤が崩れたようね。もしかしたら、元素力が作用して…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190413
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10190413,
					"content": "俺様のせいじゃねぇぞ。あんなひでぇ言われ方したら、誰だって腹立つだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190414
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190414,
					"content": "部外者の侵入を阻止する、それが私の仕事よ。責務を貫くのが酷いというのなら…君の心、いくらなんでも弱すぎるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190415
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10190415,
					"content": "てめぇ…俺様は屈するのが嫌いなだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190416
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190416,
					"content": "親分、口で勝てない相手に反論しても、意味ないと思うよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190417
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190417,
					"content": "忍、お前どっちの味方なんだよ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190418
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190418,
					"content": "事実を言ったまで。気持ちは分かるが、すぐに頭に血が上ってケンカばっかり…それで周りに迷惑をかけるのは、どうかと思うんだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190419
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190419,
					"content": "一斗のやつ、口では夜蘭に負けるし、忍にも叱られてる。完全に立場ないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190420
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10190420,
					"content": "#忍と一斗は{M#俺}{F#私}とパイモンみたいな関係だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190421
					]
				},
				{
					"id": 10190421,
					"content": "むかー、なんだとぉ！オイラと一斗を一緒にするなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190422
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10190422,
					"content": "おいおいおいおい、そりゃどういう意味だ？ケンカ売ってんのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190423
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190423,
					"content": "オ、オイラは事実を言っただけだぞ。一斗がバカだってことは常識だろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190424
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10190424,
					"content": "この俺様が…バカ、だと？じゃあ、お前なんか空飛ぶチビ助だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190425
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190425,
					"content": "空飛ぶチビ助！？このぉ…なら、オイラだってダサいあだ名をつけてやる…そうだな、おまえは牛使い野郎だ！ふん、今度から牛使い野郎って呼んでやる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190426
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10190426,
					"content": "私たちはだいぶ高いところから落ちたようだ。上の状況がまったく見えない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190427
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10190427,
					"content": "この高さ、直接登るのは不可能ね。他の道を探さないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190428
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10190428,
					"content": "みんな、お喋りに夢中なところ止めちゃって悪いけど、伝えておかなきゃいけないことがあるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190429
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10190429,
					"content": "「層岩巨淵」は璃月でも神秘に包まれた地で、数年前の採掘事故によって封鎖された場所。ここでは「見ない」、「聞かない」、「質問しない」を守って行動してくれるかしら。知らないほうがいいことも、あるものなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190430
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10190430,
					"content": "原則として、私は皆を敵に回すようなことはしない。どうか君たちも、守秘義務がある私を困らせないでほしい。もちろん、出口を探すため、私も尽力するわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190431
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10190431,
					"content": "は？なんであいつ行っちまったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190432
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190432,
					"content": "きっと出口を探しに行ったんだろう。夜蘭は私たちの中でも、もっとも危機的状況の対処に長けた人物だ。ここは黙って行かせよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190433
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10190433,
					"content": "基本的に遺言の内容を関係者以外に公開することはできない。だから、本当のことを二人には伝えられなかったんだ…すまない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190434
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10190434,
					"content": "私は遺言に書かれていた太威儀盤を手に入れるため、この層岩巨淵にやってきた。その法宝は何年も前に、いずれ必要な場所で役立つようにと、私の依頼主が志士に渡したものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190435
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10190435,
					"content": "そして目撃者によると、その法宝を受け取った男は層岩巨淵へ向かった後、行方不明になったという。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190436
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10190436,
					"content": "層岩巨淵は歴史上、数多くの戦争が起きた場所だ。たとえその者が争いの中で亡くなっていたとしても、私は法宝を取り戻すのに最善を尽くしたい…依頼主の願いを叶えるためにもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190437
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10190437,
					"content": "さっき夜蘭が話したこともすべて事実だ。層岩巨淵には危険が潜んでいる…お前たちも身をもって体感しただろう。今はこんな状況なんだ、力を合わせて突破口を探すしかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190438
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10190438,
					"content": "恩人がそう言うんなら…まあ、ここは顔を立ててやってもいい。こっからは全員仲間だ。一応、あいつも…仲間として見てやる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190439
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190439,
					"content": "夜蘭って総務司で働いてるんだよな？なんだか、妙にすごそうな人だったけど…総務司の仕事って、ああいった能力まで必要なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190440
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10190440,
					"content": "まあ、世間一般には総務司で務めているといって間違いない…彼女の身分については、あまり多くを明かせないんだ。ただ、この仕事は彼女にしかできないってことは確かだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190441
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10190441,
					"content": "いったいどんな仕事なんだよ。こんなシケた場所で働かないといけねぇなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190442
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190442,
					"content": "オイラ、知ってるぞ！冒険者だろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190443
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10190443,
					"content": "？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190444
					]
				},
				{
					"id": 10190444,
					"content": "なんだよ、その顔。オイラたちも同じような感じだし、間違ってないと思うぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190445
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10190445,
					"content": "#冒険者は{M#俺}{F#私}で、パイモンじゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190446
					]
				},
				{
					"id": 10190446,
					"content": "おまえ、なんだか最近ケチになったな。肩書きぐらい借りたっていいだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190447
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10190447,
					"content": "#そうだぞ、{NICKNAME}。お前はパイモンの親分だろ。親分なら親分らしく、子分を可愛がってやらねぇと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190448
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190448,
					"content": "オイラたちは、そんな関係じゃないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190449
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10190449,
					"content": "パイモン、親分の突拍子もない発言は気にしないでくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190450
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190450,
					"content": "ふん、忍がそう言うなら…許してやる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190451
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10190451,
					"content": "おい…はぁ、親分はこの俺様だぞ。俺が譲歩してやったんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190452
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190452,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190453
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10190453,
					"content": "まさか、ここは記録にないもう一か所の封印の内側なのかしら……いったい、ここには何が……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190454
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10190454,
					"content": "食料と水は持ってきている、もし必要なら言ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190455
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190455,
					"content": "おお、さすがだぜ！牛使い野郎は賢くないけど、おまえの部下は頼もしいな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190456
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10190456,
					"content": "ガーッハッハッハッ、俺様もそう……って、んだと！俺様だって賢いっつーの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190457
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190457,
					"content": "前方に何やら入口があるようね、奥に道が続いているみたいだわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190458
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10190458,
					"content": "どこに繋がってるんだろう？行ってみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10190404,
					"content": "ここまで…落ちてきたみたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190405
					]
				}
			]
