						100030902
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 100030902,
					"content": "襲われてる仙霊がいるぞ！でも、なんだか怪しいな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030903
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100030903,
					"content": "それに、この仙霊からも、あの不思議な引力を感じます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030904
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 100030904,
					"content": "ならば、運命はすでに進むべき道を示している。",
