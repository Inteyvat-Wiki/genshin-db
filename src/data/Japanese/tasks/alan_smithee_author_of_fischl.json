			},
			"dialogs": [
				{
					"id": 100030801,
					"content": "ここ、本当に土を掘り返した跡があるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030802
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100030802,
					"content": "うう、常九のやつ、まさか熱狂的なファンに埋められてたりしないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030803
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100030803,
					"content": "旅人、やっぱり千岩軍を呼んで調べてもらおうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030804
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100030804,
					"content": "皆さん、ご安心ください。最も熱狂的なファンは、ここにおられます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030805
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 100030805,
					"content": "お嬢様は誰かを傷つけるようなことはしません。であれば、それほど熱心ではない他のファンが、彼に手を出すということはないでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030806
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 100030806,
					"content": "それじゃあ、始めよう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100030807
					]
				},
				{
					"id": 100030807,
					"content": "地面の緩んだ箇所を掘り起こした。\\n大量のモラと北国銀行の小切手を見つけた…\\n\\n突然後ろから叱責の声が聞こえ、思わず手に持っていたものをポケットに入れてしまった。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						100030808
					]
				},
				{
					"id": 100030808,
					"content": "君たち、何してるんだ！千岩軍を呼ぶぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030809
					],
					"speakerTitle": "常九"
				},
				{
					"id": 100030809,
					"content": "わぁ！常九、生きてたのか！それに誘拐もされてない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030810
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100030810,
					"content": "なにを不吉なことを…よく見たら、前に古華派の少年とここに来た人じゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030811
					],
					"speakerTitle": "常九"
				},
				{
					"id": 100030811,
					"content": "どうやら、誤解みたいだな。君たち、うちの庭を掘り返して何をしてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030812
					],
					"speakerTitle": "常九"
				},
				{
					"id": 100030812,
					"content": "実は、聞きたいことがあって…「九先生」ってペンネーム、使ったことないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030813
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100030813,
					"content": "たとえ幻覚を見せられたとしても、自分が九先生だなんて考えることはない。もしわしが九先生なら、どうして何年も小説コンクールに投稿し続けてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030814
					],
					"speakerTitle": "常九"
				},
				{
					"id": 100030814,
					"content": "敢えて凡才のふりをしていたのか？だったら、長年落選し続けてるわしは、自分で自分を笑い者にしていることになるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030815
					],
					"speakerTitle": "常九"
				},
				{
					"id": 100030815,
					"content": "わしはよく「主人公が英雄の少年なんて時代遅れだ。冒頭でのどんでん返しや、弱いふりをして強敵を倒す展開すらもう古い」と批判されるんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030816
					],
					"speakerTitle": "常九"
				},
				{
					"id": 100030816,
					"content": "「…今の読者は九先生が書いてるような、奇抜で独創的な世界観や設定が好きなんだ」とね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030817
					],
					"speakerTitle": "常九"
				},
				{
					"id": 100030817,
					"content": "まあ、そうだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030818
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100030818,
					"content": "わしが本当に九先生なら、『古華派の兄弟子』が受賞した年、すぐに自分が九先生だと公表していただろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030819
					],
					"speakerTitle": "常九"
				},
				{
					"id": 100030819,
					"content": "「何だって、常九が九先生？間違いじゃないのか？常九はただの負け組のはずだ」——はぁ、そんな展開になったら、さぞかし痛快だろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030820
					],
					"speakerTitle": "常九"
				},
				{
					"id": 100030820,
					"content": "おまえの家には『神霄折戟録』があったよな。行秋とオイラたちの前で、あの作品をべた褒めしてたけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030821
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100030821,
					"content": "もし常九が九先生なら、とんでもない自画自賛だ。「ジン団長が自分を褒めまくる」ようなもんだぞ。そう考えると、確かにおかしいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030822
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100030822,
					"content": "皆さん、確かに常九さんは九先生ではありません。しかし、私は彼からも何か不思議なものを感じます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030823
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 100030823,
					"content": "お嬢様や例の原稿と同じような「縁」を…謎の気配を感じるのです。私には、九先生に関する物事を追跡する力があるのかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030824
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 100030824,
					"content": "そういうことなら、話は早いな！ナド・クライに着いたら、オズに案内してもらえばいいんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030825
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100030825,
					"content": "そういえば、常九はさっきまでどこに行ってたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030826
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100030826,
					"content": "原稿用紙がなくなったから、買いに行ってただけだ。私はこだわりがある人間でね。仕事として執筆活動をする以上、やはり良質な紙を使いたいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030827
					],
					"speakerTitle": "常九"
				},
				{
					"id": 100030827,
					"content": "確かに、あの原稿用紙と同じです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030828
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 100030828,
					"content": "なら、これで一歩前進だ！常九、ありがとな！さっそく次に向かおうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030829
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100030829,
					"content": "何の役に立ったのかは知らないが、礼には及ばんよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030830
					],
					"speakerTitle": "常九"
				},
				{
					"id": 100030830,
					"content": "さらば、かの世界の創造者よ。汝が定めし法則と物語は、幽夜浄土に積もる夢の塵泥には到底及ぶまい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030831
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 100030831,
					"content": "お嬢様によると、あなたの作品は…いえ、なんでもありません。お嬢様は「ありがとうございました、さようなら」とおっしゃっています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "オズ"
				}
			]
		},
