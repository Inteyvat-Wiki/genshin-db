			"dialogs": [
				{
					"id": 100030501,
					"content": "これも変わったところはなさそうだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100030502,
					"content": "いえ。皇女たるわたくしは、すでに塵の中に潜む宇宙の秘奥を見抜いているわ。それが示すものは、まさに真実へと湧き出る知恵の泉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030503
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 100030503,
					"content": "「それが手がかりだと思う」とお嬢様はおっしゃっています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "オズ"
				}
			]
		},
