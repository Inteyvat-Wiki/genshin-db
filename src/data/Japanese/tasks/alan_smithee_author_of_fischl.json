			},
			"dialogs": [
				{
					"id": 100030101,
					"content": "星と深淵を目指せ。こんにちは、旅人さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030102
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 100030102,
					"content": "よう、キャサリン！オズとフィッシュルもいたのか、奇遇だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100030103,
					"content": "宇宙の万物はやがて幽夜に沈み、光を求める者たちは黎明の地で巡り会うであろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030104
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 100030104,
					"content": "「確かに奇遇だね、こんにちは」という意味です。それでは私からもご挨拶を——お二人とも、こんにちは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030105
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 100030105,
					"content": "ちょうど最近、八重堂から旅人さん指名で依頼がありました。依頼の詳細な打ち合わせをするため、担当の編集者さんが派遣されております。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030106
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 100030106,
					"content": "商業上の機密に関わるため、依頼の詳細な内容は、協会にも伝えることができないようです。ただ、『神霄折戟録』の作者に関する依頼…ということは伺っています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030107
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 100030107,
					"content": "えっ？それって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030108
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 100030108,
					"content": "コホンッ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030109
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 100030109,
					"content": "その作者って、そんなに重要人物なのか？もしオイラたちが最近不在だったり、面倒だからって依頼を断ったりしたら、編集者は無駄足になっちゃうだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100030110,
					"content": "これを「一言伝えるだけで終わる楽な出張」と考えると、争奪戦だったのではないでしょうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030111
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 100030111,
					"content": "もしこの依頼をお受けになるようでしたら、鹿狩りで編集者さんを探してみてください。稲妻出身の方なので、すぐに分かると思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030112
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 100030112,
					"content": "待っ…いい、旅人？焦ることはないわ。運命があなたを世界の奔流へ押し流すのは、荒廃に直面させるためではない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030113
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 100030113,
					"content": "むしろ、幽夜浄土へ導くためなの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030114
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 100030114,
					"content": "「手伝わせて欲しい」とお嬢様はおっしゃっています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030115
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 100030115,
					"content": "フィッシュル、急にやる気になったな！なにか裏があるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100030116,
					"content": "別にいいじゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100030117
					]
				},
				{
					"id": 100030117,
					"content": "では、皆さんお揃いのうちに鹿狩りへ行って、編集者の方を探してみましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "オズ"
				}
			]
		},
