				]
			},
			"dialogs": [
				{
					"id": 100030201,
					"content": "経費でモンドまで旅行に来た幸運な人は——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100030202,
					"content": "行——いや！枕玉先生の担当編集、小野寺だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100030203,
					"content": "旅人さん、あの時はお世話になりました。今回も八重様の依頼をお聞きになったうえで、またお力を貸していただけたらと思います…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030204
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 100030204,
					"content": "そちらにいらっしゃる、フィッシュル皇女の衣装をまとった方は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030205
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 100030205,
					"content": "我は断罪の皇女フィッシュル。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030206
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 100030206,
					"content": "「フィッシュルです、はじめまして」とお嬢様はおっしゃっています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030207
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 100030207,
					"content": "えっと、こいつはフィッシュル。手伝いに来てくれた、オイラたちの友達だ。すっごく頼りになる冒険者なんだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100030208,
					"content": "そう、彼女はフィッシュル。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100030209
					]
				},
				{
					"id": 100030209,
					"content": "な、なるほど…フィッシュルさんですか。四回も紹介する必要はないと思いますが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030210
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 100030210,
					"content": "我の名を知ったのであれば、当然理解すべきであろう——我が名を称することは、贖罪である。ゆえに、我が名を称えることは、救済の祈りであると。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030211
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 100030211,
					"content": "お嬢様は——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030212
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 100030212,
					"content": "なるほど、そういうことでしたか。名前を覚えるのは、確かに基本的な礼儀ですね。問題を解決できるなら、一万回だってお呼びしますよ。今回はご協力くださり、ありがとうございます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030213
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 100030213,
					"content": "オズが通訳する前に、フィッシュルの言ってることを理解した！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100030214,
					"content": "編集者を見くびらないほうがいいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100030215
					]
				},
				{
					"id": 100030215,
					"content": "では、早速今回の依頼について詳しくご説明しましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030216
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 100030216,
					"content": "『神霄折戟録』の作者、九先生のことはご存じですよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030217
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 100030217,
					"content": "フィッシュル…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030218
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 100030218,
					"content": "お嬢様、今なんとおっしゃいましたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030219
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 100030219,
					"content": "九先生の代表作は『フィッシュル皇女物語』よ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030220
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 100030220,
					"content": "コホンッ、お嬢様は「もし創造主が冷酷さしか持ち合わせていないとしても、幽夜浄土と皇女は、かの者に涙を流させるほどの存在であるはずだ」とおっしゃっています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030221
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 100030221,
					"content": "分かりました。その『フィッシュル皇女物語』の作者である九先生ですが、最近ナド・クライから助けを求める手紙を送ってきました。どうやら先生の状況はあまり良くないようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030222
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 100030222,
					"content": "それなら、簡単に解決するんじゃないか？あっちの協会や傭兵に探してもらえばいいだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030223
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100030223,
					"content": "そこが最大の問題なんです。九先生がどんな顔をしているのか、年齢はいくつなのか、太っているのか痩せているのか、どこの国の人なのか——何一つ分からないんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030224
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 100030224,
					"content": "彼はずっと手紙で八重堂と連絡を取っており、宛先は大陸全土に点在しています。他の作家との交流会や現地イベントに顔を出したこともありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030225
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 100030225,
					"content": "そんな依頼、どうやってやればいいんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030226
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100030226,
					"content": "ですから、九先生が一体どこの誰なのかを調べることも、この依頼の重要な一部なんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030227
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 100030227,
					"content": "私たちも自力で調査を行ったのですが、その結果、九先生は『神霄折戟録』完結以降、文字の書き方が以前と変わっていることが分かりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030228
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 100030228,
					"content": "最初に九先生を担当していた編集者は、自分で小説を書くため既に退職しており、九先生に関する新たな情報は得られませんでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030229
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 100030229,
					"content": "たとえ失われようと、万物は断罪の皇女の記憶に留まり、幽夜浄土で永遠に残り続ける。原初の神聖なる言葉から、すべての因果が湧き出ることだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030230
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 100030230,
					"content": "お嬢様は——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030231
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 100030231,
					"content": "そうなんです、同じことを考えていたようですね。そこで私たちは、最初期の『神霄折戟録』の原稿を見つけ出したんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030232
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 100030232,
					"content": "うわぁ！これ、行——枕玉先生が見たら、興奮しすぎて気絶しちゃうんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030233
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100030233,
					"content": "いや、ていうかまた小野寺が、オズより先にフィッシュルの言葉を理解したぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030234
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100030234,
					"content": "編集さんって、不思議でしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100030235
					]
				},
				{
					"id": 100030235,
					"content": "これは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030236
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 100030236,
					"content": "オズヴァルド・ヘンリ・ラフナヴィネスよ、何か気づいたことはない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030251
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 100030251,
					"content": "「ヘンリ」は余計ですよ、お嬢様。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030237
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 100030237,
					"content": "かすかではありますが、確かに何か感じます。お嬢様の身に宿る…磁場、引力、因果の糸——そういったものに近しい気配です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030238
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 100030238,
					"content": "最終的に私たちが突き止められたことは、ひとつだけ——投稿された原稿用紙は、地模様と製法からして璃月産、おそらく軽策荘のものではないかということです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030239
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 100030239,
					"content": "えっ、じゃあ、九先生って璃月の人なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030240
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100030240,
					"content": "ていうか、軽策荘で小説を書くっていったら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030241
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100030241,
					"content": "…常九？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100030242
					]
				},
				{
					"id": 100030242,
					"content": "さすがにないんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030243
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100030243,
					"content": "常九さんですか？『古華派の兄弟子』も新人賞を受賞した作品ですね。私も知っています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030244
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 100030244,
					"content": "構わない。「涙を零す聖徒」と「贖罪の聖徒」は、行う道義こそ違えど、その力の源は同じなのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030245
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 100030245,
					"content": "小野寺様、どうぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030246
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 100030246,
					"content": "オズ、小野寺を信頼してるのはわかってるけど、オイラたちのことも考えてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030247
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100030247,
					"content": "そうですね。同一人物でなかったとしても、同じ作家同士、何かしら交流があるかもしれません。まずは彼に話を聞いてみてもいいでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030248
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 100030248,
					"content": "編集さんって、すごいでしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100030249
					]
				},
				{
					"id": 100030249,
					"content": "うぅ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030250
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100030250,
					"content": "それでは、よろしくお願いします！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030251
					],
					"speakerTitle": "小野寺"
				}
			]
		},
