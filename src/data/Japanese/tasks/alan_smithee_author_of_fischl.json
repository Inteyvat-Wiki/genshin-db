				{
					"id": 100030701,
					"content": "もし自分が九先生だったら…？まあ、創作の発想を広げる方法としては悪くないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030702
					],
					"speakerTitle": "常九"
				},
				{
					"id": 100030702,
					"content": "よし、では想像してみよう。もし自分が九先生なら、どう書くだろうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "常九"
				}
			]
		},
