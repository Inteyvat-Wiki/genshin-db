			"dialogs": [
				{
					"id": 100031201,
					"content": "どうしてあなたたちが？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031202
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 100031202,
					"content": "この声、ニコだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100031203,
					"content": "聞きたいのは、オイラたちのほうだぞ。九先生を探して璃月からここまで来たのに、なんでおまえがいるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100031204,
					"content": "ニコと仙霊に、八重堂からの依頼、そしてこれまでの調査について話した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						100031205
					]
				},
				{
					"id": 100031205,
					"content": "そうだったのね。九先生はこの子よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031206
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 100031206,
					"content": "こんにちは！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031207
					],
					"speakerTitle": "九先生"
				},
				{
					"id": 100031207,
					"content": "こ、これは何という異常な「黄昏」…！億万の幽夜ですら、このようなことは聞いたことがないわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031208
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 100031208,
					"content": "なんというか…実はあたしも小説家になりたかったの。でも、直接人の頭の中に語り掛けるほうが、口で伝えるよりもずっと楽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031209
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 100031209,
					"content": "文字を書くなんて、あたしからするとさらに面倒なの。これは理解できるでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031210
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 100031210,
					"content": "誰かに書きたい設定やストーリーを思うがままに話して、小説を書いたことにしてもいいけれど、実際そうしてしまうと、なんだかもったいなく感じるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031211
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 100031211,
					"content": "だから仙霊の知り合いに、設定とアイデアをすべて話した。そして、小説家になりたい人を探してもらって、代わりに書いてもらうことにしたのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031212
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 100031212,
					"content": "リアリティを出すために、すごく現実味のある設定も作った。例えば、薄毛とかね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031213
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 100031213,
					"content": "わたしがその被害者なの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031214
					],
					"speakerTitle": "九先生"
				},
				{
					"id": 100031214,
					"content": "そう言わないで。あの小説家見習いたちの言語能力を使って鍛えたおかげで、会話能力が回復してきたじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031215
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 100031215,
					"content": "天の使いっていうのは、人の頭に現れるインスピレーションのこと。いってみれば、昔の仕事をまた始めたようなものね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031216
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 100031216,
					"content": "それって、本当に大丈夫なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031217
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100031217,
					"content": "大丈夫よ。原稿はすべて、人が眠っている間に九先生が憑依して書いたものだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031218
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 100031218,
					"content": "世界を創りたいという夢さえあれば、自然と…自動的に浮かび上がってくる作家の人格よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031219
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 100031219,
					"content": "「自動的なんだよ。」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100031220
					]
				},
				{
					"id": 100031220,
					"content": "ちょっと待った！じゃあ、助けを求める手紙とか、オズが感じた不思議な感覚はなんだったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031221
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100031221,
					"content": "わたし、ニコに捕まってナド・クライの監視役にされちゃったの。すごく危ないんだよ。今のわたしにはもう、天空の膨大な知識も力もないんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031222
					],
					"speakerTitle": "九先生"
				},
				{
					"id": 100031222,
					"content": "その子が生まれた経緯についてだけど…小説ってリアリティを出すために、嘘と真実が入り混じった細かい設定をたくさん入れるでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031223
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 100031223,
					"content": "言われてみれば、稲妻の娯楽小説に、実在するおまじないを取り入れてるやつがあったな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031224
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100031224,
					"content": "九先生の物語設定は隠喩が多くて、その中にある生命を生み出す方法も、完全な嘘とまでは言えないの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031225
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 100031225,
					"content": "でも、まさか本当に成功する子がいるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031226
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 100031226,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031227
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 100031227,
					"content": "お嬢様はもう呆然としていらっしゃいますね。僭越ながら、私から確認させてください——お嬢様は、小説内の嘘と真実が入り混じった方法を使って、私を創り出したということですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031228
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 100031228,
					"content": "嘘が七割、真実が三割ってところね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031229
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 100031229,
					"content": "嘘が九割、真実が一割だよ。とっても危ないから、書き直したの。やっぱりわたしが書いた本、読んでないんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031230
					],
					"speakerTitle": "九先生"
				},
				{
					"id": 100031230,
					"content": "オズはあんまり驚いてないみたいだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031231
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100031231,
					"content": "なんと言いますか…生まれた時から、ぼんやりと気づいていたのかもしれません。お嬢様にお仕えできて、私は光栄です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031232
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 100031232,
					"content": "とにかく、ナド・クライの件が片付けば、九先生は晴れて戻ることができるから、そう伝えておいて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031233
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 100031233,
					"content": "ここであなたの目になるなんてイヤ！危なすぎるもん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031234
					],
					"speakerTitle": "九先生"
				},
				{
					"id": 100031234,
					"content": "あ、そうだ。軽策荘のおじさんに、原稿料と印税はおじさん9割、私1割で分けてあるって伝えてくれる？あと、ここ数年分の報酬は、庭に埋めてあるよって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031235
					],
					"speakerTitle": "九先生"
				},
				{
					"id": 100031235,
					"content": "おまえはお金をもらってどうするんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031236
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100031236,
					"content": "それを財宝として隠して、みんなをそこまで導いてあげるの。わたしたちは生まれつき人を導くのが好きで、それがなにより楽しいんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031237
					],
					"speakerTitle": "九先生"
				},
				{
					"id": 100031237,
					"content": "わたしの宝物を探しに来てね。幽夜浄土の果てに埋めておいたから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031238
					],
					"speakerTitle": "九先生"
				},
				{
					"id": 100031238,
					"content": "絶対に行きます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031239
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 100031239,
					"content": "お嬢様？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031240
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 100031240,
					"content": "あの、九先生の小説、大好きです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031241
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 100031241,
					"content": "「たとえ宇宙が漆黒で果てしなく広がっていようと、やがてすべてのものが光を放つ影を落とす」とお嬢様はおっしゃっています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031242
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 100031242,
					"content": "わたし、とっても嬉しい。あなたはもう、一番の宝物を見つけられたみたいだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031243
					],
					"speakerTitle": "九先生"
				},
				{
					"id": 100031243,
					"content": "なら、この件はひとまずこれで終わりにしましょう。あたしはこれから九先生と一戦交えて、真の作者は誰なのか決めることにするわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031244
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 100031244,
					"content": "常九じゃないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100031245
					]
				},
				{
					"id": 100031245,
					"content": "絶対にありえない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031246
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 100031246,
					"content": "一行は別れを告げ、帰路についた。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		}
	]
}