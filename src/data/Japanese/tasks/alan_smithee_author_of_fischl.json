					"content": "常九はいないみたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100030402,
					"content": "どうやら、すぐには会えなさそうですな。ここでしばらく待ちますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030403
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 100030403,
					"content": "そうするしかなさそうだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100030404,
					"content": "しかし、ここにいないとなると…本当に彼が、ナド・クライに連れ去られた九先生の可能性があります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030405
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 100030405,
					"content": "家を調べてみますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030406
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 100030406,
					"content": "勝手に人の家を調べるのは気が引けるけど、もし常九が本当に九先生だったら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
