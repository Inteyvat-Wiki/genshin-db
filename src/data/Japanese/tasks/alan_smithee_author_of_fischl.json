				{
					"id": 100030301,
					"content": "九先生って、ほかになにか特徴とかないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100030302,
					"content": "読者からの質問に対する回答や、巻末の「あとがき」によると、彼は生え際が後退気味で、少しビール腹、甘いものはあまり好まず、心臓は右側にあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030303
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 100030303,
					"content": "左だったかな…いや、右側です。それから、左手には五本の指があり、ひどい不眠症で、目にはそれぞれ一つずつ瞳があります…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030304
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 100030304,
					"content": "ぜんぜん特徴がないな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
