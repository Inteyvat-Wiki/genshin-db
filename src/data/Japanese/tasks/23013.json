			},
			"dialogs": [
				{
					"id": 230131101,
					"content": "ガルシア先生、もう一度言いますよ。資金を調達するために、本をいくらか売るべきです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131102
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230131102,
					"content": "いかん！絶対にいかん！親愛なる路通くん、君は俺に、俺の魂を売れと言うのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131103
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230131103,
					"content": "しかし先生…問題はですね、誰も魂に値段をつけてはくれないということなのですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131104,
						230131105
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230131104,
					"content": "どうしてまだここに？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230131106
					]
				},
				{
					"id": 230131106,
					"content": "旅人くん？どうして君もここに？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131107
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230131107,
					"content": "いやあ…前回の実験は失敗してしまったんだ。スライムの液体の希釈方法に問題があってね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131108
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230131108,
					"content": "できあがった潤滑剤は「ナンバリングマシン」のベアリングを滑らかにするどころか、かえって詰まりやすくしてしまったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131109
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230131109,
					"content": "だから、もっとスライムの液体の実験をする必要があるのだよ。そこで君…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131110,
						230131111
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230131110,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230131120
					]
				},
				{
					"id": 230131120,
					"content": "どうか、スライムの液体の方をお願いします、旅人さん。報酬は用意しますので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "路通"
				},
				{
					"id": 230131111,
					"content": "お金を稼ぐ方法はないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230131112
					]
				},
				{
					"id": 230131112,
					"content": "方法がないわけではないんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131113
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230131113,
					"content": "方法というよりは、才能がないのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131114
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230131114,
					"content": "補足してくれてありがとう、路通くん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131115
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230131115,
					"content": "ああ、恥ずかしい限りだ…「ナンバリングマシン」を完成させたなどと言ってみても、その機能はいたってシンプルなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131116
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230131116,
					"content": "なんと言ったらいいか…その「演算」ですら完全に自動ではなく、たくさんの補助作業を手動でする必要があるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131117
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230131117,
					"content": "しかし…必ず完成させてみせるぞ！俺は「ナンバリングマシン」が偉大な発明であることを信じている！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131118
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230131118,
					"content": "これは…これは旧時代から新時代への幕開けを告げる発明なんだ！そして、きっと金を稼ぐ方法も見つけてみせる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131119
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230131119,
					"content": "しかし、その前にだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131120
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230131105,
					"content": "まだスライムの液体が必要なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230131106
					]
				}
			]
		},
