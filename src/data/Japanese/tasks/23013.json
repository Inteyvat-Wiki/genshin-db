			},
			"dialogs": [
				{
					"id": 230130201,
					"content": "路通くん、我々の資金は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130202
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230130202,
					"content": "なんとかやっていけますよ、ガルシア先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130203
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230130203,
					"content": "璃月人には「山へ向かう車の前には、必ず道が開く」ということわざがあります。我々の今の状況にぴったりだと思いますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130204
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230130204,
					"content": "たとえ道の先に大きな山が立ちふさがっていても、必ず乗り越える方法は見つかるという意味です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130205
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230130205,
					"content": "ははは、とても巧みな例えだな。我々の境遇もまだマシに思えてくる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130206
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230130206,
					"content": "しかしガルシア先生。この言葉を残した人は、果たして山を越える方法を見つけられたんでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130207
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230130207,
					"content": "え？そんな、縁起でもない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ガルシア"
				}
			]
		},
		{
			"id": 2301303,
			"completionStepIds": [
				2301303
			],
