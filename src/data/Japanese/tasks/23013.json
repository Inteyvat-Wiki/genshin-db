			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ガルシア"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230130301,
					"content": "旅人くん、スライムの液体は取ってきてくれたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130302
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230130302,
					"content": "取ってきたよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230130303
					]
				},
				{
					"id": 230130303,
					"content": "素晴らしい！これだけあれば十分だ。早速帰って実験を始めよう。この潤滑剤があれば、俺の「ナンバリングマシン」もきっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130304
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230130304,
					"content": "俺は研究をはじめる。路通くん、後のことは君に任せたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130305
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230130305,
					"content": "はい、先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130306
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230130306,
					"content": "こちらが報酬です。旅人さん、本当にありがとうございました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130307
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230130307,
					"content": "ええと…拙い私見ではありますが、後々またあなたの助けが必要になるかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130308
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230130308,
					"content": "ですがご安心ください。僕が帳簿を管理しておきさえすれば、必ずそれに見合った報酬はお渡しできるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130309
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230130309,
					"content": "…ああ、僕がガルシア先生と一緒に旅に出たのは、両親のように一生を璃月の総務司で帳簿の整理に捧げたくなかったからです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130310
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230130310,
					"content": "しかし今は…ガルシア先生と一緒に計算の作業をする時以外は、やはり帳簿の整理に明け暮れています…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130311
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230130311,
					"content": "これがいわゆる、「運命の然らしむるところ」というやつなんでしょうね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "路通"
				}
			]
		},
