			"dialogs": [
				{
					"id": 230135001,
					"content": "どうやらここが我々の探している場所のようです。あとは人を雇えば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135002
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230135002,
					"content": "ガルシア先生？僕の話を聞いてますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135003
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230135003,
					"content": "ん？あぁ…もちろん、聞いているよ。帰って人を雇おう、時間はかかるまい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135004
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230135004,
					"content": "大丈夫？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230135005
					]
				},
				{
					"id": 230135005,
					"content": "旅人くん！はははっ…大丈夫だ、もちろん大丈夫だぞ。どうしてそんなことを聞くのだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135006
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230135006,
					"content": "今は「ナンバリングマシン」の研究に全身全霊を傾けている。成功まであと一歩のところにいると、俺は感じているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135007
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230135007,
					"content": "もし良ければ、スライムの液体を少し取ってくれるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135008
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230135008,
					"content": "君がここにいるから、わざわざ城に戻って人を雇う必要もない。ちょうど少し儲けたから、報酬をあげられるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135009,
						230135010
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230135009,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230135011
					]
				},
				{
					"id": 230135011,
					"content": "それじゃ旅人くん、任せたぞ。俺は装置の構造をどう変えるか、考えなければ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230135010,
					"content": "いいけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230135011
					]
				}
			]
		},
