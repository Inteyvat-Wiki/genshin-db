			},
			"dialogs": [
				{
					"id": 230130101,
					"content": "親愛なる路通くん、ほ…本当にここで合っているのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130102
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230130102,
					"content": "間違いありません、ガルシア先生。ここがスライムが最もよく出現する場所です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130103
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230130103,
					"content": "スライムが集まる場所であることに疑いはない。問題なのは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130104
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230130104,
					"content": "…スライムが、いささか多すぎないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130105
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230130105,
					"content": "ガルシア先生、これが我々の資金不足が招いた結果ですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130106,
						230130107
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230130106,
					"content": "#{M#君}{F#あなた}は…ガルシアさん？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230130108
					]
				},
				{
					"id": 230130108,
					"content": "旅人くん！偶然だな。君もスメールに来ていたのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130109
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230130109,
					"content": "ここで何を？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230130110
					]
				},
				{
					"id": 230130110,
					"content": "ははは、俺がここにいる訳はだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130111
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230130111,
					"content": "自業自得です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130112
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230130112,
					"content": "「勇敢に挑んだ結果」だ。路通くん、君はもうちょっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130113
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230130113,
					"content": "お望みのままに、先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130114
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230130114,
					"content": "本題に戻ろう。ここに来たのは「スライムの液体」を手に入れて、俺の「ナンバリングマシン」の潤滑剤を作るためなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130115
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230130115,
					"content": "しかし、まず市場で売られている「スライムの液体」は、採取から時間が経ちすぎて質が落ちている。それに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130116
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230130116,
					"content": "ガルシア先生が本を買いすぎましてね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130117
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230130117,
					"content": "あー…つまり、我々は多くの支出を迫られてだな…いやいや必要な支出だぞ！…それで、ちと資金不足でな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130118
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230130118,
					"content": "だから我々はここで、新鮮なスライムの液体を直接手に入れてやろうという算段だったのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130119
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230130119,
					"content": "しかしご覧の通り、俺の親愛なる路通くんは、璃月人なのに戦闘も料理もできない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130120
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230130120,
					"content": "ですが、僕には幸い帳簿整理の才能があります…これは総務司の複雑な税務規則のおかげですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130121
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230130121,
					"content": "…そして俺は、大事な「ナンバリングマシン」の部品を持ったまま戦うわけにもいかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130122
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230130122,
					"content": "つまり、助けてほしいんだ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230130123
					]
				},
				{
					"id": 230130123,
					"content": "まあ、ある意味では…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130124
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230130124,
					"content": "その通りです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130125
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230130125,
					"content": "路通くん、我々には…ええと、まだお金が残っていたかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130126
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230130126,
					"content": "こちらの旅人さんに報酬を払っても、まあなんとかやっていけると信じていますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130127
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230130127,
					"content": "じゃあ決まりだ！頼む、旅人さん。スライムの液体を集めてきてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230130107,
					"content": "どうしてここに？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230130108
					]
				}
			]
		},
		{
