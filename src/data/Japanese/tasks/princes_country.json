			"dialogs": [
				{
					"id": 401290901,
					"content": "これがフレミネが見つけた水中遺跡なのか？確かに大きいけど、思ってたのとちょっと違うぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290902
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401290902,
					"content": "水中遺跡じゃなくて、水妖王国。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290903
					]
				},
				{
					"id": 401290903,
					"content": "わかってるぞ。けど…オイラは本当に童話の世界が見れると思ったんだ…水妖たちが住む色とりどりな家とか、虹の架け橋とか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290904
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401290904,
					"content": "ごめんなさい…ちょっと飾りつけをしようかと考えたこともあるけど、工数と時間の関係で…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290905
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401290905,
					"content": "大丈夫、今は幻想の時間だから！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290906
					]
				},
				{
					"id": 401290906,
					"content": "おいおい！急に芝居の世界に入るなよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290907
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401290907,
					"content": "つまり旅人はもう本質を理解したのね。パイモンも頑張って！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290908
					],
					"speakerTitle": "ジュリア·ドストレ"
				},
				{
					"id": 401290908,
					"content": "フン、オイラをなめるなよ。足を引っ張ったりしないからな、いくぞ…幻想パイモンモード発動！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290909
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401290909,
					"content": "ゴホン…若き勇者たちよ！オイラはこの地を守る女神パイモン！おまえたちはなにをしにきた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290910
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401290910,
					"content": "う…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290911
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401290911,
					"content": "女神様。私たちは王子トルクシーの仲間、王子の失った栄光を取り戻すべく、この地に参りました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290912
					],
					"speakerTitle": "ジュリア·ドストレ"
				},
				{
					"id": 401290912,
					"content": "おお——失った栄光！この女神のもとには、金の栄光と銀の栄光と銅の栄光がある、王子がなくしたのはどれだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290913
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401290913,
					"content": "えっ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290914
					],
					"speakerTitle": "ジュリア·ドストレ"
				},
				{
					"id": 401290914,
					"content": "うーん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290915
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401290915,
					"content": "何かごっちゃになってない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290916
					]
				},
				{
					"id": 401290916,
					"content": "なってない！これが女神の試練だぞ！この試練でわかるんだ。おまえたちが欲深いやつじゃなくて、本当に尊敬すべき勇者だってことがな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290917
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401290917,
					"content": "ならば女神の褒美を受け取りたまえ。この女神が金の栄光、銀の栄光、銅の栄光の全てをおまえたちに授けよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290918
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401290918,
					"content": "そしてこちらの王子、この女神がおまえに七色の栄光を特別に授けよう。おまえの未来が輝きで満たされますように！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290919
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401290919,
					"content": "-.. -... .-- -...？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290920
					],
					"speakerTitle": "「トルクシー」"
				},
				{
					"id": 401290920,
					"content": "女神様の祝福に感謝します。今、全身に力を感じます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290921
					],
					"speakerTitle": "ジュリア·ドストレ"
				},
				{
					"id": 401290921,
					"content": "ぼ、ぼくもだ…これが伝説の、女神の加護なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290922
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401290922,
					"content": "女神パイモンすごい！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290923
					]
				},
				{
					"id": 401290923,
					"content": "フフン、勇者たちよ！今から、王国を侵略する魔物たちをやっつけに行きなさい！おまえたちならきっと、この地で欲しい物を手に入れられるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
