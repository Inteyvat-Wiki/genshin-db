			"dialogs": [
				{
					"id": 401290801,
					"content": "ジュリア夫人、フレミネ、先に絵を描かないか？オイラ、王冠よりも早く絵本の新しい内容が見たいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290802
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401290802,
					"content": "女神パイモンの姿が気になるんでしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290803
					]
				},
				{
					"id": 401290803,
					"content": "おい！わかってるなら、わざわざ言わなくてもいいんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290804
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401290804,
					"content": "ふふ、分かったわ。じゃあ今日の物語はこうしましょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290805
					],
					"speakerTitle": "ジュリア·ドストレ"
				},
				{
					"id": 401290805,
					"content": "幾多の困難を乗り越えて、王子と勇者たちはようやく水妖王国の入り口にたどり着いた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290806
					],
					"speakerTitle": "ジュリア·ドストレ"
				},
				{
					"id": 401290806,
					"content": "そこで、仲間の妖精パイモンが、みんなに本当の正体——女神——であることを明かした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290807
					],
					"speakerTitle": "ジュリア·ドストレ"
				},
				{
					"id": 401290807,
					"content": "やったー！女神の登場だ！女神は勇者たちの誠実さを大いに称賛し、褒美として、たくさんの祝福を与えた。そして、王子が目的を達成できるよう願った！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290808
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401290808,
					"content": "女神の栄光を手に入れ、王子と勇者は邪悪な巣窟に突入し、魔物を駆逐して、閉じ込められた可愛い水妖を救い出した。王子様はついに王国を奪還した。けれど王冠が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290809
					],
					"speakerTitle": "ジュリア·ドストレ"
				},
				{
					"id": 401290809,
					"content": "ああ、王冠がまだ出来てないんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290810
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401290810,
					"content": "いや、王冠はそこにあった。魔物がこっそり奪い去ったんだ。悪い奴らはまだ諦めていなかった。しかし、王子はすぐに王冠を奪回し、虹が再び王国に架かるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290811
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401290811,
					"content": "おお、その解釈は没入感があっていいな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290812
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401290812,
					"content": "わあ…すごい…ジュリア夫人の絵は素敵だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290813
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401290813,
					"content": "ありがとう。これで絵本の二ページ目も完成ね。「トルクシー」の冒険はますます終わりに近づき、王冠を戴き王となる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290814
					],
					"speakerTitle": "ジュリア·ドストレ"
				},
				{
					"id": 401290814,
					"content": "かわいい子、きっとそのときには元気になってるわよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290815
					],
					"speakerTitle": "ジュリア·ドストレ"
				},
				{
					"id": 401290815,
					"content": "-.-  ..-.   ..-  -...  .---  -.  ..-. -.  -...  -.  -...  ---",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290816
					],
					"speakerTitle": "「トルクシー」"
				},
				{
					"id": 401290816,
					"content": "きっとそうだぞ、ジュリア夫人！それに、もしかしたら今日帰ってすぐ、お医者さんの良い知らせが聞けるかもしれないしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290817
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401290817,
					"content": "ありがとう、女神様。そうだ、フレミネさん、王冠の製作について…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290818
					],
					"speakerTitle": "ジュリア·ドストレ"
				},
				{
					"id": 401290818,
					"content": "一日あれば十分です。ご安心を。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290819
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401290819,
					"content": "ありがとう。じゃあ最後の冒険はまた二日後にしましょう。ここに集まるので大丈夫かしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290820
					],
					"speakerTitle": "ジュリア·ドストレ"
				},
				{
					"id": 401290820,
					"content": "いいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290821
					]
				},
				{
					"id": 401290821,
					"content": "じゃあまた二日後に会いましょう、可愛い仲間たち。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290822
					],
					"speakerTitle": "ジュリア·ドストレ"
				},
				{
					"id": 401290837,
					"content": "~♪♫♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジュリア·ドストレ"
				},
				{
					"id": 401290822,
					"content": "夫人は帰ったし、オイラたちもそろそろ帰ろう。フレミネはまだ仕事があるよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290823
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401290823,
					"content": "うん。ちょっと街に行って、王冠の台座を作る部品を買ってこようと思う。いくつか違う案を作って、一番ふさわしいのを選ぶつもり。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290824,
						401290825
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401290824,
					"content": "真面目だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290826
					]
				},
				{
					"id": 401290825,
					"content": "努力家だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290826
					]
				},
				{
					"id": 401290826,
					"content": "そうだな。フレミネは他の人の依頼を簡単に引き受けないとしか知らなかったけど、一回引き受けたらこんなに真剣にやるんだな。知らなかったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290827
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401290827,
					"content": "…たぶん…おそらく…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290828
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401290828,
					"content": "なんだなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290829
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401290829,
					"content": "その…ぼく…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290830
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401290830,
					"content": "おい、なにもごもごしてんだ！その表情はなんだよ？なんだか顔が赤くなってるし、今すぐヘルメットを被って、隠れちゃいそうだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290831
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401290831,
					"content": "ええ！ぼく顔が赤くなってるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290832
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401290832,
					"content": "もう困らせないであげて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290833
					]
				},
				{
					"id": 401290833,
					"content": "へへっ。フレミネ、もう今日はおまえの仕事の邪魔はしないぞ。また二日後に会おうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290834
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401290834,
					"content": "うん、ありがとう…分かった。また二日後…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290835
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401290835,
					"content": "また二日後。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290836
					]
				},
				{
					"id": 401290836,
					"content": "…ぼくは、窮地に陥った人に、美しいものや奇跡を目にして欲しいんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フレミネ"
				}
			]
		},
