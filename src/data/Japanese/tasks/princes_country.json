			"dialogs": [
				{
					"id": 401290101,
					"content": "お子さんの様子は良くなりましたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290102
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401290102,
					"content": "気を遣ってくれてありがとう。今は落ち着いているみたい。かかりつけ医によると、今日は家から出して少し気晴らしをしてみてもいいと言っていたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290103
					],
					"speakerTitle": "ジュリア·ドストレ"
				},
				{
					"id": 401290103,
					"content": "ジュリア夫人！フレミネ！待たせたな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401290104,
					"content": "ふふ、みんな揃ったみたいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290105
					],
					"speakerTitle": "ジュリア·ドストレ"
				},
				{
					"id": 401290105,
					"content": "あと一人足りないだろ？へへ、でもオイラ、どこにいるかわかるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401290106,
					"content": "おーい、「トルクシー」——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401290107,
					"content": "-.. -... .-- -...？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290108
					],
					"speakerTitle": "「トルクシー」"
				},
				{
					"id": 401290108,
					"content": "わあ！「トルクシー」が剣と盾を持ってる！きれいだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401290109,
					"content": "武器を持った「トルクシー」は、より気合にあふれて見えるわ。フレミネさん、流石の腕前ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290110
					],
					"speakerTitle": "ジュリア·ドストレ"
				},
				{
					"id": 401290110,
					"content": "オイラたちのおかげでもあるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401290111,
					"content": "うん、旅人は目利きだね。材料はどれも品質が良い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290112
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401290112,
					"content": "そうだ。ジュリア夫人はさっき、冒険の最後は、戴冠式でエンディングを迎えたいと言っていたから、王冠の材料も…頼めるかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290113
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401290113,
					"content": "行く道中、ついでに探すだけでいいよ。元々自分で解決しようと思ったけど、あなたが持ってきたもののほうが、もっと綺麗かなと思うんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290114
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401290114,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290115
					]
				},
				{
					"id": 401290115,
					"content": "準備万端みたいだな。今から出発か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401290116,
					"content": "ちょっと待って。「トルクシー」が新しい姿になったから、絵本の一ページ目を更新できる気がするんだけど、みんなはどう思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290117
					],
					"speakerTitle": "ジュリア·ドストレ"
				},
				{
					"id": 401290117,
					"content": "おおっ！一気に楽しみになってきたぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401290118,
					"content": "どんな内容を描くの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290119
					]
				},
				{
					"id": 401290119,
					"content": "…今のをベースにして調整するのはどう？少なくとも、絵の内容が本来のものみたいに悲しくならないよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290120
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401290120,
					"content": "悪いところをなくして、綺麗に描き直すってことか？良さそうだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401290121,
					"content": "じゃあ、私が始めるわね。絵は得意じゃないけど、仕事で触れたりもしているから…具体的な内容については、みんな自由に話していいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290122
					],
					"speakerTitle": "ジュリア·ドストレ"
				},
				{
					"id": 401290122,
					"content": "ぼくは…まず武器は描いていいと思う。王子が勇気の剣と剛毅の盾を手にしたということは、現状を打破して、暗闇に向かって進むと決めた証明だから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290123
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401290123,
					"content": "ええ、武器を描いて…他には？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290124
					],
					"speakerTitle": "ジュリア·ドストレ"
				},
				{
					"id": 401290124,
					"content": "仲間も入れたほうがいいと思うぞ！今回「トルクシー」のそばには、頼れる仲間たちがいて、一人で戦ってるわけじゃないし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401290125,
					"content": "…仲間を描いて…他には？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290126
					],
					"speakerTitle": "ジュリア·ドストレ"
				},
				{
					"id": 401290126,
					"content": "そして、色彩。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290127
					]
				},
				{
					"id": 401290127,
					"content": "色彩…色彩…いいわね！色彩は大事、これから先の道はもう灰色に覆われた世界ではなく、色とりどりの希望に満ちているんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290128
					],
					"speakerTitle": "ジュリア·ドストレ"
				},
				{
					"id": 401290128,
					"content": "まさか…こんなに勇気をもらえる絵になるなんて…素晴らしい、みんなのアイデアが素晴らしすぎるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290129
					],
					"speakerTitle": "ジュリア·ドストレ"
				},
				{
					"id": 401290129,
					"content": "よかった、みんな元気そうだな。「トルクシー」が一番元気そうだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290130
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401290130,
					"content": "かわいい子…見てる？励みになったかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290131
					],
					"speakerTitle": "ジュリア·ドストレ"
				},
				{
					"id": 401290131,
					"content": "-.-  ..-.   ..-  -...  .---  -.  ..-. -.  -...  -.  -...  ---",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290132
					],
					"speakerTitle": "「トルクシー」"
				},
				{
					"id": 401290132,
					"content": "その通りです、ジュリア夫人。しかもまだ一ページ目に過ぎません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290133
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401290133,
					"content": "そうだぞ！オイラはもう絵本を最後まで見るのが待ちきれないぜ。はやく心を込めて完成させないとな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290134
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401290134,
					"content": "ええ！私も楽しみになってきたわ。じゃあここまでにして、みんな、今から出発しましょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290135
