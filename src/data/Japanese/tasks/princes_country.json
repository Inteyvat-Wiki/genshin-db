			"dialogs": [
				{
					"id": 401290601,
					"content": "ふう——やっと終わったぜ。これで悪い魔物を倒して、水妖王国を無事奪還したってことになったよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290602
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401290602,
					"content": "そうよ。ここで、「トルクシー」の戴冠式を行うつもりだったんだけど、ただ…たった一回で遺跡の最深部まで入れると思わなかったわ…こんなに順調だなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290603
					],
					"speakerTitle": "ジュリア·ドストレ"
				},
				{
					"id": 401290603,
					"content": "王冠が必要だと、もっと早くフレミネさんに言うべきだったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290604
					],
					"speakerTitle": "ジュリア·ドストレ"
				},
				{
					"id": 401290604,
					"content": "旅人と女神がすごすぎたんだな！一気に魔物の巣窟を片付けちゃったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290605
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401290605,
					"content": "大丈夫ですよ、ジュリア夫人。王冠を作ってから、また来ましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290606
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401290606,
					"content": "みんなには手間をかけちゃうわね。それに「トルクシー」、かわいい子、あなたもよくやったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290607
					],
					"speakerTitle": "ジュリア·ドストレ"
				},
				{
					"id": 401290607,
					"content": "-.-  ..-.   ..-  -...  .---  -.  ..-. -.  -...  -.  -...  ---",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290608
					],
					"speakerTitle": "「トルクシー」"
				},
				{
					"id": 401290608,
					"content": "でも「トルクシー」があんなに戦えるなんて、意外だったな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290609
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401290609,
					"content": "本物の王子みたいだった。きっと…彼を阻める困難はもうないはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290610
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401290610,
					"content": "フレミネさん…！ええ、きっとそうよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290611
					],
					"speakerTitle": "ジュリア·ドストレ"
				},
				{
					"id": 401290611,
					"content": "まず拠点に戻ろう。ここに来る途中、旅人に材料を集めてもらったから、さっそく王冠を作りたいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290612
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401290612,
					"content": "戻ったらオイラたちの旅を絵にしようぜ。水妖王国を奪還したから、『トルクシーの不思議な冒険』を更新できるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
