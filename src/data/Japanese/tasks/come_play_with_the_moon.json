			"dialogs": [
				{
					"id": 761220201,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220202
					],
					"speakerTitle": "ルオンノタル"
				},
				{
					"id": 761220202,
					"content": "ルオンノタル…！本物のルオンノタルだ！もう二度と会えないかと思ったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761220203,
					"content": "じゃあ、さっきの絵は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220204
					]
				},
				{
					"id": 761220204,
					"content": "月光でこの子の輪郭を描いたの。そこに、私が新たな力と祝福を注いで新たな命を与えた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220205
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761220205,
					"content": "これからはもう、私の魂を背負わなくて済むんだよ。自分の意志を持てるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220206
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761220206,
					"content": "！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220207
					],
					"speakerTitle": "ルオンノタル"
				},
				{
					"id": 761220207,
					"content": "あっ、こっちに来るぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761220208,
					"content": "うん、キミたちと過ごした記憶もすべて蘇らせたから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220210
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761220210,
					"content": "…！…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220211
					],
					"speakerTitle": "ルオンノタル"
				},
				{
					"id": 761220211,
					"content": "うぅ…ルオンノタル、本当によかった。これからはもっと優しくしてやるからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761220212,
					"content": "あ、じゃあ「サプライズ」って——！オイラ、すっごく気に入ったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761220213,
					"content": "ありがとう、コロンビーナ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220214
					]
				},
				{
					"id": 761220214,
					"content": "どういたしまして。ルオンノタルにまた会えて、私も嬉しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220216
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761220216,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220217
					],
					"speakerTitle": "ルオンノタル"
				},
				{
					"id": 761220217,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220218
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761220218,
					"content": "（相変わらずだね。でも、コロンビーナはちょっと変わったみたい。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220219
					]
				},
				{
					"id": 761220219,
					"content": "（ルオンノタルは眷属ってだけじゃなくて…気の置けない友達なんだ。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220220
					]
				},
				{
					"id": 761220220,
					"content": "会いたかったんでしょ？ほら、行っておいで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220221
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761220221,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220222
					],
					"speakerTitle": "ルオンノタル"
				},
				{
					"id": 761220222,
					"content": "またいつでも来てね。",
					"roleType": "TALK_ROLE_NPC",
