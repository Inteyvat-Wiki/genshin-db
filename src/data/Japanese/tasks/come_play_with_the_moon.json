			"dialogs": [
				{
					"id": 761220101,
					"content": "コロンビーナ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761220102,
					"content": "あれ？たしかに声がしたんだけどな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761220103,
					"content": "…わっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220104
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761220104,
					"content": "ひぃっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761220105,
					"content": "こんにちは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220106
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761220106,
					"content": "び、びっくりしたぞ！いつもいつも…いるなら返事ぐらいしろよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761220107,
					"content": "このゲームにはキミたちも慣れてきたみたいだったから、少しハードルを上げてみようと思って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220108
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761220108,
					"content": "ふんっ、今度絶対に仕返ししてやるからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761220109,
					"content": "うん、楽しみにしてるね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220110
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761220110,
					"content": "あれ、アイマスクは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220111
					]
				},
				{
					"id": 761220111,
					"content": "月霊たちと遊んでた時に、とられちゃったのかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220112
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761220112,
					"content": "どうせ目を閉じてるから、構わないよ。気に入ったなら、しばらく遊ばせてあげて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220113
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761220113,
					"content": "そういえば、コロンビーナは外に出たりしないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761220114,
					"content": "もう人に見られても平気でしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220115
					]
				},
				{
					"id": 761220115,
					"content": "うん…暇だし、いつでも出かけられるけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220116
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761220116,
					"content": "キミたちが来るかもって思ったら、留守にするのも…心配するでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220117,
						761220118
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761220117,
					"content": "そういう時は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220119
					]
				},
				{
					"id": 761220119,
					"content": "そうそう。おまえが無事だってわかってれば安心だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761220120,
					"content": "なるほど。考えてみる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220121
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761220121,
					"content": "考えてみる、かよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761220122,
					"content": "ここにいるのが好きなだけじゃないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220123
					]
				},
				{
					"id": 761220123,
					"content": "うん、楽しい思い出がたくさんある場所だからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220124
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761220124,
					"content": "でも、もう一つ理由があるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220125
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761220125,
					"content": "ん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761220126,
					"content": "キミたちにサプライズを用意してたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761220118,
					"content": "メモを残してくれれば大丈夫だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220119
					]
				}
			]
		},
