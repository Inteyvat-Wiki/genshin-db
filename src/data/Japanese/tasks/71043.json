			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710430101,
					"content": "「…アントン曹長が南東方向に大きな鐘を見つけた…岩壁には、『彼ら』の文字が書かれている…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430102
					],
					"speakerTitle": "ファデュイの日記"
				},
				{
					"id": 710430102,
					"content": "「…以前、大尉と共に北西方向で見た大きな鐘と似ている。もしかすると…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430103
					],
					"speakerTitle": "ファデュイの日記"
				},
				{
					"id": 710430103,
					"content": "「…スネージヴナとファディカの二人を送り込み、両側の遺跡にある大きな鐘を鳴らす…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430104
					],
					"speakerTitle": "ファデュイの日記"
				},
				{
					"id": 710430104,
					"content": "「黒い霧は消えたが、恐ろしい風の唸り声が岩壁に響き渡った。説明のつかない奇妙な現象はまるで…誰かの到来を告げているようだ…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430105
					],
					"speakerTitle": "ファデュイの日記"
				},
				{
					"id": 710430105,
					"content": "「…十人が犠牲となり、二つの先制部隊も大きな被害を受けたため、大尉は即時撤退を命じた…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430106
					],
					"speakerTitle": "ファデュイの日記"
				},
				{
					"id": 710430106,
					"content": "（日記から滑り落ちた簡易地図には、北西と南東の辺りに二つの大きな鐘の位置が記されており、二つの目立つドクロが描かれていた。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ファデュイの日記"
				}
			]
		},
