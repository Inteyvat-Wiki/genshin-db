	"talks": [
		{
			"id": 7150301,
			"completionStepIds": [
				7150301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7150301",
							"2"
						],
						"stepId": 7150301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ホッセイニ",
					"昊",
					"図"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715030101,
					"content": "#ちょうどいいところに来てくれた、{NICKNAME}。今どうすれば「プルシナスパイク」を中に運べるか話し合っていたところなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030102
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715030102,
					"content": "ただ、ここの状況は私たちが思っていたよりもずっと悪い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030103
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715030103,
					"content": "ゴホッ…だめだ、黒泥が多い上に、引き寄せられた魔物も多い。中に運ぶのは無理そうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030104
					],
					"speakerTitle": "昊"
				},
				{
					"id": 715030104,
					"content": "どうやって先に進めばいいのか、皆目見当も付かない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030105
					],
					"speakerTitle": "昊"
				},
				{
					"id": 715030105,
					"content": "ここから坑道の中までまだ遠い。手を貸してくれ、もう一回試してみるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030106
					],
					"speakerTitle": "図"
				},
				{
					"id": 715030106,
					"content": "それでも無理だったら、外に行って仲間たちを呼ぼう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030107
					],
					"speakerTitle": "図"
				},
				{
					"id": 715030107,
					"content": "ただの荷運びだ。この採掘スターである俺がつるはしをひょいっと振れば、山を丸々くりぬける。層岩巨淵にいる魔物なんて屁でもない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030108
					],
					"speakerTitle": "図"
				},
				{
					"id": 715030108,
					"content": "見栄を張るな。咳を我慢してるせいで、顔が真っ赤じゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030109
					],
					"speakerTitle": "昊"
				},
				{
					"id": 715030109,
					"content": "でたらめを言うな、そんなことは…ゴホッ、ゴホッゴホッ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030110
					],
					"speakerTitle": "図"
				},
				{
					"id": 715030110,
					"content": "これ以上、先に進まないほうがいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030111
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715030111,
					"content": "この黒泥との接触が長引けば、大変なことになる。それに中には魔物も多い。危険すぎる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030112
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715030112,
					"content": "し…しかし、前にこの機器を鉱区に置いたことで、きれいになったのを俺たちも見た。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030113
					],
					"speakerTitle": "図"
				},
				{
					"id": 715030113,
					"content": "もし、ゴホッ…もし坑道に存在するこの黒泥をすぐ解決できるのなら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030114
					],
					"speakerTitle": "図"
				},
				{
					"id": 715030114,
					"content": "今は速さを求める状況じゃない。問題の処理にしろ、実験にしろ、準備と考察をせず軽々に進めたら、一つのミスで命に関わることになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030115
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715030115,
					"content": "「命が一番大切である」——これは「教令院」の実験室にある操作マニュアルの基本規則の一つだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030116
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715030116,
					"content": "だから、「教令院」の学者である私は、そういった行動を見て見ぬふりはできない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030117
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715030117,
					"content": "はぁ、でも僕たちがここで手を止めたら…この大量にある黒泥はどうなる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030118
					],
					"speakerTitle": "昊"
				},
				{
					"id": 715030118,
					"content": "もし、この黒泥がもっと魔物を引き寄せたら…たとえこちらが二十人増えても…ゴホッ、中には運べなくなる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030119
					],
					"speakerTitle": "昊"
				},
				{
					"id": 715030119,
					"content": "そうだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030120
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715030120,
					"content": "なら、ここでスパイクを起動しよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030121
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715030121,
					"content": "ここで起動？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030122
					],
					"speakerTitle": "昊"
				},
				{
					"id": 715030122,
					"content": "そう。さっき黒泥が湧き出るスピードを目視で計測してみた。昨日の鉱区よりは速いが、黒泥の核心エリアではないから、これなら除去スピードのほうが上回る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030123
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715030123,
					"content": "層岩巨淵の魔物が黒泥に引き寄せられたのも、きっとそのエネルギーに影響を受けたからだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030124
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715030124,
					"content": "#ここでスパイクを起動して周囲の黒泥の影響を抑え込めば、{NICKNAME}も行動しやすくなるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030125
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715030125,
					"content": "黒泥を除去すれば、魔物もここに集まらなくなるはずだ。そうなったら、運搬を再開しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030126
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715030126,
					"content": "そうしよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715030127
					]
				},
				{
					"id": 715030127,
					"content": "二人とも、まずは拠点に戻って休んでくれ。この先もまだ君たちに頼みたいことはあるからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030128
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715030128,
					"content": "俺は大丈夫だ。これしきのことで…ゴホッ、この採掘スターは休まない。魔物を片付けるだけだ、俺も手伝おう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030129
					],
					"speakerTitle": "図"
				},
				{
					"id": 715030129,
					"content": "無理するな、君のことなら分かってるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030130
					],
					"speakerTitle": "昊"
				},
				{
					"id": 715030130,
					"content": "#この人はあの噂の{NICKNAME}だ。{M#彼}{F#彼女}に任せれば、僕たちが心配する必要もないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030131
					],
					"speakerTitle": "昊"
				},
				{
					"id": 715030131,
					"content": "#{NICKNAME}、周囲の黒泥と魔物の片付けは君に任せるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030132,
						715030133
					],
					"speakerTitle": "昊"
				},
				{
					"id": 715030132,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715030134
					]
				},
				{
					"id": 715030134,
					"content": "#そうだ。{NICKNAME}、この辺りは黒泥だらけで、思っていたよりも状況が悪い…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030135
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715030135,
					"content": "黒泥の周りには魔物がいっぱいいるから、気を付けてほしい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030136
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715030136,
					"content": "うん、気を付けるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715030137
					]
				},
				{
					"id": 715030137,
					"content": "いや、私が言いたいのは、「プルシナスパイク」に被害が出ないよう気を付けてほしいという意味だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030138
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715030138,
					"content": "君の実力を信じてはいるが…それでも、「プルシナスパイク」は精密で繊細、そして偉大な機器だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030139
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715030139,
					"content": "スパイクを傷つけないよう、十分に気を付けてほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715030133,
					"content": "安心して任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715030134
					]
				}
			]
		}
	]
}