			"completionStepIds": [
				7310404
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310404",
							"2"
						],
						"stepId": 7310404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"カイヴァン",
					"ホーベット"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731040401,
					"content": "仕事が早いな、お疲れさん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040402
					],
					"speakerTitle": "カイヴァン"
				},
				{
					"id": 731040402,
					"content": "それでは、さっそく始めてください！でないと、貴重な文物が…うぅ…魚のごはんに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040403
					],
					"speakerTitle": "ホーベット"
				},
				{
					"id": 731040403,
					"content": "落ち着け。竿を投げる時は水流の韻律を感じ、心穏やかでなければいけないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040404
					],
					"speakerTitle": "カイヴァン"
				},
				{
					"id": 731040404,
					"content": "さあ、試させてもらおう。ここでどんな大物が釣れるのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
