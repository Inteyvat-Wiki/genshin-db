					],
					"speakerTitle": "カイヴァン"
				},
				{
					"id": 731040408,
					"content": "これは…ち、ちょっと見せてください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040409
					],
					"speakerTitle": "ホーベット"
