					"nextDialogs": [
						731040413
					],
					"speakerTitle": "ホーベット"
				},
				{
					"id": 731040413,
					"content": "はぁ…早く行って、さっさと終わらせよう。帰って静かに釣りがしたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040414
					],
					"speakerTitle": "カイヴァン"
				},
				{
					"id": 731040414,
					"content": "問題ありません、着いてきてください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040415
					],
					"speakerTitle": "ホーベット"
				},
				{
					"id": 731040415,
					"content": "旅人、今回の特別な材料をハッラの実に変えよう。俺の直感がそう言ってる。",
