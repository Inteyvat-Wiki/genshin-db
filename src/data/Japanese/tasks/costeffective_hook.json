			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"カイヴァン",
					"ホーベット"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731040101,
					"content": "お願いです！この通りですから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040102
					],
					"speakerTitle": "ホーベット"
				},
				{
					"id": 731040102,
					"content": "何も言うことはない、帰ってくれないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040103
					],
					"speakerTitle": "カイヴァン"
				},
				{
					"id": 731040103,
					"content": "うわぁ、二人は揉めてるみたいだぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731040104,
					"content": "よぉ、異郷人…君もこの人に帰るよう言ってくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040105
					],
					"speakerTitle": "カイヴァン"
				},
				{
					"id": 731040105,
					"content": "突然やってきたかと思えば、骨董品を釣り上げろとしつこいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040106
					],
					"speakerTitle": "カイヴァン"
				},
				{
					"id": 731040106,
					"content": "俺の魚たちを驚かせただけでは足りず、貴重な釣りの時間を奪い続けている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040107
					],
					"speakerTitle": "カイヴァン"
				},
				{
					"id": 731040107,
					"content": "なあ君…そんなに躍起になるほど、骨董品って儲かるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040108
					],
					"speakerTitle": "カイヴァン"
				},
				{
					"id": 731040108,
					"content": "違うんですカイヴァンさん！それと、私は教令院の職員、ホーベットです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040109
					],
					"speakerTitle": "ホーベット"
				},
				{
					"id": 731040109,
					"content": "その骨董品ですが、教令院が研究のために蒐集しているものです。私は、責任を持ってそれらを管理する立場にあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040110
					],
					"speakerTitle": "ホーベット"
				},
				{
					"id": 731040110,
					"content": "しかし昨日、そうした文物を輸送する小船がトラブルに遭い、いくつかが川に落ちて、下流まで流されてしまったようなのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040111
					],
					"speakerTitle": "ホーベット"
				},
				{
					"id": 731040111,
					"content": "それなら、なおのことプロに任せたらいいだろ？一介の釣り人にすぎない俺に何の用がある？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040112
					],
					"speakerTitle": "カイヴァン"
				},
				{
					"id": 731040112,
					"content": "彼らに頼むのは時間がかかりすぎます！聞くところによれば、「釣り針にある絶景」ことカイヴァンさんは、ほぼ毎日、落とし物を釣り上げているというではありませんか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040113
					],
					"speakerTitle": "ホーベット"
				},
				{
					"id": 731040113,
					"content": "それに、あなたはこのあたりの水場に詳しいとのことですから、ぜひ文物を釣れるかどうか試してみたいのです…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040114,
						731040115
					],
					"speakerTitle": "ホーベット"
				},
				{
					"id": 731040114,
					"content": "藁にも縋る勢いだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040117
					]
				},
				{
					"id": 731040117,
					"content": "コホン、いいかホーベットさん…君の境遇には同情するが、俺はただの釣り人だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040118
					],
					"speakerTitle": "カイヴァン"
				},
				{
					"id": 731040118,
					"content": "釣りをするのは魚のため、釣れるのも、魚のほかには何もない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040119
					],
					"speakerTitle": "カイヴァン"
				},
				{
					"id": 731040119,
					"content": "魚なんて一匹も釣ったことないくせに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731040120,
					"content": "コホン！だとしても、釣りの技術を磨くうえでは常にそう意識してきた。それを他のことに使うなど考えたこともない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040121
					],
					"speakerTitle": "カイヴァン"
				},
				{
					"id": 731040121,
					"content": "だから、他を当たってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040122
					],
					"speakerTitle": "カイヴァン"
				},
				{
					"id": 731040122,
					"content": "えーっと…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040123
					],
					"speakerTitle": "ホーベット"
				},
				{
					"id": 731040123,
					"content": "事情はよくわかりませんが…こうしましょう。落とし物を探してくれとは言いません、ただ、こちらの指定する場所で釣りをして頂ければ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040124
					],
					"speakerTitle": "ホーベット"
				},
				{
					"id": 731040124,
					"content": "釣果は…なんであれ私が買い取るということで…！どうですか？お願いします！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040125
					],
					"speakerTitle": "ホーベット"
				},
				{
					"id": 731040125,
					"content": "あのな、俺は漁師だぞ、漁師！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040126,
						731040127
					],
					"speakerTitle": "カイヴァン"
				},
				{
					"id": 731040126,
					"content": "たまには釣り場を変えるのも悪くない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040128
					]
				},
				{
					"id": 731040128,
					"content": "お願いです！ほら…報酬の準備もできていますので、何卒！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040129
					],
					"speakerTitle": "ホーベット"
				},
				{
					"id": 731040129,
					"content": "はぁ…わかったわかった。気分転換だと思うことにしよう…で、どこで釣ればいい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040130
					],
					"speakerTitle": "カイヴァン"
				},
				{
					"id": 731040130,
					"content": "本当にありがとうございます！ついてきてください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040131
					],
					"speakerTitle": "ホーベット"
				},
				{
					"id": 731040131,
					"content": "前と同じように、旅人に釣り餌の材料を用意してもらうぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040132
					],
					"speakerTitle": "カイヴァン"
				},
				{
					"id": 731040132,
					"content": "そうだな…今回の特別な材料はミントだ。ただし、必ず俺のよく行く場所で採ってきてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040133
					],
					"speakerTitle": "カイヴァン"
				},
				{
					"id": 731040133,
					"content": "地図に大体の位置の印をつけたから、頼んだぞ。材料を持ってきたら、報酬の計算をしてやる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040134
					],
					"speakerTitle": "カイヴァン"
				},
				{
					"id": 731040134,
					"content": "先にホーベットさんと釣り場に行ってるから、そこで落ち合おう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カイヴァン"
				},
				{
					"id": 731040127,
					"content": "漁師もいろんなものを釣るから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040128
					]
				},
				{
					"id": 731040115,
					"content": "カイヴァンなら恐らく…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040116
					]
				},
				{
					"id": 731040116,
					"content": "俺が釣りをやっているのは、大きな魚を釣るためだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040117
					],
					"speakerTitle": "カイヴァン"
				}
			]
		},
