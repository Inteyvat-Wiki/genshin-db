			"dialogs": [
				{
					"id": 750160201,
					"content": "二人は…異国から来た旅の人か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160202
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160202,
					"content": "おっと、失礼…だが連れているのはテペトル竜だろう。その仔竜は、君たちの仲間なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160203
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160203,
					"content": "しっぽに綺麗なスカーフを巻いてもらったのか。フフ、本当に元気な子だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160204
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160204,
					"content": "#おう、ナタに来てすぐ出会ったんだ。こいつは{REALNAME[ID(2)|SHOWHOST(true)]}。最近はずっとオイラたちと一緒に旅してるんだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750160205,
					"content": "キュウ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160206
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750160206,
					"content": "一緒に旅してるのか。余計なお世話かもしれないが、少し危険だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160207,
						750160208
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160207,
					"content": "「竜」と一緒に行動するのは危ないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160210
					]
				},
				{
					"id": 750160210,
					"content": "ナタでは、人とこいつら…「竜」が一緒に暮らすのは普通なんじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750160211,
					"content": "#もしかして旅すること自体が危ないってことか？{REALNAME[ID(2)|SHOWHOST(true)]}に長旅をさせちゃいけないとか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750160212,
					"content": "キュウ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160213
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750160213,
					"content": "#そうではない…旅は竜にとっても人間にとってもいいことだ。ただ…君たちのテペトル竜、{REALNAME[ID(2)|SHOWHOST(true)]}は他の竜とは少し違う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160214
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160214,
					"content": "おっと…長々喋ってすまない、自己紹介がまだだったな。おれはマンク、龍の遺物研究会の研究員だ。部族の風俗を研究している…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160215
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160215,
					"content": "つまり、部族の過去の風習なんかだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160216
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160216,
					"content": "テペトル竜の名前は聞いたが…二人の名前は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160217
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160217,
					"content": "#オイラはパイモン、こいつは{NICKNAME}だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750160218,
					"content": "クルル！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160219
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750160219,
					"content": "#元気な子だ。パイモンと{NICKNAME}がちゃんと世話をしてるんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160220
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160220,
					"content": "キュ…キュウ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160221
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750160221,
					"content": "#もちろんだぜ！オイラたち、一緒に美味しいものをたくさん食べてきたもんな、{REALNAME[ID(2)|SHOWHOST(true)]}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160222
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750160222,
					"content": "#あっ、{REALNAME[ID(2)|SHOWHOST(true)]}、勝手にどっか行っちゃだめだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160223
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750160223,
					"content": "本当に残念だ。あんなに元気なテペトル竜なのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160224,
						750160225
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160224,
					"content": "いったい何が危ないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160226
					]
				},
				{
					"id": 750160226,
					"content": "すまない。言葉が悪かった…だが本当にそう思ってしまうんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160227
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160227,
					"content": "#単刀直入に言おう。小さなテペトル竜は沢山見て来ただろうが、{REALNAME[ID(2)|SHOWHOST(true)]}と同じようなのは一匹もいなかっただろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160228,
						750160230
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160228,
					"content": "しっぽにスカーフがついてるもんね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160229
					]
				},
				{
					"id": 750160229,
					"content": "ハハッ、それは君が巻いたんだろう。そうじゃなくて、角にある印のことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160231
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160231,
					"content": "ああ。普通の仔竜にああいう印は付いていない。あれは「焔の{RUBY#[S]シウコアトル}主の祝福」と呼ばれているものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160232
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160232,
					"content": "何と…説明すればいいのだろうな。あの印を持つ仔竜はたいてい、不思議な力を持っている。例えば、他の竜と比べて力が強かったり、速く泳げたり、高く飛べたりな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160233
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160233,
					"content": "悪い話には聞こえないけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160234
					]
				},
				{
					"id": 750160234,
					"content": "だがさっきも言ったように、それは「焔の主」の祝福であって、そいつら自身の力じゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160235
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160235,
					"content": "何せ、遥か昔の龍から授かった力なんだ。今の竜の体では、あんな強い力を受け止められない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160236
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160236,
					"content": "一方、「大霊」も夜神の国もその力を拒み、受け入れようとしない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160237
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160237,
					"content": "だから成長していく中で、そういう個体は力のせいで死んでしまったり、理性を失ったりするんだ。どちらにせよ、危険だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160238
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160238,
					"content": "あの仔竜はこだまの子に返すべきかもしれない…彼らなら適切に処分してくれるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160239,
						750160240
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160239,
					"content": "処分？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160241
					]
				},
				{
					"id": 750160241,
					"content": "言葉選びが下手くそですまない…だが地元の人間に任せるのがいい選択だと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160242
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160242,
					"content": "…教えてくれて、ありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160243
					]
				},
				{
					"id": 750160243,
					"content": "諦めないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160244,
						750160245
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160244,
					"content": "諦めるのは最善の選択じゃない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160246
					]
				},
				{
					"id": 750160246,
					"content": "…はぁ、分かった。旅人、君の決意は伝わった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160247
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160247,
					"content": "これはナタの「地元民」しか知らない秘密だから、教えるべきか迷ってたんだが——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160248
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160248,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}を助けたいなら、あいつを連れて火山の巡礼の道を歩んでくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160249
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160249,
					"content": "伝説によると、部族の勇者は二つに分かれた象徴物を携えて巨大な火山へ向かい…逝去し{RUBY#[S]シウコアトル}た龍に記憶されてしまった仲間の名前を洗い流すことで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160250
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160250,
					"content": "その仲間を、再び夜神の国に受け入れてもらえるようにしたと言われている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160251
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160251,
					"content": "どうして教えてくれたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160252
					]
				},
				{
					"id": 750160252,
					"content": "今の六大部族にそういうことをする者はおらず、する余裕もないからだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160253
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160253,
					"content": "だが君は違う。君は異邦の旅人だ——部族の古い理念に縛られることはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160254
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160254,
					"content": "成功してくれれば、古代遺物の刻印と、朽ちかけたウォーベンに書かれたことが今も有効であることを証明できる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160255
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160255,
					"content": "これはとても重要なことだ…やってみたいなら、象徴物の在処を探してみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160256
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160256,
					"content": "そうすれば、君も仲間を助けられる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160257,
						750160258
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160257,
					"content": "ウィンウィンみたいだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160259
					]
				},
				{
					"id": 750160259,
					"content": "では…例の場所を見つけたら、君たちに連絡しよう。あるいは、そちらから訪ねてくれてもいい。最近はこだまの子で研究しているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160260
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160260,
					"content": "それでは、またな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160261
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160261,
					"content": "龍の遺物研究会の研究員である彼は、身を翻して去っていった。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						750160262
					]
				},
				{
					"id": 750160262,
					"content": "#まったく、{REALNAME[ID(2)|SHOWHOST(true)]}、もう勝手に走り回っちゃダメだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160263
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750160263,
					"content": "キューン…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160264
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750160264,
					"content": "#あっ、そういえば{NICKNAME}、さっきのやつはもう行っちゃったのか？変なこととか言われなかったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160265
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750160265,
					"content": "実は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160266
					]
				},
				{
					"id": 750160266,
					"content": "#うーん…つまり、{REALNAME[ID(2)|SHOWHOST(true)]}は病気みたいなもんだから、オイラたちは必要なものを持って、こいつを火山に連れてって、病気を治してあげないといけないってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160267
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750160267,
					"content": "キュウ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160268
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750160268,
					"content": "#はぁ…{REALNAME[ID(2)|SHOWHOST(true)]}には全然わからなかったみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160269
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750160269,
					"content": "でもまあ、こいつが大きくなる前に、パパッと問題を解決できちゃう可能性もあるしな。そしたら、こいつは元気に成長できるんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160270
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750160270,
					"content": "#あいつの言うこと、信用できるかは分からないけど…象徴物を探すんだっけか？{NICKNAME}、オイラたちも探してみようぜ。もしかしたら、あいつより早く見つけられるかもしれないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160271
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750160271,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160272
					]
				},
				{
					"id": 750160272,
					"content": "キュウ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160273
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750160273,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}も一緒に行こう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160274
					]
				},
				{
					"id": 750160274,
					"content": "クルルル！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750160258,
					"content": "試してみる価値はある…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160259
					]
				},
				{
					"id": 750160245,
					"content": "仲間のことを諦めたりはしない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160246
					]
				},
				{
					"id": 750160240,
					"content": "随分と冷たい言い方だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160241
					]
				},
				{
					"id": 750160230,
					"content": "あの赤いやつ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160231
					]
				},
				{
					"id": 750160225,
					"content": "そんなこと言わないで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160226
					]
				},
