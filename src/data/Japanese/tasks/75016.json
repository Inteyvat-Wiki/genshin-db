			"dialogs": [
				{
					"id": 750160301,
					"content": "二人は…異国から来た旅の人か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160302
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160302,
					"content": "おっと、失礼…だが連れているのはテペトル竜だろう。その仔竜は、君たちの仲間なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160303
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160303,
					"content": "しっぽに綺麗なスカーフを巻いてもらったのか。フフ、本当に元気な子だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160304
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160304,
					"content": "#おう、ナタに来てすぐ出会ったんだ。こいつは{REALNAME[ID(2)|SHOWHOST(true)]}。最近はずっとオイラたちと一緒に旅してるんだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750160305,
					"content": "クルル！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160306
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750160306,
					"content": "一緒に旅してるのか。余計なお世話かもしれないが、少し危険だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160307,
						750160308
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160307,
					"content": "「竜」と一緒に行動するのは危ないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160310
					]
				},
				{
					"id": 750160308,
					"content": "ありがとう、食べられないように気をつけ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160309
					]
				},
				{
					"id": 750160309,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}はオイラたちを食べたりしないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750160310,
					"content": "ナタでは、人とこいつら…「竜」が一緒に暮らすのは普通なんじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750160311,
					"content": "#もしかして旅すること自体が危ないってことか？{REALNAME[ID(2)|SHOWHOST(true)]}に長旅をさせちゃいけないとか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750160312,
					"content": "キュウ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160313
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750160313,
					"content": "#そうではない…旅は竜にとっても人間にとってもいいことだ。ただ…君たちのテペトル竜、{REALNAME[ID(2)|SHOWHOST(true)]}は他の竜とは少し違う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160314
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160314,
					"content": "おっと…長々喋ってすまない、自己紹介がまだだったな。おれはマンク、龍の遺物研究会の研究員だ。部族の風俗を研究している…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160315
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160315,
					"content": "つまり、部族の過去の風習なんかだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160316
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160316,
					"content": "テペトル竜の名前は聞いたが…二人の名前は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160317
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160317,
					"content": "#オイラはパイモン、こいつは{NICKNAME}だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160318
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750160318,
					"content": "キュイ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160319
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750160319,
					"content": "#元気な子だ。パイモンと{NICKNAME}がちゃんと世話をしてるんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160320
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160320,
					"content": "キュ…キュウ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160321
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750160321,
					"content": "#もちろんだぜ！オイラたち、一緒に美味しいものをたくさん食べてきたもんな、{REALNAME[ID(2)|SHOWHOST(true)]}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160322
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750160322,
					"content": "#あっ、{REALNAME[ID(2)|SHOWHOST(true)]}、勝手にどっか行っちゃだめだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160323
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750160323,
					"content": "本当に残念だ。あんなに元気なテペトル竜なのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160324,
						750160325
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160324,
					"content": "いったい何が危ないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160326
					]
				},
				{
					"id": 750160325,
					"content": "そんなこと言わないで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160326
					]
				},
				{
					"id": 750160326,
					"content": "すまない。言葉が悪かった…だが本当にそう思ってしまうんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160327
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160327,
					"content": "#単刀直入に言おう。小さなテペトル竜は沢山見て来ただろうが、{REALNAME[ID(2)|SHOWHOST(true)]}と同じようなのは一匹もいなかっただろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160328,
						750160330
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160328,
					"content": "しっぽにスカーフがついてるもんね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160329
					]
				},
				{
					"id": 750160330,
					"content": "あの赤いやつ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160331
					]
				},
				{
					"id": 750160227,
					"content": "#単刀直入に言おう。小さなテペトル竜は沢山見て来ただろうが、{REALNAME[ID(2)|SHOWHOST(true)]}と同じようなのは一匹もいなかっただろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160228,
						750160230
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160329,
					"content": "ハハッ、それは君が巻いたんだろう。そうじゃなくて、角にある印のことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160331
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160331,
					"content": "ああ。普通の仔竜にああいう印は付いていない。あれは「焔の{RUBY#[S]シウコアトル}主の祝福」と呼ばれているものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160332
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160332,
					"content": "何と…説明すればいいのだろうな。あの印を持つ仔竜はたいてい、不思議な力を持っている。例えば、他の竜と比べて力が強かったり、速く泳げたり、高く飛べたりな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160333
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160333,
					"content": "悪い話には聞こえないけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160334
					]
				},
				{
					"id": 750160334,
					"content": "だがさっきも言ったように、それは「焔の主」の祝福であって、そいつら自身の力じゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160335
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160335,
					"content": "何せ、遥か昔の龍から授かった力なんだ。今の竜の体では、あんな強い力を受け止められない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160336
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160336,
					"content": "一方、「大霊」も夜神の国もその力を拒み、受け入れようとしない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160337
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160337,
					"content": "だから成長していく中で、そういう個体は力のせいで死んでしまったり、理性を失ったりするんだ。どちらにせよ、危険だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160338
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160338,
					"content": "あの仔竜はこだまの子に返すべきかもしれない…彼らなら適切に処分してくれるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160339,
						750160340
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160339,
					"content": "処分？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160341
					]
				},
				{
					"id": 750160340,
					"content": "随分と冷たい言い方だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160341
					]
				},
				{
					"id": 750160341,
					"content": "言葉選びが下手くそですまない…だが地元の人間に任せるのがいい選択だと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160342
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160342,
					"content": "…教えてくれて、ありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160343
					]
				},
				{
					"id": 750160343,
					"content": "諦めないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160344,
						750160345
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160344,
					"content": "諦めるのは最善の選択じゃない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160346
					]
				},
				{
					"id": 750160345,
					"content": "仲間のことを諦めたりはしない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160346
					]
				},
				{
					"id": 750160346,
					"content": "…はぁ、分かった。旅人、君の決意は伝わった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160347
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160347,
					"content": "これはナタの「地元民」しか知らない秘密だから、教えるべきか迷ってたんだが——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160348
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160348,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}を助けたいなら、あいつを連れて火山の巡礼の道を歩んでくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160349
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160349,
					"content": "伝説によると、部族の勇者は二つに分かれた象徴物を携えて巨大な火山へ向かい…逝去し{RUBY#[S]シウコアトル}た龍に記憶されてしまった仲間の名前を洗い流すことで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160350
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160350,
					"content": "その仲間を、再び夜神の国に受け入れてもらえるようにしたと言われている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160351
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160351,
					"content": "どうして教えてくれたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160352
					]
				},
				{
					"id": 750160352,
					"content": "今の六大部族にそういうことをする者はおらず、する余裕もないからだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160353
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160353,
					"content": "だが君は違う。君は異邦の旅人だ——部族の古い理念に縛られることはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160354
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160354,
					"content": "成功してくれれば、古代遺物の刻印と、朽ちかけたウォーベンに書かれたことが今も有効であることを証明できる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160355
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160355,
					"content": "これはとても重要なことだ…やってみたいなら、象徴物の在処を探してみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160356
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160356,
					"content": "そうすれば、君も仲間を助けられる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160357,
						750160358
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160357,
					"content": "ウィンウィンみたいだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160359
					]
				},
				{
					"id": 750160358,
					"content": "試してみる価値はある…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160359
					]
				},
				{
					"id": 750160359,
					"content": "では…例の場所を見つけたら、君たちに連絡しよう。あるいは、そちらから訪ねてくれてもいい。最近はこだまの子で研究しているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160360
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160360,
					"content": "それでは、またな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160361
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750160361,
					"content": "龍の遺物研究会の研究員である彼は、身を翻して去っていった。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						750160362
					]
				},
				{
					"id": 750160362,
					"content": "#まったく、{REALNAME[ID(2)|SHOWHOST(true)]}、もう勝手に走り回っちゃダメだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160363
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750160363,
					"content": "キュン…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160364
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750160364,
					"content": "#あっ、そういえば{NICKNAME}、さっきのやつはもう行っちゃったのか？変なこととか言われなかったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160365
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750160365,
					"content": "実は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160366
					]
				},
				{
					"id": 750160366,
					"content": "#うーん…つまり、{REALNAME[ID(2)|SHOWHOST(true)]}は病気みたいなもんだから、オイラたちは必要なものを持って、こいつを火山に連れてって、病気を治してあげないといけないってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160367
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750160367,
					"content": "キュウ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160368
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750160368,
					"content": "#はぁ…{REALNAME[ID(2)|SHOWHOST(true)]}には全然わからなかったみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160369
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750160369,
					"content": "でもまあ、こいつが大きくなる前に、パパッと問題を解決できちゃう可能性もあるしな。そしたら、こいつは元気に成長できるんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160370
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750160370,
					"content": "#あいつの言うこと、信用できるかは分からないけど…象徴物を探すんだっけか？{NICKNAME}、オイラたちも探してみようぜ。もしかしたら、あいつより早く見つけられるかもしれないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160371
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750160371,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160372
					]
				},
				{
					"id": 750160372,
					"content": "キュウ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160373
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750160373,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}も一緒に行こう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160374
					]
				},
				{
					"id": 750160374,
					"content": "キュイ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				}
			]
		},
