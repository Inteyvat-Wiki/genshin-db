				"points": []
			},
			"dialogs": [
				{
					"id": 731930501,
					"content": "貴方たちがいなければ、ローズの芽生えさえ見られなかったでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930502
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 731930502,
					"content": "こうなると知っていたら…種よりも、本を持ってくるべきでしたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930503,
						731930519
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 731930503,
					"content": "#{M#君}{F#あなた}は地元の人間じゃないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930504
					]
				},
				{
					"id": 731930504,
					"content": "意外でしたか？私もうまく馴染んだものでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930505
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 731930505,
					"content": "初めてここに来たときは、衣食住の習慣に一切慣れることができませんでしたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930506
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 731930506,
					"content": "でも時が経つにつれ、だんだんと受け入れられるようになりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930507
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 731930507,
					"content": "でも表面上慣れただけでは、心もこの状況を受け入れたとは言えません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930508
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 731930508,
					"content": "スメールシティに咲き誇るローズだってそうでしょう？ここでは到底咲くことができない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930509
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 731930509,
					"content": "#{M#君}{F#あなた}は学者なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930510
					]
				},
				{
					"id": 731930510,
					"content": "ええ…そう呼ばれていましたわ。でも、今は違います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930511
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 731930511,
					"content": "私は学者としてふさわしくないことを口にし、この立場で知ってはならない知識を知ってしまいました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930512
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 731930512,
					"content": "これは教令院の禁忌に触れることです。だから、私は学者ではなくなりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930513
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 731930513,
					"content": "どういうこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930514
					]
				},
				{
					"id": 731930514,
					"content": "好奇心は知恵を求める原動力であると同時に、罪の源でもあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930515
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 731930515,
					"content": "ここに追放された後、わかりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930516
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 731930516,
					"content": "貴方の身のために、詳しくは申し上げない方がよろしいでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930517
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 731930517,
					"content": "わかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930518
					]
				},
				{
					"id": 731930518,
					"content": "コホン、でも…その…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930535
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 731930535,
					"content": "冒険者はせわしない方だと思っていましたわ。一度手伝っていただいた後は、もう戻っていらっしゃらないかもしれないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930536
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 731930536,
					"content": "まさか、こんなにお話ができるなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930537
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 731930537,
					"content": "その…ここで、心を開いてお話しできるお友達は少ないのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930538
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 731930538,
					"content": "今後も…この子たちに肥料を…与えに来て下さる時間はありますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930539
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 731930539,
					"content": "あるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930540
					]
				},
				{
					"id": 731930540,
					"content": "では…お待ちしております。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 731930519,
					"content": "どうしてスメールローズを育てるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930520
					]
				},
				{
					"id": 731930520,
					"content": "ご存じないかもしれませんが、スメールローズという植物には様々な用途があるのですわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930521
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 731930521,
					"content": "食用にも薬用にもなり、プレゼントとしても高い経済的価値があります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930522
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 731930522,
					"content": "ですが、これらは日常生活においての普通の用途に過ぎません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930523
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 731930523,
					"content": "スメールローズの花と葉っぱ、茎はずっと今の形だったわけではありません。昔は別の形をしていたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930524
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 731930524,
					"content": "地理条件の変化が、スメールローズに形態特徴の変化を促したと、私は考えていますわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930525
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 731930525,
					"content": "その形態の進化からは、歴史や地理の情報を沢山読み取れます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930526
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 731930526,
					"content": "これは一言や二言で説明できるお話ではありませんし、通りすがりの冒険者に説明するものではないかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930527
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 731930527,
					"content": "もし植物の進化に興味がお有りなのでしたら、教令院に行ってくださいませ。植物学の教育環境がもっと整っていますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930528
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 731930528,
					"content": "研究のためだったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930529
					]
				},
				{
					"id": 731930529,
					"content": "私はもはや学者ではありませんから、研究ができる条件も資格も持ち合わせておりません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930530
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 731930530,
					"content": "強いて言うなら…はぁ、貴方は好奇心旺盛なのですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930531
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 731930531,
					"content": "…昔の住まいでは沢山のスメールローズを栽培していましたわ。美しく咲く姿を、毎日みることができた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930532
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 731930532,
					"content": "出来ることなら、昔のように、毎日見られたらいいのにと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930533
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 731930533,
					"content": "…ただそれだけです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930534
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 731930534,
					"content": "理解できる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930535
					]
				}
			]
		},
		{
			"id": 7320301,
			"completionStepIds": [
				7320301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320301",
							"2"
						],
						"stepId": 7320301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"サバーフ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732030101,
					"content": "来てくださったのですね…約束通りですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030102
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030102,
					"content": "バターチキンを作りましたの。お腹が空いていらっしゃるようでしたら、座って食べてくださいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030103
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030103,
					"content": "バターチキン！やった！オイラは大盛りで！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030104,
						732030105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732030104,
					"content": "パイモン、遠慮なさすぎ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030106
					]
				},
				{
					"id": 732030106,
					"content": "うぅ…ごめん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732030107,
					"content": "大丈夫ですよ、遠慮なさらないでください。食べ物が好きなのは当たり前のことですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030108
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030108,
					"content": "あとで料理を温めて包んで差し上げますね。手伝ってくださったお礼です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030109
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030109,
					"content": "うわぁ、サバーフさんっていい人だな！ローズも、絶対願い通りに成長すると思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732030110,
					"content": "フフ、この頃はずっと土の湿っぽさを保っていましたから、幼苗の状態はいい感じになっているはずですわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030111
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030111,
					"content": "ただ、成長の速度が少し遅くて心配なんですけれど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030112
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030112,
					"content": "普通は、胚芽の状態が良ければすぐ芽生えるはずなのです。でも未だに何も生えてこないものがいくつかあって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030113
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030113,
					"content": "土に肥料がうまく浸透していないせいかもしれません。このまま行くと、外からまた肥料を施さないといけませんね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030114,
						732030115
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030114,
					"content": "もう一回肥料をやろう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030116
					]
				},
				{
					"id": 732030116,
					"content": "では、お手数ですがまたお願いできますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030117
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030117,
					"content": "楽勝楽勝、任せてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732030115,
					"content": "草元素の力で試してみよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030116
					]
				},
				{
					"id": 732030105,
					"content": "ごめん。パイモンはいつもこうなんだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030106
					]
				}
			]
		},
		{
			"id": 7320303,
			"completionStepIds": [
				7320303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320303",
							"2"
						],
						"stepId": 7320303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"サバーフ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732030301,
					"content": "今日もありがとうございます。ここでスメールローズの成長を見守ることができて、とても嬉しいですわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030302
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030302,
					"content": "サバーフと話している間、いくつかの若葉が古い葉の間から生えてきた…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732030303
					]
				},
				{
					"id": 732030303,
					"content": "若葉はだんだん広がっていき、やがて小さな蕾をつけた…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732030304
					]
				},
				{
					"id": 732030304,
					"content": "蕾はゆっくりと綻び、サバーフが植えたスメールローズは、ようやく花を咲かせた。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732030305
					]
				},
				{
					"id": 732030305,
					"content": "彼女はスメールローズを一輪摘み取り、あなたとパイモンに手渡した。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732030306
					]
				},
				{
					"id": 732030306,
					"content": "これは受け取れないぞ。サバーフさんが育てたローズは多くないのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732030307,
					"content": "いいのですわ。貴方たちの助けがなければ、このスメールローズたちはここで咲くことができなかったでしょうから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030308,
						732030309
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030308,
					"content": "微力だけど役に立てて良かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030310
					]
				},
				{
					"id": 732030310,
					"content": "ローズの花園も壮観で素敵ですが、一輪のローズにも独自の美しさがあります。私は学者だった頃から、ローズに興味を持っておりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030311
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030311,
					"content": "え？サバーフって学者だったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732030312,
					"content": "ええ。まだパイモンにはお伝えしていませんでしたね。私はアアル村で生まれ育った住民ではなく、教令院から…「引っ越し」てきましたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030313
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030313,
					"content": "だからだったか。サバーフさんの話し方は優雅で、学者っぽいと思ったぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030314
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732030314,
					"content": "わかったぞ。サバーフはローズを引き続き研究したくて、これを植えたんだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030315
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732030315,
					"content": "それは少し違いますわ。研究対象に対する興味というのは、研究するために湧いてくるものではありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030316
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030316,
					"content": "この世界が好きだからこそ、この世界を、草木の命の軌跡をもっと知りたいと思うのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030317
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030317,
					"content": "私は——スメールの地理環境の変遷がローズの品種形態に与える影響を研究していましたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030318
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030318,
					"content": "考えてみてくださいませ。もしスメールの地理環境の変遷の方向性が今と全然違っていたら、自然環境に適応するために、ローズはどのような形態に変化していたのでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030319
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030319,
					"content": "つる植物になったでしょうか？もしそうだったら、今日の教令院の壁にはローズがいっぱい生えていたかもしれませんね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030320
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030320,
					"content": "それとも群生する花になったでしょうか？一気に大きな束になって生えれば、さぞ立派でしょうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030321
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030321,
					"content": "あるいは、様々な色があったかもしれません。白、赤、金色…それは真新しい品種になったことでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030322
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030322,
					"content": "もちろん、今はこういった新しい品種を発見できる人はあまりおりません。昔のトップレベルの学者のように、新しい品種を栽培することなんて、尚更難しいでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030323
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030323,
					"content": "つまり私が言いたかったのは、一輪一輪のローズには大きな可能性が秘められている、ということですわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030324
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030324,
					"content": "そういった可能性を探るのは楽しいことです。あの頃は毎日興味津々で、楽しく標本を集めていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030325
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030325,
					"content": "今思い返せば、純粋で楽しい時間でしたね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030326
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030326,
					"content": "とにかく、それは貴方たちが持っていてくださいな。これは私にとって損ではなく、楽しい共有なのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030327
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030327,
					"content": "それでも納得できないと言うのなら、今度また、スメールローズを持ってきてくださいませ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030328
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030328,
					"content": "貴方たちとお話しするのは、とても気が楽です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030329
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030329,
					"content": "何を話しても、「余計な話」だと、話を遮られることもありませんから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030330
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030330,
					"content": "貴方たちに小さなプレゼントを差し上げますわ。今の私にとっては使えない代物ですが、貴方たちなら気に入ってくださるかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030331
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030331,
					"content": "また来るよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030332
					]
				},
				{
					"id": 732030332,
					"content": "ええ、また来てくださいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030309,
					"content": "どうってことない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030310
					]
				}
			]
		},
