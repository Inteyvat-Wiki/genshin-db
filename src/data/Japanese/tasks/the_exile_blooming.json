			"dialogs": [
				{
					"id": 732030401,
					"content": "神の目を持っているようには見えませんのに、草元素の力が使えるということは、普通の冒険者ではないのでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030402
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030402,
					"content": "ある人々は神の目の力を借りなくても元素力が使えますが、いい噂は聞きません。貴方は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030403
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030403,
					"content": "とにかく、貴方は優しくて良い方です。決して道を踏み外さないでくださいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "サバーフ"
				}
			]
		}
	]
}