				"points": []
			},
			"dialogs": [
				{
					"id": 721320101,
					"content": "協力ありがとう。島はまだ危ないが、お前のおかげで故郷を離れた人々に少し希望を与えられた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320102
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721320102,
					"content": "大雨が止み、戦争の両陣営がさらにこの島の奪い合いに積極的になることだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320103
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721320103,
					"content": "しかし、彼らが島の状況を変える可能性がない以上、俺たちのしたことは無駄じゃない、放置して悪化させるよりもマシだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320104
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721320104,
					"content": "それじゃあ前に話したお礼だ、受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320105
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721320105,
					"content": "これは何百年も前にヤシオリ守り様が使っていた名槍…この絵がお前の役に立つかは分からない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320107
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721320107,
					"content": "だけどこれを手練れの職人に持っていけば、喜多院様の英姿を再現できるかもしれない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320108
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721320108,
					"content": "はぁ、今はもう英雄の時代ではない、かつて無数の魔を滅ぼした喜多院様も二度と戻ってはこない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320109
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721320109,
					"content": "だがお前の協力のおかげで、喜多院様の功績に…少しは近づいたように思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320110
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721320110,
					"content": "これから幕府軍の友人のところへ、何か手伝えることがないか見に行く。縁があればまたいつか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "梶"
				}
			]
		},
