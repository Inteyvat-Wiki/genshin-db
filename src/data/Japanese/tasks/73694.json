			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ダナ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736940101,
					"content": "うーん、なんで皆くたびれた顔をしてるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940102
					],
					"speakerTitle": "ダナ"
				},
				{
					"id": 736940102,
					"content": "ここで何かイベントをやってるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736940103
					]
				},
				{
					"id": 736940103,
					"content": "君は…旅人だな？ハハハ、ご高名はかねがね伺ってるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940104
					],
					"speakerTitle": "ダナ"
				},
				{
					"id": 736940104,
					"content": "そうとも。ヴァフマナ学院では、ただいま「考古」に関するミニゲームを開催中だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940105
					],
					"speakerTitle": "ダナ"
				},
				{
					"id": 736940105,
					"content": "なにせ、我が学院には歴史を研究している学者たちが多いからね。そして研究の過程で、自ら「考古」の旅に赴くこともよくある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940106
					],
					"speakerTitle": "ダナ"
				},
				{
					"id": 736940106,
					"content": "ああ、そう硬くならないでくれ。君たちを考古の旅に行かせようってわけじゃない。今回のイベントでは、ただ考古という「行動」を真似るだけなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940107
					],
					"speakerTitle": "ダナ"
				},
				{
					"id": 736940107,
					"content": "私たちは予め、スメールシティ周辺に「文物模型」を多数埋めておいたんだ…それらを埋めた場所を、とりあえず「考古エリア」と呼ぼう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940108
					],
					"speakerTitle": "ダナ"
				},
				{
					"id": 736940108,
					"content": "イベント参加者は、私たちが特別に製作した探査機を使って、「考古エリア」に埋められた「文物模型」を発掘すればいいのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940109
					],
					"speakerTitle": "ダナ"
				},
				{
					"id": 736940109,
					"content": "他の学院の学生たちも、特製の容器や探査機の製作に協力してくれたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940110
					],
					"speakerTitle": "ダナ"
				},
				{
					"id": 736940110,
					"content": "旅人、どうだ、興味があれば試してみないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940111,
						736940112
					],
					"speakerTitle": "ダナ"
				},
				{
					"id": 736940111,
					"content": "そんなに難しくなさそう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736940113
					]
				},
				{
					"id": 736940113,
					"content": "ハハハ、よし！この探査機を渡そう。「考古エリア」の場所は<color=#00E1FFFF>考古マニュアル</color>に記してあげるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940114
					],
					"speakerTitle": "ダナ"
				},
				{
					"id": 736940114,
					"content": "これで準備万端だ。旅人、さっそく考古学の醍醐味ってやつを味わってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940115
					],
					"speakerTitle": "ダナ"
				},
				{
					"id": 736940115,
					"content": "すべての「文物模型」を見つけられたなら、忘れずに報酬を受け取りに来てくれよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940116
					],
					"speakerTitle": "ダナ"
				},
				{
					"id": 736940116,
					"content": "模型を探す時は探査機に従えばいい。見分けやすいよう、元素タイプで区別してあるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940117
					],
					"speakerTitle": "ダナ"
				},
				{
					"id": 736940117,
					"content": "ただ…これらの探査機は、本来は元素を測定するための機器をとりあえず改造したものなんだ。特定の元素の影響を受けやすい可能性もある…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940118
					],
					"speakerTitle": "ダナ"
				},
				{
					"id": 736940118,
					"content": "とにかく、全ての「文物模型」を発掘できたら、魅力的な報酬がもらえるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ダナ"
				},
				{
					"id": 736940112,
					"content": "試してみてもよさそう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736940113
					]
				}
			]
		}
	]
}