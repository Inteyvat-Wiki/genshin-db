			"dialogs": [
				{
					"id": 718120201,
					"content": "どう？何か見つけた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718120202
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 718120202,
					"content": "これを見つけた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718120203
					]
				},
				{
					"id": 718120203,
					"content": "これは…こんなの見たことないわ。どこで見つけたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718120205
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 718120205,
					"content": "遁玉の丘の近くで…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718120206
					]
				},
				{
					"id": 718120206,
					"content": "遁玉の丘？どうしてそこにこんなものが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718120207
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 718120207,
					"content": "手がかりを解いてくれてありがとう。冒険者ルールに則って、これはあなたのものよ。あと報酬も受け取ってちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718120208
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 718120208,
					"content": "早急に人員を集めて、遁玉の丘へ調査を手配するわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718120209
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 718120209,
					"content": "おかしいわね…遁玉の丘一帯は何度も調査したはずなのに、まだ見落としていた場所があったなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嵐姉"
				}
			]
		},
