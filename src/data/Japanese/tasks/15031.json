			"dialogs": [
				{
					"id": 150310201,
					"content": "ここはよく通る道なんだけど、休憩してる溶岩の像を見かけることがあるんだよねぇ～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310202
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150310202,
					"content": "すごい高温のコアを持ってるはずだから、それが使えると思うんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310203
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150310203,
					"content": "みんなこんなに協力してくれるなんて思わなかったぞ。口にしてなかっただけで、キノコのこと不思議に思ってはいたんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150310204,
					"content": "うん。それにきみたちのおかげだよ。今までキノコを食べた人は山ほどいたけど、お話しできたのは初めてだったからねぇ～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310205
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150310205,
					"content": "ま、そうだよな…調べようにも、どこから手を付けていいのか見当もつかないだろうし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150310206,
					"content": "だから今回はまたとないチャンスなの。それに、あの「キノコの賢主」もなんだか偉そうな物言いで、みんな負けてられないって思ったんじゃないかなぁ～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310207
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150310207,
					"content": "「豊穣の邦」の人はみんな負けず嫌いだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310208
					]
				},
				{
					"id": 150310208,
					"content": "だな。でも、ヴァレサはのんびりしてるように見えるぞ。スポーツとか戦闘になるとまた違うのかもしれないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150310209,
					"content": "そだね…わたし、争いごとって好きじゃないし、勝ち負けをあんまり気にしないタイプだから。毎日楽しく過ごせるだけで十分なんだぁ～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310210
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150310210,
					"content": "そんなわたしに、イアンサコーチはいろんなことを教えてくれたの。「力は目的じゃなく手段だ」とか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310211
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150310211,
					"content": "アビスが攻めてきたとき、もし普段から鍛えてなかったら、元素力をコントロールできるようになってなかったら、ただ魔物が暴れるのを見てることしかできなかったと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310212
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150310212,
					"content": "どんなに怖くても、勇気を出してみんなを守らなきゃって思ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310213,
						150310214
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150310213,
					"content": "そうだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310215
					]
				},
				{
					"id": 150310215,
					"content": "ありがとう。どんどん勇敢になって、わたしフィエテナさまみたいになるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310216
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150310216,
					"content": "行こっか、歩きながら探そ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150310214,
					"content": "ヴァレサって強いんだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310215
					]
				}
			]
		},
