			},
			"dialogs": [
				{
					"id": 150310401,
					"content": "すごい収穫だな！遊像の眼がたくさん手に入ったし、それに火を噴くようなやつまであるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150310402,
					"content": "うん。それは「マグマイタチ」の鱗甲だね。燃素を噴射できるから、びゅんびゅん動けるんだよ～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310403
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150310403,
					"content": "昔お父さんから教わったんだけど、普段は火山の中に住んでる生き物なんだって。こうして出会えたのはとってもラッキーなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310404
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150310404,
					"content": "この鱗甲、もしかしたら遊像の眼よりも高温を出せるかも。へへっ、これで十分そうだねぇ～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310405
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150310405,
					"content": "すごくいい戦いぶりだったよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310406
					]
				},
				{
					"id": 150310406,
					"content": "あはは…どんなに戦いたくないと思ってても、ちゃんと意識を切り替えられるよう、いろんな方法を考えたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310407
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150310407,
					"content": "わたし、いろんな英雄のお話を読むのが好きなんだけど、前にも言ったように一番好きなのがフィエテナさまでね——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310408
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150310408,
					"content": "そのトレードマークが仮面だったから、物語の描写を参考に同じようなものを作ったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310409
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150310409,
					"content": "仮面をつけて、わたし自身がフィエテナさまになったって信じ込むとね、その顔に泥を塗るわけにはいかないってなって、勇気が湧いてくるんだぁ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310410
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150310410,
					"content": "でも、これじゃあフィエテナさまの後ろに隠れてるみたいだよね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310411
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150310411,
					"content": "なるほどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310412,
						150310413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150310412,
					"content": "でも効果はある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310414
					]
				},
				{
					"id": 150310414,
					"content": "本当？けど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310415
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150310415,
					"content": "いつかは仮面を外して、自分に向き合わなきゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310416
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150310416,
					"content": "ただ、その一歩がなかなか踏み出せないの。気づくと、またこの仮面の力に頼っちゃう…わたし、この先もずっとそうなんじゃないかって不安で…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310417,
						150310418
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150310417,
					"content": "でもキノコの調査を決心したのは自分だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310419
					]
				},
				{
					"id": 150310419,
					"content": "そうそう！決めたのは他でもない、ヴァレサ自身だろ！勇気ある決断こそが冒険では大切なことなんだ。戦うのなんて冒険の一部に過ぎないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310420
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150310420,
					"content": "そうなんだね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310421
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150310421,
					"content": "ヴァレサはもう十分前に進めてるぜ。焦らなくて大丈夫だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310422
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150310422,
					"content": "うん。いつも励ましてくれてありがとう。それにいろいろ教えてくれるし、二人には感謝してもしきれないよ～！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310423
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150310423,
					"content": "よぉ～し！もっともっと成長して、英雄の名前に隠れず、自分の名前と向き合えるようになってみせる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310424
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150310424,
					"content": "ふぅ～気分がスッキリしたら、なんだかお腹が空いてきちゃった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310425
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150310425,
					"content": "えっ、もうか！？オイラまだ消化できてないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310426
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150310426,
					"content": "それじゃ「豊穣の邦」に帰ろっか～！今度こそ「キノコの賢主」の条件を満たせるはずだよ～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150310418,
					"content": "その仮面じゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310419
					]
				},
				{
					"id": 150310413,
					"content": "恥ずかしいことなんかじゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310414
					]
				}
			]
		}
	]
