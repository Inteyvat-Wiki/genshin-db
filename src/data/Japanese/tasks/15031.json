			"dialogs": [
				{
					"id": 150310101,
					"content": "アカトル族長が皆を集めた後、ヴァレサがキノコ調査で分かったことを話した。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150310102
					]
				},
				{
					"id": 150310102,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310103
					],
					"speakerTitle": "アカトル"
				},
				{
					"id": 150310103,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310104
					],
					"speakerTitle": "アトリー"
				},
				{
					"id": 150310104,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310105
					],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 150310105,
					"content": "オイラたちが調査してたときは気にしなかったけど、あらためて聞くとだいぶめちゃくちゃな話だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150310106,
					"content": "このなんとも言えない沈黙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310107
					]
				},
				{
					"id": 150310107,
					"content": "なるほどな、果樹園のキノコたちにも意識があったとは、すごい発見じゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310108
					],
					"speakerTitle": "アカトル"
				},
				{
					"id": 150310108,
					"content": "ああ、アンタたちが調査してくれてなかったら、とんでもないことになってたかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310109
					],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 150310109,
					"content": "気づいてくれてありがとな！手がかりもこんなにたくさん集めてくれてよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310110
					],
					"speakerTitle": "ショクトリ"
				},
				{
					"id": 150310110,
					"content": "よかったぁ～…みんな信じてくれた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310111
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150310111,
					"content": "まあ、変な話ではあるがな。キノコと話すなんて、誰もしたことがない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310112
					],
					"speakerTitle": "アカトル"
				},
				{
					"id": 150310112,
					"content": "だが、ヴァレサが嘘をつくような子じゃないのはみんな知ってる。それに緑のキノコ自体、オレたちも謎に思ってた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310113
					],
					"speakerTitle": "アカトル"
				},
				{
					"id": 150310113,
					"content": "悪い兆しが見つかった以上、調査を手伝うぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310114
					],
					"speakerTitle": "アカトル"
				},
				{
					"id": 150310114,
					"content": "何か力になれることがあったら、遠慮なく言ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310115
					],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 150310115,
					"content": "こんなあっさり受け入れてもらえるなんて！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150310116,
					"content": "ありがとう、みんな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310117
					]
				},
				{
					"id": 150310117,
					"content": "さっき高温でキノコを調理する必要があるって言ってたな。ちょっと待っててくれ、さっそく用意しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310118
					],
					"speakerTitle": "アトリー"
				},
				{
					"id": 150310118,
					"content": "——待たせたな！鉄板で焼いてみたぞ、この温度なら十分だろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310119
					],
					"speakerTitle": "アトリー"
				},
				{
					"id": 150310119,
					"content": "わぁ、やっぱりすごくいい匂いだな。オイラの食欲も完全復活だぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150310120,
					"content": "じ、じゃあ…いただきます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310121
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150310121,
					"content": "ほほう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310122
					],
					"speakerTitle": "ビフロンス"
				},
				{
					"id": 150310122,
					"content": "聞こえたか？あいつの声だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150310123,
					"content": "ハーッハッハッハ、少しは分かってきたようだな。だが、この程度の温度で誠意は示せぬぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310124
					],
					"speakerTitle": "ビフロンス"
				},
				{
					"id": 150310124,
					"content": "そこらの家で出せる火力と、どこにでもある道具でササッと作っただけではないか。それでこの「キノコの賢主」に認めてもらえると？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310125
					],
					"speakerTitle": "ビフロンス"
				},
				{
					"id": 150310125,
					"content": "人間というのは実に情けない。手がかりを与えてやれば難問も解けるが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310126
					],
					"speakerTitle": "ビフロンス"
				},
				{
					"id": 150310126,
					"content": "それがなくなった途端、何もできない。こんな方法で上手くいくと思ったか？まさに愚の骨頂なり！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310127
					],
					"speakerTitle": "ビフロンス"
				},
				{
					"id": 150310127,
					"content": "もっと工夫することだ、フハハハハッ…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310128
					],
					"speakerTitle": "ビフロンス"
				},
				{
					"id": 150310128,
					"content": "ど、どうだ？声は聞こえたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310129
					],
					"speakerTitle": "アトリー"
				},
				{
					"id": 150310129,
					"content": "うわ…やっぱりヤなやつだったな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310130
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150310130,
					"content": "温度が足りないんだってよ。面倒くさいなぁ、もう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310131,
						150310132
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150310131,
					"content": "でも何を企んでるのかを知るためには…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310133
					]
				},
				{
					"id": 150310133,
					"content": "火力を上げるとなると、もっと別の方法を探す必要があるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310134
					],
					"speakerTitle": "アカトル"
				},
				{
					"id": 150310134,
					"content": "みんな聞いたか！なんでもいいから、とにかく熱いもんを持ってきてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310135
					],
					"speakerTitle": "アカトル"
				},
				{
					"id": 150310135,
					"content": "ああ、何とかできないか考えてみよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310136
					],
					"speakerTitle": "アトリー"
				},
				{
					"id": 150310136,
					"content": "任せてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310137
					],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 150310137,
					"content": "わたしたちも探しに行こっか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310138
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150310138,
					"content": "そうだな！でもオイラたち、まだこの辺りのことをあまり知らないから…ヴァレサはなにかいいアイデアないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310139
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150310139,
					"content": "う～ん…具体的には思いつかないけど、火山の近くを探してみるのはどうかなぁ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310140
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150310140,
					"content": "火山はいつもいろんなものを噴き出してるから、何かいいものが混じってるかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310141
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150310141,
					"content": "よし、じゃあ行ってみようぜ！熱々の素材を見つけて、絶対にあの性悪キノコの顔面に投げつけてやるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150310132,
					"content": "付き合ってあげるしかない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310133
					]
				}
			]
		},
