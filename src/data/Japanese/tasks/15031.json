			"dialogs": [
				{
					"id": 150310301,
					"content": "よぉーし、解決！うんうん、いい感じだねぇ。ほら見て、中の燃素も元気いっぱいだよ～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310302
