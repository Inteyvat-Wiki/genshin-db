			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"朝霧"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 725010201,
					"content": "森子さんって、なんでいつもこんな変な依頼を渡すんだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010202,
						725010203
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 725010202,
					"content": "まだ挿し絵を書いてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010204
					]
				},
				{
					"id": 725010203,
					"content": "またアイデアがなくなったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010204
					]
				},
				{
					"id": 725010204,
					"content": "あれ！？旅人、どうしてここに？だいぶ会ってなかったから、もう他の場所へ旅に出たのかと思ったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010205
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 725010205,
					"content": "はぁ…私の体がもう少し元気だったら、君のように旅へ出たのにな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010206
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 725010206,
					"content": "そうすれば、毎日森子さんと顔を合わせて催促されることもないのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010207
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 725010207,
					"content": "以前、描いた原稿が好評だったんだ。たくさんの先生が私を指名して、挿し絵を描いて欲しいって言ってるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010230
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 725010230,
					"content": "森子さんのほうで結構依頼を断ってくれたんだ。でも、まだ残っているものも多くて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010209
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 725010208,
					"content": "その上、「八重堂」の先生たちが書く小説の題材が…ますます大きくなってて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010209
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 725010209,
					"content": "はじめは稲妻以外だと、せいぜいモンドや璃月のことを書くくらいだったのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010210
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 725010210,
					"content": "今では先生たちの書く題材が…スメールまで足を伸ばしてるの。しかも、フォンテーヌにも目を付けてるみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010216
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 725010216,
					"content": "それで…本題に戻るとして……旅人、あの「写真機」ってまだ使えるよね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010217,
						725010218
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 725010217,
					"content": "まだ使えると思う…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010219
					]
				},
				{
					"id": 725010218,
					"content": "また写真を撮って欲しいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010219
					]
				},
				{
					"id": 725010219,
					"content": "ほら、この間の私の報酬って悪くなかったでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010220
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 725010220,
					"content": "だから旅人、もう一回世界各地を回って、写真を撮って来てほしいの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010221,
						725010224
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 725010221,
					"content": "うん、任せて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010222
					]
				},
				{
					"id": 725010224,
					"content": "冒険者協会に依頼を出して…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010225
					]
				},
				{
					"id": 725010222,
					"content": "じゃあ、君に任せたよ！へへっ、実はもう帳面を用意しておいたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010223
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 725010223,
					"content": "もし君が来てくれなかったら、森子さんに頼んで探してもらうところだったよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "朝霧"
				},
				{
					"id": 725010225,
					"content": "えぇっ！待って！お願い、お願いだよ！冒険者協会に依頼を出したことはあるけど、写真機を使いこなせる冒険者が見つからないの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010226
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 725010226,
					"content": "旅人、私を助けると思ってさ。もし原稿を出せなかったら、森子さんがまた私と一緒に住むことになっちゃう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010227
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 725010227,
					"content": "彼女が作る緋櫻茶漬けとか、本当に無理なの。旅人！私を助けてよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010228
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 725010228,
					"content": "わ、分かった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010229
					]
				},
				{
					"id": 725010229,
					"content": "ふぅ…よかった。ちょっと待っててね、帳面を探すから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "朝霧"
				}
			]
		}
	]
}