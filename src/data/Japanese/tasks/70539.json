					}
				]
			},
			"dialogs": [
				{
					"id": 705390101,
					"content": "ん？マーガレットのやつ、話し中みたいだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705390102,
					"content": "待てよ…あれ、ロサリアじゃないか？隣にいるのは冒険者か？会ったことないやつみたいだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390103,
						705390104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705390103,
					"content": "ロサリアも猫と遊びに来たの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705390105
					]
				},
				{
					"id": 705390105,
					"content": "分かったわ、ヴァレリナ。ヴィクトリアに言われた通り、引き続き手を貸してあげるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390106
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 705390106,
					"content": "猫の様子をチェックしたり、お風呂に入れたりするぐらい、なんてことないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390107
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 705390107,
					"content": "でも、肝心な問題はまだ解決してませんよ、ロサリアさん！私たちがずっと、二人とも猫ちゃんと仲良くなれずにいたら…いつまで経っても猫ちゃんはみんな緊張しっぱなしです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390108
					],
					"speakerTitle": "ヴァレリナ"
				},
				{
					"id": 705390108,
					"content": "そのせいで猫ちゃんが病気にでもなったら…「ネコモコの城」は開業早々潰れちゃいますよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390109
					],
					"speakerTitle": "ヴァレリナ"
				},
				{
					"id": 705390109,
					"content": "焦ったってしょうがないじゃない。仲良くなれないのは客観的事実であって、私にどうこうできる問題じゃないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390110
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 705390110,
					"content": "よう、ロサリア！それから、そっちは初めまして！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705390111,
					"content": "なにか悩み事でもあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705390112,
					"content": "ネコネコ救世主様！こんなに早く現れてくださるとは！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390113
					],
					"speakerTitle": "ヴァレリナ"
				},
				{
					"id": 705390113,
					"content": "うわっ…いきなり救世主様だなんて、びっくりしたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390114,
						705390115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705390114,
					"content": "様呼びには、それなりの責務が付きもの。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705390116
					]
				},
				{
					"id": 705390116,
					"content": "かいつまんでお話ししますね！私はヴァレリナと申します。動物が大好きで、野良猫の専門的な保護施設——名付けて「ネコモコの城」を築こうと、今全力で取り組んでいるところなんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390117
					],
					"speakerTitle": "ヴァレリナ"
				},
				{
					"id": 705390117,
					"content": "行き場のない子たちを保護すれば、みんなを不幸な運命から救い出せますし、モンドのイメージアップや生態環境の改善にも寄与できて…まさに一石二鳥です！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390118
					],
					"speakerTitle": "ヴァレリナ"
				},
				{
					"id": 705390118,
					"content": "そこで教会のシスターたちに相談したところ、私をサポートするために、優しいロサリアさんを派遣してくださいました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390119
					],
					"speakerTitle": "ヴァレリナ"
				},
				{
					"id": 705390119,
					"content": "別に優しいからじゃなくて、ヴィクトリアに頼まれたからよ。医学をかじったことがある暇なシスターは、私しかいなかったってだけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390120
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 705390120,
					"content": "なかなかやり手の冒険者だな。理路整然としてて、まとめ方が上手かったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705390121,
					"content": "それで、おまえたちが悩んでるのは…モラが足りないからか？それとも、他になにか足りないものでもあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705390122,
					"content": "モラなら十分あります！それに、敷地や関連する物資、規定に則った手続きにもまったく問題はありません！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390123
					],
					"speakerTitle": "ヴァレリナ"
				},
				{
					"id": 705390123,
					"content": "なのですが…えーっと…その…私、猫ちゃんたちに猫パンチされちゃうんです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390124
					],
					"speakerTitle": "ヴァレリナ"
				},
				{
					"id": 705390124,
					"content": "どんな姿勢で近づいても、威嚇されちゃって…食べ物を持って試してもダメでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390125
					],
					"speakerTitle": "ヴァレリナ"
				},
				{
					"id": 705390125,
					"content": "私も猫たちに怖がられてるみたい。私が近づくと、逃げちゃうのよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390126
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 705390126,
					"content": "うーん、生まれつき、猫に避けられちゃう体質の人がいるっていうのは聞いたことあるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705390127,
					"content": "でも、猫の保護活動をしようとしてるのに、猫と仲良くなれなかったら…保護施設の運営どころか、キャッツテールに来るのでさえ、ハードルが高いんじゃないのか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705390128,
					"content": "ええ…それでその方面の専門家に相談しに来たんですが、マーガレットさんもこれと言ったコツは思いつかないそうで…だからと言って、お店の人手をこちらに割いていただけるほどの余力もないみたいです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390129
					],
					"speakerTitle": "ヴァレリナ"
				},
				{
					"id": 705390129,
					"content": "でも、こうも言ってくださいました。「困ったときは、栄誉騎士と白い助手さんに頼めば、なんとかしてくれるわよ！」って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390130
					],
					"speakerTitle": "ヴァレリナ"
				},
				{
					"id": 705390130,
					"content": "まさか、そんなところへちょうど来てくださるなんて、思ってもみませんでした。お二人はまるでバルバトス様が派遣してくださった使者…救世主です！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390131
					],
					"speakerTitle": "ヴァレリナ"
				},
				{
					"id": 705390131,
					"content": "バルバトスに猫の世話についての知識があるかどうかはさておき…オイラたちも保護施設の運営経験なんてないぞ。急に救世主だなんて言われても…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390132,
						705390133
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705390132,
					"content": "ちょうどよかったかも？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705390134
					]
				},
				{
					"id": 705390134,
					"content": "たしかにそうだな！猫と仲良くするってことなら、オイラ自信があるぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390135
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705390135,
					"content": "そう考えると、おまえらの悩みも別に難しくなさそうだな。ヴァレリナとロサリアに、どうやれば猫と仲良くできるのか、見せてやればいいんだろ？安心して任せろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390136
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705390136,
					"content": "私は別にいいから、ヴァレリナにたっぷり教えてあげて。治療が必要な子がいたら、また呼んでちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390137
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 705390137,
					"content": "とにかく、君たちが保護施設を問題なく運営してくれるのなら、私が手を貸すまでもないわけで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390138
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 705390138,
					"content": "そんなに暇そうな仕事なら、引き続き関わってもいいわ。教会の行事よりは、よっぽど楽みたいだし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390139
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 705390139,
					"content": "おい、教会の仕事をサボりたいだけじゃないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390140
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705390140,
					"content": "ではさっそく、「ネコモコの城」までご案内しますね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴァレリナ"
				},
				{
					"id": 705390133,
					"content": "元々猫と遊びたいと思ってたし。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705390134
					]
				},
				{
					"id": 705390115,
					"content": "こういう時は、ぜったい依頼がある！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705390116
					]
				},
				{
					"id": 705390104,
					"content": "カードゲームをしに来たの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705390105
					]
				}
			]
		},
		{
			"id": 7053902,
