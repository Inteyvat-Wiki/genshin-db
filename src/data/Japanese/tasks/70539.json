					}
				]
			},
			"dialogs": [
				{
					"id": 705390201,
					"content": "「城」って名前なのに…なんの変哲もない普通の家だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705390202,
					"content": "これでも、街にある空き家の中では一番大きな物件なんですよ。家賃もさほど高くないし…キャッツテール風の内装一式の費用と半年分の家賃を合わせて、たったの数百万モラで済みました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390203
					],
					"speakerTitle": "ヴァレリナ"
				},
				{
					"id": 705390203,
					"content": "計画では、健康状態のいい猫ちゃんについては、引き取り許可証を発行する予定なんです。もし、責任をもって世話をすると約束できる方が現れれば、相性の合う子を連れて帰ってもらう、という流れにしようと思っていて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390204
					],
					"speakerTitle": "ヴァレリナ"
				},
				{
					"id": 705390204,
					"content": "なので、今の敷地でも十分賄えると思います。今後事業が拡大すれば、野良犬や他の困っている野生動物たちだって保護できるかもしれません！そうなったら、施設名を「モコモコの城」にしたいと思ってるんです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390205
					],
					"speakerTitle": "ヴァレリナ"
				},
				{
					"id": 705390205,
					"content": "君の計画がうまくいって、猫と相性の合う引き取り人が現れることが前提だけどね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390206
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 705390206,
					"content": "…ん？見ろ！あそこの猫、オイラたちを待ってるみたいだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705390207,
					"content": "はぁ…あの白猫は、すごい人見知りなんです。お風呂に入れるときも、脱走しちゃって…やっとのことで連れ帰ってきました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390208
					],
					"speakerTitle": "ヴァレリナ"
				},
				{
					"id": 705390208,
					"content": "真っ白でふわっふわで、雪で作ったお餅みたいだよな。そうだ、「雪大福」って名付けてやろうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390209,
						705390210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705390209,
					"content": "「豆腐白玉」もいいんじゃない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705390211
					]
				},
				{
					"id": 705390211,
					"content": "ニャー。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390212
					],
					"speakerTitle": "「雪大福」"
				},
				{
					"id": 705390212,
					"content": "へへ、おまえが付けた名前も悪くないけど、やっぱり「雪大福」って名前が気に入ったみたいだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705390213,
					"content": "よう、雪大福。よしよし、いい子だな。雪大福、一緒に遊ぶか？ほら、こっちだぞ～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705390214,
					"content": "ま…まだ出会って一分も経ってないのに、もう猫ちゃんが懐いてるなんて…！ロサリアさん…白い助手さんって、もしかして魔法使いさんなんですか！？ネコネコ白魔法使いさんとお呼びしてもいいですか…！！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390215
					],
					"speakerTitle": "ヴァレリナ"
				},
				{
					"id": 705390215,
					"content": "拾い猫でも、可愛い名前をつけてやって、優しく声をかけてやれば、そのうち懐いてくれるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705390216,
					"content": "ただし、まずは自分の…えっと…あ、そうそう、雰囲気には気をつけないとダメだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390217
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705390217,
					"content": "例えば、ヴァレリナがおどおどしながら近づいたら、猫だって不安になっちゃうだろ。それにロサリア、おまえはもっと表情を…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705390218,
					"content": "拾われた子にも…優しく呼びかければ…運命は、彷徨える命に温かい眼差しを向けてくれる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390219
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 705390219,
					"content": "モンドのこういう雰囲気は、たしかに悪くないわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390220
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 705390220,
					"content": "ニャオン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390221
					],
					"speakerTitle": "「雪大福」"
				},
				{
					"id": 705390221,
					"content": "雪大福がロサリアさんに寄ってきました！もうロサリアさんを怖がってないみたいですよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390222
					],
					"speakerTitle": "ヴァレリナ"
				},
				{
					"id": 705390222,
					"content": "（今、ロサリアのやつ…笑ったよな？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390223,
						705390224
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705390223,
					"content": "#（{M#俺}{F#私}も見たよ！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705390225
					]
				},
				{
					"id": 705390225,
					"content": "別にどうでもいいわ。それより…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390226
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 705390226,
					"content": "部屋がちょっと蒸し暑くなってきたから、風に当たってくるわ。何かあったら呼んでちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390227
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 705390227,
					"content": "あれ？喜ぶと思ったんだけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390228
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705390228,
					"content": "栄誉騎士さん、ネコネコ白魔法使いさん、猫と仲良くするコツを、もっと教えてもらえませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390229
					],
					"speakerTitle": "ヴァレリナ"
				},
				{
					"id": 705390229,
					"content": "これから、もっと多くの野良猫をネコモコの城に迎える予定ですが、みんながみんな雪大福みたいにおとなしいとは限りませんよね…どうやったら仲良くできるか、検討もつかなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390230
					],
					"speakerTitle": "ヴァレリナ"
				},
				{
					"id": 705390230,
					"content": "おう、任せろ。しっかり見てろよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390231
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705390231,
					"content": "次は、より上級の技を教えてやるぜ——猫の機嫌を取る魔法だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390232
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705390232,
					"content": "焦らずに少しずつ猫と触れあって、知り合っていけば、おまえもぜったい猫と仲良くなれるぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390233
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705390233,
					"content": "よく分かりました！今は「ネコモコの城」の事前準備期間ですから、しっかり観察して勉強させていただきます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴァレリナ"
				},
				{
					"id": 705390224,
					"content": "（しーっ、見てないふり！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705390225
					]
				},
				{
					"id": 705390210,
					"content": "もしくは「ミルクプリン」とか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705390211
					]
				}
			]
		}
	]
}