			"dialogs": [
				{
					"id": 700610101,
					"content": "はぁ…またなの？この花畑、どうしていつもこんなことになるのかな…もう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610102
					],
					"speakerTitle": "レオポルディ"
				},
				{
					"id": 700610102,
					"content": "これじゃ、また期日通りに花を届けられないよ。お客さんにどう説明すれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610103
					],
					"speakerTitle": "レオポルディ"
				},
				{
					"id": 700610103,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700610104
					]
				},
				{
					"id": 700610104,
					"content": "花畑が荒らされてね…ほら、元はあんなに綺麗な花だったのに、こんなにされちゃって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610105
					],
					"speakerTitle": "レオポルディ"
				},
				{
					"id": 700610105,
					"content": "全部あいつの仕業なんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610106
					],
					"speakerTitle": "レオポルディ"
				},
				{
					"id": 700610106,
					"content": "#ひどい、{M#人でなしだ}{F#人でなしだね}！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700610107
					]
				},
				{
					"id": 700610107,
					"content": "そうでしょう！人でなし…というか、まあ、本当に人間じゃなくてイノシシなんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610108
					],
					"speakerTitle": "レオポルディ"
				},
				{
					"id": 700610108,
					"content": "なぜか最近、しょっちゅう山を下ってきて、花畑の花をかじっては転げ回ってるんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610109
					],
					"speakerTitle": "レオポルディ"
				},
				{
					"id": 700610109,
					"content": "それにすごくずる賢くて、騒ぎを聞きつけて人が集まってくるとすぐに逃げちゃってね。さっきなんて、通りかかったお年寄りの腰にぶつかって大怪我させるところだったし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610110
					],
					"speakerTitle": "レオポルディ"
				},
				{
					"id": 700610110,
					"content": "まったく、本当に…最悪のイノシシなんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610111
					],
					"speakerTitle": "レオポルディ"
				},
				{
					"id": 700610111,
					"content": "あっ、よく見ると…あ、あなたは栄誉騎士じゃないか！？モンドを救った大英雄の！ど、どうか手を貸してくれないかな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610112
					],
					"speakerTitle": "レオポルディ"
				},
				{
					"id": 700610112,
					"content": "#よし、{M#俺}{F#私}が追い払ってあげる！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700610113
					]
				},
				{
					"id": 700610113,
					"content": "助かるよ…確か、あいつは谷のほうへ逃げていったはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610114
					],
					"speakerTitle": "レオポルディ"
				},
				{
					"id": 700610114,
					"content": "あいつはとんでもなく狡猾だから、花を使わないとダメかもね…でも、花畑はこんな状態だし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610115
					],
					"speakerTitle": "レオポルディ"
				},
				{
					"id": 700610115,
					"content": "途中で「風止みの花」を摘んでおびき出せば、からかわれる気分を味わわせてやれるかも！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "レオポルディ"
				}
			]
		},
