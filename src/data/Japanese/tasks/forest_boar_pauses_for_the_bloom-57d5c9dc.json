			"dialogs": [
				{
					"id": 700610701,
					"content": "あっ…戻ったの？どうだった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610702
					],
					"speakerTitle": "レオポルディ"
				},
				{
					"id": 700610702,
					"content": "もう追い払ったよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700610703
					]
				},
				{
					"id": 700610703,
					"content": "ああ、本当にありがとう。これがお礼の報酬だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610704
					],
					"speakerTitle": "レオポルディ"
				},
				{
					"id": 700610704,
					"content": "働いてもらった分、報酬を支払わないとね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610705
					],
					"speakerTitle": "レオポルディ"
				},
				{
					"id": 700610705,
					"content": "これで花畑も手直しできるよ。もう二度と、「人でなし」に荒らされないといいんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "レオポルディ"
				}
			]
		}
