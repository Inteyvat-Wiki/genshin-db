			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鶯",
					"ティマイオス"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716600101,
					"content": "ああ、戻ってきたんだね！「煙霰ポーション」の効果はどうだった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600102,
						716600105
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716600102,
					"content": "秘境の外でも使えたらいいな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716600103
					]
				},
				{
					"id": 716600103,
					"content": "そうそう！それなら完璧だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716600104,
					"content": "ふむふむ。なかなか好感触みたいだね。詳しく話してくれるかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600108
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716600108,
					"content": "ティマイオスに実験について詳しく話した。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						716600109
					]
				},
				{
					"id": 716600109,
					"content": "鶯さんの予想通りだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600110
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716600110,
					"content": "「煙霰ポーション」の改善すべき点——それは、昇華後の薬剤の分布を一定範囲内に絞ることだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600111
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716600111,
					"content": "おそらく…蒲公英の特性を逆に利用し、特殊な補助剤を作ることができれば、空気の流れに影響を受けない薬剤ができるはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600112
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716600112,
					"content": "だが、これは前例もなく、そう簡単にできることじゃない。テストを何回も重ねることで、その実用性を証明しなければならない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600113
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716600113,
					"content": "なに言ってるんだか、まったく分からないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716600114,
					"content": "でも、鶯はいつも重要な手がかりをくれるよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716600115,
					"content": "あら、こんなことまで予想はしてへんかったで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600116
					],
					"speakerTitle": "鶯"
				},
				{
					"id": 716600116,
					"content": "働き者の錬金術師さん、あんたはうちのことを理解するために頑張っとるん？それとも、うちを褒めて…喜ばせようとしてるんやろか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600117
					],
					"speakerTitle": "鶯"
				},
				{
					"id": 716600117,
					"content": "ぼ、僕はただ鶯さんの豊富な知識を尊敬しているだけで…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600118
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716600118,
					"content": "ふふっ、せやったら頑張らんとなぁ。こういった知識は、今後もどこかで使うかもしれへんよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600119
					],
					"speakerTitle": "鶯"
				},
				{
					"id": 716600119,
					"content": "あんたの研究が成功したら、うちにも教えたってやぁ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600120
					],
					"speakerTitle": "鶯"
				},
				{
					"id": 716600120,
					"content": "もちろん…その時が来たら、一番上質なポーションを記念品として、鶯さんに贈るよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600121
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716600121,
					"content": "それと、もし鶯さんも時間があったら、僕たちと一緒に「万民堂」で…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600122
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716600122,
					"content": "今回の「学術交流」はここまで。「春香窯」には、まだまだたくさん仕事が残っとってな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600123
					],
					"speakerTitle": "鶯"
				},
				{
					"id": 716600123,
					"content": "暇ができたら、次は必ずうちに付き合うてや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600124
					],
					"speakerTitle": "鶯"
				},
				{
					"id": 716600124,
					"content": "約束するよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716600125
					]
				},
				{
					"id": 716600125,
					"content": "ありがとうな、鶯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716600126,
					"content": "鶯はその場から去った。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						716600127
					]
				},
				{
					"id": 716600127,
					"content": "はぁ、結局誘えなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600128
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716600128,
					"content": "けど、鶯さんにはたくさん迷惑をかけたし、これ以上邪魔するわけにもいかないよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600129
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716600129,
					"content": "ここは一度落ち着いて、タイミングを見計らったほうが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600130
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716600130,
					"content": "ティマイオス、なに一人でぶつぶつ言ってるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600131
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716600131,
					"content": "あっ、いや何でもない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600132
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716600132,
					"content": "今回は本当にありがとう！約束通り、「万民堂」で二人に美味しい食事をご馳走するよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600133
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716600133,
					"content": "忘れるところだった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716600134
					]
				},
				{
					"id": 716600134,
					"content": "おお、そうだった。ごちそう、ごちそう～！早く行こうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600135
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716600135,
					"content": "ティマイオスと一緒に「万民堂」で豪華な食事をした。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						716600136
					]
				},
				{
					"id": 716600136,
					"content": "ぷはぁ…お腹いっぱい、大満足だぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600137
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716600137,
					"content": "ティマイオス！今回の研究、なかなか面白かったな！今度また璃月に来ることがあったら、オイラたちも誘ってくれよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600138,
						716600139
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716600138,
					"content": "パイモンは研究に興味ないでしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716600140
					]
				},
				{
					"id": 716600140,
					"content": "なんだよそれ！オイラだって役に立っただろ…たとえば、道を聞いたりとか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600141
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716600141,
					"content": "とにかく、二人とも感謝するよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600142
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716600142,
					"content": "けどモンドに戻ったら、しばらくは「煙霰ポーション」の改良に専念したいと思う。当分、璃月へ来ることはないだろうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600143
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716600143,
					"content": "ただ近いうち、僕の手紙を届けてもらえないだろうか。鶯さんにまだ感謝の気持ちを伝えられてないからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600144
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716600144,
					"content": "え？ずっと二人で話してたんだろ？なんで直接言わなかったんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600145
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716600145,
					"content": "そ、それは鶯さんの言葉遣いが実に…独特だったから！きちんと言葉を選んで感謝を伝えるには、直接話すよりも手紙のほうがいいかと思って…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600146
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716600146,
					"content": "それよりも時間が惜しい。早くモンドに戻ろう。今は一刻も早く、完璧な「煙霰ポーション」を作りたいんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600147
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716600147,
					"content": "なんだか鶯と別れた後から、ティマイオスの様子がおかしくないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600148
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716600148,
					"content": "う～ん、なにがあったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716600139,
					"content": "ただ美味しいものが食べたいだけでは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716600140
					]
				},
				{
					"id": 716600105,
					"content": "まだ改善の余地がある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716600106
					]
				},
				{
					"id": 716600106,
					"content": "そうだな、例えば…秘境の外でも使えるようにするとか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716600107,
					"content": "うん、鶯さんともちょうどその問題について話してたんだ。君たちが行った実験を詳しく話してくれるかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600108
					],
					"speakerTitle": "ティマイオス"
				}
			]
		}
	]
}