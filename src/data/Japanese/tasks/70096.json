						],
						"pointId": 16827
					}
				]
			},
			"dialogs": [
				{
					"id": 700960301,
					"content": "イネファ、イネファ！見て、あの風車！早く構造を記録して！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960302
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 700960302,
					"content": "了解——撮影準備中です。アイノ、今回は風車を背景に記念撮影をご希望ですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960303
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 700960303,
					"content": "あれ？旅人にパイモン——あとローエンも！やっほー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960304
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 700960304,
					"content": "ナド・クライから来た「強大な古龍」…誰のことか、もっと早く気づくべきだったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700960305,
					"content": "状況を整理中…つまり、ローエンさんは私と戦闘訓練を行いたい、ということでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960306
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 700960306,
					"content": "前後の事情を全部すっ飛ばせば、そういうことだ。お前にそんな複雑な経歴があったとはな、遠征の時は思いもしなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960307
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 700960307,
					"content": "ま、そんなことはどうでもいい。お前のその力、試してみてぇとは思ってたんだよ。どうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960308
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 700960308,
					"content": "ふふん！イネファ！目にもの見せてやって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960309
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 700960309,
					"content": "申し訳ありません——本日のスケジュールでは、私たちはこれからモンドの特殊なパーツを収集しに行く予定です。評価の結果、貴方との交戦は、今後の行動に影響を及ぼす可能性があります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960310
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 700960310,
					"content": "あ、そうだった…忘れるとこだったよ。モンドに変わったでっかいロボットがいるって聞いて来たのに…ついうっかり遊んじゃった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960311
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 700960311,
					"content": "しょうがないか…分かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960312
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 700960312,
					"content": "あのローエンが…まさかこんなにあっさり諦めるのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700960313,
					"content": "——あの遺跡守衛どもを片付ければ、予定は空くんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ローエン"
				}
			]
		},
