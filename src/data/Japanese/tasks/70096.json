						],
						"pointId": 16843
					}
				]
			},
			"dialogs": [
				{
					"id": 700960501,
					"content": "…ち、力を追い求める者よ、運命の導きに従って、ついにここまで来たか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960502
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 700960502,
					"content": "やっぱドゥリンか…そんな気はしてたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700960503,
					"content": "でも、なんだか話し方が変じゃない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960504
					]
				},
				{
					"id": 700960504,
					"content": "至高なる領主、魔女の創造物、天の使いの末裔…それぞれが異なる力を行使しつつも、皆一様に「龍」の名を冠する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960505
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 700960505,
					"content": "…「龍」こそが、「強大」の象徴であるがゆえに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960506
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 700960506,
					"content": "で、「巨龍との戦い」が力の証明になるってことか？——昔の大団長の気持ちが、少しは理解できた気がするな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960507
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 700960507,
					"content": "…え？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960508
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 700960508,
					"content": "まだ何か言い足りないみてぇだが、ここからはこいつで語り合おうぜ？そのほうが手っ取り早いだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960509
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 700960509,
					"content": "ま、待って！わ…若き人間よ、汝の求める試練はここにあらず。風龍廃墟へ赴き、最後の予言と対峙するのだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960510,
						700960511
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 700960510,
					"content": "急に早口になった！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960512
					]
				},
				{
					"id": 700960512,
					"content": "ドゥリン…大丈夫か？今日のおまえの話し方、なんか変だぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960513
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700960513,
					"content": "（ふぅ…読むべきところは全部読んだよね…だいぶ読み飛ばしてしまったけど！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960514
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 700960514,
					"content": "えっと、アルベドに実験の手伝いを頼まれてるんだった！先に帰るよ。ごめんね、みんな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960515
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 700960515,
					"content": "もう飛んでったのか？…残念だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960516
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 700960516,
					"content": "ん？これは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960517
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 700960517,
					"content": "えーっと…結局、ドゥリンは一体なにしに来たんだ？最後の「風龍廃墟へ行け」って言葉以外、ロクな情報がなかったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960518,
						700960519
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700960518,
					"content": "なんとなくだけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960520
					]
				},
				{
					"id": 700960520,
					"content": "面白いじゃねぇか。その「予言」とやらがどう実現するのか、この目で見届けたくなってきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ローエン"
				},
				{
					"id": 700960519,
					"content": "「三」という数字を揃えるためじゃない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960520
					]
				},
				{
					"id": 700960511,
					"content": "出番が終わって急いで退場する役者みたい！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960512
					]
				}
			]
		},
