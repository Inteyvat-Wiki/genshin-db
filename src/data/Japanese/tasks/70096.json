			},
			"dialogs": [
				{
					"id": 700960601,
					"content": "よし…バービーの予言によれば、導きを必要とする人間がもうすぐ来るのよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960602
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 700960602,
					"content": "登場の台詞は…覚えた。演出も…確認した。うん、今度こそ完璧ね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960603
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 700960603,
					"content": "なあ…最後の予言だけど、なんでローエンがここに来なきゃいけないんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700960604,
					"content": "あっ、もう来ちゃったの？ドゥリンったら、ちゃんと最後まで台詞を言い終わったのかしら？困ったわ…静かにしないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960605
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 700960605,
					"content": "もしかして、最後の「龍の脅威と対峙」って…トワリンのことか？でもあいつ、今日はいないみたいだぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960606
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700960606,
					"content": "厳密に言えば、俺はもう「東風守護」に会ってる。ナド・クライから戻った時、お前らのすぐそばでな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960607
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 700960607,
					"content": "そうだったな、奔狼領でファルカの手紙を届けた時のことだろ！ってことは、おまえの「予言」はもう全部終わったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960608
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700960608,
					"content": "少なくとも、「三度龍の脅威と対峙」はこれで終わったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960609
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 700960609,
					"content": "あとは「『強さ』を理解する」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960610
					]
				},
				{
					"id": 700960610,
					"content": "フン、それこそが「予言」が俺をここまで導いた理由なんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960611
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 700960611,
					"content": "ここは「風龍廃墟」と呼ばれる前は、竜巻の魔神の領域だったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960612
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 700960612,
					"content": "全てを守護する暴風を巻き起こせる強大な魔神でも、風の壁の内側にある自由への憧れは止められなかったんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960613
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 700960613,
					"content": "そいつと神座を争った北風の魔神は、力を手放してからずっと探し求めていた答えを見つけた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960614
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 700960614,
					"content": "あら？この子…ファルカさんが言っていたほど偏執的ではないみたいね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960615
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 700960615,
					"content": "「曙光の鏡」に「魔龍ドゥリン」…あいつらにも迷いはあった。だが、決して単なる力だけで強くなったわけじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960616
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 700960616,
					"content": "そうそう…よく分かっているじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960617
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 700960617,
					"content": "そして、かつての天の使い——「ウルサ」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960618
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 700960618,
					"content": "…ん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960619
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 700960619,
					"content": "言ってることはまともだけど…急にどうしたんだ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960620,
						700960621
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700960620,
					"content": "ドゥリンに続いて…ローエンまで…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960622
					]
				},
				{
					"id": 700960622,
					"content": "「『力』を望んだ天の使いは、なおも人間に近づくことを渇望し、ついには哀れな魔物に堕ちた…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960623
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 700960623,
					"content": "「その全てを目の当たりにした人間よ、それでもまだ『力』に執着するのか？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960624
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 700960624,
					"content": "——ちょっと！それ全部、あたしのセリフじゃない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960625
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 700960625,
					"content": "うわあ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960626
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700960626,
					"content": "あっ…うっかり…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960627
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 700960627,
					"content": "よう。会えて光栄だ、ニコさん。あんたが書いた台本、拝見させてもらった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960628
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 700960628,
					"content": "はぁ…ドゥリンが落としたんでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960629
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 700960629,
					"content": "へぇ？まさか、それも予言にあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960630
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 700960630,
					"content": "ただの推測よ。もしこんなことまで予言できるなら、さっきだって…コホン。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960631
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 700960631,
					"content": "ともあれ、台本の出来は悪くない。おとぎ話として読む分には、な。説教を聞くのは好きじゃねぇ…たとえ、それが「天の使い」であってもだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960632
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 700960632,
					"content": "…それは、「力」を選んだあたしの元同僚のことを言っているのだと捉えておくわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960633
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 700960633,
					"content": "それを読んだのなら、あたしが何を言いたかったのか、全部分かってるわよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960634
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 700960634,
					"content": "ああ、ここに書かれてる台詞は、貴重なアドバイスとして覚えておく。これ以上用がないなら、俺は『強敵図鑑』の編集に戻らせてもらうぜ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960635,
						700960636
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 700960635,
					"content": "（覚えておくだけで聞くとは言ってない…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960637
					]
				},
				{
					"id": 700960637,
					"content": "ま、今日はいろいろと収穫があった。んー…少しは強くなれたかもな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960638
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 700960638,
					"content": "ありがとな、お前ら…ついでに、「舞台の脇役」たちにもよろしく言っといてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960639
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 700960639,
					"content": "はぁ…彼も一癖ある人間なのね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960640
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 700960640,
					"content": "えっと…それで、結局どういうことなんだ？誰か説明してくれよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960641
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700960641,
					"content": "あなたたちは以前、ドットーレやウルサがモンドに残した「置き土産」を解決したのよね？その時、彼も随分と大変な目に遭ったって聞いたわよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960642
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 700960642,
					"content": "かつての「天の使い」が残した災いである以上、今の「天の使い」が導き正すのは当然のことでしょう？…想定していた結果とは少し違うけれど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960643
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 700960643,
					"content": "これからの人間の運命は、より一層予測不可能なものになるかもしれないわ。天の使いによる導きも、もはや未来へ至る唯一の解ではなくなったのだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960644
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 700960644,
					"content": "でも、その無限の可能性こそが…まさに人間の「強さ」なのかもしれないわね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ニコ"
				},
				{
					"id": 700960636,
					"content": "（やっぱり図鑑作りは続けるんだ…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960637
					]
				},
				{
					"id": 700960621,
					"content": "どうしてみんな台本を読むような口調なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960622
					]
				}
			]
		},
