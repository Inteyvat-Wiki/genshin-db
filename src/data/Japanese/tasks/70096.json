					"content": "はぁ、自分でやるのは初めてだったのに、まさかこんなことになるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960702,
						700960704
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 700960702,
					"content": "何事も初めては難しいものだから…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960703
					]
				},
				{
					"id": 700960703,
					"content": "それに、そんなに悪くない結果だろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700960704,
					"content": "初めてって？何のこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960705
					]
				},
				{
					"id": 700960705,
					"content": "ああ…「魔女の課題」のことよ。また後で説明するわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ニコ"
				}
			]
		},
