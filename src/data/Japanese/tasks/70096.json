			"dialogs": [
				{
					"id": 700960401,
					"content": "流れるような身のこなしだな。本当に機械なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960402
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 700960402,
					"content": "ローエンさんの攻撃も、まるで機械のように正確です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960403
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 700960403,
					"content": "わーい！新しいパーツだよ！これで新しいモジュールを作れるね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960404
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 700960404,
					"content": "ん？それじゃ、ようやく…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960405
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 700960405,
					"content": "イネファ！もっとたくさん見つけてきて！サンプルは多ければ多いほどいいんだから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960406
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 700960406,
					"content": "はい…申し訳ありません、また後でお話ししましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960407
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 700960407,
					"content": "一通り探索した後…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700960408
					]
				},
				{
					"id": 700960408,
					"content": "すぅー…すぅー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960409
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 700960409,
					"content": "寝ちゃったのか…ドーンマンポートで遊びすぎて、疲れたのかもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960410
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700960410,
					"content": "アイノはいつもこんな調子で、元気が湧くのも早ければ、疲れるのも早いのです。申し訳ありません、ローエンさん。アイノがもう少し深い眠りにつくまで、動くことができません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960411
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 700960411,
					"content": "…まあいい、お前の力はもう見せてもらったからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960412
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 700960412,
					"content": "…私の戦闘データが、貴方のお役に立てば良いのですが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960413
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 700960413,
					"content": "ところで、特殊な仕掛けの情報を教えてくださった方が、「雪山」のことも口にしていました。そちらもお調べになられてはいかがでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イネファ"
				}
			]
		},
