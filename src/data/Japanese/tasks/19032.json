			},
			"dialogs": [
				{
					"id": 1903203101,
					"content": "う…うう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203102
					],
					"speakerTitle": "芊"
				},
				{
					"id": 1903203102,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}、芊を手伝ってくれない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203103,
						1903203104
					],
					"speakerTitle": "芊"
				},
				{
					"id": 1903203103,
					"content": "手伝い？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203105
					]
				},
				{
					"id": 1903203105,
					"content": "あの水色の髪の方士がね、怖いの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203106
					],
					"speakerTitle": "芊"
				},
				{
					"id": 1903203106,
					"content": "だから、あの方士を連れてどこか遠いところへ行ってほしいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203107,
						1903203108
					],
					"speakerTitle": "芊"
				},
				{
					"id": 1903203107,
					"content": "純陽の体が原因？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203109
					]
				},
				{
					"id": 1903203109,
					"content": "全然、近づけないの。あの力、怖いよ…このままだと芊、消えちゃう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203110
					],
					"speakerTitle": "芊"
				},
				{
					"id": 1903203110,
					"content": "芊はまだ消えたくないの、だから…お願い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203111,
						1903203112
					],
					"speakerTitle": "芊"
				},
				{
					"id": 1903203111,
					"content": "彼の目にはこの子が妖魔として映るはず。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203113
					]
				},
				{
					"id": 1903203113,
					"content": "じゃあ、お願いがあるんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203114
					],
					"speakerTitle": "芊"
				},
				{
					"id": 1903203114,
					"content": "さっき、あの方士が誰かと揉めてるところを遠くから見たんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203115
					],
					"speakerTitle": "芊"
				},
				{
					"id": 1903203115,
					"content": "芊なら面倒なやつを追い払えるよ。その代わり、芊を見逃してくれない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203116,
						1903203118
					],
					"speakerTitle": "芊"
				},
				{
					"id": 1903203116,
					"content": "本当？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203117
					]
				},
				{
					"id": 1903203117,
					"content": "本当だよ！芊は嘘つかないもん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203120
					],
					"speakerTitle": "芊"
				},
				{
					"id": 1903203120,
					"content": "だめ、かな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203121
					],
					"speakerTitle": "芊"
				},
				{
					"id": 1903203121,
					"content": "彼に伝えてみる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203122
					]
				},
				{
					"id": 1903203122,
					"content": "うん、お願いを聞いてくれてありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203123
					],
					"speakerTitle": "芊"
				},
				{
					"id": 1903203123,
					"content": "あの水色の髪の方士、いい人だといいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203124
					],
					"speakerTitle": "芊"
				},
				{
					"id": 1903203124,
					"content": "芊が彼を手伝う、あなたも彼を手伝う、そして…あなたが芊を手伝って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芊"
				},
				{
					"id": 1903203118,
					"content": "それくらいなら、自分でもできるけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203119
					]
				},
				{
					"id": 1903203119,
					"content": "えっと、でも面倒には変わりないでしょ？芊ならもっといい方法で解決できるから、信じて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203120
					],
					"speakerTitle": "芊"
				},
				{
					"id": 1903203112,
					"content": "彼の代わりに返事はできない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203113
					]
				},
				{
					"id": 1903203108,
					"content": "今日見かけないのはこのせいか。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203109
					]
				},
				{
					"id": 1903203104,
					"content": "何を？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203105
					]
				}
			]
		}
	]
}