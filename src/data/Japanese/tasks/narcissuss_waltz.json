			"dialogs": [
				{
					"id": 742540501,
					"content": "セイモア！久しぶり！それにマメールも！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540502
					],
					"speakerTitle": "アン"
				},
				{
					"id": 742540502,
					"content": "えへへ、セイモアも旅の途中で、よくあなたたちに会いたがってたんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540503
					],
					"speakerTitle": "マメール"
				},
				{
					"id": 742540503,
					"content": "肯定。私はいついかなる時も、マリアンお嬢様のことを想っております。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540504
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 742540504,
					"content": "サンドローネさん、お茶会を開いてくれてありがとう。おかげで、またみんなで旅のことを語り合えるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540505
					],
					"speakerTitle": "マリアン"
				},
				{
					"id": 742540505,
					"content": "…べつに。ワタシはただ、ワタシたちは多少なりとも縁のある家族のようなものだと思って…ええ、そう言ってもおかしくはないわよね？だから、これからも暇な時に集まりましょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540506
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 742540506,
					"content": "家族？なぜかわからないけど、あたし、そう言ってもらえてすっごく嬉しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540507
					],
					"speakerTitle": "アン"
				},
				{
					"id": 742540507,
					"content": "じゃあ、この家族の中でサンドローネさんは…妹かしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540508
					],
					"speakerTitle": "マリアン"
				},
				{
					"id": 742540508,
					"content": "…「家族」とは言ったけど、別にそういうのを具体的に決める必要は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540509
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 742540509,
					"content": "肯定。アラン様によって造られたプロトタイプである私を、サンドローネ様は「兄」と呼ぶべきです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540510
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 742540510,
					"content": "アナタねえ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540511
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 742540511,
					"content": "いいなぁ。私もあなたたちの家族の一員になれるかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540512
					],
					"speakerTitle": "マメール"
				},
				{
					"id": 742540512,
					"content": "もちろんよ。なんでもアリの家族だもの——メリュジーヌがひとり増えたところで、何の問題もないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540513
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 742540513,
					"content": "肯定。マメールお嬢様は私の家族です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540514
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 742540514,
					"content": "えへへ、嬉しい！なら、この家族のために絵を描いてもいい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540515
					],
					"speakerTitle": "マメール"
				},
				{
					"id": 742540515,
					"content": "一家の肖像画？そういうの、久しぶりね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540516
					],
					"speakerTitle": "マリアン"
				},
				{
					"id": 742540516,
					"content": "あたしはかっこよく描いてね！お姉さんっぽく！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540517
					],
					"speakerTitle": "アン"
				},
				{
					"id": 742540517,
					"content": "うん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540518
					],
					"speakerTitle": "マメール"
				},
				{
					"id": 742540518,
					"content": "はぁ…好きにしなさい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「傀儡」"
				}
			]
		},
