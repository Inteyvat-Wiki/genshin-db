			"dialogs": [
				{
					"id": 742540601,
					"content": "本当に、穏やかで心地がいいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540602,
						742540603
					],
					"speakerTitle": "マリアン"
				},
				{
					"id": 742540602,
					"content": "（もう少し、座っていようかしら。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540604
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 742540604,
					"content": "ええ。招待してくれてありがとう。サンドローネ…ちゃん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マリアン"
				},
				{
					"id": 742540603,
					"content": "そろそろお茶会はお開きにしましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540604
					],
					"speakerTitle": "「傀儡」"
				}
			]
