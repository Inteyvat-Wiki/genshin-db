					}
				]
			},
			"dialogs": [
				{
					"id": 700820101,
					"content": "オルドフ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700820102,
					"content": "#おや、パイモンさんに{NICKNAME}さん…ご協力ありがとうございました。これでウィンスローも、アビスと戦った騎士たちの墓を移そうだなんて騒がなくなるはずですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820103
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700820103,
					"content": "そういえば、なんかおかしいって思ってたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700820104,
					"content": "風の原因はただの狂風のコアだったのに、ウィンスローには騎士団の幽霊の仕業だとか言って…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700820105,
					"content": "「幽霊」の正体は、他でもない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700820106
					]
				},
				{
					"id": 700820106,
					"content": "#「幽霊」は{M#君}{F#あなた}でしょ、オルドフ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700820107
					]
				},
				{
					"id": 700820107,
					"content": "えっ、そうだったのか？でも、ビールを飲んでたんだぞ。幽霊ってビールも飲めるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700820108,
					"content": "この「幽霊」と、その幽霊はまた別物ですよ。うまくやれたつもりだったんですけどね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820109
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700820109,
					"content": "…えっ…じゃあ、最初から幽霊なんていなくて、ぜんぶオルドフの悪巧みだったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700820110,
					"content": "「悪巧み」ですか、確かにその表現がふさわしいかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820111
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700820111,
					"content": "装置は私が調整したもので、元素生物をおびき寄せる媒介を少し使ったんです。最初は、ウィンスローを軽く驚かせようと思っただけなんですけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820112
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700820112,
					"content": "ただの風スライムなら、数日もすれば勝手に去っていきますし…ちょうどスネージナヤから商談を持ちかけられたので、それから戻る頃には収束しているだろうと思ったんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820113
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700820113,
					"content": "でも、狂風のコアが来てしまった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700820114
					]
				},
				{
					"id": 700820114,
					"content": "ええ、そのせいでかなり複雑なことになってしまいました。私はただ、ウィンスローにお墓を動かしてほしくなかっただけで、あんな目に遭わせるつもりはなかったんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820115
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700820115,
					"content": "ですので…あなたたちが現れた時、本当に風神の加護に感謝しましたよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820116
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700820116,
					"content": "えっ、じゃあもしオイラたちが来なかったら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700820117,
					"content": "その時は、あの狂風のコアを追い払うのに挑戦したか、あるいは騎士団の人たちに真相を話していたでしょうね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820118
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700820118,
					"content": "ですが、ウィンスローが真相を知ったら激怒して、墓石まで叩き壊してしまうかもしれません。彼は昔からそういう性格ですから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820119
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700820119,
					"content": "#なので助かりましたよ、{NICKNAME}さん、パイモンさん。アビスとの戦いでここに散った西風騎士たちを代表して、感謝を申し上げます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820120
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700820120,
					"content": "うーん、なんか変な感じはするけど、結果的にはいいことをしたんだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700820121,
					"content": "ははは…そうですね、元はといえば私のせいです…「不気味なものを拒むために必要なのは、何事をも受け入れられる広い心」…などと言いましたが、私にもできませんでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820122
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700820122,
					"content": "やはり、理屈を知っているのと実践するのは別ですね。ですが、私も反省しているんですよ。風神様、もしこの声が届いているならば、今回だけはどうかお許しください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "オルドフ"
				}
			]
		}
	]
}