			"dialogs": [
				{
					"id": 756710101,
					"content": "ツィッ、ツィッ、ピーピー、ツィッ、ツィッ、ツィッ♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710102
					],
					"speakerTitle": "バシマ五世"
				},
				{
					"id": 756710102,
					"content": "えっと…なにしてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710103,
						756710104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756710103,
					"content": "暗号文…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710105
					]
				},
				{
					"id": 756710105,
					"content": "まあ、そのようなものです！可愛いヤマガラと交流するための技でございます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710106
					],
					"speakerTitle": "バシマ五世"
				},
				{
					"id": 756710106,
					"content": "あら、ご挨拶と前置きを忘れていましたわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710107
					],
					"speakerTitle": "バシマ五世"
				},
				{
					"id": 756710107,
					"content": "通りすがりのお優しいお二人に、生論派の学者にして新星の商人、「かわいい動物愛好家」のバシマ五世がご挨拶申し上げます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710108
					],
					"speakerTitle": "バシマ五世"
				},
				{
					"id": 756710108,
					"content": "肩の力を抜き、頭を空っぽにして、わたくしの言葉に耳を貸してくださいませ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710109
					],
					"speakerTitle": "バシマ五世"
				},
				{
					"id": 756710109,
					"content": "ヤマガラが一番可愛い？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756710110,
					"content": "まったくその通りです！すばらしいですわね、ヤマガラの可愛さに魅了されて、先に言ってしまわれるなんて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710111
					],
					"speakerTitle": "バシマ五世"
				},
				{
					"id": 756710111,
					"content": "ヘンだな…なんでだか分かんないけど、テーブルの上のゲームを見たら、頭の中にいきなりこのセリフが浮かんできたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756710112,
					"content": "#見覚えあるか？{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710113,
						756710115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756710113,
					"content": "会ったことあるよね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710114
					]
				},
				{
					"id": 756710114,
					"content": "ええ！それも、一度きりのご縁ではございませんよ。お二人がこうして元気なお姿を見せてくださって、わたくし、本当に胸が温かくなりましたわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710117
					],
					"speakerTitle": "バシマ五世"
				},
				{
					"id": 756710117,
					"content": "とにかく、わたくしのそばにあるこのゲームを試してみませんか？第十七版、第三世代の「カラコロ！チュンボール」を！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710118
					],
					"speakerTitle": "バシマ五世"
				},
				{
					"id": 756710118,
					"content": "気軽に遊びながら、大きな朱羽ヤマガラ・古種が盗賊カモメに打ち勝つ物語を楽しめますわよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710119
					],
					"speakerTitle": "バシマ五世"
				},
				{
					"id": 756710119,
					"content": "おう！オイラたち、こういう気楽に遊べるゲームは大好きだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710120,
						756710121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756710120,
					"content": "今すぐやろう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710122
					]
				},
				{
					"id": 756710122,
					"content": "ええ！ご自身にぴったりの遊び方を見つけて、唯一無二の楽しみを発見できますように！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "バシマ五世"
				},
				{
					"id": 756710121,
					"content": "始めよう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710122
					]
				},
				{
					"id": 756710115,
					"content": "ああ、ヤマガラが一番可愛い！…遅かった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710116
					]
				},
				{
					"id": 756710116,
					"content": "そうですわ！たとえ以前のことを今すぐ思い出せなくても大丈夫です。大切なのは、今この瞬間を楽しむこと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710117
					],
					"speakerTitle": "バシマ五世"
				},
				{
					"id": 756710104,
					"content": "なにかと通信してる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710105
					]
				}
			]
		}
	]
}