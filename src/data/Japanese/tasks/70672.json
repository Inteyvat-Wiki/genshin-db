					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706720202,
					"content": "はい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720203
					],
					"speakerTitle": "マル"
				},
				{
					"id": 706720203,
					"content": "見ろ！でっかいヤマガラだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706720204,
					"content": "ヤマガラではありません。私の名前は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720205
					],
					"speakerTitle": "マル"
				},
				{
					"id": 706720205,
					"content": "おや…そう言われると、自分の名前さえ…思い出せませんね。とりあえず、マルとお呼びください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720206
					],
					"speakerTitle": "マル"
				},
				{
					"id": 706720206,
					"content": "マル…モンドで一度も見たことない気がするけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706720207,
					"content": "むしろ、モンドで出会うほうが不思議と言えるでしょう。実を言うと、私は璃月から来たのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720208
					],
					"speakerTitle": "マル"
				},
				{
					"id": 706720208,
					"content": "へぇ、そうだったのか…でも、なんでマルは璃月からモンドのキャッツテールに来たんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720209,
						706720212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706720209,
					"content": "飲み物を買いに来たの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706720210
					]
				},
				{
					"id": 706720210,
					"content": "確かに璃月とここの飲み物にどんな違いがあるか味わってみたい気持ちはありますが、今日やって来たのは依頼のためなんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720211
					],
					"speakerTitle": "マル"
				},
				{
					"id": 706720211,
					"content": "依頼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706720214,
					"content": "ふむ…僭越ながら私の推測によると、あなたが噂の旅人さんとお見受けいたします。実は、今回の件はあなたとも少し関係しているのです。",
