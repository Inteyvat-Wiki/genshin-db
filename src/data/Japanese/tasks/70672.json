			},
			"dialogs": [
				{
					"id": 706720101,
					"content": "あれ、マルじゃないか！なんでキャッツテールに来てるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706720102,
					"content": "マル——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706720103,
					"content": "こんにちは、マル！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706720104
					]
				},
				{
					"id": 706720104,
					"content": "お二人でしたか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720105
					],
					"speakerTitle": "マル"
				},
				{
					"id": 706720105,
					"content": "マル、どうしてここに来たんだ…ていうか！おまえって塵歌壺から出てもよかったのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706720106,
					"content": "もちろんです…おっと、そういえば、壺の外でお二人にお会いするのは初めてでしたね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720107
					],
					"speakerTitle": "マル"
				},
				{
					"id": 706720107,
					"content": "仙人が「壺の精霊」を創ったのは洞天の雑務処理をさせるためですが、活動範囲が洞天の中のみという制限はありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720108
					],
					"speakerTitle": "マル"
				},
				{
					"id": 706720108,
					"content": "ウルだって…いえ、「尋瑰納琦真君」だって、あちこち周遊して、ホコリまみれの珍しいお宝を収集していますし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720109
					],
					"speakerTitle": "マル"
				},
				{
					"id": 706720109,
					"content": "まあ、彼と比べたら、確かに壺から出てくる回数は少ないですが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720110
					],
					"speakerTitle": "マル"
				},
				{
					"id": 706720110,
					"content": "なるほどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706720111,
					"content": "で、今回はなんで壺から出てきたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720112,
						706720115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706720112,
					"content": "飲み物を買いに来たの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706720113
					]
				},
				{
					"id": 706720113,
					"content": "確かに璃月とここの飲み物にどんな違いがあるか味わってみたい気持ちはありますが、今日やって来たのは依頼のためなんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720114
					],
					"speakerTitle": "マル"
				},
				{
					"id": 706720114,
					"content": "依頼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706720117,
					"content": "ふむ…そう言われると、今回の件は旅人さんとも少し関係していますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720118
					],
					"speakerTitle": "マル"
				},
				{
					"id": 706720118,
					"content": "#{M#俺}{F#私}と？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706720119
					]
				},
				{
					"id": 706720119,
					"content": "はい。すでにお気づきかと思いますが、「七聖召喚」が流行り出してから、ご友人を招待して酒場で対戦するのが一つの楽しみとなりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720120
					],
					"speakerTitle": "マル"
				},
				{
					"id": 706720120,
					"content": "ですが招待を受けた場合、わざわざ遠くから酒場に来なければなりません。それを大変だと感じた依頼人から、仙術を使って壺の中のような小さな部屋を作って欲しいと頼まれたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720121
					],
					"speakerTitle": "マル"
				},
				{
					"id": 706720121,
					"content": "招待を受けてここに来ようとする人は、瞬きもしないうちに、部屋の中に現れることができます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720122
					],
					"speakerTitle": "マル"
				},
				{
					"id": 706720122,
					"content": "それにより、その部屋を使って自由にご友人を招待して対戦できますし、招待された人の手間も省けます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720123
					],
					"speakerTitle": "マル"
				},
				{
					"id": 706720123,
					"content": "おおっ！めちゃくちゃ便利だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706720124,
					"content": "でも…ここってマーガレットの酒場だし、仙術を使って改造したなんて知られたら、怒られるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706720125,
					"content": "いえ…その点については大丈夫です。そもそも、部屋自体はキャッツテールにあるわけではありません。それに、当然ながら酒場のオーナーの許可もいただいています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720126
					],
					"speakerTitle": "マル"
				},
				{
					"id": 706720126,
					"content": "「あら、璃月の仙術って便利ね。酒場の面積を二倍にしてもらってもいいかしら？」と言われましたが…残念ながら、私の仙術では無理でした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720127
					],
					"speakerTitle": "マル"
				},
				{
					"id": 706720127,
					"content": "マ、マーガレットが言いそうなことだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706720128,
					"content": "あなたたちが洞天に戻って来た際、この件について説明しようと思っていたのですが、ちょうどここでお会いできてよかったです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720129
					],
					"speakerTitle": "マル"
				},
				{
					"id": 706720129,
					"content": "では、始めさせていただきます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720130
					],
					"speakerTitle": "マル"
				},
				{
					"id": 706720130,
					"content": "はい、これでいいでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720131
					],
					"speakerTitle": "マル"
				},
				{
					"id": 706720131,
					"content": "では、この部屋を思う存分使って、各地のご友人を招待して対戦してみてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720132
					],
					"speakerTitle": "マル"
				},
				{
					"id": 706720132,
					"content": "あっ…言いそびれるところでした。酒場のおチビちゃんからの伝言です——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720133
					],
					"speakerTitle": "マル"
				},
				{
					"id": 706720133,
					"content": "「『七聖召喚』を楽しんでくれ！」とのことでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マル"
				},
				{
					"id": 706720115,
					"content": "カードゲームをしに来たの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706720116
					]
				},
				{
					"id": 706720116,
					"content": "当たらずといえども遠からずですね。カードゲームをやりに来たわけではありませんが、確かにカードと少し関係があります…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720134
					],
					"speakerTitle": "マル"
				},
				{
					"id": 706720134,
					"content": "マルが仙術を駆使して酒場を改築し、対戦招待ボードを作り変えた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
