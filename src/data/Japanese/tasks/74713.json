					}
				]
			},
			"dialogs": [
				{
					"id": 747130101,
					"content": "久しぶりだね、旅人、パイモン…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130102
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 747130102,
					"content": "フレミネ？なんで潜水用ヘルメットを被ってるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747130103,
					"content": "水から上がってきたばかりなの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747130104
					]
				},
				{
					"id": 747130104,
					"content": "うん…最近、水域の状況がちょっとよくないみたいで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130105
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 747130105,
					"content": "これまでの何倍もの潜水士が、あちこちで水底に沈んだ貨物を引き上げてるんだ。ぼくも、手伝うくらいしかできないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130106
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 747130106,
					"content": "早く引き上げが終われば、潜水士たちも帰れるし、水の中も以前の静かな状態に戻ると思うから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130107
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 747130107,
					"content": "そうか…こういう騒々しいのって、おまえはきっと苦手だよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747130108,
					"content": "心配してくれてありがとう、パイモン。でも、悪いことばかりじゃないよ。思いがけない収穫もあったし…持ち主のいない骨董品とか、装飾品とかね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130109
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 747130109,
					"content": "「お父様」が、綺麗で価値のあるものを引き上げたら、この船に届けるといいって…あなたたちなら、きっとその価値を活かしてくれるはずだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130110
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 747130110,
					"content": "へへっ、アルレッキーノのやつ、気が利くな。そのままゴミになっちゃうくらいなら、きれいな装飾品はアクアリウムを飾るのに使えるかもしれないぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747130111,
					"content": "オイラたちもフレミネと一緒に引き上げに行こうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747130112,
					"content": "いいの？時間を取らせちゃうけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130113
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 747130113,
					"content": "もちろん問題ないぞ！持ち主不在の宝物を拾ったらオイラたちにくれるんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747130114,
					"content": "だったら、おまえだけ働かせるわけにはいかないぜ！タダでいいものをもらうのは悪いからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130115,
						747130116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747130115,
					"content": "自分で骨董品を引き上げるのもよさそう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747130117
					]
				},
				{
					"id": 747130117,
					"content": "それじゃあ…潜水士がこれまで集めた情報を伝えるね、少しは手間が省けると思うから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130118
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 747130118,
					"content": "いいものを見つけたら、好きにしていいよ。ただ、中には船主が探してる物もあるから、そういうのは元の持ち主に返してあげて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130119
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 747130119,
					"content": "よし、分かったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747130120,
					"content": "気を付けて——知らない水域には行かないでね。もし危ないと思ったら、すぐに陸に戻って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 747130116,
					"content": "水中の宝探しは楽しいから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747130117
					]
				}
			]
		}
	]
}