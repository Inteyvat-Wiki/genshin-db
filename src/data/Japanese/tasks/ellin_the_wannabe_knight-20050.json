						200500102
					],
					"speakerTitle": "エリン"
				},
				{
					"id": 200500102,
					"content": "なにしてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200500103
					]
				},
				{
					"id": 200500103,
					"content": "今度の騎士選抜のために、訓練してるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500104
					],
					"speakerTitle": "エリン"
				},
				{
					"id": 200500104,
					"content": "…でも、ジン様のような力がないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500105
					],
					"speakerTitle": "エリン"
				},
				{
					"id": 200500105,
					"content": "だから「力」よりも、「コツ」を身につけたほうがいいかなと思ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500106
					],
					"speakerTitle": "エリン"
				},
				{
					"id": 200500106,
					"content": "たとえば、一気にこの杭を全部破壊する方法とか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500107
					],
					"speakerTitle": "エリン"
				},
				{
					"id": 200500107,
					"content": "時間があったら、一緒に考えてほしいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500108,
						200500109
					],
					"speakerTitle": "エリン"
				},
				{
					"id": 200500108,
					"content": "考えてみる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200500110
					]
				},
				{
					"id": 200500110,
					"content": "うん、ゆっくり考えよう、杭は逃げたりしないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500111
					],
					"speakerTitle": "エリン"
				},
				{
					"id": 200500111,
					"content": "勝手に逃げていくのは使われた時間と命だけだよ、ううっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500114
					],
					"speakerTitle": "エリン"
				},
				{
					"id": 200500114,
					"content": "元素は相互に影響し合うと聞いたんだけど、もしこの火鉢の火を少し爆発させたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500115
					],
					"speakerTitle": "エリン"
				},
				{
					"id": 200500115,
					"content": "でもまずはこの火鉢に火をつけないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エリン"
				},
				{
					"id": 200500109,
					"content": "二人で壊す…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200500112
					]
				},
				{
					"id": 200500112,
					"content": "団体戦が得意なの？…いつでも仲間がいる人がうらやましいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500113
					],
					"speakerTitle": "エリン"
				},
				{
					"id": 200500113,
					"content": "私みたいな人はひとりで戦う方法を勉強するしかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500114
