			"dialogs": [
				{
					"id": 751970505,
					"content": "ウルバンは武器の鍛造に取り掛かった…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						751970501
					]
				},
				{
					"id": 751970501,
					"content": "出来たぞ、ハハハ！さあ、持ってみてくれ。手にぐっとくるだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970502
					],
					"speakerTitle": "ウルバン"
				},
				{
					"id": 751970502,
					"content": "いくら払えばいい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751970503
					]
				},
				{
					"id": 751970503,
					"content": "お前たちが材料を持ってきてくれたおかげで、鍛造することができた。俺はそれだけで満足だ。モラは必要ない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970504
					],
					"speakerTitle": "ウルバン"
				},
				{
					"id": 751970504,
					"content": "この武器がお前たちの冒険の役に立つことを祈っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウルバン"
				}
			]
