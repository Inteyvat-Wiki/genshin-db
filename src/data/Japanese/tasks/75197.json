			},
			"dialogs": [
				{
					"id": 751970102,
					"content": "戻って来たか。あの「牙」は…おぉ、もう見つけたのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970103
					],
					"speakerTitle": "ウルバン"
				},
				{
					"id": 751970103,
					"content": "お前たちが冒険に出ている間に、ちょっとした問題が発生してな…どうやっても、この「牙」を削ることができないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970104
					],
					"speakerTitle": "ウルバン"
				},
				{
					"id": 751970104,
					"content": "こんなことは俺も初めてだったからな。人に頼んで、アルベド先生に聞いてきてもらった——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970105
					],
					"speakerTitle": "ウルバン"
				},
				{
					"id": 751970105,
					"content": "それでさっそく、スクロースさんがアルベド先生から預かった符石を一つ持ってきてくれたんだ。合成台に置いてあるのがそれだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970106
					],
					"speakerTitle": "ウルバン"
				},
				{
					"id": 751970106,
					"content": "符石？それが「龍牙」とどう関係あるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751970107,
					"content": "アルベド先生からの言伝によると、こういった材料で武器を作るには、まず特殊な処理が必要らしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970108
					],
					"speakerTitle": "ウルバン"
				},
				{
					"id": 751970108,
					"content": "龍にまつわる「生命力」を龍牙に吸収させ、さらにそれを使って他の龍牙を処理する、という方法がその一つだそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970109
					],
					"speakerTitle": "ウルバン"
				},
				{
					"id": 751970109,
					"content": "スクロースさんの話だと、この符石は千年前、モンドが旧貴族に抵抗していた時代の遺物で、モンドを助けたとある流浪楽団が騎士団に残していったらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970110
					],
					"speakerTitle": "ウルバン"
				},
				{
					"id": 751970110,
					"content": "その楽団の笛奏者は、燼寂海で「バクナワ」と現地の人々が呼ぶ恐ろしい魔獣と戦った。この符石はその魔獣から切り落としたものだそうだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970111
					],
					"speakerTitle": "ウルバン"
				},
				{
					"id": 751970111,
					"content": "あれ？待てよ…たしか、シトラリから聞いた話だと、燼寂海って五百年前のサンハジの戦いでできたんだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751970112,
					"content": "本当に千年前の楽団なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751970113
					]
				},
				{
					"id": 751970113,
					"content": "ハハッ、間違えるわけがない。旧貴族時代の英雄だぞ。『王と貴族の歴史』にも記録が残されている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970114
					],
					"speakerTitle": "ウルバン"
				},
				{
					"id": 751970114,
					"content": "とにかく、アルベド先生によれば、この符石には龍の力に近い「無限の生命力」が秘められている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970115
					],
					"speakerTitle": "ウルバン"
				},
				{
					"id": 751970115,
					"content": "合成台を使って、符石に宿る生命力を龍牙に吸収させることができれば、武器を作れるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970116
					],
					"speakerTitle": "ウルバン"
				},
				{
					"id": 751970116,
					"content": "聞いただけですごそうだぞ…さすがアルベドだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970117,
						751970119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751970117,
					"content": "今度アルベドにお礼しないとね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751970118
					]
				},
				{
					"id": 751970118,
					"content": "#うんうん！オイラたちだけじゃ、どうしようもなかったもんな…{NICKNAME}、さっそく符石の力を取り出してみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751970120,
					"content": "ハハッ、それじゃ、この「牙」を受け取ってくれ。頼んだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970121
					],
					"speakerTitle": "ウルバン"
				},
				{
					"id": 751970121,
					"content": "それにしても、千年前の石から「生命力」を抽出できるなんて…錬金術っていうのは実に不思議なものだな。一体どういう原理なんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウルバン"
				},
				{
					"id": 751970119,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751970120
					]
				}
			]
		},
