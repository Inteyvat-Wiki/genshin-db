			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"玄冬林檎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721123501,
					"content": "おみくじを引きたいんですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123502
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721123502,
					"content": "うわっ、態度が冷たいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721123503,
					"content": "おみくじを引きたい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721123504
					]
				},
				{
					"id": 721123504,
					"content": "分かりました。流れはこうです。まずは力を入れて、この何とかっていう箱を振ってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123505
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721123505,
					"content": "たしか「みくじ箱」っていうらしいよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721123506
					]
				},
				{
					"id": 721123506,
					"content": "そうです。その中から一本のみくじ竹が落ちてきます。そのみくじ竹を私に渡せば、あなたに相応の紙切れを差し上げます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123507
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721123507,
					"content": "たしか「おみくじ」っていうらしいよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721123508
					]
				},
				{
					"id": 721123508,
					"content": "そんなことはどうでもいいんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123509
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721123509,
					"content": "オイラ質問があるぞ！もし、オイラたちが凶のおみくじを引いちゃったら、どうすればいいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123510
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721123510,
					"content": "それが運命というものです。他にどうしろというのでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123511
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721123511,
					"content": "えっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123512
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721123512,
					"content": "外に柵みたいなものがあるけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721123513
					]
				},
				{
					"id": 721123513,
					"content": "チッ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123514
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721123514,
					"content": "いま露骨に「チッ」って言ったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123515
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721123515,
					"content": "えっと…たしか、「凶のおみくじを『みくじ掛け』に結ぶと、縁起直しができる」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123516
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721123516,
					"content": "あっ、そうですね！凶のおみくじを引いてしまったら、あの掛けに結べばいいじゃないですか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123517
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721123517,
					"content": "まったく彼らは本当…あっいえ、私たち「鳴神大社」はとても優しいので、凶のおみくじを引いても、あなたたちに運勢を変える機会を与えるんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123518
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721123518,
					"content": "なんか変なんだよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123519
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721123519,
					"content": "#{NICKNAME}、おみくじを引こう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
