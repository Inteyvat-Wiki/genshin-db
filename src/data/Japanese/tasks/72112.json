					"nextDialogs": [
						721123602
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721123602,
					"content": "は、はい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721123603
					]
				},
				{
					"id": 721123603,
					"content": "神社って本当に人間味のないところだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721123604,
					"content": "これをどうぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123605
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721123605,
					"content": "うむ、運勢を見てみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123606
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721123606,
					"content": "それと、おみくじは一日に一回だけ引くことができます、どうかお忘れなく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123607
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721123607,
					"content": "そうでなければ私も疲れて…いえ、みくじ掛けがいっぱいに…でもなく、なんでしたっけ？たしか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123608
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721123608,
					"content": "「おみくじは神様の意志の具現。そのため、神様の意志を尊重し、できる限りのことをすべきである。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123609
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721123609,
					"content": "ほら、うまいことが書かれていますよね。だから一日に一回だけなんです、覚えておいてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玄冬林檎"
				}
			]
		},
