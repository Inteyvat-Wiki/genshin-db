			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ヴィナヤック",
					"シュリヤ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735180101,
					"content": "チャージ装置の動きが前よりスムーズになった…君の言う通り、この区域の元素環境が、少しずつ通常状態にまで回復してきているんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180102
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735180102,
					"content": "…ウェネトによる影響も、少し経てば消えてしまうだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180103
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735180103,
					"content": "はいはいはい、あなたの宝物の「対ウェネト殺蟲大砲」のおかげね。さあ、任務結果を報告して、各自帰宅するとしましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180104
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735180104,
					"content": "——僕たちの「対ウェネト殺蟲大砲」だ。シュリヤ、これが僕たち二人の共同成果であることを、僕は一度も忘れたことはないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180105
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735180105,
					"content": "…昔はかなり言い争っていたが、君なしでは、僕もこれが完成する日を迎えることはできなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180106
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735180106,
					"content": "こ…こんな時にいきなり何を言い出すのよ！何よ、報告であなたのことを褒めてほしいわけ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180107
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735180107,
					"content": "まあ、ふと思っただけだよ。この数日のことって、その時の状況とけっこう似てるだろ。言い争ったり試行錯誤したりはしてたけど、結局は問題をちゃんと解決できた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180108
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735180108,
					"content": "——それに、認めざるを得ないのは、最後はやはり、いつも君の解決策のほうが効率がいいと言う点だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180109
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735180109,
					"content": "私は…その…それほどでもないわよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180110
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735180110,
					"content": "…正直、あなたの考えもちゃんと正しかったわよ。実際、「対ウェネト殺蟲大砲」の実験をしないことには、私もこれらのデータを入手できなかったわけで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180111
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735180111,
					"content": "「歯車を一つ交換するだけで機械は修理できるかもしれない。しかし一番難しいのは、どうやってその歯車を見つけ出すかということだ…」、先生の言葉が、今頃になって分かった気がするよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180112
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735180112,
					"content": "君がいてくれて本当によかった、シュリヤ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180113
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735180113,
					"content": "ええ…君もね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180114
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735180114,
					"content": "#どういうことだ？{NICKNAME}、この二人の空気が、急におかしくなったぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180115,
						735180116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735180115,
					"content": "パイモン…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735180117
					]
				},
				{
					"id": 735180117,
					"content": "コホン！昔、卒業プロジェクトのことで関係があんなに悪くなったのは、お互いに未熟すぎたせいってことね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180118
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735180118,
					"content": "そうだな。振り返ってみると、さほど大きなトラブルもなかったのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180119
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735180119,
					"content": "その——今度、一緒にカフェに行かない？今回の報告レポートについて相談するために。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735180116,
					"content": "それ以上聞かないで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735180117
					]
				}
			]
		}
	]
}