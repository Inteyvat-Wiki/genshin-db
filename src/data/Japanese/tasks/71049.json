			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿旭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710490201,
					"content": "すみませんがまだ用事がありまして、他にご用があれば後ほど伺いますね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710490202,
						710490207,
						710490212
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 710490202,
					"content": "層岩巨淵について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710490203
					]
				},
				{
					"id": 710490203,
					"content": "ああっ、私ったら…層岩巨淵の事情もご説明せずに、依頼を託すなんて！失礼しました！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710490204
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 710490204,
					"content": "実は私も詳しくはないのですが、事の起こりは数年前でした…あそこの鉱夫が変なものを掘り出して…それが何なのか、私たちは知らないし、聞く勇気もありませんでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710490205
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 710490205,
					"content": "輝山庁が七星に報告した後、凝光様の秘書が調査隊を派遣しました。そして調査隊が戻ったら、安全上の懸念があると言って、鉱坑を封鎖したんです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710490206
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 710490206,
					"content": "そうして今の層岩巨淵になったというわけです。盛露庁のお方たちは毎日、いつ再開できるか尋ねています。ですが、七星がどうしても許可してくれないんですから、焦りながらも待つしかありません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿旭"
				},
				{
					"id": 710490207,
					"content": "沐寧について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710490208
					]
				},
				{
					"id": 710490208,
					"content": "ええ、彼の生家は盛露庁でも屈指の陶磁器商なんです。でも彼自身は家の商売には興味がなく、ただただ食べたり遊んだりするのが好きで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710490209
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 710490209,
					"content": "経営もモラの管理も全く分からないものですから、借金もかなり抱えています…家族は彼が家の評判を落とすかもしれないと心配し、彼を総務司に送り込んだんです。責任感ある立場に置いて鍛えようとしているみたいで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710490210
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 710490210,
					"content": "ちょうど総務司も層岩巨淵を監視する盛露庁の専門家が必要だったので、彼を雇いました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710490211
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 710490211,
					"content": "まあ、いい事だと思いますよ。私の父も、層岩巨淵は修行の場だと言ってました。父は若い頃、あの鉱区に入ったことがあって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿旭"
				},
				{
					"id": 710490212,
					"content": "また後で。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710490213
					]
				},
				{
					"id": 710490213,
					"content": "ええ、いってらっしゃい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿旭"
				}
			]
		}
	]
}