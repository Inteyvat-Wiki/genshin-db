					"イーディス博士"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 207030101,
					"content": "これも創作のネタとして使えないか、残念。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030102
					],
					"speakerTitle": "イーディス博士"
				},
				{
					"id": 207030102,
					"content": "なにしてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207030103
					]
				},
				{
					"id": 207030103,
					"content": "「風」をテーマにしたモンド歴史の本を書こうと思ってね、今ここでインスピレーションを探してるところよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030104
					],
					"speakerTitle": "イーディス博士"
				},
				{
					"id": 207030104,
					"content": "ここには風の「七天神像」があるし、大英雄ヴァネッサ様と関係する木もあるでしょ。ここは一番いい場所なの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030105
					],
					"speakerTitle": "イーディス博士"
				},
				{
					"id": 207030105,
					"content": "でも私は「神の目」を持ってないから、「風」を探すのも集めるのも至難の業なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030106
					],
					"speakerTitle": "イーディス博士"
				},
				{
					"id": 207030106,
					"content": "インスピレーション探しというのも、ここでボーっとしてるだけなの。数少ないネタも、他の本で見た記録だもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030107
					],
					"speakerTitle": "イーディス博士"
				},
				{
					"id": 207030107,
					"content": "この大陸「神の目」を持ってない人は何をしても苦労するからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030108
					],
					"speakerTitle": "イーディス博士"
				},
				{
					"id": 207030108,
					"content": "「神の目」がないと、元素の力は使えない…研究も生活も、この世界の部外者みたいでね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030109
					],
					"speakerTitle": "イーディス博士"
				},
				{
					"id": 207030109,
					"content": "ハハッ、神様からしたら「神の目」を持ってる者こそが、この世界の主役かもしれないわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030110
					],
					"speakerTitle": "イーディス博士"
				},
				{
					"id": 207030110,
					"content": "ごめんなさい、無駄話に付き合わせたわね。まあ、そうは言うけど、私は研究を諦めないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030111
					],
					"speakerTitle": "イーディス博士"
				},
				{
					"id": 207030111,
					"content": "「神の目」がなくても、学術面で負けたくないもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030112
					],
					"speakerTitle": "イーディス博士"
				},
				{
					"id": 207030112,
					"content": "それに私聞いたんだけど、あなたも「神の目」を持ってないのに元素が見えるよね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030113
					],
					"speakerTitle": "イーディス博士"
				},
				{
					"id": 207030113,
					"content": "もし「風」元素が付着したものを入手できるなら、きっと私の研究に役に立つと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030114
					],
					"speakerTitle": "イーディス博士"
				},
				{
					"id": 207030114,
					"content": "旅人、私の代わりに木の上を探してみてくれないかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イーディス博士"
				}
			]
		},
