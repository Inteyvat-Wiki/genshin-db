					"nextDialogs": [
						207030303
					],
					"speakerTitle": "イーディス博士"
				},
				{
					"id": 207030303,
					"content": "あなたは「元素」が見える、そうよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030304
					],
					"speakerTitle": "イーディス博士"
				},
				{
					"id": 207030304,
					"content": "たぶん、「風」の痕跡を辿って探してみるといいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030305
					],
					"speakerTitle": "イーディス博士"
				},
				{
					"id": 207030305,
					"content": "木の下で待ってるから、何か見つけたら私に渡してね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イーディス博士"
				}
