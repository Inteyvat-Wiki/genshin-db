			"dialogs": [
				{
					"id": 207030501,
					"content": "何か発見は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030502
					],
					"speakerTitle": "イーディス博士"
				},
				{
					"id": 207030502,
					"content": "「葉っぱ」を見つけた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207030503
					]
				},
				{
					"id": 207030503,
					"content": "…葉っぱ？見せて。あら、箱に入れたのね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030504
					],
					"speakerTitle": "イーディス博士"
				},
				{
					"id": 207030504,
					"content": "この葉っぱたち…手に取ると確かに「風」を感じる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030505
					],
					"speakerTitle": "イーディス博士"
				},
				{
					"id": 207030505,
					"content": "この木には本当にこういう力があるのね…私も「神の目」を持ってたら、今まで時間を無駄にすることもなかったのになぁ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030506
					],
					"speakerTitle": "イーディス博士"
				},
				{
					"id": 207030506,
					"content": "ありがとう。これは創作ネタとして大事に使うわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030507
					],
					"speakerTitle": "イーディス博士"
				},
				{
					"id": 207030507,
					"content": "でも、この「葉っぱ」の保管方法はないし、「風」もすぐに消えるかもしれないのは困るわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030508
					],
					"speakerTitle": "イーディス博士"
				},
				{
					"id": 207030508,
					"content": "はい、これはあなたへの報酬よ。またネタ集めをお願いするかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イーディス博士"
				}
			]
		}
