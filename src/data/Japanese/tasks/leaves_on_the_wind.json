			"dialogs": [
				{
					"id": 207030401,
					"content": "認めたくないけど、研究に関しては、あなたのほうが向いてると思うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030402
					],
					"speakerTitle": "イーディス博士"
				},
				{
					"id": 207030402,
					"content": "冒険経験は豊富だし、身体能力もいい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030403
					],
					"speakerTitle": "イーディス博士"
				},
				{
					"id": 207030403,
					"content": "なによりも「神の目」を持ってないのに、元素を操られるところね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030404
					],
					"speakerTitle": "イーディス博士"
				},
				{
					"id": 207030404,
					"content": "元素…この大陸で元素と関係ない研究なんてないでしょ？学者にとって、元素を操れないのはかなり痛手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030405
					],
					"speakerTitle": "イーディス博士"
				},
				{
					"id": 207030405,
					"content": "あっ、また勝手に話を進めちゃってごめんなさい…あまり気にしないで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イーディス博士"
				}
			]
