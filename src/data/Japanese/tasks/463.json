			"dialogs": [
				{
					"id": 4630301,
					"content": "ここが…一番奥か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4630302,
					"content": "おったから～おったから～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4630303,
					"content": "#{NICKNAME}、手分けしてこの辺りを探そうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4630304,
					"content": "ハハハッ…その必要はない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630305
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 4630305,
					"content": "あとはこちらに任せてもらおう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630306,
						4630308
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 4630306,
					"content": "宝盗団の人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630307
					]
				},
				{
					"id": 4630307,
					"content": "勘がいい。でも、気付くのが遅すぎた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630311
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 4630311,
					"content": "イザードだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630312
					],
					"speakerTitle": "イザード"
				},
				{
					"id": 4630312,
					"content": "宝盗団を代表して礼を言う。道案内、ご苦労さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630313
					],
					"speakerTitle": "イザード"
				},
				{
					"id": 4630313,
					"content": "そんな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630314
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4630314,
					"content": "おかしい、オイラたちこっそり動いてたのに、お宝の情報はどこから漏れたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630315
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4630315,
					"content": "全然、おかしくないと思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630316
					]
				},
				{
					"id": 4630316,
					"content": "ふん、でもオイラは諦めないぜ。おい、そこの盗賊！オイラたちが抵抗しないとでも思ってるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630317
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4630317,
					"content": "見くびってもらっては困るよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630318
					],
					"speakerTitle": "イザード"
				},
				{
					"id": 4630318,
					"content": "俺の号令一つで、外で待機している仲間が入ってくる手はずになってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630319
					],
					"speakerTitle": "イザード"
				},
				{
					"id": 4630319,
					"content": "俺と違って、話が通じないヤツらでね…フフッ、ハッハハハハ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630320
					],
					"speakerTitle": "イザード"
				},
				{
					"id": 4630320,
					"content": "（ガイアと西風騎士団が登場）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630321
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4630321,
					"content": "お楽しみのところ申し訳ないが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630322
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4630322,
					"content": "仲間とやらが、ここに来ることはないぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630323
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4630323,
					"content": "そいつらとは…もうモンドの牢獄内でしか会えないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630324
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4630324,
					"content": "もちろん、すぐにお前も再会させてやる、その牢獄の中でな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630325
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4630325,
					"content": "騎士団だと…！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630326
					],
					"speakerTitle": "イザード"
				},
				{
					"id": 4630326,
					"content": "うわ、ガイアだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630327
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4630327,
					"content": "——ガイア！こいつ、おまえのお宝を狙ってるみたいだぜ！早く捕まえろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630328
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4630328,
					"content": "ちっ、あとちょっとだったというのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630329
					],
					"speakerTitle": "イザード"
				},
				{
					"id": 4630329,
					"content": "ほお、お宝？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630330
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4630330,
					"content": "悪いが、ここにお宝なんてないぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630331
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4630331,
					"content": "無駄足ご苦労さん。大人しくお縄につきな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630332
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4630332,
					"content": "え？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630333
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4630333,
					"content": "お宝が…ない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630334
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4630334,
					"content": "今…お宝がない…って言ったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630335
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4630335,
					"content": "ククッ、ハハハッ…やられた。騎士様も汚い手を使うんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630336
					],
					"speakerTitle": "イザード"
				},
				{
					"id": 4630336,
					"content": "盗賊ごときに騎士の何たるかを語られてもね…おい、何をする気だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630337
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4630337,
					"content": "大人しく捕まってたまるか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
