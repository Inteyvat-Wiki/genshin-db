				"points": []
			},
			"dialogs": [
				{
					"id": 4630101,
					"content": "「アルカディア遺跡」って、ここだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4630102,
					"content": "何て言うか…普通だな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4630103,
					"content": "分かったぞ！普通だからこそ、誰も気づかなかったんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4630104,
					"content": "深いぜ、ガイアのじいちゃん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4630105,
					"content": "——ササッ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630106
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 4630106,
					"content": "今の音、聞こえた…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630107
					]
				},
				{
					"id": 4630107,
					"content": "ネズミだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4630108,
					"content": "適当に答えてない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630109
					]
				},
				{
					"id": 4630109,
					"content": "ビクビクすんなって、大丈夫だから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4630110,
					"content": "さっさと行こう！お宝が待ってるぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 46303,
			"completionStepIds": [
				46303
