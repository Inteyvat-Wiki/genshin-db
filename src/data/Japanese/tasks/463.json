			"dialogs": [
				{
					"id": 4630001,
					"content": "これで謎はすべて解けたぜ。大変だったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630014
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4630014,
					"content": "それより、この宝の地図、随分と雑だな。海賊らしいと言えばらしいけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630002
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4630002,
					"content": "それじゃあ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630003,
						4630005
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4630003,
					"content": "ガイアに報告する",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630004
					]
				},
				{
					"id": 4630004,
					"content": "はわ…？ほ、報告なんて、いらないと思うな～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630006
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4630006,
					"content": "さすがオイラの相棒！まったく同じことを考えてたぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630007
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4630007,
					"content": "すぐに行かないとな、誰かに先を越されたらまずいもんな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630008
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4630008,
					"content": "例えばガイアが…あっ、えーと、ガイアが言ってた「宝盗団」とかいうヤツらにな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630009
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4630009,
					"content": "オイラは、ただその噂の剣をこの手に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630010
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4630010,
					"content": "いやいや、一目見れればいいんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630011
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4630011,
					"content": "天下無敵とか、遊んで暮らしたいとか考えてないんだからなっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630012
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4630012,
					"content": "さあ、おしゃべりはお宝を見つけた後にしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630013
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4630013,
					"content": "アルカディアのお宝探しの旅へ——出発！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4630005,
					"content": "お宝へゴー！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630006
					]
				}
			]
		},
		{
