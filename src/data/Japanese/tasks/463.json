					"nextDialogs": [
						4630529,
						4630530
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4630531,
					"content": "それじゃ、俺は帰ってヤツらの尋問をしてくる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4630532,
					"content": "今日はここで失礼するぜ。また騎士団に会いに来てくれよ。じゃあな。",
