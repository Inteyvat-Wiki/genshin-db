						],
						"pointId": 10050
					}
				]
			},
			"dialogs": [
				{
					"id": 750670201,
					"content": "ああ、ここはやはり呪われた地だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750670202
					],
					"speakerTitle": "クエニン"
				},
				{
					"id": 750670202,
					"content": "ここから早く去れ。長居しない方がいい……そう、漆黒の潮が押し寄せる前に、絶対にここを離れるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750670203
					],
					"speakerTitle": "クエニン"
				},
				{
					"id": 750670203,
					"content": "そう、漆黒の潮…あの巨大な影がじきにやって来る。み…皆を避難させないと。皆の安全を…守らないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "クエニン"
				}
			]
		},
		{
