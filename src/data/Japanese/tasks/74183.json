			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ウスさん"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741832201,
					"content": "そういえば、ヌヴィレットって…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832202
					]
				},
				{
					"id": 741832202,
					"content": "そうだぞ。ヌヴィレットって水龍だろ？ってことは、こいつ…まさか、ヌヴィレットよりもずっと年上だったりして…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741832203,
					"content": "新たな水龍が誕生したのか？ううむ…かつての衆の水の主はとうにお隠れになった…本当に長い時が経ったのだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウスさん"
				}
			]
		},
		{
			"id": 7418323,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7418304",
							"2"
						],
						"stepId": 7418304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ウスさん"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741832301,
					"content": "ともかく、悪龍スキュラはかつて、至尊の友人だった。しかし、我々レムリア人とフォンテーヌ人の決戦という大事な時に…彼らは反乱を起こしたのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832302
					],
					"speakerTitle": "ウスさん"
				},
				{
					"id": 741832302,
					"content": "当時、悪龍は残虐な龍の子孫を率いて「マキモス」にやってきて、城の内部…至尊のいた「カピトリウム」に攻め入ろうとした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832303,
						741832304
					],
					"speakerTitle": "ウスさん"
				},
				{
					"id": 741832303,
					"content": "「マキモス」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832305
					]
				},
				{
					"id": 741832305,
					"content": "たしか、町の人たちも「マキモス」とか、時計台とか言ってたな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741832306,
					"content": "ああ、「マキモス」とは王城の外郭のことだ。悪龍が城の中に入るためには、「ヤヌスの門」を通らなければならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832307
					],
					"speakerTitle": "ウスさん"
				},
				{
					"id": 741832307,
					"content": "その門は、王城の外と内を隔てる壁だ。かつて至尊と楽師たちが作った楽章も、「ヤヌスの門」を通る金色の水路を辿って、レムリア全域へと広がった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832308
					],
					"speakerTitle": "ウスさん"
				},
				{
					"id": 741832308,
					"content": "ボエティウスと彼の軍団は、まさにその点を利用して「ヤヌスの門」を封鎖し、最終的に悪龍を封印したのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832309
					],
					"speakerTitle": "ウスさん"
				},
				{
					"id": 741832309,
					"content": "おそらく、スキュラは至尊のもとに行きたかったのだろう。しかし、それは叶わなかった。その後、悪龍はレムリアとともに深海に沈み、至尊の姿も消え…今日に至るまで行方不明のまま…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832310,
						741832311,
						741832312
					],
					"speakerTitle": "ウスさん"
				},
				{
					"id": 741832310,
					"content": "（どこか辻褄が合わないような…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832313
					]
				},
				{
					"id": 741832313,
					"content": "#{NICKNAME}、何か思い当たることでもあったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832314
					],
					"speakerTitle": "ウスさん"
				},
				{
					"id": 741832314,
					"content": "ちょっと混乱してる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832315
					]
				},
				{
					"id": 741832315,
					"content": "無理もない…私も後から聞いた話だ。災いが起きたとき、私は王城にいなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832316
					],
					"speakerTitle": "ウスさん"
				},
				{
					"id": 741832316,
					"content": "当時、至尊の周囲で一体何が起きていたのか、知る者はいない。共にこの先を進んでみないと分からぬかもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832317
					],
					"speakerTitle": "ウスさん"
				},
				{
					"id": 741832317,
					"content": "おそらく、前に城で見た光る大きい魚は…スキュラを閉じ込めた、石の監獄の裂け目から漏れ出した意識だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832318
					],
					"speakerTitle": "ウスさん"
				},
				{
					"id": 741832318,
					"content": "彼はとうに私たちに気付いていたのやもしれぬ。ここに封印されて以来、やっと外から来た人の気配がしたものだから、あらゆる方法で私たちに呼びかけてみたのだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832319
					],
					"speakerTitle": "ウスさん"
				},
				{
					"id": 741832319,
					"content": "そうだったのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832320
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741832320,
					"content": "待てよ、黄金の宮殿に行くためには、あのなんとかって門を通らないといけないって言ってたけど、ボエティウスが門を閉めてるのなら、そもそも行けないんじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832321
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741832321,
					"content": "確かに困ったな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832322
					],
					"speakerTitle": "ウスさん"
				},
				{
					"id": 741832322,
					"content": "う～っ、失礼にもほどがあるぞ！「黄金の宮殿で待ってる」とかまじめな顔で言っておきながら…結局、門を開けてもくれてないじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832323
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741832323,
					"content": "いっそのこと、あいつが封じ込めた悪龍の封印を解除してやって、その龍に力ずくで門を開けさせるってのはどうだ？",
