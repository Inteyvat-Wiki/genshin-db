			},
			"dialogs": [
				{
					"id": 741832101,
					"content": "ヴィシャップがこんなに大きくなるなんて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832102
					]
				},
				{
					"id": 741832102,
					"content": "ふん、教養とはかけ離れたところで、野蛮に成長した種族だからな。これよりもっと変な姿になったとしても、驚きはしない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウスさん"
				}
			]
		},
		{
			"id": 7418322,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
