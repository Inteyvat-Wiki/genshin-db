			"dialogs": [
				{
					"id": 741830401,
					"content": "うわっ！こいつ、前に見た光る魚とそっくりじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741830402,
					"content": "周りになんか変なものも絡まってるし…いったいどういう状況なんだ？ますますわかんなくなってきたぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830403,
						741830404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741830403,
					"content": "この声…前、夢の中で聞いたことがある…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830405
					]
				},
				{
					"id": 741830405,
					"content": "ふむ、至尊の記憶の中で彼と会ったのだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830406
					],
					"speakerTitle": "ウスさん"
				},
				{
					"id": 741830406,
					"content": "彼の名は「スキュラ」、かつて至尊に仕えた悪龍だ。ボエティウスによって鎮められ、ここに封印されている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830407
					],
					"speakerTitle": "ウスさん"
				},
				{
					"id": 741830407,
					"content": "ええっ？悪龍を鎮めたのか？あの礼儀知らず、結構すごいこともしてたんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741830408,
					"content": "悪龍とは呼ぶが、実際は少々強いヴィシャップにすぎない。衆の水の主が深海に住まう限り、新たな水龍が誕生することはないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウスさん"
				},
				{
					"id": 741830404,
					"content": "でも、名前は覚えてない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830405
					]
				}
			]
		},
		{
			"id": 7418306,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7418306",
							"2"
						],
						"stepId": 7418306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"スキュラ",
					"ウスさん"
				],
				"points": [
					{
						"sceneId": 11,
						"position": [
							1569,
							656.42,
							4486
						],
						"pointId": 901101005
					}
				]
			},
			"dialogs": [
				{
					"id": 741830601,
					"content": "おおっ、なんと暖かな海流…！やっと自由の身になれた…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830602
					],
					"speakerTitle": "スキュラ"
				},
				{
					"id": 741830602,
					"content": "小さき者たちよ、地上から来たのか？なぜお前たちが、この深海の檻にいるのか甚だ疑問だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830603
					],
					"speakerTitle": "スキュラ"
				},
				{
					"id": 741830603,
					"content": "オイラたちは小さくなんかじゃないぞ！おまえがデカすぎるだけだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741830604,
					"content": "ふぉふぉっ、まあよい！何はともあれ、お前たちは数千年にわたってワシを縛りつけていた枷を解いてくれた。恩に着る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830605
					],
					"speakerTitle": "スキュラ"
				},
				{
					"id": 741830605,
					"content": "お礼に、ワシにできることがあれば、遠慮なく言うがよい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830606
					],
					"speakerTitle": "スキュラ"
				},
				{
					"id": 741830606,
					"content": "#へへっ、話が通じそうなやつだって思ってたんだ！そうだ、オイラはパイモン、こいつは{NICKNAME}だ。それとこっちは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830607
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741830607,
					"content": "ん～…どの名前になら馴染みがあるのかわかんないけど、オイラたちは「ウスさん」って呼んでるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830608
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741830608,
					"content": "ふむ、カッシオドル、久しいな。帰ってきたのか？少し遅かったではないか…数千年ほどか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830609
					],
					"speakerTitle": "スキュラ"
				},
				{
					"id": 741830609,
					"content": "おっ、でっかいのはウスさんとも知り合いみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830610
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741830610,
					"content": "恥知らずの裏切り者と話すことなどない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830611
					],
					"speakerTitle": "ウスさん"
				},
				{
					"id": 741830611,
					"content": "凡人よ、言葉に気をつけよ！お前たちのような傲慢な種族とは違い、ワシら龍の子孫は約束を守る。絶対に裏切ったりはせぬ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830612
					],
					"speakerTitle": "スキュラ"
				},
				{
					"id": 741830612,
					"content": "そんな言葉には、水中のかげろうほどの価値もない。君が裏切ったことは紛れもない事実——君が裏切ったせいで、私たちはあの戦争に負けたのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830613
					],
					"speakerTitle": "ウスさん"
				},
				{
					"id": 741830613,
					"content": "もしも負けていなければ…私たちの国も…至尊もあんな結果には…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830614
					],
					"speakerTitle": "ウスさん"
				},
				{
					"id": 741830614,
					"content": "カッシオドルよ、長く離れすぎておったな！真相はお前が想像しているものとは違う。まあ、元より秘密の計画だったのじゃから、詳細を知らないのも仕方あるまい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830615
					],
					"speakerTitle": "スキュラ"
				},
				{
					"id": 741830615,
					"content": "…秘密の計画？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830616
					],
					"speakerTitle": "ウスさん"
				},
				{
					"id": 741830616,
					"content": "ワシにヴィシャップの大軍を率いて王城に攻め入るようにと命じたのは、ほかでもないレムスじゃった。あれはあやつが企てた、最後の…秘密の計画の一部だったんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830617
					],
					"speakerTitle": "スキュラ"
				},
				{
					"id": 741830617,
					"content": "すべては、自らの国と民を救うために実行した計画じゃ。あやつは実に大きな器の持ち主じゃった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830618,
						741830619
					],
					"speakerTitle": "スキュラ"
				},
				{
					"id": 741830618,
					"content": "あり得ない話に聞こえるけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830620
					]
				},
				{
					"id": 741830620,
					"content": "おかしすぎるだろ？自分の国を攻めるように頼む王がどこにいるんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830621
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741830621,
					"content": "小さき者よ、レムスの考えをお前やワシに推し量れるはずもなかろう。ともかく、カッシオドル、これを見れば、お前にだってその意味が分かるじゃろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830623
					],
					"speakerTitle": "スキュラ"
				},
				{
					"id": 741830623,
					"content": "金の蜂…運命を導く金の蜂は「楽章」の召喚にしか従わない。なぜ至尊は「楽章」の力を野蛮な龍に渡したのだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830624
					],
					"speakerTitle": "ウスさん"
				},
				{
					"id": 741830624,
					"content": "約束したから…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830625
					]
				},
				{
					"id": 741830625,
					"content": "ほう？小さき者よ、いろいろ知っておるようじゃな？どこでそんなことを知ったんじゃ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830626
					],
					"speakerTitle": "スキュラ"
				},
				{
					"id": 741830626,
					"content": "海に散らばった記憶の中から…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830627
					]
				},
				{
					"id": 741830627,
					"content": "その通りじゃ、ワシらは約束した。だが、ワシはあやつの期待を裏切ってしまった。あやつの高貴な犠牲を無駄にしてしまったのじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830628
					],
					"speakerTitle": "スキュラ"
				},
				{
					"id": 741830628,
					"content": "ワシが黄金の宮殿に着いたときには、もう手遅れじゃった！荒れ狂う波は街を丸ごと呑み込み、ワシら一族も、そこから逃れることはできなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830629
					],
					"speakerTitle": "スキュラ"
				},
				{
					"id": 741830629,
					"content": "…そんなことが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830630
					],
					"speakerTitle": "ウスさん"
				},
				{
					"id": 741830630,
					"content": "裏切り者と言うならば、ボエティウスこそ本物の裏切り者じゃ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830631
					],
					"speakerTitle": "スキュラ"
				},
				{
					"id": 741830631,
					"content": "あの嘘だらけの化け物、鼠のごとき詐欺師の巧みな話術に騙されなければ…古龍の後に龍の子孫を統べた王たるワシが、斯くも容易く敗れるわけがなかろうが？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830632
					],
					"speakerTitle": "スキュラ"
				},
				{
					"id": 741830632,
					"content": "あやつは狡猾じゃ。レムスの命令により、全軍抵抗を諦めると嘘をつきおった。じゃが、ワシらが此処に辿り着くや否や、やつはワシらに向けて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830633
					],
					"speakerTitle": "スキュラ"
				},
				{
					"id": 741830633,
					"content": "今思えば、やつは、とうに何らかの手段でレムスの計画のことを知っておったんじゃろう。そして綿密に計画を練り、一歩ずつワシを罠に誘導していった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830634
					],
					"speakerTitle": "スキュラ"
				},
				{
					"id": 741830634,
					"content": "そうして、ワシの血肉は岩と化した…しかし、数千年経った今日になって、お前たちに助けられたんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830635
					],
					"speakerTitle": "スキュラ"
				},
				{
					"id": 741830635,
					"content": "ボエティウスは、自らの行動が甚大な災いをもたらすであろうことを知っていたはずだ。なのに、なぜそんな罪深いことを…まさか、「フォボス」の支配権を簒奪しようと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830636
					],
					"speakerTitle": "ウスさん"
				},
				{
					"id": 741830636,
					"content": "まだ事の全貌が見えたわけじゃない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830637
					]
				},
				{
					"id": 741830637,
					"content": "ふん、人のことを裏切り者とか言ってた本人が、裏切り者だったんじゃないか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830638
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741830638,
					"content": "でも、なんでそんなことをする必要があったんだ…？あの礼儀知らずに聞くしかないのか？ま、聞いても素直に話してくれそうにないけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830639
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741830639,
					"content": "ん？間違っておるという自覚すらない恥知らずの化け物はまだ消え失せておらぬのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830640
					],
					"speakerTitle": "スキュラ"
				},
				{
					"id": 741830640,
					"content": "そうだぞ！しかもあいつ、たくさんのフォンテーヌ人の魂を奪ったんだ！オイラたちがここに来たのも、みんなを助けるためなんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830641
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741830641,
					"content": "黄金の宮殿でオイラたちを待ってるって…いや、ウスさんを待ってるってあいつ言ってたぞ。オイラたちは招かれざる勇者だとか言っちゃってさ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830699
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741830699,
					"content": "あいつ、門も開けてくれなかったんだぞ。まったく、失礼なやつだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830642
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741830642,
					"content": "ヤヌスの門か…ふん、幻術が施されているが、あんなものはただの石の門じゃ。ただの目くらましじゃろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830643
					],
					"speakerTitle": "スキュラ"
				},
				{
					"id": 741830643,
					"content": "肉体は失ったが、小さき者たちを送り届けるぐらいなら片手間でできるじゃろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830648
					],
					"speakerTitle": "スキュラ"
				},
				{
					"id": 741830648,
					"content": "小さき者たちよ、とくと見よ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830644
					],
					"speakerTitle": "スキュラ"
				},
				{
					"id": 741830644,
					"content": "おおっ！でっかいの、おまえ結構頼もしいじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830649
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741830649,
					"content": "あとは現れたこれらの封印を一つずつ壊してゆけばよい。準備ができたら出発じゃ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830645
					],
					"speakerTitle": "スキュラ"
				},
				{
					"id": 741830645,
					"content": "ウスさんは準備できたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830646
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741830646,
					"content": "ここまで来たら、もう前に進むしかないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830647
					],
					"speakerTitle": "ウスさん"
				},
				{
					"id": 741830647,
					"content": "#よし。{NICKNAME}はどうだ、いけるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741830619,
					"content": "#{M#君}{F#あなた}も頭がおかしくなったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830620
					]
				}
			]
		},
