			"dialogs": [
				{
					"id": 240060601,
					"content": "いや、違う…ここの論証はおかしいぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060602
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240060602,
					"content": "#オーレルったら相変わらず上の空ね…{M#お兄さん}{F#お姉さん}、遊んでくれてありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060603,
						240060604
					],
					"speakerTitle": "ロウ"
				},
				{
					"id": 240060603,
					"content": "オーレル…大丈夫？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060605
					]
				},
				{
