			},
			"dialogs": [
				{
					"id": 240060401,
					"content": "オーレル、ちゃんと考えをまとめられるかしら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060402
					],
					"speakerTitle": "ロウ"
				},
				{
					"id": 240060402,
					"content": "#ええっ！？よくここがわかったわね！{M#お兄さん}{F#お姉さん}のかくれんぼ経験値って一体どのくらいなの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060403
					],
					"speakerTitle": "ロウ"
				},
				{
					"id": 240060403,
					"content": "じゃあ集合場所に行くわね。次はもっとうまく隠れるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ロウ"
				}
