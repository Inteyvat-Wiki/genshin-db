			"trigger": {
				"objectNames": [
					"ヴェルー",
					"ロウ",
					"オーレル"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240060101,
					"content": "今度は僕が鬼だよ！絶対にロウを捕まえてみせるもん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060102
					],
					"speakerTitle": "ヴェルー"
				},
				{
					"id": 240060102,
					"content": "それはどうかしら？登れない場所だってあるでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060103
					],
					"speakerTitle": "ロウ"
				},
				{
					"id": 240060103,
					"content": "う…それは靴が合ってないからだもん！靴をかえたら絶対に捕まえられるもん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060104
					],
					"speakerTitle": "ヴェルー"
				},
				{
					"id": 240060104,
					"content": "だったら二人とも靴を脱ぎましょうよ。これで公平でしょ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060105
					],
					"speakerTitle": "ロウ"
				},
				{
					"id": 240060105,
					"content": "こらこら！ここら辺は廃棄パーツだらけなんだぜ。裸足で走り回って怪我でもしたらどうするんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060106
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240060106,
					"content": "はぁい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060107
					],
					"speakerTitle": "ロウ"
				},
				{
					"id": 240060107,
					"content": "わかったよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060108
					],
					"speakerTitle": "ヴェルー"
				},
				{
					"id": 240060108,
					"content": "ねぇ…おにいちゃん、さっき僕を捕まえたとき、なんでぼんやりしてたの？目の前を走っていったのに、なんだかぼうっとしてるんだもん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060109
					],
					"speakerTitle": "ヴェルー"
				},
				{
					"id": 240060109,
					"content": "え、そうだったか？完全に無意識だったよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060110
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240060110,
					"content": "そうよ。あたしなんて周りをぐるぐる回ってたのに、完全に上の空だったわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060111
					],
					"speakerTitle": "ロウ"
				},
				{
					"id": 240060111,
					"content": "#でも…あれ？{M#お兄さん}{F#お姉さん}、どうしましたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060112,
						240060115
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240060112,
					"content": "ロウはどうしてここに？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060113
					]
				},
				{
					"id": 240060113,
					"content": "パパは出張続きで、ママもお仕事なの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060114
					],
					"speakerTitle": "ロウ"
				},
				{
					"id": 240060114,
					"content": "そしたらちょうどオーレルが本を返しにきて、パパがオーレルに私たちの世話をお願いしたの。だから一緒に遊んでるのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060118
					],
					"speakerTitle": "ロウ"
				},
				{
					"id": 240060118,
					"content": "まぁいいか。それじゃ、次は誰が鬼をやる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060119,
						240060120
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240060119,
					"content": "あまりかくれんぼは好きじゃないんじゃ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060121
					]
				},
				{
					"id": 240060121,
					"content": "それは、コホン…実は最近初めての評論を書いてて、色々と考えることがあるんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060122
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240060122,
					"content": "それで、その…体を動かしてると頭の回転が速くなるなって思ったので…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060123
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240060123,
					"content": "でもすぐにぼうっとするわよね。ひどい時なんかその場でぶつぶつ独り言を言い出して、全然こっちに気づかないんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060124
					],
					"speakerTitle": "ロウ"
				},
				{
					"id": 240060124,
					"content": "#{M#おにいちゃん}{F#おねえちゃん}も一緒に遊ぼうよ。かくれんぼが一番得意だもんね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060125,
						240060126
					],
					"speakerTitle": "ヴェルー"
				},
				{
					"id": 240060125,
					"content": "いいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060127
					]
				},
				{
					"id": 240060127,
					"content": "えへへ、どうかなあ？僕とロウは「かくれんぼマスター」だもんね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060128
					],
					"speakerTitle": "ヴェルー"
				},
				{
					"id": 240060128,
					"content": "よーし、じゃあ今からね！ロウ、早く隠れようよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060129
					],
					"speakerTitle": "ヴェルー"
				},
				{
					"id": 240060129,
					"content": "ロウとヴェルーはあっという間に走り去っていった。一方、オーレルは何か考え込む様子でゆっくりと離れていった…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 240060126,
					"content": "#{M#俺}{F#私}には勝てっこないと思うよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060127
					]
				},
				{
					"id": 240060120,
					"content": "どうして急にかくれんぼがしたくなったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060121
					]
				},
				{
					"id": 240060115,
					"content": "またかくれんぼ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060116
					]
				},
				{
					"id": 240060116,
					"content": "そうです。ドルリューおじさんは出張があるしデュメおばさんも仕事だから、ロウの世話を頼まれて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060117
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240060117,
					"content": "それで、ロウをここに連れてきて一緒に遊んでるんです…スカートを汚さないといいけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060118
					],
					"speakerTitle": "オーレル"
				}
			]
		},
		{
			"id": 2400602,
			"completionStepIds": [
				2400602
			],
