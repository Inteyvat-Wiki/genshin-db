				"objectNames": [
					"ヴェルー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240060201,
					"content": "#やっぱり見つかっちゃったかぁ。{M#おにいちゃん}{F#おねえちゃん}は相変わらずすごいや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060202
					],
					"speakerTitle": "ヴェルー"
				},
				{
					"id": 240060202,
					"content": "じゃあ、集合場所に行ってるね。おにいちゃんが長く隠れていられればいいんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060203
					],
					"speakerTitle": "ヴェルー"
				},
				{
					"id": 240060203,
					"content": "どうしてそう思うの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060204
					]
				},
				{
					"id": 240060204,
					"content": "かくれんぼをしてると、おにいちゃんは新しい考えをいっぱい思いつくんだって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060205
					],
					"speakerTitle": "ヴェルー"
				},
				{
					"id": 240060205,
					"content": "新しい考えが多すぎて、毎回しゃがみこんでずっとメモを取ってるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060206
					],
					"speakerTitle": "ヴェルー"
				},
				{
					"id": 240060206,
					"content": "そしたらロウがね、「すごく大切な考えなんだから邪魔しちゃだめ」って言うんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060207
					],
					"speakerTitle": "ヴェルー"
				},
				{
					"id": 240060207,
					"content": "だから、三人でかくれんぼをしてる時は、おにいちゃんが隠れる番になったらわざと時間を稼いで、メモを取り終わってから探し始めるようにしてるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060208
					],
					"speakerTitle": "ヴェルー"
				},
				{
					"id": 240060208,
					"content": "まぁ…おにいちゃんが鬼になった時は、すごく待たないといけないんだけどね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴェルー"
				}
			]
		},
		{
			"id": 2400603,
			"completionStepIds": [
				2400603
			],
