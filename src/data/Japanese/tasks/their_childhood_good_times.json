					"オーレル"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240060301,
					"content": "違う…この論理は筋が通ってないな。別の角度から切り込まないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060302
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240060302,
					"content": "なら…いや、やっぱり違うな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060303
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240060303,
					"content": "ん？あ、見つかっちゃったんですね。集合場所に行かないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060304
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240060304,
					"content": "うーん…こういう観点なら？いや…どうなんだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "オーレル"
				}
			]
		},
		{
