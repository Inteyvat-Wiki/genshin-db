			},
			"dialogs": [
				{
					"id": 765120101,
					"content": "#試合もここまでくれば、{NICKNAME}の中で大方考えは決まったであろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120102
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 765120102,
					"content": "コホン…えー、なんだったか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120103
					],
					"speakerTitle": "シエチェフ"
				},
				{
					"id": 765120103,
					"content": "素晴らしいバトルもついに幕を閉じた！さあ、お待ちかねの結果発表の時間だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120104
					],
					"speakerTitle": "シエチェフ"
				},
				{
					"id": 765120104,
					"content": "#では、最終審査員の{NICKNAME}に、優勝者を選んでもらおう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120105
					],
					"speakerTitle": "シエチェフ"
				},
				{
					"id": 765120105,
					"content": "#{NICKNAME}が優勝者を決めるのか？へぇ…こんなの初めてだぞ。一番重要な審査員になるなんてな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120106,
						765120112,
						765120119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765120106,
					"content": "カッコいい忍犬「ガウ丸」を選ぶ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765120107
					]
				},
				{
					"id": 765120107,
					"content": "おう！オイラも「ガウ丸」が一番すごいと思うぞ。「太郎丸」みたいな風格があるもんな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765120108,
					"content": "ガウゥッ！ガウッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120109
					],
					"speakerTitle": "「ガウ丸」"
				},
				{
					"id": 765120109,
					"content": "よくやったわね、「ガウ丸」！お前の努力が実を結んで、最高の結果になったわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120110
					],
					"speakerTitle": "菫"
				},
				{
					"id": 765120110,
					"content": "予想通りの結果ですね。稲妻のお二方、おめでとうございます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120111
					],
					"speakerTitle": "「オニキス」"
				},
				{
					"id": 765120111,
					"content": "確かに勇ましく、そして強い忍犬でした。私も納得です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120125
					],
					"speakerTitle": "「減7のアルペジオ」"
				},
				{
					"id": 765120125,
					"content": "派手な表彰式はないものの、実戦を重視する諸君なら、大げさな儀式にこだわることもないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120126
					],
					"speakerTitle": "シエチェフ"
				},
				{
					"id": 765120126,
					"content": "#{NICKNAME}に認められることは、金メッキのトロフィーやメダルなんかを遥かに凌ぐ、ナド・クライで最高級の栄誉だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120127
					],
					"speakerTitle": "シエチェフ"
				},
				{
					"id": 765120127,
					"content": "#ふふ～ん、おまえたちはテイワットで初めて、{NICKNAME}からこんなふうに賞をもらった戦士かもな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765120128,
					"content": "これ以上の褒美は求めません。十分に楽しめました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120129
					],
					"speakerTitle": "「オニキス」"
				},
				{
					"id": 765120129,
					"content": "そうでしょう、ブダノーヴァ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120130
					],
					"speakerTitle": "「オニキス」"
				},
				{
					"id": 765120130,
					"content": "ええ。次は私たち従者部隊がスポンサーになって、もっと盛り上げるというのはいかがでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120131
					],
					"speakerTitle": "「減7のアルペジオ」"
				},
				{
					"id": 765120131,
					"content": "百人規模の初戦が理想的ですわね。そうすれば、情報にない所属不明の猛者が大勢参加するかもしれませんわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120132
					],
					"speakerTitle": "「減7のアルペジオ」"
				},
				{
					"id": 765120132,
					"content": "そうですね。このような大会であれば、擲弾兵たちも進んで出資に協力してくれるはずです。事前にバレリー少将に企画書を提出しておきます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120133
					],
					"speakerTitle": "「オニキス」"
				},
				{
					"id": 765120133,
					"content": "終末番も…えっと…もし予算が何千万モラにもなるなら、出資の話はさておき、忍犬部隊も積極的に参加させていただきます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120134
					],
					"speakerTitle": "菫"
				},
				{
					"id": 765120134,
					"content": "ガァウ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120135
					],
					"speakerTitle": "「ガウ丸」"
				},
				{
					"id": 765120135,
					"content": "皆の心遣いに感謝する。だが、このような勝負に特定の有力な出資者がいるとすれば、その性質も変わってしまうのではござらぬか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120136
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 765120136,
					"content": "猛者を招集したいという気持ちは理解できるが、どうかここは、自由の身である者を集めてもらえぬだろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120137
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 765120137,
					"content": "あっ、万葉の言いたいことって、もしかして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120138
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765120138,
					"content": "うむ。比較的中立的な立場にある冒険者協会が主催するのが、最善の選択であろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120139,
						765120140
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 765120139,
					"content": "大会なら純粋に戦いたいよね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765120141
					]
				},
				{
					"id": 765120141,
					"content": "なるほど…そういうことか！よし、オイラがびしっと言ってやる——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120142
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765120142,
					"content": "今回参加したファデュイの選手は二人とも礼儀正しかったけど、中にはすごく乱暴で、オイラたちを見たらすぐに攻撃してくるやつもいるだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120143
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765120143,
					"content": "もしおまえたちがスポンサーになったら、上位入賞した選手を入隊させようと勧誘するだろ？そうなると、ファデュイが戦力を強化するのにつながっちゃうじゃんか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120144
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765120144,
					"content": "ふふ、やはり見抜かれてしまいましたか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120145
					],
					"speakerTitle": "「オニキス」"
				},
				{
					"id": 765120145,
					"content": "そういったご意見も理解はできますが、私の一存ではお約束できかねます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120146
					],
					"speakerTitle": "「オニキス」"
				},
				{
					"id": 765120146,
					"content": "部隊が違えば任務のやり方も異なるのです。私のようなしがない尉官の言葉など、何の意味も持ちませんよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120147
					],
					"speakerTitle": "「オニキス」"
				},
				{
					"id": 765120147,
					"content": "#楓原さんのおっしゃることは理にかなっていますし、{NICKNAME}様とパイモン様がご心配なさるのもよく分かりますわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120148
					],
					"speakerTitle": "「減7のアルペジオ」"
				},
				{
					"id": 765120148,
					"content": "あのですね、あれこれ策を練るのはやめにしませんか。「ガウ丸」のように、純粋な戦いを楽しみましょうよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120149
					],
					"speakerTitle": "菫"
				},
				{
					"id": 765120149,
					"content": "ガウッ！ガウルルルー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120150
					],
					"speakerTitle": "「ガウ丸」"
				},
				{
					"id": 765120150,
					"content": "ええ、そうですね。末端の戦士として、上官が心配すべき雑務まで考慮する必要はありませんでした。その通り、思う存分戦うことが肝心なのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120151
					],
					"speakerTitle": "「オニキス」"
				},
				{
					"id": 765120151,
					"content": "次の機会には、今回以上に強烈な技を披露してみせましょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120152
					],
					"speakerTitle": "「オニキス」"
				},
				{
					"id": 765120152,
					"content": "私は…皆様のために、ケーキをたくさん持参いたしますわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「減7のアルペジオ」"
				},
				{
					"id": 765120140,
					"content": "余計な意図や目的はないほうがいいね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765120141
					]
				},
				{
					"id": 765120112,
					"content": "「オニキス」が特に優れてた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765120113
					]
				},
				{
					"id": 765120113,
					"content": "背が高くて、大きな剣を持ったファデュイか…たしかに手強い相手だったよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765120114,
					"content": "なんと、私ですか？ありがとうございます。何より励みになります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120115
					],
					"speakerTitle": "「オニキス」"
				},
				{
					"id": 765120115,
					"content": "#他のお二方も素晴らしい腕前でした。私は運良く、{NICKNAME}さんのテンポに合わせられただけです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120116
					],
					"speakerTitle": "「オニキス」"
				},
				{
					"id": 765120116,
					"content": "ガウー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120117
					],
					"speakerTitle": "「ガウ丸」"
				},
				{
					"id": 765120117,
					"content": "いい、「ガウ丸」？「オニキス」さんをよく見習うのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120118
					],
					"speakerTitle": "菫"
				},
				{
					"id": 765120118,
					"content": "さすがはステパニアン中尉。バレリー少将も貴方様のことを誇りに思うでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120125
					],
					"speakerTitle": "「減7のアルペジオ」"
				},
				{
					"id": 765120119,
					"content": "「減7のアルペジオ」だと思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765120120
					]
				},
				{
					"id": 765120120,
					"content": "うーん…そういえば、オイラたちがフォンテーヌで戦った帽子のファデュイを育てたのって、こいつなのか？だとしたら、実力はたしかだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765120121,
					"content": "#あら、光栄ですわ…今後{NICKNAME}様には、豪華なスイーツをたくさんご用意しませんと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120122
					],
					"speakerTitle": "「減7のアルペジオ」"
				},
				{
					"id": 765120122,
					"content": "クゥン？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120123
					],
					"speakerTitle": "「ガウ丸」"
				},
				{
					"id": 765120123,
					"content": "ブダノーヴァさんのケーキが食べたいのなら、もっと頑張って強くならないとね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120124
					],
					"speakerTitle": "菫"
				},
				{
					"id": 765120124,
					"content": "いやはや、さすがは従者部隊のベテラン教官。かないませんね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120125
					],
					"speakerTitle": "「オニキス」"
				}
			]
		}
	]
}