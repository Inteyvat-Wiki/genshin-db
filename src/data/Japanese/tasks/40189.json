			"dialogs": [
				{
					"id": 401891001,
					"content": "へえ、目を見張るような…ってほどじゃないけど、オープンしたばかりにしては上々ね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891002
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 401891002,
					"content": "この調子で、次も頑張って戦略を練りましょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891003
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 401891003,
					"content": "映影ランドの人気上昇のために、フォンテーヌの有名シェフ——友達のエスコフィエを呼んだのよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891004
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 401891004,
					"content": "映影ランドの厨房が彼女の舞台よ。よかったら話しかけてみて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891005
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 401891005,
					"content": "レストランも戦略の一環ってことか？奥が深いな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
