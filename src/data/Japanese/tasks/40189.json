			"dialogs": [
				{
					"id": 401891401,
					"content": "このスペアリブのローストはソースの味付けを改良したの。オリジナルのよりも味が濃厚で、脂っこくないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891402
					],
					"speakerTitle": "エスコフィエ"
				},
				{
					"id": 401891402,
					"content": "ミントエキスの後味が爽やかですっきりするから、思いっきり遊んだ後におすすめよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891403
					],
					"speakerTitle": "エスコフィエ"
				},
				{
					"id": 401891403,
					"content": "でもお客さんより、スタッフ向きのメニューね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891404
					],
					"speakerTitle": "エスコフィエ"
				},
				{
					"id": 401891404,
					"content": "スタッフ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401891405,
					"content": "映影ランドはまだ建設が終わっていないでしょう？このスペアリブのローストを食べれば、きっと体力がすぐに回復して疲れがとれるはずよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891406
					],
					"speakerTitle": "エスコフィエ"
				},
				{
					"id": 401891406,
					"content": "貴方たちは責任者なんだし、スタッフの食事問題を解決する必要があるでしょ？いっそ、ここに呼び集めたらどう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891407
					],
					"speakerTitle": "エスコフィエ"
				},
				{
					"id": 401891407,
					"content": "美味しいものを食べれば士気も上がって、効率が良くなるかもしれないわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891408
					],
					"speakerTitle": "エスコフィエ"
				},
				{
					"id": 401891408,
					"content": "なるほど…サーンドル河の運搬作業人にも特製フィッシュアンドチップスを振る舞ったことがあったけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891409
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 401891409,
					"content": "作業員たちの効率がだいぶ上がって、八時間分の仕事を五時間で終わらせてくれてた。次の日もすごく元気だったよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891410
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 401891410,
					"content": "それじゃあ早速、冷めないうちにスタッフを呼んできてちょうだい。副菜やデザートも用意しておくわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891411
					],
					"speakerTitle": "エスコフィエ"
				},
				{
					"id": 401891411,
					"content": "おお！さすがエスコフィエだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891412
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401891412,
					"content": "「テーマメニュー」もきっとすごい効果を発揮できると思うぞ。しばらく定期的にこっちも見に来ないとな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401891413,
					"content": "ナヴィアと一緒にスタッフを呼び集め、特製の料理を振舞った…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
