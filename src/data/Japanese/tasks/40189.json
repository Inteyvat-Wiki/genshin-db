			"dialogs": [
				{
					"id": 401891101,
					"content": "ふーん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891102
					],
					"speakerTitle": "エスコフィエ"
				},
				{
					"id": 401891102,
					"content": "なかなかの環境ね。水辺で食事をするって雰囲気は格別だわ。映影テーマのセッティングで、お客さんたちもテンションが上がって、より食事を楽しめる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891103
					],
					"speakerTitle": "エスコフィエ"
				},
				{
					"id": 401891103,
					"content": "食材も揃っているわね。調理器具さえあれば、すぐ始められそうだわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891104
					],
					"speakerTitle": "エスコフィエ"
				},
				{
					"id": 401891104,
					"content": "こんにちは、エスコフィエ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401891105,
					"content": "あら？雇い主たちのお出ましね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891106
					],
					"speakerTitle": "エスコフィエ"
				},
				{
					"id": 401891106,
					"content": "棘薔薇の会のボス、そして有名な旅人とパイモン…そうそうたる運営陣ね——贅沢すぎるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891107
					],
					"speakerTitle": "エスコフィエ"
				},
				{
					"id": 401891107,
					"content": "それを言うなら、ホテル・ドゥボールの元シェフこそ贅沢でしょ。どこにいても、高級料理の匂いを漂わせちゃうんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891108
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 401891108,
					"content": "ゴホンッ…本題に移りましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891109
					],
					"speakerTitle": "エスコフィエ"
				},
				{
					"id": 401891109,
					"content": "旅人に、各段階の「テーマメニュー」を決めてもらうって言ってたわよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891110
					],
					"speakerTitle": "エスコフィエ"
				},
				{
					"id": 401891110,
					"content": "「テーマメニュー」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401891111
					]
				},
				{
					"id": 401891111,
					"content": "これこそがこの前言った経営戦略よ！一流シェフの料理で、「シュヴァルマラン映影ランド」にお客さんをもっと呼び込むの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891112
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 401891112,
					"content": "エスコフィエの料理なら、きっと来たお客さんもあっと驚くはずよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891113
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 401891113,
					"content": "だってパイモン、考えてみて。チケット一枚で、思う存分遊べるだけじゃなくて、噂のグルメも食べられる——ワクワクしない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891114
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 401891114,
					"content": "おおっ！そんなの毎日来ちゃうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891115,
						401891116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401891115,
					"content": "年パスは？年パスはないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401891117
					]
				},
				{
					"id": 401891117,
					"content": "でも、メニューを全部公開したら、客寄せの効果は半減してしまうわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891118
					],
					"speakerTitle": "エスコフィエ"
				},
				{
					"id": 401891118,
					"content": "とあるグルメブランドの顧問の調査によると、多くのレストランはシェフおまかせメニューを採用しているの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891119
					],
					"speakerTitle": "エスコフィエ"
				},
				{
					"id": 401891119,
					"content": "ということで、貴方には定期的にどんな「テーマメニュー」を出すのか、アイデアを出してほしいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891120
					],
					"speakerTitle": "エスコフィエ"
				},
				{
					"id": 401891120,
					"content": "手を出して。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891121,
						401891122
					],
					"speakerTitle": "エスコフィエ"
				},
				{
					"id": 401891121,
					"content": "えっ…手？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401891123
					]
				},
				{
					"id": 401891123,
					"content": "温かい。活力に満ちた手ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891124
					],
					"speakerTitle": "エスコフィエ"
				},
				{
					"id": 401891124,
					"content": "剣の柄に触れてきた場所にはまめができるものだけど、貴方の手はとても繊細だわ。きっと琴の弦に触るように剣を握ってたんでしょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891125
					],
					"speakerTitle": "エスコフィエ"
				},
				{
					"id": 401891125,
					"content": "「剣」…そうね。今回のテーマは「力」にしましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891126
					],
					"speakerTitle": "エスコフィエ"
				},
				{
					"id": 401891126,
					"content": "貴方がもたらしてくれた「力」というアイデアがどんな料理を生み出すか…楽しみにしていて頂戴——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エスコフィエ"
				},
				{
					"id": 401891122,
					"content": "アイデアって物理的に受け渡すんだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401891123
					]
				},
				{
					"id": 401891116,
					"content": "一生ここに住めないかな…！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401891117
					]
				}
			]
		},
