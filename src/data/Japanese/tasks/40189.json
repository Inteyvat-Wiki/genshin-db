			"dialogs": [
				{
					"id": 401891601,
					"content": "よし…準備万端！「シュヴァルマラン映影ランド」運営のコツ、掴めたみたいね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891602
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 401891602,
					"content": "えっ？そうなのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891603
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401891603,
					"content": "でも確かに、いつの間にか、いろいろ身についた気がするぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891604,
						401891605
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401891604,
					"content": "ナヴィアの説明が分かりやすかったから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401891606
					]
				},
				{
					"id": 401891606,
					"content": "別に大したことは教えてないよ。あんたたちの理解力が高かっただけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891607
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 401891607,
					"content": "長期的な戦いって聞いて、びっくりしたでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891608
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 401891608,
					"content": "でも、複雑なことも細かく分けて、一つずつこなしていけば、たとえ天賦の才がなくたって出来るはずなのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891609
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 401891609,
					"content": "おおっ！成長したことを実感できれば、モチベーションも上がってくるもんな！ナヴィアの励ましの言葉、ノートにメモっておくぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891610
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401891610,
					"content": "それじゃ、ナヴィアと一緒に、「シュヴァルマラン映影ランド」をもっと盛り上げていこう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401891605,
					"content": "ナヴィアのような、立派なボスになれた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401891606
					]
				}
			]
