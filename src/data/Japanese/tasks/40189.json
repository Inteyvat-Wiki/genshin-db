			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ナヴィア"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401890429,
					"content": "ばっちり。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890401
					]
				},
				{
					"id": 401890401,
					"content": "さて、相棒、パイモン。いよいよ「シュヴァルマラン映影ランド」始動よ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890402
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 401890402,
					"content": "前にも言ったように、この映影ランドは愛好家たちが作り上げたもので、棘薔薇の会がその統括と設営、運営を任されてるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890403
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 401890403,
					"content": "でも、みんなも何でもできるプロってわけじゃないし、普段はイベントブースのデザインだけを担当してる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890404
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 401890404,
					"content": "あたしたちの役割は長期的な運営計画を立てて、基本的な攻略法を作ることよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890405
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 401890405,
					"content": "長期、経営、計画…なんだか難しそうだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401890406,
					"content": "オイラたちはいつも冒険してるし、お店を出したこともほとんどないのに…ちゃんとできるのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890407,
						401890408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401890407,
					"content": "経営理論を学んだ経営者なんて一握り。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890409
					]
				},
				{
					"id": 401890409,
					"content": "うんうん、その意気よ！さすがあたしの相棒、テイワットのビジネス業界に嵐を巻き起こしてきたのね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890410
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 401890410,
					"content": "とにかく、まずは映影ランドの基本情報を確認してみましょ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890411
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 401890411,
					"content": "大体わかった気がするぜ。おまえはどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890412,
						401890413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401890412,
					"content": "こんなの朝飯前だよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890414
					]
				},
				{
					"id": 401890414,
					"content": "おう！一緒に頑張ろうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890415
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401890415,
					"content": "基本的な攻略法とか言ってたけど…基本以外のやり方もあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890416
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401890416,
					"content": "もちろん。映影やアトラクションに対する理解は人それぞれだもの。映影ランドにはスリリングなアトラクションもたくさんあるしね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890417
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 401890417,
					"content": "もしかしたら、来場者が道に迷って映影ランドのエリアから出ちゃったり…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890418
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 401890418,
					"content": "備品の使い方を間違えて、危ない目に遭ったりしちゃうかもでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890419
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 401890419,
					"content": "だから、お客さんが困らないように、イベントごとの基本的な攻略法を考えてあげるの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890420,
						401890421
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 401890420,
					"content": "#つまり{M#俺}{F#私}が先に遊ぶんだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890422
					]
				},
				{
					"id": 401890422,
					"content": "言われてみれば、アクシデントは色々ありそうだよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890423
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401890423,
					"content": "それに、難しいステージは、オイラたちくらい実力があるやつじゃないと楽にクリアできないもんな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890424
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401890424,
					"content": "そう言うこと。もちろん、相棒を危険な目に遭わせるわけにはいかないから、すでにアトラクションは一通りチェックしてあるし、安全面の問題はないはずよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890425
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 401890425,
					"content": "あんたたちには一番最初に遊んでほしいって気持ちもあったの。感想やアドバイスもぜひ聞かせて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890426
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 401890426,
					"content": "へへっ、さすがナヴィアだぜ！安心して遊べそうだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890427
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401890427,
					"content": "あんたたちの意見、楽しみにしてるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890428
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 401890428,
					"content": "さあ、まずは「カラフル・アドベンチャー」を存分に楽しんで、最初の攻略法を作りましょ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 401890421,
					"content": "お手本を見せてあげるんだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890422
					]
				},
				{
					"id": 401890413,
					"content": "うーん…やりながら覚えよう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890414
					]
				},
				{
					"id": 401890408,
					"content": "#{M#俺}{F#私}たちも結構色々やってきたし。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890409
					]
				}
			]
		},
