			"dialogs": [
				{
					"id": 401890801,
					"content": "よし、ここのスタッフはスタンバイできたみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890802,
						401890803
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401890802,
					"content": "これから頑張ろうね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890804
					]
				},
				{
					"id": 401890804,
					"content": "ふふっ、あんたたちもなかなかやるね。あたしよりもボスのオーラ、出てるんじゃない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890805
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 401890805,
					"content": "さあ、「シュヴァルマラン映影ランド」、いよいよ正式オープンよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890806
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 401890806,
					"content": "映影ランドの運営は長期的な戦いだから、焦ってもしょうがないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890807
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 401890807,
					"content": "今回の仕事はそろそろ一段落ってところかしら。ちょっと休んで、今期の運営レポートが出来上がるのを待ちましょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 401890803,
					"content": "ちゃんと監督するよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890804
					]
				}
			]
		},
		{
