			"dialogs": [
				{
					"id": 700740201,
					"content": "…「騎士が砕いて出した木屑」ってなると、やっぱりここかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700740202,
					"content": "あっ！大団長！栄誉騎士！今日は訓練に来たの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740203
					],
					"speakerTitle": "エリン"
				},
				{
					"id": 700740203,
					"content": "「目標」を追い求めて励むってのも…まあ、確かに一つの訓練だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740204
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 700740204,
					"content": "もう十分強いのに、さらに上を目指すなんて…どうぞ、二人で自由に訓練して！私は横で勉強させてもらうから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エリン"
				}
			]
		},
