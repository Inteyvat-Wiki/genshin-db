			"dialogs": [
				{
					"id": 700740801,
					"content": "クルックー",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740802
					],
					"speakerTitle": "ハト"
				},
				{
					"id": 700740802,
					"content": "鳩の羽、ゲットだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740803
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 700740803,
					"content": "やっと手に入ったな。この課題、確かに思ってたよりも大変だぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740804
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700740804,
					"content": "完成まであとちょっとだ…「大鍋で煮込んだ薬草スープ」は、確かダダウパの谷だったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740805
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 700740805,
					"content": "先に行ってるぞ！お前たちも早く来いよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740806
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 700740806,
					"content": "おい——あいつ、テンション上がりすぎだろ。すごいスピードで走ってったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740807,
						700740808
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700740807,
					"content": "さすが風のように自由な人だね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740809
					]
				},
				{
					"id": 700740809,
					"content": "…酔っぱらいさんめ…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740810
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 700740810,
					"content": "誰か、そこにいるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740811
					]
				},
				{
					"id": 700740811,
					"content": "…うわっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740812
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 700740812,
					"content": "ディオナ？なんでこんなところにいるんだ？わざわざ隠れてるみたいだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740813
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700740813,
					"content": "あたし…あたしはただ果物を摘みに来ただけなのに、あのおじさんに出くわしちゃって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740814
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 700740814,
					"content": "あの人、前に作ったお酒をもう一度作ってほしいって最近しつこいの…それでうんざりして、逃げ回ってるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740815
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 700740815,
					"content": "前に作ったお酒って…何があったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740816
					]
				},
				{
					"id": 700740816,
					"content": "この前、遠征軍と一緒に帰ってきたでしょ？それであのおじさん、キャッツテールで祝杯を上げたんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740817
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 700740817,
					"content": "キャッツテール？騎士団でやるのかと思ってたぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740818
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700740818,
					"content": "エンジェルズシェアに行くと思ってた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740819
					]
				},
				{
					"id": 700740819,
					"content": "えっと…全部行ったよ。キャッツテールは三軒目——街中の酒場を全部はしごするつもりだったみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740820
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 700740820,
					"content": "…次の遠征隊が戻ってきたら、あいつらまたそれを口実に飲み始めると思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740821
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700740821,
					"content": "間違いないね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740822
					]
				},
				{
					"id": 700740822,
					"content": "…とにかく！あの酔っぱらいさんたちの様子は、とても見てられなかったんだから！それで一番まずくて吐き気がするようにゃお酒を作って、目を覚まさせてやろうと思ったの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740823,
						700740824
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 700740823,
					"content": "でも、ディオナの体質だと…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740825
					]
				},
				{
					"id": 700740825,
					"content": "そうだよ。だからあたし、最初はリトルプリンスに作ってもらってたの…でもまさか、酔っ払さんたちがリトルプリンスをからかい出すとは思わにゃかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740826
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 700740826,
					"content": "…それでリトルプリンスは途中で逃げ出しちゃって…ついでに、酔っぱらいさんを引っかいてったんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740827
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 700740827,
					"content": "（ファルカが言ってた傷跡…まさか…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740828
					]
				},
				{
					"id": 700740828,
					"content": "混沌とした秘{RUBY#[D]酒場}境の奥深くに乗り込み、凶悪極まりない魔{RUBY#[D]リトルプリンス}物と戦う必要があってな…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740829
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 700740829,
					"content": "…お酒の調合はほぼ終わってて、あとほんのちょっとだし、大丈夫かにゃって思ったんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740830
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 700740830,
					"content": "結局、仕上げは自分でやったんだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740831
					]
				},
				{
					"id": 700740831,
					"content": "うん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740832,
						700740833
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 700740832,
					"content": "もう一つ聞きたいんだけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740834
					]
				},
				{
					"id": 700740834,
					"content": "えっと、騎士たちの服についてた木屑とか、森で拾った鳩の羽とか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740835
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 700740835,
					"content": "あともう一つ。二日酔い解消のために用意してた…ヒルチャールの薬草スープ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740836
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 700740836,
					"content": "そういえば、ファルカはつい最近戻ってきたばっかりだよな…もしかして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740837,
						700740838
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700740837,
					"content": "…こんな材料を調合できるのは…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740839
					]
				},
				{
					"id": 700740839,
					"content": "あいつ…大変なことになるぞ！早く止めに行こう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700740838,
					"content": "ディオナだけだって知らないはず！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740839
					]
				},
				{
					"id": 700740833,
					"content": "お酒に何を入れたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740834
					]
				},
				{
					"id": 700740824,
					"content": "何を作っても美味しくなるんじゃない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740825
					]
				},
				{
					"id": 700740808,
					"content": "お酒を飲みたい気持ちが溢れ出てるね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740809
					]
				}
			]
		},
		{
