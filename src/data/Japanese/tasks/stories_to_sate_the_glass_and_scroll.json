			"dialogs": [
				{
					"id": 700740301,
					"content": "訓練場は二人の好きに使って！二人みたいな実力者の腕前を直接見られるんだもの、あと三日待たされたって大丈夫！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エリン"
				}
			]
