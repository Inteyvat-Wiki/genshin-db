			"dialogs": [
				{
					"id": 700740101,
					"content": "そういえば、ファルカと魔女会が開いた「会談」なのに、あいつの課題のことはすっかり忘れてたな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700740102,
					"content": "どんな課題かちょっと見てみるか…ファルカ、ファルカ…ん？なんだこれ…空欄が一行あるだけだぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700740103,
					"content": "本人に直接聞いてみる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740104
					]
				},
				{
					"id": 700740104,
					"content": "そうだな…あいつを探すなら「酒場」とか「レストラン」とかのほうが見つけやすそうだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700740105,
					"content": "…やっぱりいないか。自分で何とかするしかないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740106
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 700740106,
					"content": "噂をすれば！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740107
					]
				},
				{
					"id": 700740107,
					"content": "おーい！ファルカ！「課題」のことで聞きたいことがあるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700740108,
					"content": "おっ？栄誉騎士とパイモンじゃないか！課題…？いきなりどうしたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740109,
						700740110
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 700740109,
					"content": "魔女会がみんなに課題を用意したんだけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740111
					]
				},
				{
					"id": 700740111,
					"content": "課題…課題…ああ、そういえば以前アリスがそんな話をしてたような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740112
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 700740112,
					"content": "——おまえの「会談」がきっかけで「課題」が用意されたんだろ！？まあいいや…それより、なんでおまえの課題は空欄一行なんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700740113,
					"content": "…ああ、俺の「課題」を載せるわけだからな。あの小さな本には少し荷が重かったんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740114,
						700740115
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 700740114,
					"content": "そう言われると気になる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740116
					]
				},
				{
					"id": 700740116,
					"content": "——テイワット最高の美酒を作り出すことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740117
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 700740117,
					"content": "…どこが重いんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700740118,
					"content": "甘く見てもらっちゃ困る——この腕の新しい傷は、その酒のレシピを手に入れる過程で負ったもんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740119
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 700740119,
					"content": "混沌とした秘境の奥深くに乗り込み、凶悪極まりない魔物と戦う必要があってな…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740120
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 700740120,
					"content": "その話、本当？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740121
					]
				},
				{
					"id": 700740121,
					"content": "課題は特別な材料をあと三つ揃えれば達成できる！栄誉騎士、パイモン、俺に力を貸してくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740122
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 700740122,
					"content": "まあ、いいぜ。三つだけってことなら…だまされたと思って付き合ってやるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700740123,
					"content": "よし、あと必要な材料は「騎士が砕いて出した木屑」、「喜びと共に舞い落ちた鳩の羽」、そして「大鍋で煮込んだ薬草スープ」だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740124
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 700740124,
					"content": "それって酒の作り方なのか！？なんか怪しい魔法薬を作るみたいだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700740125,
					"content": "うーん…まあ、なんだ…魔女たちの課題だからな！ははっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740126
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 700740126,
					"content": "レシピを完璧に再現するには、きっちり条件に満たした材料を揃える必要がある。まずは「木屑」が手に入る場所へ向かおう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 700740115,
					"content": "どんな課題か聞かせてくれる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740116
					]
				},
				{
					"id": 700740110,
					"content": "ファルカさんの課題だけ空欄みたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740111
					]
				}
			]
		},
