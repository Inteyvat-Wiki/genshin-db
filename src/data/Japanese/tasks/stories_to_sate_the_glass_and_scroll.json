						],
						"pointId": 15600
					}
				]
			},
			"dialogs": [
				{
					"id": 700740901,
					"content": "信じられない…ヒルチャールがあんなに素直に聞き入れるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740902
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 700740902,
					"content": "マスク！ファルカを見かけなかったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740903
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700740903,
					"content": "見たよ。さっき、鍋を借りに行くってヒルチャールのところに向かったんだけど…ヒルチャールは彼を見て、すぐに鍋を譲ったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740904
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 700740904,
					"content": "ほとんど話し合いもなかったのに、なんであんなにうまくいったのかな？もしかして、大団長は私の知らないヒルチャールのボディーランゲージを習得してるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740905,
						700740906
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 700740905,
					"content": "それは話し合いとは言えない気が…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740907
					]
				},
				{
					"id": 700740907,
					"content": "——そこは重要じゃないだろ！ファルカは今どこにいるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740908
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700740908,
					"content": "ほら——あそこにいるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740909
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 700740909,
					"content": "やっと…完成したぞ！テイワット最高の美酒だ！それが今この瞬間、俺の手の中にある！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740910
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 700740910,
					"content": "ファルカさん——",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740911
					]
				},
				{
					"id": 700740911,
					"content": "おっ？やっと来たか？あのヒルチャールたち、意外と話が通じるやつらだったな。思ったより早く酒を調合できた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740912
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 700740912,
					"content": "さあ、さっそく味わうとしよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740913
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 700740913,
					"content": "——ちょっと待って、飲まないで！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740914
					]
				},
				{
					"id": 700740914,
					"content": "ん？お前ら、一杯目を味わいたいのか？ふふん…この一杯目の栄誉は、絶対に譲れない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740915
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 700740915,
					"content": "そういう問題じゃなくて！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740916
					]
				},
				{
					"id": 700740916,
					"content": "安心しろ！お前たちの分も少しは残しておくから——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740917
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 700740917,
					"content": "ゴクッ…ゴクッ…はっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740918
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 700740918,
					"content": "うっ…？なんだか…まず…い…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740919
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 700740919,
					"content": "ファルカ！大丈夫か？ファルカ？ファ——ル——カ——！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740920,
						700740921
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700740920,
					"content": "——大団長！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740922
					]
				},
				{
					"id": 700740922,
					"content": "おーい！魔神に勝ったのに、こんなところで倒れてどうすんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740923
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700740923,
					"content": "うっ…あぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740924
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 700740924,
					"content": "…今一瞬だけ、歴代の北風騎士たちが見えた気がする…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740925,
						700740926
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 700740925,
					"content": "ここで倒れるなんて情けないと言うべきか…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740927
					]
				},
				{
					"id": 700740927,
					"content": "もう少し消化させてくれ…さっきの酒も、この痛い教訓もな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740928
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 700740928,
					"content": "ファルカにディオナの「百パーセント美酒を調合する」祝福について説明した…\\n彼女の手を経てこそ、微妙な材料も美酒へと変わるのだ…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						700740929
					]
				},
				{
					"id": 700740929,
					"content": "なるほど、そういうことか…足りなかった材料は泉の精霊の祝福ってわけか…ははっ、それは思いもよらなかった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740930
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 700740930,
					"content": "おい！なんだよ、そのなにもなかったみたいな涼しい顔！まだオイラたちを騙した件については、清算が済んでないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740931
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700740931,
					"content": "悪い悪い…このレシピで酒が出来ると本気で考えてたんだ。作り終わったら、一緒に飲みながら説明しようと思ってたが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740932
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 700740932,
					"content": "今はもう…飲む気にはなれないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740933,
						700740934
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 700740933,
					"content": "やめておく。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740935
					]
				},
				{
					"id": 700740935,
					"content": "そうか…じゃあ、今回の酒の件で、ひとつ借りが出来たってことだな。今度改めて鹿狩りで奢らせてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740936
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 700740936,
					"content": "——おごってくれるのか？それならいいぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740937
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700740937,
					"content": "簡単に懐柔されるんだから…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740938
					]
				},
				{
					"id": 700740938,
					"content": "うーん…まあ、お酒でこんなに長く苦しんでるんだし、良い薬になったんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740939
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700740939,
					"content": "はぁ、自業自得だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740940,
						700740941
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 700740940,
					"content": "でも、空白の課題は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740942
					]
				},
				{
					"id": 700740942,
					"content": "ははっ、酒の肴に話そうと思ってたんだが、こうなった以上、普通に話すしかないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740943
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 700740943,
					"content": "…モンドのみんなに「課題」を出すのか？いい考えだな。俺にも一つ出してくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740944
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 700740944,
					"content": "ふふっ、あなたの課題——「水占の盤に映る運命を変える」はね、遠征を決意した時点でもう達成済みなのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アリス"
				},
				{
					"id": 700740941,
					"content": "一体どういうことなの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740942
					]
				},
				{
					"id": 700740934,
					"content": "勘弁してほしい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740935
					]
				},
				{
					"id": 700740926,
					"content": "立ち上がれたことを褒めるべきか…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740927
					]
				},
				{
					"id": 700740921,
					"content": "何やってるの、大団長！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740922
					]
				},
				{
					"id": 700740906,
					"content": "少なくとも言葉は使ってない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740907
					]
				}
			]
		},
