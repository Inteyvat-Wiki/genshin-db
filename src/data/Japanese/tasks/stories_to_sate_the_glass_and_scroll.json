			},
			"dialogs": [
				{
					"id": 700740501,
					"content": "ちょ、ちょっと！鳩がびっくりして…逃げちゃっ…た…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740502
					],
					"speakerTitle": "ティミー"
				},
				{
					"id": 700740502,
					"content": "…だ…大団長？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740503
					],
					"speakerTitle": "ティミー"
				},
				{
					"id": 700740503,
					"content": "ん？ティミーじゃないか。ずいぶん背が伸びたみたいだな？ちゃんと飯は食べてるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740504
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 700740504,
					"content": "は…はい！大団長の言葉、ずっと覚えています！立派な男になるためには、ちゃんとご飯を食べて、しっかりトレーニングすること！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740505,
						700740506
					],
					"speakerTitle": "ティミー"
				},
				{
					"id": 700740505,
					"content": "態度が…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740507
					]
				},
				{
					"id": 700740507,
					"content": "しょうがないんじゃないか？この町の子供はみんな「西風騎士団の生きた伝説」にあこがれてるだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740508
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700740508,
					"content": "悪いな、お前の鳩をびっくりさせちまって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740509
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 700740509,
					"content": "ちょうど聞きたかったんだが、鳩に近づいても驚かせず、むしろ喜ばせておく方法を知らないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740510
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 700740510,
					"content": "えっと…普段は、そっと近づいて、餌をまいてあげています…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740511
					],
					"speakerTitle": "ティミー"
				},
				{
					"id": 700740511,
					"content": "——そうか、それだ！まだ餌は余ってるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740512
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 700740512,
					"content": "餌ならたくさんありますけど…でも…大団長…いったい何を…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740513
					],
					"speakerTitle": "ティミー"
				},
				{
					"id": 700740513,
					"content": "安心しろ、約束する——羽を少し借りるだけだ。これは大人同士の約束だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740514
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 700740514,
					"content": "あ…はい！ありがとうございます、大団長！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ティミー"
				},
				{
					"id": 700740506,
					"content": "普段と全然違う！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740507
					]
				}
			]
		},
