			"dialogs": [
				{
					"id": 766562001,
					"content": "#こんにちは、{NICKNAME}にパイモン。二人のおかげで、回収したロボットたちは順調にデバッグできたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766562002
					],
					"speakerTitle": "ジェネット"
				},
				{
					"id": 766562002,
					"content": "おお！みんなここにいるんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766562003
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766562003,
					"content": "今のところ、新たな故障は起きてないわ。でも、ふと思いついたことがあるの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766562004
					],
					"speakerTitle": "ジェネット"
				},
				{
					"id": 766562004,
					"content": "#{NICKNAME}、他のロボットを探しに行ったら、特殊な行動をしてないか注意してみてくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766562005
					],
					"speakerTitle": "ジェネット"
				},
				{
					"id": 766562005,
					"content": "具体的にはどんな感じの行動だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766562006
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766562006,
					"content": "ざっくり言うと…お互い交流してる、って言えばいいのかしら？十分な数のロボットを持ち帰ることができたら、より顕著に表れるかもしれないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766562007
					],
					"speakerTitle": "ジェネット"
				},
				{
					"id": 766562007,
					"content": "なるほどな…任せろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766562008
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766562008,
					"content": "本当にありがとう！次のエリアを地図に記しておくわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジェネット"
