				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"神里綾華"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20080301,
					"content": "おかしいな、今日はなんだか静かだぞ。いつもとまるで違う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20080302,
					"content": "ワンワン…ワン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080303
					],
					"speakerTitle": "太郎丸"
				},
				{
					"id": 20080303,
					"content": "まさか、またこの掛け合いか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20080304,
					"content": "トーマ——トーマ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20080305,
					"content": "ワン！ワン！…ワン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080306
					],
					"speakerTitle": "太郎丸"
				},
				{
					"id": 20080306,
					"content": "おーい——出て来いよ——もう分かってんだぞ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20080307,
					"content": "ん？なにも返事がない。トーマのやつどこ行ったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20080308,
					"content": "ワンワンワン！ワン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080309
					],
					"speakerTitle": "太郎丸"
				},
				{
					"id": 20080309,
					"content": "あれ？いつもは大人しいはずの太郎丸が、今日はやけに騒がしいな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20080310,
					"content": "お二方、トーマは見かけなかったでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080311
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20080311,
					"content": "え、トーマはおまえと一緒にいるのかと思ってたぞ。なにかあったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20080312,
					"content": "まずいですね…ここに来る途中、トーマが天領奉行の者に捕まったと聞きました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080313
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20080313,
					"content": "その情報が正しいものか確認できず、急いでここへ来たのですが。トーマが約束の時間に現れていないことを考えると、噂は本当だったのかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080314
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20080314,
					"content": "将軍様は千手百目神像の前で、百個目の神の目の「目狩り儀式」を行うつもりです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080315
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20080315,
					"content": "そして、その百個目の神の目の持ち主…つまり公の前で目を狩られる対象となるのは…おそらく、トーマです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080316
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20080316,
					"content": "もしかしてトーマが言ってた天領奉行が準備してる「儀式」って、あいつのために準備された「目狩り儀式」だったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080317
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20080317,
					"content": "おそらく…そうでしょう。将軍様と天領奉行の者は百個目の神の目の「目狩り儀式」を行い、目狩り令の段階的成果を証明したいのでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080318
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20080318,
					"content": "…いけません、早く助けに向かわなければ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080319
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20080319,
					"content": "ワンワン！ワン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080320
					],
					"speakerTitle": "太郎丸"
				},
				{
					"id": 20080320,
					"content": "落ち着いて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20080321
					]
				},
				{
					"id": 20080321,
					"content": "でも「白鷺の姫君」は社奉行の代表。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20080322
					]
				},
				{
					"id": 20080322,
					"content": "そうだぞ、おまえが直接行ったら、社奉行が雷電将軍に敵対したことになっちゃうだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080323
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20080323,
					"content": "公の前で雷電将軍に抗えば、社奉行にいる普通の人も巻き添えになる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080324
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20080324,
					"content": "それも仕方のないことです…儀式がもう始まります、時間はありません。トーマをこのまま見捨てるわけには…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080325
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20080325,
					"content": "彼は私の友人なのです。少し前までは…皆さん一緒にいたのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080326
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20080326,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}の友達でもある、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}が助けに行く。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20080327
					]
				},
				{
					"id": 20080327,
					"content": "しかし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080328
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20080328,
					"content": "さっき言ってたでしょ、時間がないって。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20080329
					]
				},
				{
					"id": 20080329,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080330
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20080330,
					"content": "はい…貴方がたのご無事を…祈っています！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080331
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20080331,
					"content": "安心しろ、綾華。友達の命に関わることだ、オイラたちは絶対に失敗しない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
