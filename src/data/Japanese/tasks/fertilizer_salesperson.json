					"大久保大介"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728130301,
					"content": "ありがとう、旅人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130302
					],
					"speakerTitle": "岩田"
				},
				{
					"id": 728130302,
					"content": "肥料を作っていたら、魔物たちがどこからか襲ってきたんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130303
					],
					"speakerTitle": "岩田"
				},
				{
					"id": 728130303,
					"content": "まったく…お前が来てくれて良かった。ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130304
					],
					"speakerTitle": "岩田"
				},
				{
					"id": 728130304,
					"content": "あの肥料の山が原因かもしれない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130305
					]
				},
				{
					"id": 728130305,
					"content": "そ、そう？でも、この匂いは成功の兆しと聞いたけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130306
					],
					"speakerTitle": "岩田"
				},
				{
					"id": 728130306,
					"content": "それより、ほら、俺の作った肥料の山を見てよ。今開けて、詳しく紹介するから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130307
					],
					"speakerTitle": "岩田"
				},
				{
					"id": 728130307,
					"content": "ちょっと待ってくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130308
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 728130308,
					"content": "え？ゴローさん、今日はどのような用件でこちらへ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130309
					],
					"speakerTitle": "岩田"
				},
				{
					"id": 728130309,
					"content": "見回りしてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130310
					]
				},
				{
					"id": 728130310,
					"content": "俺は…えっと…それより…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130311
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 728130311,
					"content": "こ、これ…お前たちが作ったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130312
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 728130312,
					"content": "はははっ、そうです、この肥料の山は俺とこの旅人が一緒に作りました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130313
					],
					"speakerTitle": "岩田"
				},
				{
					"id": 728130313,
					"content": "ゴローさん、まさかあなたも、この肥料の状態を見たくて、ここに来たんですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130314
					],
					"speakerTitle": "岩田"
				},
				{
					"id": 728130314,
					"content": "えへへ、ちょうどいい時に来ましたよ、今すぐ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130315
					],
					"speakerTitle": "岩田"
				},
				{
					"id": 728130315,
					"content": "ちょっと待ってくれ！俺はこれを見に来たんじゃない。違う、これを見に来たんだ…俺…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130316
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 728130316,
					"content": "ゴローはもう耐えられないみたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130317
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 728130317,
					"content": "この肥料の山から離れよう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130318
					]
				},
				{
					"id": 728130318,
					"content": "うん、その辺で話そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130319
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 728130319,
					"content": "ゴローさん、一体何のために来たんですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130320
					],
					"speakerTitle": "岩田"
				},
				{
					"id": 728130320,
					"content": "最近、多くの住民から、恐ろしい匂いがするという報告があったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130321
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 728130321,
					"content": "念のため、偵察しに行ったんだ。それから、匂いを辿ってここまで来た。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130322
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 728130322,
					"content": "そして、お前たちを見つけた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130323
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 728130323,
					"content": "岩田、お前が肥料を研究していると聞いたが、その作り方は本当に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130324,
						728130325
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 728130324,
					"content": "迷惑だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130326
					]
				},
				{
					"id": 728130326,
					"content": "そう。だから岩田、まずはこの肥料の山を処理してくれ。肥料のことなら、俺が何とかするから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130327
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 728130327,
					"content": "大将！ゴロー大将！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130328
					],
					"speakerTitle": "大久保大介"
				},
				{
					"id": 728130328,
					"content": "ああ、なんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130329
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 728130329,
					"content": "大将、周辺で怪しいやつを捕まえました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130330
					],
					"speakerTitle": "大久保大介"
				},
				{
					"id": 728130330,
					"content": "そいつはコソコソしていて、自分が何とか…肥料の販売員だとか言っていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130331
					],
					"speakerTitle": "大久保大介"
				},
				{
					"id": 728130331,
					"content": "怪しいと思ったので、そいつを捕まえました。早く来てください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130332
					],
					"speakerTitle": "大久保大介"
				},
				{
					"id": 728130332,
					"content": "また肥料か。肥料は俺に恨みでもあるのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130333
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 728130333,
					"content": "分かった、すぐ行く。お前はあそこに行って治安を維持してくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130334
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 728130334,
					"content": "岩田、お前はまず、肥料の山の件を処理して欲しい。その後の話はあとでするから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130335
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 728130335,
					"content": "旅人、お前も一緒に来てくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130336,
						728130337
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 728130336,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130338
					]
				},
				{
					"id": 728130338,
					"content": "肥料を販売する人？何だか、懐かしい感じがするな…だけど思い出せない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130339
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 728130339,
					"content": "まあ、とにかく行ってみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 728130337,
					"content": "肥料…販売員？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130338
					]
				},
				{
					"id": 728130325,
					"content": "刺激的だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130326
					]
				}
			]
		},
