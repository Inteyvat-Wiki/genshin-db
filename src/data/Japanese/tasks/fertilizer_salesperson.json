				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728130801,
					"content": "アラニ、本当に君なのか。き、君はなんで稲妻に来たんだ？璃月にいるはずじゃなかったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130802
					],
					"speakerTitle": "カウシック"
				},
				{
					"id": 728130802,
					"content": "うぅ…話すと長くなるの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130803
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 728130803,
					"content": "カウシックさん、アラニのことを知っているのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130804
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 728130804,
					"content": "君は…ああ、君はゴロー大将ですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130805
					],
					"speakerTitle": "カウシック"
				},
				{
					"id": 728130805,
					"content": "君の言った通りです。アラニは僕と同じように、教令院で勉強してる学者なんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130806
					],
					"speakerTitle": "カウシック"
				},
				{
					"id": 728130806,
					"content": "僕たちはそれぞれの課題で教令院を出ましたが、ここで彼女に会うとは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130807
					],
					"speakerTitle": "カウシック"
				},
				{
					"id": 728130807,
					"content": "でも…お前たちのような学者が、教令院を自由に出ることができるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130808
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 728130808,
					"content": "みんなが「自由に出られる」というわけではありませんが。僕とアラニは「ダリオッシュ」に属しています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130809
					],
					"speakerTitle": "カウシック"
				},
				{
					"id": 728130809,
					"content": "僕らにとって、外で留学するのも研究の一部なんです。なので、教令院から出ることを許可されているのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130810
					],
					"speakerTitle": "カウシック"
				},
				{
					"id": 728130810,
					"content": "ゴロー大将、僕はアラニの保証人となりますが、その…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130811
					],
					"speakerTitle": "カウシック"
				},
				{
					"id": 728130811,
					"content": "お前の保証があるから、問題ない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130812
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 728130812,
					"content": "ふぅ…助かった…ありがとう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130813
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 728130813,
					"content": "博行、大久保、自分の仕事に戻ってくれ。ここはもう大丈夫だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130814
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 728130814,
					"content": "はい、大将。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130815
					],
					"speakerTitle": "博行"
				},
				{
					"id": 728130815,
					"content": "はい、大将。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130816
					],
					"speakerTitle": "大久保大介"
				},
				{
					"id": 728130816,
					"content": "すまない、アラニさん。不審者扱いしてしまって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130817
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 728130817,
					"content": "うん…お前の容疑は晴れたが、勝手に海祇島に入って、俺たちにたくさんの迷惑をかけた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130818
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 728130818,
					"content": "えっ？な、何か罰でもあるの？私はモラをあまり持っていないけど、うぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130819
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 728130819,
					"content": "お前は肥料販売員だって言っていたよな…それに、学者兼肥料販売員だと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130820
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 728130820,
					"content": "ちょうど、ここで岩田という者が肥料を研究してるんだ。アラニさん、彼を助けてくれないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130821
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 728130821,
					"content": "もしお前が彼を手伝って、「迷惑」にならない肥料を作り出したら、ここで自由に研究できるようになる。カウシックさんみたいに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130822
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 728130822,
					"content": "ひ、肥料？いや、あの、私はただ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130823,
						728130824
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 728130823,
					"content": "彼女なら問題ない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130825
					]
				},
				{
					"id": 728130825,
					"content": "アラニ、これは取材のいいチャンスだ。稲妻に来たということは、君の論文はまだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130826
					],
					"speakerTitle": "カウシック"
				},
				{
					"id": 728130826,
					"content": "えっと…うーん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130827
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 728130827,
					"content": "教令院の卒業基準なら、君も分かっているだろう。連続して、何年も卒業できなかったら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130828
					],
					"speakerTitle": "カウシック"
				},
				{
					"id": 728130828,
					"content": "や、やる！私はやるから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130829
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 728130829,
					"content": "ワヒッドのところで肥料について調べたこともあるし、だから…一気に解決する！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130830,
						728130831
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 728130830,
					"content": "卒業は人を成長させるね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130832
					]
				},
				{
					"id": 728130832,
					"content": "ならこれで決まりだ。アラニさん、肥料の件は任せた。俺は他の仕事を片付ける。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130833
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 728130833,
					"content": "そうだ、岩田に伝えてくれ。あの…肥料の山を、もっと遠いところに置いてくれって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130834
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 728130834,
					"content": "それじゃ、僕も研究に戻るよ。アラニ、何か問題があれば、僕に聞くといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カウシック"
				},
				{
					"id": 728130831,
					"content": "卒業は最強の動力だね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130832
					]
				},
				{
					"id": 728130824,
					"content": "任せたよ、アラニ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130825
					]
				}
			]
		},
