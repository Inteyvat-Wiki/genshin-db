				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728130701,
					"content": "トーテムの深意…うん？旅人、何か用か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130702
					],
					"speakerTitle": "カウシック"
				},
				{
					"id": 728130702,
					"content": "アラニのことについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130703
					]
				},
				{
					"id": 728130703,
					"content": "アラニが海祇島に来ているのか？おかしいな、なんでここに…彼女は璃月に行ったはずだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130704
					],
					"speakerTitle": "カウシック"
				},
				{
					"id": 728130704,
					"content": "彼女は兵士に捕まった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130705
					]
				},
				{
					"id": 728130705,
					"content": "何だって？はぁ…こんな状況の海祇島に来るなんて…疑われるのも当然だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130706
					],
					"speakerTitle": "カウシック"
				},
				{
					"id": 728130706,
					"content": "それより、早く行こう。あの子はいつも、向こう見ずに行動するから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カウシック"
				}
			]
		},
		{
			"id": 7281308,
