			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"博行",
					"アラニ",
					"ゴロー",
					"大久保大介"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728130501,
					"content": "おとなしくしろ！動くな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130502
					],
					"speakerTitle": "博行"
				},
				{
					"id": 728130502,
					"content": "わ、私は動いていない！説明させて、私は本当に教令院の学者なの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130503
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 728130503,
					"content": "さっきは、肥料を販売しに来たと言っていただろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130504
					],
					"speakerTitle": "博行"
				},
				{
					"id": 728130504,
					"content": "私…教令院の学者だけど、肥料も販売できるの！説明を聞いて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130505
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 728130505,
					"content": "この人か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130506
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 728130506,
					"content": "そうです、大将。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130507
					],
					"speakerTitle": "大久保大介"
				},
				{
					"id": 728130507,
					"content": "捕まえた時、彼女は外でコソコソと彷徨っていたんです。何かを記録していたみたいです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130508
					],
					"speakerTitle": "大久保大介"
				},
				{
					"id": 728130508,
					"content": "大将、こいつはきっと、情報を探りに来た幕府の者です！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130509
					],
					"speakerTitle": "大久保大介"
				},
				{
					"id": 728130509,
					"content": "違う！そうじゃないの！だから、私はただの学者で、論文のために取材してるだけなんだって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130510
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 728130510,
					"content": "冗談はやめろ！何とかの論文のために、戦場まで来たっていうのか？きっと何か企んでるに違いない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130511
					],
					"speakerTitle": "博行"
				},
				{
					"id": 728130511,
					"content": "うぅ…論文以外に、他のことを考える余裕もないよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130512,
						728130513
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 728130512,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYSECOND|INFO_FEMALE_PRONOUN_GIRLSECOND]}は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130514
					]
				},
				{
					"id": 728130514,
					"content": "旅人！よかった、あなたがいてくれて！早く彼らに説明して。私は悪い人じゃない、ただ論文を書くために来たんだって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130515
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 728130515,
					"content": "知り合いなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130516
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 728130516,
					"content": "まあ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130517
					]
				},
				{
					"id": 728130517,
					"content": "スメールの学者って…「卒業」のために、そこまでできるのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130518
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 728130518,
					"content": "でも、お前の話だと、彼女の詳しい事情も知らないようだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130519
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 728130519,
					"content": "「スメールから来た学者」というのも、彼女から聞いただけだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130520
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 728130520,
					"content": "そうだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130521
					]
				},
				{
					"id": 728130521,
					"content": "うん…これらの証拠じゃ、信憑性が低いな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130522
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 728130522,
					"content": "でもお前が保証するなら、俺も信じる。彼女は悪い人じゃないって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130523
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 728130523,
					"content": "大将、一つ案があります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130524
					],
					"speakerTitle": "大久保大介"
				},
				{
					"id": 728130524,
					"content": "カウシックのことまだ覚えていますか？島の文化と歴史を研究している、あの学者のことを。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130525
					],
					"speakerTitle": "大久保大介"
				},
				{
					"id": 728130525,
					"content": "彼は以前からここに居続けているので、学者としての身分も信憑性が高い…彼に見てもらうのはどうでしょう。この…肥料販売員が、本当に学者なのかどうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130526
					],
					"speakerTitle": "大久保大介"
				},
				{
					"id": 728130526,
					"content": "うん、いい提案だ。旅人、カウシックさんをここに連れてきてくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130527
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 728130527,
					"content": "念のため、俺はここでこの…肥料販売員を見張っているから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130528
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 728130528,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130529
					]
				},
				{
					"id": 728130529,
					"content": "じゃあ、頼んだ。早く行くといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 728130513,
					"content": "アラニ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130514
					]
				}
			]
		},
