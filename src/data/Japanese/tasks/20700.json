			"dialogs": [
				{
					"id": 207000304,
					"content": "依頼を完了した。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000305
					]
				},
				{
					"id": 207000305,
					"content": "だらだらして、西風騎士団と変わらないな。1分あげると言ったんだ、ちゃんと覚えてるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000306
					],
					"speakerTitle": "ツァレーヴィチ"
				},
				{
					"id": 207000306,
					"content": "フン、こんな簡単なこともできないとは…1000モラだ、早く受け取れ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000307
					],
					"speakerTitle": "ツァレーヴィチ"
				},
				{
					"id": 207000307,
					"content": "1000モラ？少ないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000308
					],
					"speakerTitle": "パイモン"
				},
