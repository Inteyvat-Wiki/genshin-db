			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ツァレーヴィチ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 207000101,
					"content": "最悪だ！西風騎士団なんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000102
					],
					"speakerTitle": "ツァレーヴィチ"
				},
				{
					"id": 207000102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000103
					]
				},
				{
					"id": 207000103,
					"content": "フン、西風騎士団は本当に効率が悪い。この先は魔物がいるから通れないらしいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000104
					],
					"speakerTitle": "ツァレーヴィチ"
				},
				{
					"id": 207000104,
					"content": "しかし未だに何のお知らせもないなんて、本当頼りにならないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000105
					],
					"speakerTitle": "ツァレーヴィチ"
				},
				{
					"id": 207000105,
					"content": "俺は忙しいんだ、ここで待ってる間だけでどれぐらい金を失うか分からないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000106
					],
					"speakerTitle": "ツァレーヴィチ"
				},
				{
					"id": 207000106,
					"content": "しかし…お前は冒険者だよな？こうしよう、金を払うから俺の依頼を受けてくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000107,
						207000109
					],
					"speakerTitle": "ツァレーヴィチ"
				},
				{
					"id": 207000107,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000108
					]
				},
				{
					"id": 207000108,
					"content": "よしっ、お前みたいなやつは気に入ったよ。依頼を完了したら、ちゃんと報酬を渡すよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000111
					],
					"speakerTitle": "ツァレーヴィチ"
				},
				{
					"id": 207000111,
					"content": "俺の気のせいか分からないが、モンドのヒルチャールが増えてきた気がする。フン、西風騎士団め、何してるか分からないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000112
					],
					"speakerTitle": "ツァレーヴィチ"
				},
				{
					"id": 207000112,
					"content": "お前が依頼を受けてくれるというなら、ヒルチャールを倒してほしいんだ。でもお前は一人だし、うーん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000113
					],
					"speakerTitle": "ツァレーヴィチ"
				},
				{
					"id": 207000113,
					"content": "まあいい、山頂、山の中腹、それと麓、一つ選ぶといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000114
					],
					"speakerTitle": "ツァレーヴィチ"
				},
				{
					"id": 207000114,
					"content": "どこもヒルチャールが集まってるからそんなに変わらないんだ。それより俺は急いでるから早く選んでくれないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ツァレーヴィチ"
				},
				{
					"id": 207000109,
					"content": "どれぐらいもらえる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000110
					]
				},
				{
					"id": 207000110,
					"content": "フン、それはお前次第だ。ちゃんとやってくれたら、こっちもちゃんと報酬を渡すよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000111
					],
					"speakerTitle": "ツァレーヴィチ"
				}
			]
		},
