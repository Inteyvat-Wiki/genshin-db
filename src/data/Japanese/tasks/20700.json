			},
			"dialogs": [
				{
					"id": 207000201,
					"content": "依頼を完了した。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000202
					]
				},
				{
					"id": 207000202,
					"content": "早かったな。1分内に戻ってくるとは思わなかったよ。さすがだな、ハハハッ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000203
					],
					"speakerTitle": "ツァレーヴィチ"
				},
				{
					"id": 207000203,
					"content": "いいだろう、5000モラだ、ちゃんともらっておけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000204
					],
					"speakerTitle": "ツァレーヴィチ"
				},
				{
					"id": 207000204,
					"content": "5000モラだけ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 207000205,
					"content": "文句言うなよ、報酬はちゃんと計算しておいた、お前の実力相当の報酬だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000206
					],
					"speakerTitle": "ツァレーヴィチ"
				},
				{
					"id": 207000206,
					"content": "もっと稼ぎたいなら、もっと働くんだ。今後チャンスがあったらまた頼むよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ツァレーヴィチ"
				}
			]
		},
