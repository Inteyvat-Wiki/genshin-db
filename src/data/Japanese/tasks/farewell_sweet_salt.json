			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鍾離"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110230901,
					"content": "これは…剣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230902
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230902,
					"content": "あっ、壊れた剣よ！これが証拠よ！「塩の魔神」は抵抗した！ただモラクスには勝てなかったんだわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230903
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230903,
					"content": "「塩入れ」や「定規」に比べて、この「剣」の力はもっと強大でしょうね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230904
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230904,
					"content": "もし直すことができれば、「塩の魔神」の力をみんなに見せることができる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230905
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230905,
					"content": "確かに…負けた後に残されたものに見えるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230906
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110230906,
					"content": "剣の断片が二つ、考古学的な見地から言うとそれは二つの文化財になる。契約に従い、そのうち一方しかお前はもらえない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230907
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230907,
					"content": "ど、どうしてよ？だって、クリメントのヤツはもう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230908
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230908,
					"content": "ああ、だが「一点のみ」の契約はまだ有効だ。同時に二つもらうのは契約違反になる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230909
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230909,
					"content": "そ、それは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230910
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230910,
					"content": "なあ…鍾離、悪意はないんだし、少し融通を利かせたら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230911
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110230911,
					"content": "「契約」に融通はない。守るか、破るかだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230912
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230912,
					"content": "ダメ！半分だけもらっても直せっこないわ。そしたら「塩の魔神」の力だって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230913
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230913,
					"content": "アタシの信仰のために、何が何でも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230914
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230914,
					"content": "契約違反になっても、構わないわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230915
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230915,
					"content": "決心はついたか？では、代価を支払ってもらおう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230916
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230916,
					"content": "鍾離！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230917
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110230917,
					"content": "「岩食いの刑」を受けることになるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230918
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230918,
					"content": "…構わない。民を守るため犠牲になった「塩の魔神」と比べたら、そんなの大したことないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230919
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230919,
					"content": "どんな処罰でも構わない…アタシの信仰を守れるなら！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230920
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230920,
					"content": "女性を殴っちゃだめだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230921
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110230921,
					"content": "…それで許されるのなら、楽だけどな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230922
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230922,
					"content": "「罰」として、「真相」を教えよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230923
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230923,
					"content": "なっ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230924
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230924,
					"content": "真相？真相が…アタシへの罰？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230925
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230925,
					"content": "ああ。これから話す真相は、お前が「契約」を破った代価だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230926
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230926,
					"content": "——残念だが、塩の魔神ヘウリアは強い魔神ではない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230927
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230927,
					"content": "むしろ弱い——譲歩ばかりしてきた彼女は七神の座には登れない…敗者だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230928
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230928,
					"content": "何ですって…！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230929
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230929,
					"content": "魔神戦争時代、魔神たちはテイワット大陸を奪い合い、力と知恵を尽くし戦った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230930
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230930,
					"content": "しかし、ヘウリアは逃げることを選んだ。逃げれば、戦火の影響は自分と民たちに波及しないと思った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230931
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230931,
					"content": "しかし、長い戦争の中で「譲歩」は終わらない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230932
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230932,
					"content": "そうしてヘウリアは土地を全て失い、最後の居場所しか残らなくなった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230933
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230933,
					"content": "いや…そんなの…ありえない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230934
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230934,
					"content": "最後、彼女は民を守る武器すら持っていなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230935
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230935,
					"content": "武器すらない？でもこの剣は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230936
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230936,
					"content": "ああ、それは「塩の魔神」の遺物ではなく…彼女を殺した凶器だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230937
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230937,
					"content": "凶器…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230938
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230938,
					"content": "違う！嘘よ、アタシの信仰を惑わすつもりなのね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230939
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230939,
					"content": "事実を述べたまでだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230940
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230940,
					"content": "そんな馬鹿な！さては…あなたもモラクスの信者なのね、騙されないわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230941
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230941,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230942
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230942,
					"content": "おい！勝手に行くなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230943,
						110230945
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110230943,
					"content": "ショックだろうね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230944
					]
				},
				{
					"id": 110230944,
					"content": "罰、だからな。そうでなければ、俺だって話したくない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230947
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230947,
					"content": "先へ進もう。そこには…おそらく、彼女が「真相」を受け入れざる得ないものがある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230945,
					"content": "鍾離先生が話したのが「真相」だよね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230946
					]
				},
				{
					"id": 110230946,
					"content": "ああ、でなければ「真相」を罰にしない。俺だって話したくないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230947
					],
					"speakerTitle": "鍾離"
				}
			]
		},
