				"points": []
			},
			"dialogs": [
				{
					"id": 110231101,
					"content": "ここだ。ヘウリアだったものが崩れ、塩しか残っていない。これが彼女の最期だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231102
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110231102,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231103
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110231103,
					"content": "物語の続きだ、彼女の民はこの優しい魔神では誰も守れないと気付いた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231104
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110231104,
					"content": "魔神戦争は残酷だ。敗れた苦痛を味わわせるよりも、彼らは彼女を自由にしたかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231105
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110231105,
					"content": "でも、この「彫像」たちは…どういうこと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110231106,
					"content": "どんな弱い魔神であろうと、それが死ぬ時に流れ出る力は凡人の体では耐えられるものではない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231107
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110231107,
					"content": "逃げられなかった者がこんな風になってしまったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231108
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110231108,
					"content": "生き残った民は領地を離れ、岩王帝君の庇護を求めるため璃月に行った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231109
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110231109,
					"content": "その子孫たちは、ヘウリアが残した魔神残滓による呪いを恐れ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231110
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110231110,
					"content": "ここに戻って、彼女の怒りが鎮まるようにと剣を折って彼女に奉納した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231111
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110231111,
					"content": "だが、本当はする必要もなかったんだ。最後まで抵抗しなかった魔神が、自分の民に怒りを抱くわけ…ないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231112
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110231112,
					"content": "…そ、それでも、受け入れられないわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231113
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110231113,
					"content": "嘘よ…偽りの歴史よ…何もかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231114
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110231114,
					"content": "アタシの信仰は…揺るがない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231115
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110231115,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231116
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110231116,
					"content": "今回も、容赦ないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110231117,
					"content": "それが彼女の払う代価だ…が、悪いことばかりでもない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231118
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110231118,
					"content": "しばらく動揺は続くだろうが…すぐに納得できなくても事実を知ることはいいことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231119,
						110231121
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110231119,
					"content": "塩の魔神に詳しいんだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110231120
					]
				},
				{
					"id": 110231120,
					"content": "ああ、遠い昔の俺にとって、ヘウリアの話は戒めでもあるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231123
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110231123,
					"content": "亡くなった神を信仰するのは、いいことではない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231124
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110231124,
					"content": "…ヘウリアでも、モラクスでも、皆同じだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231125
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110231125,
					"content": "璃月の人々もいつか理解する。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110231126
					]
				},
				{
					"id": 110231126,
					"content": "ああ。さて、これから一緒に「孤雲閣」に来てくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231127
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110231127,
					"content": "ん？なにするんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110231128,
					"content": "あぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231129
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110231129,
					"content": "ここに来て、そして昔話をして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231130
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110231130,
					"content": "ふと懐かしい思いに駆られたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110231121,
					"content": "封印の事、噂で知ったんじゃないよね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110231122
					]
				},
				{
					"id": 110231122,
					"content": "鋭いな…まあ、俺が人より少し長生きしているだけのことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231123
					],
					"speakerTitle": "鍾離"
				}
			]
		}
	]
