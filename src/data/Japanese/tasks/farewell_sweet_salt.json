			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鍾離"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110230301,
					"content": "中に塩が半分入ってるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230302
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230302,
					"content": "ただの塩入れだろ、「塩の魔神」は貧乏な魔神だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230303
					],
					"speakerTitle": "クリメント"
				},
				{
					"id": 110230303,
					"content": "俺の知っている限り、それは普通のものじゃない。たかが半分、されど半分——永遠に変わらない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230304
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230304,
					"content": "ん！？つまりいくら使っても、中の塩は減らないのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230305
					],
					"speakerTitle": "クリメント"
				},
				{
					"id": 110230305,
					"content": "その通りだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230306
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230306,
					"content": "無限の塩を生み出すなんて、やっぱり「塩の魔神」の力はすごいわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230307
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230307,
					"content": "ここまで苦労してやっと見つけたお宝だ！こいつは俺のだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230308
					],
					"speakerTitle": "クリメント"
				},
				{
					"id": 110230308,
					"content": "無限に出てくる塩、それを売るだけで十分に儲かるはずだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230309
					],
					"speakerTitle": "クリメント"
				},
				{
					"id": 110230309,
					"content": "「塩の魔神」の遺産をそんなことに使わないでくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230310
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230310,
					"content": "クリメント殿がそれを欲するなら、契約に従って次は彼女がもらう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230311
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230311,
					"content": "問題ないさ、こいつより金になるものはなさそうだしな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230312
					],
					"speakerTitle": "クリメント"
				},
				{
					"id": 110230312,
					"content": "「契約」に従い、奪い合いはやめておくわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230313
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230313,
					"content": "では、先に進もう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鍾離"
				}
			]
		},
		{
			"id": 1102305,
			"completionStepIds": [
				1102305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102305",
							"2"
						],
						"stepId": 1102305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鍾離"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110230501,
					"content": "フン、ただの定規だろ、大したことない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230502
					],
					"speakerTitle": "クリメント"
				},
				{
					"id": 110230502,
					"content": "これは…測定器具の一つなのよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230503
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230503,
					"content": "その通り。しかし、これにも「塩の魔神」の力がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230504
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230504,
					"content": "これを地面に挿すと、そこから塩が溢れてくる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230505
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230505,
					"content": "深く挿すほど、得られる塩の量も多い。つまり、塩の「豊作」だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230506
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230506,
					"content": "そ、それって…俺の塩入れよりもすごいじゃないか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230507
					],
					"speakerTitle": "クリメント"
				},
				{
					"id": 110230507,
					"content": "では、契約に従い、この定規は彼女のものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230508
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230508,
					"content": "ダメだ！認めないぞ！俺が出した金だ、なんで俺が損しなければならないんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230509
					],
					"speakerTitle": "クリメント"
				},
				{
					"id": 110230509,
					"content": "それにこいつ何の役にも立ってないし、絶対に認めない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230510
					],
					"speakerTitle": "クリメント"
				},
				{
					"id": 110230510,
					"content": "やっぱりこうなるのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230511,
						110230512
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110230511,
					"content": "はぁ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230513
					]
				},
				{
					"id": 110230513,
					"content": "つまり、「契約」を破るのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230514
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230514,
					"content": "だったらなんだ？この遺跡の罠もほとんど分かったし、あんたがいなくても結構。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230515
					],
					"speakerTitle": "クリメント"
				},
				{
					"id": 110230515,
					"content": "そもそも俺が雇い主なのに、なんであんたに従わないといけないんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230516
					],
					"speakerTitle": "クリメント"
				},
				{
					"id": 110230516,
					"content": "契約を結んだからだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230517
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230517,
					"content": "岩王帝君はこう言った、「契約を反故する者は岩食いの刑に値する」と。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230518
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230518,
					"content": "それは璃月の神だろ、俺はスネージナヤから来た…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230519
					],
					"speakerTitle": "クリメント"
				},
				{
					"id": 110230519,
					"content": "「岩食いの刑」、その身を以て体験するといい…無事じゃ済まないがな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230512,
					"content": "それを言ったら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230513
					]
				}
			]
		},
		{
			"id": 1102307,
			"completionStepIds": [
				1102307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102307",
							"2"
						],
						"stepId": 1102307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鍾離"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110230701,
					"content": "その獲物も、没収する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230702
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230702,
					"content": "この先に行く資格はない、去るがいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230703
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230703,
					"content": "くそっ…覚えてろよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230704
					],
					"speakerTitle": "クリメント"
				},
				{
					"id": 110230704,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230705
					],
					"speakerTitle": "クリメント"
				},
				{
					"id": 110230705,
					"content": "考古学のためとか言って、結局嘘だったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230706,
						110230708
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110230706,
					"content": "警戒して正解だった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230707
					]
				},
				{
					"id": 110230707,
					"content": "だな！オイラの鼻は騙されないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230710
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110230710,
					"content": "彼は貪欲で間違いを犯した。しかし貪欲の他にも、契約を破る原因はまだまだある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230711
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230711,
					"content": "「渇望するもの」を前に、契約を守れる者はどれほどいるか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230712
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230712,
					"content": "これを機にはっきりとさせよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230713
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230713,
					"content": "ん？なんのことだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230714
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110230714,
					"content": "この考古学チームに、「考古学」を目的に来た者はいない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230715
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230715,
					"content": "ど、どうしてそう言えるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230716
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230716,
					"content": "お前は考古学の初歩的な知識も文化財もよく知らないが、「塩の魔神」に関する知識だけはかなり詳しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230717
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230717,
					"content": "考古学や文化財よりも、「塩の魔神」自身に興味があるのだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230718
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230718,
					"content": "また、お前が話した塩の魔神の伝説も、その多くは「銀原庁」に伝わっている…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230719
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230719,
					"content": "そ、それ以上言わないで！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230720
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230720,
					"content": "…鍾離殿はやっぱり物知りなのね。何もかも見抜かれてるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230721
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230721,
					"content": "——そう、アタシは考古学者ではなく、璃月「七星八門」のひとつ、塩業を担当する「銀原庁」の者よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230722
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230722,
					"content": "アタシたちの祖先は、かつて魔神戦争中に「塩の魔神」に守られた民だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230723,
						110230724
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230723,
					"content": "そういえば「帝君」って呼んでない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230725
					]
				},
				{
					"id": 110230725,
					"content": "確かに、「モラクス」っていう名前を口にする璃月人はめったにいないもんな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230726
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110230726,
					"content": "戦争中、モラクスがアタシたちの神を殺した！「塩の魔神」の力を奪うために！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230727
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230727,
					"content": "…憎いわ！でも璃月はモラクスの璃月、歴史だって改ざんされてるに決まってる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230728
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230728,
					"content": "だから証明したいの！モラクスが悪で、残酷な一面もあるってことを！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230729
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230729,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230730
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230730,
					"content": "「契約」に従って、真実をちゃんと公正に判断してくれるわね？鍾離殿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230731
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230731,
					"content": "もちろんだ。それに、璃月はもうモラクスの璃月ではない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230732
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230732,
					"content": "ついてこい、答えはこの先にある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230724,
					"content": "そういえば「モラクス」って呼んでた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230725
					]
				},
				{
					"id": 110230708,
					"content": "パイモンはあんな風にならないでね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230709
					]
				},
				{
					"id": 110230709,
					"content": "モラは大好きだけど、悪いことはしないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230710
					],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 1102309,
			"completionStepIds": [
				1102309
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102309",
