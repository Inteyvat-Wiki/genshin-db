					}
				]
			},
			"dialogs": [
				{
					"id": 761760301,
					"content": "…アリア姉さま、カノン姉さま。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760302
					],
					"speakerTitle": "ソネット"
				},
				{
					"id": 761760302,
					"content": "今回が初めてのことじゃない。こんなの…「罰」の域を超えてるよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760303
					],
					"speakerTitle": "ソネット"
				},
				{
					"id": 761760303,
					"content": "王に託された龍の都市も、あの小さな人間たちが築き上げた、儚くも美しい家々も…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760304
					],
					"speakerTitle": "ソネット"
				},
				{
					"id": 761760304,
					"content": "姉さまたちは、あとどれだけ罪なき命が失われるのを見届ければ、傍観をやめるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760305
					],
					"speakerTitle": "ソネット"
				},
				{
					"id": 761760305,
					"content": "もし、わたしたちの王が健在だったら——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760306
					],
					"speakerTitle": "ソネット"
				},
				{
					"id": 761760306,
					"content": "——私たちの王はもういないのよ、ソネット。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760307
					],
					"speakerTitle": "アリア"
				},
				{
					"id": 761760307,
					"content": "もし、あの全能とは程遠い高天の主が、蒼白で恐ろしい運命を「秩序」と見なすのなら…もしそれが、破滅を運命づけられたこの世界が呑み込まれるのを免れる、唯一の可能性であるのなら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760308
					],
					"speakerTitle": "アリア"
				},
				{
					"id": 761760308,
					"content": "どれほど重い代償を要求されようとも…そして、それがどれほど私を悲しませようとも、漆黒の死の静寂よりは遥かにマシよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760309
					],
					"speakerTitle": "アリア"
				},
				{
					"id": 761760309,
					"content": "世界が破滅を迎える運命にあるなら…漆黒に抗うことに、一体何の意味があるっていうの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760310
					],
					"speakerTitle": "ソネット"
				},
				{
					"id": 761760310,
					"content": "…ソネット？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760311
					],
					"speakerTitle": "アリア"
				},
				{
					"id": 761760311,
					"content": "な、何でもないよ、アリア姉さま！うん、何も言ってないから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760312
					],
					"speakerTitle": "ソネット"
				},
				{
					"id": 761760312,
					"content": "ただ、わたしたちを信じてくれてる生命が、あの暴君に虐殺されるのを見過ごすべきじゃないと思って…それが龍であれ、ちっぽけな人間たちであれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760313
					],
					"speakerTitle": "ソネット"
				},
				{
					"id": 761760313,
					"content": "わたしたち…彼らを救うべきじゃないのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760314
					],
					"speakerTitle": "ソネット"
				},
				{
					"id": 761760314,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760315
					],
					"speakerTitle": "カノン"
				},
				{
					"id": 761760315,
					"content": "…ソネットが怒るのも無理ないよ、姉さま。私から見ても、高天の主のやり方はあまりにも残酷すぎる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760316
					],
					"speakerTitle": "カノン"
				},
				{
					"id": 761760316,
					"content": "たとえほんのわずかな可能性しかなくとも…私は全力を尽くして、救える命を救いたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760317
					],
					"speakerTitle": "カノン"
				},
				{
					"id": 761760317,
					"content": "でも…救われなかった人たちは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760318
					],
					"speakerTitle": "ソネット"
				},
				{
					"id": 761760318,
					"content": "救われなかった人たち、救われなかった命…彼らの血の涙と嘆きは、跡形もなく消え去って当然だというの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760319
					],
					"speakerTitle": "ソネット"
				},
				{
					"id": 761760319,
					"content": "ううん…そんなはずない。わたしは、誰一人見捨てられることなく、すべての命が救われてほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760320
					],
					"speakerTitle": "ソネット"
				},
				{
					"id": 761760320,
					"content": "その「秩序」が高天の主と共に滅びさえすれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760321
					],
					"speakerTitle": "ソネット"
				},
				{
					"id": 761760321,
					"content": "…ソネット。私たちが生まれた意味を忘れないで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760322
					],
					"speakerTitle": "アリア"
				},
				{
					"id": 761760322,
					"content": "私たちに命を与えた王が彼方から帰還するまで、この世界を維持すること…それだけが、私たちの使命なのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760323
					],
					"speakerTitle": "アリア"
				},
				{
					"id": 761760323,
					"content": "私たちは、初めからこの秩序の代償を理解していたわ…この世界が破滅へと向かうのを、見過ごすことなんてできないもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760324
					],
					"speakerTitle": "アリア"
				},
				{
					"id": 761760324,
					"content": "…いや、これは秩序とすら関係ないよ、姉さま。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760325
					],
					"speakerTitle": "カノン"
				},
				{
					"id": 761760325,
					"content": "私たちにとって…私にとって、ソネットは一番大切な妹だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760326
					],
					"speakerTitle": "カノン"
				},
				{
					"id": 761760326,
					"content": "だから…姉さまと私を苦しめるようなことはしないでほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760327
					],
					"speakerTitle": "カノン"
				},
				{
					"id": 761760327,
					"content": "高天の秩序に直接抗ってはいけないよ。少なくとも…世界がまだ脆弱な今は。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760328
					],
					"speakerTitle": "カノン"
				},
				{
					"id": 761760328,
					"content": "カノン姉さま…わたし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760329
					],
					"speakerTitle": "ソネット"
				},
				{
					"id": 761760329,
					"content": "イスタロトが教えてくれた、人間だけが持つ言葉…「希望」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760330
					],
					"speakerTitle": "カノン"
				},
				{
					"id": 761760330,
					"content": "命がある限り、希望はある…必ず、希望はあるんだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カノン"
				}
			]
		}
	]
}