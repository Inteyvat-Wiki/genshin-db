			"dialogs": [
				{
					"id": 761160101,
					"content": "おや、あたしとボビックが生死を共にした同志じゃない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761160102,
						761160105,
						761160108,
						761160110
					],
					"speakerTitle": "アニツカ"
				},
				{
					"id": 761160102,
					"content": "二人はこれからどうするの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761160103
					]
				},
				{
					"id": 761160103,
					"content": "あたしたちはしばらくここにいるわ。ドルジスラヴの研究室の扉が壊れちゃったんだもの。悪い人たちが入らないように見張ってないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761160104
					],
					"speakerTitle": "アニツカ"
				},
				{
					"id": 761160104,
					"content": "扉を修理できたら、あるいはドルジが帰ってきたら、あなたたちと同じように…ボビックと旅にでも行くわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アニツカ"
				},
				{
					"id": 761160105,
					"content": "ドルジスラヴについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761160106
					]
				},
				{
					"id": 761160106,
					"content": "どこにいるのか、まったく見当もつかない…もし旅の途中で会ったら、よろしく伝えておいて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761160107
					],
					"speakerTitle": "アニツカ"
				},
				{
					"id": 761160107,
					"content": "また「フラッグシップ」で彼と一緒に飲み明かしたいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アニツカ"
				},
				{
					"id": 761160108,
					"content": "ボビックについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761160109
					]
				},
				{
					"id": 761160109,
					"content": "ボビックに会いたくなったの？いつでも会いに来てあげて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アニツカ"
				},
				{
					"id": 761160110,
					"content": "じゃ、またね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761160111
					]
				},
				{
					"id": 761160111,
					"content": "ええ、きっとまた会えるわ。生死を共にした仲だもの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アニツカ"
				}
			]
		}
	]
