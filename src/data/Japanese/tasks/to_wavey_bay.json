			},
			"dialogs": [
				{
					"id": 150421501,
					"content": "よし、人数確認ね！…一、二、三、四…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421502
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150421502,
					"content": "一人増えてる！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421503
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150421503,
					"content": "ざぶざぶ湾のメインアトラクションに参加したいのかい？今、ちょっと問題が発生しててね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421504
					],
					"speakerTitle": "トゥシナ"
				},
				{
					"id": 150421504,
					"content": "アルバムのイベントのために、観光ポイントで記念写真を撮るなら、今撮るよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421505
					],
					"speakerTitle": "トゥシナ"
				},
				{
					"id": 150421505,
					"content": "いやいや…ダメでしょ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421506
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150421506,
					"content": "写真っていうのは、後で見たときに温か～い思い出を蘇らせるための手段でしょ…あたしたちが欲しいのは遊ぶって体験そのものだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421507
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150421507,
					"content": "写真も報酬と交換できること、忘れてるだろ…まあ、でもオイラも同意見だぜ。一枚撮ってサヨナラなんて適当すぎるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421508
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150421508,
					"content": "そうだよね…すまない。そうすると、もう少し待ってくれるかい…できるだけ早く何とかするからさ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421509
					],
					"speakerTitle": "トゥシナ"
				},
				{
					"id": 150421509,
					"content": "どれくらい待てばいいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421510
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150421510,
					"content": "それはなんとも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421511
					],
					"speakerTitle": "トゥシナ"
				},
				{
					"id": 150421511,
					"content": "えっ？なんとも？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421512
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150421512,
					"content": "じゃああたしたちが手伝ったら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421513
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150421513,
					"content": "えっ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421514
					],
					"speakerTitle": "トゥシナ"
				},
				{
					"id": 150421514,
					"content": "ざぶざぶ湾のほかのアトラクションも、人手が少ないみたいだった。竜のスタッフも明らかに疲れてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421515
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150421515,
					"content": "メインアトラクションに何かあったから、みんなここにヘルプに入って、修復作業に当たってるんじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421516
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150421516,
					"content": "内部の事情を公表できないのは分かってる。別に困らせるために聞いてるわけじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421517
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150421517,
					"content": "むしろその逆だ。私の仲間はみな優秀だ——人助けが好きで、少し前にはみんなでイクトミ・フェリーとランニング・アシャのテストも手伝った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421518
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150421518,
					"content": "手伝わせてくれれば、事態はより早く解決するかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421519
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150421519,
					"content": "わぁ、条件を出しつつも理解を示す…さすが「調停者」だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421520
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150421520,
					"content": "チャスカ、一体どうやってあたしたちを観察してたの？まさか、こっそり木の上から盗み見してたんじゃないよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421521
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150421521,
					"content": "大事なのはそこじゃない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421522
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150421522,
					"content": "ああ…オレたちは本当に手伝うのが得意なんだ！何か問題があるなら、みんなで力になるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421523
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150421523,
					"content": "竜の状態まで悟られていたとは…素直に話したほうがよさそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421524
					],
					"speakerTitle": "トゥシナ"
				},
				{
					"id": 150421524,
					"content": "現在の状況だけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421525
					],
					"speakerTitle": "トゥシナ"
				},
				{
					"id": 150421525,
					"content": "テストプレイで、キラキラ・スライダーがペイントされていない箇所だらけだと発覚した。スピリットウェイの上から色を塗らないといけないもんで、施工難易度が高くてね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421526
					],
					"speakerTitle": "トゥシナ"
				},
				{
					"id": 150421526,
					"content": "リゾートのグランドオープンに影響を与えないよう、アトラクションを一時閉鎖して、取り急ぎ修理してる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421527
					],
					"speakerTitle": "トゥシナ"
				},
				{
					"id": 150421527,
					"content": "あははっ、そんなのあたしの手にかかればちょちょいのちょいだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421528
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150421528,
					"content": "塗料はどこにあるの？一発で全部塗ってきてあげる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421529
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150421529,
					"content": "え…それって…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421530
					],
					"speakerTitle": "トゥシナ"
				},
				{
					"id": 150421530,
					"content": "この顔を知らないか？こいつは「ウモジャ」のムアラニだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421531
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150421531,
					"content": "ムアラニ…えっ、ムアラニ…！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421532
					],
					"speakerTitle": "トゥシナ"
				},
				{
					"id": 150421532,
					"content": "ムアラニって…六英傑の、あのムアラニかい！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "トゥシナ"
				}
			]
		},
