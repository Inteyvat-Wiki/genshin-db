					"チャスカ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 150421401,
					"content": "どうだった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421402,
						150421404,
						150421406
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150421402,
					"content": "簡単だった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421403
					]
				},
				{
					"id": 150421403,
					"content": "言ってくれるじゃないか。確かに、上手だったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421408
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150421408,
					"content": "私もスタッフにアドバイスをしてこようか…今後の改善に繋がるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421409
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150421409,
					"content": "勝負したいプレイヤーがいるんだ。二人とやれないことには気がすまない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150421404,
					"content": "目がぐるぐるしてきた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421405
					]
				},
				{
					"id": 150421405,
					"content": "ははっ、ずっと集中し続けていると、疲れるからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421408
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150421406,
					"content": "結構楽しい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421407
					]
				},
				{
					"id": 150421407,
					"content": "そうか？私と同じだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421408
					],
					"speakerTitle": "チャスカ"
				}
			]
		},
