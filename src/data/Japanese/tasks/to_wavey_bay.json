			"dialogs": [
				{
					"id": 150420101,
					"content": "やっほ～！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420102
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150420102,
					"content": "太陽！海！コホラ竜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420103
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150420103,
					"content": "ムアラニ、興奮しすぎて自分の古名が「ウモ{RUBY#[D]団結}ジャ」だってこと、忘れてるんじゃないか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150420104,
					"content": "早く！こっちこっち！んもう！早く！ダッシュダッシュ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420105
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150420105,
					"content": "今行くぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420106
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150420106,
					"content": "じゃーん！これ、な～んだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420107
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150420107,
					"content": "木の板。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150420108,
					"content": "字を読んでよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420109
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150420109,
					"content": "おお、観光マップか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150420110,
					"content": "その通り！その価値は巨大な宝庫を開ける鍵にも劣らない——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420111
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150420111,
					"content": "わかるぜ！冒険の始まりの象徴だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420112
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150420112,
					"content": "「燃え盛る燃素の種」みたいなものだね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420113
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150420113,
					"content": "燃素？っていうと…たしかエネルギーの一種だったよな？つまり…一目見ただけで…力が湧いてくるって意味か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420114
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150420114,
					"content": "そう！燃素はとっても大事なんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420115
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150420115,
					"content": "マップもおんなじ。これさえあれば、チェックするだけで自分だけの冒険の道を自由に切り開けちゃうんだから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420116
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150420116,
					"content": "おお！自分だけの！冒険の道！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420117
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150420117,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420118
					],
					"speakerTitle": "アシャ"
				},
				{
					"id": 150420118,
					"content": "いや…待てよ。ムアラニの話にはなにか裏がある気がするぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150420119,
					"content": "よ～し、解散！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420120
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150420120,
					"content": "観光スポットに着いた途端、解散するガイドがどこにいるんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420121,
						150420122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150420121,
					"content": "自分が遊びたいだけなんじゃない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150420123
					]
				},
				{
					"id": 150420123,
					"content": "さっすがあたしの仲間だね！あたしの気持ちになってくれてありがと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420124
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150420124,
					"content": "見て見て！この二つのアトラクション、横に「テスト待ち」って書いてあるよ。何か問題があったのかもね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420125
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150420125,
					"content": "じゃあ、気になるアトラクションを手分けして体験しながら、テストを手伝ってあげない？もしかしたら、ざぶざぶ湾のオープンを早められるかもよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420126
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150420126,
					"content": "水上アトラクションを前にしたら、オイラたちのことなんてほっぽってどっか行っちゃうのかと思ってたけど…意外と親切なんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150420127,
					"content": "へへっ。最後はあのでっかいコホラ竜の建物の近くで集合しよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420128
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150420128,
					"content": "長年のガイド経験からすると、メイン挑戦への入口は、きっとあの辺にあると思うんだよね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420129
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150420129,
					"content": "わかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420130
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150420130,
					"content": "それじゃあ、解散ね。マップをちゃんと見るんだよ～！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150420122,
					"content": "今日はガイドもバカンスなんだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150420123
					]
				}
			]
		},
		{
