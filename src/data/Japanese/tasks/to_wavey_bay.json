			"trigger": {
				"objectNames": [
					"チャスカ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 150421301,
					"content": "ほう、いい眼をしている。私がこんな高いところに立っているのに、見つかってしまうとはな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421302
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150421302,
					"content": "お前もここのアトラクションに興味があるみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421303,
						150421305
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150421303,
					"content": "面白い？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421304
					]
				},
				{
					"id": 150421304,
					"content": "悪くないとは思うが、面白いかどうかは主観的な判断で決めるものだ。自分で試してみるに越したことはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421307
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150421307,
					"content": "あのレールが見えるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421308
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150421308,
					"content": "絵の具玉を使ってレール上の球を染めていくんだ。同じ色にすれば、球は消える。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421309
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150421309,
					"content": "どうやって「消える」のかって？ふふっ、誰かが銃を構えて球を吹っ飛ばしてるのかもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421310,
						150421311
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150421310,
					"content": "すごい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421312
					]
				},
				{
					"id": 150421312,
					"content": "じゃあ、やってみるか？そいつを使うといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421313
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150421313,
					"content": "今回はお前がやる番だ、私は見てる。頑張ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150421311,
					"content": "冗談に聞こえないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421312
					]
				},
				{
					"id": 150421305,
					"content": "難しい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421306
					]
				},
				{
					"id": 150421306,
					"content": "肩の力を抜け。ここはのびのびリゾート…「難しい」とか「手強い」なんて言葉とは無縁の場所だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421307
					],
					"speakerTitle": "チャスカ"
				}
			]
		},
