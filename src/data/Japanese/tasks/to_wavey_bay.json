			"dialogs": [
				{
					"id": 150421701,
					"content": "ムアラニ、お疲れ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421702
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150421702,
					"content": "ふー、楽しかった…どう？なかなかいい出来でしょ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421703
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150421703,
					"content": "すっごくきれいだ！さすがナタの六英傑だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421704
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150421704,
					"content": "サーフボードが飛び出して行ったあと、パイモンからお前の話を聞いた！すごすぎて、全身が燃え上がるほど興奮したぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421705
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150421705,
					"content": "えへへっ、ありがと！なんかテンション上がってきちゃったな。温泉パーティーでも開きたい気分！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421706
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150421706,
					"content": "わぁ！みんな見て！ざぶざぶ湾のスタッフが集まってきた！あんなに頑張ったんだから、みんなきっと音楽とパーティーを楽しみにしてるんじゃない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421707
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150421707,
					"content": "違うと思うな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421708
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150421708,
					"content": "え？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421709
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150421709,
					"content": "英雄ムアラニ——サインをおくれよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421710
					],
					"speakerTitle": "トゥシナ"
				},
				{
					"id": 150421710,
					"content": "俺にも！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421711
					],
					"speakerTitle": "ガウン"
				},
				{
					"id": 150421711,
					"content": "プルル！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421712
					],
					"speakerTitle": "イクトミ仔竜"
				},
				{
					"id": 150421712,
					"content": "スターの正体がバレちゃったね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421713
					]
				},
				{
					"id": 150421713,
					"content": "人が増えないうちに写真撮っとこ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421714
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150421714,
					"content": "自信に満ちた明るい笑顔で！海の景色と、自分のラッキーカラーに思いを馳せて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421715
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150421715,
					"content": "三、二、一…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421716
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150421716,
					"content": "コホラ竜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421717
					],
					"speakerTitle": "パイモン"
				},
