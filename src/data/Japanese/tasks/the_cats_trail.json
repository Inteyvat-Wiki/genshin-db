			"dialogs": [
				{
					"id": 220410301,
					"content": "昆布丸は見つかったかにゃ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410302
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220410302,
					"content": "見つけた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220410303
					]
				},
				{
					"id": 220410303,
					"content": "あれっ？またいなくなったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410304,
						220410305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 220410304,
					"content": "今捕まえてくる！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220410306
					]
				},
				{
					"id": 220410306,
					"content": "主ら、もう探さなくていいにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410307
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220410307,
					"content": "あの子はわざとうちを怒らせようとしている…あとでうちが、しっかりと叱ってやるにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410308
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220410308,
					"content": "もう大きくなったというのに、どうしてあんなにワガママにゃのか。もし神社に来た人間を驚かしたらどうするにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410309
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220410309,
					"content": "ほれ、これを主らにやろう。手伝ってくれて感謝するにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410310
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220410310,
					"content": "はぁ、どうしてあの子は「飯」のように、おとなしくなってくれにゃいのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220410305,
					"content": "まったくもう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220410306
					]
				}
