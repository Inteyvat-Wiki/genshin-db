			"dialogs": [
				{
					"id": 220410101,
					"content": "主ら、ちょうどいい時に来たにゃ。いま少し悩んでいることがある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410102
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220410102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220410103
					]
				},
				{
					"id": 220410103,
					"content": "主ら、「昆布丸」という子を覚えているか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410104
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220410104,
					"content": "あの子、近くに遊びに行ったきり帰って来ていにゃい。心配にゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410105
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220410105,
					"content": "主ら、近くへ行って「昆布丸」を探してきてくれにゃいか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410106,
						220410108
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220410106,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220410107
					]
				},
				{
					"id": 220410107,
					"content": "それじゃ頼んだにゃ。「昆布丸」を神社に連れ帰ってくれにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220410108,
					"content": "外に行ったのはその子だけ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220410109
					]
				},
				{
					"id": 220410109,
					"content": "そうにゃ…たぶんこの前うちがあの子を叱ったから、気を悪くしたのかもしれにゃい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410110
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220410110,
					"content": "まったく、どうしてうちの話を聞いてくれにゃいのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410111
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220410111,
					"content": "主に任せたにゃ。「昆布丸」を神社に連れ帰ってくれにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寝子」"
				}
			]
		},
