			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"エカテリーナ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10100201,
					"content": "#ようこそ、「公子」様のご友人、{NICKNAME}。「ファデュイ」でのご活躍をお祈りしておりますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100202,
						10100203
					],
					"speakerTitle": "エカテリーナ"
				},
				{
					"id": 10100202,
					"content": "「公子」の友達ではない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100204
					]
				},
				{
					"id": 10100204,
					"content": "フフッ…私たちは凡人であり、「氷の女皇」ではありません。凡人の考えは氷の下にある水…ずっと固く鋭いわけがありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100205
					],
					"speakerTitle": "エカテリーナ"
				},
				{
					"id": 10100205,
					"content": "失礼しました、本題に戻らせていただきます。約束は果たしたと、「公子」様から伝言を授かっております。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100206
					],
					"speakerTitle": "エカテリーナ"
				},
				{
					"id": 10100206,
					"content": "約束を果たした？あっ、人を探してくるって話か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10100207,
					"content": "はい、状況を打破できる人を探すと「公子」様は約束しました。「ファデュイ」の執行官は約束を違えません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100208
					],
					"speakerTitle": "エカテリーナ"
				},
				{
					"id": 10100208,
					"content": "じゃあ、どこにいけば会えるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10100209,
					"content": "「公子」様は<color=#00E1FFFF>「琉璃亭」</color>にいます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100210
					],
					"speakerTitle": "エカテリーナ"
				},
				{
					"id": 10100210,
					"content": "琉璃亭？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100211
					]
				},
				{
					"id": 10100211,
					"content": "おお、琉璃亭か！聞いたことがあるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10100212,
					"content": "璃月の料理には「璃菜」と「月菜」の二つの菜系があって、数百年も対立してきてるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10100213,
					"content": "で、「璃菜」の代表が「琉璃亭」なんだ。オーナーはわざと緋雲の丘に店を構えて、「月菜」を代表する「新月軒」と正面対決してるって話だぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100214,
						10100215
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10100214,
					"content": "パイモンはこんな時に役立つんだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100216
					]
				},
				{
					"id": 10100216,
					"content": "#そう言わずに——とにかく、美味しいものがあるぞ！{NICKNAME}、早く行こうぜ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10100215,
					"content": "タダで食べられると聞いたらすぐ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100216
					]
				},
				{
					"id": 10100203,
					"content": "「ファデュイ」に入るつもりはない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100204
					]
				}
			]
		},
		{
			"id": 101003,
			"completionStepIds": [
				101003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101003",
							"2"
						],
						"stepId": 101003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「公子」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10100301,
					"content": "やぁ、来たね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100302
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10100302,
					"content": "約束は果たしたよ、君たちを助けられる人——「岩神の仙体が七星によって隠された」という難題を解決してくれる人を見つけた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100303
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10100303,
					"content": "で、そいつはどこにいるんだ？<color=#00E1FFFF>「琉璃亭」</color>にいるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10100304,
					"content": "ああ、ついてきて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100305
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10100305,
					"content": "接待を——いや、この国でいう「食事会」というおもてなしを用意した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「公子」"
				}
			]
		},
		{
			"id": 101005,
			"completionStepIds": [
				101005
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101005",
							"2"
						],
						"stepId": 101005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鍾離"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10100501,
					"content": "紹介するよ。こちらは稼業人で、「往生堂」の客卿、鍾離先生だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100502,
						10100503
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10100502,
					"content": "稼業人！？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100504
					]
				},
				{
					"id": 10100504,
					"content": "うん、璃月で「往生堂」のような仕事は、どうしても「稼業人」との商売を避けられないからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100505
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10100505,
					"content": "俺たちファデュイは、こういう…影の下を歩くお友達と付き合うのが好きなんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100506
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10100506,
					"content": "影の下を歩く…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100507
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10100507,
					"content": "初めまして。お前たちがモンドで活躍した噂を耳にしたことがある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100508
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10100508,
					"content": "稼業人…影…人を「往生」…あっ！まさか、「往生堂」っていうのは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100509
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10100509,
					"content": "そうだ、お前の想像通りだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100510
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10100510,
					"content": "ひぃ——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100511
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10100511,
					"content": "「往生堂」とは葬儀業者で、人々を安心して極楽浄土へと送り出すためにある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100512
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10100512,
					"content": "あ、あれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100513
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10100513,
					"content": "ははっ、まさか鍾離先生が殺し屋かと思ったのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100514
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10100514,
					"content": "ファデュイのお友達の中には確かに殺し屋はたくさんいるけど、「往生堂」は違うよ…少なくとも表向きはね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100515
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10100515,
					"content": "表向き…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100516
					]
				},
				{
					"id": 10100516,
					"content": "一応「稼業人」だからね、詳細は言えない。とにかく、君たちに紹介した理由は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100517
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10100517,
					"content": "俺なら、お前たちに岩王帝君の仙体に会わせられる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100518
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10100518,
					"content": "なんだって！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100519
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10100519,
					"content": "ははっ、驚くことはないよ。「天権」凝光の企みのせいで、岩神の仙体は隠されてしまったけど…まあ、まずは鍾離先生の話を聞こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100520
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10100520,
					"content": "岩王帝君は仙人たちの祖だが、仙人の一人だ。璃月数千年の歴史を見ていくと、仙人が去っていく傾向は紛れもない事実としてある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100521
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10100521,
					"content": "なぜなら時代が変わったからだ——絶雲の間を訪れた時、そういう変化をお前たちも感じただろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100522,
						10100523
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10100522,
					"content": "確かに、仙人たちは璃月を離れている。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100525
					]
				},
				{
					"id": 10100525,
					"content": "見ての通り、仙人の時代は遠ざかりつつあり、人の時代こそが徐々に現実となりつつあるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100526
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10100526,
					"content": "昔、仙人が去ると盛大な儀式が執り行われていた。それが璃月の伝統だ。しかし、今回の件については七星までもがその伝統を蔑ろにしている…見ていられない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100527
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10100527,
					"content": "何せ「神殺し事件」だから…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100528
					]
				},
				{
					"id": 10100528,
					"content": "そうだよ、真犯人もまだ捕まってない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100529
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10100529,
					"content": "神殺し事件…それについて「往生堂」は気になどしていない。「往生堂」が気にしているのは、仙人を迎える迎仙儀式が盛大に行われている反面、去った仙人を送る送仙儀式が放置されている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100530
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10100530,
					"content": "旅人よ、「公子」殿からお前のことを聞いた。お前は風神の友人なのだろう…俺と共に、岩神を送る儀式の準備をしてくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100531,
						10100534,
						10100536
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10100531,
					"content": "少し考えさせて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100532
					]
				},
				{
					"id": 10100532,
					"content": "#うーん…{NICKNAME}、よく考えてみても、他に方法はなさそうだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100533
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10100533,
					"content": "そうだよ、これ以上考えても結果は同じだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100539
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10100539,
					"content": "「天権」凝光…彼女は帝君の仙体を見ることを禁じた。無事、七神を訪ねたいのなら、君にはこの方法しか残ってない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100540
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10100540,
					"content": "その通りだ。「送仙儀式」に参加することだけが、岩神の体に会うことのできる唯一の機会だろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100541
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10100541,
					"content": "それしか方法がないみたいだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100542
					]
				},
				{
					"id": 10100542,
					"content": "ああ、納得したのなら、俺についてこい。詳細は歩きながら話そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100543
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10100543,
					"content": "（黑屏、鍾離出门）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100544
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10100544,
					"content": "よしっ、これで俺の橋渡しとしての役目は終わった。どう？なかなかの結果だろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100545
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10100545,
					"content": "さあ、行くなら早くした方がいい、俺のことは気にしないで。ここで数杯いただいて…ついでに「箸」の使い方でも練習してるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10100534,
					"content": "準備を手伝ってもいい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100535
					]
				},
				{
					"id": 10100535,
					"content": "賢明な判断だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100539
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10100536,
					"content": "「公子」の口数が多すぎる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100537
					]
				},
				{
					"id": 10100537,
					"content": "へえ？「稼業人」のルールだと、それは口封じを意味する言葉だけど…面白い、剣を抜け、いざここで——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100538
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10100538,
					"content": "冗談だよ。本題に戻るよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100539
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10100523,
					"content": "七神の岩神も、仙人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100524
					]
				},
				{
					"id": 10100524,
					"content": "岩神には様々な尊名がある。契約の神、商業の神、武神、モラクス、岩王帝君…その中に「仙人」ももちろん含まれている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100525
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10100503,
					"content": "往生堂？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100504
					]
				}
			]
		},
		{
			"id": 101006,
			"completionStepIds": [
				101006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
