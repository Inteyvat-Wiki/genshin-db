			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鍾離"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10100601,
					"content": "旅人、「神が去った城」をその身で感じた後、璃月という「神のいる地」を訪れ、お前はどう感じた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100602,
						10100605
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10100602,
					"content": "モンドの雰囲気の方が好き。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100603
					]
				},
				{
					"id": 10100603,
					"content": "なるほど…お前はそういう種類の旅人か。それも悪くない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100604
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10100604,
					"content": "しかし、「神のいる地」には3700年の歴史がある、お前はまだ全てを経験したわけではないかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100607
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10100607,
					"content": "「送仙儀式」を準備する過程も、お前の旅の一部となり、お前の見聞を広めることになるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100608
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10100608,
					"content": "璃月は七国で最も繁栄している国であり、神の鎮座や七星の統治がある。それゆえ、「ファデュイ」の外交手段の多くは、璃月では通用しない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100609
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10100609,
					"content": "七星の一人である凝光は、常にファデュイを警戒している。おそらく、それこそ「公子」が「往生堂」の力を借りた理由かもしれないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100610
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10100610,
					"content": "うーん…「送仙儀式」は、「公子」にとって何のメリットがあるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100611
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10100611,
					"content": "それは知らないし、知りたくもない。俺にとって、「ファデュイ」はあくまで資金援助をするだけの存在だ。俺の望みは、璃月の伝統が人々に忘れられないことにある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100612
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10100612,
					"content": "（鍾離交给主角一个钱袋）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100613
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10100613,
					"content": "これは「公子」が提供してくれた最初の資金だ。使い切ったら、彼に報告してまた資金をもらうといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100614
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10100614,
					"content": "おおっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100615
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10100615,
					"content": "さあ、行こう。儀式の準備の第一歩は…神に釣り合う最高品質の<color=#00E1FFFF>「夜泊石」</color>を見つけ出すことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10100605,
					"content": "璃月の方が気に入った。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100606
					]
				},
				{
					"id": 10100606,
					"content": "ああ、「神のいる地」には3700年の歴史がある。これは七国の中でも最も古い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100607
					],
					"speakerTitle": "鍾離"
				}
			]
		},
