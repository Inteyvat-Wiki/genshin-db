			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"アファン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732050101,
					"content": "ほれほれ、これらの種を見てくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050102
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732050102,
					"content": "変わりないみたいだけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050103
					]
				},
				{
					"id": 732050103,
					"content": "ああ。わしは長年耕作をやってきたが、花の栽培は耕作とは違うからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050104
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732050104,
					"content": "そうでもなければ、どうしてこんなに長く成長してくれないと言うんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050105
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732050105,
					"content": "どれどれ。えっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732050106,
					"content": "アファンじいちゃん、苗畑が乾燥しすぎてると思うぜ。アアル村の辺りの土じゃ、養分が足りないのかもしれないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732050107,
					"content": "この間、村で花の栽培を手伝ったことがあるから、オイラたち経験者なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732050108,
					"content": "ほう、そうなのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050109
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732050109,
					"content": "一理あるな。こんな珍しい花は、確かに普通の花より繊細かもしれん。水やりや肥料が足りんかったかもしれんな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050110
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732050110,
					"content": "だが…この苗畑は水辺から離れておるから、水汲みには不便でな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050111
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732050111,
					"content": "自分用に蓄えてある生活用水も多くない。苗畑の種に水をやるにはちょっとキツいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050112
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732050112,
					"content": "手伝ってあげる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050113
					]
				},
				{
					"id": 732050113,
					"content": "いいのか。それじゃあ、この三つの種に水やりをしてやってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アファン"
				}
			]
		},
		{
			"id": 7320503,
			"completionStepIds": [
				7320503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
