			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アファン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732050301,
					"content": "いいぞ、いいぞ。いい方法を知ってるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050302
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732050302,
					"content": "お前たちプロの指導があるから、今回はうまくいく予感がするぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050303
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732050303,
					"content": "この間のシャワルマサンドとタフチーンは美味かったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050304,
						732050306
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732050304,
					"content": "美味しかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050305
					]
				},
				{
					"id": 732050305,
					"content": "だったらもっと作ってやろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050307
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732050307,
					"content": "わしの腕は死んだ妻には敵わんが、許せよ。今回は少なくなったが、受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050308
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732050308,
					"content": "美味しかったぞ！アファンじいちゃんって優しいな。これからも見に来るからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732050309,
					"content": "はは、この間も聞いてきたな。これが何の花かって？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050310
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732050310,
					"content": "教えてやってもいいぞ。わしが植えたのは、全部ローズなのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050311
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732050311,
					"content": "スメールローズと同じ花？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050312
					]
				},
				{
					"id": 732050312,
					"content": "この花は「ゴールデンローズ」と言ってな。スメールローズよりずっと珍しい種類の花だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050313
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732050313,
					"content": "この花の種はある友人からもらったと話したのを覚えているのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050314
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732050314,
					"content": "実は、この種も、今住んでいるこの古い家も、死んだ化け爺が残してくれたもんなのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050315
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732050315,
					"content": "おっと、忘れとった。お前たちはアアル村の人間じゃないから、この名前を知らんか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050316
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732050316,
					"content": "知らんでもいい。花を育てることのできた爺さんとして、覚えておいてくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050317
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732050317,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050318
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732050318,
					"content": "急にボーっとしてどうしたんだ？アファンじいちゃん。アファンじいちゃん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050319
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732050319,
					"content": "おっと、気が散ってしもうたな？年を取ると、集中力が鈍るのだ。みっともないところを見せてしまったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050320
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732050320,
					"content": "若造二人には感謝しとるぞ。何か見たいものがあるなら、適当に見て回るといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050321
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732050321,
					"content": "もう追い出しはせん。だが、歩くときは苗畑を荒らさんでくれよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アファン"
				},
				{
					"id": 732050306,
					"content": "まだ食べてない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050307
					]
				}
			]
		},
		{
			"id": 7320504,
