			"dialogs": [
				{
					"id": 732050401,
					"content": "まずはこの三つの種に水をやってくれ。肥料のことはもう少し考える。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050402
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732050402,
					"content": "何十年も経っとるが、簡単な肥料の作り方ならわかるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アファン"
				}
			]
		}
	]
