					"アファン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732040701,
					"content": "ああ、飯はまだなのだ。お構いできなくてすまんな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040702,
						732040703
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732040702,
					"content": "お構いなく。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040704
					]
				},
				{
					"id": 732040704,
					"content": "もう一人のチビ助はお前の友人なんだろう。可愛い子供だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040705
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732040705,
					"content": "植えた花が咲いたら、見に来てくれるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040706
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732040706,
					"content": "もちろん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040707
					]
				},
				{
					"id": 732040707,
					"content": "もうしばらくすれば咲くはずだ。お前たち、自分が育てた花を見に来るんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040708
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732040708,
					"content": "いいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040709
					]
				},
				{
					"id": 732040709,
					"content": "うん、わかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040710
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732040710,
					"content": "…♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アファン"
				},
				{
					"id": 732040703,
					"content": "お腹はすいていない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040704
					]
				}
			]
		},
		{
			"id": 7320501,
			"completionStepIds": [
				7320501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
