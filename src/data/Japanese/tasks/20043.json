			"dialogs": [
				{
					"id": 200430501,
					"content": "夕暮れの実は見つけた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430502
					],
					"speakerTitle": "クイン"
				},
				{
					"id": 200430502,
					"content": "見つけた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430503
					]
				},
				{
					"id": 200430503,
					"content": "ありがとう、これでユーリさんの分は足りるはずだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430504
					],
					"speakerTitle": "クイン"
				},
				{
					"id": 200430504,
					"content": "はあ、しかしお客さんが大分帰ってしまったな。やっぱ一人は少しキツイな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430505
					],
					"speakerTitle": "クイン"
				},
				{
					"id": 200430505,
					"content": "あっ、そうだ、手伝ってくれてありがとう。お礼はね、少し待ってて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430506
					],
					"speakerTitle": "クイン"
				},
				{
					"id": 200430506,
					"content": "お礼はいらないよ。それより、お願いしたいことがあるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430507
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 200430507,
					"content": "ミシェルに関して…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430508
					]
				},
				{
					"id": 200430508,
					"content": "ミシェルさん…彼女に会ったの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430509
					],
					"speakerTitle": "クイン"
				},
				{
					"id": 200430509,
					"content": "もっと楽な仕事を与えてほしい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430510
					],
					"speakerTitle": "クイン"
				},
				{
					"id": 200430510,
					"content": "でも最初から店番だけやってもらう予定だったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430511
					],
					"speakerTitle": "クイン"
				},
				{
					"id": 200430511,
					"content": "そ、そうなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430512
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 200430512,
					"content": "でも今お客さんたちはもう帰ったし、店番ももう必要ないだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430513
					],
					"speakerTitle": "クイン"
				},
				{
					"id": 200430513,
					"content": "帰って休んでと、ミシェルさんに伝えてくれないかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430514
					],
					"speakerTitle": "クイン"
				},
				{
					"id": 200430514,
					"content": "俺も届いてない荷物の確認をしないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "クイン"
				}
			]
		},
