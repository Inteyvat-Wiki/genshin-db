			"dialogs": [
				{
					"id": 200430301,
					"content": "まずいよ、なんでまだ来てないんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430302
					],
					"speakerTitle": "クイン"
				},
				{
					"id": 200430302,
					"content": "何があったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430303
					]
				},
				{
					"id": 200430303,
					"content": "あっ…夕暮れの実が品切れになってて、注文したけどまだ届いてないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430304
					],
					"speakerTitle": "クイン"
				},
				{
					"id": 200430304,
					"content": "お客さんが待ってるのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430305
					],
					"speakerTitle": "クイン"
				},
				{
					"id": 200430305,
					"content": "ユーリさん、もう3回も来たのに。彼女は<color=#00E1FFFF>夕暮れの実が三つ</color>だけあればいいと言っていたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430306
					],
					"speakerTitle": "クイン"
				},
				{
					"id": 200430306,
					"content": "なんとかしてあげたいけど店も見ないといけないし…誰か夕暮れの実を取ってきてくれたらいいのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430307,
						200430309
					],
					"speakerTitle": "クイン"
				},
				{
					"id": 200430307,
					"content": "急ぎなら、手伝うよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430308
					]
				},
				{
					"id": 200430308,
					"content": "手伝ってくれるの？よかった、ありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "クイン"
				},
				{
					"id": 200430309,
					"content": "ミシェルさんがもうすぐ来るよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430310
					]
				},
				{
					"id": 200430310,
					"content": "待って！ミシェルはもうあんな感じだぞ、果物を取りにいけるわけないよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 200430311,
					"content": "オイラたちで手伝おう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
