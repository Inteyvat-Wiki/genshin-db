			"dialogs": [
				{
					"id": 200430601,
					"content": "クインに聞いてきたかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430602
					],
					"speakerTitle": "ミシェル"
				},
				{
					"id": 200430602,
					"content": "帰って休むようにと言った。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430603
					]
				},
				{
					"id": 200430603,
					"content": "クインの店は大丈夫だから、帰ってちゃんと休んでな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 200430604,
					"content": "そう…ふう、他の仕事を探さないとね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430605
					],
					"speakerTitle": "ミシェル"
				},
				{
					"id": 200430605,
					"content": "えっ！？休まないのか？せっかく仕事しなくて済んだのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430606
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 200430606,
					"content": "周りを見て、バルバトス様の風はまだ働いてるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430607
					],
					"speakerTitle": "ミシェル"
				},
				{
					"id": 200430607,
					"content": "彼のご加護を受けてる私たちがサボるわけにはいかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430608
					],
					"speakerTitle": "ミシェル"
				},
				{
					"id": 200430608,
					"content": "そういえば君は何してたの？汗だくじゃない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430609
					],
					"speakerTitle": "ミシェル"
				},
				{
					"id": 200430609,
					"content": "君も忙しい人のようだね、いいと思うよ。努力の汗があると、よりバルバトス様の風を感じられるからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430610
					],
					"speakerTitle": "ミシェル"
				},
				{
					"id": 200430610,
					"content": "さあ、この牛乳を君にあげるよ。飲んだらまた頑張ろう！仕事には終わりがないからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ミシェル"
				}
			]
		},
