			"dialogs": [
				{
					"id": 200430101,
					"content": "腰がいたたたっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430102
					],
					"speakerTitle": "ミシェル"
				},
				{
					"id": 200430102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430103
					]
				},
				{
					"id": 200430103,
					"content": "仕事に行こうとしたけど、急に腰が痛み出して。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430104
					],
					"speakerTitle": "ミシェル"
				},
				{
					"id": 200430104,
					"content": "店を手伝うってクインと約束したけど、どうやら少し休まないといけないみたい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430105
					],
					"speakerTitle": "ミシェル"
				},
				{
					"id": 200430105,
					"content": "しかしここにいるだけだとどうにもならないよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430106
					],
					"speakerTitle": "ミシェル"
				},
				{
					"id": 200430106,
					"content": "何をしてほしいかクインに聞いてきてくれないかな？準備しておきたいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430107,
						200430109
					],
					"speakerTitle": "ミシェル"
				},
				{
					"id": 200430107,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430108
					]
				},
				{
					"id": 200430108,
					"content": "お願いね、私は少し休めば治るはずだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ミシェル"
				},
				{
					"id": 200430109,
					"content": "そんなに遠くないと思うけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430110
					]
				},
				{
					"id": 200430110,
					"content": "だから手伝ってくれたっていいじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
