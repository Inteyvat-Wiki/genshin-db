			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ブレッソン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 746690101,
					"content": "ブレッソン、自分を信じろ…信じるんだ。機材はもう全部そろってる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690102
					],
					"speakerTitle": "ブレッソン"
				},
				{
					"id": 746690102,
					"content": "ただ…ふぅ…水に入って…水中で機材の信頼性を証明しさえすれば、ボクは成功に一歩踏み出せる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690103
					],
					"speakerTitle": "ブレッソン"
				},
				{
					"id": 746690103,
					"content": "何してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746690104
					]
				},
				{
					"id": 746690104,
					"content": "うわっ！どっから出てきたんですか？全然気づきませんでした！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690105
					],
					"speakerTitle": "ブレッソン"
				},
				{
					"id": 746690105,
					"content": "驚きのあまり、あやうく水の中に落ちるところでした…もしボクが踏み留まれてなかったら、フォンテーヌの撮影技術に未来はなかったですよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690106,
						746690107
					],
					"speakerTitle": "ブレッソン"
				},
				{
					"id": 746690106,
					"content": "ごめん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746690108
					]
				},
				{
					"id": 746690108,
					"content": "あれ、もしかして泳げないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746690109,
					"content": "見たところ、フォンテーヌ人みたいだけど？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746690110
					]
				},
				{
					"id": 746690110,
					"content": "フォ…フォンテーヌ人なら絶対に泳げないといけないんですか？璃月人なら料理ができて、モンド人なら詩が作れるとでも？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690111
					],
					"speakerTitle": "ブレッソン"
				},
				{
					"id": 746690111,
					"content": "とにかく、今はあなたと話してる暇はありません。やっとのことで潜水器具を借りられたんですから、今日は絶対に水の中を撮影しないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690112
					],
					"speakerTitle": "ブレッソン"
				},
				{
					"id": 746690112,
					"content": "なるほど、そういうことだったのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746690113,
					"content": "その写真機って、特別なところがあるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746690114
					]
				},
				{
					"id": 746690114,
					"content": "特別なところ？これは、このブレッソン·カティが自ら改造したものです。「特別なところ」といえば、そこでしょうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690115
					],
					"speakerTitle": "ブレッソン"
				},
				{
					"id": 746690115,
					"content": "ボクの改造は精巧かつ絶妙——使った材料もすべて最上級のものです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690131
					],
					"speakerTitle": "ブレッソン"
				},
				{
					"id": 746690131,
					"content": "レンズは他の写真機よりも遥かに高品質で、水中で撮影しても画質はきれいなままですよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690116
					],
					"speakerTitle": "ブレッソン"
				},
				{
					"id": 746690116,
					"content": "でも、協会のやつらは…ボクの最新技術に見向きもしませんでした。写真は撮影者の腕がすべてだ、機材は重要じゃないって言うんです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690117
					],
					"speakerTitle": "ブレッソン"
				},
				{
					"id": 746690117,
					"content": "だから、ボクが見事なまでにきれいな写真を撮って、撮影機材の重要性に疎いやつらを黙らせてやるんです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690118
					],
					"speakerTitle": "ブレッソン"
				},
				{
					"id": 746690118,
					"content": "ふぅ…ブレッソン、自分を信じろ…信じるんだ…水は適温、水中に人食い魚もいない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690119
					],
					"speakerTitle": "ブレッソン"
				},
				{
					"id": 746690119,
					"content": "い…いや…でも！この潜水服、本当に使えるのか？水の底で急に破れたりしないよな！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690120
					],
					"speakerTitle": "ブレッソン"
				},
				{
					"id": 746690120,
					"content": "暗流に巻き込まれて底のほうに沈んだら、誰が助けてくれる？ひ、ひぃ、どうしたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690121,
						746690122
					],
					"speakerTitle": "ブレッソン"
				},
				{
					"id": 746690121,
					"content": "どうしてもできないなら、手伝うけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746690123
					]
				},
				{
					"id": 746690123,
					"content": "ほ、本当に手伝ってくれるんですか？なんと心が広くて、優しい方なんだ。まさに、あなたはボクの救いの神です！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690124,
						746690125
					],
					"speakerTitle": "ブレッソン"
				},
				{
					"id": 746690124,
					"content": "報酬はちゃんといただくけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746690126
					]
				},
				{
					"id": 746690126,
					"content": "もちろんタダ働きはさせません。報酬はたんと弾みますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690127
					],
					"speakerTitle": "ブレッソン"
				},
				{
					"id": 746690127,
					"content": "そうだ、水底に景色のいいところがいくつかあるので、それを地図上にマークしましょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690128
					],
					"speakerTitle": "ブレッソン"
				},
				{
					"id": 746690128,
					"content": "あと地上にもあります。えっと、確かこの付近なのですが…新しい機材なもので、いろいろな場所でテストしないといけないんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690129
					],
					"speakerTitle": "ブレッソン"
				},
				{
					"id": 746690129,
					"content": "よし、これでオッケー。フォンテーヌの撮影技術とボクの撮影機材の事業がどう転ぶかは、あなたの肩にかかっていますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690130
					],
					"speakerTitle": "ブレッソン"
				},
				{
					"id": 746690130,
					"content": "ボクは…えっと…地上で待っていますので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ブレッソン"
				},
				{
					"id": 746690125,
					"content": "でも、報酬は協会の規定通りでお願い。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746690126
					]
				},
				{
					"id": 746690122,
					"content": "なんなら…代わりに水中を撮影しようか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746690123
					]
				},
				{
					"id": 746690107,
					"content": "そこまで大げさに反応すると思わなくて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746690108
					]
				}
			]
		}
	]
}