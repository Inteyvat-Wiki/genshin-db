			"dialogs": [
				{
					"id": 751480101,
					"content": "龍に選ばれし者よ、ああ、龍に選ばれし者よ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751480102,
					"content": "冠の頂に登り、聖山の炎に飛び込め！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751480103,
					"content": "黄金の印を、億万の余燼の炎を解き放て！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751480104,
					"content": "キュウ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480105
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751480105,
					"content": "どうしたんだ？また変なものでも見たのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480106,
						751480107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751480106,
					"content": "なんか…だんだんはっきりしてきてる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751480108
					]
				},
				{
					"id": 751480108,
					"content": "うーん、火山に近づいたからか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751480109,
					"content": "キュイ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751480110,
					"content": "…話しかけてくるやつは、火山の中に居るのかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751480111,
					"content": "でも、火山に近づいてまた「あれ」が見えたってことは、道は間違ってないよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751480112,
					"content": "キュイ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751480107,
					"content": "なんか…どんどん近づいてる気がする…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751480108
					]
				}
			]
		},
