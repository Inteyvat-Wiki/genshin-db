			"dialogs": [
				{
					"id": 751480201,
					"content": "えっ、今のって、ク、クク竜か？彫像はやっぱりクク竜が盗んでたんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751480202,
					"content": "おい待て…あの彫像を持ったまま飛び降りたのか？火口に？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751480203,
					"content": "あれが火口か…壮観だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751480204,
					"content": "うーん、火口には大量の気体燃素が集まってるとか言ってたよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751480205,
					"content": "そうだ！<color=#00E1FFFF>気体燃素を突破する</color>なら…さっきのクク竜みたいにすればいいのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751480206,
					"content": "うぅ、でも、めちゃくちゃ高いぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480207,
						751480210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751480207,
					"content": "大丈夫、しっかり抱きしめとくから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751480208
					]
				},
				{
					"id": 751480208,
					"content": "キュイ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480209
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751480209,
					"content": "えっ、おまえも抱きしめてくれるのか？…わ、わかった。それならちょっと怖くなくなってきたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751480214,
					"content": "高いだけじゃないんだ、気体燃素もあるんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480215
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751480215,
					"content": "とにかく、準備ができたら早速行こうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751480210,
					"content": "着地の瞬間にパイモンが引っ張ってよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751480211
					]
				},
				{
					"id": 751480211,
					"content": "んなこと無理に決まってるだろ！そもそもオイラにそんな力ないし！大体、着地の瞬間っていつだよ！？そんなタイミング、掴めるわけないじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751480212,
					"content": "キュイ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480213
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751480213,
					"content": "おまえまでオイラをからかうのか。はあ…気が抜けるなあ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480214
					],
					"speakerTitle": "パイモン"
				}
			]
