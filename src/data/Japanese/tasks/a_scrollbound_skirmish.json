				"points": []
			},
			"dialogs": [
				{
					"id": 755100101,
					"content": "「仮面闘士」は「調停者」みたいに自由に飛べないけど、タイミングを見計らって突撃すれば、きっと勝てるはず！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100102
					],
					"speakerTitle": "「ナッツ」"
				},
				{
					"id": 755100102,
					"content": "バカだな。どんなに突撃が速くたって、曲がれないんじゃ当たるわけない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100103
					],
					"speakerTitle": "「燃える積み木」"
				},
				{
					"id": 755100103,
					"content": "はい、そこまで。議論するのはいいけど、喧嘩はダメよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100104
					],
					"speakerTitle": "ヴィジェ"
				},
				{
					"id": 755100104,
					"content": "け、喧嘩してるわけじゃないよ。強い戦士の話でただ盛り上がってただけ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100105
					],
					"speakerTitle": "「燃える積み木」"
				},
				{
					"id": 755100105,
					"content": "うん、心配しないで、ヴィジェお姉ちゃん！誰が強いか、ちゃんと根拠をあげながら議論してるんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100106
					],
					"speakerTitle": "「ナッツ」"
				},
				{
					"id": 755100106,
					"content": "あ、新しい作戦を思いついた。もう一回だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100107
					],
					"speakerTitle": "「燃える積み木」"
				},
				{
					"id": 755100107,
					"content": "いいよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100108,
						755100109
					],
					"speakerTitle": "「ナッツ」"
				},
				{
					"id": 755100108,
					"content": "盛り上がってるね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755100110
					]
				},
				{
					"id": 755100110,
					"content": "見ない顔ね、こんにちは！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100111
					],
					"speakerTitle": "ヴィジェ"
				},
				{
					"id": 755100111,
					"content": "その服装…もしかして旅の途中？なら、仲間ね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100112
					],
					"speakerTitle": "ヴィジェ"
				},
				{
					"id": 755100112,
					"content": "これは「ダイナミック・ウォーベン」って言ってね、あたしが作ったの。よかったら子供たちと一緒に遊んでみない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100113,
						755100114
					],
					"speakerTitle": "ヴィジェ"
				},
				{
					"id": 755100113,
					"content": "「ダイナミック・ウォーベン」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755100115
					]
				},
				{
					"id": 755100115,
					"content": "璃月の紙映影、稲妻の漫画、それからフォンテーヌの映影の技術を組み合わせて作ったゲームよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100116
					],
					"speakerTitle": "ヴィジェ"
				},
				{
					"id": 755100116,
					"content": "地元の有名な戦士をモデルに、新たな物語を生み出せるよう、「クロスオーバーチャレンジ」の要素を取り入れたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100117
					],
					"speakerTitle": "ヴィジェ"
				},
				{
					"id": 755100117,
					"content": "これまでにない、新しい体験になると思うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100118
					],
					"speakerTitle": "ヴィジェ"
				},
				{
					"id": 755100118,
					"content": "試してみる！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755100119
					]
				},
				{
					"id": 755100119,
					"content": "ええ、楽しんでちょうだい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴィジェ"
				},
				{
