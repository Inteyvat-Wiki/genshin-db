						],
						"stepId": 7010206,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ウルバン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701020201,
					"content": "この「牙」について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020202
					]
				},
				{
					"id": 701020202,
					"content": "牙？なんの牙だ？雪山で何か変な物でも拾ったか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020203
					],
					"speakerTitle": "ウルバン"
				},
				{
					"id": 701020203,
					"content": "ん？この牙は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020204
					],
					"speakerTitle": "ウルバン"
				},
				{
					"id": 701020204,
					"content": "ど、どうした？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020205
					]
				},
				{
					"id": 701020205,
					"content": "この牙はなかなか上質なものだ。耐久力もある…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020206
					],
					"speakerTitle": "ウルバン"
				},
				{
					"id": 701020206,
					"content": "それにこの断面…まるで「龍牙」のようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020207
					],
					"speakerTitle": "ウルバン"
				},
				{
					"id": 701020207,
					"content": "龍牙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020208
					]
				},
				{
					"id": 701020208,
					"content": "つまり龍の牙だよ。龍牙で作った武器は非常に鋭くて頑丈だと聞いた…その上、奇妙な力もあるらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020209
					],
					"speakerTitle": "ウルバン"
				},
				{
					"id": 701020209,
					"content": "だが、龍牙はどこにでも見つかる物ではない。伝説の中で龍牙を手に入れ武器を作った者たちは、みんな世界に名を轟かせていた大英雄だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020210
					],
					"speakerTitle": "ウルバン"
				},
				{
					"id": 701020210,
					"content": "ハハハ、巨龍を倒さなければ龍牙も手に入らないんだから、当たり前の話だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020211
					],
					"speakerTitle": "ウルバン"
				},
				{
					"id": 701020211,
					"content": "つまりこれも龍牙なのか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020212
					]
				},
				{
					"id": 701020212,
					"content": "正直に言うと、俺も龍牙を実際に見たことがないから断言はできない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020213
					],
					"speakerTitle": "ウルバン"
				},
				{
					"id": 701020213,
					"content": "ただ、この大きさの「牙」なら巨大な獣の牙には違いないはずだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020214
					],
					"speakerTitle": "ウルバン"
				},
				{
					"id": 701020214,
					"content": "お前が苦労して持って帰って来た「牙」なんだから、貴重な「龍牙」だと思うことにしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020215
					],
					"speakerTitle": "ウルバン"
				},
				{
					"id": 701020215,
					"content": "ふむ…だが1つでは武器を作るのに足りないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020216
					],
					"speakerTitle": "ウルバン"
				},
				{
					"id": 701020216,
					"content": "このような「牙」をあと…3つ探してきてくれ。俺もこいつの加工方法を調べてみるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020217
					],
					"speakerTitle": "ウルバン"
				},
				{
					"id": 701020217,
					"content": "そうだ、<color=#00E1FFFF>「牙」</color>以外にも、質のいい鉱石もあった方がいいだろう…",
