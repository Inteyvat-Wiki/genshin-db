			"dialogs": [
				{
					"id": 701020102,
					"content": "この「牙」について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020103
					]
				},
				{
					"id": 701020103,
					"content": "牙？ちょっと見せて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020104
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701020104,
					"content": "うん…この形と大きさ、確かに普通じゃないね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020105
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701020105,
					"content": "私はこの類いのものにあまり詳しくないけど…武器を作るために数多くの材料を見てきたウルバンなら、何か知っているかもしれないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020106
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701020106,
					"content": "彼に見てもらうといいわよ。この近くにいるから、すぐに見つかるはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玉霞"
				}
			]
		},
		{
			"id": 7010202,
			"completionStepIds": [
				7010207
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
