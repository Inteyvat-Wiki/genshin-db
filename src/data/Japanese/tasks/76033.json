			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"食べ物にこだわる亡霊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760330201,
					"content": "うん、中に挟んだソーセージは美味しく出来ているな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330202
					],
					"speakerTitle": "食べ物にこだわる亡霊"
				},
				{
					"id": 760330202,
					"content": "そのへんのレストランでなら、料理人の助手が十分務まるレベルだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330203
					],
					"speakerTitle": "食べ物にこだわる亡霊"
				},
				{
					"id": 760330203,
					"content": "しかし！私たちはライトキーパーに料理を提供するんだ。大事なのは料理の見た目じゃなくて、ボリュームだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330204
					],
					"speakerTitle": "食べ物にこだわる亡霊"
				},
				{
					"id": 760330204,
					"content": "パンは分厚く、野菜はもっと種類を増やしたほうがいい。それと、ソーセージ以外にも肉を加えたほうがいいだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330205
					],
					"speakerTitle": "食べ物にこだわる亡霊"
				},
				{
					"id": 760330205,
					"content": "まだ練習が必要だな。今度はベリーとお肉のソテーを試してみろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "食べ物にこだわる亡霊"
				}
			]
		},
		{
			"id": 7603303,
			"completionStepIds": [
				7603306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7603306",
							"2"
						],
						"stepId": 7603306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"食べ物にこだわる亡霊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760330301,
					"content": "肉はかなり分厚く切ってあるな。そして中までしっかり焼き上がっている…なかなかの出来だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330302
					],
					"speakerTitle": "食べ物にこだわる亡霊"
				},
				{
					"id": 760330302,
					"content": "だが、一つ覚えておいてほしい。ソテーを作るときは、付け合せにも気を配る必要がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330303
					],
					"speakerTitle": "食べ物にこだわる亡霊"
				},
				{
					"id": 760330303,
					"content": "肉は食べ続けていると、すぐに飽きが来る。だからベリーを添えるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330304
					],
					"speakerTitle": "食べ物にこだわる亡霊"
				},
				{
					"id": 760330304,
					"content": "この島にいるみんなの食事や健康を管理するのが私たちの仕事だ。野菜と肉のバランスには気を付けるように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330305
					],
					"speakerTitle": "食べ物にこだわる亡霊"
				},
				{
					"id": 760330305,
					"content": "ダメだな、このソテーは付け合せが少なすぎる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330306
					],
					"speakerTitle": "食べ物にこだわる亡霊"
				},
				{
					"id": 760330306,
					"content": "まだ練習が必要だな。今度は鳥肉のホワイトベリー漬け焼きを試してみろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "食べ物にこだわる亡霊"
				}
			]
		},
		{
			"id": 7603304,
			"completionStepIds": [
				7603308
			],
