			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"食べ物にこだわる亡霊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760330401,
					"content": "鶏肉はしっかり味が染み込んでいて、付け合せも十分だ。ほとんど言うことはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330402
					],
					"speakerTitle": "食べ物にこだわる亡霊"
				},
				{
					"id": 760330402,
					"content": "まあ、それでいい。別に文句を言うために、君たち新人を見張ってるいわけじゃないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330403
					],
					"speakerTitle": "食べ物にこだわる亡霊"
				},
				{
					"id": 760330403,
					"content": "私はただの料理人だ。料理人の仕事をこなすのみ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330404
					],
					"speakerTitle": "食べ物にこだわる亡霊"
				},
				{
					"id": 760330404,
					"content": "万が一、ワイルドハントの襲来があっても大丈夫なように、ちゃんと下準備もしてある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330405
					],
					"speakerTitle": "食べ物にこだわる亡霊"
				},
				{
					"id": 760330405,
					"content": "だが残念なことに、出来上がった料理をみんなに届けることはできなかった…遅すぎたんだ…料理はこぼれて…こぼれて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "食べ物にこだわる亡霊"
				}
			]
		}
