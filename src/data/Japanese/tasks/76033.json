			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"食べ物にこだわる亡霊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760330101,
					"content": "おい、新人、そんな料理じゃだめだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330102
					],
					"speakerTitle": "食べ物にこだわる亡霊"
				},
				{
					"id": 760330102,
					"content": "私たちが作る料理は、島にいるライトキーパーたちに提供するものだ。彼らの好みに合わせて作る必要がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330103
					],
					"speakerTitle": "食べ物にこだわる亡霊"
				},
				{
					"id": 760330103,
					"content": "ここにあるのは全部ダメだ。焼き加減が足りないし、私たちの基準を満たしていない。作り直さないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330104
					],
					"speakerTitle": "食べ物にこだわる亡霊"
				},
				{
					"id": 760330104,
					"content": "君はまだ練習が必要だ。ナド・クライのローカル料理から始めるといい。ナド・クライ・ホットドッグとかな。作ったら見せに来い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "食べ物にこだわる亡霊"
				}
			]
		},
		{
			"id": 7603302,
			"completionStepIds": [
				7603304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
