			},
			"dialogs": [
				{
					"id": 766530301,
					"content": "ようやく来てくれましたね、アイノ…さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530302
					],
					"speakerTitle": "サリーン"
				},
				{
					"id": 766530302,
					"content": "#ん？かの有名な{NICKNAME}さんと、そのお仲間の精霊じゃありませんか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530303
					],
					"speakerTitle": "サリーン"
				},
				{
					"id": 766530303,
					"content": "オイラたちを知ってるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766530304,
					"content": "私はサリーン、ナド・クライ冒険者協会の支部長です。冒険者協会でこれほど評判になっているお二人を私が知らなかったら、職務怠慢ですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530305
					],
					"speakerTitle": "サリーン"
				},
				{
					"id": 766530305,
					"content": "おお、そうだったのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766530306,
					"content": "二人のことを知ってるんだ。でも念のため確認するけど…どれがキミの依頼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530307
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 766530307,
					"content": "オイラも気になるぞ。冒険者協会がアイノに依頼するなんて、どんな内容なんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766530308,
					"content": "はぁ…冒険者にとって野外における最も大きな問題といえば、道を邪魔する様々な敵です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530309
					],
					"speakerTitle": "サリーン"
				},
				{
					"id": 766530309,
					"content": "他の国では、協会が現地の管理者と協力して、冒険者のために色々と保護措置とかを取れるのですが…ナド・クライのような場所では、協会自身で何とかするしかありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530310
					],
					"speakerTitle": "サリーン"
				},
				{
					"id": 766530310,
					"content": "そこで、先日とあるアイデアを思いついたんです——持ち歩き出来る護身用装置を作れば、戦闘が苦手な冒険者でも強敵を撃退できるようになるのではないかと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530311
					],
					"speakerTitle": "サリーン"
				},
				{
					"id": 766530311,
					"content": "ですが、失敗してしまいました…私にはこういった才能がないので、プロに助けを求めるしかありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530312
					],
					"speakerTitle": "サリーン"
				},
				{
					"id": 766530312,
					"content": "あっ、思い出した！いいアイデアだけど、設計がちょっとアレだよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530313
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 766530313,
					"content": "だから、アイノ…さんに頼もうと思ったんです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530314
					],
					"speakerTitle": "サリーン"
				},
				{
					"id": 766530314,
					"content": "今回の問題は、この人が設計した護身用装置は他の国の技術を使っていて、ナド・クライのクーヴァキ環境に適応できない、ってところだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530315
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 766530315,
					"content": "でも、この装置を作ること自体は難しくないよ。何種類かの敵でテストして、改良すればいいだけの話だから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530316
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 766530316,
					"content": "ついでに、クーヴァキ環境に関するデータもテスト時に集められるからお得だね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530317
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 766530317,
					"content": "でも、敵を倒せる実力がないとテスターは務まらないよ。万が一、この装置が役に立たなかったときは、自分でなんとかしなきゃいけないからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530318,
						766530319
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 766530318,
					"content": "それなら大丈夫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766530320
					]
				},
				{
					"id": 766530320,
					"content": "では、皆さんよろしくお願いします。必要なことがあれば、遠慮なく言ってください。成功したら、必ずナド・クライ冒険者協会から豪華な報酬をお支払いします！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "サリーン"
				},
				{
					"id": 766530319,
					"content": "戦闘だいすき！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766530320
					]
				}
			]
		}
	]
}