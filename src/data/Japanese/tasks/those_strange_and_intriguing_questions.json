			"dialogs": [
				{
					"id": 402040201,
					"content": "どうだ、「わくわくドンパチ大冒険」に参加してみるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040202
					],
					"speakerTitle": "ダルビッシュ"
				},
				{
					"id": 402040202,
					"content": "うん、今すぐ始めよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402040203
					]
				},
				{
					"id": 402040203,
					"content": "よし。じゃ、マップと盤面を用意しよう…",
					"roleType": "TALK_ROLE_NPC",
