				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ファダウェイ",
					"アターシェ",
					"ダルビッシュ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 402040101,
					"content": "アターシェ、いい加減にしなさいよ…！またひっどいレポート出して！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040102
					],
					"speakerTitle": "ファダウェイ"
				},
				{
					"id": 402040102,
					"content": "「可能性がある」とか、「おそらく」とか、「だいたい」とか、そんなんでどうやって数理モデルを構築できるって言うのよ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040103
					],
					"speakerTitle": "ファダウェイ"
				},
				{
					"id": 402040103,
					"content": "だ、だって…時間が足りなかったんだ。だいたい、妙論派の僕がキノコンやらなんやらの受ける影響の測り方なんて分かりっこないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040104
					],
					"speakerTitle": "アターシェ"
				},
				{
					"id": 402040104,
					"content": "い、いったいどうすればよかったんだよ。手を口の中に突っ込んで噛ませてから、「驚異的な咬合力」とかって記録すればよかったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040105
					],
					"speakerTitle": "アターシェ"
				},
				{
					"id": 402040105,
					"content": "ダルビッシュ、生論派としてなんとか言ってやってよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040106
					],
					"speakerTitle": "アターシェ"
				},
				{
					"id": 402040106,
					"content": "ははっ、じゃ、ちょっと言わせてもらうけど…アターシェ、君は基礎が弱すぎるんじゃないか？ほとんどのキノコンは口がないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040107
					],
					"speakerTitle": "ダルビッシュ"
				},
				{
					"id": 402040107,
					"content": "ほらね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040108
					],
					"speakerTitle": "ファダウェイ"
				},
				{
					"id": 402040108,
					"content": "だけどファダウェイ、今回はそんなに厳密な数理モデルは必要ないはずだ。院内の教員たちに見せるための課題ってわけでもないし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040109
					],
					"speakerTitle": "ダルビッシュ"
				},
				{
					"id": 402040109,
					"content": "子供向けなんだから…面白さが大事だ。想像力も必要になる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040110
					],
					"speakerTitle": "ダルビッシュ"
				},
				{
					"id": 402040110,
					"content": "わ…わかったわ。先輩がそう言うなら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040111
					],
					"speakerTitle": "ファダウェイ"
				},
				{
					"id": 402040111,
					"content": "おい、ファダウェイ、ダルビッシュと僕への態度が違いすぎるだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040112
					],
					"speakerTitle": "アターシェ"
				},
				{
					"id": 402040112,
					"content": "まあまあ。こっちの資料はだいたい揃った。アターシェの結論にも目を通してある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040113
					],
					"speakerTitle": "ダルビッシュ"
				},
				{
					"id": 402040113,
					"content": "データはテストの結果を見ながら調整すればいい…そのためのテストだ。だろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040114
					],
					"speakerTitle": "ダルビッシュ"
				},
				{
					"id": 402040114,
					"content": "さすがダルビッシュ先輩…理路整然としてる。誰かさんとは全然違うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040115
					],
					"speakerTitle": "ファダウェイ"
				},
				{
					"id": 402040115,
					"content": "はいはい、「誰かさん」が誰なのかは聞かないでおくよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040116
					],
					"speakerTitle": "アターシェ"
				},
				{
					"id": 402040116,
					"content": "ほら、最終段階の準備を始めよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040117
					],
					"speakerTitle": "ダルビッシュ"
				},
				{
					"id": 402040117,
					"content": "はい！先輩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040118
					],
					"speakerTitle": "ファダウェイ"
				},
				{
					"id": 402040118,
					"content": "僕も絵の具が乾いたか見てこよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040119
					],
					"speakerTitle": "アターシェ"
				},
				{
					"id": 402040119,
					"content": "ここからテストの参加者を探さないといけないんだけど…そこの君たち、やってみないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040120
					],
					"speakerTitle": "ダルビッシュ"
				},
				{
					"id": 402040120,
					"content": "さっきからそこで見てたんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040121
					],
					"speakerTitle": "ダルビッシュ"
				},
				{
					"id": 402040121,
					"content": "えっ、オイラたちが？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402040122,
					"content": "そう、君たち。テストに参加すれば、新鮮な果物が食べ放題だ。どうかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040123,
						402040125
					],
					"speakerTitle": "ダルビッシュ"
				},
				{
					"id": 402040123,
					"content": "新しい品種の果物のテストってこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402040124
					]
				},
				{
					"id": 402040124,
					"content": "いや、そうだな…どこから説明すればいいのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040130
					],
					"speakerTitle": "ダルビッシュ"
				},
				{
					"id": 402040130,
					"content": "まず質問だ——スライディングタックルができるボヨヨン炎キノコンとリシュボラン虎が戦ったら、どっちが勝つと思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040131,
						402040134,
						402040137
					],
					"speakerTitle": "ダルビッシュ"
				},
				{
					"id": 402040131,
					"content": "スライディングタックルができるボヨヨン炎キノコン…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402040132
					]
				},
				{
					"id": 402040132,
					"content": "オイラはリシュボラン虎の方が強いと思うけどな。だって、いかつい爪があるだろ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040133
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402040133,
					"content": "ってか、変な質問すぎないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040140
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402040140,
					"content": "まだあるぞ。プカプカ風キノコンと風スライム、それから、エルマイト旅団とナタの竜武士となら、どっちが強いと思う？海乱鬼も出たな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040141
					],
					"speakerTitle": "ダルビッシュ"
				},
				{
					"id": 402040141,
					"content": "どれも、子供たちに授業してたとき聞かれたことなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040142
					],
					"speakerTitle": "ダルビッシュ"
				},
				{
					"id": 402040142,
					"content": "子供はそういうのに興味津々だもんな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040143
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402040143,
					"content": "ハハッ、でも、子供たちの好奇心こそ教育の要だろう？これは、その好奇心に応えるために作ったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040144
					],
					"speakerTitle": "ダルビッシュ"
				},
				{
					"id": 402040144,
					"content": "本格的な「演習」をもとに作った「わくわくドンパチ大冒険」だ。子供たちが仲間を集め、冒険チームを組んで敵と戦うんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040145
					],
					"speakerTitle": "ダルビッシュ"
				},
				{
					"id": 402040145,
					"content": "それで、アターシェには食事や生活環境が魔物に与える影響の調査を、ファダウェイには「模擬育成」のモデル製作を手伝ってもらっている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040146
					],
					"speakerTitle": "ダルビッシュ"
				},
				{
					"id": 402040146,
					"content": "模擬育成？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402040147
					]
				},
				{
					"id": 402040147,
					"content": "ああ、子供たちを本物のキノコンやエルマイト旅団と戦わせるわけにはいかないだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040148
					],
					"speakerTitle": "ダルビッシュ"
				},
				{
					"id": 402040148,
					"content": "もし時間があったら、テストに参加してみないか？テストも研究の一部だ。数をこなせば、立派な経歴になるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040149
					],
					"speakerTitle": "ダルビッシュ"
				},
				{
					"id": 402040149,
					"content": "#たしかに悪くない話だよな、{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040150
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402040150,
					"content": "パイモン、そのうち賢者になれるかも！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402040151
					]
				},
				{
					"id": 402040151,
					"content": "ふんっ、オイラを舐めるなよ。今もすごいけど、もっともっとすごくなってみせるんだからな！よし、参加で決まりだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040152
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402040152,
					"content": "#歓迎するよ、{NICKNAME}、そして未来の賢者パイモン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040153
					],
					"speakerTitle": "ダルビッシュ"
				},
				{
					"id": 402040153,
					"content": "準備ができたら声をかけてくれ。「模擬育成」のルールもちゃんと説明するよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ダルビッシュ"
				},
				{
					"id": 402040134,
					"content": "リシュボラン虎に決まってる！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402040135
					]
				},
				{
					"id": 402040135,
					"content": "うんうん、オイラもそう思うぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040136
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402040136,
					"content": "ってか、変な質問すぎないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040140
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402040137,
					"content": "スライディングができるリシュボラン虎！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402040138
					]
				},
				{
					"id": 402040138,
					"content": "どんな虎だよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040139
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402040139,
					"content": "ってか、変な質問だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040140
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402040125,
					"content": "喧嘩なら興味あるけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402040126
					]
				},
				{
					"id": 402040126,
					"content": "おい、それじゃオイラたちが変人みたいだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402040127,
					"content": "とりあえず、どんなテストか聞いてみようぜ。新鮮な果物…じゃなくて、こいつらの研究がちょっと気になるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402040128,
					"content": "そちらの小さな白いレディーは興味を持ってくれてるみたいだね…その好奇心なら、きっと今までの旅でも幸運に恵まれてたに違いない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040129
					],
					"speakerTitle": "ダルビッシュ"
				},
				{
					"id": 402040129,
					"content": "じゃあ俺たちの研究について紹介しよう…どこから話せばいいかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040130
					],
					"speakerTitle": "ダルビッシュ"
				}
			]
		},
		{
