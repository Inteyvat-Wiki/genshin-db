				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"モリィ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741510101,
					"content": "#{M#お兄ちゃんにお姉ちゃん}{F#お姉ちゃんたち}、来てくれたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510102
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741510102,
					"content": "#オイラはパイモン、こっちは{NICKNAME}っていうんだ。これからは名前で呼んでくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741510103,
					"content": "モリィはブノワさんに会いに来たの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510104
					]
				},
				{
					"id": 741510104,
					"content": "うん、でもルロワさんとは話せなくて…はぁ、これじゃあ作文が書けないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510105
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741510105,
					"content": "作文？ああ、そういえばモリィは宿題のために良いことをしてるんだったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741510106,
					"content": "違うよ。あたしはもともとブノワさんが大好きなの。あの人はその…うーんと…エビカツ？そう、話がエビカツだから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510107
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741510107,
					"content": "ぷっ、なに言ってんだよ。それを言うなら「円滑」だろ。まぁ人付き合いが上手ってことか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741510108,
					"content": "パイモンお姉ちゃん、なんとかできないかな？このままじゃ、作文が書けないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510109
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741510109,
					"content": "作文に、ルロワさんのお手伝いで猫にエサやりしたことを書いたんだ。そしたら、家庭教師の先生に「ソポクポクで、身近な出来事をちゃんと書けてる」から続きを書くよう言われたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510110
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741510110,
					"content": "「ソポクポク」ってなんだよ、「素朴」だろ。ああ、だからブノワじいちゃんの家の前まで来てたんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741510111,
					"content": "宿題のためもあるけど、ルロワさんも本当に好きなの！けどこの前、ルロワさんがパパとママによろしくって言ってたから伝えたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510112
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741510112,
					"content": "パパもママもブノワさんの名前を聞いた途端、ムスッとして、もう行くなっていうの。なんでか分からないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510113
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741510113,
					"content": "でも、モリィの作文を書くなら簡単だろ？前回みたいに、猫のエサやりを手伝えばいいじゃんか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741510114,
					"content": "それじゃあ、一行しか書けないよ。少なすぎてダメだと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510115
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741510115,
					"content": "#{M#俺}{F#私}たちも一緒にやるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510116
					]
				},
				{
					"id": 741510116,
					"content": "そうそう、前みたいにな。おまえが猫にエサをやって、オイラたちは玄関と裏口を掃除しよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741510117,
					"content": "終わったら、一緒にドアをノックしてブノワじいちゃんと話そうぜ。そしたら、なにかしら書く内容ができると思うぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741510118,
					"content": "そっか、そうする！パイモンお姉ちゃんは頭がいいね。じゃあ、さっそくナナにエサをやりに行こう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "モリィ"
				}
			]
		},
		{
			"id": 7415103,
			"completionStepIds": [
				7415103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
