			},
			"dialogs": [
				{
					"id": 741500501,
					"content": "お義父さん、最近睡眠のほうはいかがです？まだ眠れませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500502
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741500502,
					"content": "ずいぶんよくなった。近ごろは悪夢もほとんど見ない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500503
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741500503,
					"content": "（ルロワ一家の会話は次第に聞こえなくなった）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "たたく"
				}
			]
		},
		{
			"id": 7415101,
			"completionStepIds": [
				7415101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7415101",
							"2"
