					},
					{
						"sceneId": 3,
						"position": [
							3591.538,
							435.092,
							4530.267
						],
						"pointId": 7521
					}
				]
			},
			"dialogs": [
				{
					"id": 741510501,
					"content": "前に会ったアトーズが玄関のドアを開けて、出てきた。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741510502
					]
				},
				{
					"id": 741510502,
					"content": "また君たちか。いったい何の用だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510503
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741510503,
					"content": "その…ブノワじいちゃんはいるか？病気だって聞いたから、具合はどうかなって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741510504,
					"content": "義父は家にいるが、体調が悪いんだ。客人に会うにもこの状態では都合が悪い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510505
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741510505,
					"content": "どんな病気か教えてくれる？パパとママに手伝ってもらって、ルロワさんに薬を渡すこともできるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510506
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741510506,
					"content": "その必要はない。薬はこちらで買いに行ける。まして義父は薬に困ってるわけじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510507
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741510507,
					"content": "オイラたちはただ病人を心配してるだけなのに、なんでそんなに冷たいんだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510508
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741510508,
					"content": "（このアトーズってやつ、絶対にブノワじいちゃんに会わせないつもりみたいだ！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510509,
						741510510
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741510509,
					"content": "（ちょっと冷たすぎる…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510511
					]
				},
				{
					"id": 741510511,
					"content": "他人のことだというのにお節介を焼きすぎだ。それで、他に用事は？なければ戻らせてもらうよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510512
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741510512,
					"content": "ちょっと待って。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510513
					]
				},
				{
					"id": 741510513,
					"content": "何か他に用でも？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510514,
						741510516
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741510514,
					"content": "ブノワさんは本当に病気なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510515
					]
				},
				{
					"id": 741510515,
					"content": "もちろんだ。重い病気だが、僕とモルティシアで何とかしようと考えているところさ。この点は他人が心配するには及ばない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510518
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741510518,
					"content": "アトーズ、外で何を騒いでいるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510519
					],
					"speakerTitle": "モルティシア"
				},
				{
					"id": 741510519,
					"content": "何でもないよ、モルティシア。お義父さんの見舞いがしたいと言って子供たちが来ていてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510520
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741510520,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510521
					],
					"speakerTitle": "モルティシア"
				},
				{
					"id": 741510521,
					"content": "お父さんは本当に子供に人気があるのね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510522
					],
					"speakerTitle": "モルティシア"
				},
				{
					"id": 741510522,
					"content": "会いたいって言う子供がいるんだから、出てきて挨拶したら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510523
					],
					"speakerTitle": "モルティシア"
				},
				{
					"id": 741510523,
					"content": "…行っても…いいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510524
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741510524,
					"content": "もちろんよ、お父さんの好きにして。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510525
					],
					"speakerTitle": "モルティシア"
				},
				{
					"id": 741510525,
					"content": "扉が開いて、ブノワが家の中からゆっくりと出てきた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741510526
					]
				},
				{
					"id": 741510526,
					"content": "小さなお客さんたち、また来たのかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510527
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741510527,
					"content": "ルロワさん、大丈夫？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510528
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741510528,
					"content": "わしかい？…ゴホゴホ、体調はあまりよくないな。でも心配しなくていい。がんばって治そうとしているところだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510529
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741510529,
					"content": "娘と娘婿がよくしてくれているから、何も心配いらないさ。さあ、お家に帰りなさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510530
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741510530,
					"content": "お義父さん、お体は大丈夫ですか？辛かったら、家に入っていてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510531
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741510531,
					"content": "ブノワはアトーズの目を見ると、黙って家の中に入った。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741510532
					]
				},
				{
					"id": 741510532,
					"content": "さて、見ただろう？義父は体の調子が本当に悪いんだ。これで満足したかな？用がなければこれで失礼するよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510533
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741510533,
					"content": "オイラたちは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510534
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741510534,
					"content": "アトーズはあなたたちに目もくれなかった。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741510535
					]
				},
				{
					"id": 741510535,
					"content": "今日はルロワさんとちょっとお話ができて良かった。はぁ、早く元気になってほしいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510536
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741510536,
					"content": "パイモンお姉ちゃん、あたし人に迷惑をかけちゃったみたい。そんなことしたくなかったんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510537
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741510537,
					"content": "なんでそう思うんだ？モリィは人に迷惑なんかかけてないぞ。オイラに言わせれば、問題があるのはあのアトーズのほうだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510538
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741510538,
					"content": "フン…なんなんだアイツ、最初から最後まで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510539,
						741510540
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741510539,
					"content": "モリィはひとまずお家に帰って。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510541
					]
				},
				{
					"id": 741510541,
					"content": "#えっ、{NICKNAME}、なんでだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510542
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741510542,
					"content": "うん、じゃあそろそろ帰るね。パパとママはここに来てほしくないみたいだし…今日どこに行ってたか知られたら、怒られちゃうかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510543
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741510543,
					"content": "ルロワさんにまた会えるかなぁ。お菓子がとってもおいしかったって伝えたいのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510544
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741510544,
					"content": "#ルロワさんの具合が良くなって、もし{M#お兄ちゃんとお姉ちゃん}{F#お姉ちゃんたち}が会えたら、代わりに伝えてもらえる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510545,
						741510546
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741510545,
					"content": "いいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510547
					]
				},
				{
					"id": 741510547,
					"content": "おう、オイラも約束するぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510548
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741510548,
					"content": "#よかった。ありがとう、{NICKNAME}{M#お兄ちゃん}{F#お姉ちゃん}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510549
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741510549,
					"content": "#じゃあ、お家に帰るね。{M#お兄ちゃんにお姉ちゃん}{F#お姉ちゃんたち}、バイバイ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510550
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741510550,
					"content": "#{NICKNAME}、なにか思いついたのか？さっきからなにか言いたそうに見えるけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510551,
						741510552
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741510551,
					"content": "あっちに行って話そう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510553
					]
				},
				{
					"id": 741510553,
					"content": "わかった、じゃあ場所を変えて話そうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741510552,
					"content": "ここで大声で言わないで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510553
					]
				},
				{
					"id": 741510546,
					"content": "約束する。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510547
					]
				},
				{
					"id": 741510540,
					"content": "#{M#俺}{F#私}とパイモンも帰るから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510541
					]
				},
				{
					"id": 741510516,
					"content": "どうしてブノワさんに会わせてくれないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510517
					]
				},
				{
					"id": 741510517,
					"content": "どうして無関係の人の見舞いを許可しないといけないんだ？言っただろう、義父は体調が悪くて、客人に会うのは不都合だと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510518
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741510510,
					"content": "（急に冷たくなった…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510511
					]
				}
			]
		},
