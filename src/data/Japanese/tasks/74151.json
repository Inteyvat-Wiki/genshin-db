			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"モリィ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741510301,
					"content": "#パイモンお姉ちゃん、{NICKNAME}{M#お兄ちゃん}{F#お姉ちゃん}、ナナにエサをあげたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510302
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741510302,
					"content": "よし、じゃあ一緒にドアをノックしてブノワじいちゃんを呼ぼうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741510303,
					"content": "でもちょっと心配だな…出てきてくれるかな？この前もルロワさんに会いに来たけど、何も話せなかったし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510304
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741510304,
					"content": "それに実はさっきドアをノックしたんだ。そしたら、出てきてはくれたけど、すぐあのコワいおムコのおじさんに戻されちゃったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510305
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741510305,
					"content": "コワいおじさんはキャンディをくれて、パパとママのいるお家に帰りなさいって言って、ドアを閉めちゃった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510306
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741510306,
					"content": "ブノワじいちゃんは親切なのに、なんで家族はそんなに冷たいんだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741510307,
					"content": "おムコのおじさんは、ルロワさんは病気だから都合が悪いって言うんだ。けど、あたしの見る限り元気だと思うの。どうして、あたしと話してくれないんだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510308
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741510308,
					"content": "パイモンお姉ちゃん、あたし作文が書けなくたっていい。だって、ルロワさんのほうがもっと心配だから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510309
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741510309,
					"content": "病気だとしたら、きっとつらいよね。ママは誰かが病気になるとかわいそうだって言うよ。病気の人をもっと気づかってあげなきゃって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510310
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741510310,
					"content": "一緒におムコのおじさんに聞いてもらえる？ルロワさんはどんな病気なのかって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510311
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741510311,
					"content": "ケーキを食べすぎたのかな？それともお布団をかけずに寝ちゃったのかな？家に帰って、パパとママにどうしたらいいか聞いてみるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510312,
						741510313
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741510312,
					"content": "一緒にドアをノックしてみよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510314
					]
				},
				{
					"id": 741510314,
					"content": "実は…おムコのおじさんのことがちょっと苦手なんだ。代わりに話をしてくれる？すごく怖いんだもん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510315
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741510315,
					"content": "おう、怖がらなくていいぞ、モリィ。オイラたちが代わりに聞いてやるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741510313,
					"content": "もともとそういう約束だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510314
					]
				}
			]
		},
