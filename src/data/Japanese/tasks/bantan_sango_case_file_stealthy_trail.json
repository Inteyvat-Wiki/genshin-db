			"trigger": {
				"objectNames": [
					"龍二"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400320101,
					"content": "来ましたか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320102
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320102,
					"content": "手がかりは見つけた？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320103
					]
				},
				{
					"id": 400320103,
					"content": "はい。今回は珊瑚所長のおかげで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320104
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320104,
					"content": "所長の「演繹」によって、いくつかの場所を特定できました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320105
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320105,
					"content": "現状、昨日の「笠かぶり犬」が守っている拠点がまだあるので、特に注意して対処する必要があります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320106
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320106,
					"content": "パイモンがつけそうなあだ名。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320107
					]
				},
				{
					"id": 400320107,
					"content": "おい！オイラはそんなあだ名つけないぞ！オイラだったら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400320108,
					"content": "えっと——「刀持ち犬」だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400320109,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320110
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320110,
					"content": "とにかく、そこに同じ装置を配置しました。効果があるといいのですが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320111
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320111,
					"content": "うぅ…無視するなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400320112,
					"content": "では、頼みましたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320113
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320113,
					"content": "他に質問はありますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320114
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320114,
					"content": "場所の情報は確かなの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320115
					]
				},
				{
					"id": 400320115,
					"content": "はい、問題ありません。すでに現場に行って調査済みです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320116
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320116,
					"content": "じゃあ、なんで龍二は今回、オイラたちと一緒に行かないんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400320117,
					"content": "一緒に行きたいのはやまやまですが、あいにく今日は珊瑚所長から他の任務を任されています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320118
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320118,
					"content": "簡単に言うと、所長は「笠かぶり犬」について少々考えがあるようです。ですので、その調査を頼まれました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320119
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320119,
					"content": "「刀持ち犬」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400320120,
					"content": "「笠かぶり犬」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320121,
						400320124
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320121,
					"content": "「笠付き刀犬」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320122
					]
				},
				{
					"id": 400320122,
					"content": "変なあだ名ですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320123
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320123,
					"content": "なんだそのあだ名、変だぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400320125,
					"content": "…もういいです。いっそ「黒い影」と呼びましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320126
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320126,
					"content": "何はともあれ、動物たちのことは頼みましたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320124,
					"content": "もうやめよう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320125
					]
				}
			]
		},
		{
			"id": 4003203,
			"completionStepIds": [
				4003203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003203",
							"2"
						],
						"stepId": 4003203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"龍二"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400320301,
					"content": "お疲れ様です。確認します…やはり数が合いませんね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320302
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320302,
					"content": "そんなに多くの動物が失踪したのか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400320303,
					"content": "はい。依頼の数から見て、すでに大半の動物は見つけることができましたが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320304
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320304,
					"content": "残念ながら、これ以上の手がかりはありません。ただ、生物は物体よりも調査が簡単なので、それほど心配する必要もないでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320305
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320305,
					"content": "以前にも、お金持ちの家で発生した盗難を調査したことがありました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320306
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320306,
					"content": "一度は手がかりが途絶えましたが、珊瑚所長の推理のおかげで、解決することができました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320307,
						400320325
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320307,
					"content": "具体的に話してくれる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320308
					]
				},
				{
					"id": 400320308,
					"content": "面白そうだな、詳しく教えてくれよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400320309,
					"content": "探偵業にも興味があったんですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320310
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320310,
					"content": "実は当時、すでに容疑者を特定していました。ただ、その容疑者の家宅からは盗品が見つからず、他の手がかりもありませんでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320311
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320311,
					"content": "しかしある日、外で調査をしていた時、容疑者が前日に鳴草を売っていたことが判明したんです。買い手にその鳴草を見せてもらうと、結構新鮮なものでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320312
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320312,
					"content": "珊瑚所長がそのことを知ると、すぐに私を影向山の調査に向かわせたんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320313
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320313,
					"content": "ん？なんで影向山なんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320314
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400320314,
					"content": "「まず、容疑者は鳴神島に住んでいる。稲妻において鳴草が生えている場所はたくさんあるけど、一般的に言って、他の島に行くには船が必要となる。だけど、私たちはその船を発見していない」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320315
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320315,
					"content": "「それに今、天領奉行は鎖国令によって非常に用心深くなっている。だから容疑者が行動をする時、天領奉行に気づかれないよう慎重になるに違いない」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320316
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320316,
					"content": "「つまり、状況から判断して他の島は選択肢から除外できる」珊瑚所長はそう言っていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320317
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320317,
					"content": "でも鳴神大社の近くにも鳴草ってあるよな？なんで影向山だと思ったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320318
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400320318,
					"content": "その点についても珊瑚所長は考えておりました。「鳴神大社の近くにも鳴草はあるけど、あそこには巫女と参拝する人々がいる」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320319
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320319,
					"content": "「もしおかしな点があったら、他の人たちもきっと気づくはずよ」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320320
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320320,
					"content": "そうだったのか！オイラ、今ならあいつが頭脳派だって信じられるぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320321
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400320321,
					"content": "その後、影向山のふもとで土の塊を見つけたんです。しかもその土が誰かに動かされた痕跡も。きっと、盗品を埋めてから、後で取り出そうとしたのでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320322
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320322,
					"content": "しかし籠を背負って行ったのに、手ぶらで帰るのは疑われると思ったのでしょう。道端にあった鳴草を採集して、戻ってから売ったんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320323
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320323,
					"content": "でもその鳴草が逆に手がかりになった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320324
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400320324,
					"content": "はい。ですので、今回の件も同じように、まだ我々が気づいていない手がかりがあるのかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320327
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320327,
					"content": "こうして一緒に協力できるのは、とてもいいことですね。元々私の特技は隠密行動や戦闘ではなく、使い走りをすることです。それら不得意な分野をあなたに任せられて、とても安心しています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320328
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320328,
					"content": "どうでしょう、「万端珊瑚」に加わってみませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320329
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320329,
					"content": "珊瑚所長は…たしかに少し話しづらい方で、よく「良心は知性の重荷」などと言っていますが、根はとても優しい方なんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320330,
						400320331
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320330,
					"content": "遠慮するよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320332
					]
				},
				{
					"id": 400320332,
					"content": "残念です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320333
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320333,
					"content": "でも確かに、あなたのような有能な方が珊瑚所長のそばにいたら、私は失業してしまうでしょうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320334
					],
					"speakerTitle": "龍二"
