			},
			"dialogs": [
				{
					"id": 746870301,
					"content": "ふぅ、やっと交替ね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870302
					],
					"speakerTitle": "マイン"
				},
				{
					"id": 746870302,
					"content": "あれ？なんであなたたちが？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870303,
						746870307
					],
					"speakerTitle": "マイン"
				},
				{
					"id": 746870303,
					"content": "な、何か問題でも？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870304
					]
				},
				{
					"id": 746870304,
					"content": "オイラたちを知ってるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746870305,
					"content": "ううん、あなたたちはすごく有名だから…大丈夫なはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870306
					],
					"speakerTitle": "マイン"
				},
				{
					"id": 746870306,
					"content": "どんなこともあなたたちに安心して任せられるって、職場でも、村でも、みんな言ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870311
					],
					"speakerTitle": "マイン"
				},
				{
					"id": 746870311,
					"content": "向こうにいる二人も頼りになるけど、なんとなくぎこちない感じがして。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870312
					],
					"speakerTitle": "マイン"
				},
				{
					"id": 746870312,
					"content": "人間の感情ってすごく難しい…少し背中を押してあげたほうがいいのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870313
					],
					"speakerTitle": "マイン"
				},
				{
					"id": 746870313,
					"content": "ぎこちないって？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870314
					]
				},
				{
					"id": 746870314,
					"content": "あ、いえ。まずは仕事仕事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870315
					],
					"speakerTitle": "マイン"
				},
				{
					"id": 746870315,
					"content": "じゃ、お願いね。操作はそんなに難しくないから、あなたたちなら、一気に片付けられるはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マイン"
				},
				{
					"id": 746870307,
					"content": "どこかで会わなかった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870308
					]
				},
				{
					"id": 746870308,
					"content": "覚えてくれてたんだ。前、「シュヴァルマラン映影ランド」にスタッフにとして参加してたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870309
					],
					"speakerTitle": "マイン"
				},
				{
					"id": 746870309,
					"content": "そういえば、なんとなく印象があるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746870310,
					"content": "あなたたちになら、安心して任せられる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870311
					],
					"speakerTitle": "マイン"
				}
			]
		}
	]
}