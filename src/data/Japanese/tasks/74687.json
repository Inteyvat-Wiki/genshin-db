				]
			},
			"dialogs": [
				{
					"id": 746870101,
					"content": "先輩、もう半日も経ってるのに、魔物がちっとも減ってないわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870102
					],
					"speakerTitle": "シェニー"
				},
				{
					"id": 746870102,
					"content": "やっぱり、増援を呼んでくる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870103
					],
					"speakerTitle": "シェニー"
				},
				{
					"id": 746870103,
					"content": "慌てるな。私とあちらの仲間を信じろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870104
					],
					"speakerTitle": "フェルロイス"
				},
				{
					"id": 746870104,
					"content": "敏感に危機を嗅ぎつける冒険者か…あるいは長官が直々に駆けつけてくれるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870105,
						746870106
					],
					"speakerTitle": "フェルロイス"
				},
				{
					"id": 746870105,
					"content": "何か困ってる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870107
					]
				},
				{
					"id": 746870107,
					"content": "噂をすれば…しかも小さな助手付き！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870108
					],
					"speakerTitle": "シェニー"
				},
				{
					"id": 746870108,
					"content": "助かった。さっそくだが、簡単に状況を説明させてくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870109
					],
					"speakerTitle": "フェルロイス"
				},
				{
					"id": 746870109,
					"content": "へへっ、説明なら私がやるから、先輩は休んでて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870110
					],
					"speakerTitle": "シェニー"
				},
				{
					"id": 746870110,
					"content": "…コホン！大砲を思いっきり放ってみたいと思わない？船隊が全滅して以来、ここ数百年の間、そんなことができる場所はどこにもなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870111
					],
					"speakerTitle": "シェニー"
				},
				{
					"id": 746870111,
					"content": "でも、ここでなら特製の弾丸で魔物を一掃できちゃうの。ストレス発散にもなるし、警察隊から賞金までもらえるわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870112
					],
					"speakerTitle": "シェニー"
				},
				{
					"id": 746870112,
					"content": "大砲で魔物を倒すのか…オイラたち、そういうの得意だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870113,
						746870114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746870113,
					"content": "たしかにやれそう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870115
					]
				},
				{
					"id": 746870115,
					"content": "先輩、嬉しいのは分かるけど、今は気を引き締めないと。副隊長には私から説明するわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870116
					],
					"speakerTitle": "シェニー"
				},
				{
					"id": 746870116,
					"content": "このあいだ、この近くの地下で作業してた作業員たちが、偶然遺跡を見つけたの。でも、中に眠ってた魔物を呼び起こしちゃって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870117
					],
					"speakerTitle": "シェニー"
				},
				{
					"id": 746870117,
					"content": "魔物を外に逃がさないように、警察隊は防衛拠点を作ったんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870118
					],
					"speakerTitle": "シェニー"
				},
				{
					"id": 746870118,
					"content": "拠点っていっても、ここにいるのは私と先輩、それからたまたま休暇で遊びに来てたメリュジーヌの警官だけ。改良した砲台だけが武器よ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870119
					],
					"speakerTitle": "シェニー"
				},
				{
					"id": 746870119,
					"content": "えっ！？すごく危なそうだぞ！メリュジーヌは大丈夫なのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746870120,
					"content": "心配するな。直接魔物と戦うわけではない。遺跡の入口に設置された大砲を使えば魔物を殲滅できる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870121
					],
					"speakerTitle": "フェルロイス"
				},
				{
					"id": 746870121,
					"content": "とっても頼もしいけど、プレッシャーの中で長時間任務をこなし続けて、相当疲れが溜まってるんじゃないかと思うの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870122
					],
					"speakerTitle": "シェニー"
				},
				{
					"id": 746870122,
					"content": "それで副隊長、もしよかったら手を貸してもらえないかしら？状況が厳しくなったら、さらに支援を要請するつもりよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870123
					],
					"speakerTitle": "シェニー"
				},
				{
					"id": 746870123,
					"content": "#シェニー、副隊長の実力を知っているだろう？——{M#彼}{F#彼女}が私の砲台を使えば、魔物を一網打尽にするに違いない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870124,
						746870125
					],
					"speakerTitle": "フェルロイス"
				},
				{
					"id": 746870124,
					"content": "試してみたいかも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870126
					]
				},
				{
					"id": 746870126,
					"content": "危機を見て見ぬふりするのは、オイラたちの流儀じゃないからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746870127,
					"content": "助かる——ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870128
					],
					"speakerTitle": "フェルロイス"
				},
				{
					"id": 746870128,
					"content": "前回の実験結果を参考に、いろいろ調整しておいた。存分に活用してくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870129
					],
					"speakerTitle": "フェルロイス"
				},
				{
					"id": 746870129,
					"content": "もし自動で照準を合わせて発射してくれる大砲があったらいいと思わない、先輩？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870130
					],
					"speakerTitle": "シェニー"
				},
				{
					"id": 746870130,
					"content": "いい考えだ！今度、警備ロボの識別モジュールを取り付けてみよう。立派な見張り役になってくれそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870131
					],
					"speakerTitle": "フェルロイス"
				},
				{
					"id": 746870131,
					"content": "さすが先輩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シェニー"
				},
				{
					"id": 746870125,
					"content": "とにかく、力を貸すよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870126
					]
				},
				{
					"id": 746870114,
					"content": "どうして急にそんなことを？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870115
					]
				},
				{
					"id": 746870106,
					"content": "ちょうどいいところに来たかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870107
					]
				}
			]
		},
