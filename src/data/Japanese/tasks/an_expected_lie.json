			"dialogs": [
				{
					"id": 741360401,
					"content": "あいつが「五」を繰り返してたのは、オイラたちにこの謎解きの方法を教えてくれてたからなんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741360402,
					"content": "それならそうと言ってくれればよかったのに。どうしてあんな回りくどい言い方をしたんだろうな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741360403,
					"content": "ハッ、あいつの企みなんか知るか…だが、ずっと俺たちをナッカーと引き合わせようとあいつはしてたみてぇだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360404
					],
					"speakerTitle": "ショシベル"
				},
				{
					"id": 741360404,
					"content": "この潜水服はあの家のそばに置いてあった。まるで俺たちのために用意したみたいに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360405,
						741360406
					],
					"speakerTitle": "ショシベル"
				},
				{
					"id": 741360405,
					"content": "#彼のほうから{M#俺}{F#私}たちを見つけたみたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360407
					]
				},
				{
					"id": 741360407,
					"content": "研究価値がないなんて…わ…私の注いだ心血が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360408
					],
					"speakerTitle": "フュシリエ"
				},
				{
					"id": 741360408,
					"content": "フュシリエのやつ…ずっとブツブツ言ってるな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360409
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741360409,
					"content": "#ところで…{NICKNAME}、ずっと誰かに見られてる気がしないか？オ、オイラ背筋がなんだかゾワゾワするぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360410
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741360410,
					"content": "…俺が先頭を行く。引き続き先に進もう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ショシベル"
				},
				{
					"id": 741360406,
					"content": "とにかく、まずはナッカーをどうにかしよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360407
					]
				}
			]
		},
