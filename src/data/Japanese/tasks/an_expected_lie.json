				"points": []
			},
			"dialogs": [
				{
					"id": 741363401,
					"content": "ふっ…やはり戻ってきたか。ほらな、五周しても見つからなかっただろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363402
					],
					"speakerTitle": "エドウィン·イースティングハウス"
				},
				{
					"id": 741363402,
					"content": "どうだい、座って茶でも飲むか？ちょうどティーカップを五つ…新しいのを買ったばかりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363403
					],
					"speakerTitle": "エドウィン·イースティングハウス"
				},
				{
					"id": 741363403,
					"content": "本当に「五」という数字が好きなんですね、エドウィンさん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363404
					],
					"speakerTitle": "ルマーク"
				},
				{
					"id": 741363404,
					"content": "ああ。不思議な力を持った数字だからね。上手く使えば、インスピレーションの扉を開くことだってできる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363405
					],
					"speakerTitle": "エドウィン·イースティングハウス"
				},
				{
					"id": 741363405,
					"content": "ついでに…インスピレーションの扉は五つあって、ノブは五回まわさないといけない…そう、五だ！分かったか？五回だぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363406
					],
					"speakerTitle": "エドウィン·イースティングハウス"
				},
				{
					"id": 741363406,
					"content": "すみません、いま本気であんたを五回殴りたくなってきました。口を閉じていてください、いいですね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ルマーク"
				}
			]
		}
	]
