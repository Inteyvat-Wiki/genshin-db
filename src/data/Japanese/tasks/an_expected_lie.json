			"dialogs": [
				{
					"id": 741360601,
					"content": "大きな空き地だな、見たところ…なにもない。オイラたちの当てが外れたのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360602
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741360602,
					"content": "この近くの植物はわざわざ手入れしてあった。剪定の痕跡もまだ新しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360603
					],
					"speakerTitle": "ショシベル"
				},
				{
					"id": 741360603,
					"content": "…私、わざわざここまで来たのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360604
					],
					"speakerTitle": "フュシリエ"
				},
				{
					"id": 741360604,
					"content": "とにかく、まずは俺一人で様子を見に行く。おまえたちは科学院の嬢ちゃんと一緒にいろ。最悪の状況になったら…急いで彼女を連れて行け。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360605
					],
					"speakerTitle": "ショシベル"
				},
				{
					"id": 741360605,
					"content": "まぁここには何もない、これ以上悪い状況にはならないだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360606
					],
					"speakerTitle": "ショシベル"
				},
				{
					"id": 741360606,
					"content": "ギィ——ガシャ、ガシャ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360607
					],
					"speakerTitle": "ショシベル"
				},
				{
					"id": 741360607,
					"content": "うわっ！気をつけろ！猛スピードで近づいてくるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
