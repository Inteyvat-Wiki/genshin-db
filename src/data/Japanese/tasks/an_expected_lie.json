			"dialogs": [
				{
					"id": 741360901,
					"content": "ちっ、科学院の犬め！ショワズールとレモンドからいくらもらったんです？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360902,
						741360903
					],
					"speakerTitle": "ナッカー"
				},
				{
					"id": 741360902,
					"content": "称号一つだけだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360904
					]
				},
				{
					"id": 741360904,
					"content": "くっ…放してください、僕のこの「フィールド生成装置」はもうすぐ完成するんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360905
					],
					"speakerTitle": "ナッカー"
				},
				{
					"id": 741360905,
					"content": "アルケウム動力コアをそれと連動させることに成功すれば…僕は誰よりも偉大な運動エネルギーのエンジニアになれます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360906
					],
					"speakerTitle": "ナッカー"
				},
				{
					"id": 741360906,
					"content": "…他人の成果を横取りして、誰よりも偉大なエンジニアだって。本当に厚かましいわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360907
					],
					"speakerTitle": "フュシリエ"
				},
				{
					"id": 741360907,
					"content": "どの道、分かっていたわ。どうしてエドウィン先輩…いやエドウィンさんが、あなたをコア研究に関与させなかったのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360908
					],
					"speakerTitle": "フュシリエ"
				},
				{
					"id": 741360908,
					"content": "エドウィンは、そもそもこれの使い道を理解していませんでした！あなただって科学院の人間だ…こいつの価値を知っているでしょう！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360909
					],
					"speakerTitle": "ナッカー"
				},
				{
					"id": 741360909,
					"content": "協力してくださいよ、僕は…僕はあなたと共同で開発してもいい。そうなれば、僕たちは誰よりも立派な名声を得ることができます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360910
					],
					"speakerTitle": "ナッカー"
				},
				{
					"id": 741360910,
					"content": "あのエドウィンもレモンドも、ショワズールだって…みんな僕たちには敵いません！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360911,
						741360912
					],
					"speakerTitle": "ナッカー"
				},
				{
					"id": 741360911,
					"content": "レモンドの言葉は正しかったみたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360913
					]
				},
				{
					"id": 741360913,
					"content": "エドウィン…さんの成果は科学院に帰属してる。私はただ回収に来ただけ、他のことには…興味ないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360914
					],
					"speakerTitle": "フュシリエ"
				},
				{
					"id": 741360914,
					"content": "フュシリエのやつ…エドウィンに対する呼び方が急に変わったな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360915
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741360915,
					"content": "なんと愚かな！お嬢さん、コンチーニが我々にどれほどの利益をくれるかご存知ないんですね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360916
					],
					"speakerTitle": "ナッカー"
				},
				{
					"id": 741360916,
					"content": "エドウィンの下で一万年使い走りをしても得られないぐらいの利益です！エドウィンも科学院も、僕たちを利用しただけ…僕たち自身のことも考えないと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360917
					],
					"speakerTitle": "ナッカー"
				},
				{
					"id": 741360917,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360918
					],
					"speakerTitle": "フュシリエ"
				},
				{
					"id": 741360918,
					"content": "ああ、そうかい。くだらねぇ話は終わりだ。そろそろ黙ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360919
					],
					"speakerTitle": "ショシベル"
				},
				{
					"id": 741360919,
					"content": "あなた、いったい誰です！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360920
					],
					"speakerTitle": "ナッカー"
				},
				{
					"id": 741360920,
					"content": "ルミドゥースハーバーを守ってる人間だ。その減らず口を閉じねぇと拳を食らわせるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360921
					],
					"speakerTitle": "ショシベル"
				},
				{
					"id": 741360921,
					"content": "#{NICKNAME}、こいつを縛り上げるのを手伝ってくれ。そのコアとやらも持って帰るぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ショシベル"
				},
				{
					"id": 741360912,
					"content": "今までずっと我慢してたんだ、ナッカー。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360913
					]
				},
				{
					"id": 741360903,
					"content": "モラはもらってない、ボランティア。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360904
					]
				}
			]
		},
