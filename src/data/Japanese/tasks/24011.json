			"dialogs": [
				{
					"id": 240111001,
					"content": "紫金オオズグロカモメめ…いったいどれだけ食べたら満足するんだ？永遠にお腹を空かせてるんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111002
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240111002,
					"content": "カモメたちを追い払ってくれてありがとうございます。もう食べ終えたので仕事に戻らないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111003
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240111003,
