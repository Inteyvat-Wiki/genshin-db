				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240111301,
					"content": "ああ、紫金オオズグロカモメさん。このフライドポテトを食べ終えたら、どこかへ行っておくれよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111302,
						240111303
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240111302,
					"content": "最近はどう？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111304
					]
				},
				{
					"id": 240111304,
					"content": "いえ、まったく役に立ちませんでした…紫金オオズグロカモメが僕のフライドポテトに向かって突撃してくると、一目散に私の後ろに隠れて震えていましたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111305
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240111305,
					"content": "まぁ…彼らは悪くありませんよ。犬っていうのは、愛し愛されるというたった一つの責任を持って生まれてきたんですからね…攻撃を仕掛ける方法なんて習っちゃいません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111306
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240111306,
					"content": "#それは{M#俺}{F#私}たちも同じ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111307
					]
				},
				{
					"id": 240111307,
					"content": "そうかもしれませんね。でも場合によっては、愛っていうのは一種の権力にもなり得ます。権力という言葉がついただけで、物事は必ず悪い方向へ突き進むんです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111308
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240111308,
					"content": "おっと、話しすぎましたね。ここ数日感情的な問題に関する事に対処してきたせいで、まだ気持ちが落ち着かなくて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111309
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240111309,
					"content": "ふぅ、当面の急務は無事にこのフライドポテトを食べきること、ですけどね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240111303,
					"content": "犬は役に立った？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111304
					]
				}
			]
		},
