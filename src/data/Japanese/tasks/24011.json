			"dialogs": [
				{
					"id": 240111101,
					"content": "犬でも飼ってみたら？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111102
					]
				},
				{
					"id": 240111102,
					"content": "それって…犬を使って紫金オオズグロカモメを追い払うってことですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111103
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240111103,
					"content": "それはいい考えですね。一匹、お願いできる人がいるかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アイオーヌ"
				}
			]
		},
		{
			"id": 2401112,
