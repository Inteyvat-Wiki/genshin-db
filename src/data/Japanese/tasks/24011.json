					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110402
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240110402,
					"content": "はぁ、でもこれからどうしましょう？毎回あなたに助けていただくわけにはいきませんし…",
