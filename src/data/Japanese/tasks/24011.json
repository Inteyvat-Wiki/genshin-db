					"アイオーヌ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240111201,
					"content": "うーん…場所を変えるとか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111202
					]
				},
				{
					"id": 240111202,
					"content": "他にいい場所が見つからないんですよ。パレ·メルモニアから近すぎると、同僚に出くわすかもしれないし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111203
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240111203,
					"content": "見つかったら無理やり連れていかれて、仕事の話をしながら一緒に食事する羽目になるので…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111204
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240111204,
					"content": "逆にパレ·メルモニアから遠すぎても、昼休憩の時間が終わるまでにオフィスに戻れなくなって、重要な仕事に対処できなくなるかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111205
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240111205,
					"content": "そんな風に色々考えると、一人で静かに食事ができる場所はここしかないんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アイオーヌ"
				}
			]
		},
