			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アイオーヌ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240110101,
					"content": "ああ、紫金オオズグロカモメさん…お腹が空いているんだろうね。でも私もまだお腹いっぱいじゃないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110102
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240110102,
					"content": "まぁいいか。これで喜んでくれるなら、それも悪くない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110103
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240110103,
					"content": "何してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110104
					]
				},
				{
					"id": 240110104,
					"content": "旅人さん？お会いできて嬉しいです。ただ、何かご用でしたら、ちょっと待っててもらえませんか。まだフライドポテトを食べ終わってなくて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110105,
						240110107
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240110105,
					"content": "特に用件はない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110106
					]
				},
				{
					"id": 240110106,
					"content": "そうですか、ならよかった。急いでこのフライドポテトを食べ終わらないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110108
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240110108,
					"content": "これが私の食事なんです。今日はロアルテさんと外回りにも出ないといけないから、早く食事を済ませないといけないんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110109
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240110109,
					"content": "パレ·メルモニアの中で食事をするのはどうも慣れなくて、普段から外で静かな場所を探して、さっさと食事を済ませてるんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110110
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240110110,
					"content": "でも今日は…なぜか紫金オオズグロカモメたちが私のフライドポテトをこぞって奪おうとするんですよ。しかも、いくら食べても満足してくれなくて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110111,
						240110112
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240110111,
					"content": "食べたがってるカモメはまだまだいるから…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110113
					]
				},
				{
					"id": 240110113,
					"content": "それは一理ありますね。でも私だってすべてのカモメたちにあげるわけにはいきませんし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110114
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240110114,
					"content": "っていうかそれ、おまえのフライドポテトなんだろ？無理にあげることないじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 240110115,
					"content": "そんなことしたら、おまえがお腹空いちゃうだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110116,
						240110117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 240110116,
					"content": "何だか元気がないみたいだけど？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110118
					]
				},
				{
					"id": 240110118,
					"content": "えっ？別にそんなことは…いえ、確かにちょっと、そうかもしれません。あなたの目はごまかせませんね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110119
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240110119,
					"content": "よく分からないんです。僕の仕事の意義って何なんだろう…って。共律庭はいつも忙しいけど、これといった成果を出せたわけでもないし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110120
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240110120,
					"content": "誰かを助けたわけでもないし、便宜を図ってあげられたわけでもない。ロアルテさんは、私たちの仕事はとっても大事だって言うんですけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110121
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240110121,
					"content": "毎日タイプライターの前に座ってキーボードをひたすら叩いているだけ。これが何の役に立つっていうんでしょう？なんなら、もう一度キーキャップをなくしたほうが、エスタブレさんに小金を稼がせることもできて、いいんじゃないかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110122
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240110122,
					"content": "すみません、こんな話を…すべてにおいて、方向性がよくわからなくなってしまって。もしかしたら…私にはもっと時間が必要なのかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110123,
						240110124
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240110123,
					"content": "とにかく、ちゃんと食べてから話そう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110125
					]
				},
				{
					"id": 240110125,
					"content": "それもそうですね。でもこの時間じゃ…もうフライドポテトを買い直してる余裕はないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110126
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240110126,
					"content": "仕方ありません。これは全部カモメたちにあげちゃいます。ロアルテさんとの仕事が片付いたら、また何か食べるものを買えばいいんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110127
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240110127,
					"content": "そうだな…えぇと、半日くらいで終わるはずなので、そんなに時間はかかりませんよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110128
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240110128,
					"content": "そんなに長い間飲まず食わずで、ホントに大丈夫なのか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110129,
						240110130
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 240110129,
					"content": "紫金オオズグロカモメのことは任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110131
					]
				},
				{
					"id": 240110131,
					"content": "で、でも…ご迷惑じゃないですか？こんなフライドポテトくらい、別に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110132
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240110132,
					"content": "ちゃんと食べとけって！腹が減っては仕事はできぬってやつだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 240110130,
					"content": "カモメのことは何とかしておくから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110131
					]
				},
				{
					"id": 240110124,
					"content": "まずは、紫金オオズグロカモメを何とかしよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110125
					]
				},
				{
					"id": 240110117,
					"content": "具合が…良くないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110118
					]
				},
				{
					"id": 240110112,
					"content": "奪い損ねたカモメもいっぱいいるからね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110113
					]
				},
				{
					"id": 240110107,
					"content": "なんでこんなところで食べてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110108
					]
				}
			]
		},
