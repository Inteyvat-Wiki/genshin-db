					"nextDialogs": [
						240111402
					]
				},
				{
					"id": 240111402,
					"content": "ぜひ、ただ…できる限り追い払うだけにしてくれませんか？カモメたちはただフライドポテトを食べたいだけで、別に悪意はないんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111403
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240111403,
					"content": "たしかに、僕は被害者だとも言えるでしょう。でも大したことじゃないので…どうか追い払うだけにしてくださいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アイオーヌ"
				}
