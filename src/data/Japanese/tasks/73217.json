					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171101,
					"content": "「セノ先輩が大マハマトラになってから、やることは多くなったが、つまらない学派闘争に巻き込まれることが減って、かえって楽になった気がする。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171102
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732171102,
					"content": "「さもなければ、俺も出張調査の合間を縫ってこんなところでサボれないだろう。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171103
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732171103,
					"content": "「最近はセノ先輩も姿を見かけないし、ここに書いても別にバレやしないよな…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171104
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732171104,
					"content": "「見つけたぞ。明日の午前中までに報告し、しかるべき処分を受けろ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171105
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732171105,
					"content": "「俺の時間を無駄にさせるな。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告知板"
				}
			]
		},
		{
			"id": 7321712,
			"completionStepIds": [
