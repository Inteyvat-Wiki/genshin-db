			"dialogs": [
				{
					"id": 732171801,
					"content": "「当社はドーンマンポートへの航路を開拓しました。当社の果物貿易への同業者の皆さんの加盟をお待ちしています」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171802
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732171802,
					"content": "「待ってくれ。ここからモンドまでの航路で果物を輸入するだなんてありえない。酒の輸入ならまだ興味を引かれるが」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171803
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732171803,
					"content": "「モンドワインの輸入なら誰でも思いつくでしょう。果物の輸入は当社だけの試みです。これはビジネスチャンスだと思いませんか！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171804
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732171804,
					"content": "「それに、必ずしもモンドから仕入れる必要は…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告知板"
				}
			]
		},
