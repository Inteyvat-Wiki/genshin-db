						"stepId": 7321715,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171501,
					"content": "船乗り、乗客、貿易商、内外の市民へ。本港における規則はすべてこの公告に基づくものとする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171502
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732171502,
					"content": "揉め事が起きた際は、治安官シャムまで助けを求めること。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告知板"
				}
			]
		},
		{
			"id": 7321716,
			"completionStepIds": [
				7321716
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321716",
							"2"
						],
						"stepId": 7321716,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171601,
					"content": "「スメールシティでグランドバザールなんかを見るより、オルモス港の旧市街を見たほうが楽しいよ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171602
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732171602,
					"content": "「教令官にあれこれ口出しされて変わり果てたグランドバザールと違って、ここにはまだスメールの特色が色濃く残っている。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171603
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732171603,
					"content": "「もちろん、ダンスを楽しみたいならズバイルシアターだね。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171604
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732171604,
					"content": "「田舎者め。スメールシティの都市計画は学者たちによって綿密に設計されたもの。科学的法則に基づかない町割りなど存在しない」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171605
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732171605,
					"content": "「オルモス港のようなゴミゴミした街並みを宝物のようにありがたがりおって、モノを知らぬ輩もいたものだ！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171606
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732171606,
					"content": "「あーあー聞こえなーい、木のうろが何かしゃべってら！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告知板"
				}
			]
		},
		{
			"id": 7321717,
			"completionStepIds": [
				7321717
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321717",
							"2"
						],
						"stepId": 7321717,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171701,
					"content": "「恥を忍んで書くが、我々は長年商船の点検や修理を生業としてきた職人で、先祖代々伝わる技術で生計を立ててきた。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171702
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732171702,
					"content": "「しかし、少し前からアーカーシャに新技術が公開され、過去の経験がまったく通用しなくなった。若者ならまだアーカーシャで勉強することもできるが、我々のような年寄りは別の職を探すしかない。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171703
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732171703,
					"content": "「書記官さまは我々に海に出てもう一旗揚げろとおっしゃったが、そのための金もないので資金を集めている最中だ。もし何か仕事があれば、ぜひお声がけいただきたい」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171704
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732171704,
					"content": "「書記官の言うことなんて聞かなくていい。ちょうど職人を探しているお得意さんを知っているので紹介しよう。海に出ようなんて考えるな、さあ、このモラを受け取ってくれ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171705
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732171705,
					"content": "「つまらん口出しはするな。成功する者がいれば、落ちぶれる者もいる。それがこの世界の法則だ。どうして自分を善人に仕立て上げ、世界の成り行きに干渉する？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171706
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732171706,
					"content": "「我々の書記官様が、また神秘主義の授業を始めたぞ。どうしてかって？そうすることで幸福になるからだ！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171707
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732171707,
					"content": "「忘れるなよ、助け合いや平等を求める心、それに義憤だって人の世を動かす法則だ、『弱肉強食』なんていうのはただの暴論だ！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171708
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732171708,
					"content": "「勘違いするな。俺は君の言説を否定するつもりはない。だが、君は俺の言ったことをまったく理解できていないようだ。だから、これ以上説明する気はない。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171709
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732171709,
					"content": "「頭に血が上った人間との議論は頭が痛くなる…ところで、ずいぶんと金に余裕があるようだな？まさか、教令院の補助金を全てこんなつまらないことに使っているとは言わないだろうな？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171710
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732171710,
					"content": "「『貧しい者が苦しむのは富める者がいるからだ。だから富める者は広く善財を喜捨すべきである』、賢者ゾルフィカールの言葉だ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171711
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732171711,
					"content": "「彼はそんなことは言っていない。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171712
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732171712,
					"content": "「いいや言った。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171713
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732171713,
					"content": "「言っていない。今月の酒代は自分で払うんだな。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171714
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732171714,
					"content": "「わかった、この議論はやめよう。だが1ヶ月くれ、必ず証明してみせる。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告知板"
				}
			]
		},
		{
			"id": 7321718,
			"completionStepIds": [
				7321718
			],
