			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170701,
					"content": "海獣出没中！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170702
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732170702,
					"content": "最近、海獣の活動が活発化しています。出港する船舶はファーロス灯台の発表する警報情報に注意するか、アーカーシャ経由で事前に海域情報を取得してください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170703
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732170703,
					"content": "質問があれば、灯台守までお問い合わせください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告知板"
				}
			]
		},
		{
			"id": 7321708,
			"completionStepIds": [
				7321708
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321708",
							"2"
						],
						"stepId": 7321708,
						"stateName": "QUEST_STATE_UNFINISHED"
