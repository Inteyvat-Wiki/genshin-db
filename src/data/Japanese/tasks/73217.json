			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170901,
					"content": "「シャープールホテルのサービスは悪くないが、壁が薄すぎる。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170902
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732170902,
					"content": "「オルモス港は物価が安いから、ここに滞在して試験の準備をするつもりだったが…やはりスメールシティに行かなければならないようだ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170903
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732170903,
					"content": "「今年合格できなければ、家に帰って畑を耕すしかない。もしそうなったときは、せめて『豊沃の恵』を持ち帰らないと…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告知板"
				}
			]
		},
		{
			"id": 7321710,
			"completionStepIds": [
				7321710
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321710",
							"2"
						],
						"stepId": 7321710,
						"stateName": "QUEST_STATE_UNFINISHED"
