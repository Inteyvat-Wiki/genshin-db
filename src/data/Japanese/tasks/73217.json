			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170101,
					"content": "こちらはオルモス港の港務管理人が設置した告知板です。オルモス港内外の重要事項がここに掲示されます。質問があればメッセージを残してください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告知板"
				}
			]
		},
		{
			"id": 7321702,
			"completionStepIds": [
				7321702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321702",
							"2"
						],
						"stepId": 7321702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170201,
					"content": "「論文のフォーマットに困っていませんか？まだ論文のテーマが浮かばず苦しんでいませんか？でしたら、誰かに教わるというのはどうでしょう。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170202
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732170202,
					"content": "「こちらは知論派の出身で、素論派、妙論派にも通じています。論文の執筆指導や質疑応答を承ります。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170203
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732170203,
					"content": "「これ以上苦しむ前に、宿屋のアマンディープさんまでご連絡を。価格応相談」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170204
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732170204,
					"content": "「代筆は頼めますか？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170205
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732170205,
					"content": "「それはできない相談です。第一、監察官殿がそんなことは許さないでしょう」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170206
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732170206,
					"content": "「その通り。ズルせず勉学に励むように。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告知板"
				}
			]
		},
		{
			"id": 7321703,
			"completionStepIds": [
				7321703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321703",
							"2"
						],
						"stepId": 7321703,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170301,
					"content": "空飛ぶ魔法を知ってるかい？空飛ぶ人を見たことは？空飛ぶ駄獣に隠された秘密とは？フォンテーヌ飛天サーカス団のスメール初公演をお見逃しなく！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170302
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732170302,
					"content": "世界でここだけのユニークなサーカスがたったの5モラ！さあ、この機会をお見逃しなく！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170303
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732170303,
					"content": "「すごかった。こんなにすごいショーはフォンテーヌでも他に見たことがない！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告知板"
				}
			]
		},
		{
			"id": 7321704,
			"completionStepIds": [
				7321704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321704",
							"2"
						],
						"stepId": 7321704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170401,
					"content": "注意！！スメールにおけるすべての傭兵業は「エルマイト旅団」が独占的に請け負い、例外は存在しない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170402
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732170402,
					"content": "うまい話を信じて、身元不明の輩から仲介料をだまし取られないように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170403
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732170403,
					"content": "ボディガード、守衛、その他の依頼が必要な際は、「三十人団」の駐オルモス港隊長フェローズまで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告知板"
				}
			]
		},
		{
			"id": 7321705,
			"completionStepIds": [
				7321705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321705",
							"2"
						],
						"stepId": 7321705,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170501,
					"content": "本港に入港するすべての船舶は、港務管理人のところで所有者情報や入港理由などの情報を登録すること。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170502
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732170502,
					"content": "商船の場合、積載商品の詳細も登録すること。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170503
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732170503,
					"content": "未登録の商船は荷下ろしや貿易活動を行うことはできず、違反行為が発覚した際は厳罰に処す。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告知板"
				}
			]
		},
		{
			"id": 7321706,
			"completionStepIds": [
				7321706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321706",
							"2"
						],
						"stepId": 7321706,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170601,
					"content": "本港は密輸行為の厳重取り締まり中であり、本港を経由する貨物はすべて登録と検査を受けなければならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170602
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732170602,
					"content": "未登録の貨物、または輸出入禁止の対象に定められた違反品については、すべて没収処分とする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170603
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732170603,
					"content": "なお、これにより発生するあらゆる損害については、すべて自己負担とする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告知板"
				}
			]
		},
		{
			"id": 7321707,
			"completionStepIds": [
				7321707
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
