				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171001,
					"content": "「最近派遣されて来た教令官はますますもって役立たずだ。何を聞いても知らぬ存ぜぬ…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171002
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732171002,
					"content": "「それに今はアーカーシャへの接続権限も解放されているんだから、こんな素人同然の教官よりまだ私の方がものを知っている。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171003
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732171003,
					"content": "「ただ、あのたまに見る書記官さまだけは、この前私たちの船の手配を手伝ってくれた。教令院も完全にバカばかりというわけではなさそうだ」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告知板"
				}
			]
		},
		{
			"id": 7321711,
			"completionStepIds": [
				7321711
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321711",
							"2"
						],
						"stepId": 7321711,
