			"dialogs": [
				{
					"id": 737100101,
					"content": "♪～♪♪～♪～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100102
					],
					"speakerTitle": "ポコポコビーニー"
				},
				{
					"id": 737100102,
					"content": "♫♫～♫～♫♫～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100103
					],
					"speakerTitle": "喜炎"
				},
				{
					"id": 737100103,
					"content": "戻ったぞ、ハニヤー、左右加さん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737100104,
					"content": "ポコポコビーニーと喜炎の楽しげな足音が聞こえて、すぐ帰ってきたって気づいたわ。本当に思う存分楽しめたみたいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100105
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 737100105,
					"content": "足音でわかったんですか？私は足音から感情なんて読めないのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100106
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 737100106,
					"content": "もっと勉強しないとですね…学びに終わりはありませんから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100107
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 737100107,
					"content": "へへっ、今回のお出かけは、確かにいつもと一味違ったぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737100108,
					"content": "キノコンの仲間たちと随分遊んだな。やっと帰ってきたぜ！遊び疲れて腹ペコだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737100109,
					"content": "そうだ！記念撮影しようぜ！有名な旅行記は旅のいろんな写真を時系列に並べてるって、『スチームバード新聞』に書いてあったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737100110,
					"content": "言われてみれば…ここ数年、キノコンの仲間たちと過ごすのが当たり前すぎて、一緒に写真を撮ることなんてほとんどなかったわね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100111
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 737100111,
					"content": "はい！この子たちにとっても、完璧な旅のしめくくりになりそうですね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100112
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 737100112,
					"content": "～♪♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100113
					],
					"speakerTitle": "ポコポコビーニー"
				},
				{
					"id": 737100113,
					"content": "～♫♫",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100114
					],
					"speakerTitle": "喜炎"
				},
				{
					"id": 737100114,
					"content": "よし！それじゃあポコポコビーニーのカメラにスタンドをつけて、タイマーで集合写真を撮ろうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737100115,
					"content": "ハニヤーと左右加さんが忙しくなくなったら、今度はみんなで遊びに行こうな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100147
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737100147,
					"content": "楽しみだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737100116,
					"content": "そういえば、ポコポコビーニーって写真がすごくうまいんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737100117,
					"content": "よく撮れたのを何枚か選んだから、集合写真と一緒にまとめとくぜ。ハニヤーと左右加さんもよかったら見てくれよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100118,
						737100119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737100118,
					"content": "そんなことまで…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100120
					]
				},
				{
					"id": 737100120,
					"content": "それから…ほら、ハニヤーと左右加さんにお土産だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737100121,
					"content": "おまえたちが前食べられなかったマカロンだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737100122,
					"content": "えっ！ちらっと言っただけだったのに、覚えててくれたんですか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100123
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 737100123,
					"content": "「シルバー伴星」…感動したわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100124
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 737100124,
					"content": "こんなことをしてもらわなくてもいいように、旅する時はちゃんと計画を立てて、その通り行動しなくちゃね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100125
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 737100125,
					"content": "仲良く雑談してる時にこそ本音が出るものだからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100126,
						737100127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737100126,
					"content": "いつの間に…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100128
					]
				},
				{
					"id": 737100128,
					"content": "フォンテーヌ廷で写真を撮ってた時だぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100129
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737100129,
					"content": "おまえがポコポコビーニーと景色を見てる間に、新聞売りの子供にちょっとお駄賃を渡して、買って来てもらったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100130
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737100130,
					"content": "安心しろ！もちろん、おまえの分もちゃーんと用意してあるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100131
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737100131,
					"content": "新聞売りの子にも、店に着いたら真っ先におまえの好きなフレーバーを探してくれって頼んだんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100132
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737100132,
					"content": "まあ、オイラたちはフォンテーヌ廷のスイーツを全部食べちゃってるから、新鮮味はそこまでないかもだけどな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100133,
						737100134
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737100133,
					"content": "パイモンが買ってくれたなら何でも最高！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100135
					]
				},
				{
					"id": 737100135,
					"content": "ホントか？へへっ…じゃあ、これからはもっといっぱい買ってやるぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100136
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737100136,
					"content": "キノコンの仲間たちのためのおやつがないのが残念だな…キノコンを抱っこしながら、一緒にごちそうを食べたかったぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100137
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737100137,
					"content": "その点は心配しないで。私がいま執筆中の『キノコン概論』では、キノコンの好む食べ物を基礎から研究してるところなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100138
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 737100138,
					"content": "キノコンも人間も食べられるようなものを探して、仲間たちが一年中「マーベラスゼリー」ばかり食べ続けなくても済むようにすることが目標よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100139
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 737100139,
					"content": "いつか必ず、両方の舌を満足させられる食材を見つけ出して、絶品料理を作ってみせるわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100140
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 737100140,
					"content": "実際の調理は、私が担当します！…十一個目の鍋を焦がされるのは阻止したいですからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100141
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 737100141,
					"content": "それって、キノコンの仲間たちと一緒の食卓でご飯を食べられる日は、そう遠くないってことだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100142,
						737100143
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737100142,
					"content": "朗報を待ってるよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100144
					]
				},
				{
					"id": 737100144,
					"content": "とにかく、いつでも「ちびチエキノコンの森」に遊びに来てね。私たちもキノコンの仲間たちも、待ってるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100145
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 737100145,
					"content": "はい。もしかしたら、予想よりもずっと早くサプライズをお届けできるかもしれません！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100146
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 737100146,
					"content": "♪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ポコポコビーニー"
				},
				{
					"id": 737100143,
					"content": "左右加の手料理、楽しみ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100144
					]
				},
				{
					"id": 737100134,
					"content": "パイモンが買ってくれたんだから、特別！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100135
					]
				},
				{
					"id": 737100127,
					"content": "全然気づかなかった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100128
					]
				},
				{
					"id": 737100119,
					"content": "パイモン、気が利くね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100120
					]
				}
			]
		}
	]
}