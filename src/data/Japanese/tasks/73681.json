			"dialogs": [
				{
					"id": 736810101,
					"content": "旅人にパイモンじゃないか。「豊穣の箱」を探すイベントに参加したと聞いたが、どうだい。面白かったかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736810102
					],
					"speakerTitle": "ベルンハルト"
				},
				{
					"id": 736810102,
					"content": "結構面白かったぞ！ブリーズブリュー祭の間って、ブリューフェアがやってるからなのか分からないけど、色んな装飾をいっぱいゲットしたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736810103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736810103,
					"content": "はは、確かにそういうのをプレゼントにする人も多いかもね。そうだ。せっかくちょうど出店してるんだし、それを使ってここをデコレーションしてみないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736810104
					],
					"speakerTitle": "ベルンハルト"
				},
				{
					"id": 736810104,
					"content": "ショップをキレイに飾り付ければ、お客さんの目をもっと引けるようになるはずだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736810105
					],
					"speakerTitle": "ベルンハルト"
				},
				{
					"id": 736810105,
					"content": "それに、プレゼントした人だって、自分の贈ったものが旅人のショップに飾られてると知ったら、きっと喜ぶだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736810106
					],
					"speakerTitle": "ベルンハルト"
				},
				{
					"id": 736810106,
					"content": "確かにそうだな！それじゃさっそくオイラたちのショップを飾ってみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
}