					"ゴロー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120200101,
					"content": "お前がいなかったら、あいつらを逃すところだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200102
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 120200102,
					"content": "その手にあるのが心海の虎の巻なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120200103,
					"content": "どれどれ…うわっ！こんなにぶ厚いのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120200104,
					"content": "実は…これはまだ一部でしかない。あと5冊もある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200105
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 120200105,
					"content": "そんなに！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120200106,
					"content": "珊瑚宮様はあらゆる状況に応じた戦略を考えている。それにこれらは「常備用の虎の巻」だ、少し多いのも仕方ないこと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200107
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 120200107,
					"content": "この虎の巻のおかげで、俺たちはあらゆる複雑な状況に対応できている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200108
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 120200108,
					"content": "こんなにたくさんの策、どんだけ時間をかけて書いたんだ…あらゆる状況に対応できるようにするなんて、考えただけで頭がクラクラするぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120200109,
					"content": "隊長！今回せっかく海祇島に戻ってきたんですし、もう一度メカジキ二番隊の指揮を取りませんか？僕たちみんな隊長に戻ってきて欲しいと思っているんです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200110,
						120200111
					],
					"speakerTitle": "幸徳"
				},
				{
					"id": 120200110,
					"content": "メカジキ二番隊はまだあるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120200112
					]
				},
				{
					"id": 120200112,
					"content": "今は平和な時期ですので、隊の数を減らして民の暮らしを手伝う必要があると珊瑚宮様はおっしゃっていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200113
					],
					"speakerTitle": "幸徳"
				},
				{
					"id": 120200113,
					"content": "約半分の兵士は「特別行動隊」の編成を維持し、各小隊の支援をしています。そしてもう半分は見回り、建造、農業などの作業を行っています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200114
					],
					"speakerTitle": "幸徳"
				},
				{
					"id": 120200114,
					"content": "ただ先日、昔の同僚が家なんか建てるよりも前線で戦っていたいと文句を言っていたので、隊への復帰を望んでいるようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200115
					],
					"speakerTitle": "幸徳"
				},
				{
					"id": 120200115,
					"content": "抵抗軍のみんなは相変わらずだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120200116,
					"content": "あっ、そういえば、オイラたちがここに来たのは、心海が祝賀会に誘ってくれたからなんだ。ゴロー、心海がどこにいるか知ってるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120200117,
					"content": "珊瑚宮様なら、今はたぶん望瀧村にいる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200118
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 120200118,
					"content": "あそこで何かあったらしい、珊瑚宮様が直々に対処しているそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200119
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 120200119,
					"content": "#俺たちもそろそろ離れよう…そうだ。{NICKNAME}、もし道中で兵士たちを見かけたら、注意深く観察しておいてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200120
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 120200120,
					"content": "近頃、兵士たちに落ち着きがない。何故かは知らないが、その理由を俺に話したくないようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200121
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 120200121,
					"content": "昔はみんな悩みがあれば俺に言っていたのに、なんであんなこそこそと…何か厄介なことがあったのかもしれない、心配だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200122,
						120200123
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 120200122,
					"content": "気にかけておく。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120200124
					]
				},
				{
					"id": 120200124,
					"content": "そうだな、オイラたちも抵抗軍の兵士たちと話がしたかったんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120200125,
					"content": "#出発しようぜ、{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120200123,
					"content": "昔の仲間にも会えるからちょうどいい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120200124
					]
				},
				{
					"id": 120200111,
					"content": "みんなどうしてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120200112
					]
				}
			]
		},
		{
			"id": 1202002,
