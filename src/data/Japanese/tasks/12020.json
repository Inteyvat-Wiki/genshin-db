				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ゴロー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120200601,
					"content": "ここが心海と約束した場所だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200602
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120200602,
					"content": "旅人、ここのこと覚えてるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200603
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120200603,
					"content": "このまえ海祇島に来た時、ここを通ったことがあるだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120200604,
					"content": "あの時、おまえは「メカジキ二番隊」の隊長になってたよな。もうあれからだいぶ時間が経ってるから、抵抗軍の兵士たちがまだおまえのことを忘れてないといいんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200605
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120200605,
					"content": "海祇島もきっと、大きく変わってると思うぞ！近くを見て回ろうぜ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200627
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120200627,
					"content": "あれ、ゴローじゃないか？行ってみよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200606
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120200606,
					"content": "「敵がこちらより多ければ、突破を求むべし。敵がこちらより少なければ、完勝を求むべし…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200607
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 120200607,
					"content": "「海辺の敵、輸送船あり。船を燃やせば、勝利をもたらさん…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200608
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 120200608,
					"content": "ゴロー様、結論は出ましたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200609
					],
					"speakerTitle": "利彦"
				},
				{
					"id": 120200609,
					"content": "ああ。珊瑚宮様の残した虎の巻をもとに推測すると、ファデュイの船が近くに停泊しているのが分かる。だからこそファデュイのヤツらも、あんなに付け上がっているんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200610
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 120200610,
					"content": "二手に分かれよう。一隊がヤツらの注意を引き、もう一隊がその隙に後ろから回り込んでヤツらの船を燃やす。そうすればきっとヤツらも逃げられまい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200611
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 120200611,
					"content": "いや、しかし珊瑚宮様は、兵力が不足している状況では兵を分断するなとも言っていた。つけ入る隙を与え、総崩れを招いてしまうと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200612
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 120200612,
					"content": "では救援を呼びましょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200613
					],
					"speakerTitle": "幸徳"
				},
				{
					"id": 120200613,
					"content": "それでは間に合わない。ヤツらの動向を見るに、もうここを離れる準備が済んでいるんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200614
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 120200614,
					"content": "珊瑚宮様の虎の巻には、「外での作戦は、急ぐべからず」とも書かれてあった。兵力が足りない以上、今回は一旦あきらめるしかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200615
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 120200615,
					"content": "では、あいつらをこのまま逃すというのですか？そんなの、納得できません！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200616
					],
					"speakerTitle": "利彦"
				},
				{
					"id": 120200616,
					"content": "実は、珊瑚宮様の虎の巻にはもう一言書いてある。「窮地に陥りし時、援軍が現れん」。だが、いまいち意味が分からない、援軍とはいったい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200617
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 120200617,
					"content": "ゴロー、ここでなにやってんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200618
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120200618,
					"content": "隊長！海祇島に戻っていたんですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200619
					],
					"speakerTitle": "幸徳"
				},
				{
					"id": 120200619,
					"content": "力を貸しに来た。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120200620
					]
				},
				{
					"id": 120200620,
					"content": "#助かった！やはり珊瑚宮様の虎の巻に間違いはなかったようだ…{NICKNAME}、ちょうどいい時に来てくれた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200621
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 120200621,
					"content": "近頃、ファデュイの残党どもに異常な動きが見られてな。それで今回、俺たちはヤツらの動向を探り、事前にここで待ち伏せをしていたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200622
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 120200622,
					"content": "だが、こちらには兵を二手に分けられるような人数がいない…悪いが、注意を引き付ける役を任せられないだろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200623
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 120200623,
					"content": "わかった！ファデュイがまたなにか悪さをしようとしてるのかもしれない。オイラたちも放っておけないぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200624
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120200624,
					"content": "よし！事は急を要する。俺たちは後ろからヤツらの船を燃やす、その後、また落ち合おう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200625
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 120200625,
					"content": "油断するなよ。俺たちも終わり次第すぐ戻る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200626
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 120200626,
					"content": "どうやら、抵抗軍のみんなはまだオイラたちのことを覚えてくれてたみたいだな！あいつらの手助けができるよう、オイラたちも頑張ろうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
