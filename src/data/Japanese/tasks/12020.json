				"points": []
			},
			"dialogs": [
				{
					"id": 120200401,
					"content": "はぁ、和平交渉に同意するなんて、珊瑚宮様はいったい何を考えてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200402
					],
					"speakerTitle": "嘉久"
				},
				{
					"id": 120200402,
					"content": "ああ…天領奉行のヤツらはまったく信用できない。ヤツら、秘密裏にファデュイと結託して俺たちと引き続き戦争しようとしてるらしいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200403
					],
					"speakerTitle": "恒雄"
				},
				{
					"id": 120200403,
					"content": "本当か？それは確かなんだろうな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200404
					],
					"speakerTitle": "嘉久"
				},
				{
					"id": 120200404,
					"content": "もちろん本当のことだ。俺たちの仲間がファデュイと対峙した時、陰謀を企ててるヤツらを見たそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200405
					],
					"speakerTitle": "恒雄"
				},
				{
					"id": 120200405,
					"content": "やっぱりそうだったのか。天領奉行のヤツら、未だに邪な心を…珊瑚宮様はやはり甘い、ヤツらを簡単に信じるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200406
					],
					"speakerTitle": "嘉久"
				},
				{
					"id": 120200406,
					"content": "シーッ、静かに。誰か来る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200407
					],
					"speakerTitle": "恒雄"
				},
				{
					"id": 120200407,
					"content": "なにを話してたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120200408,
					"content": "#{NICKNAME}隊長？戻っていたんですね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200409,
						120200410
					],
					"speakerTitle": "嘉久"
				},
				{
					"id": 120200409,
					"content": "一緒に祝賀会へ参加するため来た。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120200411
					]
				},
				{
					"id": 120200411,
					"content": "さっきのこと、隊長に言ってもいいか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200412
					],
					"speakerTitle": "嘉久"
				},
				{
					"id": 120200412,
					"content": "#やめておけ。この人は珊瑚宮様に買われている人物だ、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}も和平交渉を主張するかもしれない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200413
					],
					"speakerTitle": "恒雄"
				},
				{
					"id": 120200413,
					"content": "隊長なら俺たちを理解してくれるはずだろ？いや、でもたしかに用心に越したことはないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200414
					],
					"speakerTitle": "嘉久"
				},
				{
					"id": 120200414,
					"content": "その、隊長の帰還、歓迎します！こちらは何も異常ありません、すべて順調です！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200415
					],
					"speakerTitle": "嘉久"
				},
				{
					"id": 120200415,
					"content": "珊瑚宮様は村にいると思います、隊長もそちらへ向かってはいかがでしょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200416
					],
					"speakerTitle": "恒雄"
				},
				{
					"id": 120200416,
					"content": "うぅ…なんかコソコソなにかを言ってたような…でも言いたくないなら仕方ない。まずは村に行ってみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120200410,
					"content": "最近、何かあった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120200411
					]
				}
			]
		},
		{
			"id": 1202005,
			"completionStepIds": [
				1202008
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1202008",
							"2"
						],
						"stepId": 1202008,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"松田",
					"成瀬",
					"内村",
					"珊瑚宮心海"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120200501,
					"content": "早く言え！海祇島から仕入れた品物、こっそり天領奉行に渡してるんだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200502
					],
					"speakerTitle": "松田"
				},
				{
					"id": 120200502,
					"content": "天領奉行の商人であるお前が海祇島で商売してるなんて、前々からおかしいと思ってたんだ。今回こそは言い逃れできまい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200503
					],
					"speakerTitle": "松田"
				},
				{
					"id": 120200503,
					"content": "ご、誤解です…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200504
					],
					"speakerTitle": "成瀬"
				},
				{
					"id": 120200504,
					"content": "誤解？何をいまさら。やはりお前が海祇島で商売することに同意するんじゃなかったぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200505
					],
					"speakerTitle": "内村"
				},
				{
					"id": 120200505,
					"content": "連れてけ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200506
					],
					"speakerTitle": "内村"
				},
				{
					"id": 120200506,
					"content": "待って…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120200507
					]
				},
				{
					"id": 120200507,
					"content": "お待ちを。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200508
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120200508,
					"content": "心海！ここにいたのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200509
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120200509,
					"content": "なにかもめ事みたいだぞ、事情を聞いてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200510
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120200510,
					"content": "珊瑚宮様、この商人が怪しい行動を取っていた故、捕まえておきました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200511
					],
					"speakerTitle": "松田"
				},
				{
					"id": 120200511,
					"content": "私共の調べによれば、彼は長期的に商品を仕入れているのですが、それらを売っていないようです。それなのに品物を持っていないため、きっと天領奉行にこっそり運んでいるに違いありません！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200512
					],
					"speakerTitle": "松田"
				},
				{
					"id": 120200512,
					"content": "違います…私は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200513
					],
					"speakerTitle": "成瀬"
				},
				{
					"id": 120200513,
					"content": "そこまで。皆さん冷静に。私と一緒に深呼吸しましょう…すぅ…ふぅ…少しは落ち着きましたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200514
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120200514,
					"content": "松田、内村、海祇島の安全を心配する気持ちは私も理解していますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200515
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120200515,
					"content": "ですがその前に、こちらの商人さんが過ちを犯したかどうかにかかわらず、少なくとも弁解する機会を与えるべきではないですか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200516
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120200516,
					"content": "過ちを犯せば罰を受けるのは当然。しかし、そうでなければ冤罪を着せるわけにはいきません。海祇島で行われる物事は、主観的な判断ではなく、すべて事実に基づくものでなくては。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200517
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120200517,
					"content": "商人さん、私の部下が品物のことについて疑問を抱いています。そのことについて説明をなさってから、私が判断を下すというのはいかがでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200518
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120200518,
					"content": "はい、もちろん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200519
					],
					"speakerTitle": "成瀬"
				},
				{
					"id": 120200519,
					"content": "海祇島で商売を始めてから、確かに在庫を多数抱えていました。もう少し在庫を確保して、商品の値段が上がった頃に売ろうかと…あっ、ゴホンッ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200520
					],
					"speakerTitle": "成瀬"
				},
				{
					"id": 120200520,
					"content": "しかしそんな時、仕入れた品物をファデュイに奪われてしまったんです！私が何をしたというのでしょう？品物は奪われた上に、あなたたちに尋問までされるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200521
					],
					"speakerTitle": "成瀬"
				},
				{
					"id": 120200521,
					"content": "ふんっ、それが本当かどうかなんて分からないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200522,
						120200523
					],
					"speakerTitle": "内村"
				},
				{
					"id": 120200522,
					"content": "ここに来る途中…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120200524
					]
				},
				{
					"id": 120200524,
					"content": "だとしても、ファデュイに奪われたという証明にはならない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200525
					],
					"speakerTitle": "内村"
				},
				{
					"id": 120200525,
					"content": "それに、天領奉行とファデュイは結託してるんだ！ファデュイの手に渡ったということは、天領奉行の手に渡ったも同義！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200526
					],
					"speakerTitle": "内村"
				},
				{
					"id": 120200526,
					"content": "えっ？天領奉行がファデュイと結託？それはどこからの情報ですか、私は何も知りません！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200527
					],
					"speakerTitle": "成瀬"
				},
				{
					"id": 120200527,
					"content": "それに、結託していたとしても、私と関係ないじゃないですか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200528
					],
					"speakerTitle": "成瀬"
				},
				{
					"id": 120200528,
					"content": "戦争はもう終わったのに、天領奉行がまだファデュイと結託してるのか？うーん…オイラは違うと思うけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200529
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120200529,
					"content": "オイラたちこの前、九条家の名代に会ったんだ。そういうことをするような人じゃなかったと思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200530
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120200530,
					"content": "でもここに来るまで、たしかに兵士たちがこのことについて話してたな…心海、おまえはなにか知ってるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200531
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120200531,
					"content": "たしかに、そのような報告を聞きました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200532
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120200532,
					"content": "もう少し経てば、私たちと天領奉行の和平交渉の日になります。今回の交渉は神里家によって仕切られ、中立地点で行われます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200533
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120200533,
					"content": "私と九条裟羅がそれぞれ侍衛を引き連れ、これからのことについてしっかりと計画を立てる予定です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200534
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120200534,
					"content": "しかしそのような大事な時期に、とある噂を耳にしました。九条家が未だにファデュイと結託しており、海祇島を壊滅させようと企んでいると。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200535
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120200535,
					"content": "もしそれが本当なら、交渉は罠である可能性が…そして神里家もそれに関わっているかもしれません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200536
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120200536,
					"content": "商人さん、あなたの品物は本当にファデュイに奪われたのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200537
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120200537,
					"content": "本当です！嘘はついていません！ファデュイは私の品物を奪って、あちらの方に行きました。そこに秘密の拠点があるのかもしれません！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200538
					],
					"speakerTitle": "成瀬"
				},
				{
					"id": 120200538,
					"content": "わかりました。容易ならぬ事態です。私たちがあなたの品物を取り戻しましょう。上手くいけば、あなたの身の潔白も証明できます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200539
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120200539,
					"content": "もし本当にファデュイと天領奉行の結託を証明するような事態が起きた場合、あなたには調査に協力してもらう必要があります。よろしいですね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200540
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120200540,
					"content": "異論ありません。珊瑚宮様が直々にお手伝いをしてくださるなんて、なんとお礼を申せば。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200541
					],
					"speakerTitle": "成瀬"
				},
				{
					"id": 120200541,
					"content": "松田、内村、あなたたちは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200542
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120200542,
					"content": "珊瑚宮様の仰せのままに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200543
					],
					"speakerTitle": "松田"
				},
				{
					"id": 120200543,
					"content": "#よろしい。{NICKNAME}…いえ、メカジキ小隊二番隊隊長、私と共にこのことについて調査していただけますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200544,
						120200547
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120200544,
					"content": "もちろん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120200545
					]
				},
				{
					"id": 120200545,
					"content": "ふふ…では、あなたと離れていた間に、新たな成長を遂げているかどうか見せてもらいますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200546
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120200546,
					"content": "私もあなたに自分の得意なことをお教えいたします…私についてきてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120200547,
					"content": "御意！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120200548
					]
				},
				{
					"id": 120200548,
					"content": "ふふ…そうかしこまらず。これから何があろうと、ひとまず今は平和な時期なんですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200549
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120200549,
					"content": "それにあなたもずっと海祇島に留まるわけにはいかないでしょう…お互いに肩書きの違いはあれど、少なくとも友達のように振る舞いませんか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
