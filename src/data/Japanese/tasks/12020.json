			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"有澤"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120200301,
					"content": "ふぁ…平和…最高だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200302
					],
					"speakerTitle": "有澤"
				},
				{
					"id": 120200302,
					"content": "ん？なんだか見慣れた顔が…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200303
					],
					"speakerTitle": "有澤"
				},
				{
					"id": 120200303,
					"content": "どこかで見たような…誰だったか…思い出せない。だが敵じゃないようだな、何か用か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200304
					],
					"speakerTitle": "有澤"
				},
				{
					"id": 120200304,
					"content": "ここ最近の出来事について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120200305
					]
				},
				{
					"id": 120200305,
					"content": "みんなに落ち着きがない？そうか？全然そうは感じなかったが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200306
					],
					"speakerTitle": "有澤"
				},
				{
					"id": 120200306,
					"content": "普段から他人と会話をするのが好きじゃないからかもな。俺からすりゃ、あいつらはいつも騒がしいからさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200307
					],
					"speakerTitle": "有澤"
				},
				{
					"id": 120200307,
					"content": "せっかくの平和なんだ、ちゃんと味わっておかないと…ここで日向ぼっこして、海風に吹かれる。俺のやるべきことは、それだけさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200308
					],
					"speakerTitle": "有澤"
				},
				{
					"id": 120200308,
					"content": "悪いな、お前たちの質問に答えられなくて。珊瑚宮様に聞いてみるといい、あの人ならなんでも知ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200309
					],
					"speakerTitle": "有澤"
				},
				{
					"id": 120200309,
					"content": "うわ…もう眠っちゃいそうだぞ。これ以上邪魔するのはやめとこう。他の人に聞こうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 1202004,
			"completionStepIds": [
				1202006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
