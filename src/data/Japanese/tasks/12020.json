						120200524
					]
				}
			]
		},
		{
			"id": 1202006,
			"completionStepIds": [
				1202009
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1202009",
