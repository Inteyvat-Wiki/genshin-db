			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伝次郎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120200201,
					"content": "あなたは…メカジキ二番隊の隊長！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200202
					],
					"speakerTitle": "伝次郎"
				},
				{
					"id": 120200202,
					"content": "あなたのことは知っていますよ！あなたのおかげで、今の海祇島の平和があるんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200203
					],
					"speakerTitle": "伝次郎"
				},
				{
					"id": 120200203,
					"content": "自分はメカジキ二番隊の隊員ではありませんが、当時たたら砂にいた時、あなたをお見かけしたことがあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200204
					],
					"speakerTitle": "伝次郎"
				},
				{
					"id": 120200204,
					"content": "両軍が対峙する中、陣前比武で何人もの幕府武士と戦っていましたよね。かっこよかったです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200205
					],
					"speakerTitle": "伝次郎"
				},
				{
					"id": 120200205,
					"content": "何か自分に手伝えることは？なんでもお手伝いします！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200206
					],
					"speakerTitle": "伝次郎"
				},
				{
					"id": 120200206,
					"content": "ここ最近の出来事について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120200207
					]
				},
				{
					"id": 120200207,
					"content": "皆さんの落ち着きがない…確かに、自分も感じていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200208
					],
					"speakerTitle": "伝次郎"
				},
				{
					"id": 120200208,
					"content": "たぶん、まだ戦争の影響が尾を引いているのでしょう。戦場では犠牲になる可能性が常にあったので、皆さん凄く気を張っていましたし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200209
					],
					"speakerTitle": "伝次郎"
				},
				{
					"id": 120200209,
					"content": "そんな状況下で戦争がいきなり終わったため、皆さんどうやって普通の生活に戻ったらいいのか分からないんですよ…ははっ、ですので心配しなくても大丈夫です、少し時間が経てば皆さんよくなると思いますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200210
					],
					"speakerTitle": "伝次郎"
				},
				{
					"id": 120200210,
					"content": "それ以外だと、自分には心当たりがありません。ですが、珊瑚宮様がいる以上、海祇島に危険はないと自分はそう信じています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200211
					],
					"speakerTitle": "伝次郎"
				},
				{
					"id": 120200211,
					"content": "それに今はあなたも戻ってきましたので、より安全かと！何か必要なことがあれば、いつでも自分におっしゃってください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200212
					],
					"speakerTitle": "伝次郎"
				},
				{
					"id": 120200212,
					"content": "すごく親切な人だったな…他の人にも聞いてみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 1202003,
			"completionStepIds": [
				1202005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
