					"content": "とにかく、このミントビーンスープをレイフに届けてあげてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410912
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230410912,
					"content": "ナワーズとラミズの分も作ってあげなきゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230410909,
					"content": "エネルギッシュだね…",
