			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ネルミン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230410201,
					"content": "うぅ…また葉っぱがいっぱい食いちぎられてる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410202
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230410202,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410203
					]
				},
				{
					"id": 230410203,
					"content": "旅人さん、見てください！また子猫が花をかじりに来たんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410204
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230410204,
					"content": "ほら、この葉っぱ。これも…これもそれも！かじられて大きな穴ができちゃってます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410205,
						230410208
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230410205,
					"content": "お腹が空いてたのかな？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410206
					]
				},
				{
					"id": 230410206,
					"content": "レイフもそう言って、食べ物を持ってあちこちの猫に餌をやりに行ってくれたんです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410207
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230410207,
					"content": "でも次の日、やっぱり子猫がやって来て花をかじっていって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410210
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230410210,
					"content": "今は葉っぱをかじっているだけだけでも、いつか子猫が茎を噛み切っちゃうんじゃないかって心配で…そうなったら大変です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410211
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230410211,
					"content": "でも、心を鬼にして子猫を遠くに追っ払うわけにもいかなくて。何しろ外は砂漠です。この村以外に行く所はないでしょうから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410212
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230410212,
					"content": "旅人さん、もう一度子猫に餌をやってきてもらえませんか？満腹になって、もう花をかじりに来ないといいんですが…葉っぱも別に美味しいわけじゃないでしょうし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410213,
						230410214
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230410213,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410216
					]
				},
				{
					"id": 230410216,
					"content": "じゃあお願いしますね、旅人さん。地図の、その子猫がよくいる場所に印をつけておきますから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410217
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230410217,
					"content": "他の子猫が花をかじりに来ないように、私はこの鉢植えのそばを守っていたいんです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230410214,
					"content": "猫の相手は得意だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410215
					]
				},
				{
					"id": 230410215,
					"content": "良かったです！私、猫の爪っていつ見ても、いきなり飛びかかってきて引っ掻かれるんじゃないかと心配で…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410216
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230410208,
					"content": "子猫は…遊びでかじってるのかな？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410209
					]
				},
				{
					"id": 230410209,
					"content": "子猫がどんな遊びをするのかはよく知りませんが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410210
					],
					"speakerTitle": "ネルミン"
				}
			]
		},
		{
