				{
					"id": 230410501,
					"content": "旅人さん、水を汲んできてくれましたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410502
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230410502,
					"content": "何とか汲んできたよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410503
					]
				},
				{
					"id": 230410503,
					"content": "よかった！お花に水をあげるので、ちょっと待ってくださいね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410504
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230410504,
					"content": "ネルミンは花に水をやり始めた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230410505
					]
				},
				{
					"id": 230410505,
					"content": "ふぅ…これでいいでしょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410506
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230410506,
					"content": "クルスームおばあちゃんは、水をやるときは植木鉢の下に水が漏れてくれば止めていいって言ってました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410507
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230410507,
					"content": "これで土が「十分に湿った」ことになるんですって。後は三日に一回水をやれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410508
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230410508,
					"content": "あら！ごめんなさい、独り言を言ってしまって…これはお礼です。手伝ってくれてありがとうございます、旅人さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410509
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230410509,
					"content": "葉っぱを剪定するときは、どんな道具を使えばいいんでしょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ネルミン"
				}
			]
		},
