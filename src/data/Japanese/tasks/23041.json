			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ネルミン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230410101,
					"content": "ふぅ…これだけ土が柔らかければいいでしょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410102
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230410102,
					"content": "まだこの鉢植えの世話をしてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410103
					]
				},
				{
					"id": 230410103,
					"content": "ええ、クルスームおばあちゃんから花の育て方をたくさん教わったので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410104
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230410104,
					"content": "例えば土を柔らかくしたり、時たま葉っぱを剪定したり、色んな方法で虫を取り除いたり…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410105
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230410105,
					"content": "それに根っこが水浸しになって腐ってしまうから、水をやりすぎてもいけないんですって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410106
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230410106,
					"content": "はぁ、毎日花に水をやって、常に土を湿らせてなきゃダメだと思ってました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410107
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230410107,
					"content": "でもそのほうがいいですよね、毎日水を汲みにいく必要がないですし。水汲み場はここから遠いもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410108
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230410108,
					"content": "私は枝葉の剪定を続けないといけないから、水汲みを手伝ってもらえませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410109
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230410109,
					"content": "もうカサンには話してあるんです。花にやる水を汲みに来てもいいって言われました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410110,
						230410111
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230410110,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410114
					]
				},
				{
					"id": 230410114,
					"content": "じょうろはそこです。水を汲むときはあまり泥が混じらないよう、気をつけてくださいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230410111,
					"content": "それ、みんなクルスームおばあちゃんが？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410112
					]
				},
				{
					"id": 230410112,
					"content": "ええ…だいたいですけどね。クルスームおばあちゃんは物知りだから、よく教えてもらいに行くんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410113
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230410113,
					"content": "じゃあお願いしますね、旅人さん。じょうろに水を汲んできてくれるだけで大丈夫ですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410114
					],
					"speakerTitle": "ネルミン"
				}
			]
		},
		{
			"id": 2304102,
			"completionStepIds": [
				2304101,
