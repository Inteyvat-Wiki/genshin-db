					"ネルミン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230410301,
					"content": "旅人さん、いいところに。ミントビーンスープを作ったんです。味見してみてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410303
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230410303,
					"content": "この材料…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410304
					]
				},
				{
					"id": 230410304,
					"content": "人に頼んで買って来てもらったものもありますが、ミントは…私が自分で育てたんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410305
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230410305,
					"content": "レイフが私にガーデニングの道具と肥料を送ってくれたでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410306
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230410306,
					"content": "花を一鉢植えるだけではもったいないと思って…それで、アザライさんに頼んでミントの種を買ってきてもらったんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410307
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230410307,
					"content": "ミントの種を植えてから、あの鉢植えと同じように世話をしていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410308
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230410308,
					"content": "ずっと世話をしていたら、ミントはすくすく育って…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410309
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230410309,
					"content": "それを少し摘んで、ミントビーンスープを作ったんです。どうです？美味しいでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410310
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230410310,
					"content": "えっと…私のスープを飲みましたよね？手伝ってほしいことがあるんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410311,
						230410312
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230410311,
					"content": "その、まだ飲み終わってないんだけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410313
					]
				},
				{
					"id": 230410313,
					"content": "だーめ！冗談ですよ、報酬はちゃんと払いますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410314
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230410314,
					"content": "ザイトゥン桃を3つ採ってきてもらいたいんです。レイフはこの果物が大好物で…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410315
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230410315,
					"content": "だから、ミントビーンスープに入れて、レイフに届けてあげたいと思って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410316
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230410316,
					"content": "ミントビーンスープはもう作れるようになりましたから、後は誰かがザイトゥン桃を採ってきてくれるのを待つだけなんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410317,
						230410319
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230410317,
					"content": "わかった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410318
					]
				},
				{
					"id": 230410318,
					"content": "ありがとうございます。帰ってきたら、またミントビーンスープをご馳走しますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410321
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230410321,
					"content": "じゃあお願いしますね、旅人さん。ザイトゥン桃を採ったら私のところに持ってきてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230410319,
					"content": "仕事中に飲んでもいいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410320
					]
				},
				{
					"id": 230410320,
					"content": "少しだけですし、彼の仕事はそんなに厳しくありませんから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410321
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230410312,
					"content": "スープ、返すね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410313
					]
				}
			]
		},
