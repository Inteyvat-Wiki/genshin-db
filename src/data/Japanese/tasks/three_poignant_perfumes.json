					"nextDialogs": [
						10120820
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10120820,
					"content": "ハハハッ…そうかもしれないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120821
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10120821,
					"content": "「岩王帝君」の化身は数多く存在する、その中のひとつかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120822
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10120822,
