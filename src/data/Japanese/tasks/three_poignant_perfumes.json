					"nextDialogs": [
						10120814
					]
				},
				{
					"id": 10120814,
					"content": "三つ目は優しい香りだけど長持ち、ほんのり…なんとかかんとか、大人の女性にウケがいいって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120815
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10120815,
					"content": "あれ…今のって？",
