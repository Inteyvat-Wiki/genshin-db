				},
				{
					"id": 10120502,
					"content": "えっ？どうしてオイラたちが来るってわかったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10120503,
					"content": "えぇ匂いがする人を狙っとる2人組がおるって聞いてな…",
