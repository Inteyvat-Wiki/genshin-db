						10120809
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10120809,
					"content": "（「金屋蔵嬌」を捧げる）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120810
					]
				},
				{
					"id": 10120810,
					"content": "一つ目は、甘くて夢にあふれた感じ、若い女の子が好きな香りだって鶯が言ってたな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120811
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10120811,
					"content": "（「山の花錦」を捧げる）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120812
					]
				},
				{
					"id": 10120812,
					"content": "二つ目は、高貴なイメージ、お金持ちのお嬢さんのお気に入りだって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120813
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10120813,
					"content": "（「縹渺たる仙縁」を捧げる）",
