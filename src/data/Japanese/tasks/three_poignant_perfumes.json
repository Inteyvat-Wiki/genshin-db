					"nextDialogs": [
						10120816,
						10120817
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10120816,
					"content": "「岩王帝君」が気に入ったようだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120818
					]
				},
				{
					"id": 10120818,
					"content": "あれって大人の女性にウケがいいやつだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120819
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10120819,
					"content": "まさか…「岩王帝君」って本当はお姉さん？",
