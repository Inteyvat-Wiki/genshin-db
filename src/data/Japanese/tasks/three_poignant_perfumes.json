			"dialogs": [
				{
					"id": 10120301,
					"content": "嵐姉さん、手伝ってほしいんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10120302,
					"content": "悪いね、もう長いこと依頼は受けていないの。他の冒険者をあたってちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120303
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 10120303,
					"content": "依頼を出すほどのことじゃないんだ、ちょっとしたことだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120304,
						10120307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10120304,
					"content": "香膏を作れる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120305
					]
				},
				{
					"id": 10120305,
					"content": "…え。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120306
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 10120306,
					"content": "そういうのを使うような人に見える？なんだか小馬鹿にされた気分…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120311
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 10120311,
					"content": "でも嵐姉さんから確かにいい匂いがするぞ。香膏じゃないなら、何の匂いだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10120312,
					"content": "そう言われてみると、確かに何か香るわね、うーん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120313
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 10120313,
					"content": "あっ、もしかしたら戻ってくる時に摘んだ「清心」じゃない？ずっと持ち歩いてるのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120314
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 10120314,
					"content": "はあ、そっか…嵐姉さんも花を摘んだりするんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120315
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10120315,
					"content": "…薬に使うからよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120316
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 10120316,
					"content": "はい、この話は終わり。香膏なら…<color=#00E1FFFF>綺命</color>に聞いてみたら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120317
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 10120317,
					"content": "あの占い師のお姉さんだよな？うん、確かにいい匂いがしてたかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120318
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10120318,
					"content": "じゃあ行ってくる、ありがとな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10120307,
					"content": "嵐姉さんからいい匂いがする。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120308
					]
				},
				{
					"id": 10120308,
					"content": "…え。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120309
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 10120309,
					"content": "あなたたち私をからかってるの？バカにしてるわけじゃないわよね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120310
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 10120310,
					"content": "私はいつも外を走ってるの。そりゃ見た目には多少気を遣ってるけど、「いい匂い」なんてとても…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120311
					],
					"speakerTitle": "嵐姉"
				}
			]
		},
