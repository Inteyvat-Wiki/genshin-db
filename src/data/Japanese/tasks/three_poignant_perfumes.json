	"talks": [
		{
			"id": 101202,
			"completionStepIds": [
				101202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101202",
							"2"
						],
						"stepId": 101202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"博来"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10120201,
					"content": "店主、霓裳花ってあるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10120202,
					"content": "霓裳花？もちろんあるよ、どの種類をお探しで？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120203
					],
					"speakerTitle": "博来"
				},
				{
					"id": 10120203,
					"content": "うん…種類？い、一番品質のいいやつがいいよな？霓裳花ってそんなに種類があるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10120204,
					"content": "ふん、何も知らない他国の人間か、そんなことを聞くとは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120205
					],
					"speakerTitle": "博来"
				},
				{
					"id": 10120205,
					"content": "「金屋蔵嬌」、「山の花錦」、「縹渺たる仙縁」、この3種類の霓裳花をそれぞれ1株見せてもらえないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120206
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10120206,
					"content": "——おおッ！お客さん、玄人ですな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120207
					],
					"speakerTitle": "博来"
				},
				{
					"id": 10120207,
					"content": "隣の二人は召使いでしょうか。召使いなら、旦那様より先に口出ししないほうがいいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120208,
						10120209,
						10120210
					],
					"speakerTitle": "博来"
				},
				{
					"id": 10120208,
					"content": "こっちまで一緒くたに…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120212
					]
				},
				{
					"id": 10120212,
					"content": "さあ、さあ、ご覧ください。何か質問がありましたら、ぜひ遠慮なく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120213
					],
					"speakerTitle": "博来"
				},
				{
					"id": 10120213,
					"content": "ふむ、育った環境や交配状況によって、霓裳花の特徴は変わるが…店主が用意したものはどれもいい状態で保存されているな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120214
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10120214,
					"content": "たとえばこの品種。枝が生い茂り、花蕊が金の屋敷に隠された美人を思わせるこの様。緑の葉が長く育ち、その多くは水の条件が複雑な場所で成長する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120215
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10120215,
					"content": "そしてこっちだ、山の陰や湿気の多いところにある霓裳花は花弁が大きく育ち、花蕊が密集しているため香りが濃くなり、まさに花錦の名にふさわしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120216
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10120216,
					"content": "最後の品種は、枝も葉も花も密度がかなり低く、花が咲く時の香りも淡いが、一番長く持つ。古人が仙人のもとを訪れるため山を登った時、偶然見つけたものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120217
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10120217,
					"content": "しかし今となっては、野生の霓裳花の多くは璃月の地理の変遷により絶滅している。そのため、現在は人工栽培の方が多くなっているんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120218
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10120218,
					"content": "はあ、旦那は詳しいですな、私もそこまでは知りませんでした…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120219
					],
					"speakerTitle": "博来"
				},
				{
					"id": 10120219,
					"content": "嗜む程度だ。こちらの旅人の方が侮れないぞ、いつか大陸を踏破する者になるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120220,
						10120221
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10120220,
					"content": "そんなにすごくない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120222
					]
				},
				{
					"id": 10120222,
					"content": "褒めすぎだぞ、鍾離…それで、この3種類の霓裳花のうちどれを選べばいいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120223
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10120223,
					"content": "店主、全部もらうぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120224
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10120224,
					"content": "またか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120225
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10120225,
					"content": "ハハッ、芝居を観る時は一番人気の役者を選び、鳥を飼う時は貴重なガビチョウを選ぶ——それが人生というものだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120226
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10120226,
					"content": "だが、今回3種類とも買うのは、俺の人生の信条が理由ではない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120227
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10120227,
					"content": "知らないとは思うが、伝統によると品種の異なる霓裳花をそれぞれ香膏にし、「七天神像」の前に捧げることで、岩王帝君が気に入ったものを選んでくれるそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120228
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10120228,
					"content": "こういう古い時代のしきたりや一部複雑すぎる伝統は、徐々に簡略化されていったがな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120229
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10120229,
					"content": "しかし、これは3700年間、七神の一座に属してきた神の「送仙儀式」だ。やはり伝統に従い、香膏を捧げることにしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120230
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10120230,
					"content": "ふむ、それで…うむ…モラは持っているか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120231
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10120231,
					"content": "またモラを持って来てないのかよ！鍾離ッーー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120232,
						10120233
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10120232,
					"content": "もう慣れた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120234
					]
				},
				{
					"id": 10120234,
					"content": "…えっと、お客さん、すみませんが、一つお聞きしてもよろしいですか。これらの花は、岩王帝君に捧げるものなのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120235
					],
					"speakerTitle": "博来"
				},
				{
					"id": 10120235,
					"content": "そうだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120236
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10120236,
					"content": "はあ、それなら早く言ってくださいよ…あの「迎仙儀式」の後、私も良くない噂をいろいろと聞きました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120237
					],
					"speakerTitle": "博来"
				},
				{
					"id": 10120237,
					"content": "不吉なことは口にしたくないので、割愛させてもらいますが。とにかく、岩王帝君のことが心配で、あの噂が真実なのではないかと気が気じゃなかったのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120238
					],
					"speakerTitle": "博来"
				},
				{
					"id": 10120238,
					"content": "岩王帝君のためなら、お金は取れません。私からの気持ちということにさせてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120239
					],
					"speakerTitle": "博来"
				},
				{
					"id": 10120239,
					"content": "い、いいのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120240
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10120240,
					"content": "ハハッ、岩王帝君がいなかったら、私みたいな一般人の住む場所などなかったのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120241
					],
					"speakerTitle": "博来"
				},
				{
					"id": 10120241,
					"content": "過去に岩王帝君が詩を作っていなければ、この霓裳花だって重宝されることはありませんでした…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120242
					],
					"speakerTitle": "博来"
				},
				{
					"id": 10120242,
					"content": "へえ…今まで見聞きしてきた璃月の風土や人情って、神様が与えてきた恩恵の結果だったんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120243
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10120243,
					"content": "…とにかく、礼を言う。これで俺たちの憂いは一つ解消した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120244
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10120244,
					"content": "金を忘れてきた鍾離のせいだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120245
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10120245,
					"content": "いえ、ほんの気持ちですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "博来"
				},
				{
					"id": 10120233,
					"content": "鍾離先生が持ってた方がおかしいかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120234
					]
				},
				{
					"id": 10120221,
					"content": "霓裳花のことはよく知らないけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120222
					]
				},
				{
					"id": 10120209,
					"content": "パイモンを非常食扱いした報いか…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120212
					]
				},
				{
					"id": 10120210,
					"content": "いや、会ったことあるよね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120211
					]
				},
				{
					"id": 10120211,
					"content": "ん？会ったこと…ああ、旅人さんでしたか！申し訳ない、先ほどは言葉が過ぎましたね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120212
					],
					"speakerTitle": "博来"
				}
			]
		},
		{
			"id": 101203,
