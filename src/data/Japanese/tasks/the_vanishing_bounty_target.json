			"dialogs": [
				{
					"id": 760440101,
					"content": "「フラッグシップ」の指名手配の中で、手に負えないやつがあるんだ。手がかりが何も掴めない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440102
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760440102,
					"content": "前にそいつがレンポ島北部で人を襲ったって話があったんだけど、急に姿をくらませちまったんだよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440103
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760440103,
					"content": "「誰かが通った後には必ず痕跡が残る」。たとえ痕跡が消されていても、新たな証拠が残ってしまうものだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440104
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 760440104,
					"content": "それに、指名手配の情報に詳しいことは書かれていなかったけど、やつらが何も情報を掴めていないわけじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440105
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 760440105,
					"content": "そうだよな。レゼックに聞きにいってくるよ。あたいが行けば何か聞き出せるかもだしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440106
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760440106,
					"content": "じゃあ、任せたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440107
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 760440107,
					"content": "ああ。安心して待っててくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヤフォダ"
				}
			]
		},
