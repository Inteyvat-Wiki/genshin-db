			"dialogs": [
				{
					"id": 760440301,
					"content": "「フラッグシップ」の指名手配か…いつの間にか、あとは残り一つになったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440302
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760440302,
					"content": "#{NICKNAME}の活躍のおかげだと聞いたが、{M#彼}{F#彼女}でもこの最後の案件については打つ手なしだそうだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440303
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 760440303,
					"content": "手がかりが何もないもんな——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440304
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760440304,
					"content": "あっ、いや…手配情報には記載されてないけど、本当にないとは限らないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440305
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760440305,
					"content": "何か見当がついてるのかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440306
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 760440306,
					"content": "レゼックに聞きにいってくるよ。あたいが行けば何か聞き出せるかもだしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440307
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760440307,
					"content": "じゃあ、任せたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440308
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 760440308,
					"content": "ああ。安心して待っててくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヤフォダ"
				}
			]
		}
