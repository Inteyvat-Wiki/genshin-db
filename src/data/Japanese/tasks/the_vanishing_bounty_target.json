				]
			},
			"dialogs": [
				{
					"id": 760440201,
					"content": "懸賞金がかかってる対象の情報は全部掲示板に載ってる。話には付き合うが、賞金の額については相談に乗れないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440202
					],
					"speakerTitle": "レゼック"
				},
				{
					"id": 760440202,
					"content": "懸賞金のターゲットについて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440203
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760440203,
					"content": "掲示板には四人載ってるが、手がかりがあるのはそのうち三人だ。詐欺の容疑で懸賞金がかかってるのは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440204
					],
					"speakerTitle": "レゼック"
				},
				{
					"id": 760440204,
					"content": "…おい、待てって！新米のトレジャーハンターをそうやってあしらうのは知ってるけど、あたいにまでそんな対応かよ？何が聞きたいかは分かってるんだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440205
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760440205,
					"content": "「秘聞の館」が介入するのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440206
					],
					"speakerTitle": "レゼック"
				},
				{
					"id": 760440206,
					"content": "それはうちのボス次第…ん？なんであたいが逆に質問されてんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440207
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760440207,
					"content": "「裂けアゴ」のハルクは未だに見つかってないみたいだけど、あんたらの出してる情報が曖昧すぎるせいじゃないのか？なんで外見の特徴すら書かれてないんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440208
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760440208,
					"content": "そんなことも知らんトレジャーハンターに、ハルクの相手が務まるはずがない。彼らの時間…そして命を無駄にすることはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440209
					],
					"speakerTitle": "レゼック"
				},
				{
					"id": 760440209,
					"content": "わかったよ。それじゃあ、顎の恐ろしい傷痕以外に特徴はあるか？他のやつが知らないようなやつでさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440210
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760440210,
					"content": "他の人が知らない…例えば、背中にある印みたいなもの——とかか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440211
					],
					"speakerTitle": "レゼック"
				},
				{
					"id": 760440211,
					"content": "そう。そういうやつだよ！ホントにあったんだな！っていうか、そんなことなんで知ってるんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440212
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760440212,
					"content": "ただの例だ。俺も知らん。仮にあったとして、どうやって確かめるつもりだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440213
					],
					"speakerTitle": "レゼック"
				},
				{
					"id": 760440213,
					"content": "そ、それもそうか…はぁ、本当に特ダネは持ってないのか？あたいらの仲だろ、何か教えてくれよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440214
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760440214,
					"content": "ハルクはナシャタウンで本性を現してから、レンポ島北部へ逃げ、そこで今も悪事の限りを働いている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440215
					],
					"speakerTitle": "レゼック"
				},
				{
					"id": 760440215,
					"content": "それは知ってるよ。前に聞いたからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440216
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760440216,
					"content": "でも最近は消息が途絶えてるんだろ？北部へ行ったとすれば…ピラミダならいいけど、もしスネージナヤ・グラードに向かってたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440217
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760440217,
					"content": "（極寒の地だぞ。あたいの腕、耐えきれるのか…？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440218
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760440218,
					"content": "いや、やつはまだレンポ島にいるはずだ。ただし隠れ場所が分かっていない。これは特ダネだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440219
					],
					"speakerTitle": "レゼック"
				},
				{
					"id": 760440219,
					"content": "えっ、どうしてそう確信できるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440220
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760440220,
					"content": "それは企業秘密だ。別料金。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440221
					],
					"speakerTitle": "レゼック"
				},
				{
					"id": 760440221,
					"content": "ちぇっ、ケチだな。はぁ…顎に傷跡がある男なんて、レンポ島でだって十歩歩いたら一人はいるだろ。どうやって探せってんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440222
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760440222,
					"content": "なら、俺たちの仲に免じて一つアドバイスだ。顎の傷痕にばかりとらわれるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440223
					],
					"speakerTitle": "レゼック"
				},
				{
					"id": 760440223,
					"content": "…それはつまり、何かしらの手を使って顎の傷痕を隠してるかもってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440224
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760440224,
					"content": "なるほどな…やつが「裂けアゴ」って呼ばれてるのは、特徴的な傷跡のせいだ。逆に言えば、傷跡がなければ他の男と見分けがつかないってことか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440225
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760440225,
					"content": "つまり、顎を気にして隠そうとしてる男を探せばいいってことだな。こりゃ新たな手がかりになるぞ。よし、進展があったらまた来るからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440226
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760440226,
					"content": "ああ。いい知らせを待ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "レゼック"
				}
			]
		},
