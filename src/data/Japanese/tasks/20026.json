			"dialogs": [
				{
					"id": 200260101,
					"content": "出前オーダー",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260102
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 200260102,
					"content": "旅人、ちょうどよかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260103
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 200260103,
					"content": "ん？ごはんを食べに来ただけですか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260104
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 200260104,
					"content": "わ、わかりました。でも少し手伝ってほしいんです。最高の料理をご馳走しますから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260105
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 200260105,
					"content": "アカツキワイナリーのアーネストさんはよくうちにおつまみを頼みますけど、いつも変わった注文を追加するんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260106
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 200260106,
					"content": "えっと…今回彼が注文したのは<color=#00E1FFFF>大根の揚げ団子</color>で、卵を追加してほしいと言われたけど、うちの卵料理の材料はもう全部使い切ってしまったんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260107
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 200260107,
					"content": "だから、鳥の卵を二つ探してきてくれませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260108,
						200260111
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 200260108,
					"content": "いいけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200260109
					]
				},
				{
					"id": 200260109,
					"content": "風立ちの地なら、鳥の卵がたくさん見つかるはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260110
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 200260110,
					"content": "じゃあ、お願いしますね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "サラ"
				},
				{
					"id": 200260111,
					"content": "お腹空いた、食事しに来ただけだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200260112
					]
				},
				{
					"id": 200260112,
					"content": "風立ちの地なら、鳥の卵がたくさん見つかるはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260113
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 200260113,
					"content": "このお願いを聞いてくれたら、鹿狩りのスペシャルコースをご馳走しますから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "サラ"
				}
			]
		},
