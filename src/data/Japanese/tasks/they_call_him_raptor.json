			"dialogs": [
				{
					"id": 4842201,
					"content": "こんなとこまで来るなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4842202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4842202,
					"content": "この先、元素の痕跡がない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4842203
					]
				},
				{
					"id": 4842203,
					"content": "目印の元素が尽きたのかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4842204
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4842204,
					"content": "そっか、元素の痕跡を消せないと分かって、手下を使って足止めさせたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4842205
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4842205,
					"content": "痕跡が自然と消えるのを待つつもりなんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4842206
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4842206,
					"content": "そうはさせない！急ごう。",
