			},
			"dialogs": [
				{
					"id": 101121001,
					"content": "ありがとう、本当にありがとう！やっと欲しかったものが揃った！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121002
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 101121002,
					"content": "父さん、母さん！神器を見つけたよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121003
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 101121003,
					"content": "えっ？待ってよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121004
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101121004,
					"content": "約束のお酒は？ここまで大変だったんだよ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121005
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101121005,
					"content": "あれ？スタンレーじゃないか、こんなところで散歩かい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121006
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101121006,
					"content": "あっ、あはははっ、吟遊詩人か！奇遇だな、お前らも散歩か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121007
					],
					"speakerTitle": "スタンレー"
				},
				{
					"id": 101121007,
					"content": "そうだよ、食後の散歩ついでに、友達の探し物に付き合ってたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121008
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101121008,
					"content": "スタンレーは嘘つきかも、ますます怪しく思えてきたぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121009,
						101121010
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101121009,
					"content": "同じく…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101121011
					]
				},
				{
					"id": 101121011,
					"content": "ジャックを傷つけないために、あらかじめ剣と盾を置きにきたのかもな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121012
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101121012,
					"content": "大冒険者はダダウパの谷に詳しいよね？なにせ、ここは君がかつて戦った場所だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121013
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101121013,
					"content": "と、当然だ、目を閉じても迷子にならない自信があるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121014
					],
					"speakerTitle": "スタンレー"
				},
				{
					"id": 101121014,
					"content": "なるほど、君の記憶力と根性には感服するよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121015
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101121015,
					"content": "大冒険者だからな、それくらい当然だ！ここにはヒルチャールがたくさんいるから、お前たちこそ気を付けるんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121016
					],
					"speakerTitle": "スタンレー"
				},
				{
					"id": 101121016,
					"content": "で、ではまたな、若者たちよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121017
					],
					"speakerTitle": "スタンレー"
				},
				{
					"id": 101121017,
					"content": "やっぱ怪しいよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121018
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101121018,
					"content": "仕方ないよ、ジャックにあんなことを言ってしまったんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121019
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101121019,
					"content": "でも…あらためてみると、実に面白い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121020
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101121020,
					"content": "「過去」を忘れたくないから、「今」を捨てた人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121021
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101121021,
					"content": "もし彼が「未来」への一歩を踏み出さなければならなくなった時、その一歩はどこへ向かうのだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121022
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101121022,
					"content": "ん？どういう意味だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121023
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101121023,
					"content": "あははっ、ただの独り言さ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121024
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101121024,
					"content": "#そうだ、{NICKNAME}、今夜は<color=#00E1FFFF>「エンジェルズシェア」</color>に行ってみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101121010,
					"content": "かもじゃなくて、きっとそうだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101121011
					]
				}
			]
