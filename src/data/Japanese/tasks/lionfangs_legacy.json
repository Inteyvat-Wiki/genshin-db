					]
				},
				{
					"id": 101120629,
					"content": "Biadam！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120630
					],
					"speakerTitle": "ヒルチャール"
				},
				{
					"id": 101120630,
					"content": "うっ…<color=#00E1FFFF>ご機嫌斜め</color>みたいだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120631,
						101120633
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101120626,
					"content": "Kucha pupu gusha ye!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120629
					]
				},
				{
					"id": 101120618,
					"content": "盾をください。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120622
					]
				},
				{
					"id": 101120619,
					"content": "Vin plata dada！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120620
					]
				},
				{
					"id": 101120620,
					"content": "Mosi mita！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120621
					],
					"speakerTitle": "ヒルチャール"
				},
				{
					"id": 101120621,
					"content": "うん、<color=#00E1FFFF>落ち着いてる</color>し、続けていいと思うぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120624,
						101120625,
						101120626
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101120610,
					"content": "きっとあの盾で間違いない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120612
					]
				},
				{
					"id": 101120611,
					"content": "さすがウェンティだ。",
					"roleType": "TALK_ROLE_PLAYER",
