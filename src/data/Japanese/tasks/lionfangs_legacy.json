			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ウェンティ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101120401,
					"content": "ほら、これが<color=#00E1FFFF>「煌めく勇気の剣」</color>だよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120402
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101120402,
					"content": "本気か？ただの古い剣だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101120403,
					"content": "ヒルチャールのやつら、なんでこんなものに祈りを捧げてたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101120404,
					"content": "（おそらく、どっかの誰かがヒルチャールの戦利品の中にこの剣を入れただけだろうね…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120405
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101120405,
					"content": "ボ、ボロすぎる！それに…なんと言えばいいか、言葉が見つからないくらい普通だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120406
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 101120406,
					"content": "いやジャック、君はモンド城外にいる風晶蝶を見たことないかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120407
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101120407,
					"content": "ああいう蝶も昼間は目立たないけど、夜になると目が眩むほど眩しくなる、まるで空を飛ぶ宝石のようにね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120408
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101120408,
					"content": "勇気だってそういうものだろう？平穏な人からしたら、その価値は理解できない。けどいざ苦境に立たされた時、勇気だけが君を奮い上がらせ、窮地を脱する唯一の光となる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120409,
						101120410,
						101120411
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101120409,
					"content": "口が上手。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120412
					]
				},
				{
					"id": 101120412,
					"content": "そ、その通りだ！間違いない、これが「煌めく勇気の剣」だよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120413
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 101120413,
					"content": "うん、じゃあこれで剣は見つけたし、あとは盾だね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120414
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101120414,
					"content": "この辺りを探してみよう！きっと<color=#00E1FFFF>ダダウパの谷</color>のどこかにあるはず——おや？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120415
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101120415,
					"content": "あれ？あそこに誰かいるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120416
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101120416,
					"content": "スタンレー？どうして彼がここに？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120417
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101120417,
					"content": "様子が少し変だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120418
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101120418,
					"content": "どうしたんだ？急に止まって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120419
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 101120419,
					"content": "何でもないよ、コインをばら撒く「宝盗イタチ」が通っただけさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120420
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101120420,
					"content": "何ッ？どこにいるんだ！僕も見たい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120421
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 101120421,
					"content": "君は武具を探しに来たんだろ？そんなもの見る必要はないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101120410,
					"content": "心が震えた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120412
					]
				},
				{
					"id": 101120411,
					"content": "こっちまで信じそうになった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120412
					]
				}
			]
		},
		{
			"id": 1011206,
			"completionStepIds": [
