			},
			"dialogs": [
				{
					"id": 101120601,
					"content": "ほら、あれが<color=#00E1FFFF>「輝く意志の盾」</color>だよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120602
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101120602,
					"content": "嘘つけ！どう見てもただの木の板だろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120603
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101120603,
					"content": "ボロボロだし、たがで補強されてるぞ！誰があんなのを盾に使うんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101120604,
					"content": "しかも、酒の染みまである…まるで酒樽から適当に取り外してきたような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120605
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 101120605,
					"content": "でもボクの吟遊詩人としての勘が、あれこそ「輝く意志の盾」だと言ってるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120606
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101120606,
					"content": "戦士は体にある傷を誇りに思うように、盾も同じさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120607
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101120607,
					"content": "盾が綺麗だと、それは戦場で使われてないってことだ。ボロボロな盾こそ、百戦錬磨の証拠じゃないかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120608
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101120608,
					"content": "ボロボロになっても、戦場で最後の一瞬、血がなくなるまで戦い抜く。そんな意志こそが貴重だ、そうだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120609,
						101120610,
						101120611
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101120609,
					"content": "ウェンティの言う通り！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120612
					]
				},
				{
					"id": 101120612,
					"content": "そうだな…綺麗な盾なんてないもんな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120613
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101120613,
					"content": "じゃあ…ヒルチャールに「輝く意志の盾」を譲ってもらう方法を考えないとな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120614
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101120614,
					"content": "こんにちは、ヒルチャールさん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120615
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101120615,
					"content": "Dala？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120616
					],
					"speakerTitle": "ヒルチャール"
				},
				{
					"id": 101120616,
					"content": "#うわっ、やっぱ{NICKNAME}に任せる。聞いたことあるヒルチャール語を試してみたらどうだ？それとボディーランゲージで交渉してみよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120617,
						101120618,
						101120619
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101120617,
					"content": "モラで盾を交換したい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120622
					]
				},
				{
					"id": 101120622,
					"content": "Biadam！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120623
					],
					"speakerTitle": "ヒルチャール"
				},
				{
					"id": 101120623,
					"content": "うっ…<color=#00E1FFFF>ご機嫌斜め</color>みたいだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120624,
						101120625,
						101120626
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101120624,
					"content": "このスイートフラワー、あげるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120627
					]
				},
				{
					"id": 101120627,
					"content": "Mosi mita！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120628
					],
					"speakerTitle": "ヒルチャール"
				},
				{
					"id": 101120628,
					"content": "うん、<color=#00E1FFFF>落ち着いてる</color>し、続けていいと思うぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120631,
						101120633
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101120631,
					"content": "ウェンティ、歌う。盾、ください。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120632
					]
				},
				{
					"id": 101120632,
					"content": "ん？分かった、ちょっとだけ歌うね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120634
					],
					"speakerTitle": "ウェンティ"
				},
