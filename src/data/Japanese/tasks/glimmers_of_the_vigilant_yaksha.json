			"dialogs": [
				{
					"id": 111010701,
					"content": "そんな…「禁忌滅却の札」が効かないなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010702
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111010702,
					"content": "ヒルチャールの纏ってる邪気がまた強くなったのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010703
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111010703,
					"content": "「禁忌滅却の札」…なんかどこかで聞いたことあるような？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010704,
						111010705
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111010704,
					"content": "「絶雲の間」を自由に出入りできるあの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010706
					]
				},
				{
					"id": 111010706,
					"content": "そうだ、それだ！仙人の「目印」だから、きっと仙人の力が残ってたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010707
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111010707,
					"content": "あれを使って魔物を退散させてたのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010708
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111010708,
					"content": "き、君たち何を言ってるんだ。これはただ、昨夜眠れなくてだな…仙力がまだ目覚めていないだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010709
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111010709,
					"content": "もう一度チャンスをくれれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010710
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111010710,
					"content": "また「邪気を纏ったヒルチャール」がそっちにいったぞ、今度は任せてもいいか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010711
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111010711,
					"content": "わ…吾輩は体調が優れない、さっき仙力を使いすぎたせいかもしれん、そうでなければこんな妖魔ごとき…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010712
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111010712,
					"content": "ちぇっ…やっぱり嘘つきだったのか、見事に当たったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010713
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111010713,
					"content": "旅人、オイラたちで追いかけよう。「元素視角」を使えば追跡できるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111010705,
					"content": "あれを使って魔を退治してたのか…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010706
					]
				}
			]
