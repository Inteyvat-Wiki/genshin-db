			"dialogs": [
				{
					"id": 111010201,
					"content": "この『護法仙衆夜叉録』でいいの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010202
					],
					"speakerTitle": "紀芳"
				},
				{
					"id": 111010202,
					"content": "ああ、釣りはいらない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010203
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111010203,
					"content": "あら太っ腹…感謝するわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010204
					],
					"speakerTitle": "紀芳"
				},
				{
					"id": 111010204,
					"content": "あいつ、「なんとかかんとか辰天君」じゃないか？なんでこんなところに？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010205,
						111010206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111010205,
					"content": "「掇星攫辰天君」ね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010207
					]
				},
				{
					"id": 111010207,
					"content": "さっき『護法仙衆夜叉録』って本を…買ってたみたいだぜ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111010208,
					"content": "確か仙人に関する本だった気がするけど、なんで仙人が自分に関する本を買ってるんだろうな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010209,
						111010211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111010209,
					"content": "ずっと怪しいと思ってた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010210
					]
				},
				{
					"id": 111010210,
					"content": "えっ、そうなのか？どこが怪しいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010214,
						111010216,
						111010218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111010214,
					"content": "仙人がお金を稼いでどうするの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010215
					]
				},
				{
					"id": 111010215,
					"content": "あ…確かに、他の仙人はみんな欲がない感じだったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010220
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111010220,
					"content": "ふむ……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010221
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111010221,
					"content": "どうやら、あの本の内容を確認する必要があるな、何か手がかりになるかも知れない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111010216,
					"content": "詐欺の手口と同じ気がする。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010217
					]
				},
				{
					"id": 111010217,
					"content": "もしかして…実はあいつには願いを叶える力がない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010220
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111010218,
					"content": "あの仮面ダサい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010219
					]
				},
				{
					"id": 111010219,
					"content": "あっ！確かに凄くダサい！怪しすぎる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010220
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111010211,
					"content": "ナルシスト？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010212
					]
				},
				{
					"id": 111010212,
					"content": "そうかもな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111010213,
					"content": "でもよくよく考えると、あの仙人なんだかおかしいような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010214,
						111010216,
						111010218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111010206,
					"content": "これが「仙人との縁」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010207
					]
				}
			]
		},
