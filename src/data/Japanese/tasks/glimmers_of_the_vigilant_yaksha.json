						111011202
					]
				},
				{
					"id": 111011202,
					"content": "本の中では、魔神の怨嗟と千年争った「夜叉」たちですら、「業障」に陥るって書いてあるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111011203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111011203,
					"content": "魔神の怨嗟に汚染された夜叉が、考えもつかないような恐怖、憤怒、苦痛に苦しめられる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111011204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111011204,
					"content": "うぅ…璃月を千年も守って、見返りがない上にこんな苦痛を味わうなんて、かわいそすぎるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
