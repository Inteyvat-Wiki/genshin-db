			"dialogs": [
				{
					"id": 191735301,
					"content": "「全自動灌漑仕掛け」…ファルザン先輩ってば、本当に厄介な課題を残してくれたな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191735302
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 191735302,
					"content": "師匠、あたしに手伝えることはある？材料の購入とか、紙と筆の用意とか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191735303
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 191735303,
					"content": "えっと…確か君は、今日中に終わらせなきゃいけない宿題がまだたくさん残ってるんじゃない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191735304
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 191735304,
					"content": "え？あ…はい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191735305
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 191735305,
					"content": "宿題を終わらせて、さっさとベッドで横になりなさい。ファルザン先輩を心配させないことが、一番の助けだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191735306
					],
					"speakerTitle": "ティナリ"
