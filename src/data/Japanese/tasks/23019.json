			"dialogs": [
				{
					"id": 230190401,
					"content": "どうだ？船の調査は終わったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190402
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230190402,
					"content": "もう終わったよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190403
					]
				},
				{
					"id": 230190403,
					"content": "船の状況を説明した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230190404
					]
				},
				{
					"id": 230190404,
					"content": "なるほど。安く済まそうと小手先でごまかした船体はやっぱりダメだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190405
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230190405,
					"content": "でもああいう船体の修理はカネがかかる。あれの船主は確か懐具合が寂しかったはず…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190406
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230190406,
					"content": "ふぅ、やっぱり彼女と話してみるか。カネより人の命の方が大事だからな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ラフィク"
				}
			]
		}
	]
