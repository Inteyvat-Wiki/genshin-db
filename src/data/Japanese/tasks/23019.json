			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ラフィク"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230190101,
					"content": "やっぱり、こうすると余計にカネがかかる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190102
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230190102,
					"content": "なんの話？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190103
					]
				},
				{
					"id": 230190103,
					"content": "あ、どうも。いま船を設計しているところなんだが…壁にぶつかってしまってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190104
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230190104,
					"content": "簡単に言うと、製造コストを上げずに船の積載量を増やしたいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190105
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230190105,
					"content": "重量が大きくなると、船が壊れやすくなる。重量が不均一な状態では、バランスに問題が出る…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190106
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230190106,
					"content": "一番効果的な解決方法は、より良い材料を使うことだ。だがそうなると…製造コストが問題になってくる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190107
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230190107,
					"content": "はぁ…ぶっちゃけた話、カネはないけど、いい船が作りたいってだけの話さ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190108
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230190108,
					"content": "だからカネの代わりに、技術で問題を解決できないかと思ってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190109
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230190109,
					"content": "そんなこと本当にできるの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190110
					]
				},
				{
					"id": 230190110,
					"content": "ハハハッ。信じてもらえないかもしれないが、そういう前例はいくらでもある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190111
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230190111,
					"content": "俺たちの造る船は、荒波にさらされることのない近海漁船ばかりだしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190112
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230190112,
					"content": "みんなケチるとこはケチって、修理しながら使うってのを前提に船を造ってる…なんとか使えたら、それでいいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190113
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230190113,
					"content": "ま…そのお陰で、俺たち船の修理工は毎日大忙しだけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190114
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230190114,
					"content": "旅人、できたらあそこに行って、帰港したばかりの船を調べてくれないか？日頃の過積載が祟ってトラブルが起きてるように見える。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190115
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230190115,
					"content": "さっき悩んでた問題も、そこにヒントがあるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190116,
						230190118
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230190116,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190117
					]
				},
				{
					"id": 230190117,
					"content": "じゃ、頼んだぞ！俺は急いで他の船の修理に行かないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230190118,
					"content": "なんで自分で行かないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190119
					]
				},
				{
					"id": 230190119,
					"content": "行きたいのは山々だが、網を引き上げにすぐ出航したいって船がいてな。そいつの修理をしなきゃならねえ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190120
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230190120,
					"content": "だから旅人、君に頼むしかないんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ラフィク"
				}
			]
		},
