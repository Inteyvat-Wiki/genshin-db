				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412140101,
					"content": "またまた来てやったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412140102,
					"content": "旅人、パイモン。来たか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140103
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412140103,
					"content": "アルベドに会うことにも慣れて来たな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140104,
						412140105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412140104,
					"content": "頼まれていたことを終わらせた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140106
					]
				},
				{
					"id": 412140106,
					"content": "ありがとう。やはりキミに頼んで正解だったようだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140107
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412140107,
					"content": "役に立てたかな？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140108
					]
				},
				{
					"id": 412140108,
					"content": "もちろん、ボクの研究に大いに役立ってくれたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140109
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412140109,
					"content": "へへ、それならよかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412140110,
					"content": "この恩は忘れない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140111
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412140111,
					"content": "剣は返すよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140112
					]
				},
				{
					"id": 412140112,
					"content": "十分、強くなっただろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412140113,
					"content": "いい感じだ。キミの体はどうかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140114
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412140114,
					"content": "普段と変わらない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140115
					]
				},
				{
					"id": 412140115,
					"content": "ならよかった。穢れや毒による副作用はないようだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140116
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412140116,
					"content": "やはり…ボクの考えは正しかったみたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140117
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412140117,
					"content": "なんでも知っているような顔しやがって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412140118,
					"content": "剣の使い心地はどうだった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140119,
						412140120
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412140119,
					"content": "よかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140121
					]
				},
				{
					"id": 412140121,
					"content": "そうか。ともかく、これでボクが求めていた状態にまで達した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140122
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412140122,
					"content": "剣を持ったぞ…アルベド、それを使うのか？バ、バカなことはやめとけ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412140123,
					"content": "キミが浄化した純粋な生命力をここから取り出す。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140124
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412140124,
					"content": "力だけを取り出せるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412140125,
					"content": "他の者にできなくても、ボクならできるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140126
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412140126,
					"content": "…よし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140127
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412140127,
					"content": "おおっ、力が光る玉みたいになって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412140128,
					"content": "不思議な瓶の中に入ったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140129
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412140129,
					"content": "この剣はもう伝説の武器ではないが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140130
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412140130,
					"content": "記念にもらってほしい。キミの冒険の手助けになるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140131,
						412140132
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412140131,
					"content": "本当にいいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140133
					]
				},
				{
					"id": 412140133,
					"content": "ボクが必要なのは実験結果だけだ。必要な物を手に入れた今、剣は扱いに長けたキミが持つべきだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140134
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412140134,
					"content": "旅人、ボクの実験を手伝ってくれて感謝しているよ。では、また。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140135
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412140135,
					"content": "ボクと共鳴する、龍の生命力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140136
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412140136,
					"content": "龍だからではない、ボクの因果だからだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140137
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412140137,
					"content": "レインドット…師匠…これがあなたの創った巨龍「ドゥリン」なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140138
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412140138,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140139
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412140139,
					"content": "ボクとこれは、果たして…出会ってもよかったものなのだろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412140132,
					"content": "もう必要ないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140133
					]
				},
				{
					"id": 412140120,
					"content": "悪かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140121
					]
				},
				{
					"id": 412140105,
					"content": "約束通り、全て終わらせた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140106
					]
				}
			]
		}
	]
}