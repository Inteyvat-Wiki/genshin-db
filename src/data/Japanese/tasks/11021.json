	"talks": [
		{
			"id": 1102102,
			"completionStepIds": [
				1102102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102102",
							"2"
						],
						"stepId": 1102102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鍾離"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110210201,
					"content": "うーん、特に変わったところはないな…価値のあるものを見つけられるだろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210202
					],
					"speakerTitle": "クリメント"
				},
				{
					"id": 110210202,
					"content": "ん？結構壮大だと思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110210203,
					"content": "景色の話じゃない…あんな大戦があった後なら何か違和感を覚えるところがあるはずなんだが、今は…どこから探せばいいかも分からんな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210204
					],
					"speakerTitle": "クリメント"
				},
				{
					"id": 110210204,
					"content": "ここは孤雲閣。魔神、もしくは魔神戦争の歴史を研究したければ、ここが最高の場所になる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210205
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110210205,
					"content": "伝説によると、岩王帝君は岩の槍を海に投げ、魔神を封印した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210206
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110210206,
					"content": "その岩の槍が長年の風化を受けて、今の景色となった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210207
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110210207,
					"content": "こんな大きい山が、岩王帝君の武器？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110210208,
					"content": "俺たちが見ているのは氷山の一角に過ぎない。あの時、帝君が投げた槍の数も体積も、これを遥かに超えている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210209
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110210209,
					"content": "ただ角度の違いや、それから海水や重力の影響でその多くは海の底に沈んだんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210210
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110210210,
					"content": "そのため、風化だけでなく最初の崩落も孤雲閣が出来上がった要因の一つとなっている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210211
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110210211,
					"content": "じゃあ…あんな桁外れの力を持った者と戦った魔神も、きっと強かったんだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210212
					],
					"speakerTitle": "クリメント"
				},
				{
					"id": 110210212,
					"content": "ああ、だから孤雲閣には研究の価値がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210213
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110210213,
					"content": "あの歴史と関係するものの多くは海に沈んだが、「渦の魔神」が大波を引き起こした影響で何かが見つかるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210214
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110210214,
					"content": "つまり、ちゃんと探せばきっと大儲けでき…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210215
					],
					"speakerTitle": "クリメント"
				},
				{
					"id": 110210215,
					"content": "コホン、収穫はあるってことだな？それなら安心だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210216
					],
					"speakerTitle": "クリメント"
				},
				{
					"id": 110210216,
					"content": "この人数なら、手分けして探した方がいいだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210217
					],
					"speakerTitle": "クリメント"
				},
				{
					"id": 110210217,
					"content": "ああ、では俺は友人と共に行くことにする。雑学は分かるが、プロの考古学者の前で恥をかくのは遠慮したいからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210218
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110210218,
					"content": "えっ？ア、アタシ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210219
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110210219,
					"content": "なんだ？あんたの本職だろ、なぜ驚く？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210220
					],
					"speakerTitle": "クリメント"
				},
				{
					"id": 110210220,
					"content": "分かったわ…で、では案内するわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210221
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110210221,
					"content": "ああ、珍しいものを見つけたら、そうだな…対岸で落ち合おう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鍾離"
				}
			]
		},
		{
			"id": 1102106,
			"completionStepIds": [
				1102106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102106",
							"2"
						],
						"stepId": 1102106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"クリメント"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110210601,
					"content": "…あんた、本当に考古学者か！？何も知らないじゃないか、本当に大丈夫なのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210602
					],
					"speakerTitle": "クリメント"
				},
				{
					"id": 110210602,
					"content": "術業に専攻有りって言うでしょ！ちゃんと説明してるじゃない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210603
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110210603,
					"content": "ケンカはやめろよ、何があったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110210604,
					"content": "こいつ、考古学者なのにこの辺りの遺跡について何も知らないんだよ！むしろ、俺の方が詳しいくらいだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210605
					],
					"speakerTitle": "クリメント"
				},
				{
					"id": 110210605,
					"content": "だから、俺の勘と経験で…価値のありそうなものを持ってくることしかできなかった。はぁ、時間の無駄だったかもしれない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210606
					],
					"speakerTitle": "クリメント"
				},
				{
					"id": 110210606,
					"content": "…アタシはずっと「塩の魔神」の研究をしてたんだから、詳しくないのも仕方ないでしょ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210607,
						110210608
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110210607,
					"content": "（学者として、確かにおかしいかも…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110210609
					]
				},
				{
					"id": 110210609,
					"content": "そっちこそ、モラのことしか聞いてこなかったじゃない！貴重な文化財の価値をモラで測ることしか知らないの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210610
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110210610,
					"content": "そ、それは…モラで言えば一番分かりやすいだろ！まさに璃月の伝統だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210611
					],
					"speakerTitle": "クリメント"
				},
				{
					"id": 110210611,
					"content": "二人とも少し落ち着け。お互い見つけた物を一緒に確認しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210612
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110210612,
					"content": "ふむ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210613
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110210613,
					"content": "そちらが見つけた物は確かに「渦の魔神」の影響で岸に上がったものだが、魔神とは関係がないな。残念だが、この海域に元々あったものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210614
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110210614,
					"content": "一方、俺たちが見つけた石板には不思議な模様がある、魔神の力も残っているな。研究に役立つと思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210615
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110210615,
					"content": "は、早くそれを俺に渡せ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210616
					],
					"speakerTitle": "クリメント"
				},
				{
					"id": 110210616,
					"content": "へヘッ、これで収穫はありだな。魔神の力、これを探してたんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210617
					],
					"speakerTitle": "クリメント"
				},
				{
					"id": 110210617,
					"content": "コホン、他のものも少しは金になると思うし、顧問料を回収できるはずだ——全部、俺のものだからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210618
					],
					"speakerTitle": "クリメント"
				},
				{
					"id": 110210618,
					"content": "魔神の力がないと、研究価値がないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210619
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110210619,
					"content": "ううん、アタシが「塩の魔神」の歴史を研究しているのは、歴史が文化と信仰を教えてくれるからよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210620
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110210620,
					"content": "あなたはお金のことしか考えてないみたいだけど！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210621
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110210621,
					"content": "馬鹿言え！俺はスネージナヤの考古学研究員だ、正真正銘な！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210622,
						110210623
					],
					"speakerTitle": "クリメント"
				},
				{
					"id": 110210622,
					"content": "（考古学で儲けたいだけなのでは…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110210624
					]
				},
				{
					"id": 110210624,
					"content": "そうだ、あのコップは売らない方がいいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210625
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110210625,
					"content": "ん？なんでだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210626
					],
					"speakerTitle": "クリメント"
				},
				{
					"id": 110210626,
					"content": "あれは凝光のコレクションで、群玉閣と共に落ちてきたんだ。七星を敵に回したくなければ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210627
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110210627,
					"content": "うっ…金になると思ったのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210628
					],
					"speakerTitle": "クリメント"
				},
				{
					"id": 110210628,
					"content": "ほら、またお金の話！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210629
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110210629,
					"content": "だったらなんだっていうんだ！研究成果も金も、どっちも得るに越したことないじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210630
					],
					"speakerTitle": "クリメント"
				},
				{
					"id": 110210630,
					"content": "さあ！ここは終わりにするぞ。そうだ「塩の魔神」、そいつには俺も興味があるんだ。次は「地中の塩」に行くか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "クリメント"
				},
				{
					"id": 110210623,
					"content": "（魔神の力を集めたいだけでは…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110210624
					]
				},
				{
					"id": 110210608,
					"content": "（初歩的な知識くらい持ってるはず…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110210609
					]
				}
