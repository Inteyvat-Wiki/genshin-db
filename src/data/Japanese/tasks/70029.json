			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ホッセイニ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700290101,
					"content": "旅人、どうだった？「プルシナスパイク」は役に立ったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290102,
						700290103
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700290102,
					"content": "大活躍した。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700290104
					]
				},
				{
					"id": 700290104,
					"content": "よくやった、苦労したかいがあったぞ。この依頼も一件落着だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290105
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700290105,
					"content": "この特異体ついては、通常の野外でよく見かける遺跡守衛や遺跡ハンターとは大きく違う。その設計は飛躍的に優れたものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290106
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700290106,
					"content": "だが、似たような設計の自律装置はそう多くはない。私が推測するには、恐らくこれはある種の実験品なのかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290107
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700290107,
					"content": "最初の設計者はどんな目的で制作したのだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290108
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700290108,
					"content": "これは…つまり古代文明の科学レベルは、学術界の想像を遥かに超えているということになるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290109
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700290109,
					"content": "もし分解して内部構造を研究できれば、きっと革命的な何かを発見できる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290110
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700290110,
					"content": "旅人、もしよかったら私を特異体の残骸まで連れて行ってくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290111
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700290111,
					"content": "もうほぼ何も残ってない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700290112
					]
				},
				{
					"id": 700290112,
					"content": "何だと？まさか、機体をバラバラに壊してしまったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290113
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700290113,
					"content": "ああ神よ…なんてもったいないことを！いや、これは大きな過ちだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290114
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700290114,
					"content": "はぁ、事前に警告しておくべきだった。私が悪い…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290115
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700290115,
					"content": "ああ残念、実に残念だ。古代技術に関する歴史的な発見になるはずだったのに…それが今、サンプルすら残ってないとは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290116,
						700290119
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700290116,
					"content": "ごめん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700290117
					]
				},
				{
					"id": 700290117,
					"content": "いいんだ。君はこの件の学術的な価値を知らない、だから責めてもしょうがない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290118
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700290118,
					"content": "私はその価値を知っている者として、君に注意するべきだった。責務を怠ったのは私だ、君の責任ではない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290121
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700290121,
					"content": "今回の現地調査は本当に大変だった。それに離島で長く滞在できなかった、せっかくの大発見を無駄にしてしまった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290122
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700290122,
					"content": "ああ、もうポジティブに考えるしかない。少なくとも「プルシナスパイク」を修理でき、その機能も検証できた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290123
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700290123,
					"content": "この様な精密機械を作ったプルシナ先輩とアイシャ先輩を心から尊敬している。彼らの偉大なる発明は、倉庫の中でほこりをかぶるだけじゃもったいない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290124
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700290124,
					"content": "今回の稲妻での研究がこれ以上進まないのなら、私は研究テーマを「プルシナスパイク」に変更する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290125
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700290125,
					"content": "もし、この研究テーマが「教令院」に注目され、私の研究論文が発表できるようになれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290126
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700290126,
					"content": "謝辞の中に君の名前を書いておくよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290127
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700290127,
					"content": "頑張って論文を理解するよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700290128
					]
				},
				{
					"id": 700290128,
					"content": "ははっ、それに向けて頑張ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290129
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700290129,
					"content": "今回は協力してくれてありがとう。君の旅が上手くいくことを願う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700290119,
					"content": "先に教えてくれていたら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700290120
					]
				},
				{
					"id": 700290120,
					"content": "私の考慮不十分が原因だ。しかし、今となってはもう遅い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290121
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700290103,
					"content": "問題はすべて解決した。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700290104
					]
				}
			]
		}
	]
}