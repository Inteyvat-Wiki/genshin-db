			"completionStepIds": [
				7002901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7002901",
							"2"
						],
						"stepId": 7002901,
						"stateName": "QUEST_STATE_UNFINISHED"
