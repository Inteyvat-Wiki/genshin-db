			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ファーラビ",
					"エドモンド"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736790101,
					"content": "旅人、来てくれたか。ふぅ…これでやっと一安心だぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736790102
					],
					"speakerTitle": "エドモンド"
				},
				{
					"id": 736790102,
					"content": "わぁ、エドモンドにファーラビ。おまえら、なんで急に雪山に来たんだ？ここで合流したいってメッセージには、すっごくびっくりしたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736790103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736790103,
					"content": "はは、ちょっと急だけど、「思いもよらない研究目標」が現れたから、どうしてもこのチャンスを逃したくなくて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736790104
					],
					"speakerTitle": "ファーラビ"
				},
				{
					"id": 736790104,
					"content": "「思いもよらない研究目標」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736790105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736790105,
					"content": "そうなんだ。エドモンドさんは、雪山のふもとで巨大な動物の足跡を見つけたことがあると言ってた。それで、ここ二日の捜索を経て、僕たちはこの辺りで同じような足跡を見つけたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736790106
					],
					"speakerTitle": "ファーラビ"
				},
				{
					"id": 736790106,
					"content": "旅人、ここには絶対とんでもなくデカい雪のイノシシが住んでいると、僕は確信してる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736790107
					],
					"speakerTitle": "ファーラビ"
				},
				{
					"id": 736790107,
					"content": "そいつの毛と血液のサンプルを入手できれば、雪のイノシシという種族の生存状況や、雪のイノシシが山のふもとに現れる原因を突き止めることにかなり役立つはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736790108
					],
					"speakerTitle": "ファーラビ"
				},
				{
					"id": 736790108,
					"content": "ってことは、今日の目標は、その巨大な雪のイノシシ狩りなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736790109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736790109,
					"content": "いや、狩りじゃない。俺たち狩人の間では、巨大な雪のイノシシはドラゴンスパインの真の主であり、狩ってはいけないという伝説があるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736790110
					],
					"speakerTitle": "エドモンド"
				},
				{
					"id": 736790110,
					"content": "でも、研究目的なら、ちょっとの間行動不能にさせるくらいなら、大丈夫だよな？ファーラビくん、しっかりやってくれよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736790111
					],
					"speakerTitle": "エドモンド"
				},
				{
					"id": 736790111,
					"content": "うん、安心してくれ。最近、モンドの収穫の季節にイノシシ襲撃が多発する状況を知って、実は色々と考えたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736790112
					],
					"speakerTitle": "ファーラビ"
				},
				{
					"id": 736790112,
					"content": "もしかしたら、イノシシというテーマを深く研究することは、みんなの問題解決にも繋げられるんじゃないかってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736790113
					],
					"speakerTitle": "ファーラビ"
				},
				{
					"id": 736790113,
					"content": "生物研究の重要な目的の一つは、そいつらと共存することだからさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736790114
					],
					"speakerTitle": "ファーラビ"
				},
				{
					"id": 736790114,
					"content": "へへ、このブリーズブリュー祭の旅では、収穫がいっぱいあったみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736790115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736790115,
					"content": "うん。美味しいお酒を飲めるだけじゃなく、親切な友人や努力する目標も見つけられた。でもまあ、感慨深い話は下山の後にしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736790116
					],
					"speakerTitle": "ファーラビ"
				},
				{
					"id": 736790116,
					"content": "旅人、あの雪のイノシシの足跡の大きさから見ると、俺は多分相手にならないからここに残る。ここはお前のようなプロにしか任せられないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736790117
					],
					"speakerTitle": "エドモンド"
				},
				{
					"id": 736790117,
					"content": "でも、あいつを呼び寄せる餌と捕獲装置を用意しといたから安心してくれ。きっと役に立つはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736790118
					],
					"speakerTitle": "エドモンド"
				},
				{
					"id": 736790118,
					"content": "うん。任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736790119
					]
				},
				{
					"id": 736790119,
					"content": "旅人、準備が出来たら、餌に火をつけて、雪の大イノシシを呼び寄せるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736790120,
						736790121
					],
					"speakerTitle": "ファーラビ"
				},
				{
					"id": 736790120,
					"content": "準備はできてる。雪の大イノシシ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 736790121,
					"content": "ちょっと待って、まだ準備できてない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736790122
					]
				},
				{
					"id": 736790122,
					"content": "大丈夫、ゆっくり準備してくれ。何せ、僕たちの相手はあのデカブツだからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ファーラビ"
				}
			]
		}
	]
}