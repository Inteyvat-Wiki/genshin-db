				]
			},
			"dialogs": [
				{
					"id": 756510101,
					"content": "旅人、最近、依頼で疲れてるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756510102,
					"content": "気遣いができる優秀なガイドとして、オイラがリラックスさせてやるぞ！ジャジャーン！ここを知ってるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510103,
						756510105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756510103,
					"content": "ダーモヴィル雑貨店。看板に書いてあるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510104
					]
				},
				{
					"id": 756510105,
					"content": "モラ泥棒のアジト、お財布の墓場…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510106
					]
				},
				{
					"id": 756510104,
					"content": "いらっしゃい。ダーモヴィル雑貨店へようこそ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510107
					],
					"speakerTitle": "ブシコー"
				},
				{
					"id": 756510106,
					"content": "お客様、それは言いすぎじゃないかな？ダーモヴィル雑貨店は安価で良質な商品が売りなんだ。値段を見ればわかるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510107
					],
					"speakerTitle": "ブシコー"
				},
				{
					"id": 756510107,
					"content": "ここはただの店じゃないぞ。がんばって働いた労働者がモラを使うことで息抜きする場所なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756510108,
					"content": "その通り。最近、「一つ買ったらもう一つおまけ」キャンペーンもやっているんだ！誰でも参加できるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510109
					],
					"speakerTitle": "ブシコー"
				},
				{
					"id": 756510109,
					"content": "買ったら店の赤字、買わなかったらお客様の損！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510110
					],
					"speakerTitle": "ブシコー"
				},
				{
					"id": 756510110,
					"content": "オイラもそのキャンペーンのポスター、見たぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756510111,
					"content": "一つ分の値段で二つの品物が手に入るなんて、どう考えてもボロ儲けだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756510112,
					"content": "ここで買い物をしなかったら、一生後悔しそうな気がして…それで今日、おまえをここに連れてきたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510113,
						756510114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756510113,
					"content": "何が欲しいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510115
					]
				},
				{
					"id": 756510114,
					"content": "後悔しないために何を買うの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510115
					]
				},
				{
					"id": 756510115,
					"content": "えへへっ、それはあとのお楽しみだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756510116,
					"content": "言ってくれないとモラは出せないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510117
					]
				},
				{
					"id": 756510117,
					"content": "フフン、今日はオイラが出すから大丈夫だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756510118,
					"content": "#オーナー、パイモンと{NICKNAME}の名前で注文したやつはもう届いてるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756510119,
					"content": "届いてるよ。少々お待ちを。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510120
					],
					"speakerTitle": "ブシコー"
				},
				{
					"id": 756510120,
					"content": "店主のブシコーは、何だかわからないほど厳重にラッピングされた商品を取り出した。パイモンはどこからか大量の小銭を取り出し、この小銭たちともうおさらばかと思ってか、名残惜しそうな表情を浮かべた。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						756510121
					]
				},
				{
					"id": 756510121,
					"content": "パイモンと一緒に分厚いラッピングを開けると、中身は二冊のアルバムだった。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 756510122,
					"content": "やっと手に入ったぜ！ずっと待ってたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756510123,
					"content": "これで、撮った写真をしまえるぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756510124,
					"content": "パイモン、写真機を使ってたことあった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510125
					]
				},
				{
					"id": 756510125,
					"content": "たまたま見てないだけだって。気づいてないところで、おまえのブサイク写真をたくさん撮ってるからな！へへっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510126,
						756510127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756510126,
					"content": "見たくなってきたかも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510128
					]
				},
				{
					"id": 756510127,
					"content": "見せて見せて！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510128
					]
				},
				{
					"id": 756510128,
					"content": "まだダメだぞ。一冊埋まったら見せてやるからさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510129,
						756510130
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756510129,
					"content": "パイモンのケチ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510131
					]
				},
				{
					"id": 756510130,
					"content": "パイモンのいじわる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510131
					]
				},
				{
					"id": 756510131,
					"content": "そんなんじゃないぞ！ほら、こっちがおまえの分な。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510132
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756510132,
					"content": "ちょっと薄いけど、それでもけっこう入ると思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510133
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756510133,
					"content": "オイラたち、今までいろんな場所で人のために写真を撮ったよな。でも、自分たちの写真はそんなに撮ってない気がするんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510134
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756510134,
					"content": "これからはもっとオイラたちの思い出を残したいなって思ってさ。それでこれを買ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510135
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756510135,
					"content": "パイモンからのプレゼントってこと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510136
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756510136,
					"content": "そうだぞ！今なら一冊買えばもう一冊もらえるから、オイラたち二人の分が揃うだろ？予約したときからそう決めてたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510137
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756510137,
					"content": "すぐ使ってくれよな！一緒に行ったとこを撮って、思い出を探してみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510138
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756510138,
					"content": "そうだ、オイラの写真機で撮ってみるか？まだ使ったことないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510139
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756510139,
					"content": "このオーダーメイド版写真機を雑貨屋に調達してもらうの大変だったんだ。使わないともったいないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510140,
						756510141
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756510140,
					"content": "使ってみるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510142
					]
				},
				{
					"id": 756510141,
					"content": "ありがとう、パイモン。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510142
					]
				},
				{
					"id": 756510142,
					"content": "おまえが気に入ってくれたんなら良かったぜ。優秀なガイドとしてあたりまえのことをやっただけだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510143
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756510143,
					"content": "ほら、一緒に写真を撮りに行こうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
}