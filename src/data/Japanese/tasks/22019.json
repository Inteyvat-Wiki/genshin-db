					"珊瑚"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220190101,
					"content": "では二人とも、頼んだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190102
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190102,
					"content": "安心して俺たちに任せてくれ、珊瑚さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190103
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220190103,
					"content": "よくも俺の目を盗んで隠れていられたな、いい度胸だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190104
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220190104,
					"content": "それに、そんな身分まで使って…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190105
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220190105,
					"content": "彼の犯行は今日で終わりよ。龍二、私が説明したこと、ちゃんと覚えているわよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190106
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190106,
					"content": "はい、所長。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190107
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220190107,
					"content": "よろしい…旅人、君も来たのね、助かるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190108,
						220190109
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190108,
					"content": "犯人を捕まえに行くの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190111
					]
				},
				{
					"id": 220190111,
					"content": "証拠は十分集めた、犯人の行動も把握している。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190112
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190112,
					"content": "旅人と龍二、そして安藤さんと天野さん、犯人を捕まえてきて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190113
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190113,
					"content": "彼にはきっと何人かの仲間がいるけれど、君がいれば心強いわ。きっと上手くいくはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190114,
						220190117
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190114,
					"content": "何をすればいいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190115
					]
				},
				{
					"id": 220190115,
					"content": "君の気迫で犯人を怯えさせて、動きを封じてくれれば十分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190116
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190116,
					"content": "こんなコソ泥に、大した行動なんてできないと思うけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190121
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190121,
					"content": "私の予想が正しければ、今頃犯人は野外に行って、窃盗品を地中に埋める準備をしているはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190122
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190122,
					"content": "今駆け付ければ、ちょうど犯人と盗品の両方を確保できる。早く出発して、私はここでいい知らせを待っているから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190117,
					"content": "一緒に行かないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190118
					]
				},
				{
					"id": 220190118,
					"content": "私にとって、この事件はもう解決済みよ。残作業に手を加えないようにするわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190119
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190119,
					"content": "旅人、君の気迫で犯人を怯えさせて、動きを封じてくれれば十分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190120
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190120,
					"content": "こんなコソ泥に、大した行動なんてできないと思うけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190121
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190109,
					"content": "もうすぐ解決するの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190110
					]
				},
				{
					"id": 220190110,
					"content": "ええ、もし順調にいけば、今日で事件解決よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190111
					],
					"speakerTitle": "珊瑚"
				}
			]
		},
		{
			"id": 2201902,
			"completionStepIds": [
				2201903
			],
