					"龍二"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220190201,
					"content": "彼を発見しました。予想通り、盗品を埋めているようです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190202,
						220190204
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220190202,
					"content": "行こう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190203
					]
				},
				{
					"id": 220190203,
					"content": "待ってください、旅人。今は…まだ好機ではありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190206
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220190206,
					"content": "もう少し…よし…もうそろそろです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190207
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220190207,
					"content": "おいお前、なにしてるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190208
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220190208,
					"content": "手にしているものを捨てろ、そして動くな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190209
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220190209,
					"content": "き、君たちは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190210
					],
					"speakerTitle": "石川八郎"
				},
				{
					"id": 220190210,
					"content": "ちくしょう…ボサっとしてるんじゃない！この二人をやっちまえ、絶対に逃げ切るんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190211
					],
					"speakerTitle": "石川八郎"
				},
				{
					"id": 220190211,
					"content": "宝盗団ごときが、調子に乗りやがって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190212
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220190212,
					"content": "安藤さん、天野さん、手伝いに来ました！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190213
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220190213,
					"content": "おう！じゃあ頼んだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190214
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220190214,
					"content": "旅人、もう行動しても良いようです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190215
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220190215,
					"content": "そんな面倒なことにしなくても…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190216
					]
				},
				{
					"id": 220190216,
					"content": "全ては所長の指示です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190217
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220190217,
					"content": "よし、行きましょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龍二"
				},
				{
					"id": 220190204,
					"content": "捕まえる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190205
					]
				},
				{
					"id": 220190205,
					"content": "待ってください。今は…まだ好機ではありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190206
					],
					"speakerTitle": "龍二"
				}
			]
		},
		{
			"id": 2201903,
			"completionStepIds": [
				2201905
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
