			},
			"dialogs": [
				{
					"id": 220190601,
					"content": "今駆け付ければ、ちょうど犯人と盗品の両方を確保できる。早く出発して、私はここでいい知らせを待っているから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190602
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190602,
					"content": "旅人、ほかに何か用？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190603,
						220190607
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190603,
					"content": "機嫌悪そうだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190604
					]
				},
				{
					"id": 220190604,
					"content": "つまらない事件とつまらない犯人。犯行の手口もいたって普通、ただの小細工だわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190605
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190605,
					"content": "今回の事件を評価するとしたら…「つまらない」って言葉しか思い付かない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190606
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190606,
					"content": "しかしつまらないとは言え、犯罪なんだから、解決できてよかったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190607,
					"content": "一緒に行かないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190608
					]
				},
				{
					"id": 220190608,
					"content": "私にとって、この事件はもう解決済みよ。残作業に手を加えないようにするわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190609
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190609,
					"content": "それに、私は戦闘が苦手だから、犯人に人質にされたら、逆に足手まといになってしまう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190610
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190610,
					"content": "私は自分の力をきちんと理解しているの。だから犯人を捕まえる仕事は、君たちに任せる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚"
				}
			]
		}
	]
}