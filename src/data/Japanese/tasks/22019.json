						],
						"stepId": 2201905,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"龍二"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220190301,
					"content": "これで犯人と盗品の両方を確保できたな。龍二、そして旅人、ありがとう。ご苦労様。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190302
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220190302,
					"content": "俺と天野はこいつらを奉行所に連れて帰る予定だ、残りのことは任せてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190303
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220190303,
					"content": "しかし、珊瑚ってすごいな。これほど正確に犯人を探し出してみせるとは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190304
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220190304,
					"content": "ああ、あの珊瑚だからな。こんな事件、彼女にとって朝飯前だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190305
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220190305,
					"content": "じゃあ龍二、俺たちは先に奉行所に戻る。こいつの件を処理したら、また改めて礼をしに行くからよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190306
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220190306,
					"content": "どういたしまして、気を付けて帰ってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190307
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220190307,
					"content": "旅人、僕たちも戻って所長に報告しましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龍二"
				}
			]
		},
		{
			"id": 2201904,
			"completionStepIds": [
				2201906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201906",
							"2"
						],
						"stepId": 2201906,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"珊瑚"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220190401,
					"content": "今頃、安藤さんと天野さんは、犯人を連れて奉行所に戻ったはずです。事の経緯は以上です、所長。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190402
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220190402,
					"content": "ええ、分かった。解決してよかったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190403
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190403,
					"content": "旅人、君もご苦労様。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190404,
						220190405
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190404,
					"content": "本当に…これで解決したの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190406
					]
				},
				{
					"id": 220190406,
					"content": "結局、犯人を連れて帰ったのは天野と安藤だから、そう感じるのもおかしくないわ。ほら、報酬を受け取って、そうすれば、多少は「実感」できるんじゃないかしら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190407,
						220190409
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190407,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYSECOND|INFO_FEMALE_PRONOUN_GIRLSECOND]}の報酬は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190408
					]
				},
				{
					"id": 220190408,
					"content": "私？私は奉行所の方々の力になれたし、この町に平和を取り戻すことができたわ。それが私にとって一番の報酬なのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190412
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190412,
					"content": "実を言うと、今回は「収穫なし」だったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190413
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190413,
					"content": "斬新な犯罪手法を見つけることもなかったし、犯罪に対する真新しい理念も聞けなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190414
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190414,
					"content": "結局、つまらない事件だったわ。幸いなことに、それほど手間はかからなかったし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190415,
						220190417
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190415,
					"content": "珊瑚所長…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190416
					]
				},
				{
					"id": 220190416,
					"content": "あら？私のように「犯罪」に興味を抱く人間は、初めてかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190419
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190419,
					"content": "「犯罪」への興味は、私が探偵になった理由でもある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190420
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190420,
					"content": "#…{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYSECOND|INFO_FEMALE_PRONOUN_GIRLSECOND]}も「犯罪」がしたいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190421
					]
				},
				{
					"id": 220190421,
					"content": "ええ。私は完璧で隙のない「犯罪」を犯してみたいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190422
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190422,
					"content": "しかし、残念なことに…ほとんどの場合、人が犯罪を犯す時には痕跡が残ってしまう。そうなると、解決は時間の問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190423,
						220190424,
						220190425
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190423,
					"content": "人以外の場合は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190426
					]
				},
				{
					"id": 220190426,
					"content": "ほら、君も知らず知らずのうちに「犯罪」について考え出した。そうでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190427
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190427,
					"content": "不安になる必要はないわ、君はただ考えているだけだもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190428
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190428,
					"content": "私もよく「犯罪」について考えているの。例えば、犯行の手段や理由…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190429
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190429,
					"content": "何のために？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190430
					]
				},
				{
					"id": 220190430,
					"content": "もちろん、事件を素早く解決するためよ。最近の事件は以前よりも複雑で、知恵を絞らないといけないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190431
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190431,
					"content": "しかし、いずれも「完全犯罪」と呼べるものはなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190432
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190432,
					"content": "「完全犯罪」を見たことあるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190433
					]
				},
				{
					"id": 220190433,
					"content": "あるわ。あの「完全犯罪」…本当の犯人はまた捕まっていないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190434
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190434,
					"content": "でも、犯行時には必ず痕跡が残る。私はただ、まだその痕跡に気付いていないだけだと思うの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190435
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190435,
					"content": "さて、話はこれくらいにして。旅人、約束してた報酬を受け取って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190436
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190436,
					"content": "暇があったら遊びに来てね。暇がなかったら…うん…それでも構わないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190437
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190437,
					"content": "勘が教えてくれてるの、私たちはいずれまた手を組むってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190424,
					"content": "犯人が存在しない場合は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190426
					]
				},
				{
					"id": 220190425,
					"content": "どうやって全ての痕跡を消すの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190426
					]
				},
				{
					"id": 220190417,
					"content": "これが「探偵」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190418
					]
				},
				{
					"id": 220190418,
					"content": "探偵の全員がこう考えてるわけでもないわ。でも私は、「犯罪」に対して強い興味があるのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190419
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190409,
					"content": "何もいらないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190410
					]
				},
				{
					"id": 220190410,
					"content": "私は「正義」を貫けたから、もう十分。それ以外の欲しいものはないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190411
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190411,
					"content": "…それとも、言い方を変えた方がよかったかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190412
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190405,
					"content": "終わった感じがしない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190406
					]
				}
			]
		},
