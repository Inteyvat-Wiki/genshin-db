			"dialogs": [
				{
					"id": 726750601,
					"content": "次は吉法師を連れて死兆星号に乗ろう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750602
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726750602,
					"content": "やだ。船が沈んじゃう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750603
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726750603,
					"content": "この船は沈まないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750604
					]
				},
				{
					"id": 726750604,
					"content": "この船で稲妻まで行ったから安心して。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750605
					]
				},
				{
					"id": 726750605,
					"content": "そうだぞ！この船のおかげで五百蔵や吉法師と知り合うことができたんだ。だから心配無用だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750606
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726750606,
					"content": "おぉ！そうだったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750607
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726750607,
					"content": "それに北斗はとても頼りになるし、南十字の人たちだってそうだ。だからこの船は、海の上では一番安全な場所なんだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750608
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726750608,
					"content": "ぬ！分かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「吉法師」"
				}
			]
		},
