			"dialogs": [
				{
					"id": 722641401,
					"content": "ぬ！修行は楽しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641402,
						722641412
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722641402,
					"content": "そうこなくっちゃ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722641403
					]
				},
				{
					"id": 722641403,
					"content": "金髪、とても強い。ぽんぽこしたら、大きくて丸いのが消えた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641404
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722641404,
					"content": "普段から鍛練してるからね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722641405
					]
				},
				{
					"id": 722641405,
					"content": "ぬ！金髪みたいに強くなりたい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641406
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722641406,
					"content": "だから修行修行、もっと強くなる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641407
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722641407,
					"content": "吉法師は強くなったら、何がしたいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722641408
					]
				},
				{
					"id": 722641408,
					"content": "刑部小判に復讐する、ぬはは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641409
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722641409,
					"content": "それから、五百蔵を石じゃなくす。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641410
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722641410,
					"content": "頑張って。修行する場所は任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722641411
					]
				},
				{
					"id": 722641411,
					"content": "ぬ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722641412,
					"content": "そうこなくっちゃ。じゃあまたね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722641413
					]
				},
				{
					"id": 722641413,
					"content": "イェーイ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「吉法師」"
				}
			]
		},
		{
