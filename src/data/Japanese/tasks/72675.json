			"dialogs": [
				{
					"id": 726750801,
					"content": "見ろ！いい眺めだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750802
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726750802,
					"content": "ぬ、すごい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750803
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726750803,
					"content": "山がいっぱい。あそこはどんなところ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750804
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726750804,
					"content": "ん？あそこは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750805,
						726750806
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726750805,
					"content": "稲妻だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750807
					]
				},
				{
					"id": 726750807,
					"content": "あそこはきっと影向山だ。影向山のふもとが、鎮守の森だぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750808
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726750808,
					"content": "遠い。五百蔵は、海の向こう側。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750809
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726750809,
					"content": "そうだぞ。でもオイラたちが修行に付き合ってやるからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750810
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726750810,
					"content": "うん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750811
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726750811,
					"content": "次はどこに行けばいいんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750812
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726750812,
					"content": "オイラたちがよく知ってて、美味しいものが食べられる場所は無いか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750813,
						726750817
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726750813,
					"content": "パイモンは食べ物のことしか頭にないね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750814
					]
				},
				{
					"id": 726750814,
					"content": "美味しいもの、よし！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750815
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726750815,
					"content": "さすが吉法師、よく分かってるな。世にある美味しいものを食べ回ることだって、大事な修行のうちだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750816
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726750816,
					"content": "おまえもそれくらい分かってないと、吉法師に追い越されちゃうぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750818
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726750818,
					"content": "それにしても、マストに登るのは疲れるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750819
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726750819,
					"content": "登る？白髪は飛べるのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750820
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726750820,
					"content": "細かいことにツッコむな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750821
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726750821,
					"content": "とりあえず今日はこの辺にしておこう。次はどこに行くか、考えないとな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750822
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726750822,
					"content": "ぬ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726750817,
					"content": "#そう言ってるうちに{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}もお腹が空いてきた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750818
					]
				},
				{
					"id": 726750806,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYSECOND|INFO_FEMALE_PRONOUN_GIRLSECOND]}が住んでるところ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750807
					]
				}
			]
		}
