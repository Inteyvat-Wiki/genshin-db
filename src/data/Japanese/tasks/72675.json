			},
			"dialogs": [
				{
					"id": 726750101,
					"content": "雪山と違う。寒くないし、雪もない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750102
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726750102,
					"content": "ここは孤雲閣だ！伝説によると岩王帝君が倒したあの…頭がいっぱいある、でっかい水蛇…えっと、なんて名前だっけ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750103,
						726750104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726750103,
					"content": "渦の魔神？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750105
					]
				},
				{
					"id": 726750105,
					"content": "それだ！渦の魔神オセル！当時、そいつはこの地で石槍にやられて、鎮圧されたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726750106,
					"content": "うわぁ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750107
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726750107,
					"content": "へへん、すごいだろ？オイラたちもあいつと戦ったことがあるんだぞ！凝光の群玉閣で…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726750108,
					"content": "金色の晶蝶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750109
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726750109,
					"content": "そっちかよ！ちゃんと人の話を聞けよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726750110,
					"content": "稲妻にいる晶蝶と違うからね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750111
					]
				},
				{
					"id": 726750111,
					"content": "紫色以外の晶蝶を見たことないんだと思う…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750112
					]
				},
				{
					"id": 726750112,
					"content": "#そうかもな…だったらしょうがないか。{NICKNAME}、吉法師に晶蝶を獲ってやれよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750113,
						726750115,
						726750117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726750113,
					"content": "どうしてパイモンがやらないの。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750114
					]
				},
				{
					"id": 726750114,
					"content": "お、おまえの方が慣れてるだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726750118,
					"content": "いいけど、晶核しか手に入らないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750119
					]
				},
				{
					"id": 726750119,
					"content": "やったー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726750115,
					"content": "パイモンは飛べるのに。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750116
					]
				},
				{
					"id": 726750116,
					"content": "でも、晶蝶を捕まえるのはおまえの方が慣れてるだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726750117,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750118
					]
				},
				{
					"id": 726750104,
					"content": "オセル？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750105
					]
				}
			]
		},
