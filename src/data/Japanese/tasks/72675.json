				"points": []
			},
			"dialogs": [
				{
					"id": 726750401,
					"content": "見ろよ、死兆星号だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726750402,
					"content": "すごい！水がいっぱい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750403
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726750403,
					"content": "大きい！しかも水の上にある！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750404
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726750404,
					"content": "大きいものは、きっと重たい。どうして沈まないの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750405
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726750405,
					"content": "死兆星号は船だからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726750406,
					"content": "でも泥船は沈むよ。兎と妖狸と泥船の物語。五百蔵が教えてくれたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750407
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726750407,
					"content": "うん…でも北斗の死兆星号は泥で作られた船じゃないから、沈まないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726750408,
					"content": "どうして、泥じゃなかったら沈まないの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750409
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726750409,
					"content": "随分すらすら話せるようになってきたな…でもなんて説明したらいいか…そうだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750410
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726750410,
					"content": "#へへっ、{NICKNAME}にクイズだ。船はどうして水に浮かぶんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750411,
						726750414
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726750411,
					"content": "船は木でできていて、草元素は凄いから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750412
					]
				},
				{
					"id": 726750412,
					"content": "え？草元素にはそんな特性があるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726750413,
					"content": "じゃあ…盾を持ったヒルチャールはどうして水に浮かぶことができないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750416
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726750416,
					"content": "うぬぬ、よく分からない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750417
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726750417,
					"content": "大丈夫だ。大きくなってオイラみたいに賢くなれば、吉法師も理解できるようになるぞ。船はどうして浮くのか、雪山にはどうして雪が降るのか、全部分かるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750418,
						726750420,
						726750421
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726750418,
					"content": "パイモンも分かってないでしょ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750419
					]
				},
				{
					"id": 726750419,
					"content": "おい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750422
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726750422,
					"content": "死兆星号がよく見える場所まで来たぞ！ここで吉法師に写真を撮ってやろうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750423
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726750423,
					"content": "写真！撮る！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750424
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726750424,
					"content": "そうそう！吉法師はそこで大人しく立ってろよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726750420,
					"content": "今は分からなくても大丈夫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750422
					]
				},
				{
					"id": 726750421,
					"content": "分からないことがあってもいい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750422
					]
				},
				{
					"id": 726750414,
					"content": "浮力が重力より大きいから船は水に浮かぶ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750415
					]
				},
				{
					"id": 726750415,
					"content": "そうだったのか！なるほど、目から鱗だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750416
					],
					"speakerTitle": "パイモン"
				}
			]
		},
