					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726750302,
					"content": "金色じゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750303
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726750303,
					"content": "えっ！金色じゃないのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750304,
						726750305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726750304,
					"content": "そう言われても…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750306
					]
				},
				{
					"id": 726750306,
					"content": "考えてみたら、これまで晶蝶をたくさん捕まえてきたけど、全く気にしたことなかったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726750307,
					"content": "なんだか…大人になって急に夢が打ち砕かれたみたいな気持ちだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726750308,
					"content": "パイモンにも修行が必要だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750309
					]
				},
				{
					"id": 726750309,
					"content": "白髪、がんばれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750310
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726750310,
					"content": "もう、オイラはいいから。修行が必要なのは吉法師だろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726750311,
					"content": "でもやっぱりちょっと、がっかりだよな…どうして岩晶蝶の晶核は金色じゃないんだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726750312,
					"content": "晶蝶は金色。どうしてこれは金色じゃないの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750313,
						726750314
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726750313,
					"content": "晶蝶はそういう生き物なのかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750315
					]
				},
				{
					"id": 726750315,
					"content": "まあしょうがないよな。とりあえず計画通りに進もうぜ。吉法師に死兆星号を見せてやるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726750314,
					"content": "知らないよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750315
					]
				},
				{
					"id": 726750305,
					"content": "打つ手なし。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750306
					]
				}
			]
		},
