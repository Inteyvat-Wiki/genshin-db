						],
						"pointId": 6836
					}
				]
			},
			"dialogs": [
				{
					"id": 741420401,
					"content": "#あれ、{NICKNAME}{M#お兄さん}{F#お姉さん}…さっき会ったばかりだよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420402
					],
					"speakerTitle": "カノティラ"
				},
				{
					"id": 741420402,
					"content": "いつのこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420403
					]
				},
				{
					"id": 741420403,
					"content": "えっと、ぼくにもよく分からないけど…だって、こんな場所じゃ時間なんて分からないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420404
					],
					"speakerTitle": "カノティラ"
				},
				{
					"id": 741420404,
					"content": "カノティラ、一緒に行こう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420405
					]
				},
				{
					"id": 741420405,
					"content": "ここは普通じゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420406
					]
				},
				{
					"id": 741420406,
					"content": "でも、普通か普通じゃないかは、ぼくたちが決めることだよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420407
					],
					"speakerTitle": "カノティラ"
				},
				{
					"id": 741420407,
					"content": "あ…別に他の意味があるわけじゃないよ。ただ、ここはぼくにとって本当にいい場所なんだ。だってほら、生気や色彩に満ちている。あっちの世界ではこんな景色を見たことがない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420408
					],
					"speakerTitle": "カノティラ"
				},
				{
					"id": 741420408,
					"content": "ヒマワリを一輪見たくらいだけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420409
					]
				},
				{
					"id": 741420409,
					"content": "本当に？あぁ！それはどこで？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420410
					],
					"speakerTitle": "カノティラ"
				},
				{
					"id": 741420410,
					"content": "前に子犬に会った場所。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420411
					]
				},
				{
					"id": 741420411,
					"content": "よし！なら先に行ってるね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420412
					],
					"speakerTitle": "カノティラ"
				},
				{
					"id": 741420412,
					"content": "待って…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
