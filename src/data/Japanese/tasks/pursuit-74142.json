					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741421404,
					"content": "…ならいいんだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421405
					]
				},
				{
					"id": 741421405,
					"content": "#よーし！諸悪の根源も戻ってきたな。カノティラ、おまえ{NICKNAME}をすごく心配させたんだからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741421406,
					"content": "えっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421407
					],
					"speakerTitle": "カノティラ"
				},
				{
					"id": 741421407,
					"content": "ぐす、ごめんなさい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421408
					],
					"speakerTitle": "カノティラ"
				},
				{
					"id": 741421408,
					"content": "えっ？えーと…別に責めてるわけじゃないんだぞ！だから泣くなってカノティラ。美味しいものやるからさ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421409
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741421409,
					"content": "（何があったんだよ？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421410
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741421410,
					"content": "（中で危険な目に遭った。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421411
					]
				},
				{
					"id": 741421411,
					"content": "（そっか…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421412
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741421412,
					"content": "ほらほら、泣くなって！カノティラは勇敢だろ！オイラの一番好きな鳥肉と野生キノコの串焼きをご褒美にやるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741421413,
					"content": "ひっく…ありがとう、パイモン…はむっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421414
					],
					"speakerTitle": "カノティラ"
				},
				{
					"id": 741421414,
					"content": "（もぐもぐ）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421415
					],
					"speakerTitle": "カノティラ"
				},
				{
					"id": 741421415,
					"content": "う～ん、変わった味だね。これが人間の食べるご飯なのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421416
					],
					"speakerTitle": "カノティラ"
				},
				{
					"id": 741421416,
					"content": "なんだって！？食べないならオイラに返せよなっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421417
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741421417,
					"content": "#でも…ありがとうパイモン。それから{NICKNAME}{M#お兄さん}{F#お姉さん}も、助けてくれてありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421418
					],
					"speakerTitle": "カノティラ"
				},
				{
					"id": 741421418,
					"content": "これからどうするの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421419
					]
				},
				{
					"id": 741421419,
					"content": "分からない。でも、もう二度と本は読みたくないかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421420
					],
					"speakerTitle": "カノティラ"
				},
				{
					"id": 741421420,
					"content": "…カノティラ、そこまでしなくてもいいんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421421
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741421421,
					"content": "うん…でも「啓示の書」は本当に恐ろしいから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421422
					],
					"speakerTitle": "カノティラ"
				},
				{
					"id": 741421422,
					"content": "（つまり、結局なにがあったんだ？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421423
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741421423,
					"content": "（どう説明したらいいか…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421424,
						741421425
					]
				},
				{
					"id": 741421424,
					"content": "（行ってみないと分からないよ。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421426
					]
				},
				{
					"id": 741421426,
					"content": "（なんだよ！モヤモヤするなぁ…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421427
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741421427,
					"content": "…とにかく、ぼくはもうここにいる必要はないし、みんなと一緒にメリュシー村で暮らすよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421428
					],
					"speakerTitle": "カノティラ"
				},
				{
					"id": 741421428,
					"content": "それがいいぞ！ほかのメリュジーヌが優しくしてくれるって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421429
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741421429,
					"content": "#うん。ありがとう、{NICKNAME}{M#お兄さん}{F#お姉さん}にパイモン。",
