			},
			"dialogs": [
				{
					"id": 741420701,
					"content": "#あ、{NICKNAME}{M#お兄さん}{F#お姉さん}。あれ、パイモンは一緒じゃないの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420702
					],
					"speakerTitle": "カノティラ"
				},
				{
					"id": 741420702,
					"content": "あの裂け目…何を見てるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420703
					]
				},
				{
					"id": 741420703,
					"content": "えっ？裂け目って何のことだい。鏡じゃないの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420704
					],
					"speakerTitle": "カノティラ"
				},
				{
					"id": 741420704,
					"content": "まぁ…確かに、ぼくには探しているものがあるけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420705
					],
					"speakerTitle": "カノティラ"
				},
				{
					"id": 741420705,
					"content": "ずっと「謎鏡」の手がかりを探していてね…絵のようなもので、啓示の書と同じように「瞑想」が可能なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420706
					],
					"speakerTitle": "カノティラ"
				},
				{
					"id": 741420706,
					"content": "四象限と「ゲシュタル塔」の絵について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420707
					]
				},
				{
					"id": 741420707,
					"content": "#…そっか、そんなところにあったんだね。よし！ありがとう、{NICKNAME}{M#お兄さん}{F#お姉さん}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カノティラ"
				}
			]
		},
