			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"レイラ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400860101,
					"content": "旅人、パイモン、ポコポコビーニー。ここだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860102
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400860102,
					"content": "レイラ！この数日間、テンテンヨーヨー獣と楽しく過ごせたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400860103,
					"content": "もちろん！テンテンヨーヨー獣が荷物を運んでくれたおかげで、遠くまでキャンプに行って、いつもと違う星空を見れたんだ。それに、論文も進められたの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860104
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400860104,
					"content": "でも、小麦粉とかに咳き込みながらリストにあったものをほぼ全部作ってあげたんだけど…それでもテンテンヨーヨー獣の好物が見つからなくて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860105
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400860105,
					"content": "改良後の「叡智宝珠」では、直接キノコンと会話できればいいのにな…うん！このことも手紙に書いて、生論派のベテラン学者に頼んでみるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860106
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400860106,
					"content": "レイラ、今までになくやる気みたいだぞ！こんなに話したのに、まだ元気そうじゃないか…仲間のためなら、そこまでできるんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400860107,
					"content": "うー、でも消耗しすぎた…早く八重お姉さんと合流しよう。じゃないと…また力が抜けちゃうかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "レイラ"
				}
			]
		},
		{
			"id": 4008602,
			"completionStepIds": [
				4008602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008602",
							"2"
						],
						"stepId": 4008602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"八重神子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400860201,
					"content": "おや？随分と早いのう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860202
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400860202,
					"content": "神子、もう帰るのか？スメールでそんなに遊んでないんじゃないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400860203,
					"content": "いいや、とっくに満喫したぞ。おかげで、今回の取材は順調じゃった。貴重なバトルでの経験を手に入れた上、陰謀を暴く素晴らしい劇まで観られたからのう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860204
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400860204,
					"content": "左右加にはオリジナルキャラを捨ててもらって、次は汝らを主人公にした小説でも書いてもらおうかのう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860205,
						400860206
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400860205,
					"content": "#{M#君}{F#あなた}も裏で動いてた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400860207
					]
				},
				{
					"id": 400860207,
					"content": "そうだ！ようやくわかったぞ！神子は何度もヒントをくれてたよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400860208,
					"content": "もっと早くエルヒンゲンの陰謀を暴けたはずなのに、どうして遠回りしてたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400860209,
					"content": "初めに真相を突き止めてしもうたら、興ざめじゃろ？汝らがこの局面をどう打破するか、見てみたかったんじゃ。結果から見れば、とんでもない驚きの連続じゃった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860210
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400860210,
					"content": "最初、妾は汝らとキノコンの物語は「主」と「従者」から展開すると思っておった。じゃが汝らは、もっとよい答えを導き出した…それは平等な契りである、「仲間」という概念じゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860211
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400860211,
					"content": "別の角度から考えれば…いつも「主」のことを考えるエルヒンゲンが、汝らに敵わなかったのも当然じゃな。まあ、あやつの腕なら、しばらくは騒ぎが止まんじゃろうが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860212
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400860212,
					"content": "う、またついていけなくなったぞ…今度は神子の言葉をメモして、帰ってしっかり研究しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400860213,
					"content": "さて、世間話はここまでじゃ…百雷遮羅のことは頼んだぞ。こやつの面倒を見てやってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860214
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400860214,
					"content": "汝らとハニヤーはますます頑張らんとな。こんなに面白い大会が続くかどうかは、汝らの努力にかかっておる。ちょっとは楽しみにしておるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400860206,
					"content": "エルヒンゲンが怪しいって分かってたんでしょ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400860207
					]
				}
			]
		},
		{
			"id": 4008603,
			"completionStepIds": [
				4008603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008603",
							"2"
						],
						"stepId": 4008603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ハニヤー",
					"レイラ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400860301,
					"content": "来たか、時間はピッタリだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860302
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400860302,
					"content": "他の出場選手の「叡智宝珠」を集めて、キノコンの仲間に相応しい生息地を選んだわ。周囲の生態環境に影響を及ぼすこともない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860303
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400860303,
					"content": "さあ、皆に挨拶して、「喜炎」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860304
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400860304,
					"content": "「喜炎」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400860305
					]
				},
				{
					"id": 400860305,
					"content": "「炎1」の新しい名前なの。最初この子と出会った時…あまりにも大人しかったから、内心、喜んだ気持ちがあった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860306
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400860306,
					"content": "私が偏見を取り去り、自分の本当の心に向き合って、キノコンを憎まずにいられたら…この気持ちもずっと続くでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860307
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400860307,
					"content": "ハニヤーさん、心のわだかまりがやっと解けたんだね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860308
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400860308,
					"content": "そう来なくっちゃ！炎1って名前にちょっと慣れちゃってたけど、この新しい名前はもっと深い意味があるよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860309,
						400860310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400860309,
					"content": "よかったね、ハニヤー。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400860311
					]
				},
				{
					"id": 400860311,
					"content": "一番厳しく自分を律して、この優しいキノコンたちを必ず大切にするから…仲間を安心して私に託して。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860312
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400860312,
					"content": "もう別れの時だね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860313
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400860313,
					"content": "さようなら、テンテンヨーヨー獣。ハニヤーさんの言うことをちゃんと聞くんだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860314
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400860314,
					"content": "百雷遮羅、今度「テイマー大会」が開催されることになったら、神子はきっとおまえを見に来るぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860315
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400860315,
					"content": "ポコポコビーニー…もう一回ハイタッチしようぜ！短い間だったけど楽しかった。おまえも楽しく生きて、オイラたちと再会できる日を楽しみにしろよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860316
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400860316,
					"content": "きっとまた会える！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400860317
					]
				},
				{
					"id": 400860317,
					"content": "人とキノコンが共存できる日が早く来ることを願っているわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860318
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400860318,
					"content": "信じてるわよ！君たちの朗報を待ってるから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400860310,
					"content": "喜炎も、よかったね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400860311
					]
				}
			]
		}
	]
}