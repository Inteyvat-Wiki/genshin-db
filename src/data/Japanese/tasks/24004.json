			"dialogs": [
				{
					"id": 240040201,
					"content": "…このページ、もう読んだっけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040202,
						240040203
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240040202,
					"content": "本を…読んでるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040204
					]
				},
				{
					"id": 240040204,
					"content": "#わっ、{M#お兄さん}{F#お姉さん}？こんなに早く来るなんて。まだ本を開いたばかりですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040205
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240040205,
					"content": "この本はロウのお父さんがわざわざ俺に届けてくれたんです。それに、わからない所があったら聞いてもいいって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040206
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240040206,
					"content": "でも…はは、本当のところを言うと、この本はほとんど理解できないんですよね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040207
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240040207,
					"content": "ま、とにかく…俺は先に集合場所に行きますね。見つかっちゃった以上、かくれんぼのルールは守らないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240040203,
					"content": "いつも勉強を忘れないんだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040204
					]
				}
			]
		},
