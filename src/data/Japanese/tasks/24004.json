			"dialogs": [
				{
					"id": 240040501,
					"content": "なんだよ…なんでそんなにじっと見つめるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040502
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240040502,
					"content": "おにいちゃん…またどこかに隠れてこっそり本を読んでたんじゃないの？もっとちゃんと遊んでよぅ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040503
					],
					"speakerTitle": "ヴェルー"
				},
				{
					"id": 240040503,
					"content": "そうよ、せっかくの機会なんだから真剣にやりなさいよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040504
					],
					"speakerTitle": "ロウ"
				},
				{
					"id": 240040504,
					"content": "いい隠れ場所は二人に取られちゃったし、俺はかくれんぼなんてそんなに得意じゃないし…だったら本を読んで時間をつぶすしかないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040505
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240040505,
					"content": "フンだ！おにいちゃんのウソつき！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040506
					],
					"speakerTitle": "ヴェルー"
				},
				{
					"id": 240040506,
					"content": "ふんっ！本の虫ってやつね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040507
					],
					"speakerTitle": "ロウ"
				},
				{
					"id": 240040507,
					"content": "ゆ、許してくれよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040508,
						240040509
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240040508,
					"content": "許してあげなよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040510
					]
				},
				{
					"id": 240040510,
					"content": "えへへっ！ロウってかくれんぼがすごく上手なんだ。面白い隠れ場所をたくさん知ってるんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040517
					],
					"speakerTitle": "ヴェルー"
				},
				{
					"id": 240040517,
					"content": "へへへ、ロウが一緒に遊んでくれるし、ここもなかなか面白いなぁ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040511
					],
					"speakerTitle": "ヴェルー"
				},
				{
					"id": 240040511,
