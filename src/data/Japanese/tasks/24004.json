				"points": []
			},
			"dialogs": [
				{
					"id": 240040101,
					"content": "おにいちゃん！あそこに隠れようよ。きっと僕たち、見つからないでいられるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040102
					],
					"speakerTitle": "ヴェルー"
				},
				{
					"id": 240040102,
					"content": "ヴェルー、勝手に行くなって！はぐれたら家に帰れなくなっちゃうだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040103,
						240040104
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240040103,
					"content": "どうしてここに？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040105
					]
				},
				{
					"id": 240040105,
					"content": "#わあ、{M#おにいちゃん}{F#おねえちゃん}！ねえ一緒にかくれんぼしようよ！ロウはもう隠れちゃったよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040106
					],
					"speakerTitle": "ヴェルー"
				},
				{
					"id": 240040106,
					"content": "ロウについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040107
					]
				},
				{
					"id": 240040107,
					"content": "その話はあと！早く早く！ロウはここに詳しいんだもん…もっといい隠れ場所を見つけないと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040108
					],
					"speakerTitle": "ヴェルー"
				},
				{
					"id": 240040108,
					"content": "ヴェルーはすごい速さで走り去ってしまった…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240040109
					]
				},
				{
					"id": 240040109,
					"content": "はぁ、ヴェルーのやつ…いっつも言うこと聞かないんだよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040110
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240040110,
					"content": "すみません、もう一回俺たちと遊んでくれませんか？なぜだか、ヴェルーがすごく興奮しちゃってて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040111,
						240040114
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240040111,
					"content": "新しい仲間ができたからかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040112
					]
				},
				{
					"id": 240040112,
					"content": "そうなんだと思います。でもまあ、ヴェルーが楽しく過ごせるならそれでいいんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040113
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240040113,
					"content": "でも…はぁ…興奮しすぎて、ロウと一緒に変な場所に隠れたりしてないだろうな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040118
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240040118,
					"content": "#{M#お兄さん}{F#お姉さん}、申し訳ないんですけど、また一緒に俺たちと遊んでくれませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040119
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240040119,
					"content": "ヴェルーのやつがスネるといけないから、俺も隠れる場所を探さないと。こんな街のど真ん中で泣かれたら、どうしようもないし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040120
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240040120,
					"content": "オーレルは立ち去った…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 240040114,
					"content": "ロウについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040115
					]
				},
				{
					"id": 240040115,
					"content": "さっき知り合った女の子です。俺たちがかくれんぼしてるのを見て、一緒に遊びたいって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040116
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240040116,
					"content": "彼女はヴェルーと性格が似てるし、仲良くしてくれてるみたいです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040117
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240040117,
					"content": "それに…あの子もお父さんが忙しくてあまり遊んでくれないって言ってました。その点は俺たちと似てるかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040118
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240040104,
					"content": "またかくれんぼしてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040105
					]
				}
			]
		},
		{
			"id": 2400402,
