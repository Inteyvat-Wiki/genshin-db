				{
					"id": 240040301,
					"content": "#うわぁ！{M#おにいちゃん}{F#おねえちゃん}は見つけるのが上手いね！隠れ場所を変えようと思ってたところだったのになぁ…",
					"roleType": "TALK_ROLE_NPC",
