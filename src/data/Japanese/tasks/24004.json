			"dialogs": [
				{
					"id": 240040401,
					"content": "#あーあ…見つかっちゃっ…あれ？{M#お兄さん}{F#お姉さん}はだあれ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040402
					],
					"speakerTitle": "ロウ"
				},
				{
					"id": 240040402,
					"content": "オーレルとヴェルーの友だちだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040403
					]
				},
				{
					"id": 240040403,
					"content": "ああ！ヴェルーの言ってた、かくれんぼが得意な人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040404
					],
					"speakerTitle": "ロウ"
				},
				{
					"id": 240040404,
					"content": "#ふふっ、やっと会えたわね。{M#お兄さん}{F#お姉さん}ってすごいのね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040405
					],
					"speakerTitle": "ロウ"
				},
				{
					"id": 240040405,
					"content": "あたしの負け！集合場所に行ってるわね。",
