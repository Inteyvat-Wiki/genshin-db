			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ガルシア",
					"アハンガル",
					"路通"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230150101,
					"content": "このベアリングはサイズが大きすぎて、他のベアリングと合わないんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150102
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230150102,
					"content": "前回は小さすぎ、今回は大きすぎ…お前のせいで鉄の塊が全部なくなってしまったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150103
					],
					"speakerTitle": "アハンガル"
				},
				{
					"id": 230150103,
					"content": "実は…我々のお金も、もうすぐ底を突くんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150104
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230150104,
					"content": "何を騒いでるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150105
					]
				},
				{
					"id": 230150105,
					"content": "こいつから鉄パイプと歯車をたくさん作ってくれと頼まれたんだが、毎回要求が違うんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150106
					],
					"speakerTitle": "アハンガル"
				},
				{
					"id": 230150106,
					"content": "それを作ってやるために、俺は手持ちの鉄の塊を使い果たしてしまったんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150107
					],
					"speakerTitle": "アハンガル"
				},
				{
					"id": 230150107,
					"content": "それなのにこいつは、まだ足りない、もっと歯車が必要だ、とぬかしやがる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150108
					],
					"speakerTitle": "アハンガル"
				},
				{
					"id": 230150108,
					"content": "もう一度俺の仕事の説明を聞いてくれ。きちんと聞けば、きっと理解できる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150109
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230150109,
					"content": "これ、堂々巡りって感じ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150110
					]
				},
				{
					"id": 230150110,
					"content": "アハンガルさんには気の毒ですが、ガルシア先生の気が済むまで説明させてあげましょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150111
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230150111,
					"content": "時に旅人さん、僕…いえ、ガルシア先生が鉄の塊集めを手伝ってほしいそうなのですが、よろしいでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150112,
						230150113
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230150112,
					"content": "時間ならあるけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150114
					]
				},
				{
					"id": 230150114,
					"content": "機械の製作については、予想していた障害に突き当たっています。ガルシア先生は現在、それをどうやって乗り越えるか考え中です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150115
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230150115,
					"content": "もし興味がおありでしたら、ガルシア先生に聞いてみてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150116
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230150116,
					"content": "ですが…あの機械の原理をきちんと理解できる人は、彼自身を除いていないと思いますがね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150117
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230150117,
					"content": "まずはその前に、鉄の塊をお願いしますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "路通"
				},
				{
					"id": 230150113,
					"content": "機械の改造の方はどうなの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150114
					]
				}
			]
		},
