			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ガルシア",
					"路通",
					"アハンガル"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230150301,
					"content": "分かった分かった！もういい。歯車を作ってやる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150302
					],
					"speakerTitle": "アハンガル"
				},
				{
					"id": 230150302,
					"content": "しかし、俺はまだ機械の説明を完全には…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150303
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230150303,
					"content": "鉄の塊はもうあるんだろ？じゃあすぐに取り掛かるから、そこから離れろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150304
					],
					"speakerTitle": "アハンガル"
				},
				{
					"id": 230150304,
					"content": "アハンガルは猛烈な勢いでハンマーを振り回しはじめ、ガルシアはそこから離れざるを得なかった…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230150305
					]
				},
				{
					"id": 230150305,
					"content": "アハンガルさんを作業に集中させてあげましょう。これは報酬です、お受け取りください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150306
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230150306,
					"content": "上手くいくといいね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150307
					]
				},
				{
					"id": 230150307,
					"content": "お気持ちに感謝します、旅人さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150308
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230150308,
					"content": "しかし、僕はこの事について…残念ながら悲観的な見通しを抱いています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150309
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230150309,
					"content": "ガルシア先生は、機械に関しては天才であることに一点の疑いもありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150310
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230150310,
					"content": "しかし、ガルシア先生が完成させたいあの機械については…ただ「天才」であるだけでは、足りない気がするのです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "路通"
				}
			]
		},
		{
			"id": 2301550,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
