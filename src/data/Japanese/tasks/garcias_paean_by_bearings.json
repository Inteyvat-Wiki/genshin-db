			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アハンガル",
					"ガルシア"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230155001,
					"content": "そんなにたくさんの歯車とパイプで何を作るんだ？鉄で覆われた小屋でも建てたいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155002
					],
					"speakerTitle": "アハンガル"
				},
				{
					"id": 230155002,
					"content": "その通りだ！僕は小屋を建てたいんだ。歯車で一杯の小屋を。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155003
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230155003,
					"content": "歯車の一部を収容する場所を「ストレージ」と呼び、ベアリングと別の歯車は「ナンバーベース」を構成する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155004
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230155004,
					"content": "「ストレージ」の歯車は数字を保存、記録するために用いられ、「ナンバーベース」の歯車はそれらの計算に用いられる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155005
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230155005,
					"content": "絵に描けば理解できると思うが…紙はないか？ない？大丈夫だ、俺の服に描こう。そうすればわかるはずだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155006
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230155006,
					"content": "そこの炭をくれないか？ありがとう、これを見てくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ガルシア"
				}
			]
		}
	]
}