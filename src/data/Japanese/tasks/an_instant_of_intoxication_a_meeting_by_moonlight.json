			"trigger": {
				"objectNames": [
					"エドラー",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 402000201,
					"content": "つまり、もう少ししたら、フォンク捜査官が悪者の取り調べをする場所まで、オイラたちを連れてってくれるんだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402000202,
					"content": "そういうこと。私たちの「秘密基地」が見られるかもね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000203
					],
					"speakerTitle": "エドラー",
					"speakerSubtitle": "「執律庭」エージェント"
				},
				{
					"id": 402000203,
					"content": "ははっ、冗談だよ。万が一騒ぎが起きても職務に影響が出ないように、人里離れた民家で取り調べることにしたんだ。出発したら、しっかりついて来てね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000204
					],
					"speakerTitle": "エドラー",
					"speakerSubtitle": "「執律庭」エージェント"
				},
				{
					"id": 402000204,
					"content": "#心配するな！超優秀ガイド、パイモンがついてるからな。迷宮みたいな場所だって、{NICKNAME}と一緒に何度も潜り抜けてきたんだ。フォンテーヌ廷で迷子になんかならないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402000205,
					"content": "#あれ？{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402000206,
					"content": "もう戻ってくるなんて…もしかして夜蘭は「しばらく目を閉じてるだけで休憩完了」ってタイプのワーカホリックなのか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000207,
						402000208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402000207,
					"content": "まだ休暇には入ってないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000209
					]
				},
				{
					"id": 402000209,
					"content": "へへっ、心配するなって。オイラだって成長してるんだからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402000210,
					"content": "やっと事件が解決して一段落したんだし、夜蘭と思いっきり楽しんできてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402000211,
					"content": "悩みなんか、ぜーんぶ忘れて、休みを満喫するんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402000212,
					"content": "小さな探偵パイモンさんのことは任せて。私がちゃんと面倒を見るから。学びたいこととか、食べたいものがあれば、できる限り要望に応えるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000213,
						402000214
					],
					"speakerTitle": "エドラー",
					"speakerSubtitle": "「執律庭」エージェント"
				},
				{
					"id": 402000213,
					"content": "パイモンのことをよろしく。行ってきます！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000215
					]
				},
				{
					"id": 402000215,
					"content": "おう！オイラ、がんばるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402000214,
					"content": "パイモン、がんばってね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000215
					]
				},
				{
					"id": 402000208,
					"content": "パイモンが心配で様子を見に来た。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000209
					]
				}
			]
		}
	]
}