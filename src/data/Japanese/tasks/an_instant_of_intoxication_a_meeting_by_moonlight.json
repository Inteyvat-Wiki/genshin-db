						],
						"pointId": 340100819
					}
				]
			},
			"dialogs": [
				{
					"id": 402000101,
					"content": "素敵な夜景ね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000102
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402000102,
					"content": "爽やかなロマリタイムフラワーの香り、街角の香水店から漂う芳香、そして濃厚なコーヒー豆の匂いが夜風の中で溶け合い、ゆったりとした雰囲気を醸し出している。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000103
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402000103,
					"content": "屋上テラスのある酒場でもあれば、炭酸入りの葡萄酒を注文して、最高のほろ酔い気分を堪能できたんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000104,
						402000105
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402000104,
					"content": "穏やかな休暇なんだし、飲もう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000106
					]
				},
				{
					"id": 402000106,
					"content": "そうね…じゃあ一緒に探しに行きましょう。隠れ家的な酒場なら、裏メニューとかもあるかもしれないわね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000107
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402000107,
					"content": "でもその前に…カブリエール商会が開いているうちに、この衣装に合う香水を一緒に選んでくれない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000108
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402000108,
					"content": "精密な時計や、遊び心のあるクロックワークの調度品、それに技巧を凝らした独特なアクセサリー…あそこなら、見応えのある品を沢山置いているわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000109,
						402000110
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402000109,
					"content": "一仕事終えて買い物したくなったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000111
					]
				},
				{
					"id": 402000111,
					"content": "テイワット屈指の見識があって、審美眼にも優れた旅人が付き合ってくれるんだもの。この機会にしっかり意見をもらわないとね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000112
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402000112,
					"content": "うん…満足よ。本当に素晴らしい異国の旅になったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000113
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402000113,
					"content": "あと数日休暇があれば、もっとのんびりできたんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000114,
						402000115
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402000114,
					"content": "休暇を楽しむって言ってなかった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000116
					]
				},
				{
					"id": 402000116,
					"content": "仕方ないわ。次の仕事が待っているから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000117
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402000117,
					"content": "今回の事件に関する正式な報告書を書いたら、より優れた貨物の通関体制を構築するために、次の任務地点まで向かわないといけないの——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000118
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402000118,
					"content": "ナド・クライにね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000119,
						402000120
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402000119,
					"content": "#{M#俺}{F#私}たちの次の目的地もそこだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000121
					]
				},
				{
					"id": 402000121,
					"content": "心配ないわ。ただ情報提供者と会って、今後の協力案について確認するだけよ。あとは、お互いにどこまで干渉するか決めたりね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000122
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402000122,
					"content": "詳しい話はまた今度しましょう。せっかくだから、今回のフォンテーヌ旅行を記念して、一緒に写真を撮らない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000123,
						402000124
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402000123,
					"content": "調査の指導をしてくれた記念に。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000125
					]
				},
				{
					"id": 402000125,
					"content": "そうね、君みたいな新進気鋭のエージェントになら背中を任せられるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000126
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402000126,
					"content": "じゃあ、今回大活躍してくれた総合映像記録器を使って、大切な一枚を残しましょうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000127
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402000127,
					"content": "次にナド・クライで会った時も、今回みたいに君と仕事ができることを願っているわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402000124,
					"content": "見事な連携で事件を解決した記念に。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000125
					]
				},
				{
					"id": 402000120,
					"content": "何か緊急事態でもあったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000121
					]
				},
				{
					"id": 402000115,
					"content": "また仕事に戻らないといけないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000116
					]
				},
				{
					"id": 402000110,
					"content": "ちょうど購買欲が湧いてきた！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000111
					]
				},
				{
					"id": 402000105,
					"content": "大事件を解決したんだし、飲もう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000106
					]
				}
			]
		},
		{
			"id": 4020002,
