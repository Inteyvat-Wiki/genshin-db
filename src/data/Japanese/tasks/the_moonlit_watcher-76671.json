			},
			"dialogs": [
				{
					"id": 766710401,
					"content": "ふぅ、やっと魔物をやっつけたぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766710402,
					"content": "一体どういうことだ？あいつら、ずっとここで待ち伏せしてたわけじゃないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766710403,
					"content": "ワイルドハント…マンドラゴラ…なるほど、分かりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710404
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766710404,
					"content": "えっ、なにが分かったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766710405,
					"content": "マンドラゴラが障壁を作ってヴァルディスさんを閉じ込めていたのは、彼を守るためだったんじゃないでしょうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710406
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766710406,
					"content": "マンドラゴラは環境の変化に敏感なんです。先ほどこちらへ来る途中、近くで奇妙な囁き声が聞こえました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710407
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766710407,
					"content": "今にして思えば、あれはまだ姿を現していないワイルドハントが発していたものだったんでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710408
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766710408,
					"content": "そして、マンドラゴラはとっくにそれに気づいていた。だからヴァルディスさんを足止めし、先に進めないようにしたんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710409
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766710409,
					"content": "ですが、彼がついてきてしまったため、やむを得ずこの障壁を作って彼を守ったのでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710410
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766710410,
					"content": "なるほど…だからこの子たちは、ずっとここから離れようとしなかったんですね。本当に、なんていうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710411
					],
					"speakerTitle": "ヴァルディス"
				},
				{
					"id": 766710411,
					"content": "ヴァルディスさんは普段から花や草の香りがするので、守ってくれたのかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710412
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766710412,
					"content": "何はともあれ、ありがとうございました。もう危険はありませんよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710413
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766710413,
					"content": "わっ、もう行っちゃった。健気なやつらだな、見返りも求めず人助けをするなんて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710414
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766710414,
					"content": "あいつらがいてくれたら、宝箱を開けてる時に背後から襲われる心配もなくなるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710415
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766710415,
					"content": "そう考えると、ヴァルディスがあいつらについて行きたくなる気持ちも、わからなくもないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710416
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766710416,
					"content": "そうでしょう！やっと僕のことを分かってくれる人が…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710417,
						766710418
					],
					"speakerTitle": "ヴァルディス"
				},
				{
					"id": 766710417,
					"content": "よくそんなこと言ってられるね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766710419
					]
				},
				{
					"id": 766710419,
					"content": "うう、すみません。大人しく罰を受けます…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710420
					],
					"speakerTitle": "ヴァルディス"
				},
				{
					"id": 766710420,
					"content": "さて、無事救出も済んだことですし、早く戻りましょう。みんな待っていますし、心配はかけられません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766710418,
					"content": "職務放棄していい理由にはならない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766710419
					]
				}
			]
		},
