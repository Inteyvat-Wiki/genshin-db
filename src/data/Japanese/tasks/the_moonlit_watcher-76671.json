			"dialogs": [
				{
					"id": 766710101,
					"content": "まだ届いていないんですか？困りましたね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710102
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766710102,
					"content": "隊長、どうしやすか？灯台の兄弟たちが手ぐすね引いて待ってるってのに…燃料がなけりゃ、拠点ごと干上がっちまいますぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710103
					],
					"speakerTitle": "アンライフ"
				},
				{
					"id": 766710103,
					"content": "そうですよ、隊長！早く手を打ちましょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710104
					],
					"speakerTitle": "エーグル"
				},
				{
					"id": 766710104,
					"content": "分かりました。皆さんは心配しなくて大丈夫です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710105
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766710105,
					"content": "いったん持ち場に戻ってください。この件は僕が対処しますから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710106
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766710106,
					"content": "旅人さん、パイモンさん。来てくれたんですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710107
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766710107,
					"content": "よう、イルーガ！みんなして入り口に集まって、どうしたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710108,
						766710109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766710108,
					"content": "すごく忙しそうだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766710110
					]
				},
				{
					"id": 766710110,
					"content": "ご心配なく。少し問題が起きただけで、大したことではありません。すでに対応策も考えてありますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710111
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766710111,
					"content": "イルーガはいつも一人でこっそり問題を解決しようとするな。オイラたちにも話してくれればいいのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766710112,
					"content": "もしかして、オイラたちだから話しにくいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766710113,
					"content": "あはは、そんなことないですよ。僕一人で解決できるようなことについて、みんなを心配させたくなかったものですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710114
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766710114,
					"content": "しかし、君たちも今や調査分隊「闇夜の鶯」の隊員です。その隊長として、隠し事なんてしませんよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710115
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766710115,
					"content": "ここでは少し話しにくいので、中でゆっくり話しましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766710109,
					"content": "何かあったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766710110
					]
				}
			]
		},
		{
			"id": 7667102,
