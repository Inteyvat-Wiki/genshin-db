			},
			"dialogs": [
				{
					"id": 766711101,
					"content": "この前見かけた時、気になったんだけど、どうしてライトキーパーの拠点に、屋台みたいな車両があったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766711102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766711102,
					"content": "あそこでご飯が作れたら便利そうだけど、そんな単純な話じゃなさそうだし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766711103,
						766711105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766711103,
					"content": "実は手の込んだ料理が作れるのかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766711104
					]
				},
				{
					"id": 766711104,
					"content": "食べてみたい…って、違う！そういう話じゃないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766711107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766711107,
					"content": "あれは、正式には「月車」と言います。僕たちライトキーパーがスネージナヤの動力機関を改造して作った輸送車です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766711108
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766711108,
					"content": "移動可能な灯台で、クーヴァキを燃料に動いています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766711109
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766711109,
					"content": "移動速度はそれほどでもありませんが、物資の輸送に貴重な人手を割かずに済みますから、助かっています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766711110
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766711110,
					"content": "パイモンさんが言っていた料理についてですが…今まで考えたこともありませんでした。ですが、中にトースターを搭載するというのは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766711111,
						766711112
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766711111,
					"content": "パイモンの話を真に受けないで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766711113
					]
				},
				{
					"id": 766711113,
					"content": "いえいえ、持ち場に立つライトキーパーにとって、簡単に空腹を満たせるというのは非常に重要です。パイモンさんの言葉に、はっとさせられました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766711114
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766711114,
					"content": "食事用の車両を用意できれば、みんな野外でわざわざ火を起こさなくても、温かい料理を食べられるようになりますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766711115
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766711115,
					"content": "そうだろ？みんなで色んな美味しいものを作って、ここでキャンプファイヤーをするんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766711116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766711116,
					"content": "うーん、でも拠点のみんなは忙しそうだし、そんな気分になる余裕もなさそうだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766711117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766711117,
					"content": "僕もいつか、みんなと心置きなく食卓を囲めたら…考えるだけで、すごく幸せな気分になります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766711118
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766711118,
					"content": "ですが、今はまだ気を緩めていい状況ではありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766711119
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766711119,
					"content": "やっぱりそうなのか…ワイルドハントのせいか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766711120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766711120,
					"content": "先日、南にいるフリンズさんから連絡があったんです。最も強大なワイルドハントの軍勢は、君たちが協力してくれたおかげで討伐できた、と。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766711121
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766711121,
					"content": "ですが各地に散ったワイルドハントは、今も破壊を続けています。決して、油断はできません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766711122
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766711122,
					"content": "現在は拠点を整備し、定期的にライトキーパーを巡回調査に派遣して、往来の安全を確保しています…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766711123
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766711123,
					"content": "うーん、聞いてるだけで疲れてきた…ライトキーパーの仕事ってホントに大変なんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766711124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766711124,
					"content": "これは基本的な任務にすぎません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766711125
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766711125,
					"content": "神出鬼没のワイルドハントと対峙するようなより危険な任務は、義父さんやフリンズさん、オラヴィさんたちが担ってくれています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766711126
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766711126,
					"content": "その他のことまで義父さんに心配させるわけにはいきませんから、こういった基礎的な任務は僕が引き継いだんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766711127
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766711127,
					"content": "実は今一番厄介なのは物資の準備ではなく、人手の問題でして…本当に、どうにもならないんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766711128
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766711128,
					"content": "ライトキーパーの拠点は長い間修繕されていないので、長期的に居住することはできません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766711129
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766711129,
					"content": "現在は野外の拠点と本部を往復するしかなく、そのせいでみんな疲弊していて…戦力として動ける者が、日に日に減っているんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766711130
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766711130,
					"content": "何か解決策は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766711131
					]
				},
				{
					"id": 766711131,
					"content": "この問題を解決するには、ここをいつでも帰ってこられるような拠点にする必要があります。そして、ライトキーパーの拠点として何よりも大切なのが…灯台です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766711132
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766711132,
					"content": "ここに灯台を建てるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766711133
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766711133,
					"content": "ええ。ワイルドハント襲撃の際、灯台さえあれば、それを心の拠り所に戦うことができますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766711134
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766711134,
					"content": "しかし現実は…先ほどご覧いただいた通り、あまり順調には進んでいません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766711135
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766711135,
					"content": "そういえば、手伝いに来たのを忘れてたぞ。一体どんな問題があったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766711136
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766711136,
					"content": "はい。拠点を築くには大量の燃料と物資が必要となるので、月車を使って、いつもピラミダから輸送してもらっているんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766711137,
						766711138
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766711137,
					"content": "現地調達じゃダメなの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766711139
					]
				},
				{
					"id": 766711139,
					"content": "そう簡単ならいいんですが…僕たちに必要なのは普通の燃料ではなく、クーヴァキで精製された特殊な油なんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766711140
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766711140,
					"content": "付近の植物からクーヴァキを採取すれば、しばらくは持つはずですが…それで灯台の燃料を賄おうと思ったら、まさに焼け石に水です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766711141
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766711141,
					"content": "本来なら昨夜、燃料と物資を積んだ輸送車が到着するはずだったんですが…いまだに姿を見せていません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766711142
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766711142,
					"content": "輸送を担当しているヴァルディスさんは、とても真面目に仕事に取り組んでいます。時間を間違えるようなミスをするとは、とても思えません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766711143
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766711143,
					"content": "だからこそ、途中で何かトラブルに遭ったのではないかと…心配なんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766711144,
						766711145
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766711144,
					"content": "そんな悪い方向にばかり考えないで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766711146
					]
				},
				{
					"id": 766711146,
					"content": "たとえ酒樽に閉じ込められたり、頭だけ出して地面に埋められたりしたって、最後はなんとかなるもんだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766711147
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766711147,
					"content": "これよりひどい状況にはなってないはずだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766711148
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766711148,
					"content": "ふふっ、もしかしてそれは、冒険の途中で実際に体験したことですか？どうやら、僕はお二人の実力を見くびっていたようですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766711149,
						766711150
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766711149,
					"content": "もっとひどいのもあって…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766711151
					]
				},
				{
					"id": 766711151,
					"content": "とりあえず、この辺りを探してみようぜ。道に迷ってるだけかもしれないしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766711152
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766711152,
					"content": "確かにその通りですね。そうと決まれば、ぐずぐずしてはいられません。お二人にも手伝っていただけると助かります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766711153
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766711153,
					"content": "もちろんだぞ！さっそく出発しようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766711150,
					"content": "メロピデ要塞に入ったことがある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766711151
					]
				},
				{
					"id": 766711145,
					"content": "落ち着いて。こういうのには慣れてる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766711146
					]
				},
				{
					"id": 766711138,
					"content": "この辺りは木材が豊富なんだし。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766711139
					]
				},
				{
					"id": 766711112,
					"content": "冗談だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766711113
					]
				},
				{
					"id": 766711105,
					"content": "戦闘ロボットに変形するのかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766711106
					]
				},
				{
					"id": 766711106,
					"content": "えぇ！？もしかして、料理がマズいって言ったら、お玉で攻撃してくる料理ロボットとかか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766711107
					],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
}