						],
						"pointId": 361100048
					}
				]
			},
			"dialogs": [
				{
					"id": 766710601,
					"content": "…隊長！よかった、やっと人が来てくれた…助けてください、隊長！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710602
					],
					"speakerTitle": "ヴァルディス"
				},
				{
					"id": 766710602,
					"content": "ヴァルディスさん、どうしてここにいるんですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710603
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766710603,
					"content": "話せば長くなるんですが…このマンドラゴラが作った障壁は、中からじゃどうにもできなくて…もう丸一日、ここに閉じ込められてるんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710604
					],
					"speakerTitle": "ヴァルディス"
				},
				{
					"id": 766710604,
					"content": "待ってください。それはおかしいです。ここはピラミダからのルートではありませんし、近道とも言えません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710605
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766710605,
					"content": "それにマンドラゴラは人を襲ったりしません…縄張りを荒らされない限りは、ですが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710606
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766710606,
					"content": "一体どうやって、ここに閉じ込められたんですか？合理的な説明ができないのなら、君にはもう少しそこにいてもらうしかありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710607
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766710607,
					"content": "うわっ、イルーガの怒ってる姿って、なんか珍しいな。ちょっと怖くなってきたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710608,
						766710609
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766710608,
					"content": "隊長なんだし、威厳を見せないと。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766710610
					]
				},
				{
					"id": 766710610,
					"content": "まあ、そうだよな。やっぱり冒険者のほうが気が楽だぞ…オイラたちは外部の隊員でよかったな。もし正式な隊員だったら、きっとイルーガに叱られてたぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710611
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766710611,
					"content": "うぅ…わかりました、事の経緯をご説明します。昨夜、拠点に向かっていると、マンドラゴラの群れが道を塞いでいたんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710612
					],
					"speakerTitle": "ヴァルディス"
				},
				{
					"id": 766710612,
					"content": "隊長もご存知かと思いますが、僕は普段から昆虫や植物の研究をするのが好きでして…これほど多くのマンドラゴラが一箇所に集まっているのは、非常に珍しいことなんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710613
					],
					"speakerTitle": "ヴァルディス"
				},
				{
					"id": 766710613,
					"content": "またとない研究の機会だと思い、彼らを追っていたら、こんなことに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710614
					],
					"speakerTitle": "ヴァルディス"
				},
				{
					"id": 766710614,
					"content": "申し訳ありません！これは僕の責任です。次の一週間は…いえ、一ヶ月…これから一ヶ月、夜番は僕が担当します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710615,
						766710617
					],
					"speakerTitle": "ヴァルディス"
				},
				{
					"id": 766710615,
					"content": "まずは彼を救助しよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766710616
					]
				},
				{
					"id": 766710616,
					"content": "そうですね、規則違反の件は戻ってからにしましょう。まずは、彼を救出する方法を考えないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710621
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766710621,
					"content": "旅人さん、またご迷惑をおかけします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710622
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766710622,
					"content": "うぅ、ありがとうございます…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴァルディス"
				},
				{
					"id": 766710617,
					"content": "物資はもう手に入れたし…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766710618
					]
				},
				{
					"id": 766710618,
					"content": "えっ、どういう意味ですか？ま、まさか…僕を見捨てるおつもりですか！？お願いします、もうこんなことはしませんから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710619
					],
					"speakerTitle": "ヴァルディス"
				},
				{
					"id": 766710619,
					"content": "かわいそうだし、まずは助けてやろうぜ。どうせ拠点に戻ったら、罰を受けることになるんだし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710620
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766710620,
					"content": "パイモンさんの言う通りです。規則違反の件は、戻ってから考えましょう。まずは、ここから出す方法を考えないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710621
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766710609,
					"content": "彼らには彼らの規則があるから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766710610
					]
				}
			]
		},
