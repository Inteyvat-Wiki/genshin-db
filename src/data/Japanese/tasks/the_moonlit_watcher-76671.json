						],
						"pointId": 361100044
					}
				]
			},
			"dialogs": [
				{
					"id": 766710201,
					"content": "この前見かけた時、気になったんだけど、どうしてライトキーパーの拠点に、屋台みたいな車両があったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766710202,
					"content": "あそこでご飯が作れたら便利そうだけど、そんな単純な話じゃなさそうだし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710203,
						766710205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766710203,
					"content": "実は手の込んだ料理が作れるのかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766710204
					]
				},
				{
					"id": 766710204,
					"content": "食べてみたい…って、違う！そういう話じゃないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766710207,
					"content": "あれは、正式には「月車」と言います。僕たちライトキーパーがスネージナヤの動力機関を改造して作った輸送車です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710208
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766710208,
					"content": "移動可能な灯台で、クーヴァキを燃料に動いています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710209
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766710209,
					"content": "移動速度はそれほどでもありませんが、物資の輸送に貴重な人手を割かずに済みますから、助かっています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710210
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766710210,
					"content": "パイモンさんが言っていた料理についてですが…今まで考えたこともありませんでした。ですが、中にトースターを搭載するというのは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710211,
						766710212
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766710211,
					"content": "パイモンの話を真に受けないで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766710213
					]
				},
				{
					"id": 766710213,
					"content": "いえいえ、持ち場に立つライトキーパーにとって、簡単に空腹を満たせるというのは非常に重要です。パイモンさんの言葉に、はっとさせられました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710214
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766710214,
					"content": "食事用の車両を用意できれば、みんな野外でわざわざ火を起こさなくても、温かい料理を食べられるようになりますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710215
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766710215,
					"content": "そうだろ？みんなで色んな美味しいものを作って、ここでキャンプファイヤーをするんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766710216,
					"content": "うーん、でも拠点のみんなは忙しそうだし、そんな気分になる余裕もなさそうだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710217
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766710217,
					"content": "僕もいつか、みんなと心置きなく食卓を囲めたら…考えるだけで、すごく幸せな気分になります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710218
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766710218,
					"content": "ですが、今はまだ気を緩めていい状況ではありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710219
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766710219,
					"content": "やっぱりそうなのか…ワイルドハントのせいか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710220
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766710220,
					"content": "はい。ご存じの通り、最近ワイルドハントの活動が活発化しているため、僕たちも警戒を強めざるを得ないんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710221
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766710221,
					"content": "現在は拠点を整備し、定期的にライトキーパーを巡回調査に派遣して、往来の安全を確保しています…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710222
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766710222,
					"content": "うーん、聞いてるだけで疲れてきた…ライトキーパーの仕事ってホントに大変なんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710223
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766710223,
					"content": "これは基本的な任務にすぎません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710224
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766710224,
					"content": "神出鬼没のワイルドハントと対峙するようなより危険な任務は、義父さんやフリンズさん、オラヴィさんたちが担ってくれています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710225
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766710225,
					"content": "その他のことまで義父さんに心配させるわけにはいきませんから、こういった基礎的な任務は僕が引き継いだんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710226
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766710226,
					"content": "実は今一番厄介なのは物資の準備ではなく、人手の問題でして…本当に、どうにもならないんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710227
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766710227,
					"content": "ライトキーパーの拠点は長い間修繕されていないので、長期的に居住することはできません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710228
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766710228,
					"content": "現在は野外の拠点と本部を往復するしかなく、そのせいでみんな疲弊していて…戦力として動ける者が、日に日に減っているんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710229
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766710229,
					"content": "何か解決策は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766710230
					]
				},
				{
					"id": 766710230,
					"content": "この問題を解決するには、ここをいつでも帰ってこられるような拠点にする必要があります。そして、ライトキーパーの拠点として何よりも大切なのが…灯台です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710231
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766710231,
					"content": "ここに灯台を建てるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710232
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766710232,
					"content": "ええ。ワイルドハント襲撃の際、灯台さえあれば、それを心の拠り所に戦うことができますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710233
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766710233,
					"content": "しかし現実は…先ほどご覧いただいた通り、あまり順調には進んでいません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710234
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766710234,
					"content": "そういえば、手伝いに来たのを忘れてたぞ。一体どんな問題があったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710235
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766710235,
					"content": "はい。拠点を築くには大量の燃料と物資が必要となるので、月車を使って、いつもピラミダから輸送してもらっているんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710236,
						766710237
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766710236,
					"content": "現地調達じゃダメなの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766710238
					]
				},
				{
					"id": 766710238,
					"content": "そう簡単ならいいんですが…僕たちに必要なのは普通の燃料ではなく、クーヴァキで精製された特殊な油なんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710239
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766710239,
					"content": "付近の植物からクーヴァキを採取すれば、しばらくは持つはずですが…それで灯台の燃料を賄おうと思ったら、まさに焼け石に水です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710240
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766710240,
					"content": "本来なら昨夜、燃料と物資を積んだ輸送車が到着するはずだったんですが…いまだに姿を見せていません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710241
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766710241,
					"content": "輸送を担当しているヴァルディスさんは、とても真面目に仕事に取り組んでいます。時間を間違えるようなミスをするとは、とても思えません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710242
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766710242,
					"content": "だからこそ、途中で何かトラブルに遭ったのではないかと…心配なんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710243,
						766710244
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766710243,
					"content": "そんな悪い方向にばかり考えないで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766710245
					]
				},
				{
					"id": 766710245,
					"content": "たとえ酒樽に閉じ込められたり、頭だけ出して地面に埋められたりしたって、最後はなんとかなるもんだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710246
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766710246,
					"content": "これよりひどい状況にはなってないはずだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710247
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766710247,
					"content": "ふふっ、もしかしてそれは、冒険の途中で実際に体験したことですか？どうやら、僕はお二人の実力を見くびっていたようですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710248,
						766710249
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766710248,
					"content": "もっとひどいのもあって…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766710250
					]
				},
				{
					"id": 766710250,
					"content": "とりあえず、この辺りを探してみようぜ。道に迷ってるだけかもしれないしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710251
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766710251,
					"content": "確かにその通りですね。そうと決まれば、ぐずぐずしてはいられません。お二人にも手伝っていただけると助かります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710252
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766710252,
					"content": "もちろんだぞ！さっそく出発しようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766710249,
					"content": "メロピデ要塞に入ったことがある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766710250
					]
				},
				{
					"id": 766710244,
					"content": "落ち着いて。こういうのには慣れてる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766710245
					]
				},
				{
					"id": 766710237,
					"content": "この辺りは木材が豊富なんだし。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766710238
					]
				},
				{
					"id": 766710212,
					"content": "冗談だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766710213
					]
				},
				{
					"id": 766710205,
					"content": "戦闘ロボットに変形するのかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766710206
					]
				},
				{
					"id": 766710206,
					"content": "えぇ！？もしかして、料理がマズいって言ったら、お玉で攻撃してくる料理ロボットとかか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710207
					],
					"speakerTitle": "パイモン"
				}
			]
		},
