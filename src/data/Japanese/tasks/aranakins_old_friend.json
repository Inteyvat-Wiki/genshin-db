			"dialogs": [
				{
					"id": 730570401,
					"content": "これはナラの琴、アランナキンはずっと取っておいた。でも、もう今は歌えないはず…弦の音程が外れてるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570402
					],
					"speakerTitle": "アランナキン"
				},
				{
					"id": 730570402,
					"content": "（古びたウードには、亀裂が何本か入っている。しかしきちんと修理して保管してあったようだ。）",
					"roleType": "TALK_ROLE_NPC",
