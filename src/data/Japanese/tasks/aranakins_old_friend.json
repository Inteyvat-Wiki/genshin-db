			},
			"dialogs": [
				{
					"id": 730570501,
					"content": "ナラの…えっと、あれなんだっけ？アランナキンが寝る時には必要ない。だから名前が分からない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570502
					],
					"speakerTitle": "アランナキン"
				},
				{
					"id": 730570502,
					"content": "「ベッド」でしょ。ずいぶん綺麗だな…これ、新品か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730570503,
					"content": "へへっ、アランナキンがいつも掃除してるから…キミたちがここで寝たいなら、寝ていいよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランナキン"
				}
			]
		},
		{
			"id": 7305706,
