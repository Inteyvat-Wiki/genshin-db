			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730570101,
					"content": "あれ、いなくなった…まぁそうだよな。一緒に冒険したのも覚えてないみたいだったし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570102,
						730570103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730570102,
					"content": "しょんぼりしないで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570104
					]
				},
				{
					"id": 730570104,
					"content": "うん、確かに…そうだよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730570105,
					"content": "そうだ、この前アランナキンから教えてもらった曲を弾こうぜ。そしたらオイラたちのこと、わかってくれるかもしれないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570106,
						730570108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730570106,
					"content": "すごくいいアイデア。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570107
					]
				},
				{
					"id": 730570107,
					"content": "へへっ、だってオイラは、パイモンだからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730570108,
					"content": "たまにはいいこと言うんだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570109
					]
				},
				{
					"id": 730570109,
					"content": "なんて言い草だよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730570103,
					"content": "また一から友達になればいいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570110
					]
				}
			]
		},
		{
			"id": 7305702,
			"completionStepIds": [
				7305707
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7305707",
							"2"
						],
						"stepId": 7305707,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パイモン",
					"アランナキン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730570201,
					"content": "へへ、あいつが来たぞ！よう！チビ助！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730570202,
					"content": "アランナキンはチビではない。それを言うなら、そっちの空飛ぶ白いヤツの方だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570203
					],
					"speakerTitle": "アランナキン"
				},
				{
					"id": 730570203,
					"content": "…それはそうと、金色の「す」…ナラ、どうしてその曲が弾けるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570204
					],
					"speakerTitle": "アランナキン"
				},
				{
					"id": 730570204,
					"content": "それは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570205,
						730570207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730570205,
					"content": "アランナキンが教えてくれたんだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570206
					]
				},
				{
					"id": 730570206,
					"content": "そうだぞ。この曲は前におまえと冒険した時、おまえが教えてくれたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730570209,
					"content": "へえ…そうだったのか？うーん、アランナキンは賢くないが、キミたちは「砂」には見えないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570210
					],
					"speakerTitle": "アランナキン"
				},
				{
					"id": 730570210,
					"content": "おう！「砂」は「ワルカ」、つまり悪いナラだろ。オイラたちはいいナラだ！これだって、おまえが教えてくれたんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730570211,
					"content": "へえ！キミたちにそんな話を？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570212
					],
					"speakerTitle": "アランナキン"
				},
				{
					"id": 730570212,
					"content": "#へへ、そうだぞ！{NICKNAME}、これまでのことをもう一回説明してやろうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730570213,
					"content": "あなたたちはアランナキンに、三人で一緒に冒険して、最後に「死域」を鎮めた話をした。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730570214
					]
				},
				{
					"id": 730570214,
					"content": "…そうなのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570215
					],
					"speakerTitle": "アランナキン"
				},
				{
					"id": 730570215,
					"content": "アランナキンは賢くない。でもキミたちの言ってることは、本当なんだろうな。何も思い出せなくて、ゴメン。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570216
					],
					"speakerTitle": "アランナキン"
				},
				{
					"id": 730570216,
					"content": "別に悪くなんかないぞ！覚えてなくて当たり前だし…それに、また友達になればいいわけだしさ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570217,
						730570218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730570217,
					"content": "アランナキンはいい子だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570220
					]
				},
				{
					"id": 730570220,
					"content": "そっか…仲間か。じゃあ、ついて来て！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570221
					],
					"speakerTitle": "アランナキン"
				},
				{
					"id": 730570221,
					"content": "え？でも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570222
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730570222,
					"content": "金色のナラ、白いふわふわ！我が家に招待するから、ついて来て！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランナキン"
				},
				{
					"id": 730570218,
					"content": "パイモンはいい子だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570219
					]
				},
				{
					"id": 730570219,
					"content": "へへっ、言うまでもないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570220
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730570207,
					"content": "#{M#君}{F#あなた}に会うために、この曲を弾いたんだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570208
					]
				},
				{
					"id": 730570208,
					"content": "#へへっ、{NICKNAME}の演奏はどうだった？教えてもらった曲、ちゃんと覚えてただろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570209
					],
					"speakerTitle": "パイモン"
				}
			]
		},
