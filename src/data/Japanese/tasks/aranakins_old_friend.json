					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730570601,
					"content": "上の階には、ナラが置いていった葉っぱもある。読んでもちんぷんかんぷんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570602
					],
					"speakerTitle": "アランナキン"
				},
				{
					"id": 730570602,
					"content": "あれは…ナラが記憶を残すための葉っぱ。こういう葉っぱに字を書いて、ひとまとめにする。でもナラの文字は、アランナキンにはさっぱり分からない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570606
					],
					"speakerTitle": "アランナキン"
				},
				{
					"id": 730570606,
					"content": "それってつまり…「ノート」のこと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570603
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730570603,
					"content": "「ノート」…？それが、ナラが記憶を残すために使うもの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570604
					],
					"speakerTitle": "アランナキン"
				},
				{
					"id": 730570604,
					"content": "そうだぞ…なあ、オイラたちが上に行って、一緒になにが書いてあるか読んじゃダメか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570605
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730570605,
					"content": "ダメじゃない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランナキン"
				}
			]
		},
		{
			"id": 7305707,
			"completionStepIds": [
				7305706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7305706",
							"2"
						],
						"stepId": 7305706,
						"stateName": "QUEST_STATE_UNFINISHED"
