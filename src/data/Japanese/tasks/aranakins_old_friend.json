			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730570901,
					"content": "「…バクルおじさんに壊されたウードを直したよ。一人で泣かないで。つらかったら、私とハイヤームに話してみて…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570902
					],
					"speakerTitle": "古いノート"
				},
				{
					"id": 730570902,
					"content": "「…教令院に採用された。おめでとう、私！『戦士の花嫁』なんかにはならないわ。将来は『大賢者シマン』になるの！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570903
					],
					"speakerTitle": "古いノート"
				},
				{
					"id": 730570903,
					"content": "「…ふふ、『演奏家』イルファンに賢人ハイヤーム！離れ離れになっても、私のことを忘れないでよ！特にハイヤーム、私を忘れないでね」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570904
					],
					"speakerTitle": "古いノート"
				},
				{
					"id": 730570904,
					"content": "「…このノートともお別れだ。さよなら、イルファン、シマン——僕の親友たち。森がいつまでも僕たちの物語を覚えていてくれますように。僕たちがお互いを忘れないでいられますように…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570905
					],
					"speakerTitle": "古いノート"
				},
				{
					"id": 730570905,
					"content": "（…後の内容はごちゃごちゃと賑やかで、子供たちの楽しくて悲しい思い出が詰まっている…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570906
					],
					"speakerTitle": "古いノート"
				},
				{
					"id": 730570906,
					"content": "「…アランナキンがいなくなった。いつからか、いなくなった。ぼくもウードに別れを告げる時だ。職人になろう。父さんがそう望んだように…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570907
					],
					"speakerTitle": "古いノート"
				},
				{
					"id": 730570907,
					"content": "（その下にまだ何か書いてあるようだが、黒く塗りつぶされている）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570908
					],
					"speakerTitle": "古いノート"
				},
				{
					"id": 730570908,
					"content": "「…このノートを読んでいる将来のぼくへ。もし奇跡的にアランナキンたちに出会えたら、この花を返してあげてほしい…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570909
					],
					"speakerTitle": "古いノート"
				},
				{
					"id": 730570909,
					"content": "あれ…ノートからなにか、落っこちたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570910
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730570910,
					"content": "花…みたいだな？オイラたちが手に入れたのと…同じだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
