			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アランナキン",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730570701,
					"content": "それ、どんな記憶が残ってたんだ？なにが書いてあった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570702
					],
					"speakerTitle": "アランナキン"
				},
				{
					"id": 730570702,
					"content": "#ノートの持ち主は{M#君}{F#あなた}を知ってるみたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570703
					]
				},
				{
					"id": 730570703,
					"content": "そうなのか…覚えてないや…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570704
					],
					"speakerTitle": "アランナキン"
				},
				{
					"id": 730570704,
					"content": "この人は…大人になったから、もうおまえの姿が見えないって言ってる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570705
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730570705,
					"content": "うーん…成長するって、色々苦労があるもんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570706
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730570706,
					"content": "そうそう、ノートにはこうも書いてあるぞ…この花をおまえにやるって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570707
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730570707,
					"content": "これ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570708
					]
				},
				{
					"id": 730570708,
					"content": "え…？ええっ！これは大事な花だ！どうして…どうしてその人がこれを？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570709
					],
					"speakerTitle": "アランナキン"
				},
				{
					"id": 730570709,
					"content": "同じような花を、オイラたちももらったぞ…おまえは覚えてないだろうけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570710
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730570710,
					"content": "そうか…キミたちとはまた友達になれるけど…このナラのことは、姿かたちすら覚えてない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570711
					],
					"speakerTitle": "アランナキン"
				},
				{
					"id": 730570711,
					"content": "き、気にするなって…元気だせよ。オイラたちにはまだこの花があるし、もっとたくさんの思い出をおまえにあげられる。だろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570712
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730570712,
					"content": "うん、白いふわふわの言う通りだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570713
					],
					"speakerTitle": "アランナキン"
				},
				{
					"id": 730570713,
					"content": "ボク、この花を持って帰る。「マウティイェマ」なら、カノジョを目覚めさせる方法を知ってるはずだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570714
					],
					"speakerTitle": "アランナキン"
				},
				{
					"id": 730570714,
					"content": "#うーん…ナラ{NICKNAME}と白いふわふわ、ボクはアランナガの所に帰る。カノジョを植えて、カノジョの歌を聴く。時間があれば、遊びにきて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570715
					],
					"speakerTitle": "アランナキン"
				},
				{
					"id": 730570715,
					"content": "うんうん、絶対行く！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
