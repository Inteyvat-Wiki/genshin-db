			"dialogs": [
				{
					"id": 705550101,
					"content": "旅人、仕事は終わったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705550102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705550102,
					"content": "オイラがグランフィディアと配達の注文を片付けてる間、おまえが大活躍だったって聞いたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705550103,
						705550104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705550103,
					"content": "今回はひらめきに溢れてたんだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705550105
					]
				},
				{
					"id": 705550105,
					"content": "…とにかく、栄誉騎士は今のモンドにおいて、トップバーテンダーの一人だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705550106
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705550106,
					"content": "経験年数を考えると、キャッツテールの小さな伝説に追いつく可能性すらある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705550107
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705550107,
					"content": "その決定には全面的に賛成です、大団長。今回、栄誉騎士様にはご負担をおかけしてしまったので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705550108
					],
					"speakerTitle": "グランフィディア"
				},
				{
					"id": 705550108,
					"content": "ドリンクスポットはしばらく営業を続け、遠征隊メンバーを迎えられるよう準備を万全にしておきます。適切な店舗が見つかり次第、通常営業の試験運用も始める予定です…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705550109
					],
					"speakerTitle": "グランフィディア"
				},
				{
					"id": 705550109,
					"content": "おお！騎士団のみんなが美味しい飲み物を飲めるようになるんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705550110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705550110,
					"content": "さすがはヘルターの直弟子だ！グランフィディアは気が利くな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705550111
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705550111,
					"content": "それと、栄誉騎士様が開発された新作の特製ドリンクですが…よろしければレシピを残して、当スポットの正式メニューに加えさせていただけませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705550112,
						705550113
					],
					"speakerTitle": "グランフィディア"
				},
				{
					"id": 705550112,
					"content": "全然構わないよ、みんなで飲もう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705550114
					]
				},
				{
					"id": 705550114,
					"content": "うーん…なんかおまえ、まだ言いたいことがありそうだな…オイラが当ててやろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705550115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705550115,
					"content": "おまえの性格からして…特製ドリンク一杯一杯に、名前の由来を書き添えろって言うつもりだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705550116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705550116,
					"content": "お客さんたちに知ってもらいたいんだろ？誰のために、誰からヒントをもらって、そのすごい力作を完成させたのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705550117,
						705550118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705550117,
					"content": "さすがパイモン、よく分かってる！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705550119
					]
				},
				{
					"id": 705550119,
					"content": "承知いたしました！もしご要望があれば、専門家に書類の作成を依頼し、これらの特製ドリンクの特許を申請することもできますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705550120
					],
					"speakerTitle": "グランフィディア"
				},
				{
					"id": 705550120,
					"content": "はっはっは、これから新しく入るバーテンダーたちも、我らが栄誉騎士の奇抜な手法を会得してくれるといいな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705550121
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705550121,
					"content": "お前と肩を並べる傑作とまではいかなくとも、栄誉騎士の腕前を七割再現できりゃ、もう立派な達人だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 705550118,
					"content": "皆にとって大切なことだよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705550119
					]
				},
				{
					"id": 705550113,
					"content": "断ったら…なんだかケチみたいじゃない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705550114
					]
				},
				{
					"id": 705550104,
					"content": "話してると、次々アイデアが湧いてきて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705550105
					]
				}
			]
		}
	]
}