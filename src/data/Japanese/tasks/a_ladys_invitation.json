			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「傀儡」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 762180101,
					"content": "あら？来たのね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180102
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 762180102,
					"content": "よう、サンドローネ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180103,
						762180104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762180103,
					"content": "招待してくれてありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180105
					]
				},
				{
					"id": 762180105,
					"content": "あれ？手紙にはお茶会を開くって書いてあったけど…何もないよな？お菓子を用意し忘れたのか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762180106,
					"content": "ふん、そんなわけないでしょう。見くびらないでくれるかしら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180107
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 762180107,
					"content": "わぁ！テ、テーブルが…！どうやって出したんだ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762180108,
					"content": "ふふっ、驚いた？ワタシが発明した携帯式ティーテーブルよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180109
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 762180109,
					"content": "楽々持ち運べて収納も簡単、さらにファジオと同じ浮遊装置も搭載したわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180110
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 762180110,
					"content": "そのうえ…いいえ、ここまでにしておきましょう。なんだか売り込みをしてる気分になってきたわ。とにかく、なんとなくでも凄いということが伝われば、それで十分よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180111
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 762180111,
					"content": "はい、お茶とお菓子よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180112
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 762180112,
					"content": "それじゃ、遠慮なく。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180113
					]
				},
				{
					"id": 762180113,
					"content": "ん…！すっごくおいしいぞ！想像通り、おまえの作るお菓子は最高だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762180114,
					"content": "当然でしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180115
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 762180115,
					"content": "でも、なんでこんな装置を作ろうと思ったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762180116,
					"content": "もちろん、友人たちとどこでもお茶会を楽しめるようにするためよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180117
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 762180117,
					"content": "前にも言った通り、すでに持っているものを守ること以外にも、大切な物を手元に留めておく方法はあるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180118
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 762180118,
					"content": "だから今は、もっと外に出かけて、もっとみんなと一緒に過ごしたいと思っているの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180119
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 762180119,
					"content": "でも、招待をした側がお菓子の準備やテーブルの片付けをしてもらうなんて、淑女の礼儀にはそぐわないでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180120
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 762180120,
					"content": "へへっ、友達なら気にしないと思うけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762180121,
					"content": "ワタシが気にするのよ。それに、この程度のものを造るなんて造作もないことだわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180122
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 762180122,
					"content": "アナタたちが気に入ったなら、プレゼントしてあげてもいいわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180123
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 762180123,
					"content": "えっ！？い…いいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762180124,
					"content": "言ったでしょう、ワタシはこういうものを造るのが得意なの。気にせず受け取りなさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180125
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 762180125,
					"content": "ありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180126
					]
				},
				{
					"id": 762180126,
					"content": "遠慮はいらないわ。千霊祭では随分とアナタたちの世話になったもの。淑女として当然のお返しだと思ってちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 762180104,
					"content": "待たせちゃった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180105
					]
				}
			]
		}
	]
}