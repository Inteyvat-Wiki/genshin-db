			"dialogs": [
				{
					"id": 706910101,
					"content": "#{M#栄誉騎士のお兄ちゃん}{F#栄誉騎士のお姉ちゃん}！こっちこっち！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910102
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 706910102,
					"content": "クレーね、新しい友達ができたの！一緒に遊ばない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910103
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 706910103,
					"content": "みんなが新しいゲームを教えてくれたの。「雪の行方」っていうんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910104
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 706910104,
					"content": "ルールも難しくなくて、かくれんぼみたいな感じなんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910105
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 706910105,
					"content": "おおっ、クレー！ヨォーヨと早柚も、おまえら、友達になったんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706910106,
					"content": "なんか、「風の行方」の改良版みたいだな？楽しそうだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910107,
						706910108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706910107,
					"content": "いいね、かくれんぼ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706910109
					]
				},
				{
					"id": 706910109,
					"content": "はっくしょん…拠点はまだそんなに冷え込んでいないはずなのだが。ふぁぁ…まだちょっと眠いな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910110
					],
					"speakerTitle": "早柚"
				},
				{
					"id": 706910110,
					"content": "#ん？見間違いか？{NICKNAME}とパイモンが見えたような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910111
					],
					"speakerTitle": "早柚"
				},
				{
					"id": 706910111,
					"content": "#見間違いじゃないよ。{NICKNAME}とパイモンちゃんが来たの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910112,
						706910113
					],
					"speakerTitle": "ヨォーヨ"
				},
				{
					"id": 706910112,
					"content": "ヨォーヨ、早柚、こんにちは！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706910114
					]
				},
				{
					"id": 706910114,
					"content": "体を動かせば、眠いのもふっとぶよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910115
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 706910115,
					"content": "真面目な菫さんも言ってたでしょ？雪山を回るのは、早柚ねぇねの技を磨くためにもいいって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910116
					],
					"speakerTitle": "ヨォーヨ"
				},
				{
					"id": 706910116,
					"content": "うっ、よくそんなことを覚えていたな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910117
					],
					"speakerTitle": "早柚"
				},
				{
					"id": 706910117,
					"content": "はぁ…同業たちや忍犬に負けたら…もっと監視が厳しくなって、サボりづらくなる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910118
					],
					"speakerTitle": "早柚"
				},
				{
					"id": 706910118,
					"content": "今回の修行は、本気で取り組んだほうがよさそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910119
					],
					"speakerTitle": "早柚"
				},
				{
					"id": 706910119,
					"content": "大丈夫だよ、絶雲の唐辛子とコショウの粉末を入れた新しいレシピのお肉と野菜のシチューを用意したから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910120
					],
					"speakerTitle": "ヨォーヨ"
				},
				{
					"id": 706910120,
					"content": "始まる前に食べれば、かくれんぼ中はずっとぽかぽかだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910121
					],
					"speakerTitle": "ヨォーヨ"
				},
				{
					"id": 706910121,
					"content": "悪くなさそうだ！まずは食べよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910122
					],
					"speakerTitle": "早柚"
				},
				{
					"id": 706910122,
					"content": "オ…オイラも食べたいぞ！！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706910123,
					"content": "じゃあ——雪山でかくれんぼ、始めるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910124
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 706910124,
					"content": "へへっ！雪山は真っ白だから、オイラはぜったい見つからない自信があるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706910113,
					"content": "一緒にかくれんぼしない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706910114
					]
				},
				{
					"id": 706910108,
					"content": "#{M#俺}{F#私}もクレーの新しい友達と会ってみたい！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706910109
					]
				}
			]
		}
	]
}