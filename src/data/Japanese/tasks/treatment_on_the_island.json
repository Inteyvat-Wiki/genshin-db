			},
			"dialogs": [
				{
					"id": 721380401,
					"content": "#お疲れ、{NICKNAME}。迷惑をかけてないだろうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380402,
						721380403
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380402,
					"content": "大丈夫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380404
					]
				},
				{
					"id": 721380404,
					"content": "君が採集した薬草で新しい薬を作ったんだが、薬の効果を確かめる相手がいない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380405
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380405,
					"content": "#だから、もしよければ、{NICKNAME}に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380406
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380406,
					"content": "はっきり言って。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380407
					]
				},
				{
					"id": 721380407,
					"content": "#俺が薬を飲んだ後、{NICKNAME}にその効果を見届けてほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380408
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380408,
					"content": "新しい薬の効果はまだ不安定だ、今は最悪の結果を予測することしかできない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380409
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380409,
					"content": "だから、誰かに俺の成功を見届けてほしい…あるいは、失敗した結果を処理してくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380410
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380410,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 721380403,
					"content": "そんなことないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380404
					]
				}
			]
