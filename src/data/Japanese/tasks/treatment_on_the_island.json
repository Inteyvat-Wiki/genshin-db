			"dialogs": [
				{
					"id": 721380201,
					"content": "あっ、来てくれたのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380202
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380202,
					"content": "薬草は採集できたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "保本"
				}
			]
		},
		{
			"id": 7213803,
			"completionStepIds": [
				7213807
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7213807",
							"2"
						],
						"stepId": 7213807,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7213802",
							"3"
						],
						"stepId": 7213802,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"保本"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721380301,
					"content": "そうだ、これだ。茎葉も潰れていないし、それに新鮮だ…ありがとう、本当に助かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380302
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380302,
					"content": "これでいいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380303
					]
				},
				{
					"id": 721380303,
					"content": "ああ、これで十分だ。新しい薬の研究を始めることができるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380304
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380304,
					"content": "あらためて礼を言う。これは前に話した報酬だ。ぜひ受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380305
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380305,
					"content": "ちなみに、外国の方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380306
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380306,
					"content": "ああ、すまない。色々と助けてもらったのに、まだ名前を聞いていなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380307
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380307,
					"content": "#{NICKNAME}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380308
					]
				},
				{
					"id": 721380308,
					"content": "#{NICKNAME}、また手伝ってくれるなら、後日ここに戻ってきてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380309
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380309,
					"content": "もちろん報酬は弾む、はははっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "保本"
				}
			]
		},
