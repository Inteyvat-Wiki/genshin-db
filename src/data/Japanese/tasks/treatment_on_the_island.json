	"talks": [
		{
			"id": 7213801,
			"completionStepIds": [
				7213801
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7213801",
							"2"
						],
						"stepId": 7213801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"保本"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721380101,
					"content": "うわ！お…俺は怪しいものじゃないぞ、ただの地元の医師だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380102
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380102,
					"content": "信じてくれないなら、俺の家まで案内する。何か足りない物があるなら、そこから持っていってもいいぞ。だから、大目に見てくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380103
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380103,
					"content": "あるいは、君たちの大将である九条様のとこまで連れていってくれてもいい！あの人は俺のことを知ってるから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380104,
						721380105
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380104,
					"content": "何か誤解してる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380106
					]
				},
				{
					"id": 721380106,
					"content": "ん…？君たちは幕府軍のようには見えないな…ただ珊瑚宮の連中にも見えない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380107
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380107,
					"content": "君たちは…外国の人か？何でここに？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380108,
						721380109
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380108,
					"content": "それは…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380110
					]
				},
				{
					"id": 721380110,
					"content": "はぁ…何はともあれ、ここから早く離れた方がいい。今のヤシオリ島は危ないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380111
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380111,
					"content": "今日まで、「祟り神」が消える気配もなく、天領奉行が軍を撤退させようという意思も見えない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380112
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380112,
					"content": "この島はもう住めないのだ、観光なんてもってのほかだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380113
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380113,
					"content": "奉行に捕まらないように逃げてきた外国人なら、西へ向かうといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380144
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380144,
					"content": "天領奉行は得体の知れない逃亡者を歓迎しない、ただ海賊なら君を受け入れるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380114,
						721380115
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380114,
					"content": "島で何があったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380116
					]
				},
				{
					"id": 721380116,
					"content": "ふん…自分の目で確かめてみるといい。城内のヤツらと珊瑚宮の連中が俺たちに何をしたのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380117
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380117,
					"content": "最初はたたら砂の爆発だった。あの日の夜空まで妙な色に染められた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380140
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380140,
					"content": "多くの友人や家族が仕事を失い、生活に追われたんだ。それに重傷を負って、悲惨な姿で家に帰ってきた人もたくさんいた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380141
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380141,
					"content": "それだけじゃない、多くの友人が…避難できなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380118
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380118,
					"content": "そして、珊瑚宮のヤツらが大蛇の遺骨の鎮め物を壊したせいで、「祟り神」が暴れ出し、他の場所へ逃げて死んだ人が多くいる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380119
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380119,
					"content": "「祟り神」がもたらした奇病も広がっていて、ここに住む人々ではもう手を付けられなくなった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380142
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380142,
					"content": "両陣営に広がるのも時間の問題だろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380143
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380143,
					"content": "ここは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380120
					]
				},
				{
					"id": 721380120,
					"content": "そもそも、ここは稲妻にとって「玉鋼」の錬成に必要な晶鉱の主産地だ。鉱石さえあれば、俺たちは城内の方々に縛られることなく、いい生活を送れる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380121
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380121,
					"content": "だけど今は？今、島で生活している人はほとんどいない…俺みたいに、ちゃんと話せる「人」が。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380122
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380122,
					"content": "何でここを離れないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380123
					]
				},
				{
					"id": 721380123,
					"content": "離れたくない人なんていないだろう。天領奉行様のご子息にも誘われたことがある…彼は今も戦争の指揮をしているはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380124
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380124,
					"content": "「お前は医術の心得がある、普通の人とは違う。島に残っていては危険だから、俺の軍医になってくれないか。お前を父に紹介しよう。」と言われた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380145
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380145,
					"content": "彼はこう言っていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380125
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380125,
					"content": "戦争が始まるまで、鳴神島の奉行様を治療するなんてこと俺みたいな田舎の医者には想像もできなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380126
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380126,
					"content": "だけど今…考えてみろ、奉行様の側に名医が多くいるだろう。だけどヤシオリ島は？ここの病人が頼りにできる医者は俺1人しかいない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380127
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380127,
					"content": "だから、俺はここを出るつもりもないし、片方の兵士のみを治療するつもりもない。俺の敵は「祟り神」だけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380128
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380128,
					"content": "何か手伝えることは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380129
					]
				},
				{
					"id": 721380129,
					"content": "大丈夫…あ、いや、確かに助けが必要だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380130
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380130,
					"content": "「祟り神」がもたらす奇病の治療薬を作るには、ある特別な薬草が必要なんだ。効果があるかはまだ分からないが、何もしないよりはましだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380131
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380131,
					"content": "ただ、その薬草には「祟り神」がまといついているはず、ほとんどが危険な場所に分布しているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380146
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380146,
					"content": "川や海によって隔てられているか、または怪物が住み着いているか…これらの地帯には「祟り神」によって最もひどく荒廃している…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380132
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380132,
					"content": "俺の度胸と能力では、採取は到底無理だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380133
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380133,
					"content": "医者という立場上、俺はそんな危険な場所へと薬草を採りに行くことができない。今は進行を遅らす治療しかできない状況だ…新しい薬も長いこと作れていない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380134
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380134,
					"content": "外国人、君の持っている「風の翼」を見た。君は経験の豊かな旅人なのだろう。この程度の危険なら、簡単に乗り越えられるんじゃないだろうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380135
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380135,
					"content": "だから、薬草を採集して来てほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380136
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380136,
					"content": "集めたら、ここに持ってきてくれ。報酬については心配無用だ、少しばかり貯金があるからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380137
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380137,
					"content": "君からしたら見知らぬ人からの依頼だろうが、どうか助けてくれ、頼む。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380138
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380138,
					"content": "それと気をつけて欲しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "保本"
				},
				{
					"id": 721380115,
					"content": "落ち込んでいるように見える。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380116
					]
				},
				{
					"id": 721380109,
					"content": "話せば長くなる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380110
					]
				},
				{
					"id": 721380105,
					"content": "怪しい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380106
					]
				}
			]
		},
		{
