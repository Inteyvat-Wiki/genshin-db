	"talks": [
		{
			"id": 7351301,
			"completionStepIds": [
				7351301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7351301",
							"2"
						],
						"stepId": 7351301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"シュリヤ",
					"ヴィナヤック"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735130101,
					"content": "…だ、か、ら、どうしてリベットまでオーダーメイドにする必要があるわけ？そんなことしたって性能がそれほど上がるはずないでしょうが！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130102
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735130102,
					"content": "——リベット装甲ってのは妙論派のロマンだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130103
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735130103,
					"content": "まさか…昨日からずっと争ってたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735130104
					]
				},
				{
					"id": 735130104,
					"content": "ああ、来たんだね。そういうわけじゃないさ。実は経費の問題については、昨日すでに話し終わってるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130105
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735130105,
					"content": "はぁっ…今は他の問題について話し合ってたの。だけどいつの間にか、また経費のことに戻っちゃってたみたい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130106
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735130106,
					"content": "他の問題？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735130107
					]
				},
				{
					"id": 735130107,
					"content": "パーツを繋ぐための接続溝を、光が反射するほど磨き上げたのに、シュリヤのやつ、今度はなんと「計画を中止したい」ときた！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130108
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735130108,
					"content": "中止じゃないわ！しばらく中断するだけ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130109
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735130109,
					"content": "環境パラメータが少し変なのよ。気付いてないの？このまま設置すれば、装置のチャージ効率は予想を遥かに下回ってしまう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130110
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735130110,
					"content": "このエリアにいったい何が起きているのかをまず解明して、すべての影響を与える要素を排除してから、計画通り組み立てましょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130111
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735130111,
					"content": "理想化された環境と実際の環境が合わない、なんて状況はいくらでもある。そこまでいちいち気にする必要はないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130112
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735130112,
					"content": "僕は設計図を作った時から許容範囲をちゃんと考慮に入れてるんだ。これしきの影響、なんてことない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130113
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735130113,
					"content": "だいたい、やってみて初めて、実際に問題のある部分を見出せるってこともあるんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130114
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735130114,
					"content": "——つまり、それがあのとき二号機の実験を強行して爆発に至った理由ってわけ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130115
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735130115,
					"content": "そ、それとこれとは話が違うだろ！あの時の僕はまだ許容量を残すことを意識していなかったから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130116
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735130116,
					"content": "…もっと安全な実験方法はないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735130117
					]
				},
				{
					"id": 735130117,
					"content": "そうだな…砲塔の発射機能を閉じて、そのチャージプロセスだけを模擬実験するとか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130118
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735130118,
					"content": "…ダメ。あなたを信用できないわ。やはりここは砲塔の点火モジュールごと外しましょう。私が保管しててあげる。その状態なら他のパーツをいくらでも入れていいわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130119
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735130119,
					"content": "点火モジュールを外すだって？——そしたらこの「対ウェネト殺蟲大砲」がただの形だけのものになってしまうじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130120
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735130120,
					"content": "チャージ機能を実験するだけって言ったでしょ？あなた、やっぱり発射する気だったのね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130121
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735130121,
					"content": "ッ…その…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130122,
						735130123
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735130122,
					"content": "じゃあ、まずは発射機能を閉じよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735130124
					]
				},
				{
					"id": 735130124,
					"content": "はぁ…組み立てテストのつもりでやろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130125
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735130125,
					"content": "もっと早くこうするべきだったのよ…設置の途中にたくさんの魔物が引き付けられてくるでしょうから、その時は頼むわよ、冒険者さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735130123,
					"content": "とりあえず、まずは形だけでも作ろう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735130124
					]
				}
			]
		}
	]
}