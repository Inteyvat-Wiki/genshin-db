					"ハニヤー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400851501,
					"content": "ようやくこの日が来たわね！旅人、パイモン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851502
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400851502,
					"content": "忠告したはずよ。キノコンに余計な感情を抱かず、駒として指示を与えるようにと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851503
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400851503,
					"content": "でも、君たちは何の変わりもないようね。だから…この対戦を何の心配もなく終わらせられるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851504,
						400851505
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400851504,
					"content": "#変わるのは{M#君}{F#あなた}のほう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400851506
					]
				},
				{
					"id": 400851506,
					"content": "そうだ！オイラたちとポコポコビーニー、それから他の仲間たちとの連携は絶対負けないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851507
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400851507,
					"content": "はぁ…分かったわ。それじゃ、その軟弱な戦い方と本物のテイマーの戦い方の差を見せてあげる…炎1！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400851505,
					"content": "実力で説得して見せる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400851506
					]
				}
			]
		},
		{
			"id": 4008516,
			"completionStepIds": [
				4008517
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
