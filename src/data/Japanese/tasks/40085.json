			"trigger": {
				"objectNames": [
					"エルヒンゲン",
					"八重神子",
					"レイラ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400851601,
					"content": "観客、そして選手の皆様——数々の激戦を経て、いよいよ「サウマラタ蓮杯」の決戦が始まります！テイマーのハニヤーが旅人との勝負を決める時です！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851602
					],
					"speakerTitle": "エルヒンゲン"
				},
				{
					"id": 400851602,
					"content": "勝者が最終テストに合格すれば、私の全財産を受け取るとともに、大会を継続して行う責任を担うことになります。そして、全テイワットに平和のあるべき道を引き続き宣伝してくれることでしょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851603
					],
					"speakerTitle": "エルヒンゲン"
				},
				{
					"id": 400851603,
					"content": "今日はカウトリヤがいないみたいだ…チャンスだぜ！決戦と最終テストの後は、まずエルヒンゲンを説得して、それからカウトリヤと直接話し合おうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400851604,
					"content": "神子にレイラ。おまえらも来てくれたのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851605
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400851605,
					"content": "神子とレイラに、ハニヤーの事とこれからの計画を話した。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400851606
					]
				},
				{
					"id": 400851606,
					"content": "やはりな。せっかちな学術狂いも、ついに主人公一行に正体を現しおったか…汝らの推測は、真実に近いところにあったんじゃな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851607
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400851607,
					"content": "しばらくは教令院には伝えないでおくというのも、慎み深い判断じゃった。何せ、カウトリヤか…あるいは他の者が、切り札を残しておるかもしれんからの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851608
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400851608,
					"content": "まあ、今の状況じゃ気を抜くに抜けないぜ。あの最強と呼ばれるハニヤーと対戦することになった上、エルヒンゲンの「最終テスト」がなにかもまだわからないんだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851609
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400851609,
					"content": "それに、ハニヤーを説得する方法だって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851610
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400851610,
					"content": "何、答えは明白じゃろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851611
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400851611,
					"content": "妾たちのキノコンたちを連れてハニヤーをあっさりと倒し、あやつの態度を改めてから真実を投げ込めばよい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851612
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400851612,
					"content": "あなたたちなら…きっと、ハニヤーさんを正しい道に戻せるって、信じてるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851613
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400851613,
					"content": "応援、ありがとう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400851614
					]
				},
				{
					"id": 400851614,
					"content": "よっしゃ！ポコポコビーニー、テンテンヨーヨー獣、それに百雷遮羅…一番よく知る仲間たちと肩を並べて戦うぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851615
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400851615,
					"content": "みんなの力を結集したのが、今のオイラたちだ。だから、絶対負けないぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
