				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400850901,
					"content": "ポコポコビーニー！大丈夫か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850902
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400850902,
					"content": "一対三はさすがにきついね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850903
					]
				},
				{
					"id": 400850903,
					"content": "おかしい、そのプカプカ水キノコン…裏コマンドを三回も発動したのに、どうしてまだ旅人の指示を受けているんです？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850904
					],
					"speakerTitle": "エルヒンゲン"
				},
				{
					"id": 400850904,
					"content": "カウトリヤの装置が壊れたか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850905
					],
					"speakerTitle": "エルヒンゲン"
				},
				{
					"id": 400850905,
					"content": "ほう、まだ気づけておらんようじゃな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850906
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400850906,
					"content": "「叡智宝珠」の技術は、確かにキノコンをテイマーの命令に従わせられる。じゃがそれは、あくまでもやつらの本能を抑え、「生物」としてのキノコンとテイマーとの交流を深めたに過ぎぬ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850907
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400850907,
					"content": "この四体のキノコンはテイマーを認めておる——やつらの間の感情と絆は、とっくに「叡智宝珠」の影響を凌駕しているんじゃが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850908
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400850908,
					"content": "八重神子…あなた、秘境封印の術法を解除できたのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850909
					],
					"speakerTitle": "エルヒンゲン"
				},
				{
					"id": 400850909,
					"content": "粗末な模倣品で、妾を阻むつもりとは？どうやら、甘く見られておるようじゃな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850910
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400850910,
					"content": "寄せ集めの「裏コマンド」が、本当に何の弱点も露わにしてないとでも思うたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850911
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400850911,
					"content": "面倒な…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850912
					],
					"speakerTitle": "エルヒンゲン"
				},
				{
					"id": 400850912,
					"content": "神子にレイラ！ハニヤーも来たのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850913
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400850913,
					"content": "エルヒンゲン…君が首謀者だったのね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850914
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400850914,
					"content": "キノコンよりも、君の野心のほうがもっと許せないわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850915
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400850915,
					"content": "八重お姉さん…早く手伝いに行こう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850916
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400850916,
					"content": "焦るでないぞ、レイラちゃん。こういう時はちゃんと見届けるんじゃ。仲間の絆というものは、世俗的な陰謀や技術に破壊されたりはせぬものよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850917
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400850917,
					"content": "百雷遮羅、まだ任務をやり遂げてないじゃろう？ここで屈服してどうする？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850918
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400850918,
					"content": "あれ？見ろ、百雷遮羅が意識を取り戻したみたいだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850919
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400850919,
					"content": "もしかして、今が八重お姉さんの言うタイミングなの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850920
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400850920,
					"content": "テンテンヨーヨー獣、信じてるよ！あの嘘つきを倒そう…コホンッ、ゴホッ…ゴホッ…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850921
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400850921,
					"content": "キノコンの仲間たちが裏コマンドで受けてた影響が…消えてくぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850922
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400850922,
					"content": "まだ躊躇っておるのか、ハニヤー？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850923
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400850923,
					"content": "怖いか？…「駒」として使ってきたキノコンが、常に汝を信じておること——そして今まで避けてきた感情を今、直視せざるを得んのが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850924
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400850924,
					"content": "でも、汝のキノコンは待ちくたびれておるようじゃぞ。「叡智宝珠」のコントロールから逃れた後も、ずっと汝の命令を待っておる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850925
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400850925,
					"content": "炎1…君は、本当に私を待ってるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850926
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400850926,
					"content": "ごめんね、ずっと厳しくしてきたのに、まだ私を信じてくれていたのね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850927
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400850927,
					"content": "さあ、やるべきことをやり遂げましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850928
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400850928,
					"content": "なんだかわからないけど、キノコンはみんな目が覚めたみたいだぞ！よっしゃあ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850929
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400850929,
					"content": "エルヒンゲン！この卑怯者め…オイラたちの怒りを受け止める準備はできたか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850930
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400850930,
					"content": "慌てず、秩序を崩さずに迎え撃ちましょう。相手はただのキノコン…私たちはまだ主導権を握っています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エルヒンゲン"
				}
			]
		},
		{
			"id": 4008510,
			"completionStepIds": [
				4008510
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008510",
							"2"
						],
						"stepId": 4008510,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"エルヒンゲン",
					"八重神子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400851001,
					"content": "くっ、キノコンの群れに負けるなどと…あり得ない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851002
					],
					"speakerTitle": "エルヒンゲン"
				},
				{
					"id": 400851002,
					"content": "逃がさない！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400851003
					]
				},
				{
					"id": 400851003,
					"content": "神子、どうしてやつを止めないんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851004
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400851004,
					"content": "ん？妾は観光客じゃ。スメール領内で誰かを逮捕する権利など持っておらぬ。汝らも同じじゃろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851005
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400851005,
					"content": "じゃが安心せい、やつは逃げられぬ。会場に戻ったら、自ずと分かろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851006
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400851006,
					"content": "よし、深く考えずに、さっさと追いかけようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 4008512,
			"completionStepIds": [
				4008512
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008512",
							"2"
						],
						"stepId": 4008512,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"シード",
					"エルヒンゲン",
					"八重神子",
					"レイラ",
					"ハニヤー",
					"ダッシュデーツ",
					"左右加"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400851201,
					"content": "おまえらは…「三十人団」の傭兵？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400851202,
					"content": "やっと動き出した。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400851203
					]
				},
				{
					"id": 400851203,
					"content": "大マハマトラセノの命により、重罪人エルヒンゲン、および学術犯罪者カウトリヤを逮捕しに参った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851204
					],
					"speakerTitle": "シード"
				},
				{
					"id": 400851204,
					"content": "大マハマトラは前からカウトリヤに目をつけていたが、お忙しく相手をする暇がなかった。こうして無事に逮捕できるのは、君たちが提供してくれた証拠のおかげだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851205
					],
					"speakerTitle": "シード"
				},
				{
					"id": 400851205,
					"content": "大マハマトラからお二人への手紙だ。受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851206
					],
					"speakerTitle": "シード"
				},
				{
					"id": 400851206,
					"content": "セノはずっとこの大会を見守ってたんだ…オイラたちが調査してる間も、裏で手がかりを集めて、みんなの安全を守る準備をしてたんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851207,
						400851208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400851207,
					"content": "いいタイミングだったね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400851209
					]
				},
				{
					"id": 400851209,
					"content": "では、犯人はこちらで連れて行く。君たちがここにいるなら、会場の秩序を心配する必要もないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851210
					],
					"speakerTitle": "シード"
				},
				{
					"id": 400851210,
					"content": "祝うにはまだ早いですよ。まだ終わってはいません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851211
					],
					"speakerTitle": "エルヒンゲン"
				},
				{
					"id": 400851211,
					"content": "ドットーレ様のために、必ずまた戻ってきます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851212
					],
					"speakerTitle": "エルヒンゲン"
				},
				{
					"id": 400851212,
					"content": "まだ強がってるのか？牢屋で改心するんだな、ファデュイの嘘つきめ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400851213,
					"content": "それにしても、セノの手紙では証拠とか言ってたな。ベスト16の後、神子がいなかったけど…通報しに行ってたってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400851214,
					"content": "む、なぜそのように妾を見る？妾も悩んでおるんじゃぞ。せっかくの休暇なのに、暇なく色んな者に見つかって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851215
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400851215,
					"content": "編集たちを連れてスメールシティを廻っておったら、奇遇にも大マハマトラとばったり会うて雑談しただけじゃ。肝心なのは、汝らが集めてきた手がかりじゃぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851216
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400851216,
					"content": "うーん…簡単そうに言うほど、背後になにかあるんじゃないかと疑っちゃうぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851217
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400851217,
					"content": "ところで、主催側もスポンサーも逮捕されちゃったけど、キノコンとこの大会はどうなるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851218
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400851218,
					"content": "ルールはルールじゃ。童たちが優勝し、最終テストも通過した。つまり、カウトリヤとエルヒンゲンの座を奪ったのじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851219
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400851219,
					"content": "これから、大会のすべては童たちのもの。色んなことを経験してきた童たちならば、最善の決定を出せるはずじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851220,
						400851221
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400851220,
					"content": "まずはハニヤーに真相を告げる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400851222
					]
				},
				{
					"id": 400851222,
					"content": "真相なら、狐の人からすでに聞いたわ。私のご先祖様を襲ったキノコンは、狂暴化していたって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851223
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400851223,
					"content": "私のキノコンに対する印象は、根底から誤っていて、極端すぎたみたいね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851224
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400851224,
					"content": "えっ？オイラたち、まだなにも言ってないのに！うぅ、神子に先を越された…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851225
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400851225,
					"content": "ほう、感謝の気持ちはないものか？落ち込んだハニヤーを立ち直らせ、汝たちの道を応援させるには、少しばかり心を動かすものが必要じゃろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851226
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400851226,
					"content": "みんな、それ以上言わなくて大丈夫よ…確かに前は意固地になり続けて、完全に麻痺するまで自分を欺いていた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851227
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400851227,
					"content": "でも、今こうして真相を見たわ。「叡智宝珠」がなくても、炎1は私の命令を聞いてくれた。この子は、ずっと私を信じてくれてた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851228
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400851228,
					"content": "私の負けよ。君たちの異議と処罰を受け入れるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851229
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400851229,
					"content": "処罰だなんて大袈裟だぞ。怖い話をしたり、炎1に厳しくしただけで、まだ悪いことはしてなかったじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851230
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400851230,
					"content": "ちょうどいいぜ！これからどうすればいいのか、思いついたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851231
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400851231,
					"content": "#{M#俺}{F#私}もいい案がある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400851232
					]
				},
				{
					"id": 400851232,
					"content": "みんなと一緒に最終決定と文言を決めた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400851233
					]
				},
				{
					"id": 400851233,
					"content": "よし！オイラ、もう完璧だぞ！今すぐみんなにお知らせしようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851234,
						400851235
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400851234,
					"content": "優勝者スピーチはパイモンに任せた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400851236
					]
				},
				{
					"id": 400851236,
					"content": "コホンッ…こんな舞台で、大人数に向けて話すのは初めてだぞ…ちょっと緊張してきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851237
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400851237,
					"content": "この度、オイラと旅人が運よく優勝者になった上、陰謀を暴けてとっても嬉しいぞ！この大会をより良く開催する責任は、オイラたちが担うことになった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851238
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400851238,
					"content": "主催側とスポンサーは逮捕されたけど、各出場選手の報酬は予定通り配るから、どうか安心してくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851239
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400851239,
					"content": "やった！これを待ってた！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851240
					],
					"speakerTitle": "ダッシュデーツ"
				},
				{
					"id": 400851240,
					"content": "賢明な判断ですね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851241
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 400851241,
					"content": "ただ、今の「叡智宝珠」にはまだ欠点がある…周囲の環境に影響を与えて、人々に健康上の問題を引き起こしてしまうことがあるんだ。だから、キノコンの仲間はまだ、いつもみんなのそばにいるってわけにはいかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851242
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400851242,
					"content": "健康のために、各選手はキノコンの仲間としばらく一緒に過ごした後、キノコンを一番頼れるテイマーのハニヤーに預けてほしいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851243
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400851243,
					"content": "でも、仲間と長く離れ離れになることはないぞ！ハニヤーがキノコンたちの面倒を見てくれてる間、オイラたちは教令院に「叡智宝珠」の改良をお願いして、一刻も早くこの問題を解決して見せる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851244
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400851244,
					"content": "それに、今回の大会は面白かった！一回だけじゃつまらないし、みんなももっと対戦したいよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851245
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400851245,
					"content": "技術的な問題が解決したら、おまえたちもキノコンの仲間と再会できるはずだ！その時には、またみんなで勝負しようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851246
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400851246,
					"content": "これが…私への処罰？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851247
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400851247,
					"content": "準優勝者へのご褒美と言った方が正しそうじゃな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851248
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400851248,
					"content": "心配しないで、ハニヤーさん。キノコの仲間と仲良くするのは、結構幸せなことだよ。あなたもそうでしょ、テンテンヨーヨー獣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851249
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400851249,
					"content": "それでもやっぱり…何だか少し寂しいな。テンテンヨーヨー獣のこと、あなたに任せたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851250
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400851250,
					"content": "旅人、パイモン…それにレイラ、狐の人…君たちは本当に不思議ね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851251
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400851251,
					"content": "ハニヤー、みんなの前で宣言しちゃったんだから、おまえも元気出すんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851252
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400851252,
					"content": "ええ、君たちの言いたいことは、聞かなくても分かるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851253
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400851253,
					"content": "テイマーとして、その依頼を受け入れましょう。最善を尽くして、キノコン——みんなの大切な仲間を、ちゃんと世話するから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851254
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400851254,
					"content": "へへっ、もっと早くその表情を出せば良かったのに！それでこそ、オイラたちが友達になりたい、超すごいハニヤーだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851255
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400851255,
					"content": "じゃあ、みんなはしばらく、自分の仲間と思いっきり遊んでくれ。あとでまた、オルモス港で落ち合おうな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400851235,
					"content": "活躍する機会をパイモンに譲る。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400851236
					]
				},
				{
					"id": 400851221,
					"content": "まずはハニヤーに考えを改めてもらう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400851222
					]
				},
				{
					"id": 400851208,
					"content": "あとは任せる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400851209
					]
				}
			]
		},
