			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ハニヤー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400850401,
					"content": "どうしてこうなったの…炎1？どうして全力で戦わないのよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850402,
						400850403
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400850402,
					"content": "#命令を出したのは{M#君}{F#あなた}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850404
					]
				},
				{
					"id": 400850404,
					"content": "炎1を責めるなよ。それにおまえも無理するな、ハニヤー。準決勝の時、おまえは炎1が傷を負うのをみて、ためらっただろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400850405,
					"content": "おまえはオイラたちと神子以外で、自分と対等に戦える相手に出会ったことがなかったんじゃないか？炎1と他の仲間を苦戦させたこともない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400850406,
					"content": "そして、炎1と仲間たちが傷を負うのを見ると、やっぱり心が痛むんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850407
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400850407,
					"content": "無理する？今さら、キノコンが傷を負った程度で心が動くとでも？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850408,
						400850409
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400850408,
					"content": "推測じゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850410
					]
				},
				{
					"id": 400850410,
					"content": "ハニヤー…おまえは怖い物語を聞かされて育った。キノコンのことを警戒するのも十分わかる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850411
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400850411,
					"content": "だけど、ぼやけた印象だけで目の前の仲間を凶悪な敵にしちゃうなんて…なあ、時間が経つほど、自分をごまかせなくなってるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850412
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400850412,
					"content": "オイラたちもよく狂暴なキノコンを討伐してた。ついこないだまでは、キノコンを純粋な魔物として扱ってたんだ。参戦目的だって、最初はキノコンの暴走を防ぐことだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400850413,
					"content": "でもポコポコビーニーに出会って、気付いたんだ。努力をやめずに、本当の気持ちで温和なキノコンと向き合えば、こいつらも応えてくれる。オイラたちと仲良く交流してくれるってな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850414
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400850414,
					"content": "少なくとも、こいつらみたいに温和なキノコンはおまえの仲間であって、駒や敵なんかじゃないぞ！オイラたち、おまえに炎1や他のキノコンを信じて欲しいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850415,
						400850416
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400850415,
					"content": "そして過激な発想をやめて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850417
					]
				},
				{
					"id": 400850417,
					"content": "黙って、まだ対戦中よ！もう優勝者面で私に説教する気！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400850416,
					"content": "理性を持ってキノコンという種に向き合おう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850417
					]
				},
				{
					"id": 400850409,
					"content": "#{M#君}{F#あなた}が認めたくないだけ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850410
					]
				},
				{
					"id": 400850403,
					"content": "#{M#君}{F#あなた}はもう気弱になっちゃった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850404
					]
				}
			]
		},
		{
			"id": 4008505,
			"completionStepIds": [
				4008505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008505",
							"2"
						],
						"stepId": 4008505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ハニヤー",
					"エルヒンゲン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400850501,
					"content": "失敗よ…まだ一番重要な一歩を踏み出せていないっていうのに、失敗したわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850502
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400850502,
					"content": "結局、君たちは最大の変数になったってことね…でも、そんな幼稚な考えで、どうして私に勝てたわけ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850503,
						400850504
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400850503,
					"content": "その理由を説明してあげる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850505
					]
				},
				{
					"id": 400850505,
					"content": "ハニヤー、オイラたちが勝ったんだから、約束通り話を聞いてくれるよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850506
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400850506,
					"content": "でも、話は一旦あとにしたいんだ。まずは炎1に最終テストまでついてきてもらえないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850507
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400850507,
					"content": "炎1？この子を連れて行くの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850508
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400850508,
					"content": "ああ！ポコポコビーニーとテンテンヨーヨー獣、百雷遮羅、それとおまえの炎1…みんなのキノコンの力を合わせて、最終テストを通過するんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850509,
						400850510
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400850509,
					"content": "そして大会の最高権限を手に入れる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850511
					]
				},
				{
					"id": 400850511,
					"content": "あの日、おまえと会話してノートを手に入れた後、オイラたち色々と考えたんだ——キノコンの安全性についてだけどさ、確かにおまえの考えも一理ある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850512
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400850512,
					"content": "「叡智宝珠」は人の健康に影響を及ぼすし、大会は過度に宣伝すべきじゃない。キノコンと人間の近くでは暮らすべきじゃないと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850513
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400850513,
					"content": "でも、叡智宝珠を改良しながらキノコンと交流を深めて、温和なキノコンを見出していけば、この群れと少しずつ仲良くなることは可能なはずだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850514
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400850514,
					"content": "…好きにすればいいわ。私はどうせ負けたし、敗者が頑固に言い張る資格なんかないもの…炎1も…いつも自分のことを思いやってくれる主が欲しいでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850515
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400850515,
					"content": "ハニヤー、しっかりしろ！仲間の心にいる自分の位置を見誤るなよ…最終テストに合格したら、もっと大事な話があるんだからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850516,
						400850517
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400850516,
					"content": "#{M#君}{F#あなた}の先祖について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850518
					]
				},
				{
					"id": 400850518,
					"content": "そうだぞ！当時なにが起きたかわかれば、おまえも考え直すかもしれない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850519
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400850519,
					"content": "素晴らしい、実に素晴らしい対戦でした！観点の対決もまことに感慨深い！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850520
					],
					"speakerTitle": "エルヒンゲン"
				},
				{
					"id": 400850520,
					"content": "エルヒンゲン？なんで会場に入って来たんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850521
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400850521,
					"content": "もちろん、両者の最終決戦…そして優勝者の、最終テストでの姿を見届けるためです！大会にとって、これは歴史的な時。欠席するわけにはいかないでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850522
					],
					"speakerTitle": "エルヒンゲン"
				},
				{
					"id": 400850522,
					"content": "さあいらっしゃい、旅人とパイモン。私にあなたたちの意志を証明してみてください！あなたたちなら、きっとこの大会を昇華させるカギになれる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エルヒンゲン"
				},
				{
					"id": 400850517,
					"content": "襲撃の真相…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850518
					]
				},
				{
					"id": 400850510,
					"content": "キノコンの仲間たちを適切に配置する。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850511
					]
				},
				{
					"id": 400850504,
					"content": "#{M#君}{F#あなた}ならきっと理解できる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850505
					]
				}
			]
		},
		{
			"id": 4008508,
			"completionStepIds": [
				4008508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008508",
							"2"
						],
						"stepId": 4008508,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"エルヒンゲン",
					"エルヒンゲン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400850801,
					"content": "どういうことだ…？ファデュイがあちこちいるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850802
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400850802,
					"content": "エルヒンゲン！会場に悪者が侵入してるぞ！早く逃げろ、オイラたちが相手するから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850803
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400850803,
					"content": "って、待てよ、出口はどこだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850804,
						400850805
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400850804,
					"content": "会場が悪者の侵入を受けたんじゃない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850806
					]
				},
				{
					"id": 400850806,
					"content": "さすがは旅人、察しがよろしい。さあ、このような窮地にも対応する策はありますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850807
					],
					"speakerTitle": "エルヒンゲン"
				},
				{
					"id": 400850807,
					"content": "オイラ、よくわからないぞ…今は、最終テストじゃなかったのか？黒幕はカウトリヤじゃなかったのか？やつはこの大会で成果を出すために、おまえのお金を騙し取ったんじゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850808
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400850808,
					"content": "真相まであと一歩というところです。カウトリヤの動機は確かにおっしゃる通りだ。彼の発掘した失われた技術は、素晴らしい力を秘めています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850809
					],
					"speakerTitle": "エルヒンゲン"
				},
				{
					"id": 400850809,
					"content": "だから、彼を買ってこの大会を計画し、この技術の影響力を広げようとしているのです。まあ、あなたのような価値の高い目標が自ら釣り針にかかるとは、思ってもみませんでしたが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850810,
						400850811
					],
					"speakerTitle": "エルヒンゲン"
				},
				{
					"id": 400850810,
					"content": "自ら手の内を明かすんだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850812
					]
				},
				{
					"id": 400850812,
					"content": "つまり…おまえは初めからカウトリヤに騙されてないし、それどころか、カウトリヤを利用したのか？おまえ、元々ファデュイの悪者だったんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850813
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400850813,
					"content": "くぅ、ムカつくぜ！おまえに気を付けろって言ってやろうとしてたのに！ポコポコビーニー、こいつを殴るぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850814
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400850814,
					"content": "気迫は素晴らしいですが、自信に満ち溢れすぎたようですね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850815
					],
					"speakerTitle": "エルヒンゲン"
				},
				{
					"id": 400850815,
					"content": "テンテンヨーヨー獣？百雷遮羅…それに炎1まで？おまえら、どうしたんだ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850816
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400850816,
					"content": "カウトリヤは「叡智宝珠」に裏コマンドを追加したのですよ。私がこのコマンドを実行すれば、宝珠にコントロールされたすべてのキノコンは私の言いなりになります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850817
					],
					"speakerTitle": "エルヒンゲン"
				},
				{
					"id": 400850817,
					"content": "裏コマンド？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850818
					]
				},
				{
					"id": 400850818,
					"content": "まさか…大会を大々的に宣伝することで人々にキノコンをたくさん捕まえさせて、それを乗っ取って悪事を働こうとしてるのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850819
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400850819,
					"content": "鋭い勘ですね、とてもいいですよ。大会をもっと広げれば、民間に膨大な数のキノコン部隊が出来上がる。スメールで混乱を引き起こすチャンスを作ってくれるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850820
					],
					"speakerTitle": "エルヒンゲン"
				},
				{
					"id": 400850820,
					"content": "私が同僚の手に負えないようなことを成し遂げれば、私の敬愛する主——あなたたちのせいでここを去ったドットーレ様も、私にまだ価値があると再認識してくれるはずだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850821,
						400850822
					],
					"speakerTitle": "エルヒンゲン"
				},
				{
					"id": 400850821,
					"content": "「ドットーレ」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850823
					]
				},
				{
					"id": 400850823,
					"content": "今、私はもっとうまくやれます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850824
					],
					"speakerTitle": "エルヒンゲン"
				},
				{
					"id": 400850824,
					"content": "あなたたちを排除できれば、長官や多くの同僚の汚名を晴らし、最も偉大な功績で組織に貢献できる…ドットーレ様も、私を最重視してくれる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850825
					],
					"speakerTitle": "エルヒンゲン"
				},
				{
					"id": 400850825,
					"content": "あなたたちの死は事故として喧伝しましょう——キノコンのことを信じすぎて、限界を突破しようとした結果…会場が崩れて遭難してしまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850826
					],
					"speakerTitle": "エルヒンゲン"
				},
				{
					"id": 400850826,
					"content": "そしてこの秘境を封鎖して、あなたたちに起こったことを誰にも知らせずにおくのです。もちろん、教令院に対してはカウトリヤに全責任と罪を背負ってもらいます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850827
					],
					"speakerTitle": "エルヒンゲン"
				},
				{
					"id": 400850827,
					"content": "その後はあなたたちへの追悼を名目に、さらに多くのモラを投入し、宣伝に力を入れ、大会をもっと頻繁に開催して…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850828
					],
					"speakerTitle": "エルヒンゲン"
				},
				{
					"id": 400850828,
					"content": "おまえ、なんで平気な顔してでたらめを言えるんだ？それに仲間を裏切るって…卑怯すぎるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850829
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400850829,
					"content": "くぅっ…おまえの話を聞いて、すっごくムカムカしてきたぞ！絶対おまえの思い通りになんかさせるもんか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850830
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400850830,
					"content": "でも、どうしよう？おまえは今武器を持ってないし、他のキノコンの仲間も言うことを聞いてくれないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850831,
						400850832
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400850831,
					"content": "まずは自分を守って！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850833
					]
				},
				{
					"id": 400850833,
					"content": "焦って動く必要はありませんよ。キノコン対キノコン、そして戦士対戦士。旅人の仲間たちが倒され、信念が崩れ落ちたその時——とどめを刺してあげればいいのですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850834
					],
					"speakerTitle": "エルヒンゲン"
				},
				{
					"id": 400850834,
					"content": "私たちのこれまでのやり方は綺麗とは言えませんでした。ですから少なくとも、礼を欠かず、敬意を払って旅人をお送りしましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エルヒンゲン"
				},
				{
					"id": 400850832,
					"content": "ポコポコビーニーを信じる！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850833
					]
				},
				{
					"id": 400850822,
					"content": "#{M#君}{F#あなた}は博士の残党だったんだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850823
					]
				},
				{
					"id": 400850811,
					"content": "続きは牢屋で話せば？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850812
					]
				},
				{
					"id": 400850805,
					"content": "エルヒンゲンが手配したんだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850806
					]
				}
			]
		},
		{
			"id": 4008509,
