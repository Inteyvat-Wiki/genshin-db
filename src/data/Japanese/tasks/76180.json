				"objectNames": [
					"「少女」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761800601,
					"content": "そ…そんな！ありえないわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800602
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 761800602,
					"content": "キミの負けだね、サンドローネ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800603
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761800603,
					"content": "て…手加減してあげたのよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800604
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 761800604,
					"content": "本当？すごく悔しそうだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800605
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761800605,
					"content": "くっ…もう一回よ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800606
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 761800606,
					"content": "ふん、楽勝ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800607
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 761800607,
					"content": "負けちゃった。やっぱりサンドローネはすごいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800608
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761800608,
					"content": "次はもっと難しいゲームで遊びましょう。面白いパズルをたくさん知ってるのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800609
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 761800609,
					"content": "うん…ふふっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800610
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761800610,
					"content": "な、何笑ってるのよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800611
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 761800611,
					"content": "サンドローネのこんな嬉しそうな姿なんて、前はあんまり見れなかったから。私をゲームに誘ってくれたことなんてほとんどないし、むしろ追い出してたでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800612
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761800612,
					"content": "ちょっと…ワタシがいじめていたみたいな言い方しないでくれるかしら！これからは、もっとお茶会に誘うから…それでいいでしょう！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800613
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 761800613,
					"content": "うん、嬉しい。私、サンドローネと一緒のお茶会が大好き。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				}
			]
		},
