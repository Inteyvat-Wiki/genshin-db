			},
			"dialogs": [
				{
					"id": 761800801,
					"content": "キミとゲームができて楽しかった。また遊ぼうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800802,
						761800803
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761800802,
					"content": "（もう少し、座っていようかしら。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800804
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 761800804,
					"content": "もう行っちゃうの？わかった。じゃあ、またね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761800803,
					"content": "そろそろお茶会はお開きにしましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800804
					],
					"speakerTitle": "「傀儡」"
				}
			]
		}
	]
