			"dialogs": [
				{
					"id": 761800401,
					"content": "前はいつもサンドローネの庭に集まってたから、サンドローネが私の庭にお茶を飲みに来るのって、なんだか新鮮だね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800402
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761800402,
					"content": "まあ、お茶とお菓子はワタシが用意しているから、たいして変わっていない気がするけれど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800403
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 761800403,
					"content": "うん、やっぱり美味しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800404
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761800404,
					"content": "ふん。ところで、旅人もよくアナタに会いにここに来てるそうね。具体的には何をしているの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800405
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 761800405,
					"content": "うーん…一緒におしゃべりしたり、月霊と遊んだり、月霊が絵を描くのを眺めたり…かな。あ、月並べもするよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800406
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761800406,
					"content": "「月並べ」…って、三つの石を一列に並べるあのゲーム？旅人とアナタ、どっちが勝ち越しているの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800407
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 761800407,
					"content": "数えてない。でも旅人、結構上手だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800408
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761800408,
					"content": "ふふっ…ワタシとやってないからそう思うんじゃないかしら？本当の「上手」とはどんなものか、教えてあげる。引き分けだったら、ワタシの負けでいいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800409
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 761800409,
					"content": "いいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				}
			]
		},
		{
			"id": 7618006,
			"completionStepIds": [
				7618004
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
