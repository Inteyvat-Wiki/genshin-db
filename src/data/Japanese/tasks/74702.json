			},
			"dialogs": [
				{
					"id": 747020101,
					"content": "あら、最近はずいぶん沢山魚を持ち帰っているわね。水槽の飾り付けも、だんだんそれらしくなってきたじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020102
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 747020102,
					"content": "へへっ、オイラたち、こういうのは得意なんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747020103,
					"content": "達成感を感じているみたいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020104
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 747020104,
					"content": "もちろんだ！でも達成感もあるけど、まだなんだかちょっと…ちょっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020105,
						747020106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747020105,
					"content": "物足りない気持ち？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020107
					]
				},
				{
					"id": 747020107,
					"content": "そうそう！そんな感じがしてるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747020108,
					"content": "それはどうして？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020109
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 747020109,
					"content": "オイラもわからないけど…なんだか、まだなにかが足りない気がしてるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020110,
						747020112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747020110,
					"content": "レストランとか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020111
					]
				},
				{
					"id": 747020111,
					"content": "おい！違うぞ！こんなに綺麗な魚を食べるわけないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747020114,
					"content": "足りないのは、成果を見に来てくれるお客さんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747020115,
					"content": "つまり…このアクアリウムをオープンさせて、観光客を迎え入れたいってことかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020116
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 747020116,
					"content": "なにか不安なことでもあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020117,
						747020118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747020117,
					"content": "ここが賑やかになりすぎるのを心配してる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020119
					]
				},
				{
					"id": 747020119,
					"content": "それなら、経営と宣伝についてはオイラたちに任せるといいぞ！こっちの心配はいらないから、サンドローネは安心して自分のことをやっててくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747020120,
					"content": "そこまで言うなら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020121
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 747020121,
					"content": "売上は三対七で山分け！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020122
					]
				},
				{
					"id": 747020122,
					"content": "えっ…？オイラたち、七割しかもらえないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747020123,
					"content": "七割は向こうの分だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020124
					]
				},
				{
					"id": 747020124,
					"content": "そっか、この船はサンドローネが借りてるんだもんな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747020125,
					"content": "はいはい、ワタシを理不尽な大家みたいに言わないでちょうだい。実際に働くのはアナタたちなんだから、ワタシは少ない方でいいわ。ワタシはパンタローネみたいにケチじゃないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020126
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 747020126,
					"content": "ってことは…アクアリウムを営業してもいいってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747020127,
					"content": "ええ、勝手にして。ワタシの研究の邪魔さえしなければいいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020128
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 747020128,
					"content": "やった！ウィンガレット・プクプクアクアリウム、オープンだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020129
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747020129,
					"content": "もう名前まで考えていたのね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 747020118,
					"content": "面倒なことになるのを心配してる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020119
					]
				},
				{
					"id": 747020112,
					"content": "お客さんがいない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020113
					]
				},
				{
					"id": 747020113,
					"content": "あっ！そうだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747020106,
					"content": "寂しい気持ち？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020107
					]
				}
			]
		}
	]
}