			"dialogs": [
				{
					"id": 223020301,
					"content": "坊ちゃまは一体どこに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020302
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 223020302,
					"content": "常九が書いた本について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223020303
					]
				},
				{
					"id": 223020303,
					"content": "えっ？か、彼まだ書いてるんですか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020304
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 223020304,
					"content": "ああ、そういえばこの前稲妻国のコンテストに参加すると言ってましたね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020305
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 223020305,
					"content": "今回は何の話です？前回は七星に関する本で、絶対出版してくれって頼まれましたが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020306
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 223020306,
					"content": "出版するどころか、千岩軍に怒られそうになりましたよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020307
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 223020307,
					"content": "でも今回は稲妻国のコンテストですから、私たちには関係ありませんね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020308
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 223020308,
					"content": "原稿を私に渡してください。持っていくように商会の人に言っておきますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020309
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 223020309,
					"content": "でも常九殿は今回も勝ち目がないかもしれませんね。稲妻国では今『沈秋拾剣録』という本が流行ってると聞きました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020310
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 223020310,
					"content": "璃月の人が書いたものらしいのですが、誰が書いたかは分かってないんです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020311
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 223020311,
					"content": "そうだ、原稿を届けてくれてありがとうございます。本来は常九殿からお金をもらった私たちが取りに行くはずでした。これはあなたにお渡しします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿旭"
				}
			]
		},
