			"dialogs": [
				{
					"id": 223020201,
					"content": "この先は<color=#00E1FFFF>飛雲商会</color>だぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 223020202,
					"content": "原稿を<color=#00E1FFFF>入口の人</color>に渡せばいいんだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 223020203,
					"content": "それにしても…気になるよな。一体どんな小説なんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 223020204,
					"content": "どうだ？こっそり見てみるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
