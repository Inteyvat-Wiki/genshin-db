			"dialogs": [
				{
					"id": 223020101,
					"content": "今度はうまく行けるはず…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020102
					],
					"speakerTitle": "常九"
				},
				{
					"id": 223020102,
					"content": "なにが？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223020103
					]
				},
				{
					"id": 223020103,
					"content": "君、稲妻国で小説のコンテストがあるって知ってるかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020104
					],
					"speakerTitle": "常九"
				},
				{
					"id": 223020104,
					"content": "確か…「この小説はすごい！」というタイトルで、稲妻国の「八重堂」が主催するもの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020105
					],
					"speakerTitle": "常九"
				},
				{
					"id": 223020105,
					"content": "このコンテストのために、長い間準備してきて、稲妻の人気な小説をいろいろ読んで参考にしたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020106
					],
					"speakerTitle": "常九"
				},
				{
					"id": 223020106,
					"content": "あんなに読んで研究した本の山…璃月と稲妻の文化を融合したわしの小説はきっと優勝間違いなし！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020107
					],
					"speakerTitle": "常九"
				},
				{
					"id": 223020107,
					"content": "わしの小説をコンテスト担当に届けてもらうように、飛雲商会と話はしてあるんだが、集荷する者が来なくてね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020108
					],
					"speakerTitle": "常九"
				},
				{
					"id": 223020108,
					"content": "すまないが、君に時間があるなら、この原稿を<color=#00E1FFFF>飛雲商会</color>に届けてくれないかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020109,
						223020111
					],
					"speakerTitle": "常九"
				},
				{
					"id": 223020109,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223020110
					]
				},
				{
					"id": 223020110,
					"content": "では頼んだ。今度は絶対にうまく行けるはずだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "常九"
				},
				{
					"id": 223020111,
					"content": "小説のテーマは…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223020112
					]
				},
				{
					"id": 223020112,
					"content": "それは教えられない。なにせコンテストに参加する大事な作品だからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020113
					],
					"speakerTitle": "常九"
				},
				{
					"id": 223020113,
					"content": "今回成功したらきっと何もかもうまく行くはず…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "常九"
				}
			]
		},
