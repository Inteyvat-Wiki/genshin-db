						223020402
					],
					"speakerTitle": "常九"
				},
				{
					"id": 223020402,
					"content": "うまく行けたら、この本は全世界で売られることになって、彼女もきっと目にするはずだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020403
					],
					"speakerTitle": "常九"
				},
				{
					"id": 223020403,
					"content": "な、なんでまだここにいるんだ？早く原稿を<color=#00E1FFFF>飛雲商会</color>に届けてくれたまえ。",
					"roleType": "TALK_ROLE_NPC",
