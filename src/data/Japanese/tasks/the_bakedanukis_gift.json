			},
			"dialogs": [
				{
					"id": 790350101,
					"content": "#{NICKNAME}さん、パイモンさん、お二方は二匹の妖狸をご存じですか？一匹は紫色のふろしき、もう一匹は黄色のふろしきを背負っているのですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350102
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 790350102,
					"content": "あっ！きっと豆助と柴助のことだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790350103,
					"content": "どうやら確かにご存じのようですね、よかったです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350104
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 790350104,
					"content": "ん？あいつらになにかあったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790350105,
					"content": "いえ、そういうわけではありません。ただ、身振り手振りでこれを渡されまして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350106
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 790350106,
					"content": "お二方は、稲妻の妖狸と鹿狩りに行ったことがあるとお聞きしました。ですので、もしかしたらあの二匹の妖狸もお二方のお友達なのではと考えたのです。彼らはきっと、これをお二方に渡したかったのでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350107
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 790350107,
					"content": "おお！豆助と柴助からの贈り物だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790350108,
					"content": "へへっ、どうやらあいつらも、順調に旅を始めたみたいだな。いつかまた会えるかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
