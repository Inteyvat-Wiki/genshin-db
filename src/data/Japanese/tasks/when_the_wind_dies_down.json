			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アンバー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3980101,
					"content": "あっ、あんたたち！やっと栄誉騎士の凱旋だね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980102
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3980102,
					"content": "#へへ、{NICKNAME}と一緒にトワリンとじゃれ合ってきたぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3980103,
					"content": "でも、昨日帰ってくるはずじゃなかったの？ジンさんが一足先に帰ってきて、あんたたちの活躍をみんなに話してくれたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980104
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3980104,
					"content": "あーあ…いつかわたしも、そんな大舞台に立てたらいいな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980105,
						3980108
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3980105,
					"content": "アンバーのおかげだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980106
					]
				},
				{
					"id": 3980106,
					"content": "ううん、今回の件が無事片付いたのは、あんたたちの頑張りがあったからだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980107
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3980107,
					"content": "最初にあんたたちをモンドに連れてきたのも、偵察騎士としての仕事を果たしただけだもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980111
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3980111,
					"content": "ふふん、礼なんていらないぞ——そういえば、アンバーはここでオイラたちを待ってくれてたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3980112,
					"content": "えっと、今回の任務は遠征とはまた違ってて、そう余裕はないんだ…ほら、今は後片付けをしているとこ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980113
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3980113,
					"content": "「後片付け」？モンドになにかあったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3980114,
					"content": "うん…ジンさんがいない間に、近くの魔物たちが「総攻撃」を仕掛けてきたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980115
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3980115,
					"content": "幸い前々からヒルチャールの動向は探ってたし、ヤツらの拠点がモンドに近づいてきていることには気付いてたから良かったけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980116
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3980116,
					"content": "あっ、覚えてるぞ。アンバーと初めて会った時もヒルチャールの巣を片付けてたよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3980117,
					"content": "そうそう、ああいった準備を怠ってたら、今頃モンドは危なかったかもね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980118,
						3980121
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3980118,
					"content": "退けることができてよかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980119
					]
				},
				{
					"id": 3980119,
					"content": "うん、でも何だかおかしいんだよね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980120
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3980120,
					"content": "ヒルチャールに総攻撃を仕掛けるような指揮能力はないはずなのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980123
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3980123,
					"content": "だから、今回の件はアビス教団が裏で糸を引いてると思うの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980124
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3980124,
					"content": "あいつらがヒルチャールを操ったってことか？じゃ、じゃあ…もしトワリンを助けてなかったら、そのヒルチャールみたいに操られて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3980125,
					"content": "もしかしたらね。偵察騎士として、今後はアビス教団の動向にも注意しなくちゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980126
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3980126,
					"content": "あ、ごめんね。せっかく帰って来たのに、またこんな話しちゃって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980127
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3980127,
					"content": "そうだ！「ニンジンとお肉のハニーソテー」をごちそうするって約束してたよね。今まで龍災のせいで行けなかったし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980128
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3980128,
					"content": "今回の勝利をお祝いして奢ってあげる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980129
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3980129,
					"content": "やったー！アンバーが忘れてても、オイラは忘れてなかったけどな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980130
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3980130,
					"content": "えへへ、わたしも「ニンジンとお肉のハニーソテー」を久しく食べられていないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980131
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3980131,
					"content": "<color=#00E1FFFF>「鹿狩り」</color>で待ってて。ここの片付けが終わったら、すぐ行くから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3980121,
					"content": "どうしてヒルチャールが…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980122
					]
				},
				{
					"id": 3980122,
					"content": "おかしいんだよね、ヒルチャールに総攻撃を仕掛けるような指揮能力はないはずなのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980123
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3980108,
					"content": "あんなのはもうごめんだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980109
					]
				},
				{
					"id": 3980109,
					"content": "うん…そうだね、せっかく手に入れた平和だもん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980110
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3980110,
					"content": "今回の件が無事片付いたのは、あんたたちの頑張りがあったからだよ。ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980111
					],
					"speakerTitle": "アンバー"
				}
			]
		},
		{
