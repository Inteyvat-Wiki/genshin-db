				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3980901,
					"content": "龍災も落ち着いたけど、あんたたちはこれからどうするの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980902
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3980902,
					"content": "#たぶんモンドを離れて、七国を旅しながら、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}の家族の手がかりを探すかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980903
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3980903,
					"content": "そっか…じゃあ、しばらく会えなくなるんだね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980904,
						3980905
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3980904,
					"content": "モンドを離れたくない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980906
					]
				},
				{
					"id": 3980906,
					"content": "大丈夫！どこだろうとも風が届く場所であれば、あんたは西風騎士団の戦友であり、栄誉騎士だから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980907,
						3980908
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3980907,
					"content": "風の導くままに！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980909
					]
				},
				{
					"id": 3980909,
					"content": "うん！モンドはいつでも歓迎するよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980910
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3980910,
					"content": "へへ、早く食べようか、じゃないとお肉が冷めちゃう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980911
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3980911,
					"content": "うーん——美味しい！さすがアンバーがおすすめするだけあって、期待通りだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980912
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3980912,
					"content": "当然だよ、料理の腕にはあまり自信ないけど、舌に自信はあるからね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980913
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3980913,
					"content": "あ、そうだ、伝え忘れるとこだった…",
