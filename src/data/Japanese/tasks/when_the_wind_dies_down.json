			"trigger": {
				"objectNames": [
					"サラ",
					"ガイア"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3980701,
					"content": "いらっしゃい、お客さん、ご注文は何にしますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980702
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 3980702,
					"content": "はぁ…つれないな、「親友」の俺を無視する気か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980703,
						3980705
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 3980703,
					"content": "気づかなかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980704
					]
				},
				{
					"id": 3980704,
					"content": "ははは…実力だけじゃなく、騎士としての美徳「ユーモア」も兼ね備えてるようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980707
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 3980707,
					"content": "モンドの新たな英雄が目の前にいると思うと、騎士として心が震え立つもんがあるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980708
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 3980708,
					"content": "ガイアがまた適当に褒めてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980709
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3980709,
					"content": "はは、俺が言ったことは本心だぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980710,
						3980714
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 3980710,
					"content": "ここで何してたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980711
					]
				},
				{
					"id": 3980711,
					"content": "頭ん中を整理したくてな、静かな場所を探してたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980712
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 3980712,
					"content": "他の騎士は後片付けしてるっていうのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980713
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3980713,
					"content": "考えるっていうのも大変な仕事だ、むしろ戦場の後片付けの方が楽だと思うぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980717
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 3980717,
					"content": "ふーん？その考えごとって？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980718
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3980718,
					"content": "アビス教団のことだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980719
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 3980719,
					"content": "龍災でジンがモンドにいなかった間、アビス教団にとっては絶好のチャンスだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980720
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 3980720,
					"content": "もしお前がアビス教団の者なら、こんな「絶好のチャンス」にヒルチャールだけを送り込むか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980721,
						3980722
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 3980721,
					"content": "ヒルチャールだけなのは、確かに怪しい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980723
					]
				},
				{
					"id": 3980723,
					"content": "真相を見極めるため、俺は待つことにしたんだ——ヤツらの次の行動をな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980724
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 3980724,
					"content": "それにお前たちが風龍廃墟で激しい戦いを繰り広げている間、モンドの城門でヒルチャールの叫び声を聞いてな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980725
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 3980725,
					"content": "城内に不審者がいたんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980726
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 3980726,
					"content": "モンドの城内にか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980727
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3980727,
					"content": "ああ、他の騎士が城の外で戦っていれば、城内の守りは必然的に手薄になるだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980728
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 3980728,
					"content": "だから、城に残っていた俺はアビス教団の侵入者と…ちょっとばかしやりあってな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980729
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 3980729,
					"content": "あの手この手で情報を聞かせてもらった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980730
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 3980730,
					"content": "その情報っていうのが、そいつらアビス教団を裏で統治する者のことだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980731
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 3980731,
					"content": "アビス教団を…統治？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980732
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3980732,
					"content": "トワリンをあんな風に戦いの道具とさせたのも、その統治者の仕業だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980733
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 3980733,
					"content": "「あの手この手」って、どんなことして情報を聞き出したんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980734
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3980734,
					"content": "あはは…そこは俺の天才的な「話術」によるものだと思っておいてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980735
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 3980735,
					"content": "#その統治者は、アビス教団の魔物に…「{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYD|INFO_FEMALE_PRONOUN_GIRLD]}様」と呼ばれている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980736
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 3980736,
					"content": "#「{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYD|INFO_FEMALE_PRONOUN_GIRLD]}」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980737
					]
				},
				{
					"id": 3980737,
					"content": "まあ、情報共有はここまでにしておこう。アンバーがこっちに向かって来てる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980738
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 3980738,
					"content": "一緒に戦わなかったことを怒ってるんだろうな…じゃ、お先に失礼するぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980739
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 3980739,
					"content": "ガイア先輩に逃げられた！やっぱ後ろめたいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980740,
						3980742
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3980740,
					"content": "実はこっそり頑張ってた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980741
					]
				},
				{
					"id": 3980741,
					"content": "そうなの？う～ん…あの話術に騙されたんじゃない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980744
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3980744,
					"content": "まあ、あの人のことは置いといて。もうくたくた、お腹もぺっこぺこだよ、先に注文させてもらうね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980745
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3980745,
					"content": "サラさん、「ニンジンとお肉のハニーソテー」ちょうだい——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3980742,
					"content": "そう！悪いやつだ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980743
					]
				},
				{
					"id": 3980743,
					"content": "そうそう、騎兵隊の隊長なのに率先して戦わないんだもん、はぁ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980744
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3980722,
					"content": "じゃあ、真相は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980723
					]
				},
				{
					"id": 3980714,
					"content": "また何か企んでるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980715
					]
				},
				{
					"id": 3980715,
					"content": "俺が？いやいや、逆だ。「他の者」が何を企んでいるのか考えようと思ってな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980716
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 3980716,
					"content": "で、頭ん中を整理したくて、静かな場所を探してたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980717
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 3980705,
					"content": "親友のガイアじゃないか。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980706
					]
				},
				{
					"id": 3980706,
					"content": "ほう、俺の熱い気持ちに応えてくれるとは。どうやら、俺の誠実さが伝わったようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980707
					],
					"speakerTitle": "ガイア"
				}
			]
		},
		{
			"id": 39809,
			"completionStepIds": [
				39809
			],
			"beginWay": "TALK_BEGIN_MANUAL",
