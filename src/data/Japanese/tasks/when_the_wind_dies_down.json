			"dialogs": [
				{
					"id": 3980401,
					"content": "ついに来た、盛り上がって来たぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980402
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 3980402,
					"content": "危機よ！災難よ！冒険よ！熱血よ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980403
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 3980403,
					"content": "冒険者協会はとうとう！猫や犬探しといった低俗な依頼とおさらばだ！新たな冒険時代がやってくる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980404
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 3980404,
					"content": "若者よ、さあ冒険者協会に入ろう！こんな時こそ龍災を鎮め、モンドを救うんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980405
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 3980405,
					"content": "えっと…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980406
					]
				},
				{
					"id": 3980406,
					"content": "…うん、なんだと！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980407
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 3980407,
					"content": "龍災が終結した？代理団長の演説を聞いていなかったのか…だと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980408
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 3980408,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980409
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 3980409,
					"content": "風魔龍よ！なぜもう少し耐えてくれなかった！我々の出番がまだだというのに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "サイリュス"
				}
			]
		},
		{
			"id": 39807,
			"completionStepIds": [
				39807
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
