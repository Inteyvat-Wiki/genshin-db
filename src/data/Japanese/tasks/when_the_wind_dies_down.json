			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ニムロド"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3980301,
					"content": "ありがとうな！やっと一件落着だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980302
					],
					"speakerTitle": "ニムロド"
				},
				{
					"id": 3980302,
					"content": "龍災の影響で、いくつかの輸送ルートが封鎖されてね。食料や果物ならまだしも…お酒まで品切れになったら、それこそおしまいだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980303
					],
					"speakerTitle": "ニムロド"
				},
				{
					"id": 3980303,
					"content": "お酒を飲めない日々なんて想像もできない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980304
					],
					"speakerTitle": "ニムロド"
				},
				{
					"id": 3980304,
					"content": "ああ、早く輸送ルートが復活してくれることを祈るよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
