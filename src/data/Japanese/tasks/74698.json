			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"バーベロス"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 746980101,
					"content": "うっ…あそこにいるのは神子か…なんだか面倒なことになりそうな気がするぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746980102,
					"content": "「三川花祭」の時だって、結果的には楽しかったけど、その過程がな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746980103,
					"content": "会うなり身売り契約させられたし…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746980104
					]
				},
				{
					"id": 746980104,
					"content": "でも今回は…へへっ、オイラたちが頑張るわけじゃないし、なにかされることは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746980105,
					"content": "しーっ、声が大きいよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746980106
					]
				},
				{
					"id": 746980106,
					"content": "おや…童にパイモン。せっかくフォンテーヌで出会えたというのに、童たちときたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980107
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 746980107,
					"content": "うわっ！み、み、み、神子！全部聞いてたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746980108,
					"content": "いいや。何も聞いておらぬぞ。じゃが、その様子を見るに…ろくな話ではなさそうじゃな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980109
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 746980109,
					"content": "そ、そんなことないぞ！オイラたちも神子に会えて嬉しいな、へへへ…こ、ここにはなにをしに来たんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980110,
						746980111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746980110,
					"content": "（話題の変え方が強引すぎる…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746980112
					]
				},
				{
					"id": 746980112,
					"content": "当然、八重堂のために奔走しておるのじゃよ。妾のような苦労の絶えぬ編集長に、他に何の用があるというのじゃ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980113
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 746980113,
					"content": "新刊を箱いっぱいに買い込んだばかりでな。これを持ち帰って、八重堂の編集者たちにじっくり読ませようと思っていたのじゃが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980114
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 746980114,
					"content": "思いがけず、「古い友人」がこの占い屋の前に立ち止まっておるのを見かけてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980115
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 746980115,
					"content": "普段、神社に「おみくじ」を引きに来ることなど滅多にないというのに、今になって占いに興味を持つとはのう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980116
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 746980116,
					"content": "じゃが、廷内を散策しておった時、外れによく当たる占いの屋台があると聞いてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980117
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 746980117,
					"content": "それで、妾も一度見てもらったのじゃ。まあ…好奇心を満たすため、といったところじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980118
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 746980118,
					"content": "えっ？もうカードを引いたのか？オイラ、どうやっておまえに引かせればいいか、ずっと悩んでたんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746980119,
					"content": "何のカードを引いたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746980120
					]
				},
				{
					"id": 746980120,
					"content": "ふむ、妾の未来にそんなに興味があるのか？ふふっ、知りたいと言うのなら、見せてやらんこともない。じゃが、少々の代償を払ってもらわねばな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980121
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 746980121,
					"content": "そうじゃな…いっそのこと八重堂の一員となって、冒険譚を本にまとめるというのはどうじゃ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980122
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 746980122,
					"content": "本の名は最近流行りの名付け方にならって、『非常食を拾ったら、天下無敵になった』とするのがよいな。きっと、飛ぶように売れるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980123
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 746980123,
					"content": "かなり分厚い本になりそう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746980124
					]
				},
				{
					"id": 746980124,
					"content": "構わぬ。面白ければ、どれほど分厚くてもよい。以前、『パラドックス後のホライゾン』という娯楽小説を出版したことがある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980125
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 746980125,
					"content": "あれは辞書のように分厚くてのう。しかも、なんと全八部作なんじゃ。三冊の設定資料集と六冊の外伝を合わせれば、積み重ねただけで天井に届くほどじゃぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980126
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 746980126,
					"content": "もし童がそれほどの物語を書けるというのなら、編集長である妾が責任編集者になってやってもよいぞ。どうじゃ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980127,
						746980128
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 746980127,
					"content": "原稿を催促したいだけでしょ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746980129
					]
				},
				{
					"id": 746980129,
					"content": "ほう？であれば、カードは見せずともよいのじゃな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980130
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 746980130,
					"content": "急に見たくなくなってきた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746980131
					]
				},
				{
					"id": 746980131,
					"content": "だな！実はオイラたちもそこまで——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980132
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746980132,
					"content": "ほれ、これが妾の引いたカードじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980133
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 746980133,
					"content": "説明によると…逆位置の「正義」だったかのう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980134,
						746980135
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 746980134,
					"content": "目を隠したよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746980136
					]
				},
				{
					"id": 746980136,
					"content": "見たくないのか？まあよい。はぁ…占いが嫌いなんじゃな。次に童たちが「おみくじ」を引きに来ても、この嫌われ者の宮司はもう引いてやらぬ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980137
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 746980137,
					"content": "そういえば、最近よく神社へ絵馬を掛けに来ておったじゃろう？いっそ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980138,
						746980139
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 746980138,
					"content": "すごくいいカードを引いたね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746980140
					]
				},
				{
					"id": 746980140,
					"content": "おまえなぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980141
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746980141,
					"content": "良いには良いが、残念ながら逆位置の「正義」じゃからな…妾が悪人だとでも言いたいのじゃろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980142
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 746980142,
					"content": "「正義」のカードと言っても、一般的な意味での「善人」や「悪人」を指すわけではないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980160
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746980160,
					"content": "むしろ…今、逆位置にあるそれが指し示すのは、「不誠実な人」だね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980143
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746980143,
					"content": "不誠実？まさか。妾がこやつらにおみくじを読み解いてやるときは、この上なく誠実にしておるというのに…そうじゃろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980144
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 746980144,
					"content": "オイラの記憶だと、旅人が神子のおみくじを引く時は毎回大吉だったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980145
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746980145,
					"content": "それは童の運がいいのじゃ。あるいは、宮司である妾の傍におる時は、運気が上がっておるのじゃな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980146
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 746980146,
					"content": "運…それは奇遇だね。確かに逆位置の「正義」は、歪んだ因果、不均衡、不誠実…そして不満足を象徴しておる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980147
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746980147,
					"content": "妖怪であるおまえさんなら、理解できるだろう。なにしろ「妖怪」の誕生は、もとより「欲望」と密接に関わっておるからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980148
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746980148,
					"content": "物事へ対する渇望、叶わなかった夢、未完の大志、何らかの感情に惹かれること…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980149
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746980149,
					"content": "これらの満たされなかった「欲望」は些細なきっかけで成長し、予想外の根や芽をはびこらせる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980150
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746980150,
					"content": "そして、稲妻の「大妖怪」であるおまえさんの心にも、さらに巨大な「欲望」が埋まっておるのだろうね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980151
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746980151,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980152
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 746980152,
					"content": "だが、これ以上はわしにも見えないよ。何せカードを一枚引いただけだからね。それに、逆位置の「正義」は隠し事や嘘にも長けておる。他人に対しても、自分自身に対してもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980153
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746980153,
					"content": "なんとも要領を得ぬ話じゃのう。巫女たちがおみくじを読み解く時の言い回しにそっくりじゃ。ここで、このような斬新な占いの話術が聞けるとは思わなんだぞ。なかなか面白いではないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980154
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 746980154,
					"content": "とはいえ、それは神社の経営理念にそぐわぬ。巫女たちには教えられんのう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980155
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 746980155,
					"content": "何はともあれ、汝の占いには感謝しておる。機会があれば、鳴神大社へ遊びに来て、汝も占われてみぬか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980156
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 746980156,
