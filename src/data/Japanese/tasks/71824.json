			"trigger": {
				"objectNames": [
					"ヴェル·ゴレット"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718240201,
					"content": "旅人、どうかしたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240202
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 718240202,
					"content": "冥ちゃんについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240203
					]
				},
				{
					"id": 718240203,
					"content": "あの子のことね。あの事以来、大分落ち着いたわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240204
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 718240204,
					"content": "でも、あの子も不憫よね。以前の祭りの時、お客さんも多かったから、彼女も寂しかったはず…だからお客さんにいたずらをして驚かしてたのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240205
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 718240205,
					"content": "でもそれって、ただ誰かと遊びたかっただけなのよね…もとは子供なんだから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240206,
						718240207
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 718240206,
					"content": "霄灯を送ってあげられる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240208
					]
				},
				{
					"id": 718240208,
					"content": "彼女に霄灯を？…悪くないわね。でもあの子はなかなか見つけづらいわよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240209
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 718240209,
					"content": "もし探したいなら、夜にあそこの林で、霄灯を木にかけるといいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240210
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 718240210,
					"content": "そうすれば、あの子もそれに気づくはずだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 718240207,
					"content": "霄灯は好きかな…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240208
					]
				}
			]
		},
