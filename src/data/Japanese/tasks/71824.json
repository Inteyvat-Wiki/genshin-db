			"dialogs": [
				{
					"id": 718240301,
					"content": "どう？霄灯は届けられた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240302
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 718240302,
					"content": "まあ…届いてると思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240303
					]
				},
				{
					"id": 718240303,
					"content": "そう、それはよかった。これであの子も少しは楽しんでくれるかしら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240304
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 718240304,
					"content": "あの子が…どんな願いをするのかは分からないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴェル·ゴレット"
				}
			]
		},
