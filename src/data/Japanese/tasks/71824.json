			"trigger": {
				"objectNames": [
					"言笑"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718240101,
					"content": "もっと早くしないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240102
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718240102,
					"content": "忙しいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240103
					]
				},
				{
					"id": 718240103,
					"content": "いや、そうでもない。ただ、今は祭りの時期だから、旅館の人もほとんど実家に帰っててな。人手が足りないから、全部俺一人でやってるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240104
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718240104,
					"content": "幸い、お客さんは別に多くないから、俺一人でも問題ない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240105
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718240105,
					"content": "ゴホンッ…この前は手伝ってくれてありがとう。お前がいなかったらどうなってたことやら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240106,
						718240107
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718240106,
					"content": "最近また…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240108
					]
				},
				{
					"id": 718240108,
					"content": "それはない！もう絶対にないんだ！もしまた出たら、今度こそ俺は耐えられないかもしれない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240109
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718240109,
					"content": "本当にあの事…あの子のことが聞きたいなら…オーナーに聞いてくれ。俺は…本当に何も知らない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "言笑"
				},
				{
					"id": 718240107,
					"content": "最近あの子は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240108
					]
				}
			]
		},
		{
			"id": 7182402,
			"completionStepIds": [
				7182402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
