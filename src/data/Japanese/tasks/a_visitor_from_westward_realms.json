	"talks": [
		{
			"id": 7166301,
			"completionStepIds": [
				7166302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7166302",
							"2"
						],
						"stepId": 7166302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ナザファリン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716630101,
					"content": "こんにちは。どうしたんだ、困ってそうだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716630102,
					"content": "ああ、クラクサナリデビ様よ。確かに、私は厄介な問題を抱いております。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630103
					],
					"speakerTitle": "ナザファリン"
				},
				{
					"id": 716630103,
					"content": "クラクサナリデビ様よ、お二人はきっと、ナザファリンを救いに来てくださった大英雄たちなのでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630104
					],
					"speakerTitle": "ナザファリン"
				},
				{
					"id": 716630104,
					"content": "これはいわゆる…えっと、何と言うのでしたっけ…寒いので、誰かが布団をくれた？ん？それとも、雨…雨中送炭ですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630105
					],
					"speakerTitle": "ナザファリン"
				},
				{
					"id": 716630105,
					"content": "うっ…これってスメール人特有の話し方なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630106,
						716630107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716630106,
					"content": "多分、彼女だけだと思う…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716630108
					]
				},
				{
					"id": 716630108,
					"content": "そうだよな。それに、それを言うなら雪中送炭だろう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716630109,
					"content": "あっ、そうそうそう、雪中送炭。本当に雪中送炭でしたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630110
					],
					"speakerTitle": "ナザファリン"
				},
				{
					"id": 716630110,
					"content": "…えっと、とにかく、おまえはナザファリンって言うんだな？それで、オイラたちに助けてほしいことって？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716630111,
					"content": "そんなに要点を抑えて話すことができるなんて…あなたは賢いんですね！実は、私ナザファリンは今、人生最大の難局を迎えておりまして！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630112
					],
					"speakerTitle": "ナザファリン"
				},
				{
					"id": 716630112,
					"content": "#オイラはパイモンだ。こいつは{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716630113,
					"content": "#こんにちは、{NICKNAME}だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716630114
					]
				},
				{
					"id": 716630114,
					"content": "お二人に出会うことができて本当に嬉しいです！私はナザファリンと申します！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630115
					],
					"speakerTitle": "ナザファリン"
				},
				{
					"id": 716630115,
					"content": "名前ならさっきもう言ってたけどな…で、おまえはどんな難局に直面してるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716630116,
					"content": "はい、実は、私にはパルヴァネという高い志を持つ友達がいまして。彼女は以前私に、皆を幸せにする調味料を作りたいと言いました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630117
					],
					"speakerTitle": "ナザファリン"
				},
				{
					"id": 716630117,
					"content": "えっ、みんなを幸せにする調味料？調味料が…どうやって人を幸せにするっていうんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716630118,
					"content": "うーん…それはナザファリンも存じ上げません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630119
					],
					"speakerTitle": "ナザファリン"
				},
				{
					"id": 716630119,
					"content": "でもパルヴァネは、その調味料を加えれば、どんな料理でもひときわ美味しくなると申しておりました！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630155
					],
					"speakerTitle": "ナザファリン"
				},
				{
					"id": 716630155,
					"content": "特別に美味しい料理を食べれば、人々はきっと幸せな気持ちになれます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630120
					],
					"speakerTitle": "ナザファリン"
				},
				{
					"id": 716630120,
					"content": "ああ！なるほどな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716630121,
					"content": "あっさり納得しちゃった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716630122
					]
				},
				{
					"id": 716630122,
					"content": "彼女が旅に出たのも、その調味料の作り方を探しに行くためなのです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630123
					],
					"speakerTitle": "ナザファリン"
				},
				{
					"id": 716630123,
					"content": "でも、彼女は旅をしながら研究をして、まるで忙しく飛び回る働きバチのようです。彼女の大親友として、ただスメールにいるだけで何も手伝ってあげられないなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630124
					],
					"speakerTitle": "ナザファリン"
				},
				{
					"id": 716630124,
					"content": "だからどうしても、彼女のために何かしてあげたくて。それで以前、彼女が私に話したことをもとに、考えを整理してみました。私は彼女が可哀想で、寝食も忘れてしまって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630156
					],
					"speakerTitle": "ナザファリン"
				},
				{
					"id": 716630156,
					"content": "寝食も忘れて何日か思い巡らしたおかげで、ようやく私のできることを思いつきました！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630125
					],
					"speakerTitle": "ナザファリン"
				},
				{
					"id": 716630125,
					"content": "うん？寝食も忘れるって、ちょっと使い方が違うんじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716630126,
					"content": "ああ、教えてくださりありがとうございます。璃月のことわざは、やはり難しいですね。もっと勉強しなければ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630127
					],
					"speakerTitle": "ナザファリン"
				},
				{
					"id": 716630127,
					"content": "本題に戻ろうぜ。それで、なにを思いついたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716630128,
					"content": "あっ、そうでした！一つ方法を考えついたんです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630157
					],
					"speakerTitle": "ナザファリン"
				},
				{
					"id": 716630157,
					"content": "それは…パルヴァネの考えをもとにいくつかの調味料のレシピを作ることです。そして、それらの調味料を料理に加え、皆から感想を集めるのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630129
					],
					"speakerTitle": "ナザファリン"
				},
				{
					"id": 716630129,
					"content": "市場調査をし、集めた情報を整理してパルヴァネに渡そうと思いまして。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630130
					],
					"speakerTitle": "ナザファリン"
				},
				{
					"id": 716630130,
					"content": "ご存知の通り、研究においては実際の調査も非常に重要です。これは、私があの忙しい親友のためにできる唯一のことでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630131
					],
					"speakerTitle": "ナザファリン"
				},
				{
					"id": 716630131,
					"content": "ただ、私の考えたこの調味料のレシピは、きっと彼女が望んでいるものではないと思います…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630132
					],
					"speakerTitle": "ナザファリン"
				},
				{
					"id": 716630132,
					"content": "けれど、皆さんから集めたこの調味料のフィードバックを、きっと賢いパルヴァネなら役に立ててくれると思います。これを使えば、彼女もすごい調味料をあっという間に調合できるでしょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630133
					],
					"speakerTitle": "ナザファリン"
				},
				{
					"id": 716630133,
					"content": "ですので、私は七国のうち、食文化でその名が知れ渡る璃月へやってきました！璃月では、「民は食を以て天となす」という言葉があると聞いています。きっとたくさんのインスピレーションを得られるのではないかと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630134
					],
					"speakerTitle": "ナザファリン"
				},
				{
					"id": 716630134,
					"content": "要するに、レシピはまだ考えていなくて、オイラたちにそれを手伝ってほしいってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630135
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716630135,
					"content": "いえ、違います。ああ、クラクサナリデビ様よ。レシピを考えることについては、やはりスメール人の私にやらせてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630136
					],
					"speakerTitle": "ナザファリン"
				},
				{
					"id": 716630136,
					"content": "スメール人は料理に調味料を使うのが得意です。ほら、お二人とお話ししているうちに、早速レシピを一つ思いつきましたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630137
					],
					"speakerTitle": "ナザファリン"
				},
				{
					"id": 716630137,
					"content": "ああ、それで言えば、またまた感謝しなければ！お二人は本当に、この憐れなナザファリンを救いに来た大英雄です！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630138
					],
					"speakerTitle": "ナザファリン"
				},
				{
					"id": 716630138,
					"content": "んん？ど、どういたしまして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630139
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716630139,
					"content": "#で、{M#俺}{F#私}たちは何をすれば…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716630140
					]
				},
				{
					"id": 716630140,
					"content": "実は、うーん…調味料のレシピは思いついたのですが、憐れなナザファリンは璃月に知り合いが一人もいないのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630141
					],
					"speakerTitle": "ナザファリン"
				},
				{
					"id": 716630141,
					"content": "それに、私はプロの冒険者ではありません。これほどの原料を集めるとなれば、か弱き素人が一人でエルマイト旅団の拠点に侵入するのと同じようなものです。ちょっと敷居が高すぎますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630142
					],
					"speakerTitle": "ナザファリン"
				},
				{
					"id": 716630142,
					"content": "エルマイト旅団？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716630143
					]
				},
				{
					"id": 716630143,
					"content": "ああ、それはスメールの傭兵組織です。モラさえ払えばなんでもやってくれます。中には、禍々しい力を操れるメンバーもいて、かなり手ごわいのですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630144
					],
					"speakerTitle": "ナザファリン"
				},
				{
					"id": 716630144,
					"content": "考えただけで怖くなってきました。さあ、先程の話題に戻りましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630145
					],
					"speakerTitle": "ナザファリン"
				},
				{
					"id": 716630145,
					"content": "#そうですね…ナザファリンは今、パイモン様と{NICKNAME}様に、レシピにある原料を集め、その調味料を作ってもらいたいです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630146
					],
					"speakerTitle": "ナザファリン"
				},
				{
					"id": 716630146,
					"content": "そして、出来上がった調味料を料理に加え、お二人のお知り合いに試食して頂きたいのです。最後に、その感想を記録して、ナザファリンまで渡してください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630147,
						716630148
					],
					"speakerTitle": "ナザファリン"
				},
				{
					"id": 716630147,
					"content": "なるほど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716630149
					]
				},
				{
					"id": 716630149,
					"content": "なるほど！それならそうと言ってくれれば良かったのに。オイラたちは、知り合いが多いからな、任せとけ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630150
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716630150,
					"content": "クラクサナリデビ様よ、親切なお二人に感謝いたします！私もこの間を利用してレシピを考えようと思います。新たなレシピを思いついたら、またお二人にお伝えいたしますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630151
					],
					"speakerTitle": "ナザファリン"
				},
				{
					"id": 716630151,
					"content": "この鍋を受け取っていただけますか。これはスメールの職人に頼んで作ってもらったんです。この鍋でなら、きっと皆を幸せにする調味料を作り上げられますよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630152
					],
					"speakerTitle": "ナザファリン"
				},
				{
					"id": 716630152,
					"content": "#やったぜ！{NICKNAME}、さっそく調味料を作ろうぜ！オイラが最初に試食してやるよ、へへっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630153
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716630153,
					"content": "道理で協力的なわけだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716630154
					]
				},
				{
					"id": 716630154,
					"content": "へへっ、早く、早く！行こうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716630148,
					"content": "誰かに試食してほしいってことね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716630149
					]
				},
				{
					"id": 716630107,
					"content": "今まで会ったスメール人にこんな人いない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716630108
					]
				}
			]
		}
	]
}