			},
			"dialogs": [
				{
					"id": 80070101,
					"content": "一瞬で消えてしまうものかと思ったが…ハールヴダンの魂が、これほどまでに強靭だったとはな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070102
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80070102,
					"content": "邪魔者め！去れ…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070103
					],
					"speakerTitle": "アビスの司祭"
				},
				{
					"id": 80070103,
					"content": "ふん、どこを見ている？俺を仕留める絶好の機会だ、そうだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070104
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80070104,
					"content": "…ダインスレイヴ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070105
					],
					"speakerTitle": "アビスの司祭"
				},
				{
					"id": 80070105,
					"content": "やつを倒して装置を止めるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ダインスレイヴ"
				}
			]
		},
		{
			"id": 800703,
			"completionStepIds": [
