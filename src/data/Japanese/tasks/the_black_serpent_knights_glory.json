			},
			"dialogs": [
				{
					"id": 80071001,
					"content": "さっきのって…ハールヴダンの魂か…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071002
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80071002,
					"content": "ここには奇妙な力がいくつも集まっている。魂を目にしてもおかしくはないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071003
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80071003,
					"content": "だが、これ以上深いところを探索するつもりなら、注意する必要がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071004
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80071004,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071005
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80071005,
					"content": "ああ、気をつけるよ。ところで、ダインは一緒に来ないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071006
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80071006,
					"content": "さっきの装置で少なからずダメージを受けた。身体が癒えるまでしばらく時間がかかる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071007
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80071007,
					"content": "そうだったのか…って、そんなのとっくに気付いてたぞ。ずっとやせ我慢してたんだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071008
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80071008,
					"content": "ダインにも休みが必要だと思うぞ。たとえば…休暇を取るとか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071009
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80071009,
					"content": "休暇？ふっ、俺に似つかわしくない言葉だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071010
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80071010,
					"content": "俺には、まだ成さなければならないことがある。今この時も、「運命の織機」の計画は進んでいるのだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071011
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80071011,
					"content": "ここの増幅装置も、あの計画と何か関係があると疑ったほうがいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071012,
						80071013
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80071012,
					"content": "#{M#俺}{F#私}も気に掛けておく。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80071014
					]
				},
				{
					"id": 80071014,
					"content": "気遣い感謝する、「雇用主」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071015
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80071015,
					"content": "次に会う時、貴様が「向こう側」になっていないことを祈ろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071016
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80071016,
					"content": "まったく、最後にあんなこと言うなんて、根に持つにもほどがあるぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071017
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80071017,
					"content": "#おまえの{M#妹}{F#お兄}さんには会えなかったけど、手がかりはいっぱい手に入ったな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071018
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80071018,
					"content": "旅を続けてれば、いつか会える日が来るさ！そしたら、ちゃんと仲直りするんだぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071019
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80071019,
					"content": "あっ、忘れるところだった。オイラたち、ヒルチャールの変わった行動を調べにここへ来たんだったよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071020
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80071020,
					"content": "ひとまず鉱夫さんに報告はできるけど…どこから話せばいいんだ？ここの出来事って、事情を知らない人からすると複雑すぎるし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071021
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80071021,
					"content": "とりあえず、依頼のことは忘れないようにしとこう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80071013,
					"content": "ダインが回復したら、またゆっくり話そう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80071014
					]
				}
			]
		},
		{
