					"ダインスレイヴ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80070301,
					"content": "ど、ど、どうしよう…あのアビスの司祭を倒しても、装置が止まらないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80070302,
					"content": "ハールヴダン…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070303,
						80070304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80070303,
					"content": "#{M#俺}{F#私}が代わりにやる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80070305
					]
				},
				{
					"id": 80070305,
					"content": "ちっ！装置が動作している限り、呪われた俺たちは本来の力を発揮できない。今この場で、アビスに対抗できるのは貴様だけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070306
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80070306,
					"content": "あいつの献身を無駄にしないためにも、ここで時間を使うのは得策じゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070307
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80070307,
					"content": "転移の扉と周りの光は見たか？やつらはおそらく、エネルギー装置を他のところに分散して置いている。そこへ行き、装置を確認するんだ、急ぐぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070308
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80070308,
					"content": "あのアビスが設置した転移の扉を通るのか？…おい、待てって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80070304,
					"content": "#{M#俺}{F#私}なら、呪いの浄化作用を受けない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80070305
					]
				}
			]
		},
		{
