			"dialogs": [
				{
					"id": 80070901,
					"content": "これで、装置は完全に止まったよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070902
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80070902,
					"content": "ああ、焼け付くような痛みもなくなった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070903
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80070903,
					"content": "オイラたち、アビスの計画を阻止できたってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070904,
						80070905
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80070904,
					"content": "けど、ハールヴダンは…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80070906
					]
				},
				{
					"id": 80070906,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070907
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80070907,
					"content": "確認させてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070908
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80070908,
					"content": "ダインのやつ…かなり落ち込んでるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070909
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80070909,
					"content": "昔の戦友と、こんな形で再会するなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070910
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80070910,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070911
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80070911,
					"content": "…行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80070905,
					"content": "もう彼の存在を感じられない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80070906
					]
				}
			]
		},
		{
