			},
			"dialogs": [
				{
					"id": 752190101,
					"content": "#あの…{NICKNAME}さんですよね？ちょっとお待ちを！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190102
					],
					"speakerTitle": "フチル"
				},
				{
					"id": 752190102,
					"content": "これを…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190103
					],
					"speakerTitle": "フチル"
				},
				{
					"id": 752190103,
					"content": "ん？オイラたちに頼みたいことでもあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752190104,
					"content": "ははっ、いえ。あなたたち宛てのお荷物を預かってるんです。どこに行けばお会いできるか、考えていたところで——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190105
					],
					"speakerTitle": "フチル"
				},
				{
					"id": 752190105,
					"content": "まさかバッタリ出会えるなんてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190106
					],
					"speakerTitle": "フチル"
				},
				{
					"id": 752190106,
					"content": "荷物？誰からだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752190107,
					"content": "この荷物は、長い長い旅を経て届いたんですよ。色んな人たちの手を経て、つい先日、冒険者協会から懸木の民の伝達使に渡されたんです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190108
					],
					"speakerTitle": "フチル"
				},
				{
					"id": 752190108,
					"content": "このところ、ナタも落ち着かなくて、キャラバンの往来もしばらく途絶えてたので…差出人は書かれてませんが、消印を見るに、フォンテーヌからみたいですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190109
					],
					"speakerTitle": "フチル"
				},
				{
					"id": 752190109,
					"content": "フォンテーヌにもお友達がたくさんいらっしゃるんですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190110,
						752190111
					],
					"speakerTitle": "フチル"
				},
				{
					"id": 752190110,
					"content": "届けてくれてありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752190112
					]
				},
				{
					"id": 752190112,
					"content": "はい、こんなに早く配達できるなんて、今日はいい一日になりそうです！炎神さまのご加護のおかげですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190113
					],
					"speakerTitle": "フチル"
				},
				{
					"id": 752190113,
					"content": "じゃあ、私は次の配達があるので。あなたがたもいい一日になりますように！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190114
					],
					"speakerTitle": "フチル"
				},
				{
					"id": 752190114,
					"content": "おう、仕事頑張れよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752190115,
					"content": "う～ん、フォンテーヌからか。軽そうだし、荷物っていうより、手紙か…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752190116,
					"content": "開けてみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752190117,
					"content": "わぁ、シャルロットからだ！これは…フォンテーヌを離れる時に撮ってくれた写真だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752190118,
					"content": "ついこの間なのに、なんか、すごく昔のことみたいに感じるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752190119,
					"content": "へへっ、大事にしまっとこうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752190111,
					"content": "無事、配達完了だね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752190112
					]
				}
			]
		}
	]
}