			"dialogs": [
				{
					"id": 711050101,
					"content": "おじいちゃん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050102
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 711050102,
					"content": "あれ？こんな夜遅くに、なんで子どもが一人でいるんだ？おまえ、名前は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711050103,
					"content": "あたしはシャンジュン…おじいちゃんを探しに来たの…おじいちゃんが妖怪に捕まっちゃって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050104
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 711050104,
					"content": "よ…妖怪？ここって妖怪がいるのか？どんな妖怪だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711050105,
					"content": "あ…あたしも知らない…おじいちゃんが言ってたの。山には妖怪がいるからうろうろするなって…でもおじいちゃん、山に入ってから、もう三日も帰って来なくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050106
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 711050106,
					"content": "#それは{M#君}{F#あなた}を脅しただけなんじゃない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050107
					]
				},
				{
					"id": 711050107,
					"content": "オイラもそう思うぞ…じいちゃんは山になにしに行ったんだ？なにか言ってなかったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711050108,
					"content": "おじいちゃんは村の薬草採りなの。それで最近、仙草を採ってきたんだけど、懸練山の近くの仙水をやらないと育たないんだって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050109
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 711050109,
					"content": "だから…仙水を守っている妖怪に出くわしちゃったんじゃないかなあ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050110
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 711050110,
					"content": "シャンジュン、心配するな。じいちゃんは何か困ったことがあっただけかもしれないぞ。もう遅いし、とりあえず家まで送ってやるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711050111,
					"content": "でも、おじいちゃんを助けに行かなきゃ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050112
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 711050112,
					"content": "#{M#俺}{F#私}たちが手伝ってあげるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050113
					]
				},
				{
					"id": 711050113,
					"content": "ほんとう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050114
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 711050114,
					"content": "おう！おまえが家に帰らないと、じいちゃんはもっと困るかもしれないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711050115,
					"content": "あ、そっか…おじいちゃんを困らせちゃだめだよね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050116
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 711050116,
					"content": "だからオイラたちが探しに行ってやるよ。家はどこだ？先に送ってってやるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711050117,
					"content": "いいよいいよ。あたしの家は翹英荘にあるけど、一人で帰れるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050118
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 711050118,
					"content": "今すぐおじいちゃんを探しに行ってもらっていい？危ない目に遭ってないか心配なの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050119
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 711050119,
					"content": "それでもオイラたちは構わないぞ。じゃあ…じいちゃんが具体的にどこに行ったかわかるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711050120,
					"content": "あっちに向かって歩いて行ったのしかわからない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050121
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 711050121,
					"content": "じゃあ、まずそっちのほうを探してみるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050122
					]
				},
				{
					"id": 711050122,
					"content": "ありがとう、二人とも！じゃあ、あたしはすぐ帰るね。みんなを困らせちゃいけないから…村でおとなしく、いい知らせを待ってる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "？？？"
				}
			]
		},
		{
			"id": 7110502,
			"completionStepIds": [
				7110502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
