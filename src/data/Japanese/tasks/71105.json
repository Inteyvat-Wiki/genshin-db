			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 711050201,
					"content": "「寝過ごした！明日までに急いで帰らなければ、シャンジュンの世話をしてやれる者がいない…わしはなんというバカなことを…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050202
					],
					"speakerTitle": "誰かの手帳"
				},
				{
					"id": 711050202,
					"content": "「たしか薬蝶の谷から懸練山に行く途中に小道があったはずだ…小道を進んで山洞を抜ければすぐに着くはず…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050203
					],
					"speakerTitle": "誰かの手帳"
				},
				{
					"id": 711050203,
					"content": "「あの付近には魔物がいるそうだが、こうなったら近道するしかない…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050204
					],
					"speakerTitle": "誰かの手帳"
				},
				{
					"id": 711050204,
					"content": "これ、そのじいちゃんが残したものみたいだぞ。小道を進んだんだ——オイラたちも探しに行こう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7110505,
			"completionStepIds": [
				7110505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7110505",
