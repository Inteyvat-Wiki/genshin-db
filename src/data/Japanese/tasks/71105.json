			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 711050501,
					"content": "「…魔物が出るのではないかとは思っていたが…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050502
					],
					"speakerTitle": "誰かの手帳"
				},
				{
					"id": 711050502,
					"content": "「…ずいぶん流れた…太ももが…止まらない…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050503
					],
					"speakerTitle": "誰かの手帳"
				},
				{
					"id": 711050503,
					"content": "「…眠い…だが懸練山はもう目の前だ…シャンジュン…きっと仙水を取って帰ってやるからな…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050504
					],
					"speakerTitle": "誰かの手帳"
				},
				{
					"id": 711050504,
					"content": "「…シャンジュン…きっと仙水を取って帰ってやるからな…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050505
					],
					"speakerTitle": "誰かの手帳"
				},
				{
					"id": 711050505,
					"content": "まずいぞ…魔物に襲われて、ひどい怪我をしたみたいだ…そんな状態で懸練山に水を取りに行ったのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050506
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711050506,
					"content": "急いで行ってみようぜ。助けられるといいんだけどな…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
