			"dialogs": [
				{
					"id": 711051101,
					"content": "他に用がないなら、私は先に失礼するよ。好きに見て回ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711051102
					],
					"speakerTitle": "羅おじ"
				},
				{
					"id": 711051102,
					"content": "つまり本当にシャンジュンって子はいないんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711051103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711051103,
					"content": "周りの人にも聞いておこう。もしかしたら、家の場所を間違えただけのよそ者だったってこともあるかもしれないしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711051104
					],
					"speakerTitle": "羅おじ"
				},
				{
					"id": 711051104,
					"content": "ここまで足を運んでくれて、しかも「仙人」の薬草に水までやってくれて、ありがとうな。彼が知ったらきっと感謝して、君たちの厄を払ってくれるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "羅おじ"
				}
			]
		}
	]
