				]
			},
			"dialogs": [
				{
					"id": 711050601,
					"content": "あれ？ここのはずだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050602
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711050602,
					"content": "なんで誰もいないんだ？なんの痕跡も見当たらないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050603
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711050603,
					"content": "もう帰っちゃったのかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050604
					]
				},
				{
					"id": 711050604,
					"content": "それはないと思うけどな。シャンジュンのおじいさんは怪我をしてるんだぞ。そんなに遠くまで行けるはずあるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050605
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711050605,
					"content": "でも近くにはいない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050606
					]
				},
				{
					"id": 711050606,
					"content": "誰かが道の途中でおじいさんに出会って、連れ帰ってくれたのか…？それならあり得そうだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050607
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711050607,
					"content": "なんなら翹英荘に戻って聞いてみるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050608
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711050608,
					"content": "その前に少し「仙水」を汲んでおこう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050609
					]
				},
				{
					"id": 711050609,
					"content": "仙水？うん…たしかに、もしじいちゃんが本当に助けてもらってるなら、きっと欲しがってるだろうしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050610
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711050610,
					"content": "#ついでに人助けができるぞ。へへっ、やっぱり{NICKNAME}は細かいところまでよく気がつくぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7110508,
			"completionStepIds": [
				7110508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7110508",
							"2"
						],
						"stepId": 7110508,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"羅おじ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711050801,
					"content": "おや…旅人じゃないか。そんなにあたふたして、何か困ったことでもあったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050802
					],
					"speakerTitle": "羅おじ"
				},
				{
					"id": 711050802,
					"content": "羅おじ…シャンジュンとそいつのじいちゃんの家がどこにあるか知ってるか？二人を訪ねて来たんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050803
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711050803,
					"content": "シャンジュン？そんな名は聞いたことがないな。ここの人か？村の者なら、全員知っているはずだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050804
					],
					"speakerTitle": "羅おじ"
				},
				{
					"id": 711050804,
					"content": "聞いたことがない？まさか…オイラたち、外で女の子に会ったんだ。名前はシャンジュンで、家は翹英荘だって言ってたぞ。じいちゃんを探してほしいって頼まれて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050805
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711050805,
					"content": "それに大きな竹のいかだも持ってた！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050806
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711050806,
					"content": "ふむ…竹のいかだならよく見かけるが、シャンジュンという名前は…村にそんな名前の者がいないのは確かだ。おじいさんの名前は分かるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050807
					],
					"speakerTitle": "羅おじ"
				},
				{
					"id": 711050807,
					"content": "おじいさんは薬草採りだって言ってた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050808
					]
				},
				{
					"id": 711050808,
					"content": "薬草採り？ふーむ、確かに前は、薬草採りの人がいたが…でも、亡くなってもう三年になる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050809
					],
					"speakerTitle": "羅おじ"
				},
				{
					"id": 711050809,
					"content": "亡くなった！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050810
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711050810,
					"content": "外で魔物に出くわしてしまってな…はぁ…だが、その人は君たちが探している人ではないはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050811
					],
					"speakerTitle": "羅おじ"
				},
				{
					"id": 711050811,
					"content": "彼は少々変わり者でな。所帯を持っていなかったから、子や孫なんかがいるはずない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050812
					],
					"speakerTitle": "羅おじ"
				},
				{
					"id": 711050812,
					"content": "ええ…いったいどういうことだ？じゃあ、オイラたちが会ったシャンジュンは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050813
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711050813,
					"content": "まさか、あいつ自身が妖怪だったのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050814
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711050814,
					"content": "村の薬草採りはどんな薬草を採ってたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050815
					]
				},
				{
					"id": 711050815,
					"content": "見たことのない草花ばかりだよ。私は茶のことしか知らないから、さっぱり分からないが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050816
					],
					"speakerTitle": "羅おじ"
				},
				{
					"id": 711050816,
					"content": "だが彼が災難に遭ったときのことは覚えている。みんな、懸練山の近くで彼を発見したんだ。そのとき、彼は手に水の入った瓶を握りしめていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050817
					],
					"speakerTitle": "羅おじ"
				},
				{
					"id": 711050817,
					"content": "家の庭に仙草があって、その「仙水」をやらなければ生きていけないのだと彼は言っていた。まったく愚かだと思ったよ。どれも同じ川の水で、特別なところなんてありはしない。そのために命をかけるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050818
					],
					"speakerTitle": "羅おじ"
				},
				{
					"id": 711050818,
					"content": "はぁ…とはいえ、故人に敬意を払って、私たちは彼を埋葬した後、彼が汲んできたその水を庭にまいてやったんだ。安らかに眠れるようにな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050819
					],
					"speakerTitle": "羅おじ"
				},
				{
					"id": 711050819,
					"content": "懸練山の仙水？オイラたちもそこに行って、仙水も汲んできたけど…じゃあ、その薬草採りって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050820
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711050820,
					"content": "同じ人な気がする。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050821
					]
				},
				{
					"id": 711050821,
					"content": "なるほど、不思議な話だな。それなら…ついて来てくれ。彼の庭に案内してあげよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050822
					],
					"speakerTitle": "羅おじ"
				},
				{
					"id": 711050822,
					"content": "君たちも水を汲んできたのなら、彼の庭にまいてやるといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "羅おじ"
				}
			]
		},
