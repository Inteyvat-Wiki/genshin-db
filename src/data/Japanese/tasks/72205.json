				"points": []
			},
			"dialogs": [
				{
					"id": 722050301,
					"content": "#こんにちは、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050302,
						722050303
					],
					"speakerTitle": "キト"
				},
				{
					"id": 722050302,
					"content": "こんにちは。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050304
					]
				},
				{
					"id": 722050304,
					"content": "この前あの花を摘んできてくれてありがとう！でも…なんだか変なんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050305
					],
					"speakerTitle": "キト"
				},
				{
					"id": 722050305,
					"content": "私も、ずっとなにかおかしい感じがする…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050306
					],
					"speakerTitle": "キナ"
				},
				{
					"id": 722050306,
					"content": "毎回違う場所に行っても、いつも悲しい人に会う…みんな他の人の話が聞こえないみたいに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050307
					],
					"speakerTitle": "キト"
				},
				{
					"id": 722050307,
					"content": "それに、キレイな花を見かけて、ポケットに入れても、すぐに失くなっちゃう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050308,
						722050309
					],
					"speakerTitle": "キナ"
				},
				{
					"id": 722050308,
					"content": "それは…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050310
					]
				},
				{
					"id": 722050310,
					"content": "そうなんだ…よくわからない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050311
					],
					"speakerTitle": "キト"
				},
				{
					"id": 722050311,
					"content": "もう離れなきゃいけないの…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050312
					],
					"speakerTitle": "キナ"
				},
				{
					"id": 722050312,
					"content": "あの金色のおじさんも似たようなことを言ってた…でも、まだあのおじさんとは一緒に行けない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050313
					],
					"speakerTitle": "キト"
				},
				{
					"id": 722050313,
					"content": "私たち、まだウナおばあちゃんにキレイな花をあげなきゃいけないから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キナ"
				},
				{
					"id": 722050309,
					"content": "そろそろ離れないと。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050310
					]
				},
				{
					"id": 722050303,
					"content": "元気だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050304
					]
				}
			]
		},
		{
			"id": 7220505,
