			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"キト",
					"キナ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722050101,
					"content": "うぅ、おかしいなぁ…ポケットにあるはずなのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050102,
						722050103
					],
					"speakerTitle": "キト"
				},
				{
					"id": 722050102,
					"content": "こんにちは。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050104
					]
				},
				{
					"id": 722050104,
					"content": "失くしちゃったら大変…ウナおばあちゃんに渡さないといけないのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050105
					],
					"speakerTitle": "キナ"
				},
				{
					"id": 722050105,
					"content": "ウナおばあちゃん、もう年だから、色々忘れてきてる…最近は若かった頃のことをずっと言ってるし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050106
					],
					"speakerTitle": "キト"
				},
				{
					"id": 722050106,
					"content": "ずっと「花」のことを言ってるよ…その花は、霧海の外の花で、色の違うキレイな花なんだって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050107
					],
					"speakerTitle": "キナ"
				},
				{
					"id": 722050107,
					"content": "ある日、夢を見たんだ…島の霧が「パッ」ってぜんぶ消えて、海の向こうに大きくて高いキレイな屋敷が建ってた…木でも金でもない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050108
					],
					"speakerTitle": "キト"
				},
				{
					"id": 722050108,
					"content": "私も私も！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050109
					],
					"speakerTitle": "キナ"
				},
				{
					"id": 722050109,
					"content": "あの夢の中で、僕は高い山と大きな木に登って、キレイな花をいっぱい摘んだ…見たことなかったけど、ウナおばあちゃんが欲しがってた花だってわかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050110
					],
					"speakerTitle": "キト"
				},
				{
					"id": 722050110,
					"content": "でも花を採りすぎて、すごく重たくて、木から落ちちゃったんだ。ずっと落ちてたら…夢から覚めた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050111
					],
					"speakerTitle": "キト"
				},
				{
					"id": 722050111,
					"content": "ふん、欲張りだからでしょ！私は何回もこれで足りるって言ったのに！最後は私まで一緒に落ちちゃったじゃない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050112
					],
					"speakerTitle": "キナ"
				},
				{
					"id": 722050112,
					"content": "ポケットにも何もないし…どんな顔でウナおばあちゃんのところに帰ればいいの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キト"
				},
				{
					"id": 722050103,
					"content": "何か手伝えることは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050104
					]
				}
			]
		},
		{
			"id": 7220503,
			"completionStepIds": [
				7220512
