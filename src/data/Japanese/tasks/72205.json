			},
			"dialogs": [
				{
					"id": 722050501,
					"content": "ここでまた会ったね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050502
					],
					"speakerTitle": "キト"
				},
				{
					"id": 722050502,
					"content": "また会ったね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050503,
						722050504
					],
					"speakerTitle": "キナ"
				},
				{
					"id": 722050503,
					"content": "こんにちは！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050505
					]
				},
				{
					"id": 722050505,
					"content": "#えへへ、まだここにいるよ！そういえば、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}はこの大きな石が何に使われるか知ってる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050506
					],
					"speakerTitle": "キト"
				},
				{
					"id": 722050506,
					"content": "ふふん、キトお兄ちゃんはなんでも知ってるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050507,
						722050508
					],
					"speakerTitle": "キナ"
				},
				{
					"id": 722050507,
					"content": "知らない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050509
					]
				},
				{
					"id": 722050509,
					"content": "マタおじいちゃんによると、これは亡霊を招く墓なんだって…死んだあとにさまよってる霊は、この大きな石に引き寄せられて、ここで夢から覚める。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050510
					],
					"speakerTitle": "キト"
				},
				{
					"id": 722050510,
					"content": "そして島の上で徘徊して…彼らの願いを満足させられる人を探す。見つけたあとは、その人にまとわりつく…自分の願いが満たされ、船乗りに送られるまで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050511
					],
					"speakerTitle": "キト"
				},
				{
					"id": 722050511,
					"content": "良い霊もいるけど、悪い霊もいる…だから、霧の夜道を歩くとき、この大きな石の前で、自分の名前を大声で叫ぶ必要があるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050512
					],
					"speakerTitle": "キト"
				},
				{
					"id": 722050512,
					"content": "先祖を心に刻んでる人は、孤独な魂よりも勇気を持ってる。死んだ霊が生者の血筋を知れば、そそくさと離れていくんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050513
					],
					"speakerTitle": "キト"
				},
				{
					"id": 722050513,
					"content": "#ただ、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}は外から来たんだよね…ここで名高い名前とかないから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050514
					],
					"speakerTitle": "キト"
				},
				{
					"id": 722050514,
					"content": "#うぅ…悪い霊が来ちゃったら、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}はどうすればいいの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050515
					],
					"speakerTitle": "キナ"
				},
				{
					"id": 722050515,
					"content": "へへ、大丈夫、怖がらないで。僕が守るから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050516
					],
					"speakerTitle": "キト"
				},
				{
					"id": 722050516,
					"content": "キナも！一緒に悪い霊を追い返すよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キナ"
				},
				{
					"id": 722050508,
					"content": "何に使うの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050509
					]
				},
				{
					"id": 722050504,
					"content": "まだ島にいたんだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050505
					]
				}
			]
		},
