			"dialogs": [
				{
					"id": 722050701,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}、また会ったね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050702
					],
					"speakerTitle": "キト"
				},
				{
					"id": 722050702,
					"content": "キトお兄ちゃん、今日は話をしたくないみたい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050703,
						722050704
					],
					"speakerTitle": "キナ"
				},
				{
					"id": 722050703,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050705
					]
				},
				{
					"id": 722050705,
					"content": "大丈夫…一人で遊んでるから、放っておいてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
