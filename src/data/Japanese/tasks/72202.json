			"dialogs": [
				{
					"id": 722020101,
					"content": "雷鳥様…私を見捨てたのですか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020102,
						722020103
					],
					"speakerTitle": "チセ"
				},
				{
					"id": 722020102,
					"content": "こんにちは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722020104
					]
				},
				{
					"id": 722020104,
					"content": "雷鳥様…どうか怒りをお鎮めください…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020105
					],
					"speakerTitle": "チセ"
				},
				{
					"id": 722020105,
					"content": "あなた様の旨意と教諭を読むために最善を尽くします…ですが…ですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020106
					],
					"speakerTitle": "チセ"
				},
				{
					"id": 722020106,
					"content": "どうして…私を拒絶するのですか…どうして…うぅ…ぅぅう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020107
					],
					"speakerTitle": "チセ"
				},
				{
					"id": 722020107,
					"content": "どうして…私はあなた様の霧に深入りできないのですか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020108,
						722020113
					],
					"speakerTitle": "チセ"
				},
				{
					"id": 722020108,
					"content": "読む…何を言ってるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722020109
					]
				},
				{
					"id": 722020109,
					"content": "あなた様が残した雷石…私がなんとかします…銀色の船が来ました、もう私に時間はありません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020110
					],
					"speakerTitle": "チセ"
				},
				{
					"id": 722020110,
					"content": "雷石って…何？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722020111
					]
				},
				{
					"id": 722020111,
					"content": "アウタケ平原の雷石…雷電を扱うことができる者にのみ動かせ…霧の中を迷わずに行ける者にのみ、見つけることができる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020112
					],
					"speakerTitle": "チセ"
				},
				{
					"id": 722020112,
					"content": "雷鳥が立ち…雷鳥が翼を広げるように…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "チセ"
				},
				{
					"id": 722020113,
					"content": "霧は…消えたはずだけど？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722020109
					]
				},
				{
					"id": 722020103,
					"content": "何か手伝えることは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722020104
					]
				}
			]
		},
