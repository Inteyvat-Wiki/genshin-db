			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"柴染"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726880101,
					"content": "またお会いしましたね、お二方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880102
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726880102,
					"content": "昨日の「花影瑶庭」は実に楽しめました。あなたたちは才能に恵まれているようですね。これなら花芸の真髄もすぐに掴めそうです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880103
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726880103,
					"content": "新しい「花題」をあなたたちに用意しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880104,
						726880110
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726880104,
					"content": "さっそく始めよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726880105
					]
				},
				{
					"id": 726880105,
					"content": "おう！準備は万端だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726880106,
					"content": "お二方の目には、煌びやかな光が宿っています。まるで色鮮やかな花の海を映しているかのようで、驚きました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880107
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726880107,
					"content": "さて、あなたたちの発想力を磨くためにも、本日の「花題」は少し難しくしています——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880108
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726880108,
					"content": "「湖畔に奇石、池に蓮の花」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880109
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726880109,
					"content": "花題の意味を理解した上で、花材を慎重に選び、あなたたちの「花庭」を作ってみてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柴染"
				},
				{
					"id": 726880110,
					"content": "他に用事がある…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726880111
					]
				},
				{
					"id": 726880111,
					"content": "ええ、それでしたら大丈夫です。花を生けるには、心を落ち着かせる必要がありますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880112
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726880112,
					"content": "用事を済ませ、喧噪から離れた時、花題にある「花庭」をより完璧なものにすることができるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柴染"
				}
			]
		},
		{
			"id": 7268803,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7268801",
							"2"
						],
						"stepId": 7268801,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7268803",
							"2"
						],
						"stepId": 7268803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"柴染"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726870201,
					"content": "容彩祭にいらしている方たちに、「花影瑶庭」の素晴らしさを伝えられるよう、これから数日間、私はここで案内をしてまいります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870202
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870202,
					"content": "お二方も「花題」を毎日解くのを忘れないでください。合計で四つの「花題」を用意していますので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870203
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870203,
					"content": "もちろん、何かご質問がありましたら、私もできる限りお答えいたします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870204,
						726870210,
						726870222
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870204,
					"content": "ここのお花について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870205
					]
				},
				{
					"id": 726870205,
					"content": "私が使っている花材はすべて、「咲耶の花屋」が提供してくれたものです。「咲耶の花屋」が栽培しているお花は、手頃な価格ながらもどれも質がいいんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870206
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870206,
					"content": "あなたたちは、すでに咲耶さんと会ったことがあるかもしれませんね。私たちは同じ先生のもとで「生け花」を学びました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870207
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870207,
					"content": "花芸について、咲耶さんも深い見識を持っています。ただ、容彩祭に大勢の人が来ることを聞いた途端、少し緊張してしまったようです。こういった環境では、落ち着いて生け花ができないとか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870208
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870208,
					"content": "ですので、私が代わりに「咲耶の花屋」を皆さんに勧めています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870209
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870209,
					"content": "機会があったら、オイラたちも手伝ってやるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870219
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726870219,
					"content": "他に何か質問はありますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870220
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870220,
					"content": "ありがとう、柴染さん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870221
					]
				},
				{
					"id": 726870221,
					"content": "いえ、どういたしまして。時間がありましたら、いつでも来てください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870210,
					"content": "社奉行について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870211
					]
				},
				{
					"id": 726870211,
					"content": "社奉行は、これまで稲妻の花芸事業を支えてきてくれました。もっと言うと、今回の催しのために出資してくださった貴人は、まさにあの白鷺の姫君なのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870212
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870212,
					"content": "白鷺の姫君は幼少の頃より、花芸に対して素晴らしい才を見せていました。私はあの方が花を生ける姿を見たことがあり、その心得についても語り合ったことがあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870213
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870213,
					"content": "私のほうが年上ではありますが、生け花の技術も花芸に対する理解も、あの方には及びません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870214
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870214,
					"content": "状況が許す限り、白鷺の姫君は「生け花」の持つ芸術性を広めるため、資金を毎年提供してくれます。時には、自分の貯蓄を使うこともあるようです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870215
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870215,
					"content": "白鷺の姫君は、以前このように自分の胸の内を打ち明けたことがありました——「生け花」をより多くの人に知ってもらい、花芸に興味を持っていただいて、それに精通してほしいと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870216
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870216,
					"content": "綾華、稲妻の花芸のためにそんなに頑張ってたんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870217
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726870217,
					"content": "彼女の願いが叶うといい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870218
					]
				},
				{
					"id": 726870218,
					"content": "ありがとうございます。お二方とも思いやりに溢れた方々なのですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870219
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870222,
					"content": "もう大丈夫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870223
					]
				},
				{
					"id": 726870223,
					"content": "時間がありましたら、いつでも来てください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柴染"
				}
			]
		}
	]
}