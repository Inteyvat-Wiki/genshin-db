			"dialogs": [
				{
					"id": 765090101,
					"content": "へぇ、「親切な商人」さんじゃないの…なぁに、こんなところまで商売に来たってわけ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090102
					],
					"speakerTitle": "ヴィスラヴァ"
				},
				{
					"id": 765090102,
					"content": "はぁ、あなたには分からないかもしれないけど、私みたいにお金のない庶民にとって、商機を嗅ぎとるっていうのは、野良犬が美味しそうな骨を嗅ぎつけるようなものなんだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090103
					],
					"speakerTitle": "エドラー"
				},
				{
					"id": 765090103,
					"content": "ふぅん、よく喋るのね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090104
					],
					"speakerTitle": "ヴィスラヴァ"
				},
				{
					"id": 765090104,
					"content": "盤面を見てみたら？負け寸前じゃないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090105
					],
					"speakerTitle": "ヴィスラヴァ"
				},
				{
					"id": 765090105,
					"content": "#そうでもないよ…あれ？{NICKNAME}さん。ちょうどよかった！この人にどうやって一矢報いるか、知恵を貸してよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090106
					],
					"speakerTitle": "エドラー"
				},
				{
					"id": 765090106,
					"content": "へへっ、そういうのはオイラたち得意だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765090107,
					"content": "#{M#俺}{F#私}が前にやったのとちょっと違う…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765090108
					]
				},
				{
					"id": 765090108,
					"content": "新しい場所で「商売」をするには、それなりに変化が必要だからね。これは、私が改良した最新の兵棋演習なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090109
					],
					"speakerTitle": "エドラー"
				},
				{
					"id": 765090109,
					"content": "つまり、遊びの幅がもっと広がったってこと。「戦線リーダー」がいて、それぞれ効果の違う旗があって…まるで本物の軍隊を指揮してるような感覚を味わえるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090110
					],
					"speakerTitle": "エドラー"
				},
				{
					"id": 765090110,
					"content": "って、お客さんに勧めてたら、この人に邪魔されちゃったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090111
					],
					"speakerTitle": "エドラー"
				},
				{
					"id": 765090111,
					"content": "私の商品は合法だし、通報なんてしなくていいって説得するには、一回手合わせしてみるしかなかったんだ。危険な「軍事兵器」だなんて誤解されたら、たまったものじゃないからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090112
					],
					"speakerTitle": "エドラー"
				},
				{
					"id": 765090112,
					"content": "ふん、ひとりで長々と…あっ、もしかしてお二人は、あの有名な旅人さんと最高のガイド、パイモンさんでは？お噂はかねがね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090113
					],
					"speakerTitle": "ヴィスラヴァ"
				},
				{
					"id": 765090113,
					"content": "まさか、この親切なフォンテーヌの商人がこんな人脈を持ってたなんて…お二人の名声は広く知れ渡ってるわ。お会いできて光栄よ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090114
					],
					"speakerTitle": "ヴィスラヴァ"
				},
				{
					"id": 765090114,
					"content": "あたしはヴィスラヴァ。「親切なボディガード」とでも思ってくれたらいいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090115
					],
					"speakerTitle": "ヴィスラヴァ"
				},
				{
					"id": 765090115,
					"content": "残念ながら、まだ演習が終わってなくて。そうでもなければ、すぐにでもおもてなしさせていただくんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090116,
						765090117
					],
					"speakerTitle": "ヴィスラヴァ"
				},
				{
					"id": 765090116,
					"content": "（「おもてなし」…含みがあったりして。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765090118
					]
				},
				{
					"id": 765090118,
					"content": "へへっ、そんなに気にしなくていいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765090119,
					"content": "おまえ、結構いいやつなんだな！前におまえみたいな格好のやつと会った時は、えっと…いきなりケンカになっちゃってさ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765090120,
					"content": "あはは、今は休暇中だから。普段なら手を出せる時は出すけど…とにかく、今は危害を加えるつもりはないわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090121
					],
					"speakerTitle": "ヴィスラヴァ"
				},
				{
					"id": 765090121,
					"content": "#でも、{M#君}{F#あなた}たちは戦う気みたいだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765090122
					]
				},
				{
					"id": 765090122,
					"content": "そうだぞ！さっき来た時、兵棋演習してただけなのに、なんかピリピリしてたように見えたけど…誤解だったみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765090123,
					"content": "手合わせ？いいアイデアね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090124
					],
					"speakerTitle": "ヴィスラヴァ"
				},
				{
					"id": 765090124,
					"content": "まあ、別にいいけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090125
					],
					"speakerTitle": "エドラー"
				},
				{
					"id": 765090125,
					"content": "ちょ、ちょっと待て！そう思ったってだけだぞ！なんで本気になっちゃうんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765090126,
					"content": "あはは、冗談だって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090127
					],
					"speakerTitle": "エドラー"
				},
				{
					"id": 765090127,
					"content": "でも、この新商品には雰囲気を和ませてくれる効果もあるみたいだよ…戦う寸前だった二人が、この新しい兵棋演習を目の前にしたとたん、これだからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090128
					],
					"speakerTitle": "エドラー"
				},
				{
					"id": 765090128,
					"content": "おっと、ついお喋りが長くなっちゃった。さあ、旅人さんも試してみない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090129
					],
					"speakerTitle": "エドラー"
				},
				{
					"id": 765090129,
					"content": "やってみたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765090130
					]
				},
				{
					"id": 765090130,
					"content": "それか、先に彼女を倒すのを手伝ってくれてもいいけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090131
					],
					"speakerTitle": "エドラー"
				},
				{
					"id": 765090131,
					"content": "助っ人禁止！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴィスラヴァ"
				},
				{
					"id": 765090117,
					"content": "（ちょっと危険なにおい…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765090118
					]
				}
			]
		}
	]
}