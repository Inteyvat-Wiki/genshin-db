					"イルマリ"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2428.906,
							200.527,
							8923.907
						],
						"pointId": 14142
					},
					{
						"sceneId": 3,
						"position": [
							2427.081,
							200.4,
							8922.118
						],
						"pointId": 14143
					},
					{
						"sceneId": 3,
						"position": [
							2427.91,
							200.376,
							8922.991
						],
						"pointId": 14144
					}
				]
			},
			"dialogs": [
				{
					"id": 760420201,
					"content": "その身なり…宝探しにきたトレジャーハンターか？あんたらのような人間はしょっちゅうやってくるが、飽きもせずによくもまあ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420202
					],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760420202,
					"content": "じいさん、鋭いな。同業者がここでひどい目に遭ったらしくてさ。しかも幽霊に襲われたとかって騒ぎ立ててるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420203
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760420203,
					"content": "あたいは幽霊も祟りも信じてないから、本当に人を襲う幽霊なんかがいるのか、確かめにきたんだよ…もちろん、同業者が手に入れそびれた宝物を見つけられたらもっといいけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420204
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760420204,
					"content": "じいさん、教えてくれ。あいつらの言ってた人を襲う幽霊って一体なんなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420205
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760420205,
					"content": "人を襲う幽霊などおらん。ぶたれるのが人なら、ぶつほうも人に決まっとるわい。じゃがなあ、あれは確かに悪鬼のような人間じゃった。生きてはいるが…とっくに死んでおるのかもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420206
					],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760420206,
					"content": "…は？じいさん、何言って…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420207
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760420207,
					"content": "でたらめなどではないぞ。アトラス号を知っておるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420208
					],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760420208,
					"content": "知ってるよ。でも沈んじまったんだろ？このすぐ近くで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420209
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760420209,
					"content": "あの船で最も価値のあるお宝——それはレッド・ミラーが残した「偉大なる財宝」を見つけるためのしるしだ。ま、今まで誰も見つけたことはないけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420210
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760420210,
					"content": "詳しいのう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420211
					],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760420211,
					"content": "へへっ、これでもプロだからね。ん？つまり、人を襲ってるやつはアトラス号と関係してるってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420212
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760420212,
					"content": "その通りじゃ。あの海難事故は凄惨なものじゃったが、生存者も少なからずいた。「裂けアゴ」のハルクなんかも、そのうちの一人じゃな。アトラス号で名を轟かせた海賊は、もはや彼一人となった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420213
					],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760420213,
					"content": "聞いた話では、数年はスネージナヤ・グラードで働いたのちに、どこかのキャラバンで仕事をしとったそうじゃ。じゃが最近は、ナシャタウンで何かをしでかしたようで、キャラバンも彼を敬遠しとる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420214
					],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760420214,
					"content": "その日、数人のトレジャーハンターがアトラス号の残骸付近を探しているとき、「裂けアゴ」のハルクがそれを目撃し、彼らに襲いかかったんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420215
					],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760420215,
					"content": "もともとやつの船だったんだ…沈んでも思い入れがあるんだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420216
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760420216,
					"content": "そうじゃな。海難事故があってから、彼は二度と船に乗ることはなかったらしい。海賊なんてもってのほかじゃろう。じゃが、彼のような人間がまともな職で生計を立てるというのは、そう簡単なことでもない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420217
					],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760420217,
					"content": "昔…アトラス号に「世話」になった連中は、ただじゃ引き下がれないだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420218
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760420218,
					"content": "でも全部自分で選んだことなんだし、人のせいにしちゃいけないだろ。自分の選択には責任を負うもんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420219
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760420219,
					"content": "人は生きていれば過ちを犯すこともある。大事なのは、すぐに軌道修正することじゃ。ハルクは舵手だというのに、こう何度も道を誤るとはのう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420220
					],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760420220,
					"content": "つまり、ハルクはナシャタウンで問題を起こして戻ってきたのか。そいつにとって終わりの地であり、始まりの地でもあるここに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420221
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760420221,
					"content": "でも、そいつはまた間違った選択をした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420222
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760420222,
					"content": "人の本質は変わらんということじゃな。彼はここで多くの人を傷つけ…逃げ上手な魚のようにすっかり姿を消してしまいおった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420223
					],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760420223,
					"content": "ナシャタウンの「フラッグシップ」も指名手配しておるそうじゃ。多くの人が念入りにやつを探しているのに、髪の毛一本見つからん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420224
					],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760420224,
					"content": "じいさん、魚は釣れてないみたいだけど、情報通なんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420225
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760420225,
					"content": "ふん、口が達者な嬢ちゃんじゃのう…もう一ついいことを教えてやろう。アトラス号の残骸はあそこじゃ。運試ししてみるがいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420226
					],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760420226,
					"content": "運試し？もしやつがいきなりどっかから現れて襲ってきたら、じいさんが助けてくれるのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420227
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760420227,
					"content": "何をいう、わしはただの釣り人だぞ…どうやって助けろと言うんじゃ。せいぜい近くまで一緒に行って道案内をするくらいじゃな…どうせここでは魚も釣れんからのう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420228
					],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760420228,
					"content": "はあ、そうだよな。大丈夫、勝てなかったらずらかればいいんだ。あたいは逃げるのは大得意だからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヤフォダ"
				}
			]
		},
