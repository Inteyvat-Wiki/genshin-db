				]
			},
			"dialogs": [
				{
					"id": 760420301,
					"content": "その身なり…宝探しにきたトレジャーハンターか？あんたらのような人間はしょっちゅうやってくるが、飽きもせずによくもまあ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420302
					],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760420302,
					"content": "じいさん、鋭いな。同業者がここでひどい目に遭ったらしくてさ。しかも幽霊に襲われたとかって騒ぎ立ててるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420303
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760420303,
					"content": "あたいは幽霊も祟りも信じてないから、本当に人を襲う幽霊なんかがいるのか、確かめにきたんだよ…もちろん、同業者が手に入れそびれた宝物を見つけられたらもっといいけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420304
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760420304,
					"content": "じいさん、教えてくれ。あいつらの言ってた人を襲う幽霊って一体なんなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420305
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760420305,
					"content": "ここには幽霊がおるんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420306
					],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760420306,
					"content": "はぁ！？ほんとにいるのかよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420307
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760420307,
					"content": "いや、実際に見たのは人が人を襲っている光景じゃ。まあ、確かに悪鬼のようなやつじゃったな。生きてるようで、とっくに死んでおるのかもしれん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420308
					],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760420308,
					"content": "…は？じいさん、何言って…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420309
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760420309,
					"content": "でたらめなどではないぞ。アトラス号を知っておるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420310
					],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760420310,
					"content": "知ってるよ。でも沈んじまったんだろ？このすぐ近くで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420311
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760420311,
					"content": "あの船で最も価値のあるお宝…それはレッド・ミラーが残した「偉大なる財宝」を見つけるためのしるしだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420312
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760420312,
					"content": "詳しいようじゃの。そのしるしなら、小さな白いやつを連れた金髪の冒険者が、前に見つけていったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420313
					],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760420313,
					"content": "（は？それってまさか…うーん、でも今は仕事が優先だな。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420314
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760420314,
					"content": "へへっ、これでもプロだからね。ん？つまり、人を襲ってるやつはアトラス号と関係してるってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420315
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760420315,
					"content": "その通りじゃ。あの海難事故は凄惨なものじゃったが、生存者も少なからずいた。「裂けアゴ」のハルクなんかも、そのうちの一人じゃな。アトラス号で名を轟かせた海賊は、もはや彼一人となった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420316
					],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760420316,
					"content": "聞いた話では、数年はスネージナヤ・グラードで働いたのちに、どこかのキャラバンで仕事をしとったそうじゃ。じゃが最近は、ナシャタウンで何かをしでかしたようで、キャラバンも彼を敬遠しとる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420317
					],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760420317,
					"content": "その日、数人のトレジャーハンターがアトラス号の残骸付近を探しているとき、「裂けアゴ」のハルクがそれを目撃し、彼らに襲いかかったんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420318
					],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760420318,
					"content": "もともとやつの船だったんだ…沈んでも思い入れがあるんだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420319
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760420319,
					"content": "そうじゃな。海難事故があってから、彼は二度と船に乗る勇気は出なかったらしい。海賊なんてもってのほかじゃろう。だが、彼のような人間がまともな職で生計を立てるというのは、そう簡単なことでもない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420320
					],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760420320,
					"content": "昔…アトラス号に「世話」になった連中は、ただじゃ引き下がれないだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420321
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760420321,
					"content": "でも全部自分で選んだことなんだし、人のせいにしちゃいけないだろ。自分の選択には責任を負うもんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420322
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760420322,
					"content": "人は生きていれば過ちを犯すこともある。大事なのは、すぐに軌道修正することじゃ。ハルクは舵手だというのに、こう何度も道を誤るとはのう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420323
					],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760420323,
					"content": "つまり、ハルクはナシャタウンで問題を起こして戻ってきたのか。そいつにとって終わりの地であり、始まりの地でもあるここに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420324
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760420324,
					"content": "でも、そいつはまた間違った選択をした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420325
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760420325,
					"content": "人の本質は変わらんということじゃな。彼はここで多くの人を傷つけ…逃げ上手な魚のようにすっかり姿を消してしまいおった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420326
					],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760420326,
					"content": "ナシャタウンの「フラッグシップ」も指名手配しておるそうじゃ。多くの人が念入りにやつを探しているのに、髪の毛一本見つからん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420327
					],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760420327,
					"content": "じいさん、魚は釣れてないみたいだけど、情報通なんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420328
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760420328,
					"content": "ふん、口が達者な嬢ちゃんじゃのう…もう一ついいことを教えてやろう。アトラス号の残骸はあそこじゃ。運試ししてみるがいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420329
					],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760420329,
					"content": "運試し？もしやつがいきなりどっかから現れて襲ってきたら、じいさんが助けてくれるのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420330
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760420330,
					"content": "何をいう、わしはただの釣り人だぞ…どうやって助けろと言うんじゃ。せいぜい近くまで一緒に行って道案内をするくらいじゃな…どうせここでは魚も釣れんからのう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420331
					],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760420331,
					"content": "はあ、そうだよな。大丈夫、勝てなかったらずらかればいいんだ。あたいは逃げるのは大得意だからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヤフォダ"
				}
			]
		},
