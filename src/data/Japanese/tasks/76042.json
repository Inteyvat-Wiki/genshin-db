			"dialogs": [
				{
					"id": 760420101,
					"content": "トレジャーハンターが、海賊船の残骸を漁っている最中に幽霊に襲われた…なんつーか、三流のエンタメ小説みたいな話だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420102
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760420102,
					"content": "殴られたやつらも、言ってることが滅茶苦茶だし…これじゃ本当か嘘か分からないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420103
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760420103,
					"content": "海賊船の話、ヤフォダも知ってたんだね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420104
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 760420104,
					"content": "うん。小さい頃だったけど、アトラス号の話はすごかったもん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420105
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760420105,
					"content": "いい子にしてないと、『盾女』ロヴィーサが捕まえにくるぞ。『狂人』グレティルがお前を海に投げ捨てて、魚の餌にしてしまうぞ——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420106
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760420106,
					"content": "昔、そんな話で脅かされたな。まあ、あたいはちっとも怖くなかったけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420107
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760420107,
					"content": "ふっ、そういうことなら今回の任務の適任者はあんたしかいないね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420108
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 760420108,
					"content": "…えっ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420109
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760420109,
					"content": "わかったよ…ちょっと遠いけど、調査してみる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420110
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760420110,
					"content": "（あの海域は沈没船が多くて、たまに宝物を掘り出すやつがいるんだよな。もしかしたら、あたいも…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420111
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760420111,
					"content": "宝探しに夢中になって仕事を疎かにしないようにね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420112
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 760420112,
					"content": "わ、わかってるって姐さん！さっさと終わらせて戻ってくるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヤフォダ"
				}
			]
		},
		{
