			"dialogs": [
				{
					"id": 790750201,
					"content": "ぼくは…ここを掃除しておくよ。ショヴィニェのために日向ぼっこする場所を作ってやらなきゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750202
					],
					"speakerTitle": "パニュール"
				},
				{
					"id": 790750202,
					"content": "ショヴィニェの説得については二人にお願いするね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750203
					],
					"speakerTitle": "パニュール"
				},
				{
					"id": 790750203,
					"content": "ぼくが行ったら、しつこいって怒らせちゃうかもしれないから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パニュール"
