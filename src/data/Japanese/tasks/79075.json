			"dialogs": [
				{
					"id": 790750101,
					"content": "はぁ…ショヴィニェは一体何を考えてるんだ？頑なにぼくとの会話を拒むだなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750102
					],
					"speakerTitle": "パニュール"
				},
				{
					"id": 790750102,
					"content": "ショヴィニェについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750103
					]
				},
				{
					"id": 790750103,
					"content": "やあ、二人とも…ショヴィニェはまだぼくに怒ってるみたいなんだ。いくら呼んでも出てきてくれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750104
					],
					"speakerTitle": "パニュール"
				},
				{
					"id": 790750104,
					"content": "はぁ、下じゃ風も吹かないし、日差しも届かない。枯れちゃったらどうしよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750105
					],
					"speakerTitle": "パニュール"
				},
				{
					"id": 790750105,
					"content": "その…植木鉢なら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790750106,
					"content": "持ち出してあげればいいんじゃ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750107
					]
				},
				{
					"id": 790750107,
					"content": "試しはしたよ。でも、ショヴィニェのやつ、ずっと怒ってて…近づくことすらできなかったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750108
					],
					"speakerTitle": "パニュール"
				},
				{
					"id": 790750108,
					"content": "あんまりぷんすか怒ってるもんで、吹き飛ばされるところだったよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750109
					],
					"speakerTitle": "パニュール"
				},
				{
					"id": 790750109,
					"content": "待てよ。なんでぷんすかしたくらいで吹き飛ばされることになるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750110,
						790750111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790750110,
					"content": "さすがにぷんすかしすぎ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750112
					]
				},
				{
					"id": 790750112,
					"content": "この前、旅の誘いを断ったのが怒りを買ったのかもね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750113
					],
					"speakerTitle": "パニュール"
				},
				{
					"id": 790750113,
					"content": "あの…ショヴィニェの様子を見てきてくれない？あなたたちなら、彼を説得できるかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750114
					],
					"speakerTitle": "パニュール"
				},
				{
					"id": 790750114,
					"content": "いいよ、試してみる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750115
					]
				},
				{
					"id": 790750115,
					"content": "おう。オイラたちはいろんな場所を旅してきて、いろんなやつと会ってきたからな。きっと…えっと、もしかしたら、あいつを説得できるかもしれないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790750116,
					"content": "よかった！ショヴィニェはこの島の下の洞窟にいるんだ。探してみてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750117
					],
					"speakerTitle": "パニュール"
				},
				{
					"id": 790750117,
					"content": "ぼくは…ここを掃除しておくよ。ショヴィニェのために日向ぼっこする場所を作ってやらなきゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パニュール"
				},
				{
					"id": 790750111,
					"content": "確かに近寄りたくないかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750112
					]
				}
			]
		},
