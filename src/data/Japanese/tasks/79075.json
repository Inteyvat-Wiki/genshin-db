						],
						"pointId": 311
					}
				]
			},
			"dialogs": [
				{
					"id": 790750301,
					"content": "ふぅ…やっと風が止まったぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750302,
						790750303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790750302,
					"content": "話を聞いて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750304
					]
				},
				{
					"id": 790750304,
					"content": "分かった。話は聞くよ。でもその前に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750305
					],
					"speakerTitle": "ショヴィニェ"
				},
				{
					"id": 790750305,
					"content": "ショックを受けてるみたいだな。「なんで花が喋ってる」って聞きたくて仕方ないんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750306
					],
					"speakerTitle": "ショヴィニェ"
				},
				{
					"id": 790750306,
					"content": "それか「なんで花になったんだ」——かな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750307
					],
					"speakerTitle": "ショヴィニェ"
				},
				{
					"id": 790750307,
					"content": "よく聞かれるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750308
					]
				},
				{
					"id": 790750308,
					"content": "外にいた頃はよく聞かれたものさ。帰ってきた後…聞いてくる人はいなくなったけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750309
					],
					"speakerTitle": "ショヴィニェ"
				},
				{
					"id": 790750309,
					"content": "「外」って、この世界の外ってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790750310,
					"content": "旅から帰ったらこうなってたって聞いた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750311
					]
				},
				{
					"id": 790750311,
					"content": "ふーん、よく知ってるみたいだな。さてはパニュールから聞いたな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750312
					],
					"speakerTitle": "ショヴィニェ"
				},
				{
					"id": 790750312,
					"content": "そうさ。旅の途中で、オレはこんな風になったんだ。ははっ、ローゼルのやつの言葉を借りれば…これがオレの自ら望んだ「変化」だったってわけさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750313
					],
					"speakerTitle": "ショヴィニェ"
				},
				{
					"id": 790750313,
					"content": "変わりたいって気持ちはわからなくもないけど、なんで花になることを選んだんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750314,
						790750315
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790750314,
					"content": "植物が大好きだからってわけじゃないよね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750316
					]
				},
				{
					"id": 790750316,
					"content": "いや。オレはただ…己の「居場所」を見つけたかっただけさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750317
					],
					"speakerTitle": "ショヴィニェ"
				},
				{
					"id": 790750317,
					"content": "この世界の外で、色んなやつらを見てきた。シェフ、ガーデナー、教師…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750318
					],
					"speakerTitle": "ショヴィニェ"
				},
				{
					"id": 790750318,
					"content": "誰もが自分の安心できる「居場所」を見つけて、それぞれの生活を送ってた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750319
					],
					"speakerTitle": "ショヴィニェ"
				},
				{
					"id": 790750319,
					"content": "それに対してオレはどうだった？——旅しかとりえがなくて、自分のために安定した「居場所」を探そうだなんて思ったこともなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750320
					],
					"speakerTitle": "ショヴィニェ"
				},
				{
					"id": 790750320,
					"content": "#この「植木鉢」が{M#君}{F#あなた}の「居場所」なんだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750321
					]
				},
				{
					"id": 790750321,
					"content": "そういうことだ。理解が早くて助かるぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750322
					],
					"speakerTitle": "ショヴィニェ"
				},
				{
					"id": 790750322,
					"content": "植木鉢の中にいる花でいる限り、オレは常に安心できる「居場所」を持てる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750323
					],
					"speakerTitle": "ショヴィニェ"
				},
				{
					"id": 790750323,
					"content": "ただ…はぁ、植木鉢っていう己の「居場所」を見つけた今、旅に出る必要もなくなっただろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750324
					],
					"speakerTitle": "ショヴィニェ"
				},
				{
					"id": 790750324,
					"content": "でもオレは冒険客だ。旅をしないで、どんな価値ある事をやれるっていうんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750325
					],
					"speakerTitle": "ショヴィニェ"
				},
				{
					"id": 790750325,
					"content": "分からないんだ。外の世界を見れば見るほど、分からなくなる…「居場所」と「旅」、一体どっちが大切なんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750326
					],
					"speakerTitle": "ショヴィニェ"
				},
				{
					"id": 790750326,
					"content": "考えれば考えるほど頭が痛くなる…パニュールに話しかけられたときだって、うまく返事できなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750327
					],
					"speakerTitle": "ショヴィニェ"
				},
				{
					"id": 790750327,
					"content": "パニュールに間違った答えを出してしまうのが怖いんだ。もしあいつが元々は旅が好きだったのに、オレのこのザマを見て、旅が嫌いになったらどうしようってずっと考えちまってさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750328
					],
					"speakerTitle": "ショヴィニェ"
				},
				{
					"id": 790750328,
					"content": "でも、パニュールは永遠にオレの友達だ。だからあいつからの質問には誠実に答えなきゃならない。それで、あいつに聞かれたことを、全部答えちまったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750329
					],
					"speakerTitle": "ショヴィニェ"
				},
				{
					"id": 790750329,
					"content": "もちろん…オレが花になったのは、己が安心できる「居場所」が欲しかったからだってことを含めてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750330
					],
					"speakerTitle": "ショヴィニェ"
				},
				{
					"id": 790750330,
					"content": "この答えがあいつを悲しませたのかもしれない…それか、そもそもオレの今の姿が気に入らないのかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750331
					],
					"speakerTitle": "ショヴィニェ"
				},
				{
					"id": 790750331,
					"content": "それで、オレたちの距離は段々遠くなっていった。オレは花だから、自力で上まで登ることもできない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750332
					],
					"speakerTitle": "ショヴィニェ"
				},
				{
					"id": 790750332,
					"content": "でも、これでいいんだ。パニュールもきっとオレのことなんてうんざりだろ。きっとまだオレに怒ってるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750333
					],
					"speakerTitle": "ショヴィニェ"
				},
				{
					"id": 790750333,
					"content": "なるほどな。おまえたちはお互いに「相手が自分のことを怒ってる」って思ってたんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750334
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790750334,
					"content": "だから二人とも会うことを避けてた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750335
					]
				},
				{
					"id": 790750335,
					"content": "なんだよ？パニュールが怒ってないとでもいうのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750336,
						790750337
					],
					"speakerTitle": "ショヴィニェ"
				},
				{
					"id": 790750336,
					"content": "二人とも考えてることがそっくりだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750338
					]
				},
				{
					"id": 790750338,
					"content": "パニュールの考えをショヴィニェに伝えた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						790750339
					]
				},
				{
					"id": 790750339,
					"content": "なんてこったい！オレがそんな風に考えるわけないじゃないか。あいつの悲しむ顔がみたいなんて、一度も思ったことはないぜ。あいつの表情が少し曇っただけでも、心が砕けちまうのに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750340
					],
					"speakerTitle": "ショヴィニェ"
				},
				{
					"id": 790750340,
					"content": "二人とも！どうかオレを上まで連れてってくれ！お願いだ！一刻も早くパニュールに会いたいんだ！一秒だって待てないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750341
					],
					"speakerTitle": "ショヴィニェ"
				},
				{
					"id": 790750341,
					"content": "その言葉を待ってたんだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750342
					]
				},
				{
					"id": 790750342,
					"content": "#へへっ！行こうぜ、{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790750337,
					"content": "#彼は{M#君}{F#あなた}が怒ってると思ってる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750338
					]
				},
				{
					"id": 790750315,
