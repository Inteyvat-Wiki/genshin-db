			"dialogs": [
				{
					"id": 790750401,
					"content": "ショヴィニェ、き…来てくれたんだね。聞いてほしいんだ。ぼく、ショヴィニェのことを怒ったことなんて一度もないし、離れようだなんて思うはずないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750402
					],
					"speakerTitle": "パニュール"
				},
				{
					"id": 790750402,
					"content": "ぼくはただ…ショヴィニェがもうぼくの友達でいてくれないんじゃないかって心配だったんだ…ほら、冒険客の一部はすごく変わるでしょ？君もそういう風になったんじゃないかと思っちゃって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750403
					],
					"speakerTitle": "パニュール"
				},
				{
					"id": 790750403,
					"content": "女神様にお祈りもしたけど…いい貢物を捧げられなかったせいで、失敗しちゃった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750404
					],
					"speakerTitle": "パニュール"
				},
				{
					"id": 790750404,
					"content": "パニュール、そんなことは絶対にありえない。オレは永遠におまえの友達だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750405
					],
					"speakerTitle": "ショヴィニェ"
				},
				{
					"id": 790750405,
					"content": "オレにも謝らせてくれ。考え事をするのに精一杯で、おまえの話に耳を傾けることを忘れてた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750406
					],
					"speakerTitle": "ショヴィニェ"
				},
				{
					"id": 790750406,
					"content": "オレのこの姿を、おまえは…おまえはもう二度と見たくないんじゃないかと思ってたんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750407
					],
					"speakerTitle": "ショヴィニェ"
				},
				{
					"id": 790750407,
					"content": "やっと誤解が解けたね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750408
					]
				},
				{
					"id": 790750408,
					"content": "よかったな！てっきりとんでもない問題で、お互い顔も見たくないくらいの喧嘩になったのかと思ったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750409,
						790750410
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790750409,
					"content": "悩み自体は割と複雑だったけどね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750411
					]
				},
				{
					"id": 790750411,
					"content": "ありがとう、二人とも！あんたらがいなきゃ、オレはまだ下の洞窟で引きこもってただろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750412
					],
					"speakerTitle": "ショヴィニェ"
				},
				{
					"id": 790750412,
					"content": "今なら本心をあらいざらいパニュールに話せるぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750413
					],
					"speakerTitle": "ショヴィニェ"
				},
				{
					"id": 790750413,
					"content": "いつでも君の話を聞くよ、ショヴィニェ。旅のことでも、植木鉢のことでも…なんでも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750414
					],
					"speakerTitle": "パニュール"
				},
				{
					"id": 790750414,
					"content": "そうだ、二人とも。これを受け取ってくれ。時間をかけて集めてきたものなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750415
					],
					"speakerTitle": "パニュール"
				},
				{
					"id": 790750415,
					"content": "女神様のご加護があらんことを。友達とケンカすることがありませんように…それから、話を聞いてくれる人が常に傍にいますように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パニュール"
				},
				{
					"id": 790750410,
					"content": "解決したならそれでいい。",
					"roleType": "TALK_ROLE_PLAYER",
