			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"桂"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413400101,
					"content": "すみません、こんな日にまで面倒をかけてしまって。毎年海灯祭になると、「不卜廬」の患者も多くなって、大変忙しくなるのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400102
					],
					"speakerTitle": "桂"
				},
				{
					"id": 413400102,
					"content": "どうしてこんなに…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400103
					]
				},
				{
					"id": 413400103,
					"content": "海灯祭は、みなさん家族と一緒に宴をやったり、美食や美酒を嗜んだりします…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400104
					],
					"speakerTitle": "桂"
				},
				{
					"id": 413400104,
					"content": "そうすると、消化不良による病や症状が出る方がたくさん現れるのです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400105
					],
					"speakerTitle": "桂"
				},
				{
					"id": 413400105,
					"content": "私はいつも「暴飲暴食は避けるように」と忠告しているのですが、祭りの時はそれも聞いてくれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400106
					],
					"speakerTitle": "桂"
				},
				{
					"id": 413400106,
					"content": "先程も何件か、消化不良と胃病の薬を届けてほしいという連絡が入ったのですが…「不卜廬」も手を離せる状況じゃなく…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400107
					],
					"speakerTitle": "桂"
				},
				{
					"id": 413400107,
					"content": "旅人さん、もしよろしければ、薬を届けていただけないでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "桂"
				}
			]
		},
		{
			"id": 4134002,
