			},
			"dialogs": [
				{
					"id": 413400701,
					"content": "来たのですね。もう願い事を霄灯に書きました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400702
					],
					"speakerTitle": "桂"
				},
				{
					"id": 413400702,
					"content": "今ちょうどいい頃合いだと思います…霄灯を飛ばしましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400801
					],
					"speakerTitle": "桂"
				},
				{
					"id": 413400801,
					"content": "私の願い、璃月の民が健康に過ごせるように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400802
					],
					"speakerTitle": "桂"
				},
				{
					"id": 413400802,
					"content": "それじゃ「不卜廬」が…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400803
					]
				},
				{
					"id": 413400803,
					"content": "あははっ、ですので個人的な願いなのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400804
					],
					"speakerTitle": "桂"
				},
				{
					"id": 413400804,
					"content": "私が薬を手に取るのは、苦しんでいる人を助けたいからです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400805
					],
					"speakerTitle": "桂"
				},
				{
					"id": 413400805,
					"content": "「良薬を普及させ、病の無い世の中を祈る」とは正にこのことです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400806
					],
					"speakerTitle": "桂"
				},
				{
					"id": 413400806,
					"content": "ははっ、皆さんが健康でいてくれたら、私も忙しくしないで済むことでしょう。それもいいことです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400807
					],
					"speakerTitle": "桂"
				},
				{
					"id": 413400807,
					"content": "おっと！今思い出したのですが、まだ1件薬を届けてないお家がございました！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400808
					],
					"speakerTitle": "桂"
				},
				{
					"id": 413400808,
					"content": "すみません、私はこれで失礼します！良いお祭りを！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "桂"
				}
			]
		},
