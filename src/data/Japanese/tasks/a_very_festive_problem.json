			"trigger": {
				"objectNames": [
					"桂"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413400401,
					"content": "お疲れ様でした。無事届けてくれましたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400402,
						413400403
					],
					"speakerTitle": "桂"
				},
				{
					"id": 413400402,
					"content": "あの人たちまた病気になる気が…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400404
					]
				},
				{
					"id": 413400404,
					"content": "それも仕方ありません。日頃の生活習慣に注意しなければ、胃腸病もどんどん治りにくくなっていきます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400405
					],
					"speakerTitle": "桂"
				},
				{
					"id": 413400405,
					"content": "しかし、私もこれでしばらく一息つけそうです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400406
					],
					"speakerTitle": "桂"
				},
				{
					"id": 413400406,
					"content": "霄灯について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400407
					]
				},
				{
					"id": 413400407,
					"content": "霄灯を？私たちは…飛ばしません。霄灯は願い事をするためのものです。では、「不卜廬」は何を願えばいいのでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400408
					],
					"speakerTitle": "桂"
				},
				{
					"id": 413400408,
					"content": "商人なら商売が上手くいくことを希望すると思いますが、病を治す薬舗がそんなことを願ってはいけません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400409,
						413400410
					],
					"speakerTitle": "桂"
				},
				{
					"id": 413400409,
					"content": "桂さんはやさしい人だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400411
					]
				},
				{
					"id": 413400411,
					"content": "しかし個人的には、霄灯を飛ばしたい気持ちはあります。せっかくの祭りですので…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400412
					],
					"speakerTitle": "桂"
				},
				{
					"id": 413400412,
					"content": "霄灯作りを試みたのですが、他の事で忙しくて、全く終わっていません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400413
					],
					"speakerTitle": "桂"
				},
				{
					"id": 413400413,
					"content": "今みたいに休憩時に少しずつ作るしかないのです…霄灯が出来た頃には、海灯祭も終わっていることでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400414
					],
					"speakerTitle": "桂"
				},
				{
					"id": 413400414,
					"content": "手伝うよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400415
					]
				},
				{
					"id": 413400415,
					"content": "ほ、本当ですか？そんな、感謝してもしきれません！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "桂"
				},
				{
					"id": 413400410,
					"content": "桂さんは誠実な人だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400411
					]
				},
				{
					"id": 413400403,
					"content": "一時的な効果しかないと思う…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400404
					]
				}
			]
		},
