			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"観海"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413400301,
					"content": "うぅ…あぁ…苦しい…な、何か用か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400302
					],
					"speakerTitle": "観海"
				},
				{
					"id": 413400302,
					"content": "桂の薬について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400303
					]
				},
				{
					"id": 413400303,
					"content": "おお！ありがとう！いい時に来た…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400304
					],
					"speakerTitle": "観海"
				},
				{
					"id": 413400304,
					"content": "いや、薬があれば安心だ。多分昨日の夜風のせいで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400305
					],
					"speakerTitle": "観海"
				},
				{
					"id": 413400305,
					"content": "消化不良じゃないの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400306
					]
				},
				{
					"id": 413400306,
					"content": "消化不良？胃腸は至って丈夫だよ。焼き魚を3つも食べられるくらいにな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400307
					],
					"speakerTitle": "観海"
				},
				{
					"id": 413400307,
					"content": "今でも、飯や酒に関しては、周りで俺の右に出る者はいないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400308
					],
					"speakerTitle": "観海"
				},
				{
					"id": 413400308,
					"content": "それよりも、薬を飲まなくては。まだ次の酒飲み会がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400309,
						413400310
					],
					"speakerTitle": "観海"
				},
				{
					"id": 413400309,
					"content": "お体に気をつけて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400311
					]
				},
				{
					"id": 413400311,
					"content": "はははっ、大丈夫さ。じいさんじゃあるまいし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400312
					],
					"speakerTitle": "観海"
				},
				{
					"id": 413400312,
					"content": "でも忠告ありがとう、気をつけるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "観海"
				},
				{
					"id": 413400310,
					"content": "体を壊してからじゃ遅い。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400311
					]
				}
			]
		},
		{
