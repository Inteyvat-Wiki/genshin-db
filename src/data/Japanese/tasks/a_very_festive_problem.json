			"dialogs": [
				{
					"id": 413400601,
					"content": "この霄灯は立派に出来ていますね。私のとは比べ物にならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400602
					],
					"speakerTitle": "桂"
				},
				{
					"id": 413400602,
					"content": "では夜になったら、この霄灯を飛ばしましょう。いい場所を知っています。",
