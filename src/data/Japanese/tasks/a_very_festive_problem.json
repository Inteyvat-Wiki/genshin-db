			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"志華"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413400201,
					"content": "何か悪いものでも食べたのかなぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400202
					],
					"speakerTitle": "志華"
				},
				{
					"id": 413400202,
					"content": "桂の薬について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400203
					]
				},
				{
					"id": 413400203,
					"content": "おっ！ありがとう、桂さんに頼んでた薬だよね？今消化不良で…お腹が痛くて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400204
					],
					"speakerTitle": "志華"
				},
				{
					"id": 413400204,
					"content": "祭りで賑わう街中をぶらぶらしてただけなんだけど、つい食べ過ぎちゃって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400205
					],
					"speakerTitle": "志華"
				},
				{
					"id": 413400205,
					"content": "なに食べたの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400206
					]
				},
				{
					"id": 413400206,
					"content": "えっと…チャーハン、魚、果物、エビ、あと美味しいお酒！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400207,
						413400208
					],
					"speakerTitle": "志華"
				},
				{
					"id": 413400207,
					"content": "道理で…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400209
					]
				},
				{
					"id": 413400209,
					"content": "だから薬をもらったんだ。それに、祭りなのに食べたい物が食べられないなんて、祭りの意味がないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400210
					],
					"speakerTitle": "志華"
				},
				{
					"id": 413400210,
					"content": "とにかく、薬ありがとう。少し休むことにするよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志華"
				},
				{
					"id": 413400208,
					"content": "祭りだからって食べ過ぎはよくない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400209
					]
				}
			]
		},
		{
			"id": 4134003,
			"completionStepIds": [
				4134004
			],
