					{
						"sceneId": 3,
						"position": [
							2454.721,
							343.059,
							2402.242
						],
						"pointId": 7560
					}
				]
			},
			"dialogs": [
				{
					"id": 715320101,
					"content": "ご両人、この講談師の弟子、巻舒のために歩みを止めてはくださいませんか——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320102
					],
					"speakerTitle": "巻舒"
				},
				{
					"id": 715320102,
					"content": "こういった噂をお聞きになったことはありませんか？「海灯祭の美しい夜に、炎の光が夜空に絵を描き、壮麗な絵巻を浮かび上がらせる…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320103
					],
					"speakerTitle": "巻舒"
				},
				{
					"id": 715320103,
					"content": "よ、よく分からないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715320104,
					"content": "炎の光？夜空に絵を描く？普通のヤツには絶対できないだろ…飛行艇とかに乗ったとしても、空に浮かぶ不思議な絵の具なんてないしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715320105,
					"content": "それって、大げさなたとえ話なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320106,
						715320107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715320106,
					"content": "普通の絵とは違う？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715320108
					]
				},
				{
					"id": 715320108,
					"content": "#その噂の主人公はあなた方お二人、高名な旅人{NICKNAME}さんとその相棒パイモンさんなのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320109
					],
					"speakerTitle": "巻舒"
				},
				{
					"id": 715320109,
					"content": "ん？なんで急にオイラたちの話になるんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715320110,
					"content": "お忘れかもしれませんが、去年、冒険者テンテンの依頼をお受けし、特別な競争に挑戦なさいましたよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320111
					],
					"speakerTitle": "巻舒"
				},
				{
					"id": 715320111,
					"content": "美しい花火がその競争を彩る様は、それはもう壮大な絶景でした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320112
					],
					"speakerTitle": "巻舒"
				},
				{
					"id": 715320112,
					"content": "そういや、確かにそんなことあったな。あの時はちょちょいのちょいで、冒険者協会の宣伝員を助けただけだったけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715320113,
					"content": "あいつはあのイベントで新しいメンバーを呼び込みたいって言ってたな。結局それがうまくいったのかは知らないけどさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320114,
						715320115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715320114,
					"content": "そんなことがあったような気も…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715320116
					]
				},
				{
					"id": 715320116,
					"content": "あの時、私は望舒旅館の近くでやけ酒をあおりながら、花火に照らされたお二人の姿を見上げていました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320117
					],
					"speakerTitle": "巻舒"
				},
				{
					"id": 715320117,
					"content": "その瞬間、試験に落第した悲しみや将来への不安が、お二人の生き生きした輝きのお陰で、すうっと消えていくのを感じました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320118
					],
					"speakerTitle": "巻舒"
				},
				{
					"id": 715320118,
					"content": "元気を取り戻した私は、民俗学の研究を続けるため、沈玉の谷にやって来て、心より愛する題材に取り組むことができたのです…これもお二人の激励のお陰です！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320119
					],
					"speakerTitle": "巻舒"
				},
				{
					"id": 715320119,
					"content": "私以外にも、お二人の姿に惹かれて冒険者協会に入った方が数多くおられます。彼らも新しい人生を見つけたのです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320120
					],
					"speakerTitle": "巻舒"
				},
				{
					"id": 715320120,
					"content": "ええっ！？そんなことになってたのかよ！あの時、遠くで見てる人がいるなんて気づかなかったぞ。それにさ、競争に挑戦しただけなのに、誰かを元気づけてるなんて思いもしなかったな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715320121,
					"content": "おまえの話があんまりに大げさだから、ちょっと恥ずかしくなってきたぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320122,
						715320123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715320122,
					"content": "元気が出たのならよかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715320124
					]
				},
				{
					"id": 715320124,
					"content": "本日はお目にかかれて、本当に光栄です。お二人に心から感謝するとともに、ひとつお願いが——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320125
					],
					"speakerTitle": "巻舒"
				},
				{
					"id": 715320125,
					"content": "どうか、これからも輝きを届け、もっと多くの人々を勇気づけてください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320126
					],
					"speakerTitle": "巻舒"
				},
				{
					"id": 715320126,
					"content": "オイラたちはおまえが言うほど偉大じゃないけど、おまえの考え方は好きだな。みんなを勇気づけられたら、オイラたちもめちゃめちゃ嬉しいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715320127,
					"content": "それで、オイラたちはなにすればいいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715320128,
					"content": "慣例通り、テンテンが計画した競争を参考にし、お二人に勇気をいただいた冒険者たちと協力して、「雲上の煌行」という全く新しい企画を考えました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320129
					],
					"speakerTitle": "巻舒"
				},
				{
					"id": 715320129,
					"content": "この沈玉の谷は不思議なものだらけ。その中の一つに不思議な鯉がいます。鯉の力を借りれば、人は猛スピードで走ることができます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320130
					],
					"speakerTitle": "巻舒"
				},
				{
					"id": 715320130,
					"content": "お二人はいつも通り、山間や空中を思いっきり飛び回り、元気なお姿や活力をたくさんの人に見せてくださればそれでよいのです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320131,
						715320132
					],
					"speakerTitle": "巻舒"
				},
				{
					"id": 715320131,
					"content": "お安いご用！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715320133
					]
				},
				{
					"id": 715320133,
					"content": "もちろんモラの他にも様々な謝礼をご用意し、心からの感謝をお伝えするつもりです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320134
					],
					"speakerTitle": "巻舒"
				},
				{
					"id": 715320134,
					"content": "お二人が希望を与え、皆を勇気づけてくださったことに対する謝礼としては十分と言えないかもしれませんが、これが全てではありません。今後も折を見て、お二人に恩返しするつもりです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320135
					],
					"speakerTitle": "巻舒"
				},
				{
					"id": 715320135,
					"content": "#へへっ、礼儀にこだわりすぎだぞ！謝礼が少なくても、オイラと{NICKNAME}はずっと旅を続けて、迷ってる人たちをできるだけ助けるつもりだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320136
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715320136,
					"content": "巻舒の話を聞いてたら、なんか冒険するのに一層やる気がみなぎってきたぞ！あいつの言ってた「雲上の煌行」ってのをやってみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715320132,
					"content": "喜んで！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715320133
					]
				},
				{
					"id": 715320123,
					"content": "元気が出たのは嬉しい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715320124
					]
				},
				{
					"id": 715320115,
					"content": "それがどうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715320116
					]
				},
				{
					"id": 715320107,
					"content": "それってまさか花火のこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715320108
					]
				}
			]
		}
	]
}