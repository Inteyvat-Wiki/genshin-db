			"trigger": {
				"objectNames": [
					"フローラ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200690101,
					"content": "お花の元気がなくなってきた、もったいない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690102
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200690102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690103
					]
				},
				{
					"id": 200690103,
					"content": "よくお客さんがプレゼント用に切り花を買いに来るの。だから毎日切り花を用意してるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690104
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200690104,
					"content": "でも切られた花は長く保存できないから、当日に売り切らないとたくさん枯れちゃうの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690105
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200690105,
					"content": "色々な方法を試したけど、それでも一日経つとお花のほとんどが売り物にならなくなるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690106
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200690106,
					"content": "どうやったら花の状態を長く保てられるんだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690107,
						200690111
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200690107,
					"content": "食材保存の方法を使えば…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690108
					]
				},
				{
					"id": 200690108,
					"content": "「鹿狩り」のサラさんが残った食材を日の当たらない涼しい場所に置いて、氷で冷やして保存するって言ってた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690109
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200690109,
					"content": "フローラもそれを試してみたよ。でも氷で冷やすとお花の色と形が変になっちゃうの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690110
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200690110,
					"content": "確かに枯れてはいないけど…きれいなお花ではなくなっちゃう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690114
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200690114,
					"content": "色んな人に相談してたらサイードさんが…その人知ってる？あの学者さんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690115
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200690115,
					"content": "ある日サイードさんが花を買いに来た時、前に「生花の冷蔵保存」の方法を本で読んだことがあるって教えてくれたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690116
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200690116,
					"content": "確か…お花を容器に入れて、その容器を氷の近くに置くんだって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690117
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200690117,
					"content": "あと、試すのなら雪山のような温度の低い場所が適しているとも言っていたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690118
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200690118,
					"content": "でも雪山は危険だって聞くし、手伝ってくれる冒険者もすぐには見つからない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690119
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200690119,
					"content": "旅人さん、このお花が入った3つの箱を雪山の雪に埋めてきてくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690120,
						200690121
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200690120,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690122
					]
				},
				{
					"id": 200690122,
					"content": "ありがとう。そうね…雪山は広いから色んな区域に分かれてるらしいよ。場所によって保存効果も違うかもしれない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690123
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200690123,
					"content": "うーん、比較できるのが一番だけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690124
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200690124,
					"content": "じゃあこのお花をそれぞれ雪山の<color=#00E1FFFF>七天神像のそば</color>、<color=#00E1FFFF>山中の水辺</color>、それと…<color=#00E1FFFF>洞窟の入口</color>に置いてきてくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200690121,
					"content": "どこに埋める？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690122
					]
				},
				{
					"id": 200690111,
					"content": "一日で全部売ればいい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690112
					]
				},
				{
					"id": 200690112,
					"content": "もちろんそれが一番だよ。でも毎日数本は売れ残るの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690113
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200690113,
					"content": "たったの数本でも、そのまま枯れるのを見過ごすわけにはいかないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690114
					],
					"speakerTitle": "フローラ"
				}
			]
		},
