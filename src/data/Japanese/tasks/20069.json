					"content": "そして<color=#00E1FFFF>雪山で水のある場所を探して</color>…湖でも池でも大丈夫だよ。見つけたら花を水辺に置いてほしいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690326
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200690326,
					"content": "お花を傷付けないように気を付けて運んでね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200690321,
					"content": "どこに埋める？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690322
					]
				},
				{
					"id": 200690311,
					"content": "一日で全部売ればいい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690312
					]
				},
				{
					"id": 200690312,
					"content": "もちろんそれが一番だよ。でも毎日数本は売れ残るの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690313
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200690313,
					"content": "たったの数本でも、そのまま枯れるのを見過ごすわけにはいかないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690314
					],
					"speakerTitle": "フローラ"
				}
			]
		},
