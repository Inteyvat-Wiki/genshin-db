			"dialogs": [
				{
					"id": 200690201,
					"content": "お花はどうなった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690202
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200690202,
					"content": "埋めたよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690203
					]
				},
				{
					"id": 200690203,
					"content": "ありがとう、しばらく雪山に置いたままにしてみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690204
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200690204,
					"content": "ふふ、手伝ってくれてありがとう。これを受け取って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690205
					],
					"speakerTitle": "フローラ"
				}
			]
		},
