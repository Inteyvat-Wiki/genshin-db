			"dialogs": [
				{
					"id": 706890514,
					"content": "<color=#FFCC33FF>何か変わったことない？</color>",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706890501
					]
				},
				{
					"id": 706890501,
					"content": "旅人さん、いいところに来てくださいました。少しお時間をいただけますか？お渡ししたいものがあるんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706890502,
						706890503
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 706890502,
					"content": "救援要請？お宝の手がかり？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706890504
					]
				},
				{
					"id": 706890504,
					"content": "…冒険者協会の業務についてよくご存じですね。ですが残念ながら、この件はそういった依頼とは関係ありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706890505
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 706890505,
					"content": "協会で作った新型のノートをお受け取りください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706890506,
						706890507
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 706890506,
					"content": "冒険手帳があるのに？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706890508
					]
				},
				{
					"id": 706890508,
					"content": "冒険手帳の主な機能は、依頼の完了状況や、魔物に関する情報を記録することです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706890509
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 706890509,
					"content": "一方でこのノートの役割は、冒険者の皆さんが旅の途中で出会った不思議な人々や出来事を記録するためです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706890510,
						706890511
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 706890510,
					"content": "そうなんだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706890512
					]
				},
				{
					"id": 706890512,
					"content": "お役に立てば何よりです。それでは、本件はこれにて完了です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706890513
					],
					"speakerTitle": "キャサリン"
				},
				{
