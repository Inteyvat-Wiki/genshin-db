			},
			"dialogs": [
				{
					"id": 706890114,
					"content": "<color=#FFCC33FF>何か変わったことない？</color>",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706890101
					]
				},
				{
					"id": 706890101,
					"content": "旅人さん、いいところに来てくださいました。少しお時間をいただけますか？お渡ししたいものがあるんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706890102,
						706890103
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 706890102,
					"content": "救援要請？お宝の手がかり？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706890104
					]
				},
				{
					"id": 706890104,
					"content": "…冒険者協会の業務についてよくご存じですね。ですが残念ながら、この件はそういった依頼とは関係ありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706890105
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 706890105,
					"content": "協会で作った新型のノートをお受け取りください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706890106,
						706890107
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 706890106,
					"content": "冒険手帳があるのに？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706890108
					]
				},
				{
					"id": 706890108,
					"content": "冒険手帳の主な機能は、依頼の完了状況や、魔物に関する情報を記録することです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706890109
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 706890109,
					"content": "一方でこのノートの役割は、冒険者の皆さんが旅の途中で出会った不思議な人々や出来事を記録するためです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706890110,
						706890111
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 706890110,
					"content": "そうなんだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706890112
					]
				},
				{
					"id": 706890112,
					"content": "お役に立てば何よりです。それでは、本件はこれにて完了です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706890113
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 706890113,
					"content": "引き続き、自由な冒険をお楽しみください。星と深淵を目指せ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 706890111,
					"content": "確かに役に立ちそう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706890112
					]
				},
				{
					"id": 706890107,
					"content": "またくれるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706890108
					]
				},
				{
					"id": 706890103,
					"content": "護送依頼？人探し？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706890104
					]
				}
			]
		},
