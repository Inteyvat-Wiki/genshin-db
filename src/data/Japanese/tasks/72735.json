				"points": []
			},
			"dialogs": [
				{
					"id": 727350101,
					"content": "お前らの親分はどいつだ？前に出てこい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350102
					],
					"speakerTitle": "「千日喧嘩大飛車」"
				},
				{
					"id": 727350102,
					"content": "この俺、「千日喧嘩大飛車」は精鋭中の精鋭だ。「花角玉将」様に代わって、お前ら荒瀧派の親分の首を頂戴しに来た！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350103
					],
					"speakerTitle": "「千日喧嘩大飛車」"
				},
				{
					"id": 727350103,
					"content": "うわっ、こいつ好戦的だな！しかも、なんだか怖いこと言ってるし！今回は本当に強いやつが来たみたいだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 727350104,
					"content": "ハッ、礼儀のなってないやつだな！しかも、お前の称号にも「大」が入ってるとは。俺様と張り合うつもりか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350105
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727350105,
					"content": "よし、この俺様が直々に相手してやる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350106
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727350106,
					"content": "せ、背が高い。しかも…鬼族だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350107
					],
					"speakerTitle": "「千日喧嘩大飛車」"
				},
				{
					"id": 727350107,
					"content": "こんなこわもてのやつが、虫相撲みたいな子供の遊びをするなんて…おかしいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350108
					],
					"speakerTitle": "「千日喧嘩大飛車」"
				},
				{
					"id": 727350108,
					"content": "なんだと？まさか虫相撲を見くびってんのか？いい度胸じゃねぇか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350109
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727350109,
					"content": "虫相撲の「粋」ってもんが分からねぇやつは、虫相撲をこよなく愛する俺様が改心させてやらねぇとな！さあ来い、懲らしめてやる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350110,
						727350111
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727350110,
					"content": "そうだ！懲らしめてやろう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727350112
					]
				},
				{
					"id": 727350112,
					"content": "そうだそうだ。このままじゃ済まさないぞ！任せたからな、牛使い野郎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 727350113,
					"content": "仕方ない…こ、来い！ビビるもんか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「千日喧嘩大飛車」"
				},
				{
					"id": 727350111,
					"content": "そうだ！改心させてやろう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727350112
					]
				}
			]
		}
	]
