			"dialogs": [
				{
					"id": 401730501,
					"content": "ん？ナニ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730502
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401730502,
					"content": "これから儀式で使った剣を族長に返しに行くの。他のモノは一旦ここに置いていくけど、もし興味があるなら好きに使ってちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730503
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401730503,
					"content": "『蜃気楼戦記』の最新刊があるんだけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401730504
					]
				},
				{
					"id": 401730504,
					"content": "えっ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730505
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401730505,
					"content": "『オルツィ嬢事件簿』の番外編も…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401730506
					]
				},
				{
					"id": 401730506,
					"content": "えぇええッ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730507
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401730507,
					"content": "一緒に読まない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401730508
					]
				},
				{
					"id": 401730508,
					"content": "えーっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730509
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401730509,
					"content": "（ええ？どういうコト？どうしてワタシがそれを好きなのを知ってるの？まさか、ワタシのコト、ずっと見てたとか！？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730510
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401730510,
					"content": "（ううん、そんなのありえない…きっとオロルンがバラしたのね。あのコったら…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730511
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401730511,
					"content": "（ワ…ワタシの好みを覚えててくれたの？えっ、ホントに？別にわざわざ覚えるようなコトじゃないし、重要なコトでもないけど…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730512
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401730512,
					"content": "（で…でも、コレって誘ってくれてるのよね？え、どうしよう、どうしよう？どう返事したらいいの？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730513
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401730513,
					"content": "コ、コホン…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730514
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401730514,
					"content": "分かった。用事の後に時間があったらね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シトラリ"
				}
			]
		}
	]
