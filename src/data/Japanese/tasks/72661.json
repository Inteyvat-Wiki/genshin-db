				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ナンタック",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726610101,
					"content": "若い釣り人、会えてうれしいよ。どうしたんだ、何か手助けが必要か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610102
					],
					"speakerTitle": "ナンタック"
				},
				{
					"id": 726610102,
					"content": "さあさあ、遠慮せず。私が君の釣り講師となろう、なんでも言うといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610103
					],
					"speakerTitle": "ナンタック"
				},
				{
					"id": 726610103,
					"content": "まさか「海中月」のことだったとは。鯨井はまだそのことに執着しているのか。無理もない、彼女の願いは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610104
					],
					"speakerTitle": "ナンタック"
				},
				{
					"id": 726610104,
					"content": "はぁ、もし彼女が「海中月」の真相を知ったら、きっと失望するだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610105
					],
					"speakerTitle": "ナンタック"
				},
				{
					"id": 726610105,
					"content": "真相って？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610106
					]
				},
				{
					"id": 726610106,
					"content": "実は当時帰ってから、私は「海中月」についての調査をずっと行っていた。そして古い書籍から手がかりを見つけたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610107
					],
					"speakerTitle": "ナンタック"
				},
				{
					"id": 726610107,
					"content": "その手がかりをもとに、現地へ行って調査した。そうしたら、驚きの事実が発見したのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610108
					],
					"speakerTitle": "ナンタック"
				},
				{
					"id": 726610108,
					"content": "それらをすべて私の作品に書き込んだ。最近はけっこう売れてるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610109
					],
					"speakerTitle": "ナンタック"
				},
				{
					"id": 726610109,
					"content": "ふむ、ちょうど編集が残していった見本がある。君たちに見せてあげよう。「海中月」に関するすべての真相が書かれてあるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610110
					],
					"speakerTitle": "ナンタック"
				},
				{
					"id": 726610110,
					"content": "どれどれ、オイラもみたいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726610111,
					"content": "『「海中月」の真相が大ウミガメだった件について』…長い書名だな…ってえっ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726610112,
					"content": "大ウミガメ？「海中月」は大ウミガメだったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726610113,
					"content": "そうだ、「海中月」は大ウミガメなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610114
					],
					"speakerTitle": "ナンタック"
				},
				{
					"id": 726610114,
					"content": "あの日の夜、私たちが見たのは、背中にイグサのような光る植物が生えた大ウミガメだったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610115
					],
					"speakerTitle": "ナンタック"
				},
				{
					"id": 726610115,
					"content": "あれは妊娠した母親で、岸に上がって産卵しようとしていたから、我々もちょうど帰る道を探し出せた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610116
					],
					"speakerTitle": "ナンタック"
				},
				{
					"id": 726610116,
					"content": "だから、帰ったら私の話を鯨井に伝えてほしい。何はともあれ、人は現実に向き合わなければならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610117
					],
					"speakerTitle": "ナンタック"
				},
				{
					"id": 726610117,
					"content": "確かに説明がつくけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610118
					]
				},
				{
					"id": 726610118,
					"content": "その表情、やはり信じられないか？だが私の研究には証拠がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610119
					],
					"speakerTitle": "ナンタック"
				},
				{
					"id": 726610119,
					"content": "古い書籍によれば、「海中月」は一種の古代生物だ。遥か昔、ほとんどの生物がまだ陸の上で生活をしていた頃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610120
					],
					"speakerTitle": "ナンタック"
				},
				{
					"id": 726610120,
					"content": "それらの祖先は、今でいうドラゴンスパインに生息していた。現在でも、化石が見られるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610121
					],
					"speakerTitle": "ナンタック"
				},
				{
					"id": 726610121,
					"content": "以前、<color=#00E1FFFF>龍眠の谷西側</color>の採掘地でいくつか見つけた。もし信じられないなら、探しに行ってくるといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ナンタック"
				}
			]
		},
