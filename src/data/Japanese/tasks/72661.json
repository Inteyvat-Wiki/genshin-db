					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726610501,
					"content": "なんだ、ほとんどが鉱滓だ。まるで、中のものを誰かに取られたみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726610502,
					"content": "あれ！？あいつは…宝盗団？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726610503,
					"content": "あいつらが鉱石の中のものを取ったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726610504,
					"content": "早く追いかけよう。きっと近くにあいつらの拠点があるはずだ。鉱石の中にあったものもきっとそこにある！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726610505,
					"content": "行こう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610506
					]
				},
				{
					"id": 726610506,
					"content": "こっそり、こっそりだぞ。見つかるなよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
