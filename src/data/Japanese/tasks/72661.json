			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鯨井椛",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726610601,
					"content": "やっと帰ってきたね。ん？嘉瑋は来ないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610602
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726610602,
					"content": "家庭を持ったから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610603
					]
				},
				{
					"id": 726610603,
					"content": "家庭を持った？はははっ！確かに彼らしいわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610604
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726610604,
					"content": "だって、それが彼の願いだったから…まあ、その理由なら許すわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610605
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726610605,
					"content": "それで、ナンタックは？見つかったの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610606
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726610606,
					"content": "売れている本を書いてた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610607
					]
				},
				{
					"id": 726610607,
					"content": "えっ？本当に作家になってたの？やるわね、本の内容は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610608
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726610608,
					"content": "オイラ知ってるぞ！書名は『「海中月」の真相が大ウミガメだった件について』だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610609
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726610609,
					"content": "ふーん、長い名前ね、娯楽小説かしら？悪くないわね…私も一冊…あれ？ちょっと待って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610610
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726610610,
					"content": "「海中月」の真相が…大ウミガメだった件について！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610611
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726610611,
					"content": "うん…実は大ウミガメだった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610612
					]
				},
				{
					"id": 726610612,
					"content": "何言ってるの？大ウミガメなわけないでしょ？彼はあの時一緒に見た「海中月」を忘れたっていうの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610613
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726610613,
					"content": "オイラたちも最初は信じてなかったんだけど…雪山に行って「海中月」の化石を探したんだ…この本と、化石…おまえにやるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610614
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726610614,
					"content": "し、信じないわ…こんなの嘘よ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610615
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726610615,
					"content": "私たち「鯨井」家は漁師一族なの、父も稲妻で有名な漁師だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610616
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726610616,
					"content": "父は何十年も費やして海で「海中月」を追ったの。しかも、あと一歩のところまでいったのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610617
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726610617,
					"content": "最後はやっぱりダメだったけど、父はあきらめなかった。もし伝説の「海中月」を捕まえられれば、漁師にとって大きな栄誉となる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610618
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726610618,
					"content": "でもその次に海を出たきり…父は戻ってこなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610619
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726610619,
					"content": "…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610620
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726610620,
					"content": "だから、私は信じない。お願いだから私の手伝いをして！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610621
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726610621,
					"content": "じゃあどうするつもり？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610622
					]
				},
				{
					"id": 726610622,
					"content": "今帰って父の残した物を探してくる。父は「海中月」を追う途中、数々の資料を残したの。その中からきっと何か方法が見つけられるはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610623
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726610623,
					"content": "君にも釣りの訓練を用意したから、その時はお願いね。良い知らせを待ってて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鯨井椛"
				}
			]
		},
