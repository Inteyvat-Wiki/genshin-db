			"dialogs": [
				{
					"id": 726610701,
					"content": "おいお前ら、このボロい石、価値があると思うか？こんな鉱石の中にあるなんて、珍しいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610702
					],
					"speakerTitle": "老黒七"
				},
				{
					"id": 726610702,
					"content": "おいおい冗談だろ、これはボロい石なんかじゃねぇ、学校で学ばなかったのか？これは化石だよ、化石。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610703
					],
					"speakerTitle": "林逃山"
				},
				{
					"id": 726610703,
					"content": "とんでもなく価値のあるものだ。これ一つで璃月港の半分は買える！お前は帰って勉強でもするんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610704
					],
					"speakerTitle": "林逃山"
				},
				{
					"id": 726610704,
					"content": "本当か？そんなに価値があるのか？じゃあこの拠点にあるやつ全部足したら、俺たち億万猛者に！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610705
					],
					"speakerTitle": "巴子"
				},
				{
					"id": 726610705,
					"content": "「億万長者」だ！お前も帰って勉強しろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610706
					],
					"speakerTitle": "林逃山"
				},
				{
					"id": 726610706,
					"content": "おい！そこのやつ、化石を返せ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610707
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726610707,
					"content": "あ？誰だ！？クソッ…見つかったか…野郎ども、かかれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "林逃山"
				}
			]
		}
