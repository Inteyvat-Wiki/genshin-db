			"dialogs": [
				{
					"id": 210280401,
					"content": "#ありがとう、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280402
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210280402,
					"content": "うん、これだけあれば、薬が十分作れます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280403
					],
					"speakerTitle": "桂"
				},
				{
					"id": 210280403,
					"content": "暑気あたりの薬は、次のときにまとめて配達しますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280404
					],
					"speakerTitle": "桂"
				},
				{
					"id": 210280404,
					"content": "じゃあお願いするね、桂お兄ちゃん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280405
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210280405,
					"content": "#これをあげるよ。助けてくれてありがとう、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}。帰ろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280406
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210280406,
					"content": "へへ、父が知ったらきっと喜ぶよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280407
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210280407,
					"content": "モンちゃん、少し待ってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280408
					],
					"speakerTitle": "桂"
				},
				{
					"id": 210280408,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280409
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210280409,
					"content": "薬のチェックをすると言ったでしょう？残りのリストがまだ終わっていませんよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280410
					],
					"speakerTitle": "桂"
				},
				{
					"id": 210280410,
					"content": "え…え？あんなにチェックしたのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280411
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210280411,
					"content": "まだほんの少しですよ。さあ、モンちゃん、引き続き確認してください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280412
					],
					"speakerTitle": "桂"
				},
				{
					"id": 210280412,
					"content": "うぅ…わ、分かった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "モン"
				}
			]
		},
