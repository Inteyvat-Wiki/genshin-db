			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"桂",
					"モン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210280201,
					"content": "こんにちは、薬の受け取りですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280202
					],
					"speakerTitle": "桂"
				},
				{
					"id": 210280202,
					"content": "あれ？モンちゃんではありませんか。どうしてここに？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280203
					],
					"speakerTitle": "桂"
				},
				{
					"id": 210280203,
					"content": "あ…分かりました、薬のことを聞きに来たんですね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280204
					],
					"speakerTitle": "桂"
				},
				{
					"id": 210280204,
					"content": "安心してください。薬はほとんど準備できましたよ。数回に分けて、お父さんのところに送り届けますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280205
					],
					"speakerTitle": "桂"
				},
				{
					"id": 210280205,
					"content": "でもモンちゃんのお父さんの注文が多すぎて、薬がすぐなくなってしまうんです。だから、一部の薬は遅くなってしまうかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280206
					],
					"speakerTitle": "桂"
				},
				{
					"id": 210280206,
					"content": "えっと、そうですね…ミントがあまり残っていませんので、暑気あたりの薬を作れません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280207
					],
					"speakerTitle": "桂"
				},
				{
					"id": 210280207,
					"content": "お父さんの注文だけでなく、他のお客さんの病気も診ないといけませんからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280208
					],
					"speakerTitle": "桂"
				},
				{
					"id": 210280208,
					"content": "それじゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280209,
						210280211
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210280209,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}の出番だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280210
					]
				},
				{
					"id": 210280210,
					"content": "#へへ、ありがとう、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280213
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210280213,
					"content": "それじゃあ、薬のことはお願いね。ボクはここに残って薬のチェックをするから。父にしつこく言われてるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280214
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210280214,
					"content": "真面目な子ですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280215
					],
					"speakerTitle": "桂"
				},
				{
					"id": 210280215,
					"content": "それなら私について来てください。薬のリストを見せますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280216
					],
					"speakerTitle": "桂"
				},
				{
					"id": 210280216,
					"content": "うわぁ…こんなにあるの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280217
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210280217,
					"content": "まずはこちらから確認しておいてください。私は残りの薬を持ってきますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280218
					],
					"speakerTitle": "桂"
				},
				{
					"id": 210280218,
					"content": "え？まだあるの！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "モン"
				},
				{
					"id": 210280211,
					"content": "報酬はちゃんと取るけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280212
					]
				},
				{
					"id": 210280212,
					"content": "#へへ、大丈夫だよ！{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}、ありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280213
					],
					"speakerTitle": "モン"
				}
			]
		},
