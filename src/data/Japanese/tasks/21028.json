			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"モン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210280101,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}！ちょうどいいところに。聞きたいことがあるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280102,
						210280103
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210280102,
					"content": "何？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280105
					]
				},
				{
					"id": 210280105,
					"content": "父は、スメールまでの旅は長くなるから、薬を準備しないとって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280106
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210280106,
					"content": "頭痛と腹痛の薬、暑気あたりに効く薬…それに二日酔いの薬でしょ、それから消化を助ける薬…いっぱいあるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280107
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210280107,
					"content": "二日酔いの薬まで準備するのかよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 210280108,
					"content": "きっと商談をするときのため。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280109
					]
				},
				{
					"id": 210280109,
					"content": "え？商談と、二日酔いの薬にいったいなんの関係があるんだ？お酒をたくさん飲めば、商売がうまくいくのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 210280110,
					"content": "とにかく、これから「不卜廬」に行って、薬の準備ができたか聞くように頼まれたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280111
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210280111,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}、一緒に行ってくれない？手伝って欲しいことがあるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280112,
						210280113
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210280112,
					"content": "行こう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280115
					]
				},
				{
					"id": 210280115,
					"content": "#行こう、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "モン"
				},
				{
					"id": 210280113,
					"content": "頼みたいことって？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280114
					]
				},
				{
					"id": 210280114,
					"content": "着いてから話すよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280115
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210280103,
					"content": "旅の準備はどう？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280104
					]
				},
				{
					"id": 210280104,
					"content": "ほとんど父とあのおじさんたちが準備してるよ…でも父もボクにいくつか仕事をくれたの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280105
					],
					"speakerTitle": "モン"
				}
			]
		},
		{
			"id": 2102802,
			"completionStepIds": [
				2102803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
