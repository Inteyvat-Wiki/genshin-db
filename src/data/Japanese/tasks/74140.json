						],
						"pointId": 6283
					}
				]
			},
			"dialogs": [
				{
					"id": 741401301,
					"content": "ああ。またここに来たのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401302
					],
					"speakerTitle": "カノティラ"
				},
				{
					"id": 741401302,
					"content": "どうしたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741401303,
					"content": "みんなやあなたたちはぼくに優しくしてくれるから、こんなこと言うのはわがままだって思うよ。でも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401304
					],
					"speakerTitle": "カノティラ"
				},
				{
					"id": 741401304,
					"content": "現実の世界はひどく退屈だと思わない？本の中の世界のほうが、もっと美しいよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401305,
						741401307,
						741401309
					],
					"speakerTitle": "カノティラ"
				},
				{
					"id": 741401305,
					"content": "そう思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401306
					]
				},
				{
					"id": 741401306,
					"content": "えっ？そんな風に思ってたのかよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741401311,
					"content": "ぼくはやっぱり、「啓示の書」の中の世界が美しいと思う。そこかしこに露に濡れた花びらがあって、それにやっとのことで子犬と友達になれたんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401312
					],
					"speakerTitle": "カノティラ"
				},
				{
					"id": 741401312,
					"content": "子犬か…そういえばカノティラ、おまえって犬の言葉がわかるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741401313,
					"content": "え？それは無理だよ。ただ「啓示の書」の中の子犬は特別なんだ。それともぼくが特別なのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401314
					],
					"speakerTitle": "カノティラ"
				},
				{
					"id": 741401314,
					"content": "瞑想の中で、ずっと本の世界に行って遊ぶことを考えていたら、ある日突然「ワンワン」という本来の鳴き声が言葉に変わっていたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401315
					],
					"speakerTitle": "カノティラ"
				},
				{
					"id": 741401315,
					"content": "そのとき何を言われたかというと…「行け、もうここには来るな」だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401316
					],
					"speakerTitle": "カノティラ"
				},
				{
					"id": 741401316,
					"content": "はぁ、ヒマワリが咲く景色を見たかったのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401317
					],
					"speakerTitle": "カノティラ"
				},
				{
					"id": 741401317,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401318
					]
				},
				{
					"id": 741401318,
					"content": "そ、そっか…カノティラ、体に気をつけろよ！オイラたちはもう行くな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741401307,
					"content": "そうは思わない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401308
					]
				},
				{
					"id": 741401308,
					"content": "そうか…きっとそれが正常で、ぼくが普通じゃないんだろうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401311
					],
					"speakerTitle": "カノティラ"
				},
				{
					"id": 741401309,
					"content": "別に違いなんてないと思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401310
					]
				},
				{
					"id": 741401310,
					"content": "#{NICKNAME}{M#お兄さん}{F#お姉さん}って、誰よりも強い人だからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401311
					],
					"speakerTitle": "カノティラ"
				}
			]
		}
	]
}