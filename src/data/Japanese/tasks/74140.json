			"dialogs": [
				{
					"id": 741401101,
					"content": "あっ、また会ったね。あれ、今回はパイモンも連れてきたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401102
					],
					"speakerTitle": "カノティラ"
				},
				{
					"id": 741401102,
					"content": "えっと、前に一緒に「瞑想」してここに来たときもオイラいたけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741401103,
					"content": "そうだっけ？ならぼくが忘れてしまったんだろうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401104
					],
					"speakerTitle": "カノティラ"
				},
				{
					"id": 741401104,
					"content": "何はともあれ、あなたのおかげで「謎鏡」の場所やもうすぐ花が咲きそうな場所を見つけることができた。この地に対する理解も深まったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401105
					],
					"speakerTitle": "カノティラ"
				},
				{
					"id": 741401105,
					"content": "うぅ…相変わらずカノティラの話し方って、難しいよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741401106,
					"content": "ワン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401107
					]
				},
				{
					"id": 741401107,
					"content": "うん？でも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401108
					],
					"speakerTitle": "カノティラ"
				},
				{
					"id": 741401108,
					"content": "ウ～、ワン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401109
					]
				},
				{
					"id": 741401109,
					"content": "はいはい、分かったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401110
					],
					"speakerTitle": "カノティラ"
				},
				{
					"id": 741401110,
					"content": "（んん…？子犬となに話してるんだ？まさか、メリュジーヌってみんな、犬の言葉が話せるのか？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741401111,
					"content": "（本当に不思議。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401112
					]
				},
				{
					"id": 741401112,
					"content": "仕方ない、じゃあまた今度。うーん、そんなこと言われても、また遊びにくるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401113
					],
					"speakerTitle": "カノティラ"
				},
				{
					"id": 741401113,
					"content": "#じゃあ行こうか、{NICKNAME}{M#お兄さん}{F#お姉さん}、パイモン。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カノティラ"
				}
			]
		},
		{
