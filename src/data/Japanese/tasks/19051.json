	"talks": [
		{
			"id": 1905101,
			"completionStepIds": [
				1905101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1905101",
							"2"
						],
						"stepId": 1905101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"銀杏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190510101,
					"content": "こんにちは、旅人さん。私は銀杏、南十字の船医をしています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510102
					],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510102,
					"content": "もし船員が船酔いや風邪を訴えたり、手足の切断が必要になったりした時、私が責任をもって治療しています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510103
					],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510103,
					"content": "船上での病気、怪我について学びたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510104
					]
				},
				{
					"id": 190510104,
					"content": "はい、北斗姉さんに言われたんですよね？私に任せてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510105
					],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510105,
					"content": "まず新人にとって、航海でもっとも危険なことは何だと思いますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510106,
						190510107,
						190510108
					],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510106,
					"content": "船酔い？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510109
					]
				},
				{
					"id": 190510109,
					"content": "確かにそれらも船上では厄介な問題ですが、もっとも危険なものではありません。新人にとって、もっとも危険なのは「危険に対する油断」です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510110
					],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510110,
					"content": "若く、自分には力があると思っている新人の船員は、その多くが怪我や病気の予防を蔑ろにしています。彼らは、陸の上で問題がなければ海の上でも問題がないと思っているのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510111
					],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510111,
					"content": "そういった方々は、最終的にひどい目を見ることになります。海を渡ること——特に遠洋航海は、とても過酷な仕事だということを忘れてはなりません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510112
					],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510112,
					"content": "物資不足による栄養の偏り、急激な温度変化や厳しい気候による病など、様々な問題に直面することでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510113
					],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510113,
					"content": "情報の遮断や娯楽不足による、心理的な問題も生じるかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510114
					],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510114,
					"content": "さらに重要なのは、海上では薬や治療法が豊富にあるわけではなく、些細な問題でも取り返しのつかない結果になる可能性があることです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510115
					],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510115,
					"content": "ということは、さっき言っていた手足の切断って…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510116
					]
				},
				{
					"id": 190510116,
					"content": "ふふっ、先ほどの話が冗談だと思っていたようですね。無理もありません、ほとんどの新人はそう思うでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510117
					],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510117,
					"content": "しかし、あなたにはこれを重要視して欲しいのです。防げたはずのことが、これまでにもたくさん起きたので…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510118
					],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510118,
					"content": "私からは以上です。新人でしたら、ひとまずこれらを知っておけば十分でしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510119
					],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510119,
					"content": "他に聞きたいことはありますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510120,
						190510129,
						190510137
					],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510120,
					"content": "北斗は、こういったことについてどう思ってるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510121
					]
				},
				{
					"id": 190510121,
					"content": "北斗姉さん…彼女は私が今まで会ってきた人の中で、仲間の命を一番大切に思う方だと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510122
					],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510122,
					"content": "私は一介の船医ですが、北斗姉さんのお達しにより、不調だと思った新人を船から降ろして休ませる権利を持っています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510123
					],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510123,
					"content": "航海前の物資調達においても、医薬品の優先順位は一番高いです。そして十分な予算を割り振られているため、必要なものを自由に購入できます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510124
					],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510124,
					"content": "船隊の会計を担当している銭目が、このことをどう言っていると思いますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510125
					],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510125,
					"content": "かなりの金銭的な負担だとのことです、ふふっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510126
					],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510126,
					"content": "それでも、不必要なケガや病気を避けるために、北斗姉さんは私に権限を与えてくれました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510127
					],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510127,
					"content": "北斗姉さんは、この問題を解決できる人物として私を信頼してくれています…もちろん、私もその信頼に応えているつもりです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510128
					],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510128,
					"content": "これが彼女の考えになります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510119
					],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510129,
					"content": "手足を切断した船員はその後どうなったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510130
					]
				},
				{
					"id": 190510130,
					"content": "ふむ…あなたは彼らのその後が気になるんですか？北斗姉さんがあなたを認めている理由は、実力だけではないようですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510131
					],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510131,
					"content": "銭目を説得して船隊の帳簿を見せてもらえば、「定期的な療養費と障害者のための補助金」という項目の固定費があることがわかるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510132
					],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510132,
					"content": "船隊の収入にかかわらず、この支出を変更することはありません。共に戦った仲間たちに毎年送っているものです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510133
					],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510133,
					"content": "陸に戻った彼らの中には、事業を立ち上げたり、旅に出たりする者もいます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510134
					],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510134,
					"content": "もし、体のケガを忘れることができたら、きっと私たちよりもずっと自由な生活を送れるでしょうね、ふふっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510135
					],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510135,
					"content": "残念なことではありますが、生涯付きまとう痛みを無視することは、誰にもできません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510136
					],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510136,
					"content": "唯一の救いは、北斗姉さんが指揮する南十字は、決して仲間を忘れないということです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510119
					],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510137,
					"content": "いろいろと勉強になった、ありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510138
					]
				},
				{
					"id": 190510138,
					"content": "はい、今日はここまでにしておきましょう。くれぐれも健康には気を付けてくださいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510107,
					"content": "風邪？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510109
					]
				},
				{
					"id": 190510108,
					"content": "手足の切断？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510109
					]
				}
			]
		},
		{
			"id": 1905102,
			"completionStepIds": [
				1905102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1905102",
							"2"
						],
						"stepId": 1905102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"絵星"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190510201,
					"content": "旅人、さっきはごめん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510202
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 190510202,
					"content": "あなたに加入してもらうおうと、つい躍起になって困らせてたことに気付かなかった。姉さんが気付かせてくれてよかったよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510203
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 190510203,
					"content": "気にしないで、海図について学ばせてほしい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510204
					]
				},
				{
					"id": 190510204,
					"content": "おっ！それなら、うちに聞いて大正解だよ。自分で言うのもあれだけど、璃月港でもっとも才ある航海士は、今あなたの目の前にいるうちだからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510205
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 190510205,
					"content": "じゃあ、まずは海図を識別するうえで大切な点を教えるね。質問があったら、いつでもしてちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510206
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 190510206,
					"content": "複雑な数値の記された海図を手にした時、まず何を見るべきか分かる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510207
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 190510207,
					"content": "海岸の形状、島の位置、水深、水路要素、危険物、それらを書かれている内容から確認するの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510208
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 190510208,
					"content": "これらの情報があれば、少なくとも安全な航路を導き出せるかどうかの判断ができるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510209
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 190510209,
					"content": "表現の面において、海図に用いられる描画は特殊で、陸地みたいにはっきりとした基準がないの。それに、ほとんどの海図には縮尺がついてないから、正確な距離を割り出すのも難しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510210
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 190510210,
					"content": "ただ最新の海図にのみ、距離を示す補助線の入った付属図があるんだ。その補助線は、さまざまな色で引かれてるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510211
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 190510211,
					"content": "ちなみに、うちのおかげで南十字はその最新のやつを使ってるんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510212
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 190510212,
					"content": "それと、一部の作図者は特殊な記号を使って標記することがあるの。付属図がなかったら、なかなか解読できないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510213
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 190510213,
					"content": "たとえば、前任の航海士が残した海図とか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510214
					]
				},
				{
					"id": 190510214,
					"content": "ははっ、それだけじゃないよ。破けた海図の仕入れ先は、いろいろあるからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510215
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 190510215,
					"content": "正直、うちにとっても挑戦なの。だって、どれも長い歴史を持っているからね。描かれた印とか…見たことのないものがたくさん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510216
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 190510216,
					"content": "でも難しければ難しいほど、やりがいを感じるんだ。もし解読できなかったら、海に関する多くの秘密を逃しちゃうもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510217
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 190510217,
					"content": "幸いなことに、うちらには北斗姉さんがいる。どこで手に入れたのか分からないけど、古代の記号学の本を手に入れてくれたから、それでうちも勉強できるようになったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510218
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 190510218,
					"content": "さすがは姉さんだよね、こんなめったに市場に出回らないものを手に入れるなんて。古い海図だけでなく、記号学の書籍まで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510219
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 190510219,
					"content": "おっと、ちょっと話が脱線しちゃったね。へへっ、海図の解読に関する基礎知識はこんなもんかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510220
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 190510220,
					"content": "他に聞きたいことはある？旅人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510221,
						190510236
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 190510221,
					"content": "海図の描き方について、心得はある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510222
					]
				},
				{
					"id": 190510222,
					"content": "海図の描き方？それってかなり上級者向けだよ。それに正直、あんまり得意じゃないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510223
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 190510223,
					"content": "今うちらが使っている海図も、前任の航海士が残したものを参考に修正したものだし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510224
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 190510224,
					"content": "ただ、海図は「最新の状態」を保つ必要がある。つまり、海の状況の変化に合わせて更新する必要があるの。それが、うちにとって数少ない海図制作の経験かな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510225
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 190510225,
					"content": "ただ、それについては北斗姉さんにも聞いたほうがいいと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510226
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 190510226,
					"content": "この前、船隊が未知の海域に迷い込んだの。危険を感じたから、あまり深入りせずにすぐ引き返したんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510227
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 190510227,
					"content": "船が通った区域を姉さんが簡単な海図にしてくれたの、将来の探検のためにって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510228
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 190510228,
					"content": "意外でしょ？うちも驚いたんだ。まさか姉さんが海図を描けるなんてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510229
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 190510229,
					"content": "#じゃあ、どうして{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYSECOND|INFO_FEMALE_PRONOUN_GIRLSECOND]}が航海士に選ばれたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510230
					]
				},
				{
					"id": 190510230,
					"content": "それは、うちに才能があるから育てようと思ったんだよ、きっと。へへっ、実はうちだけじゃなく、みんなに対しても同じなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510231
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 190510231,
					"content": "以前、うちもあなたと同じような疑問を持ってたんだ。だって、大半の船では、航海士の仕事を船長がやってるからさ。うちは姉さんの意図が知りたくて、直接聞きに行ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510232
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 190510232,
					"content": "そしたら、笑いながら怒られちゃった。「岩王帝君だって、一人で戦ってはいなかった」ってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510233
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 190510233,
					"content": "きっと、姉さんは船にいるみんなが一人前になって欲しいと考えてるんだよ。全員に南十字船隊を支えて欲しいんだ、きっと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510234
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 190510234,
					"content": "もし、いつか姉さんがいなくなっても、うちらは前に進み続けることができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510235
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 190510235,
					"content": "普段は大雑把で、勢い任せの姉さんだけど、みんなのことを真面目に考えてるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510220
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 190510236,
					"content": "他に質問はない、ありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510237
					]
				},
				{
					"id": 190510237,
					"content": "当然のことをしたまでだよ。姉さんの友達なら、うちの友達も同然だから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "絵星"
				}
			]
		},
		{
			"id": 1905103,
			"completionStepIds": [
				1905103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1905103",
							"2"
						],
						"stepId": 1905103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"徐六石"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190510301,
					"content": "やあ、旅人！気象観測について、この俺に聞きに来たのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510302
					],
					"speakerTitle": "徐六石"
				},
				{
					"id": 190510302,
					"content": "どうして分かったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510303
					]
				},
				{
					"id": 190510303,
					"content": "ははっ、俺みたいな仕事だと、目が良くないと食っていけないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510304
					],
					"speakerTitle": "徐六石"
				},
				{
					"id": 190510304,
					"content": "北斗の姉貴が新人用の訓練を案内してただろ。そして、お前さんは銀杏と絵星のところに行って話をしていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510305
					],
					"speakerTitle": "徐六石"
				},
				{
					"id": 190510305,
					"content": "それでわかったんだ。姉貴は恐らく、お前さんに船員の生活を紹介しているんじゃないかってな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510306,
						190510307
					],
					"speakerTitle": "徐六石"
				},
				{
					"id": 190510306,
					"content": "さすがだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510308
					]
				},
				{
					"id": 190510308,
					"content": "はははっ、ならさっそく、気象観測の大切な点を教えよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510309
					],
					"speakerTitle": "徐六石"
				},
				{
					"id": 190510309,
					"content": "海の気象とはもっぱら、海霧、高潮、海上竜巻などの現象を指す…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510310
					],
					"speakerTitle": "徐六石"
				},
				{
					"id": 190510310,
					"content": "それらのほとんどは安全な航海に影響を与えるものだ。しかし幸いなことに、どんな気象にも予兆はある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510311
					],
					"speakerTitle": "徐六石"
				},
				{
					"id": 190510311,
					"content": "たとえば海上竜巻。これは渦を巻くように風が高速回転する現象でな。大型船をいとも簡単に巻き上げ、多大な損害を与える非常に危険なものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510312
					],
					"speakerTitle": "徐六石"
				},
				{
					"id": 190510312,
					"content": "だが海上竜巻は、高温多湿で大きな黒雲のある環境下でのみ発生する。それさえ知っていれば対処が可能だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510313
					],
					"speakerTitle": "徐六石"
				},
				{
					"id": 190510313,
					"content": "それと海上竜巻が発生する前は、反対方向に強さの異なる風が吹く、それも知っていれば、より警戒することができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510314
					],
					"speakerTitle": "徐六石"
				},
				{
					"id": 190510314,
					"content": "そしてもっとも重要なのが、黒雲の中に小さな白い渦が現れたら、すぐさまみんなに知らせて、航路を変更する必要があること。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510315
					],
					"speakerTitle": "徐六石"
				},
				{
					"id": 190510315,
					"content": "これが海上竜巻の予兆だ。ここ数年、俺はその予兆を一度も見逃したことがない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510316,
						190510324
					],
					"speakerTitle": "徐六石"
				},
				{
					"id": 190510316,
					"content": "すごい洞察力だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510317
					]
				},
				{
					"id": 190510317,
					"content": "まあな、海に対する洞察力なら悪くないと自負してる。だが、人を見る目に関しては姉貴の足元にも及ばない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510318
					],
					"speakerTitle": "徐六石"
				},
				{
					"id": 190510318,
					"content": "望舒旅館の近くにある小さな漁村を知っているか？姉貴は子供の頃、大人たちと一緒にそこで漁に参加していたらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510319
					],
					"speakerTitle": "徐六石"
				},
				{
					"id": 190510319,
					"content": "それから、生活のため港へ移り住んだ。まだ小さな子供だったというのに、ああいった環境の中で生計を立てるなんて、姉貴の実力は大したもんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510320
					],
					"speakerTitle": "徐六石"
				},
				{
					"id": 190510320,
					"content": "姉貴が俺の肩を叩いて、「あんたにもできる」と言ってくれなかったら、今の自分みたいにはなろうと思わなかっただろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510321
					],
					"speakerTitle": "徐六石"
				},
				{
					"id": 190510321,
					"content": "お前さんは知らないと思うが、外で流れてる俺の噂は「三杯酔」という醜聞だけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510322
					],
					"speakerTitle": "徐六石"
				},
				{
					"id": 190510322,
					"content": "酔っぱらって海に落ちたり、人に馬鹿にされたりで、前の船隊をクビになった出来損ないが、今は南十字の見張り手になってるなんてな。言っても誰も信じないだろう、ははっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510323
					],
					"speakerTitle": "徐六石"
				},
				{
					"id": 190510323,
					"content": "だから、何か技術を持ってるだけじゃ足りないんだ。姉貴のような、人を見る目のある方に出会わないとな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510332
					],
					"speakerTitle": "徐六石"
				},
				{
					"id": 190510332,
					"content": "指導してくれてありがとう、だいたい理解できた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510333
					]
				},
				{
					"id": 190510333,
					"content": "他にまた知りたいことがあれば、俺のところに来るといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "徐六石"
				},
				{
					"id": 190510324,
					"content": "経験豊富なんだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510325
					]
				},
				{
					"id": 190510325,
					"content": "恥ずかしい話だが、俺の経験の多くは、実は姉貴から教わったものなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510326
					],
					"speakerTitle": "徐六石"
				},
				{
					"id": 190510326,
					"content": "たとえば、さっきお前さんに教えた気象観測なんかも、姉貴こそが真の専門家といえる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510327
					],
					"speakerTitle": "徐六石"
				},
				{
					"id": 190510327,
					"content": "望舒旅館の近くにある小さな漁村を知っているか？姉貴は子供の頃、大人たちと一緒にそこで漁に参加していたらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510328
					],
					"speakerTitle": "徐六石"
				},
				{
					"id": 190510328,
					"content": "それから、生活のため港へ移り住んだ。ずっとそういった環境で過ごしてきたから、海の上のことを何でも知っているんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510329
					],
					"speakerTitle": "徐六石"
				},
				{
					"id": 190510329,
					"content": "俺が乗船して間もない頃は、これまでの船乗り人生がすべて無駄だったんじゃないかと、毎日のように考えていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510330
					],
					"speakerTitle": "徐六石"
				},
				{
					"id": 190510330,
					"content": "だが徐々に、その新しい知識や見聞への理解が深まっていくと、南十字がなぜこれほどまでに強大なのかがわかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510331
					],
					"speakerTitle": "徐六石"
				},
				{
					"id": 190510331,
					"content": "すべての船隊に「龍王」が鎮座しているわけではない。ここにいられるのは、とても幸運なことなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510332
					],
					"speakerTitle": "徐六石"
				},
				{
					"id": 190510307,
					"content": "北斗は人をよく知り、その才能を使うのが上手い。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510308
					]
				}
			]
		},
