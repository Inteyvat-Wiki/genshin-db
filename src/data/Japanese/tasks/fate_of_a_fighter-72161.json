			},
			"dialogs": [
				{
					"id": 721610601,
					"content": "外国人、調子はどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610602
					],
					"speakerTitle": "稲葉久蔵"
				},
				{
					"id": 721610602,
					"content": "悪い、ここは客を迎えるのに向いてない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610603
					],
					"speakerTitle": "稲葉久蔵"
				},
				{
					"id": 721610603,
					"content": "だが…お前が来てくれて嬉しく思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610604
					],
					"speakerTitle": "稲葉久蔵"
				},
				{
					"id": 721610604,
					"content": "元気そうで何より。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610605
					]
				},
				{
					"id": 721610605,
					"content": "ああ、また借りができた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610606
					],
					"speakerTitle": "稲葉久蔵"
				},
				{
					"id": 721610606,
					"content": "ははッ、残念だが、今回も生き延びた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610607
					],
					"speakerTitle": "稲葉久蔵"
				},
				{
					"id": 721610607,
					"content": "いいことじゃないか。残念とか言うな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610608,
						721610609
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721610608,
					"content": "これからどうするの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610610
					]
				},
				{
					"id": 721610610,
					"content": "まだ決まってないが、帰ることはないと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610611
					],
					"speakerTitle": "稲葉久蔵"
				},
				{
					"id": 721610611,
					"content": "九条政仁という坊ちゃんが良い方のようだが、彼の父がいま逃走兵を捕らえるよう命令を出してると聞いた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610612
					],
					"speakerTitle": "稲葉久蔵"
				},
				{
					"id": 721610612,
					"content": "そのような時分に帰れはしない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610613
					],
					"speakerTitle": "稲葉久蔵"
				},
				{
					"id": 721610613,
					"content": "この鎧を外し、このまま1人で生きていくのも悪くないだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610614
					],
					"speakerTitle": "稲葉久蔵"
				},
				{
					"id": 721610614,
					"content": "だが平和な日常で己を騙しても、俺の記憶が、自分は血に濡れた負傷兵だと言っている…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610615
					],
					"speakerTitle": "稲葉久蔵"
				},
				{
					"id": 721610615,
					"content": "ふん…とにかく、この先のことは誰にも分からない、だろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610616,
						721610617
					],
					"speakerTitle": "稲葉久蔵"
				},
				{
					"id": 721610616,
					"content": "…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610618
					]
				},
				{
					"id": 721610618,
					"content": "そういえば、俺は大御所様の決断を一切疑ったことがない。だから、離れても悔いはないと思っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610619
					],
					"speakerTitle": "稲葉久蔵"
				},
				{
					"id": 721610619,
					"content": "うっ…急に話題が重くなったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610620
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721610620,
					"content": "ああ、このような話をしていたら…かつての戦友に会いたくなってきた。今でもこの島で俺と繋がりがあるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610621
					],
					"speakerTitle": "稲葉久蔵"
				},
				{
					"id": 721610621,
					"content": "稲妻の伝統では、「血石華」と言う名の妖艶で華奢な花を捧げる…武士たる者の宿命の証だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610622
					],
					"speakerTitle": "稲葉久蔵"
				},
				{
					"id": 721610622,
					"content": "この先の旅でもし俺の戦友たちに会ったら、足を止めて挨拶でもしてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "稲葉久蔵"
				},
				{
					"id": 721610617,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610618
					]
				},
				{
					"id": 721610609,
					"content": "帰りたいと思ったことある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610610
					]
				}
			]
		},
