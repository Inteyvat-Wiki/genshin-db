			"dialogs": [
				{
					"id": 721610301,
					"content": "帰ったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610302,
						721610303
					],
					"speakerTitle": "稲葉久蔵"
				},
				{
					"id": 721610302,
					"content": "全部解決した。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610304
					]
				},
				{
					"id": 721610304,
					"content": "うっ…急にヘンな雰囲気に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721610305,
					"content": "お前みたいな部外者にこんなこと頼んで、悪かったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610306,
						721610307
					],
					"speakerTitle": "稲葉久蔵"
				},
				{
					"id": 721610306,
					"content": "人の心配ができたんだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610308
					]
				},
				{
					"id": 721610308,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610309
					],
					"speakerTitle": "稲葉久蔵"
				},
				{
					"id": 721610309,
					"content": "薬草が切れた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610310
					],
					"speakerTitle": "稲葉久蔵"
				},
				{
					"id": 721610310,
					"content": "外用薬がほぼなくなったというのに、腫れがまだ治まらない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610311
					],
					"speakerTitle": "稲葉久蔵"
				},
				{
					"id": 721610311,
					"content": "いや…案ずるな、まだ何とかなる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610312
					],
					"speakerTitle": "稲葉久蔵"
				},
				{
					"id": 721610312,
					"content": "俺のことじゃなく自分のことだけ心配してろ、もう行け。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610313
					],
					"speakerTitle": "稲葉久蔵"
				},
				{
					"id": 721610313,
					"content": "子供みたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610314
					]
				},
				{
					"id": 721610314,
					"content": "…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610315
					],
					"speakerTitle": "稲葉久蔵"
				},
				{
					"id": 721610315,
					"content": "何だと…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610316
					],
					"speakerTitle": "稲葉久蔵"
				},
				{
					"id": 721610316,
					"content": "おまえのこと言ってるんだ、まるで子供みたいだって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610317
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721610317,
					"content": "苦しいのに、あと少しで泣きそうなのに、無理してかっこつけて…ぜんぜん正直じゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610318
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721610318,
					"content": "そういうの、子供のやることだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610319
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721610319,
					"content": "それに久蔵さん、忘れてないよな——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610320,
						721610321
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721610320,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}たちに借りができてる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610322
					]
				},
				{
					"id": 721610322,
					"content": "ふっ…しょうがない連中だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610323
					],
					"speakerTitle": "稲葉久蔵"
				},
				{
					"id": 721610323,
					"content": "では鳴草を集めてくれ、この島の至るところで見つけられる。葉の鮮度がいいものがいい、汁を絞りやすいから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610324
					],
					"speakerTitle": "稲葉久蔵"
				},
				{
					"id": 721610324,
					"content": "これでいいか。俺は少し寝るから、そっとしておいてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "稲葉久蔵"
				},
				{
					"id": 721610321,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}たちは助けにきた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610322
					]
				},
				{
					"id": 721610307,
					"content": "傷は治った？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610308
					]
				},
				{
					"id": 721610303,
					"content": "しばらくの間、静かに過ごせる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610304
					]
				}
			]
		},
