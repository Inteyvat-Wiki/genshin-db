					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610705
					],
					"speakerTitle": "稲葉久蔵"
				},
				{
					"id": 721610705,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}の相手じゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610706
					]
				},
				{
					"id": 721610706,
					"content": "ははっ、大口ばかり叩く…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610707
					],
					"speakerTitle": "稲葉久蔵"
				},
				{
					"id": 721610707,
					"content": "ヤツらを全員追い払えてから、そのようなことは言うんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610708
					],
					"speakerTitle": "稲葉久蔵"
				},
				{
					"id": 721610708,
					"content": "約束する。",
