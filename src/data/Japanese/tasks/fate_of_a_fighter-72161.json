					"稲葉久蔵"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721610101,
					"content": "ふん、情けない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610102
					],
					"speakerTitle": "稲葉久蔵"
				},
				{
					"id": 721610102,
					"content": "せっかく助けてやったのに、情けないってなんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610103,
						721610104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721610103,
					"content": "自分のことを言ってるんだと思う…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610105
					]
				},
				{
					"id": 721610105,
					"content": "この俺が外国人に救われ、ケチをつけられるとは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610106
					],
					"speakerTitle": "稲葉久蔵"
				},
				{
					"id": 721610106,
					"content": "そっか…それより武士の旦那、大丈夫か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721610107,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610108,
						721610109
					],
					"speakerTitle": "稲葉久蔵"
				},
				{
					"id": 721610108,
					"content": "元気そうだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610110
					]
				},
				{
					"id": 721610110,
					"content": "借りができたな、外国人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610111
					],
					"speakerTitle": "稲葉久蔵"
				},
				{
					"id": 721610111,
					"content": "それと、いい戦いぶりだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610112
					],
					"speakerTitle": "稲葉久蔵"
				},
				{
					"id": 721610112,
					"content": "#{NICKNAME}、会えて光栄だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610113
					]
				},
				{
					"id": 721610113,
					"content": "調子に乗るな、外国人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610114
					],
					"speakerTitle": "稲葉久蔵"
				},
				{
					"id": 721610114,
					"content": "…稲葉藤三郎久蔵、久蔵と呼んでくれていい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610115,
						721610116
					],
					"speakerTitle": "稲葉久蔵"
				},
				{
					"id": 721610115,
					"content": "さっきの連中は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610117
					]
				},
				{
					"id": 721610117,
					"content": "海賊だ、名椎の浜にヤツらの拠点が幾つかある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610118
					],
					"speakerTitle": "稲葉久蔵"
				},
				{
					"id": 721610118,
					"content": "逃げ回る賊、失業した鉱夫と漁師、「目狩り令」のお尋ね者、もしくは脱走兵…この者たちが群れになって…大御所様の制御から逃れようとしている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610119
					],
					"speakerTitle": "稲葉久蔵"
				},
				{
					"id": 721610119,
					"content": "「浮浪人」といい、「海乱鬼」といい、どっちも無法なヤツらだ…こないだまでヤツらを討伐してきた、抵抗軍が島の鎮め物を壊すまで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610120
					],
					"speakerTitle": "稲葉久蔵"
				},
				{
					"id": 721610120,
					"content": "たたら砂と鉱場の難民が逃げ出し、その中のネズミどもが隙に乗じて海賊に参加してから、奴らもより大胆になったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610121
					],
					"speakerTitle": "稲葉久蔵"
				},
				{
					"id": 721610121,
					"content": "先ほどの海賊は南の拠点からやってきた、この船の貨物を狙ってな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610122
					],
					"speakerTitle": "稲葉久蔵"
				},
				{
					"id": 721610122,
					"content": "俺がさぞかし邪魔だったんだろう、ふん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610123
					],
					"speakerTitle": "稲葉久蔵"
				},
				{
					"id": 721610123,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYSECOND|INFO_FEMALE_PRONOUN_GIRLSECOND]}の船じゃないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610124
					]
				},
				{
					"id": 721610124,
					"content": "この船か？元は珊瑚宮抵抗軍の船だが…俺がここに来た時、既に人はいなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610125
					],
					"speakerTitle": "稲葉久蔵"
				},
				{
					"id": 721610125,
					"content": "だから、ヤドカリのようにここで生活し始めたというわけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610126
					],
					"speakerTitle": "稲葉久蔵"
				},
				{
					"id": 721610126,
					"content": "これほど舌を動かすのも久々だな。疲れる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610127
					],
					"speakerTitle": "稲葉久蔵"
				},
				{
					"id": 721610127,
					"content": "そうだ、お前がよければ、一つ手を貸してくれないか…俺の傷が治ったら、そのとき借りは返そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610128
					],
					"speakerTitle": "稲葉久蔵"
				},
				{
					"id": 721610128,
					"content": "さっき話した周囲の海賊拠点だが、そこを片付けてほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610129
					],
					"speakerTitle": "稲葉久蔵"
				},
				{
					"id": 721610129,
					"content": "そうでもしないと、野良犬のような海賊が俺を邪魔し続けるだろう。海賊がいる他の拠点にも二度とこの船に近寄らないよう威嚇できる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610130
					],
					"speakerTitle": "稲葉久蔵"
				},
				{
					"id": 721610130,
					"content": "お前の腕をもう一度見せてくれ、どうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610131,
						721610132
					],
					"speakerTitle": "稲葉久蔵"
				},
				{
					"id": 721610131,
					"content": "楽勝。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610133
					]
				},
				{
					"id": 721610133,
					"content": "ふん、大口を叩くか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610134
					],
					"speakerTitle": "稲葉久蔵"
				},
				{
					"id": 721610134,
					"content": "そうだ、外国人——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610135
					],
					"speakerTitle": "稲葉久蔵"
				},
				{
					"id": 721610135,
					"content": "油断はするなよ、足のケガには気をつけろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "稲葉久蔵"
				},
				{
					"id": 721610132,
					"content": "すぐ行ってくる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610133
					]
				},
				{
					"id": 721610116,
					"content": "なぜ襲われた？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610117
					]
				},
				{
					"id": 721610109,
					"content": "自尊心を傷つけたみたい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610110
					]
				},
				{
					"id": 721610104,
					"content": "武士独特のひねくれた言い方だ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610105
					]
				}
			]
		},
