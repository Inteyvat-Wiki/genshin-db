			},
			"dialogs": [
				{
					"id": 721610505,
					"content": "薬草を煎じるまで時間がかかる、お前はもう行っていい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610506
					],
					"speakerTitle": "稲葉久蔵"
				},
				{
					"id": 721610506,
					"content": "…あ、いや、追い払っているわけでは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610507
					],
					"speakerTitle": "稲葉久蔵"
				},
				{
					"id": 721610507,
					"content": "後でまた来い、誰かと話ができるのも…悪くない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610508,
						721610509
					],
					"speakerTitle": "稲葉久蔵"
				},
				{
					"id": 721610508,
					"content": "分かった。",
