					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722490301,
					"content": "吾は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490302
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490302,
					"content": "吾は、ヘリオスの建造者——阿倍良久なり！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490303
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490303,
					"content": "ヘリオス？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722490304,
					"content": "ヘリオスって、なにかすごいものなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722490305,
					"content": "当然だ！吾はヘリオスの建造を主導し、国を挙げて、アビサルドラゴエアに抗ったのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490306
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490306,
					"content": "白夜国において、吾の他にこのような偉業を成し遂げた者はおらぬ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490307
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490307,
					"content": "へぇ、なんかすごそうだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722490308,
					"content": "でもそんなすごい人が、なんでここに閉じ込められてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722490309,
					"content": "吾は…裏切られたのだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490310
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490310,
					"content": "当時、天の国が底なしのアビスに落ち、人々はドラゴエアの迫害を受けた。そこで吾は、人々を救うためにヘリオスを建造した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490311
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490311,
					"content": "だがその後、あの卑しき者たちが現れた！命の危険がなくなった途端、人々を欺くようになり…挙句の果てには、子供を一国の長にした。なんと馬鹿げたことか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490312
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490312,
					"content": "吾もやつらの企てによって、牢獄に幽閉されたのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490313
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490313,
					"content": "おのれ…おのれおのれッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490314
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490314,
					"content": "そうだ…汝よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490315,
						722490317
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490315,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722490316
					]
				},
				{
					"id": 722490316,
					"content": "おう、おまえのことを呼んでるみたいだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490320
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722490320,
					"content": "汝のことだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490321
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490321,
					"content": "ここにはかつて、吾の聖なる衣が置かれていた。しかし、長き年月を経てすでに朽ち果ててしまった。それゆえ、それを拠り所にすることはできない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490322
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490322,
					"content": "汝が試練に通過したら、吾は自らの想いを込めた供え物を汝に託そう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490323
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490323,
					"content": "汝が試練を通過するのを…祈っている…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490324
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490324,
					"content": "これは極めて危険なことだ。旅人よ、準備ができたら、吾に言ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490317,
					"content": "いや、きっと呼んでるのはパイモン。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722490318
					]
				},
				{
					"id": 722490318,
					"content": "ええ、でもおまえのほうを見てるけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490319
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722490319,
					"content": "（しかも熱烈な眼差しで。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490320
					],
					"speakerTitle": "パイモン"
				}
			]
		},
