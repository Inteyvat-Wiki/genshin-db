				"points": []
			},
			"dialogs": [
				{
					"id": 722490201,
					"content": "うむ。汝なら、きっとやり遂げるだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490202
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490202,
					"content": "頼むぞ…この供え物を…必ず…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490203
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490203,
					"content": "必ず…そこに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490204
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490204,
					"content": "そこに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490205
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490205,
					"content": "どうしたんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722490206,
					"content": "残魂さんの声、どんどん聞き取りにくくなってるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722490207,
					"content": "奉納の場に…持っていけば…魂は一つになる…そうすれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490208
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490208,
					"content": "残魂さん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722490209,
					"content": "そうすれば…そうすれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490210
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490210,
					"content": "そうすれば、どうなるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722490211,
					"content": "そうすれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490212
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490212,
					"content": "うぅ…全然わからない。でもこれって、この供え物をどこかに持っていけばいいってことだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722490213,
					"content": "この供え物、ここに置かれて長いみたいだけど、食べ物は入ってるかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722490214,
					"content": "盗み食いしないで…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722490215
					]
				},
				{
					"id": 722490215,
					"content": "オ、オイラだって、別になんでも食べるわけじゃないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722490216,
					"content": "#よし、{NICKNAME}、供え物を持っていこう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
