				"points": []
			},
			"dialogs": [
				{
					"id": 3572301,
					"content": "風魔龍が…城内を襲ってる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572302
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3572302,
					"content": "#ガイア先輩、{NICKNAME}さん、ちょうどよかった、一緒に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572303
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3572303,
					"content": "待て、アンバー。見たことないヤツがいるんだが？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572304
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 3572304,
					"content": "あっ…そうだった。こちらはガイア先輩、わたしたちの騎兵隊長なの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572305
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3572305,
					"content": "#この人は、えっと……遠いところから来た{NICKNAME}さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572306
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3572306,
					"content": "（「遠い」ってことしか分からないのか…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572307
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 3572307,
					"content": "事の経緯はこう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572308
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3572308,
					"content": "なるほど、モンドへようこそ。しかし、こんな最悪なタイミングで来るとはツイてないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572309
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 3572309,
					"content": "俺にも分かるぜ、血縁者と離れ離れになるツラい気持ちがな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572310
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 3572310,
					"content": "それから、何で風神を探してるかは知らないが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572311
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 3572311,
					"content": "誰にでも言いたくない秘密はある、お前もその口だろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572312
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 3572312,
					"content": "ははっ、だから聞かないでおいてやるぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572313
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 3572313,
					"content": "とにかく、騎士団を代表して礼を言うよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572314,
						3572315
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 3572314,
					"content": "災いを放っておけなかった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3572318
					]
				},
				{
					"id": 3572318,
					"content": "さっきの風魔龍との戦いで、守られた市民は全員お前たちの活躍を目撃した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572319
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 3572319,
					"content": "代理団長もお前たちに興味があるみたいでな。<color=#00E1FFFF>騎士団本部</color>までどうか来てくれないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ガイア"
				},
				{
					"id": 3572315,
					"content": "どういたしまして。お礼は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3572316
					]
				},
				{
					"id": 3572316,
					"content": "…モンド名物のニンジンとお肉のハニーソテーでもどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572317
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 3572317,
					"content": "それはさっき聞いた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3572318
					]
				}
			]
		}
	]
}