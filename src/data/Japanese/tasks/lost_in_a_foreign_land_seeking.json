				{
					"id": 710590401,
					"content": "戻ってきたのね。収穫はあった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590402
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710590402,
					"content": "ないならそれでも大丈夫よ。好きなところに座って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590403
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710590403,
					"content": "私が焦っているとか、気にしなくていいから…ここに残って老後生活を送る計画もある。その時はあんたに年金の申し込みと受け取りをしてもらうかもね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590404
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710590404,
					"content": "わぁ、おまえ、のんびりしてるな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710590405,
					"content": "ふん、もし新しい発見がなければ、私は一生ここでのんびりすることになるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カタリナ"
				}
			]
		},
		{
			"id": 7105906,
			"completionStepIds": [
				7105907
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105907",
							"2"
						],
						"stepId": 7105907,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710590603,
					"content": "え…この記章って…あのファデュイのやつが残したものなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590601
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710590601,
					"content": "うぅ…人影もなかったかよ。それじゃどう報告すればいいのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590602
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710590602,
					"content": "うーん、他にできることもないよな。戻ろうぜ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7105913,
			"completionStepIds": [
				7105909
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105909",
							"2"
						],
						"stepId": 7105909,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"カタリナ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710591305,
					"content": "これは…士官の記章、行動手帳と…ノート？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591306
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710591306,
					"content": "コーリャはどこにいるの、教えて。彼はまだ生きているの…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591307,
						710591308
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710591307,
					"content": "見つからなかったけど、まだ生きてるかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591309
					]
				},
				{
					"id": 710591309,
					"content": "コーリャが私を残して、逃走兵のような真似をするはずがない…安心して、分かってるから。彼は敵前逃亡なんてしないって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591310
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710591310,
					"content": "これらの物はどこで見つけたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591311
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710591311,
					"content": "南東方向の洞窟。地図に記してあげる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591312
					]
				},
				{
					"id": 710591312,
					"content": "あそこはすっごく不気味な場所だぞ、変わった魔物もいっぱいいたし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710591313,
					"content": "ありがとう…ありがとう。でも私…ごめんね……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591314
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710591314,
					"content": "私…私はコーリャがもう犠牲になっていることを願っているの。むしろそう信じたいのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591315
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710591315,
					"content": "コーリャ、女皇陛下に恥をかかせないで、私に恥をかかせないで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591316
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710591316,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591317
					]
				},
				{
					"id": 710591317,
					"content": "コ、コホン…私は大丈夫よ…ごめんごめん！空気を悪くしてしまったわね…そういえば、あんたたちにちゃんとお礼も言ってなかったわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591318
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710591318,
					"content": "そうだ、炎水…あっ、はぁ…あんたたちはお酒を飲まない、そうだったわね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591319
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710591319,
					"content": "モラを少し持っているわ…それと…集めてきた物資もある。私が持ってても仕方ないから、どうぞ受け取って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591320,
						710591321
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710591320,
					"content": "これからどうするの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591322
					]
				},
				{
					"id": 710591322,
					"content": "これから？ご心配ありがとう、でもあんたに「悪事を働かせる」必要はもうないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591323
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710591323,
					"content": "うん…私のコーリャを探しに行くかもね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591324
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710591324,
					"content": "部隊が移駐する前に、彼が送ってくれた手紙を今でも持っているわ…私にとって、これは彼がこの世にいた最後の証拠なの…これからもずっと持っていきたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591325
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710591325,
					"content": "もし彼がまだ生きているのなら…女皇陛下のファデュイとして、彼がどこへ逃げ隠れしようと、私はこの裏切り者の首を必ず取りに行くわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591326
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710591326,
					"content": "もし彼が犠牲になったのなら…私も含めて——ファデュイが決して逃れられない運命を迎えた彼を、姉として誇りに思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591327
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710591327,
					"content": "「我らの他に誰がいる」っていうのは…そういうことなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591328,
						710591330
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710591328,
					"content": "#もし悪事を働く{M#君}{F#あなた}を止める日が来たら？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591329
					]
				},
				{
					"id": 710591329,
					"content": "…お互い、選べないときもある。それに、するべきことがあるでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591333
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710591333,
					"content": "とにかく…あんたは本当に真面目すぎよ。まだお酒も飲めないお子ちゃまのくせに、いつも変な悩みを抱えてるのね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591334
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710591334,
					"content": "その話は今度にしましょう。いつか、選ばなければならない日が来たらね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591335
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710591335,
					"content": "でも、今は休むわ…あんたも少し寝ない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591336
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710591336,
					"content": "ムシロは一枚しかないのに、どうやって寝るんだよ！オイラたちを追い出そうとしてるだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591337
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710591337,
					"content": "ははははは！それはあんたたちの問題でしょ…お気の毒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591338
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710591338,
					"content": "いずれにしろ、助けてくれたことに感謝してるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710591330,
					"content": "そんなにファデュイの立場にこだわるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591331
					]
				},
				{
					"id": 710591331,
					"content": "ええ、そうよ。変？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591332
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710591332,
					"content": "理念やら、立場やら、つまらない質問ばかり。ぷっ…私の仮面の下には理念だけじゃないわ。だって弾丸は怖いもの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591333
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710591321,
					"content": "まだ手伝いはいる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591322
					]
				},
				{
					"id": 710591308,
					"content": "秘密の通路を通って逃げ出したかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591309
					]
				}
			]
		},
		{
			"id": 7105914,
			"completionStepIds": [
				7105908
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710591401,
					"content": "「…この秘密の部屋に入ることに成功した。巨大なからくりの魔物はまだ外をうろついている、俺が逃げ出すのを待っているようだ。あいつはまるで捕食者のように、心がねじくれていて恐ろしい…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591402
					],
					"speakerTitle": "ニコライ伍長のノート"
				},
				{
					"id": 710591402,
					"content": "「…左足にひどい傷を負ったが、適当に手当したせいで痛い。腫れてしまった。感染したかもしれない…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591403
					],
					"speakerTitle": "ニコライ伍長のノート"
				},
				{
					"id": 710591403,
					"content": "「…岩穴にはもう一つ出口があるが、どこに通じているのかは分からない。出口の構造はとても脆いもので、支えるものがなければ、外からの強い力で簡単に崩れてしまうだろう…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591404
					],
					"speakerTitle": "ニコライ伍長のノート"
				},
				{
					"id": 710591404,
					"content": "「…バレてしまったようだ、誰か来た。…全身が漆黒の…剣士…？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591405
					],
					"speakerTitle": "ニコライ伍長のノート"
				},
				{
					"id": 710591405,
					"content": "「…彼、いや、あいつ…？頑丈な金属柵でさえあいつを止められないようだ。あいつの様子を見れば分かる…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591406
					],
					"speakerTitle": "ニコライ伍長のノート"
				},
				{
					"id": 710591406,
					"content": "「…ごめん、カティア。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ニコライ伍長のノート"
				}
			]
		}
	]
}