			},
			"dialogs": [
				{
					"id": 710580601,
					"content": "私は休むわ、古傷がまだ痛いの…ごめん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580602
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710580602,
					"content": "何かあったら、日を改めて私のところに来て…私もあんたに頼みたいことがあるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カタリナ"
				}
			]
		},
		{
			"id": 7105901,
			"completionStepIds": [
				7105901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105901",
							"2"
						],
						"stepId": 7105901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"カタリナ",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710590101,
					"content": "来てくれたのね！好きな場所に座って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590102
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710590102,
					"content": "ごめん、前回あんたたちを急いで追い出した上に、頼みたいことの説明もしなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590103,
						710590104
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710590103,
					"content": "大丈夫だから言ってみなさい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590107
					]
				},
				{
					"id": 710590107,
					"content": "安心しなさい、あんたたちに悪事を働かせるようなことはないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590108,
						710590109
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710590108,
					"content": "それじゃ言ってみなさい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590113
					]
				},
				{
					"id": 710590113,
					"content": "実は…私のコーリャ…、私の隊員ニコライとはぐれたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590114
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710590114,
					"content": "だから…彼が残した手がかりを探してほしくて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590115
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710590115,
					"content": "彼がまだ生きているのなら、彼を連れてきてほしい。もし彼が犠牲になってたなら…私に教えて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590116
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710590116,
					"content": "本当にごめん、こんなことを頼むなんて…助けてくれるかしら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590117
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710590117,
					"content": "そういうことか…てっきり悪事を働かせるのかと思ったぜ！例えば、千岩軍を壊滅させたり…とか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710590118,
					"content": "千岩軍…どうして？彼らを敵に回しても、ファデュイには何のメリットもないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590119
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710590119,
					"content": "どういうこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590120
					]
				},
				{
					"id": 710590120,
					"content": "こっちが聞きたいわよ…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590121
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710590121,
					"content": "待って…分かったわ…地上で璃月人と意見の相違があったのかしら…？それなら補給が断たれたのも説明がつく…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590122
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710590122,
					"content": "くっ…地上で一体何が起こったの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590123,
						710590124
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710590123,
					"content": "話せば長くなる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590125
					]
				},
				{
					"id": 710590125,
					"content": "ふん…そのことは後にしましょう。戦争ってそういうものだわ…敵も味方も常に変わる、それがファデュイが身を置く環境なのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590126
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710590126,
					"content": "でも私は…少なくとも今は、コーリャのことにしか気にしていないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590127
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710590127,
					"content": "私たちが撤退するとき、彼がはぐれてしまったの…それで、私が彼を探しに戻ったら、私まで他の人とはぐれてしまった。はぁ、本当に情けない話よね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590128
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710590128,
					"content": "彼が最後に目撃された場所を…マップ上に記しておくわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590129
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710590129,
					"content": "彼は追撃してきた敵の注意を逸らそうとして、あそこで私たちと離れ離れになった。でも、優秀な戦士だから、あんな場所で死んだりしてないって信じてるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590130
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710590130,
					"content": "彼がそこに手がかりを残してくれていればいいけど…そう願うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710590124,
					"content": "#{M#君}{F#あなた}たちが起こしたことだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590125
					]
				},
				{
					"id": 710590109,
					"content": "どうせファデュイにメリットのあることでしょ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590110
					]
				},
				{
					"id": 710590110,
					"content": "そうだぞ、おまえたちのような悪いやつらにとって、もしオイラたちのしてる良いことが悪いことだったとしても、オイラたちを止めるなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710590111,
					"content": "良いことやら…悪いことやら…私があんたたちを止める…何の話よ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590112
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710590112,
					"content": "はぁ…あんたたちうるさいわね、人の話を最後まで聞きなさいよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590113
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710590104,
					"content": "大丈夫、まだ手伝うとは約束してないから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590105
					]
				},
				{
					"id": 710590105,
					"content": "そうだぞ、おまえたちはファデュイだ。もしオイラたちに悪事を働かせるつもりなら、聞いてやらないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710590106,
					"content": "ぷっ…確かに一理あるわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590107
					],
					"speakerTitle": "カタリナ"
				}
			]
		},
		{
