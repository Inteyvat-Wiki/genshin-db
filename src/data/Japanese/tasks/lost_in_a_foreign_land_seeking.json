			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710590201,
					"content": "「…ツイてないな。カティア姉さんのバラライカを壊してしまった。急なことだったから、どんな風に壊したかも分からない。怒られる前に直さないと…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590202
					],
					"speakerTitle": "ニコライ伍長の日誌の残片"
				},
				{
					"id": 710590202,
					"content": "「…五百年前の先祖たちはこうして災厄に対抗していたのか？先祖たちと比べれば、俺たちが経験した苦戦は取るに足らないものだけだ、と大尉が言ってた…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590203
					],
					"speakerTitle": "ニコライ伍長の日誌の残片"
				},
				{
					"id": 710590203,
					"content": "（中の数ページは黒い物質に汚されており、黒い物質を取り除くと、インクで書かれている字もめちゃくちゃになってしまった。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590204
					],
					"speakerTitle": "ニコライ伍長の日誌の残片"
				},
				{
					"id": 710590204,
					"content": "「…このままここにいてはだめだ。あいつらは泥状の黒いものを通して俺の痕跡を把握できるんだ…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590205
					],
					"speakerTitle": "ニコライ伍長の日誌の残片"
				},
				{
					"id": 710590205,
					"content": "「…ここからは反対方向に進み続け、再びあいつらが小隊主力の場所から遠ざかるよう誘導する…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590206
					],
					"speakerTitle": "ニコライ伍長の日誌の残片"
				},
				{
					"id": 710590206,
					"content": "「…南東方向の要塞遺跡の隣に入り口があるようだ。あの道なら行けるかも…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590207
					],
					"speakerTitle": "ニコライ伍長の日誌の残片"
				},
				{
					"id": 710590207,
					"content": "「…うまくいくといいが。我らの他に誰がいる！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ニコライ伍長の日誌の残片"
				}
			]
		},
