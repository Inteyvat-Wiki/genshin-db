			"dialogs": [
				{
					"id": 710590301,
					"content": "戻ってきたのね。炎水はまだ残ってるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590302
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710590302,
					"content": "はは…お酒を飲むのに付き合えって言ってるわけじゃない。もしケガでもしたら、炎水は傷口の洗浄にも使えるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590303
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710590303,
					"content": "どう？収穫はあった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590304
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710590304,
					"content": "これを見つけた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
