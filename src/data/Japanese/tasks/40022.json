			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"辛炎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400220101,
					"content": "旅人、最近駐留してる兵士からいい知らせを聞いたぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220102
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400220102,
					"content": "九条裟羅さんが城内の事務に追われてて、彼女の部下も当分は動けないらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220103
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400220103,
					"content": "結局のところ、この秘境からはもうずっと魔物が出てきてないから、あいつらもこの重要な扉を守るだけで、焦って秘境内に入る必要もないみたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220104
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400220104,
					"content": "おかげで結構な時間稼ぎになってくれてるぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220105
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400220105,
					"content": "じゃあ早く入ろう、あの二人きっと待ちくたびれてるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 4002203,
			"completionStepIds": [
				4002203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4002203",
							"2"
						],
						"stepId": 4002203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「公子」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400220301,
					"content": "ずっと散り散りになっていた記憶が、ようやく一つの形になった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220302
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220302,
					"content": "すべて思い出したよ…この「訣籙陰陽寮」の過去…そしてその本質を。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220303
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220303,
					"content": "ここは「陰陽師」を実験する場所でも、邪悪なものを生む巣窟でもない。晴之介が僕とこの秘境を作った目的は…「守護」するためだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220304
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220304,
					"content": "「守護」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400220305,
					"content": "僕たちの国は、かつてある災害に見舞われたことがあった。それが原因で、晴之介の一番大事な人が奪われてしまったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220306
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220306,
					"content": "晴之介は深く悔やんだ。その時から、彼は邪悪を制御する力を渇望するようになった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220307
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220307,
					"content": "彼は海を渡り璃月へ行き、仙人を訪ねた。仙法を修行し、その奥深き術と自身が長年研究してきた「神通」を組み合わせ、最古の「陰陽術」を編み出した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220308
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220308,
					"content": "その後、彼は国に尽くす有志の武士を招集し、僕とこの陰陽寮を作ったんだ。そして僕を原型にした「拓本」を数多く製作し、それらを武士に分け与えた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220309
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220309,
					"content": "武士と「式神」が組み、符術と武道を駆使し、より確実に魔物を滅する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220310
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220310,
					"content": "彼らは二人一組となり、外で魔物と戦った。そして戦いに負けた魔物の情報を、「式神」によって書き記した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220356
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220356,
					"content": "秘境に戻ってから、その情報をもとに「鏡の魔物」の姿として再現し、武士たちの訓練相手としていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220311
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220311,
					"content": "僕は「式神」の統率者として、「拓本」たちの見聞や経験を吸収しながら、秘境の構造を調整し、武士たちにより効果的な訓練を提供していたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220312
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220312,
					"content": "そして時が経てば、これらの志の高い武士たちは、とてつもなく高い武術を身に着けることができる。彼らが離れれば、また新たな新人がやって来て、新たな見聞、新たな相手…それらを繰り返していった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220313
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220313,
					"content": "演武の秘境だったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400220314
					]
				},
				{
					"id": 400220314,
					"content": "道理で終わらない戦いが続いていたわけだ…ここは元々訓練場だったようだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220315
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400220315,
					"content": "つまり、惟神晴之介がこの陰陽寮を作ったのは、武士を訓練して、より効果的に魔物に対抗するためだったってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220316
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400220316,
					"content": "じゃあそいつ、立派な良い人だったってことじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220317
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400220317,
					"content": "もしそうだったら、なんで秘境の奥深くに隠れる必要があるんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220318
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400220318,
					"content": "いや、晴之介はもうとっくに寮内にはいない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220319
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220319,
					"content": "なぜかは分からないが、晴之介はすべての武士を追い出し、この秘境を廃棄した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220320
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220320,
					"content": "その記憶…最後の欠片は、まだ思い出せていない…それどころか、晴之介が離れる時、僕に何を言ったかさえも思い出せない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220321
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220321,
					"content": "離れたってことは…まだ生きてるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220322
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400220322,
					"content": "たぶん。少なくとも…僕はそうだと願っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220323
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220323,
					"content": "僕は晴之介に創造された一種の「兵器」だ。僕と陰陽寮の使命は、戦いを作り続け、自分と他人を磨き上げていくこと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220324
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220324,
					"content": "しかし今となっては、この秘境も意味のないものとなった。君たち以外、他に来る人もいない…主に見捨てられた兵器に、一体なんの価値があると言うのだろうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220325
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220325,
					"content": "なんかすごく悲しそうだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220326
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400220326,
					"content": "主に見捨てられた兵器…アハハッ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220327
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400220327,
					"content": "兵器になるのも悪くないんじゃないかな？戦いに沈んだ者は、みな自らの意義と価値を追い求めている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220328
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400220328,
					"content": "そうなのか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220329
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220329,
					"content": "君は俺の秘密に興味があっただろ？どうして俺が秘境の排斥に抗うことができるのか、どうして俺がこんな複雑な戦局に対応できるのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220330
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400220330,
					"content": "俺はただ「木の根」の隙間で戦ったことがあるだけなんだ。果てしない苦境、命懸けの危険…それら養分を得ることでのみ、俺はより早く強くなれる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220331
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400220331,
					"content": "俺が欲しいのは勝利ではなく、磨くこと。自らを鋭利に尖らせ、恐れられる存在になる。俺も君と同じ「兵器」なのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220332
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400220332,
					"content": "だったら…君の追い求めている戦い…その終点は一体どこにあるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220333
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220333,
					"content": "終点を追い求めるのは、終わることを望む者だけさ。俺は違う。そんな無意味なことなんて、まったく気にしていない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220334
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400220334,
					"content": "俺は戦うために生まれた。俺が生きている限り、終点は現れない…俺の選んだ道は、その一歩一歩がすべて極限なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220335
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400220335,
					"content": "戸惑いを捨てろ。悲しみと迷いを抱えたままでは、無情な兵器にはなれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220336
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400220336,
					"content": "どうやったら捨てることができる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220337
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220337,
					"content": "アタイが思うに、捨てるっていうのは一種の表現じゃないか？別に本当に何かを捨てるわけじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220338
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400220338,
					"content": "「式大将」、あんたは何も捨てなくていい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220355
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400220355,
					"content": "あんたは記憶を取り戻したばかりだ。今こそ過去を拾うチャンスなんだよ。あんたにとって正しくて重要なこと、それを取り戻せればそれでいいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220339
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400220339,
					"content": "正しくて重要な…こと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220340
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220340,
					"content": "アタイにはあるぜ。アタイはロックが好きだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220341
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400220341,
					"content": "ロックが好きなやつはあまり多くないだろ？確かに人気はないが、それでも大丈夫。楽しけりゃあそれでいい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220342
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400220342,
					"content": "他のやつらが好きかどうかなんて、アタイとまったく関係ないと思わないか？アタイは自分のやりたいことしかやらないぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220343
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400220343,
					"content": "たとえ冷たい目で見られても、放っておけ！アタイの音楽は、端っから分からないやつのために聴かせるもんじゃねぇ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220344
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400220344,
					"content": "曲…たしか僕のために弾いてくれたあの「試験」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220345
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220345,
					"content": "一人寂しく道を歩き、たまに篝火のそばで人に会って、みんなで一緒に焼き魚を食べてた。そうあんたは言ってたけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220346
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400220346,
					"content": "そういうのが理解できてる時点で、あんたは人の感情をよく知ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220347
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400220347,
					"content": "人はみんな多かれ少なかれ、そういった孤独な道を歩んだことがある。あんたもそこにいる、ならあんたはアタイたちの仲間だ。だからこそ篝火のそばで出会い、友達になれたのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220348
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400220348,
					"content": "道は険しいが、アタイたちは孤独じゃない。「式大将」、これがアタイの音楽にある言語で、正しいことを続けた収穫だ。あんたは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220349
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400220349,
					"content": "何かやらなきゃいけないことがあるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220350
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400220350,
					"content": "辛炎さん…今はまだ君のようにはなれないけど…僕は分かっている、このまま立ち止まっていてはいけないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220351
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220351,
					"content": "前に進もう、みんな！最後の「拓本」を取り戻したい…いや、取り戻して、この秘境を再び掌握する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220352
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220352,
					"content": "きっと…僕にできることはまだあるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220353
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220353,
					"content": "おう、気を取り直して行こう！まだ戦いが残ってるぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220354
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400220354,
					"content": "みんな一緒に進めば、問題ない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 4002206,
			"completionStepIds": [
				4002206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4002206",
							"2"
						],
						"stepId": 4002206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「式大将」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400220601,
					"content": "晴之介は僕を見捨てたわけじゃない、僕が彼を啓発し、彼の抱えていた重荷を手放させたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220602
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220602,
					"content": "僕と「訣籙陰陽寮」に対し、晴之介は美しい願いを持っていた。強いて言うなら、生まれた時代を間違えただけなのかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220603
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220603,
					"content": "武士たちは精一杯鍛錬し、その鍛錬も少しながら効果があると証明された。しかし、凡人の力には限界がある。我々が作り出した進歩は…あまりにも遅いもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220604
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220604,
					"content": "僕たちが修行に奮闘していた時、あの「無想の一太刀」を振るう神が、勤勉で強大な戦士を引き連れ、この土地に埋もれていた災いを根絶やしにした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220605
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220605,
					"content": "みんなの努力が突如として不要なものになった…そんな結果を受け入れられる人なんていない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220606
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220606,
					"content": "神の力は時に残酷。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400220607
					]
				},
				{
					"id": 400220607,
					"content": "まったく想像できない…でもどこかで似た話を聞いたような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220608
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400220608,
					"content": "僕は混乱し、落ち込み、すべてを疑った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220609
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220609,
					"content": "しかし僕たちの作った結果、僕たちの払った代価、それらがたとえどんなに小さなものでも、実際に存在していたものだったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220610
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220610,
					"content": "いずれにしても、晴之介と武士たちの望んでいた「目標」は達成され、武士たちも精一杯訓練する必要がなくなった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220611
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220611,
					"content": "それは元々祝福すべきことだった。だが晴之介は情がありすぎたゆえ、世間のあらゆるものを気にかけ、自身の失ったものに固執したのだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220612
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220612,
					"content": "「守護」は我々の共同の願いだった。晴之介はみんなを守ろうとした…ならば、僕は晴之介を守ろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220613
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220613,
					"content": "晴之介の最も満足する造物として、彼が「訣籙陰陽寮」にいた時の唯一の友として、僕は彼を導いた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220614
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220614,
					"content": "彼は僕に言っていたよ。新たな「意義」を探しに行くと。一ヶ月かかるかもしれないし、一年、何百年かかるかもしれない。どんなに長くても、僕はいつの日か彼が願いを叶え、ここへ戻ってくることを願っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220615
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220615,
					"content": "来る日も来る日も待ち続け、僕は深い眠りについた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220616
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220616,
					"content": "はぁ…晴之介よ、君はもう戻っては来ないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220617
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220617,
					"content": "そんな悲しむなって、「式大将」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220618
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400220618,
					"content": "惟神晴之介はあんなに強い仙法を学んで、「神通」だって身につけてる。もしかしたら不老不死になってるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220619
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400220619,
					"content": "みんな、もう決めたよ。晴之介がこの世にいてもいなくても、僕は彼のために生きるのはやめる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220620
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220620,
					"content": "君たちに会ってから、一つ学んだことがある。信じることだ。晴之介は自分の道を歩んでいる、僕はそう信じる…そして僕自身も、そんな道を歩んで行けると信じてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220621
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220621,
					"content": "この世に生まれ落ちた時から、僕たちは孤独の果てに向かって歩んでいる。だけど霧の中には火の光があり、夜空の下には新たな仲間がいる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220667
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220667,
					"content": "僕たちの使命が、長い旅によって終わることはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220622
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220622,
					"content": "晴之介のやったすべてに価値がある。そして僕の「意義」こそ、僕の使命なんだ。この点についてはずっと変わらないし、奪われることもない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220623
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220623,
					"content": "我こそは武人を補佐する「式神」が長「式大将」、この「訣籙陰陽寮」不変の寮司。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220624
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220624,
					"content": "我が責務は武人を補佐し、武道を極限まで鍛え上げる者に手を差し伸べること。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220625
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220625,
					"content": "世の中にはまだ、高き山を登る者が必ずいる。僕はその山々の綱となり、彼らの武器となり、彼らと共に頂へ向かおう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220626
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220626,
					"content": "よし、その意気だぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220627,
						400220628
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400220627,
					"content": "やっと答えを見つけたね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400220629
					]
				},
				{
					"id": 400220629,
					"content": "記憶が完全に戻った式大将は…なんだかすごく頼りになる感じだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220630
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400220630,
					"content": "すでに「訣籙陰陽寮」は再び制御した。今後「鏡の魔物」が逃げ出すことはない。今回のことも、これで終わりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220631
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220631,
					"content": "あと何日かすれば、符術の力の脈絡を整理し、「訣籙陰陽寮」を元通りに戻すことができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220632
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220632,
					"content": "ここは予測不能でありながら、安全で頼れる試練の地。今後は僕もここをずっと守護し、武道を極める者に最も効果的な試練を与えよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220633
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220633,
					"content": "天領奉行もそろそろ秘境に入る頃合いだ。彼らが来たら、僕が今回の事を詳しく説明する。それについては、僕に任せてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220634
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220634,
					"content": "わかった、つまりオイラたちは後処理をしなくてもいいんだな？ん～オイラ、こういうなにも気にしなくていい感じ、すごく好きだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220635
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400220635,
					"content": "君たちのおかげで、僕は真の自分を取り戻せた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220636
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220636,
					"content": "少しばかりの礼を用意した。みんなの恩とは比べ物にならないが、少しは役に立つだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220637
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220637,
					"content": "「拓本」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220638
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400220638,
					"content": "彼のことは、「式小将」と呼んでくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220639
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220639,
					"content": "「式小将」は他の「拓本」と違い、大陸のどこにいても、僕と連絡を取り合える。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220640
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220640,
					"content": "「訣籙陰陽寮」を離れれば、彼は「式札」と符術を使うことができなくなるが、君たちを加護することはできるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220641
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220641,
					"content": "彼を連れて各地を渡り歩けば、僕をそばに置いて連れ歩くのと同じ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220642
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220642,
					"content": "（「式大将」の口調がしんみりしてきてるぞ…アタイたちともう会えないことを心配してるのか？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220643
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400220643,
					"content": "おい！そんなしょげたこと言うな、アタイたちはまだここにいるだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220644
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400220644,
					"content": "それに、旅人と九条裟羅さん、北斗さんのおかげで、アタイが稲妻に来るのもそこまで難しいことじゃねぇ。もしかしたら、たまにまたここに来て、あんたに会いに来るかもしれねぇぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220645
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400220645,
					"content": "辛炎さん…それは…君の時間をとってしまうことになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220646
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220646,
					"content": "聞くが、ロックはどうだった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220647
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400220647,
					"content": "ロック…僕にとっては、非常にいい音楽だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220648
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220648,
					"content": "それだけで十分だ。アタイは音楽の良さを知っている人にしか演奏しない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220649
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400220649,
					"content": "みんな、よく聴けよ、アタイが一曲奏でてやる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220650
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400220650,
					"content": "えっ！？ここで曲を弾くのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220651
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400220651,
					"content": "この曲にこんな心振るわす部分があったなんてな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220652
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400220652,
					"content": "公子はダンスができるんだろ？あいつと一緒に…ってあれっ？公子は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220653
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400220653,
					"content": "おいっ——！公子！どこ行くんだよ、まさか、こっそり逃げようとしてるんじゃないよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220654
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400220654,
					"content": "逃げる？俺はただ、休憩する場所を探して、考え事をしようとしていただけだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220655
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400220655,
					"content": "旅人、俺が調査していたことを君に教える時が来たね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220656,
						400220657
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400220656,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400220658
					]
				},
				{
					"id": 400220658,
					"content": "やっぱり鋭いね。君の目は人の心を見透かしてるんじゃないかって、時々疑ってしまうよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220659
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400220659,
					"content": "今回はすごく楽しかった、正直、稲妻はかなり好きだよ…些細な厄介事…そして、それがもたらす影響を考えなければね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220660
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400220660,
					"content": "元々は、この秘境が「散兵」と関係していると思い、ここへ来たのさ。だけど、彼はいなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220661
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400220661,
					"content": "「神の心」を持った「散兵」は俺たちと連絡を絶った…これにはおそらく何か裏がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220662
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400220662,
					"content": "だが「散兵」がこんなことをするのも、俺はまったく予想していなかったわけじゃないよ。俺が戦いを求めてファトゥスになったのと同じように、ファトゥスの多くは自分の目的を持っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220663
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400220663,
					"content": "あの「心」はもう少し泳がせておこう。いつか、どこに行ったのかが分かる。その時は、君ならどう選択する？旅人、君の終点はどこにあるのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220664
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400220664,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400220665
					]
				},
				{
					"id": 400220665,
					"content": "ホント、もう少しここにいたかったね。長く滞在すればするほど、次に会った時の喜びも大きくなる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220666
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400220666,
					"content": "夜空の星のように…君はいつも多くの驚きをもたらしてくれる、俺の相棒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400220657,
					"content": "#これまでの{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}の経験と関係してる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400220658
					]
				},
				{
					"id": 400220628,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}もすごく啓発された。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400220629
					]
				}
			]
		},
