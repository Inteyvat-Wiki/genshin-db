			"dialogs": [
				{
					"id": 400221101,
					"content": "みんな、戻ってきたのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400221102
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400221102,
					"content": "人も揃ったことだし、最後の答えを探しに行く時が来たね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400221103
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400221103,
					"content": "あんたらは、なかなか辛い一戦をしてたみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400221104
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400221104,
					"content": "一戦？アハハッ…もう何戦したかすらも覚えていないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400221105
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400221105,
					"content": "俺が本領を発揮した姿も悪くなかっただろ、「式大将」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400221106
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400221106,
					"content": "タルタリヤさんはこの秘境にすごく詳しくて、どんなに強い魔物でも完璧に対応できていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400221107
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400221107,
					"content": "僕たちなら、この秘境の最深部まで辿り着けると思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400221108
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400221108,
					"content": "おっ？一緒に何日かいて、けっこう仲良くなったみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400221109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400221109,
					"content": "ハハッ、もう戦友さ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400221110
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400221110,
					"content": "再構築の間、「式大将」から聞いたんだけど、一番重要とも言える拓本の出現を感じたらしい。すぐ近くにあるみたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400221111
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400221111,
					"content": "あの「拓本」に込められた符術の力は、他のものを遥かに超える。回収がうまくいけば、この秘境の真相を思い出すことができるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400221112
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400221112,
					"content": "近くにあるだろ？なんで取りに行ってないんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400221113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400221113,
					"content": "「式大将」…あんた、アタイたちを待ってたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400221114
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400221114,
					"content": "みんなのおかげで、僕はここまで来られた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400221115
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400221115,
					"content": "僕の記憶は、君たちのおかげで少しずつ取り戻せたんだ。最後の一番重要な一刻は…みんなに見届けてもらいたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「式大将」"
				}
			]
		},
