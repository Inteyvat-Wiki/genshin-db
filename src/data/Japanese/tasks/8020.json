			"dialogs": [
				{
					"id": 80200301,
					"content": "ここに隠してあるのか？確かに人気がまったくないし、気づかれにくい場所だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80200302,
					"content": "さっそく確認しに行こうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80200303,
					"content": "待て、旅人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200304
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200304,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200305
					]
				},
				{
					"id": 80200305,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200306
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200306,
					"content": "…急ごう、入るぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200307
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200307,
					"content": "（さっきダインは何を言おうとしたんだろう…？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200308
					]
				},
				{
					"id": 80200308,
					"content": "おい、オイラを置いてくなって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
