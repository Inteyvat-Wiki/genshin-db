			"dialogs": [
				{
					"id": 80200101,
					"content": "待った、あれって…ダインじゃないか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80200102,
					"content": "ん？ああ、貴様たちか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200103
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200103,
					"content": "お友達？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200104
					],
					"speakerTitle": "アトッサ"
				},
				{
					"id": 80200104,
					"content": "わたし、先に村に入ってるね。村長たちの様子を確認してこないと。またね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200105
					],
					"speakerTitle": "アトッサ"
				},
				{
					"id": 80200105,
					"content": "おう。またな、アトッサ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80200106,
					"content": "まったく、おまえってほんと神出鬼没だよな。登場するたびにオイラたちをびっくりさせないと気が済まないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80200107,
					"content": "貴様たちが「アビス」を追っている限り、俺たちの道が交差するのも当然のことだ。個人の意志とは関係ない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200108
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200108,
					"content": "…ってことは、アビス教団を追ってここに来たってことか？アビスの魔物を倒してたみたいだし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80200109,
					"content": "そうだが…なんだ？貴様たちは違ったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200110,
						80200111
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200110,
					"content": "こっちもアビス教団の動きに気づいて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200112
					]
				},
				{
					"id": 80200112,
					"content": "いずれにせよ、この地の異変には気づいているはずだ——どんなに鈍くてもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200113
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200113,
					"content": "アビス教団は、間違いなくこの近くで何か準備をしている。さらに言うなら…何かしらの計画を進めているはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200114
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200114,
					"content": "つまり、この近くのヒルチャールに落ち着きがないのもアビス教団の仕業ってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80200115,
					"content": "いや、事ここに至って、ヒルチャールの落ち着きをなくす程度のことがやつらの目的とは思えん。おそらくそれは、何らかの計画の「副産物」だろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200116
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200116,
					"content": "でも、この件がヴィマラ村の脅威になってるのは確かだぞ。しばらくヴィマラ村に残って、ここを守ったほうがいいんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80200117,
					"content": "無論、村は守る。だがそれ以上に、アビス教団がここで何を企んでいるのか突き止めるほうが重要だ。さらなる悲劇を防ぐためにもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200118,
						80200119
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200118,
					"content": "今の状況について、もう一度村人に聞こう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200120
					]
				},
				{
					"id": 80200120,
					"content": "元より貴様の質問から逃げるつもりはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200121
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200121,
					"content": "案ずるな…今回は時間がある。あとでゆっくり話すとしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200119,
					"content": "それより…前に約束した「答え」を教えて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200120
					]
				},
				{
					"id": 80200111,
					"content": "実は偶然出くわしただけ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200112
					]
				}
			]
		},
