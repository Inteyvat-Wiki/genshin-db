			"dialogs": [
				{
					"id": 80200501,
					"content": "ここが一番奥みたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80200502,
					"content": "気を付けろ、「アビス」の気配だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200503
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200503,
					"content": "うわっ、本当にアビス教団のやつらが現れたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
