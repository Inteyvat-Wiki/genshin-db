			},
			"dialogs": [
				{
					"id": 80200601,
					"content": "予想通り、「偽りの記憶」は罠だったか。アビス教団は俺たちの後をつけていたようだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200602
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200602,
					"content": "これで、やつに会う機会も…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200603
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200603,
					"content": "ぐっ…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200604
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200604,
					"content": "ダイン！？急にどうしたんだ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200605
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80200605,
					"content": "感じなかったか？地脈の乱れだ。アビス教団め、また何か企んでいるらしい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200606
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200606,
					"content": "おまえって本当に感覚が鋭いよな。オイラ、特になにも感じなかったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200607
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80200607,
					"content": "貴様たち、今から俺の言う通りに動け——あそこの仕掛けを使ってここから離れろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200608
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200608,
					"content": "一人で本当に大丈夫？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200609
					]
				},
				{
					"id": 80200609,
					"content": "いまアビス教団は何かをしようとしているところだ。このタイミングでヴィマラ村に戻れば、例の「失踪者」を見つけられるかもしれん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200610
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200610,
					"content": "…二手に分かれると考えればいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200611
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200611,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200612
					]
				},
				{
					"id": 80200612,
					"content": "（判断的には何も間違ってないと思うけど…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200613
					]
				},
				{
					"id": 80200613,
					"content": "（でも、どうしても「違和感」が拭えない…どこかで何かを見落としてるような…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200614
					]
				},
				{
					"id": 80200614,
					"content": "ふん…やはりな。こうして貴様たちの罠にはまることでようやく、俺の前に現れる気になったか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200615
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200615,
					"content": "#{M#あなた}{F#君}は、自分自身と「耕運機の目」の両方を賭けた…",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80200616
					]
				},
				{
					"id": 80200616,
					"content": "#{M#これだけの餌を用意されたんだから、}{F#これだけの餌を用意されたんだ。}誘惑に負けて罠にかかったのは、むしろ{M#私}{F#俺}のほうなんじゃない？「末光の剣」ダインスレイヴ。",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80200617
					]
				},
				{
					"id": 80200617,
					"content": "一人で来たのか？貴様の信者たちはどうした？連れてこなかったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200618
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200618,
					"content": "#十分な準備をした「末光の剣」を前に、{M#いくら戦力を投入したところで無駄なことでしょ。なら、私一人であなたに立ち向かったほうがいいから。}{F#いくら戦力を投入したところで無駄なことだよ。なら、俺一人で君に立ち向かったほうがマシだ。}",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80200619
					]
				},
				{
					"id": 80200619,
					"content": "言いたいことがたくさんあるのは知ってるよ…",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80200620
					]
				},
				{
					"id": 80200620,
					"content": "#…でもその話は、{M#私}{F#俺}を倒せたらにしよう…どう？",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": []
				}
			]
		},
