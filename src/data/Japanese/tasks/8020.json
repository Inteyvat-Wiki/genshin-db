			},
			"dialogs": [
				{
					"id": 80200201,
					"content": "あれ？ダイン？おーい…ダインってば！なにぼーっとしてんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80200202,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200203
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200203,
					"content": "なにかあったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80200204,
					"content": "どうしたの？ダイン？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200205
					]
				},
				{
					"id": 80200205,
					"content": "貴様たちが話していた失踪者だが…そいつはどんなやつだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200206
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200206,
					"content": "うん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80200207,
					"content": "確か二十代前半の男の人だったよな。一体どうしたんだよ、ダイン…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80200208,
					"content": "先ほど、頭の中にあるものが突然現れた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200209
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200209,
					"content": "…どうやら、そいつに関する「記憶」のようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200210
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200210,
					"content": "なんだって…？えっと…ひょっとして、昨日あいつのことを話したから夜に夢を見たとか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80200211,
					"content": "いや、あれは夢じゃない。今朝目が覚めた後、急に頭の中にこの記憶が浮かんできた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200212
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200212,
					"content": "確実に言えるのは、俺はこの男に会ったことがないということ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200213
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200213,
					"content": "で、その「記憶」の内容は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200214
					]
				},
				{
					"id": 80200214,
					"content": "ああ。確か、その記憶で俺は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200215
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200215,
					"content": "…「最古の耕運機の目」をそいつに渡していた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200216
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200216,
					"content": "…！？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200217
					]
				},
				{
					"id": 80200217,
					"content": "えっ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80200218,
					"content": "…ってことは、いなくなった人がアビス教団と繋がってるのは確かみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200219
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80200219,
					"content": "ああ。それにおそらくそいつは、人の脳内に記憶を「埋め込む」能力を持っているようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200220
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200220,
					"content": "いったいどうやって…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200221
					]
				},
				{
					"id": 80200221,
					"content": "それが本当なら、ヴィマラ村のみんなもただ頭の中に嘘の記憶を埋め込まれただけなんじゃないか？元々そいつのことなんか知らなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200222
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80200222,
					"content": "でも、こんなことをしたところで…いったいなんの役に立つんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200223
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80200223,
					"content": "今朝のこの一件で、アビス教団側の状況がひとつ露呈した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200224
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200224,
					"content": "ん？それって？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200225
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80200225,
					"content": "やつらは依然として…「最古の耕運機の目」を求めている。それを探すことをまだ諦めていないということだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200226
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200226,
					"content": "このような記憶を埋め込んだのも、「目」の在りかを唯一知っている俺の頭を混乱させるためだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200227,
						80200228
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200227,
					"content": "じゃあ「目」はまだ安全なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200229
					]
				},
				{
					"id": 80200229,
					"content": "ふむ、そう心配するのも無理からぬことだ。だが、アビス教団にそれを現実にするほどの力はないだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200230
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200230,
					"content": "しかし、やつらの「目」に対する執着を見る限り、それなりの用心はしておくべきだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200231
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200231,
					"content": "「目」がまだこちらの手にあるか、確認しておこう。二人も来てくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200232
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200232,
					"content": "「目」を隠した場所に行くのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200233
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80200233,
					"content": "（…でもこのまま行ったら、尾行されてたときに隠し場所をバラすことになるんじゃ？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200234
					]
				},
				{
					"id": 80200234,
					"content": "（もしかすると、アビス教団がダインに記憶を埋め込んだ本当の狙いはこれなのかもしれない。ダインを疑心暗鬼にさせて、確認させようと…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200235
					]
				},
				{
					"id": 80200235,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200236
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200236,
					"content": "（ダインなら、この考えに至らないことはないはず…それに彼の様子からすると、他に考えがあるのかも…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200237,
						80200238
					]
				},
				{
					"id": 80200237,
					"content": "じゃあ、行こうか。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200239
					]
				},
				{
					"id": 80200239,
					"content": "…ああ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200238,
					"content": "案内して、ダイン。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200239
					]
				},
				{
					"id": 80200228,
					"content": "「記憶」が事実だった可能性は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200229
					]
				}
			]
		},
