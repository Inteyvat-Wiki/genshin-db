				]
			},
			"dialogs": [
				{
					"id": 80200122,
					"content": "日が暮れるまで、もう一度ヴィマラ村の村人たちに聞き込みを行って情報を集めた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						80200123
					]
				},
				{
					"id": 80200123,
					"content": "なるほどな…そのような依頼を受け、ここに来ていたのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200124
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200124,
					"content": "「まるで記憶の中にしか存在しない人」…ふむ、確かに気になるな。それに、これがただの失踪事件ではないというのには同意だ。裏でアビス教団が糸を引いているかどうかは、今のところ不明だが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200125
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200125,
					"content": "これ以外に得られたのは、「ヒルチャールに落ち着きがない」という表面的な情報だけか…やはり、あまり収穫はないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200126,
						80200127
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200126,
					"content": "よし、それじゃあ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200128
					]
				},
				{
					"id": 80200128,
					"content": "こいつが血縁者の記憶の中で聞いた謎の声のことをな。確か…「罪人」だったっけ？それって一体なにもんなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200129
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80200129,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200130
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200130,
					"content": "旅人、貴様は…血縁者が自分を「裏切った」と思うか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200131,
						80200132
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200131,
					"content": "#{M#妹}{F#お兄ちゃん}を信じたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200133
					]
				},
				{
					"id": 80200133,
					"content": "なるほど…貴様のその言葉からは迷いを感じたが、真実が明らかになっていない今、それも仕方のないことだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200134
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200134,
					"content": "取り返しのつかないことが起きる前であれば、二人の関係はまだ修復できる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200135
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200135,
					"content": "貴様たちが知りたがっている、あの「罪人」とは違ってな。あいつは過去に他の「罪人」たちと共に国を裏切り、この俺のことも裏切った…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200136
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200136,
					"content": "やつの名は——「予言者」ヴェズルフェルニル。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200137
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200137,
					"content": "口にするのさえ嫌悪するが、あいつと俺の間には血の繋がりがある——あれは俺の「兄」だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200138
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200138,
					"content": "あいつが…ダインのお兄さんだって？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200139,
						80200140
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80200139,
					"content": "二人の間に一体何があったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200141
					]
				},
				{
					"id": 80200141,
					"content": "「罪人」は合わせて五人いる…即ち、カーンルイアの「五大罪人」だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200142
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200142,
					"content": "「賢者」フロプタチュール、「予言者」ヴェズルフェルニル、「黄金」レインドット、「極悪騎」スルトロッチ、そして「月の狩人」レリル。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200143
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200143,
					"content": "俺の記憶が如何に摩耗しようと、あいつらの名前だけは決して忘れない。いつの日か必ず…やつらへの復讐を果たす。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200144
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200144,
					"content": "い、今の名前！いくつか聞いたことあるぞ…アルベドを創造したレインドットに、スカークの師匠スルトロッチ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200145
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80200145,
					"content": "そしてたった今知った、コロタールを導いてアビス教団を作らせたダインのお兄さん…「予言者」ヴェズルフェルニル…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200146
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80200146,
					"content": "いつの間にかすべてが繋がった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200147
					]
				},
				{
					"id": 80200147,
					"content": "（そういえば、フォンテーヌの遺跡で見つけた予言の石板も、そのヴェズルフェルニルが残したものなのかもしれない。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200148
					]
				},
				{
					"id": 80200148,
					"content": "そいつらは全員、かつてカーンルイアで大きな希望を寄せられた者たちだ。各分野の同世代を束ねる存在だった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200149
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200149,
					"content": "当時、俺を含めた六人が災厄の発生をくい止め、世界の根幹を揺るがし続ける黒王を阻止するという計画があった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200150
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200150,
					"content": "だが、あの五人が胸に秘めていたのは欲望だ。「アビス」の誘惑に負けると、世界を滅ぼせるほどの力を分け合い、その手中に収めた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200151
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200151,
					"content": "やつらは「罪人」となり、同時に超越者となった。そして世界に匹敵するほどの力を持つようになったんだ、全員がな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200152
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200152,
					"content": "やがてカーンルイアで災厄が起きたが、やつらは誰一人として立ち上がらなかった…俺は、決してそれを許さない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200153,
						80200154
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200153,
					"content": "その後…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200155
					]
				},
				{
					"id": 80200155,
					"content": "…ああ。このまま放っておけば、やつらはいつか、世界そのものを「裏切る」だろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200156,
						80200157
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200156,
					"content": "辛いことを思い出させちゃったね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200158
					]
				},
				{
					"id": 80200158,
					"content": "気にすることはない。言ったはずだ、貴様の質問から逃げるつもりはないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200159
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200159,
					"content": "それでダイン、前回別れてから、なにか新しい手がかりは見つかったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200160
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80200160,
					"content": "ああ、あれから引き続き「運命の織機」のことを追っていた。既に「運命の織機·原初の計画」が動き出してから、かなりの日数が経っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200161
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200161,
					"content": "以前「最古の耕運機の目」を奪うことで、その計画の一部を阻止したが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200162
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200162,
					"content": "確か、魔神オセルを改造するってやつだったっけ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200163
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80200163,
					"content": "ああ。だが…あれは技術的な実験にすぎなかったのだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200164
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200164,
					"content": "必要不可欠な「耕運機の目」を手に入れていないにもかかわらず、やつらは実験段階を飛ばして、何かしらの方法で計画を進めている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200165
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200165,
					"content": "何せ、その兆候がいくつも見られるからな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200166
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200166,
					"content": "じゃあ、これからどうするんだ？まだ間に合うんだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200167
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80200167,
					"content": "いま最も優先すべきは…運命の織機が何に使われるか明らかにすることだ。これが分かれば、アビス教団の目的にもいくらか目途が立つ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200168
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200168,
					"content": "現在把握している情報からすると、運命の織機はおそらく…「地脈」と関係しているのだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200169
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200169,
					"content": "地脈？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200170
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80200170,
					"content": "前に旅人が見た血縁者の記憶も、あの一帯の地脈が不安定だったことによるものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200171
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200171,
					"content": "それにここ最近、アビス教団を追っていて気づいたことがある——やつらが活動した地域では、地脈に問題が起こっているようだ、必ずな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200172
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200172,
					"content": "地脈の中には「記憶」が流れてる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200173
					]
				},
				{
					"id": 80200173,
					"content": "あれ？だとすると、オイラたちがヴィマラ村で探してる「まるで記憶の中にしか存在しない人」も、なにか関係してるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200174
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80200174,
					"content": "（記憶…地脈…運命の織機…記憶の中にしかいない人）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200175
					]
				},
				{
					"id": 80200175,
					"content": "（これらすべてを繋ぐものは一体…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200176
					]
				},
				{
					"id": 80200176,
					"content": "その可能性もゼロではない。明日から俺もそっちの調査に加わろう。今回の事件は確かにある種の契機になるかもしれん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200177
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80200177,
					"content": "へへっ、またダインと一緒に行動できるな！じゃあ今日は早めに休んで、明日はもう少し遠くまで行ってみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200401
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80200401,
					"content": "ふわぁ～…昨日は考えることが多すぎたせいで、頭がくらくらするぞ…ダインのやつ、難しい話ばっかするんだもんな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200402,
						80200403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80200402,
					"content": "#{M#俺}{F#私}もあまり眠れなかった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200404
					]
				},
				{
					"id": 80200404,
					"content": "とりあえず、ダインのところに行こうぜ。今日はやらなきゃいけないことがたくさんあるからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80200403,
					"content": "まだ混乱してる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200404
					]
				},
				{
					"id": 80200157,
					"content": "教えてくれてありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200158
					]
				},
				{
					"id": 80200154,
					"content": "#{M#妹}{F#お兄ちゃん}がダインの兄と接触したんだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200155
					]
				},
				{
					"id": 80200140,
					"content": "当時のカーンルイアに一体何があったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200141
					]
				},
				{
					"id": 80200132,
					"content": "あれは裏切りと言ってもいいかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200133
					]
				},
				{
					"id": 80200127,
					"content": "前回約束したことを教えてくれる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200128
					]
				}
			]
		},
