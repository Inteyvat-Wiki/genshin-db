			"dialogs": [
				{
					"id": 130280201,
					"content": "拠点を訪れると、二匹のキノコンは無事に受け入れられた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130280202
					]
				},
				{
					"id": 130280202,
					"content": "ここのキノコン、オイラたちのことを覚えてくれてるみたいだ。オイラたちにすごく親切だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130280203,
					"content": "どうやら、あの元素生命のここでの地位はかなり高かったみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280204
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130280204,
					"content": "あれ？おまえたち、どうしたんだ？オイラと一緒に遊びたいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130280205,
					"content": "~♩~♩",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280206
					],
					"speakerTitle": "プカプカ風キノコン"
				},
				{
					"id": 130280206,
					"content": "#よしよし。じゃあ{NICKNAME}、オイラちょっとこいつらと遊んで来てもいいか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280207,
						130280208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130280207,
					"content": "行ってらっしゃい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280209
					]
				},
				{
					"id": 130280209,
					"content": "…一つ、あなたに謝りたいことがあるの。アペプの体内にいた時、「火種」が砕けた際に…私が自身の力を使おうとしたことについて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280210
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130280210,
					"content": "パイモンから聞いたかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280211,
						130280212
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130280211,
					"content": "うん、とても心配した。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280213
					]
				},
				{
					"id": 130280213,
					"content": "やっぱり、私は冷静さを欠いていたわ。あの時、もっと考えて、より大局を見た判断を下すべきだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280214
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130280214,
					"content": "でも、草龍の命が危機に瀕していて、スメールの民がみんな危険にさらされていることを考えると…焦って、怯えずにはいられなかったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280215
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130280215,
					"content": "やれることがあるのに、最後はやらないと決断していたら…力が尽きる前に時間が先に来てしまっていたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280216
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130280216,
					"content": "力を使うことはもっとも簡単なことであり、もっとも困難なことでもあるわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280217
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130280217,
					"content": "引き続き「成長」していく必要がある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280218
					]
				},
				{
					"id": 130280218,
					"content": "ええ、あの子たちからは色々教わったわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280219
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130280219,
					"content": "「本望」という言葉を聞いた時、理解はできたけど、なかなか受け入れられなかったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280220
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130280220,
					"content": "あの声がなぜあんなにも明るかったのか、私には分からない。あんなに悲しいことだったのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280221
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130280221,
					"content": "私はまた、「共感」できなくなったみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280222,
						130280223
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130280222,
					"content": "#これは{M#君}{F#あなた}の問題じゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280224
					]
				},
				{
					"id": 130280224,
					"content": "慰めてくれてありがとう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280225
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130280225,
					"content": "感情って本当に複雑だわ。これからも勉強に励んでいかないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280226
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130280226,
					"content": "あら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280227
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130280227,
					"content": "~♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280228
					],
					"speakerTitle": "プカプカ水キノコン"
				},
				{
					"id": 130280228,
					"content": "～♪～♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280229
					],
					"speakerTitle": "プカプカ水キノコン"
				},
				{
					"id": 130280229,
					"content": "この子たち、畑を世話する方法を知っていたなんて…動きだけを真似しているのかしら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280230
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130280230,
					"content": "けれど、あのキノコンは喋ることさえできていたから、ひょっとしたらこれも元素力が長年に渡って与えた影響なのかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280231
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130280231,
					"content": "時間には力がある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280232
					]
				},
				{
					"id": 130280232,
					"content": "そうね。二匹の元素生命の憂いも、これで無事解決だわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280233
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130280233,
					"content": "この拠点の世話は私に任せて。不定期にだけど、ここの状況を確認しに来るわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280234
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130280234,
					"content": "あの子たちの足跡を残すためにも。そして将来、この子たちと出会える可能性を作るためにもね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280235
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130280235,
					"content": "なにせ、最後にあの子は「ヌール」という名前を思い出したんだもの。その記憶が戻ったのだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280236,
						130280237
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130280236,
					"content": "家族の情を信じてる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280238
					]
				},
				{
					"id": 130280238,
					"content": "ええ、素敵な願いだわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280239
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130280239,
					"content": "ナヒーダ、キノコンたちがまた果物を持ってきたぞ。一緒に食べようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280240
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130280240,
					"content": "ええ、すぐ行くわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130280237,
					"content": "奇跡を信じてる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280238
					]
				},
				{
					"id": 130280223,
					"content": "#{M#俺}{F#私}も{M#君}{F#あなた}と同じ感情だった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280224
					]
				},
				{
					"id": 130280212,
					"content": "うん、とても怒ってる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280213
					]
				},
				{
					"id": 130280208,
					"content": "楽しんできて！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280209
					]
				}
			]
		}
	]
}