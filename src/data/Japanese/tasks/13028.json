			"dialogs": [
				{
					"id": 130280113,
					"content": "この子たち、ここでもうずいぶん長い時間を過ごしてきたようね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280101
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130280101,
					"content": "あの子たちが再会できるように…私、何かをしてあげたいわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280102
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130280102,
					"content": "この二匹のキノコンだけじゃなく、オイラ、プカプカ風キノコンの拠点も心配だぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130280103,
					"content": "ええ、同感よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280104
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130280104,
					"content": "一つ考えがあるわ。この子たちを元の場所に連れ戻して、一緒に生活させるというのはどうかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280105
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130280105,
					"content": "日頃から元素生物が導いてくれていたのなら、その生活の習慣も近いはずよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280106
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130280106,
					"content": "確かにそうだな！お互いの面倒も見れるし！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130280107,
					"content": "じゃあ、あなたたち、私たちと一緒に来てくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280108
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130280108,
					"content": "……？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280109
					],
					"speakerTitle": "プカプカ水キノコン"
				},
				{
					"id": 130280109,
					"content": "~♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280110
					],
					"speakerTitle": "プカプカ水キノコン"
				},
				{
					"id": 130280110,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280111
					],
					"speakerTitle": "プカプカ水キノコン"
				},
				{
					"id": 130280111,
					"content": "よし、こいつらもオッケーみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130280112,
					"content": "ええ、では行きましょうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ナヒーダ"
				}
			]
