			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"博来"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400010203,
					"content": "いくら積まれても売る気はない！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010204
					]
				},
				{
					"id": 400010205,
					"content": "一介の商人には払えない額だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010206
					]
				},
				{
					"id": 400010202,
					"content": "#そこの{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_GIRLB]}ちゃん、その隣に浮かんでいるチビは、いくらで売っているのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010203,
						400010205
					],
					"speakerTitle": "博来"
				},
				{
					"id": 400010204,
					"content": "いくら積まれても売られる気はない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400010206,
					"content": "なんかおかしいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400010207,
					"content": "でも正直に言うとちょっと気になるな…一体いくらだ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400010208,
					"content": "まあ、いくら積まれても売る気はないということにしておくか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400010209,
					"content": "ハハハッ、確かに最近は懐に余裕がないから、あまり出せないかもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010210
					],
					"speakerTitle": "博来"
				},
				{
					"id": 400010210,
					"content": "なにせ普通の商人だ。珍しい宝物を売っているわけではない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010211
					],
					"speakerTitle": "博来"
				},
				{
					"id": 400010211,
					"content": "…なんかあやしいぞ、こいつ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400010212,
					"content": "そう言わないで…そうだ、飴食べる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010213
					],
					"speakerTitle": "博来"
				},
				{
					"id": 400010220,
					"content": "さすがパイモン…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 400010213,
					"content": "#{NICKNAME}、こいつは信頼できるやつだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400010214,
					"content": "そうだ、君たちも「海灯祭」目当てで璃月に来たんだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010215
					],
					"speakerTitle": "博来"
				},
				{
					"id": 400010215,
					"content": "今年の「明霄の灯」はとにかくすごい。巨大な灯を浮かせるために使った「浮生の石」はここ20年で最も大きいものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010216
					],
					"speakerTitle": "博来"
				},
				{
					"id": 400010216,
					"content": "神話に出てくる雲の中の城が本当に実在していたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010217
					],
					"speakerTitle": "博来"
				},
				{
					"id": 400010217,
					"content": "きっと同じくらい大きな浮生の石がくっついているんだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010218
					],
					"speakerTitle": "博来"
				},
				{
					"id": 400010218,
					"content": "なんかすごそう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010219
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400010219,
					"content": "ようこそ、璃月へ——<color=#00E1FFFF>璃月港</color>の代表としての言葉ではないが、少なくとも私の店はいつでも君を歓迎するよ。はははは、機会があればまた会おう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "博来"
				}
			]
		},
