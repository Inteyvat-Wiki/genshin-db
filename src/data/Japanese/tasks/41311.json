					"望雅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413111101,
					"content": "おかえり。どう？宜年の料理はなかなかだったでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111102
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 413111102,
					"content": "すごく美味しかったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 413111103,
					"content": "あの書類は参考にしないって…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413111104
					]
				},
				{
					"id": 413111104,
					"content": "そう？去年もそんな感じだったわ…私たちの提案通りに広告を出してくれれば、売り上げがもっと増えるはずなのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111105
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 413111105,
					"content": "まあ、いいわ。ほら、さっき言ったプレゼントよ。この「霄灯」をあげるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111106
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 413111106,
					"content": "わぁ、すごくきれいな灯りだ、これってどうやって作るんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 413111107,
					"content": "うーん…編み方は私もうまく説明できないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111108
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 413111108,
					"content": "もし「霄灯」に興味があるのなら、<color=#00E1FFFF>景明</color>に聞いてみるといいわ。彼は「霄灯」と「明霄の灯」の責任者よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111109
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 413111109,
					"content": "あのすごーく大きい灯りも、その人が担当しているのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 413111110,
					"content": "ええ、彼はその辺にいるだろうから、すぐに見つかると思うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111111
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 413111111,
					"content": "「霄灯」を編んで魈にプレゼントしたら、少しは喜んでくれるかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 413111112,
					"content": "早く<color=#00E1FFFF>景明</color>を探しに行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 4131112,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
