			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"江舟"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413110601,
					"content": "#{NICKNAME}、見ろ！空中に石が浮いているぞ。鎖も引っ張られて伸びてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110602
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 413110602,
					"content": "鎖がなかったら、どこまで飛んでいくんだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110603
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 413110603,
					"content": "あれは「明霄の灯」の材料、浮生の石。この「霄市」はそのために作られたものだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110604
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 413110604,
					"content": "えっと、誰…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110605
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 413110605,
					"content": "明霄の灯の建設進捗統計を担当している江舟だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110606
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 413110606,
					"content": "君たちは最近璃月に来たばかりで、海灯祭を見るのも初めてかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110607
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 413110607,
					"content": "そうだけど…どうして分かったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110608
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 413110608,
					"content": "去年は変わったマスコットを連れた旅人なんていなかったからさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110609
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 413110609,
					"content": "つまり「明霄の灯」は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413110610
					]
				},
				{
					"id": 413110610,
					"content": "海灯祭で、人々が飛ばす小さな提灯が「霄灯」で、璃月のみんなが共同で建設した巨大な提灯が「明霄の灯」だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110611
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 413110611,
					"content": "「霄市」の屋台は璃月の各商会が年に一度、お金のためではなく、「明霄の灯」を建設するために開いたものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110612
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 413110612,
					"content": "じゃあ、「霄市」には美味しいものもたくさんあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110613
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 413110613,
					"content": "もちろん。私に言わせれば、海灯祭は璃月の美食を味わう最高の機会だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110614
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 413110614,
					"content": "これは璃月の1年のうちで最も盛大な祭りだ。海灯祭で自分の技術をみんなに披露すれば、評判もかなり上がるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110615
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 413110615,
					"content": "だから金にはならなくとも、各商店は全力を出し、海灯祭で己の技を競い合うのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110616
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 413110616,
					"content": "璃月人はいろんな面ですごいんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110617
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 413110617,
					"content": "まだ何か聞きたいことがあったら、海灯祭の責任者である<color=#00E1FFFF>望雅</color>さんを探してみるといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110618
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 413110618,
					"content": "望雅さんは基本「霄市」のあたりにいる。彼女に聞けば色々と教えてくれるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110619
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 413110619,
					"content": "そいつはどの店の料理が一番美味しいのかも知ってるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110620
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 413110620,
					"content": "当然さ。望雅さんは海灯祭の全てに詳しいからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110621
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 413110621,
					"content": "#分かった、{NICKNAME}、早く「霄市」に行って、その<color=#00E1FFFF>望雅</color>さんを探そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110622
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 413110622,
					"content": "それで…一番美味しい屋台でお腹いっぱい食べるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 4131107,
			"completionStepIds": [
				4131107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
