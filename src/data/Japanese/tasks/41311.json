			"trigger": {
				"objectNames": [
					"ピンばあや"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400010601,
					"content": "今年の「明霄の灯」のデザインは「移霄導天真君」か。見栄えを気にするあやつが喜びそうじゃのう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010602,
						400010611
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 400010602,
					"content": "「移霄導天真君」について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010603
					]
				},
				{
					"id": 400010603,
					"content": "今年の海灯祭の「明霄の灯」は「移霄導天真君」のイメージを参考にデザインされたんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010604
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 400010604,
					"content": "鹿の角をもっと大きくしてくれるといいんじゃが。なにせ鹿の角はあの仙人の誇りじゃったからのう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010605
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 400010605,
					"content": "その角には岩王帝君の力が込められておって、璃月で最も硬いものだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010606
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 400010606,
					"content": "しかし「あの決戦」で山が崩れそうになり、彼は麓にいた人々を守るため、自ら角を斬ってくれと友人に頼んだんじゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010607
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 400010607,
					"content": "彼は斬り落とされた角を支点にして、山を支えた。彼自身も最後の一滴の血が流れるまで戦ったんじゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010608
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 400010608,
					"content": "今になってもなお、彼の角に支えられた「天衡山」は高くそびえ立っておる、そして彼が戦いで流した血は「碧水川」となった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010609
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 400010609,
					"content": "ほぉっほぉっ…信じてくれるかどうかは別として、この話を聞いてくれただけで、ばあやは満足じゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010610
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 400010610,
					"content": "海灯祭が今も在り続けているのは、あの「旧友」たちが寂しがり屋だからかもしれないのう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 400010611,
					"content": "さようなら。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010612
					]
				},
				{
					"id": 400010612,
					"content": "さようなら。往古来今、美徳の精神が続かんことを。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ピンばあや"
				}
			]
		},
		{
			"id": 4131106,
