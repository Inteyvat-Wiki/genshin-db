			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ヴェル·ゴレット"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413110101,
					"content": "あと少しで海灯祭ね。今年は旅館に飾り付けをしようかしら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110102
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 413110102,
					"content": "海灯祭？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413110103
					]
				},
				{
					"id": 413110103,
					"content": "知らない？その年の最初の満月の夜が璃月の「海灯祭」よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110104
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 413110104,
					"content": "それは英雄を祀るための祭典。夜になると人々は「霄灯」と「明霄の灯」を夜空に放つの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110105
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 413110105,
					"content": "灯りには「薪が尽きても火は伝わるように、美徳は永遠に消えない」という意味が込められているわ。私達は夜の海に輝く灯りが、英雄の魂を故郷に導くと信じているの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110106
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 413110106,
					"content": "おぉ…すごく盛大な祭りなんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 413110107,
					"content": "それなら…美味しいものもたくさんあるよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 413110108,
					"content": "#{NICKNAME}、オイラの言いたいこと、もちろん分かるだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 413110109,
					"content": "あなたたちも海灯祭に参加するの？「海灯祭」当日までは、しばらくお祭りは続くわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110110
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 413110110,
					"content": "この期間中に人々は祈祷を捧げたり、厄払いをしたりするの。璃月の言葉で言うと「古きを送り、新しきを迎える」ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110111
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 413110111,
					"content": "もし参加したいのなら、今からでも間に合うわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110112
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 413110112,
					"content": "それと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110113
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 413110113,
					"content": "それと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413110114
					]
				},
				{
					"id": 413110114,
					"content": "もし行くのなら…その…試しに魈様も誘ってあげてくれないかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110115
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 413110115,
					"content": "魈様と私たちはそこまで親しい間柄じゃないから、ちょっと声をかけにくいの。あなたたちは仲がいいみたいだし、せっかくなら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110116
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 413110116,
					"content": "でも魈の気持ちを考えると…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413110117
					]
				},
				{
					"id": 413110117,
					"content": "うん、今声をかけに行くのはあまりよくないような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 413110118,
					"content": "そうなの…ならいいわ！ちょっと言ってみただけなの。ほら、早く<color=#00E1FFFF>璃月港</color>に行ってきなさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110119
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 413110119,
					"content": "遅くなると人がみんな集まってくるわ。そうなると遊ぶのも大変よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110120
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 413110120,
					"content": "早く行きなさい。海灯祭を楽しんでおいで！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴェル·ゴレット"
				}
			]
		},
		{
