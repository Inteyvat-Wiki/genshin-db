					"景明"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413111201,
					"content": "このペースなら…間に合うだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111202
					],
					"speakerTitle": "景明"
				},
				{
					"id": 413111202,
					"content": "「霄灯」の編み方を知りたい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413111203
					]
				},
				{
					"id": 413111203,
					"content": "「霄灯」の編み方？おや…君の格好、この土地の人間じゃないね。自分で「霄灯」を編みたいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111204
					],
					"speakerTitle": "景明"
				},
				{
					"id": 413111204,
					"content": "「霄灯」には色んなタイプがあるからな。ふむ…一番簡単なものの作り方を教えてあげよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111205
					],
					"speakerTitle": "景明"
				},
				{
					"id": 413111205,
					"content": "ちょうどここに材料があるんだ…おっと、この材料はまず処理を施す必要があったな。まずはこれで試しに作ってみてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111401
					],
					"speakerTitle": "景明"
				},
				{
					"id": 413111401,
					"content": "あ…頭がこんがらがるぞ、こんなに複雑だなんて…お、おまえは覚えたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 413111402,
					"content": "なんとか…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413111403
					]
				},
				{
					"id": 413111403,
					"content": "ははは、始めは難しいかもしれないが、数をこなせば慣れるさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111404
					],
					"speakerTitle": "景明"
				},
				{
					"id": 413111404,
					"content": "君たちのように「霄灯」の編み方を覚えたいという人は、もうそう多くない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111405
					],
					"speakerTitle": "景明"
				},
				{
					"id": 413111405,
					"content": "あの超巨大な「明霄の灯」も、こうやって編んで作ったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 413111406,
					"content": "あれか？あれも…「編んだ」と言えるだろう。だが一人ではなく。璃月にいる全ての者が一緒に編んだんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111407
					],
					"speakerTitle": "景明"
				},
				{
					"id": 413111407,
					"content": "璃月にいる全ての者が？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 413111408,
					"content": "君も知っているだろう、「霄市」の商店がこの「明霄の灯」を建設するためにここに集まっているのを。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111409
					],
					"speakerTitle": "景明"
				},
				{
					"id": 413111409,
					"content": "なるほど…「明霄の灯」は、毎回商店の力を借りて作られてるのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111410
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 413111410,
					"content": "これは海灯祭の伝統だ。必要な費用は主に総務司からの寄付金だが、材料やその他もろもろは、全て一般の人々が寄付したものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111411
					],
					"speakerTitle": "景明"
				},
				{
					"id": 413111411,
					"content": "あ…この前の女の子、自分のぬいぐるみを寄付してたよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111412
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 413111412,
					"content": "ぬいぐるみも「明霄の灯」の建設に使えるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 413111413,
					"content": "それは…海灯祭は大きな祭りだ。みんなが「明霄の灯」の建設に参加したいのなら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111414
					],
					"speakerTitle": "景明"
				},
				{
					"id": 413111414,
					"content": "何を寄付したとしても、基本全て受け取るようにしている。想いが込められているからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111415
					],
					"speakerTitle": "景明"
				},
				{
					"id": 413111415,
					"content": "なにせ盛大な祭りだ、参加することで「祝福」を受けたいという人もいるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111416
					],
					"speakerTitle": "景明"
				},
				{
					"id": 413111416,
					"content": "おっと、君たちは海灯祭を楽しみに来たのだろう。引き留めてすまないね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111417
					],
					"speakerTitle": "景明"
				},
				{
					"id": 413111417,
					"content": "また「霄灯」を編みたくなったら、私のところに来てくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111418
					],
					"speakerTitle": "景明"
				},
				{
					"id": 413111418,
					"content": "海灯祭を楽しんでくれよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "景明"
				}
			]
		},
