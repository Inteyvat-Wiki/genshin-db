			},
			"dialogs": [
				{
					"id": 400010901,
					"content": "チャンチャンはね、今ぬいぐるみを寄付したよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010902
					],
					"speakerTitle": "チャンチャン"
				},
				{
					"id": 400010902,
					"content": "昨夜、空を飛んでみたいってあの子に言われた夢を見たから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010903
					],
					"speakerTitle": "チャンチャン"
				},
				{
					"id": 400010903,
					"content": "だからそこのお姉さんにあの子を渡したんだ。きっとすぐに夢が叶えられるよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010904
					],
					"speakerTitle": "チャンチャン"
				},
				{
					"id": 400010904,
					"content": "チャンチャンはいいことしたかな？海灯祭はみんなの願いが叶う日でしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "チャンチャン"
				}
			]
		},
