			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"望雅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413110701,
					"content": "こんにちは、何か用かしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110702
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 413110702,
					"content": "あなたの格好…璃月の人じゃないようね。旅人かしら？「霄市」へようこそ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110703
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 413110703,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYSECOND|INFO_FEMALE_PRONOUN_GIRLSECOND]}が海灯祭の責任者？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413110704
					]
				},
				{
					"id": 413110704,
					"content": "責任者…とも言えないわ。海灯祭は璃月全体の祭りなのだから、誰かが責任を取るものでもないもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110705
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 413110705,
					"content": "私はただ細かい部分を管理して、海灯祭をもっと盛り上げているだけよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110706
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 413110706,
					"content": "聞きたいことがある…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413110707
					]
				},
				{
					"id": 413110707,
					"content": "「霄市」で一番美味しい屋台はどこなんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110708
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 413110708,
					"content": "一番？それぞれに特徴があるから、はっきりした答えは出せないわ。ただ、一番人気の屋台なら知っているわね。<color=#00E1FFFF>宜年</color>の屋台よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110709
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 413110709,
					"content": "あそこに並ぶ人がもう少し増えたら、千岩軍に行列の整理をしてもらう予定よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110710
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 413110710,
					"content": "行くなら急いだ方がいいわ。人が増えて道が埋め尽くされる前にね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110711
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 413110711,
					"content": "そうだ、宜年のところに行くのなら、ついでにこの書類を彼に渡してちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110712
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 413110712,
					"content": "これは我々総務司が昨年の海灯祭のデータを元に作成した、各商店への経営提案よ。どうせ行くのなら、ついでに手伝ってくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110713
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 413110713,
					"content": "戻ってきたら、お礼としてちょっとしたプレゼントをあげるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "望雅"
				}
			]
		},
		{
			"id": 4131108,
			"completionStepIds": [
				4131108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4131108",
							"2"
						],
						"stepId": 4131108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"宜年"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413110801,
					"content": "人手が足りないな、もう少し人を連れてくるべきだった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110802
					],
					"speakerTitle": "宜年"
				},
				{
					"id": 413110802,
					"content": "ここはどんな美味しいものがあるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110803
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 413110803,
					"content": "お客さんかい？メニューはこっちだ。メニューにあるものもないものも、何でも作れるからね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110804
					],
					"speakerTitle": "宜年"
				},
				{
					"id": 413110804,
					"content": "わぁ！それじゃあ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110805
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 413110805,
					"content": "うーん、小さな屋台だけど…なんでもあるようだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110806
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 413110806,
					"content": "当然さ、僕に作れない料理はないからね。さぁ、早く注文して。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110807
					],
					"speakerTitle": "宜年"
				},
				{
					"id": 413110807,
					"content": "これは望雅さんからの書類。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413110808
					]
				},
				{
					"id": 413110808,
					"content": "また今年も来たか。経営提案なんて——僕は料理の味以外で勝負する気はないのに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110809
					],
					"speakerTitle": "宜年"
				},
				{
					"id": 413110809,
					"content": "まあいい、書類をくれる？あとで薪代わりにでもするよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110810
					],
					"speakerTitle": "宜年"
				},
				{
					"id": 413110810,
					"content": "さあ、食事しに来たのなら注文してくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110811
					],
					"speakerTitle": "宜年"
				},
				{
					"id": 413110811,
					"content": "こんなにメニューがあるなんて。これも美味しそうだな、ああ、こっちも食べたい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110812
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 413110812,
					"content": "あれ、「チ虎魚焼き」？これ、確か「銅雀」が好きだった料理だよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110813
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 413110813,
					"content": "うん…海灯祭が英雄を祀るための祭りなら、この料理にしよう。これであいつを偲ぶんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110814,
						413110815
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 413110814,
					"content": "自分が食べたいだけでしょ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413110816
					]
				},
				{
					"id": 413110816,
					"content": "なかなか見る目があるな、うちの看板メニューをいきなり当てるなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110817
					],
					"speakerTitle": "宜年"
				},
				{
					"id": 413110817,
					"content": "少し待っていてくれ、すぐにできるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110819
					],
					"speakerTitle": "宜年"
				},
				{
					"id": 413110819,
					"content": "はい、注文してた「チ虎魚焼き」だよ、味はどう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110820
					],
					"speakerTitle": "宜年"
				},
				{
					"id": 413110820,
					"content": "美味しいっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110821
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 413110821,
					"content": "パイモンは食の専門家だ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413110822
					]
				},
				{
					"id": 413110822,
					"content": "おまえの最高の仲間として当然のことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110823
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 413110823,
					"content": "ははは、ゆっくり食べてくれ。僕は次のお客さんを対応しないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110824
					],
					"speakerTitle": "宜年"
				},
				{
					"id": 413110824,
					"content": "まだ何か食べたかったら、いつでも注文してくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宜年"
				},
				{
					"id": 413110815,
					"content": "パイモンらしい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413110816
					]
				}
			]
		},
		{
			"id": 4131111,
			"completionStepIds": [
				4131111
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
