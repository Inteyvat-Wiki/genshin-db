					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 413111503,
					"content": "複雑すぎて全部覚えられなかったけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 413111504,
					"content": "大丈夫よ、覚えきれなかったら、また景明に「霄灯」の作り方を聞きに行けばいいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111505
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 413111505,
					"content": "よし、私はそろそろ仕事に行かなきゃ。海灯祭を楽しんでね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "望雅"
				}
			]
		},
