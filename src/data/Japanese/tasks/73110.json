	"talks": [
		{
			"id": 7311001,
			"completionStepIds": [
				7311001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7311001",
							"2"
						],
						"stepId": 7311001,
						"stateName": "QUEST_STATE_UNFINISHED"
