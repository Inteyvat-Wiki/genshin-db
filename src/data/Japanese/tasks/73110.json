			},
			"dialogs": [
				{
					"id": 731100701,
					"content": "「羊呑の岩」を探索した。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100702
					]
				},
				{
					"id": 731100702,
					"content": "なんと、危険な目には遭わなかったか？だが…お前たちの腕なら、トトメスに会っても無事に済んだだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100703
					],
					"speakerTitle": "ソヘイル"
				},
				{
					"id": 731100703,
					"content": "羊呑の岩を探索した経緯をソヘイルに伝え、石板を渡した。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731100704
					]
				},
				{
					"id": 731100704,
					"content": "やはりアジトが…当時あれほど警戒したにも関わらず、トトメスに強奪されたのも無理はない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100705
					],
					"speakerTitle": "ソヘイル"
				},
				{
					"id": 731100705,
					"content": "まったく眼識のないやつめ。キングデシェレトを信仰していると言いながら、重要な遺物を適当に置いておくとは…全くもって…許せん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100706
					],
					"speakerTitle": "ソヘイル"
				},
				{
					"id": 731100706,
					"content": "教令院を代表してお前たちに感謝する。やつらからこの価値ある…あー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100707
					],
					"speakerTitle": "ソヘイル"
				},
				{
					"id": 731100707,
					"content": "どうして急に眉をひそめるんだ？もしかしてすっごく解読しにくい内容だったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100708
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731100708,
					"content": "いや、その逆だ。これは…愛の詩なのだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100709
					],
					"speakerTitle": "ソヘイル"
				},
				{
					"id": 731100709,
					"content": "知論派のやつらの方が、この石板の価値を理解できるだろうな。やつらの論文の題名まで、想像がつく——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100710
					],
					"speakerTitle": "ソヘイル"
				},
				{
					"id": 731100710,
					"content": "『修辞の発展と文明の発展の関連性に関する初歩的考察』。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ソヘイル"
				}
			]
		},
