							"2"
						],
						"stepId": 7311001,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302515",
							"3"
						],
						"stepId": 7302515,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"ソヘイル"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731100101,
					"content": "ふぅ…涼しくなったな。すまんが、石板をちょっと見せてくれんか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100102
					],
					"speakerTitle": "ソヘイル"
				},
				{
					"id": 731100102,
					"content": "ソヘイルは石板を手に持つと、じっくり確かめた。時に眉をしかめ、驚きの声を上げながら。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731100103
					]
				},
				{
					"id": 731100103,
					"content": "おい…じっくり見すぎだろ！まさかその内容を暗記して、報酬を払わないつもりか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731100104,
					"content": "すまんすまん。見入ってしまってな。わしもこのような文献を目にするのは初めてだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100105
					],
					"speakerTitle": "ソヘイル"
				},
				{
					"id": 731100105,
					"content": "何かわかった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100106
					]
				},
				{
					"id": 731100106,
					"content": "ふむ…少しだがな。何かのプロジェクトの記録のようだ…中には「アアル」の話もあったが、アアル村とどんな関係があるかはわからん。これ以上の言及がないのは残念だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100107
					],
					"speakerTitle": "ソヘイル"
				},
				{
					"id": 731100107,
					"content": "だが、この発見は特筆の価値がある。ありがとう、これが約束の報酬だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100108,
						731100109
					],
					"speakerTitle": "ソヘイル"
				},
				{
					"id": 731100108,
					"content": "どういたしまして。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100112
					]
				},
				{
					"id": 731100109,
					"content": "ティルザードに感謝すべきだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100110
					]
				},
				{
					"id": 731100110,
					"content": "そうだぞ。ティルザードが嘘をついてないって証明するためじゃなきゃ、オイラたちはこの石板を見つけてこなかったんだからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731100111,
					"content": "その通りだ。ティルザードに感謝せんとな。ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100112
					],
					"speakerTitle": "ソヘイル"
				},
				{
					"id": 731100112,
					"content": "次は、より多くの文献を見つけねば。だが、砂漠に入らんと手に入れにくいな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100113
					],
					"speakerTitle": "ソヘイル"
				},
				{
					"id": 731100113,
					"content": "あっ…思いついたぞ！お前たち、これから時間があるなら、不躾ながらお願いがあるのだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100114
					],
					"speakerTitle": "ソヘイル"
				},
				{
					"id": 731100114,
					"content": "ソヘイルさん、もしかして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100115
					],
					"speakerTitle": "ハルワニ"
				},
				{
					"id": 731100115,
					"content": "学者の皆さんは砂漠に入ってはならないというのが、賢者様のお達しのはずです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100116
					],
					"speakerTitle": "ハルワニ"
				},
				{
					"id": 731100116,
					"content": "いやいや、誤解するでない。賢者様の命令に背くわけではないぞ。だが、賢者様のお申しつけに、「贈り物を送ってはならない」という項目はなかろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100117
					],
					"speakerTitle": "ソヘイル"
				},
				{
					"id": 731100117,
					"content": "贈り物？何かいいものをくれるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731100118,
					"content": "とても大事なものだぞ——わしの考古ノートだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100119
					],
					"speakerTitle": "ソヘイル"
				},
				{
					"id": 731100119,
					"content": "実を言うと、わしも十数年前、砂漠に入ったことがあるのだが、何も特別な発見はなかった。怪しい場所に残された何箇所かの遺跡の位置だけを、記録した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100120
					],
					"speakerTitle": "ソヘイル"
				},
				{
					"id": 731100120,
					"content": "数年経って、またここに戻り、お前たちと出会ったのは、きっと何かの運命だと思ったのだ。だから、このノートをお前たちに授けよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100121
					],
					"speakerTitle": "ソヘイル"
				},
				{
					"id": 731100121,
					"content": "貴方は…？わかりました。確かに賢者様のお申しつけに反してはいませんが、このような行動はしょせん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100122
					],
					"speakerTitle": "ハルワニ"
				},
				{
					"id": 731100122,
					"content": "#行動とは何だ？ただ大英雄の{NICKNAME}と小さな英雄のパイモンと出会った記念に、プレゼントを贈っただけだ。筋が通っているだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100123
					],
					"speakerTitle": "ソヘイル"
				},
				{
					"id": 731100123,
					"content": "筋…ですか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100124,
						731100125
					],
					"speakerTitle": "ハルワニ"
				},
				{
					"id": 731100124,
					"content": "すごく筋が通ってる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100130
					]
				},
				{
					"id": 731100125,
					"content": "あんまり通ってない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100126
					]
				},
				{
					"id": 731100126,
					"content": "あっ…この贈り物では、物足りなかったかな？ふむ…これは挨拶代わりのものだ！後で、もっとちゃんとしたものを用意しよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100127
					],
					"speakerTitle": "ソヘイル"
				},
				{
					"id": 731100127,
					"content": "えっと、オイラは結構筋が通ってると思うけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731100128,
					"content": "小さな英雄も同意してくれたことだし、大英雄も…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100129
					],
					"speakerTitle": "ソヘイル"
				},
				{
					"id": 731100129,
					"content": "うん…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100130
					]
				},
				{
					"id": 731100130,
					"content": "ふぅ。学者の世界って複雑すぎるぞ！オイラたちに調査を依頼したいだけなのに、プレゼントを贈るなんて言って…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100131
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731100131,
					"content": "要するに、隣にいるデカいやつが賢者に告げ口するのが怖いだけだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100132,
						731100134,
						731100136
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731100132,
					"content": "パイモンの世界が簡単すぎるんだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100133
					]
				},
				{
					"id": 731100134,
					"content": "パイモンにもちゃんとわかったんだ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100135
					]
				},
				{
					"id": 731100136,
					"content": "彼にも事情がある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100137
					]
				},
				{
					"id": 731100133,
					"content": "そうか？オイラは結構複雑だと思うけどな。なんてったって、色んな食べ物の味も覚えなきゃいけないし…いっぱいある宝物の入手方法だって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100141
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731100234,
					"content": "それに、アランナラ名前もたくさん覚えなきゃいけないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100242
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731100135,
					"content": "当たり前だろ！顔に「助けてくれ」って書いてあったぞ！それに、今助けてやったら、絶対報酬をたんまりもらえるからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100141
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731100137,
					"content": "それはそうだけど。学者たちって、知識の追求を盾にしてるような気がするぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100138
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731100138,
					"content": "これさえ口にすれば、なんでも正当化出来る。なに言ったって、なにしたって、ちゃんとした理由になるもんな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100139
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731100139,
					"content": "パイモンはそうならないようにね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100140
					]
				},
				{
					"id": 731100140,
					"content": "ならないぞ！オイラは知識なんかに興味ないしな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100141
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731100141,
					"content": "それより、さっそくソヘイルからのプレゼントを見て、どんなことを記録してあるのか確認しようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100142
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731100142,
					"content": "へえ…本当に色々あったんだな。キングデシェレトの霊廟の近くで一ヶ月も探索して、なんの収穫もなくて。でも、諦めずに探してたら、「透明遺跡」をいくつか見つけたらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100143
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731100143,
					"content": "それから、キングデシェレトの霊廟より遥かに小さい「飽飲の霊廟」を見つけたんだよな。でも最終的に、「羊呑の岩」ってとこで傭兵たちに襲われて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100144
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731100144,
					"content": "わぁ、あいつの記録を見ろよ、けっこう苦労してたみたいだぞ。それなのに、「笑われるよりも辛いのは、知識が増えなかったことだ。」だってさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100145
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731100145,
					"content": "今とは別人みたいだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100146
					]
				},
				{
					"id": 731100146,
					"content": "当時のソヘイルは、真剣に知識を追い求めていたみたいだな…オイラ感動したぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100147
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731100147,
					"content": "こうしてみると、あいつがこれを貴重なプレゼントって言うのも、大げさじゃなかったのかもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100148
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731100148,
					"content": "それじゃ、あいつの言ってた場所をまわってみよう！何か発見出来たら、持ち帰って、あいつへのお返しにしてやろうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
