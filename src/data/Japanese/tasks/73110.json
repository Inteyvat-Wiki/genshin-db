			"dialogs": [
				{
					"id": 731100801,
					"content": "「飽飲の霊廟」を探索した。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100802
					]
				},
				{
					"id": 731100802,
					"content": "飽飲の霊廟に行ってきたのか。わしの言った通り、キングデシェレトの霊廟の縮小版だっただろう。で、何か収穫はあったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100803
					],
					"speakerTitle": "ソヘイル"
				},
				{
					"id": 731100803,
					"content": "飽飲の霊廟を探索した経緯をソヘイルに伝え、石板を渡した。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731100804
					]
				},
				{
					"id": 731100804,
					"content": "ふむ…特別な発見はなさそうだな…だが、飽飲の霊廟とキングデシェレトの霊廟との違いは、大きさだけではなかったようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100805
					],
					"speakerTitle": "ソヘイル"
				},
				{
					"id": 731100805,
					"content": "この石板は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100806
					],
					"speakerTitle": "ソヘイル"
				},
				{
					"id": 731100806,
					"content": "なあなあ、なんて書いてあったんだよ？文字がこんなにいっぱい書いてあるんだから、絶対研究する価値もあるだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100807
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731100807,
					"content": "ふむ…わしの見た限りでは、これは一般的な動物をモチーフした寓話だな。",
