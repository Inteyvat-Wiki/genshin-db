			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ソヘイル",
					"ハルワニ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731100501,
					"content": "これで、三つの遺跡の探索は完成した。わしの心配事も解決したな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100502
					],
					"speakerTitle": "ソヘイル"
				},
				{
					"id": 731100502,
					"content": "では、友情を深めた証に、大英雄と小さな英雄への感謝を示して、プレゼントをさらに用意しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100503,
						731100505
					],
					"speakerTitle": "ソヘイル"
				},
				{
					"id": 731100503,
					"content": "気を使わなくていいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100504
					]
				},
				{
					"id": 731100504,
					"content": "大したことじゃないぞ。オイラたちもおまえのノートを頼りに、たくさんの宝物を見つけたからな！そうだ、論文はどうなったんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100507
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731100507,
					"content": "論文か…少しばかり頭が痛いな…新しい論文を書くことはできるが、わしはもう量で勝つという年ではなくなったからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100508
					],
					"speakerTitle": "ソヘイル"
				},
				{
					"id": 731100508,
					"content": "何か突破的な成果を出さねば…やはりキングデシェレトの霊廟に入らんことには…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100509
					],
					"speakerTitle": "ソヘイル"
				},
				{
					"id": 731100509,
					"content": "賢者様は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100510
					],
					"speakerTitle": "ハルワニ"
				},
				{
					"id": 731100510,
					"content": "ああ、わかっておる。何かと言えば「賢者様」と、わしはただ愚痴をこぼしただけだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100511
					],
					"speakerTitle": "ソヘイル"
				},
				{
					"id": 731100511,
					"content": "どうしてそんなに成果が欲しいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100512
					]
				},
				{
					"id": 731100512,
					"content": "もちろん、次の賢者に立候補するためだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100513
					],
					"speakerTitle": "ソヘイル"
				},
				{
					"id": 731100513,
					"content": "他人から見れば、賢者と学者の差など、小さな夕暮れの実と大きな夕暮れの実の差のようなものかもしれん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100514
					],
					"speakerTitle": "ソヘイル"
				},
				{
					"id": 731100514,
					"content": "しかし実際のところ、賢者とわしら普通の学者の差は、ヒルチャールとスライムの差より大きいのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100515,
						731100517
					],
					"speakerTitle": "ソヘイル"
				},
				{
					"id": 731100515,
					"content": "全然関係ない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100516
					]
				},
				{
					"id": 731100516,
					"content": "そう、その通り。全く別ものなのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100519
					],
					"speakerTitle": "ソヘイル"
				},
				{
					"id": 731100519,
					"content": "賢者たちは権力を掌握している。それはつまり、すべての学者の首を絞めているようなものだ。学者は生きるも、死ぬも、賢者様のお言葉次第。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100520
					],
					"speakerTitle": "ソヘイル"
				},
				{
					"id": 731100520,
					"content": "多くの人は論文のために一生懸命頑張っている。わしだって…この年で体面のことも気にせず、ただ賢者様のご注目を願うばかりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100521
					],
					"speakerTitle": "ソヘイル"
				},
				{
					"id": 731100521,
					"content": "だから、わしは絶対賢者になるぞ。そうせねば、過去に受けた屈辱も、苦しみも痛みも、すべてが無意味なものになる。お前も学者なら、わしの考えを理解できるだろう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100522
					],
					"speakerTitle": "ソヘイル"
				},
				{
					"id": 731100522,
					"content": "#いや、{NICKNAME}は考古ノートの方のおまえに似てると思うぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100523
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731100523,
					"content": "考古ノート？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100524
					],
					"speakerTitle": "ソヘイル"
				},
				{
					"id": 731100524,
					"content": "うん！「笑われるよりも辛いのは、知識が増えなかったことだ。」これはおまえが考古ノートに書いた言葉だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100525
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731100525,
					"content": "何？わしがそんなものを？ふむ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100526
					],
					"speakerTitle": "ソヘイル"
				},
				{
					"id": 731100526,
					"content": "うむ…確かにそのような日々もあった。お前たちが思い出させてくれなければ、頭をよぎることもなかっただろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100527,
						731100528
					],
					"speakerTitle": "ソヘイル"
				},
				{
					"id": 731100527,
					"content": "忘れてたんだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100529
					]
				},
				{
					"id": 731100529,
					"content": "#ふぅ…{NICKNAME}、パイモン。突然じゃが、また不躾なお願いがある…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100530
					],
					"speakerTitle": "ソヘイル"
				},
				{
					"id": 731100530,
					"content": "えっ…？まさか、また石板を探せってか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100531
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731100531,
					"content": "いやいやいや、石板はもう十分だ…ただ…あの古いノートをもう一度、読みたくなったのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100532
					],
					"speakerTitle": "ソヘイル"
				},
				{
					"id": 731100532,
					"content": "お前たちにあげた考古ノートを、返してもらえんか？お礼は他のものを用意してやろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100533
					],
					"speakerTitle": "ソヘイル"
				},
				{
					"id": 731100533,
					"content": "いいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100534
					]
				},
				{
					"id": 731100534,
					"content": "ああ、色々駆け回ってきてくれて、ありがとう。お前たちの旅が上手くいくよう祈る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100535
					],
					"speakerTitle": "ソヘイル"
				},
				{
					"id": 731100535,
					"content": "それと、若い頃を思い出させてくれてありがとうな。悪くない気持ちだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ソヘイル"
				},
				{
					"id": 731100528,
					"content": "思い出せてよかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100529
					]
				},
				{
					"id": 731100517,
					"content": "その差は…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100518
					]
				},
				{
					"id": 731100518,
					"content": "差と言うよりも、それらはそもそも別ものなのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100519
					],
					"speakerTitle": "ソヘイル"
				},
				{
					"id": 731100505,
					"content": "お互い必要なものを手に入れただけ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100506
					]
				},
				{
					"id": 731100506,
					"content": "そうそう！オイラたちは宝物をゲットした。おまえもこれで論文が書けるだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100507
					],
					"speakerTitle": "パイモン"
				}
			]
		},
