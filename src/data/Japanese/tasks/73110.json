			},
			"dialogs": [
				{
					"id": 731100601,
					"content": "「透明遺跡」を探索した。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100602
					]
				},
				{
					"id": 731100602,
					"content": "ほう、「透明遺跡」に行ってきたのか。収穫は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100603
					],
					"speakerTitle": "ソヘイル"
				},
				{
					"id": 731100603,
					"content": "もちろんあったぞ！それも、驚くほどのやつだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731100604,
					"content": "透明遺跡を探索した経緯をソヘイルに伝え、三つの石板を渡した。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731100605
					]
				},
				{
					"id": 731100605,
					"content": "おお…！やはり、謎の力の裏には、キングデシェレトの明かされぬ秘密があったのか。じっくり研究してみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100606
					],
					"speakerTitle": "ソヘイル"
				},
				{
					"id": 731100606,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100607
					],
					"speakerTitle": "ソヘイル"
				},
				{
					"id": 731100607,
					"content": "これは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100608
					],
					"speakerTitle": "ソヘイル"
				},
				{
					"id": 731100608,
					"content": "そんな…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100609
					],
					"speakerTitle": "ソヘイル"
				},
				{
					"id": 731100609,
					"content": "お、おい、顔色が悪いぞ。何か怖いことでもわかったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100610
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731100610,
					"content": "ああ…すまん。怖いわけではない…石板の内容は複雑に見えるが、その正体は…休暇申請の記録だけなのだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100611
					],
					"speakerTitle": "ソヘイル"
				},
				{
					"id": 731100611,
					"content": "しかも、休暇の理由も、今の若い学者どもとそう変わらん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100612
					],
					"speakerTitle": "ソヘイル"
				},
				{
					"id": 731100612,
					"content": "ふう。当時、透明遺跡に入る方法を知らなくてよかったわい。でなければ、カッとなって頭がおかしくなったかもしれん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100613
					],
					"speakerTitle": "ソヘイル"
				},
				{
					"id": 731100613,
					"content": "ともあれ、これらの石板を持ってきてくれてありがとう。モンド人にも休暇の理由を聞いてくれば、論文が書けるはずじゃ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100614
					],
					"speakerTitle": "ソヘイル"
				},
				{
					"id": 731100614,
					"content": "『忙裏閑を偸む——異なる社会における休暇に対する認識の変遷』。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ソヘイル"
				}
			]
		},
		{
			"id": 7311007,
			"completionStepIds": [
				7311004
			],
