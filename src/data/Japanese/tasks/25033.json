			"dialogs": [
				{
					"id": 250330101,
					"content": "いい子、いい子。お腹いっぱいになった？訓練できそう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330102
					],
					"speakerTitle": "トゥラテ"
				},
				{
					"id": 250330102,
					"content": "キュ、キュー、キュキュー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330103
					],
					"speakerTitle": "チーカ"
				},
				{
					"id": 250330103,
					"content": "へへっ、元気いっぱいだ！じゃあ、今日も頑張ろっか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330104
					],
					"speakerTitle": "トゥラテ"
				},
				{
					"id": 250330104,
					"content": "一緒に頑張る！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330106
					]
				},
				{
					"id": 250330106,
					"content": "#ん？あっ、こんにちは、{M#お兄ちゃん}{F#お姉ちゃん}！今、山登りの訓練をしてるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330107
					],
					"speakerTitle": "トゥラテ"
				},
				{
					"id": 250330107,
					"content": "キュー！キュー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330108
					],
					"speakerTitle": "チーカ"
				},
				{
					"id": 250330108,
					"content": "キュー、キュー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330109,
						250330112
					],
					"speakerTitle": "チーカ"
				},
				{
					"id": 250330109,
					"content": "訓練の調子はどう？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330110
					]
				},
				{
					"id": 250330110,
					"content": "うーん…前よりもだいぶ高いところまで登れてるから、「よくなってる」よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330111
					],
					"speakerTitle": "トゥラテ"
				},
				{
					"id": 250330111,
					"content": "ただ、山を登る時の動きがちょっと不慣れな感じってだけで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330116
					],
					"speakerTitle": "トゥラテ"
				},
				{
					"id": 250330116,
					"content": "#{M#お兄ちゃん}{F#お姉ちゃん}、もう一度お手本を見せてくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330117,
						250330121
					],
					"speakerTitle": "トゥラテ"
				},
				{
					"id": 250330117,
					"content": "いいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330118
					]
				},
				{
					"id": 250330118,
					"content": "#ありがとう！今度こそちゃんと{M#お兄ちゃん}{F#お姉ちゃん}の動きを覚えるからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330119
					],
					"speakerTitle": "トゥラテ"
				},
				{
					"id": 250330119,
					"content": "チーカもちゃんと見とくんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330120
					],
					"speakerTitle": "トゥラテ"
				},
				{
					"id": 250330120,
					"content": "キュッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330123
					],
					"speakerTitle": "チーカ"
				},
				{
					"id": 250330123,
					"content": "#それじゃあ、よろしくね、{M#お兄ちゃん}{F#お姉ちゃん}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330124
					],
					"speakerTitle": "トゥラテ"
				},
				{
					"id": 250330124,
					"content": "僕たちは下から見て、タイムを測るから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330125
					],
					"speakerTitle": "トゥラテ"
				},
				{
					"id": 250330125,
					"content": "キュー、キュー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "チーカ"
				},
				{
					"id": 250330121,
					"content": "今度こそちゃんと見て覚えてね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330122
					]
				},
				{
					"id": 250330122,
					"content": "もちろん。チーカと二人で目を凝らして、絶対にどんな動きも見逃さないよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330123
					],
					"speakerTitle": "トゥラテ"
				},
				{
					"id": 250330112,
					"content": "着々と元気になってるみたいだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330113
					]
				},
				{
					"id": 250330113,
					"content": "もちろん！僕はチーカの世話が上手だってお母さんも言ってた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330114
					],
					"speakerTitle": "トゥラテ"
				},
				{
					"id": 250330114,
					"content": "チーカはすごく成長したよ！前よりもずっと高いところまで登れるようになったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330115
					],
					"speakerTitle": "トゥラテ"
				},
				{
					"id": 250330115,
					"content": "ただ、山を登る時の動きがちょっと不慣れな感じってだけで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330116
					],
					"speakerTitle": "トゥラテ"
				}
			]
