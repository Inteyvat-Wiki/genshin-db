					"nextDialogs": [
						250330204
					]
				},
				{
					"id": 250330204,
					"content": "#僕やチーカより全然速いよ…{M#お兄ちゃん}{F#お姉ちゃん}はもう十分速いと思う！",
					"roleType": "TALK_ROLE_NPC",
