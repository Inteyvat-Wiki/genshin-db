					"nextDialogs": [
						250330212
					],
					"speakerTitle": "チーカ"
				},
				{
					"id": 250330212,
					"content": "#{M#お兄ちゃん}{F#お姉ちゃん}、助けてくれてありがとう。はい、この果物あげるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330213
					],
					"speakerTitle": "トゥラテ"
				},
				{
					"id": 250330213,
					"content": "さっきチーカが採ってきたばっかりなんだ。前よりだいぶ速くなったんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330214
					],
					"speakerTitle": "トゥラテ"
				},
				{
					"id": 250330214,
					"content": "#えへへ、{M#お兄ちゃん}{F#お姉ちゃん}がいいお手本を見せてくれたおかげだよ！チーカ、すっごく成長したんだ！",
