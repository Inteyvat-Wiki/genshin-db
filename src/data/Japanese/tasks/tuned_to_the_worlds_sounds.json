			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"楓原万葉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700300301,
					"content": "風はまだお主の来訪を知らせていなかった、それなのにここに現れるとは。実に見事でござる、如何にしてそのようなことが？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300302
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 700300302,
					"content": "えへへ、こいつはおまえが思ってるよりもすごいってことだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700300303,
					"content": "コホン、これで足りる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300304
					]
				},
				{
					"id": 700300304,
					"content": "見せてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "楓原万葉"
				}
			]
		},
		{
			"id": 7003004,
			"completionStepIds": [
				7003007
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7003007",
