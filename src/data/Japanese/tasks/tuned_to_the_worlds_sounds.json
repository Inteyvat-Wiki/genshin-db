			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"楓原万葉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700300401,
					"content": "うむ、質の良い琉璃百合でござる、これなら十分でござろう。これらをすり潰し、出てきた液に琴を浸ければ蘇るはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300402
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 700300402,
					"content": "うむ——この懐かしい感じ、目覚めたようでござるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300403
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 700300403,
					"content": "さあ、試してみるとよい、あとはお主に託そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300404
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 700300404,
					"content": "託そうってどういう意味？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300405
					]
				},
				{
					"id": 700300405,
					"content": "ははっ、詩人も時には言葉を素直に伝えるのでござるよ。「お主に託そう」とは、文字通りこの琴をお主に贈るという意味でござるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300406
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 700300406,
					"content": "再び璃月を訪れたのは、この地を聞くため。岩神が守るこの古き大地で、止まぬささやきを聞くことができた、拙者はもう満足でござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300407
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 700300407,
					"content": "もちろん、いつの日かこの琴が不要になったら、拙者はそれを取りに来よう。しかし…その日が来ないことを願っておる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300408
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 700300408,
					"content": "さあ、拙者は旅を続けるでござる。こんな時、璃月人であればなんと言うのでござろうか？ふむ…きっとこうでござるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300409
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 700300409,
					"content": "#{NICKNAME}、「またいつの日か会おう」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "楓原万葉"
				}
			]
		}
	]
