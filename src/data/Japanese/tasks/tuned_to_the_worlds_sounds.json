			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"重佐"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700300101,
					"content": "よっ！旅人、久しぶりだな、元気か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300102
					],
					"speakerTitle": "重佐"
				},
				{
					"id": 700300102,
					"content": "会ったことあったっけ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300103
					]
				},
				{
					"id": 700300103,
					"content": "おい…お前さん…もう俺のことを忘れたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300104
					],
					"speakerTitle": "重佐"
				},
				{
					"id": 700300104,
					"content": "俺は「死兆星」号の副船長の重佐だよ。この前、うちの「死兆星」号に乗って稲妻まで行っただろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300105
					],
					"speakerTitle": "重佐"
				},
				{
					"id": 700300105,
					"content": "いやいや、重佐副船長、おまえのことならもちろん覚えてるぞ。こいつ、また冗談を言ってるんだ、ははは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700300106,
					"content": "おっと——なんだ、そうだったのか！まあ、なにしろ俺は「死兆星」号の副船長だしな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300107
					],
					"speakerTitle": "重佐"
				},
				{
					"id": 700300107,
					"content": "コホン、何か手伝ってほしいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300108
					]
				},
				{
					"id": 700300108,
					"content": "あぁ、いや、実は俺のことじゃなくて、うちの船隊に滞在してる万葉の兄ちゃんのことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300109
					],
					"speakerTitle": "重佐"
				},
				{
					"id": 700300109,
					"content": "お前さんも覚えてるよな？稲妻から帰港する時、あいつも俺たちと一緒に帰ることを選んだだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300110
					],
					"speakerTitle": "重佐"
				},
				{
					"id": 700300110,
					"content": "璃月へと戻る途中、あいつはどうも機嫌が良かったみたいで、航海中にみんなと詩を読んだり、歌を作ったりしてさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300111
					],
					"speakerTitle": "重佐"
				},
				{
					"id": 700300111,
					"content": "ただ残念なことに、俺たちの船じゃ北斗姉さんから小月まで、あいつのように…その…えーと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300112,
						700300114
					],
					"speakerTitle": "重佐"
				},
				{
					"id": 700300112,
					"content": "趣！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300113
					]
				},
				{
					"id": 700300113,
					"content": "そうそう！趣！あいつのように趣の分かるやつはいないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300116
					],
					"speakerTitle": "重佐"
				},
				{
					"id": 700300116,
					"content": "そのせいか璃月に着いた途端、あいつは船から降りて、色んなところを見て回るためどこかに行っちまった。ずっと船にいたし、きっと退屈してたんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300117
					],
					"speakerTitle": "重佐"
				},
				{
					"id": 700300117,
					"content": "でも離れて間もなく、あいつからお前さんの行方を気に留めるよう連絡が届いた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300118
					],
					"speakerTitle": "重佐"
				},
				{
					"id": 700300118,
					"content": "トラブルでもあったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300119
					]
				},
				{
					"id": 700300119,
					"content": "詳しいことは分からんが、お前さんに会ったら自分のとこに来て欲しいと伝言を頼まれた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300120
					],
					"speakerTitle": "重佐"
				},
				{
					"id": 700300120,
					"content": "あの感じからして大したことじゃなさそうな気もするが、でも些細なことだったら、旅人に頼む必要もないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300121
					],
					"speakerTitle": "重佐"
				},
				{
					"id": 700300121,
					"content": "#オイラたち、些細なことでもよく手伝ってるよな、{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300122,
						700300123,
						700300124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700300122,
					"content": "うん、ハトの餌やりとか。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300125
					]
				},
				{
					"id": 700300125,
					"content": "おお——それは意外だな、そんなことまで手伝ってるとは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300126
					],
					"speakerTitle": "重佐"
				},
				{
					"id": 700300126,
					"content": "どうりで北斗姉さんがお前さんのことを高く買ってるわけだ。北斗姉さんが言うようにお前さんは「人情」に厚いんだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300127
					],
					"speakerTitle": "重佐"
				},
				{
					"id": 700300127,
					"content": "おっと！ついお喋りしすぎた。早く万葉の兄ちゃんのとこに行ってやってくれ。あいつは多分、璃月港の北側にいるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300128
					],
					"speakerTitle": "重佐"
				},
				{
					"id": 700300128,
					"content": "俺は船隊のこともある、この辺で失礼するよ。じゃあ、気をつけてな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "重佐"
				},
				{
					"id": 700300123,
					"content": "うん、レストランの配達とか。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300125
					]
				},
				{
					"id": 700300124,
					"content": "うん、掃除とか。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300125
					]
				},
				{
					"id": 700300114,
					"content": "変わった感性！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300115
					]
				},
				{
					"id": 700300115,
					"content": "いやいや、趣と言うべきだな！あいつのように趣の分かるやつはいないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300116
					],
					"speakerTitle": "重佐"
				}
			]
		},
		{
			"id": 7003002,
			"completionStepIds": [
				7003004
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7003004",
							"2"
						],
						"stepId": 7003004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"楓原万葉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700300201,
					"content": "琴の音はしんと響き、龍角は枯れゆく、弦のみが世を繋ぎ、ただ独り老いゆく…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300202
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 700300202,
					"content": "よっ！万葉の兄ちゃん！ここにいたんだな？オイラたちが手伝いに来たぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700300203,
					"content": "おや？お主ら来てくれたか、久方ぶりでござるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300204
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 700300204,
					"content": "パイモンから「万葉の兄ちゃん」と呼ばれるのも、これまた趣がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300205
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 700300205,
					"content": "えへへ、重佐副船長のマネだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300206,
						700300207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700300206,
					"content": "のんびりしてたみたいだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300208
					]
				},
				{
					"id": 700300208,
					"content": "ははっ、拙者が暗き運命を背負い、歩みを重くするような者だと思うか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300209
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 700300209,
					"content": "重佐副船長から頼み事があるって聞いたのに、ここでのんびりと景色を眺めながら詩を読んでるなんて思わなかったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700300210,
					"content": "稲妻の一件が終わり、今や拙者の心に他念はない。璃月を再び訪ねるには、この地の詩を学び、綺麗な音を聴かねばならぬ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300211
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 700300211,
					"content": "お主らの手を借りたいことも本来はなかったが、お主らがここに来るのが一歩遅れたため、今はある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300212
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 700300212,
					"content": "んん？意味が分からないぞ。「本来はなかったが…今はある…」って、なんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700300213,
					"content": "おまえ、山の中でなにか悪いものでも食ったのか？なに言ってるのか全然伝わってこないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700300214,
					"content": "しーっ…これを聞くでござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300215
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 700300215,
					"content": "どう思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300216
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 700300216,
					"content": "おっ！この音…まるで吟遊野郎が弾いてるみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300217
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700300217,
					"content": "ふむ、吟遊野郎？いつか、その人物とも会ってみたいものでござる。旅人、お主はどう思った？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300218,
						700300219
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 700300218,
					"content": "その琴は壊れてるみたいだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300220
					]
				},
				{
					"id": 700300220,
					"content": "うむ、確かにその通り。だがそれよりも肝心なのは、この琴には不思議な力がある点でござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300221
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 700300221,
					"content": "この名もない古き琴は拙者が山を越える際、失われたとある洞府で偶然見つけたもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300222
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 700300222,
					"content": "古くはあるが状態は良く、この琴を見ていたら、つい胸が高鳴り、弾いてみたくなった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300223
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 700300223,
					"content": "拙者が琴をつま弾くと、まるで誰かが共に弾いているかのような感覚に陥ったでござる。あの感覚、実に懐かしいものでござった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300224
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 700300224,
					"content": "えーと、まさか本当に幻覚が見えるようなものを食べたんじゃないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300225
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700300225,
					"content": "それはないと思うでござる。一曲弾き終わり、拙者は我に返った。そして、その洞府をよく観察すると、何かが秘められているような気がした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300226
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 700300226,
					"content": "生い茂る雑草を見たところ、その洞府は主が離れてずいぶんと久しいようでござった。しかし、机と椅子は埃を被っておらず、ほのかな香りが漂っていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300227
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 700300227,
					"content": "さらに風の中をざわめく雑音さえも静まりかえっておったでござる。このような神秘的なところは、おそらく璃月の伝説で語られる「仙境」でござろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300228
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 700300228,
					"content": "おおおおっ！ということは、その琴は仙人が残した宝物なのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300229
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700300229,
					"content": "ははっ、どうでござろう。ただこのような奇妙な出来事は、友に話すべきだと思ったのでござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300230
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 700300230,
					"content": "だが、璃月の友は姉君以外にお主しかいない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300231
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 700300231,
					"content": "姉君はこのようなことに興味がないかもしれぬ、だからお主を誘ってみたでござるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300232
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 700300232,
					"content": "そして、重佐副船長にお主のことを気に留めるよう頼んだ。残念なことに、お主らが来る前にこの琴は壊れてしまったが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300233
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 700300233,
					"content": "はぁ、これは拙者の手落ちでござる。拙者は琴を持って四方を流浪し、ついそれを弾き過ぎてしまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300234
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 700300234,
					"content": "えっ、仙人の宝物も壊れたりするのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300235
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700300235,
					"content": "あの雷神様でさえ、永遠を掴むことはできなかった…ましてや他の物であれば、なおのことでござろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300236
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 700300236,
					"content": "うぅ…お、おまえはオイラたちの塵歌壺をしっかりと守っとけよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300237
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700300237,
					"content": "幸い、この程度の損傷であれば修復できるはず。今はまるで眠っているかのようなもので、琴の中の力が時と共に散っている状態でござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300238
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 700300238,
					"content": "正しい材料さえ見つかれば、それを呼び覚ますことができるでござろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300239
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 700300239,
					"content": "拙者の耳が正しければ、その材料は…琉璃百合。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300240
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 700300240,
					"content": "どうして分かるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300241
					]
				},
				{
					"id": 700300241,
					"content": "拙者は前に言ったでござろう、風は万物のささやきを抱え、巡っていると。その中のいくつかを拙者は聞いたのでござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300242
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 700300242,
					"content": "それゆえ、この古き琴の過去を少しだけ知っておる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300243
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 700300243,
					"content": "拙者はここで待っていよう、材料のことを頼めるでござろうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300244
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 700300244,
					"content": "お主は璃月港の大英雄、これしきのこと問題ないでござろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 700300219,
					"content": "その琴は高そうだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300220
					]
				},
				{
					"id": 700300207,
					"content": "ぶらぶらしてたみたいだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300208
					]
				}
			]
		},
		{
			"id": 7003003,
