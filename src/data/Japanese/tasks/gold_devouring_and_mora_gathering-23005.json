			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ハティム"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230050301,
					"content": "前回はささやかだったが、今回は絶対に大儲けしてやる！<color=#00E1FFFF>モラミート</color>、<color=#00E1FFFF>バターチキン</color>、<color=#00E1FFFF>「お肉ツミツミ」</color>、どうだ、選べたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ハティム"
				}
			]
		},
		{
			"id": 2300504,
			"completionStepIds": [
				2300504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
