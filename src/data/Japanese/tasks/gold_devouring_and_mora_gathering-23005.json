			},
			"dialogs": [
				{
					"id": 230050901,
					"content": "この料理、どうも怪しいな…まぁいい、さっさと始めよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050902
					],
					"speakerTitle": "ハティム"
				},
				{
