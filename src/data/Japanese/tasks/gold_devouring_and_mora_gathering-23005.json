			},
			"dialogs": [
				{
					"id": 230050201,
					"content": "うむ…悪くない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050202
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230050202,
					"content": "大儲けしたみたいだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230050203
					]
				},
				{
					"id": 230050203,
					"content": "おう、旅人！お前たちのお陰で、少々儲けさせてもらった。「千金料理」にはやはり効果があるようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050204
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230050204,
					"content": "とはいえ、いつもの取引での儲けと、それほど変わらない程度だが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050205
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230050205,
					"content": "「千金料理」にふさわしい成果とはとても言えん。食べる料理を間違えたか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050206
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230050206,
					"content": "旅人、もう1回試してみよう。また「千金料理」を選んでくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050207
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230050207,
					"content": "いつも通り、<color=#00E1FFFF>モラミート</color>、<color=#00E1FFFF>バターチキン</color>、<color=#00E1FFFF>「お肉ツミツミ」</color>のうちから一品選んでくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ハティム"
				}
			]
		},
		{
			"id": 2300503,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
