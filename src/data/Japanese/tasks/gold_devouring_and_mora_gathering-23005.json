			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ハティム"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230050401,
					"content": "うーむ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050402
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230050402,
					"content": "よう、ハティム！最近調子はどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230050403,
					"content": "あー…お前たちか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050404
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230050404,
					"content": "はぁ…このしかめっ面を見れば、大体察しがつくだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050405
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230050405,
					"content": "正直に言うが、現時点で俺の財布は半分が空になった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050406
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230050406,
					"content": "おかしいな…こんなはずじゃなかったんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050407
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230050407,
					"content": "オホン…！話は戻るが、これはもしかすると…高騰の兆しかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050408
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230050408,
					"content": "人は、膝を曲げないと高く飛べないというだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050409
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230050409,
					"content": "先物市場も同じだ。いまや市場全体が底を打った。これは、もうじき反転すると考えていいんじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050410
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230050410,
					"content": "…つまり、今が底値買いの絶好のチャンスだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050411,
						230050412
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230050411,
					"content": "まだ山の中腹だったりして…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230050413
					]
				},
				{
					"id": 230050413,
					"content": "いや、俺には確信がある。これは千載一遇のチャンスだ。大儲けの機会を逃してなるものか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050414
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230050414,
					"content": "そうでもしなきゃ、カリミの偉大なる富豪、ハティム様の名がすたる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050415
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230050415,
					"content": "また助けてくれるな？友よ。もう一度「千金料理」を選んでくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050416
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230050416,
					"content": "またあの3品から選ぶの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050417
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230050417,
					"content": "ふむ…いや！底値買いをするなら、市場の好転を促すスペシャルな料理が必要だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050418
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230050418,
					"content": "実は、モンドにも富豪がいると聞いた。彼の酒造業は大変に繁盛しているそうだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050419
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230050419,
					"content": "それって…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230050420
					]
				},
				{
					"id": 230050420,
					"content": "えぇ、ディルックの旦那！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050421
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230050421,
					"content": "でも、どうして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050422
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230050422,
					"content": "ハハハッ、俺は「お肉ツミツミ」を知っているんだぞ、彼を知らないはずがなかろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050423
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230050423,
					"content": "彼が所有している酒場で、「アップルサイダー」という良き品を扱っているそうだ。それを飲めば、あの富豪の金運を多少なりとも借りれるかもしれん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050424
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230050424,
					"content": "頼む。アップルサイダーを手に入れてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230050412,
					"content": "膝を曲げるのは、脚が痛いだけの可能性も…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230050413
					]
				}
			]
		},
