			},
			"dialogs": [
				{
					"id": 230050601,
					"content": "これがあの富豪のアップルサイダーか？うーむ、なんと非凡な香りだ…目が覚めるようだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050602
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230050602,
					"content": "よし！これこそが、市場に変化をもたらす良き品だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050603
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230050603,
					"content": "この恩は一生忘れないぞ。お前たち、またあとで会おう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ハティム"
				}
			]
		},
