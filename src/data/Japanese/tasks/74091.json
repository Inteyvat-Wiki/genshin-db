			"dialogs": [
				{
					"id": 740910401,
					"content": "ああ…親切な方…ありがとう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910402
					],
					"speakerTitle": "バラン"
				},
				{
					"id": 740910402,
					"content": "大丈夫か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740910403,
					"content": "お…俺は…まだ…やれる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910404
					],
					"speakerTitle": "バラン"
				},
				{
					"id": 740910404,
					"content": "もう無理だと思うよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740910405
					]
				},
				{
					"id": 740910405,
					"content": "す…すまないが、俺をあそこの埠頭まで…つ…連れ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910406
					],
					"speakerTitle": "バラン"
				},
				{
					"id": 740910406,
					"content": "もうしゃべるなよ。オイラたちが連れて戻ってやるからさ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
