			"dialogs": [
				{
					"id": 740910501,
					"content": "アイグイさん、も…戻りました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910502
					],
					"speakerTitle": "バラン"
				},
				{
					"id": 740910502,
					"content": "あんたたち…バランを助けてくれたのか、礼を言うよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910503
					],
					"speakerTitle": "アイグイ"
				},
				{
					"id": 740910503,
					"content": "このバカめ…だから言っただろう！危険な仕事に命をかける必要はない。エティヌとの定期連絡の時に報告だけし、人を派遣してもらって処理すりゃいい、ってな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910504
					],
					"speakerTitle": "アイグイ"
				},
				{
					"id": 740910504,
					"content": "あのとき親切に教えてやったのに、お前というやつは…逆に俺のことを不真面目で職務怠慢だと言ったな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910505
					],
					"speakerTitle": "アイグイ"
				},
				{
					"id": 740910505,
					"content": "危なすぎるからお前には無理だと、俺が言ったのを覚えてるか？お前はその言葉を信じなかった。いい教訓になっただろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910506
					],
					"speakerTitle": "アイグイ"
				},
				{
					"id": 740910506,
					"content": "お…俺は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910507
					],
					"speakerTitle": "バラン"
				},
				{
					"id": 740910507,
					"content": "なんだ、まだ強がるつもりか？どれ、言ってみるがいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910508
					],
					"speakerTitle": "アイグイ"
				},
				{
					"id": 740910508,
					"content": "み、水を飲ませてください…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910509
					],
					"speakerTitle": "バラン"
				},
				{
					"id": 740910509,
					"content": "バランは水筒を見つけて中身をゴクゴクと飲み、それから乾いたパンをちぎって口に入れた。\\nその間、老人が何を言おうとも、何も聞こえないかのように飲み食いに集中していた。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740910510
					]
				},
				{
					"id": 740910510,
					"content": "ふぅ…なんとか…生き返った。ありがとう、二人がいなかったら俺は今頃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910511
					],
					"speakerTitle": "バラン"
				},
				{
					"id": 740910511,
					"content": "弔慰金をお前の両親に手渡すところだったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910512
					],
					"speakerTitle": "アイグイ"
				},
				{
					"id": 740910512,
					"content": "ふん…職務怠慢で重大な事故を引き起こして、クビになるよりはずっとマシですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910513
					],
					"speakerTitle": "バラン"
				},
				{
					"id": 740910513,
					"content": "なんだと！この…はぁ、お前とはまったく話にならんわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910514
					],
					"speakerTitle": "アイグイ"
				},
				{
					"id": 740910514,
					"content": "その…二人にこんなことを言うのは厚かましいかもしれないけど…皆の安全のためにも話させてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910515
					],
					"speakerTitle": "バラン"
				},
				{
					"id": 740910515,
					"content": "二人とも、ダイビングはできるかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910516
					],
					"speakerTitle": "バラン"
				},
				{
					"id": 740910516,
					"content": "できると言えば、まぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910517
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740910517,
					"content": "実はヒルチャールに捕まったとき、潜水服を失くしてしまったんだ。一応、前回の定期検査で予備部品が損傷してるのが分かったから、新しいものを申請してるんだが、まだ届いてなくてね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910518
					],
					"speakerTitle": "バラン"
				},
				{
					"id": 740910518,
					"content": "でもパイプのメンテナンスを怠るわけにはいかない…二人がダイビングできるなら、すまないが俺の代わりに潜ってメロピデ要塞のパイプをチェックしてもらえないだろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910519
					],
					"speakerTitle": "バラン"
				},
				{
					"id": 740910519,
					"content": "もちろん報酬は用意する。礼儀を欠くようなことはしない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910520
					],
					"speakerTitle": "バラン"
				},
				{
					"id": 740910520,
					"content": "みんなの安全に関わることなら、手伝ってやってもいいぞ。でもパイプの点検なんてすごく専門的な仕事っぽいけど、オイラたちに任せて大丈夫なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910521
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740910521,
					"content": "ああ、単純な定期検査だけだから、小さな問題しか見つからないはずだ。前回の検査ではリスクが四箇所見つかったが…処理はさほど難しくないし、今から説明しよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910522
					],
					"speakerTitle": "バラン"
				},
				{
					"id": 740910522,
					"content": "もし水中のパイプから<color=#00E1FFFF>気泡が漏れている</color>場合、水中生物…もしくは非生物による衝突が原因と思われる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910523
					],
					"speakerTitle": "バラン"
				},
				{
					"id": 740910523,
					"content": "応急処置の方法は、<color=#00E1FFFF>調整弁を操作して流量を調節し、一時的に気泡漏れを抑え</color>ればいい。たったそれだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910527
					],
					"speakerTitle": "バラン"
				},
				{
					"id": 740910527,
					"content": "ちなみに、調整弁の操作にはちょっとしたコツがある。<color=#00E1FFFF>ハンドルを回すときに気体の流量を観察しながら行うんだ。それで、流量が減少すれば手順に問題はない</color>ということになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910524
					],
					"speakerTitle": "バラン"
				},
				{
					"id": 740910524,
					"content": "ふむふむ…なんとなく理解したぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910525
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740910525,
					"content": "もし分からない点があれば、定期検査が完了する前だったらいつでも答えよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910526
					],
					"speakerTitle": "バラン"
				},
				{
					"id": 740910526,
					"content": "おう！よし、とりあえずやってみるか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
