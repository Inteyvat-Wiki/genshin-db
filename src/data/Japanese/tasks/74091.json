			"dialogs": [
				{
					"id": 740911701,
					"content": "あの面倒な点検修理作業も、助っ人が来てくれてるんだし…そんなに頑張らなくてもいいと思うが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911702,
						740911706
					],
					"speakerTitle": "アイグイ"
				},
				{
					"id": 740911702,
					"content": "この埠頭について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740911703
					]
				},
				{
					"id": 740911703,
					"content": "メロピデ要塞にあれだけたくさんあるパイプ、そのメンテナンスは俺らがやってるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911704
					],
					"speakerTitle": "アイグイ"
				},
				{
					"id": 740911704,
					"content": "だがまあ、大抵は細かい補修にすぎん。実際に大問題が起きたら、俺らじゃ手に負えんからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911705
					],
					"speakerTitle": "アイグイ"
				},
				{
					"id": 740911705,
					"content": "自分の手に負えることだけやればいい。たとえば、休みの日に街へ行き、ついでに手紙を届けてくるとか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アイグイ"
				},
				{
					"id": 740911706,
					"content": "邪魔しないでおく。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740911707
					]
				},
				{
					"id": 740911707,
					"content": "俺はどのみち暇だから、邪魔ということはないさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アイグイ"
				}
			]
		}
	]
}