			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"アイグイ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740910101,
					"content": "あいつ、まさかヒルチャールに捕まってスープにされたんじゃないだろうな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910102,
						740910103
					],
					"speakerTitle": "アイグイ"
				},
				{
					"id": 740910102,
					"content": "誰が捕まったって？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740910105
					]
				},
				{
					"id": 740910105,
					"content": "あそこを見てくれ。水面にヒルチャールの拠点があるだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910106
					],
					"speakerTitle": "アイグイ"
				},
				{
					"id": 740910106,
					"content": "まるで一晩のうちに突然現れたかのように、休まず必死に働いてやがる。はぁ…バランのやつと一緒だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910107
					],
					"speakerTitle": "アイグイ"
				},
				{
					"id": 740910107,
					"content": "もしあいつの運が良けりゃ、今ごろは鍋の中じゃなくてヒルチャールと熱く会話を交わしてるかもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910108
					],
					"speakerTitle": "アイグイ"
				},
				{
					"id": 740910108,
					"content": "ん？つまり、おまえの知り合いがあそこにいるヒルチャールに捕まったってことか？ぜんぜん焦ってないように見えるけど、助けにいかなくていいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740910109,
					"content": "助けるだって？俺は前もって言ったんだ——そんな危険な仕事に命をかける必要はない。エティヌとの定期連絡の時に報告だけし、人を派遣してもらって処理すりゃいい、ってな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910110
					],
					"speakerTitle": "アイグイ"
				},
				{
					"id": 740910110,
					"content": "そう親切に教えてやったのに、なんて言ったと思う？逆に俺のことを不真面目で、職務怠慢だって言ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910111
					],
					"speakerTitle": "アイグイ"
				},
				{
					"id": 740910111,
					"content": "あいつが先輩の経験や知識を重んじなかったのが原因なんだから、自業自得だとしか言えないね。若モンはちったぁ苦労しないとな。教訓を学ばなきゃ成長できないんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910112,
						740910113
					],
					"speakerTitle": "アイグイ"
				},
				{
					"id": 740910112,
					"content": "片方の話だけじゃ何とも判断できない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740910114
					]
				},
				{
					"id": 740910114,
					"content": "そうそう、命が優先だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740910115,
					"content": "おい、危ないぞ！あんたたち、もし怪我でもしたらどうするんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910116
					],
					"speakerTitle": "アイグイ"
				},
				{
					"id": 740910116,
					"content": "#それなら安心しろ、{NICKNAME}は強いんだぞ！じーさんはここで待っててくれ。すぐ戻ってくるからさ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740910113,
					"content": "命を落としたら成長なんてできない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740910114
					]
				},
				{
					"id": 740910103,
					"content": "なんのスープ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740910104
					]
				},
				{
					"id": 740910104,
					"content": "そこじゃないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910105
					],
					"speakerTitle": "パイモン"
				}
			]
		},
