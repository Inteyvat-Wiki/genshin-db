					"nextDialogs": [
						721290604
					]
				},
				{
					"id": 721290604,
					"content": "ああ、大丈夫だ。ゆっくりでいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "梶"
				},
				{
					"id": 721290603,
					"content": "今、頑張ってるところ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721290605
					]
				},
				{
					"id": 721290605,
					"content": "本当にダメなら無理しないでくれ。ここは危険だから、あまり長居はしない方がいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "梶"
