				"points": []
			},
			"dialogs": [
				{
					"id": 721290401,
					"content": "やるね、外国の人！雲がかなり消えた、俺の推測は正しかったようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290402
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721290402,
					"content": "この次は、蛇神の首と蛇骨鉱坑でもう2つの鎮め物を修復する必要がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290403
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721290403,
					"content": "よければ、この2つの鎮め物もお願いできるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290404
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721290404,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721290405
					]
				},
				{
					"id": 721290405,
					"content": "ご協力ありがとう。俺は金持ちではないが、ちゃんと報酬は渡すよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290406
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721290406,
					"content": "いつ実現できるかは分からないが、家族と友人が帰って来る日がまた一歩近づいたな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290407
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721290407,
					"content": "ちなみに、それが済んだら島の西側にいるから来てくれ。無明砦にも抵抗軍に侵されたから、この異変に関係があるかもね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "梶"
				}
			]
		},
