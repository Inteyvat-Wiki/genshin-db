			"dialogs": [
				{
					"id": 721290201,
					"content": "あなたが鎮め物を見つめていると、奇妙な力が突然あなたに流れ込む。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290202
					],
					"speakerTitle": "鎮め物に触れる"
				},
				{
					"id": 721290202,
					"content": "あなたは、それがあなたを拒否しているのではなく、あなたに何かを求めていることに気付いた……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290203
					],
					"speakerTitle": "鎮め物に触れる"
				},
				{
					"id": 721290203,
					"content": "…この鎮め物には何か欠けているようだ、この辺りを探してみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721290204,
					"content": "元素視角を使って、この辺りの元素の痕跡を調べたら、手がかりがあるかもしれないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
