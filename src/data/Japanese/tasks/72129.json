				"points": []
			},
			"dialogs": [
				{
					"id": 721290101,
					"content": "独特な形をした石灯籠。不穏なエネルギーを放っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290102
					],
					"speakerTitle": "観察"
				},
				{
					"id": 721290102,
					"content": "この石灯籠おかしいぞ…なんだか気分が悪くなってきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721290103,
					"content": "ん、なにか書いてあるぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721290104,
					"content": "「通りがかった旅人よ、この鎮め物に何か疑問を感じたら、無想刃狭間にいる梶さんへご相談を。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290105
					],
					"speakerTitle": "観察"
				},
				{
					"id": 721290105,
					"content": "字の感じからして、書かれたのはつい最近のようだ。その下には雨で滲んではいるものの、小さな字で何か書いてある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290106
					],
					"speakerTitle": "観察"
				},
				{
					"id": 721290106,
					"content": "「…梶さんに伝えなさい、私たちは…を試した。残念だが…近くで…を見つけるかもしれない…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290107
					],
					"speakerTitle": "観察"
				},
				{
					"id": 721290107,
					"content": "「…梶さんになるべく早く避難場所へ来いと伝えなさい。家族が彼に会いたがってる。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290108
					],
					"speakerTitle": "観察"
				},
				{
					"id": 721290108,
					"content": "この梶さんっていう人が石灯籠と関係してるみたいだ。無想刃狭間に行って聞いてみよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7212902,
			"completionStepIds": [
				7212905
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
