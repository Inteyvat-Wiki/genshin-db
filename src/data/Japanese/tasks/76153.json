			"dialogs": [
				{
					"id": 761530101,
					"content": "出版業は儲からないし、いっそ投資で稼ぐか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530102
					],
					"speakerTitle": "サビト"
				},
				{
					"id": 761530102,
					"content": "投資証券を見せてくれる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761530103
					]
				},
				{
					"id": 761530103,
					"content": "はいよ！一枚二千モラ、決算は週一回です。へへっ、この袋の中に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530104
					],
					"speakerTitle": "サビト"
				},
				{
					"id": 761530104,
					"content": "…うっ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530105
					],
					"speakerTitle": "サビト"
				},
				{
					"id": 761530105,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761530106
					]
				},
				{
					"id": 761530106,
					"content": "ヤフォダさん、どうしてここに？も、もしかして、ネフェルさんから何か…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530107
					],
					"speakerTitle": "サビト"
				},
				{
					"id": 761530107,
					"content": "いや？ただ友達と一緒にぶらっと寄っただけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530108
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761530108,
					"content": "へへっ、サビトさんの投資ビジネス、かなり上手くいってるみたいだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530109
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761530109,
					"content": "いやいや！ぼちぼちですよ、ははは…こんな小さな商売じゃ、大した稼ぎにはなりません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530110
					],
					"speakerTitle": "サビト"
				},
				{
					"id": 761530110,
					"content": "（この娘…何か含みがありそうだな…きっとネフェルの指示だろう…ちっ。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530111
					],
					"speakerTitle": "サビト"
				},
				{
					"id": 761530111,
					"content": "本当に儲かるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761530112
					]
				},
				{
					"id": 761530112,
					"content": "もちろん。姐さんが言ってたんだ。サビトさんは一番評判が高くて、一番腕の立つ商人だってね。彼のところで投資すれば、間違いないってさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530113
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761530113,
					"content": "そ…そうですね…ははは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530114
					],
					"speakerTitle": "サビト"
				},
				{
					"id": 761530114,
					"content": "（やっぱりネフェルか…！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530115
					],
					"speakerTitle": "サビト"
				},
				{
					"id": 761530115,
					"content": "じゃあ、いつになったら報酬がもらえるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761530116
					]
				},
				{
					"id": 761530116,
					"content": "今お買い求めいただいたのは…本日発売の短期投資証券でして…なんとその場で損益が計算されるんです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530117
					],
					"speakerTitle": "サビト"
				},
				{
					"id": 761530117,
					"content": "今とっさに思いついたんじゃないだろうな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761530118,
					"content": "えっ…と、とにかく、ご購入いただきありがとうございます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530119
					],
					"speakerTitle": "サビト"
				},
				{
					"id": 761530119,
					"content": "こちらが投資報酬となります。では、良い一日を！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530120,
						761530121
					],
					"speakerTitle": "サビト"
				},
				{
					"id": 761530120,
					"content": "儲かった。ラッキー！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761530122
					]
				},
				{
					"id": 761530122,
					"content": "ほんとか？へへっ、じゃあ鳥の形をしたやつがいいな。オイラ、あれ好きなんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761530123,
					"content": "えっ、あたいも行く。ネフェル姐さんにもお土産を買って帰ろうっと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530124
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761530124,
					"content": "ヤ…ヤフォダさん、お待ちを！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530125
					],
					"speakerTitle": "サビト"
				},
				{
					"id": 761530125,
					"content": "…あの、ネフェルさんから何か、言伝とかは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530126
					],
					"speakerTitle": "サビト"
				},
				{
					"id": 761530126,
					"content": "あ。そうそう、ネフェル姐さんが「モノは見つかった」って言ってたよ。それと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530127
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761530127,
					"content": "「焦ることはない。一歩ずつ歩むのが道ってもんだ。」ってさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530128
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761530128,
					"content": "そ、そうですね。仰る通りです…お二人とも、引き続きよろしくお願いします…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "サビト"
				},
				{
					"id": 761530121,
					"content": "さあ、パイモン。飴細工を買いにいこう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761530122
					]
				}
			]
