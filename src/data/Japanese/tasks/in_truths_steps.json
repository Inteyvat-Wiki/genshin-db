			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"バハール"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736960101,
					"content": "こんにちは、旅人さん。その様子だと…きっと学院フェスに参加しに来てくれたんですよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960102
					],
					"speakerTitle": "バハール"
				},
				{
					"id": 736960102,
					"content": "もし興味がありましたら、私たちハルヴァタット学院が主催するイベントに参加してみませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960103
					],
					"speakerTitle": "バハール"
				},
				{
					"id": 736960103,
					"content": "ハルヴァタットが研究しているのって…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736960104
					]
				},
				{
					"id": 736960104,
					"content": "厳密には正確な表現ではありませんが、一言でいうと…「言語」です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960105
					],
					"speakerTitle": "バハール"
				},
				{
					"id": 736960105,
					"content": "それが私たちハルヴァタット学院が研究しているものになります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960106
					],
					"speakerTitle": "バハール"
				},
				{
					"id": 736960106,
					"content": "どうです？聞いただけで、学院フェスの楽しい雰囲気には合わなさそうですよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960107
					],
					"speakerTitle": "バハール"
				},
				{
					"id": 736960107,
					"content": "同じ学院の友人たちもそう思っている人が多いんです。みんな楽しく遊んでいるのに、お客さんにクイズをさせるわけにもいかないでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960108
					],
					"speakerTitle": "バハール"
				},
				{
					"id": 736960108,
					"content": "それにクイズみたいなミニゲームは…皆さんに興味を持ってもらうのが難しいんです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960109
					],
					"speakerTitle": "バハール"
				},
				{
					"id": 736960109,
					"content": "数日にも及ぶ…友好的な討論の末、私たちは「真相究明」というミニゲームを作りました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960110
					],
					"speakerTitle": "バハール"
				},
				{
					"id": 736960110,
					"content": "このミニゲームは道具をあまり必要とせず、思考を巡らすだけで遊べます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960111
					],
					"speakerTitle": "バハール"
				},
				{
					"id": 736960111,
					"content": "ゲームではまず始めに、一つのショートストーリーをお話しします。この短い物語には起承転結がなく、一般的な物語の作り方とは違うように聞こえるかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960112
					],
					"speakerTitle": "バハール"
				},
				{
					"id": 736960112,
					"content": "そして、あなたは私に「質問」することができます。あなたの質問に対して、私は<color=#00E1FFFF>「はい」</color>、<color=#00E1FFFF>「いいえ」</color>、<color=#00E1FFFF>「関係ない」</color>のいずれかの回答をします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960113
					],
					"speakerTitle": "バハール"
				},
				{
					"id": 736960113,
					"content": "あなたの目的は「質問」をして、この物語の「真相」を見つけることです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960114
					],
					"speakerTitle": "バハール"
				},
				{
					"id": 736960114,
					"content": "大丈夫、あまり緊張しないでください。その物語の真相は、そこまで複雑なものではありませんから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960115
					],
					"speakerTitle": "バハール"
				},
				{
					"id": 736960115,
					"content": "どうでしょう？もし興味がありましたら、今から挑戦してみますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960116,
						736960118
					],
					"speakerTitle": "バハール"
				},
				{
					"id": 736960116,
					"content": "さっそく始めよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736960117
					]
				},
				{
					"id": 736960117,
					"content": "承りました。では、一つ目の物語をお話ししましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "バハール"
				},
				{
					"id": 736960118,
					"content": "他に用事がある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736960119
					]
				},
				{
					"id": 736960119,
					"content": "しばらくはここに居ますから、遊びたくなったら、いつでも来てくださいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "バハール"
				}
			]
		}
	]
}