				"points": []
			},
			"dialogs": [
				{
					"id": 401181001,
					"content": "「軍師」お姉ちゃんと一緒にびゅんびゅん爆速車に乗りたい！でもお姉ちゃん、乗ると頭がクラクラするみたいだから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401181002
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401181002,
					"content": "クレーは鋭いな。「軍師」お姉ちゃんの目に回る星でも見たんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401181003
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401181003,
					"content": "今日は少し減ってたよ！昨日はいっぱい金色のお星さまが飛んでたの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401181004
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401181004,
					"content": "ママがここにいたらきっと、あのお星さまたちはみんな雲の中に落ちちゃった魚だ、とか言ってたよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "クレー"
				}
			]
		},
