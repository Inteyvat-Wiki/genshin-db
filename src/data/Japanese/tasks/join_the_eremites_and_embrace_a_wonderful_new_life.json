			"trigger": {
				"objectNames": [
					"アティヤ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732670101,
					"content": "エルマイト旅団に入って素晴らしい生活を送ろう！そこのお友達、我らがエルマイト旅団に興味はないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670102
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670102,
					"content": "えっと…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670103
					]
				},
				{
					"id": 732670103,
					"content": "コホン、ではよく聞いてくれ。エルマイト旅団はいいところだぞ。自由！団結！友好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670104
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670104,
					"content": "しかも、木の上に住んでいる奴らの懐から金を頂戴できるんだ。教令院の学者連中は金持ちで、支払いが滞ることもない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670105,
						732670106
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670105,
					"content": "もう冒険者協会に入ってるから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670107
					]
				},
				{
					"id": 732670107,
					"content": "え？冒険者協会…？まあ…構わないさ！今時、みんな掛け持ちくらいしてるし、冒険者も傭兵も感覚的には似たようなもんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670108
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670108,
					"content": "いや、ずいぶん違う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670109
					]
				},
				{
					"id": 732670109,
					"content": "ああ、でも我々のまかないはいいぞ。三日にあげず魚も肉も出る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670110
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670110,
					"content": "それにもし運が良ければ、あの「熾鬣の獅子」ディシアと話をすることさえできるんだぞ！俺は…ゲホッ…ゴホゴホ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670111,
						732670112
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670111,
					"content": "ちょっと水でも飲んで…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670113
					]
				},
				{
					"id": 732670113,
					"content": "ふぅー…いや…すまんすまん、慌てて喋りすぎた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670114
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670114,
					"content": "ようやく俺の宣伝を聞いてくれる人が来て、興奮してしまったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670115
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670115,
					"content": "でも、本当にエルマイト旅団に入ろうとは考えてないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670116,
						732670117
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670116,
					"content": "今のところそのつもりはない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670118
					]
				},
				{
					"id": 732670118,
					"content": "そうか、お前がそう言うなら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670119
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670119,
					"content": "ずっとここで勧誘してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670120
					]
				},
				{
					"id": 732670120,
					"content": "ああ、これが俺の仕事だからな。近頃はどこも人手不足だが、我々傭兵稼業はとりわけ人手が足りなくて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670121
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670121,
					"content": "まあ…お前には関係ない話か。我がエルマイト旅団は大勢いるように見えるだろうが、傭兵というのは危険な仕事だからな。キャラバンを護送するような仕事なら、せいぜい疲れるくらいでまだいいが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670122
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670122,
					"content": "学者に関わる仕事に出るときは、本当に危険なんだ。五体満足で生きて帰って来られただけ、ありがたいと思わなければ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670123
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670123,
					"content": "普通の仲間がこうした仕事を終えて帰ってきたら、少なくとも十日から半月は休ませなけりゃならない。するとこの空きを誰かが埋める必要がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670124
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670124,
					"content": "スメールは広いし、学者も多いから、毎日新しい仕事がどんどん入ってきて、我々はほとんど昼も夜も働き通しなんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670125
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670125,
					"content": "もっと人を増やさなけりゃ、本当にやっていけない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670126
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670126,
					"content": "それで、誰か勧誘できた？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670127
					]
				},
				{
					"id": 732670127,
					"content": "この村でってことか？はは…残念ながらまだ一人も。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670128
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670128,
					"content": "いや…勧誘できてないとは言えないな。ただ、声をかけた人は来てくれないし、来てくれる人は入れないというだけで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670129
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670129,
					"content": "嘘だと思うなら、俺について来るか？この勧誘活動を終える頃には、お前も我々の仲間になりたくなるかもしれないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670130
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670130,
					"content": "…まあ、冗談だよ。お前は入りたくないと言ったんだから、こっちも無理強いはしない。ただ、誰かに付き添ってもらいたいだけなのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670132
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670132,
					"content": "付き添いだけならいいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670131
					]
				},
				{
					"id": 732670131,
					"content": "へへ、ありがとう。そうだな…まずサニアのところに行こう。昼間だったら彼女も暇なはずだ。夜は…ジェバーリと生活のことで話し合うのに忙しいようだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670117,
					"content": "冒険者協会の仕事で手一杯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670118
					]
				},
				{
					"id": 732670112,
					"content": "随分スピーチに慣れてるんじゃない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670113
					]
				},
				{
					"id": 732670106,
					"content": "もうたくさん依頼を受けてるから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670107
					]
				}
			]
		},
		{
