			},
			"dialogs": [
				{
					"id": 732670801,
					"content": "わぁ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670802
					],
					"speakerTitle": "エーテン"
				},
				{
					"id": 732670802,
					"content": "こ、こんなに速く走れるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670803
					],
					"speakerTitle": "カリマ"
				},
				{
					"id": 732670803,
					"content": "うん！スピードも出てるし、走り方もしっかりしてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670804
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670804,
					"content": "エーテン、カリマ、よく覚えておくんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670805
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670805,
					"content": "危険な状況に遭遇したら強がるな。撤退する必要があるときは、思い切って撤退しないとダメだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670806
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670806,
					"content": "特にお前だぞ、エーテン。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670807
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670807,
					"content": "わかってるわよぉ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670808
					],
					"speakerTitle": "エーテン"
				},
				{
					"id": 732670808,
					"content": "よろしい。じゃあ次は…村の外に行って、自分の目で「戦闘」を見てみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670809
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670809,
					"content": "やったぁ！ちょうどパパが木を削って刀を作ってくれたから、持ち歩いてるのよ。カリマは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670810
					],
					"speakerTitle": "エーテン"
				},
				{
					"id": 732670810,
					"content": "小さい弓矢ならあるけど…ママは先の尖ってない矢しかくれなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670811
					],
					"speakerTitle": "カリマ"
				},
				{
					"id": 732670811,
					"content": "ハハハ！大丈夫だ、お前たちには剣があり、弓があり、そして何より勇気がある。冒険の道に十分足を踏み出せるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670812
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670812,
					"content": "だが、村の外に出たらむやみに走り回るんじゃない。俺と旅人のそばを離れるなよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670813,
						732670814
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670813,
					"content": "本当にこの子たちを連れて行くの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670815
					]
				},
				{
					"id": 732670815,
					"content": "…安心しろ、前にも行ったことのある場所だ。病弱なサソリが何匹かいるだけで、ほとんど攻撃性はない。大丈夫さ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670816
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670816,
					"content": "それに、我々二人がいるじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670817,
						732670818
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670817,
					"content": "#{M#俺}{F#私}も数に入ってるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670819
					]
				},
				{
					"id": 732670819,
					"content": "…どうせここまで来たんだし、人助けは最後までやるものだぞ、旅人。こちらも冒険者のルールに従って、報酬は用意するから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670820
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670820,
					"content": "じゃあ、二人の準備ができたら、すぐ出発しよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670821
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670821,
					"content": "うんっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670822
					],
					"speakerTitle": "エーテン"
				},
				{
					"id": 732670822,
					"content": "うぅ…ちょっと緊張する…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カリマ"
				},
				{
					"id": 732670818,
					"content": "そんな約束してないけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670819
					]
				},
				{
					"id": 732670814,
					"content": "子ども二人連れて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670815
					]
				}
			]
		},
		{
			"id": 7326710,
