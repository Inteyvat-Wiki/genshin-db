				"points": []
			},
			"dialogs": [
				{
					"id": 732671001,
					"content": "うわ…あのサソリ…でっかい…あれに近づくの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671002
					],
					"speakerTitle": "エーテン"
				},
				{
					"id": 732671002,
					"content": "あたしの矢が当たったのに、どうして少しも反応がないんだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671003
					],
					"speakerTitle": "カリマ"
				},
				{
					"id": 732671003,
					"content": "でも…どうしてあんなに簡単に倒せたの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671004,
						732671005
					],
					"speakerTitle": "カリマ"
				},
				{
					"id": 732671004,
					"content": "長年の鍛錬の成果だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732671006
					]
				},
				{
					"id": 732671006,
					"content": "うう…キャンディス姉さんに、すごく進歩したって言われたのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671007
					],
					"speakerTitle": "カリマ"
				},
				{
					"id": 732671007,
					"content": "カリマ、そんなにしょげることはないさ。毎日少しずつ進歩すれば、いつかお前もすごい実力の持ち主になれる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671008
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732671008,
					"content": "エーテンもだ。このまま訓練を続けていれば、じきにエルマイト旅団に入れるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671009
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732671009,
					"content": "うう、ディシアお姉ちゃんから直接武術を教えてもらえたらなぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671010
					],
					"speakerTitle": "エーテン"
				},
				{
					"id": 732671010,
					"content": "次にキャンディスお姉ちゃんに会ったら、絶対またトレーニングの指導をお願いする！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671011
					],
					"speakerTitle": "カリマ"
				},
				{
					"id": 732671011,
					"content": "この子たちは二人とも…やる気満々だな、ハッハハハ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671012,
						732671013
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732671012,
					"content": "結局誰も勧誘できなかったね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732671014
					]
				},
				{
					"id": 732671014,
					"content": "ゲホゲホ…コホン…お前も痛いところを突くなあ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671015
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732671015,
					"content": "仕事のことはさておき…俺の宣伝に効果が全くないわけではないさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671016
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732671016,
					"content": "俺の宣伝を聞いて、村の若者の多くは村の外に行ってみたいと思ったはずだ…たとえエルマイト旅団に入りたいとは思わなくてもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671017
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732671017,
					"content": "それはさておき、この子たち二人を連れて村に戻らないと。長いこと外出していると、家の人が心配するだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671018
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732671018,
					"content": "さあ、報酬を受け取ってくれ。付き合ってくれてありがとう、旅人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671019
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732671019,
					"content": "やれやれ、このあと旅団に戻って業務報告をしないと。なんと説明したものか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671020
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732671020,
					"content": "そうだ、アティヤおじさん、まだテストしてもらってないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671021
					],
					"speakerTitle": "エーテン"
				},
				{
					"id": 732671021,
					"content": "え？ああ…そうだったな。だが、まずは帰ろう。テストは村に帰ってからだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732671013,
					"content": "#{M#君}{F#あなた}の仕事はどうするの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732671014
					]
				},
				{
					"id": 732671005,
					"content": "二人はまだ小さいからね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732671006
					]
				}
			]
		}
