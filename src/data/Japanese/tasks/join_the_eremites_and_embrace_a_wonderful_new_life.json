						],
						"stepId": 7326705,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"フォディル",
					"アティヤ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732670501,
					"content": "アティヤ、何でまた来たんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670502
					],
					"speakerTitle": "フォディル"
				},
				{
					"id": 732670502,
					"content": "へへ、不撓不屈が我らエルマイト旅団のモットーですからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670503
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670503,
					"content": "それなら覚えておけ。原則を曲げないのが俺のモットーだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670504
					],
					"speakerTitle": "フォディル"
				},
				{
					"id": 732670504,
					"content": "フォディル兄貴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670505
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670505,
					"content": "俺はもうエルマイト旅団を抜けたんだから、そう呼ばなくてもいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670506
					],
					"speakerTitle": "フォディル"
				},
				{
					"id": 732670506,
					"content": "はい、フォディルさん。でも、本当に戻ってみようとは考えないんですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670507
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670507,
					"content": "中にはその…突っ走る兄弟もいますが、ほとんどの兄弟は規律や法を守っています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670508
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670508,
					"content": "アティヤ、言ったはずだ。俺はもう戻るつもりはないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670509
					],
					"speakerTitle": "フォディル"
				},
				{
					"id": 732670509,
					"content": "お前が今言ったようなことは、俺もとうに自分の目で見てわかってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670510
					],
					"speakerTitle": "フォディル"
				},
				{
					"id": 732670510,
					"content": "エルマイト旅団の全員が無法者というわけではないし、メンバーの誰もが好んで火事場泥棒を働くわけでもない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670511
					],
					"speakerTitle": "フォディル"
				},
				{
					"id": 732670511,
					"content": "だがなアティヤ…悪事は伝染するんだ。法を犯し規律を乱す者が一人でもいると、周りのやつも影響を受ける…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670522
					],
					"speakerTitle": "フォディル"
				},
				{
					"id": 732670522,
					"content": "一人が複数の人に影響を与え、その複数の人がさらに活動を続ければ、より多くの人に影響を与える…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670523
					],
					"speakerTitle": "フォディル"
				},
				{
					"id": 732670523,
					"content": "アティヤ、そういう状況に関しては俺よりもお前のほうがよくわかっているだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670512
					],
					"speakerTitle": "フォディル"
				},
				{
					"id": 732670512,
					"content": "そういう雰囲気の中にいると…悪事に手を染めてしまうんだ、アティヤ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670513
					],
					"speakerTitle": "フォディル"
				},
				{
					"id": 732670513,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670514
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670514,
					"content": "お前は俺に戻るよう勧めるが、俺もお前に抜けるよう勧めたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670515
					],
					"speakerTitle": "フォディル"
				},
				{
					"id": 732670515,
					"content": "お前から見れば、エルマイト旅団は道徳的とは言えないまでも、悪の組織ではないんだろう…だが人はいつまでもグレーゾーンで生きるわけにはいかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670516
					],
					"speakerTitle": "フォディル"
				},
				{
					"id": 732670516,
					"content": "…これはお前への忠告にすぎん。どうするかは、自分で決めろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670517
					],
					"speakerTitle": "フォディル"
				},
				{
					"id": 732670517,
					"content": "わかりました、フォディル兄貴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670518
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670518,
					"content": "ああ。もしお前が本当に抜けて…生計を立てたいなら、力になるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670519
					],
					"speakerTitle": "フォディル"
				},
				{
					"id": 732670519,
					"content": "大丈夫？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670520
					]
				},
				{
					"id": 732670520,
					"content": "ハハハ、フォディル兄貴を説得出来なかったな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670521
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670521,
					"content": "次は…いや、ひとまず帰って休もうか。沢山喋ったから、喉が痛くなってきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アティヤ"
				}
			]
		},
		{
			"id": 7326706,
