			"trigger": {
				"objectNames": [
					"サニア",
					"アティヤ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732670301,
					"content": "はあ、困ったわね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670302
					],
					"speakerTitle": "サニア"
				},
				{
					"id": 732670302,
					"content": "おはよう、サニア！何を選んでるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670303
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670303,
					"content": "アティヤ…言ったでしょ、ジェバーリはエルマイト旅団には興味ないって。私も彼を傭兵になんてしたくないから、取り次いでくれと言われても無駄よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670304
					],
					"speakerTitle": "サニア"
				},
				{
					"id": 732670304,
					"content": "いやいや、ジェバーリはあれだけの料理の腕があるんだから、エルマイト旅団に入ればきっといいポストに就けるはずだ。収入もずっと良くなるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670305
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670305,
					"content": "それに彼も、外で仕事を探したいと言ってただろう？もし本当に外で仕事をしたいなら、知人の俺の紹介があるのが一番いいに決まってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670306
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670306,
					"content": "彼の話は聞き流していいよ。たまにそんなことを言うけど、何日か経つと気が変わるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670307
					],
					"speakerTitle": "サニア"
				},
				{
					"id": 732670307,
					"content": "結局、私を一人村に残すのは嫌だって言うし…私も彼が一人で出稼ぎに行くのは嫌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670308
					],
					"speakerTitle": "サニア"
				},
				{
					"id": 732670308,
					"content": "ましてや、毎日が命がけの傭兵稼業だなんて！だから諦めて。たとえジェバーリが行きたいと言っても、私が止めるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670309
					],
					"speakerTitle": "サニア"
				},
				{
					"id": 732670309,
					"content": "はい、話はここまで。これから買い物に行かなきゃならないから、他の人をあたってちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670310
					],
					"speakerTitle": "サニア"
				},
				{
					"id": 732670310,
					"content": "ふぅ…仕方ない。旅人、見ての通り、俺の仕事は毎日こんな調子さ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670311
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670311,
					"content": "次はフォディルのところに行こう。彼は…もともと我々の仲間だったんだが、脱退してしまったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670312
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670312,
					"content": "もし説得して戻ってきてくれるなら、それに越したことはないんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アティヤ"
				}
			]
		},
		{
			"id": 7326705,
			"completionStepIds": [
				7326705
			],
