				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732670601,
					"content": "アティヤおじさん！まだエルマイト旅団の勧誘をしてるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670602
					],
					"speakerTitle": "エーテン"
				},
				{
					"id": 732670602,
					"content": "エーテン、また飛び出してきたのか。お母さんには言ってあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670603
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670603,
					"content": "言ったわ！ママは仕事だから、一人でカリマのところに遊びに来たの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670604
					],
					"speakerTitle": "エーテン"
				},
				{
					"id": 732670604,
					"content": "こんにちは、アティヤおじさん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670605
					],
					"speakerTitle": "カリマ"
				},
				{
					"id": 732670605,
					"content": "アティヤおじさん、この前おじさんに話したこと、どう思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670606
					],
					"speakerTitle": "エーテン"
				},
				{
					"id": 732670606,
					"content": "あたしずっと体を鍛えてるし、カリマとも一緒に長いこと特訓してるの…もうかけっこじゃカリマに負けないわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670607
					],
					"speakerTitle": "エーテン"
				},
				{
					"id": 732670607,
					"content": "誰が負けたって？あたし、あの日はお昼をあまり食べてなかっただけだもん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670608
					],
					"speakerTitle": "カリマ"
				},
				{
					"id": 732670608,
					"content": "とにかく、おじさんがあたしのために作ってくれた計画に従って、ずっと特訓してきたから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670609
					],
					"speakerTitle": "エーテン"
				},
				{
					"id": 732670609,
					"content": "アティヤおじさん、今日、もう一度テストしてみて！あたしがエルマイト旅団に入る資格があるかどうか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670610,
						732670611
					],
					"speakerTitle": "エーテン"
				},
				{
					"id": 732670610,
					"content": "これがあなたの言ってた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670612
					]
				},
				{
					"id": 732670612,
					"content": "コホン…よし！エーテン、今日はエルマイト旅団のメンバーとして、もう一度お前をテストしてやろう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670613
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670613,
					"content": "やったあ！カリマもテストしてもらいなさいよ。一緒にがんばろう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670614
					],
					"speakerTitle": "エーテン"
				},
				{
					"id": 732670614,
					"content": "あたしは別にエルマイト旅団には入りたくないの。ただ村に残って、みんなを守りたいだけ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670615
					],
					"speakerTitle": "カリマ"
				},
				{
					"id": 732670615,
					"content": "でも…アティヤおじさんにテストしてもらうのもいいかも。あたし、キャンディスお姉ちゃんに特訓法を教えてもらったことがあるんだから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670616
					],
					"speakerTitle": "カリマ"
				},
				{
					"id": 732670616,
					"content": "ええ！？いつの間に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670617
					],
					"speakerTitle": "エーテン"
				},
				{
					"id": 732670617,
					"content": "ハハハ、二人とも元気があって、よろしい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670618
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670618,
					"content": "エーテンもほっぺを膨らませてないで。機会があれば、特訓法を教えてもらいにディシアのところに連れて行ってやろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670619
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670619,
					"content": "ほんとう！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670620
					],
					"speakerTitle": "エーテン"
				},
				{
					"id": 732670620,
					"content": "エルマイト旅団のメンバーは、嘘はつかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670621
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670621,
					"content": "だが、今日はテストを始める前に、こちらの旅人にお手本の動作を見せてもらおう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670622,
						732670624
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670622,
					"content": "#{M#俺}{F#私}がやるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670623
					]
				},
				{
					"id": 732670623,
					"content": "…今までお手本を見せる機会がなかったんだ。自分で走って、この子たちを二人だけでここに残しておくわけにいかないだろう？それは危ないからな…今回は頼む、旅人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670626
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670626,
					"content": "ああコホン、この旅人は偉大な冒険者で、お前たちにお手本を見せるためにやっとのことでお招きしたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670627
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670627,
					"content": "エーテン、カリマ、二人ともよく見ておくんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670628
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670628,
					"content": "はーい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670629
					],
					"speakerTitle": "エーテン"
				},
				{
					"id": 732670629,
					"content": "冒険者って…冒険者協会にいるような人…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670630
					],
					"speakerTitle": "カリマ"
				},
				{
					"id": 732670630,
					"content": "傭兵だろうが守衛だろうが、任務遂行の時には、ひとまず撤退しなければならない状況に遭遇することがある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670631
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670631,
					"content": "そうした場合、必要なことは…できるだけ速く走ることだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670632
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670632,
					"content": "じゃあ旅人、頼む。まず練習してみるんだ…そう…速やかに撤退する方法を！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670633
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670633,
					"content": "スタート地点はあそこだ。お手本を見せてやってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670624,
					"content": "お手本を見せたことがないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670625
					]
				},
				{
					"id": 732670625,
					"content": "…これまではこの子たちを見てないといけなかったからな。お手本の動作を見せるどころじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670634
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670634,
					"content": "…とにかく、今回は頼む、旅人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670626
					],
					"speakerTitle": "アティヤ"
				},
				{
					"id": 732670611,
					"content": "入りたい人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670612
					]
				}
			]
		},
