				"points": []
			},
			"dialogs": [
				{
					"id": 745240401,
					"content": "おや、童ではないか。妾の今日の予定を知っておったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240402,
						745240403
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 745240402,
					"content": "神子は将軍に会ってきたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745240404
					]
				},
				{
					"id": 745240404,
					"content": "ふふっ、なかなか鼻が利くようじゃな。なに、滅多に外出せぬ友人に、甘味と流行りの娯楽小説でも届けようと思うただけのこと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240405
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 745240405,
					"content": "影も流行りのを読み始めたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745240406
					]
				},
				{
					"id": 745240406,
					"content": "稲妻の民の娯楽や好みの変化を知りたいそうじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240407
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 745240407,
					"content": "つい先ほどまで、語り合っておった。最初は真面目くさって物語の内容から読者の好みを分析しておったが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240408
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 745240408,
					"content": "…話をしているうちに、急に気になり始めたのか…「それで、最後はどうなるのです？」と問うてきたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240409
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 745240409,
					"content": "ふふっ、影も、興味深い物語には抗えぬようじゃな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240410,
						745240411
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 745240410,
					"content": "今の神子の表情…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745240412
					]
				},
				{
					"id": 745240412,
					"content": "ほう？それが今日の汝の本当の目的か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240413
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 745240413,
					"content": "合点がいったわ。旅の最中で妾が恋しくなった時のために、写真に残しておきたい、というわけじゃな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240414
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 745240414,
					"content": "では任せるぞ。心して角度を決めるのじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "八重神子"
				},
				{
					"id": 745240411,
					"content": "ぜひとも記録に残しておかないと。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745240412
					]
				},
				{
					"id": 745240403,
					"content": "甘い匂いがするね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745240404
					]
				}
			]
		}
	]
