			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ホッセイニ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745150101,
					"content": "#ん？{NICKNAME}にパイモン、ちょうどいいところに。冒険者協会に依頼を出そうとしていたところだったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150102
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 745150102,
					"content": "#依頼が自分からやってくるなんてな。へへ、{NICKNAME}、今夜はご馳走が食べられそうだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745150103,
					"content": "コホン、パイモン…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745150104
					]
				},
				{
					"id": 745150104,
					"content": "あっ…オイラが言いたかったのは、オイラたちみたいな有名な冒険者は、それなりのギャラがいるぜってことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745150105,
					"content": "報酬のことなら心配しないでくれ。前回と同じように頼んだ実験をこなしてくれれば、然るべき報酬を支払おう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150106
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 745150106,
					"content": "ぜ、前回？えーと…どっかで会ったっけ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745150107,
					"content": "はぁ…まだ覚えてくれていないのか？スメール教令院の学者、ホッセイニだ。これまで何度も手伝ってくれただろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150108
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 745150108,
					"content": "ご…ごめん。まったく記憶になくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745150109,
					"content": "「エネルギー原盤」のことも忘れたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150110,
						745150111
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 745150110,
					"content": "もしかして、「原盤マン」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745150113
					]
				},
				{
					"id": 745150113,
					"content": "「原盤マン」？あっ、思い出したぞ。前に離島と層岩巨淵で会ったよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745150114,
					"content": "っていうか、おまえすごく変わってないか？なんか、雰囲気が明るくなったような…全然わからなかったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745150115,
					"content": "はは、そう見えるか？ここ最近、気分がすこぶるいいんだ。これほど運に恵まれたのは実に久しぶりでな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150116
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 745150116,
					"content": "おお！何かいいことがあったのか？オイラたちにも教えてくれよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745150117,
					"content": "話せば長くなるんだが…実は前回君たちと別れた後、教令院に戻ったんだ。そして、集めたデータを基に、人工エネルギー原盤の構想をまとめて提出した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150118
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 745150118,
					"content": "レポートを読んだ指導教員は興奮を隠せない様子で、その場で「惜しみない賞賛」を贈ってくださった。それから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150119
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 745150119,
					"content": "それから…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745150120,
					"content": "指導教員にスメールを追い出されて、フォンテーヌにやってきたのさ。今はここで指導教員に与えられた課題をやっている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150121
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 745150121,
					"content": "えっ？でも「賞賛」されたんじゃないのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745150122,
					"content": "ああ、よくもファンタジー小説の類を研究テーマとして提出したなと、私の勇気を讃えてくださったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150123
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 745150123,
					"content": "全然褒められてないじゃないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745150124,
					"content": "私も最初はひどく落ち込んでいた。だがその後、フォンテーヌで優秀な協力者や投資者に出会ってな。私のプロジェクトを大いに気に入ってくれたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150125
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 745150125,
					"content": "彼らの協力のもと、これまでの研究成果とフォンテーヌの技術を融合させ、ついに人工エネルギー原盤のプロトタイプを造ることに成功した。その名も「ホッセイニ原盤」だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150126
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 745150126,
					"content": "「ホッセイニ原盤」の実験が計算通りにうまくいけば、知恵の神の試練はもとより…賢者になることだって夢じゃない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150127
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 745150127,
					"content": "まだ卒業してないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745150128
					]
				},
				{
					"id": 745150128,
					"content": "コホン、そんなことは無意味で紛らわしいだけの変数だ。成功の前段階にある、些細な挫折に過ぎないさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150129
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 745150129,
					"content": "目下の急務は、「ホッセイニ原盤」のパフォーマンスを検証すること。だから、秘境に入ってこれを使った後、評価してくれる人を雇おうとしたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150130
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 745150130,
					"content": "#ということで、{NICKNAME}、今回の「ホッセイニ原盤」の実験プロジェクトに参加してくれないだろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150131,
						745150133
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 745150131,
					"content": "つまり、それを使って戦うんだよね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745150132
					]
				},
				{
					"id": 745150132,
					"content": "その通りだ。君の優れた戦闘能力は承知しているが、今のところまだ「ホッセイニ原盤」は想定レベルに達していなくてな。くれぐれも安全には気をつけてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 745150133,
					"content": "了解。任せて！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745150134
					]
				},
				{
					"id": 745150134,
					"content": "#{NICKNAME}、君の優れた戦闘能力は承知しているが、現時点で「ホッセイニ原盤」はまだ想定レベルに達していなくてな。くれぐれも安全には気をつけてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 745150111,
					"content": "それも記憶にないかも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745150112
					]
				},
				{
					"id": 745150112,
					"content": "なら「原盤マン」は？これなら覚えているだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150113
					],
					"speakerTitle": "ホッセイニ"
				}
			]
		}
	]
}