			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ヴァカロー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760940101,
					"content": "あいつをどうやって出すか…困ったもんだぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940102
					],
					"speakerTitle": "ヴァカロー"
				},
				{
					"id": 760940102,
					"content": "何か手伝えることはある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760940103
					]
				},
				{
					"id": 760940103,
					"content": "ん？ああ、親切な冒険者か。いいタイミングだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940104
					],
					"speakerTitle": "ヴァカロー"
				},
				{
					"id": 760940104,
					"content": "ここの洞窟を抜けると北へ向かう道があったんだが、この前のクーヴァキの異変で崩落してしまってな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940105
					],
					"speakerTitle": "ヴァカロー"
				},
				{
					"id": 760940105,
					"content": "人的被害がなくてよかったと言っていたら、ある外国の行商人が、「仲間」が中に閉じ込められたと言い出したんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940106
					],
					"speakerTitle": "ヴァカロー"
				},
				{
					"id": 760940106,
					"content": "それは近くで知り合ったネムリヒツジだった。ここに長くいれば分かると思うが、ネムリヒツジがついてまわるのは、たいてい種を遠くまで運ぼうとしてるだけなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940107
					],
					"speakerTitle": "ヴァカロー"
				},
				{
					"id": 760940107,
					"content": "でも何を説明しても聞く耳を持ってくれなくてな、どうにかして助け出すように頼まれたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940108
					],
					"speakerTitle": "ヴァカロー"
				},
				{
					"id": 760940108,
					"content": "洞窟の奥への道を再び繋ぐには、この玲瓏の花を使うしかない。でも俺は霜月の子の魔法も、強力なクーヴァキ装置も持ち合わせてなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940109
					],
					"speakerTitle": "ヴァカロー"
				},
				{
					"id": 760940109,
					"content": "そこであんたに出会えたってわけだ。冒険者なら、中にいるネムリヒツジを連れ出す方法、何か思いつかないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940110
					],
					"speakerTitle": "ヴァカロー"
				},
				{
					"id": 760940110,
					"content": "あの人の代わりに礼を言わせてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴァカロー"
				}
			]
		},
