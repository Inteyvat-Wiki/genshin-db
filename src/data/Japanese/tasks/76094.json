			"dialogs": [
				{
					"id": 760940501,
					"content": "おお！前に、外国から来た行商人の「お仲間」が洞窟に閉じ込められたんだが…まさか助け出してくれてたとはな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940502
					],
					"speakerTitle": "ヴァカロー"
				},
				{
					"id": 760940502,
					"content": "ネムリヒツジが人についてまわるのは、持ってる種を遠くまで撒くためだってのは、周知の事実なんだが…あの人は、どれだけ説明しても聞く耳を持ってくれなかったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940503
					],
					"speakerTitle": "ヴァカロー"
				},
				{
					"id": 760940503,
					"content": "ちょうど困ってたんだ。あんたのような親切な冒険者に出会えて本当に良かったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940504
					],
					"speakerTitle": "ヴァカロー"
				},
				{
					"id": 760940504,
					"content": "これはほんの気持ちだ。受け取ってくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴァカロー"
				}
			]
