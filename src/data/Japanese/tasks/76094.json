					"ヴァカロー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760940201,
					"content": "よかった！あんたなら何とかしてくれると思ったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940202
					],
					"speakerTitle": "ヴァカロー"
				},
				{
					"id": 760940202,
					"content": "ネムリヒツジはクーヴァキのない環境じゃ生存できないが、ナド・クライにいる間だけでも、あの人の心の慰めになれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940203
					],
					"speakerTitle": "ヴァカロー"
				},
				{
					"id": 760940203,
					"content": "じゃあ、またな。少ないがお礼にとっといてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴァカロー"
				}
			]
		},
