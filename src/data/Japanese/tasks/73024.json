			},
			"dialogs": [
				{
					"id": 730240501,
					"content": "ありがとうございます。本当に助かりました！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240502
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730240502,
					"content": "ご覧の通り、私はここでレンジャー長をしているラナといいます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240503,
						730240505
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730240503,
					"content": "#{M#俺}{F#私}は{NICKNAME}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240504
					]
				},
				{
					"id": 730240504,
					"content": "オイラはパイモン！外国から来たんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240507
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730240507,
					"content": "そうでしたか。うん…確かに森の民とは服装が違いますし…黄砂のほうからいらしたようにも見えません。通気性があって、スメールにぴったりの装いですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240508
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730240508,
					"content": "コホンッ！とにかく私たちレンジャー長の仕事は森を守り、旅人を助けてガイドすることです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240509
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730240509,
					"content": "#{NICKNAME}とパイモンもご覧になったかと思いますが、最近の森はあまり理想的な状態ではありません。「キノコン」や猛獣が暴れ回っています。それに「死域」も…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240510
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730240510,
					"content": "もしよければお送りしますよ。ちょうど、パトロールでヴィマラ村を通るんです。そこから水路に沿って進めば、スメールシティやオルモス港に行きやすいはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240511,
						730240513
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730240511,
					"content": "うん、行こう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240512
					]
				},
				{
					"id": 730240512,
					"content": "はい、お二人の安全は私が保障します！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730240513,
					"content": "うん。でも先に用事を済ませてもいい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240514
					]
				},
				{
					"id": 730240514,
					"content": "分かりました。ではここでお待ちしています。くれぐれもお気をつけて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730240505,
					"content": "#{M#俺}{F#私}たちは遠いところから来た…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240506
					]
				},
				{
					"id": 730240506,
					"content": "#ああ！オイラはパイモン。こいつは{NICKNAME}だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240507
					],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
