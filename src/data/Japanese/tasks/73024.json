			"dialogs": [
				{
					"id": 730240101,
					"content": "ありがとうございます。本当に助かりました！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240102
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730240102,
					"content": "ご覧の通り、私はここでレンジャー長をしているラナといいます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240103,
						730240105
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730240103,
					"content": "#{M#俺}{F#私}は{NICKNAME}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240104
					]
				},
				{
					"id": 730240104,
					"content": "オイラはパイモン！外国から来たんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730240107,
					"content": "そうでしたか。うん…確かに森の民とは服装が違いますし…黄砂のほうからいらしたようにも見えません。通気性があって、スメールにぴったりの装いですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240108
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730240108,
					"content": "ん？待てよ、ラナがレンジャー長だとしたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240109,
						730240123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730240109,
					"content": "ティナリを知ってるはず？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240110
					]
				},
				{
					"id": 730240110,
					"content": "#えっ！{NICKNAME}も先輩をご存知なんですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240111
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730240111,
					"content": "ティナリ先輩は「近づくな」というオーラを出していますが、根はいい方なんです。見習い時代、なにかとお世話になりました。それに耳がとてもきれいなんですよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240112
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730240112,
					"content": "うんうん！実はオイラ、あの耳に触ってみたかったんだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240113,
						730240116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730240113,
					"content": "#実は{M#俺}{F#私}も…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240114
					]
				},
				{
					"id": 730240114,
					"content": "うーん…こっそり飛んでいけば、触れるかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730240115,
					"content": "うふふっ、急に手を出したら、先輩きっと怒るでしょうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240118
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730240118,
					"content": "でしょう？艶があって、どんな手触りをしているのか気になりますよね。先輩がいま連れている子も、興味津々みたいです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240119
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730240119,
					"content": "あれ？それってまさか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730240120,
					"content": "コレイのこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240121
					]
				},
				{
					"id": 730240121,
					"content": "#あれ？{NICKNAME}もコレイをご存知なのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240122
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730240122,
					"content": "コレイは身体の具合があまり良くないそうです。それでも必死に森を守り、死域を排除しようとしているので、みんな彼女を心配しています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240141
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730240141,
					"content": "コホンッ！とにかく私たちレンジャー長の仕事は森を守り、旅人を助けてガイドすることです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240142
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730240142,
					"content": "#{NICKNAME}とパイモンもご覧になったかと思いますが、最近の森はあまり理想的な状態ではありません。「キノコン」や猛獣が暴れ回っています。それに「死域」も…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240143
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730240143,
					"content": "もしよければお送りしますよ。ちょうど、パトロールでヴィマラ村を通るんです。そこから水路に沿って進めば、スメールシティやオルモス港に行きやすいはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240144,
						730240146
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730240144,
					"content": "うん、行こう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240145
					]
				},
				{
					"id": 730240145,
					"content": "はい、お二人の安全は私が保障します！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730240146,
					"content": "うん。でも先に用事を済ませてもいい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240147
					]
				},
				{
					"id": 730240147,
					"content": "分かりました。ではここでお待ちしています。くれぐれもお気をつけて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730240116,
					"content": "パイモンならこっそり飛べば触れるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240117
					]
				},
				{
					"id": 730240117,
					"content": "おい！そんなことしたら、ティナリが怒るだろ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730240123,
					"content": "コレイを知ってる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240124
					]
				},
				{
					"id": 730240124,
					"content": "#おや、{NICKNAME}はあの子に会ったことがあるのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240125
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730240125,
					"content": "コレイは身体の具合があまり良くないそうです。それでも必死に森を守り、死域を排除しようとしているので、みんな彼女を心配しています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240126
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730240126,
					"content": "ですが、あの「触りたくなる耳」の先輩がついてれば、きっと大丈夫でしょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240127
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730240127,
					"content": "え？耳って…まさか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240128,
						730240138
					],
					"speakerTitle": "パイモン"
				},
