				},
				{
					"id": 730240138,
					"content": "アンバーのこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240139
					]
				},
				{
					"id": 730240139,
					"content": "「ウサギ伯爵、出撃！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240140
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730240140,
					"content": "…って、どう考えてもアンバーのことじゃないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240141
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730240105,
