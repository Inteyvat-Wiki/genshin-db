			},
			"dialogs": [
				{
					"id": 110133001,
					"content": "旅人にパイモン。まさか孤雲閣に来るなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110133002
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 110133002,
					"content": "何か用かしら？いま取り込み中だから、あまり長くは話せないのだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110133003,
						110133007
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 110133003,
					"content": "どうして刻晴はここにいるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110133004
					]
				},
				{
					"id": 110133004,
					"content": "見ての通り、ここであるものを建設していてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110133005
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 110133005,
					"content": "群玉閣よりもこちらの方が重要と考え、私が監督をしているの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110133006
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 110133006,
					"content": "間に合うといいんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "刻晴"
				},
				{
					"id": 110133007,
					"content": "これは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110133008
					]
				},
				{
					"id": 110133008,
					"content": "新型の帰終機よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110133009
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 110133009,
					"content": "凝光が専門家を雇って帰終機の分解を頼んでね。そして、それを基に改良版を設計したの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110133010
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 110133010,
					"content": "仙人が作った原型の帰終機と比べると、射速と威力はやや劣るけど、大量生産が可能になるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110133011
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 110133011,
					"content": "それに分解と組み立てが容易なため、効率よく色んな場所に配置することができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110133012
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 110133012,
					"content": "これこそが危機を迎え撃つための良策だと、私は信じているわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "刻晴"
				}
			]
		},
