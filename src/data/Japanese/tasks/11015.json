			},
			"dialogs": [
				{
					"id": 110143001,
					"content": "あ、あなたたち…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110143002
					],
					"speakerTitle": "七七"
				},
				{
					"id": 110143002,
					"content": "どうして、七七がここに？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110143003
					]
				},
				{
					"id": 110143003,
					"content": "海辺は、とても危険。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110143004
					],
					"speakerTitle": "七七"
				},
				{
					"id": 110143004,
					"content": "七七は、みんなの避難を手伝ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110143005,
						110143006
					],
					"speakerTitle": "七七"
				},
				{
					"id": 110143005,
					"content": "「危険」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110143007
					]
				},
				{
					"id": 110143007,
					"content": "うん。凝光が言ってた、海によくないものがいるって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110143008
					],
					"speakerTitle": "七七"
				},
				{
					"id": 110143008,
					"content": "だから人を避難させるため、七七に頼んだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110143009
					],
					"speakerTitle": "七七"
				},
				{
					"id": 110143009,
					"content": "でも、誰も七七の言うことを聞いてくれない。七七、ここを守ることしかできない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110143010
					],
					"speakerTitle": "七七"
				},
				{
					"id": 110143010,
					"content": "もし危険な状況になったら、七七が前に出て、みんなを守る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110143011
					],
					"speakerTitle": "七七"
				},
				{
					"id": 110143011,
					"content": "あなたたちも、海に近づかないで。危険だから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "七七"
				},
				{
					"id": 110143006,
					"content": "「避難」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110143007
					]
				}
			]
		}
