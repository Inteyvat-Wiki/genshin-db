			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凝光"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110150301,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150302,
						110150303
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110150302,
					"content": "何かあったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110150304
					]
				},
				{
					"id": 110150304,
					"content": "少し力を使ってしまっただけだ、問題はない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150305
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110150305,
					"content": "我一人であやつを始末しようと思ったのだが、まさか主も追ってくるとは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150306
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110150306,
					"content": "だが、心配はいらぬ、あれがこの地に来ることはもうない。あれほどの傷を負ったのだ、他の場所へ行っただろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150307
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110150307,
					"content": "先ほど、水の中でいったい何が？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150308
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150308,
					"content": "既に解決した。水中へ潜る前から傷を負っていたゆえ、我もあまり手を焼かずに済んだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150309
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110150309,
					"content": "そう、無事で何よりだわ。いずれにせよ、私たちはこの危機を乗り切ることができた。あとで群玉閣へ来てくれるかしら。この礼はしっかりとさせてもらうわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150310
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150310,
					"content": "凝光様、船隊からの報告によると、水の魔物は孤雲閣一帯から去り、周辺海域は正常に戻ったようです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150311
					],
					"speakerTitle": "正茂"
				},
				{
					"id": 110150311,
					"content": "ご苦労様、千岩軍の状態は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150312
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150312,
					"content": "凝光様が用意してくれた傷薬、それと刻晴様の指揮のおかげで、なんとか被害を最小限に抑えることができました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150313
					],
					"speakerTitle": "正茂"
				},
				{
					"id": 110150313,
					"content": "もちろん、助けに来てくれたこの方にも感謝を。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150314
					],
					"speakerTitle": "正茂"
				},
				{
					"id": 110150314,
					"content": "千岩軍を代表して、あなたにお礼を申し上げます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150315
					],
					"speakerTitle": "正茂"
				},
				{
					"id": 110150315,
					"content": "我は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150316,
						110150317
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110150316,
					"content": "申鶴がみんなを守った。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110150318
					]
				},
				{
					"id": 110150318,
					"content": "そうか、それは何よりだ。雲先生の劇を観た時、神女へと送られる称賛を素直に受け取れるようになるかもしれないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150319
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110150319,
					"content": "だが、我は英雄になろうとしたわけではなく、ただ主を守りたかっただけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150320
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110150320,
					"content": "ひとまず、兵士たちは休憩を取りなさい。でも油断は禁物よ。あれが再び訪れる可能性もある、警戒を怠らないようになさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150321
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150321,
					"content": "はっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150322
					],
					"speakerTitle": "正茂"
				},
				{
					"id": 110150322,
					"content": "長いこと影から見ていたようですが、何か結論は出ましたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150323
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150323,
					"content": "ふっ、妾の意見を聞いておるのか？もし申鶴がいなければ、此度の件はそう簡単にいかなかっただろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150324
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110150324,
					"content": "それは否定しません。しかし彼女がこの場にいなかったとしても、最終的な勝利はやはり私たちが手にしていたでしょう。無論、戦いはより苛烈を極めていたとは思いますが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150325
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150325,
					"content": "それにいざという時には、また群玉閣を落とせばいいだけの話です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150326
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150326,
					"content": "…人間が模倣し、手を加えた帰終機を見てきた。確かに新奇な発想を多少使っておったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150327
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110150327,
					"content": "失敗から学び、事前に計画を立てることで危機へと立ち向かう。前回からずいぶんと進歩したようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150328
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110150328,
					"content": "今回は及第点としておこう。これからも試練が数多と訪れるはずだ、妾はずっと見ておるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150329
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110150329,
					"content": "天権の座にいる限り、璃月の平和は私が守ります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150330
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150330,
					"content": "申鶴よ。数年前、お前がこっそりと山を下り、悲しみに満ちた顔で戻ってきたのを妾は見ていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150331
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110150331,
					"content": "今回、この璃月港を訪れ、心境に変化はあったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150332
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110150332,
					"content": "ああ、変わった。しかし、まだ上手く言葉にできそうにない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150333
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110150333,
					"content": "だが、想像をしていたよりも良いひとときだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150334
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110150334,
					"content": "ならばよい。旅人、申鶴のことは任せたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150335
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110150335,
					"content": "ふむ、あれこれ話をしておったら、申鶴の子供の頃を思い出したのだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150336
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110150336,
					"content": "それは語らずともよい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150337
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110150337,
					"content": "そうか？ふん、お前といい、あやつといい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150338
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110150338,
					"content": "まあ、聞きたくないのであればよかろう、今回は見逃してやる。さて、妾は帰るとしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150339
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110150339,
					"content": "二人とも、まずはゆっくりと休んで。落ち着いたら、また群玉閣に来てちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150340
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150340,
					"content": "群玉閣の再建と璃月が無事危機を乗り越えたこと、今回の宴はかつてないほど盛大なものになるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150317,
					"content": "劇に登場する英雄みたいだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110150318
					]
				},
				{
					"id": 110150303,
					"content": "大丈夫？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110150304
					]
				}
			]
		},
		{
			"id": 1101504,
