				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110150401,
					"content": "わあ…みんなもう来てるみたいだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110150402,
					"content": "群玉閣で凝光の宴に参加するのって、オイラはじめてだぞ！美味しそうな料理がいっぱいで目移りしちゃうな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110150403,
					"content": "ここに集まってくれた方々は、この凝光の大切な客人。今日は思う存分、宴を楽しんでちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150404
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150404,
					"content": "お酒が飲めない人は、他にも飲み物があるから安心して。美酒は心を安らかにするけれど、それは何もお酒を飲むことに限った話じゃないわ。この群玉閣から見える美しい景色を眺めるだけで、酔いしれることだってできるはずよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150405
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150405,
					"content": "聞いたか？今日、雲先生の舞台を拝めるらしいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150406
					],
					"speakerTitle": "永業"
				},
				{
					"id": 110150406,
					"content": "ああ、実はそのために俺は来たんだよ！雲先生の劇は、一つも見逃したことがないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150407
					],
					"speakerTitle": "朱陶"
				},
				{
					"id": 110150407,
					"content": "今回、『神女劈観』という演目をやるらしい。雲先生の父が執筆した劇とのことだ。あまりにも楽しみで、ここ二、三日よく眠れなくってな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150408
					],
					"speakerTitle": "朱陶"
				},
				{
					"id": 110150408,
					"content": "あっ、見て！雲先生が舞台に！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150409
					],
					"speakerTitle": "詩羽"
				},
				{
					"id": 110150409,
					"content": "私の舞台はいかがでしたでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150410
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 110150410,
					"content": "すっごくよかったぞ！機会があったら、オイラにも演技の仕方を教えてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150411
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110150411,
					"content": "見事であった。そして…礼を言わせてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150412
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110150412,
					"content": "いえ、貴方のおかげで『神女劈観』をより完璧なものに仕上げることができたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150413
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 110150413,
					"content": "劇の幕は下りましたが、貴方の人生はこの先も続いていきます。将来、きっと璃月港に馴染むことができると私は思いますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150414
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 110150414,
					"content": "ああ、感謝する。我も変わるための「きっかけ」を見つけられたようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150415
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110150415,
					"content": "雲先生…ひっく…ここにいたのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150416
					],
					"speakerTitle": "朱陶"
				},
				{
					"id": 110150416,
					"content": "ん？そこのし、白い髪の姉ちゃん、ただ者じゃないようだな。まるで仙人みたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150417
					],
					"speakerTitle": "朱陶"
				},
				{
					"id": 110150417,
					"content": "ん？まさか、お前があの神女なのか？それに、そっちは有名な旅人じゃあないか？ああ、今日は本当に来た甲斐があったな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150418
					],
					"speakerTitle": "朱陶"
				},
				{
					"id": 110150418,
					"content": "椅子をこっちに持ってきても？ほら、一緒に話そうぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150419
					],
					"speakerTitle": "朱陶"
				},
				{
					"id": 110150419,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150420
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110150420,
					"content": "残りの酒を目や鼻で飲みたくなければ、さっさと消え失せるといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150421
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110150421,
					"content": "この感じ…初めて申鶴と会った時に戻ったみたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150422
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110150422,
					"content": "道のりはまだまだ長そうだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110150423
					]
				},
				{
					"id": 110150423,
					"content": "ひぃぃっ！な、なにをする気だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150424
					],
					"speakerTitle": "朱陶"
				},
				{
					"id": 110150424,
					"content": "申鶴、落ち着けって——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
