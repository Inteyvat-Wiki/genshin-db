				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"百聞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110150101,
					"content": "凝光の秘書さん、素材を集めてきたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110150102,
					"content": "あら、早かったですね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150103
					],
					"speakerTitle": "百聞"
				},
				{
					"id": 110150103,
					"content": "なるほど、三人で一緒に探していたのですか…では素材を確認しましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150104
					],
					"speakerTitle": "百聞"
				},
				{
					"id": 110150104,
					"content": "千奇核心と仙家呪符、どちらも高品質で特に問題はないようです。これで今回の勝敗も決しましたね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150105
					],
					"speakerTitle": "百聞"
				},
				{
					"id": 110150105,
					"content": "ではここに宣言しましょう。群玉閣再建における素材集めの功労者は、旅人さん、雲菫さん、北斗さん、この三名です！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150106
					],
					"speakerTitle": "百聞"
				},
				{
					"id": 110150106,
					"content": "なんだって、もう終わりなのか？まだ浮生の石すら見つけられてないのに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150107
					],
					"speakerTitle": "宏飛"
				},
				{
					"id": 110150107,
					"content": "くっ、納得いかん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150108
					],
					"speakerTitle": "昌貴"
				},
				{
					"id": 110150108,
					"content": "はぁ、頑張りましたが、今一歩及ばなかったようです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150109
					],
					"speakerTitle": "志成"
				},
				{
					"id": 110150109,
					"content": "では、皆さんには群玉閣へと移動してもらいます。凝光様がそちらでお待ちです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150110
					],
					"speakerTitle": "百聞"
				},
				{
					"id": 110150110,
					"content": "あれ？北斗がいないけど、どこ行ったんだ？さっきまでここにいたのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110150111,
					"content": "北斗さんは用事があり、少し遅れるとのことです。ではこちらに、私と一緒に来てください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150112
					],
					"speakerTitle": "百聞"
				},
				{
					"id": 110150112,
					"content": "じゃあ、オイラたちは先に群玉閣に行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110150113,
					"content": "最後に群玉閣に行ったのって、もうかなり前のことだよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 1101502,
			"completionStepIds": [
				1101506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101506",
							"2"
						],
						"stepId": 1101506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凝光"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110150201,
					"content": "仙家呪符と千奇核心を組み合わせて、群玉閣の制御盤へと取り付ける。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150202
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150202,
					"content": "これで群玉閣の再建も無事終了ね。あとはつなぎ止めている縄を回収すれば、空高く上昇するはずよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150203
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150203,
					"content": "みんなご苦労様。さて、約束通り報酬を与えるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150204
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150204,
					"content": "やったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110150205,
					"content": "雲先生がここに来た理由については、もうすでに聞いているわ。新しい劇に相応しい舞台を探しているのよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150206
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150206,
					"content": "はい。凝光さんのご意見を伺いたいのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150207
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 110150207,
					"content": "雲先生が心を込めて準備してきた劇、きっと壮大な物語なのでしょう。なら初演は、この再建された群玉閣で行うのはどうかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150208
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150208,
					"content": "ここは天高く舞う楼閣、絶景を一望できるわ。風を感じながら、民衆の反応を見ることが出来る。ここよりも適した舞台は他にないはずよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150209
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150209,
					"content": "凝光さん、ありがとうございます。では劇の道具が準備でき次第、それを群玉閣へと手配していただけますでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150210
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 110150210,
					"content": "名演を楽しめるんだもの、これくらい遠慮しなくていいのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150211
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150211,
					"content": "旅人さん、申鶴さん、そしてパイモンさん、私はお先に失礼します。ぜひとも劇を観に来てくださいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150212
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 110150212,
					"content": "あなたは？質問したいことはあるかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150213
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150213,
					"content": "#念のため言っておくけれど、あなたの{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}の行方は私にも分からないわ。これに関しては聞かないようにしてちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150214
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150214,
					"content": "おお…さすが凝光、いつも先を読んでくるな…じゃあ、オイラの質問に答えてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150215
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110150215,
					"content": "…商売はあなたたちが思っているほど、単純なものじゃない。経済力、人脈、流れ、機を捉えるための嗅覚…必要なものは多岐に渡るわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150216
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150216,
					"content": "もしモラを稼ぐ方法を聞きたいのであれば、約束通り答えましょう。でも今のあなたたちには、あまりお勧めできないのが正直なところね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150217
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150217,
					"content": "おい——オイラ、まだなにも聞いてないのに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110150218,
					"content": "ふふっ、すべて顔に書いてあるんだもの、一目見ただけで分かるわ。もちろん、群玉閣の再建を手伝ってくれたのだし、それにはちゃんと応えるから安心してちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150219
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150219,
					"content": "もしモラに困ったら、私が雇ってあげる。報酬については、最高水準のものを用意するわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150220
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150220,
					"content": "やったぞ！今度もしモラが必要になったら、凝光のとこにいけばいいんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150221
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110150221,
					"content": "オイラたちが聞きたいことはもう聞いたぞ。申鶴はなにを聞くんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150222
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110150222,
					"content": "我もいいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150223
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110150223,
					"content": "もちろん！だって、みんなで力を合わせて素材を集めたんだからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150224
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110150224,
					"content": "感謝する…しかし、我が聞きたいことは特に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150225
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110150225,
					"content": "そう？滅多にない機会よ、無駄にするのはもったいないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150226
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150226,
					"content": "もったいないことはしちゃダメだぞ！う―ん、なにか聞きたいことはないのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150227
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110150227,
					"content": "凝光殿、その…我は璃月港に馴染めるだろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150228
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110150228,
					"content": "へえ、面白い質問ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150229
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150229,
					"content": "璃月港は寛容な場所よ。規則を守っていれば、あなたを拒むことはないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150230
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150230,
					"content": "つまり、大切なのはあなたが璃月港への「帰属意識」を持てるかどうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150231
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150231,
					"content": "帰属意識？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150232
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110150232,
					"content": "そう。ある場所を好きになったり、そこに馴染もうとしたりするのには…必ず理由があるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150233
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150233,
					"content": "その地で出会った人、経験した事、もしくは璃月の雰囲気が好きで、その生活を気に入っているなんて理由もあるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150234
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150234,
					"content": "とにかく、璃月港に残って生活するのなら、誰であろうと理由が必要よ。あなたもそれを早く見つけられるといいわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150235
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150235,
					"content": "…承知した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150236
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110150236,
					"content": "よう、話し中か？野暮用で船隊に戻っててな、少し遅れちまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150237
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 110150237,
					"content": "おっ、ちょうど北斗の番だぞ！北斗はなにを聞くんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150238
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110150238,
					"content": "アタシか？あー、アタシは特に聞きたいことはないな。今回は凝光のやつに無理やり手伝わされたんだよ、これに参加したのはついでだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150239
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 110150239,
					"content": "凝光、この前の約束、忘れるなよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150240
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 110150240,
					"content": "あれはかなり厄介だ。アタシの船隊だけじゃ、対処しきれないかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150241
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 110150241,
					"content": "心配ないわ、もう手は打ってある。傷薬の準備も万全だし、千岩軍も待機しているわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150242
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150242,
					"content": "ならいい。だが気を付けろよ、油断は禁物だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150243
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 110150243,
					"content": "北斗、凝光、なんの話をしてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150244
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110150244,
					"content": "群玉閣が空高く昇った時、自然と分かるはずよ。でも…決していいことではない、知らないほうが幸せかもしれないわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150245
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150245,
					"content": "初めて群玉閣を訪れた時、私は高台の端に立ち、空から璃月港を眺めたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150246
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150246,
					"content": "その時、私はいつの日かこの群玉閣の影で、七国を覆い尽くそうと考えた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150247
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150247,
					"content": "今でも私の願いは変わらない。でも、今回の群玉閣の再建は、私自身のためだけではないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150248
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150248,
					"content": "私が願うは、群玉閣がこの先も永遠に璃月港の上空を飛び、世の繁栄と平和を見守ること。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150249
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150249,
					"content": "…みんなも一緒に、それを見届けてちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150250
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150250,
					"content": "昇空儀式、これより開始するわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凝光"
				}
			]
		},
		{
			"id": 1101503,
			"completionStepIds": [
				1101503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
