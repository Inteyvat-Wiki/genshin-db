				{
					"id": 223011707,
					"content": "私が聞いた時は既に前の話が終わったから、その後は確か…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011708
					],
					"speakerTitle": "江舟"
