			},
			"dialogs": [
				{
					"id": 223010201,
					"content": "戻ってきたのか、ご苦労さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010202
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 223010202,
					"content": "講談は話せば話すほど内容を忘れてしまう。仕方のないことだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010203
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 223010203,
					"content": "その、答えは分かったかね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "茶博士劉蘇"
				}
			]
		},
		{
			"id": 2230104,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2230108",
							"2"
						],
						"stepId": 2230108,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"99902",
							"3"
						],
						"stepId": 99902,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"茶博士劉蘇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223010401,
					"content": "まだここにいるんだね。ハハハッ、私の講談…どう思うかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010402,
						223010405
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 223010402,
					"content": "ほかには？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223010403
					]
				},
				{
					"id": 223010403,
					"content": "ほら、『裁雨の音』と『海山履雲記』、どちらも名作だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010404
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 223010404,
					"content": "二言三言では終わらない。続きを聞きたいなら、時間を見てまた来ればいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010407
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 223010407,
					"content": "今回の講談は君のおかげでうまくいった。これはお礼だ。これからもよろしく頼むよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 223010405,
					"content": "次回お楽しみにしか覚えてない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223010406
					]
				},
				{
					"id": 223010406,
					"content": "ハハッ、続きが聞きたいなら、何回も来ておくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010407
					],
					"speakerTitle": "茶博士劉蘇"
				}
			]
		},
