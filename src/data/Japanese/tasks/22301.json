			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"茶博士劉蘇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223010101,
					"content": "しまった、どこまで話したかね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010102
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 223010102,
					"content": "何の話？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223010103
					]
				},
				{
					"id": 223010103,
					"content": "どうも、講談を聞きにきたのかね？それとも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010104
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 223010104,
					"content": "私？私は小遣いを稼ぐため、ここで講談をしているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010105
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 223010105,
					"content": "ただ講談の数が多く、内容もそれぞれ違うから、時に間違えたりもするんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010106
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 223010106,
					"content": "数日前、南十字船隊の物語『海山履雲記』が聞きたいお客たちと、古華派の物語『裁雨の音』が聞きたいお客たちがいたんだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010107
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 223010107,
					"content": "こちらも商売だから仕方なく、それぞれ一部を話したんだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010108
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 223010108,
					"content": "お客がハマってどうしても続きを聞きたいと言ってきたんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010109
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 223010109,
					"content": "この二つの話は数年前に話したものだからよく覚えてなくてね、これから本を読みながら思い出す予定だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010110
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 223010110,
					"content": "しかし、前回どこまで話したか忘れてしまったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010111
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 223010111,
					"content": "外にいる方々にさりげなく聞いてもらえないかね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010112,
						223010114
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 223010112,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223010113
					]
				},
				{
					"id": 223010113,
					"content": "迷惑をかけてすまないね。私が聞きに行ったら、自分の看板に泥を塗ることになるから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010118
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 223010118,
					"content": "少し考えてみたが、あの三人に聞いた方がいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010119
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 223010119,
					"content": "一人は<color=#00E1FFFF>茂才公</color>、この方は一度も欠かさず聞いてくれた。もう一人は<color=#00E1FFFF>範二</color>殿、ここのオーナーだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010120
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 223010120,
					"content": "最後の一人は<color=#00E1FFFF>江舟</color>さん、前回はすぐに帰ったが、前半は聞いてくれたはずだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 223010114,
					"content": "いっそ、初めから…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223010115
					]
				},
				{
					"id": 223010115,
					"content": "私もそうしたいよ、二倍のお金がもらえるんだから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010116
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 223010116,
					"content": "でもそうすると範二殿に追い出される…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010117
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 223010117,
					"content": "頼む、代わりに聞いてきてほしいんだ。答えが分かったら教えてくれ。様子を見て講談を始めるよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010118
					],
					"speakerTitle": "茶博士劉蘇"
				}
			]
		},
		{
			"id": 2230102,
