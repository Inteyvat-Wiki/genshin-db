			},
			"dialogs": [
				{
					"id": 10091501,
					"content": "ん？なんでこんなとこに石のテーブルが？しかも、食器と酒壺がたくさん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10091502,
					"content": "隣りの椅子には字が刻んであるな。「此処に留雲が居る」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091510
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10091510,
					"content": "「此処に帰終が座る」、それと「此処を帝君が借りた」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10091503,
					"content": "「帝君」って、もしかして「岩王帝君」のことか？「帰終」は…ちょっと分からないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10091504,
					"content": "「留雲」…そうだ！あの削月築陽真君が言ってた仙人の中に、「留雲借風真君」がいた！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10091505,
					"content": "ってことは、ここはあの「留雲借風真君」が他の仙人と一緒に食事をする場所なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091506
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10091506,
					"content": "へへ、もしそうなら、仙人の好物を作れば、あの「留雲借風真君」の気を引けるかもしれないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091507
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10091507,
					"content": "でも仙人って、どんな料理が好きなんだろうな？全然分からない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091508
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10091508,
					"content": "しょうがない、周りを見てみよう。過去に参拝しに来た人が、何か手がかりを残してくれてるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091509
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10091509,
					"content": "そうだ、仙人って…ニンジンとお肉のハニーソテーって好きだと思うか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
