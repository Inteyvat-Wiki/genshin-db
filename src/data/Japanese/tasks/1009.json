			},
			"dialogs": [
				{
					"id": 10090201,
					"content": "どうやらここで誰かが料理をしたみたいだな。仙人へのお供え物を作ったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10090202,
					"content": "使い残しの食材がある。キンギョソウ…ハスの花托…そして豆腐、手間がかかりそうな料理だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10090203,
					"content": "おっ、あそこ見てみろよ、なんかノートみたいなのがあるぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10090204,
					"content": "ムズカシイ料理だから、レシピをメモするのも無理ないな…オイラたちも確認してみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 100903,
			"completionStepIds": [
				100903
			],
