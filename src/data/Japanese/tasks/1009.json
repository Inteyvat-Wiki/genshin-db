			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 10090301,
					"content": "うわ、小麦粉が地面に散乱してる。ここで料理をしてたやつはいい加減だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10090302,
					"content": "鍋の中にあるのは肉だな…なんの肉かは分からないけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10090303,
					"content": "この料理、もしかして仙人へのお供え物か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10090304,
					"content": "うーん…「肉類」と「小麦粉」を使う料理か…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10090305,
					"content": "あれ？なんか紙が地面に落ちてるぞ…しかも、足跡で半分汚れてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10090306,
					"content": "この紙、料理となにか関係があるのか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 100904,
			"completionStepIds": [
				100904
