				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10091401,
					"content": "妾の仙境を通過するとは、大した者だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091402
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 10091402,
					"content": "妾は留雲借風真君。お前達、何しにここへ来た。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091403,
						10091405
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 10091403,
					"content": "この仙境は仙人が造ったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091404
					]
				},
				{
					"id": 10091404,
					"content": "当たり前だ。仙境だけでなく、あの仕掛けも妾が作ったものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091407
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 10091407,
					"content": "妾の「仕掛けの術」は、たとえ「帰終」や岩王帝君であろうとも称賛する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091408
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 10091408,
					"content": "こんな大きな仙境に、一人で住んでるのか？しかも、大量の仕掛け付きで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091409
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10091409,
					"content": "まさか「仕掛けの術」を研究するため、一人でこんなところに？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091410
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10091410,
					"content": "伝説と同じで、仙人たちって人間界を離れて隠居しながら、すっごいものを研究してるんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091411
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10091411,
					"content": "妾は…ただ人や仙人と接するのが億劫で、静寂を求めただけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091412
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 10091412,
					"content": "だが、その静寂も長くは続かなかった。お前達がその「禁忌滅却の札」を持って、ここにやってきたからな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091413
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 10091413,
					"content": "まあよい！お前達、用事は何だ。手短に頼もう、妾の休息を邪魔してほしくないのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091414
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 10091414,
					"content": "帝君が…帝君が暗殺された、だと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091415
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 10091415,
					"content": "な、なんてことだ！誰がそんな大罪を犯した！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091416
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 10091416,
					"content": "このような荒唐無稽な話、到底信じられん。調べさせてもらうぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091417
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 10091417,
					"content": "いや、いっそ先に璃月港を鎮圧してやろうか。あとで衆仙で——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091418
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 10091418,
					"content": "…えっ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091419
					]
				},
				{
					"id": 10091419,
					"content": "えっ！？ちょ、ちょっと待った！璃月港を鎮圧って、なに言ってんだよ？璃月港を全部ぶっ壊す気か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091420
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10091420,
					"content": "二度と同じ過ちが起こらぬよう、雷霆が如き手段を選ぶのもやぶさかではない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091421,
						10091423
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 10091421,
					"content": "#でも{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYSECOND|INFO_FEMALE_PRONOUN_GIRLSECOND]}は璃月港を守る仙人だ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091422
					]
				},
				{
					"id": 10091422,
					"content": "そうだ、帝君の律令に従い、妾たちは璃月港を3700年以上守ってきた。だが今、そこに悪が存在する以上、非常な手段も取らざるを得ない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091425
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 10091425,
					"content": "妾は人の苦しみなど見たくない。だからこそ、このような時には非常な手段を取らざるを得ないのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091426
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 10091426,
					"content": "おいおい！なんとかしろ、この仙人本気みたいだぞ！本当に璃月港を鎮圧する気だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091427
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10091427,
					"content": "お供え物を捧げた、「契約」に従って…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091428
					]
				},
				{
					"id": 10091428,
					"content": "そうだ！美味しい料理をいっぱい作ったんだ、全部やろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091429
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10091429,
					"content": "なあ、「鎮圧」とかじゃなくて璃月港を守って欲しいんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091430
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10091430,
					"content": "せめて…他の仙人の意見を聞いてくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091431
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10091431,
					"content": "…「契約」か。契約の神が暗殺された今、その言葉は皮肉でしかないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091432
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 10091432,
					"content": "璃月港の人間は時折り「契約」を蔑ろにし、白黒をあやふやにする連中だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091433
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 10091433,
					"content": "だが…お前達が「契約」の名のもとで妾に協力を求めるのなら、妾も「契約」を無視することはできぬ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091434
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 10091434,
					"content": "その上、お前達は「禁忌滅却の札」を持ってきた…帝君がその神札を作った時、仙力を注ぎ込み、人間へと与えたが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091435
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 10091435,
					"content": "今、その神札に仙力はほとんど残っていない。ただの誓約の証にすぎない代物だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091436
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 10091436,
					"content": "さらにお前達の話の真偽を証明するものでもない。さっきの話に偽りがないか調べさせてもらう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091437
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 10091437,
					"content": "削月築陽真君の招へいも、そのためだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091438
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 10091438,
					"content": "もういい、速やかに去るが良い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 10091423,
					"content": "凡人を守るはずでは…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091424
					]
				},
				{
					"id": 10091424,
					"content": "そうだ。だが、いま帝君が暗殺され、璃月港も危うい状況だ。早々に鎮圧しなければ、災難が蔓延する恐れがある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091425
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 10091405,
					"content": "この仙境の仕掛けは仙人が作ったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091406
					]
				},
				{
					"id": 10091406,
					"content": "当たり前だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091407
					],
					"speakerTitle": "留雲借風真君"
				}
			]
		},
