			},
			"dialogs": [
				{
					"id": 10090401,
					"content": "綺麗に片付いてるな。ここで料理をした人は、後片付けをちゃんとしたみたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10090402,
					"content": "たぶん、仙人へのお供え物を作ったんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10090403,
					"content": "この食材は…「松茸」と「獣肉」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10090404,
					"content": "レシピが隣りに置いてある。ここで料理をした人は本当に几帳面だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
