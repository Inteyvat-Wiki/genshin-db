			},
			"dialogs": [
				{
					"id": 190361601,
					"content": "ん、まだ出発しないの？もしかして気が変わった？行かないほうがいいよ、あいつと関わるのは賢明じゃないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361602
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 190361602,
					"content": "彼と何かあったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361603
					]
				},
				{
					"id": 190361603,
					"content": "もし彼が永遠に消えてくれれば、とっても喜ぶわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361604
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 190361604,
					"content": "（微笑って返しておこう。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361605
					]
				},
				{
					"id": 190361605,
					"content": "ははっ、そんな目で見ないでよ。気に食わない人ぐらい、誰にだっているでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361606
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 190361606,
					"content": "とにかく、早めに出た方がいいわ。鹿野院が大事件を起こさないうちにね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361607
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 190361607,
					"content": "そうだ、もし偶然やつの遺品を見つけたりしたら、絶対私に教えて喜ばせてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚"
				}
			]
		},
