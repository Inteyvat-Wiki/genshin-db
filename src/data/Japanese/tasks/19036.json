			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"龍二",
					"珊瑚"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190361401,
					"content": "もしあの旅人も時間がなかったら、どうしよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361402
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361402,
					"content": "あんな面倒ごとを勝手に引き受ける君が悪いのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361403
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 190361403,
					"content": "あら、でも運がいいわね。救世主のお出ましだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361404
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 190361404,
					"content": "えっ？本当だ！旅人、来てくださったんですね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361405
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361405,
					"content": "#安心して、{M#俺}{F#私}は暇だから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361406
					]
				},
				{
					"id": 190361406,
					"content": "これが「噂をすれば」ってやつね、暇人さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361407
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 190361407,
					"content": "所長！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361408
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361408,
					"content": "旅人と比べれば、所長の方が暇人じゃないですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361409
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361409,
					"content": "いいえ、私はとても忙しいの。一日中ここに立っているから…大変なのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361410
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 190361410,
					"content": "どんなに引き受けたくない依頼だとしても、その言い訳はあまりにも適当すぎますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361411
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361411,
					"content": "引き受けたくない依頼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361412
					]
				},
				{
					"id": 190361412,
					"content": "そうです…それが旅人にわざわざ来ていただいた理由なんです。詳しく説明させてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361413
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361413,
					"content": "最近、天領奉行の重要人物が失踪したのですが、まったく行方が分からず、連絡できる手段もないのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361414
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361414,
					"content": "ですが諸般の事情により、天領奉行が大々的に捜索するのは不都合ということで、この人物の捜索を内密に私たちに託したのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361415
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361415,
					"content": "その人物の名は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361416
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361416,
					"content": "九条裟羅よ、大将である彼女がいなくなったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361417
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 190361417,
					"content": "…もし実際にあの大将が行方不明なら、稲妻全土を徹底的に捜査するべきですし…私たちだけに依頼するわけがないでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361418
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361418,
					"content": "旅人、所長の冗談は無視してください。失踪者の名前は、「鹿野院平蔵」と言うんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361419
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361419,
					"content": "彼は奉行所の特別探偵で、階級はただの同心なのですがその実力は侮れず、奉行所からも高く評価されています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361420
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361420,
					"content": "あら？私以上の実力者なのかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361421
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 190361421,
					"content": "所長、手助けは望んでいませんから、せめて邪魔しないでくださいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361422
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361422,
					"content": "旅人、申し訳ないのですが、私はこの依頼を引き受けたものの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361423
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361423,
					"content": "見ての通り…所長は手伝いたくないようで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361424,
						190361425
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361424,
					"content": "報酬が少ないから？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361426
					]
				},
				{
					"id": 190361426,
					"content": "どっちも不正解！零点よ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361427
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 190361427,
					"content": "正直、あのガキとは関わりたくないのよ。それが手伝いたくない理由。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361428
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 190361428,
					"content": "もし「鹿野院が行方不明」よりも喜ばしいことがあるとすれば…「鹿野院が百年間行方不明」！これしかないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361429
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 190361429,
					"content": "コホン…つまり、珊瑚所長と平蔵さんは、過去のことでちょっと不仲でして。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361430
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361430,
					"content": "なるほど…同業者は揉めやすいからね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361431
					]
				},
				{
					"id": 190361431,
					"content": "コホン…それが、実際はそういうことよりも深刻でして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361432
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361432,
					"content": "平蔵さんは真実の聖域に向かうための足かせになると、所長は言っていました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361433
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361433,
					"content": "あんなやつ、ただの犬っころだわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361434
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 190361434,
					"content": "はぁ…平蔵さんはなんて言うか…とても個性的で…でも、間違いなくいい人です。昔は色々と教えてくれたりもして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361435
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361435,
					"content": "だから所長に助ける気がなくとも、私は無視するわけにいきません。少なくとも依頼を信頼できる人物、例えば旅人のような凄腕の人に任せたいのです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361436,
						190361437
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361436,
					"content": "#つまり、{M#俺}{F#私}は下請け業者ってことだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361438
					]
				},
				{
					"id": 190361438,
					"content": "え…そ、そんなことないですよ！その…もちろん天領奉行からの報酬は全て差し上げますし、私個人からも少しお渡しします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361439
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361439,
					"content": "ですからどうか、この依頼を引き受けてほしいのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361440
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361440,
					"content": "もし平蔵さんが事件に巻き込まれているとしても、あなたがいれば安心ですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361441,
						190361445
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361441,
					"content": "彼のことをよく知っているの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361442
					]
				},
				{
					"id": 190361442,
					"content": "実はとっても仲がいいんです。ただ珊瑚所長からは彼とは距離を置くよう言われていて、公の場で親しげに振る舞うことは許されていません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361443
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361443,
					"content": "だから人に聞かれたときは、平蔵さんとは何度かお会いしているとしか答えないんです。今日だって、この件がなければ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361444
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361444,
					"content": "コホン…話はこれくらいにしておきましょう。その、彼を探してきてくださいませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361449
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361449,
					"content": "分かった、すぐに出発する。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361450
					]
				},
				{
					"id": 190361450,
					"content": "はい、私が伝えられる情報はこれくらいです。奉行所の依頼書をお渡ししますので、平蔵さんを見つけたら直接奉行所にご報告願います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361445,
					"content": "いいけど、もうちょっと情報が欲しい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361446
					]
				},
				{
					"id": 190361446,
					"content": "ありがとうございます！確か平蔵さんは失踪する前、海祇島に興味を持たれていたはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361447
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361447,
					"content": "戦時中は海祇島で任務に就いていて、戦後も頻繁に島を行き来していたみたいですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361448
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361448,
					"content": "あなたは珊瑚宮と長い付き合いだそうですし、そこを捜査の起点とするのがいいと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361449
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361437,
					"content": "#分かった、{M#君}{F#あなた}は中抜きするわけだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361438
					]
				},
				{
					"id": 190361425,
					"content": "手がかりが少ないから？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361426
					]
				}
			]
		},
		{
			"id": 1903615,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1903606",
							"2"
						],
						"stepId": 1903606,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"龍二"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190361501,
					"content": "旅人、早めに出発してくださいね。平蔵さんが危険に遭っていないことを祈ります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361502
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361502,
					"content": "鹿野院平蔵について詳しく教えて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361503
					]
				},
				{
					"id": 190361503,
					"content": "平蔵さんですか？活力に満ちた人ですよ！お喋り好きで、明るくてとても元気で、前向きに突き進む姿しか見たことがありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361504
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361504,
					"content": "所長はいつも彼のことをブンブン飛ぶハエのようだと言っていました。きっと、卵の割れ目を見つけるハエのように目ざとく、小さな痕跡を正確に見つけることができるからでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361505
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361505,
					"content": "つまり、平蔵さんは普通のハエじゃなく、天才的なハエなのかもしれませんね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361506
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361506,
					"content": "たとえ嗅覚や視覚、そして聴覚を遮ったとしても、卵の割れ目をちゃんと見つけられるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361507
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361507,
					"content": "不思議ですよね。まるで五感以外の第六感を頼りにしているようです。勘？それとも神の救いの手？それとも他の何か…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361508,
						190361510
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361508,
					"content": "斬新だけど、その例えはもういいや。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361509
					]
				},
				{
					"id": 190361509,
					"content": "あ、所長にいつも説明が下手と言われるのですが、やっぱりそうなんでしょうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361510,
					"content": "変な例えだね、でももっと聞きたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361511
					]
				},
				{
					"id": 190361511,
					"content": "コホン…またの機会にしましょう…所長がこっちを睨んでいるので…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龍二"
				}
			]
		},
