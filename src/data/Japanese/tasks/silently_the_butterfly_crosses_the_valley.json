					"nextDialogs": [
						711151203
					],
					"speakerTitle": "「きままな仙像」"
				},
				{
					"id": 711151203,
					"content": "台詞を最後まで覚えてなかったくせに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711151204,
					"content": "細かいことは気にせんでよいのじゃ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151205
					],
					"speakerTitle": "「きままな仙像」"
				},
				{
					"id": 711151205,
					"content": "そうじゃ、もし興味があるなら、ちょっとした秘密をおぬしらに教えてやろう！花の枝を折り、仙人洞の外にある壊れた薬壺にそれを差すと、石門が開く…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
