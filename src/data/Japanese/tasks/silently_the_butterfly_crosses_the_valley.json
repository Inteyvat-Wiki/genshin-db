			},
			"dialogs": [
				{
					"id": 711150601,
					"content": "フゥ…そうじゃ、こいつじゃ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150602
					],
					"speakerTitle": "「きままな仙像」"
				},
				{
					"id": 711150602,
					"content": "以前、洞府の薬君様は扉を飾るために彩蝶を集めていらっしゃったんじゃが…洞府の仕掛けは壊れてしまった。彩蝶と薬壺は…もともと仙樹に栄養を与えるために使っておったものじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150603
					],
					"speakerTitle": "「きままな仙像」"
				},
				{
					"id": 711150603,
					"content": "仙樹？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711150604,
					"content": "フフン、そうじゃ！この仙樹は当時、薬君様が自ら植えたもの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150605
					],
					"speakerTitle": "「きままな仙像」"
				},
				{
					"id": 711150605,
					"content": "今では枯れてしまったが…彩蝶が残っていさえすれば仙樹は復活すると薬君様が仰っていたんじゃ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150606
					],
					"speakerTitle": "「きままな仙像」"
				},
				{
					"id": 711150606,
					"content": "だが…人の姿を維持できなくなってからすぐ、薬君は姿を消してしまわれた。今頃どうなさっているのやら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150607
					],
					"speakerTitle": "「きままな仙像」"
				},
				{
					"id": 711150607,
					"content": "それで、何をすればいいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711150608
					]
				},
				{
					"id": 711150608,
					"content": "おお、すまんすまん。つい薬君様の思い出に浸ってしもうた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150609
					],
					"speakerTitle": "「きままな仙像」"
				},
				{
					"id": 711150609,
					"content": "オホン…人間よ、よく聞け！彩蝶を壺の中に入れさえすれば、枯れ木に養分を与えることができるんじゃ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150610
					],
					"speakerTitle": "「きままな仙像」"
				},
				{
					"id": 711150610,
					"content": "フフン、これぞ薬君様が作り上げた仙人の仕掛け！不思議じゃろう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150611,
						711150613
					],
					"speakerTitle": "「きままな仙像」"
				},
				{
					"id": 711150611,
					"content": "試してみる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711150612
					]
				},
				{
					"id": 711150612,
					"content": "ウム、それでは頼んだぞ。親切な人間よ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「きままな仙像」"
				},
				{
					"id": 711150613,
					"content": "どうして彩蝶なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711150614
					]
				},
				{
					"id": 711150614,
					"content": "ム？確かに、どうしてじゃろうな…薬君様は彩蝶が好きだったんじゃろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150615
					],
					"speakerTitle": "「きままな仙像」"
				},
				{
					"id": 711150615,
					"content": "ウム…とにかく、あの彩蝶たちを壺の中に戻してくれ。頼んだぞ、親切な人間よ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「きままな仙像」"
				}
			]
		},
