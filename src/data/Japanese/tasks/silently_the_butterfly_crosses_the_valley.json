				]
			},
			"dialogs": [
				{
					"id": 711150401,
					"content": "む…んっ？おぬしらは何じゃ？わしの夢見を邪魔しおって…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150402
					],
					"speakerTitle": "「きままな仙像」"
				},
				{
					"id": 711150402,
					"content": "えっ！？どこから声が聞こえてるんだ？こ、怖いぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711150403,
					"content": "…わっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150404
					],
					"speakerTitle": "「きままな仙像」"
				},
				{
					"id": 711150404,
					"content": "うわああ！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711150405,
					"content": "ははははは！どうだ、怖いじゃろう！もしわしがこうして石に閉じ込められていなければ、おぬしらはとっくにわしの腹の中じゃ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150406
					],
					"speakerTitle": "「きままな仙像」"
				},
				{
					"id": 711150406,
					"content": "えっ…？なんだ、ただの話せる石像かよ…化け物かなんかかと思ったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150407
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711150407,
					"content": "フン、なんじゃ、「ただの話せる石像」とは！石像が話せるのが恐ろしくないというのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150408
					],
					"speakerTitle": "「きままな仙像」"
				},
				{
					"id": 711150408,
					"content": "えっ、だって…そういう石像なら他のところでもいっぱい見たし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150409
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711150409,
					"content": "な、なに！…まぁよい。おぬしらを驚かせることはできなかったようじゃの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150410
					],
					"speakerTitle": "「きままな仙像」"
				},
				{
					"id": 711150410,
					"content": "なんで人を驚かせようとするんだよ！ただの石像のくせに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150411
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711150411,
					"content": "フン！わしが「ただの石像」だとしても、この地は薬君様の洞府なんじゃ！薬君様がまだいらっしゃった頃は、安らぎの時間を誰かに邪魔されることを好いてはおられんかった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150412
					],
					"speakerTitle": "「きままな仙像」"
				},
				{
					"id": 711150412,
					"content": "だから、わしは嫌な連中をみんな驚かせて追い払っておるんじゃ！薬君様がいなくなっても同じことじゃ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150413
					],
					"speakerTitle": "「きままな仙像」"
				},
				{
					"id": 711150413,
					"content": "しかし、おぬしらからは普通の凡人どもとは違う雰囲気じゃな。わしの声にも驚かなんだし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150414
					],
					"speakerTitle": "「きままな仙像」"
				},
				{
					"id": 711150414,
					"content": "よかったら、わしにちょっと力を貸してくれんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150415
					],
					"speakerTitle": "「きままな仙像」"
				},
				{
					"id": 711150415,
					"content": "えっ？なにを手伝ってほしいんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150416
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711150416,
					"content": "フム…この色彩豊かな蝶を見るがよい！洞府の主がいなくなってから、やつらはあちこちに散らばってしもうて、そこら中を飛び回っておる——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150417
					],
					"speakerTitle": "「きままな仙像」"
				},
				{
					"id": 711150417,
					"content": "しーっ…おまえの頭の上にちょうど一匹いるぞ！ちょっと待ってろ、オイラたちが捕まえてやるから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
