			"dialogs": [
				{
					"id": 711151101,
					"content": "おい！彩蝶を全部壺の中に戻したけど、仙樹はちっとも変わらないじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711151102,
					"content": "うん？おぬしらは何じゃ？わしの…ああ、おぬしらか。親切な人間どもよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151103
					],
					"speakerTitle": "「きままな仙像」"
				},
				{
					"id": 711151103,
					"content": "おお！まさか本当に彩蝶を全部見つけてくるとは！何となく言っただけなのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151104
					],
					"speakerTitle": "「きままな仙像」"
				},
				{
					"id": 711151104,
					"content": "い、いや！つまりじゃな…仙力の脈動をわしも感じたということじゃ！ならば次は、薬君様の残してくださった口上を唱えれば仙樹に生気が蘇るはずじゃ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151105
					],
					"speakerTitle": "「きままな仙像」"
				},
				{
					"id": 711151105,
					"content": "ええと、何じゃったかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151106
					],
					"speakerTitle": "「きままな仙像」"
				},
				{
					"id": 711151106,
					"content": "「…木々は玄冬に生まれ、栄枯の歳月を重ねる。我が思いは春に逢い、再た盛んに生い茂る…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151107
					],
					"speakerTitle": "「きままな仙像」"
				},
				{
					"id": 711151107,
					"content": "…蝶が舞う…舞う…後半は忘れてしもうた。とにかく最後は「万象帰す」じゃ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「きままな仙像」"
				}
			]
		},
