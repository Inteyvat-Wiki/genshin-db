					}
				]
			},
			"dialogs": [
				{
					"id": 711150501,
					"content": "フゥ…そうじゃ、こいつじゃ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150502
					],
					"speakerTitle": "「きままな仙像」"
				},
				{
					"id": 711150502,
					"content": "以前、洞府の薬君様は扉を飾るために彩蝶を集めていらっしゃったんじゃが…洞府の仕掛けは壊れてしまった。彩蝶と薬壺は…もともと仙樹に栄養を与えるために使っておったものじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150503
					],
					"speakerTitle": "「きままな仙像」"
				},
				{
					"id": 711150503,
					"content": "仙樹？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711150504,
					"content": "フフン、そうじゃ！この仙樹は当時、薬君様が自ら植えたもの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150505
					],
					"speakerTitle": "「きままな仙像」"
				},
				{
					"id": 711150505,
					"content": "今では枯れてしまったが…彩蝶が残っていさえすれば仙樹は復活すると薬君様が仰っていたんじゃ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150506
					],
					"speakerTitle": "「きままな仙像」"
				},
				{
					"id": 711150506,
					"content": "だが…人の姿を維持できなくなってからすぐ、薬君は姿を消してしまわれた。今頃どうなさっているのやら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150507
					],
					"speakerTitle": "「きままな仙像」"
				},
				{
					"id": 711150507,
					"content": "「彩蝶が壺に集まり、枯れ木を蘇らせる…」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711150508
					]
				},
				{
					"id": 711150508,
					"content": "おお、そうじゃ！その…ちょっと待て、どうしてそれを知っているんじゃ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150509
					],
					"speakerTitle": "「きままな仙像」"
				},
				{
					"id": 711150509,
					"content": "まぁよい、とにかくそういう事じゃ！彩蝶を壺の中に入れさえすれば、枯れ木に養分を与えることができる！では頼んだぞ、親切な人間よ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「きままな仙像」"
				}
			]
		},
