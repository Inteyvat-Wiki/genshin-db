				]
			},
			"dialogs": [
				{
					"id": 760020301,
					"content": "ふぅ…逃げられたか。こいつらもバカだな。俺らに楯突くとはよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020302
					],
					"speakerTitle": "バス"
				},
				{
					"id": 760020302,
					"content": "手助け感謝する。仲間たちが「ベルヴィル・マドモワゼル」をナシャタウンまで送り届けたら、二人の取り分はちゃんと確保しておくぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020303
					],
					"speakerTitle": "バス"
				},
				{
					"id": 760020303,
					"content": "うんうん、報酬のことさえ覚えててくれれば…って、ちょ、ちょっと待て！おまえら、人さらいなのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760020304,
					"content": "とんだ誤解だ、お嬢ちゃん。人さらいなんかじゃないさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020305
					],
					"speakerTitle": "バス"
				},
				{
					"id": 760020305,
					"content": "「ベルヴィル・マドモワゼル」ってのはこの鉄くずの名前なんだ。サーンドル河から運んでくるのは一苦労だった。誰かに奪われちまったら、大損だぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020306
					],
					"speakerTitle": "バス"
				},
				{
					"id": 760020306,
					"content": "ああ、フォンテーヌのクロックワーク・マシナリーだったのか…フォンテーヌの技術力ってすごいな。こんなとこまで運んできても動くなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760020307,
					"content": "ハハッ、また冗談か？この鉄くずのエネルギーシステムなんて、とっくに引っぺがされてる。動くわけないだろ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020308
					],
					"speakerTitle": "バス"
				},
				{
					"id": 760020308,
					"content": "「警告。起動モード<color=#FF5E41FF>異常</color>。エネルギーモジュール<color=#FF5E41FF>異x5F02&#5E38常</color>。認証失敗。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020309
					],
					"speakerTitle": "「ベルヴィル・マドモワゼル」"
				},
				{
					"id": 760020309,
					"content": "「認証失敗。<color=#FF5E41FF>認証失敗</color>。<color=#FF5E41FF>認証失敗</color>。<color=#FF5E41FF>殲滅</color>。<color=#FF5E41FF>殲滅</color>。<color=#FF5E41FF>殲滅</color>。<color=#FF5E41FF>殲滅殲滅殲滅殲</color>——」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020310
					],
					"speakerTitle": "「ベルヴィル・マドモワゼル」"
				},
				{
					"id": 760020310,
					"content": "#うわぁ——！{NICKNAME}、気を付けろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
