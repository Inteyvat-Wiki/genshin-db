			"dialogs": [
				{
					"id": 760020101,
					"content": "#おい、そこの金髪{M#の兄貴}{F#の姉貴}！いいところに来たな。売られたケンカを買うとこなんだ。ちょっと手ぇ貸してくれ！あとで分け前はちゃんとやるからよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020102
					],
					"speakerTitle": "バス"
				},
				{
					"id": 760020102,
					"content": "#なんだ、一人じゃ勝てないからって仲間を引き込もうってか？いいだろう、そっちがそう出るなら、こっちもだ。{M#兄ちゃん}{F#お嬢ちゃん}、こっちにつけ！こいつをやっちまえたら、モラは半分あんたにやる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020103
					],
					"speakerTitle": "ホイカ"
				},
				{
					"id": 760020103,
					"content": "え、えぇ！？オイラたちは通りすがりで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
