					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730980401,
					"content": "えーっと…どれどれ…新しい宝の地図が現れたみたいだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730980402,
					"content": "「閉じ込められたアランナラ」はいいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980403
					]
				},
				{
					"id": 730980403,
					"content": "#こほん！そうだぞ。家の所有者が見つからなくて、すっごく心配なんだ！だから{NICKNAME}、考えがあるんだけど、絵に描かれた場所に行ってみるのはどうだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730980404,
					"content": "そこに着いたら、絵に描かれた通り…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980405,
						730980407
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730980405,
					"content": "お宝をもっと発見？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980406
					]
				},
				{
					"id": 730980406,
					"content": "そうだ！いやっ、違う！助けを求めるアランナラを発見だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980409
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730980409,
					"content": "えっと…この「メールボックス」って、なんだか不思議だな。ここにも新しい絵が送られてくる可能性があるから、後で見てみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730980407,
					"content": "「閉じ込められたアランナラ」発見？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980408
					]
				},
				{
					"id": 730980408,
					"content": "そうだ！それに、お宝もゲットできるかもしれないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980409
					],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
