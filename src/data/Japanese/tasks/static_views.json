			},
			"dialogs": [
				{
					"id": 730980301,
					"content": "どれどれ…んん？これってアランナラの絵なのか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730980302,
					"content": "他人の物を勝手に漁るのはよくない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980303
					]
				},
				{
					"id": 730980303,
					"content": "ふーん？オイラたち、今まで冒険者の拠点とか、遺跡の宝箱とか、漁りまくってたけどな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730980304,
					"content": "えーっと…じゃあ、こういうことにしよう！この家の周りにアランナラの姿が見えなくて心配だから、オイラたち手がかりを調べてるんだ。オイラのおかげで、閉じ込められたアランナラを助けられるかもしれないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980305,
						730980306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730980305,
					"content": "パイモンの言う通り。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980307
					]
				},
				{
					"id": 730980307,
					"content": "ふふん、当然だ！とにかく多分、この絵は近くの景色が描いてある…んだよな？へへっ、もしかすると宝の地図かも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730980308,
					"content": "#{NICKNAME}、描かれた場所に行ってみようぜ！本当にアランナラが残したお宝があるかもしれないぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730980306,
					"content": "おお、いかにも！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980307
					]
				}
			]
		},
		{
			"id": 7309804,
			"completionStepIds": [
				7309803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
