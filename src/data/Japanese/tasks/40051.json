					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511902
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400511902,
					"content": "下に深海ヴィシャップがこんなにたくさんいるなんて。あいつが言ってたことは本当だったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511903
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400511903,
					"content": "つみって、本当にヴィシャップマンなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511904
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400511904,
					"content": "でも、ぜんぜん姿が見当たらないぞ。いったいどこにいったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511905
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400511905,
					"content": "はぁ、あまり考えててもしょうがないよな。とりあえず上に戻ろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
