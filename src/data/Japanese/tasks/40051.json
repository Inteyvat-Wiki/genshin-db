				},
				{
					"id": 400511102,
					"content": "どうやら、今回はオイラたちを騙してなかったみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400511103,
					"content": "厳密に言うと、ほとんど騙された事が無い。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511104
					]
				},
				{
					"id": 400511104,
					"content": "まあ、あいつの話を聞く限りそうだけど…っておい、どうしてあいつを理解した気になってんだよ！そんなのダメだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
