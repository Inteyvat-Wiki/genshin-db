					"content": "ここに来るまでに見逃してたりしないよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511703
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400511703,
					"content": "…また前と同じ結末。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511704
					]
				},
				{
					"id": 400511704,
					"content": "うぅ、落ち込むなしっかりしろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511705
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400511705,
					"content": "少なくとも、海祇島の兵士はほとんど撤退できた。仮にヴィシャップが現れても、誰もケガすることはないはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511706
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400511706,
					"content": "あいつの言う通りになることを考えると腹が立つけど、ここはオイラたちがやるしかない。光の道を導こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
