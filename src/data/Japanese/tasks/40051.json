			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"つみ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400510101,
					"content": "つみ、オイラたちやったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400510102,
					"content": "はい、あなたたちの成果は私も確認しています。確かに、三つの塔の処理がすべて完了したようですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510103
					],
					"speakerTitle": "つみ"
				},
				{
					"id": 400510103,
					"content": "淵下宮の環境も回復し始めたため、負傷者と兵士たちも撤退を早めています。えっと、ほとんどの方はすでに避難済みのようです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510104
					],
					"speakerTitle": "つみ"
				},
				{
					"id": 400510104,
					"content": "ただ、少々予想外なことも起きています。二人とも、私について来てくれませんか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "つみ"
				}
			]
		},
		{
			"id": 4005102,
			"completionStepIds": [
				4005102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005102",
							"2"
						],
						"stepId": 4005102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"つみ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400510201,
					"content": "うわっ、大日御輿の中に暗闇が！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400510202,
					"content": "本来であれば、今ごろ淵下宮はすべて元通りになっているはずでした…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510203
					],
					"speakerTitle": "つみ"
				},
				{
					"id": 400510203,
					"content": "ただ残念なことに、今はもっとも危険な場所へと変わり果てています。なぜこうなったのか、そしてどうしたらいいのか私にも分かりません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510204
					],
					"speakerTitle": "つみ"
				},
				{
					"id": 400510204,
					"content": "しかし、黒幕がどこにいるかだけはお二人に伝えられます。こうなってしまった以上、黒幕と対峙し、計画をすべて吐かせる以外に方法はないでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510205
					],
					"speakerTitle": "つみ"
				},
				{
					"id": 400510205,
					"content": "どうやって黒幕を見つけたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400510206,
					"content": "私は黒霧の流れをずっと観察してきました。異常があった場合、すぐに分かります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510207
					],
					"speakerTitle": "つみ"
				},
				{
					"id": 400510207,
					"content": "これまで、黒霧を引き寄せ続ける微弱な渦がありました。かの者がアビスの力を必要とする時、微かな流れを起こすのでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510208
					],
					"speakerTitle": "つみ"
				},
				{
					"id": 400510208,
					"content": "あれはとても危険な存在です。ただのヴィシャップとは比べものにならない力を持っています…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510209,
						400510210
					],
					"speakerTitle": "つみ"
				},
				{
					"id": 400510209,
					"content": "安心して、元々懲らしめるつもりだった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400510211
					]
				},
				{
					"id": 400510211,
					"content": "そう言っていただけて助かります。では、あなたにお任せします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510212
					],
					"speakerTitle": "つみ"
				},
				{
					"id": 400510212,
					"content": "私の推測では、彼は<color=#00E1FFFF>図書館</color>の近くにいるはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "つみ"
				},
				{
					"id": 400510210,
					"content": "相手も邪魔が入るのが分かってたはず。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400510211
					]
				}
			]
		},
		{
			"id": 4005103,
			"completionStepIds": [
				4005103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005103",
							"2"
						],
						"stepId": 4005103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「淵上」と自称するもの"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400510301,
					"content": "ふん、予想外と言うべきか、予想通りと言うべきか。この暗闇の中でも突き進み、霧を払って俺の目の前に現れるとは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510302
					],
					"speakerTitle": "「淵上」と自称するもの"
				},
				{
					"id": 400510302,
					"content": "そんなことが可能なのは、お前くらいしかいないと思っていたよ。だが、まさかやつらと手を組むとはな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510303
					],
					"speakerTitle": "「淵上」と自称するもの"
				},
				{
					"id": 400510303,
					"content": "また喋りながら時間を稼ぐつもりだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400510304,
					"content": "…そうか、お前たちは本当に知らないようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510305
					],
					"speakerTitle": "「淵上」と自称するもの"
				},
				{
					"id": 400510305,
					"content": "この俺を見て、頭に血が上るのも分かる。ここに辿り着くまで長いこと駆け回ってきたんだろう？だというのに、まだそんな体力が残っているとは、さすがに厄介だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510306
					],
					"speakerTitle": "「淵上」と自称するもの"
				},
				{
					"id": 400510306,
					"content": "軽く体を動かすとしよう。俺の言葉に、耳を貸したくなるまでな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「淵上」と自称するもの"
				}
			]
		},
		{
			"id": 4005105,
			"completionStepIds": [
				4005105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005105",
							"2"
						],
						"stepId": 4005105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「淵上」と自称するもの"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400510501,
					"content": "ま、待て、終わりだ！これ以上やったら死ぬぞ、俺が！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510502
					],
					"speakerTitle": "「淵上」と自称するもの"
				},
				{
					"id": 400510502,
					"content": "そのために来た。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400510503
					]
				},
				{
					"id": 400510503,
					"content": "あの女…瞳孔が細く長い女は、自分のことをなんと言っていた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510504
					],
					"speakerTitle": "「淵上」と自称するもの"
				},
				{
					"id": 400510504,
					"content": "えっ、どうしておまえがそのことを知ってるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400510505,
					"content": "その女の名前を言ってみろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510506
					],
					"speakerTitle": "「淵上」と自称するもの"
				},
				{
					"id": 400510506,
					"content": "自分のことをつみって言ってたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510507
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400510507,
					"content": "ふん、トカゲの分際で、人間の真似をしやがるとはな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510508
					],
					"speakerTitle": "「淵上」と自称するもの"
				},
				{
					"id": 400510508,
					"content": "トカゲ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400510509
					]
				},
				{
					"id": 400510509,
					"content": "お前も分かっているだろう。深海ヴィシャップは賢く、進化が早い種であることを。そして千年も前から、とある言い伝えがある——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510510
					],
					"speakerTitle": "「淵上」と自称するもの"
				},
				{
					"id": 400510510,
					"content": "——それが、ヴィシャップマンに関する伝説だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510511
					],
					"speakerTitle": "「淵上」と自称するもの"
				},
				{
					"id": 400510511,
					"content": "ヴィシャップ…マン？なんか、オイラが考えたあだ名みたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510512
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400510512,
					"content": "その昔、淵下宮にはこのような伝説があった。深海ヴィシャップは迫害を受け、生き延びるために新たな進化を始めた。勝者の姿かたちを真似するようになったと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510513
					],
					"speakerTitle": "「淵上」と自称するもの"
				},
				{
					"id": 400510513,
					"content": "やがて、瞳孔を除けば人間と全く区別のつかない種族——ヴィシャップマンが現れた。その者たちは淵下宮に入り、人間の居場所を奪ったとされている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510514
					],
					"speakerTitle": "「淵上」と自称するもの"
				},
				{
					"id": 400510514,
					"content": "どうだ、心当たりがあるだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510515
					],
					"speakerTitle": "「淵上」と自称するもの"
				},
				{
					"id": 400510515,
					"content": "つみの瞳孔も、縦長だったって言ってたよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510516
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400510516,
					"content": "日差しが強いところでは、トカゲの瞳孔は細長い縦状になる。まさに、あいつがお前らを裏切った証拠と言えるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510517
					],
					"speakerTitle": "「淵上」と自称するもの"
				},
				{
					"id": 400510517,
					"content": "でも、ずっとオイラたちを助けてくれたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510518
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400510518,
					"content": "あいつは、俺へ復讐するためにお前たちを利用しただけに過ぎない。なにせ、俺もあいつらを裏切ったからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510519
					],
					"speakerTitle": "「淵上」と自称するもの"
				},
				{
					"id": 400510519,
					"content": "俺はかつて、ヴィシャップと同盟を結んでいたことがある。やつらの目的は、精鋭を大日御輿へと送り、囚われている同族を救うこと。その目的を果たしてやるため、俺は淵下宮全体を黒霧で覆ってやった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510520
					],
					"speakerTitle": "「淵上」と自称するもの"
				},
				{
					"id": 400510520,
					"content": "その見返りとして俺たちアビス教団が手にしたのが、領地を通る許可だ。それから、やつらは三つの塔の改造のため俺に力を貸した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510521
					],
					"speakerTitle": "「淵上」と自称するもの"
				},
				{
					"id": 400510521,
					"content": "しかし、やつらは予期していなかったのだろう。アビスの黒霧が元素生物にとって恐ろしい猛毒であるというのを。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510522
					],
					"speakerTitle": "「淵上」と自称するもの"
				},
				{
					"id": 400510522,
					"content": "だから、ヴィシャップたちは裏切られたと思ってるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510523
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400510523,
					"content": "ああ、俺自身も裏切りだと認めている。ヴィシャップがアビスの力を受けてなお飛び跳ねているなど、アビス教団にとって恥ずべきことだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510524
					],
					"speakerTitle": "「淵上」と自称するもの"
				},
				{
					"id": 400510524,
					"content": "おまえッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510525
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400510525,
					"content": "今の状況を説明してやろう。あの女はお前たちを利用するだけ利用した後、手の平を返すはずだ。大日御輿で珊瑚王蟲を抑え込み、暗闇を作り出してヴィシャップを擁護するだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510526
					],
					"speakerTitle": "「淵上」と自称するもの"
				},
				{
					"id": 400510526,
					"content": "今頃は深いところに潜り、囚われた仲間を救出する準備をしているんじゃないか。そして、血枝珊瑚の源は断たれることになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510527
					],
					"speakerTitle": "「淵上」と自称するもの"
				},
				{
					"id": 400510527,
					"content": "深海ヴィシャップたちは可哀そうだけど、でも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510528
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400510528,
					"content": "海祇島の未来を守りたいと思うのなら、急いだほうがいいだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510529
					],
					"speakerTitle": "「淵上」と自称するもの"
				},
				{
					"id": 400510529,
					"content": "俺が残しておいた装置で光の道を導き、大日御輿の暗闇を払うといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510530
					],
					"speakerTitle": "「淵上」と自称するもの"
				},
				{
					"id": 400510530,
					"content": "おまえの話はもう信用しないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510531
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400510531,
					"content": "そうか。だが、他に選択の余地はあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510532
					],
					"speakerTitle": "「淵上」と自称するもの"
				},
				{
					"id": 400510532,
					"content": "どのみち今回、俺には何の収穫もない。だが、そんなことはどうでもいいことだ。俺は教団の中でも端役に過ぎないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510533
					],
					"speakerTitle": "「淵上」と自称するもの"
				},
				{
					"id": 400510533,
					"content": "殿下の傍をウロチョロしてるやつらとは違って、俺はいつだってどうでもいいことにこだわる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510534
					],
					"speakerTitle": "「淵上」と自称するもの"
				},
				{
					"id": 400510534,
					"content": "さて、時間稼ぎはこれで十分だ。もう会うこともないだろう。俺は先に失礼させてもらうぞ。それとこれは以前、大日御輿で手に入れたものだ。餞別としてお前にくれてやる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510535
					],
					"speakerTitle": "「淵上」と自称するもの"
				},
				{
					"id": 400510535,
					"content": "これって、心海がくれたものとセットなんじゃ…って、そんなこと気にしてる場合じゃなかっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510536
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400510536,
					"content": "くぅぅ、また逃げられた！もう、ムカつくな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510537
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400510537,
					"content": "たとえ、あいつの言うことに筋が通っていても、そう簡単に信じないほうがいいはずだ。まずはつみに話を聞いてみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 4005111,
			"completionStepIds": [
				4005111
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005111",
							"2"
						],
						"stepId": 4005111,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400511101,
					"content": "オイラ驚いたぞ。本当にこれで解決できるなんて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400511102,
					"content": "どうやら、今回はオイラたちを騙してなかったみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400511103,
					"content": "厳密に言うと、ほとんど騙された事が無い。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511104
					]
				},
				{
					"id": 400511104,
					"content": "まあ、あいつの話を聞く限りそうだけど…っておい、どうしてあいつを理解した気になってんだよ！そんなのダメだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400511105,
					"content": "これで大日御輿への道は再び開かれた。早く下に行ってみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 4005115,
			"completionStepIds": [
				4005115
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005115",
							"2"
						],
						"stepId": 4005115,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"つみ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400511501,
					"content": "あっ、つみだ！大日御輿の前でいったいなにやってるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400511502,
					"content": "戻られたのですね。どうですか、救出は成功しましたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511503
					],
					"speakerTitle": "つみ"
				},
				{
					"id": 400511503,
					"content": "幼いヴィシャップはもう助けたぞ。でも年を取って弱ってたヴィシャップは、オイラたちが精鋭を倒した後に水の中に隠れちゃったから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400511504,
					"content": "つみ、おまえ本当にヴィシャップなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400511505,
					"content": "余計な説明をする気はありません。私はあなたたちと会話できますが、これで理解しました。人との繋がりは必ず裏切りで終わってしまうことを。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511506
					],
					"speakerTitle": "つみ"
				},
				{
					"id": 400511506,
					"content": "私たち二つの種族は、殺し合う運命なのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511507
					],
					"speakerTitle": "つみ"
				},
				{
					"id": 400511507,
					"content": "私が離れる前に、この塔を破壊します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511508
					],
					"speakerTitle": "つみ"
				},
				{
					"id": 400511508,
					"content": "一人でできるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511509
					]
				},
				{
					"id": 400511509,
					"content": "それ以上近づかないでください。それから、妙なことも考えないように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511510
					],
					"speakerTitle": "つみ"
				},
				{
					"id": 400511510,
					"content": "この高塔は…私の願いを聞いてくれるようです。私が望めば、私のために光と闇を切り替えてくれます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511511
					],
					"speakerTitle": "つみ"
				},
				{
					"id": 400511511,
					"content": "その気になれば、私の目の前で瓦解もするでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511512
					],
					"speakerTitle": "つみ"
				},
				{
					"id": 400511512,
					"content": "拳を握り締める程度の、たったそれだけの思いで、このヴィシャップを苦しめてきた建物を破壊できます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511513
					],
					"speakerTitle": "つみ"
				},
				{
					"id": 400511513,
					"content": "しかし、どうしても…心を鬼にすることができません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511514
					],
					"speakerTitle": "つみ"
				},
				{
					"id": 400511514,
					"content": "うぅぅ、こんなの血枝珊瑚を失うよりもツラいぞ！な、なにか方法はないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511515,
						400511516
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400511515,
					"content": "つみ、これは知ってる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511517
					]
				},
				{
					"id": 400511517,
					"content": "これは…まさか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511518
					],
					"speakerTitle": "つみ"
				},
				{
					"id": 400511518,
					"content": "つみは自分の首飾りを思い出し、それを欠片と組み合させた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400511519
					]
				},
				{
					"id": 400511519,
					"content": "これって、三匹の蛇が絡み合った…首飾り？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511520
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400511520,
					"content": "この首飾りは、私が物心ついた時からずっと持っていたものです。なぜ、あなたが持つ二つの欠片とぴったり合うのでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511521
					],
					"speakerTitle": "つみ"
				},
				{
					"id": 400511521,
					"content": "そろそろ答えが見えてきたはず。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511522
					]
				},
				{
					"id": 400511522,
					"content": "そんな馬鹿なことが、いったい何が言いたいのですか…まさか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511523
					],
					"speakerTitle": "つみ"
				},
				{
					"id": 400511523,
					"content": "オイラ、さっぱり理解できないぞ…こっちは心海の首飾りで、そっちは大日御輿のもの、そしてつみの首飾りは子供の頃から持ってたもので…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511524
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400511524,
					"content": "つみは海祇島に属する存在。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511525
					]
				},
				{
					"id": 400511525,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511526
					],
					"speakerTitle": "つみ"
				},
				{
					"id": 400511526,
					"content": "私はヴィシャップと共に育ちました。そばにはこの首飾りと、それから書物の入った箱がいくつかあっただけ。ただ、それのおかげで人間の言葉と文字を学ぶことができました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511527
					],
					"speakerTitle": "つみ"
				},
				{
					"id": 400511527,
					"content": "しばらくして、淵下宮には人間がいなくなりました。誰一人残らずに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511528
					],
					"speakerTitle": "つみ"
				},
				{
					"id": 400511528,
					"content": "つい最近まで、人間との接点はありませんでした。書物に書かれた内容や意味を知ったのも、つい最近のことです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511529
					],
					"speakerTitle": "つみ"
				},
				{
					"id": 400511529,
					"content": "つみ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511530
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400511530,
					"content": "人間の書物に、私には理解できない熟語がありました。しかし私は今になって、それを理解できたようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511531
					],
					"speakerTitle": "つみ"
				},
				{
					"id": 400511531,
					"content": "「人は生まれた場所に属し、獣は餌を得られる場所に属する」。私はヴィシャップであり、人間ではありません。だから、私は帰るべき場所へ帰ります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511532
					],
					"speakerTitle": "つみ"
				},
				{
					"id": 400511532,
					"content": "大日御輿、もう私にとっては些末なこと。いずれまた、我々は必ず帰ってきます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511534
					],
					"speakerTitle": "つみ"
				},
				{
					"id": 400511534,
					"content": "つみ、行っちゃったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511535
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400511535,
					"content": "最後、どうして急に考えを変えたんだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511536
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400511536,
					"content": "心海なら分かるかもしれない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511537
					]
				},
				{
					"id": 400511537,
					"content": "ああ、そうだな。この状況を予想してたから、心海は首飾りをくれたのかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511538
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400511538,
					"content": "ひとまず、これで一件落着だ！戻って心海に報告しようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400511516,
					"content": "つみ、これを受け取って。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511517
					]
				}
			]
		},
		{
			"id": 4005116,
			"completionStepIds": [
				4005116
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005116",
							"2"
						],
						"stepId": 4005116,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"珊瑚宮心海"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400511601,
					"content": "おーい、心海！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511602
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400511602,
					"content": "おや、帰ってきたのですね。戻ってきた兵士たちから事情は聞いています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511603
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 400511603,
					"content": "あなたは、つみという巫女と協力することで黒霧を消すことに成功した…ただ突如、大日御輿に異変が起きた。そうですよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511604
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 400511604,
					"content": "ああ、だいたいそんな感じだな。でも、それからまた妙なことが起きたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511605
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400511605,
					"content": "そのあとに起きたことを心海に話した。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400511606
					]
				},
				{
					"id": 400511606,
					"content": "そのようなことが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511607
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 400511607,
					"content": "ごめんな、心海。オイラたち、心海からもらった首飾りを人にあげちゃったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511608
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400511608,
					"content": "気にしないでください。前にも言いましたが、もう海祇島にとって必要のないものですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511609
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 400511609,
					"content": "あれは元々、海祇大御神が淵下宮の役人を整理し、制度改革の際に使っていたものです。その三つの首飾りはそれぞれ大日御輿、珊瑚宮の血脈、そして海祇の御使いに託されました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511610
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 400511610,
					"content": "村人、官僚、神使の三者が互いに監視し合うことを意図していたのでしょう。しかし現在、村人の子孫を除いて他の二勢力は廃れ、この首飾りも役割を失いました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511611
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 400511611,
					"content": "さっき海祇の御使いって言ったけど…つみが海祇神の使者だと思ってる兵士もいるみたいだぞ。トカゲも縦長の瞳孔を持ってるだろ。それでオイラたち全員勘違いしちゃったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511612
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400511612,
					"content": "いえ、そうとも限りません。海祇の御使いは蛇神の眷属であることを表すため、そのほとんどが半人半蛇の姿をしています。しかし、進化の後期に入ると、海祇の御使いはその瞳以外、人間と瓜二つの姿になるのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511613
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 400511613,
					"content": "むしろ、ヴィシャップマンや地中リザードマンというのは…小説の中にしか出てこない、ただの設定です。珊瑚宮の機密文書にも、その実在を裏付ける記述はありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511614
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 400511614,
					"content": "えっ、だったら、つみはヴィシャップじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511615
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400511615,
					"content": "海祇大御神が海祇島を作るため力を使い果たした後、その力は次第に弱まりました。ですので、海祇の御使いが誕生することはもうありません。最後に記録されている御使いは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511616
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 400511616,
					"content": "ヴィシャップと人間、両者と交流ができ、橋渡しとなることが期待された御使いです——彼女は幼い頃、世話係の巫女と共に淵下宮の境でヴィシャップに襲われ、それ以来、行方が分からなくなったとされています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511617
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 400511617,
					"content": "多くの人は彼女が亡くなったと考えています。ただ、中にはヴィシャップたちに育てられているのではと思っている人もいるようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511618
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 400511618,
					"content": "御使い一族は海祇の民に恩があります。ヴィシャップと海祇島の領土を巡る争いがなくなった今、その人が帰るべき場所を見つけられることを心から祈るばかりです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511619
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 400511619,
					"content": "それが、つみの生い立ちだったのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511620
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400511620,
					"content": "しかし、血枝珊瑚の原理がそのようなものだったとは。私は珊瑚宮の現人神の巫女として、「聖土化」に対抗する新たな手段を考えねばなりませんね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511621
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 400511621,
					"content": "とは言え、あなたのおかげで「聖土化」の問題はひとまず解決しました。これから数十年の間、海祇島は平和が続くことでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511622
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 400511622,
					"content": "あらためて、あなたたちに心から感謝いたします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚宮心海"
				}
			]
		},
