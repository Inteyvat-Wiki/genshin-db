			"dialogs": [
				{
					"id": 402390301,
					"content": "みんな揃ってるな。ちょうどよかったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402390302,
					"content": "これでようやく一段落だね。話すべきことは、今のうちに全部はっきりさせときな。会場を出た後の揉め事には、ヴォイニッチ商会は一切責任を持たないからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390303
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 402390303,
					"content": "そうね…璃月方面への被害は深刻ではないし、転売ルートをつぶすという今回の目的も達成できたから——あの者たちは全員、フォンテーヌ側に引き渡して処理してもらうわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390304
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402390304,
					"content": "感謝する。書類の処理を考えると、奴らを全員引き連れて帰りたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390305
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 402390305,
					"content": "それから、お前についてだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390306
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 402390306,
					"content": "お前はヴォイニッチ商会の人間だ。私が勝手にお前を連行したら、秘聞の館の主人が黙ってないだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390307
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 402390307,
					"content": "なら、どうするんだい？シュヴルーズさん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390308
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 402390308,
					"content": "…少し前、犯人を追跡する過程で、ナシャタウンに設置されていた見本市の広告看板を壊した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390309
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 402390309,
					"content": "ほう？そりゃ、「自白」かい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390310
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 402390310,
					"content": "そこで提案がある。彼の連行を見逃す代わりに、広告看板の一件も帳消しにしてもらう…というのはどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390311
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 402390311,
					"content": "交渉成立だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390312
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 402390312,
					"content": "もっとこじれるかと思ったけど、こんな簡単に解決しちゃうのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402390313,
					"content": "おじさん、僕たち…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390314
					],
					"speakerTitle": "アティ"
				},
				{
					"id": 402390314,
					"content": "おじさんのことは、お姉ちゃんたちから聞いたよ。でも…私たちはやっぱり、おじさんがいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390315
					],
					"speakerTitle": "ラーヤ"
				},
				{
					"id": 402390315,
					"content": "でも、俺は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390316
					],
					"speakerTitle": "アシュヴァパティ"
				},
				{
					"id": 402390316,
					"content": "もしお前が、やつらのことを軽々しく信じず、お前を受け入れてくれた旅団に自衛のための武器を残していれば、こんな結果を招くことはなかったのかもしれないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390317
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 402390317,
					"content": "私に言わせれば、お前の罪は武器を研究したことなんかじゃない。自分の知識で、仲間を守りきれなかったことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390318
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 402390318,
					"content": "君の…言う通りだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390319
					],
					"speakerTitle": "アシュヴァパティ"
				},
				{
					"id": 402390319,
					"content": "罪を償える機会が目の前にあるというのに、それでもまだ躊躇うのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390320
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 402390320,
					"content": "俺は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390321
					],
					"speakerTitle": "アシュヴァパティ"
				},
				{
					"id": 402390321,
					"content": "——償わせてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390322
					],
					"speakerTitle": "アシュヴァパティ"
				},
				{
					"id": 402390322,
					"content": "旅人、それから夜蘭さん——今回はうまく連携が取れてよかった。では、私は先に失礼する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390323
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 402390323,
					"content": "私の方も公務が立て込んでいるから、これで失礼するわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390324
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402390324,
					"content": "さて、どうやら自由になったみたいだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390325
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 402390325,
					"content": "彼女たちが俺を捕まえないとしても…俺は自分の目的で商会に入った。評判を地に落とすところだったのに、本当に処分しないつもりなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390326
					],
					"speakerTitle": "アシュヴァパティ"
				},
				{
					"id": 402390326,
					"content": "あんたが嘘まみれだったのは分かってたさ。でも、砂漠が「故郷」だって言った時、それだけは嘘じゃないって気づいた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390327
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 402390327,
					"content": "実を言うと、あたしも砂漠を「故郷」と呼ぶ人間の一人でね。だから、あんたの背後にある物語に興味が湧いちまったのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390328
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 402390328,
					"content": "あんたの物語については、旅人から聞かせてもらったが…悪くなかった。だからあんたが持ち込んだ厄介事は、ひとまず物語の付属品ってことにしておいてあげるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390329
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 402390329,
					"content": "本当に？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390330
					],
					"speakerTitle": "アシュヴァパティ"
				},
				{
					"id": 402390330,
					"content": "ただし、あんたは商会の禁忌をいくつも犯した。これ以上、商会に置いておくわけにはいかないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390331
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 402390331,
					"content": "分かってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390332
					],
					"speakerTitle": "アシュヴァパティ"
				},
				{
					"id": 402390332,
					"content": "この子たちを連れて、砂漠へ帰ることをお勧めするよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390333
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 402390333,
					"content": "なぜだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390334
					],
					"speakerTitle": "アシュヴァパティ"
				},
				{
					"id": 402390334,
					"content": "あたしが物心ついた時から、砂漠じゃ争いが絶えなかった。でも、あんたの物語を聞いて、砂漠の人間にも別の生き方があるんじゃないかって思えてきたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390335
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 402390335,
					"content": "今のスメールは前とは大違いだ。あのクラクサナリデビの統治の下なら、その三人の子供のために故郷を再建するのだって、不可能じゃないはずさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390336
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 402390336,
					"content": "気持ちはありがたいが…これほどの年月が過ぎたんだ。オアシスはとっくに、風砂の下だろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390337
					],
					"speakerTitle": "アシュヴァパティ"
				},
				{
					"id": 402390337,
					"content": "今更テントを張り直したところでどうにもなりはしないさ。現実はどこまでも残酷だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390338
					],
					"speakerTitle": "アシュヴァパティ"
				},
				{
					"id": 402390338,
					"content": "それならお客様、うちの商品をご覧になりませんこと？相応の対価さえいただけるなら、何でも売りますわよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390339
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 402390339,
					"content": "モラさえあれば何でも買えると…？ふん…この子たちのために「故郷」を買い戻してやれればよかったがな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390340
					],
					"speakerTitle": "アシュヴァパティ"
				},
				{
					"id": 402390340,
					"content": "ドリーってすぐああやって客を呼び込むんだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390341
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402390341,
					"content": "可能ですわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390342
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 402390342,
					"content": "えっ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390343
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402390343,
					"content": "じゃじゃじゃーん！ご覧くださいまし、この魔力に満ちた宝石を。あの大魔女アリスの傑作ですのよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390344
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 402390344,
					"content": "これさえ植えれば、黄砂が吹き荒れる場所にも泉が湧いて、オアシスを作り出せますわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390345
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 402390345,
					"content": "なっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390346
					],
					"speakerTitle": "アシュヴァパティ"
				},
				{
					"id": 402390346,
					"content": "ふむ…本物だね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390347
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 402390347,
					"content": "はっ…ナド・クライの見本市は本当に宣伝通り、何でも手に入るんだな…でも、こんな高そうな宝物には、手が届かない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390348
					],
					"speakerTitle": "アシュヴァパティ"
				},
				{
					"id": 402390348,
					"content": "さて…この宝石を私に託した魔女は、対価には「子供たちの喜び」が相応しいと言っていましたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390349
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 402390349,
					"content": "はぁ…もっと稼げる売り方はいくらでもあるのですけれど、あの魔女のご要望とあっては断れませんわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390350
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 402390350,
					"content": "「子供たちの喜び」？それって何モラ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390351
					],
					"speakerTitle": "アティ"
				},
				{
					"id": 402390351,
					"content": "そうですわねぇ！あなたたち三人が見本市で稼いだ額の中からいただく——と言うのはいかがかしら。そうすれば、自分たちの努力で「故郷」を買い戻せますわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390352
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 402390352,
					"content": "それは間違いなく、喜ばしいこと——そうですわよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390353
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 402390353,
					"content": "交渉成立！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390354
					],
					"speakerTitle": "アティ"
				},
				{
					"id": 402390354,
					"content": "素晴らしいですわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390355
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 402390355,
					"content": "最後にこんなサプライズに出会えるなんて、思わなかったぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390356
					],
