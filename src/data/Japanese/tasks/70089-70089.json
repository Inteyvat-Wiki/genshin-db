			"dialogs": [
				{
					"id": 700890101,
					"content": "ん？なんでこんなとこに人がいるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700890102,
					"content": "この風神像でもない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890103
					],
					"speakerTitle": "「モーキー」"
				},
				{
					"id": 700890103,
					"content": "おい、なにしてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700890104,
					"content": "帰り道を探しているんだ。風神の像を探さなきゃいけないってことだけは覚えているんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890105
					],
					"speakerTitle": "「モーキー」"
				},
				{
					"id": 700890105,
					"content": "他は何も…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890106
					],
					"speakerTitle": "「モーキー」"
				},
				{
					"id": 700890106,
					"content": "帰り道？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700890107,
					"content": "胸の中にあるのは、かすかな郷愁だけ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890108
					],
					"speakerTitle": "「モーキー」"
				},
				{
					"id": 700890108,
					"content": "目覚めた時、「お前は『モーキー』だ」と書かれたメモを持っていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890109
					],
					"speakerTitle": "「モーキー」"
				},
				{
					"id": 700890109,
					"content": "だから、僕の名前はきっと「モーキー」なんだと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890110
					],
					"speakerTitle": "「モーキー」"
				},
				{
					"id": 700890110,
					"content": "邪魔してごめんね。さようなら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890111
					],
					"speakerTitle": "「モーキー」"
				},
				{
					"id": 700890111,
					"content": "変なやつだけど、悪いやつじゃないみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700890112,
					"content": "どうしたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700890113,
					"content": "変なものが見えた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700890114
					]
				},
				{
					"id": 700890114,
					"content": "変なもの？さっきのやつが神像に触れたからか？",
