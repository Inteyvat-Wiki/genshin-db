			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"サラ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4860203,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860204
					]
				},
				{
					"id": 4860204,
					"content": "ごめん、ごはんならもう食べた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860205
					]
				},
				{
					"id": 4860202,
					"content": "よかった、来てくれて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860203
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 4860205,
					"content": "もう、客引きじゃないですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860206
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 4860206,
					"content": "騎士団にお願いしたいことがあって、代理団長に伝言をお願いしたいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860207
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 4860207,
					"content": "ジンに用があるんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4860209,
					"content": "信頼できる仲間だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860210
					]
				},
				{
					"id": 4860211,
					"content": "面識はある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860212
					]
				},
				{
					"id": 4860213,
					"content": "彼女のしもべだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860214
					]
				},
				{
					"id": 4860208,
					"content": "あれ？ジン団長と親しいんですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860209
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 4860210,
					"content": "そうなんですね、ジン団長のお仲間なら安心できます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860211
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 4860212,
					"content": "ジン団長はあなたたちのことを気に入っていると聞きましたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860213
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 4860214,
					"content": "し、しもべ？西風騎士団は旧貴族のようになるつもりなんですか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860215
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 4860215,
					"content": "#ごめんな、{NICKNAME}のユーモアはたまにセンスがおかしいんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4860216,
					"content": "それで伝言って？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860217
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4860217,
					"content": "すみません…本当は自分で騎士団に行くべきなのですが、最近レストランが忙しくて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860218
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 4860218,
					"content": "実は清泉町との輸送ルートがヒルチャールに占領されてしまい、食材が届かなくなってしまったんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860219
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 4860220,
					"content": "騎士団にその退治を依頼したいと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860221
					]
				},
				{
					"id": 4860222,
					"content": "分かった、狩人どもを説教しよう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860223
					]
				},
				{
					"id": 4860219,
					"content": "それなのに清泉町の狩人たちは知らんぷりして、狩り以外の仕事はしないと言われてしまって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860220
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 4860221,
					"content": "はい、その通りです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860222
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 4860223,
					"content": "おいおい！本当にそれで問題が解決すると思ってるのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860224
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4860225,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860226
					]
				},
				{
					"id": 4860224,
					"content": "輸送ルート上にいるヒルチャールを退治してくださるよう、私の代わりに<color=#00E1FFFF>ジン団長に依頼して</color>いただけませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860225
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 4860226,
					"content": "ほっ…助かりました。ジン団長が動いてくれるなら、きっとすぐ解決してくださるはずです。ありがとうございます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860227
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 4860227,
					"content": "ジンはみんなに信頼されてるんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860228
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4860228,
					"content": "あっ、そうだ、<color=#00E1FFFF>バーテンダーのチャールズ</color>さんも何か困っているようでした…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860229
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 4860229,
					"content": "ついでに、彼のところにも行ってみてもらえませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860230
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 4860230,
					"content": "おう、人助けはオイラの信条だからな、任せろ！…まあ、ついでっていう割には少し遠回りな気もするけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 48603,
			"completionStepIds": [
				48603
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"48603",
							"2"
						],
						"stepId": 48603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"チャールズ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4860301,
					"content": "ここはジューススタンドじゃないぞ、ちびっこたち。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860302
					],
					"speakerTitle": "チャールズ"
				},
				{
					"id": 4860302,
					"content": "ふん、失礼なやつだな。人助けに来たんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4860303,
					"content": "人助け？そうか、君たち代理団長のお気に入りだったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860304
					],
					"speakerTitle": "チャールズ"
				},
				{
					"id": 4860304,
					"content": "むぅっ…変な言い方だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4860305,
					"content": "では、今期の税収報告表をいただけるよう、ジンさんに伝えてもらえないだろうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860306
					],
					"speakerTitle": "チャールズ"
				},
				{
					"id": 4860306,
					"content": "エルザーさんに報告書を提出する時期が近づいてきてね…それにしても、モンドの酒税は高い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860307
					],
					"speakerTitle": "チャールズ"
				},
				{
					"id": 4860307,
					"content": "こんなこともジンに依頼してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860308
					]
				},
				{
					"id": 4860308,
					"content": "アカツキワイナリーにはお金があるでしょ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860309
					]
				},
				{
					"id": 4860309,
					"content": "まあ、ディルック様の経営手腕のおかげだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860310
					],
					"speakerTitle": "チャールズ"
				},
				{
					"id": 4860310,
					"content": "なんで報告表がジンのところにあるんだ？帳面をつけるのもジンの仕事なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4860311,
					"content": "ああ、全ての勘定は代理団長が確認することになっている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860312
					],
					"speakerTitle": "チャールズ"
				},
				{
					"id": 4860312,
					"content": "なにせ酒はモンドの主要収入源だからな、ジンさんはいつも的確な対応をしてくれているよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860313
					],
					"speakerTitle": "チャールズ"
