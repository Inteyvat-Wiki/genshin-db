			"trigger": {
				"objectNames": [
					"ガイア"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4861001,
					"content": "あっ、ガイアだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861002
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4861002,
					"content": "おう、お前さんがた、待ってたぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861003
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4861003,
					"content": "ジンが倒れた時の話は聞いた。騎士団を代表して礼を言わせてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861004
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4861004,
					"content": "きゅ、急に真顔でお礼を言われると、なんだか照れるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861005
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4861005,
					"content": "ハハッ、俺たちの大事な代理団長の恩人だからな、これくらいは当然さ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861006
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4861006,
					"content": "そうだ、お礼の他にも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861007
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4861007,
					"content": "仕事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4861008
					]
				},
				{
					"id": 4861008,
					"content": "その通り！話が早くて助かるぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861009
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4861009,
					"content": "お礼の品をくれるとか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4861010
					]
				},
				{
					"id": 4861010,
					"content": "ハハハッ、お前のそのストレートに話すとこ気に入ったぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861011
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4861011,
					"content": "でも、その前に…まずは騎士団のことを手伝ってほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861012
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4861012,
					"content": "ジンの仕事を分担してほしいんだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861013
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4861013,
					"content": "ああ、お前がジンに報告した件だが、すでに代わりの手配は済ませてある…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861014
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4861014,
					"content": "…けど、ジン以外のヤツに任せるのは何かと心配でな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861015
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4861015,
					"content": "手伝いが必要そうなところがあったら、手を貸してやってほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861016
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4861016,
					"content": "モンドの「栄誉騎士」が協力してくれるなら、俺も安心できる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861017
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4861017,
					"content": "#{NICKNAME}をいくら褒めても何も出ないぞ。それより——おまえも手伝え！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861018
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4861018,
					"content": "ハハッ、俺にはもっと重要な任務があるんだよ…色々と「準備」が必要でね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861019
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4861019,
					"content": "はぁ、仕方ない。確か…<color=#00E1FFFF>サラとチャールズとマーガレット</color>だったよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861020
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4861020,
					"content": "ああ、よろしく頼む。またな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ガイア"
				}
			]
		},
