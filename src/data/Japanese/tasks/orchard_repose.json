					}
				]
			},
			"dialogs": [
				{
					"id": 150331501,
					"content": "わぁ～、こんなにいっぱい。すごいねぇ～！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331502
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150331502,
					"content": "「熱闘の宴」にはたくさん食材が必要だって言ってただろ？タダでご馳走になって、手伝わないわけにはいかないもんな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150331503,
					"content": "さっき食べてみたら、ジューシーで、甘くてすっごく美味しかったぞ！きっとすぐに売り切れちゃう果物なんだろうな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150331504,
					"content": "あとキノコも食べてみたけど、ほんのり果物みたいな香りが混じってた！不思議だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150331505,
					"content": "よし、こいつは「トロピカルキノコ」って名前にしようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331506,
						150331508
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150331506,
					"content": "パイモンの舌は信じられる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150331507
					]
				},
				{
					"id": 150331507,
					"content": "へへっ、わかってるじゃんか。いろんな場所に行って、いろんな美味しいものを食べてきたオイラの舌は、この頭と同じくらい正確だからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331510
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150331510,
					"content": "うんうん、助かるよ～ありがとね。じゃあ、わたしもサクッと取り掛かろうかな。さっき言った通りキノコ料理を作るから、ちょっと待っててねぇ～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331511
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150331511,
					"content": "ヴァレサは手早く食材を調理すると、熱々のキノコ料理をあなたたちの前に運んできた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150331512
					]
				},
				{
					"id": 150331512,
					"content": "わたし、料理の腕はそこまでだから、あんま期待しないでね。でも素材が良ければちょっと手を加えるだけでとっても美味しくなるんだよ～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331513
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150331513,
					"content": "いやいや、すっごくいい匂いがするぞ。キノコの香りが料理する前より強くなってるし、きっと美味しいんだろうな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331514
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150331514,
					"content": "おお、生で食べるのとはまた違った味わいだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331515,
						150331516
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150331515,
					"content": "それぞれで味が違う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150331517
					]
				},
				{
					"id": 150331517,
					"content": "えへへ、気に入ってくれてよかったよ～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331518
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150331518,
					"content": "このキノコって「豊穣の邦」ですごく人気なんだけど、まだ他の場所ではあまり知られてないんだぁ～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331519
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150331519,
					"content": "今回の「熱闘の宴」は、このキノコを宣伝するためでもあるんだよ。アトリーおじさんが、色々と工夫して新メニューを作ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331520
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150331520,
					"content": "もし興味があったら、参加してみてね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331521
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150331521,
					"content": "興味ある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150331522
					]
				},
				{
					"id": 150331522,
					"content": "オイラか？「熱闘の宴」…もちろん、オイラが参加しないわけにはいかないだろ！まぁ、どんだけ食べられるかはわかんないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331523
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150331523,
					"content": "大丈夫大丈夫～食べ物が無駄になることはないから心配いらないよ。もし食べ切れなかったら、わたしに言って。手伝ってあげるから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331524
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150331524,
					"content": "それなら安心だな…って、いやいや、オイラが参加したら、おまえとはライバルってことになるよな？オイラに勝ち目ないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331525
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150331525,
					"content": "そこはやってみないと分からないんじゃない？きみも結構食べるほうでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331526
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150331526,
					"content": "それに勝ち負けなんて重要じゃないよ。「豊穣の邦」のグルメを楽しむチャンスだと思ってさ～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331527
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150331527,
					"content": "たしかにその通りだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331528
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150331528,
					"content": "#{M#俺}{F#私}も付き合うよ、パイモン。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150331529
					]
				},
				{
					"id": 150331529,
					"content": "よし、じゃあオイラたち二人とも申し込むぞ！待ってろよ、このパイモンの実力を見せつけてやるぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150331516,
					"content": "どっちもすごく美味しい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150331517
					]
				},
				{
					"id": 150331508,
					"content": "たまにはパイモンの判断を信じよっか。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150331509
					]
				},
				{
					"id": 150331509,
					"content": "「たまには」って一言余計だろ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331510
					],
					"speakerTitle": "パイモン"
				}
			]
