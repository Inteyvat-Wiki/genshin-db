					},
					{
						"sceneId": 3,
						"position": [
							-2630.629,
							273.544,
							10215.22
						],
						"pointId": 10953
					},
					{
						"sceneId": 3,
						"position": [
							-2634.262,
							273.488,
							10214.6
						],
						"pointId": 10954
					}
				]
			},
			"dialogs": [
				{
					"id": 150331001,
					"content": "ここがイアンサコーチのお家だよ～なんか競技場でトラブルが起きたみたいで、今はお家にいないんだぁ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331002
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150331002,
					"content": "ここにある器具のメンテナンスをコーチに頼まれてるの。ちょっと待っててね～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331003
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150331003,
					"content": "こんなにたくさんあるんだな。全部おまえたちが普段使うものなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331004
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150331004,
					"content": "うん、イアンサコーチがわたしたちのトレーニングを見てくれて、いろんなコツを教えてくれるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331005
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150331005,
					"content": "コーチが教えてくれる理論的な知識って、わたしには理解できないんだけど、言う通りにやれば成長がすごく早くなるの。えへへ、やっぱりコーチってすごいなぁ～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331006
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150331006,
					"content": "それはヴァレサに才能があるってことだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150331007
					]
				},
				{
					"id": 150331007,
					"content": "オイラもやってみたい！試してみていいか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331008
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150331008,
					"content": "もちろん。じゃあ一番軽いやつにしよっか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331009
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150331009,
					"content": "ん、ふぬぬぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331010
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150331010,
					"content": "ダメだ、ちっとも上がらない…こんな重いの、ほんとにトレーニングに使えるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331011
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150331011,
					"content": "ん～わたし的にはここにあるものでちょうどいいかな。でもイアンサコーチが、ここのウエイトプレートじゃ物足りないから、特注のプレートをいくつか頼まなきゃって言ってたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331012
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150331012,
					"content": "おお、すごいな！こんな重たいもんを持ち上げられるようには見えないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331013
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150331013,
					"content": "コーチが丁寧に教えてくれたおかげだよ。えへへ～わたし自身はそんなに苦労してないと思うんだぁ～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331014
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150331014,
					"content": "これが天才…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150331015
					]
				},
				{
					"id": 150331015,
					"content": "ううん、違うよ。トレーニング器具とか魔物が相手なら全力を出せるってだけ。そっちのほうが気が楽だからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331016
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150331016,
					"content": "でも、誰かと戦うってなるとてんでダメ…相手を怪我させちゃうかもって怖くなるの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331017
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150331017,
					"content": "そうなのか…じゃあ「帰火聖夜の巡礼」はどうしてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331018
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150331018,
					"content": "はぁ～団体戦なんて勝てたことないし、ましてや順位なんて言うまでもないよ。競ったり、奪い合ったりするのが苦手なんだぁ～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331019
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150331019,
					"content": "でもね、イアンサコーチが教えてくれたんだけど、力の真髄の一つは「コントロールすること」にあるんだって。それで、ここにあるバーベルを例に説明してくれたの——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331020
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150331020,
					"content": "バーベルって、持ち上げるときだけじゃなくて、下ろすときにも力が必要で、本当に力のある人は、その強弱を自在にコントロールできるんだって。ただ力を強くすればいいんじゃなくて、力をつけた後、どう使うか考えることが肝心なの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331021
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150331021,
					"content": "…頭では分かってるんだ…トレーニングのときはいつもそうしてたし、問題なんて起きたことなかった。なのに、いざ誰かと戦うとなると、なんだか自分のこと信じきれなくなっちゃうんだよね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331022,
						150331023
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150331022,
					"content": "大丈夫だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150331024
					]
				},
				{
					"id": 150331024,
					"content": "うん、ありがとう。もっと頑張ってトレーニングすれば、きっと克服できるよね！よしっ、とりあえず今はメンテナンスを終わらせよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331025
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150331025,
					"content": "——うん、これでオッケー。待たせちゃってごめんね。じゃあ果樹園を見に行こっか～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150331023,
					"content": "焦る必要はないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150331024
					]
				}
			]
		},
