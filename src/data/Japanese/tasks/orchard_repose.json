						],
						"pointId": 10951
					}
				]
			},
			"dialogs": [
				{
					"id": 150330601,
					"content": "あそこがわたしのお家だよ～！ほら、前は果物屋になってて、後ろはわたしたち家族が住んでるところ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330602
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150330602,
					"content": "家の前で果物屋を開いてるのか？もしかして、自分たちで果物を育ててるとか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330603
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150330603,
					"content": "えへへ、そうなんだぁ。うちにはすっごくひろーい果樹園があるんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330604
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150330604,
					"content": "ここは集落の入り口にすごく近いから、朝になるといつも外から足音とか車の音とかが聞こえてくるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330605
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150330605,
					"content": "お父さんとお母さんもその時間になるとバタバタし始めて、そろそろ起きる時間だって分かるんだぁ～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330606
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150330606,
					"content": "それで、一緒に果樹園に行って手伝うのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330607
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150330607,
					"content": "そ、それは…頭では起きなきゃって分かってるんだけど、身体のほうが準備できてるかどうかは、また別の話で…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330608
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150330608,
					"content": "だいたい布団の下に頭を潜らせて、そのまま寝ちゃうんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330609
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150330609,
					"content": "わかる、わかるぞ…そういう時にする二度寝って、いつもより超ぐっすり寝れるんだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330610
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150330610,
					"content": "それに出発するときは、こいつが絶対起こしてくれるから全然大丈夫だし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330611
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150330611,
					"content": "次からはパイモンが起こす係ね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150330612
					]
				},
				{
					"id": 150330612,
					"content": "じょ、冗談だって。ちょっと空気をなごませようと思って言っただけだから、そんな怖いこと言うなよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330613
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150330613,
					"content": "あはは～たまにはのんびり遅くまで寝るのも悪くないよねぇ～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330614
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150330614,
					"content": "わたしはいつも目が覚めたら、まずお父さんとお母さんの部屋を片付けて、トレーニングに出かけるんだぁ。終わったらお家に帰ってご飯を食べるってのが日課なんだよ～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330615
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150330615,
					"content": "それでご飯を食べ終わったら、お父さんとお母さんは出荷しにいくの。その間はわたしが果樹園で働くんだぁ～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330616
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150330616,
					"content": "つまり、今この時間？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150330617
					]
				},
				{
					"id": 150330617,
					"content": "じゃあ、果樹園に行ってみようぜ。オイラ見てみたいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330618
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150330618,
					"content": "いいよ～、あとで案内してあげるね。今は…わたしについてきて。こっちだよ～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴァレサ"
				}
			]
		},
