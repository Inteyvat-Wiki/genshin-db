			"dialogs": [
				{
					"id": 150331401,
					"content": "ガゥ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331402
					],
					"speakerTitle": "ワナナ"
				},
				{
					"id": 150331402,
					"content": "留守番ありがとねぇ、ワナナ。こっちおいで～あれ、また前よりムキムキになった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331403
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150331403,
					"content": "ギャウ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331404
					],
					"speakerTitle": "ワナナ"
				},
				{
					"id": 150331404,
					"content": "えへへ、ちょっと筋肉を見ただけだって～力比べはしないよ。勝負はまた今度ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331405
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150331405,
					"content": "この子はワナナって言うの。普段、果樹園に人がいないとき、ここを見張ってくれてるんだよ。すっごく頼りになるし、人懐っこいおチビちゃんなんだぁ～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331406
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150331406,
					"content": "お、おチビちゃん？だいぶガタイ良くて強そうだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331407
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150331407,
					"content": "さあ、どうぞ入って。ここがうちの果樹園だよ～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331408
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150331408,
					"content": "わぁ、想像してたよりも広いぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331409
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150331409,
					"content": "あっちもこっちも果物でいっぱいだ！どれも美味しそうだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331410
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150331410,
					"content": "えへへ～ここが「豊穣の邦」って言われるのは、火山が近くて土地が肥沃だからっていうのもあるんだ。ここでは何を植えても美味しく育つの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331411
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150331411,
					"content": "ここの果物はすごく人気があるんだよ。外で売るためだけじゃなくて、自分たちが食べる分や親戚とか友達にあげる分までたくさん採っておくんだぁ～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331412
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150331412,
					"content": "なるほどな。今までなんで火山の麓に住む部族がいるのか疑問だったけど、そんなメリットがあったのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150331413,
					"content": "うん！あっ、せっかくここまで来たことだし、果物を採って食べてこっかぁ～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331414
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150331414,
					"content": "えっ、おまえさっきご飯を食べたばっかじゃなかったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331415
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150331415,
					"content": "果物は食後のデザート。ご飯とは別腹だかんね～！四、五十個くらいなら食べても平気だよ～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331416,
						150331417
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150331416,
					"content": "四、五十個…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150331418
					]
				},
				{
					"id": 150331418,
					"content": "えへへ～わたしが小っちゃい頃からね、お父さんはうちの前で果物屋をやってたんだ。お父さんの服をちょいちょいって引っ張ると、いつも果物を一個くれたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331419
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150331419,
					"content": "わたし、食べるのがすっごく速くて、飲み込むとすぐにまた一個…って繰り返してたら、その食べっぷりを見に来る人がどんどん増えて、人だかりができたんだ～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331420
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150331420,
					"content": "それでね、お父さんの話によると、わたしがあまりにも美味しそうに食べるから果物を買いに来る人まで増えたんだって。お父さんの役に立てたのがすっごく嬉しくて、もっともっとたくさん食べるようになっちゃったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331421
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150331421,
					"content": "しかも果物を買ったお客さんが、わたしの頭をなでて「こんなによく食べる子は、将来きっと大きくなるよ」って褒めてくれたんだぁ～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331422
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150331422,
					"content": "わたしはただボーっと周りの人がしゃべってるのを見てただけなんだけど、しばらくするとお父さんもつられて笑い出して、手伝いに来てくれたお母さんも一緒に笑って…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331423
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150331423,
					"content": "すごく幸せそうな光景だな、羨ましいぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331424
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150331424,
					"content": "でもね～、みんながうちの果物を買ってくれるのは、本当に美味しいからなんだよ。自慢ってわけじゃないけど、一度食べてみれば分かるから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331425
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150331425,
					"content": "そうそう、ちょうど数日後に「熱闘の宴」が開催されるの。そのデザートにうちの果物をたくさん提供してるんだぁ～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331426
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150331426,
					"content": "「熱闘の宴」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331427
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150331427,
					"content": "うん、大食い大会みたいなイベントだよ。すっごいたくさん食材を用意しなきゃいけないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331428
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150331428,
					"content": "だから気にせず、いっぱいもいじゃって！わたしも一緒にやるよ。無駄にはならないから大丈夫！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331429
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150331429,
					"content": "よし！どれどれ、どこから始めるかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331430
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150331430,
					"content": "あれ、なんであんなところに…キノコがあるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331431
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150331431,
					"content": "ああ、あのキノコはねぇ、果樹園を作った時に、いつの間にか生えてきたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331432
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150331432,
					"content": "水やりも肥料もなしに、ぐんぐん育つんだ。肉厚でジューシーで、とっても美味しいんだよ～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331433
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150331433,
					"content": "炒めたり揚げたりするだけじゃなくて、生で食べても美味しくってね。果物みたいな味がするんだぁ～！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331434
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150331434,
					"content": "果物の味がするキノコ？そんなの聞いたことないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331435
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150331435,
					"content": "もしかしたら周りの養分を吸収したのかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150331436
					]
				},
				{
					"id": 150331436,
					"content": "たぶんそうだと思う。果物みたいな味がするんだったら、それはもう果物ってことだよねぇ。見た目なんて気にしない気にしない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331437
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150331437,
					"content": "さあさあ、好きなだけもいで～！キノコも一緒にちょこっと採って、あとで料理して食べよ～!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150331417,
					"content": "本当にたくさん食べるんだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150331418
					]
				}
			]
		},
