			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ヴァレサ",
					"イアンサ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 150330501,
					"content": "あれ、イアンサコーチだ！帰火聖夜の巡礼に参加するって聞いてたんですけど、どうして戻ってきたんですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330502
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150330502,
					"content": "ああ、戦闘用の消耗品がもうすぐなくなるのを思い出してな。念のためやっぱり取りに戻ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330503
					],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 150330503,
					"content": "おっ、そっちの二人は競技場でも見かけたな。たしかカチーナを手伝ってたやつらだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330504
					],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 150330504,
					"content": "おう、オイラはパイモンで、こいつは旅人だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150330505,
					"content": "二人ともすごいよな。カチーナのやつ、めきめき腕を上げて、自信もかなりついてたみたいだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330506
					],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 150330506,
					"content": "ああして帰火聖夜の巡礼で勝てたのも、長年の努力の賜物だろう。すごく立派なことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330507
					],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 150330507,
					"content": "カチーナに会ったら、褒めてあげて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150330508
					]
				},
				{
					"id": 150330508,
					"content": "ああ、安心しろ、分かってる。カチーナにとって大事なことだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330509
					],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 150330509,
					"content": "ところで、アンタたち「豊穣の邦」には何か用があって来たのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イアンサ"
				}
			]
		},
		{
