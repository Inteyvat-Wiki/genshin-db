					],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 150330803,
					"content": "よく来てくれたな、二人とも！ようこそ「豊穣の邦」へ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330804
					],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 150330804,
					"content": "見てくれ、この前競技場でこれを買ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330805
					],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 150330805,
					"content": "あっ、それって前に見たあのラクガキ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330806
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150330806,
					"content": "今じゃ手に入れるのが難しくなっててな。ずっと並んでようやく買えたんだ、へへっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330807
					],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 150330807,
					"content": "わたしもこのラクガキを描いた服を持ってるよ。ベッドの横にかけてあるの、えへへ～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330808,
						150330810
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150330808,
					"content": "今、その名高き人物が目の前に！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150330809
					]
				},
				{
					"id": 150330809,
					"content": "今度わたしの服にサインしてほしいなぁ～！絶対大切にするから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330812
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150330812,
					"content": "そうだ。二人とも、ここでの予定はもう決まってるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 150330810,
					"content": "ちょっと照れくさいね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150330811
					]
				},
				{
					"id": 150330811,
					"content": "へへっ、人気があるのはいいことだぞ。これもアンタが活躍した証だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330812
					],
					"speakerTitle": "イアンサ"
				}
			]
		},
