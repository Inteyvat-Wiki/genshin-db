				},
				{
					"id": 200100302,
					"content": "Dala beru yo?! Kundala muhe, kucha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100303
					],
					"speakerTitle": "ヒルチャール"
				},
				{
					"id": 200100303,
					"content": "Kundala gusha! Hahaha!",
