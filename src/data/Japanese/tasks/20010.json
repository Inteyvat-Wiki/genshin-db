					"nextDialogs": [
						200100202
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 200100202,
					"content": "この子にしよう、急いで近づこう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100203
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 200100203,
					"content": "他のヒルチャールを起こさないように気を付けてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100204
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 200100204,
					"content": "でないと絶対攻撃しに来たって思われるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100205
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 200100205,
					"content": "そんなことになったら会話ができなくなっちゃうもの。",
