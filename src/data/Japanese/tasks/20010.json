			"dialogs": [
				{
					"id": 200100101,
					"content": "旅人、ここ、ここよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100102
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 200100102,
					"content": "あのヒルチャールたちには気付かれないように。どうしてあなたはいつもまっすぐ集落に向かって突っ走るの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100103
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 200100103,
					"content": "まあいいわ。今までずっとヒルチャールの言葉を研究してきたけど、記録よりもその話し方を勉強したいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100104
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 200100104,
					"content": "せっかくここで完全なヒルチャール集落に出会ったんだ、このチャンスは逃さないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100105
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 200100105,
					"content": "だからね、練習相手になってくれるヒルチャールを探したいんだけど、一緒に集落に入ってくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エラ·マスク"
				}
			]
		},
