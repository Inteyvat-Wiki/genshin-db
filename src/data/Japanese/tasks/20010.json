			"dialogs": [
				{
					"id": 200100601,
					"content": "Olah! Muhe mimi, nye, eh... mosi aba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100602
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 200100602,
					"content": "Yo mimi beru si?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100603
					],
					"speakerTitle": "ヒルチャール"
				},
				{
					"id": 200100603,
					"content": "Buka...mita nye, guru-guru...yo mosi ka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100604
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 200100604,
					"content": "Ya odomu, Todo yo, buka guru-guru nye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100605
					],
					"speakerTitle": "ヒルチャール"
				},
				{
					"id": 200100605,
					"content": "Mi? Dada! Valo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100606
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 200100606,
					"content": "Valo, ya odomu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100607
					],
					"speakerTitle": "ヒルチャール"
				},
				{
					"id": 200100607,
					"content": "ふふっ、このヒルチャールの動きを見て、喜んでくれたみたいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100608
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 200100608,
					"content": "今回の交流はうまくいったみたいね。私のヒルチャール語のスキルもなかなかのものね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エラ·マスク"
				}
			]
		},
