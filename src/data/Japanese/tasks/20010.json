						200100304
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 200100304,
					"content": "Biat ye, plata ye pupu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100305
					],
					"speakerTitle": "ヒルチャール"
				},
				{
					"id": 200100305,
					"content": "Movo unta nye kucha, mi dada tiga mitono!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100306
					],
					"speakerTitle": "ヒルチャール"
				},
				{
					"id": 200100306,
					"content": "私の言葉が通じたみたい！今プレゼントを用意するって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100307
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 200100307,
					"content": "ぶ、武器よ！うううっ、旅人、助けて！",
