			"dialogs": [
				{
					"id": 745320101,
					"content": "悪い知らせがあります。『スチームバード新聞』に依頼した街頭調査の報告によると、人々は「フラッシュ映影」という芸術形式に対して、あまり興味がないようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745320102
					],
					"speakerTitle": "プチ・ルミエール"
				},
				{
					"id": 745320102,
					"content": "不可解ですね…僕たちの「フラッシュ映影」の完成品は面白いと思ってくれているようですが、制作に興味があるかと尋ねると、返ってくるのは消極的な反応ばかりで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745320103
					],
					"speakerTitle": "プチ・ルミエール"
				},
				{
					"id": 745320103,
					"content": "えっ？でも「フラッシュ映影」を作るのって面白いだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745320104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745320104,
					"content": "データによると、一般の方々にとって二番目に大きな障害は機材にあるようです。誰もが映影機や編集技術を使いこなせるわけではありませんから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745320105
					],
					"speakerTitle": "プチ・ルミエール"
				},
				{
					"id": 745320105,
					"content": "そして最大の懸念は、これによる収益化が難しいと感じていること…特に、完成した作品を周囲の友達とシェアしにくい点にあるようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745320106
					],
					"speakerTitle": "プチ・ルミエール"
				},
				{
					"id": 745320106,
					"content": "シェア、ですか…なるほど！「フラッシュ映影」のための映影祭が必要ですね！そうすれば誰もが、自分の制作物が星々のように輝いていると実感できるはずです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745320107
					],
					"speakerTitle": "メリエス"
				},
				{
					"id": 745320107,
					"content": "よし、決まりですね！今こそ奮発する時です！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745320108
					],
					"speakerTitle": "メリエス"
				},
				{
					"id": 745320108,
					"content": "おい、すぐ奮発しようとするな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745320109,
						745320110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745320109,
					"content": "普通の人が映影祭に参加するのは難しいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745320111
					]
				},
				{
					"id": 745320111,
					"content": "僕もパイモンさんの意見に賛成です。展示会は僕たちにとっても、そしてターゲットとなる人たちにとっても、決してハードルが低いとは言えませんから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745320112
					],
					"speakerTitle": "プチ・ルミエール"
				},
				{
					"id": 745320112,
					"content": "それに、その雰囲気やサイクルも、普通の人々とはあまりに馴染みがないように感じます。もっと一般大衆に適した案を模索する必要があるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745320113
					],
					"speakerTitle": "プチ・ルミエール"
				},
				{
					"id": 745320113,
					"content": "大衆向けのモデル…フォンテーヌで最も大衆的な娯楽と言えば、スチームバード新聞になりますね。ただ、この媒体は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745320114
					],
					"speakerTitle": "プチ・ルミエール"
				},
				{
					"id": 745320114,
					"content": "オイラたちがみんなのために作品を編集して、映影にするって手もあるんじゃないか！？そうすれば、たくさんの友達と一緒に見れるだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745320115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745320115,
					"content": "そうですよ！コマーシャルみたいに、ほかの映影の冒頭で流すのもありかもしれません！とにかく、媒体の選択肢はたくさんあります！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745320116
					],
					"speakerTitle": "メリエス"
				},
				{
					"id": 745320116,
					"content": "どうやら、「フラッシュ映影」という芸術形式には、まだまだ掘り下げる余地がたくさんありそうですね。これは嬉しいサプライズです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745320117
					],
					"speakerTitle": "プチ・ルミエール"
				},
				{
					"id": 745320117,
					"content": "#{NICKNAME}さん、パイモンさん、ありがとうございます！これでまた、新しい目標が見つかりました！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745320118
					],
					"speakerTitle": "メリエス"
				},
				{
					"id": 745320118,
					"content": "へへっ、オイラたちはただ思いついたアイデアを言っただけだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745320119,
						745320120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745320119,
					"content": "#さすが{M#俺}{F#私}たち。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745320121
					]
				},
				{
					"id": 745320121,
					"content": "ご安心ください。続きがあれば、必ずお二人にご協力をお願いしますから！そして、お名前をゲストの一番最初に載せることを約束します！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "メリエス"
				},
				{
					"id": 745320120,
					"content": "報酬は多めにね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745320121
					]
				},
				{
					"id": 745320110,
					"content": "映影祭も毎日開くわけにはいかないでしょ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745320111
					]
				}
			]
		}
	]
}