				],
				"points": []
			},
			"dialogs": [
				{
					"id": 222000101,
					"content": "こんにちは、何かグー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000102
					],
					"speakerTitle": "一成"
				},
				{
					"id": 222000102,
					"content": "うっ、また腹の虫が鳴ってるな。えっと、何か手伝えることはグー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000103
					],
					"speakerTitle": "一成"
				},
				{
					"id": 222000103,
					"content": "ん？なんて？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						222000104
					]
				},
				{
					"id": 222000104,
					"content": "はあ、腹が減るといつもこうだ。グーグー言ってて、俺の話し声すら遮ってしまうんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000105
					],
					"speakerTitle": "一成"
				},
				{
					"id": 222000105,
					"content": "一応…グー…「不卜廬」にも診てもらったけど、単に腹が減っただけで病気じゃないから、治せなグー",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000106
					],
					"speakerTitle": "一成"
				},
				{
					"id": 222000106,
					"content": "腹いっぱい食べればいいって先生に言われたけど…俺の食事の量は誰よりも大きいからグー…腹いっぱい食べることは財布的に難しいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000107
					],
					"speakerTitle": "一成"
				},
				{
					"id": 222000107,
					"content": "食事の後まだ腹が減ってるなら、食間に何か食べておいたほうがいいって嘉義は言ってくれたんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000108
					],
					"speakerTitle": "一成"
				},
				{
					"id": 222000108,
					"content": "食べたいものはたくさんあるから、どれが満腹になりやすいか分からないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000109
					],
					"speakerTitle": "一成"
				},
				{
					"id": 222000109,
					"content": "旅人、お前さんはよく野外にいるし、何を食べれば満腹になりやすいか知ってるよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000110
					],
					"speakerTitle": "一成"
				},
				{
					"id": 222000110,
					"content": "俺は食べたいものから満腹になれるものを選びたいんだが、手伝ってくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000111
					],
					"speakerTitle": "一成"
				},
				{
					"id": 222000111,
					"content": "今回は何を食べたいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						222000112
					]
				},
				{
					"id": 222000112,
					"content": "俺の食べたいものは多いぞ…そうだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "一成"
				}
			]
		},
