			"dialogs": [
				{
					"id": 222000201,
					"content": "ふむ、モンドに美味しい料理がたくさんあると聞いたな、確か鳥肉のスイートフラワー漬け焼き、モンド風焼き魚、漁師トースト、ドドリアン海鮮スープ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000202
					],
					"speakerTitle": "一成"
				},
				{
					"id": 222000202,
					"content": "頼む、一番満腹になれる料理を俺に持ってきてくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000203
					],
					"speakerTitle": "一成"
				},
				{
					"id": 222000203,
					"content": "それを食べれば、きっと俺の腹の虫も収まるはずだグー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "一成"
				}
