			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"慧心",
					"甘雨"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110320201,
					"content": "来てくれてありがとうございます、先輩。二人も、よく来てくれた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320202
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320202,
					"content": "気にするな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110320203,
					"content": "準備ご苦労様です。そんなに気を遣わなくてもいいのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320204
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320204,
					"content": "あー、実は…先輩、さっきのこと以外にも、まだ相談したいことがあるんです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320205
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320205,
					"content": "そうですか？助けが必要ならためらわず、直接言ってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320206
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320206,
					"content": "えー、いや、助けが必要なわけでは…うーん…少しお話を聞いてくれますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320207
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320207,
					"content": "よろこんで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320208
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320208,
					"content": "ふふ…私は小さい頃から、甘雨先輩のお話をたくさん父上から聞かされてきました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320209
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320209,
					"content": "父上のこともとても尊敬していますが、いつも甘雨先輩の優しさと頼りがいのある姿に惹かれていました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320210
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320210,
					"content": "あなたの背中を追いかけて、私は月海亭にやってきたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320211
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320211,
					"content": "そのように思ってくれていたのですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320212
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320212,
					"content": "でもやはり、月海亭の秘書の仕事はとても大変です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320213
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320213,
					"content": "私は先輩のように優秀ではありません。だから、よく悩んでしまうのです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320214
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320214,
					"content": "そんなことありません。慧心はとても良くやっていますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320215
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320215,
					"content": "ふふ、ありがとうございます、先輩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320216
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320216,
					"content": "数年前、私にも娘が生まれて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320217
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320217,
					"content": "えっ！天おじはもうおじいちゃんってことか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110320218,
					"content": "私の影響で、娘も当時の私と同じように、月海亭の秘書になるのが夢です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320219
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320219,
					"content": "でも、正直心配でした。この仕事は一筋縄ではいかない上、あの子に素質があるかどうかもまだ分かりません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320220
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320220,
					"content": "でも今回のことを通して、私はあの子を応援すると決めました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320221
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320221,
					"content": "えっ、それはなぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320222
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320222,
					"content": "あの子が将来、甘雨という先輩に出会えるからです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320223
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320223,
					"content": "甘雨先輩は優しくあの子を導き、当時のあなたの母も同じようだった、と伝えてくれるはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320224
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320224,
					"content": "その情景は素晴らしいものだと思いました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320225
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320225,
					"content": "だから——二十年後のことも先輩に頼みましたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320226
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320226,
					"content": "慧心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320227
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320227,
					"content": "…わ、私の存在があなたにとって、そんなに意味あるものだったなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320228
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320228,
					"content": "ふふ、先輩が父上のやり方を見せてくれたのと同じように、先輩が「立会人」になってくれると安心するんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320229
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320229,
					"content": "「立会人」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320230
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320230,
					"content": "…確かに、私は何千年も璃月の発展や変化に立ち会ってきました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320231
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320231,
					"content": "でも、それはずっと私に孤独しか与えていないと思っていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320232
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320232,
					"content": "慧心、あなたのさっきの話は、私にとってとても意味あるものです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320233
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320233,
					"content": "岩王帝君との「契約」以外にも、この璃月港の人々との繋がりがあったのだと感じさせてくれました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320234
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320234,
					"content": "私を頼り、認め、求めていた人がいたのですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320235
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320235,
					"content": "当たり前です。あなたは私の唯一の先輩ですよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320236
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320236,
					"content": "ふふ…そうですね。しっかり皆さまに応えなければ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320237
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320237,
					"content": "そうだぞ！やっと元通りになったな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320238
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110320238,
					"content": "仮に本当に追い出されてたとしても、少し抵抗してみます…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320239
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320239,
					"content": "あなたの思いに応えるためにもこれからも「契約」を履行し、「七星」の秘書として居続けます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320240,
						110320241
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320240,
					"content": "はあ…最初からそう言ってたのに…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110320242
					]
				},
				{
					"id": 110320242,
					"content": "とにかく、戻らなければ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320243
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320243,
					"content": "私がいなければ、事務処理も滞っているでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320244
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320244,
					"content": "さて、仕事です！時間を無駄にはできません！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320245
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320245,
					"content": "頑張ってください、先輩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320246
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320246,
					"content": "ええ！もう行くのか！？まだ食べ終わってないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110320241,
					"content": "追い出されたのは誤解だってば。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110320242
					]
				}
			]
		},
		{
			"id": 1103203,
			"completionStepIds": [
				1103204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1103204",
							"2"
						],
						"stepId": 1103204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"百暁",
					"百識",
					"百聞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110320301,
					"content": "はっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320302
					],
					"speakerTitle": "百識"
				},
				{
					"id": 110320302,
					"content": "百識、大丈夫ですか…まさか、立ったまま寝ていたんじゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320303
					],
					"speakerTitle": "百聞"
				},
				{
					"id": 110320303,
					"content": "見て…見てください、あれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320304
					],
					"speakerTitle": "百暁"
				},
				{
					"id": 110320304,
					"content": "こんなところでサボっているなんて、私の代わりにはならないようですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320305
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320305,
					"content": "そんな！私たち…もうずっと働いていて、休まないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320306
					],
					"speakerTitle": "百聞"
				},
				{
					"id": 110320306,
					"content": "こうして甘雨様と会う前に倒れてしまっていました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320307
					],
					"speakerTitle": "百暁"
				},
				{
					"id": 110320307,
					"content": "甘雨様、会いたかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320308
					],
					"speakerTitle": "百識"
				},
				{
					"id": 110320308,
					"content": "あら、私たちはただの顔見知りですよ。そんなに求められていたなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320309
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320309,
					"content": "ここ最近、朝も夜も甘雨様が帰ってきて仕事を引き継いでくれるのを願っていました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320310
					],
					"speakerTitle": "百聞"
				},
				{
					"id": 110320310,
					"content": "今のあなたは、まるで仙人様が救いの手を差し伸べているかのように見えます…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320311
					],
					"speakerTitle": "百識"
				},
				{
					"id": 110320311,
					"content": "以前のライバル心はもう忘れました。ただ早く仕事から解放されたい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320312
					],
					"speakerTitle": "百暁"
				},
				{
					"id": 110320312,
					"content": "はいはい、分かりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320313
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320313,
					"content": "では、いま手元にある仕事を政務、商務、民事に分けてください。未着手か進行中かも明記してくださいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320314
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320314,
					"content": "残りは私に任せれば大丈夫です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320315
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320315,
					"content": "はい！すぐやります！",
