		},
		{
			"id": 201901,
			"completionStepIds": [
				201901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201901",
							"2"
						],
						"stepId": 201901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「淑女」",
					"パイモン",
					"雷電将軍"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20190101,
					"content": "まったく次から次へと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190102
					],
					"speakerTitle": "「淑女」"
				},
				{
					"id": 20190102,
					"content": "ここが天守閣だと知らなかったら、どこぞの市場か何かと勘違いしていたところよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190103
					],
					"speakerTitle": "「淑女」"
				},
				{
					"id": 20190103,
					"content": "少しはお利口さんになったのかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190104
					],
					"speakerTitle": "「淑女」"
				},
				{
					"id": 20190104,
					"content": "あっ、九条裟羅が「淑女」に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20190105,
					"content": "稲妻の民が犯した過ちは、私が裁きます。あなたの出る幕ではありません、「淑女」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190106
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 20190106,
					"content": "…それは申し訳ございませんでしたわね、将軍様。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190107
					],
					"speakerTitle": "「淑女」"
				},
				{
					"id": 20190107,
					"content": "「淑女」！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190108
					]
				},
				{
					"id": 20190108,
					"content": "はいはい、私のことが忘れられないのはわかってるから、そんなに私の名前を口に出さないでちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190109
					],
					"speakerTitle": "「淑女」"
				},
				{
					"id": 20190109,
					"content": "私を恨んでることも当然知ってるわ…しつこい旅人ね。ここであんたと会うのもまったく不思議なことだとは思ってないわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190110,
						20190111
					],
					"speakerTitle": "「淑女」"
				},
				{
					"id": 20190110,
					"content": "裏で邪眼を広めるなんて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190112
					]
				},
				{
					"id": 20190112,
					"content": "そんなに急いで将軍様の前で私の「罪」を暴きたいの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190113
					],
					"speakerTitle": "「淑女」"
				},
				{
					"id": 20190113,
					"content": "ふふ…私はただスネージナヤから外交の使節として来ただけよ。あんたが何を言ってるのか、まったく見当もつかないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190114
					],
					"speakerTitle": "「淑女」"
				},
				{
					"id": 20190114,
					"content": "オイラたちのこと、眼中にないみたいだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190115,
						20190116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20190115,
					"content": "神の目を失った人々のために…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190117
					]
				},
				{
					"id": 20190117,
					"content": "私が興味のない人や物事の話はやめてちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190118
					],
					"speakerTitle": "「淑女」"
				},
				{
					"id": 20190118,
					"content": "名前すらも他人に覚えてもらえないような小者たちが、この「永遠」に至るための革命で踏み台となれるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190119
					],
					"speakerTitle": "「淑女」"
				},
				{
					"id": 20190119,
					"content": "彼らの短い人生からしたら、それはそれは大きな誉れだったのではなくて？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190120
					],
					"speakerTitle": "「淑女」"
				},
				{
					"id": 20190120,
					"content": "将軍様、私の言ったこと、間違ってるかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190121
					],
					"speakerTitle": "「淑女」"
				},
				{
					"id": 20190121,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190122,
						20190123
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 20190122,
					"content": "あとウェンティの神の心も…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190124
					]
				},
				{
					"id": 20190124,
					"content": "昔のことを掘り返すの。あんたって執念深いのね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190125
					],
					"speakerTitle": "「淑女」"
				},
				{
					"id": 20190125,
					"content": "スネージナヤ女皇の理想は、この世で最も高貴で純粋なもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190126
					],
					"speakerTitle": "「淑女」"
				},
				{
					"id": 20190126,
					"content": "それに比べれば、あんたの言ったものは…取るに足らない「必要な犠牲」に過ぎないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190127
					],
					"speakerTitle": "「淑女」"
				},
				{
					"id": 20190127,
					"content": "決着をつける時が来た。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190128
					]
				},
				{
					"id": 20190128,
					"content": "ふふ、決着？あっははははっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190129
					],
					"speakerTitle": "「淑女」"
				},
				{
					"id": 20190129,
					"content": "私もあんたの顔は見飽きてきたところよ。でも、あんたがそんな無謀な人だとは思わなかったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190130
					],
					"speakerTitle": "「淑女」"
				},
				{
					"id": 20190130,
					"content": "そんな偉そうなことを言う前に、わかってるのかしら…あんたはまだ稲妻にとって、最も重要なお尋ね者だってことを。自分の置かれてる状況をよく考えることね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190131
					],
					"speakerTitle": "「淑女」"
				},
				{
					"id": 20190131,
					"content": "天守閣に押し入り、御前で大口を叩くなんて、自首以外のなんだと言うの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190132
					],
					"speakerTitle": "「淑女」"
				},
				{
					"id": 20190132,
					"content": "あんたと私の間にある差をわかってほしいわ。地位も…実力もね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190133
					],
					"speakerTitle": "「淑女」"
				},
				{
					"id": 20190133,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}は——",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190134
					]
				},
				{
					"id": 20190134,
					"content": "——「御前試合」を申し込む！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190135
					]
				},
				{
					"id": 20190135,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190136
					],
					"speakerTitle": "「淑女」"
				},
				{
					"id": 20190136,
					"content": "わかりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190137
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 20190137,
					"content": "まさか、そんな手があったなんてね…あんたもこの国の「ルール」を利用できるようになったってところかしら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190138
					],
					"speakerTitle": "「淑女」"
				},
				{
					"id": 20190138,
					"content": "辛うじて自分を私と対等の位置まで引き上げるとは…認めるわ、これは私にとっても予想外の手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190139
					],
					"speakerTitle": "「淑女」"
				},
				{
					"id": 20190139,
					"content": "でも敗者は…死ぬのよ？わかってるのかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190140
					],
					"speakerTitle": "「淑女」"
				},
				{
					"id": 20190140,
					"content": "旅人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190141
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20190141,
					"content": "ふふふ…じゃあ、ここは甘んじてあんたと一曲踊ってあげるわ。あんたと私、どちらかの命が…尽きるまで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「淑女」"
				},
				{
					"id": 20190123,
					"content": "璃月の人々が置かれている危機的状況も…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190124
					]
				},
				{
					"id": 20190116,
					"content": "邪眼に飲み込まれた戦友のために…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190117
					]
				},
				{
					"id": 20190111,
					"content": "稲妻を操ろうだなんて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190112
					]
				}
			]
		}
	]
}