			"dialogs": [
				{
					"id": 120004501,
					"content": "本当に助かった。これで鉱石の商売を続けられる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120004502
					],
					"speakerTitle": "常九"
				},
				{
					"id": 120004502,
					"content": "この前は態度が悪くて本当にすまなかった。どうか許してくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "常九"
				}
			]
		},
		{
			"id": 1200304,
			"completionStepIds": [
				1200304
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200304",
							"2"
						],
						"stepId": 1200304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"行秋"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120030401,
					"content": "さて終幕だ、君たちもいてくれないと話にならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030402
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030402,
					"content": "そんなこと言って、オイラたちがあちこち走り回ってる間、おまえはなにしてたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120030403,
					"content": "それは…もちろん、きちんと『神霄折戟録』を読んで、素敵な時間を過ごしたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030404
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030404,
					"content": "神戟と邪剣、弥耳と未央…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030405
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030405,
					"content": "5巻までの展開は「奇妙」であり、「摩訶不思議」と表現していいが、この6巻を表す言葉は見つからない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030426
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030426,
					"content": "こんな奇書を書けるのは、この世に彼しかいないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030427
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030427,
					"content": "で、それが茂才公の件と何か関係があるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120030406,
					"content": "感服しただけさ。だって、「予想外」っていうのは珍しいことだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030407,
						120030409
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030407,
					"content": "何もかも予想通りってわけだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030408
					]
				},
				{
					"id": 120030408,
					"content": "僕の予想が叶ったのは、君の協力のおかげだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030411
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030411,
					"content": "な、なんだ！？この「オイラだけ分からない」みたいな展開は！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030412
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120030412,
					"content": "じゃ、じゃあ、倉庫に行けば面白いものが見れるっていうのは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120030413,
					"content": "考えてみるといい。茂才公が璃月港を探しても石珀が1つも買えない状況を。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030414
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030414,
					"content": "材料がなければ、契約は果たせない。契約を果たせなければ、「ファデュイ」を敵に回す。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030415
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030415,
					"content": "そして、「飛雲商会」の名を聞いた彼はきっと腹を立てるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030416
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030416,
					"content": "茂才公には金と勢力がある、そして彼はこんな扱いを受けたことがない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030417
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030417,
					"content": "鬱憤を晴らすにせよ、問題を解決するにせよ、彼は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030418
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030418,
					"content": "お前たちだな！お前たちが常九の肩を持ったせいで！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030419
					],
					"speakerTitle": "茂才公"
				},
				{
					"id": 120030419,
					"content": "ほら、噂をすれば。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030420
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030420,
					"content": "こんなに走り回っても石珀がどこにもないと思ったら、「飛雲商会」が動いていたか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030421
					],
					"speakerTitle": "茂才公"
				},
				{
					"id": 120030421,
					"content": "希少な鉱石でもないのに品切れになるまで買い込むとは、俺を狙っているのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030422
					],
					"speakerTitle": "茂才公"
				},
				{
					"id": 120030422,
					"content": "狙うも何も、僕は恩返しをしているだけだ。それに助けが必要な人がいれば、助太刀に入るのが当たり前だろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030423
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030423,
					"content": "このままで終わると思うな、と言ったのはそっちの人だしね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030424
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030424,
					"content": "フン、身の程を知らない馬鹿め、これ以上言っても無駄だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030425
					],
					"speakerTitle": "茂才公"
				},
				{
					"id": 120030425,
					"content": "さあ、お願いします。ここの石珀を全て奪ってやってください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "茂才公"
				},
				{
					"id": 120030409,
					"content": "本は面白かった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030410
					]
				},
				{
					"id": 120030410,
					"content": "面白かったよ…こっちも華々しい終わりを迎えられることを願ってるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030411
					],
					"speakerTitle": "行秋"
				}
			]
		},
		{
			"id": 1200306,
