			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"常九"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120030901,
					"content": "やっと来てくれた！今朝、質屋の人がわしの本を全部返してくれたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030902
					],
					"speakerTitle": "常九"
				},
				{
					"id": 120030902,
					"content": "きっと君たちが協力してくれたんだろ？ありがとう、本当にありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030903,
						120030904
					],
					"speakerTitle": "常九"
				},
				{
					"id": 120030903,
					"content": "力になれてよかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030905
					]
				},
				{
					"id": 120030905,
					"content": "ああ、そう言わずに、このことはわしにとって本当に大きなことなんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030906
					],
					"speakerTitle": "常九"
				},
				{
					"id": 120030906,
					"content": "常家は璃月では大きい一族だったが、わしが若くして当主を継いだ時、商売で何度も失敗して家の財産を失ってしまったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030907
					],
					"speakerTitle": "常九"
				},
				{
					"id": 120030907,
					"content": "一族の栄光を取り戻そうと、ここ数年は必死に頑張ってきた…今回の石珀の商いは、わしの全財産をかけた希望だったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030908
					],
					"speakerTitle": "常九"
				},
				{
					"id": 120030908,
					"content": "君たちがいなかったら、おそらくわしは無事でいられなかっただろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030909
					],
					"speakerTitle": "常九"
				},
				{
					"id": 120030909,
					"content": "おまえも「お坊ちゃま」だったんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030910
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120030910,
					"content": "ん？どういう意味だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030911
					],
					"speakerTitle": "常九"
				},
				{
					"id": 120030911,
					"content": "なんでもないぞ！そうだ、本を返しに来たんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030912
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120030912,
					"content": "ああ、『神霄折戟録』！あの古華派の少年、急に姿をくらませたから泥棒かと思ってたところだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030913
					],
					"speakerTitle": "常九"
				},
				{
					"id": 120030913,
					"content": "古華派…そんなにまずいところなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030914
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120030914,
					"content": "門派自体は数百年の歴史があって輝かしい時期もあったが、今ではもう落ちぶれたな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030915
					],
					"speakerTitle": "常九"
				},
				{
					"id": 120030915,
					"content": "門派の復興には新たな血が必要になるだろう…しかし、ずっと衰え落ちぶれたままでは新しい人材も入ってこないはずさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030916
					],
					"speakerTitle": "常九"
				},
				{
					"id": 120030916,
					"content": "今の古華派の若者ときたら…たとえばあの少年、恩返しとか言ってたくせに、君たちの半分の仕事もしてないじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030917,
						120030918
					],
					"speakerTitle": "常九"
				},
				{
					"id": 120030917,
					"content": "それは違うかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030919
					]
				},
				{
					"id": 120030919,
					"content": "はぁ、まあこの話はどうでもいい。そうだ、『テイワット観光ガイド』の璃月編が欲しかったんだろ！用意しておいたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030920
					],
					"speakerTitle": "常九"
				},
				{
					"id": 120030920,
					"content": "これは君たちにあげよう。それから、ほんの気持ち程度だが謝礼も…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030921,
						120030922
					],
					"speakerTitle": "常九"
				},
				{
					"id": 120030921,
					"content": "ありがとう、頑張った甲斐があった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030923
					]
				},
				{
					"id": 120030923,
					"content": "鉱石も売れて、我が愛書たちも戻ってきた、本当に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030924
					],
					"speakerTitle": "常九"
				},
				{
					"id": 120030924,
					"content": "うん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030925
					],
					"speakerTitle": "常九"
				},
				{
					"id": 120030925,
					"content": "どうした？なんか落ちたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030926
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120030926,
					"content": "いや、なんでもない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030927
					],
					"speakerTitle": "常九"
				},
				{
					"id": 120030927,
					"content": "（あの少年…まさか…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "常九"
				},
				{
					"id": 120030922,
					"content": "忘れるところだった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030923
					]
				},
				{
					"id": 120030918,
					"content": "古華派の転機はもうすぐ来るかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030919
					]
				},
				{
					"id": 120030904,
					"content": "大したことはしていない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030905
					]
				}
			]
		}
	]
}