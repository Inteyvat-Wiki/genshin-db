			"dialogs": [
				{
					"id": 120030601,
					"content": "調子に乗るな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030602
					],
					"speakerTitle": "デットエージェント"
				},
				{
					"id": 120030602,
					"content": "うわっ、強そうなやつが来たぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 1200308,
			"completionStepIds": [
				1200308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200308",
							"2"
						],
						"stepId": 1200308,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"行秋"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120030801,
					"content": "フン、只者ではないな…このままでは予想外の損失になる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030802
					],
					"speakerTitle": "デットエージェント"
				},
				{
					"id": 120030802,
					"content": "もっと痛めつけてやってください！そして、石珀を！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030803
					],
					"speakerTitle": "茂才公"
				},
				{
					"id": 120030803,
					"content": "「ファデュイ」とお前は、ビジネス上の協力関係なだけだ。お前の尻拭いまでしてやるつもりはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030804
					],
					"speakerTitle": "デットエージェント"
				},
				{
					"id": 120030804,
					"content": "な、なにを？こ、これもそちらの注文のためではありませんか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030805
					],
					"speakerTitle": "茂才公"
				},
				{
					"id": 120030805,
					"content": "注文の件は、自分でなんとかしろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030806
					],
					"speakerTitle": "デットエージェント"
				},
				{
					"id": 120030806,
					"content": "い、行かないでください！お、おい、待て！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030807
					],
					"speakerTitle": "茂才公"
				},
				{
					"id": 120030807,
					"content": "坊っちゃま！どうしてここに？怪我はありませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030808
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 120030808,
					"content": "#ああ、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_XIABOY|INFO_FEMALE_PRONOUN_XIAGIRL]}のおかげで無事だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030809
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030809,
					"content": "坊っちゃま！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030810,
						120030811
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120030810,
					"content": "坊っちゃま！？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030812
					]
				},
				{
					"id": 120030812,
					"content": "お、お前が「飛雲商会」の御曹司？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030813
					],
					"speakerTitle": "茂才公"
				},
				{
					"id": 120030813,
					"content": "ああ、僕が古華派門弟、そして「飛雲商会」会長の次男──行秋だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030814
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030814,
					"content": "クソッ、ハメられた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030815
					],
					"speakerTitle": "茂才公"
				},
				{
					"id": 120030815,
					"content": "茂才公、強要による売買は商人としてどうかと思うよ。ここは商人らしいやり方で解決しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030816
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030816,
					"content": "この石珀がなければ、「ファデュイ」が君をどうするか、想像してあげようか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030817
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030817,
					"content": "チッ…言え、どうすればその石珀を譲ってくれるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030818
					],
					"speakerTitle": "茂才公"
				},
				{
					"id": 120030818,
					"content": "常九殿には七割引の値段と言っていたな。ではこうしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030819
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030819,
					"content": "通常価格の三倍、これでどうかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030820
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030820,
					"content": "ッ！足元を見やがって！き、貴様…いい加減にしろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030821
					],
					"speakerTitle": "茂才公"
				},
				{
					"id": 120030821,
					"content": "まあ、そう叫ぶな。買うの、それとも買わないの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030822
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030822,
					"content": "…はぁ、分かった、三倍で売ってくれ、それでいいんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030823
					],
					"speakerTitle": "茂才公"
				},
				{
					"id": 120030823,
					"content": "毎度あり、今後とも何卒よろしく頼むよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030824
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030824,
					"content": "お、おまえ、「飛雲商会」の御曹司だったのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030825
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120030825,
					"content": "じゃあ、オイラたちが使ってたモラは全部おまえの財布から——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030826
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120030826,
					"content": "気にするな。損することのない商売な上に、茂才公にお仕置きできた。一石二鳥だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030827,
						120030829
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030827,
					"content": "人は見かけによらない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030828
					]
				},
				{
					"id": 120030828,
					"content": "ハハッ、そう褒めるなよ。君の正義もなかなか感心したぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030831
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030831,
					"content": "あーーッ！オイラ、コイツのことずっと本の虫って呼んでた！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030832
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120030832,
					"content": "お坊ちゃまを怒らせたら、相手の手足を斬るって武侠小説で読んだことあるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030833
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120030833,
					"content": "どうしよう？どうすればいい？ごめん！本当にオイラが悪かった！許してくれっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030834
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120030834,
					"content": "君は飛べるんだし、足がなくても平気だろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030835
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030835,
					"content": "#うわっ！その目は本気だ！{NICKNAME}、助けろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030836,
						120030837
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120030836,
					"content": "からかってるだけだよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030838
					]
				},
				{
					"id": 120030838,
					"content": "くくっ、冗談はここまでにして、今回のことは助かった、本当にありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030839
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030839,
					"content": "この『神霄折戟録』もなかなか面白かった。これを常九殿に返してきてくれないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030840
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030840,
					"content": "また使い走り？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030841
					]
				},
				{
					"id": 120030841,
					"content": "だって、僕は何もしていないのに、お礼を言われるのもなんだろう。君たちは関係ないのに、最後まで協力してくれたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030842
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030842,
					"content": "これほど義侠の心のある人と知り合えただけで、僕は満足だからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030843
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030843,
					"content": "坊ちゃま、お話の途中で申し訳ありませんが、旦那様の方には…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030844
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 120030844,
					"content": "ああ、父上には今回の件を解決したついでに、大金を稼いだと伝えてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030845
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030845,
					"content": "だから、このことに免じてあと数日だけ時間をくれないか？『神霄折戟録』の中に秘境の話があってね、そこに行ってみたいんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030846
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030846,
					"content": "そんなこと言って、本当は本を返しに行くのが面倒なだけだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030847
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120030847,
					"content": "ハハッ、常九殿ならきっと謝礼も準備してくれていると思うよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030848
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030848,
					"content": "謝礼！…ま、まあ、行ってやらなくもないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030849
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120030849,
					"content": "はぁ、何を言っても坊ちゃまは止められませんね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030850
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 120030850,
					"content": "何で行秋の正体を教えてくれなかった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030851
					]
				},
				{
					"id": 120030851,
					"content": "し、知らないとは思わなかったです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030852
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 120030852,
					"content": "では、本を返すことは頼んだ。縁があったらまた会おう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030837,
					"content": "読んだのは本当に武侠小説なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030838
					]
				},
				{
					"id": 120030829,
					"content": "御曹司は字の練習をしないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030830
					]
				},
				{
					"id": 120030830,
					"content": "ハハハッ、それは大目に見てくれ。僕の字を見れば僕だってすぐ分かるから、ある意味便利なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030831
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030811,
					"content": "…やはりそうなんだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030812
					]
				}
			]
		},
		{
			"id": 1200309,
			"completionStepIds": [
				1200309
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
