			"dialogs": [
				{
					"id": 402130101,
					"content": "申し訳ございません！よそ者に設計局の資産を占有されてしまうとは、なんという失態…必ず原因を究明いたします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402130102
					],
					"speakerTitle": "「准尉」"
				},
				{
					"id": 402130102,
					"content": "いや、調査は不要だ。部下を連れて戻ってくれ。この施設を改めて管理してもらう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402130103
					],
					"speakerTitle": "「大尉」"
				},
				{
					"id": 402130103,
					"content": "調査が不要というのは…上の意思でしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402130104
					],
					"speakerTitle": "「准尉」"
				},
				{
					"id": 402130104,
					"content": "調査は不要だ——わかったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402130105
					],
					"speakerTitle": "「大尉」"
				},
				{
					"id": 402130105,
					"content": "はっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402130106
					],
					"speakerTitle": "「准尉」"
				},
				{
					"id": 402130106,
					"content": "ん？いつの間に紛れ込んできた。ここはクーヴァキ実験設計局の施設だ。関係者以外は立ち去れ。",
					"roleType": "TALK_ROLE_NPC",
