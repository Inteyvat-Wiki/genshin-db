			"dialogs": [
				{
					"id": 401930301,
					"content": "オーナー！三川花祭のおかげで、ここ数日の客数がいつもの三倍ですよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930302
					],
					"speakerTitle": "藍川丞"
				},
				{
					"id": 401930302,
					"content": "今月の売上…かなり、いっちゃうかもです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930303
					],
					"speakerTitle": "藍川丞"
				},
				{
					"id": 401930303,
					"content": "うんうん、いい調子。今月こそ、真っ向勝負で八重堂に勝てるかもね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930304
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 401930304,
					"content": "何を喜んでおるのじゃ。妾にも教えてくれぬか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930305
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 401930305,
					"content": "み、神子…アハハ、何でもないって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930306
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 401930306,
					"content": "ほう…妾のほうは、嬉しいことがあったのじゃ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930307
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 401930307,
					"content": "三川花祭の収益の三割を八重堂が受けることになったゆえ、今月の売上はこれまでをはるかに上回るやもしれぬ。めでたいじゃろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930308
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 401930308,
					"content": "ええっ——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930309
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 401930309,
					"content": "え…えっと…つまり我々は八重堂の売り上げに対する三百三十三回目の挑戦で、みごと準優勝に輝いたってことですね。いやぁ、めでたい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930310
					],
					"speakerTitle": "藍川丞"
				},
				{
					"id": 401930310,
					"content": "ふふふ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930311
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 401930311,
					"content": "…今夜、皆が美しい夢を見られますように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "影"
				}
			]
		},
