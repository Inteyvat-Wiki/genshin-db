			},
			"dialogs": [
				{
					"id": 401930101,
					"content": "よう、ダチ公！昨日の夜は秋沙銭湯に行ってきたんだってな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930102
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401930102,
					"content": "みんなをねぎらって、俺様も今日、秋沙銭湯に行こうと思ってるんだが、一緒にどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930103
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401930103,
					"content": "えっ？でも、オイラたち、昨日行ったばかりだし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401930104,
					"content": "だってほら、昨日一緒に行けなかったやつらもいるだろ？忍とかゴローとか…あと、綾人の兄貴も…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930105
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401930105,
					"content": "要するに、温泉のことを聞いて、親分自身が行きたくなったらしいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930106
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 401930106,
					"content": "と…とにかく！祭りを満喫し終わったら、教えてくれ。ヒュー、みんなで温泉だぜッ！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "荒瀧一斗"
				}
			]
		},
