					}
				]
			},
			"dialogs": [
				{
					"id": 401930201,
					"content": "一斗に急かされながら、再びみんなで「秋沙銭湯」へと向かった。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401930202
					]
				},
				{
					"id": 401930202,
					"content": "ガハハッ！ここが一番熱いみてぇだな。誰が一番長く耐えられるか、勝負しようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930203
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401930203,
					"content": "ハハッ、一斗殿からの熱い申し出を無下にするわけにもいかないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930204
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 401930204,
					"content": "やめな、いい大人なんだから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930205
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 401930205,
					"content": "温泉…あったかい…すぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930206
					],
					"speakerTitle": "早柚"
				},
				{
					"id": 401930206,
					"content": "おい、温泉で寝たら危ないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401930207,
					"content": "うぅ…毛皮がずぶぬれで重たい。クラクラする…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930208
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 401930208,
					"content": "ハハハッ！ゴローの兄弟、もうへばっちまったのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930209
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401930209,
					"content": "おい——温泉施設で騒ぐな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930210
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 401930210,
					"content": "その頃、他の一行は…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401930211
					]
				},
				{
					"id": 401930211,
					"content": "ふふ、一斗くんは相変わらず元気いっぱいですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930212
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 401930212,
					"content": "お兄様、対戦に集中してくださいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930213
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 401930213,
					"content": "おぉ——手に汗握る局面、はたして旅人の次の一手は！？なあなあ、二人やったらどうする？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930214
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 401930214,
					"content": "そうですね…私なら、一歩一歩堅実に進み、味方の優位を固める策を取るでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930215
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 401930215,
					"content": "危険を承知で果敢に攻め続け、勝利をものにする…っていうのも悪くないと思うよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930216,
						401930217
					],
					"speakerTitle": "鹿野院平蔵"
				},
				{
					"id": 401930216,
					"content": "（着実に進もう…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401930218
					]
				},
				{
					"id": 401930218,
					"content": "ほう？その手があったとは、参りました。これ以上続ける必要もないでしょう。先ほど引いたくじでは、次に貴方に挑むのは——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930219
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 401930219,
					"content": "綾華、存分に楽しみなさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930220
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 401930220,
					"content": "えっ…？は、はい！では、よろしくお願いいたします…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930221
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 401930221,
					"content": "（綾人…もしかして、綾華に譲るためにわざと負けた…？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 401930217,
					"content": "（賭けに出る！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401930218
					]
				}
			]
		},
