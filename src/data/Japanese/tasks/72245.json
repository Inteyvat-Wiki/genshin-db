			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"里栖太御須",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722450401,
					"content": "動くな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450402
					],
					"speakerTitle": "里栖太御須"
				},
				{
					"id": 722450402,
					"content": "あっ！動くなって！そう言ってるのが聞こえないのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450403
					],
					"speakerTitle": "里栖太御須"
				},
				{
					"id": 722450403,
					"content": "えっ、でも…なんで急に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450404,
						722450405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722450404,
					"content": "パイモンが動かなかったら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722450406
					]
				},
				{
					"id": 722450406,
					"content": "そんなことないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450407
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722450407,
					"content": "それじゃあ、一回転してみてくれ。そんな服、見たことがない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450408
					],
					"speakerTitle": "里栖太御須"
				},
				{
					"id": 722450408,
					"content": "少しダサいが、なかなか面白い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450409
					],
					"speakerTitle": "里栖太御須"
				},
				{
					"id": 722450409,
					"content": "ダサいだなんて、じゃあ見るなよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450410
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722450410,
					"content": "なんだよ…女官たちに同じこと言ったときは、こんなうるさくなかったのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450411
					],
					"speakerTitle": "里栖太御須"
				},
				{
					"id": 722450411,
					"content": "まあでも、白夜の国にいる人の服とか顔は、もう見飽きたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450412
					],
					"speakerTitle": "里栖太御須"
				},
				{
					"id": 722450412,
					"content": "だからキミたちが珍しいのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450413
					],
					"speakerTitle": "里栖太御須"
				},
				{
					"id": 722450413,
					"content": "ふむふむ、なるほど。この服はこういう仕組みなのか…キミたち異郷の者は、羞恥心というものを知らないようだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450414
					],
					"speakerTitle": "里栖太御須"
				},
				{
					"id": 722450414,
					"content": "なるほど、服の構造はこうなっているのか。だったら、体の部分はこの形にしよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450415
					],
					"speakerTitle": "里栖太御須"
				},
				{
					"id": 722450415,
					"content": "なにがしたいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450416
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722450416,
					"content": "彫像だよ。泥と水を混ぜて、手で形を作り上げる。これをやってる時は、いつも心が落ち着くんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450417
					],
					"speakerTitle": "里栖太御須"
				},
				{
					"id": 722450417,
					"content": "普段の議会では、大人たちが決めた台詞を言うだけで、とても不安な気持ちになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450418
					],
					"speakerTitle": "里栖太御須"
				},
				{
					"id": 722450418,
					"content": "…さて、キミの造型も、もう見飽きたかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450419
					],
					"speakerTitle": "里栖太御須"
				},
				{
					"id": 722450419,
					"content": "ボクにかまわず、自分のことをしてくるといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "里栖太御須"
				},
				{
					"id": 722450405,
					"content": "空中から落ちるのかな？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722450406
					]
				}
			]
		},
		{
			"id": 7224505,
			"completionStepIds": [
				7224505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
