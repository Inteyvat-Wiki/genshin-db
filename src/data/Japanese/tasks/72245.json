			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"離可琉",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722450101,
					"content": "ん？ちょっと邪魔しないで、今…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450102
					],
					"speakerTitle": "離可琉"
				},
				{
					"id": 722450102,
					"content": "すごく大事なこと考えてるんだから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450103
					],
					"speakerTitle": "離可琉"
				},
				{
					"id": 722450103,
					"content": "大事なこと？なに考えてたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722450104,
					"content": "あの大日御輿って呼ばれてるもの、キミも見たでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450105
					],
					"speakerTitle": "離可琉"
				},
				{
					"id": 722450105,
					"content": "あれは白夜の国でもっとも高い建造物なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450106
					],
					"speakerTitle": "離可琉"
				},
				{
					"id": 722450106,
					"content": "今ね、どうすればあれより高い建造物を建てられるか、考えてたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450107
					],
					"speakerTitle": "離可琉"
				},
				{
					"id": 722450107,
					"content": "うーん…でも大日御輿があんなに高いのって、白夜国を照らすためなんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722450108,
					"content": "それよりも高いものを作って、なにするんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722450109,
					"content": "もちろん、このボク——離可琉さまの名を轟かせるためさ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450110
					],
					"speakerTitle": "離可琉"
				},
				{
					"id": 722450110,
					"content": "そうすれば、ボクがあの阿倍良久のおっさんよりも、すごいって証明できるだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450111,
						722450112
					],
					"speakerTitle": "離可琉"
				},
				{
					"id": 722450111,
					"content": "知り合いなの…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722450113
					]
				},
				{
					"id": 722450113,
					"content": "もちろん。大日御輿を建てて、白夜国を危機から救った人でしょ…昔は、ボクも彼を崇拝してたけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450114
					],
					"speakerTitle": "離可琉"
				},
				{
					"id": 722450114,
					"content": "でも、まさか王位を狙うとはね。あの大人たちがいなかったら、ボクは命を落としてたかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450115
					],
					"speakerTitle": "離可琉"
				},
				{
					"id": 722450115,
					"content": "ふんっ、絶対に大日御輿より高い建造物を建ててやる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450116
					],
					"speakerTitle": "離可琉"
				},
				{
					"id": 722450116,
					"content": "ど、どんだけかかるんだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722450117,
					"content": "知ったことか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450118
					],
					"speakerTitle": "離可琉"
				},
				{
					"id": 722450118,
					"content": "ボクのおかげで、白夜国の民はこんなにも意味のあるものを建てられるんだ。感謝してもしきれないはずだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450119
					],
					"speakerTitle": "離可琉"
				},
				{
					"id": 722450119,
					"content": "さあ、わかったら邪魔しないでよね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450120
					],
					"speakerTitle": "離可琉"
				},
				{
					"id": 722450120,
					"content": "そうだな…高さがこれくらいなら…耐力と接合部は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "離可琉"
				},
				{
					"id": 722450112,
					"content": "阿倍良久を知ってるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722450113
					]
				}
			]
		},
		{
			"id": 7224502,
			"completionStepIds": [
				7224502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
