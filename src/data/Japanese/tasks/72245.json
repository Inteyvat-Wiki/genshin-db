			},
			"dialogs": [
				{
					"id": 722450701,
					"content": "はぁ…キミは、異郷の旅人か…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450702
					],
					"speakerTitle": "御琉部栖"
				},
				{
					"id": 722450702,
					"content": "何かを探してるのか。キミの歩く姿を見ると、実に悲しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450703
					],
					"speakerTitle": "御琉部栖"
				},
				{
					"id": 722450703,
					"content": "悲しい？なにか悲しいことでもあったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450704
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722450704,
					"content": "歌手にとって、この世界にあるすべてが悲しいことなのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450705
					],
					"speakerTitle": "御琉部栖"
				},
				{
					"id": 722450705,
					"content": "例えば、結ぶことは別れを意味するんだ。そして生きることは、いつの日か土の下に埋まることを意味する…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450706
					],
					"speakerTitle": "御琉部栖"
				},
				{
					"id": 722450706,
					"content": "それと同じように、長き別れの痛みを癒せはしない、短い再会ではね…旅人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450707
					],
					"speakerTitle": "御琉部栖"
				},
				{
					"id": 722450707,
					"content": "何かを探す人のみが、故郷を遠く離れた旅路に足を踏み入れるのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450708
					],
					"speakerTitle": "御琉部栖"
				},
				{
					"id": 722450708,
					"content": "現地の者にとっては、そのような旅路は浪漫溢れるものだろう。だが旅人自身からすれば、苦痛を伴う旅だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450709
					],
					"speakerTitle": "御琉部栖"
				},
				{
					"id": 722450709,
					"content": "昔なら、キミのために一曲歌ってあげてたんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450710
					],
					"speakerTitle": "御琉部栖"
				},
				{
					"id": 722450710,
					"content": "今はある人と約束しててね。彼女の声を聴くまで、ボクはもう歌わないと誓ってるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450711
					],
					"speakerTitle": "御琉部栖"
				},
				{
					"id": 722450711,
					"content": "だから、キミのために祝福を祈ることしかできない。まあ、キミはボクよりけっこう年上みたいだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450712
					],
					"speakerTitle": "御琉部栖"
				},
				{
					"id": 722450712,
					"content": "キミの願いが叶わんことを。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "御琉部栖"
				}
			]
		}
	]
