			"trigger": {
				"objectNames": [
					"栖令比御",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722450301,
					"content": "遠方からの旅人か。ゴホッ…とても疲れているようだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450302
					],
					"speakerTitle": "栖令比御"
				},
				{
					"id": 722450302,
					"content": "疲労はよくないことだよ。多くの病は、疲労から始まるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450303
					],
					"speakerTitle": "栖令比御"
				},
				{
					"id": 722450303,
					"content": "毎日十分な睡眠を取らないと、ゴホッゴホッ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450304
					],
					"speakerTitle": "栖令比御"
				},
				{
					"id": 722450304,
					"content": "ゴホッ、ゲホッゲホッ…健康に成長できない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450305
					],
					"speakerTitle": "栖令比御"
				},
				{
					"id": 722450305,
					"content": "なんか…おまえのほうが不健康そうだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722450306,
					"content": "ははっ、これは昔からでね、持病なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450307
					],
					"speakerTitle": "栖令比御"
				},
				{
					"id": 722450307,
					"content": "いいかい、健康な体にしか、完全な魂は宿らない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450308
					],
					"speakerTitle": "栖令比御"
				},
				{
					"id": 722450308,
					"content": "はぁ…もう少し時間があったらよかったのに…そうすればボクはきっと、世界一の医者になって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450309
					],
					"speakerTitle": "栖令比御"
				},
				{
					"id": 722450309,
					"content": "たとえボクの体でも、健康な状態で部屋から出られたはず。そして思う存分、遊べたのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "栖令比御"
				}
			]
		},
		{
