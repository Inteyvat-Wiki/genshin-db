			"trigger": {
				"objectNames": [
					"伊恩",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722450501,
					"content": "おや、そこの旅人。面白い恰好をしてるね、ボクが占ってあげようか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450502
					],
					"speakerTitle": "伊恩"
				},
				{
					"id": 722450502,
					"content": "ボクは、占いが確実に当たると言われている、伊恩さまだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450503
					],
					"speakerTitle": "伊恩"
				},
				{
					"id": 722450503,
					"content": "ホントか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722450504,
					"content": "なんか、客引きの謳い文句みたいに聞こえるけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722450505,
					"content": "（それに、たしかこの子の墓に書いてあったのは……）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450506
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722450506,
					"content": "そんな疑うような目で見ないでよ。ボクは普段からみんなを占ってあげてるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450507
					],
					"speakerTitle": "伊恩"
				},
				{
					"id": 722450507,
					"content": "でも白夜国の国民に…幸福で楽しい運命が訪れることは、非常に少ない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450508
					],
					"speakerTitle": "伊恩"
				},
				{
					"id": 722450508,
					"content": "だからいつも、幸運だって嘘をつくことにしてるんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450509
					],
					"speakerTitle": "伊恩"
				},
				{
					"id": 722450509,
					"content": "それで少しでも、嬉しい気持ちになってくれたらいいと思ってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450510
					],
					"speakerTitle": "伊恩"
				},
				{
					"id": 722450510,
					"content": "でもそのせいで、占いが全然当たらないって言われちゃうんだ。まったく、悲しいよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450511
					],
					"speakerTitle": "伊恩"
				},
				{
					"id": 722450511,
					"content": "それ、ホントなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450512
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722450512,
					"content": "ねえねえ、小人さん、キミのことも占ってあげようか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450513
					],
					"speakerTitle": "伊恩"
				},
				{
					"id": 722450513,
					"content": "お、おう。じゃあ、占ってみてくれよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450514
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722450514,
					"content": "ふむ…どれどれ、あれ、なんでこんなに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450515
					],
					"speakerTitle": "伊恩"
				},
				{
					"id": 722450515,
					"content": "うわっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450516
					],
					"speakerTitle": "伊恩"
				},
				{
					"id": 722450516,
					"content": "ど、どうしたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450517
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722450517,
					"content": "占えない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450518
					],
					"speakerTitle": "伊恩"
				},
				{
					"id": 722450518,
					"content": "どうしてだ…普段はたしかに当たらないこともあるけど、占えないなんてことはなかったのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450519
					],
					"speakerTitle": "伊恩"
				},
				{
					"id": 722450519,
					"content": "どうやら、大した腕じゃなさそうだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450520
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722450520,
					"content": "…そうみたい。まだまだ勉強が必要みたいだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊恩"
				}
			]
		},
