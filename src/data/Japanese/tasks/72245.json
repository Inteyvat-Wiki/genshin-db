			},
			"dialogs": [
				{
					"id": 722450601,
					"content": "あっ、その恰好、異国から来た旅人だよね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450602
					],
					"speakerTitle": "比螺夢門"
				},
				{
					"id": 722450602,
					"content": "どこから来たの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450603
					],
					"speakerTitle": "比螺夢門"
				},
				{
					"id": 722450603,
					"content": "モンドから来た。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722450604,
					"content": "モンド？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450605
					],
					"speakerTitle": "比螺夢門"
				},
				{
					"id": 722450605,
					"content": "比螺夢門に、モンド城の景色と雰囲気を簡単に説明した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722450606
					]
				},
				{
					"id": 722450606,
					"content": "聞いたこともない都だ。そうか、すごいね。そんな場所があるなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450607
					],
					"speakerTitle": "比螺夢門"
				},
				{
					"id": 722450607,
					"content": "はははっ、だから言ったのさ。この世界が白夜国だけのはずがないって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450608
					],
					"speakerTitle": "比螺夢門"
				},
				{
					"id": 722450608,
					"content": "白夜国しかなかったら、そんなの…つまらな過ぎて死んじゃうよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450609
					],
					"speakerTitle": "比螺夢門"
				},
				{
					"id": 722450609,
					"content": "古い文献に、白夜国ができる前の物語が載ってたんだ。それを読んだ時、きっと外の世界があると思ったんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450610
					],
					"speakerTitle": "比螺夢門"
				},
				{
					"id": 722450610,
					"content": "だけど、本当はけっこう怖かったんだ。白夜国の外に何もないかもしれないことが、恐ろしくてたまらなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450611
					],
					"speakerTitle": "比螺夢門"
				},
				{
					"id": 722450611,
					"content": "旅人、キミの存在を知れてとても安心したよ。ふむ、世界にはまだまだ面白い場所があるんだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450612
					],
					"speakerTitle": "比螺夢門"
				},
				{
					"id": 722450612,
					"content": "ただ残念なことに、ボクは帰日の祭に出なければならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450613
					],
					"speakerTitle": "比螺夢門"
				},
				{
					"id": 722450613,
					"content": "そうだ、旅人。ここまでどうやって来たのか教えてよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450614
					],
					"speakerTitle": "比螺夢門"
				},
				{
					"id": 722450614,
					"content": "帰日の祭が終わったら、機会を見計って、大日御輿から抜け出すからさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450615
					],
					"speakerTitle": "比螺夢門"
				},
				{
					"id": 722450615,
					"content": "その時は、ジュースでも一緒に飲もう！あはははっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "比螺夢門"
				}
			]
		},
