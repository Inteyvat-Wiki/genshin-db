			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"依栖目那須",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722450201,
					"content": "ん？白夜の国でキミたちのような格好をした者は見たことがない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450202
					],
					"speakerTitle": "依栖目那須"
				},
				{
					"id": 722450202,
					"content": "まさか、外から来たのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450203
					],
					"speakerTitle": "依栖目那須"
				},
				{
					"id": 722450203,
					"content": "やっぱり、この世界は白夜の国だけじゃなかったんだな！キミたちの使ってる地図を見せてくれよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450204
					],
					"speakerTitle": "依栖目那須"
				},
				{
					"id": 722450204,
					"content": "（地図を見せる…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722450205
					]
				},
				{
					"id": 722450205,
					"content": "ふむふむ、なるほど。実に緻密に作られている。陸地の輪郭は細かく、川の流れさえも描いてあるなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450206
					],
					"speakerTitle": "依栖目那須"
				},
				{
					"id": 722450206,
					"content": "このテイワットという国の大きさは、白夜の国と比べたらどれくらいなんだい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450207
					],
					"speakerTitle": "依栖目那須"
				},
				{
					"id": 722450207,
					"content": "テイワットっていうのは、大陸全体の名前だぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722450208,
					"content": "それと淵下宮…あっ、白夜国は、地図の南にあるこの小さなところだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722450209,
					"content": "なんだと！ボクたち白夜の国土はこんなに広いんだぞ、こんなちっぽけなわけがあるか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450210
					],
					"speakerTitle": "依栖目那須"
				},
				{
					"id": 722450210,
					"content": "それにこの地図、出来過ぎてるな。きっと妄想で描いたものに違いない！さっさと持ってけ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450211
					],
					"speakerTitle": "依栖目那須"
				},
				{
					"id": 722450211,
					"content": "尊敬の念を抱いたのに、まさか偽物だとは。よくもボクの目を汚してくれたな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450212
					],
					"speakerTitle": "依栖目那須"
				},
				{
					"id": 722450212,
					"content": "ふんっ！信じないなら勝手にしろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
