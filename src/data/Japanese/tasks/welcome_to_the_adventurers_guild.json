			"trigger": {
				"objectNames": [
					"キャサリン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200300101,
					"content": "<color=#00E1FFFF>冒険者協会</color>へようこそ。あなたのことは観察させてもらいました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300102
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200300102,
					"content": "#{NICKNAME}を観察？こいつなんかしたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 200300103,
					"content": "いえいえ、優秀な冒険者を見つけることも、私の仕事ですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300104
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200300104,
					"content": "あなたから、伝説の冒険者たちと肩を並べられるほどの素質を感じます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300105
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200300105,
					"content": "へへっ、それはオイラも分かるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 200300106,
					"content": "#{NICKNAME}と一緒にいると、安心できるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 200300107,
					"content": "でも冒険者にとって素質よりも経験のほうが大事です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300108
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200300108,
					"content": "<color=#00E1FFFF>「冒険経験」</color>を積み重ねることで<color=#00E1FFFF>「冒険ランク」</color>が上がります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300109
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200300109,
					"content": "早速、新しく入ってきた冒険者に紹介しますね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300110
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200300110,
					"content": "待って！オイラたちもう正式な冒険者になったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 200300111,
					"content": "安心してください。冒険者協会には会費を払う必要も、強制的な義務もありませんから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300112
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200300112,
					"content": "つまり、協会に入ったらメリットだらけ、デメリットはありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300113,
						200300114
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200300113,
					"content": "分かった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200300116
					]
				},
				{
					"id": 200300116,
					"content": "とにかく、「冒険ランク」が上がる度、冒険者協会から報酬をもらえます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300117
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200300117,
					"content": "これは協会から新人へ贈るプレゼントです、確認してくださいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300118
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200300118,
					"content": "冒険ランク報酬",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 200300114,
					"content": "今メリットがほしい！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200300115
					]
				},
				{
					"id": 200300115,
					"content": "はは…今時の新人は率直ですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300116
					],
					"speakerTitle": "キャサリン"
				}
			]
		},
		{
			"id": 2003002,
			"completionStepIds": [
				2003003,
				2003004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2003003",
							"2"
						],
						"stepId": 2003003,
						"stateName": "QUEST_STATE_UNFINISHED"
