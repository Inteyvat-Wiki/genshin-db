				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"キャサリン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200300201,
					"content": "改めて入会を歓迎します、冒険者の新星！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300202
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200300202,
					"content": "これはあなたの<color=#00E1FFFF>「冒険の証」</color>です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300203,
						200300205
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200300203,
					"content": "証書もあるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200300204
					]
				},
				{
					"id": 200300204,
					"content": "新人の加入はとても大事なことですから、当然です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300207
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200300207,
					"content": "これには協会の依頼や報酬に関する情報がたくさん載ってますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300208
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200300208,
					"content": "会員の証明でもあるからね、きちんと保管してくださいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300209
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200300209,
					"content": "それと、もうひとつ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300210
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200300210,
					"content": "「冒険ランク」が上がりにくいと感じる時がたまにあると思いますが、",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300211
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200300211,
					"content": "その時は「印象に残る任務」をクリアすることで協会の認可をもらえますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300212
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200300212,
					"content": "印象に残る任務…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 200300213,
					"content": "「冒険ランク」の上限を突破するための「突破任務」と言ったほうがいいかもしれませんね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300214
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200300214,
					"content": "今はまだその時じゃないですが、あなたの「経験」が多くなれば、みんなの認可をもらえるチャンスも増えてくるはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300215
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200300215,
					"content": "では今日はここまでにしましょう。これからどんどん会う機会も増えると思いますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300216
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200300216,
					"content": "頑張ってくださいね、冒険者さん。星と深淵を目指せ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200300205,
					"content": "これは…宣伝冊子？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200300206
					]
				},
				{
					"id": 200300206,
					"content": "そう思ってもいいですけど、機能性は侮れませんよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300207
					],
					"speakerTitle": "キャサリン"
				}
			]
		}
	]
}