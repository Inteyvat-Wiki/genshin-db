				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ヘディーヴ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710880201,
					"content": "こんにちは！ああ、君か！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880221
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710880221,
					"content": "ははっ、本当に君たちを探してくるなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880202,
						710880203
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710880202,
					"content": "#そう、{M#俺}{F#私}だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710880204
					]
				},
				{
					"id": 710880204,
					"content": "ああ、失礼失礼！俺はヘディーヴ、ヘディーヴ·プルシナだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880205
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710880205,
					"content": "ははっ、もし君が学院の歴史に詳しければ、俺たちの創始者が占星学の分野で、プルビルニの宿敵だったことを知っていただろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880206,
						710880208
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710880206,
					"content": "#{M#俺}{F#私}は{NICKNAME}だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710880207
					]
				},
				{
					"id": 710880207,
					"content": "自己紹介はいらないよ、君の名はすでに聞き及んでいるからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880211
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710880211,
					"content": "ここで何してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710880212
					]
				},
				{
					"id": 710880212,
					"content": "俺は総務司から特別に招待されて来た調査学者なんだ。層岩巨淵の再開前に立て坑に入って、生態系の変化や古生物の考察をしている…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880213
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710880213,
					"content": "当然、その代わり、璃月の歴史学会にその研究成果を伝えなければならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880214
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710880214,
					"content": "はぁ、言いたいことは分かる…原則、これは教令院の規則に反する行為だ。だが璃月のスタンスは強硬で、彼らを揺さぶることのできる人はいない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880215
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710880215,
					"content": "それに、探検隊は名目上、俺が率いている。拠点にいる鉱夫たちの費用も負担しなければならない…はぁ、成果が出なければ、元も子もないんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880216,
						710880217
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710880216,
					"content": "なるほど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710880218
					]
				},
				{
					"id": 710880218,
					"content": "でもまあ大丈夫さ、慰めてもらう必要はない。俺はお金持ちだからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880219
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710880219,
					"content": "ならいい。さようなら。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710880220
					]
				},
				{
					"id": 710880220,
					"content": "じゃあね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710880217,
					"content": "大変だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710880218
					]
				},
				{
					"id": 710880208,
					"content": "先生を紹介するのがスメールの伝統なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710880209
					]
				},
				{
					"id": 710880209,
					"content": "ははっ、そうじゃないさ。なんというか…学者としての矜持かな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880210
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710880210,
					"content": "アニサ先輩のせいで…プルビルニの悪癖がうつってしまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880211
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710880203,
					"content": "誰？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710880204
					]
				}
			]
		},
		{
			"id": 7108803,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7108802",
							"2"
						],
						"stepId": 7108802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"瑾武"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710880301,
					"content": "よ、見ない顔だね。こんにちは、若者！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880302
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880302,
					"content": "見ない顔？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710880303
					]
				},
				{
					"id": 710880303,
					"content": "ははっ…鉱区の全員を知ってるとは言えないけど、名前くらいは言えるよ。あんたは…初めて鉱区に入ったんじゃないかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880304
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880304,
					"content": "#{NICKNAME}だよ。よろしく。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710880305
					]
				},
				{
					"id": 710880305,
					"content": "設備を管理している瑾武だ。もう二十年ほど鉱区にいるから、こいつらの姉貴みたいなもんさ。何か分からないことがあったり、設備に問題があったりしたときは、あたしを探せばいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880306
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880306,
					"content": "あとは、歴史や昔話などを聞きたきゃ大歓迎さ。まあ、暇してるからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880307,
						710880316,
						710880323,
						710880326
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880307,
					"content": "層岩巨淵の歴史について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710880308
					]
				},
				{
					"id": 710880308,
					"content": "それは長い話になるよ…簡潔に説明してあげよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880309
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880309,
					"content": "層岩巨淵は璃月最大の鉱床で、天衡山の鉱区に次いで二番目に古い鉱区なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880310
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880310,
					"content": "岩王帝君が現れる前は、琉璃晶砂を採掘して、陶磁器なんかの取引で生計を立てていた部族が住んでたって伝説もある…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880311
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880311,
					"content": "その後、これらの部族は岩王帝君の使者である夜叉と血の誓いを交わして彼らに加わり、今の八門の一つ——盛露庁の前身となったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880312
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880312,
					"content": "彼らは若陀龍王の鎮圧や、漆黒の災いの撃退にも参加した…本当に、璃月にすごく貢献したのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880313
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880313,
					"content": "ほら、北西方向のあの谷…あれは、岩王帝君が若陀龍王を層岩巨淵から引きずり出した時にできた跡だって伝説もある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880314
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880314,
					"content": "その後、荒れ果てた土地を捨て、都市での生活に慣れた部族の人々は岩王帝君と共に都市に移り住むことにした。彼らは磁器を作って売ることを生業にし、戦のことなんざ気にもしなくなったのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880315
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880315,
					"content": "ははっ…だから、今の盛露庁のやつを「細かいところにばかりこだわるただの磁器商人」と見ちゃいけないよ。彼らの先祖も、岩王帝君と肩を並べて激戦を戦い抜いて来たんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880316,
					"content": "層岩巨淵について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710880317
					]
				},
				{
					"id": 710880317,
					"content": "数年前、鉱区が封鎖された時、あたしもここにいた。下層のやつらがえらいものを掘り出したって聞いたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880318
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880318,
					"content": "その時は、負傷者が次から次へと上に運ばれてきた記憶しかないね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880319
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880319,
					"content": "また、おかしなことに、やつらが負った傷はよく見かける仕事中の怪我なんかじゃかった。そうだね…精神的な衝撃を受けたみたいな感じだ、分かるかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880320
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880320,
					"content": "やつらを地上に送り出してからは、たったの数日で元の精神状態に戻ってくれた…大きな被害はなかったが、それでも七星の目を引いたのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880321
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880321,
					"content": "何を掘り出したのかは知らないが、ロクなものじゃないことは間違いない。玉京台のお方たちもそう考えていたのかもしれないね…それで、層岩巨淵は全面的に封鎖された。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880322
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880322,
					"content": "その結果、盛露庁はご機嫌斜めになっちまった…ははっ、それはまた別の話だけどね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880323,
					"content": "#{M#君}{F#あなた}の仕事について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710880324
					]
				},
				{
					"id": 710880324,
					"content": "あたし？ただ設備を管理してるだけさ。もう二十年くらい経つかね。他の子供が学校に通う年頃、あたしはもう採掘用の晶石ランプや浄水器をいじってた。特に言うことはないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880325
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880325,
					"content": "#{M#たくさんの鉱夫と知り合ってきた。あいつらが初めて鉱区に入ってきた時は、あんたよりかろうじて年上って程度の年頃だったよ。}{F#女の子がこんな仕事をするもんじゃない。あたしのように一日中汗をかきながら、鉱区で時間を費やすのはもったいないよ。}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880326,
					"content": "「七星陣法」について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710880327
					]
				},
				{
					"id": 710880327,
					"content": "あれは「七星」が特別に設置したのさ。真面目な人には効くけど、卑怯者には…ははっ、冗談はここまでにしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880328
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880328,
					"content": "とにかく、この陣法は政令上最高ランクの封印さ。見た人は、勝手に封印を解いたらどんな責を問われるか、想像に難くないね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880329
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880329,
					"content": "だから、「七星」はわざと目立つ「磐鍵」を用いて、陣法を固定するための結び目として使っているんだよ。これも権威を示すため…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880330
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880330,
					"content": "賊に隙を与えたとしても、やつらはこの封印を解除して上の者を怒らせるほどの度胸はない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880331
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880331,
					"content": "コホンッ…つまり、もし誰かが妨害されずに封印を解いたとしたら…少なくとも、その人は「七星」に黙認されてるってことさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑾武"
				}
			]
		}
	]
}