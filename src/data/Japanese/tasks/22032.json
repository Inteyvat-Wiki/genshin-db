			},
			"dialogs": [
				{
					"id": 220320201,
					"content": "もう戻ってきたのですか？まさか正体を隠した料理人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320202
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320202,
					"content": "うぅ…もう待ちくたびれました。一口でも食べさせてください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320203,
						220320204
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320203,
					"content": "ごゆっくりどうぞ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220320204,
					"content": "さっき話した料理は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320205
					]
				},
				{
					"id": 220320205,
					"content": "えーっと…揚げ魚の甘酢あんかけ、黒背スズキの唐辛子煮込みとモンド風焼き魚だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 220320206,
					"content": "決めたら湯雯さんに渡そう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 2203203,
