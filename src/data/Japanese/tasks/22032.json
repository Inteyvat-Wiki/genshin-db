					"湯雯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220320101,
					"content": "うぅ…璃月料理が食べたい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320102
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320103
					]
				},
				{
					"id": 220320103,
					"content": "あなたは？その格好…あなたが旅人ですね。失礼しました、私はただ故郷が懐かしくなってしまったのです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320104,
						220320105
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320104,
					"content": "璃月料理が食べたいって言ってた？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320118
					]
				},
				{
					"id": 220320118,
					"content": "え？もしかして…璃月料理を作れるのですか？助かります！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320119
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320119,
					"content": "そ、それでは早速お願いします。本場の璃月料理を食べさせてください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320120
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320120,
					"content": "悩みますね…私が今一番食べたいのは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320121
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320121,
					"content": "ええ…子供の頃に食べた、お母さんの魚料理を思い出したので…魚が食べたいです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320122
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320122,
					"content": "魚を洗って両面に切り込みを入れ、香辛料とお酒を加え、鍋で両面がキツネ色になるまで焼く…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320123
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320123,
					"content": "水とタレを追加し煮詰め、とろみをつけて盛り付けするんです…味、香り、色合い、全てが完璧な料理です！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320124
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320124,
					"content": "隣にいた、当時はまだ幼かった弟も興奮して叫んでいたほどです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320125
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320125,
					"content": "うぅ…お母さんの魚料理は絶品でしたが、いつになったら帰って食べることが出来るんでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320105,
					"content": "何かお困りごとでも？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320106
					]
				},
				{
					"id": 220320106,
					"content": "まずは自己紹介させてください。私の名前は湯雯。璃月の歴史学者で、稲妻の特徴的な風習や民話を調査していました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320107
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320107,
					"content": "現地での情報収集がほぼ終わり、璃月に帰る予定でした。しかし、稲妻の鎖国令が原因で、ここに留まらざるを得なくなってしまいました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320108
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320108,
					"content": "しかし実は、運が良かったとも思っています。何故なら今稲妻は、歴史的な瞬間を迎えていると感じているからです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320109
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320109,
					"content": "今のこの状況は、必ずテイワットの歴史に大きな足跡を残すでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320110
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320110,
					"content": "そのような歴史を自分の目で確かめ、全てを正しく記録し、子孫へと残すことこそが歴史学者の使命なのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320111
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320111,
					"content": "しかし…どんなにやりがいのある仕事でも…私のお腹を満たすことはできません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320112
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320112,
					"content": "お腹が空いたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320113
					]
				},
				{
					"id": 220320113,
					"content": "お腹が空いた…というわけではありませんが、フフッ、稲妻の料理も美味しいとは思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320114
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320114,
					"content": "ここの「天ぷら」が特に好きです。ただよく考えてみますと…衣を包んで油で揚げただけのもの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320115
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320115,
					"content": "長い間稲妻料理しか食べていないので、璃月料理が食べたくなりました。しかし、本場の璃月料理が食べられるお店はなかなか見つかりません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320116
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320116,
					"content": "先日、勢いで冒険者協会に行って「料理依頼」を出したのですが、なかなか引き受けてくれる人がいません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320117
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320117,
					"content": "試してもいい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320118
					]
				}
			]
		},
		{
