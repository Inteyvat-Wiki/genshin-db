					"湯雯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220320501,
					"content": "あら？こ、これも稲妻料理なのでは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320502
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320502,
					"content": "私が依頼した料理ではないと思うのですが…まあ、いいとしましょう。この料理で、お腹いっぱいになりましたから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320503
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320503,
					"content": "とにかく感謝します、旅人。これを受け取ってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "湯雯"
				}
			]
		},
		{
