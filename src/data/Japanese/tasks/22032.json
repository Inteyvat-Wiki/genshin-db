					"湯雯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220320401,
					"content": "おや、このお味…璃月の料理でも稲妻の料理でもないですね。新鮮なお味です…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320402
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320402,
					"content": "私が食べたかった料理ではありませんが、新鮮な味を楽しめたので、とても満足です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320403
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320403,
					"content": "旅人、ありがとうございます。これはお礼です、受け取ってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "湯雯"
				}
			]
		},
		{
			"id": 2203205,
			"completionStepIds": [
				2203205
			],
			"beginWay": "TALK_BEGIN_AUTO",
