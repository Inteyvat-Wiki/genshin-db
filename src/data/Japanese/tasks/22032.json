			},
			"dialogs": [
				{
					"id": 220320601,
					"content": "え？こ、この料理…味がなんだか…微妙です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320602
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320602,
					"content": "微妙というよりも…奇妙と言った方が正しいのかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320603
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320603,
					"content": "このような料理を作り出せるなんて、あなたの料理の腕も…なかなか独特なのですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320604
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320604,
					"content": "お疲れ様でした！お礼を受け取ってください。この料理は…後でゆっくりといただきます…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "湯雯"
