			"dialogs": [
				{
					"id": 220320701,
					"content": "魚料理か。どれを作ればいいんだろうな？あの人の代わりにオイラたちが選んでやろうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320702
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 220320702,
					"content": "そうだな…オイラが好きな魚料理は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320703
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 220320703,
					"content": "辛口の黒背スズキの唐辛子煮込み！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320704
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 220320704,
					"content": "酸っぱ甘い揚げ魚の甘酢あんかけ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320705
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 220320705,
					"content": "そして、万能なモンド風焼き魚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320706
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 220320706,
					"content": "パイモンが食べたいだけでしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320707
					]
				},
				{
					"id": 220320707,
					"content": "えへへ、オイラのセンスを信じろ！さあ、早く一つ選ぼう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320708,
						220320710,
						220320712,
						220320714
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 220320708,
					"content": "黒背スズキの唐辛子煮込みにする。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320709
					]
				},
				{
					"id": 220320709,
					"content": "いいと思うぞ！じゃあさっそく黒背スズキの唐辛子煮込みを作って、湯雯さんに食べさせてあげよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 220320710,
					"content": "揚げ魚の甘酢あんかけにする。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320711
					]
				},
				{
					"id": 220320711,
					"content": "よーし！じゃあさっそく揚げ魚の甘酢あんかけを作って、湯雯さんに食べさせてあげよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 220320712,
					"content": "モンド風焼き魚にする。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320713
					]
				},
				{
					"id": 220320713,
					"content": "よし！じゃあさっそくモンド風焼き魚を作って、湯雯さんに食べさせてあげよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 220320714,
					"content": "もう少し考える…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320715
					]
				},
				{
					"id": 220320715,
					"content": "そうか。決めたらさっそく作って湯雯さんに渡そう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
