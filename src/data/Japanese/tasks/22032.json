			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"湯雯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220320801,
					"content": "うぅ…璃月料理が食べたい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320802
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320802,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320803
					]
				},
				{
					"id": 220320803,
					"content": "あなたは？その格好…あなたが旅人ですね。失礼しました、私はただ故郷が懐かしくなってしまったのです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320804,
						220320805
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320804,
					"content": "璃月料理が食べたいって言ってた？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320818
					]
				},
				{
					"id": 220320818,
					"content": "え？もしかして…璃月料理を作れるのですか？助かります！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320819
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320819,
					"content": "そ、それでは早速お願いします。本場の璃月料理を食べさせてください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320820
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320820,
					"content": "悩みますね…私が今一番食べたいのは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320821
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320821,
					"content": "ええ…子供の頃に食べた、お母さんの魚料理を思い出したので…魚が食べたいです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320822
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320822,
					"content": "魚を洗って両面に切り込みを入れ、香辛料とお酒を加え、鍋で両面がキツネ色になるまで焼く…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320823
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320823,
					"content": "水とタレを追加し煮詰め、とろみをつけて盛り付けするんです…味、香り、色合い、全てが完璧な料理です！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320824
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320824,
					"content": "隣にいた、当時はまだ幼かった弟も興奮して叫んでいたほどです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320825
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320825,
					"content": "うぅ…お母さんの魚料理は絶品でしたが、いつになったら帰って食べることが出来るんでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320805,
					"content": "何かお困りごとでも？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320806
					]
				},
				{
					"id": 220320806,
					"content": "まずは自己紹介させてください。私の名前は湯雯。璃月の歴史学者で、稲妻の特徴的な風習や民話を調査していました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320807
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320807,
					"content": "現地での情報収集がほぼ終わり、璃月に帰る予定でした。しかし、最近稲妻には大事件が頻発していて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320808
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320808,
					"content": "今の稲妻は、歴史的な瞬間を迎えていると感じました！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320809
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320809,
					"content": "今のこの状況は、必ずテイワットの歴史に大きな足跡を残すでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320810
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320810,
					"content": "そのような歴史を自分の目で確かめ、全てを正しく記録し、子孫へと残すことこそが歴史学者の使命なのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320811
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320811,
					"content": "しかし…どんなにやりがいのある仕事でも…私のお腹を満たすことはできません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320812
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320812,
					"content": "お腹が空いたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320813
					]
				},
				{
					"id": 220320813,
					"content": "お腹が空いた…というわけではありません。フフッ、稲妻の料理もとても美味しいので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320814
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320814,
					"content": "ここの「天ぷら」が特に好きです。ただよく考えてみますと…衣を包んで油で揚げただけのもの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320815
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320815,
					"content": "長い間稲妻料理しか食べていないので、璃月料理が食べたくなりました。しかし、本場の璃月料理が食べられるお店はなかなか見つかりません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320816
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320816,
					"content": "先日、勢いで冒険者協会に行って「料理依頼」を出したのですが、なかなか引き受けてくれる人がいません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320817
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320817,
					"content": "試してもいい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320818
					]
				}
			]
		}
	]
