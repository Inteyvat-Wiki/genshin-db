			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"ジャヴィ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731090101,
					"content": "うーん…この辺にあるはずなのに、どうして見つからないんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090102
					],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090102,
					"content": "何を探してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090103
					]
				},
				{
					"id": 731090103,
					"content": "君は…ああ、旅人だな。噂は聞いている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090104
					],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090104,
					"content": "俺はジャヴィ、えっと…普通のセールスマンで、昔ここに埋めた「夢の箱」を探しているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090105
					],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090105,
					"content": "変わった名前だな…その箱の中にはなにが入ってるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731090106,
					"content": "そうだな…強いて言うなら、子供の頃に「叶えたかった夢」かな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090107
					],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090107,
					"content": "どうして埋めたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090108
					]
				},
				{
					"id": 731090108,
					"content": "ははは、これは小さい頃に友達と一緒に考えた遊びなんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090109
					],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090109,
					"content": "一番叶えたい夢を書いて、ここに埋める…そして、みんなで「夢の箱」を掘り出す時間を決めたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090110
					],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090110,
					"content": "それで、その決めた時間が今なんだけど…どうやら、このことを今でも覚えているのは俺だけだったみたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090111
					],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090111,
					"content": "はあ、みんな…この約束は忘れても、自分の夢までは忘れていないといいが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090112
					],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090112,
					"content": "とにかく、ここに来たのは自分の箱を掘り起こして、自分の中で区切りをつけたかったからなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090113
					],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090113,
					"content": "でも、いくら探しても見つからなくて…もしかして、誰かに掘り起こされたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090114,
						731090115
					],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090114,
					"content": "その時、何か目印はつけなかったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090118
					]
				},
				{
					"id": 731090118,
					"content": "確かに、木の横に埋めたはずなんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090119
					],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090119,
					"content": "木の横？こ、この辺には木がたくさんあるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731090120,
					"content": "子供の頃は気にも留めていなかった。あの時は、ただ箱を埋めた場所の目印になるように、小さな札を立てたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090121
					],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090121,
					"content": "でも長い時間が経っているから、あの札はなくなってしまったし、周囲の木の見分けもつかなくなった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090122
					],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090122,
					"content": "それでも、この辺りに箱を埋めたってことだけは、なんとなく覚えてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090123
					],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090123,
					"content": "旅人、一緒に探してくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090124,
						731090127
					],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090124,
					"content": "どうやって探すの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090125
					]
				},
				{
					"id": 731090125,
					"content": "あの箱は木の横に埋めたから…とりあえず、木の周りを掘ってみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090126
					],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090126,
					"content": "頼む、旅人。ちゃんと報酬は支払うから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090130
					],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090130,
					"content": "ほら、この森の広さを見てくれ。俺一人じゃ絶対に見つけられない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090131
					],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090131,
					"content": "分かった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090132
					]
				},
				{
					"id": 731090132,
					"content": "はは、ありがとう。それじゃ、二手に分かれて探そう。俺はこっちを探すから、あっちは君に任せる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090127,
					"content": "でも、どうせ夢は飛び去ったし…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090128
					]
				},
				{
					"id": 731090128,
					"content": "夢が飛び去ってしまったからこそ、あの箱を掘り出す必要があるんだ。子供の頃に思い描いていた夢を確かめたい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090129
					],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090129,
					"content": "頼む、旅人。ちゃんと報酬は支払うから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090130
					],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090115,
					"content": "夢は飛び去ったのかも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090116
					]
				},
				{
					"id": 731090116,
					"content": "ははは…それも否定はできない。何しろ、あの時に書いた夢は、もう覚えてないんだから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090117
					],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090117,
					"content": "ただ、たとえ夢が飛び去ったとしても、あの箱は飛べないはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090118
					],
					"speakerTitle": "ジャヴィ"
				}
			]
		},
		{
			"id": 7310903,
			"completionStepIds": [
				7310903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310903",
							"2"
						],
						"stepId": 7310903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ジャヴィ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731090301,
					"content": "しまった、この「夢の箱」は俺のものじゃない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090302,
						731090304
					],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090302,
					"content": "箱を一つ掘り起こした…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090303
					]
				},
				{
					"id": 731090303,
					"content": "はは…俺もだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090305
					],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090305,
					"content": "この「夢の箱」を開けてみたら、中の紙切れにアミの名前が書いてあった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090306
					],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090306,
					"content": "この子のことは知っている。彼女はジャハンギルの娘で、よく食品店の横にいるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090307
					],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090307,
					"content": "彼女の夢は花職人になって、たくさんの花を育てることだったらしい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090308
					],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090308,
					"content": "驚いたな。ジャハンギルは彼女を自分の店の後継者として育てるのだと思っていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090309,
						731090310
					],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090309,
					"content": "#まずは{M#君}{F#あなた}の夢を見てみよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090311
					]
				},
				{
					"id": 731090311,
					"content": "ああ！そうだ、俺の夢を確認しないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090312
					],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090312,
					"content": "えっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090313
					],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090313,
					"content": "「『ヴァナラ』になって、ずっと森の中で暮らしたい…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090314
					],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090314,
					"content": "これが俺の子供の頃の夢？まったく、あの頃は何を考えていたのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090315
					],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090315,
					"content": "はぁ、あの頃の俺に言ってやりたい。ヴァナラは簡単にモラを稼げる仕事じゃないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090316,
						731090317
					],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090316,
					"content": "いいと思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090318
					]
				},
				{
					"id": 731090318,
					"content": "そう思うのは子供だからだ。この歳になると、夢なんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090319
					],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090319,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090320
					],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090320,
					"content": "どうすればモラをもっと稼げるか、どうすれば夜にぐっすり眠れるようになるか…そんなことばかりになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090321
					],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090321,
					"content": "ふう、俺のくだらない夢よりも、問題はアミの夢についてだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090322
					],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090322,
					"content": "彼女の「夢の箱」を開けてしまったからには、お詫びに何かしなければならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090323
					],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090323,
					"content": "うーん…そうだな、彼女は花職人になりたいと思っていたわけだから、まずは花の育て方を学ぶ必要がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090324
					],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090324,
					"content": "ちょうど俺のところに使っていない植木鉢があるから、彼女にあげよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090325
					],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090325,
					"content": "旅人、花の種を手に入れる方法は知っているか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090326,
						731090327
					],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090326,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090332
					]
				},
				{
					"id": 731090332,
					"content": "それじゃ、種の件は君に任せた、旅人。後でジャハンギルの店の傍で会おう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090327,
					"content": "どうしてそんなことを？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090328
					]
				},
				{
					"id": 731090328,
					"content": "ははは…ただの気まぐれだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090329
					],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090329,
					"content": "今の俺は夢なんてものを追うことはできない。もう若くないというのもあるし…昔の夢に、あまり興味がないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090330
					],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090330,
					"content": "でも、アミはまだ若い。彼女なら自分の夢を実現するために頑張れるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090331
					],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090331,
					"content": "つまらない大人の俺にできることは何もない。せめて植木鉢をプレゼントすることで、彼女の励みになるといいんだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090332
					],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090317,
					"content": "夢にいいも悪いもない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090318
					]
				},
				{
					"id": 731090310,
					"content": "#これが{M#君}{F#あなた}の「夢の箱」だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090311
					]
				},
				{
					"id": 731090304,
					"content": "#{M#君}{F#あなた}も箱を掘り出したの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090305
					]
				}
			]
		},
		{
			"id": 7310905,
			"completionStepIds": [
				7310905
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310905",
							"2"
						],
						"stepId": 7310905,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アミ",
					"ジャヴィ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731090501,
					"content": "えっと…これを私に？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090502
					],
					"speakerTitle": "アミ"
				},
				{
					"id": 731090502,
					"content": "あの箱は私が適当に埋めたものだし、中の紙切れも適当に書いたものだから、おじさんが見ても大丈夫。謝る必要はないよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090503
					],
					"speakerTitle": "アミ"
				},
				{
					"id": 731090503,
					"content": "いいんだ。この植木鉢は俺のところにあっても使い道がないから、君にプレゼントしたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090504
					],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090504,
					"content": "それから、とある人に花の種を探してもらっているんだ。もうすぐ届くはず…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090505,
						731090506
					],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090505,
					"content": "種を持ってきた！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090507
					]
				},
				{
					"id": 731090507,
					"content": "ん？いつからいたんだ、気づかなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090508
					],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090508,
					"content": "コホン…アミ、君は花職人になりたいんだろう？これを使って花を植えてみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090509
					],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090509,
					"content": "ありがとう…でも、パパのお店の横に花を植えたら、虫さんが鍋に入っちゃうかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090510
					],
					"speakerTitle": "アミ"
				},
				{
					"id": 731090510,
					"content": "そしたら鍋に入っちゃった虫さんも可哀想だし、虫さんを食べちゃった人も可哀想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090511
					],
					"speakerTitle": "アミ"
				},
				{
					"id": 731090511,
					"content": "でもお店から離れた場所に植えたら、お世話を忘れちゃうかもしれない。それでお花が枯れたら、お花も可哀想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090512
					],
					"speakerTitle": "アミ"
				},
				{
					"id": 731090512,
					"content": "それにパパはいつも忙しくて、私一人じゃ遠くに行かせてくれないし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090513
					],
					"speakerTitle": "アミ"
				},
				{
					"id": 731090513,
					"content": "そうだな…アミさえよければ、俺と一緒に花の世話をするのはどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090514
					],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090514,
					"content": "まあ、俺は毎日の仕事帰りにしか来られないが…多少なりとも自由な時間はある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090515
					],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090515,
					"content": "いいよ！でも、パパはダメって言うかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090516
					],
					"speakerTitle": "アミ"
				},
				{
					"id": 731090516,
					"content": "俺とジャハンギルは知り合いと言える間柄だ。後で彼のところにいって話をすれば、きっと許してくれるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090517
					],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090517,
					"content": "やった！そ、それなら…もっとたくさんお花を植えたい！私、スメールローズが大好きなの！将来は…パパのお店の横に、スメールローズをいっぱい植えたいんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090518
					],
					"speakerTitle": "アミ"
				},
				{
					"id": 731090518,
					"content": "なるほど、いい夢を持っているじゃないか。それなら、俺たち二人で頑張ろう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090519,
						731090520
					],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090519,
					"content": "#その時は{M#俺}{F#私}にも一輪ちょうだい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090521
					]
				},
				{
					"id": 731090521,
					"content": "#うん！ありがとう、お{M#兄}{F#姉}さん！えっと…スイートフラワーも植えたい、あとは何を植えたらいいかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090522
					],
					"speakerTitle": "アミ"
				},
				{
					"id": 731090522,
					"content": "この子は本当に花を植えるのが好きなようだ。このまま、自分の夢を諦めないでほしい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090523
					],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090523,
					"content": "はは…俺みたいな平凡でつまらない人間にならないといいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090524
					],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090524,
					"content": "コホン！旅人、手伝ってくれてありがとう。これを受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090525,
						731090526
					],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090525,
					"content": "真面目に生きることは平凡なんかじゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090527
					]
				},
				{
					"id": 731090527,
					"content": "ありがとう。でも、俺は別に文句を言ったわけじゃないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090528
					],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090528,
					"content": "ただ…今日は埋めた「夢」を見たせいか、少し感慨深いものがあったんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090529
					],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090529,
					"content": "さて、俺もそろそろ帰るとしよう。今日はありがとう、旅人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090530
					],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090530,
					"content": "そうだな…新しい「夢」を書いて、また埋めてみるかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジャヴィ"
				},
				{
					"id": 731090526,
					"content": "真面目に生きることはつまらないことなんかじゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090527
					]
				},
				{
					"id": 731090520,
					"content": "がんばれ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090521
					]
				},
				{
					"id": 731090506,
					"content": "この花の種をあげるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090507
					]
				}
			]
