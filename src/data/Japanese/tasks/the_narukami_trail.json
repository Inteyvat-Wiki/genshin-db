				"points": []
			},
			"dialogs": [
				{
					"id": 220500201,
					"content": "「鳴神大社」は…ここにゃのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500202
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220500202,
					"content": "赤い扉が多い。人間は赤い扉が好きにゃのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500203
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220500203,
					"content": "これは「鳥居」だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500204
					]
				},
				{
					"id": 220500204,
					"content": "浅瀬神社にもあるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 220500205,
					"content": "おお、わかったにゃ。これが「鳥居」だったか。鳥たちが住む場所にゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500206
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220500206,
					"content": "鳥居が多いなら、鳥も多いはずにゃ。鳥はいいものにゃ、人間も結構かしこいにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500207
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220500207,
					"content": "主ら、響がどこにいるか見たか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500208
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220500208,
					"content": "人の痕跡はない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500209
					]
				},
				{
					"id": 220500209,
					"content": "この周りには、人はいないみたいだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 220500210,
					"content": "いっそのこと、「鳴神大社」に行って、巫女さんたちに聞いてみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 220500211,
					"content": "その「響」も巫女のはず…だったら、なにか知ってるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 2205003,
			"completionStepIds": [
				2205003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2205003",
							"2"
						],
						"stepId": 2205003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「寝子」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220500301,
					"content": "にゃおーん、この神社は本当に大きいにゃ。人間もたくさんいるにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500302
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220500302,
					"content": "おお！賽銭箱と柵もこんなに立派、どうりで人がたくさん来るにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500303
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220500303,
					"content": "主ら、ここの風格をよく学んでおくにゃ。今後、浅瀬神社もこんな風にするにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500304,
						220500305
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220500304,
					"content": "それが原因じゃないと思う…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500306
					]
				},
				{
					"id": 220500306,
					"content": "だけど、響が見つからにゃい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500307
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220500307,
					"content": "と、とにかく、誰か見つけて「響」のことを聞いてみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 220500305,
					"content": "#なんで{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}！？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500306
					]
				}
			]
		},
		{
			"id": 2205004,
			"completionStepIds": [
				2205004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2205004",
							"2"
						],
						"stepId": 2205004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"稲城蛍美",
					"「寝子」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220500401,
					"content": "こんにちは、遠くからいらした旅人さん。「鳴神大社」へようこそ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500402
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 220500402,
					"content": "悩みや願いがあるのなら、ここでおみくじを引いてみてはいかがでしょう。雷神様が祝福してくれますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500403
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 220500403,
					"content": "オイラたち、おみくじを引きに来たんじゃないんだ。聞きたいことがあって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 220500404,
					"content": "聞きたいこと？はい…どうぞおっしゃってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500405
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 220500405,
					"content": "事の経緯は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500406
					]
				},
				{
					"id": 220500406,
					"content": "浅瀬神社の…響？まさか「浅瀬響」ですか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500407
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 220500407,
					"content": "そうにゃ！響は「浅瀬響」にゃ！主は響を知ってるのかにゃ？今どこにいるにゃ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500408
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220500408,
					"content": "えぇ…えっ！？猫がしゃべった…私の聞き間違いでしょうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500409
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 220500409,
					"content": "人間は相変わらず驚くのが好きにゃ…うちがしゃべるのがそんなにおかしいのかにゃ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500410
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220500410,
					"content": "主、響を知ってるのか？今どこにいるにゃ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500411
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220500411,
					"content": "猫に質問されるのは、なんだか変な感じがしますね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500412
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 220500412,
					"content": "しかし、もし本当にあの「浅瀬響」を探しているのなら、探す場所を間違えてますよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500413
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 220500413,
					"content": "えっ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500414
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 220500414,
					"content": "探す場所を…間違えてる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500415
					]
				},
				{
					"id": 220500415,
					"content": "神社に残った数少ない保存状態の良い書籍で、彼女の名前を目にしたことがあります。彼女は浅瀬神社の最後の代…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500416
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 220500416,
					"content": "約四、五百年前、「影向役者三人組」という言い伝えがありました。浅瀬響、惟神晴之介、御輿長正はかつて影向山で、影向天狗に教えを請いました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500417
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 220500417,
					"content": "その間、浅瀬は我々の神社でも見習いをしたことがあり、狐斎宮様とも親交を深めました。しかし、最後は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500418
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 220500418,
					"content": "彼ら三人は結局、書籍にも詳しく記録されていない「災厄」をきっかけに、それぞれ別の道を歩みました。うわさでは、惟神は海を渡って璃月へ行き、より強大な「仙家道法」を学びに行ったそうです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500419
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 220500419,
					"content": "御輿は稲妻城へ戻り、幕府に仕えました。そして浅瀬は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500420,
						220500421
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 220500420,
					"content": "セイライ島に戻った…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500422
					]
				},
				{
					"id": 220500422,
					"content": "ええ、そうです。しかし参考にできる資料がとても少なく、具体的な状況は不明のままです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500423
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 220500423,
					"content": "ちょっと待って…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500424
					]
				},
				{
					"id": 220500424,
					"content": "うーん…四、五百年前ってことは、響はすごく昔の人ってことだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500425
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 220500425,
					"content": "じゃあ寝子は四、五百歳の猫ってことか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500426
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 220500426,
					"content": "にゃ？うちはよくわからにゃい。「四、五百歳」とはどういう意味にゃ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500427
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220500427,
					"content": "うちは人間じゃないから、そんなことを気にする必要はにゃい。うちは太陽と月が昇ることだけを知っていればいいにゃ。気分が悪いときは、一眠りすればいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500428
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220500428,
					"content": "羨ましい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500429,
						220500431
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 220500429,
					"content": "パイモンも似たようなものでしょ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500430
					]
				},
				{
					"id": 220500430,
					"content": "おい！失礼だな、オイラは毎日おまえの心配で忙しいんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500433
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 220500433,
					"content": "主らの言ってること、うちにはわからにゃい。そんなことより、響はどこにゃ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500434
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220500434,
					"content": "浅瀬響なら、おそらくもう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500435
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 220500435,
					"content": "響はここにいない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500436
					]
				},
				{
					"id": 220500436,
					"content": "そ、そうだぞ。響はたぶん他の場所に行ってるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500437
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 220500437,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500438
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220500438,
					"content": "そうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500439
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220500439,
					"content": "なら仕方ないにゃ。色んなところを駆けまわるなんて、響は本当に子供っぽいにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500440
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220500440,
					"content": "何はともあれ、ありがとう、巫女お姉さん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500441
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 220500441,
