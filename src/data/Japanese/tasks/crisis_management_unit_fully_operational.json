			},
			"dialogs": [
				{
					"id": 737060101,
					"content": "みんな、いい知らせだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060102
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 737060102,
					"content": "あたしたちが「知行合一プロジェクト」のために造った基礎が、各学院の権威ある学者たちに高く評価されたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060103
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 737060103,
					"content": "これからは、教令院から派遣された専門の職員が私たちの決めた基準とルールごと正式に引き継いでくれるってさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060104
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 737060104,
					"content": "みんな、本当にお疲れさま！協力してくれてありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060105
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 737060105,
					"content": "やったぁ！頑張った甲斐があった！コレイのおかげだね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060106
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 737060106,
					"content": "うむうむ、コレイは引継ぎの仕事も実に上手くやってくれたのう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060107
					],
					"speakerTitle": "ファルザン"
				},
				{
					"id": 737060107,
					"content": "新入生の若者たちもお前みたいに、隅々まで完璧にこなせるようになってくれるとよいのじゃが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060108
					],
					"speakerTitle": "ファルザン"
				},
				{
					"id": 737060108,
					"content": "論文に書いてある大きな目標ばかり考えた結果、机上の推論から離れて現実に戻った瞬間、何もできんぼんくらになるのではいかん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060109
					],
					"speakerTitle": "ファルザン"
				},
				{
					"id": 737060109,
					"content": "あ、あたしだって何でもできるわけじゃないよ！各学院の代表たちの間を走り回って、交渉して、目が回る思いだった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060110
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 737060110,
					"content": "旅人とパイモンにも感謝しないと。二人は一番大事なルールの制定を完璧にしてくれたし、貴重な意見をいっぱいくれたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060111,
						737060112
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 737060111,
					"content": "そんな大それたことでもないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737060113
					]
				},
				{
					"id": 737060113,
					"content": "オイラたちも、こういう仕事には慣れてるからな。みんなで特別なキャンプをしてるみたいな感じで楽しかったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737060114,
					"content": "謎解きと体を動かすプログラムが組み込まれてるのも面白かったしな。体を動かしたおかげでお腹が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737060115,
					"content": "うぅ…お腹…空いたぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737060116,
					"content": "なぁ、全部うまくいったことだし、お祝いにご飯でも食べようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737060117,
					"content": "はは、パイモンが代弁してくれたな。みんなへのご褒美にと思って、あたしとキャンディスが料理を用意したんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060118
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 737060118,
					"content": "皆さん、こちらへどうぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060119
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 737060119,
					"content": "ごちそう！お祝いのパーティーだな！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737060120,
					"content": "タイミングばっちりだね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060121
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 737060121,
					"content": "えへへ、こんなに豪華なスメール料理は久しぶりだな！最近食べてないものを食べたせいか、いつもの倍くらい食べちゃってる気がするぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060122,
						737060123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737060122,
					"content": "じゃあ、もう一回腹ごなしする？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737060124
					]
				},
				{
					"id": 737060124,
					"content": "ふふんっ、オイラをなめるなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737060125,
					"content": "そこまでわがままになるつもりはないぞ。おまえの財布事情だってちゃんと頭に入れてるからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737060126,
					"content": "もぐもぐ…うむ！砂漠地帯の料理を味わうのは久しぶりじゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060127
					],
					"speakerTitle": "ファルザン"
				},
				{
					"id": 737060127,
					"content": "なにやら…記憶と違う気がするな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060128
					],
					"speakerTitle": "ファルザン"
				},
				{
					"id": 737060128,
					"content": "以前砂漠で食べた料理は…こんなに手がこんでおらんかった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060129
					],
					"speakerTitle": "ファルザン"
				},
				{
					"id": 737060129,
					"content": "お褒めの言葉をありがとうございます、ファルザン先輩。光栄です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060130
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 737060130,
					"content": "アアル村を訪れる学者がみんなあなたのように礼儀正しい人でしたら、私たちも毎回最高の食事でもてなしますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060131
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 737060131,
					"content": "そういや、アンバーさんは遥か遠くのモンドから来たんだろう？スメールで見ていきたい場所とかはあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060132
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 737060132,
					"content": "へへっ、もう決めてあるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060133
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 737060133,
					"content": "オルモス港の北西に、天まで届きそうなほど大きな木が、たくさん生い茂ってる森があるって聞いたんだ。みんな「鹿狩り」の建物よりも幅が広いんだって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060134
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 737060134,
					"content": "だから一目見てみたい！一体どんな景色なんだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060135
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 737060135,
					"content": "木のてっぺんまで登ったら、そこから飛び降りて、風の翼で巨木の間を滑空するんだ。きっとすっごく楽しいよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060136
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 737060136,
					"content": "じゃあ、団子とか、水分を含んだお菓子とか用意しないとな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060137
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 737060137,
					"content": "高いところは風が強いから、くずが出るような食べ物はあまりよくないんだ。水袋も、万が一落としても大丈夫なようにぶ厚めのものを持っていこう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060138
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 737060138,
					"content": "おお！もちもちの団子は、確かによさそうだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060139
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737060139,
					"content": "砂漠なら、巨大な遺跡も気になるな。あのすっごい砂時計型の建物とか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060140
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 737060140,
					"content": "もちろん、遺跡を保護するルールとかもあるかもしれないから、ずんずん入っていくつもりは無いよ。遠くから見るだけで十分！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060141
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 737060141,
					"content": "中で眠っている主の安眠を邪魔するのも、よくないしね。あはは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060142
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 737060142,
					"content": "ルールを守ろうとしてくださって、ありがとうございます、アンバーさん。本当に嬉しいです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060143
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 737060143,
					"content": "アンバーは普段砂漠とは全然環境の違うところに住んでるから、列柱砂原を旅したら、乾燥に耐えられなくなると思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060144
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 737060144,
					"content": "だから、保湿用の軟膏とか、エッセンシャルオイルも用意して…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060145,
						737060146
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 737060145,
					"content": "お肌のケアまで考えるなんて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737060147
					]
				},
				{
					"id": 737060147,
					"content": "でも、今回は事前に立ててた旅行計画をなぞるよりも、予想外の楽しみ方ができてよかったよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060148
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 737060148,
					"content": "コレイのおかげで新しい友達もできて、すっごく嬉しい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060149
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 737060149,
					"content": "みんなも時間があったら、きっとモンドに遊びに来てね。思いっきり食べて、楽しんで帰ってもらえるように用意するから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060150
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 737060150,
					"content": "それは楽しみだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060151
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 737060151,
					"content": "フォンテーヌに行った時、輸入された蒲公英酒を飲んだんだ。あの香りと甘さは人を酔わせる。まったく渋みを感じなかったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060152
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 737060152,
					"content": "でも、容器の中が長旅で、味に若干影響が出てたんじゃないかと思うんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060153
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 737060153,
					"content": "モンドに着いたら、本場の純粋な蒲公英酒が飲めるってことだろ。何樽でも飲んでやる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060154
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 737060154,
					"content": "たまにはお酒以外のものも飲んだらどうですか？子供たちがくれた赤念の実の粉を入れたお茶とか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060155
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 737060155,
					"content": "は…ははは、キャンディス…その…あの、ちょっと味をみるだけだ。五杯程度しか入らねぇ…小さな樽もあるだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060156
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 737060156,
					"content": "本当にモンドに遊びに行ったら、必ず土産を買って帰るから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060157
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 737060157,
					"content": "西風騎士団の図書館には、十数万冊の本があるそうじゃのう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060158
					],
					"speakerTitle": "ファルザン"
				},
				{
					"id": 737060158,
					"content": "異なる視点から装置の技術的問題を分析している古書もあるやもしれん。読んでみる価値はありそうじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060159
					],
					"speakerTitle": "ファルザン"
				},
				{
					"id": 737060159,
					"content": "具体的な数字はわからないけど、図書館はすっごく広いよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060160
					],
					"speakerTitle": "アンバー"
				},
				{
