			"dialogs": [
				{
					"id": 711215101,
					"content": "ど、どうか命だけはお助けを！彼らとは何の関係もないんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711215102
					],
					"speakerTitle": "変わった商人"
				},
				{
					"id": 711215102,
					"content": "#{M#君}{F#あなた}は何者？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711215103
					]
				},
				{
					"id": 711215103,
					"content": "わ…私は…えっと、話せば長くなるんだが…彼らがいくつか物を盗んで、私はその持ち主に頼まれて届け出を出し、持ち主に返すことになった、それだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711215104
					],
					"speakerTitle": "変わった商人"
				},
				{
					"id": 711215104,
					"content": "まあ、盗人は君たちが追っ払ってくれたことだし、もうここに用はないよ。それじゃ、お先に失礼させてもらおう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711215105
					],
					"speakerTitle": "変わった商人"
				},
				{
					"id": 711215105,
					"content": "待って…！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711215106
					]
				},
				{
					"id": 711215106,
					"content": "気にしないで。どのみちまた会う機会があるだろうからさ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "変わった商人"
				}
			]
