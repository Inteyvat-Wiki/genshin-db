			"dialogs": [
				{
					"id": 711210201,
					"content": "心から感謝するよ！やれやれ、君たちが助けてくれなかったら、私の荷物はごっそりなくなるところだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210202
					],
					"speakerTitle": "変わった商人"
				},
				{
					"id": 711210202,
					"content": "手持ちは少ないが、これをお礼として受け取ってくれ。さ、遠慮せずに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210203
					],
					"speakerTitle": "変わった商人"
				},
				{
					"id": 711210203,
					"content": "おいおい、別にいいって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711210204,
					"content": "ははっ、ではこれにて失礼。またどこかで会おう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "変わった商人"
				}
			]
		},
		{
