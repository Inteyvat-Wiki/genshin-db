					"変わった商人"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711210301,
					"content": "ど、どうか命だけはお助けを…って、あれ？君たちじゃないか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210302
					],
					"speakerTitle": "変わった商人"
				},
				{
					"id": 711210302,
					"content": "あの時の！？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711210303
					]
				},
				{
					"id": 711210303,
					"content": "へへっ、これは奇遇だなぁ…はは、私のことはお構いなく、失礼するよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210304
					],
					"speakerTitle": "変わった商人"
				},
				{
					"id": 711210304,
					"content": "彼らがどんなお宝を残したのか確認するといい。ああ…私のことは心配しないでくれ、届け出を出したからね…返すべきものは私の手で返すよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210305
					],
					"speakerTitle": "変わった商人"
				},
				{
					"id": 711210305,
					"content": "待って…！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711210306
					]
				},
				{
					"id": 711210306,
					"content": "気にしないで。どのみちまた会う機会があるだろうからさ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "変わった商人"
				}
			]
		},
