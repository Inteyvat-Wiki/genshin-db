						],
						"pointId": 17224
					}
				]
			},
			"dialogs": [
				{
					"id": 746960101,
					"content": "七七、何か思い出せたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960102
					],
					"speakerTitle": "ブラシーネ"
				},
				{
					"id": 746960102,
					"content": "うぅっ…ごめん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960103
					],
					"speakerTitle": "七七"
				},
				{
					"id": 746960103,
					"content": "謝らなくていい、大丈夫だぞ。パレ・メルモニアまではまだ距離があるから、もう少し歩いてみよう。もしかしたら、家がどこか思い出せるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960104
					],
					"speakerTitle": "ブラシーネ"
				},
				{
					"id": 746960104,
					"content": "見ろ、七七がいるぞ！一緒にいるのはメリュジーヌか。見たことない組み合わせだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746960105,
					"content": "あ！旅人、それと…パイ…パイモン…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960106
					],
					"speakerTitle": "七七"
				},
				{
					"id": 746960106,
					"content": "こんにちは。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960107
					]
				},
				{
					"id": 746960107,
					"content": "七七の知り合いか？よかった。私がルミドゥースハーバーの近くで捜査をしていた時に、この迷子を見かけて…迷子だよな？体型からして、人間の子供のはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960108
					],
					"speakerTitle": "ブラシーネ"
				},
				{
					"id": 746960108,
					"content": "七七は…えっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960109
					],
					"speakerTitle": "七七"
				},
				{
					"id": 746960109,
					"content": "#{M#俺}{F#私}たちの大切な友達だよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960110
					]
				},
				{
					"id": 746960110,
					"content": "そうそう！オイラたちはずっと前から知り合いの、仲良しの友達なんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746960111,
					"content": "おおっ、よく反応したな！もし七七が自分をキョンシーだって言ってたら、このメリュジーヌを怖がらせちゃうところだったぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746960112,
					"content": "ん…大切な友達…そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960113
					],
					"speakerTitle": "七七"
				},
				{
					"id": 746960113,
					"content": "ようやく手がかりが掴めたようだな。正直に言うと、私もここまでお手上げの状況に遭遇したのは初めてなんだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960114
					],
					"speakerTitle": "ブラシーネ"
				},
				{
					"id": 746960114,
					"content": "友達なら知ってると思うけど、彼女の記憶には少し問題があるようで、名前以外のことがなかなか思い出せないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960115
					],
					"speakerTitle": "ブラシーネ"
				},
				{
					"id": 746960115,
					"content": "七七はたまにこうなっちゃうんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746960116,
					"content": "かわいそうにな…私はひとまず、マレショーセ・ファントムに連れて行って保護するつもりでいた。そこへ向かう道中で彼女が少しでも記憶を取り戻せないか、様子を見つつな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960117
					],
					"speakerTitle": "ブラシーネ"
				},
				{
					"id": 746960117,
					"content": "きみたちは、彼女の家がどこにあるか知ってるか？教えてくれれば、私が直接送り届けよう。そのほうが色々と面倒事も省ける。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960118
					],
					"speakerTitle": "ブラシーネ"
				},
				{
					"id": 746960118,
					"content": "知ってはいるけど…えっと、ここからじゃさすがに遠すぎるぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746960119,
					"content": "遠…すぎ…？七七、ずっと仙霊について歩いてたら…ルミドゥースハーバーに着いた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960120
					],
					"speakerTitle": "七七"
				},
				{
					"id": 746960120,
					"content": "えっ？思い出したのか？じゃあ、さらに前のことは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960121
					],
					"speakerTitle": "ブラシーネ"
				},
				{
					"id": 746960121,
					"content": "その前は…白先生と一緒に遺…ん、遺…なんだっけ？患者さんのところに行って…薬草を採って、それから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960122
					],
					"speakerTitle": "七七"
				},
				{
					"id": 746960122,
					"content": "おっ、遺瓏埠のことか！？名探偵パイモンは、全部まるっとお見通しだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746960123,
					"content": "七七は白朮と一緒に遺瓏埠へ往診に行って、その辺りで薬草を採ってる時に迷子になった。で、たまたま出会った仙霊についていったら、ルミドゥースハーバーまで来ちゃったってわけだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746960124,
					"content": "ふふん、オイラ、旅人と一緒に『怪盗と名探偵』を読んでてよかったぜ。この程度の推理は朝飯前だぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746960125,
					"content": "あの物語、完全に作り話なんだけどね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960126
					]
				},
				{
					"id": 746960126,
					"content": "おおっ！確かに筋が通ってるな。それじゃ、私はすぐに出発して七七を遺瓏埠まで送るよ。白朮さんは七七の保護者なんだろ？きっとすごく心配しているはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960127,
						746960128
					],
					"speakerTitle": "ブラシーネ"
				},
				{
					"id": 746960127,
					"content": "確かバーベロスさんが待ってる人の中には…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960129
					]
				},
				{
					"id": 746960129,
					"content": "そうだ！うっかり忘れちゃうところだったぞ。おーい、バーベロス——いるか？聞こえてるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960130
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746960130,
					"content": "そう大声を出さずともよい。ずっとここにいたけど、おまえたちの会話を遮りたくなかっただけだよ。傾聴は優秀な占い師の本能だからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960131
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746960131,
					"content": "いわゆる仙霊の道案内も、ある種の運命の導きと言えるだろう。ヒヒッ…せっかくここまで来たんだ、ついでに「占い」なんてどうだい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960132
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746960132,
					"content": "うら…ない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960133
					],
					"speakerTitle": "七七"
				},
				{
					"id": 746960133,
					"content": "もう、待ってよ。バービー、そんな形式的な態度じゃ、子供が怖がっちゃうじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960134
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746960134,
					"content": "ちょっとどいて。よく見ててね…サプライズプレゼントは、こうやって渡すのが正解なの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960135
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746960135,
					"content": "コホン、小さな魔女会の七七ちゃん。私はあなたの盟友クレーのママで、この世界で一番すごい大魔女、アリスおばさんよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960136
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746960136,
					"content": "アリスおばさん、こんにちは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960137
					],
					"speakerTitle": "七七"
				},
				{
					"id": 746960137,
					"content": "本当に礼儀正しくて可愛い、いい子ね。さあ、大魔女が小さな魔女のために、サプライズで予言の儀式を行ってあげる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960138
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746960138,
					"content": "予言…儀式？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960139
					],
					"speakerTitle": "七七"
				},
				{
					"id": 746960139,
					"content": "そう！目の前にあるカードを見てみて。綺麗でしょ？どう？素敵じゃない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960140
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746960140,
					"content": "気に入った…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960141
					],
					"speakerTitle": "七七"
				},
				{
					"id": 746960141,
					"content": "よかった！それじゃあ、そこから一枚引いてね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960142
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746960142,
					"content": "ん…これで、いい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960143
					],
					"speakerTitle": "七七"
				},
				{
					"id": 746960143,
					"content": "もちろんだよ。ちゃんと協力してくれたご褒美に、そのカードはあなたにあげちゃう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960144
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746960144,
					"content": "…ありがとう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960145
					],
					"speakerTitle": "七七"
				},
				{
					"id": 746960145,
					"content": "さあ、バービー、あなたの休憩時間はもう終わりよ。七七ちゃんのために解読してあげて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960146
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746960146,
					"content": "肩を揺さぶるんじゃない…ちゃんと見ておるよ…ふむ、「吊された男」の正位置かい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960147
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746960147,
					"content": "それを引ける者はそう多くない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960148
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746960148,
					"content": "つまり、七七ちゃんはとっても特別な存在ってこと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960149
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746960149,
					"content": "超越と忍耐を象徴し、世俗からの超脱をも意味しておる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960150
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746960150,
					"content": "一定の制限の中におるが、おまえさん自身はそこから抜け出そうとは思っておらんようだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960151
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746960151,
					"content": "制限…勅令のこと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960152
					],
					"speakerTitle": "七七"
				},
				{
					"id": 746960152,
					"content": "表面的に言えば、その理解でも間違ってないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960153
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746960153,
					"content": "未来のことは、ただ待つだけでよい。当然、おまえさんにとって一番あり余っているのは時間だろう。だが…おや、こいつはおかしいね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960154
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746960154,
					"content": "はいはい、ストップ、ストップ！そんなに一気に喋ると、小さい子が疲れちゃうでしょ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960155
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746960155,
					"content": "まずは七七ちゃんに、このプレゼントをじっくり堪能してもらおうよ。子供にはもっと気長に、たっぷり時間を設けて接しなきゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960156
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746960156,
					"content": "ねえ、七七ちゃん。このささやかなサプライズ、喜んでもらえたかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960157
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746960157,
					"content": "カード、きれい…ありがとう、アリスおばさん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960158
					],
					"speakerTitle": "七七"
				},
				{
					"id": 746960158,
					"content": "あら、お利口さん。頑張っておばさんの名前を覚えてくれたの？本当はもっとあなたとお話ししたいけど、そろそろ時間ね。いい子はお家に帰らなくちゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960159
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746960159,
					"content": "バービー、もしまだ言いたいことがあれば、次に小さな魔女会が集まる時に、小さな魔女一人一人に予言をしてあげて！きっと、みんな喜ぶはずよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960160
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746960160,
					"content": "…勝手にわしの仕事を増やさないでくれないかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960161
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746960161,
					"content": "はい、決まり！それじゃまたね、七七ちゃんと立会人さんたち。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960162
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746960162,
					"content": "バイバイ…アリスおばさんと、アリスおばさんの…おともだち。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960163
					],
					"speakerTitle": "七七"
				},
				{
					"id": 746960163,
					"content": "ふぅ…話は終わったのかな？さっきの二人の声、このぬいぐるみから聞こえてたのか？これは新型のおもちゃか何か？すごく可愛い…どこで売って…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960164
					],
					"speakerTitle": "ブラシーネ"
				},
				{
					"id": 746960164,
					"content": "あっ！違う違う、そんなことを考えている場合じゃない。七七、白朮さんを探しに行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960165
					],
					"speakerTitle": "ブラシーネ"
				},
				{
					"id": 746960165,
					"content": "…うん、時間になった。七七、帰らないと。また今度…旅人、パイモン。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960166,
						746960167
					],
					"speakerTitle": "七七"
				},
				{
					"id": 746960166,
					"content": "またね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960168
					]
				},
				{
					"id": 746960168,
					"content": "カード…プレゼント、ん…きれい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "七七"
				},
				{
					"id": 746960167,
					"content": "気を付けて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960168
					]
				},
				{
					"id": 746960128,
					"content": "七七も含まれてたよね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960129
					]
				}
			]
		},
