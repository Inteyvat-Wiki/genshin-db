					{
						"sceneId": 3,
						"position": [
							4410.831,
							150.124,
							4633.232
						],
						"pointId": 6132
					}
				]
			},
			"dialogs": [
				{
					"id": 140040801,
					"content": "おーい、帽子を持ってきたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040802
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140040802,
					"content": "本当か？ありがとう！すぐ出るから待っててくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040803
					],
					"speakerTitle": "フェソレ"
				},
				{
					"id": 140040803,
					"content": "うーん…えっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040804
					],
					"speakerTitle": "フェソレ"
				},
				{
					"id": 140040804,
					"content": "なんだ、ちゃんと髪の毛あるんじゃんかよ。しかも、フサフサだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040805
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140040805,
					"content": "はぁ、やっぱり誤解してる気がしたよ。そんな理由のわけないだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040806
					],
					"speakerTitle": "フェソレ"
				},
				{
					"id": 140040806,
					"content": "あれ、これ僕がなくした帽子じゃないんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040807
					],
					"speakerTitle": "フェソレ"
				},
				{
					"id": 140040807,
					"content": "おまえの言ってた帽子がどうしても見つからなかったから、新しいのを買ってきたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040808
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140040808,
					"content": "正確には「もらった」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040809
					]
				},
				{
					"id": 140040809,
					"content": "そうだったのか…わざわざありがとう。でも申し訳ないが、僕はあの帽子じゃないとダメなんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040810
					],
					"speakerTitle": "フェソレ"
				},
				{
					"id": 140040810,
					"content": "もしかして、思い出の品だったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040811
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140040811,
					"content": "それは、えっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040812
					],
					"speakerTitle": "フェソレ"
				},
				{
					"id": 140040812,
					"content": "ごめん、僕にも上手く説明できなくって。時間が惜しいから、周りを探してみるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040813
					],
					"speakerTitle": "フェソレ"
				},
				{
					"id": 140040813,
					"content": "帽子ならさっき下で拾ったが、これはあんたのかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040814
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140040814,
					"content": "公爵様！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040815
					],
					"speakerTitle": "フェソレ"
				},
				{
					"id": 140040815,
					"content": "あっ、リオセスリ。久しぶりだな。なにしてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040816
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140040816,
					"content": "今日は特に用事がなくて、監獄内を見て回ってたんだ。俺の執務室は広いが、長く居すぎるとやはり少し窮屈でな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040817
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140040817,
					"content": "あんたらは相変わらずのようだ。助けを必要とする人がいれば、どんな些細なことでも首を突っ込む。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040818
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140040818,
					"content": "これぞ冒険者の精神ってやつだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040819
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140040819,
					"content": "ほう、メロピデ要塞にも、ぜひ支部を設立してほしいもんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040820
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140040820,
					"content": "あんたら「制帽の会」にとって、帽子は大事なもんだろ？不用意に失くすのはよくないんじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040821
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140040821,
					"content": "次また、こんな幸運に恵まれるとは限らないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040822
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140040822,
					"content": "分かりました。あ、ありがとうございます、公爵様…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040823
					],
					"speakerTitle": "フェソレ"
				},
				{
					"id": 140040823,
					"content": "そ、それでは僕は、えっと、お…お先に失礼します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040824
					],
					"speakerTitle": "フェソレ"
				},
				{
					"id": 140040824,
					"content": "変なやつだったな。なんであんなに困ってたのか、結局わからなかったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040825
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140040825,
					"content": "もしかして、やましいことでもしてるのかな？どうしておまえを見た途端、あんなにビクビクしはじめたんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040826
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140040826,
					"content": "まさか、その逆さ。「制帽の会」のやつらはトラブルを起こすこともなく、積極的に労働に励んでる。むしろ、俺は安心してるほどだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040827
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140040827,
					"content": "あいつはただ、内向的だっただけだろう。いきなり俺が目の前に現れて、緊張したんじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040828
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140040828,
					"content": "えっ？内向的…？内向的な犯罪者なんているのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040829
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140040829,
					"content": "地上には罪が幾千とあり、犯罪者の動機も幾千とある。「犯罪者」っていうのは、ただのレッテルに過ぎない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040830
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140040830,
					"content": "「悪」も、「暴虐」も、「利己」も…いずれも複雑な人間性を表現するには不十分なもんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040831
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140040831,
					"content": "彼がどんな人間で、どうして犯罪者になったのか…彼の物語を知らない限り、分かるすべなどないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040832
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140040832,
					"content": "なるほどな。おまえが気にしないなら、別にいいけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040833,
						140040834
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140040833,
					"content": "「制帽の会」って？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040835
					]
				},
				{
					"id": 140040835,
					"content": "ああ、そういった類の組織は、大半が犯罪者同士のいざこざを集団乱闘へと変えるだけのもんだったが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040836
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140040836,
					"content": "「制帽の会」は違ってな。あいつらは斬新で面白いことを試みてる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040837
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140040837,
					"content": "今、時間はあるか？特別許可食堂に行こう。ちょうど、あんたらとおしゃべりしたかったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040838
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140040838,
					"content": "その話の後、もし興味が湧いたのなら、「制帽の会」のラウンジに連れていってやろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040839
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140040839,
					"content": "あの食堂にはあんまりいい印象がないけど…まあ、どうせすることもないし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040840
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140040840,
					"content": "行こう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040841
					]
				},
				{
					"id": 140040841,
					"content": "ああ。じゃあ、付いてきてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140040834,
					"content": "真面目に働く人もいるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040835
					]
				}
			]
		},
		{
			"id": 1400409,
			"completionStepIds": [
				1400409
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1400409",
							"2"
						],
						"stepId": 1400409,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"リオセスリ"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							4486.272,
							121.6,
							4595.675
						],
						"pointId": 5211
					},
					{
						"sceneId": 3,
						"position": [
							4485.177,
							121.596,
							4596.509
						],
						"pointId": 6133
					},
					{
						"sceneId": 3,
						"position": [
							4483.128,
							121.648,
							4596.076
						],
						"pointId": 6135
					}
				]
			},
			"dialogs": [
				{
					"id": 140040901,
					"content": "これは公爵様に旅人じゃないか。ようこそ、特別許可食堂へ。本日のサービス食を食べに来たのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040902
					],
					"speakerTitle": "ウォルジー"
				},
				{
					"id": 140040902,
					"content": "ただ、公爵様には先に断っとくが、スペシャルサービス食は今日用意してなくってな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040903
					],
					"speakerTitle": "ウォルジー"
				},
				{
					"id": 140040903,
					"content": "俺は必要ない。あんたらは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040904,
						140040905
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140040904,
					"content": "お腹は空いてない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040906
					]
				},
				{
					"id": 140040906,
					"content": "オ…オイラも大丈夫だ。もっと美味しいもんのために、お腹は空けておきたいからな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040907
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140040907,
					"content": "残念ながら、みんなあんたの腕を買ってないようだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040908
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140040908,
					"content": "ははっ、だったら公爵様、どうにかして食材の種類を増やしてくれないか。じゃなきゃ、レパートリーも増やしようがない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040909
					],
					"speakerTitle": "ウォルジー"
				},
				{
					"id": 140040909,
					"content": "食べ物がいらないなら、飲み物を用意しよう。どれも仕入れたばかりのいいもんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040910
					],
					"speakerTitle": "ウォルジー"
				},
				{
					"id": 140040910,
					"content": "おっ、それならいいな！ここってサービス食しかないのかと思ったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040911
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140040911,
					"content": "普通の人には出してないからな。これは特別待遇だ——公爵様とお前さんたちだけのな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040912
					],
					"speakerTitle": "ウォルジー"
				},
				{
					"id": 140040912,
					"content": "へへっ、オイラ特別待遇って大好きだぞ。じゃあ、オイラの分は二つくれ、それくらい余裕で飲めそうだからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040913
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140040913,
					"content": "ああ、ちょっと待っててくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040914
					],
					"speakerTitle": "ウォルジー"
				},
				{
					"id": 140040914,
					"content": "しばらくして…ウォルジーが飲み物を持ってきてくれた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						140040915
					]
				},
				{
					"id": 140040915,
					"content": "前回、あんたらと会った時は少々慌ただしかった。あの後も色々あったせいで、こうして個人的に話す時間は作れずにいただろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040916
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140040916,
					"content": "俺は物語を聞くのが大好きでな。あんたらがフォンテーヌで活躍した物語を耳にしてから、実際の状況がどんなもんだったのか聞きたかったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040917
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140040917,
					"content": "えっと、それを話すと長くなるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040918,
						140040921,
						140040924
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140040918,
					"content": "義を以って戦いに身を投じ、人を救った。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040919
					]
				},
				{
					"id": 140040919,
					"content": "悪くない。危険な騒動に身を投じる勇気を持ちながら、命を捨てることなく撤退する判断力も備えてる。これは誰にでもできることじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040920
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140040920,
					"content": "あんたらがそういう稀有な品格を持っていなかったら、俺は二人と知り合う機会も得られなかっただろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040927
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140040927,
					"content": "…なにを言ってもいいように捉えそうだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040928
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140040928,
					"content": "さっき帽子をくれたやつは、オイラたちに媚びを売りたいって隠さずに言ってくれたけど…おまえはここの「公爵」だし、そんなことする理由なんてないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040929
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140040929,
					"content": "いいや、あんたらはメロピデ要塞を救い、俺がこれからもここで愉快に過ごせるようにしてくれた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040930
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140040930,
					"content": "単純に敬服してるだけさ。あんたらに見合った賛辞を贈ってるんだ。それの何がおかしい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040931,
						140040932
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140040931,
					"content": "正直言って、ちょっと変。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040933
					]
				},
				{
					"id": 140040933,
					"content": "なるほど、信頼感が原因ってわけか。仕方ないだろ、俺のやってきたことはどれも小さなことばかりだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040934
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140040934,
					"content": "俺は早くに犯罪者となり、この地へ流された。長くもがき続けたことで、やっとここのボスになったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040935
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140040935,
					"content": "あらゆる手段を使ってきた。まともなものもあれば、口にするのが憚られるものもある。だが、ここでは罪が科せられることはない。ただ勝者のみが王となる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040936
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140040936,
					"content": "どうだ。こんなことを知っても、別に信頼感を高めることはできないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040937
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140040937,
					"content": "そうだな。それにおまえって、これまで会ってきたやつとちょっと違う気がするぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040938
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140040938,
					"content": "ははっ、その点についちゃ俺も自覚してる。だが、それでも俺があんたらを見る目に変わりはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040939
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140040939,
					"content": "——この友好な関係を、ぜひとも維持していこうじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040940,
						140040941
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140040940,
					"content": "#{M#俺}{F#私}も同じ気持ち。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040942
					]
				},
				{
					"id": 140040942,
					"content": "公爵様——ご指示の通り、やはり荷物の山から申告されていない禁制品が一箱見つかりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040943
					],
					"speakerTitle": "グーレイ"
				},
				{
					"id": 140040943,
					"content": "とても巧妙に隠されていたことから、これは初犯ではないでしょう。現在、荷物のルートを調べています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040944
					],
					"speakerTitle": "グーレイ"
				},
				{
					"id": 140040944,
					"content": "ああ、そうか。進捗があったらまた知らせろ。とりあえず物を置いて、先に戻っていてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040945
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140040945,
					"content": "はっ、公爵様。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040946
					],
					"speakerTitle": "グーレイ"
				},
				{
					"id": 140040946,
					"content": "すまないな、この件を忘れるところだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040947
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140040947,
					"content": "禁制品ってなんだ？危ないもんじゃないだろうな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040948
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140040948,
					"content": "通常であれば、そういったもんじゃない。禁制品とは、一般的に秘密裏に持ち込まれた荷物のことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040949
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140040949,
					"content": "だが、犯罪者どもの多くは何かしら飛び抜けた特技を持ってる。何の変哲もない物が突如として別のもんに化けるかもしれない。だから、物資の管理は特に注意が必要でな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040950
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140040950,
					"content": "どれ…ふむ、だいたい予想してた通りか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040951
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140040951,
					"content": "おお～、モラにお菓子、毛糸玉、ロープ、機械の部品、それに宝石まであるぞ！大漁だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040952
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140040952,
					"content": "待った。おまえが没収したってことは、つまり…これって、全部おまえのものになるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040953
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140040953,
					"content": "ああ、他に処理する方法もないしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040954
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140040954,
					"content": "それってボロ儲けじゃないか！？旅人、おまえもどっかの「公爵」になってくれよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040955,
						140040957
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140040955,
					"content": "じゃあ、パイモンは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040956
					]
				},
				{
					"id": 140040956,
					"content": "オイラは倉庫管理員だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040959
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140040959,
					"content": "そこまで気に入るとは思わなかった。こうしよう…この中から一つ、好きなものを選んでくれ。あんたへのプレゼントだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040960
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140040960,
					"content": "本当か？どれでもいいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040961
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140040961,
					"content": "後悔するなよ。オイラ、遠慮しないからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040962
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140040962,
					"content": "こんなことで冗談を言うわけもないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040963
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140040963,
					"content": "じゃあ…えーっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040964
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140040964,
					"content": "これだ！この黒い宝石。一目見て高級品だってわかるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040965
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140040965,
					"content": "うっ…うぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040966
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140040966,
					"content": "や、やっぱやめた…別のにする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040967,
						140040968
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140040967,
					"content": "どうしたの、パイモン？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040969
					]
				},
				{
					"id": 140040969,
					"content": "この石、変だぞ…持ってると嫌なことをいろいろ思い出すんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040970
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140040970,
					"content": "自分の意思とは関係なしに、嫌な気持ちがどんどんと湧いてくる…これ、すっごく怪しいぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040971
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140040971,
					"content": "そりゃ妙だな。俺にも見せてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040972
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140040972,
					"content": "ふむ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040973
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140040973,
					"content": "パイモンの言う通りだ。俺も不愉快な思い出が蘇ってきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040974
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140040974,
					"content": "#{M#俺}{F#私}にも試させて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040975
					]
				},
				{
					"id": 140040975,
					"content": "いいのか？この体験はあまり気持ちのいいもんじゃないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040976,
						140040977
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140040976,
					"content": "みんなと同じ情報を共有したい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040978
					]
				},
				{
					"id": 140040978,
					"content": "なるほどな。じゃあ、試してみるといい。身体そのものに悪影響はないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040979
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140040979,
					"content": "！！！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040980
					]
				},
				{
					"id": 140040980,
					"content": "どうだ？おまえもなにか見えたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040981,
						140040982
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140040981,
					"content": "うん、確かに二人の言う通りだった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040983
					]
				},
				{
					"id": 140040983,
					"content": "この宝石は俺が預かろう。あとでじっくり調べてみる。パイモン、別のを選んでくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040984
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140040984,
					"content": "じゃあ…うぅ、やっぱやめとく。お菓子にしようかと思ったけど、もう怖くて食べられないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040985,
						140040986
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140040985,
					"content": "同感。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040987
					]
				},
				{
					"id": 140040987,
					"content": "ああ、それがいい。念のため、箱の中身はすべて処分しておこう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040988
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140040988,
					"content": "ちょうど飲み物も空になる。次は「制帽の会」を案内しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040989
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140040989,
					"content": "紹介ついでに、話も続けられるしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040990
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140040990,
					"content": "毎日、こんなに暇ってわけじゃないんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040991
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140040991,
					"content": "はっ、今さらそれを聞くのか？最初に出会った時も、こんな感じだっただろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140040986,
					"content": "用心に越したことはない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040987
					]
				},
				{
					"id": 140040982,
					"content": "少なくとも…印象深い記憶だった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040983
					]
				},
				{
					"id": 140040977,
					"content": "#{M#俺}{F#私}の体質は特別だから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040978
					]
				},
				{
					"id": 140040968,
					"content": "どこか具合悪いの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040969
					]
				},
				{
					"id": 140040957,
					"content": "#「公爵」の称号はもう{M#俺}{F#私}のもの。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040958
					]
				},
				{
					"id": 140040958,
					"content": "ほう？さっき平和的な付き合いに頷いたばかりなのに、もう俺の座を奪う気か。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040959
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140040941,
					"content": "ありがとう。でも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040942
					]
				},
				{
					"id": 140040932,
					"content": "#{M#君}{F#あなた}は自分のことをあんまり話してない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040933
					]
				},
				{
					"id": 140040921,
					"content": "この国について少しずつ分かってきた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040922
					]
				},
				{
					"id": 140040922,
					"content": "なるほど、確かに旅人らしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040923
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140040923,
					"content": "旅の見聞を記録し、人脈を築き上げていく。あんたの「視野の広さ」と「恵まれた機会」はあらゆる人を超えてるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040927
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140040924,
					"content": "#どれも{M#俺}{F#私}とはあんまり関係ない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040925
					]
				},
				{
					"id": 140040925,
					"content": "くくっ、そりゃ謙遜がすぎる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040926
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140040926,
					"content": "あんたの何気ない行動が新たな変化をもたらし、定められた運命を変えた可能性だってある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040927
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 140040905,
					"content": "スペシャルがないなら大丈夫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040906
					]
				}
			]
		},
