			},
			"dialogs": [
				{
					"id": 140040201,
					"content": "「メロピデ要塞」って怖いところだと思ってたけど、雰囲気を見るとそんなに悪くないところだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140040202,
					"content": "生活が安定してて、毎日ちゃんとごはんが食べられる。それに「特別許可券」でいろんなものだって買えるし！どうりで囚人の大半がここを離れたがらないわけだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040203,
						140040204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140040203,
					"content": "確かに。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040205
					]
				},
				{
					"id": 140040205,
					"content": "あっ、リオセスリのことだろ。オイラも、あいつの腕は超一流だと思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140040206,
					"content": "見た目はイカついけど、実際に話してみると結構話しやすい感じがするし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140040207,
					"content": "あいつって、監獄のやつらとはどんな感じで接してるんだろう？もしかして、接する相手によって振る舞い方を変えてたりするのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140040208,
					"content": "何かしらの「手段」を持ってるんだと思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040209
					]
				},
				{
					"id": 140040209,
					"content": "だな。ここの人にルールを守らせながらも、過剰に縛り付けてもない。そんなふうに管理できるあいつは、独自のノウハウを持ってるんだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140040210,
					"content": "おーい、誰か手を貸してくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040211
					],
					"speakerTitle": "フェソレ"
				},
				{
					"id": 140040211,
					"content": "あれ？今なんか声が聞こえなかったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140040212,
					"content": "#{M#俺}{F#私}も聞こえた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040213
					]
				},
				{
					"id": 140040213,
					"content": "すまない、誰かいないか？手伝ってほしいことがあるんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040214
					],
					"speakerTitle": "フェソレ"
				},
				{
					"id": 140040214,
					"content": "やっぱり！聞き間違えじゃないぞ。この辺りからだ！でも人の姿は見当たらないな…どういうことだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040215
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140040215,
					"content": "あっ、誰か聞こえてるのか？おーい、こっちだ。箱の中だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040216
					],
					"speakerTitle": "フェソレ"
				},
				{
					"id": 140040216,
					"content": "箱？だから姿が見えなかったのか。よし、見に行ってみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040217
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140040217,
					"content": "なんで箱の中なんかに隠れてるんだよ？誰も通りかからなかったら、いくら叫んでも意味ないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140040218,
					"content": "えっと、ちょっとわけがあってね。そこは聞かないでもらえるかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040219,
						140040220
					],
					"speakerTitle": "フェソレ"
				},
				{
					"id": 140040219,
					"content": "眉毛を剃られたとか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040221
					]
				},
				{
					"id": 140040221,
					"content": "うわっ、ひどいな。おまえ、いじめられてるのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040222
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140040222,
					"content": "いやいや、そこまでのことじゃないけど…ただ、誰かに僕の帽子を探してきてほしくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040223
					],
					"speakerTitle": "フェソレ"
				},
				{
					"id": 140040223,
					"content": "帽子を？でも、なんでわざわざ隠れなきゃいけないんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040224
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140040224,
					"content": "あっ、わかった！おまえって髪の毛が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040225,
						140040226
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140040225,
					"content": "パイモン、それ以上は言わないであげて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040227
					]
				},
				{
					"id": 140040227,
					"content": "あっ、ごめんごめん。なるほど、そういうことだったのか。へへっ、だから顔を見せてくれないんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040228
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140040228,
					"content": "帽子か…よし、すぐ見つけてきてやるぞ。どんなやつなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040229
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140040229,
					"content": "な、なんだか誤解してる気もするけど…まあ、帽子を取り戻せるならいっか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040230
					],
					"speakerTitle": "フェソレ"
				},
				{
					"id": 140040230,
					"content": "つばのついた柔らかい帽子でね。色は茶色、デザインは割と普通のものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040231
					],
					"speakerTitle": "フェソレ"
				},
				{
					"id": 140040231,
					"content": "たぶん入口のリフト近くで落としたんだと思う。ちょっと暑かったから、帽子を脱いでしばらく休んでたんだ。でも、気づいたらなくなってて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040232
					],
					"speakerTitle": "フェソレ"
				},
				{
					"id": 140040232,
					"content": "頼む。あの帽子は僕にとってとても大事なものなんだ。僕はここで待ってるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040233
					],
					"speakerTitle": "フェソレ"
				},
				{
					"id": 140040233,
					"content": "安心しろ、さくっと行ってくるぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140040226,
					"content": "パイモン、空気を読もう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040227
					]
				},
				{
					"id": 140040220,
					"content": "服を破られたとか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040221
					]
				},
				{
					"id": 140040204,
					"content": "たぶん、これがあの人の管理スタイル。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040205
					]
				}
			]
		},
