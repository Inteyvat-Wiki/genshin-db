			"dialogs": [
				{
					"id": 140040501,
					"content": "水にも落ちてない。風に飛ばされて落ちたのかと思ったけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140040502,
					"content": "う～ん、どこに落ちてるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040503,
						140040504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140040503,
					"content": "諦めよう、ここは広すぎる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040505
					]
				},
				{
					"id": 140040505,
					"content": "それもそうだな。ハゲを見られたくないだけなら、帽子があればいいし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040506
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140040506,
					"content": "よーし、それじゃあ「ラグ＆ボーンショップ」に行ってみようぜ。たしかあそこって、いろんな物が売ってただろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040507,
						140040509
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140040507,
					"content": "お店に行くだけなのにテンション高くない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040508
					]
				},
				{
					"id": 140040508,
					"content": "へへっ、ついでに他の物も買えるからな。せっかくだし、いいだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040512
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140040512,
					"content": "とりあえず、お店に行ってみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140040509,
					"content": "…先に言っておくけど、帽子だけだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040510
					]
				},
				{
					"id": 140040510,
					"content": "えっ？なんでオイラの考えてることがわかったんだ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040511
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140040511,
					"content": "はぁ…おまえ、どんどんイジワルになってくよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040512
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140040504,
					"content": "買いに行ったほうがはやい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040505
					]
				}
			]
		},
