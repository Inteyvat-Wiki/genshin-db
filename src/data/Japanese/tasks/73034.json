			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730340201,
					"content": "ん？なにしてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730340202,
					"content": "このノートに花の世話の仕方が書いてある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730340203
					]
				},
				{
					"id": 730340203,
					"content": "本当か？オイラにも見せてくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730340204,
					"content": "「…日当たりのよい、広い場所に置く必要がある…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730340205,
					"content": "コレイには、それを外に運ぶ暇がなかったみたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730340206,
					"content": "へへっ、コレイの代わりに、この花を世話しようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730340207,
					"content": "うーん…とりあえず、この花を外に運んで、家の横に置こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730340208,
					"content": "あんまり遠くに運ばないようにな。じゃないと、コレイが帰ってきたときに花が見つからなくて焦るかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7303406,
			"completionStepIds": [
				7303406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7303406",
							"2"
						],
						"stepId": 7303406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730340601,
					"content": "あれ？この手紙…コレイが残したものみたいだ。確認してみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340602
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730340602,
					"content": "でも、人はいないみたい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730340603
					]
				},
				{
					"id": 730340603,
					"content": "またティナリと一緒に仕事してるんじゃないか？あいつら、ずっと忙しそうだったしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730340604,
					"content": "それより、手紙の内容を見てみようぜ。この筆跡、コレイは力を込めて書いたみたいだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340605
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730340605,
					"content": "#「{NICKNAME}にパイモン、花の世話をしてくれて、ありがとう。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340606
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730340606,
					"content": "「最近は森での仕事が多すぎて…忙しくなると、つい花の世話を忘れてしまうんだ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340607
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730340607,
					"content": "「手伝ってくれて、本当にありがとう。時間ができたら、一緒にジャハンギルさんの店で『ポテトボート』を食べよう！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340608
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730340608,
					"content": "おお！見てみろ、コレイがオイラたちにご馳走してくれるって言ってるぞ！これはメモしておかないとな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340609
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730340609,
					"content": "でも、コレイは一体なにをやってるんだろう…忙しくて色々と手が回ってないみたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340610
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730340610,
					"content": "疲れを溜めないように、ちゃんと休んでるといいんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
}