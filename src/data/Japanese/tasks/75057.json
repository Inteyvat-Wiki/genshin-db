			"dialogs": [
				{
					"id": 750013201,
					"content": "本当に成功するとは…まるで「物語」の場面が現実になったようだ。素晴らしい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013202
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750013202,
					"content": "騒々しい音も静まり…小さな「陰縫いの針」は再び元の姿を取り戻した。しかしあれほど巨大なものが「ドスン」と下に落ちるとは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013203
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750013203,
					"content": "ああ…まさか本当にやってのけるとは…これは夢か？君たちは実在するのか？まさか私の妄想じゃないだろうな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013204
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750013204,
					"content": "#{M#夢は覚めた}{F#夢は覚めたよ}…{M#あとは自分でなんとかして}{F#あとは自分でなんとかしてね}！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750013205
					]
				},
				{
					"id": 750013205,
					"content": "おいおい、ひどいこと言うなよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750013206,
					"content": "#どうだ！言っただろ？{NICKNAME}はすごいって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750013207,
					"content": "キュイッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013208
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013208,
					"content": "#へへっ、{REALNAME[ID(2)|SHOWHOST(true)]}もすごいって思っただろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750013209,
					"content": "#{NICKNAME}、素晴らしき異邦の勇士よ。君はアビスの影響を受けていないな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013210,
						750013211
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750013210,
					"content": "平気だよ、アビスなんて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750013212
					]
				},
				{
					"id": 750013212,
					"content": "#部族で最強とうたわれる勇士ですら、アビスと対峙する際は十二分に気を引き締める必要があるというのに…やはり{NICKNAME}はただ者ではないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013213
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750013213,
					"content": "今回のことを題材に執筆すれば、サンハジが記録した物語よりも素晴らしいものができあがるだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013214
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750013214,
					"content": "キュウ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013215
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013215,
					"content": "サンハジが誰なのかわからないけど、すごい人なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750013216,
					"content": "はは！すべての「部族の語り部」にとって、謎煙の主のサンハジは尊敬に値する人物だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013217
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750013217,
					"content": "だが今は差し迫った状況だ。こんど時間ができたらサンハジの物語を教えてやろう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013218
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750013218,
					"content": "よし。では次の浮上した「陰縫いの針」のもとへ向かおう。急ぎ問題を解決すれば、今夜にも執筆に取りかかれる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013219
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750013219,
					"content": "出発だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013220
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750013220,
					"content": "キュイッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013211,
					"content": "今のところはなんとも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750013212
					]
				}
			]
		},
		{
			"id": 7505704,
			"completionStepIds": [
				7505702
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7505702",
							"2"
						],
						"stepId": 7505702,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7500107",
							"2"
						],
						"stepId": 7500107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750010801,
					"content": "ふむ、恐ろしい物音が聞こえたから少々様子を見に来てみれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010802
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750010802,
					"content": "「余計な事を考えるなティトゥ、大したことない」…ここへ来るまで自分にそう言い聞かせていたというのに、実際にはこれほど大変なことが起こっていたとはな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010803
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750010803,
					"content": "キュイッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010804
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010804,
					"content": "こんなところに小さなテペトル竜が…君がこの二人の異邦人をここへ導いたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010805
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750010805,
					"content": "それに、この「陰縫いの針」は…まさか君たちが地面へ押し込んだのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010806,
						750010809
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750010806,
					"content": "もしかして…穴を開けちゃいけなかった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010807
					]
				},
				{
					"id": 750010807,
					"content": "#え？なぁ{NICKNAME}、オイラたちまずいことしちゃったんじゃ…なら目撃者が一人しかいない今のうちに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010808
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750010808,
					"content": "#ははっ、怖いことを言ってくれるな。それはさほど深刻な問題ではないし、むしろ助かったくらいだ。ところで、そこの{M#少年}{F#少女}が{NICKNAME}なのはわかったが、君はなんという名前だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010813
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750010813,
					"content": "キュイッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010814
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010814,
					"content": "#この子は{REALNAME[ID(2)|SHOWHOST(true)]}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010815
					]
				},
				{
					"id": 750010815,
					"content": "うむ、私の名はティトゥ、部族で物語を伝{RUBY#[S]語り部}える者だ。そして谷間にあるこの石柱たちを「見守って」いる存在でもある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010816
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750010816,
					"content": "君たちが穴を開けたこの石柱は、三本ある小さな「陰縫いの針」のうちの一本で、私の監視対象なのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010817
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750010817,
					"content": "か、監視…やっぱりオイラたちがあの石柱とかいうのをいじると、ナタの人たちが損害賠償を求めてくるんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010818
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750010818,
					"content": "うう…そうだって知ってたら本名を明かさなかったのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010819
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750010819,
					"content": "賠償か…「ティトゥは、このような方法で目の前の人物を脅迫すれば、目的を達成できるかもしれないと思いついた…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010820
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750010820,
					"content": "そういう展開だとすれば、このような描写を挟むべきだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010821
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750010821,
					"content": "キュ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010822
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010822,
					"content": "ああ、すまない。つい物語のことを考えていた。私は部族で昔話を{RUBY#[D]語り部}伝えるのを任されていて、何年も物語を語り続けてきたのだよ。しかし最近は、自分で新しい物語を考える必要が出てきてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010823
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750010823,
					"content": "ここ数日、常にその事で悩んでいたところ「陰縫いの針」にも問題が生じてしまった。古い言葉にあるように、本当に人が不運だと竜も不運になるのだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010824
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750010824,
					"content": "コホン…別に君たちを脅迫するつもりなどない。もし本当にそのつもりなら、頭の中で考えているフレーズをわざわざ口に出したりしないだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010825
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750010825,
					"content": "この状況を見てくれ。互いに名乗り合っても揉め事は起きていない。つまり私たちはすでに友人同士ということではないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010826
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750010826,
					"content": "それで、その友人の頼みを少しばかり聞いてもらえないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010827
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750010827,
					"content": "ば…賠償を求められるんじゃなければ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010828
					]
				},
				{
					"id": 750010828,
					"content": "もちろんそのようなことはしない。どこから話すべきか…そうだな、君たちは谷を通り抜けるとき、金色の模様が刻まれた巨大な固体燃素の塊を見なかったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010829
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750010829,
					"content": "このエリアの中心にあるから、見逃すことはないと思うが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010830,
						750010831
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750010830,
					"content": "あるような…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010833
					]
				},
				{
					"id": 750010833,
					"content": "私が言わんとしていたのは、その大石柱に関係することだ…あの大石柱は部族の人々に「陰縫いの針」と呼ばれているのだが、最近いくつか問題が生じていてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010834
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750010834,
					"content": "正直なところ君たちに会う前は、大石柱のことはもう諦めようと思っていたのだ。「『陰縫いの針』の問題が解決できなかったら、災難で部族が滅ぶ物語を書いても構わないのだから…」と自分自身に言い聞かせていたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010835
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750010835,
					"content": "待てよ…ただの石柱がどうして部族が滅びるのと関係があるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010836
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750010836,
					"content": "それにさっきから言ってる「陰縫いの針」や、オイラたちが穴を開けた小さな「陰縫いの針」って、どっちも大石柱のことだよな。なんでそんな呼び方をしてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010837
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750010837,
					"content": "キュ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010838
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010838,
					"content": "#ああ、{NICKNAME}とパイモンは異邦人だから、もっと詳しく説明しなければならないな。これは部族に伝わる伝説に関係しているのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010839
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750010839,
					"content": "物語によると、大霊が「陰縫いの針」をここに吊るしたのは火山大王の陰を縫い付けるためだという…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010840
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750010840,
					"content": "しかし真の歴史はこうだ。「あの柱の下にはこの地のアビスが封印されている」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010841
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750010841,
					"content": "ナタの物語はほとんどがそうだ。警告のために語られ、レトリックとメタファーで装飾されている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010842
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750010842,
					"content": "待てよ！下にいるのは封印されたアビスだって！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010843
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750010843,
					"content": "そうだ。そして最近、三本の小さな「陰縫いの針」のうち二本が浮上した。もし三本目の柱も浮き上がれば、底にある不吉なものが潮のように押し寄せてくるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010844
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750010844,
					"content": "だから予想外に、君たちがその一本を押し込んだのを見て喜んだのだ。もちろん君たちに賠償を求めるつもりなどない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010845
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750010845,
					"content": "その代わりと言ってはなんだが、もう一本の小さな「陰縫いの針」も押し込んではくれないだろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010846
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750010846,
					"content": "#うーん…どうする、{NICKNAME}…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010847,
						750010848
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750010847,
					"content": "…アビスのことなら、放っておけない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010849
					]
				},
				{
					"id": 750010849,
					"content": "キュイッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010850
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010850,
					"content": "#わかった。{REALNAME[ID(2)|SHOWHOST(true)]}も賛成してるみたいだしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010851
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750010851,
					"content": "おお…暗闇が支配する時に必ず火の光が現れるように、危機には必ず素晴らしい英雄が立ち上がるんだな、ははっ。人類の可能性とは、こういう時にこそ非常に輝く。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010852
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750010852,
					"content": "#これも素晴らしい物語の題材になるかもしれんな。{NICKNAME}、君は物語の中の英雄でも持ち合わせていない気質を備えているようだ。期待しているぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010853
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750010853,
					"content": "では行こう、英雄たちよ。浮上した「陰縫いの針」を確かめるために。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750010848,
					"content": "#{M#俺}{F#私}たちにできる事があるんじゃ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010849
					]
				},
				{
					"id": 750010831,
					"content": "特に覚えていない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010832
					]
				},
				{
					"id": 750010832,
					"content": "そうか？あれはかなり目立つと思っていたが…まぁいいだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010833
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750010809,
					"content": "#パイモンが主犯。{M#俺}{F#私}は従っただけ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010810
					]
				},
				{
					"id": 750010810,
					"content": "うわっ！いつもそういうこと言うよな。さすがのオイラも怒るぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010811
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750010811,
					"content": "#ははっ、そんなに緊張しないでくれたまえ。むしろ安心したよ。ところで、そこの小さなお嬢さんはパイモンと言うのだな。こちらの{M#少年}{F#少女}の名前は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010812
					],
					"speakerTitle": "ティトゥ"
				},
				{
					"id": 750010812,
					"content": "#{NICKNAME}だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010813
					]
				}
			]
		}
	]
}