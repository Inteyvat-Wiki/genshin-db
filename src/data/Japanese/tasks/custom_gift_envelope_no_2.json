			"dialogs": [
				{
					"id": 715340301,
					"content": "なるほど。このようにして作った祝灯状は、確かに美しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340302
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 715340302,
					"content": "協力してもらってすまないな。おかげで記念の品も手に入り——実りある旅になった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340303
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 715340303,
					"content": "手伝ってくれたこと、感謝する。お前がまた稲妻に来たら、その時は茶でもご馳走しよう。",
					"roleType": "TALK_ROLE_NPC",
