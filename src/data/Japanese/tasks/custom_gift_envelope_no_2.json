			},
			"dialogs": [
				{
					"id": 715340101,
					"content": "うむ、やはりまずは他の祝灯状を参考に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340102
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 715340102,
					"content": "旅人、久しぶりだな…何をそんなに驚いている？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340103
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 715340103,
					"content": "いや、まさか…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715340104
					]
				},
				{
					"id": 715340104,
					"content": "「まさか一介の武人に、海灯祭の趣が理解できるとは」とでも？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340105
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 715340105,
					"content": "#{M#君}{F#あなた}が羽を伸ばしてるなんて珍しくて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715340106
					]
				},
				{
					"id": 715340106,
					"content": "「天領奉行」は重大な責任を背負っている。その一員である者は、常日頃から一寸たりとも気を緩めてはならないのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340107
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 715340107,
					"content": "傍から見れば、確かに私は趣など解さぬ武人に見えるかもしれない…あの花見坂の舞踊や音楽の雰囲気にもそぐわない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340108
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 715340108,
					"content": "だが、日常の中で気を緩めたばかりに、悪党どもに隙を与えてしまえば…その時は、私のみならず、花見坂全体の雰囲気も、沈んでしまうだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340109
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 715340109,
					"content": "せいぜい、こうして隙を見つけ、時間を作って散策してみる程度だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340110
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 715340110,
					"content": "すまない、せっかくの祭りでするような話ではなかったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340111
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 715340111,
					"content": "祝灯状を作ろうとしているのだが、作り方が分からないのだ。よければ、教えてくれないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340112
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 715340112,
					"content": "いいよ。えーっと…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
