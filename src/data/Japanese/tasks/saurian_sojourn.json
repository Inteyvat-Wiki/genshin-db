			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"コミナ",
					"「イェーイェー副教官」",
					"クウェク"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 756700101,
					"content": "高所特訓以外はすべて完了しました、教官！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756700102
					],
					"speakerTitle": "コミナ"
				},
				{
					"id": 756700102,
					"content": "イェー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756700103
					],
					"speakerTitle": "「イェーイェー副教官」"
				},
				{
					"id": 756700103,
					"content": "よし、やる気満々だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756700104
					],
					"speakerTitle": "クウェク"
				},
				{
					"id": 756700104,
					"content": "「こだまの子」はオレたちの偉大なる計画の第一拠点となる。そして、ゆくゆくは「流泉の衆」や「懸木の民」などの部族にも潜入し…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756700105
					],
					"speakerTitle": "クウェク"
				},
				{
					"id": 756700105,
					"content": "えええ！クウェク、一体なに企んでるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756700106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756700106,
					"content": "なんだか謎のスパイ組織みたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756700107
					]
				},
				{
					"id": 756700107,
					"content": "#え？大英雄{NICKNAME}サマと、仲間のパイモン…！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756700108
					],
					"speakerTitle": "クウェク"
				},
				{
					"id": 756700108,
					"content": "ハハ、誤解だ。スパイ組織なんかじゃないさ！オレたちは、竜の仲間たちと楽しく交流するコツをみんなに伝授しに来たんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756700109
					],
					"speakerTitle": "クウェク"
				},
				{
					"id": 756700109,
					"content": "コミナは医者で、参加者の安全を確保してくれる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756700110
					],
					"speakerTitle": "クウェク"
				},
				{
					"id": 756700110,
					"content": "「イェーイェー副教官」はオレたちが探してきた助っ人なんだが、ステージの設計を色々助けてくれたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756700111
					],
					"speakerTitle": "クウェク"
				},
				{
					"id": 756700111,
					"content": "オレは教官で主催者だ。今、開会式をやってたんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756700112,
						756700113
					],
					"speakerTitle": "クウェク"
				},
				{
					"id": 756700112,
					"content": "誤解でよかった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756700114
					]
				},
				{
					"id": 756700114,
					"content": "すみません！クウェクさんが有意義なことに取り組んでいると聞いたので、私がそれなら「ちゃんとした」言葉を使ったほうがいいってアドバイスしたんです…かえって裏目に出ちゃったみたいで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756700115
					],
					"speakerTitle": "コミナ"
				},
				{
					"id": 756700115,
					"content": "ははっ、コミナ、謝らなくていいぜ。オレもこいつも、あんたがつけてくれた呼び名を気に入ってるしな。そうだろ、イェーイェー副教官？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756700116
					],
					"speakerTitle": "クウェク"
				},
				{
					"id": 756700116,
					"content": "キュキュ…イェー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756700117
					],
					"speakerTitle": "「イェーイェー副教官」"
				},
				{
					"id": 756700117,
					"content": "#な？そうだ、{NICKNAME}、試してみたいか？あんたにとっては朝飯前かもしれないが、楽しめると思うぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756700118
					],
					"speakerTitle": "クウェク"
				},
				{
					"id": 756700118,
					"content": "どんな風にやるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756700119
					]
				},
				{
					"id": 756700119,
					"content": "簡単だ。いろんな竜と一緒に、オレが設定した目標を達成してくれ。一番重要なのは、信頼と絆だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756700120
					],
					"speakerTitle": "クウェク"
				},
				{
					"id": 756700120,
					"content": "一人で全ての目標をクリアしようなんて考えたら、一歩も進めなくなるぜ。常に仲間にも気を配ってくれよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756700121
					],
					"speakerTitle": "クウェク"
				},
				{
					"id": 756700121,
					"content": "そうそう、まだ高所における安全対策ができてなくて…クク竜とは一緒に行けないんだ。安全第一だからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756700122
					],
					"speakerTitle": "クウェク"
				},
				{
					"id": 756700122,
					"content": "#やってみようぜ！{NICKNAME}は協力プレイが得意だもんな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756700123,
						756700124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756700123,
					"content": "うん、やってみる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756700125
					]
				},
				{
					"id": 756700125,
					"content": "#よかった…もし{NICKNAME}さんも試してくれたことが広まれば、きっとみんな積極的に参加しにきてくれますよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756700126
					],
					"speakerTitle": "コミナ"
				},
				{
					"id": 756700126,
					"content": "それじゃあコミナ、オイラたちにも「正式」な呼び名を付けてくれよ。カッコイイので頼むぞ、へへっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756700127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756700127,
					"content": "うーん、じっくり考えませんと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "コミナ"
				},
				{
					"id": 756700124,
					"content": "パイモンがそういうなら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756700125
					]
				},
				{
					"id": 756700113,
					"content": "通報するところだった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756700114
					]
				}
			]
		}
	]
}