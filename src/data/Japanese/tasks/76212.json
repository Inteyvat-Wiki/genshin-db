			"trigger": {
				"objectNames": [
					"キアウケツァル"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 762120301,
					"content": "近くの本棚の高いところで立ち止まった…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						762120304
					]
				},
				{
					"id": 762120304,
					"content": "ここなら安全。金色の友達、何か用？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120305,
						762120306
					],
					"speakerTitle": "キアウケツァル"
				},
				{
					"id": 762120305,
					"content": "いや、ただ少し気になって…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762120308
					]
				},
				{
					"id": 762120308,
					"content": "ここ、木の足場が高い、視界も広い。身を隠すにはいい場所。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120309
					],
					"speakerTitle": "キアウケツァル"
				},
				{
					"id": 762120309,
					"content": "ワタシの部{RUBY#[D]部族}屋で、地面にいるのは、危険。たとえ頭上の大いなる主{RUBY#[D]至高なる領主}宰が気まぐれに、ワタシたちを殺さなくても、他の部{RUBY#[D]部族}屋の略奪者が、襲ってくる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120310
					],
					"speakerTitle": "キアウケツァル"
				},
				{
					"id": 762120310,
					"content": "ケツァールのように、崖や樹冠に棲んでいたら、災いが来る前に逃げ出し、生き残れる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120311
					],
					"speakerTitle": "キアウケツァル"
				},
				{
					"id": 762120311,
					"content": "それに、ヴィンディアが、ワタシの飛ぶ姿を見たいと言った。彼女は大きな鳥に乗って、冒険する物語を歌{RUBY#[D]執筆}いたいから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120312
					],
					"speakerTitle": "キアウケツァル"
				},
				{
					"id": 762120312,
					"content": "本当に彼女に騙されてないのかな…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762120313
					]
				},
				{
					"id": 762120313,
					"content": "違う。ヴィンディアはとってもいい人。たぶん、十字路の主と同じくらい。二人とも優しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120314
					],
					"speakerTitle": "キアウケツァル"
				},
				{
					"id": 762120314,
					"content": "でも、キミたち、高く飛んでた。すごい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120315
					],
					"speakerTitle": "キアウケツァル"
				},
				{
					"id": 762120315,
					"content": "これ、キミたちにあげる、友達の証。ワタシは追いつかれないため、もっと高く飛ぶ方法、考えないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120316
					],
					"speakerTitle": "キアウケツァル"
				},
				{
					"id": 762120316,
					"content": "ここには、あの高貴な大いなる主{RUBY#[D]至高なる領主}宰も、皮剥ぎが好きな征服者もいない。安全だけど、退路を確保するのが習慣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キアウケツァル"
				},
				{
					"id": 762120306,
					"content": "#{M#君}{F#あなた}が降りられないんじゃないかって…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762120307
					]
				},
				{
					"id": 762120307,
					"content": "ありがとう。でも、困ってたわけじゃない。高いところは安全、殺されることがない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120308
					],
					"speakerTitle": "キアウケツァル"
				}
			]
		}
	]
}