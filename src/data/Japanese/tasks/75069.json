				},
				{
					"id": 750691204,
					"content": "私は…冒険団の戦士だ。隊長のタイカ様ほどではないが、私にも役に立てることはある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750691205
					],
					"speakerTitle": "クエニン"
				},
				{
					"id": 750691205,
					"content": "私は冒険団の拠点を守る役目を担っている…夜になっても眠れない時は拠点の周りを巡回していた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750691206
					],
					"speakerTitle": "クエニン"
				},
				{
