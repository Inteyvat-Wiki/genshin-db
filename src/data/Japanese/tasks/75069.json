			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"クエニン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750690201,
					"content": "ん？ここまで来る人はあまりいない…危険な場所だからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690202
					],
					"speakerTitle": "クエニン"
				},
				{
					"id": 750690202,
					"content": "お前も冒険団のメンバーなのか…？ふん、黒い巨蛇の影が天蛇の船から降りてきたそうだ…お前も気を付けろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690203
					],
					"speakerTitle": "クエニン"
				},
				{
					"id": 750690203,
					"content": "いっそ、早くここを離れたほうがいい。冒険団にも人ならざるものが潜んでいる…あの怒鳴り声、実に鬱陶しい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690204
					],
					"speakerTitle": "クエニン"
				},
				{
					"id": 750690204,
					"content": "むしろ、ここにいたほうが心が落ち着く。滝が、はは…滝の轟音が他の音をかき消してくれるからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "クエニン"
				}
			]
		},
		{
			"id": 7506905,
			"completionStepIds": [
				7506903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7506903",
							"2"
						],
						"stepId": 7506903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750690501,
					"content": "（破れた紙切れ。最初の方の筆跡はきれいだ…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690502
					],
					"speakerTitle": "クエニンの日記"
				},
				{
					"id": 750690502,
					"content": "「…アビスの魔物がどんどん湧いてきている——これは想定内だ…だが、冒険団は最終的に失敗し、撤退中だ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690503
					],
					"speakerTitle": "クエニンの日記"
				},
				{
					"id": 750690503,
					"content": "「何とかして、残っている人たちを安全に避難させなければ。夜中に突然消えた者や、光のない所から帰ってきた者は十分に警戒した方がいい。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690504
					],
					"speakerTitle": "クエニンの日記"
				},
				{
					"id": 750690504,
					"content": "「…アビスの魔物がどんどん増えてきた。拠点もじきに見つかるだろう。その前に…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690505
					],
					"speakerTitle": "クエニンの日記"
				},
				{
					"id": 750690505,
					"content": "（だんだんと筆跡が乱れていく…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690506
					],
					"speakerTitle": "クエニンの日記"
				},
				{
					"id": 750690506,
					"content": "「ああ、寒い…寒いな。あそこ…あそこで血が尽きてしまった…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690507
					],
					"speakerTitle": "クエニンの日記"
				},
				{
					"id": 750690507,
					"content": "「滝の音が大きい…これでいい。ここなら…滝の下は静かだ。白い顔、開いた口、流れる血…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690508
					],
					"speakerTitle": "クエニンの日記"
				},
				{
					"id": 750690508,
					"content": "「あそこ…あそこに、何か…何かが…ある…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690509
					],
					"speakerTitle": "クエニンの日記"
				},
				{
					"id": 750690509,
					"content": "「滝の下に滝の下に滝の下に滝の下に滝の下に滝の下に滝の下に滝の下に滝の下に…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "クエニンの日記"
				}
			]
		},
