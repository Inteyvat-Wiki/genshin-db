			"dialogs": [
				{
					"id": 110040301,
					"content": "急凍樹～、急凍樹、おいしい～急凍樹～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040302
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110040302,
					"content": "急凍樹～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040303,
						110040305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110040303,
					"content": "浮かれすぎじゃない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110040304
					]
				},
				{
					"id": 110040304,
					"content": "あなたが真面目すぎるんだよ！珍しい食材が手に入ったんだよ、これ以上に嬉しいことはないって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040307
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110040307,
					"content": "あっ、あっちにまだ何かあるみたいだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040308
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110040308,
					"content": "きっと、さっきの狩人が追いかけてたイノシシだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110040309,
					"content": "この模様、見たことないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110040310,
					"content": "う～ん、どこかで見たことあるような…どこだったかな…あっ！『璃月風物誌』だよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040311
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110040311,
					"content": "この模様…うん、間違いない！これ、300年以上前に絶滅したイノシシだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040312
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110040312,
					"content": "えええっ！？そんな昔のイノシシなのか！なんで生きてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040313,
						110040315
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110040313,
					"content": "凍ってたからかな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110040314
					]
				},
				{
					"id": 110040314,
					"content": "あり得るな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040317
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110040317,
					"content": "このイノシシの肉ってすごく美味しいから、乱獲されて絶滅したんだって。本に書いてあったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040318
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110040318,
					"content": "急凍樹と絶滅したイノシシ、今日はお宝を二つもゲットしちゃった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040319
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110040319,
					"content": "これなら勝てる気がする。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110040320
					]
				},
				{
					"id": 110040320,
					"content": "うん、清泉町に戻ろう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "香菱"
				},
				{
					"id": 110040315,
					"content": "長生きさんだから？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110040316
					]
				},
				{
					"id": 110040316,
					"content": "長生きすぎないか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040317
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110040305,
					"content": "急凍樹～",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110040306
					]
				},
				{
					"id": 110040306,
					"content": "あははっ、あなたたちが歌うとなんか変！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040307
					],
					"speakerTitle": "香菱"
				}
			]
		}
	]
