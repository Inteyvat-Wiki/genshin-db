			"dialogs": [
				{
					"id": 750360201,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}、どうしたんだ？さっきから掘り返してるけど、なんかすごいものでも見つけたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750360202,
					"content": "あっ、もしかして、貴重な宝物でも掘り当てたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750360203,
					"content": "キュウ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360204
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360204,
					"content": "どれどれ…なにかの種みたいだな…荒れ地みたいなところで、こんなものが見つかるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750360205,
					"content": "キュウ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360206
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360206,
					"content": "でも、あんまり価値があるようには見えないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750360207,
					"content": "キュウ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360208,
						750360209
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360208,
					"content": "種には無限の可能性が秘められてる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750360210
					]
				},
				{
					"id": 750360210,
					"content": "でも、どう見ても荒れ果てた場所だし…土もカチカチで…この種、ほんとに生きてるのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750360211,
					"content": "ウゥ…キュウ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360212
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360212,
					"content": "悲しんでるのか…でも、本当にどうなるかわからないことなんだ。最初から芽が出ない種もあるし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750360213,
					"content": "まあ、とにかく植えてみるか！もしかしたら、掘った穴が浅かったり、栄養が足りなかっただけかもしれないしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750360214,
					"content": "もっと丁寧に植えてあげれば、芽が出るかもしれないぞ！へへっ、なにが育つかな？すごく大きなグレインの実とか…すごく香りがいいショコアトゥルの種もいいな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360215
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750360215,
					"content": "キュー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360216
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360216,
					"content": "トリックフラワーかも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750360217
					]
				},
				{
					"id": 750360217,
					"content": "こんな時にそんなこと言うなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750360218,
					"content": "でも、ナタの植物にはどんな栄養が必要なんだろうな…まあいいっか、とりあえず植えてみよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750360209,
					"content": "何かすごいものに育つかも！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750360210
					]
				}
			]
		},
