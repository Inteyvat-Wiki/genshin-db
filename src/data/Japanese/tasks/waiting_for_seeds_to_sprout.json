					"speakerTitle": "パイモン"
				},
				{
					"id": 750360802,
					"content": "きれいな花を咲かせてくれ～！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360803
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750360803,
					"content": "…ん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360804
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750360804,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750360805
					]
				},
				{
					"id": 750360805,
					"content": "あっ、燃素のエネルギーがなくなったな。きっと種にしっかり吸収されたんだ。でも…全然反応がないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360806
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750360806,
					"content": "キュウ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360807,
						750360811
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360807,
					"content": "種が成長するのに時間がかかるのかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750360808
					]
				},
				{
					"id": 750360808,
					"content": "おお！考えてみると確かにそうだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360809
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750360809,
					"content": "蒲公英は「フーッ」って吹いたら白い傘がたくさん飛んでくし、ググプラムは子オオカミの毛に引っ付いて遠くまで行けるし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360810
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750360810,
					"content": "種の生命力って強いんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360815
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750360815,
					"content": "じゃあ、邪魔しないでおこう。しばらくしたらまた見に来てみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360816
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750360816,
					"content": "キュウ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360811,
					"content": "種がびっくりしてるだけかも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750360812
					]
				},
				{
					"id": 750360812,
					"content": "ほ、ほんとか？そうだよな！オイラが急ぎすぎたのかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360813
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750360813,
					"content": "#その種も、{REALNAME[ID(2)|SHOWHOST(true)]}に掘り返されたり、虫に栄養を盗まれたり、魔物に邪魔されたりしたことあるかもしれないし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360814
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750360814,
					"content": "土の中に埋まってる種からしたら、人の喧嘩は、雷が鳴ってるのと同じように怖いものなのかもな。それで土の中から出て来ないのかも…！きっとそうに違いない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360815
					],
					"speakerTitle": "パイモン"
				}
			]
