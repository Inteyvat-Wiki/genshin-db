					"ジリアンナ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200380101,
					"content": "はあ、七天神像はどうなってるのかしら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380102
					],
					"speakerTitle": "ジリアンナ"
				},
				{
					"id": 200380102,
					"content": "七天神像がどうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200380103
					]
				},
				{
					"id": 200380103,
					"content": "実はね…昔は七天神像のところへ毎週のように行って、祈祷と掃除をしていたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380104
					],
					"speakerTitle": "ジリアンナ"
				},
				{
					"id": 200380104,
					"content": "なにせ神様がいるおかげで、今の幸せがあるからね。私なりのお恩返しのつもりよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380105
					],
					"speakerTitle": "ジリアンナ"
				},
				{
					"id": 200380105,
					"content": "でもリリーが生まれてから、出かけるチャンスがどんどん減っていったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380106
					],
					"speakerTitle": "ジリアンナ"
				},
				{
					"id": 200380106,
					"content": "七天神像はきっと埃だらけになってると思うの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380107
					],
					"speakerTitle": "ジリアンナ"
				},
				{
					"id": 200380107,
					"content": "責任を押し付けてるみたいで申し訳ないけど、私の代わりに七天神像を掃除してくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380109,
						200380110
					],
					"speakerTitle": "ジリアンナ"
				},
				{
					"id": 200380109,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200380111
					]
				},
				{
					"id": 200380111,
					"content": "ありがとう、あなたに風神のご加護があらんことを。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380115
					],
					"speakerTitle": "ジリアンナ"
				},
				{
					"id": 200380115,
					"content": "そうだ、七天神像には神様の力があるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380116
					],
					"speakerTitle": "ジリアンナ"
				},
				{
					"id": 200380116,
					"content": "「埃」は通常の掃除では綺麗にできないの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380117
					],
					"speakerTitle": "ジリアンナ"
				},
				{
					"id": 200380117,
					"content": "でもあなたには「元素」の力があるから、きっと簡単に解決できるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380118
					],
					"speakerTitle": "ジリアンナ"
				},
				{
					"id": 200380118,
					"content": "私のように一日使うこともないはず…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジリアンナ"
				},
				{
					"id": 200380110,
					"content": "風で埃を綺麗にすればいい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200380112
					]
				},
				{
					"id": 200380112,
					"content": "バルバトス様とその風は、きっと毎日忙しいのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380113
					],
					"speakerTitle": "ジリアンナ"
				},
				{
					"id": 200380113,
					"content": "それに、何事も神様を当てにするわけにはいかないからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380114
					],
					"speakerTitle": "ジリアンナ"
				},
				{
					"id": 200380114,
					"content": "どうか私と一緒にバルバトス様の手助けをしてちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380115
					],
					"speakerTitle": "ジリアンナ"
				}
			]
		},
