			"dialogs": [
				{
					"id": 50280501,
					"content": "降臨者の命の価値は、汝の想像を遥かに超えるもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50280502
					],
					"speakerTitle": "シュバランケ"
				},
				{
					"id": 50280502,
					"content": "だが、汝はその手で世界の希望を握り潰した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50280503
					],
					"speakerTitle": "シュバランケ"
				},
				{
					"id": 50280503,
					"content": "もし私の失敗が運命で定まっているのなら、なぜそうも恐れる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50280504
					],
					"speakerTitle": "マーヴィカ"
				},
				{
					"id": 50280504,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50280505
					],
					"speakerTitle": "シュバランケ"
				},
				{
					"id": 50280505,
					"content": "（願いのため、我々は巡礼の道を歩む。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50280506
					],
					"speakerTitle": "マーヴィカ"
				},
				{
					"id": 50280506,
					"content": "（最強の名のため、我々は集い戦う。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50280507
					],
					"speakerTitle": "マーヴィカ"
				},
				{
					"id": 50280507,
					"content": "（夢のため、我々は劫火の中で燃え尽きるのだ。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50280508
					],
					"speakerTitle": "マーヴィカ"
				},
				{
					"id": 50280508,
					"content": "（それを延々と繰り返してきた…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マーヴィカ"
				}
			]
		},
