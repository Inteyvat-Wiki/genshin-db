			"dialogs": [
				{
					"id": 766530501,
					"content": "うーん…この研究、続けるべきなのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530502
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 766530502,
					"content": "これは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766530503,
					"content": "ビュンビュンスパイ1号だよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530504
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 766530504,
					"content": "やっぱりよくわからないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766530505,
					"content": "正確に言うと、ここはビュンビュンスパイ1号のテストプラットフォームで、ビュンビュンスパイ1号はアイノが新しく造った潜入用ロボットです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530506
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 766530506,
					"content": "アイノは少し前に闇市で廃棄された清掃ユニットを購入し、それを改造して今のビュンビュンスパイ1号にしました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530507
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 766530507,
					"content": "このプラットフォームは様々な敵対環境をシミュレーション可能で、ビュンビュンスパイ1号の潜入性能をテストできるのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530508
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 766530508,
					"content": "アイノはどうして潜入ロボットを造ったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530509
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766530509,
					"content": "カンカン・アマサヒカエメが盗まれたと知ったアイノは、「相手の背後にどれほど強大な勢力が潜んでいようが、仲間を助けてみせる」と決心したのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530510
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 766530510,
					"content": "そしてビュンビュンスパイ1号の設計を完成させたあと、開発を始めました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530511
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 766530511,
					"content": "想定通りに進んだ場合、開発が完了すれば、警備が厳重なクーヴァキ実験設計局であっても、簡単に潜入し仲間を救出できるようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530512
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 766530512,
					"content": "なんだかすごそうだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530513
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766530513,
					"content": "ですが、アイノは計画を完璧に仕上げることに非常に時間がかかることにすぐ気づき、このプランを諦めました。直接ナド・クライをひっくり返したほうが早いという結論に至ったようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530514
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 766530514,
					"content": "決めた！どちらにせよ時間が掛かるなら、やっぱりビュンビュンスパイ1号の開発を続けるよ。ぜったい仲間の救出に役立ってくれるからね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530515
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 766530515,
					"content": "#それでしたら、{NICKNAME}さんとパイモンさんにも手伝ってもらいませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530516
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 766530516,
					"content": "今までの統計結果によると、他のテスターから参考データを採取できれば、アイノの開発スピードは少なくとも30%はアップするはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530517
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 766530517,
					"content": "面白そうだな。オイラやるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530518
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766530518,
					"content": "#{M#俺}{F#私}も。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766530519
					]
				},
				{
					"id": 766530519,
					"content": "では、アイノに代わってお礼を言わせていただきます。私から権限を付与するので、テストをしたい場合は直接このプラットフォームを使用してください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イネファ"
				}
			]
		}
	]
}