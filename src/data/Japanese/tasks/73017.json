				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パイモン",
					"アランコンティ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730171201,
					"content": "ただいま！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730171202,
					"content": "聞こえた。嗚咽が穏やかなメロディーに変わった。けど、音の大きな流れに合流するにはまだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171203
					],
					"speakerTitle": "アランコンティ"
				},
				{
					"id": 730171203,
					"content": "まだアランコンティの力が必要だ！へへっ、あとは任せたぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730171204,
					"content": "アランコンティ、了解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171205
					],
					"speakerTitle": "アランコンティ"
				},
				{
					"id": 730171205,
					"content": "おう！これでもう安心だよな！早くヴァルナ神器を治さないと、アパーム叢林が胞子だらけになっちゃうぜ…考えただけで…へっくしゅん——ううっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730171206,
					"content": "なんでアランナラは胞子に反応しないんだ…？アランナラは影響を受けたりしないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730171207,
					"content": "アランナラも大丈夫じゃない。アランナラはキノコを調理する。「胞子」は小さすぎて多すぎて、捕まえられない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171208
					],
					"speakerTitle": "アランコンティ"
				},
				{
					"id": 730171208,
					"content": "ヴァルナ神器が壊れる前、ヴァーナのキノコはこんなに多くなかった。ヴァルナ神器の修理が終われば、全部良くなる。マラーナ以外は。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171209
					],
					"speakerTitle": "アランコンティ"
				},
				{
					"id": 730171209,
					"content": "きっと良くなるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171210
					]
				},
				{
					"id": 730171210,
					"content": "#そうだぞ。オイラと{NICKNAME}も協力するからさ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730171211,
					"content": "マラーナについてもきっと解決法がある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171212
					]
				},
				{
					"id": 730171212,
					"content": "#ナラ{NICKNAME}は、ナラヴァルナなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171213
					],
					"speakerTitle": "アランコンティ"
				},
				{
					"id": 730171213,
					"content": "え？唐突にどうしたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730171214,
					"content": "アランパンドゥから、ナラヴァルナは金色で勇敢なナラだと聞いた。アランナラと一緒にヴァルナ神器を治し、黒い雨と泥を追い払い、月と太陽を連れ帰ったと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171215
					],
					"speakerTitle": "アランコンティ"
				},
				{
					"id": 730171215,
					"content": "#ナラ{NICKNAME}も、アランナラのヴァルナ神器の修理を手伝う金色で、勇敢なナラだ。違うか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171216
					],
					"speakerTitle": "アランコンティ"
				},
				{
					"id": 730171216,
					"content": "でも、ナラヴァルナはずーっと昔の人だぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171217
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730171217,
					"content": "#ナラヴァルナが戻ってきたのじゃないのか？ナラ{NICKNAME}はまったく別のナラなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171218
					],
					"speakerTitle": "アランコンティ"
				},
				{
					"id": 730171218,
					"content": "別のナラにも、似たようなメロディがあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171219,
						730171220
					],
					"speakerTitle": "アランコンティ"
				},
				{
					"id": 730171219,
					"content": "多分ね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171221
					]
				},
				{
					"id": 730171221,
					"content": "アランコンティはナラヴァルナを見たことがない。でも、アランパンドゥが色々話してくれた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171222
					],
					"speakerTitle": "アランコンティ"
				},
				{
					"id": 730171222,
					"content": "#{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}のメロディは、きっとナラ{NICKNAME}と同じ。聞くと嬉しくなる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171223
					],
					"speakerTitle": "アランコンティ"
				},
				{
					"id": 730171223,
					"content": "#だろ。オイラも{NICKNAME}と一緒にいるだけで楽しいんだ！でもナラヴァルナが森を出ていったみたいに、いつか{NICKNAME}もオイラのそばからいなくなると思うと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171224
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730171224,
					"content": "ううぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171225
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730171225,
					"content": "#きっとアランパンドゥが「休憩所」で待ってる。ナラ{NICKNAME}、アランコンティと一緒に帰ろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171226,
						730171228
					],
					"speakerTitle": "アランコンティ"
				},
				{
					"id": 730171226,
					"content": "行こう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171227
					]
				},
				{
