			"dialogs": [
				{
					"id": 730171001,
					"content": "しっとりした夢、乾燥した夢…じゃらん、カタカタ、さらさら、ヴァーナの歌…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171002
					],
					"speakerTitle": "アランコンティ"
				},
				{
					"id": 730171002,
					"content": "#ナラ{NICKNAME}？「葉っぱ」は夢の中、「枝」はここにある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランコンティ"
