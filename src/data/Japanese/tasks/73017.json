			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アランコンティ",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730170401,
					"content": "大木の根は良いものだ。湿度の息遣いを聞ける。眠気を誘うメロディーだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170402
					],
					"speakerTitle": "アランコンティ"
				},
				{
					"id": 730170402,
					"content": "うーん…またまた意味不明だな。でも、まぁいいや！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730170403,
					"content": "それはそうと、中はこんなに広いんだな。「入り組んでる」っていうのか？それに、雰囲気も他とはぜんぜん違うぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730170404,
					"content": "こんなとこで、ヴァルナ神器にエネルギーを送る「葉っぱ」を見つけなきゃいけないのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730170405,
					"content": "ここであって、ここじゃない。あれの声を聞き、あれの気配を感じ、あれの脈動を見ることはできる。けど、パイモンにあれは見つけられない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170406
					],
					"speakerTitle": "アランコンティ"
				},
				{
					"id": 730170406,
					"content": "え？なんでだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170407
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730170407,
					"content": "#パイモンが無理なら、{M#俺}{F#私}は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170408
					]
				},
				{
					"id": 730170408,
					"content": "金色のナラには、旋律が見える。夜の涼風のように、にわかに降る雨のように、そして砕けた湖面の、一千もの夢のように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170409
					],
					"speakerTitle": "アランコンティ"
				},
				{
					"id": 730170409,
					"content": "何だか凄そう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170410
					]
				},
				{
					"id": 730170410,
					"content": "#さすが{NICKNAME}だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170411
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730170411,
					"content": "へへっ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170412
					]
				},
				{
					"id": 730170412,
					"content": "#えへへ…って違う！{NICKNAME}、ひとの話を横取りするなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730170413,
					"content": "#ナラ{NICKNAME}がパイモンになる…マラーナでキノコとペアを組んで踊るよりも恐ろしい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170414
					],
					"speakerTitle": "アランコンティ"
				},
				{
					"id": 730170414,
					"content": "想像できない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170415
					]
				},
				{
					"id": 730170415,
					"content": "だから、そんなことありえないって！と言うか、起きてほしくない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170416
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730170416,
					"content": "アランコンティもさ、もうちょっと分かりやすくしゃべれないのかよ？で、ヴァルナ神器の「葉っぱ」はどこにあるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170417
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730170417,
					"content": "夢の中だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170418
					],
					"speakerTitle": "アランコンティ"
				},
				{
					"id": 730170418,
					"content": "へえ…待て、じゃあなんで最初からそう言わなかったんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170419
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730170419,
					"content": "パイモンがなぜかと聞いたから。どこにあるかとは聞かなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170420
					],
					"speakerTitle": "アランコンティ"
				},
				{
					"id": 730170420,
					"content": "あれ…オイラ、アランナラとの付き合い方が分かった気がするぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170421
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730170421,
					"content": "アランコンティ、探さなきゃいけない「葉っぱ」が具体的にどの辺にあるか教えてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170422
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730170422,
					"content": "分かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170423
					],
					"speakerTitle": "アランコンティ"
				},
				{
					"id": 730170423,
					"content": "わぁ、アランコンティはほんとに聞かれたことにしか答えないんだな…よし、それで三か所っていうのは、具体的にどこだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170424
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730170424,
					"content": "ここ、あっち、向こう側。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170425
					],
					"speakerTitle": "アランコンティ"
				},
				{
					"id": 730170425,
					"content": "うんうん…って違う。それじゃ、なんの説明にもなってないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170426
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730170426,
					"content": "パイモン、大失敗だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170427
					]
				},
				{
					"id": 730170427,
					"content": "#オイラの大失敗は、{NICKNAME}の大失敗と同じだぞ！アランコンティの話はまったく当てにならないぜ…どうやって三か所を探し当てればいいんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170428
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730170428,
					"content": "ヴァルナ神器は一番すごいアランナラが作ったもの。「枝」と「葉っぱ」の結びつきは、目には見えないが、見える。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170429
					],
					"speakerTitle": "アランコンティ"
				},
				{
					"id": 730170429,
					"content": "#ナラ{NICKNAME}にはアランナラとその痕跡が見える。そうして方角は分かる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170430
					],
					"speakerTitle": "アランコンティ"
				},
				{
					"id": 730170430,
					"content": "や、やっと意味が分かった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170431
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730170431,
					"content": "アランナラの痕跡を追えば見つかるんだね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170432
					]
				},
				{
					"id": 730170432,
					"content": "ううっ…今回くらいオイラに答えさせてくれよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
