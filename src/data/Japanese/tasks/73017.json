			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パイモン",
					"アランコンティ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730170201,
					"content": "あ～、やっと見つけた！おまえ、アランコンティだよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730170202,
					"content": "違うと言ってもいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170203
					],
					"speakerTitle": "アランコンティ"
				},
				{
					"id": 730170203,
					"content": "へ？どういう意味だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730170204,
					"content": "なぜならアランコンティは、木にも雨にも、ヴァーナの夢にも、楽器の弦にもなれるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170205
					],
					"speakerTitle": "アランコンティ"
				},
				{
					"id": 730170205,
					"content": "へえ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730170206,
					"content": "#…ちんぷんかんぷんだぞ！{NICKNAME}、こいつがなに言ってるか分かるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170207,
						730170209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730170207,
					"content": "分からない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170208
					]
				},
				{
					"id": 730170208,
					"content": "だよな。そりゃ単語の意味はわかるけど、なにが言いたいのか全然伝わってこないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730170213,
					"content": "金色のナラ、空飛ぶチビ。どうしてアランコンティに会いに来た？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170214
					],
					"speakerTitle": "アランコンティ"
				},
				{
					"id": 730170214,
					"content": "オイラは「空飛ぶチビ」じゃないぞ！あれ、でも確かに言えてるかも…？いや、とにかくオイラはパイモンだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170215
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730170215,
					"content": "#「金色のナラ」にも名前はあるぞ。こいつは{NICKNAME}だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730170216,
					"content": "アランパンドゥに言われて来たんだ。アランコンティが夢の林にいるから、様子を見に行ってくれって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170217
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730170217,
					"content": "パイモンはアランパンドゥにこう伝えるといい。アランコンティは元気、夢の林も元気、しっとりした夢も元気だと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170218
					],
					"speakerTitle": "アランコンティ"
				},
				{
					"id": 730170218,
					"content": "#そ、そうか…{NICKNAME}、じゃあアランパンドゥのとこに戻るか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170219
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730170219,
					"content": "…って違う！オイラたちはヴァルナ神器を治しに来たんだ！もうちょっとで言われるがままに帰っちゃうとこだったぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170220
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730170220,
					"content": "アランパンドゥに伝えるといい。アランコンティは、パイモンを言いなりにさせるつもりはないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170221
					],
					"speakerTitle": "アランコンティ"
				},
				{
					"id": 730170221,
					"content": "別に、そんなこと知りたくないと思うよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170222
					]
				},
				{
					"id": 730170222,
					"content": "オイラだってどうでもいいぞ！このアランナラ、一体なんなんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170223
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730170223,
					"content": "確かアランパンドゥが言ってた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170224
					]
				},
				{
					"id": 730170224,
					"content": "えっと、アランコンティのことを「ナラとなじみがない」って言ってたよな…つまり、人間との付き合い方を知らないってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170225
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730170225,
					"content": "#{M#俺}{F#私}もアランナラとの付き合い方は知らない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170226
					]
				},
				{
					"id": 730170226,
					"content": "うん、確かに。「郷に入っては郷に従え」だ、オイラたちがあいつらとの付き合い方を勉強しないとな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170227
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730170227,
					"content": "でも今更だけど、アランナラとはどう付き合えばいいんだろうな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170228,
						730170230
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730170228,
					"content": "空飛ぶチビはどう思う？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170229
					]
				},
				{
					"id": 730170229,
					"content": "金色のナラにも分からないのに、空飛ぶチビに分かると思うか？なんなら不思議なアランコンティに聞いてみるか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170233
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730170233,
					"content": "なあ、アランコンティ。アランナラ同士ってどうやって交流してるんだ？オイラたちにも教えてくれよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170234
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730170234,
					"content": "なぜそれが知りたい？ナラはナラ、パイモンはパイモン、アランナラはアランナラ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170235
					],
					"speakerTitle": "アランコンティ"
				},
				{
					"id": 730170235,
					"content": "…ああ、そうか。パイモンも種になって土に埋められたいんだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170236
					],
					"speakerTitle": "アランコンティ"
				},
				{
					"id": 730170236,
					"content": "違うぞ！そんなこと、一ミリも思ってない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170237
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730170237,
					"content": "じゃあ、金色のナラが種になりたいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170238,
						730170240
					],
					"speakerTitle": "アランコンティ"
				},
				{
					"id": 730170238,
					"content": "いや、遠慮しとく。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170239
					]
				},
				{
					"id": 730170239,
					"content": "種は素晴らしいのに。残念だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170242
					],
					"speakerTitle": "アランコンティ"
				},
				{
					"id": 730170242,
					"content": "余計な話してたら、ここに来た目的を忘れるとこだった。そう、ウツァヴ祭だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170243
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730170243,
					"content": "ウツァヴ祭のために、ヴァルナ神器を治さなくちゃならないんだ。そうすれば天気も元通りになるし、あの嫌な胞子もいなくなる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170244
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730170244,
					"content": "パイモンの言う通りだ。ウツァヴ祭のため、紺碧の大地の中心のため。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170245
					],
					"speakerTitle": "アランコンティ"
				},
				{
					"id": 730170245,
					"content": "霧の立ちこめる夢の林も悪くない。けど、「胞子」はけしからん。走るキノコもけしからん。雨が多いと、キノコも調理しづらくなる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170246
					],
					"speakerTitle": "アランコンティ"
				},
				{
					"id": 730170246,
					"content": "おおっ、そこら辺のことはよく分かってるんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170247
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730170247,
					"content": "#ヴァルナ神器を治しに行こう。ナラ{NICKNAME}とパイモン、アランコンティについて来て。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランコンティ"
				},
				{
					"id": 730170240,
					"content": "可能なら、やってみたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170241
					]
				},
				{
					"id": 730170241,
					"content": "嘘つくなよ。あいつ、本気にするだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170242
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730170230,
					"content": "とりあえず、比喩を使ってみたら？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170231
					]
				},
				{
					"id": 730170231,
					"content": "よし、やってみよう！金色のナラは…えっと…うーん…テイワット風目玉焼きみたいだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170232
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730170232,
					"content": "…やっぱりアランコンティに聞いみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170233
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730170209,
					"content": "大体の意味は分かる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170210
					]
				},
				{
					"id": 730170210,
					"content": "ええ、すごいな！で、あいつはなにが言いたいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730170211,
					"content": "色んなものに変身できるってことかな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170212
					]
				},
				{
					"id": 730170212,
					"content": "#ほんとか？{NICKNAME}、騙したら許さないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170213
					],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7301704,
			"completionStepIds": [
				7301704
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301704",
