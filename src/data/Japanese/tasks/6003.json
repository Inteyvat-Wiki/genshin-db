						],
						"pointId": 6
					}
				]
			},
			"dialogs": [
				{
					"id": 60030901,
					"content": "ようこそ、待っていたよ。この小さな研究所を気に入っていただけただろうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030902
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030902,
					"content": "気に入るだって？魔物だらけだったじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030903
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 60030903,
					"content": "よくそのように悠長に構えられたものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030904
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 60030904,
					"content": "ふっ、何も焦ることなどなかろう？すべては順調。お前たちが来たのも予想通りだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030905
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030905,
					"content": "まずサンドローネとアルレッキーノ、そして次はお前たち。今日は客人が多い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030906
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030906,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030907
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 60030907,
					"content": "その二人をお捜しかな？なら、アルレッキーノは研究所に入ってすぐ姿を消してしまったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030908
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030908,
					"content": "サンドローネのほうは、さっきまでここで大声で私に詰め寄っていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030909
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030909,
					"content": "彼女はいつもそうだ。礼儀知らずで困ったものだよ。だが、他人を気にかけるようになるとは意外だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030910
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030910,
					"content": "お前たちと交友のある者は、皆そうなってしまうのか？しかし、それは研究者からしたらいただけない。客観性を失ってしまうからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030911
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030911,
					"content": "サンドローネはどこにいる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030912
					]
				},
				{
					"id": 60030912,
					"content": "ああ、彼女なら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030913
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030913,
					"content": "ずいぶんと大きな夢を見ているようね、ドットーレ。月髄を手に入れれば、この世界の神を名乗れるとでも思った？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030914
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 60030914,
					"content": "名乗る？その言い方は好ましくないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030915
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030915,
					"content": "自称ではなく事実だ。研究者であるお前なら、その差を理解できないはずないだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030916
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030916,
					"content": "はぁ？アナタごときが？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030917
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 60030917,
					"content": "あら失礼、淑女も時には失言してしまうの、気にしないで。同僚なんだし、アナタのやり口くらい分かっているつもりよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030918
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 60030918,
					"content": "ああ、同僚だから、お前ならそう言うと思っていたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030919
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030919,
					"content": "言葉を尽くすより、事実を見せたほうが早いことをお互いよく知っているだろう。今の私の次元を理解してもらうために、ちょっとしたプレゼントを用意した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030920
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030920,
					"content": "プレゼント？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030921
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 60030921,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030922
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 60030922,
					"content": "アナタの部下たちはどこに行ったの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030923
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 60030923,
					"content": "はて？もしかすると未知なる神の足跡を追って、新世界へ旅立ったのかもしれないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030924
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030924,
					"content": "サンドローネよ——お前は教養に欠け、傲慢な態度を取ってくるが、だからといって私はその部下に八つ当たりなどしない。彼らにも新世界へ向かう権利はあるのだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030925
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030925,
					"content": "まさか…クーヴァキ実験設計局に人を向かわせたの？あそこは女皇陛下の実験場なのよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030926
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 60030926,
					"content": "ああ、陛下のご命令はもちろん心に刻んでいるとも。だがお前も知っての通り、それは私の今の目標と矛盾しない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030927
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030927,
					"content": "私はただ、自分の望む実験をしているだけ、何か問題があるだろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030928
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030928,
					"content": "私が嘘をつき、お前の気を逸らそうとしているだけなのか、それともお前の部下が本当に危険な目に遭っているのか、よく考えてみるといいだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030929
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030929,
					"content": "ファデュイの兵にまで手を出すなんて、狂ってる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030930
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 60030930,
					"content": "私は自分に新たなルールを定めた——すべての人に一度だけチャンスを与えるとね。もちろん、お前にもだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030931
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030931,
					"content": "ここを離れたいのなら止めはしない。何しろ、我々は仲の良い同僚同士なのだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030932
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030932,
					"content": "このッ——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030933
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 60030933,
					"content": "まさかサンドローネまで、この世界の人を案じるようになるとはな。実に残念だよ。自己中心的なところが、彼女の唯一の長所だったというのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030934
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030934,
					"content": "たかが実験設計局を守るために躍起になる…そんなことでいったい何を成し遂げられる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030935
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030935,
					"content": "人質を取るなど、褒められた行為ではありませんね。それとも今のあなたにとって、体面など重要ではないのでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030936
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 60030936,
					"content": "体面？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030937
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030937,
					"content": "この手にはすでに月髄が二つ…失われた一つもまもなく完成する。新世界の神となるこの私に、体面を語るとは——あまりに滑稽ではないかね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030938
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030938,
					"content": "そなたに聖物を扱う資格などない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030939
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 60030939,
					"content": "私から見れば、生きる資格のない人間はごまんといる。だが私は慈悲深くその存在を許してやっているのだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030940
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030940,
					"content": "#{M#自分のしたことを、必ず後悔することになるぞ。}{F#自分のしたことを、必ず後悔することになるよ。}",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030941
					]
				},
				{
					"id": 60030941,
					"content": "フン、それはお前たちに私を後悔させるだけの力があればの話だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「博士」"
				}
			]
		},
