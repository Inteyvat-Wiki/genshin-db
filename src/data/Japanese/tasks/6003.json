			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ジョタウタス"
				],
				"points": [
					{
						"sceneId": 20322,
						"position": [
							309.422,
							310.76,
							540.634
						],
						"pointId": 3
					}
				]
			},
			"dialogs": [
				{
					"id": 60030501,
					"content": "貴様ら…なぜここに！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030502
					],
					"speakerTitle": "ジョタウタス",
					"speakerSubtitle": "「博士」の部下"
				},
				{
					"id": 60030502,
					"content": "「博士」はいま研究所内にいるはずだが、なぜそなたは逃げようとしておるのだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030503
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 60030503,
					"content": "ふん、「博士」様に用があるのか…だが上手くいくとは到底思えないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030504
					],
					"speakerTitle": "ジョタウタス",
					"speakerSubtitle": "「博士」の部下"
				},
				{
					"id": 60030504,
					"content": "あなたがこの先どれだけ生きていられるかは、その発言の価値に左右されるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030505
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 60030505,
					"content": "執行官がもう二人、研究所内に入ったが、それがどうしたってんだ？あの「博士」様があんだけ大掛かりなことをしてるんだ、何の準備もしてないわけがない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030506
					],
					"speakerTitle": "ジョタウタス",
					"speakerSubtitle": "「博士」の部下"
				},
				{
					"id": 60030506,
					"content": "でも、おまえはその部下であることに不満があるようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030507
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 60030507,
					"content": "それに、この辺りは魔物の痕跡と気配に満ちてる…まさか、そんなやつらと一緒にいるのが好きなのかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030508
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 60030508,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030509
					],
					"speakerTitle": "ジョタウタス",
					"speakerSubtitle": "「博士」の部下"
				},
				{
					"id": 60030509,
					"content": "#{M#「博士」が何を企んでるのか、知りたいんだ。知ってることがあれば教えてくれないか。}{F#「博士」が何を企んでるのか、知りたいの。知ってることがあれば教えて。}",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030510
					]
				},
				{
					"id": 60030510,
					"content": "#{M#自分たちのためだけに動いてるわけじゃない。「博士」の行動はナド・クライ全体…いや、君たちのスネージナヤにも影響を与えるかもしれないんだ。}{F#自分たちのためだけに動いてるわけじゃない。「博士」の行動はナド・クライ全体…ううん、あなたたちのスネージナヤにも影響を与えるかもしれないの。}",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030511
					]
				},
				{
					"id": 60030511,
					"content": "…くっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030512
					],
					"speakerTitle": "ジョタウタス",
					"speakerSubtitle": "「博士」の部下"
				},
				{
					"id": 60030512,
					"content": "あの方は…とんでもないものを作っている。その計画のために、長い年月を費やしてきたようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030513
					],
					"speakerTitle": "ジョタウタス",
					"speakerSubtitle": "「博士」の部下"
				},
				{
					"id": 60030513,
					"content": "少し前、「博士」様はスネージナヤに戻ると言ったが、思いのほか早く帰ってこられてな。その手には、宝石のように輝くものが二つあった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030514
					],
					"speakerTitle": "ジョタウタス",
					"speakerSubtitle": "「博士」の部下"
				},
				{
					"id": 60030514,
					"content": "…月髄。「博士」はコロンビーナさんから、それを奪ったのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030515
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 60030515,
					"content": "「少女」様から？あの方はもう組織を離れたんだろ？いなくなる前に、女皇陛下の命は果たしたから、自分のすべきことをすると言っていたらしいが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030516
					],
					"speakerTitle": "ジョタウタス",
					"speakerSubtitle": "「博士」の部下"
				},
				{
					"id": 60030516,
					"content": "組織を離れることが、必ずしもいいことだとは限らない。俺の尊敬する「隊長」様だって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030517
					],
					"speakerTitle": "ジョタウタス",
					"speakerSubtitle": "「博士」の部下"
				},
				{
					"id": 60030517,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030518
					]
				},
				{
					"id": 60030518,
					"content": "計画を遂行するため、上は「博士」様、「傀儡」様、「少女」様の部隊をこの地に派遣した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030519
					],
					"speakerTitle": "ジョタウタス",
					"speakerSubtitle": "「博士」の部下"
				},
				{
					"id": 60030519,
					"content": "俺は当時「少女」様の隊に所属していたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030520
					],
					"speakerTitle": "ジョタウタス",
					"speakerSubtitle": "「博士」の部下"
				},
				{
					"id": 60030520,
					"content": "あの方は、俺たちとほとんど会話せず、周りにも無関心だった。かといって、心ここにあらずってわけでもなくて…ただ、この世界がどうなろうと気にしていないようだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030521
					],
					"speakerTitle": "ジョタウタス",
					"speakerSubtitle": "「博士」の部下"
				},
				{
					"id": 60030521,
					"content": "まるで生きる意味を見つけられず、遠くを眺めるしかないように…いつも空を見上げていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030522
					],
					"speakerTitle": "ジョタウタス",
					"speakerSubtitle": "「博士」の部下"
				},
				{
					"id": 60030522,
					"content": "「博士」様は、いつも少し離れたところから彼女を見守っていた。以前は協力関係にあったようだが、やがて「少女」様が彼を警戒するようになり疎遠になったらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030523
					],
					"speakerTitle": "ジョタウタス",
					"speakerSubtitle": "「博士」の部下"
				},
				{
					"id": 60030523,
					"content": "「少女」様が組織を去った後、俺は「博士」様の隊に異動した。だがあの方もまた…同じように周りのことに無関心で、ただ月だけを見据えていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030524
					],
					"speakerTitle": "ジョタウタス",
					"speakerSubtitle": "「博士」の部下"
				},
				{
					"id": 60030524,
					"content": "今の「博士」様は、三つの月を何よりも欲している。月が足りないのなら、自分で作ればいいと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030525
					],
					"speakerTitle": "ジョタウタス",
					"speakerSubtitle": "「博士」の部下"
				},
				{
					"id": 60030525,
					"content": "月髄を作る？もしかして「ヒュペルボレイア」の虚影から得た知識かい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030526
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 60030526,
					"content": "詳しくお話しいただきありがとうございます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030527
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 60030527,
					"content": "そなた、本当はコロンビーナさんの部下のままでいたかったのではないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030528
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 60030528,
					"content": "…いや、あの方はもう執行官じゃない。それに俺たちファデュイが忠誠を誓うべきは、女皇陛下ただお一人だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030529
					],
					"speakerTitle": "ジョタウタス",
					"speakerSubtitle": "「博士」の部下"
				},
				{
					"id": 60030529,
					"content": "これを貴様らに教えたのは「博士」様を完全に信じきれなかったからにすぎない。あの方の行動は、俺たちがナド・クライに来た本来の目的と食い違ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030530
					],
					"speakerTitle": "ジョタウタス",
					"speakerSubtitle": "「博士」の部下"
				},
				{
					"id": 60030530,
					"content": "分かった。彼のことは必ず止めてみせる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030531
					]
				},
				{
					"id": 60030531,
					"content": "「召使」の部下がクーヴァキ実験設計局にいるから、合流するといいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030532
					]
				},
				{
					"id": 60030532,
					"content": "月髄を作るね…おまけに完成も近そうだ…ドットーレの技術がそこまで進んでるなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030533
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 60030533,
					"content": "ここからは苦戦を強いられるでしょう。皆さん、心の準備を。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フリンズ"
				}
			]
		},
