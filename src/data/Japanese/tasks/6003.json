			"dialogs": [
				{
					"id": 60031101,
					"content": "未完成とはいえ、人造月髄の影響でドットーレの力はこちらを凌駕している…まともにやり合うな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60031102
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 60031102,
					"content": "——今だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60031103
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 60031103,
					"content": "退きましょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60031104
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 60031104,
					"content": "確かに、降伏よりも撤退のほうが賢明だろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60031105
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60031105,
					"content": "これは…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60031106
					]
				},
				{
					"id": 60031106,
					"content": "まずい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60031107
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 60031107,
					"content": "#{M#俺のことはいいから、みんな逃げて——}{F#私のことはいいから、みんな逃げて——}",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60031108
					]
				},
				{
					"id": 60031108,
					"content": "旅人！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60031109
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 60031109,
					"content": "ちっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60031110
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 60031110,
					"content": "今は打つ手がありません。ひとまず退くしかないでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フリンズ"
				}
			]
