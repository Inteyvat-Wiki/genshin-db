			"dialogs": [
				{
					"id": 60030101,
					"content": "みんな揃ってるみたいだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60030102,
					"content": "ああ、こっちは準備万端だ。旅人、パイモン、お前たちはどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030103
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 60030103,
					"content": "バッチリだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030104,
						60030106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60030104,
					"content": "#{M#俺}{F#私}も！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030105
					]
				},
				{
					"id": 60030105,
					"content": "よし。さっそく本題に入るとしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030113
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 60030113,
					"content": "そんじゃ、まずは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030114
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 60030114,
					"content": "待った！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030115
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 60030115,
					"content": "誰かいるみたいだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030116
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 60030116,
					"content": "足音が隠せてないよ。ただ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030117
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 60030117,
					"content": "敵意は感じられませんね。しばらくそこにいらっしゃるようですが、もしや旅人さんについて来たんでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030118
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 60030118,
					"content": "入ったらどうだい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030119
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 60030119,
					"content": "やはり簡単にバレてしまいましたか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030120
					],
					"speakerTitle": "ゲディミナス",
					"speakerSubtitle": "「召使」の部下"
				},
				{
					"id": 60030120,
					"content": "「召使」様の命により、伝言をお届けに参りました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030121
					],
					"speakerTitle": "ゲディミナス",
					"speakerSubtitle": "「召使」の部下"
				},
				{
					"id": 60030121,
					"content": "ドットーレはスネージナヤに戻ると思われたが、そうではなかった。そしてクーヴァキ実験設計局にも、ナシャタウンにも姿を見せていない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030122
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 60030122,
					"content": "ということは、おそらく北にある研究所にいるはずよ。ふんっ、どうして個人で使える場所を申請したのかと思えば…最初から何もかも計画していたってことね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030123
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 60030123,
					"content": "彼らにこう伝えてくれ——私とサンドローネが先行する。もし君たちも気になるようなら、ナド・クライの最北にある研究所で会おう、と。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030124
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 60030124,
					"content": "コロンビーナと仲のいい二人だが、行動を起こす前にわざわざ俺たちに情報共有をしてくれたってことか…ファデュイの協力に礼を言わないとだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030125
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 60030125,
					"content": "「少女」様はすでに組織を離れましたが…上層部があの方を気にかけていることに嘘偽りはありません。それに、今の「博士」様の行動は不可解極まりない。我々も目が離せません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030126
					],
					"speakerTitle": "ゲディミナス",
					"speakerSubtitle": "「召使」の部下"
				},
				{
					"id": 60030126,
					"content": "立場上、人々と衝突することも多々ありますが、我々とて義理も情も理解しているつもりです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030127
					],
					"speakerTitle": "ゲディミナス",
					"speakerSubtitle": "「召使」の部下"
				},
				{
					"id": 60030127,
					"content": "あなたたちは「少女」様のご友人ですので、もちろん知る権利があります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030128
					],
					"speakerTitle": "ゲディミナス",
					"speakerSubtitle": "「召使」の部下"
				},
				{
					"id": 60030128,
					"content": "さすがアルレッキーノ、状況判断が早いね。おかげでだいぶ手間が省けた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030129
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 60030129,
					"content": "地図はここに置いておきます。北の研究所へ向かうのであれば、くれぐれもお気をつけください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030130
					],
					"speakerTitle": "ゲディミナス",
					"speakerSubtitle": "「召使」の部下"
				},
				{
					"id": 60030130,
					"content": "どうか忘れないように——少なくともナド・クライでは、「召使」様の部下はあなたたちの味方です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030131
					],
					"speakerTitle": "ゲディミナス",
					"speakerSubtitle": "「召使」の部下"
				},
				{
					"id": 60030131,
					"content": "お気遣い感謝します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030132
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 60030132,
					"content": "当然の務めです。では私はこれで。何かございましたら、クーヴァキ実験設計局へお越しください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030133
					],
					"speakerTitle": "ゲディミナス",
					"speakerSubtitle": "「召使」の部下"
				},
				{
					"id": 60030133,
					"content": "「博士」は実験設計局じゃなくて、一番北の研究所に行ったんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030134
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60030134,
					"content": "「傀儡」の推測が正しければ、ナド・クライに来る前から計画してたってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030135
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 60030135,
					"content": "女皇のためというのはおそらく建前で、別の思惑があるのだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030136
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 60030136,
					"content": "「博士」は行動が早く、そのやり方も残忍で悪質なものだ。手を焼かされるだろう。万全の準備をしないとね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030137
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 60030137,
					"content": "現状、「博士」の行動は予測しがたいものです。二手に分かれ、一部をナシャタウンの守衛に充てるのが得策かと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030138
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 60030138,
					"content": "えっと…アイノもお手伝いしたいけど、研究所への潜入にはあんまり向いてないかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030152
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 60030152,
					"content": "そうだ、「落ち着いた方がいいカモ」を持って行って。戦闘で役に立つはずだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030139
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 60030139,
					"content": "では、イネファさんもアイノさんを守るために残るということでよろしいでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030140
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 60030140,
					"content": "行動ロジックを検知——アイノの保護の優先度は極めて高くなっております。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030141
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 60030141,
					"content": "万が一に備え、ファルカさんも残ったほうがよいだろう。研究所は私たちに任せてほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030142
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 60030142,
					"content": "北風騎士としては留守番なんて性に合わんが…まあ仕方ない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030143
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 60030143,
					"content": "ナシャタウンは俺に任せておけ。お前たちも気をつけろよ。手に負えなくなったら、すぐ撤退しろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030144
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 60030144,
					"content": "ヤフォダにも手伝わせよう。あたしがいない間の情報収集はこの子に任せるといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030145
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 60030145,
					"content": "了解、ボス。みんな、無事に帰ってきてくれよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030146
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 60030146,
					"content": "ああ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030147
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 60030147,
					"content": "では、さっそく発つとしましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030148,
						60030149
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 60030148,
					"content": "今回は危険かもしれないから…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030150
					]
				},
				{
					"id": 60030150,
					"content": "研究所への潜入か…わかった。おまえたちが本気でやり合うつもりなら、オイラは他のやつらの手伝いをしてるぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030151
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60030151,
					"content": "全力で事に当たる必要がありそうだ。行く前に何かやり残したことはあるかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030401,
						60030601
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 60030401,
					"content": "まだやっておきたいことがある…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030402
					]
				},
				{
					"id": 60030402,
					"content": "じゃあ、あんたの準備ができたら出発しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 60030601,
					"content": "いつでも出発できる！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030602
					]
				},
				{
					"id": 60030602,
					"content": "よし、みんな行動開始だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030603
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60030603,
					"content": "ああ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 60030149,
					"content": "パイモンは残ってみんなを手伝って。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030150
					]
				},
				{
					"id": 60030106,
					"content": "状況をもう一度整理しよっか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030107
					]
				},
				{
					"id": 60030107,
					"content": "ハハッ、なんだ緊張してんのか？まあ無理もない。こんな事態、みんな初めてだろうしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030108
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 60030108,
					"content": "少し前、コロンビーナが「博士」に襲われた…お前はその時、彼女が「月の影」に消える瞬間を見たんだったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030109
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 60030109,
					"content": "当時、旅人以外の者は「博士」が何らかの力を使ったところしか見ておらぬ。その後、コロンビーナさんは姿を消し、そなたが空から海へと落ちてきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030110
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 60030110,
					"content": "目下の急務はコロンビーナの救出。それから、ファデュイ執行官「博士」はなぜ三月の力を奪ったのか…それを突き止め、阻止しなきゃならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030111
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 60030111,
					"content": "本来であれば、「月神」を取り戻すことは私たち霜月の子の役目のはずだ。皆の協力に、霜月の子を代表して心より感謝しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030112
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 60030112,
					"content": "削除",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030113
					]
				}
			]
		},
