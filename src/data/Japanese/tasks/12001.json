			},
			"dialogs": [
				{
					"id": 120010801,
					"content": "調べたいことがあるとか言ってたくせに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010802
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120010802,
					"content": "結局、本を読む場所を変えただけじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010803
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120010803,
					"content": "茂才公の商売が分かったよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010804
					]
				},
				{
					"id": 120010804,
					"content": "なるほど、予想通りかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010805
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120010805,
					"content": "本当に予想してたのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010806
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120010806,
					"content": "策はもう考えたよ。この手紙を「飛雲商会」に届けてくれないか？彼らなら、何をすべきか分かってくれるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010807
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120010807,
					"content": "訳あって、僕は一緒に行けないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010808
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120010808,
					"content": "手紙の内容は読まないでくれよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010809
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120010809,
					"content": "うわっ、汚い字だな！こんな字、読もうと思っても読めないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010810,
						120010811
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120010810,
					"content": "古代文字かな？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010812
					]
				},
				{
					"id": 120010812,
					"content": "ふむ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010813
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120010813,
					"content": "だから、読まなくていいと言ったんだ…読んでも読まなくても意味がないからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010814
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120010814,
					"content": "「飛雲商会」には、この手紙を読める人がいるから心配ない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010815
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120010815,
					"content": "けど、あの「飛雲商会」が協力してくれるのか？あそこって璃月の大商会の一つだろ、オイラたちに協力してくれる理由が見当たらないけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010816
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120010816,
					"content": "「飛雲商会」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010817
					]
				},
				{
					"id": 120010817,
					"content": "璃月に来てから、よくその名前を耳にするだろ？いろんな事業がその商会と関係してるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010818
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120010818,
					"content": "そんな大商会が協力してくれるんならもちろん助かるけど、協力のあてはあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010819
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120010819,
					"content": "それなら心配ない。僕の考えが正しければ、彼らには僕と同じ義侠の心がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010820
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120010820,
					"content": "この真摯な手紙を読めば、きっと助けてくれるさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010821,
						120010822
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120010821,
					"content": "本当に？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010823
					]
				},
				{
					"id": 120010823,
					"content": "茂才公にお仕置きするなら、僕たちの力だけじゃ足りないからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010824
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120010824,
					"content": "それに僕がしたって、他の人に知られたくないし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010825
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120010825,
					"content": "常九に恩返しするって言ってなかったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010826
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120010826,
					"content": "「ことが終われば衣を払い、功と名を深く隠す」、これが義侠の根底だからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010827
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120010827,
					"content": "一滴の水の恩を、湧き出る泉をもって報いる、それが恩返しだ。僕は貸しを作りたくないし、お返しもいらない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010828
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120010828,
					"content": "かっこいいこと言って、本当は本の続きを読みたいだけだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010829
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120010829,
					"content": "では、手紙を「飛雲商会」に届ける件は頼んだぞ。彼は琉璃亭の近くにいるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010830
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120010830,
					"content": "無視するな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120010822,
					"content": "どうして飛雲商会に？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010823
					]
				},
				{
					"id": 120010811,
					"content": "暗号文かな？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010812
					]
				}
			]
		}
	]
