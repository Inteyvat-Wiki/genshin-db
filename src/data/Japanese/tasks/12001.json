			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120010201,
					"content": "むっ、どうすれば茂才公が「ファデュイ」と結託してるかどうか分かるかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010202,
						120010203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120010202,
					"content": "決定的な証拠が必要だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010204
					]
				},
				{
					"id": 120010204,
					"content": "じゃあ…いっそ探しに行くか？現場を目撃したら一番だけど、目撃できなくても驚かしてみたら全部教えてくれるかも！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120010205,
					"content": "まずは門番に聞いてみよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010206
					]
				},
				{
					"id": 120010206,
					"content": "任せた！オイラは合わせるかな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120010203,
					"content": "現場を目撃できたらいいのに…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010204
					]
				}
			]
		},
		{
			"id": 1200103,
			"completionStepIds": [
				1200103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200103",
							"2"
						],
						"stepId": 1200103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"大武"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120010301,
					"content": "何者だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010302,
						120010304
					],
					"speakerTitle": "大武"
				},
				{
					"id": 120010302,
					"content": "モンドからの商人で、茂才公と約束している。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010303
					]
				},
				{
					"id": 120010303,
					"content": "ん？それなら連絡が来ているはずだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010306
					],
					"speakerTitle": "大武"
				},
				{
					"id": 120010306,
					"content": "旦那様は本日急な用件がある故、面会は全て取り消しされたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010307
					],
					"speakerTitle": "大武"
				},
				{
					"id": 120010307,
					"content": "「用件」って…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120010308,
					"content": "旦那様は近頃ある事業で忙しくてな、今日も朝から大事な客人を迎えに行かれた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010309
					],
					"speakerTitle": "大武"
				},
				{
					"id": 120010309,
					"content": "今、どこにいるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120010310,
					"content": "すまないが、誰にも言うなと旦那様に言われている…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010311
					],
					"speakerTitle": "大武"
				},
				{
					"id": 120010311,
					"content": "こっちは客人ではないというの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010312
					]
				},
				{
					"id": 120010312,
					"content": "いやいや、そういう意味じゃないんだ。気を悪くしたならすまない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010313,
						120010314
					],
					"speakerTitle": "大武"
				},
				{
					"id": 120010313,
					"content": "会わせてくれないとただで済むと思うなよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010315
					]
				},
				{
					"id": 120010315,
					"content": "すまない、悪かった！旦那様は今、新月軒にいるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010316
					],
					"speakerTitle": "大武"
				},
				{
					"id": 120010316,
					"content": "どうか許してくれ、旦那様には言わないでくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010317
					],
					"speakerTitle": "大武"
				},
				{
					"id": 120010317,
					"content": "フン、こっちも急用があるからな、今日のところは許してやるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010318
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120010318,
					"content": "茂才公との商談が上手くいったら、おまえの無礼を忘れてやる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010319
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120010319,
					"content": "か、感謝する！その商談に岩神様のご加護があらんことを！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010320
					],
					"speakerTitle": "大武"
				},
				{
					"id": 120010320,
					"content": "おまえに演技ができたなんてな、知らなかったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010321,
						120010323
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120010321,
					"content": "ついね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010322
					]
				},
				{
					"id": 120010322,
					"content": "おまえに騙されないよう、オイラも気を付けないとな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010325
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120010325,
					"content": "けど、あの門番が言ってた大事な客人って、たぶん「ファデュイ」のことだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010326,
						120010327
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120010326,
					"content": "そうだと思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010328
					]
				},
				{
					"id": 120010328,
					"content": "おう、さっそく新月軒に行こう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120010327,
					"content": "来るタイミングがよかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010328
					]
				},
				{
					"id": 120010323,
					"content": "パイモンもなかなか。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010324
					]
				},
				{
					"id": 120010324,
					"content": "へへっ、オイラに礼をしたいなら、美味しいものを奢ってくれよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010325
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120010314,
					"content": "その旦那様に言いつけてやる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010315
					]
				},
				{
					"id": 120010304,
					"content": "#{NICKNAME}です、招待されたので来た。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010305
					]
				},
				{
					"id": 120010305,
					"content": "おかしいな、名簿にそんな名前はないが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010306
					],
					"speakerTitle": "大武"
				}
			]
		},
		{
			"id": 1200107,
			"completionStepIds": [
				1200107
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200107",
							"2"
						],
						"stepId": 1200107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"茂才公"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120010701,
					"content": "ええ、分かっています。必ずや注文は成し遂げます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010702
					],
					"speakerTitle": "茂才公"
				},
				{
					"id": 120010702,
					"content": "しかし、部下の話によると、進捗はあまり良くないようだが…協力的ではない人間がいるとか、そうだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010703
					],
					"speakerTitle": "デットエージェント"
				},
				{
					"id": 120010703,
					"content": "あっ…ええ、材料の仕入れに少しトラブルがありまして、石珀がまだ入手できていないんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010704
					],
					"speakerTitle": "茂才公"
				},
				{
					"id": 120010704,
					"content": "でも、心配いりません。あの常九殿が売ってくれなくても、別の者から買えばいいだけの話です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010705
					],
					"speakerTitle": "茂才公"
				},
				{
					"id": 120010705,
					"content": "なら、いいだろう。前にも言ったが、「ファデュイ」は結果を重んじる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010706
					],
					"speakerTitle": "デットエージェント"
				},
				{
					"id": 120010706,
					"content": "そのためなら「ファデュイ」は支援するが、期限通りに納品できないなら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010707
					],
					"speakerTitle": "デットエージェント"
				},
				{
					"id": 120010707,
					"content": "我々の善意もタダではないということを覚えておけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010708
					],
					"speakerTitle": "デットエージェント"
				},
				{
					"id": 120010708,
					"content": "ええ、分かっていますとも。お世話になっているんですから、期待を裏切るわけにはいきません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010709
