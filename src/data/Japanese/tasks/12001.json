					"speakerTitle": "茂才公"
				},
				{
					"id": 120010709,
					"content": "ああ、結果が楽しみだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010710
					],
					"speakerTitle": "デットエージェント"
				},
				{
					"id": 120010710,
					"content": "フン、常九め…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "茂才公"
				},
				{
					"id": 610045701,
					"content": "茂才公、やっぱり「ファデュイ」と手を組んでるみたいだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 610045702,
					"content": "このことを本の虫に報告しよう。あっちもうまくいってるといいけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
