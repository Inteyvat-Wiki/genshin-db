			"dialogs": [
				{
					"id": 740410101,
					"content": "ブロイ、その二つの観測所のデータなんだけど、もう手に入れたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740410102,
					"content": "本当か！？それは何よりだ！早速だけどそれを見せてくれないかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410103,
						740410104
					],
					"speakerTitle": "ブロイ"
				},
				{
					"id": 740410103,
					"content": "はい、これ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410107
					]
				},
				{
					"id": 740410107,
					"content": "以前集めたテープをブロイに渡した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740410108
					]
				},
				{
					"id": 740410108,
					"content": "あああっ、そう、これだよこれ！二人はまるで天から私の苦難を救いにきた天使だ！美しく幸せで悠々自適な生活を取り戻すための——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410109
					],
					"speakerTitle": "ブロイ"
				},
				{
					"id": 740410109,
					"content": "さすがに大げさすぎるだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740410110,
					"content": "とにかく善は急げだ。親切な冒険者さん！主管に中央処理ステーションの鍵を申請するから、少しだけ待っててくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410111
					],
					"speakerTitle": "ブロイ"
				},
				{
					"id": 740410111,
					"content": "はぁ、まったく…急いでくれよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740410112,
					"content": "しばらくして、ブロイが興奮した様子で戻ってきた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740410113
					]
				},
				{
					"id": 740410113,
					"content": "冒険者さん、鍵は手に入れたよ！あとは中央処理ステーションに行ってこれらのデータをまとめれば、水文観測事業は無事に元の状態に戻せるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410114,
						740410115
					],
					"speakerTitle": "ブロイ"
				},
				{
					"id": 740410114,
					"content": "へえ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410116
					]
				},
				{
					"id": 740410116,
					"content": "「パート·ドゥ·フリュイ観測所」と「クレームクレープシュゼット観測所」の状況を考えると、中央処理ステーションにもスネージナヤの連中がいる可能性があるからね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410117
					],
					"speakerTitle": "ブロイ"
				},
				{
					"id": 740410117,
					"content": "だから…お願いだ、どうか一緒に来てほしい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410118
					],
					"speakerTitle": "ブロイ"
				},
				{
					"id": 740410118,
					"content": "うぅ…その代わりオイラたちへの報酬を忘れるなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740410115,
					"content": "そんなことまで一緒についていく必要ある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410116
					]
				},
				{
					"id": 740410104,
					"content": "報酬は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410105
					]
				},
				{
					"id": 740410105,
					"content": "それは…心配しないでくれ！主管が本来の水文研究を再開するのを許可してくれたら、報酬は必ず支払おう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410106
					],
					"speakerTitle": "ブロイ"
				},
				{
					"id": 740410106,
					"content": "へへっ、ならいいんだけどさ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410107
					],
					"speakerTitle": "パイモン"
				}
			]
		},
