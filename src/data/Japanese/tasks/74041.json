			"dialogs": [
				{
					"id": 740410601,
					"content": "えーと、どれどれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410602
					],
					"speakerTitle": "ブロイ"
				},
				{
					"id": 740410602,
					"content": "前に集めたデータをまとめることができれば、素晴らしい成果を得られるに違いない…水文観測を復旧させられるのももうすぐだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410603
					],
					"speakerTitle": "ブロイ"
				},
				{
					"id": 740410603,
					"content": "おおっ、そりゃよかったな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740410604,
					"content": "んっ？なんだか一部のデータが足りないような…気のせいかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410605
					],
					"speakerTitle": "ブロイ"
				},
				{
					"id": 740410605,
					"content": "なんでそこで自信なさげなんだよ！おまえが責任を受け持ってるデータじゃないのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410606
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740410606,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410607
					],
					"speakerTitle": "マリノフスキー"
				},
				{
					"id": 740410607,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410608
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740410608,
					"content": "…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410609
					]
				},
				{
					"id": 740410609,
					"content": "…ええと、すみません。部屋を間違えました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410610
					],
					"speakerTitle": "マリノフスキー"
				},
				{
					"id": 740410610,
					"content": "ファデュイの指揮官は、その体型に見合わず素早く、飛ぶように逃げ去っていった…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740410611
					]
				},
				{
					"id": 740410611,
					"content": "…えっと、いま通ったのって…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410612,
						740410613
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740410612,
					"content": "ヴィシャップよりも速かった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410614
					]
				},
				{
					"id": 740410614,
					"content": "い…今はそんなこと気にしてる場合じゃないだろ！ファデュイだぞ！どうしてここにいるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410615
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740410615,
					"content": "#{NICKNAME}、急いでさっきのやつを追いかけて、問いただそうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740410613,
					"content": "なんて素早いやつ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410614
					]
				}
			]
		},
