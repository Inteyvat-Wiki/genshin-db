				]
			},
			"dialogs": [
				{
					"id": 740411301,
					"content": "な、殴らないで！投降しますから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411302
					],
					"speakerTitle": "マリノフスキー"
				},
				{
					"id": 740411302,
					"content": "こ…このテープを探しに来たんでしょう？全部あげますから、もう勘弁してください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411303
					],
					"speakerTitle": "マリノフスキー"
				},
				{
					"id": 740411303,
					"content": "ファデュイの指揮官はおとなしくすべての研究データを差し出した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740411304
					]
				},
				{
					"id": 740411304,
					"content": "どうだ？ブロイ、これで全部か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740411305,
					"content": "えーと…たぶん？うん、間違いない！これで全部だと思うよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411306
					],
					"speakerTitle": "ブロイ"
				},
				{
					"id": 740411306,
					"content": "はぁ、今のは聞かなかったことにしとくな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740411307,
					"content": "目的は何？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740411308
					]
				},
				{
					"id": 740411308,
					"content": "おとなしく全部話せよな！おまえらが観測所を占領した理由はなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740411309,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411310
					],
					"speakerTitle": "マリノフスキー"
				},
				{
					"id": 740411310,
					"content": "それは…サボるためで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411311
					],
					"speakerTitle": "マリノフスキー"
				},
				{
					"id": 740411311,
					"content": "…は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740411312,
					"content": "僕はマリノフスキーっていいます。第三十四独立偵察小隊の隊長です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411313
					],
					"speakerTitle": "マリノフスキー"
				},
				{
					"id": 740411313,
					"content": "最初、フォンテーヌに派遣されたばかりの頃はみんな楽しく過ごしていたし、大変な任務なんてなかったんです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411315
					],
					"speakerTitle": "マリノフスキー"
				},
				{
					"id": 740411315,
					"content": "ええと…つまり観測所を占領したのと、どういう関係があるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411316
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740411316,
					"content": "それが、数ヶ月前に人事異動でスネージナヤから来た「シュミロフ」というやつが僕のところに配属されて、新しい副官に就任したんですよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411317
					],
					"speakerTitle": "マリノフスキー"
				},
				{
					"id": 740411317,
					"content": "シュミロフ？ああ、クレームクレープシュゼット観測所で見かけた小隊長か…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411318
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740411318,
					"content": "そうです！僕はあいつがもうウンザリなんです！かといってどうにかすることもできない。だから、任務という口実を作って外出してあいつを避けることしか——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411319
					],
					"speakerTitle": "マリノフスキー"
				},
				{
					"id": 740411319,
					"content": "待てよ、よくわからないんだけどさ…そのシュミロフってやつは、おまえの副官なんだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411320
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740411320,
					"content": "そうですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411321
					],
					"speakerTitle": "マリノフスキー"
				},
				{
					"id": 740411321,
					"content": "だったら、おまえの部下なんだろ？なんで上司が部下にビクビクしてんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411322
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740411322,
					"content": "あの忌々しいやつは確かに僕の部下ですが、いつも厳粛な顔つきで周囲に仕事を頑張らせようとするんです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411323
					],
					"speakerTitle": "マリノフスキー"
				},
				{
					"id": 740411323,
					"content": "やつの言葉は、どれも言い返しようのない正論で…でも本当は全然働きたくないだなんて、みんな大っぴらには言えないでしょう！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411324
					],
					"speakerTitle": "マリノフスキー"
				},
				{
					"id": 740411324,
					"content": "それで、偶然近くに不思議な塔が見えたので、思い切ってここを調査するという名目で共律庭の手紙を偽造したんです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411325
					],
					"speakerTitle": "マリノフスキー"
				},
				{
					"id": 740411325,
					"content": "おまえたちが偽造したもんだったのかよ！まぁ、よく考えればそっか…共律庭が水文観測所の管理をおまえらに任せるはずないもんな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411326
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740411326,
					"content": "ブロイ、他になにか聞いておくことはあるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411327
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740411327,
					"content": "うーん…なるほどね。君たちが観測所を占拠したのはサボりたかったから…いや…ただ、この騒々しい世界でひと時の安らぎを得ようとしたからだった、と。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411328
					],
					"speakerTitle": "ブロイ"
				},
				{
					"id": 740411328,
					"content": "それで？ここで過ごした休息の時間はどうだった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411329
					],
					"speakerTitle": "ブロイ"
				},
				{
					"id": 740411329,
					"content": "は…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411330
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740411330,
					"content": "その…快適でしたよ？周りの風景もきれいだし、少し昼寝すれば気持ちが楽になって心地よくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411331
					],
					"speakerTitle": "マリノフスキー"
				},
				{
					"id": 740411331,
					"content": "そうだろう？特に、目が覚めたとき目の前に緊急の仕事が何も転がってなくて、苦手な人が誰も見張ってないって気づいたときは最高だよ。午後の日差しとそよ風を感じていればいいんだから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411332
					],
					"speakerTitle": "ブロイ"
				},
				{
					"id": 740411332,
					"content": "まるで夢から覚めて、何の心配事もない別の夢にもう一度入るみたいな感じですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411333
					],
					"speakerTitle": "マリノフスキー"
				},
				{
					"id": 740411333,
					"content": "そうそう、それこそ私たちの生活！ところで、まだヴァザーリ回廊が数量限定で販売している紅茶を味わったことはないだろう？良かったら、今度一緒に——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411334
					],
					"speakerTitle": "ブロイ"
				},
				{
					"id": 740411334,
					"content": "ちょっと待った！なんでいきなり訳のわからない話題になってるんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411335
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740411335,
					"content": "もういいや、おとなしくオイラたちと一緒に来てもらうぞ！フォンテーヌ科学院におまえの罪を全部吐いてもらうからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411336
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740411336,
					"content": "そ、そんな——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411337
					],
					"speakerTitle": "マリノフスキー"
				},
				{
					"id": 740411337,
					"content": "ま、待ってくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411338
					],
					"speakerTitle": "ブロイ"
				},
				{
					"id": 740411338,
					"content": "恩人の二人とも！この方は、実際には私たちの水文研究に対して何もしていない、そうだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411339
					],
					"speakerTitle": "ブロイ"
				},
				{
					"id": 740411339,
					"content": "見方を変えれば、私たちのためにデータの一部を収集してくれた人とも言える…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411340
					],
					"speakerTitle": "ブロイ"
				},
				{
					"id": 740411340,
					"content": "何よりも、彼だってただ純粋に仕事がイヤで、美しく幸せで悠々自適とした暮らしを送りたかっただけなんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411341
					],
					"speakerTitle": "ブロイ"
				},
				{
					"id": 740411341,
					"content": "そ、そうです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411342
					],
					"speakerTitle": "マリノフスキー"
				},
				{
					"id": 740411342,
					"content": "いや…なんか意気揚々と言ってるけどさ。それって自慢できるようなことじゃないからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411343
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740411343,
					"content": "お願いだ、親切な冒険者さん！今回は科学の名に免じて、寛大な心で彼を許してあげてくれないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411344,
						740411345
					],
					"speakerTitle": "ブロイ"
				},
				{
					"id": 740411344,
					"content": "科学とは関係ないような気もするけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740411346
					]
				},
				{
					"id": 740411346,
					"content": "あ…ありがとうございます、皆さん！もう絶対にこんなことはしないと誓います！これからは、全力を尽くして自分の力でサボってみせます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411347
					],
					"speakerTitle": "マリノフスキー"
				},
				{
					"id": 740411347,
					"content": "そう！重要なのはその心意気だよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411348
					],
					"speakerTitle": "ブロイ"
				},
				{
					"id": 740411348,
					"content": "ヘンなところで闘志を燃やすなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411349
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740411349,
					"content": "ファデュイの指揮官は、深く感謝しながら去っていった…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740411350
					]
				},
				{
					"id": 740411350,
					"content": "よし！問題は無事解決したし、私も戻ってデータを整理しようかな！",
