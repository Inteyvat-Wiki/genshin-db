				"points": []
			},
			"dialogs": [
				{
					"id": 715220101,
					"content": "本当にヒラメキに満ちたゲームだ!ハハハ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220102
					],
					"speakerTitle": "ブイス"
				},
				{
					"id": 715220102,
					"content": "新しいゲームがあるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715220103
					]
				},
				{
					"id": 715220103,
					"content": "旅人！ちょうどいいところに来た、私が作ったこのゲームで遊んでみてほしいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220104
					],
					"speakerTitle": "ブイス"
				},
				{
					"id": 715220104,
					"content": "ほらこっちだ、名前は「ドバッとピキーン！」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220105
					],
					"speakerTitle": "ブイス"
				},
				{
					"id": 715220105,
					"content": "我々詩人が詩を書く時の全過程を完璧に再現したものだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220106,
						715220110
					],
					"speakerTitle": "ブイス"
				},
				{
					"id": 715220106,
					"content": "お酒、お酒、またお酒ってこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715220107
					]
				},
				{
					"id": 715220109,
					"content": "詳しく教えて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715220110
					]
				},
				{
					"id": 715220107,
					"content": "ハハハ、本当にユーモアのあるお方だ。酒でヒラメキを刺激するのは確かにいい方法だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220108
					],
					"speakerTitle": "ブイス"
				},
				{
					"id": 715220108,
					"content": "だが本当に素晴らしい詩を作りたければ、酒だけでは不充分だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220110
					],
					"speakerTitle": "ブイス"
				},
				{
					"id": 715220110,
					"content": "詩歌創作では、私たちはまずあちこちからヒラメキを探す必要がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220111
					],
					"speakerTitle": "ブイス"
				},
				{
					"id": 715220111,
					"content": "人によっては色々な場所を旅したり、一人物思いに耽ったり、さらには…酒で自分の思考を刺激するのが大好きな人もいる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220112
					],
					"speakerTitle": "ブイス"
				},
				{
					"id": 715220112,
					"content": "これは最も苦しい段階だ。ヒラメキを探している間は、それがどこにあるか分からないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220113
					],
					"speakerTitle": "ブイス"
				},
				{
					"id": 715220113,
					"content": "ほとんどの時間は、私たちに得られたものなど何もないと苛立ち、憂鬱になる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220114
					],
					"speakerTitle": "ブイス"
				},
				{
					"id": 715220114,
					"content": "だが実際には自覚こそないものの、ヒラメキは静かに私たちの脳裏に蓄積されていくのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220115
					],
					"speakerTitle": "ブイス"
				},
				{
					"id": 715220115,
					"content": "きっかけがあれば、ヒラメキは一気に吹き出して、優れた詩…あるいは絵か、他の何かになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220116
					],
					"speakerTitle": "ブイス"
				},
				{
					"id": 715220116,
					"content": "それがゲームになるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715220117
					]
				},
				{
					"id": 715220117,
					"content": "ハハハ！もちろん！詩の創作過程はハッキリしていて、分かりやすい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220118
					],
					"speakerTitle": "ブイス"
				},
				{
					"id": 715220118,
					"content": "ちょうどモンドにボードゲームの制作が得意な人たちがいて、私の考えに興味を持ってくれたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220119
					],
					"speakerTitle": "ブイス"
				},
				{
					"id": 715220119,
					"content": "何度もよく話し合って皆のアイデアを集結させ、「ドバッとピキーン！」というこのゲームがようやく誕生した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220120
					],
					"speakerTitle": "ブイス"
				},
				{
					"id": 715220120,
					"content": "興味があるなら、今からプレイできるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220121
					],
					"speakerTitle": "ブイス"
				},
				{
					"id": 715220121,
					"content": "何度も遊べば、君も詩人になれるかもしれない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ブイス"
				}
			]
		}
	]
}