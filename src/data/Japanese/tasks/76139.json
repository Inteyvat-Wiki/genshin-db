			"dialogs": [
				{
					"id": 761390101,
					"content": "出版業は儲からないし、いっそ投資で稼ぐか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390102
					],
					"speakerTitle": "サビト"
				},
				{
					"id": 761390102,
					"content": "投資証券を見せてくれる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761390103
					]
				},
				{
					"id": 761390103,
					"content": "はいよ！一枚二千モラ、決算は週一回です。へへっ、この袋の中に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390104
					],
					"speakerTitle": "サビト"
				},
				{
					"id": 761390104,
					"content": "…うっ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390105
					],
					"speakerTitle": "サビト"
				},
				{
					"id": 761390105,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761390106
					]
				},
				{
					"id": 761390106,
					"content": "い、いえ、ネフェルさんにご来店いただけるとは思わなくて…と、投資証券をお求めで？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390107
					],
					"speakerTitle": "サビト"
				},
				{
					"id": 761390107,
					"content": "あたしは結構。友達の付き添いで来ただけだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390108
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761390108,
					"content": "投資ビジネスが大繁盛って噂は、本当だったんだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390109
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761390109,
					"content": "いやいや！ぼちぼちですよ、ははは…こんな小さな商売じゃ、大した稼ぎにはなりません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390110
					],
					"speakerTitle": "サビト"
				},
				{
					"id": 761390110,
					"content": "本当に儲かるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761390111
					]
				},
				{
					"id": 761390111,
					"content": "もちろん。敏腕商人サビトのところで投資すれば、絶対に損はしないさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390112
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761390112,
					"content": "そ…そうですね…ははは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390113
					],
					"speakerTitle": "サビト"
				},
				{
					"id": 761390113,
					"content": "今日の運を試してみよう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761390114
					]
				},
				{
					"id": 761390114,
					"content": "今お買い求めいただいたのは…本日発売の短期投資証券でして、なんとその場で損益が計算されるんです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390115
					],
					"speakerTitle": "サビト"
				},
				{
					"id": 761390115,
					"content": "今とっさに思いついたんじゃないだろうな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761390116,
					"content": "えっ…と、とにかく、ご購入いただきありがとうございます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390117
					],
					"speakerTitle": "サビト"
				},
				{
					"id": 761390117,
					"content": "こちらが投資報酬となります。では、良い一日を！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390118,
						761390119
					],
					"speakerTitle": "サビト"
				},
				{
					"id": 761390118,
					"content": "儲かった。ラッキー！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761390120
					]
				},
				{
					"id": 761390120,
					"content": "ほんとか？へへっ、じゃあ鳥の形をしたやつがいいな。オイラ、あれ好きなんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761390121,
					"content": "それじゃあたしも失礼するよ。サビトさんはやっぱり信頼できるいい商人だ。商売の成功を祈ってるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390122
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761390122,
					"content": "どうも、ネフェルさん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390123
					],
					"speakerTitle": "サビト"
				},
				{
					"id": 761390123,
					"content": "…それから、ネフェルさん。前にお願いしたあれの件ですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390124
					],
					"speakerTitle": "サビト"
				},
				{
					"id": 761390124,
					"content": "モノは見つかったよ。ただ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390125
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761390125,
					"content": "焦ることはない。一歩ずつ歩むのが道ってもんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390126
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761390126,
					"content": "そ、そうですね。ネフェルさんの言う通りです…では、どうかお願いします…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "サビト"
				},
				{
					"id": 761390119,
					"content": "さあ、パイモン。飴細工を買いにいこう。",
					"roleType": "TALK_ROLE_PLAYER",
