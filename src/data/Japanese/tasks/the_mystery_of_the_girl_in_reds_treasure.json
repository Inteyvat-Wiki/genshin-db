				"points": []
			},
			"dialogs": [
				{
					"id": 102010301,
					"content": "あっ、秘境の入口がこんなところに！きっと、この中に逃げたんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010302,
						102010303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 102010302,
					"content": "じゃあ、袋の鼠だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010304
					]
				},
				{
					"id": 102010304,
					"content": "はぁ…はぁ……っ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010305
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 102010305,
					"content": "クレー、まだ走れるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 102010306,
					"content": "ここで休んでてもいいぞ？宝物はオイラたちが取り返してきてやるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 102010307,
					"content": "…だ、だめ！クレーも一緒に行く！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010308
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 102010308,
					"content": "モフモフが盗んだのはクレーのものだから、クレーが返してもらうの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010309,
						102010310
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 102010309,
					"content": "勇敢でえらいね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010311
					]
				},
				{
					"id": 102010311,
					"content": "ふふん、クレーだってやればできる子なんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010312
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 102010312,
					"content": "#栄誉騎士の{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}、早く行こう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "クレー"
				},
				{
					"id": 102010310,
					"content": "でも、秘境は危険だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010311
					]
				},
				{
					"id": 102010303,
					"content": "追おう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010304
					]
				}
			]
		},
