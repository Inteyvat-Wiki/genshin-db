			"dialogs": [
				{
					"id": 102010101,
					"content": "着いた！この辺りだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010102
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 102010102,
					"content": "あのね、クレーの宝物はここに埋めてたんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010103
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 102010103,
					"content": "穴が空いてるな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 102010104,
					"content": "待った、そこに誰かいる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010105
					]
				},
				{
					"id": 102010105,
					"content": "アビスの魔術師か！？まさか、ジンが言ってたやつじゃ、モンドの近くをうろついてるっていう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 102010106,
					"content": "あれ？あいつの手、なにか持ってないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 102010107,
					"content": "あーーっ！！クレーの宝物だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010108
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 102010108,
					"content": "なんだって！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 102010109,
					"content": "チッ、助っ人を連れてくるとはな。作戦変更だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010110
					],
					"speakerTitle": "アビスの魔術師"
				},
				{
					"id": 102010110,
					"content": "おい！待て、逃げるな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 102010111,
					"content": "追おう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 1020103,
			"completionStepIds": [
				1020113
