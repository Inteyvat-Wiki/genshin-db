			"dialogs": [
				{
					"id": 102010401,
					"content": "フン、追いつかれたか。少しはやるみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010402
					],
					"speakerTitle": "アビスの魔術師"
				},
				{
					"id": 102010402,
					"content": "だが、ここまでだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010403
					],
					"speakerTitle": "アビスの魔術師"
				},
				{
					"id": 102010403,
					"content": "おい、何をする気だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 102010404,
					"content": "ハッハハハハッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010405
					],
					"speakerTitle": "アビスの魔術師"
				},
				{
					"id": 102010405,
					"content": "人々の噂の中から、最強の人間について情報を集めさせてもらった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010406
					],
					"speakerTitle": "アビスの魔術師"
				},
				{
					"id": 102010406,
					"content": "そしたら、この赤い服のガキが、モンドでも最強の宝を持っているというじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010407
					],
					"speakerTitle": "アビスの魔術師"
				},
				{
					"id": 102010407,
					"content": "その宝が我々の手に渡った以上、お前たちに勝ち目はない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010408
					],
					"speakerTitle": "アビスの魔術師"
				},
				{
					"id": 102010408,
					"content": "そうだな——お前たちでこれの力を試してやろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010409
					],
					"speakerTitle": "アビスの魔術師"
				},
				{
					"id": 102010409,
					"content": "だめ！ぜ、ぜったいにいじっちゃだめ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010410
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 102010410,
					"content": "フン、その焦った顔、今になって怖くなったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010411
					],
					"speakerTitle": "アビスの魔術師"
				},
				{
					"id": 102010411,
					"content": "どれどれ…ふむ、火の印か、ハハハハッ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010412
					],
					"speakerTitle": "アビスの魔術師"
				},
				{
					"id": 102010412,
					"content": "バーーン",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010501
					],
					"speakerTitle": "アビスの魔術師"
				},
				{
					"id": 102010501,
					"content": "あああっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010502
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 102010502,
					"content": "生きるための心得——「怪我人いるところにジン団長あり」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010503
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 102010503,
					"content": "終わった…うぅっ、もうだめだぁ……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010504
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 102010504,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 102010505,
					"content": "クレーの「宝物」って、爆弾だったのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010506,
						102010507
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 102010506,
					"content": "すごい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010508
					]
				},
				{
					"id": 102010508,
					"content": "はー、どうりでクレーがモンドで最強って噂があるわけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010509
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 102010509,
					"content": "少なくとも、オイラは相手にしたくないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010510
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 102010510,
					"content": "でもクレー、なんで逃げてったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010511,
						102010512
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 102010511,
					"content": "生きるための心得とか言ってた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010513
					]
				},
				{
					"id": 102010513,
					"content": "あっ、そうだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010514
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 102010514,
					"content": "<color=#00E1FFFF>騎士団</color>に戻って、ジン団長に今回の一件を報告しよう。",
					"roleType": "TALK_ROLE_NPC",
