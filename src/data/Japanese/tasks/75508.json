			"dialogs": [
				{
					"id": 755080101,
					"content": "あっ！来た来た～！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080102
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 755080102,
					"content": "一番大事なお客さんも到着したことだし、いよいよパーティーも最高潮だね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080103
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 755080103,
					"content": "よっ！ムアラニ！シロネンも来てたんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755080104,
					"content": "それに瑞希も？稲妻から来たのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755080105,
					"content": "うん。ナタの友人って、みんな家族のように接してくれるんだ。だから「流泉の衆」は、あたしにとって第二の故郷って感じなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080106
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 755080106,
					"content": "それに、こっちの支店もちゃんと切り盛りして、できる限りここの人たちの力にならないとね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080107
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 755080107,
					"content": "実際、瑞希の働きぶりはすごいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080108
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755080108,
					"content": "そこらの優等生でさえ、瑞希と比べたら怠け者に見えちゃうくらいね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080109,
						755080110
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755080109,
					"content": "シロネンも瑞希のとこのお客さんだったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755080111
					]
				},
				{
					"id": 755080111,
					"content": "最近、変な夢を見るんだよね。たとえば…四週間だった工期を一週間に変更されるとか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080112
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755080112,
					"content": "あと「丸みを帯びた危険な飾り」が欲しいとかね。しかも、同じように工期を四分の一にされるオマケつき…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080113,
						755080114
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755080113,
					"content": "スライムとキノコン。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755080115
					]
				},
				{
					"id": 755080115,
					"content": "即答かよ！？まさか、夢の中でシロネンに注文したのっておまえじゃないよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755080116,
					"content": "それ…危険って言える？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080117
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755080117,
					"content": "はぁ、工期は別にいいとして、丸いものって加工に手間がかかるから、急いで作ると質が悪くなっちゃうんだよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080118
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755080118,
					"content": "とまあ、夢で厄介な注文をいっぱい受けてさ。なんかおかしく思ったから、仕事を終わらせて瑞希のお店に行ったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080119
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755080119,
					"content": "そしたら効果バツグン。その日の昼寝からもう変な夢を見なくなったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080120
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755080120,
					"content": "ふふっ、シロネンの悩みを解決できてよかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080121
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 755080121,
					"content": "でも変な夢が消えたのは、キミ自身が頑張ったおかげだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080122
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 755080122,
					"content": "とにかく、今はみんな元気ってことで、リラックスするにはもってこいのタイミングだから——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080123
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 755080123,
					"content": "「流泉の衆」の伝統、水上パーティーを開いて、みんなに思いっきり楽しんでもらうことにしたんだ~！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080124,
						755080125
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 755080124,
					"content": "水上パーティー！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755080126
					]
				},
				{
					"id": 755080126,
					"content": "へへっ、遊びつくしてやろうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755080127,
					"content": "…でも初参加だし、美味しい食べ物と飲み物があるってことぐらいしか想像できないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755080128,
					"content": "ナタのみんなはこういうときに、なにして遊ぶんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080129,
						755080130,
						755080131
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755080129,
					"content": "コホラ竜にサーフボードを引っ張ってもらう？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755080132
					]
				},
				{
					"id": 755080132,
					"content": "そ…それって、オイラでも遊べるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080133
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755080133,
					"content": "ほほ～う、もうエクストリームスポーツのとりこになってるみたいだね！あたしも最初に思いついたのがそれだったよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080134
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 755080134,
					"content": "でもね、アミナに真面目な口調でこう言われちゃったんだ…コホンッ…「一般人にこういうのは刺激が強すぎるよ！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080135
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 755080135,
					"content": "「普通のビーチバレーでも、力加減をミスって、ケガさせちゃうケースがあるからね！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080136
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 755080136,
					"content": "「せっかく参加したのに、ケガのせいで楽しく遊べずに嫌な気持ちだけ残すことになったら、瑞希さんの仕事が増えちゃうでしょ！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080137
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 755080137,
					"content": "人の悩みを解決できるのは嬉しいけど、その原因がケガとなるとまた話が別だからね。やっぱり、お客さんには安全に楽しんでもらわないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080138
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 755080138,
					"content": "へへっ、だからこうして瑞希と相談してたってわけ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080139
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 755080139,
					"content": "その顔からして、いい案を思いついたみたいだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080140
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755080140,
					"content": "うん。このイベントを、エクストリームスポーツの経験が浅いからって尻込みしちゃうようなものじゃなく、気軽に参加できるものにするのがいいと思ったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080141
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 755080141,
					"content": "稲妻の「三川花祭」のことをムアラニに話したら、過去のお祭りで行われたミニゲームがちょうどいいんじゃないかってなってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080142
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 755080142,
					"content": "それで考えた結果、ナタの雰囲気に合わせて「秋津羽戯」をアレンジして、リラックスしつつ、爽快感も楽しめる「ビートボール」を思いついたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080143
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 755080143,
					"content": "稲妻のゲームに…ナタの雰囲気を取り入れたのか…これまでに考えたことなかった組み合わせだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080144,
						755080145
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755080144,
					"content": "こだまの子の「ターンテーブル」が見えた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755080146
					]
				},
				{
					"id": 755080146,
					"content": "…へぇ、まだ「ターンテーブル」のボリュームをオンにしてないのに、低音とビートを今から感じ取っちゃうなんてね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080147
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755080147,
					"content": "今回のメインとなる「ビートボール」は、熱い音楽のリズムに合わせて、すべてのブロックをボールで壊すゲームになってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080148
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755080148,
					"content": "直観的にプレイできて、複雑なテクニックもいらない。その上、安全だから誰でも楽しめる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080149
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755080149,
					"content": "もちろん、旅人みたいな才能あるプレイヤーだったら…独特の「ビート」と「深み」を表現できるだろうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080150
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755080150,
					"content": "一つの曲でも、DJによって違った表情を見せるっしょ？リズムゲームもそれとおんなじ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080151
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755080151,
					"content": "もしかすると…「チル」系の音楽も、あんたがプレイしたら「サイケデリック」や「アートコア」みたいな面白い感じになるかもね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080152
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755080152,
					"content": "ちょっと楽しみになってきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080153
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755080153,
					"content": "よ…よくわかんないけど、おまえならきっとできると思うぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080154,
						755080155
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755080154,
					"content": "音楽とゲームの天才になってみせるよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755080156
					]
				},
				{
					"id": 755080156,
					"content": "そうそう、その意気だよ！君とパイモンには、一番楽しんでもらいたいんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080157
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 755080157,
					"content": "お菓子と飲み物を持って、あとで君のプレイを見物させてもらうね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080158
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 755080158,
					"content": "ただし、熱中しすぎないよう気をつけること。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080159
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 755080159,
					"content": "じゃないと、寝てる間も音楽が頭を離れなくなっちゃうかもしれないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080160
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 755080160,
					"content": "へへっ、ありがとな！楽しませてもらうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080161
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755080161,
					"content": "…シロネンって曲を選ぶのが得意だし、もし夢の中で聴くことになっても…きっと大丈夫だよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755080155,
					"content": "そこまで上手くないけど、頑張るよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755080156
					]
				},
				{
					"id": 755080145,
					"content": "ビートを感じる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755080146
					]
				},
				{
					"id": 755080130,
					"content": "クク竜に乗って高い所から落ちる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755080132
					]
				},
				{
					"id": 755080131,
					"content": "ユムカ竜で紐なしバンジージャンプ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755080132
					]
				},
				{
