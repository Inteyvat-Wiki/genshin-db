			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"路通",
					"ガルシア",
					"ジャーヤ"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							3490.198,
							461.138,
							3643.4
						],
						"pointId": 5696
					}
				]
			},
			"dialogs": [
				{
					"id": 741180201,
					"content": "大変立派な劇場ですね。きっとかなりの収益を出しているんでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180202
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180202,
					"content": "劇場か…はぁ、さっさと仕事に取り掛かろう。ここの仕事が片付いたら、ペトリコール町に帰るぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180203
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 741180203,
					"content": "帰ったら、町でパン屋を開く。もうナンバリングマシンも何も知るものか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180204
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 741180204,
					"content": "あ…先生…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180205
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180205,
					"content": "どうした、路通くん？おばけでも見たような顔して。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180206
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 741180206,
					"content": "あぁ…なんてこった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180207
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 741180207,
					"content": "ガルシア…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180208
					],
					"speakerTitle": "ジャーヤ"
				},
				{
					"id": 741180208,
					"content": "ジャーヤ！？なんでここにいるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741180209,
					"content": "本当に奇遇だね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180210
					]
				},
				{
					"id": 741180210,
					"content": "先生、先ほどの言い方はちょっと失礼ではないかと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180211
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180211,
					"content": "シーッ、黙りたまえ、路通くん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180212
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 741180212,
					"content": "#ガルシア、それに{NICKNAME}。ここで会えるなんて嬉しいわ。もしかして、歌劇場の帳簿整理を手伝いに来たの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180213
					],
					"speakerTitle": "ジャーヤ"
				},
				{
					"id": 741180213,
					"content": "じゃあ、もしかしてその帳簿って…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180214
					]
				},
				{
					"id": 741180214,
					"content": "あ、いえ、違うわ。うちの劇団はまだこちらの歌劇場で公演したことはないもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180215
					],
					"speakerTitle": "ジャーヤ"
				},
				{
					"id": 741180215,
					"content": "ただ、私の知る限り、ガルシアは暇なときに歌劇を観に来るような人じゃないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180216
					],
					"speakerTitle": "ジャーヤ"
				},
				{
					"id": 741180216,
					"content": "歌劇場に来た理由はおそらく…仕事を頼まれたからじゃないかってね。違うかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180217
					],
					"speakerTitle": "ジャーヤ"
				},
				{
					"id": 741180217,
					"content": "先生のそばにいる人は、私なんかよりジャーヤさんのほうがよほど相応しいんじゃないかと、心底そう思いますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180218
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180218,
					"content": "ふふっ、私たちはみんなかけがえのない存在よ、親愛なる路通。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180219
					],
					"speakerTitle": "ジャーヤ"
				},
				{
					"id": 741180219,
					"content": "えーと…その…ジャーヤくん、会えて嬉しいよ、俺は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180220
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 741180220,
					"content": "…とか言いつつあまり嬉しくなさそうね。研究が順調じゃないのかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180221
					],
					"speakerTitle": "ジャーヤ"
				},
				{
					"id": 741180221,
					"content": "そんなことも分かるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180222
					]
				},
				{
					"id": 741180222,
					"content": "まあね。彼は私を見て不機嫌になることはないし、あなたや路通のせいで不愉快になることもないでしょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180223
					],
					"speakerTitle": "ジャーヤ"
				},
				{
					"id": 741180223,
					"content": "ガルシアの生活の中で、こんなに彼の機嫌を損ねられるのは、あの「ナンバリングマシン」だけよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180224
					],
					"speakerTitle": "ジャーヤ"
				},
				{
					"id": 741180224,
					"content": "ジャーヤは、なんでガルシアのことをこんなによく分かるんだろ？ずっと会ってなかったのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180225,
						741180226
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741180225,
					"content": "彼女の直感かも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180227
					]
				},
				{
					"id": 741180227,
					"content": "お二人ともカフェにでも行って、ゆっくりお話しされたほうがいいでしょう。何せ、一言二言で説明できることではありませんので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180228
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180228,
					"content": "俺は…あ、いや、喜んで…しかし俺たちは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180229
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 741180229,
					"content": "心配しないでください、先生。ごくごく簡単な計算ですから、僕一人で十分ですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180230
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180230,
					"content": "…まさか仕事が終わるまで、ジャーヤさんをほったらかしにするつもりではありませんよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180231
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180231,
					"content": "ふふ、優しいのね、路通。あとでコーヒーを買ってきてあげるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180232
					],
					"speakerTitle": "ジャーヤ"
				},
				{
					"id": 741180232,
					"content": "ありがとうございます。カフェで先生とゆっくりお過ごしください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180233
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180233,
					"content": "ガルシアとジャーヤは一緒にその場を離れていった…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741180234
					]
				},
				{
					"id": 741180234,
					"content": "本当にカフェに行っちゃった…オイラたち、置いてけぼりにされた気分だぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180235,
						741180236
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741180235,
					"content": "完全に蚊帳の外。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180237
					]
				},
				{
					"id": 741180237,
					"content": "#いいえ、{NICKNAME}さん。ここからが正式な依頼です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180238,
						741180239,
						741180240
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180238,
					"content": "どんな食材を探すの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180241
					]
				},
				{
					"id": 741180241,
					"content": "あはは、冗談がお上手ですね。あなたの時間を無駄にするつもりはありませんからご安心を。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180242
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180242,
					"content": "ガルシア先生と僕は、今まさに危険にさらされているんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180243
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180243,
					"content": "え…えっ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180244
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741180244,
					"content": "あちらに行って話しましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "路通"
				},
				{
					"id": 741180239,
					"content": "どんなパーツを探すの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180241
					]
				},
				{
					"id": 741180240,
					"content": "それとも、あの二人の写真を撮りに行く？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180241
					]
				},
				{
					"id": 741180236,
					"content": "#{M#俺}{F#私}はなんでここにいるんだろう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180237
					]
				},
				{
					"id": 741180226,
					"content": "ガルシアさんが分かりやすいからかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180227
					]
				}
			]
		},
		{
			"id": 7411803,
			"completionStepIds": [
				7411803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
