			"dialogs": [
				{
					"id": 741180401,
					"content": "…やっぱり、あの人はずっとガルシア先生を見張っているようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180402
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180402,
					"content": "カウンター近くのテーブルを見てください。前に帽子を置いている男がいるでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180403
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180403,
					"content": "間違いありません。先日、僕たちを尾行していたやつです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180404,
						741180405
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180404,
					"content": "警察を呼んでくる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180406
					]
				},
				{
					"id": 741180406,
					"content": "通報はいい手ですね…ちょうど近くに警官がいます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180407
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180407,
					"content": "そこにいるメンタ警官には、前にも事件について相談したことがあるんです。僕たちの今の状況をよく分かってくれています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180408
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180408,
					"content": "きっと手を貸してくれるでしょう。警察隊員がそばにいれば、やつらも過激な行動には出ないはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180409
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180409,
					"content": "#{NICKNAME}さん、メンタ警官に状況を説明してきてくださいますか？僕はガルシア先生のほうへ行きます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180410
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180410,
					"content": "では急ぎましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "路通"
				},
				{
					"id": 741180405,
					"content": "警察に通報しよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180406
					]
				}
			]
		},
