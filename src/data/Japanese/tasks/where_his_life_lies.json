				]
			},
			"dialogs": [
				{
					"id": 741180101,
					"content": "…先生、ひとまずペトリコール町に行ったほうがいいかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180102
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180102,
					"content": "グザヴィエさんとフェリックスさんはいませんが、メカントルさんとバビスさんなら、まだ町にいるはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180103
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180103,
					"content": "きっと、あのお二人からアドバイスやヒントをもらえるでしょう。もし上手くいかなかったとしても、せめて愚痴を聞いてもらうことくらいはできるのではないでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180104
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180104,
					"content": "いや、親愛なる路通くん、それはいかんのだ…メカントルとバビスの研究は今まさに飛ぶ鳥を落とす勢いだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180105
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 741180105,
					"content": "先日彼らからもらった手紙には、フォンテーヌ科学院から頭脳明晰な人がペトリコール町に来たと書いてあった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180106
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 741180106,
					"content": "ボシュエという名前らしいが、豊富な学識と見解を備えていて、様々な問題を解決してくれたそうだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180107
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 741180107,
					"content": "それに比べて俺は…はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180108,
						741180109
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 741180108,
					"content": "ガルシアさん？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180110
					]
				},
				{
					"id": 741180110,
					"content": "#{NICKNAME}さん、奇遇ですね。まさかフォンテーヌでお会いできるとは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180111
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180111,
					"content": "…再会したタイミングは、まぁあいにくといった感じですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180112
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180112,
					"content": "#そうだな、実に間の悪い…だがそれでも会えて嬉しいよ、{NICKNAME}くん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180113
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 741180113,
					"content": "うわ…こいつ、相当疲れが溜まってそうだな？目の周りにすごいクマができてるぞ、それになんだか雰囲気も暗いし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741180114,
					"content": "ガルシアさん、一体何があったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180115
					]
				},
				{
					"id": 741180115,
					"content": "僕たち…いえ、先生の研究がちょっと、これまでにない問題にぶつかりまして。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180116
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180116,
					"content": "でも、これを話すとなると長くなります…それに、今からエピクレシス歌劇場に行って、帳簿を整理しないといけなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180117
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180117,
					"content": "その仕事が片付いたら、どこか静かな場所でも探してゆっくりお話ししませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180118
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180118,
					"content": "他の仕事を見つけたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180119
					]
				},
				{
					"id": 741180119,
					"content": "いえ、仕事とは言いましたが、大したものではありません…あちこちで雇われて計算のお手伝いをしているだけです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180120
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180120,
					"content": "最近、エピクレシス歌劇場は多くの劇団を招いていて、全体的な経費精算を急いでやらないといけないようでして。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180121
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180121,
					"content": "そこで、ペトリコール町に帰る資金を貯めるために、僕たち…つまり僕がガルシア先生に代わって、その依頼を引き受けました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180122
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180122,
					"content": "まったく、役不足な仕事だ！ごくごく簡単な計算じゃないか。ナンバリングマシンを使わずとも、俺なら半日で片付けられる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180123
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 741180123,
					"content": "だからこそ資金を稼ぐにはもってこいなんですよ。早く出発しましょう、先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180124
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180124,
					"content": "#そうだ。もしよろしければ、{NICKNAME}さんも一緒に来てくださいませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180125
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180125,
					"content": "あなたのような名高い友人が同行してくだされば、不必要なトラブルに巻き込まれずに済むかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180126
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180126,
					"content": "もちろんそれなりの報酬はお支払いしますので、ご安心ください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180127,
						741180128
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180127,
					"content": "うん、いいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180129
					]
				},
				{
					"id": 741180129,
					"content": "それはどうでしょう…はは、とにかく、さっそく出発しましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "路通"
				},
				{
					"id": 741180128,
					"content": "街中ではトラブルなんか起きないはず。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180129
					]
				},
				{
					"id": 741180109,
					"content": "フォンテーヌに帰ってたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180110
					]
				}
			]
		},
		{
			"id": 7411802,
			"completionStepIds": [
				7411802
			],
