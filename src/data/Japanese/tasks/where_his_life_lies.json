					"content": "実は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180503
					]
				},
				{
					"id": 741180503,
					"content": "メンタ警官に事情を説明した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741180504
					]
				},
				{
					"id": 741180504,
					"content": "…ガルシアさんの件だね。うん、分かった。一緒に行くよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180505
					],
					"speakerTitle": "メンタ"
				},
				{
					"id": 741180505,
					"content": "少なくとも、あの怪しいやつは追い払ってあげないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "メンタ"
