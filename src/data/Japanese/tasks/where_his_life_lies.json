			"dialogs": [
				{
					"id": 741185001,
					"content": "#親愛なる{NICKNAME}さん、何か聞きたいことでも？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185002,
						741185008,
						741185014
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741185002,
					"content": "これからどうするの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741185003
					]
				},
				{
					"id": 741185003,
					"content": "今はまだ、あの人たちの正体を掴めていません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185004
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741185004,
					"content": "事件の届け出はしましたが、現時点では何の手がかりもないので、警察も捜査のしようがないようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185005
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741185005,
					"content": "なにせ、これだけ広いフォンテーヌ廷ですから、警察も付きっきりで僕たちを見守るわけにはいかないでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185006
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741185006,
					"content": "それに…ジャーヤさんまで巻き込んでしまって、事態はさらに複雑になってしまいました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185007
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741185007,
					"content": "ガルシア先生の説得で、ジャーヤさんが一日も早くフォンテーヌを離れていただけることを願うばかりです。そうすれば、なんとか元の計画通りに行動できますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "路通"
				},
				{
					"id": 741185008,
					"content": "ガルシアさんは研究に詰まってるんだよね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741185009
					]
				},
				{
					"id": 741185009,
					"content": "「詰まってる」のは、これ以上性能を向上させられないからです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185010
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741185010,
					"content": "しかし応用できる分野において、「ナンバリングマシン」の活躍は大いに期待できます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185011
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741185011,
					"content": "ただ、ガルシア先生はその応用できる分野にほとんど関心がないようでして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185012
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741185012,
					"content": "そういったことも、先生を苦しめている要因の一つではないかと、私は思っています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185013
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741185013,
					"content": "でも逆に、だからこそ失意の研究者という「役」を先生は見事に演じられているのでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "路通"
				},
				{
					"id": 741185014,
					"content": "またね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741185015
					]
				},
				{
					"id": 741185015,
					"content": "はい。引き続きよろしくお願いします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "路通"
				}
			]
		},
