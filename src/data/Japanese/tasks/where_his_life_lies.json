						],
						"pointId": 5698
					}
				]
			},
			"dialogs": [
				{
					"id": 741180301,
					"content": "…ここなら大丈夫そうですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180302
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180302,
					"content": "最初からお話ししましょう。スメールでナンバリングマシンの改造を手伝っていただいた後、このマシンの性能は飛躍的に向上しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180303
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180303,
					"content": "そして、さらなる改良を加えようと先生は奮い立ったのですが、伝統的な装置の伝動構造には限界があるそうで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180304
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180304,
					"content": "ナンバリングマシンの性能は、これ以上改善の余地がないことが分かりました。そこで僕たちはフォンテーヌに戻って、何かアイデアはないかと探すことにしたんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180305
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180305,
					"content": "ところがフォンテーヌに帰ってくると、ある怪しい人物が突然ガルシア先生のもとを訪ねて来ました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180306
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180306,
					"content": "それで、その人はガルシア先生にこう申し出たんです——研究資金の援助をして、さらに他のパートナーも探してやると。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180307
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180307,
					"content": "しかしそれと引き換えに、ナンバリングマシンに関する設計構想とデータをすべて共有してくれ、という条件を付けてきました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180308,
						741180309
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180308,
					"content": "ガルシアさんはきっと頷かない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180310
					]
				},
				{
					"id": 741180310,
					"content": "そうだぞ！口を開くなり人の研究成果を寄こせなんて、そんなのゆすってるようなもんじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741180311,
					"content": "その通りです。ですから、ガルシア先生はきっぱり断りました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180312
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180312,
					"content": "ただそれ以来、僕とガルシア先生はずっと誰かに尾行されているようでして。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180313
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180313,
					"content": "しかも、僕たちがいない隙に部屋に侵入して、何かを探していたようなんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180314
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180314,
					"content": "部屋は元通りになっていましたが、物色された痕跡をガルシア先生が見つけました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180315
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180315,
					"content": "ひ、ひどすぎるぞ…ほしいものが手に入らないからって、盗もうとするなんて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180316
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741180316,
					"content": "部屋を物色されたことに気づいてから、僕たちは早々にお金を集めてここを離れ、ペトリコール町に帰ろうと決めました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180317
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180317,
					"content": "町に帰ったら、空想クラブの他の先生方に連絡して、一緒にこの問題を解決しようと考えたんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180318
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180318,
					"content": "それにペトリコール町は…はは、ガルシア先生の「ホーム」でもありますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180319
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180319,
					"content": "先生にとって、ペトリコール町ほど安全な場所はありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180320
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180320,
					"content": "もともと今日出発するつもりで、ペトリコール町に向かう準備をしていました。そこで、あなたには護衛をお願いしようと思っていたんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180321
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180321,
					"content": "でもまさか、ここでジャーヤさんにばったり会うなんて…彼女の安全のためにも、まずガルシア先生にはジャーヤさんをフォンテーヌ廷まで送ってもらうしかありませんでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180322,
						741180323
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180322,
					"content": "何をすればいい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180324
					]
				},
				{
					"id": 741180324,
					"content": "この状況では、出発を少し先延ばしにするしかないでしょう。今すぐガルシア先生の元に行っていただけますか？先ほども申し上げたように…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180325
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180325,
					"content": "あなたのような名高い友人が同行してくだされば、不必要なトラブルに巻き込まれずに済むかもしれませんから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180326,
						741180327
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180326,
					"content": "分かった。急いで追いかけるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180330
					]
				},
				{
					"id": 741180330,
					"content": "ガルシア先生はジャーヤさんに事情をありのまま伝えるでしょう。その後どうするかは…ジャーヤさん自身が決めることになります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180331
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180331,
					"content": "とにかく、急いでフォンテーヌ廷へ行きましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "路通"
				},
				{
					"id": 741180327,
					"content": "まさか危険な目に遭ってないよね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180328
					]
				},
				{
					"id": 741180328,
					"content": "いえ、それはたぶん大丈夫でしょう。ガルシア先生がフォンテーヌ廷にいる限り、その周りを多くの警備ロボが巡回しているでしょうし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180329
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180329,
					"content": "万が一、相手が暴力的な手段を使おうとしても、執律庭であれば大半の問題を解決してくれるはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180330
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180323,
					"content": "何か手伝えることは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180324
					]
				},
				{
					"id": 741180309,
					"content": "その人は信用できないと思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180310
					]
				}
			]
		},
