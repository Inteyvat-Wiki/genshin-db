					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771030
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726771030,
					"content": "前、封印されて石になった時、吉法師ずっと立ってた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771031
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726771031,
					"content": "封印が解けた後も、足がずっと変な感じだったの。",
