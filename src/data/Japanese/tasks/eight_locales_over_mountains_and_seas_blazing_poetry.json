			"dialogs": [
				{
					"id": 726770101,
					"content": "ここの景色、すごいだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726770102,
					"content": "階段みたいな水たまり、色がキレイ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770103,
						726770108,
						726770111
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726770103,
					"content": "パイモンと吉法師は語彙力が低いね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770104
					]
				},
				{
					"id": 726770104,
					"content": "#でも本当にすごいんだぞ！この色、{NICKNAME}だったらどう表せるんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770105,
						726770106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726770105,
					"content": "まるで氷元素みたい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770107
					]
				},
				{
					"id": 726770107,
					"content": "なんだよそれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726770113,
					"content": "#でもここの景色は本当にすごいな。{NICKNAME}、ここで会った画家を覚えてるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770114,
						726770116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726770114,
					"content": "フェルメール？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770115
					]
				},
				{
					"id": 726770115,
					"content": "そう、フェルメール！あの時、彼に協力して二つの巨大な像に光る珠を付けただろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726770118,
					"content": "最後には絵も貰ったしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726770119,
					"content": "これかな？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770120
					]
				},
				{
					"id": 726770120,
					"content": "おう！これだ！吉法師、見てみろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726770121,
					"content": "ぬ！これは、写真？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770122
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726770122,
					"content": "違うぞ、これは人が描いた絵だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726770123,
					"content": "ぬ？人は写真を撮れるのに、どうして絵を描いたりするの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770124
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726770124,
					"content": "#うーん…確かに、なんでだろう。{NICKNAME}は分かるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770125,
						726770127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726770125,
					"content": "きっと、自分だけの作品を作りたいんだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770126
					]
				},
				{
					"id": 726770126,
					"content": "なるほど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770130
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726770130,
					"content": "それに、描いたものには心がこもっている。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770131
					]
				},
				{
					"id": 726770131,
					"content": "うんうん、思い描いたものを一つ一つ描いていくのは大変なことだもんな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770132
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726770132,
					"content": "うぅ…吉法師の写真を撮るのは簡単で、苦労しないから、思い入れがないの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770133
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726770133,
					"content": "えっ！そ、そういうことじゃないんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770134
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726770134,
					"content": "絵は時間がかかるから吉法師が疲れちゃう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770135
					]
				},
				{
					"id": 726770135,
					"content": "そうだぞ！絵を描くのにはすごく時間がかかるから、吉法師にはキツイんだ。その間、ずっと同じ姿勢を保ってなきゃいけないだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770136
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726770136,
					"content": "前、封印されて石になった時、吉法師ずっと立ってた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770137
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726770137,
					"content": "封印が解けた後も、足がずっと変な感じだったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770138
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726770138,
					"content": "うう、それは辛かっただろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770139
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726770139,
					"content": "パイモンは飛べるから、足は辛くない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770140
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726770140,
					"content": "そうでもないぞ！こう見えても飛ぶときは体全体を使うから、疲れるんだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770141
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726770141,
					"content": "わぁ！花に火がついてる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770142
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726770142,
					"content": "人の話を聞けよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770143
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726770143,
					"content": "烈焔花？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770144
					]
				},
				{
					"id": 726770144,
					"content": "烈焔花…鎮守の森では見かけないもんな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770145
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726770145,
					"content": "吉法師、欲しいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770146
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726770146,
					"content": "欲しい！暖かそう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770147
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726770147,
					"content": "#じゃあちゃんと{NICKNAME}に頼むんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770148
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726770148,
					"content": "#{NICKNAME}、欲しい！ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770149
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726770149,
					"content": "これが妖狸のお願いの仕方なのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726770127,
					"content": "写真機は高いから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770128
					]
				},
				{
					"id": 726770128,
					"content": "え！？写真機は高いのか？じゃあ普段の戦いや、泳いだり山登りしたりする時、落として壊したりなんかしたら大変じゃないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770129
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726770129,
					"content": "うわぁ…これからは気を付けないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770130
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726770116,
					"content": "誰だっけ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770117
					]
				},
				{
					"id": 726770117,
					"content": "フェルメールだよ！彼に協力して、二つの巨大な像に光る珠を付けただろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726770106,
					"content": "風元素みたい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770107
					]
				},
				{
					"id": 726770108,
					"content": "吉法師はパイモンみたいに語彙力が高いね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770109
					]
				},
				{
					"id": 726770109,
					"content": "パイモンみたいにすごい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770110
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726770110,
					"content": "うーん…そういう意味じゃないと思うけど…とにかく、吉法師は賢いぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726770111,
					"content": "本当にすごいね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770112
					]
				},
				{
					"id": 726770112,
					"content": "ん？おまえも語彙力がないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770113
					],
					"speakerTitle": "パイモン"
				}
			]
		},
