			"dialogs": [
				{
					"id": 726770301,
					"content": "大きい！熱い！火がついた大きな花、すごい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770302
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726770302,
					"content": "すごいだろ？あ、そうだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726770303,
					"content": "吉法師、そのままでいてくれ。写真を撮ってやるよ！",
