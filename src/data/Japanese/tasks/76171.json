					"nextDialogs": [
						761710152
					]
				},
				{
					"id": 761710152,
					"content": "やっぱりそれか。オイラも月落銀がいいと思ってたぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
