				"points": []
			},
			"dialogs": [
				{
					"id": 101200301,
					"content": "あっ、「栄誉騎士」！まさか、こんなところで会うなんて奇遇だね。わたしもちょうどこの辺りを偵察してたところなんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200302
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 101200302,
					"content": "あれ？その表情…なんか嫌なことでもあった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200303
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 101200303,
					"content": "ジン団長から依頼を受けたんだけど…失敗したかもしれない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200304,
						101200305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101200304,
					"content": "話せば長くなる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200306
					]
				},
				{
					"id": 101200306,
					"content": "大丈夫、気にしないで。失敗なんてよくあることだよ。私だって毎回有力な情報を探せるわけじゃないし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200307
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 101200307,
					"content": "だから元気出して！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200308,
						101200309
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 101200308,
					"content": "ありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200310
					]
				},
				{
					"id": 101200310,
					"content": "えへへっ。そうだ、わたしも手伝うよ。一体何が起きたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200311
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 101200311,
					"content": "ジン団長から、シューベルト·ローレンスっていう人と友好関係を築いてくれって頼まれたんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101200312,
					"content": "でもいざ会ってみたら、すごく変わった性格をしてて、まともに話すら聞いてもらえなかったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101200313,
					"content": "あっ、わたしその人知ってるよ！きっと礼儀知らずって言われたんでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200314,
						101200315
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 101200314,
					"content": "知ってたんだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200316
					]
				},
				{
					"id": 101200316,
					"content": "あははっ、わたしも何回も言われたよ。ローレンス家の人はそういうことにこだわるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200317
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 101200317,
					"content": "えっ？みんなそうなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200318
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101200318,
					"content": "貴族は貴族なりの矜持を持つべきだ、っていうのが彼らの考えだね。まぁ…言ってる意味は分かるけど、この時代を生きる人じゃないって感じがするかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200319
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 101200319,
					"content": "でも、中にはそうじゃない人もいるんだよ。例えば、わたしの友達のエウルアとか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200320
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 101200320,
					"content": "と、友達？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200321
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101200321,
					"content": "そう、彼女はローレンス家の人間だけど、同時に騎士団の第4小隊の隊長でもあるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200322,
						101200323
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 101200322,
					"content": "ローレンス家は騎士団を敵視してるはず。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200324
					]
				},
				{
					"id": 101200324,
					"content": "エウルアは特別なの。彼女は一族の人と違って、自分の考えを持って行動をしてるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200325
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 101200325,
					"content": "言い換えれば、彼女は一族の規則をあまり気にしてないってことかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200326
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 101200326,
					"content": "あっ、でも彼女もローレンス家の人間との付き合い方をちゃんと理解してるからね。会ってみれば、わたしが言ったことが分かると思うよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200327
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 101200327,
					"content": "でも、そのエウルアっていう人がローレンス家の人間なら、どうしてジン団長はエウルアじゃなくてオイラたちに頼んだんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200328
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101200328,
					"content": "それは、一言では説明できないかな…簡単に言うと、エウルアが騎士団に入ったことで、一族からあまり良く見られてないみたい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200329
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 101200329,
					"content": "彼らからしたら、エウルアは敵に寝返った裏切り者なのかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200330,
						101200331
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 101200330,
					"content": "確かに良くは思われてないかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200332
					]
				},
				{
					"id": 101200332,
					"content": "えへへっ、でも彼女は親しみやすい性格だから、困ってることを伝えたらきっと、シューベルトさんと打ち解ける方法を教えてくれるはずだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200333
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 101200333,
					"content": "たしか朝、望風山地の方へ見回りに出たから、そこに行けば彼女に会えると思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200334
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 101200334,
					"content": "おう、ありがとう、アンバー。じゃあ、さっそく彼女を探しに行こう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200335
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101200335,
					"content": "気をつけてね！わたしも偵察に行かなきゃ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アンバー"
				},
				{
					"id": 101200331,
					"content": "分からなくもないけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200332
					]
				},
				{
					"id": 101200323,
					"content": "ローレンス家でも騎士団に入れるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200324
					]
				},
				{
					"id": 101200315,
					"content": "アンバーも経験したことあったんだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200316
					]
				},
				{
					"id": 101200309,
					"content": "さすがはアンバー、前向きだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200310
					]
				},
				{
					"id": 101200305,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}たちが悪いわけじゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200306
					]
				}
			]
		},
		{
			"id": 1012004,
