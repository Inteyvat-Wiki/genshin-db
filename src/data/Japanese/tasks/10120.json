			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ジン",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101200101,
					"content": "栄誉騎士、忙しいところ来てくれて、感謝する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200102
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 101200102,
					"content": "手短に話そう。騎士団から君に、ある特殊な任務を依頼したい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200103,
						101200105
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 101200103,
					"content": "騎士団は相変わらず忙しいね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200104
					]
				},
				{
					"id": 101200104,
					"content": "あぁ。最近は様々なことが起きていて、私を含めたモンドの騎士団全員が一時も気を緩められない状況だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200107
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 101200107,
					"content": "実はここ最近、ローレンス家の人間がファデュイと深く繋がっているとの報告を騎士団員からたくさん受けているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200108
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 101200108,
					"content": "またファデュイかよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101200109,
					"content": "でもローレンス家って、どんなやつらなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101200110,
					"content": "過去のモンドには、旧貴族によって支配されていた暗黒の時代があった。高塔の王から取り戻した自由に再び枷がかけられ、それにより、奴隷制度に拍車がかかったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200111
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 101200111,
					"content": "初代「蒲公英騎士」ヴァネッサ様が革命を起こし、旧貴族の支配を覆した。そして、西風騎士団を立ち上げ、今のモンドへと変わった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200112
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 101200112,
					"content": "その渦中にあったローレンス家こそが、モンドに苦しみを与えた旧貴族だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200113
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 101200113,
					"content": "あっ、オイラ分かったぞ。悪者の末裔がファデュイと一緒になって、また悪巧みをしてるんだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101200114,
					"content": "今はまだ疑惑の段階だ、確かな証拠はない。今日君たちに来てもらったのは、この件を調査してもらいたいからなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200115,
						101200116
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 101200115,
					"content": "#どうして{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}に？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200117
					]
				},
				{
					"id": 101200117,
					"content": "それは…旧貴族と騎士団は過去、敵対関係にあってな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200118
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 101200118,
					"content": "騎士団は長い年月をかけて、双方の軋轢を解消しようとしたんだが、貴族の末裔は未だ騎士団を敵視している…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200119
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 101200119,
					"content": "私たちがどんな態度で彼らに接しようとも、いい結果にはならないだろう。過剰な反応を引き起こしてしまうだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200120
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 101200120,
					"content": "「調査」という名目で押し入ることは可能だが、もしこちらの早とちりであれば、また彼らに不信感を募らせてしまうかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200121
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 101200121,
					"content": "そうなれば、今までの努力も水の泡となる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200122
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 101200122,
					"content": "#でも{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}も「栄誉騎士」だし…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200123
					]
				},
				{
					"id": 101200123,
					"content": "君は騎士団の中でも最も適任なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200124
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 101200124,
					"content": "その身分を強調する必要はない。君は遠くから旅をしてここへ来た旅人だ、この街の「多数派」ではない。であれば、そこからローレンス家のあの貴族と共通の話題を探すこともできるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200125
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 101200125,
					"content": "彼と友好な関係を築けば、ファデュイとの一件も探れるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200126
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 101200126,
					"content": "さすがジン団長！すみずみまで考えが行き届いてるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101200127,
					"content": "そんなことないさ。ただ外交問題で蓄積してきた経験を生かしただけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200128
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 101200128,
					"content": "そのローレンス家の人間はシューベルトという。最近はモンド北側の城壁付近をうろついているらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200129
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 101200129,
					"content": "とっつきにくい性格のようだが、きちんと向き合って話せば問題ないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200130,
						101200131
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 101200130,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200132
					]
				},
				{
					"id": 101200132,
					"content": "協力感謝する。何か問題があれば、できる限りのサポートはさせてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジン"
				},
				{
					"id": 101200131,
					"content": "うまくいくといいけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200132
					]
				},
				{
					"id": 101200116,
					"content": "それは騎士団の仕事では？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200117
					]
				},
				{
					"id": 101200105,
					"content": "ジン団長らしいね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200106
					]
				},
				{
					"id": 101200106,
					"content": "状況が許せば、私も君とゆっくり話をしたいのだが、今はモンド城の安全を優先しなければならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200107
					],
					"speakerTitle": "ジン"
				}
			]
		},
		{
			"id": 1012002,
			"completionStepIds": [
				1012003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1012003",
							"2"
						],
						"stepId": 1012003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"？？？",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101200201,
					"content": "ん？誰だ貴様は。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200202
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101200202,
					"content": "こんにちは、オイラたちは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101200203,
					"content": "こんにちは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200204,
						101200206
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101200204,
					"content": "こ、こんにちは…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200205
					]
				},
				{
					"id": 101200205,
					"content": "「こんにちは」だと？私の聞き間違いか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200208
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101200208,
					"content": "フンッ、軽々しく挨拶をしてくるなど、軽薄で無礼であるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200209
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101200209,
					"content": "私を知らないとは、無知な外来者か。私はシューベルト·ローレンス、正真正銘貴族の末裔である。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200210
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101200210,
					"content": "私に話しかけたいのなら、言葉を選んだ方がいい。そのような程度の低い言葉は聞くに堪えん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200211
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101200211,
					"content": "さあ、分かったらさっさと片膝をついて、謝罪の言葉と自己紹介でもしたらどうなんだ。それが礼儀というものだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200212
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101200212,
					"content": "えっ？そんな礼儀、聞いたことないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101200213,
					"content": "フンッ、みながそれを弁えていた時代は、そのような礼儀作法など基本中の基本、常識だったのだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200214
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101200214,
					"content": "貴族に対し無礼を働いた場合、少なくとも鞭打ちの刑に処されていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200215
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101200215,
					"content": "それが今はどうだ、規則は廃れ、礼儀作法も忘れ去られた。腐敗しきってみるに堪えない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200216,
						101200217
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101200216,
					"content": "凄く面倒。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200218
					]
				},
				{
					"id": 101200218,
					"content": "なに？旧貴族の尊厳を疑っているのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200219
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101200219,
					"content": "教えてやろう、ローレンス家は確かに没落したものの、我ら末裔は今もなお栄光を取り戻す機会を窺っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200220
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101200220,
					"content": "周りの人間が規則に従わないからこそ、私が貴族の高貴さと礼儀作法を主張し続けなければならない。なぜなら、生まれた時点で格が違うのだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200221
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101200221,
					"content": "まだ何も言ってないんだけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200222
					]
				},
				{
					"id": 101200222,
					"content": "もういい、貴様の言動にはうんざりだ。凡人に話すことなどない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200223
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101200223,
					"content": "それに、貴様に礼儀を教えてやる義理もないしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200224
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101200224,
					"content": "まだ大事な用事があるんだ、失礼する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101200217,
					"content": "道理で旧貴族は没落した。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200218
					]
				},
				{
					"id": 101200206,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200207
					]
				},
				{
					"id": 101200207,
					"content": "「どうした」だと？私の聞き間違いか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200208
					],
					"speakerTitle": "シューベルト"
				}
			]
		},
		{
