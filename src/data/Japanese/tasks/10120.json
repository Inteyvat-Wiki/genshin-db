				"points": []
			},
			"dialogs": [
				{
					"id": 101200401,
					"content": "手際がいいわね。彼らは私が長いこと目を付けていた標的なのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200402
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 101200402,
					"content": "手柄を横取りにされた感じだわ。これが「早い者勝ち」というものかしら？…まったく、この恨み覚えておくわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200403
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 101200403,
					"content": "…うん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101200404,
					"content": "えっと、恨み？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200405
					]
				},
				{
					"id": 101200405,
					"content": "そうよ、ここの異変に気付いて、急いで駆けつけて来たのに、君がファデュイを追い詰めてるんだもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200406
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 101200406,
					"content": "手柄を逃した上に、私が加勢していなかったら、全く無関係の人間に成り下がってたところじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200407
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 101200407,
					"content": "でも、ケガがなくてよかったわ。こんな大勢のファデュイと戦うのは大変だったでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200408,
						101200409
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 101200408,
					"content": "もうファデュイとの戦いは慣れてる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200410
					]
				},
				{
					"id": 101200410,
					"content": "なに言ってるかあんま分かんないけど、オイラたちのことを心配してくれてるんだよな、ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200411
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101200411,
					"content": "はっ？どうして憎むべき相手を心配しなきゃいけないの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200412
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 101200412,
					"content": "でもさっき、「ケガがなくてよかったわ」って…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101200413,
					"content": "あれは、もし君たちがケガをしていたら、手柄を横取りされただけじゃなく、私がモンド城まで君たちを運んであげなきゃいけなかったでしょ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200414
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 101200414,
					"content": "そんなことまでさせられた日には、屈辱で君をかたきとして見ていたところよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200415
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 101200415,
					"content": "そういう意味だったのかよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200416
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101200416,
					"content": "#もしかして{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYSECOND|INFO_FEMALE_PRONOUN_GIRLSECOND]}がエウルア？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200417
					]
				},
				{
					"id": 101200417,
					"content": "ええ、そうよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200418
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 101200418,
					"content": "やっぱり、なんだかおかしいと思ったんだ！まぁ、話が通じないとまではいかないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200419
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101200419,
					"content": "初対面の人に対して「おかしい」だなんて、貴族どころか、普通の人から見ても無礼だと思うけれど？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200420
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 101200420,
					"content": "それよりも、どうして私の名前を知っているの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200421
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 101200421,
					"content": "その礼儀のことと関係してるんだ。こいつは西風騎士団の栄誉騎士で、オイラたちはシューベルト·ローレンスっていう貴族を調査してるんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200422
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101200422,
					"content": "でもその人は礼儀にすごくうるさくて、全然話を聞いてくれないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200423
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101200423,
					"content": "あははっ、なるほど。あの人はそういう人なの、私の伯父よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200424
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 101200424,
					"content": "でも、どうして彼の調査を？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200425
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 101200425,
					"content": "ファデュイと繋がってるかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200426
					]
				},
				{
					"id": 101200426,
					"content": "なるほど、ふふっ、本当にいい度胸をしているのね。私の目の前で一族の悪口を言うなんて。また私の恨みを買いたいのかしら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200427
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 101200427,
					"content": "違うぞ！ジン団長の依頼なんだ！それに、まだ容疑の段階だからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200428,
						101200429
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101200428,
					"content": "気にならないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200430
					]
				},
				{
					"id": 101200430,
					"content": "モンド城の人々には、ローレンス家は悪者に見えるもの。そういう噂が出回ったっておかしくないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200431
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 101200431,
					"content": "たしかに…昔、残酷な支配者だったらしいから、評判もかなり悪いよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200432
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101200432,
					"content": "君もそんな風に考えていたのね…その言葉、忘れないわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200433
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 101200433,
					"content": "えっ？そっちが先に言ってきたのに！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200434
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101200434,
					"content": "あははっ、面白いわ。初対面の人に3回もこんな感情を抱くなんて、こんなに面白い人と会ったのは久しぶりよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200435,
						101200436
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 101200435,
					"content": "「面白い」の？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200437
					]
				},
				{
					"id": 101200437,
					"content": "私を訪ねたのは、ローレンス家の礼儀作法を学んで私の伯父と打ち解けるためよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200438
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 101200438,
					"content": "おう、アンバーの紹介で来たんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200439
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101200439,
					"content": "問題ないわ。今からでも教えてあげる。とりあえずモンド城へ戻りましょう。人がいるところの方が練習になるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200440,
						101200441
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 101200440,
					"content": "さっきの件は和解ってことで？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200442
					]
				},
				{
					"id": 101200442,
					"content": "それとこれとは別よ。代理団長の依頼やアンバーの紹介なら、私も無視はできないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エウルア"
				},
				{
					"id": 101200441,
					"content": "#もしかして、そこで{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}に仕返しを？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200442
					]
				},
				{
					"id": 101200436,
					"content": "なんだか楽しそう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200437
					]
				},
				{
					"id": 101200429,
					"content": "心配しないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200430
					]
				},
				{
					"id": 101200409,
					"content": "戦いは得意。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200410
					]
				}
			]
