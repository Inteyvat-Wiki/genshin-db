			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"葉名山薫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721260101,
					"content": "大変です…どうしたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260102
					],
					"speakerTitle": "葉名山薫"
				},
				{
					"id": 721260102,
					"content": "何があったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721260103
					]
				},
				{
					"id": 721260103,
					"content": "あっ…よかった、あなたが来てくれたなら安心です…実は、あなたから貰った種を植えたのですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260104
					],
					"speakerTitle": "葉名山薫"
				},
				{
					"id": 721260104,
					"content": "少し植えたところで、そこに突然魔物が現れてしまい、そこから離れてくれないんです。もう花を植えに行くことができません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260105
					],
					"speakerTitle": "葉名山薫"
				},
				{
					"id": 721260105,
					"content": "このまま放っておいたら、花を植えた場所が荒らされてしまうかもしれません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260106
					],
					"speakerTitle": "葉名山薫"
				},
				{
					"id": 721260106,
					"content": "もしよければ、魔物を追い払ってもらえないでしょうか？わ、私はただ花を植えたいだけなんです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260107,
						721260109
					],
					"speakerTitle": "葉名山薫"
				},
				{
					"id": 721260107,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721260108
					]
				},
				{
					"id": 721260108,
					"content": "本当ですか？ありがとうございます！それではよろしくお願いします！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "葉名山薫"
				},
				{
					"id": 721260109,
					"content": "何でそんなに花を植えたいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721260110
					]
				},
				{
					"id": 721260110,
					"content": "みんながたたら砂に戻りたくないのは、「御影炉心」の件でもう住めないかもと心配しているからだと思います…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260111
					],
					"speakerTitle": "葉名山薫"
				},
				{
					"id": 721260111,
					"content": "その人たちを一人一人説得することはできませんが、ここに綺麗な花をたくさん植えたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260112
					],
					"speakerTitle": "葉名山薫"
				},
				{
					"id": 721260112,
					"content": "たたら砂がもう安全であると、皆さんに説得できるかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260113
					],
					"speakerTitle": "葉名山薫"
				},
				{
					"id": 721260113,
					"content": "それに…えへへ、花を植える以外に、私にはみんなを説得する方法がありませんから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260114
					],
					"speakerTitle": "葉名山薫"
				},
				{
					"id": 721260114,
					"content": "だから、お願いします。魔物を追い払ってください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "葉名山薫"
				}
			]
		},
