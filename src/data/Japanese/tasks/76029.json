						760290235
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 760290235,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290236
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760290236,
					"content": "…比較中…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290237
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 760290237,
					"content": "ひ、比較って、なにとだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290238
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760290238,
					"content": "ナド・クライの月の神像との類似度…九十五パーセント…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290239,
						760290241
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 760290239,
					"content": "#か…彼女は役者{M#なんだ！}{F#なの！}",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290240
					]
				},
				{
					"id": 760290240,
					"content": "旅人さんの心拍数の上昇を検知しました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290243
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 760290243,
					"content": "終わったよ！これでもう二度と壊れないはず。もらったおか…イ…イネファ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290244
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 760290244,
					"content": "もらった…何ですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290245
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 760290245,
					"content": "も、もらったパーツ、すごく役に立ったよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290246
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 760290246,
					"content": "……？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290247
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 760290247,
					"content": "ん？その人はだれ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290248
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 760290248,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290249,
						760290250
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760290249,
					"content": "修理の依頼人だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290251
					]
				},
				{
					"id": 760290251,
					"content": "（あのお姉さん、どこかで見たことあるような…ま、いっか。そんなことより、パイモンからもらったお菓子をちゃんと隠しとかないと。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290252
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 760290252,
					"content": "そ…その通りだぞ！あと、このパーツ、こいつからお前にって。修理のお礼だってさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290253
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760290253,
					"content": "えっ？見せて見せて…わあ～、どれもレアな年代物だ！本当にもらっていいの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290254
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 760290254,
					"content": "…うん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290255
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760290255,
					"content": "ありがとう！また修理したいものがあったら、いつでも来てね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290256
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 760290256,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290257
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 760290257,
					"content": "えっと…じゃ、じゃあ、オイラたちはそろそろ帰るぜ。アイノ、イネファ、また来るからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290258
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760290258,
					"content": "（イネファに勘付かれる前に、早くコロンビーナを連れてここを離れないと！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290259
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760290259,
					"content": "う…うん！またね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290260
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 760290260,
					"content": "（早くお菓子のカスを片づけないと。イネファにバレちゃったら大変！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290261
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 760290261,
					"content": "さようなら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290262
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 760290262,
					"content": "…アイノ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290263
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 760290263,
					"content": "な…なに？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290264
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 760290264,
					"content": "先ほどもらったパーツですが、供えておきましょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290265
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 760290265,
					"content": "えっ？どうして？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290266
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 760290266,
					"content": "「月神からの贈り物」かもしれませんから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290267
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 760290267,
					"content": "えっ、何言ってるの？…後で回路をチェックしてあげるよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アイノ"
				},
				{
					"id": 760290250,
					"content": "人見知りのお客さんだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290251
					]
				},
				{
					"id": 760290241,
					"content": "ご、誤差も考えないと…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290242
					]
				},
				{
					"id": 760290242,
					"content": "誤差は極めて小さく、信頼できる推論です…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290243
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 760290216,
					"content": "その友達はちょっと人見知りで…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290217
					]
				}
			]
