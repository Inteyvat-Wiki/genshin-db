			"dialogs": [
				{
					"id": 760290201,
					"content": "アイノ！いるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760290202,
					"content": "わあ！パイモンの声だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290203
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 760290203,
					"content": "こんにちは！アイノに会いに来てくれたってことは、きっとお菓子を持ってるんだよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290204
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 760290204,
					"content": "そう言うと思って、ジャジャーン、ちゃんと持ってきたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760290205,
					"content": "早くちょうだい！イネファがもうすぐ帰ってくるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290206
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 760290206,
					"content": "今日はなにして遊ぶ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290207
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 760290207,
					"content": "へへ…実は、アイノに頼みたいことがあるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760290208,
					"content": "うわっ！こ…これ以上近づけないで！そんな怖いもの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290209
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 760290209,
					"content": "怖いもの？このライアーのことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760290210,
					"content": "言ったでしょ、科学や機械で説明できないことは苦手なんだってば…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290211
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 760290211,
					"content": "このライアー…数日おきに玄関先に現れて…修理してるうちにいつの間にか消えちゃうの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290212
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 760290212,
					"content": "お…お化けの仕業とか、そんなの信じないから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290213
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 760290213,
					"content": "えっと…ちょっと誤解があったみたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760290214,
					"content": "誤解？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290215,
						760290216
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 760290215,
					"content": "実は、ある友達のライアーなんだけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290217
					]
				},
				{
					"id": 760290217,
					"content": "でもあいつに悪気はないんだ。こっそり持ち帰ったのには理由があって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760290218,
					"content": "ほんと？嘘じゃないよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290219
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 760290219,
					"content": "うーん…じゃあキミたちを信じて、もっかい見てあげる…今度はばっちり直すから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290220
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 760290220,
					"content": "ちょっと待ってて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290221
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 760290221,
					"content": "アイノのやつ、頼もしいな。謎のお届け物に怖い思いをさせられて可哀想だったけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290222
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760290222,
					"content": "お礼をしないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290223
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760290223,
					"content": "そうだな…うわっ！な、なんでおまえがここにいるんだよ！腰が抜けそうになったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290224
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760290224,
					"content": "これを渡したら帰る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290225
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760290225,
					"content": "ん？なんなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290226
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760290226,
					"content": "職人さんへのお礼にって、月霊が集めた「宝物」。彼女が好きそうだからって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290227
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760290227,
					"content": "わぁ～！変なパーツがいっぱいあるぞ。ちゃんとアイノに渡しておくからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290228
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760290228,
					"content": "帰るときは、人に見られないように気を付けてくれよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290229
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760290229,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290230
					]
				},
				{
					"id": 760290230,
					"content": "パイモン…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290231
					]
				},
				{
					"id": 760290231,
					"content": "ん？どうしたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290232
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760290232,
					"content": "あそこ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290233
					]
				},
				{
					"id": 760290233,
					"content": "……！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290234
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760290234,
					"content": "……",
