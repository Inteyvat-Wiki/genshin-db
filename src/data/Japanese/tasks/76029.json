			"dialogs": [
				{
					"id": 760290101,
					"content": "こんにちは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290102
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760290102,
					"content": "あれ、出かけるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760290103,
					"content": "うん、ライアーの修理に。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290104
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760290104,
					"content": "…えっ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760290105,
					"content": "月霊のライアーが壊れてしまったの。すごく大事にしてたから、修理してあげようと思って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290106
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760290106,
					"content": "月霊って多才なんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760290107,
					"content": "うん、よくここでライアーを弾いてるよ。たまに私も一緒に歌ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290108
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760290108,
					"content": "前から思ってたけど、おまえ、月霊にすごく優しいよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760290109,
					"content": "ええ、あの子たちはずっとそばにいてくれるから。それに、面白いものを見つけたらわざわざ持ち帰ってくれるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290110
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760290110,
					"content": "（ラウマが言ってた——月神を喜ばせようとするのは月霊の本能だって。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290111
					]
				},
				{
					"id": 760290111,
					"content": "でも、どうやって修理なんかするんだ？人に姿を見られちゃまずいだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760290112,
					"content": "えっと…前は、動物や月霊に頼んで、職人さんの家の入口に置いてた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290113
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760290113,
					"content": "職人さんが気づいたら、ついでに修理してくれるんだけど…気付くまで数日かかることもある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290114
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760290114,
					"content": "なんか大変そうだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760290115,
					"content": "よかったら手伝うよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290116
					]
				},
				{
					"id": 760290116,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290117
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760290117,
					"content": "安心しろ。オイラたちが持ってったら、今日中に仕上がるかもだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760290118,
					"content": "…じゃあ、お言葉に甘えて。ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290119
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760290119,
					"content": "いいっていいって。それで、どの職人を尋ねたらいいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760290120,
					"content": "名前は知らないけど…家の前に大きなロボットアームがあって、ホラガイみたいな丸い家に住んでる人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290121
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760290121,
					"content": "（もしかして…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290122
					]
				},
				{
					"id": 760290122,
					"content": "中からクルムカケの香りがすることもあるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290123
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760290123,
					"content": "誰のことか分かったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
