			"dialogs": [
				{
					"id": 733280201,
					"content": "千のハグを！次に会えるのを楽しみにしてるね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280202,
						733280206
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 733280202,
					"content": "次はどこで会えるかな？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280203
					]
				},
				{
					"id": 733280203,
					"content": "さあね？天空の島かも？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280204
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 733280204,
					"content": "ははははっ、冗談だって！でももし君がそこであたしに会いたくなったら、あたしもきっとそこにいるはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280205
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 733280205,
					"content": "なぜかなんて聞かないでね、あたしには分かるんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280208
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 733280208,
					"content": "とにかく、また会えること、期待しててね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 733280206,
					"content": "#{M#君}{F#あなた}にも千のハグを。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280207
					]
				},
				{
					"id": 733280207,
					"content": "ははっ、ありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280208
					],
					"speakerTitle": "ジェイド"
				}
			]
		}
	]
