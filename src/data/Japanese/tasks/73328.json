					"ジェイド"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733280101,
					"content": "おまえは、ジェイド——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733280102,
					"content": "#{NICKNAME}？それにパイモンちゃんも！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280103
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 733280103,
					"content": "ピピー！…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280104
					],
					"speakerTitle": "ブンブン"
				},
				{
					"id": 733280104,
					"content": "ははっ、あたしの言った通り！また会えたね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280105
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 733280105,
					"content": "ここで何をやってるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280106
					]
				},
				{
					"id": 733280106,
					"content": "うーん…大人のオンナの秘密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280107
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 733280107,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733280108,
					"content": "#{M#だから、聞かないでってことだよ！あたしにだってプライバシーがあるの…}{F#酒場かどこかで、あたしのご機嫌を取ってくれれば、教えてあげなくもないよ…これ以上言わないとダメ？}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280109
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 733280109,
					"content": "#{M#ぷっ…ヒョウ局のルールだよ、言えないの、ごめんね。}{F#じょ、冗談だって、本気にしないでよ！ヒョウ局のルールだよ…今回は厳しい秘密保持命令が出てるの、ごめんね。}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280110
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 733280110,
					"content": "ふん、もったいぶるなよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733280111,
					"content": "その…最近はどうしてた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280112,
						733280113
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 733280112,
					"content": "まあまあ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280114
					]
				},
				{
					"id": 733280114,
					"content": "うん…あたしもおんなじ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280115
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 733280115,
					"content": "さて、君を引き留めるのはここら辺にしとくよ。はぁ…まだやらなきゃいけないことが残ってるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280116
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 733280116,
					"content": "えっ、ジェイドってそんなに忙しいのか…前はそんなじゃなかったよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733280117,
					"content": "ふふっ…今は「安定」した仕事を見つけたってところかな。仕事の内容は昔と大差ないんだけどね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280118
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 733280118,
					"content": "ヒョウ局の仕事を見つけてからすぐ、また昔の自由気ままな日々が懐かしくなっちゃった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280119
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 733280119,
					"content": "君のほうがどうしてるのかは知らないけど、あたしはずっと君の物語を期待してるんだよ。あたしからも色々シェアしたいお話があるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280120
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 733280120,
					"content": "でも別に急ぐ必要はないよ。今はまだ…いい物語はためておいて、発酵させてやらないとね。砂漠を旅する人たちは昔、それを頼りに生きてたんだからね！へへっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280121
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 733280121,
					"content": "うん…とにかく、体に気を付けてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280122
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 733280122,
					"content": "ジェイドもね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280123
					]
				},
				{
					"id": 733280123,
					"content": "うん、千のハグを君に。ずっと君のために祈ってるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280124
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 733280124,
					"content": "ピピ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280125
					],
					"speakerTitle": "ブンブン"
				},
				{
					"id": 733280125,
					"content": "ははっ、ブンブンもだってさ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 733280113,
					"content": "普通かな…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280114
					]
				}
			]
		},
		{
