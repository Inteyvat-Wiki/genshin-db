							4345.289,
							158.024,
							4642.497
						],
						"pointId": 4927
					}
				]
			},
			"dialogs": [
				{
					"id": 740620301,
					"content": "（ナクルの話によると、フォンテーヌ出身じゃないと拒否されるみたいだ。オイラたちも相手にされないんじゃないか？なにか良い方法はないかな…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620302,
					"content": "（ドアをノックする。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620303
					]
				},
				{
					"id": 740620303,
					"content": "誰だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620304,
						740620306,
						740620309
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620304,
					"content": "無名の旅人、国をまたにかける冒険者。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620305
					]
				},
				{
					"id": 740620305,
					"content": "…ここはいつから観光名所になったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620312
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620312,
					"content": "#{NICKNAME}、真面目にやれって。目的を忘れるなよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620313,
						740620378
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620313,
					"content": "依頼を受けて交渉に来た。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620314
					]
				},
				{
					"id": 740620314,
					"content": "実はある人に頼まれて相談に来たんだ。この部屋を貸してくれないか？もちろん、依頼人が特別許可券を払うぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620315
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620315,
					"content": "似たような話を前にも聞いたな…何度も何度も、諦めの悪いやつだ。あの妙な口ぶりのやつに頼まれたんだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620316
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620316,
					"content": "まあいい。ここまで粘ったことに免じて聞いてやる…いくら払うか言え。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620317
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620317,
					"content": "（よかった。交渉の余地がないわけじゃないみたいだぞ。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620318
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620318,
					"content": "（ナクルは予算を教えてくれてたよな。額を提示するなら、最初から正直に予算の上限を伝えるか？それとも低くするか？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620319,
						740620356
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620319,
					"content": "（正直に予算を伝える。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620320
					]
				},
				{
					"id": 740620320,
					"content": "おう、それじゃ正直に言うぞ。依頼人の予算は特別許可券で五万四千枚だ。かなりいい条件だとオイラは思うぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620321
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620321,
					"content": "五万四千枚？前回、あのドアを叩いたヘンなやつが言ってた額から…たったの一割しか増えてないじゃないか。それぽっちしか上げないとはケチだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620322
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620322,
					"content": "これで少ないのか？オイラは結構多いと思うけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620323
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620323,
					"content": "はぁ、分かってないな。カランザのことは知ってるか？あいつは太っ腹だぜ。あいつが提示した額は…なんと十万八千枚だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620324
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620324,
					"content": "本当かよ？そんなに？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620325
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620325,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620326
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620326,
					"content": "…も、もちろんだ。俺が嘘をついているように見えるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620327
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620327,
					"content": "あいだにドアがあるから、なにも見えないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620328
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620328,
					"content": "（こいつ声が震えてたな。もしかしたら、真っ赤な嘘なのかも。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620329
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620329,
					"content": "#（{NICKNAME}、次はどうする？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620330,
						740620340
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620330,
					"content": "（最大限の誠意は見せた。納得させよう。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620331
					]
				},
				{
					"id": 740620331,
					"content": "こっちは最初から正直に伝えたし、本当に五万四千枚しかないんだ。さすがに十万八千枚は高すぎるぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620332
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620332,
					"content": "おまえがこの条件を飲めないってんなら、オイラたちは…どうしようもないし、諦めるしかないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620333
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620333,
					"content": "このまま待っていれば…あと少し待てばきっと上がる。次に…次また来た時には、必ずもっと高い額を提示してくれるはずだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620334
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620334,
					"content": "俺が相場を読み違えることはない！きっとまだ上がるぞ！だから我慢しないと！そう簡単に応じるわけには…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620335
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620335,
					"content": "確信があるような言い方だけどさ、なんか根拠でもあんのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620336
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620336,
					"content": "もちろん経験さ！これまでの二回の経験が教えてくれてる。俺が折れない限り、このまま値上がるってね。シンプルな理屈だろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620337
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620337,
					"content": "そんなの理屈って言えないだろ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620338
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620338,
					"content": "お前はガキだしな、理解できないのもしょうがない。とにかく、今はその時じゃないんだ。妥協はしないから、帰ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620339
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620339,
					"content": "#うぅ…どうやら意志は固いみたいだ。{NICKNAME}、戻ってナクルに伝えようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620340,
					"content": "（騙す気なら、カマをかけてみよう。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620341
					]
				},
				{
					"id": 740620341,
					"content": "ううぅ…まさか、カランザみたいな強力なライバルがいるなんて…どう考えても勝てるわけないよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620342
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620342,
					"content": "#{NICKNAME}、もう帰ろうぜ。予算が低すぎて、相手にされなかったってナクルに伝えよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620343
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620343,
					"content": "じゃあな、ドアの向こうの人。カランザと仲良くしろよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620344
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620344,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620345
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620345,
					"content": "…えっ？本当にもう行っちまったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620346
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620346,
					"content": "おい、まだいるよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620347
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620347,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620348
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620348,
					"content": "おーい！まだ行かないでくれ——戻ってこい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620349
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620349,
					"content": "…なんだよ、おまえの声が遠くからでも聞こえたぞ。カランザを呼んでほしいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620350
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620350,
					"content": "あ、ああ、いや…すまない、そんな面倒をかけるつもりはないさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620351
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620351,
					"content": "#気にすんなって。どうせついでだし、そうだろ、{NICKNAME}？それくらい、別に大した手間じゃないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620352
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620352,
					"content": "くッ…このチビ、なかなか意地が悪いな。その…なんだ、正直なところ…さっきの条件はまだ有効か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620353
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620353,
					"content": "今はそうだけど、これからどうなるか…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620354
					]
				},
				{
					"id": 740620354,
					"content": "分かった、さっきの額で応じよう。ただし、依頼人には直接交渉しに来てもらいたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620355
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620355,
					"content": "#おう、わかったぜ！{NICKNAME}、戻ってナクルに伝えよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620356,
					"content": "（思い切り額を低くする！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620357
					]
				},
				{
					"id": 740620357,
					"content": "じゃ、じゃあ…二万七千！特別許可券で二万七千枚ならどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620358
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620358,
					"content": "二万七千枚！？おいおい、冗談だろう？俺をバカにしてるのか。なんで前より減ってるんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620359
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620359,
					"content": "ドアを叩いてきたあのヘンなやつのほうがもっと高かったし、俺はそれでも応じなかったんだ。お前らのその額で満足するわけないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620360
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620360,
					"content": "#（{NICKNAME}、どうしよう、この額のままいくか？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620361,
						740620370
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620361,
					"content": "相場が下がってるから、もっと低くなる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620362
					]
				},
				{
					"id": 740620362,
					"content": "本当かよ？ナクルがこの部屋を借りたがってるんだろう？あいつならもっと出すと思うんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620363
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620363,
					"content": "そりゃ…人の堪忍袋にも限界があるからな！おまえは二回もきっぱり断ったわけだしさ、あいつももう諦めるだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620364
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620364,
					"content": "今回は半分の額を提示したけど、次はもしかしたら…おっと、次はもうないかもしれないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620365
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620365,
					"content": "…ちょっと考えさせてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620366
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620366,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620367
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620367,
					"content": "おーい、ドアの向こうの人。考えはまとまったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620368
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620368,
					"content": "分かった、さっきの額で応じよう。ただし、依頼人には直接交渉しに来てもらいたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620369
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620369,
					"content": "#おう、わかったぜ！{NICKNAME}、戻ってナクルに伝えよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620370,
					"content": "（依頼人の予算上限まで上げる。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620371
					]
				},
				{
					"id": 740620371,
					"content": "うーん…じゃあ、特別許可券で五万四千枚ならどうだ？二万七千枚の倍だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620372
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620372,
					"content": "五万四千枚？前回、あのドアを叩いたヘンなやつが言ってた額から…たったの一割しか増えてないじゃないか。それぽっちしか上げないとはケチだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620373
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620373,
					"content": "それにお前らが提示する額って、高かったり低かったりするし…きっとまだ上がる余地が残ってるんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620374
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620374,
					"content": "このまま待っていれば…あと少し待てばきっと上がる。次に…次また来た時には、必ずもっと高い額を提示してくれるはずだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620375
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620375,
					"content": "俺が相場を読み違えることはない！きっとまだ上がるぞ！だから我慢しないと！そう簡単に応じるわけには…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620376
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620376,
					"content": "帰ってくれ。俺は応じないぞ。少なくとも今回は応じないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620377
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620377,
					"content": "#うぅ…どうやら意志は固いみたいだ。{NICKNAME}、戻ってナクルに伝えようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620378,
					"content": "（ドアを開けてみる。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620379
					]
				},
				{
					"id": 740620379,
					"content": "…おい！お、お前、何するんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620380
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620380,
					"content": "ドアを開けようとしてるんだけど？ドア越しだとお互いの表情が見えないからな。話し合いをするんなら、面と向かって話したほうがいいだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620381
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620381,
					"content": "それにメロピデ要塞の部屋は誰かの私有物じゃないよな？仮住まいなら、オイラたちも入っていいはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620382
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620382,
					"content": "待て！絶対にダメだ！お前ら、全然わかってない…ドアの裏にどんな闇が隠されてるのかを…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620383
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620383,
					"content": "えっと、つまり何が言いたいかというと…人と目が合うと、俺は緊張して話せなくなるんだ。ドア越しのままにしてくれ。で、どんな用件なんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620384,
						740620449
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620384,
					"content": "依頼を受けて交渉に来た。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620385
					]
				},
				{
					"id": 740620385,
					"content": "おう、ある人から頼まれて相談に来たんだ。この部屋を貸してくれないか？もちろん、依頼人が特別許可券を支払うぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620386
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620386,
					"content": "似たような話を前にも聞いたな…何度も何度も、諦めの悪いやつだ。あの妙な口ぶりのやつに頼まれたんだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620387
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620387,
					"content": "まあいい。ここまで粘ったことに免じて聞いてやる…いくら払うか言え。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620388
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620388,
					"content": "（よかった。交渉の余地がないわけじゃないみたいだぞ。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620389
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620389,
					"content": "（ナクルは予算を教えてくれてたよな。額を提示するなら、最初から正直に予算の上限を伝えるか？それとも低くするか？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620390,
						740620427
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620390,
					"content": "（正直に予算を伝える。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620391
					]
				},
				{
					"id": 740620391,
					"content": "おう、それじゃ正直に言うぞ。依頼人の予算は特別許可券で五万四千枚だ。かなりいい条件だとオイラは思うぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620392
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620392,
					"content": "五万四千枚？前回、あのドアを叩いたヘンなやつが言ってた額から…たったの一割しか増えてないじゃないか。それぽっちしか上げないとはケチだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620393
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620393,
					"content": "これで少ないのか？オイラは結構多いと思うけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620394
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620394,
					"content": "はぁ、分かってないな。カランザのことは知ってるか？あいつは太っ腹だぜ。あいつが提示した額は…なんと十万八千枚だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620395
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620395,
					"content": "本当かよ？そんなに？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620396
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620396,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620397
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620397,
					"content": "…も、もちろんだ。俺が嘘をついているように見えるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620398
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620398,
					"content": "あいだにドアがあるから、なにも見えないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620399
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620399,
					"content": "（こいつ声が震えてたな。もしかしたら、真っ赤な嘘なのかも。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620400
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620400,
					"content": "#（{NICKNAME}、次はどうする？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620401,
						740620411
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620401,
					"content": "（最大限の誠意は見せた。納得させよう。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620402
					]
				},
				{
					"id": 740620402,
					"content": "こっちは最初から正直に伝えたし、本当に五万四千枚しかないんだ。さすがに十万八千枚は高すぎるぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620403,
					"content": "おまえがこの条件を飲めないってんなら、オイラたちは…どうしようもないし、諦めるしかないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620404,
					"content": "このまま待っていれば…あと少し待てばきっと上がる。次に…次また来た時には、必ずもっと高い額を提示してくれるはずだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620405
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620405,
					"content": "俺が相場を読み違えることはない！きっとまだ上がるぞ！だから我慢しないと！そう簡単に応じるわけには…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620406
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620406,
					"content": "確信があるような言い方だけどさ、なんか根拠でもあんのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620407
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620407,
					"content": "もちろん経験さ！これまでの二回の経験が教えてくれてる。俺が折れない限り、このまま値上がるってね。シンプルな理屈だろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620408
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620408,
					"content": "そんなの理屈って言えないだろ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620409
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620409,
					"content": "お前はガキだしな、理解できないのもしょうがない。とにかく、今はその時じゃないんだ。妥協はしないから、帰ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620410
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620410,
					"content": "#うぅ…どうやら意志は固いみたいだ。{NICKNAME}、戻ってナクルに伝えようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620411,
					"content": "（騙す気なら、カマをかけてみよう。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620412
					]
				},
				{
					"id": 740620412,
					"content": "ううぅ…まさか、カランザみたいな強力なライバルがいるなんて…どう考えても勝てるわけないよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620413,
					"content": "#{NICKNAME}、もう帰ろうぜ。予算が低すぎて、相手にされなかったってナクルに伝えよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620414
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620414,
					"content": "じゃあな、ドアの向こうの人。カランザと仲良くしろよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620415
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620415,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620416
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620416,
					"content": "…えっ？本当にもう行っちまったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620417
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620417,
					"content": "おい、まだいるよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620418
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620418,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620419
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620419,
					"content": "おーい！まだ行かないでくれ——戻ってこい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620420
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620420,
					"content": "…なんだよ、おまえの声が遠くからでも聞こえたぞ。カランザを呼んでほしいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620421
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620421,
					"content": "あ、ああ、いや…すまない、そんな面倒をかけるつもりはないさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620422
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620422,
					"content": "#気にすんなって。どうせついでだし、そうだろ、{NICKNAME}？それくらい、別に大した手間じゃないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620423
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620423,
					"content": "くッ…このチビ、なかなか意地が悪いな。その…なんだ、正直なところ…さっきの条件はまだ有効か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620424
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620424,
					"content": "今はそうだけど、これからどうなるか…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620425
					]
				},
				{
					"id": 740620425,
					"content": "分かった、さっきの額で応じよう。ただし、依頼人には直接交渉しに来てもらいたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620426
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620426,
					"content": "#おう、わかったぜ！{NICKNAME}、戻ってナクルに伝えよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620427,
					"content": "（思い切り額を低くする！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620428
					]
				},
				{
					"id": 740620428,
					"content": "じゃ、じゃあ…二万七千！特別許可券で二万七千枚ならどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620429
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620429,
					"content": "二万七千枚！？おいおい、冗談だろう？俺をバカにしてるのか。なんで前より減ってるんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620430
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620430,
					"content": "ドアを叩いてきたあのヘンなやつのほうがもっと高かったし、俺はそれでも応じなかったんだ。お前らのその額で満足するわけないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620431
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620431,
					"content": "#（{NICKNAME}、どうしよう、この額のままいくか？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620432,
						740620441
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620432,
					"content": "相場が下がってるから、もっと低くなる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620433
					]
				},
				{
					"id": 740620433,
					"content": "本当かよ？ナクルがこの部屋を借りたがってるんだろう？あいつならもっと出すと思うんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620434
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620434,
					"content": "そりゃ…人の堪忍袋にも限界があるからな！おまえは二回もきっぱり断ったわけだしさ、あいつももう諦めるだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620435
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620435,
					"content": "今回は半分の額を提示したけど、次はもしかしたら…おっと、次はもうないかもしれないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620436
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620436,
					"content": "…ちょっと考えさせてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620437
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620437,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620438
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620438,
					"content": "おーい、ドアの向こうの人。考えはまとまったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620439
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620439,
					"content": "分かった、さっきの額で応じよう。ただし、依頼人には直接交渉しに来てもらいたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620440
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620440,
					"content": "#おう、わかったぜ！{NICKNAME}、戻ってナクルに伝えよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620441,
					"content": "（じゃあ、予算上限まで額を上げよう。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620442
					]
				},
				{
					"id": 740620442,
					"content": "うーん…じゃあ、特別許可券で五万四千枚ならどうだ？二万七千枚の倍だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620443
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620443,
					"content": "五万四千枚？前回、あのドアを叩いたヘンなやつが言ってた額から…たったの一割しか増えてないじゃないか。それぽっちしか上げないとはケチだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620444
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620444,
					"content": "それにお前らが提示する額って、高かったり低かったりするし…きっとまだ上がる余地が残ってるんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620445
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620445,
					"content": "このまま待っていれば…あと少し待てばきっと上がる。次に…次また来た時には、必ずもっと高い額を提示してくれるはずだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620446
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620446,
					"content": "俺が相場を読み違えることはない！きっとまだ上がるぞ！だから我慢しないと！そう簡単に応じるわけには…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620447
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620447,
					"content": "帰ってくれ。俺は応じないぞ。少なくとも今回は応じないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620448
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620448,
					"content": "#うぅ…どうやら意志は固いみたいだ。{NICKNAME}、戻ってナクルに伝えようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620449,
					"content": "（引き続きドアを開けてみる。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620450
					]
				},
				{
					"id": 740620450,
					"content": "な、なにをする！やめろ！言っただろう。お前らは、ドアの裏にどんな闇が隠されてるのか全然わかってない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620451
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620451,
					"content": "顔を見ないと、本物の人間か分からない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620452
					]
				},
				{
					"id": 740620452,
					"content": "もちろん本物さ…それに、たとえ本物じゃなくても別にいいだろ？こっちだって、お前らが実在してるかどうか知らないが、こうして交流できてるんだしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620453,
						740620455
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620453,
					"content": "パイモンの顔をつねってみた。本物らしい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620454
					]
				},
				{
					"id": 740620454,
					"content": "そうか。どうやら二人とも互いに本物だと証明できたみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620458
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620458,
					"content": "とにかく、俺はドアを開けないぞ。お前らも開けようとするな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620459
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620459,
					"content": "えっと…でもオイラたち、ある人に頼まれたんだ。なぁ、この部屋を貸してくれないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620460
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620460,
					"content": "だったら、そいつには諦めてもらうしかないな。闇と共存するのは俺一人で十分だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620461
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620461,
					"content": "さっきから闇って言ってるけど、それって一体なんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620462
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620462,
					"content": "声を聞いた感じ、お前まだガキだろ？子供には理解できないさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620463
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620463,
					"content": "ふん！どーせ作り話でオイラたちを騙そうとしてるんだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620464
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620464,
					"content": "ははっ、そうかもしれないな。でも俺の話は以上だ。ドアは開けないし、部屋を貸すのもなしだ。帰ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620465
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620465,
					"content": "ドアの向こうにいる相手は何も言わなくなった。\\nしばらく待ち、もう一度ドアをノックしたが応答はない。まるで、最初から誰もいなかったかのようだ…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740620466
					]
				},
				{
					"id": 740620466,
					"content": "あ、あれ？本当に相手にしてくれなくなっちゃったぞ…交渉に失敗しちゃったみたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620467
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620467,
					"content": "うぅ…とにかく、戻ってナクルに伝えようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620455,
					"content": "#{M#俺}{F#私}は誰かの夢の中の登場人物かも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620456
					]
				},
				{
					"id": 740620456,
					"content": "そいつは俺の夢でか？そういえば、お前らの声を聞いたことあったな…元気な女の子と話してる声を。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620457
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620457,
					"content": "#オイラの夢かもしれないぞ？もしそうだったら…目が覚めても、{NICKNAME}がそばにいてくれるといいけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620458
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620306,
					"content": "どこから来て、何者なのかは聞かないで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620307
					]
				},
				{
					"id": 740620307,
					"content": "はぁ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620308
					],
					"speakerTitle": "ある人"
				},
				{
					"id": 740620308,
					"content": "（なにしてるんだよ。そんなこと言ったら、もっとややこしくなるだけだろ？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620312
					],
					"speakerTitle": "パイモン"
