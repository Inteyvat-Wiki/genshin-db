					}
				]
			},
			"dialogs": [
				{
					"id": 740620101,
					"content": "そこの方、しばしお待ちを…二人はどんな依頼も引き受けてくれる聞いたんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620102,
						740620103
					],
					"speakerTitle": "ナクル"
				},
				{
					"id": 740620102,
					"content": "確かにそうだけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620105
					]
				},
				{
					"id": 740620105,
					"content": "コホン…実は以前、紫色のドレスを着た女の子から、二人の面倒を見るよう頼まれたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620106
					],
					"speakerTitle": "ナクル"
				},
				{
					"id": 740620106,
					"content": "しかし、どんな依頼も引き受ける二人なら、それなりの腕をお持ちのはず。こちらが面倒を見る必要などないだろう。むしろ、私の面倒を見てもらいたいくらいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620107
					],
					"speakerTitle": "ナクル"
				},
				{
					"id": 740620107,
					"content": "面倒を見るのはいいけど、割引はしないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620108
					]
				},
				{
					"id": 740620108,
					"content": "ああ、ルールは理解してるから心配しないでほしい。依頼の結果にかかわらず、相場で報酬を支払おう。もちろん、ここではモラが通用しないから特別許可券で渡すつもりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620109
					],
					"speakerTitle": "ナクル"
				},
				{
					"id": 740620109,
					"content": "結果にかかわらず報酬を支払うって…本当にいいのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620110,
					"content": "かまわないとも。それほど難しい案件ということだからね。これもニザーミーのせいさ。腕っぷしは強いが、その使いどころを間違ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620111
					],
					"speakerTitle": "ナクル"
				},
				{
					"id": 740620111,
					"content": "実は、しばらくここに滞在する必要があるんだ。そこで、学術研究に適した場所を探している。机と椅子、本棚、それから資料を貼ったり書いたりできるボードがあればいいんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620112
					],
					"speakerTitle": "ナクル"
				},
				{
					"id": 740620112,
					"content": "私の考えを察してくれたようだね。でも、ここはダメなんだ。おっと、理由は聞かないでくれ。反対側の部屋も同じ構造をしているんだが、そっちなら使えるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620113
					],
					"speakerTitle": "ナクル"
				},
				{
					"id": 740620113,
					"content": "しかし、その部屋はとても妙でね。誰かが独占していて、ドアもめったに開かないんだ。私はその人物に会ったこともなければ、ドアが開いているところも見たことがない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620114
					],
					"speakerTitle": "ナクル"
				},
				{
					"id": 740620114,
					"content": "そこで、私はボディガードのニザーミーに代わりに話をつけてもらうよう頼んだ。だが、彼はその人物とソリが合わず、交渉は失敗に終わったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620115
					],
					"speakerTitle": "ナクル"
				},
				{
					"id": 740620115,
					"content": "うーん…交渉や話し合いはあいつの得意分野じゃない気がするけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620116,
					"content": "ああ、まさにその通り。そもそも、あれは交渉や話し合いと言えるようなものではなかった。彼がドアに拳を叩き付けると、その向こう側から大声が聞こえたんだ。本当に驚いたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620117,
						740620119
					],
					"speakerTitle": "ナクル"
				},
				{
					"id": 740620117,
					"content": "うわ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620118
					]
				},
				{
					"id": 740620118,
					"content": "それって、もう交渉の「こ」の字もないじゃんか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620121,
					"content": "そこで、二人には代わりに交渉を頼みたい。独占している部屋を貸してもらえるよう、その人物と話してきてほしいんだ。私の予算は…特別許可券で五万四千枚。その範囲内でお願いできるかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620122
					],
					"speakerTitle": "ナクル"
				},
				{
					"id": 740620122,
					"content": "成功する自信がなくとも、とりあえず試してみてくれるだけでいい。どうか頼まれてくれないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ナクル"
				},
				{
					"id": 740620119,
					"content": "プロ意識がないね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620120
					]
				},
				{
					"id": 740620120,
					"content": "そもそも、あいつはそういった分野のプロじゃないだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740620103,
					"content": "誰からそんなことを…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620104
					]
				},
				{
					"id": 740620104,
					"content": "風の噂で聞いたのさ…そう、ただの噂でね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620105
					],
					"speakerTitle": "ナクル"
				}
			]
		},
