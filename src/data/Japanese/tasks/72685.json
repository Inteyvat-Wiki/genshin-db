			"trigger": {
				"objectNames": [
					"駒形"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726850101,
					"content": "こんにちは、容彩祭にようこそ、お客さん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850102
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726850102,
					"content": "新しくなった「機関棋譚」をぜひ体験してみて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850103,
						726850119
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726850103,
					"content": "「機関棋譚」とは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726850104
					]
				},
				{
					"id": 726850104,
					"content": "璃月で開発された机の上で遊べる「遊戯」だよ。とっても面白いんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850105
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726850105,
					"content": "「機関棋譚」の発明者は瑞錦さんっていうの。稲妻でこの「遊戯」を宣伝させてもらえるよう、彼女から「海外運営」の許可をもらったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850106
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726850106,
					"content": "最近は瑞錦さんとずっと手紙で連絡を取り合ってて、彼女と一緒に「機関棋譚」の遊び方を改善しているの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850107
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726850107,
					"content": "新しい企画が完成したところで、ちょうど「光華容彩祭」が開催されるって聞いてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850108
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726850108,
					"content": "出展することが決まってしばらくした後、ある大物の方がここに来るって聞いたの。「機関棋譚」の商業的な可能性を調べるためらしいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850109
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726850109,
					"content": "となれば、私ももっと頑張らないとね！みんなが面白い「機関棋譚」を気に入ってくれたら嬉しいな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850110
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726850110,
					"content": "君も「機関棋譚·巧策の陣」を体験してみない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850111
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726850111,
					"content": "「巧策の陣」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726850112
					]
				},
				{
					"id": 726850112,
					"content": "ざっくり言うと、「機関棋譚」の新しい遊び方だよ。璃月の盤上遊戯である「終盤」を参考にしてるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850113
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726850113,
					"content": "「巧策の陣」では対局を始めた段階で、すでに一部の機関が盤面に置かれてるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850114
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726850114,
					"content": "棋士は大局を分析して、機関をどう駆使するか、そして慎重に取捨選択しながら、勝つための策を考える必要があるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850115
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726850115,
					"content": "以前のものと比べると、「巧策の陣」は進行が速くなってる。棋士の判断力が試される厳しい試練になっていて、挑戦に満ちてるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850116
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726850116,
					"content": "じゃあ、やってみる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726850117
					]
				},
				{
					"id": 726850117,
					"content": "うん、「巧策の陣」を楽しんでもらえたらいいな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850118
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726850118,
					"content": "「機関棋譚」を遊ぶ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 726850119,
					"content": "また会ったね、駒形さん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726850120
					]
				},
				{
					"id": 726850120,
					"content": "えっ、私のことまだ覚えててくれたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850121
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726850121,
					"content": "前回、君が面白い遊び方を色々見つけてくれたおかげで、「機関棋譚」にはまだまだ改善の余地があるっていうことに気付いたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850122
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726850122,
					"content": "だから、「霊妙の陣」が終了した後、瑞錦さんに手紙を出して、私なりの考えを伝えたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850123
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726850123,
					"content": "まさか、瑞錦さんが私と同じような考えを持っていたなんて思わなかったよ！私、やっぱり立派な「海外運営」だね、えへへ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850124
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726850124,
					"content": "とにかく、瑞錦さんと何回か連絡を重ねた結果、最新の「機関棋譚」——この「巧策の陣」が出来上がったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850125
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726850125,
					"content": "「巧策の陣」は、璃月の盤上遊戯である「終盤」を参考にしてるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850126
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726850126,
					"content": "「巧策の陣」では対局を始めた段階で、すでに一部の機関が盤面に置かれてるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850127
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726850127,
					"content": "棋士は大局を分析して、機関をどう駆使するか、そして慎重に取捨選択しながら、勝つための策を考える必要があるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850128
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726850128,
					"content": "以前のものと比べると、「巧策の陣」は進行が速くなってる。棋士の判断力が試される厳しい試練になっていて、挑戦に満ちてるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850129
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726850129,
					"content": "面白そう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726850130
					]
				},
				{
					"id": 726850130,
					"content": "でしょ！お客さんたちが遊んだ後の反応を今すぐ見てみたいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850131
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726850131,
					"content": "運営を始めてしばらく経ったから、私もだいぶ慣れてきたんだ。だから、容彩祭の開催中に、この「遊戯」をより多くの人に知ってもらいたいと思ってるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850132
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726850132,
					"content": "それにある大物の方がここに来て、「機関棋譚」の商業的な可能性を調べるって聞いたんだ！この容彩祭で「機関棋譚」が大流行したらいいな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850133
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726850133,
					"content": "どうかな、さっそく「巧策の陣」をやってみる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850134
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726850134,
					"content": "「機関棋譚」を遊ぶ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		}
	]
}