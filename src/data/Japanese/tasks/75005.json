						],
						"pointId": 8109
					},
					{
						"sceneId": 3,
						"position": [
							-2237.073,
							208.846,
							7958.869
						],
						"pointId": 8110
					},
					{
						"sceneId": 3,
						"position": [
							-2236.62,
							208.781,
							7958.013
						],
						"pointId": 9244
					}
				]
			},
			"dialogs": [
				{
					"id": 750050201,
					"content": "さあ、遠慮せずにくつろいでくれ。俺の料理を食べるだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050202
					],
					"speakerTitle": "レグバ"
				},
				{
					"id": 750050202,
					"content": "もし自分で作りたいなら、そこの箱にレシピがある。余った食材も置いてあるから、好きに使ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050203
					],
					"speakerTitle": "レグバ"
				},
				{
					"id": 750050203,
					"content": "えっ？レシピを持ち歩いてるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750050204,
					"content": "ああ、自分で書いたやつを何枚かな。誰かが使ったり、助けを必要とするやつがいたら、役に立ったりするかもしれないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050205
					],
					"speakerTitle": "レグバ"
				},
				{
					"id": 750050205,
					"content": "おおっ、用意周到だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750050206,
					"content": "集落の外じゃ、頼れるのは自分だけだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050207
					],
					"speakerTitle": "レグバ"
				},
				{
					"id": 750050207,
					"content": "#そういえば、{M#君}{F#あなた}の名前は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050208
					]
				},
				{
					"id": 750050208,
					"content": "俺か？ハハッ！レグバと呼んでくれ。お前らはなんて呼んだらいい、友よ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050209
					],
					"speakerTitle": "レグバ"
				},
				{
					"id": 750050209,
					"content": "レグバに自己紹介をした。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750050210
					]
				},
				{
					"id": 750050210,
					"content": "#パイモンに{NICKNAME}、それからテペトル竜の{REALNAME[ID(2)|SHOWHOST(true)]}か…お前らがナタで出会ったのも、何か縁あってのことだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050211
					],
					"speakerTitle": "レグバ"
				},
				{
					"id": 750050211,
					"content": "#ところで、{NICKNAME}。禁域の近くで何をしてたんだ？宝探しか？それとも…部族の秘密を探るつもりだったとか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050212,
						750050215
					],
					"speakerTitle": "レグバ"
				},
				{
					"id": 750050212,
					"content": "もちろん宝探し。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050213
					]
				},
				{
					"id": 750050213,
					"content": "キュウ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050214
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050214,
					"content": "そうそう！厳重に守られてる場所って、お宝がよく隠されてるもんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050220
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750050220,
					"content": "とにかく…あそこは諦めろ、異邦人。中に入れはしない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050221
					],
					"speakerTitle": "レグバ"
				},
				{
					"id": 750050221,
					"content": "あそこは古代の先人たちが夜の世界と再び繋がりを結んだ場所だ。それ以来、部族の人間たちはだんだん「夜神の国」に足を踏み入れるようになった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050222
					],
					"speakerTitle": "レグバ"
				},
				{
					"id": 750050222,
					"content": "キュル？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050223
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050223,
					"content": "「夜神の国」って、どんな場所なんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050224
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750050224,
					"content": "ハハッ、そこはナタの人間がこの世を離れたときに行く場所だ…ごく一部の人を除いて、あそこから戻ってこれたやつはいない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050225
					],
					"speakerTitle": "レグバ"
				},
				{
					"id": 750050225,
					"content": "噂じゃ、光る水が流れていて、巨大な黒曜石の碑がそびえ立ってるらしい。部族の禁域よりも、「夜神の国」は好奇心を持っちゃならねぇ場所だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050226
					],
					"speakerTitle": "レグバ"
				},
				{
					"id": 750050226,
					"content": "それで、おまえがさっき言ってた、下の…ええと、夜の世界と交流できるっていう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050227
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750050227,
					"content": "媒介となるレリック——昔の人間が「大霊」と…つまり「夜神の国」の使者と交流するための古い道具だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050228
					],
					"speakerTitle": "レグバ"
				},
				{
					"id": 750050228,
					"content": "おお、古い道具…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050229
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750050229,
					"content": "キュイ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050230
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050230,
					"content": "…おっと、ちょっとおしゃべりが過ぎたかもしれないな。とにかく、部族と「夜神の国」が安定した繋がりを持った今、もうレリックは必要なくなった。それに俺から見れば、あのやり方はあまりにもおざなりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050231
					],
					"speakerTitle": "レグバ"
				},
				{
					"id": 750050231,
					"content": "だが、それでも一応は部族のレリックなもんでね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050232
					],
					"speakerTitle": "レグバ"
				},
				{
					"id": 750050232,
					"content": "キュ…キュウ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050233
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050233,
					"content": "わかったぞ…そういうことなら仕方ないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050234
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750050234,
					"content": "ああ、禁域には行かないようにしてくれ。それが掟だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050235
					],
					"speakerTitle": "レグバ"
				},
				{
					"id": 750050235,
					"content": "ハハッ！連れの子は相当賢いみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050236
					],
					"speakerTitle": "レグバ"
				},
				{
					"id": 750050236,
					"content": "俺にも昔、仲間の竜がたくさんいた…それこそ賢い子もな。だが今は俺一人。集落から離れて久しい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050237
					],
					"speakerTitle": "レグバ"
				},
				{
					"id": 750050237,
					"content": "…おっと、もうだいぶ夜が更けてきたな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050238
					],
					"speakerTitle": "レグバ"
				},
				{
					"id": 750050238,
					"content": "ふわぁ～…わからないことだらけで、なんだか眠くなってきたぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050239
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750050239,
					"content": "ハハッ、悪かった。話を聞いてくれる人に会ったのは久々だったもんでな。つい喋りすぎちまった…こうして出会ったのも何かの縁だ。ここで一晩休んでかないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050240
					],
					"speakerTitle": "レグバ"
				},
				{
					"id": 750050240,
					"content": "寝床もちゃんと用意しよう。夜はこの辺りをパトロールするから、安全面も心配不要だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050241
					],
					"speakerTitle": "レグバ"
				},
				{
					"id": 750050241,
					"content": "おう、親切にありがとな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050242
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750050242,
					"content": "キュイ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050243
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050243,
					"content": "温かな寝床に横たわり、揺らめく焚き火を眺めていると、すぐに夢の世界へと旅立った…\\nしかし、小さな物音がずっと耳元に届いて、深い眠りにつけない。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750050244
					]
				},
				{
					"id": 750050244,
					"content": "頬のあたりを冷たく湿った感触が襲い、ドロドロとした暗い夢から連れ出されるまで——そんな状態がずっと続いた…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750050245
					]
				},
				{
					"id": 750050245,
					"content": "#目を開けると、{REALNAME[ID(2)|SHOWHOST(true)]}の見慣れた人懐っこい顔が映った。\\nもしかすると、さっきはこの子が起こそうと、頬を舐めたのかもしれない。\\nだがしばらくして、何かを見せようとしているのだと気づいた——不思議な黒曜石の像だ…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750050246
					]
				},
				{
					"id": 750050246,
					"content": "キュキュイッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050247,
						750050249
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050247,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}がこれを見つけてきたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050248
					]
				},
				{
					"id": 750050248,
					"content": "キュ…キュウ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050252
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050252,
					"content": "うぅ…なんだか不気味な感じがするぞ。縁起が悪そうじゃないか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050253,
						750050255
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750050253,
					"content": "パイモンも縁起とか気にするの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050254
					]
				},
				{
					"id": 750050254,
					"content": "ただ思ったことを口にしただけだぞ…どう見てもいいものじゃなさそうだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050257
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750050257,
					"content": "#それより、{REALNAME[ID(2)|SHOWHOST(true)]}！もしかして、オイラたちが寝てる間に外に出たのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050258
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750050258,
					"content": "キュウ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050259
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050259,
					"content": "困ったな、どこから拾ってきたんだろ…危険で汚い場所だったりしないよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050260
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750050260,
					"content": "キュルル…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050261
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050261,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}？{NICKNAME}！パイモン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050262
					],
					"speakerTitle": "レグバ"
				},
				{
					"id": 750050262,
					"content": "ここにいるぞ。どうしたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050263
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750050263,
					"content": "#いや、{REALNAME[ID(2)|SHOWHOST(true)]}の鳴き声を聞いて駆けつけたんだ。何かあったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050264
					],
					"speakerTitle": "レグバ"
				},
				{
					"id": 750050264,
					"content": "キュウ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050265
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050265,
					"content": "こ…これは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050266
					],
					"speakerTitle": "レグバ"
				},
				{
					"id": 750050266,
					"content": "あぁ…なんてこった。その黒曜石の像は、ご先祖が「夜神の国」と交流するのに使ってたレリックじゃないか。封印の向こう、禁域の奥深くに隠されてたっていうのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050267
					],
					"speakerTitle": "レグバ"
				},
				{
					"id": 750050267,
					"content": "そのテペトル竜に掘らせて盗んだんだな？ちっ…異邦人め、やっぱり部族のレリックを狙ってたのか。食料と休む場所まで用意してやったのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050268,
						750050270,
						750050272
					],
					"speakerTitle": "レグバ"
				},
				{
					"id": 750050268,
					"content": "待って、説明するから…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050269
					]
				},
				{
					"id": 750050269,
					"content": "わ、わざとじゃないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050274
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750050274,
					"content": "キュウ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050275
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050275,
					"content": "レグバに事情を説明した…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750050276
					]
				},
				{
					"id": 750050276,
					"content": "…そうだったのか。そいつがあちこちに穴を掘るのが好きだってことを忘れてた…俺のミスだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050277
					],
					"speakerTitle": "レグバ"
				},
				{
					"id": 750050277,
					"content": "はぁ、どうしたもんか。長いこと使われていなかったとはいえ、そいつは紛れもないレリック。「大霊」の怒りを買ったら大変なことになるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050278
					],
					"speakerTitle": "レグバ"
				},
				{
					"id": 750050278,
					"content": "えっと…どうしたらいいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050279
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750050279,
					"content": "とにかく、元の場所に戻しに行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050280
					],
					"speakerTitle": "レグバ"
				},
				{
					"id": 750050280,
					"content": "キュウ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050281
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050281,
					"content": "ハハ、困ったやつだな、まったく！さ、出発するぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050282
					],
					"speakerTitle": "レグバ"
				},
				{
					"id": 750050282,
					"content": "忠告しておくが…遺跡は道が入り組んでる。それに仕掛けも多い。くれぐれも気を付けてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "レグバ"
				},
				{
					"id": 750050270,
					"content": "バレちゃった。逃げよう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050271
					]
				},
				{
					"id": 750050271,
					"content": "おい、逃げるなよ。わざと盗ったわけじゃないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050274
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750050272,
					"content": "バレてしまった以上は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050273
					]
				},
				{
					"id": 750050273,
					"content": "おい、手を出しちゃダメだろ。ちゃんと説明しろよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050274
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750050255,
					"content": "価値があるように見えるけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050256
					]
				},
				{
					"id": 750050256,
					"content": "おいおい…こんな見た目の奇妙なもの、大したモラにはならないだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050257
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750050249,
					"content": "も…もしかして、吐き出したの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050250
					]
				},
				{
					"id": 750050250,
					"content": "グルル…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050251
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050251,
					"content": "どう見ても吐き出したもんじゃないだろ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050252
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750050215,
					"content": "ただの好奇心で…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050216
					]
				},
				{
					"id": 750050216,
					"content": "そうそう。封印されてる場所を見て、気にならないやつなんていないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050217
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750050217,
					"content": "キュウ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050218
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050218,
					"content": "普通のやつは気にならないと思うが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050219
					],
					"speakerTitle": "レグバ"
				},
				{
					"id": 750050219,
					"content": "うっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050220
					],
					"speakerTitle": "パイモン"
				}
			]
		},
