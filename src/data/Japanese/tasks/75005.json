				]
			},
			"dialogs": [
				{
					"id": 750050101,
					"content": "#{NICKNAME}、見ろ。なんか封印されてる場所があるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750050102,
					"content": "へへっ、さっきこの近くで手に入れた変なものだけど、ここを開けるのに使えるんじゃないか？オイラの勘がそう言ってるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750050103,
					"content": "う～ん…この向こうには一体なにがあるんだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750050104,
					"content": "キュイ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050105,
						750050110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050105,
					"content": "魔物の巣窟かもしれない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050106
					]
				},
				{
					"id": 750050106,
					"content": "えっ…で、でも魔物がいるってことは、きっとお宝もあるってことだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750050107,
					"content": "キュウ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050108
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050108,
					"content": "そうとも限らない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050109
					]
				},
				{
					"id": 750050109,
					"content": "ふん、しらけるようなこと言うなって。入ってみようぜ。そうすればわかるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750050115,
					"content": "おい、そこの異邦人！あぁ…あとスカーフを巻いたテペトル竜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050116
					],
					"speakerTitle": "レグバ"
				},
				{
					"id": 750050116,
					"content": "キュル？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050117
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050117,
					"content": "ハッ、盛り上がってるとこ悪いんだが、誰も教えてくれなかったのか？ここが封印されてるのは、「禁域」だからだってよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050118
					],
					"speakerTitle": "レグバ"
				},
				{
					"id": 750050118,
					"content": "残念だが、そこを探しても「古い呪い」以外、何も見つからないと思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050119
					],
					"speakerTitle": "レグバ"
				},
				{
					"id": 750050119,
					"content": "グル…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050120
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050120,
					"content": "つまり…お宝はないってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750050121,
					"content": "いや、お宝は…たぶんあるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050122
					],
					"speakerTitle": "レグバ"
				},
				{
					"id": 750050122,
					"content": "たぶん？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050123
					]
				},
				{
					"id": 750050123,
					"content": "だが、それは異邦人が手を出していいもんじゃない。その向こうは「禁域」であり、「聖域」でもあるからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050124
					],
					"speakerTitle": "レグバ"
				},
				{
					"id": 750050124,
					"content": "通常、伝達使が試練をクリアし資格を手に入れることで、やっと入れるところだ。中には、古代の先人たちが夜の世界と交流するのに媒介としたレリックがあるとされてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050125
					],
					"speakerTitle": "レグバ"
				},
				{
					"id": 750050125,
					"content": "だがまさか…ちょっと離れてた隙に、試練の完了を証明する石の鍵を三つ集めるとは…まったく驚いたな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050126
					],
					"speakerTitle": "レグバ"
				},
				{
					"id": 750050126,
					"content": "へへっ、オイラたちは登ったり下りたり、探し物したりするのが得意だからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750050127,
					"content": "キューン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050128
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050128,
					"content": "たとえ部族の伝達使でも、お前たちのように機敏に動けないだろう。ふむ…こうしよう、禁域には入れられないが、俺の拠点がすぐそこにあってな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050129
					],
					"speakerTitle": "レグバ"
				},
				{
					"id": 750050129,
					"content": "そこで小腹を満たして、休んでいくのはどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050130
					],
					"speakerTitle": "レグバ"
				},
				{
					"id": 750050130,
					"content": "キュイ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050131,
						750050135
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050131,
					"content": "今はお腹が空いてない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050132
					]
				},
				{
					"id": 750050132,
					"content": "オイラも…って言いたいところだけど、実はちょっとお腹空いてて…やっぱり休んでこうぜ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050133
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750050133,
					"content": "しょうがないね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050134
					]
				},
				{
					"id": 750050134,
					"content": "へへっ…オイラってば成長期だからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050139
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750050139,
					"content": "ハハッ…仲がいいな。んじゃ、拠点まで案内しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050140
					],
					"speakerTitle": "レグバ"
				},
				{
					"id": 750050140,
					"content": "着いたら、温かい料理でもてなそう。遠くからの客人よ、色々と話そうじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "レグバ"
				},
				{
					"id": 750050135,
					"content": "じゃあ、せっかくだし…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050136
					]
				},
				{
					"id": 750050136,
					"content": "いいぜ、おまえは休んどけ。オイラが見張っとくから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050137
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750050137,
					"content": "パイモンはぐっすり寝ちゃうでしょ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050138
					]
				},
				{
					"id": 750050138,
					"content": "おい！オイラを甘く見るなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050139
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750050110,
					"content": "お宝が隠されてるかもしれない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050111
					]
				},
				{
					"id": 750050111,
					"content": "おう！オイラもそう思うぞ。この中にはきっとお宝が眠ってるんだ！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750050112,
					"content": "キュウ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050113
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050113,
					"content": "そうあんまり興奮しないの。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050114
					]
				},
				{
					"id": 750050114,
					"content": "中になにがあるかは、入ってみればわかるはずだ！まずはここの封印を解いてみようぜ！お宝、お宝～！待っててくれよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050115
					],
					"speakerTitle": "パイモン"
				}
			]
		},
