					"nextDialogs": [
						750050503
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050503,
					"content": "さっきまで、すごい怖いところにいたんだ！大きな石碑が話しかけてきて…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750050504,
					"content": "#どうした、{REALNAME[ID(2)|SHOWHOST(true)]}？オイラたちのことを心配してくれてるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750050505,
					"content": "キュイ…キュルル…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050506
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050506,
					"content": "言ったろ、お前の友達は無事に帰ってくるって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050507
					],
					"speakerTitle": "レグバ"
				},
				{
					"id": 750050507,
					"content": "ところで、その大きな石碑っつうのは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050508
					],
					"speakerTitle": "レグバ"
				},
				{
					"id": 750050508,
					"content": "（レグバに何を見たか話した…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050509
					]
				},
				{
					"id": 750050509,
					"content": "なに！「大霊」の意志の顕現に打ち勝ったのか！？しかもその話を聞く限り、「夜神の国」に行ったようだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050510
					],
					"speakerTitle": "レグバ"
				},
				{
					"id": 750050510,
					"content": "どうやら、お前らはただの異邦人じゃないようだ。夜神の国から帰ってきたやつを、この目で見れるなんて。俺の人生も捨てたもんじゃないな、ハハッ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050511
					],
					"speakerTitle": "レグバ"
				},
				{
					"id": 750050511,
					"content": "よし、これで「ちょっとしたトラブル」も解決だ。急いで上に戻るとしよう。封印を元に戻す方法も考えないとな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050512
					],
					"speakerTitle": "レグバ"
				},
				{
					"id": 750050512,
					"content": "おいおい…なにが「ちょっとしたトラブル」だよ！部族の「大霊」が意志を顕現させたんだぞ。そんでオイラたちに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050513
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750050513,
					"content": "なに、そんくらい問題ないさ。時間が経てば、また地脈から力が集まる。ほっとけばいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050514
					],
					"speakerTitle": "レグバ"
				},
				{
					"id": 750050514,
					"content": "ええと…部族の人間なのに、崇拝する対象への扱いが雑すぎやしないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050515
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750050515,
					"content": "ま、出会ったのが俺で良かったな。厳しいやつだったら、罰を受けることになってただろう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050516
					],
					"speakerTitle": "レグバ"
				},
				{
					"id": 750050516,
					"content": "えっ、それは勘弁だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050517
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750050517,
					"content": "それとお前も…もうここのものを取るんじゃないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050518
					],
					"speakerTitle": "レグバ"
				},
				{
					"id": 750050518,
					"content": "キュウ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050519
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050519,
					"content": "ハハッ、じゃ早くここを離れよう。他のご先祖様に怒られる前にな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "レグバ"
				}
			]
