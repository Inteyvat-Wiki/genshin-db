			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710130201,
					"content": "<color=#00E1FFFF>『神の目』</color>を手に入れたが、心に疑問が生まれた。魔物たちには言葉があり、感情があり、物作りもできる。見た目以外、人間とそう変わらない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710130202
					],
					"speakerTitle": "遺跡の宝物"
				},
				{
					"id": 710130202,
					"content": "心の疑問を石碑に刻むことにした。この石碑を読んだ者よ、私の疑問に答えてくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "遺跡の宝物"
				}
			]
		},
