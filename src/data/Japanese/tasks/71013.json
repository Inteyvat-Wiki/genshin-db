			},
			"dialogs": [
				{
					"id": 710130101,
					"content": "私と弟弟子は幼い頃から武術を学び、妖魔退治を志してきた。しかし<color=#00E1FFFF>『神の目』</color>なしでは、それは容易くなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710130102
					],
					"speakerTitle": "遺跡の宝物"
				},
				{
					"id": 710130102,
					"content": "<color=#00E1FFFF>『神の目』</color>を手に入れるために、弟弟子とここで修行することにした。この石碑はその証だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710130103
					],
					"speakerTitle": "遺跡の宝物"
				}
			]
		},
		{
			"id": 7101302,
			"completionStepIds": [
				7101302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7101302",
