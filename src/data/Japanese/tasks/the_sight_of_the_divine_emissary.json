			"dialogs": [
				{
					"id": 736870301,
					"content": "『お願いっ！私の仙狐宮司』、巫女系タイトルの獲得した票数は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870302
					],
					"speakerTitle": "由宇"
				},
				{
					"id": 736870302,
					"content": "『オルツィ嬢事件簿』、オルツィ嬢テーマの獲得した票数は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870303
					],
					"speakerTitle": "由宇"
				},
				{
					"id": 736870303,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870304
					],
					"speakerTitle": "由宇"
				},
				{
					"id": 736870304,
					"content": "今回の投票の流れは透明性が高く、結果が公平かつ公正であることを、ここにて宣言します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "由宇"
				}
			]
		}
	]
}