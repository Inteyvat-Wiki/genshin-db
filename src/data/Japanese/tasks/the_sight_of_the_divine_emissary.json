							"2"
						],
						"stepId": 7368701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"由宇",
					"鉄也"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736870101,
					"content": "もう人がいっぱい集まってるな。オイラにも見せてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736870102,
					"content": "はぁ、こんなにも票に差が開くとは。「演武伝心」のような稲妻ならではの試合なら、絶対政子さんのほうが勝つと思ってたのに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870103
					],
					"speakerTitle": "由宇"
				},
				{
					"id": 736870103,
					"content": "予想通りの結果だ。「オルツィ嬢事件簿」は気鋭の人気作品だからな。物語も面白いし、挿絵のフォンテーヌ衣装も特徴的だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870104
					],
					"speakerTitle": "鉄也"
				},
				{
					"id": 736870104,
					"content": "それに、オルツィ嬢の身分は神里家のご令嬢に相応しいと思わないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870105
					],
					"speakerTitle": "鉄也"
				},
				{
					"id": 736870105,
					"content": "う～ん…オルツィ嬢は強気で、悪戯好きだし、神里家のお嬢様とは全然似ても似つかないけど。でもフォンテーヌ衣装を着る彼女を見れるのはなかなか新鮮でいいかもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870106
					],
					"speakerTitle": "由宇"
				},
				{
					"id": 736870106,
					"content": "あれ、なに言ってんだこいつら。なんか状況がイマイチわからないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736870107,
					"content": "えっ、掲示板を見てみろ！演武伝心の衣装の投票項目は…えっと、「お願いっ！私の仙狐宮司」に「オルツィ嬢事件簿」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736870108,
					"content": "待て待て、このあいだ言ってた投票って、稲妻の四季の風物詩じゃなかったか？いつの間に娯楽小説の主人公の衣装になったんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870109,
						736870110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736870109,
					"content": "案を修正した？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736870111
					]
				},
				{
					"id": 736870111,
					"content": "これはちゃんと聞かないとな。今すぐ社奉行へ行って綾華に聞いてみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736870110,
					"content": "投票に何か問題があった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736870111
					]
				}
			]
		},
		{
			"id": 7368702,
			"completionStepIds": [
				7368702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7368702",
							"2"
						],
						"stepId": 7368702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"水田",
					"小野寺",
					"神里綾華"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736870201,
					"content": "申し訳ございません、投票用紙が入った二つの箱を取り違えてしまいました！小野寺さんが出張先から帰って気づいた時には、既に結果が公表された後でして",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870202
					],
					"speakerTitle": "水田"
				},
				{
					"id": 736870202,
					"content": "はぁ、機密漏洩を防ぐために、わざわざ投票用紙に題名を書かなかったことが、かえってあだになってしまいましたか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870203
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 736870203,
					"content": "えっ、嘘だろ…本当に演武伝心で着る衣装の投票にこんな問題が起きてるなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736870204,
					"content": "旅人さん、パイモンさん、貴方たちも投票の結果をご存じのようですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870205
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736870205,
					"content": "おう。オイラたちどころか、ここに来る途中みんなこの話題で持ちきりだったぞ。どうするつもりだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736870206,
					"content": "神里さん、このような重大な失態を犯したのは私たちの責任です。今すぐもう一度投票を行い、その際にしっかりと説明します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870207
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 736870207,
					"content": "いいえ、小野寺さん、少々お待ちください。まだ他の解決方法があるかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870208
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736870208,
					"content": "票を取り違えたことは、私たち大会陣営しか知らないこと。一般の民衆は投票に問題があったことにまだ気づいていません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870209
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736870209,
					"content": "それに、模擬試合で流行りの作品の衣装が出てくることについて、特に不平や不満の声は上がっていませんでした。むしろ逆に、それに驚いて喜んでいるようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870210
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736870210,
					"content": "大会の目的は、より多くの人に試合に興味を持っていただくことである以上、この不手際がもたらした結果を「失態」のままにすべきではないでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870211
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736870211,
					"content": "綾華、それってつまり…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736870212,
					"content": "はい。この結果を利用しましょう。最後の模擬試合で、私は投票結果の衣装を着て登場します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870213
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736870213,
					"content": "しかし…それではご迷惑をかけてしまいます。なにしろ小説の登場人物の衣装は、演武の衣装のように戦闘のために設計されてはいません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870214
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 736870214,
					"content": "大丈夫です。小説に登場したフォンテーヌ様式の衣装は、複雑なものではありませんし、あまり影響はないと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870215
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736870215,
					"content": "普段の服装とは違いますが、慣れるように頑張ります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870216
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736870216,
					"content": "おお、平然としてるけど、なんだか迫力がひしひしと伝わってくるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870217
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736870217,
					"content": "はい。分かりました…それでは、神里さんの提案で行きましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870218
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 736870218,
					"content": "模擬試合で最大限の実力を発揮していただくために、読者用の行事の衣装を、この二日間で神里さんの体型に合わせて調整します！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870219
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 736870219,
					"content": "はい、お願いします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870220
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736870220,
					"content": "綾華、小説の登場人物の衣装を着て模擬試合に出るなんて、本当に大丈夫なのか？オイラたちの前で無理してないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870221
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736870221,
					"content": "ご安心ください、無理はしていませんよ。それにちょっとだけ嬉しいんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870222
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736870222,
					"content": "今まで、華麗な衣装を着て舞台に上がることを考えると、動きがキレイかどうか、観客たちの期待に応えられるかどうかと、色々と心配してきました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870223
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736870223,
					"content": "しかし、小説の登場人物の衣装であれば、そのように考える必要はありません。なぜなら、作中の探偵のお嬢さんは、我が道を行くいたずらっ子で有名ですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870224
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736870224,
					"content": "これで模擬試合を観る皆様も、伝統の形を新たな楽しみと共に味わえるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870225
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736870225,
					"content": "（綾華はそんな風に考えてるんだ…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736870226
					]
				},
				{
					"id": 736870226,
					"content": "いえ、これだけではありませんね。私は心の中で、いつか普段とは違う姿になることを、ずっと望んでいたのかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870227
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736870227,
					"content": "旅人さん、知り合ったばかりの頃に貴方はこうおっしゃっていました。璃月、モンド…それぞれの国の服装には違った特徴があると。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870228
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736870228,
					"content": "あの時の私は、自分もこの異国様式を体験できる日が来るとは、思いもしませんでした。でも今は、かつて叶えられないと思っていた願いも、こうしてすぐ届くところにあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870229
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736870229,
					"content": "それにお母様も昔、異国の服装に憧れていました。今回また、お母様の願いを一つ叶えてあげられます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870230
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736870230,
					"content": "こう考えると、この特別な衣装は確かに喜ばしいものと呼べるかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870231
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736870231,
					"content": "へへっ、投票を取り違えはしたけど、結果的にいいほうに転んだみたいだな。よし、問題も無事解決できたし、試合会場へ向かおうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870232
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736870232,
					"content": "はい。旅人さんの実力を信じています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870233
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736870233,
					"content": "小野寺さんと服の採寸を済ませたら、会場へ行って貴方たちの試合を観に行きますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "神里綾華"
				}
			]
		},
		{
			"id": 7368703,
