			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パズ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736920101,
					"content": "やあ…旅人、こんにちは。その様子だと、学院フェスに参加しにきてくれたんだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920102
					],
					"speakerTitle": "パズ"
				},
				{
					"id": 736920102,
					"content": "もし興味があるなら、我がアムリタ学院の考案したミニゲームをやってみないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920103
					],
					"speakerTitle": "パズ"
				},
				{
					"id": 736920103,
					"content": "どんなミニゲーム？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736920104
					]
				},
				{
					"id": 736920104,
					"content": "名付けて「生体模倣」。我々が学院フェス期間中だけ開催しているミニゲームでね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920105
					],
					"speakerTitle": "パズ"
				},
				{
					"id": 736920105,
					"content": "このゲームでは、動物の行動パターンをいくつか紹介させてもらう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920106
					],
					"speakerTitle": "パズ"
				},
				{
					"id": 736920106,
					"content": "もちろん、これらの「パターン」は簡略化および整理されたものだから、とても分かりやすいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920107
					],
					"speakerTitle": "パズ"
				},
				{
					"id": 736920107,
					"content": "君がやるべきことは、用意されたこれらの模型を使って動物の行動をマネするだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920108,
						736920109
					],
					"speakerTitle": "パズ"
				},
				{
					"id": 736920108,
					"content": "聞くかぎりでは簡単そう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736920110
					]
				},
				{
					"id": 736920110,
					"content": "そうとも。「動物の習性には一定のパターンがある」というのは、理解しやすいし、誰もが納得する認識だろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920111
					],
					"speakerTitle": "パズ"
				},
				{
					"id": 736920111,
					"content": "しかし、そのシンプルな言葉の裏には、探究しきれない謎が隠されているんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920112
					],
					"speakerTitle": "パズ"
				},
				{
					"id": 736920112,
					"content": "まあ…今は学術的な観点は置いといて、気軽に動物の習性を体験してもらおうというわけさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920113,
						736920115
					],
					"speakerTitle": "パズ"
				},
				{
					"id": 736920113,
					"content": "体験してみたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736920114
					]
				},
				{
					"id": 736920114,
					"content": "では、こちらに来てくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パズ"
				},
				{
					"id": 736920115,
					"content": "他に用事がある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736920116
					]
				},
				{
					"id": 736920116,
					"content": "構わないさ。期間中、私はずっとブースにいる。体験したいと思い立ったら、いつでも来てくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パズ"
				},
				{
					"id": 736920109,
					"content": "そんなに難しくなさそう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736920110
					]
				}
			]
		}
	]
}