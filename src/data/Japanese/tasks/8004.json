			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 80040301,
					"content": "これって…都市じゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80040302,
					"content": "空中に浮かんでるし、まるごと逆さまになってるぞ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040303,
						80040304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80040303,
					"content": "目を見張る光景だ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040402
					]
				},
				{
					"id": 80040402,
					"content": "この都市を見てると…なにか思い出しそうな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80040403,
					"content": "えーっと、ほら、なんだっけ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80040404,
					"content": "「穢れた逆さ神像」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040405
					]
				},
				{
					"id": 80040405,
					"content": "そうそう、それだ！不気味な雰囲気が漂ってるし、逆さなのもあの時と同じくらい衝撃的というか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80040406,
					"content": "こうなってくると、やっぱり層岩巨淵の下って、アビス教団となにかしら関係があるのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040407
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80040407,
					"content": "これは、ますます調査しないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80040408,
					"content": "えっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040409
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80040409,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040410,
						80040411
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80040410,
					"content": "ダインスレイヴ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040412
					]
				},
				{
					"id": 80040412,
					"content": "まさか、ここで貴様たちに会うとはな、予想外だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040413
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80040413,
					"content": "久しぶりだな、ダイン…いや、待った、どうしておまえが層岩巨淵にいるんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040414
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80040414,
					"content": "層岩巨淵…なるほど、ここは層岩巨淵の地下か。足を踏み入れたことは一度もなかったが…このようになっていたとは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040415
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80040415,
					"content": "ダインには聞きたいことが山ほどある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040416
					]
				},
				{
					"id": 80040416,
					"content": "ああ、前回の「出会い」と「別れ」は些か急なものだったからな、貴様が逸る気持ちも理解できる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040417
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80040417,
					"content": "それに、このような「偶然」が目の前で起きたんだ。貴様の疑問に俺も答えてやるべきだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040418,
						80040419
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80040418,
					"content": "じゃあ、まずはどうしてここにいるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040420
					]
				},
				{
					"id": 80040420,
					"content": "貴様も思い当たるものがあるはずだ。先日、俺は「アビスの使徒」の痕跡を再び見つけ、それを追っていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040421
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80040421,
					"content": "ただ忌々しいことに、やつは俺に追い詰められると、以前と同じ手口で逃げようとしてな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040422
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80040422,
					"content": "その後を追って、俺も転移の扉をくぐった。しかし見ての通り、やつとは違う場所に転移してしまったようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040423,
						80040424
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80040423,
					"content": "ということは前回、転移した後…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040425
					]
				},
				{
					"id": 80040425,
					"content": "ああ、これまでの経験から推測するに…アビスの転移能力は単に点と点を結んだものではなく、網目状になっている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040426
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80040426,
					"content": "転移の扉がどこに繋がり、網目をどう辿るのかは、やつらの思うがままなのだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040427
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80040427,
					"content": "この世界にあるワープポイントと、なんだか似てるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040428
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80040428,
					"content": "前回、貴様の血縁を追って転移の扉をくぐったが、気が付くと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040429
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80040429,
					"content": "周りには誰もおらず…俺は一人、あの風魔龍の巣にいた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040430
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80040430,
					"content": "そうだったのか。ところで、あの最古の「耕運機」の目はどうなったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040431
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80040431,
					"content": "ああ、それなら既に手を打ってある。「運命の織機」の計画、その真相を突き止めるまで、アビスの手に落ちることはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040432,
						80040433
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80040432,
					"content": "それじゃあ、改めて自己紹介してくれる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040434
					]
				},
				{
					"id": 80040434,
					"content": "ふん、その肩書きをまだ覚えていたか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040435
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80040435,
					"content": "別に隠す気などない。それはかつて、カーンルイアの栄光を浴びた称号だ。しかし、今となっては…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040436
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80040436,
					"content": "…ただの皮肉であり、呪いに過ぎない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040437
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80040437,
					"content": "俺は、国の滅亡を見届けた宮廷親衛隊隊長だ。この肩書きを口にしたくない理由など十分過ぎるほどにある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040438
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80040438,
					"content": "#どうやら、おまえの{M#妹}{F#お兄}さんが言ったことは本当だったみたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040439,
						80040440
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80040439,
					"content": "#{M#俺}{F#私}の{M#妹}{F#お兄ちゃん}の過去について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040441
					]
				},
				{
					"id": 80040441,
					"content": "俺たちは、かつて「旅の仲間」だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040442
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80040442,
					"content": "あれは、運命を求める苦難に満ちた旅。ただ…俺たちは、共に「終点」を迎えることができなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040443
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80040443,
					"content": "「旅の終点」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040444
					]
				},
				{
					"id": 80040444,
					"content": "際限なく質問を続ける前に、先ほどの俺の言葉を思い出してみろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040445
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80040445,
					"content": "仮に、「転移の網」の推測が正しかった場合、アビス教団にとって、ここは転移先として設定するほどの価値があるということだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040446
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80040446,
					"content": "アビス教団が、ここでコッソリなにかしてるってことか？オイラと旅人の予想通りだったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040447
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80040447,
					"content": "つまり、今この瞬間も…「アビス」の目に映っている可能性がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040448
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80040448,
					"content": "や…やめろって、そう言われると怖くなってくるだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040449,
						80040450
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80040449,
					"content": "まずは調査をしよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040451
					]
				},
				{
					"id": 80040451,
					"content": "ふっ、賢明な判断だ。そこの岩壁の近くに火があるようだ、そこから調べるとしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80040450,
					"content": "ひとまず、ダインのことは信じるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040451
					]
				},
				{
					"id": 80040440,
					"content": "二人の間には、一体何があったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040441
					]
				},
				{
					"id": 80040433,
					"content": "「末光の剣」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040434
					]
				},
				{
					"id": 80040424,
					"content": "#{M#妹}{F#お兄ちゃん}には追いつけなかったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040425
					]
				},
				{
					"id": 80040419,
					"content": "さっきの転移はどういうこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040420
					]
				},
				{
					"id": 80040411,
					"content": "変わった登場の仕方だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040412
					]
				},
				{
					"id": 80040304,
					"content": "想像を絶する光景だ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040402
					]
				}
			]
		},
