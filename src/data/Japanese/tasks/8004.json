			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"キャサリン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80040101,
					"content": "ようこそいらっしゃいました、旅人さん。何という巡り合わせでしょう、ふふっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040102
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 80040102,
					"content": "キャサリン、こんにちは。なにか依頼はあるか？それにしても…今日は随分とご機嫌みたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80040103,
					"content": "はい。実は今朝早く、神社へおみくじを引きに行ったんです。そしたら、近々「思いがけない再会」を果たすかもしれないと、巫女さんに言われまして。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040104
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 80040104,
					"content": "キャサリンが神社におみくじ？な、なんだか珍しい光景だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80040105,
					"content": "あ、いや、そこじゃなくて。おまえ、たった一日のうちに稲妻まで行って帰ってきたってことか？ここ、璃月だぞ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80040106,
					"content": "ふふっ、私もたまにはプライベートを楽しみたかったもので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040107
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 80040107,
					"content": "それで、さっき言ってた「思いがけない再会」って、オイラたちのことなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80040108,
					"content": "さあ、どうでしょう？ただ、この期待感が胸にある限り、誰と会っても嬉しい気持ちになれそうです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040109
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 80040109,
					"content": "はぁ…オイラたちほぼ毎日会ってるけどな。キャサリンが喜んでくれてるなら別にいっか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040110,
						80040111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80040110,
					"content": "思いがけない再会か…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040112
					]
				},
				{
					"id": 80040112,
					"content": "ああ…おまえの気持ち、オイラもわかるぞ。巫女さんの言ったことが当たってるといいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80040113,
					"content": "#だって、おまえの{M#妹さん}{F#お兄さん}は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80040114,
					"content": "その落ち込んだご様子…私、何か触れてはいけないことを言ってしまったのでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040115
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 80040115,
					"content": "いや、大丈夫だ、気にしないでくれ。それよりも依頼の話に戻ろうぜ。なにかオイラたちにぴったりな依頼はないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80040116,
					"content": "ええ、それでしたら、ちょうどいい依頼があります。鉱夫の方からの依頼でして、層岩巨淵を調査してほしいとのことです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040117
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 80040117,
					"content": "えっ、そこって封鎖されてたよな？もう解除されたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80040118,
					"content": "詳細については、依頼人の玥輝さんに聞いてみてください。彼は今、層岩巨淵の近くにいるはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040119
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 80040119,
					"content": "おう、わかった！ありがとな、キャサリン。それじゃ、出発するか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80040120,
					"content": "はい、星と深淵を目指せ…えっと、今回は本当に「深淵」を目指しているようですね。幸運を祈ります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 80040111,
					"content": "もしかして…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040112
					]
				}
			]
		},
		{
			"id": 800402,
			"completionStepIds": [
				800402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800402",
							"2"
						],
						"stepId": 800402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"玥輝"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80040201,
					"content": "こんにちは！えっと…おまえが玥輝か？オイラたち、冒険者協会の依頼で来たんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80040202,
					"content": "ああ、こんにちは。その依頼なら俺が出したもので間違いない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040203
					],
					"speakerTitle": "玥輝"
				},
				{
					"id": 80040203,
					"content": "うん？そちらの方はどこかで見たことがあるような…もしかして、有名な冒険者さんだろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040204,
						80040205
					],
					"speakerTitle": "玥輝"
				},
				{
					"id": 80040204,
					"content": "#{M#俺}{F#私}のことを話すと長くなる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040206
					]
				},
				{
					"id": 80040206,
					"content": "そうか、分かった。まずは自己紹介をさせてくれ。俺は玥輝、つい先日、層岩巨淵の採掘許可をもらった鉱夫だ。それから、ここには俺の下で働いてくれているやつらが何人かいる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040207
					],
					"speakerTitle": "玥輝"
				},
				{
					"id": 80040207,
					"content": "えっ？層岩巨淵の採掘許可ってもらえるものなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80040208,
					"content": "ああ、玉京台のやつらもやっと融通が利くようになってな。千岩軍の保護下っていう条件付きで、浅いところの鉱物であれば採掘の許可が下りるようになったんだ。で、その許可を最初にもらったのが俺らだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040209
					],
					"speakerTitle": "玥輝"
				},
				{
					"id": 80040209,
					"content": "だが最近、どうも奇妙なことが起きていてな。鉱夫たちがみんな怯えてるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040210
					],
					"speakerTitle": "玥輝"
				},
				{
					"id": 80040210,
					"content": "奇妙なこと…なにが起こったんだ？オイラたち、詳しい状況をまだなにも聞かされてないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80040211,
					"content": "まあ、大したことじゃないんだが、無視もできない不気味なことでな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040212
					],
					"speakerTitle": "玥輝"
				},
				{
					"id": 80040212,
					"content": "ある日、うちの鉱夫が休憩していたら、意識の朦朧としたヒルチャールたちが前を通り過ぎていったそうなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040213
					],
					"speakerTitle": "玥輝"
				},
				{
					"id": 80040213,
					"content": "ただ、そのヒルチャールたちは彼に目もくれず、層岩巨淵の奥へと進んで行ったらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040214
					],
					"speakerTitle": "玥輝"
				},
				{
					"id": 80040214,
					"content": "それから何日か彼が様子を見ていると、同じようなことが時々起こっていると分かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040215
					],
					"speakerTitle": "玥輝"
				},
				{
					"id": 80040215,
					"content": "もしかして、好奇心旺盛なヒルチャールがいて、この辺をうろうろしてただけなんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80040216,
					"content": "いや、それがおかしなことに、層岩巨淵に来たヒルチャールたちは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040217
					],
					"speakerTitle": "玥輝"
				},
				{
					"id": 80040217,
					"content": "…「入ったらもう出てこないんだ」と、彼が言っていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040218
					],
					"speakerTitle": "玥輝"
				},
				{
					"id": 80040218,
					"content": "そのヒルチャールたちを確認できるのは行きの片道だけ。中に入ったらもう出てくることがないらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040219
					],
					"speakerTitle": "玥輝"
				},
				{
					"id": 80040219,
					"content": "しかも、この間から似たようなことがさらに増えていてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040220
					],
					"speakerTitle": "玥輝"
				},
				{
					"id": 80040220,
					"content": "「あのヒルチャールたちの目的は？」「あの後、あいつらはどうなったんだ？」「何か悪いことでも企んでるんじゃないか？」と…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040221
					],
					"speakerTitle": "玥輝"
				},
				{
					"id": 80040221,
					"content": "そういった考えが次々と鉱夫たちの頭をよぎり、恐怖のあまり仕事に手がつかなくなってるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040222
					],
					"speakerTitle": "玥輝"
				},
				{
					"id": 80040222,
					"content": "うぅ…その気持ち、オイラもわかるぞ。聞いただけで鳥肌が立ってきた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040223,
						80040224
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80040223,
					"content": "想像しただけで怖い…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040225
					]
				},
				{
					"id": 80040225,
					"content": "ああ、未知から生まれる恐怖こそ、一番恐ろしいものだ。真相を突き止めない限り、どうにも安心して働けそうにない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040226
					],
					"speakerTitle": "玥輝"
				},
				{
					"id": 80040226,
					"content": "えっと…この依頼、オイラたち本当に受けるのか？その、鉱夫さん、もう少し考えさせてくれないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040227
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80040227,
					"content": "#{M#俺}{F#私}たちに任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040228
					]
				},
				{
					"id": 80040228,
					"content": "おい！？オイラの意見もちゃんと聞いてくれよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040229,
						80040230
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80040229,
					"content": "こういった変わったことには…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040231
					]
				},
				{
					"id": 80040231,
					"content": "そっか。よし…わ、わかったぞ、オイラも頑張る。もしかしたら、おまえの家族の手がかりが見つかるかもしれないしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040232
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80040232,
					"content": "それにここで退いたら、この先ずっと気になってモヤモヤするだろうし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040233
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80040233,
					"content": "二人とも、この依頼を受けてくれないか？せっかく手に入れた採掘許可だ、俺も無駄にはしたくない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040234
					],
					"speakerTitle": "玥輝"
				},
				{
					"id": 80040234,
					"content": "おう、オイラたちに任せろ！なにが起こってるのか、気にもなるからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040235
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80040235,
					"content": "そうか、助かるよ！今、あのヒルチャールたちが向かった先を教える…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玥輝"
				},
				{
					"id": 80040230,
					"content": "「アビス教団」が関係していると思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040231
					]
				},
				{
					"id": 80040224,
					"content": "確かに奇妙なことだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040225
					]
				},
				{
					"id": 80040205,
					"content": "まずは依頼について話そう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040206
					]
				}
			]
		},
		{
			"id": 800403,
			"completionStepIds": [
				800403,
				800404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
