					"キヌア"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752630201,
					"content": "#{M#俺}{F#私}もエントリーしたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752630202
					]
				},
				{
					"id": 752630202,
					"content": "おっと、予想外の展開です。勇敢な挑戦者が現れました！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630203
					],
					"speakerTitle": "キヌア"
				},
				{
					"id": 752630203,
					"content": "ほう？身の程知らずのチビめ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630204
					],
					"speakerTitle": "キヌア"
				},
				{
					"id": 752630204,
					"content": "まさに波乱に次ぐ波乱の展開です…最後の勝者は果たして誰になるのか？期待の目で見守りましょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630205
					],
					"speakerTitle": "キヌア"
				},
				{
					"id": 752630205,
					"content": "スタッフがレース場を整備し、観客も集まってきた…ついにスタートラインに立った…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
