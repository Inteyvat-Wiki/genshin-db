			"dialogs": [
				{
					"id": 752630501,
					"content": "レース終了！レース終了です！信じられない結果となりました！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630502
					],
					"speakerTitle": "キヌア"
				},
				{
					"id": 752630502,
					"content": "#発表します。勝者は——{NICKNAME}です！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630503
					],
					"speakerTitle": "キヌア"
				},
				{
					"id": 752630503,
					"content": "うおお！あいつすごく強いぞ！「電光」と「石火」に勝つなんて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630504
					]
				},
				{
					"id": 752630504,
					"content": "まるで金色の稲妻だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630505
					]
				},
				{
					"id": 752630505,
					"content": "オイオイ、銀色の稲妻は？銀色の稲妻は見えなかったのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630506
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752630506,
					"content": "完敗だ…こんなスピードはおそらく一生出せない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630507
					],
					"speakerTitle": "「疾風のナナシアン」"
				},
				{
					"id": 752630507,
					"content": "諦めないで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752630508
					]
				},
				{
					"id": 752630508,
					"content": "お…お前を目標に頑張るよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630509
					],
					"speakerTitle": "「疾風のナナシアン」"
				},
				{
					"id": 752630509,
					"content": "～～～♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630510
					]
				},
				{
					"id": 752630510,
					"content": "～～～♬",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630511
					]
				},
				{
					"id": 752630511,
					"content": "今回の優勝賞品を授与します。どうぞお受け取りください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630512
					],
					"speakerTitle": "キヌア"
				},
				{
					"id": 752630512,
					"content": "あなたの名前は、のんびりスピードレースの歴史に永久に刻まれるでしょう！",
					"roleType": "TALK_ROLE_NPC",
