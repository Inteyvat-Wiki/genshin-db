			"dialogs": [
				{
					"id": 752630301,
					"content": "信じられません！本当に「疾風のナナシアン」を破る人が現れました！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630302
					],
					"speakerTitle": "キヌア"
				},
				{
					"id": 752630302,
					"content": "風のように現れた挑戦者が、本日の優勝を勝ち取りました。さあ——盛大な拍手を！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630303
					],
					"speakerTitle": "キヌア"
				},
				{
					"id": 752630303,
					"content": "まさか…負けるなんて！ありえない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630304
					],
					"speakerTitle": "「疾風のナナシアン」"
				},
				{
					"id": 752630304,
					"content": "す…すごいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630305
					]
				},
				{
					"id": 752630305,
					"content": "しかーし！長年のファンならご存知でしょう！のんびりスピードレース場に現れた最強の選手は、「疾風のナナシアン」だけではありません！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630306
					],
					"speakerTitle": "キヌア"
				},
				{
					"id": 752630306,
					"content": "「疾風のナナシアン」以前に、天下無敵とさえ呼ばれた選手が二名いました。今日は彼らも、レース場に来ています！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630307
					],
					"speakerTitle": "キヌア"
				},
				{
					"id": 752630307,
					"content": "それではお迎えしましょう、「電光」——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630308
					],
					"speakerTitle": "キヌア"
				},
				{
					"id": 752630308,
					"content": "～～～♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630309
					]
				},
				{
					"id": 752630309,
					"content": "「石火」——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630310
					],
					"speakerTitle": "キヌア"
				},
				{
					"id": 752630310,
					"content": "～～～♬",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630311
					]
				},
				{
					"id": 752630311,
					"content": "挑戦者さん、この二人は本当に恐ろしい相手ですよ。先ほど見せてもらった実力では、勝つのは至難の業かもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630312
					],
					"speakerTitle": "キヌア"
				},
				{
					"id": 752630312,
					"content": "準備はいいですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630313
					],
					"speakerTitle": "キヌア"
				},
				{
					"id": 752630313,
					"content": "準備オッケー！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752630314
					]
				},
				{
					"id": 752630314,
					"content": "スタッフがレース場を整備し、観客も集まってきた…ついにスタートラインに立った…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
