			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"キヌア"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752630101,
					"content": "ご来場の皆様、間もなくのんびりスピードレースが始まります！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630102
					],
					"speakerTitle": "キヌア"
				},
				{
					"id": 752630102,
					"content": "昨日、一昨日、そして一昨々日と三連覇中のチャンピオン、「疾風のナナシアン」を倒し、本日の大賞を手にする人は現れるのでしょうか！エントリーがお済みでないお客様は最後のチャンスです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630103
					],
					"speakerTitle": "キヌア"
				},
				{
					"id": 752630103,
					"content": "「疾風のナナシアン」に挑戦する方は？エントリーする人はもういませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630104
					],
					"speakerTitle": "キヌア"
				},
				{
					"id": 752630104,
					"content": "「疾風のナナシアン」は強すぎるよ。もう三日連続で賞品をかっさらってるんだ。誰も勝てやしないって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630105
					]
				},
				{
					"id": 752630105,
					"content": "グルルルル！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630106
					]
				},
				{
					"id": 752630106,
					"content": "えっ？挑戦する気か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630107
					]
				},
				{
					"id": 752630107,
					"content": "ふん、もはや竜を出場させるしかないのか？臆病者どもめ、それぞれ自分の竜を出すがいい。この「疾風のナナシアン」が真のスピードを教えてやる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630108
					],
					"speakerTitle": "キヌア"
				},
				{
					"id": 752630108,
					"content": "まさに前代未聞ののんびりスピードレースです！たくましい竜の仲間たちは三連覇中の「疾風のナナシアン」を倒せるでしょうか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キヌア"
				}
			]
		},
		{
			"id": 7526302,
			"completionStepIds": [
				7526301
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
