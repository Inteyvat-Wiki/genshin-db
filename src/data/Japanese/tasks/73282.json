				"objectNames": [
					"タッドラー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732822801,
					"content": "（彼女は慌てて目線をそらし、緊張した様子で俯いた。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822802,
						732822805
					],
					"speakerTitle": "タッドラー"
				},
				{
					"id": 732822802,
					"content": "大丈夫？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822803
					]
				},
				{
					"id": 732822803,
					"content": "ごめん、狩りは終わり。私は父上の「猟鷹」だから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822804
					],
					"speakerTitle": "タッドラー"
				},
				{
					"id": 732822804,
					"content": "でも…私は大丈夫。心配しないで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822808,
						732822810
					],
					"speakerTitle": "タッドラー"
				},
				{
					"id": 732822808,
					"content": "そんなに極端なの…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822809
					]
				},
				{
					"id": 732822809,
					"content": "極端…？分からない。物心がついたときからこのように生きてきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822814
					],
					"speakerTitle": "タッドラー"
				},
				{
					"id": 732822814,
					"content": "あっ…でも…あなたとパイモンのこと、そして旅のことも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822815
					],
					"speakerTitle": "タッドラー"
				},
				{
					"id": 732822815,
					"content": "機会があれば、もっと聞かせてほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822816
					],
					"speakerTitle": "タッドラー"
				},
				{
					"id": 732822816,
					"content": "いいぞ、オイラたちにはいーーーっぱい物語があるからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822817,
						732822818
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732822817,
					"content": "うん、いいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822819
					]
				},
				{
					"id": 732822819,
					"content": "ははっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822820
					],
					"speakerTitle": "タッドラー"
				},
				{
					"id": 732822820,
					"content": "コホン、いやなんでもない、ただ嬉しいんだ…ありがとう…ええと、旅人さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "タッドラー"
				},
				{
					"id": 732822818,
					"content": "聞きたいなら、いつでも聞かせてあげる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822819
					]
				},
				{
					"id": 732822810,
					"content": "自分のために生きようと思ったことはない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822811
					]
				},
				{
					"id": 732822811,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822812
					],
					"speakerTitle": "タッドラー"
				},
				{
					"id": 732822812,
					"content": "…いや、ない。思ったこともないし、期待もしていない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822813
					],
					"speakerTitle": "タッドラー"
				},
				{
					"id": 732822813,
					"content": "冷酷無情な砂漠に生きながら、自分のことを考える余裕などない。私がいなくてもみんな生きていけるが、部族がなければ…私は一人では生きていけない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822814
					],
					"speakerTitle": "タッドラー"
				},
				{
					"id": 732822805,
					"content": "#{M#君}{F#あなた}とマシーラの関係について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822806
					]
				},
				{
					"id": 732822806,
					"content": "前にも言ったはずだ。彼は私の父、私は彼の「猟鷹」。私は彼の命令に従い、狩りをし、彼のために死ぬ…彼はタニットの意志の代表だから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822807
					],
					"speakerTitle": "タッドラー"
				},
				{
					"id": 732822807,
					"content": "もし私が父上の命令を実行できないときが来たら、「猟鷹」としての命も終わりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822808,
						732822810
					],
					"speakerTitle": "タッドラー"
				}
			]
		},
		{
			"id": 7328229,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
