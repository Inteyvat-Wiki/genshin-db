					"マシーラ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732820101,
					"content": "おお、来てくれたか！少し話を聞いてくれないか。これが最後の頼みになるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820102,
						732820104
					],
					"speakerTitle": "マシーラ"
				},
				{
					"id": 732820102,
					"content": "うん、何を手伝ってほしいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820103
					]
				},
				{
					"id": 732820103,
					"content": "タッドラーから、君に話したいことがあるそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820106
					],
					"speakerTitle": "マシーラ"
				},
				{
					"id": 732820106,
					"content": "ええっ…そんなにあらたまって、どうしたんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732820107,
					"content": "北国の遺跡、君たちが初めて会った辺り…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820108,
						732820110
					],
					"speakerTitle": "マシーラ"
				},
				{
					"id": 732820108,
					"content": "何を言ってるの…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820109
					]
				},
				{
					"id": 732820109,
					"content": "北国の遺跡、君たちが初めて会った辺り…これを忘れないでくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マシーラ"
				},
				{
					"id": 732820110,
					"content": "そう、分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820111
					]
				},
				{
					"id": 732820111,
					"content": "ああ、彼女を頼んだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マシーラ"
				},
				{
					"id": 732820104,
					"content": "他に用事があるんだけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820105
					]
				},
				{
					"id": 732820105,
					"content": "ぜひとも聞いてやってくれ…タッドラーがどうしても話したいと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820106
					],
					"speakerTitle": "マシーラ"
				}
			]
		},
