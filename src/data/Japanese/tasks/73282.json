			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"リルパァール"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732820601,
					"content": "くっ…マシーラのやつ、いなくなってるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820602
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732820602,
					"content": "あるのは書き置きだけですね…まったく、あの老いぼれキツネ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820603
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 732820603,
					"content": "君がこれを読んでいる頃、私はすでに峡谷の深くにある避難所に身を隠しているはずだ。\\n君の首がまだ両肩の間に繋がっているなら、タッドラーの選択を悲しまないでほしい。\\n\\nこの狩りはまだ終わらないだろう。それどころか嵐の始まりだ。\\nタニットの長老、狩人マシーラより、謹んで警告を——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820604
					],
					"speakerTitle": "調べる"
				},
				{
					"id": 732820604,
					"content": "あいつの書いてること…意味が分からないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820605
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732820605,
					"content": "何かの圧力により、部族を離れたようですね…そして、あなたに警告のメッセージを残した。ふん、タニットで…何か見えない波が荒れ狂っているのでしょうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リルパァール"
				}
			]
		},
		{
			"id": 7328228,
			"completionStepIds": [],
