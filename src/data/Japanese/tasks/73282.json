			"dialogs": [
				{
					"id": 732822901,
					"content": "おお、来てくれたか、尊き「ジンニーの主」よ。今日はどのような用で？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822902,
						732822906
					],
					"speakerTitle": "マシーラ"
				},
				{
					"id": 732822902,
					"content": "タッドラーについて…",
