			"trigger": {
				"objectNames": [
					"タッドラー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732820401,
					"content": "来てくれたのか、良かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820402,
						732820403
					],
					"speakerTitle": "タッドラー"
				},
				{
					"id": 732820402,
					"content": "#{M#俺}{F#私}に話したいことがあるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820404
					]
				},
				{
					"id": 732820404,
					"content": "この時間の砂漠は、とてもきれいだ。私の好きな景色なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820405
					],
					"speakerTitle": "タッドラー"
				},
				{
					"id": 732820405,
					"content": "だが…今までここで仲間と一緒に、こうやって太陽がゆっくりと沈むのを見る機会はなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820406
					],
					"speakerTitle": "タッドラー"
				},
				{
					"id": 732820406,
					"content": "そうなのか。砂漠が全部真っ赤に染まってて…すごくきれいだな、それに静かだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820407
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732820407,
					"content": "でもタッドラー、おまえがわざわざオイラたちを呼んだのはこのためなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732820408,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820409
					],
					"speakerTitle": "タッドラー"
				},
				{
					"id": 732820409,
					"content": "タニットにとってあなたは客だが、「猟鷹」にとっては潜在的な「獲物」…でも、生き残るのはあなたであってほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820410
					],
					"speakerTitle": "タッドラー"
				},
				{
					"id": 732820410,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820411
					]
				},
				{
					"id": 732820411,
					"content": "だから、ごめん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "タッドラー"
				},
				{
					"id": 732820403,
					"content": "元気にしてた？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820404
					]
				}
			]
		},
		{
			"id": 7328206,
