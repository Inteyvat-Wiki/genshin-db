			"dialogs": [
				{
					"id": 730190401,
					"content": "Bonjour !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190402,
					"content": "Oh, bonjour... Avez-vous besoin de quelque chose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190403
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190403,
					"content": "Oui, on cherche quelque chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190404,
					"content": "Haha, bien sûr, tout le monde « cherche quelque chose ». Mais si vous me dites juste que c'est « quelque chose », je ne vais pas savoir ce que vous voulez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190405
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190405,
					"content": "Ah... Oui. Comment dire, ce que l'on veut, c'est...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190406,
					"content": "Un truc blanc et carré...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190407
					]
				},
				{
					"id": 730190407,
					"content": "Blanc et carré ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190408
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190408,
					"content": "Oui, quelque chose qui s'effrite quand on le frotte et qu'on emballe dans une bulle toute dure !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190409,
					"content": "En voilà une étrange description...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190410
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190410,
					"content": "Je ne suis pas vraiment sûr de ce que c'est, mais ce truc carré et blanc dont vous parlez, à quoi sert-il ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190411
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190411,
					"content": "Savez-vous quel usage on en fait ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190412,
						730190414
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190412,
					"content": "Ça se mange...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190413
					]
				},
				{
					"id": 730190413,
					"content": "Une chose qui se mange, blanche et carrée...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190416
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190416,
					"content": "Ah ! J'ai compris. Je vois très bien ce que voulez... Hahahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190417
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190417,
					"content": "Qu'est-ce qu'il y a de si drôle !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190418,
					"content": "Ah là là... Hahahahaha, une chose carrée et blanche qui devient du sable quand on le frotte entre les doigts... Et qu'on peut manger...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190419
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190419,
					"content": "Ce ne serait pas du sucre, par hasard ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190420
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190420,
					"content": "Et cette bulle toute dure, ça ne serait pas la bouteille qu'on utilise pour transporter le sucre ? Une bulle toute dure, hahahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190421
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190421,
					"content": "Ah, alors c'est du sucre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190422,
						730190423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190422,
					"content": "C'est un peu gênant...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190424
					]
				},
				{
					"id": 730190424,
					"content": "Hahaha, j'en ai les larmes aux yeux. Je ne sais pas à quand remonte la dernière fois où j'ai ri comme ça, après toutes ces années à me démener pour faire marcher mon commerce...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190425
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190425,
					"content": "En parlant de ça, ça me rend nostalgique. Je me souviens qu'il y a longtemps, quand j'étais enfant... j'avais un ami qui m'a dit à peu près la même chose la première fois qu'il a goûté au sucre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190426
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190426,
					"content": "Il était assez surpris. « Ce truc blanc et carré est si délicieux ! C'est merveilleux ! C'est le goût du bonheur. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190427
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190427,
					"content": "Haha... C'était il y a tellement d'années que je ne me rappelle même pas à quoi il ressemblait quand j'y repense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190428
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190428,
					"content": "Ah là là... Vous m'avez bien fait rire, alors je vous fais cadeau de cette bouteille de sucre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190429
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190429,
					"content": "Merci.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190430
					]
				},
				{
					"id": 730190430,
					"content": "Faites attention quand vous la tenez. C'est certes une bulle toute dure, mais elle se cassera si vous la faites tomber. Une « bulle toute dure », hahahahaha !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190423,
					"content": "C'est un peu la honte...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190424
					]
				},
				{
					"id": 730190414,
					"content": "Ça se cuisine...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190415
					]
				},
				{
					"id": 730190415,
					"content": "Une chose blanche et carrée qui se cuisine, ce serait un assaisonnement ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190416
					],
					"speakerTitle": "Iaanesh"
				}
			]
		},
