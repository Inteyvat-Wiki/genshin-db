				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730190101,
					"content": "Prends bien la pluie et grandis vite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190102
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190102,
					"content": "Bonjour ! Tu es Ara... Ara-quoi, déjà ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190103,
						730190105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190103,
					"content": "Tu es le frère d'Arapacati ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190104
					]
				},
				{
					"id": 730190104,
					"content": "Oh, bien joué, ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190107,
					"content": "Grandis, grandis pour devenir un plat délicieux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190108
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190108,
					"content": "Il ne réagit pas du tout à ce qu'on lui dit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190105,
					"content": "Arasaka.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190106
					]
				},
				{
					"id": 730190106,
					"content": "Arasaka ! Tu es Arasaka ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190107
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7301902,
			"completionStepIds": [
				7301902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301902",
							"2"
						],
						"stepId": 7301902,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730190201,
					"content": "#Ah ! {M#Un}{F#Une} nara... {M#Il}{F#Elle} est si {M#grand}{F#grande}, ça fait peur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190202
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190202,
					"content": "S'il te plaît... Ne les cueille pas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190203
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190203,
					"content": "Bon, d'accord. On ne les cueille pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190204,
					"content": "Ouf... Ces pêches zaytuns, je les ai toutes plantées une à une, alors qu'elles n'étaient que des graines...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190205
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190205,
					"content": "#N—Non ! {M#Méchants}{F#Méchantes} naras ! Comment pouvez-vous cueillir les pêches zaytuns des autres !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190206
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190206,
					"content": "P—Pourquoi les naras font des choses si effroyables...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190207
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190207,
					"content": "On n'a rien fait, on n'a même pas eu le temps de les cueillir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190208,
					"content": "C'est déjà effrayant alors que vous n'avez rien fait, alors imaginez si vous aviez fait quelque chose, je serais mort de peur !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190209
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190209,
					"content": "Quoi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190210,
					"content": "Non, Arasaka... Réfléchis bien, fais-le pour tes pêches zaytuns, pour ton entraînement culinaire... Je ne peux pas reculer maintenant, je ne dois pas avoir peur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190211
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190211,
					"content": "Tu es donc vraiment Arasaka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190212,
					"content": "Ouah, c—comment vous savez mon nom... D'où venez-vous... Vous, vous connaissez mon nom alors qu'on vient à peine de se rencontrer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190213,
						730190216
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190213,
					"content": "Tu viens de le dire...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190214
					]
				},
				{
					"id": 730190214,
					"content": "Quel malheur, c'est fini, mon nom va être utilisé pour une terrible malédiction... S'il vous plaît, par pitié, épargnez ma vie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190215
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190215,
					"content": "Je peux tout faire, sauf vous donner des pêches zaytuns...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190219
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190219,
					"content": "Ne t'inquiète pas, c'est Arapacati qui a demandé qu'on vienne te trouver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190220,
					"content": "A—Arapacati ? Ah, ma « sœur » bien-aimée, le soleil de la forêt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190221
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190221,
					"content": "Vous informez Arasaka des derniers événements...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730190222
					]
				},
				{
					"id": 730190222,
					"content": "Ouah, l—le Festival Utsava arrive si vite... Hé, vous êtes des naras qui vont participer à la fête ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190223
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190223,
					"content": "#Je suis désolé de vous avoir pris pour des {M#méchants}{F#méchantes}. Vous êtes de {M#gentils}{F#gentilles} naras, et seuls les bons naras peuvent entrer à Vanarana et participer au Festival Utsava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190224
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190224,
					"content": "Le Festival Utsava approche, si je rentre à Vanarana sans avoir fini mon entraînement culinaire... Ça ne va pas... Mais je dois quand même participer à la fête...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190225
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190225,
					"content": "Pourquoi tu sembles plus nerveux qu'avant... Tu as toujours tes pêches zaytuns, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190226,
					"content": "M—Mes pêches zaytuns, c'est pas suffisant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190227
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190227,
					"content": "Il faut que je capture le goût du bonheur. Sans ça, les pêches zaytuns ne sont que de simples pêches...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190228
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190228,
					"content": "Arachatora, Arapas et Araphala, ils ne croient pas à l'existence du goût du bonheur. Il faut que je le trouve pour faire goûter les naras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190229,
						730190230
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190229,
					"content": "Le goût du bonheur ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190231
					]
				},
				{
					"id": 730190231,
					"content": "Hihi, j'ai déjà goûté une fois au goût du bonheur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190232
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190232,
					"content": "Le goût du bonheur. C'est blanc et ça s'effrite quand on le frotte... Il se transforme en valukas blancs, mais c'est pas aussi dur et ça fait pas mal comme des valukas. On l'emballe dans une bulle toute dure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190233,
						730190234
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190233,
					"content": "... Des valukas blancs ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190235
					]
				},
				{
					"id": 730190235,
					"content": "Les valukas blancs, c'est du sable blanc, non ? Mais cette bulle toute dure, qu'est-ce que c'est...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190236,
					"content": "Roh, je ne comprends rien. Ce goût du bonheur, où est-ce qu'il se trouve ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190237,
					"content": "P—Pourquoi tu demandes ça ? Est-ce que tu veux t'emparer du goût du bonheur avant moi ? Tu me fais peur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190238,
						730190239
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190238,
					"content": "On veut juste te donner un coup de main...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190241
					]
				},
				{
					"id": 730190241,
					"content": "Me donner un coup de main ? Pourquoi ? J—Je suis capable de le trouver par moi-même...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190242
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190242,
					"content": "Cependant, il y a plein de naras qui viennent et qui repartent. En plus, il y a un d'entre eux qui porte l'odeur des valukas. Ah... J'ai peur... S'il y avait moins de naras, j'y arriverais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190243
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190243,
					"content": "*soupir* OK, je n'y arriverai pas... Je n'ose pas entrer dans Gandharva, il y a beaucoup de naras. En plus, il n'y a que des arbres morts, j'ai peur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190244
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190244,
					"content": "J'avais un ami narien qui habitait dedans. Mais c'était il y a longtemps. Maintenant, il a changé, il ne peut plus m'entendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190245
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190245,
					"content": "Ah, d'accord ! Donc le goût du bonheur dont tu parles, il se trouve à Gandharva, c'est ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190246
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190246,
					"content": "Le goût du bonheur n'est pas quelque chose qui pousse dans le sol. Il a été créé par des naras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190247
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190247,
					"content": "J'ai vraiment envie de le goûter encore. Je me souviens à quel point j'étais heureux lorsque je l'ai goûté pour la première fois. C'était tellement merveilleux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190248
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190248,
					"content": "Dans la forêt, mon ami narien et moi, on comptait ensemble le nombre de rayons de soleil qui tombaient comme des feuilles d'or à travers les feuilles des arbres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190249
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190249,
					"content": "On chantait en dégustant le goût du bonheur. Chaque fois que je voyais le soleil à travers les feuilles, je pensais à lui, je pensais au goût du bonheur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190250
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190250,
					"content": "C'est la raison pour laquelle je voudrais qu'Arapacati puisse y goûter. Pendant le Festival Utsava, les naras aussi pourront le goûter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190251
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190251,
					"content": "#Je comprends, c'est une mission pour {NICKNAME} et moi ! Hein, {NICKNAME} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190252,
						730190253
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190252,
					"content": "Moi aussi, je veux goûter au bonheur...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190254
					]
				},
				{
					"id": 730190254,
					"content": "Vraiment ? Vous n'êtes pas en train de me faire marcher ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190255
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190255,
					"content": "Non !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190256
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190256,
					"content": "Par contre, il y a beaucoup de personnes à Gandharva. À qui doit-on s'adresser pour avoir des pistes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190257
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190257,
					"content": "Je sais. Il y a peu, j'ai vu un nara qui passait par ici, il <color=#00E1FFFF>allait à Gandharva</color>. Il le portait sur lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190258
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190258,
					"content": "Il avait un truc bombé sur le dos. C'est ce que le nara utilisait pour prendre des choses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190259
