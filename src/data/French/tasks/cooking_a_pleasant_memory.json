			},
			"dialogs": [
				{
					"id": 730190601,
					"content": "C'est ça ! Je ne pensais pas que vous me l'apporteriez si vite... C'est vraiment ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190602
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190602,
					"content": "Vous n'êtes quand même pas en train d'essayer de me tromper avec un truc que vous avez fabriqué...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190603
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190603,
					"content": "Avec la description que tu nous as faite, ce serait étonnant que quelqu'un arrive à fabriquer quoi que ce soit !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190604,
					"content": "Si tu as des doutes, tu n'as qu'à goûter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190605,
					"content": "Vous n'avez pas mis de choses bizarres dedans, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190606
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190606,
					"content": "Bien sûr que non, hmph. Alors, tu goûtes, oui ou non ? Sinon, on le reprend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190607,
					"content": "N—Non... Ne le reprenez pas, l—laissez-moi goûter...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190608
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190608,
					"content": "Ne le reprenez pas, je vais goûter, je vais goûter... Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190609
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190609,
					"content": "Ah, c'est vraiment ça ! C'est vraiment le goût du bonheur, c'est vraiment ce goût-là... Héhé... Je suis si heureux de pouvoir le goûter une fois de plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190610
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190610,
					"content": "Je ne pensais pas avoir la chance d'y goûter à nouveau... Ah, mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190611,
						730190612
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190611,
					"content": "Qu'est-ce qu'il y a ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190613
					]
				},
				{
					"id": 730190613,
					"content": "Euh... Comment dire... Le goût du bonheur n'a pas changé par rapport à avant. Mais je ne sais pas pourquoi, il ne me procure pas autant de bonheur que la première fois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190614
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190614,
					"content": "Est-ce que le marchand nous aurait donné du sucre pas assez sucré ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190615,
					"content": "Non, ça n'a rien à voir avec son goût... Quand j'en mangeais avec mon ami... C'était la première fois que je goûtais ce goût du bonheur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190616
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190616,
					"content": "Je me sentais plus heureux à ce moment-là, mais pourquoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190617
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190617,
					"content": "#C'est bien normal, c'est comme quand {NICKNAME} cuisine un même plat plusieurs fois, il n'a pas le même goût...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190618,
					"content": "Et moi aussi, je ne suis pas toujours de même humeur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190619,
						730190620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190619,
					"content": "En effet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190621
					]
				},
				{
					"id": 730190621,
					"content": "N—Non, je suis convaincu qu'il y a un moyen pour que je puisse retrouver la sensation du goût du bonheur comme la première fois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190622
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190622,
					"content": "Ah, je sais ! À l'époque, j'en avais mangé avec mon ami. Du coup, le goût du bonheur, ça doit être partagé avec un ami pour que ça marche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190623
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190623,
					"content": "#C'est sûr que c'est ça. Vous êtes de {M#gentils naras}{F#gentilles naras}, et vous avez trouvé le goût du bonheur. Vous êtes mes {M#amis}{F#amies}. Je vais en préparer pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190624
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190624,
					"content": "#Oui, on est de {M#bons amis}{F#bonnes amies} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190625,
					"content": "Arasaka se met à cuisiner. Il met des pêches zaytuns et du sucre dans la marmite...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730190626
					]
				},
				{
					"id": 730190626,
					"content": "Arasaka vous donne ensuite le plat.\\nComme vous vous y attendiez, cela n'a pas d'autre saveur qu'un goût sucré excessif.\\nPeut-être que c'est ça, le goût du bonheur.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730190627
					]
				},
				{
					"id": 730190627,
					"content": "Ah ! C'est vraiment un goût qui rend heureux. C'est délicieux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190628
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190628,
					"content": "Hmm, ce plat est assez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190629,
					"content": "Il est assez « joyeux ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190630,
						730190631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190630,
					"content": "Mais un peu trop sucré.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190632
					]
				},
				{
					"id": 730190632,
					"content": "Moi aussi, je trouve que c'est un peu trop sucré...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190633
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190633,
					"content": "A—Ah oui ? Oh là là, on dirait que j'ai mis un peu trop de sucre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190634
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190634,
					"content": "Cependant... Héhé, c'est bien vrai que ce n'est qu'en le partageant avec des amis qu'on peut avoir le vrai goût du bonheur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190635
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190635,
					"content": "Même s'il est différent de celui que j'ai goûté la première fois, avec vous... je ressens un autre type de bonheur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190636,
						730190637
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190636,
					"content": "Si tu es heureux, c'est tout ce qui compte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190638
					]
				},
				{
					"id": 730190638,
					"content": "Au début, je me méfiais de vos intentions, mais vous n'en avez pas tenu compte. Et vous m'avez même aidé à trouver le goût du bonheur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190639
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190639,
					"content": "Grâce à votre aide, je peux enfin préparer ma suprême délicatesse, et terminer mon entraînement culinaire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190640
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190640,
					"content": "Ce n'est rien du tout, voyons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190641
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190641,
					"content": "M—Mais... vous avez fait tant de choses pour moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190642
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190642,
					"content": "Ah oui. Je vais vous enseigner la recette de ce plat. Comme ça, vous pourrez partager le goût du bonheur avec vos amis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190643
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190643,
					"content": "(Hmm... Si on modifie un peu la recette en ajoutant quelque chose d'autre, ça devrait faire un bon casse-croûte...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190637,
					"content": "J'ai soif...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190638
					]
				},
				{
					"id": 730190631,
					"content": "J'ai besoin d'eau.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190632
					]
				},
				{
					"id": 730190620,
					"content": "Vraiment ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190621
					]
				},
				{
					"id": 730190612,
					"content": "Il y a un problème ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190613
					]
				}
			]
		},
