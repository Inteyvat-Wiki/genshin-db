						730190235
					]
				},
				{
					"id": 730190230,
					"content": "Ce goût du bonheur dont tu parles, c'est...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190231
					]
				},
				{
					"id": 730190216,
					"content": "On sait déjà qui tu es.",
