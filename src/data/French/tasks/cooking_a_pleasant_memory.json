			"dialogs": [
				{
					"id": 730190501,
					"content": "Ma famille fait du commerce sur la voie reliant le Gouffre à Sumeru depuis toujours. On importe des pierres précieuses de Liyue et on exporte des épices.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190502
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190502,
					"content": "Une fois, pour une raison que j'ai oubliée, mon père m'a laissé à Gandharva pendant un très long moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190503
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190503,
					"content": "Je me souviens que j'étais dans la forêt et que je m'y suis fait un ami. On s'amusait bien ensemble, et ensuite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190504
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190504,
					"content": "Ensuite, je ne me souviens plus. Son nom, son visage, je n'arrive pas à m'en rappeler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190505
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190505,
					"content": "Je me souviens juste que ça semblait être un moment heureux. Puis mon père est finalement venu me chercher. J'ai pensé à rendre visite à mon ami, mais je n'en ai jamais eu l'occasion, et puis j'ai fini par oublier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190506
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190506,
					"content": "Si vous ne m'aviez pas demandé du sucre, je ne me serais jamais rappelé de tout ça. Comment ai-je pu oublier...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaanesh"
				}
			]
		},
