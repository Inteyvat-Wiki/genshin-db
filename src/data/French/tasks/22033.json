					"Tang Wen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220330601,
					"content": "Oh ? Ce plat a un goût... vraiment... vraiment subtil ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330602
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330602,
					"content": "Non, peut-être pas subtil... mais plutôt... étrange ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330603
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330603,
					"content": "Je n'arrive pas à croire que vous avez pu cuisiner un plat comme ça. Votre cuisine est vraiment... d'un autre monde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330604
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330604,
					"content": "#Merci ! {M#Voyageur}{F#Voyageuse}, s'il vous plaît, prenez ce cadeau... Je savourerai votre plat plus tard...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				}
			]
		},
