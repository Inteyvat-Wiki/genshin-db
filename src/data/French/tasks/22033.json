			"dialogs": [
				{
					"id": 220330701,
					"content": "Alors, quel dessert préparer ? Et si on le choisissait nous même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220330702,
					"content": "Voyons voir... Mes encas préférés ces derniers temps sont...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220330703,
					"content": "Les délicieuses boules de riz gluant bon marché !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220330704,
					"content": "Les magnifiques et goûteux beignets lotus !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220330705,
					"content": "Et les mous et gluants dango trois couleurs !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220330706,
					"content": "C'est tout ce que tu aimes manger, non ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330707
					]
				},
				{
					"id": 220330707,
					"content": "Héhé, n'aie pas peur. Fais confiance à mes papilles ! Choisis-en un ~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330708,
						220330710,
						220330712,
						220330714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220330708,
					"content": "Les boules de riz gluant, alors.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330709
					]
				},
				{
					"id": 220330709,
					"content": "Génial ! Faisons des boules de riz gluant pour Tang Wen !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220330710,
					"content": "Faisons des beignets lotus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330711
					]
				},
				{
					"id": 220330711,
					"content": "Oui ! Faisons des Beignets lotus pour Tang Wen !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220330712,
					"content": "C'est parti pour les dango trois couleurs.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330713
					]
				},
				{
					"id": 220330713,
					"content": "Cool ! Faisons des dango trois couleurs pour Tang Wen !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220330714,
					"content": "Je vais y réfléchir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330715
					]
				},
				{
					"id": 220330715,
					"content": "Hmm, on commencera la préparation une fois que tu auras décidé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
