			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tang Wen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220330801,
					"content": "Ah, si seulement je pouvais manger des plats liyuéens...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330802
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330802,
					"content": "Qu'est-ce qu'il y a ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330803
					]
				},
				{
					"id": 220330803,
					"content": "#Qui êtes-vous ? Cette tenue... Vous êtes {M#le voyageur}{F#la voyageuse}, non ? Désolée, j'ai juste un peu le mal du pays...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330804,
						220330805
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330804,
					"content": "Vous venez de dire que vous vouliez manger des plats liyuéens, n'est-ce pas ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330818
					]
				},
				{
					"id": 220330818,
					"content": "Hé ? Vous savez cuisiner des plats liyuéens ? Génial !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330819
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330819,
					"content": "Alors, aidez-moi à en préparer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330820
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330820,
					"content": "Laissez-moi réfléchir... Ce que j'aimerais manger...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330821
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330821,
					"content": "Je veux manger des encas liyuéens. Simples et bons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330822
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330822,
					"content": "Ces derniers temps, quand je ferme les yeux... Je vois toujours un gentilhomme, comme dans un rêve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330823
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330823,
					"content": "Il porte des bottes en croute de riz, une couronne en tofu et une cape en brioche de riz. Un éventail en biscuits de fleurs dans la main...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330824,
						220330825
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330824,
					"content": "Il attirerait les rats...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330826
					]
				},
				{
					"id": 220330826,
					"content": "Sorti d'une petite boutique d'encas de la rue, il dégage un doux parfum en passant près de moi. Je n'oublierai jamais cette odeur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330827
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330827,
					"content": "S'il vous plaît, ramenez-moi ce gentilhomme !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330825,
					"content": "Sa tenue manque encore de nouilles et de riz...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330826
					]
				},
				{
					"id": 220330805,
					"content": "Avez-vous besoin d'aide ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330806
					]
				},
				{
					"id": 220330806,
					"content": "Tout d'abord, laissez-moi me présenter. Je m'appelle Tang Wen, je suis une historienne de Liyue et je faisais des recherches de terrain sur les coutumes et le folklore d'Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330807
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330807,
					"content": "J'étais sur le point de retourner à Liyue, car j'avais presque fini ma collecte d'informations. Mais tellement de choses sont arrivées à Inazuma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330808
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330808,
					"content": "J'ai le sentiment qu'Inazuma est en train de vivre un moment historique !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330809
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330809,
					"content": "Cette période laissera une empreinte dans les annales de l'histoire de Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330810
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330810,
					"content": "Une historienne se doit d'être témoin de cette histoire de ses propres yeux, puis de la consigner de manière fidèle, complète et claire pour la postérité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330811
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330811,
					"content": "Mais... Aussi excitante que soit une telle entreprise pour moi, elle ne satisfera pas mon estomac...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330812
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330812,
					"content": "Vous avez faim ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330813
					]
				},
				{
					"id": 220330813,
					"content": "Je ne peux pas dire que c'est de la faim... Hahahaha ! La nourriture d'Inazuma est aussi tout à fait délicieuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330814
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330814,
					"content": "J'aime particulièrement les tempuras, bien qu'ils ressemblent à... des trucs recouverts de pâte frite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330815
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330815,
					"content": "Mais après avoir mangé de la nourriture d'Inazuma pendant si longtemps, celle de Liyue me manque. Cependant, je n'ai pas trouvé de restaurant qui propose des plats liyuéens authentiques.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330816
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330816,
					"content": "Je suis même allée à la Guilde des aventuriers il y a quelques jours pour y déposer une mission de cuisine, mais je n'ai pas encore eu de réponse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330817
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330817,
					"content": "Je peux essayer ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330818
					]
				}
			]
		}
	]
}