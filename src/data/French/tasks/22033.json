				"objectNames": [
					"Tang Wen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220330301,
					"content": "Ah ! C'est ça ! C'est ce goût bien de chez moi dont je rêvais tant... c'est... *sniff* ... si touchant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330302
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330302,
					"content": "Merci ! Je me sens revigorée avec cette bonne nourriture.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330303
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330303,
					"content": "Voici en guise de remerciement. Je vous souhaite un bon voyage !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				}
			]
		},
		{
			"id": 2203304,
			"completionStepIds": [
				2203304
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
