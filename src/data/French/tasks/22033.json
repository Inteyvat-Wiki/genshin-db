			"dialogs": [
				{
					"id": 220330201,
					"content": "Vous revoilà déjà ? Vous n'êtes pas un chef qui cache son identité, par hasard ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330202
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330202,
					"content": "Hmm... J'ai hâte ! Laissez-moi goûter, s'il vous plaît !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330203,
						220330204
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330203,
					"content": "Bon appétit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220330204,
					"content": "Voyons voir... de quels plats a-t-on parlé ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330205
					]
				},
				{
					"id": 220330205,
					"content": "Hmm... Des boules de riz gluant, des beignets lotus et des dango trois couleurs !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220330206,
					"content": "Décidons lequel cuisiner et donnons-le à Tang Wen !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 2203303,
			"completionStepIds": [
				2203303
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
