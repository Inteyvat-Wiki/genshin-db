			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210229601,
					"content": "On a trouvé deux autres stèles...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210229602
					]
				},
				{
					"id": 210229602,
					"content": "Vite, montrez-moi ce que vous avez trouvé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229603
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210229603,
					"content": "« ... Et sur les Plaines Guili les deux êtres sacrés combattirent, faisant pleuvoir poussière pour l'un, rochers pour l'autre... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229604
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210229604,
					"content": "Oh... On dirait bien qu'une bataille a eu lieu sur les Plaines Guili, une bataille d'envergure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229605
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210229605,
					"content": "Ce serait à cette occasion que l'Agora Guili aurait été complètement détruite. Quelqu'un semble avoir ajouté quelque chose à la suite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229606
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210229606,
					"content": "On dirait que l'auteur ne voulait pas quitter cet endroit, et y serait resté... Et il y aurait aussi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229607
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210229607,
					"content": "... Un trésor ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210220502
					]
				},
				{
					"id": 210220502,
					"content": "... Vous êtes décidément très sensibles à ce genre de chose, n'est-ce pas ? Mais en effet, si l'on s'en tient au texte, on peut le comprendre ainsi ; un trésor serait bien caché à l'Agora Guili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220503
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220503,
					"content": "Mais... L'inscription mentionne : « que les Quatre Commandements de Guizhong guident les générations à venir qui chercheront ce trésor »...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220504
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220504,
					"content": "« Enseignez avec sagesse, dirigez avec vertu, faites preuve de force d'âme, soyez uni dans l'ambition ; et que ces quatre préceptes soient réunis en un lieu nommé « Agora Guili ». »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220505
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220505,
					"content": "Hum... J'ignore vraiment comment interpréter ces lignes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220506
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220506,
					"content": "Allons à l'Auberge Wangshu ; un peu de repos ne nous ferait pas de mal. On pourra ensuite résoudre l'énigme à tête reposée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		}
	]
}