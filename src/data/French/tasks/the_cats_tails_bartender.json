			"trigger": {
				"objectNames": [
					"Nimrod"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 191010101,
					"content": "Pas mal... Ce petit vin de la taverne de La Queue de Chat n'est vraiment pas mauvais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010102
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010102,
					"content": "Quelle taverne ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191010103
					]
				},
				{
					"id": 191010103,
					"content": "#Hein ? Oh, {M#voyageur}{F#voyageuse}... Tu ne connais pas la taverne de La Queue de Chat ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010104
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010104,
					"content": "À en voir ta tête, tu n'en as sans doute jamais entendu parler ou mis les pieds. Tu ne sais vraiment pas ce que tu manques...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010105
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010105,
					"content": "La Queue de Chat propose tout un tas de boissons délicieuses, au goût comme tu n'as jamais goûté ailleurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010106
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010106,
					"content": "Et puis, elle porte bien son nom en plus. L'intérieur est rempli de plein de photos de chats tout mignons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010107
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010107,
					"content": "Être entouré de tous ces chats, avec un succulent cocktail en main... C'est tellement facile d'oublier le temps qui passe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010108,
						191010109
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010108,
					"content": "La Queue de Chat est ouverte en ce moment ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191010110
					]
				},
				{
					"id": 191010110,
					"content": "Euh... Mais tu n'as pas l'air d'être en âge de boire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010111
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010111,
					"content": "Mais bon, ce n'est pas un problème ! Diona, la barmaid de la taverne, est la plus douée de tout Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010112
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010112,
					"content": "Ce sera facile pour elle de te préparer quelque chose sans alcool.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010113
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010113,
					"content": "En plus de ça, Diona est toute mignonne, comme un petit chaton...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010114
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010114,
					"content": "*hic* ... *hic* ! Oups, j'ai trop parlé. Ne va surtout pas répéter à Diona que j'ai dit ça, hein...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010115
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010115,
					"content": "Bon, si tu veux aller à La Queue de Chat, c'est juste derrière, là-bas. Tu peux y aller directement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010116
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010116,
					"content": "Moi... Euh, je vais dégriser un peu... J'ai un peu trop bu et j'aurais du mal à enchaîner une cinquième tournée là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010109,
					"content": "Ça me donne envie d'essayer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191010110
					]
				}
			]
		}
	]
}