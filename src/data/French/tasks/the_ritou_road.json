			"dialogs": [
				{
					"id": 728090108,
					"content": "Eh bien, c'est enfin arrivé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090109
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090109,
					"content": "Ça leur a quand même pris un moment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090110
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090110,
					"content": "Argh, et cette boîte est cassée sur le côté, en plus !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090111
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090111,
					"content": "Franchement ! J'avais dit de faire attention. J'espère que rien n'est cassé à l'intérieur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090112
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090112,
					"content": "Ouf, aucune bouteille n'est cassée, on dirait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090113
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090113,
					"content": "Hein ? Pourquoi le bouchon de cette bouteille est desserré ? Maintenant il faut que je l'enlève avant de pouvoir le remettre. Franchement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090114
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090114,
					"content": "*tousse* ... Et ces ingrédients pour faire de l'alcool ont une odeur trop forte. Déplaçons-les d'abord...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090115
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090115,
					"content": "Euh... Pourquoi y a-t-il autant de Blobs ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Harrison"
				}
			]
		},
		{
			"id": 7280902,
			"completionStepIds": [
				7280907
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280907",
							"2"
						],
						"stepId": 7280907,
						"stateName": "QUEST_STATE_UNFINISHED"
