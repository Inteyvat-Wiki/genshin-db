				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Harrison"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728090204,
					"content": "#Merci beaucoup, {M#voyageur}{F#voyageuse}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090205
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090205,
					"content": "Sans vous, cet endroit aurait été ma tombe aujourd'hui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090206,
						728090208
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090206,
					"content": "C'est vous qui avez installé ce camp ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728090207
					]
				},
				{
					"id": 728090207,
					"content": "Euh... On peut dire ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090210
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090210,
					"content": "Vous savez, faire des affaires à Ritou, ce n'est pas facile. Ce camp est... Eh bien, vous pouvez le considérer comme une de mes petites astuces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090211
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090211,
					"content": "Il y a quelques jours, j'ai demandé à un... ami de Mondstadt de m'envoyer des ingrédients pour la fabrication d'alcool.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090212
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090212,
					"content": "Il a ensuite mis la main sur un lot d'échantillons de la nouvelle création du Domaine de l'Aurore, qu'il m'a envoyé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090213
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090213,
					"content": "Mais il n'a pas fait attention... Et maintenant, plusieurs boîtes sont cassées et le bouchon d'une bouteille d'ingrédients s'est desserré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090214
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090214,
					"content": "J'ai donc voulu l'enlever pour pouvoir ensuite le remettre bien en place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090215
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090215,
					"content": "Mais je ne m'attendais pas à ce qu'un tas de Blobs me tombe dessus comme ça. C'est vraiment étrange...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090216
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090216,
					"content": "Des ingrédients du Domaine de l'Aurore...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728090217
					]
				},
				{
					"id": 728090217,
					"content": "Bah, ça n'a plus d'importance. Pour ce qui est des ingrédients, je m'arrangerai avec ce type la prochaine fois qu'il viendra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090218
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090218,
					"content": "Vous m'avez sauvé. Je vous dois quelque chose en retour... Eh bien, prenez ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090219
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090219,
					"content": "Et puis vous voyez ce petit bateau là-bas ? C'est une autre de mes petites astuces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090220
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090220,
					"content": "Avec lui, on peut se faufiler jusqu'à l'Île de Narukami. Pratique, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090221
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090221,
					"content": "Pourquoi devrait-on se « faufiler »...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728090222
					]
				},
				{
					"id": 728090222,
					"content": "Bah voyons... On ne sait jamais ce qui va se passer, vous savez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090223
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090223,
					"content": "#Bon, je dois retourner faire le point sur ces marchandises. Je ne peux donc pas rester longtemps ici. Encore une fois, merci beaucoup, {M#voyageur}{F#voyageuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090224
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090224,
					"content": "On dirait que je vais devoir changer le lieu de collecte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090208,
					"content": "Qu'est-ce que vous faites ici ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728090209
					]
				},
				{
					"id": 728090209,
					"content": "Je suis... en train de déplacer des marchandises ! Hahaha, je déplace des marchandises...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090210
					],
					"speakerTitle": "Harrison"
				}
			]
		}
	]
}