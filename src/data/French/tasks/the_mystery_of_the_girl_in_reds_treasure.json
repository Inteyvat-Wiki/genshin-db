			"dialogs": [
				{
					"id": 102010301,
					"content": "C'est l'entrée d'un donjon ! Le Mage de l'Abîme a dû s'y réfugier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010302,
						102010303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010302,
					"content": "Il n'a aucun moyen de s'échapper.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010304
					]
				},
				{
					"id": 102010304,
					"content": "*halète* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010305
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010305,
					"content": "Klee, tu as besoin d'une pause ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010306,
					"content": "Pourquoi ne pas nous attendre ici pendant qu'on récupère ton trésor pour toi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010307,
					"content": "... Non, je viens avec vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010308
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010308,
					"content": "C'est mon trésor que monsieur Boule-de-poils a volé. C'est à moi de le récupérer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010309,
						102010310
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010309,
					"content": "C'est courageux de ta part !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010311
					]
				},
				{
					"id": 102010311,
					"content": "Héhé ! Ne vous en faites pas, je suis une grande fille !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010312
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010312,
					"content": "Allons-y, chevalier honoraire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010310,
					"content": "Mais ces donjons sont dangereux...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010311
					]
				},
				{
					"id": 102010303,
					"content": "Poursuivons-le.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010304
					]
				}
			]
		},
