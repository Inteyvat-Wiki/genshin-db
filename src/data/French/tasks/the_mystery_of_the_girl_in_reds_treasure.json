				],
				"points": []
			},
			"dialogs": [
				{
					"id": 102010401,
					"content": "Hmph. Vous avez réussi à me suivre. Je dois admettre que je suis impressionné.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010402
					],
					"speakerTitle": "Mage de l'Abîme"
				},
				{
					"id": 102010402,
					"content": "Mais votre chemin s'arrête ici !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010403
					],
					"speakerTitle": "Mage de l'Abîme"
				},
				{
					"id": 102010403,
					"content": "Et qu'est-ce que vous allez faire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010404,
					"content": "Hahahahaha !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010405
					],
					"speakerTitle": "Mage de l'Abîme"
				},
				{
					"id": 102010405,
					"content": "Oh, la propension des humains à trop parler nous a fourni tout ce dont nous avions besoin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010406
					],
					"speakerTitle": "Mage de l'Abîme"
				},
				{
					"id": 102010406,
					"content": "Nous savons que votre petite amie en rouge possède le trésor le plus puissant de tout Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010407
					],
					"speakerTitle": "Mage de l'Abîme"
				},
				{
					"id": 102010407,
					"content": "Ce trésor est maintenant à moi. Et vous ne pouvez rien y faire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010408
					],
					"speakerTitle": "Mage de l'Abîme"
				},
				{
					"id": 102010408,
					"content": "Maintenant, votre précieux trésor sera votre perte !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010409
					],
					"speakerTitle": "Mage de l'Abîme"
				},
				{
					"id": 102010409,
					"content": "Non, non, attendez ! Ne... Ne le touchez pas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010410
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010410,
					"content": "Haha ! Vu comme tu as peur, tu sais déjà ce qui t'attend !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010411
					],
					"speakerTitle": "Mage de l'Abîme"
				},
				{
					"id": 102010411,
					"content": "Maintenant, qu'avons-nous là ? Un symbole Pyro ? Héhéhéhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010412
					],
					"speakerTitle": "Mage de l'Abîme"
				},
				{
					"id": 102010412,
					"content": "Bang—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010501
					],
					"speakerTitle": "Mage de l'Abîme"
				},
				{
					"id": 102010501,
					"content": "NON !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010502
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010502,
					"content": "Je n'ai pas respecté les règles de survie ! « Les explosions peuvent blesser, et Jean ne fait pas de quartier »...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010503
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010503,
					"content": "Ça y est... Je suis fichue, bouhouhou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010504
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010504,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010505,
					"content": "Attends, le trésor de Klee est une bombe ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010506,
						102010507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010506,
					"content": "Trop fort...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010508
					]
				},
				{
					"id": 102010508,
					"content": "Pas étonnant qu'elle ait été nommée parmi les combattants les plus puissants de Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010509,
					"content": "Je ne voudrais jamais avoir le malheur de l'énerver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010510,
					"content": "Mais pourquoi elle s'est enfuie ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010511,
						102010512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010511,
					"content": "Elle a parlé de ses règles de survie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010513
					]
				},
				{
					"id": 102010513,
					"content": "Tu as raison !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010514,
					"content": "Retournons au <color=#00E1FFFF>QG de l'Ordre de Favonius</color> pour faire notre rapport à Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010512,
					"content": "Elle a parlé de Jean...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010513
					]
				},
				{
					"id": 102010507,
					"content": "Le Mage de l'Abîme a eu ce qu'il méritait !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010508
					]
				}
			]
		},
