					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861006,
					"content": "Je voulais aussi vous parler d'autre chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861007
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861007,
					"content": "Encore du travail à nous refiler ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4861008
					]
				},
				{
					"id": 4861008,
					"content": "Bingo ! Tu lis dans mes pensées !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861009
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861009,
					"content": "Une récompense ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4861010
					]
				},
				{
					"id": 4861010,
					"content": "Hahaha ! J'aime ta façon de penser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861011
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861011,
					"content": "#Mais avant de parler de récompense, il y a quelques services que j'aimerais que vous me rendiez {M#tous}{F#toutes} les deux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861012
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861012,
					"content": "Comme remplacer Jean ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861013
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4861013,
					"content": "Oui. Bien que toutes les demandes qu'on vous a demandé de transmettre aient déjà été confiées à d'autres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861014
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861014,
					"content": "Je crains que le travail ne soit pas impeccable, car personne n'est plus méticuleux que Jean...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861015
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861015,
					"content": "J'espère que tu pourras nous prêter main forte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861016
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861016,
					"content": "Ça me rassurerait que le chevalier honoraire de l'Ordre supervise tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861017
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861017,
					"content": "#Vous pouvez peut-être amadouer {NICKNAME}, mais ça ne marche pas avec moi ! Pourquoi vous ne supervisez pas le travail vous-même ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861018
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4861018,
					"content": "J'aimerais bien, mais je dois m'occuper d'autres choses plus urgentes. J'ai beaucoup à préparer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861019
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861019,
					"content": "Hmph. OK dans ce cas. Si je me rappelle bien, <color=#00E1FFFF>Sara, Charles et Margaret</color> ont sollicité notre aide ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861020
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4861020,
					"content": "C'est bien ça. Merci pour votre aide précieuse ! À bientôt !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				}
			]
		},
