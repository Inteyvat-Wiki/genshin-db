			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4860203,
					"content": "Je peux faire quelque chose pour vous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860204
					]
				},
				{
					"id": 4860204,
					"content": "Le restaurant ? Ça ira, merci, je viens de manger.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860205
					]
				},
				{
					"id": 4860202,
					"content": "Je vous trouve enfin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860203
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860205,
					"content": "Ce n'est pas pour ça que je viens vous voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860206
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860206,
					"content": "Je m'occupe de certaines affaires pour l'Ordre de Favonius ; j'aurais besoin que vous m'aidiez à transmettre un message à la Grande Maîtresse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860207
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860207,
					"content": "Ah, c'est Jean que vous cherchez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860209,
					"content": "Bien sûr. On est du même bord.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860210
					]
				},
				{
					"id": 4860211,
					"content": "#Disons qu'on s'est déjà {M#rencontrés}{F#rencontrées}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860212
					]
				},
				{
					"id": 4860213,
					"content": "#Je suis {M#son loyal serviteur}{F#sa loyale servante} !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860214
					]
				},
				{
					"id": 4860208,
					"content": "Ah ? Vous la connaissez personnellement ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860209
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860210,
					"content": "Ah bon ? Ça doit être rassurant de pouvoir compter sur quelqu'un comme elle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860211
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860212,
					"content": "En tout cas, j'ai entendu dire qu'elle a beaucoup de respect pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860213
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860214,
					"content": "Ah bon ? L'Ordre de Favonius donne aussi dans ces concepts d'aristocrates dépassés ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860215
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860215,
					"content": "#Euh... Ne faites pas attention à ce que dit {NICKNAME}, {M#il}{F#elle} a un sens de l'humour particulier...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860216,
					"content": "Revenons-en à nos Brutocollinus. Que voulez-vous dire à Jean ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860217,
					"content": "Oui. Dites-lui que je suis désolée de ne pas pouvoir me rendre au quartier général en personne ; le restaurant est plein à craquer ces derniers temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860218
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860218,
					"content": "La route qu'on utilise pour les livraisons vers Deauclaire a été bloquée par des Brutocollinus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860219
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860220,
					"content": "Vous souhaitez donc l'aide de l'Ordre ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860221
					]
				},
				{
					"id": 4860222,
					"content": "Vous voulez que qu'on donne une leçon à ces chasseurs ? C'est parti !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860223
					]
				},
				{
					"id": 4860219,
					"content": "Et les chasseurs de Deauclaire estiment qu'il n'est pas de leur devoir de protéger les livraisons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860220
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860221,
					"content": "C'est ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860222
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860223,
					"content": "Comment ?! Mais non, ce n'est pas le problème !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860225,
					"content": "Pas de problème.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860226
					]
				},
				{
					"id": 4860224,
					"content": "Je voudrais que <color=#00E1FFFF>vous demandiez à Jean</color> d'envoyer des chevaliers se débarrasser des Brutocollinus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860225
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860226,
					"content": "Ah, me voilà rassurée. Avec Jean aux commandes, ça ne devrait pas poser de problème.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860227
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860227,
					"content": "Tout le monde fait vraiment confiance à Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860228,
					"content": "Ah oui, j'oubliais. <color=#00E1FFFF>Charles</color>, le barman, m'a dit qu'il avait quelques soucis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860229
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860229,
					"content": "Peut-être pourriez-vous passer le voir en chemin ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860230
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860230,
					"content": "D'accord. Quand on aide, c'est jusqu'au bout ! Même si la taverne n'est pas exactement sur notre route.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 48603,
			"completionStepIds": [
				48603
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"48603",
							"2"
						],
						"stepId": 48603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Charles"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4860301,
					"content": "Les enfants, vous croyez que c'est un bar à jus de fruits ici ou quoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860302
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4860302,
					"content": "C'est comme ça qu'on accueille les gens qui viennent aider ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860303,
					"content": "#Ah, c'est vous les {M#nouveaux protégés}{F#nouvelles protégées} de la Grande Maîtresse ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860304
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4860304,
					"content": "Euh, c'est pas très poli de dire ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860305,
					"content": "Dites-lui de m'envoyer un formulaire de déclaration trimestrielle d'impôt, s'il vous plaît.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860306
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4860306,
					"content": "Je dois dire à Elzer de faire les comptes bientôt... Ah vraiment, la taxe sur l'alcool à Mondstadt est exhorbitante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860307
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4860307,
					"content": "Jean a d'autres choses à faire. Pourquoi vous adresser à elle pour ça ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860308
					]
				},
				{
					"id": 4860308,
					"content": "Le Domaine de l'Aurore roule sur l'or pourtant...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860309
					]
				},
				{
					"id": 4860309,
					"content": "C'est grâce à la gestion impeccable de maître Diluc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860310
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4860310,
					"content": "Jean s'occupe aussi des affaires de comptabilité ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860311,
					"content": "En quelque sorte. Elle vérifie personnellement tous les comptes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860312
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4860312,
					"content": "Le vin est la source principale de revenus à Mondstadt, alors Jean y fait très attention.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860313
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4860313,
					"content": "Je vois. Elle travaille dur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860314,
					"content": "J'admets qu'elle nous facilite la vie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860315
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4860315,
					"content": "À dire vrai... Tout le monde s'est habitué à s'en remettre à elle.",
