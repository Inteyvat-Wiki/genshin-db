			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ooshima Junpei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722140401,
					"content": "Oh ! Ce sont de beaux morceaux... Merci infiniment !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140402
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140402,
					"content": "Je vais cuisiner quelques plats rapides. Avec un peu de chance, je pourrai même terminer ma sculpture après manger, haha !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140403
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140403,
					"content": "Quel est le rapport ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140404
					]
				},
				{
					"id": 722140404,
					"content": "La bonne nourriture donne des forces pour travailler ! Ce n'était pas le cas avec tout ce poisson, mes mains semblaient manquer d'énergie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140405
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140405,
					"content": "Plus sérieusement, je craignais de devoir prendre plus de temps pour terminer la statue, mais plus maintenant ! Grâce à vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140406
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140406,
					"content": "Bon, je sais que j'ai été engagé par un chat, mais... il vaut mieux éviter les retards dans tous les cas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140407
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140407,
					"content": "En tout cas, je vais terminer ce travail aussi tôt que possible... D'ailleurs, madame la grande prêtresse suppléante a dit que de bonnes choses se produiront après l'achèvement de cette statue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140408
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140408,
					"content": "Je ne sais pas trop ce qu'elle veut dire par là, mais je suis curieux de le voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140409
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140409,
					"content": "Revenez plus tard pour jeter un œil au résultat final.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				}
			]
		}
	]
