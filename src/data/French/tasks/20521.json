					"Iris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205210301,
					"content": "Ce ragoût à la crème est pour vous.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210302
					]
				},
				{
					"id": 205210302,
					"content": "Ah bon, ce doit être Harris qui vous a demandé de me l'amener. Merci !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210303
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 205210303,
					"content": "À manger ce genre de plat succulent, je vais avoir du mal à retourner à mes rations séchées plus tard...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210304
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 205210304,
					"content": "Haha, je plaisante ! Je suis une aventurière, je sais endurer et surmonter toutes les difficultés que je rencontre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210305
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 205210305,
					"content": "Allez-vous continuer à grimper ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210306
					]
				},
				{
					"id": 205210306,
					"content": "Bien sûr, ce campement n'est qu'une escale. Quand j'en aurai l'occasion, j'essayerai d'en installer d'autres plus loin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210307
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 205210307,
					"content": "Je pourrai dire adieu aux bons plats bien chauds quand ce sera fait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210308
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 205210308,
					"content": "Mais je ne vais pas non plus foncer tête baissée ! Je vais d'abord observer un peu plus la situation, puis je retournerai au camp de base pour préparer un plan dans le détail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210309
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 205210309,
					"content": "Merci d'avoir fait tout ce chemin pour m'apporter ce ragoût ! Voilà pour vous remercier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iris"
				}
			]
		},
