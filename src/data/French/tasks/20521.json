			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Harris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205210101,
					"content": "Il lui faudrait vraiment un bon repas chaud...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210102
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210102,
					"content": "De qui parlez-vous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210103
					]
				},
				{
					"id": 205210103,
					"content": "Oh, je pensais à Iris ! Elle prévoit d'aller explorer les hauteurs de Dosdragon. Si seulement elle pouvait manger un bon repas chaud avant d'y aller...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210104
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210104,
					"content": "Elle veut organiser une équipe pour partir en expédition dans les hauteurs. Donc, elle a décidé de partir devant pour camper un peu plus haut, afin d'observer la situation et d'établir une route.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210105
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210105,
					"content": "Son camp n'est pas vraiment loin, et on peut toujours lui envoyer des provisions...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210106
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210106,
					"content": "Mais quand même... Camper dans la montagne comme ça... En mangeant un bon plat chaud, elle aurait plus de forces !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210107
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210107,
					"content": "Hélas, je n'ose pas m'aventurer dans ces montagnes... Voudriez-vous m'aider en apportant ce ragoût à la crème à Iris ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210108,
						205210110
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210108,
					"content": "Je m'en charge.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210109
					]
				},
				{
					"id": 205210109,
					"content": "Merci beaucoup !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210113
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210113,
					"content": "Je viens de finir le ragoût et c'est tout chaud. Dépêchez-vous de le livrer à Iris ! Avec toute cette neige, ça va refroidir vite, et ce ne sera plus bon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210114
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210114,
					"content": "Au pire des cas, si vous rencontrez des ennuis en chemin et si le ragoût n'est plus bon, vous pouvez revenir et je vous en préparerai un autre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210110,
					"content": "Où est son campement exactement ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210111
					]
				},
				{
					"id": 205210111,
					"content": "Elle a dit qu'il était situé près du flanc de la montagne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210112
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210112,
					"content": "C'est une aventurière chevronnée, toujours prudente. Elle ne s'éloignera pas plus que de raison de son campement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210113
					],
					"speakerTitle": "Harris"
				}
			]
		},
