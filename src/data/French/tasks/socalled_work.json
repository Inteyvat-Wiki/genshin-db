			"dialogs": [
				{
					"id": 221140701,
					"content": "Je suis comme le tonnelier sans talent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140702,
						221140708
					],
					"speakerTitle": "An le nerveux"
				},
				{
					"id": 221140702,
					"content": "Comment ça, « comme le tonnelier » ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140703
					]
				},
				{
					"id": 221140703,
					"content": "*soupir* Ce que je veux dire, c'est que je suis comme celui qui fabrique un tonneau et à qui il manque une planche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140704
					],
					"speakerTitle": "An le nerveux"
				},
				{
					"id": 221140704,
					"content": "La seule planche qu'il me reste n'est pas idéale ; le tonneau ne sera pas parfait si je l'utilise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140705
					],
					"speakerTitle": "An le nerveux"
				},
				{
					"id": 221140705,
					"content": "Mais d'un autre côté, si je cherche une meilleure planche, qui sait combien de temps il faudra attendre avant de pouvoir obtenir le tonneau que je veux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140706
					],
					"speakerTitle": "An le nerveux"
				},
				{
					"id": 221140706,
					"content": "Et comme le temps m'est compté, je dois faire le meilleur de deux mauvais choix.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140707
					],
					"speakerTitle": "An le nerveux"
				},
				{
					"id": 221140707,
					"content": "*soupir* Allez savoir combien d'autres tonneliers comme moi existent sur ce monde, coincés entre le marteau et l'enclume...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "An le nerveux"
				},
				{
					"id": 221140708,
					"content": "À propos du travail de Linling...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140709
					]
				},
				{
					"id": 221140709,
					"content": "Son travail ? Elle vous avait demandé de l'aide pour cette histoire de navires aux quais, non ? J'en ai entendu parler, bien sûr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140710
					],
					"speakerTitle": "An le nerveux"
				},
				{
					"id": 221140710,
					"content": "Pas la peine de prendre cet air étonné. Tant qu'on obtient des résultats, c'est tout ce qui m'importe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140711
					],
					"speakerTitle": "An le nerveux"
				},
				{
					"id": 221140711,
					"content": "Qui plus est, c'est elle qui a payé votre récompense sur ses propres moyens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140712
					],
					"speakerTitle": "An le nerveux"
				},
				{
					"id": 221140712,
					"content": "Mais elle n'a pas pensé à vérifier ses chiffres avant de les faire remonter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140713
					],
					"speakerTitle": "An le nerveux"
				},
				{
					"id": 221140713,
					"content": "Ce type d'attitude manque de maturité, et c'est ce qui me met le plus en boule.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "An le nerveux"
				}
			]
		},
