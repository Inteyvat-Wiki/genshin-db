			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"An le nerveux"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221140201,
					"content": "*soupir* Je vous jure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140202
					],
					"speakerTitle": "An le nerveux"
				},
				{
					"id": 221140202,
					"content": "Hum. À propos de Linling...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140203
					]
				},
				{
					"id": 221140203,
					"content": "Mmm ? Ah, Linling. Eh bien... Comment dire... Elle n'est pas vraiment idéale pour son poste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140204
					],
					"speakerTitle": "An le nerveux"
				},
				{
					"id": 221140204,
					"content": "Si vous voulez savoir, soit. Ses derniers relevés étaient juste... inutilisables.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140205
					],
					"speakerTitle": "An le nerveux"
				},
				{
					"id": 221140205,
					"content": "Tenez, sur cette semaine, il n'y a qu'un ou deux jours corrects, sur sept ! Même un coup d'œil rapide en apprend plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140206
					],
					"speakerTitle": "An le nerveux"
				},
				{
					"id": 221140206,
					"content": "Avec ce genre d'attitude, comment voulez-vous que je puisse lui faire confiance ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140207
					],
					"speakerTitle": "An le nerveux"
				},
				{
					"id": 221140207,
					"content": "C'est juste quelques chiffres...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140208
					]
				},
				{
					"id": 221140208,
					"content": "Quand on travaille correctement, il n'y a pas de « c'est juste ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140209
					],
					"speakerTitle": "An le nerveux"
				},
				{
					"id": 221140209,
					"content": "Il suffit d'une seule planche trop courte pour faire baisser le volume d'un tonneau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140210
					],
					"speakerTitle": "An le nerveux"
				},
				{
					"id": 221140210,
					"content": "Et d'après moi, il en va de même quand on est à la tâche. Celui qui n'est pas appliqué ne fait que ralentir le reste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140211
					],
					"speakerTitle": "An le nerveux"
				},
				{
					"id": 221140211,
					"content": "Tenez, regardez ces chiffres justement. Si le nombre de navires est mal calculé, alors il en ira de même pour le calcul des activités des quais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140212
					],
					"speakerTitle": "An le nerveux"
				},
				{
					"id": 221140212,
					"content": "Et les conséquences peuvent être coûteuses. Même si quelqu'un arrive à redresser la barre, le temps perdu reste perdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140213
					],
					"speakerTitle": "An le nerveux"
				},
				{
					"id": 221140213,
					"content": "Vous comprenez mieux maintenant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140214,
						221140219
					],
					"speakerTitle": "An le nerveux"
				},
				{
					"id": 221140214,
					"content": "Oui, je comprends...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140215
					]
				},
				{
					"id": 221140215,
					"content": "*soupir* Mais on manque trop de main-d'œuvre en ce moment... Je ne pense pas que je puisse me permettre de la renvoyer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140216
					],
					"speakerTitle": "An le nerveux"
				},
				{
					"id": 221140216,
					"content": "« Mieux vaut une planche trop courte que pas de planche du tout », comme on dit après tout. Vous me suivez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140217
					],
					"speakerTitle": "An le nerveux"
				},
				{
					"id": 221140217,
					"content": "La personne responsable de l'inspection des cargaisons n'est pas disponible en ce moment... Allez voir Linling et dites-lui d'aller donner un coup de main là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140218
					],
					"speakerTitle": "An le nerveux"
				},
				{
					"id": 221140218,
					"content": "Si tout se passe sans trop de problèmes, alors elle pourra réintégrer son poste au retour du responsable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140224
					],
					"speakerTitle": "An le nerveux"
				},
				{
					"id": 221140224,
					"content": "Disons que c'est un test, et sa seconde chance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140225
					],
					"speakerTitle": "An le nerveux"
				},
				{
					"id": 221140225,
					"content": "Tenez, donnez ce manifeste à Linling, et dites-lui de marquer chaque inspection de cargaison qu'elle aura effectuée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140226
					],
					"speakerTitle": "An le nerveux"
				},
				{
					"id": 221140226,
					"content": "Mais dites-lui aussi que j'attends plus d'elle ; si elle fait une erreur, c'est fini, plus de secondes chances.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "An le nerveux"
				},
				{
					"id": 221140219,
					"content": "Je vais lui dire...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140220
					]
				},
				{
					"id": 221140220,
					"content": "Quoi ? Qu'est-ce que vous allez dire ? Qu'elle est renvoyée ? Non, elle n'est pas encore renvoyée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140221
					],
					"speakerTitle": "An le nerveux"
				},
				{
					"id": 221140221,
					"content": "On manque trop de main-d'œuvre en ce moment sur les quais. « Mieux vaut une planche trop courte que pas de planche du tout », vous me suivez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140222
					],
					"speakerTitle": "An le nerveux"
				},
				{
					"id": 221140222,
					"content": "La personne responsable de l'inspection des cargaisons n'est pas disponible en ce moment... Allez voir Linling et dites-lui d'aller donner un coup de main là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140223
					],
					"speakerTitle": "An le nerveux"
				},
				{
					"id": 221140223,
					"content": "Si tout se passe sans trop de problèmes, alors elle pourra réintégrer son poste au retour du responsable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140224
					],
					"speakerTitle": "An le nerveux"
				}
			]
		},
		{
			"id": 2211403,
			"completionStepIds": [
				2211403
			],
