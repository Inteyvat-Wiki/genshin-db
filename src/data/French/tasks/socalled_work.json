				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Linling"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221140301,
					"content": "*sniff* Mon travail... Comment je vais faire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140302
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140302,
					"content": "An vous donne une seconde chance.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140303
					]
				},
				{
					"id": 221140303,
					"content": "Vraiment ? Mais c'est super !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140304
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140304,
					"content": "Hein ? L'inspection des cargaisons ? Hum... Mais je n'ai jamais fait ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140305
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140305,
					"content": "Je ne peux pas me permettre que les choses se passent mal... Je dois aller me préparer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140306
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140306,
					"content": "Il faut que j'aille récupérer les derniers standards d'inspection... Ah, et ne pas oublier non plus les normes précédentes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140307
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140307,
					"content": "Vous pouvez m'aider à aller compter les cargaisons ? Il vous suffit de vérifier que les quantités correspondent à ce qui est écrit ; je vérifierai plus en détail après vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140308,
						221140311
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140308,
					"content": "D'accord.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140309
					]
				},
				{
					"id": 221140309,
					"content": "Alors je compte sur vous ! Je dois rester ici pour me préparer en attendant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140310
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140310,
					"content": "Il ne faut pas qu'on se trompe cette fois-ci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140311,
					"content": "On s'en occupe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140312
					]
				},
				{
					"id": 221140312,
					"content": "Non, pas cette fois. C'est un travail autrement plus compliqué que de compter les navires, je dois m'en occuper.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140313
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140313,
					"content": "Dites-moi juste le nombre de cargaisons. Je ferai un contrôle plus poussé derrière.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				}
			]
		},
		{
			"id": 2211405,
			"completionStepIds": [
				2211405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2211405",
							"2"
						],
						"stepId": 2211405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Linling"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221140501,
					"content": "Alors, vous avez les chiffres ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140502,
						221140504
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140502,
					"content": "C'est bon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140503
					]
				},
				{
					"id": 221140503,
					"content": "Très bien ! Je suis prête de mon côté ; j'irai vérifier vos notes dans un instant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140506
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140506,
					"content": "Ah, oui : tenez ! C'est un petit geste pour vous remercier. J'irai vérifier derrière vous, je n'ai pas le droit à l'erreur cette fois-ci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140504,
					"content": "Vous n'étiez pas en train de composer un poème par hasard ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140505
					]
				},
				{
					"id": 221140505,
					"content": "Bien sûr que non ! Je sais quand il faut se montrer responsable ; l'heure n'est pas à la poésie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140506
					],
					"speakerTitle": "Linling"
				}
			]
		},
		{
			"id": 2211406,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2211402",
							"2"
						],
						"stepId": 2211402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Linling"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221140601,
					"content": "... Je ne peux plus me permettre de composer pendant le travail. Je dois être plus sérieuse que ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140602,
						221140607,
						221140612
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140602,
					"content": "Le travail reste prioritaire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140603
					]
				},
				{
					"id": 221140603,
					"content": "Je sais bien... Mais à passer son temps à refaire toujours les mêmes gestes d'année en année... Ça devient lassant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140604
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140604,
					"content": "Et puis, c'est ce genre de boulot sans grande valeur en soi ; personne n'y fait attention, on finit par ne plus faire trop attention soi-même...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140605
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140605,
					"content": "Même si An dit souvent que chaque travail est important, et que chaque pièce du rouage compte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140606
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140606,
					"content": "Si c'est vraiment le cas, alors pourquoi est-ce que tout le monde est si difficile sur ce qu'il veut bien faire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140607,
					"content": "Il faut être responsable.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140608
					]
				},
				{
					"id": 221140608,
					"content": "Je vous demande rarement de l'aide ; la majeure partie du temps, c'est moi qui suis aux commandes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140609
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140609,
					"content": "Je sais bien qu'il faut être responsable, mais plus il y a à faire, et plus on cherche les occasions de respirer un peu ; c'est pour ça que je vous ai demandé de l'aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140610
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140610,
					"content": "Que je n'aie vraiment rien à faire, et alors me voilà partie à chercher quelque chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140611
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140611,
					"content": "*soupir* Vous n'avez jamais occupé un emploi, ça ne vous parle pas tout ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140612,
					"content": "Pourquoi vous aimez tant écrire des poèmes ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140613
					]
				},
				{
					"id": 221140613,
					"content": "Comment ? Mes poèmes ? Ah, eh bien... Pour vous, pourquoi travaille-t-on ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140614
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140614,
					"content": "Moi, j'estime que « travailler pour pouvoir continuer à travailler », ça limite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140615
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140615,
					"content": "Comment dire... C'est important d'avoir un rêve, non ? Quelque chose de complètement différent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140616
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140616,
					"content": "C'est une bouffée d'air après une dure journée, qu'on tombe de fatigue et qu'il faut continuer. Au moins, on a toujours ce rêve qui reste tangible, vous voyez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140617
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140617,
					"content": "Enfin, ce n'est que ma façon de voir les choses. Tenez, je me demande ce qu'auraient à dire un aventurier sur ce sujet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140618
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140618,
					"content": "Les aventuriers ne vivent que pour leurs rêves ; personnellement, j'estime qu'un travail régulier me permet de garder les pieds sur terre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140619
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140619,
					"content": "Mais... Hahaha, croyez-moi : les rêves sont faits pour rester des rêves. Le travail, c'est quelque chose de réel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				}
			]
		},
