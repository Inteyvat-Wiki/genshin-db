			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Linling"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221140101,
					"content": "Ça y est, c'est fini pour moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140102
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140102,
					"content": "Qu'est-ce qu'il se passe ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140103
					]
				},
				{
					"id": 221140103,
					"content": "*sniff* An le nerveux vient de me dire que je ne suis peut-être pas faite pour ce type de boulot...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140104
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140104,
					"content": "Autant dire qu'il va me renvoyer, c'est tout vu ! Qu'est-ce que je vais faire... Alors que j'y mettais vraiment du mien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140105,
						221140111
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140105,
					"content": "Pourquoi...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140106
					]
				},
				{
					"id": 221140106,
					"content": "*sniff* Vous vous souvenez que vous m'aviez aidée pour les navires ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140107
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140107,
					"content": "Je n'ai pas imaginé un instant que vous pourriez vous tromper, alors je n'ai pas vérifié avant de donner les chiffres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140108
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140108,
					"content": "Résultat : il y avait plein d'erreurs. An a piqué une de ces colères...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140109
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140109,
					"content": "Est-ce que vous pourriez aller lui en toucher un mot ? Ça ne se reproduira plus, et je ne vous embêterai plus non plus !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140110
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140110,
					"content": "Je n'ose pas aller le voir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140111,
					"content": "C'est à cause de la dernière fois ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140112
					]
				},
				{
					"id": 221140112,
					"content": "Oui... Vous vous souvenez, je vous avais demandé de m'aider à compter les navires ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140113
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140113,
					"content": "Je n'ai pas imaginé un instant que vous pourriez vous tromper, alors je n'ai pas vérifié avant de donner les chiffres. Ils étaient remplis d'erreurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140114
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140114,
					"content": "Mais ce n'était pas juste une fois, je l'ai déjà fait tellement d'autres fois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140115
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140115,
					"content": "Je savais même pas ce qu'on me reprochait, et An le nerveux a, eh bien, piqué une crise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140116
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140116,
					"content": "Allez lui en toucher un mot, s'il vous plaît ! Ça ne se reproduira plus et je ne vous embêterai plus non plus !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140117
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140117,
					"content": "Je n'ose pas aller le voir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				}
			]
		},
		{
			"id": 2211402,
