			"dialogs": [
				{
					"id": 750110301,
					"content": "Je ne m'attendais pas à ce que le centre du Sanctuaire supérieur soit une île cachée. Et moi qui me demandais pourquoi c'était si différent des images que j'ai vues.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110302
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110302,
					"content": "Ma mémoire n'est pas si mauvaise, après tout. Je ne serais pas responsable de tous ces tissages anciens, sinon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110303
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110303,
					"content": "Mais à part ce rocher encore plus grand au milieu, il n'y a rien d'autre ici... Ce rocher géant pourrait-il être le cadeau légendaire du Sage de la flamme dérobée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110304,
					"content": "Hmm ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110305
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110305,
					"content": "À ce stade, je suis vraiment perplexe. Dans tous les rouleaux que j'ai vus, lorsque les héros passent l'épreuve et atteignent cet endroit, ils devraient sentir l'esprit du Sage de la flamme dérobée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110306
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110306,
					"content": "Tant que vous atteignez cet endroit en passant l'épreuve, vous êtes censé vous sentir appelé, d'une manière ou d'une autre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110307
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110307,
					"content": "Mais je n'ai aucune idée de ce que cela signifie en pratique. J'avais l'impression que je serais en mesure de résoudre ce problème une fois arrivée ici, que je pourrais... *soupir* On dirait que ce n'était qu'une douce illusion...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110308
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110308,
					"content": "Hmm... Yaa ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110309
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110309,
					"content": "#Euh... {REALNAME[ID(2)|SHOWHOST(true)]}, tu parviens à le voir ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110310
					]
				},
				{
					"id": 750110310,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110311
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110311,
					"content": "Est-ce que tu sais ce que ça signifie ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110312
					]
				},
				{
					"id": 750110312,
					"content": "Raouh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110313
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110313,
					"content": "#Tu... as vu quelque chose ? Qu'as-tu vu ? Qui aurait cru que la personne digne du cadeau n'était autre que {M#mon petit}{F#ma petite} {NICKNAME} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110314
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110314,
					"content": "Hein ? Je n'ai rien vu moi... C'est bizarre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110315,
					"content": "J'ai vu un motif doré...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110316
					]
				},
				{
					"id": 750110316,
					"content": "Yaa ! Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110317
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110317,
					"content": "#Un motif doré ? Tu veux parler de celui que nous avons vu à l'endroit où nous avons rencontré {REALNAME[ID(2)|SHOWHOST(true)]} la première fois ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110318,
					"content": "Et moi qui pensais que ce n'était qu'une hallucination !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110319,
					"content": "Yaa ! Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110320
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110320,
					"content": "#Même si tu me fais signe de lever la tête, {REALNAME[ID(2)|SHOWHOST(true)]}, ça ne sert à rien. Je ne vois rien ! Mais puisque tu le dis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110321,
						750110322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110321,
					"content": "Le ton est également très familier...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110323
					]
				},
				{
					"id": 750110323,
					"content": "Ça voudrait dire que la personne qui les a laissés est le Sage de la flamme dérobée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110324,
					"content": "Quoi ? Ça voudrait dire que vous avez déjà obtenu une révélation du Sage de la flamme dérobée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110325
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110325,
					"content": "#{M#Mon petit}{F#Ma petite}, j'ai bien vu que tu étais {M#plein}{F#pleine} d'avenir. J'ai l'œil après tout ! Alors, as-tu trouvé comment recevoir le cadeau ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110326
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110326,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110327,
						750110328
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110327,
					"content": "Oui, il suffit de...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110329
					]
				},
				{
					"id": 750110329,
					"content": "La stèle de pierre se met à résonner avec un grondement sourd.\\nAlors que la terre tremble, le rocher géant posé sur le sol révèle sa véritable forme...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 750110328,
					"content": "(Tendre la main en direction de la stèle géante...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110329
					]
				},
				{
					"id": 750110322,
					"content": "C'est la même personne qui a laissé le précédent motif doré...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110323
					]
				}
			]
		},
