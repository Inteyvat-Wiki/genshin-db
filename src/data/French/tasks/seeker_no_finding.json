					}
				]
			},
			"dialogs": [
				{
					"id": 750110101,
					"content": "Alors, c'est ça le Sanctuaire supérieur. D'en bas, on pourrait croire que tout est gris et vide ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110102,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110103
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110103,
					"content": "Je ne m'attendais pas à ce que ce soit comme ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110104,
					"content": "En effet. On dit que les terres flottantes ici sont maintenues par le pouvoir du phlogistique, une source d'énergie très vigoureuse... C'est un phénomène étrange, mais c'est la meilleure façon de le comprendre pour l'instant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110105
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110105,
					"content": "Cela explique non seulement pourquoi l'herbe et les fleurs poussent dessus, mais aussi comment cela réchauffe à nouveau la terre refroidie et déclenche une conflagration d'âmes dans l'obscurité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110106
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110106,
					"content": "C'est ça le phlogistique... C'est ce que le Sage de la flamme dérobée a volé des griffes du dragon géant pour nous l'offrir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110107
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110107,
					"content": "En parlant de tout ça, ça me fait penser à quelque chose qui me met un peu en colère. Il y en a dans la tribu qui en voyant le Sanctuaire supérieur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110108
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110108,
					"content": "... Qui disent avec audace qu'un simple humain ne serait pas capable de créer des îles flottantes en utilisant le phlogistique, tirant la conclusion que le Sage de la flamme dérobée était, lui aussi, une sorte de dragon géant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110109
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110109,
					"content": "Hmm ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110110,
						750110111
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110110,
					"content": "C'est vraiment ce qu'ils pensent ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110113
					]
				},
				{
					"id": 750110113,
					"content": "Juste parce qu'ils n'ont pas pu le faire eux-mêmes, ils insistent sur le fait que ceux qui l'ont fait devaient être surhumains. Je préfère ne pas fréquenter des gens qui ont ce genre de mentalité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110114
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110114,
					"content": "Au fait, qu'en est-il du trésor et de l'élixir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110115,
					"content": "On dirait qu'il n'y a pas grand-chose pour nous ici !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110116,
					"content": "Raouh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110117
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110117,
					"content": "Héhé, vous ne pensiez quand même pas que ce serait aussi simple ? Nous sommes mis à l'épreuve par le Sage de la flamme dérobée qu'on appelle « le fou », après tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110118
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110118,
					"content": "Si ce que disent les anciens rouleaux est correct, nous devons trouver des mécanismes à activer, terminer l'épreuve finale et atteindre le centre du Sanctuaire supérieur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110119
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110119,
					"content": "Mais je ne sais pas non plus à quoi ce centre est supposé ressembler... Je ne peux m'empêcher de trouver que les images des îles flottantes dont je me souviens sont un peu différentes de ce que nous voyons ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110120
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110120,
					"content": "Mais il est possible qu'avec l'âge, ma mémoire devienne moins fiable. J'en étais pourtant autrefois si fière. Quoi qu'il en soit... Puisque nous avons fait tout ce chemin, fions-nous plutôt à notre intuition !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110121
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110121,
					"content": "Comment activer ces mécanismes ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110122
					]
				},
				{
					"id": 750110122,
					"content": "Hmm... Tu devrais pouvoir les activer avec le phlogistique, comme avec les gravures, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110123
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110123,
					"content": "C'est du moins ce que disent les vieux rouleaux. Apparemment, les burinites phlogistiques dans tout Natlan sont basées sur ces mécanismes... Ce qui en fait d'incroyables reliques en soi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110124
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110124,
					"content": "#{M#Mon petit}{F#Ma petite}, tu as montré des résultats prometteurs jusqu'à présent. Va essayer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110111,
					"content": "Ils sont libres de penser ce qu'ils veulent...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110112
					]
				},
				{
					"id": 750110112,
					"content": "Je sais qu'il est difficile de faire changer la vision que les autres ont du monde, mais ça me met quand même hors de moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110113
					],
					"speakerTitle": "Chikya"
				}
			]
		},
