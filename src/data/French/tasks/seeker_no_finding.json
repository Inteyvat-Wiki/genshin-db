			"dialogs": [
				{
					"id": 750110501,
					"content": "Le niveau de l'eau a monté et... la source est désormais pleine de phlogistique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110503
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110503,
					"content": "L'eau sous mes genoux est tiède, et je sens une chaleur circuler dans mes membres... Quelle sensation agréable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110504
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110504,
					"content": "Alors, le cadeau du Sage de la flamme dérobée ne serait pas l'élixir qui guérit toutes les blessures, mais cette eau de source ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110505,
					"content": "Pas étonnant, étant donné que le Peuple des sources n'est pas très loin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110506,
					"content": "Yaa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110507
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110507,
					"content": "#Héhé, {REALNAME[ID(2)|SHOWHOST(true)]} a l'air très à l'aise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110508
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110508,
					"content": "Ce n'est pas une source thermale ordinaire, ma petite Paimon flottante. Lorsqu'un héros qui a été choisi se baigne dans cette source, il obtient le pouvoir de manier le phlogistique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110509
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110509,
					"content": "Ah bon ? Et si c'est moi qui m'y baigne, que se passera-t-il ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110510,
					"content": "Hmm... Laisse-moi réfléchir... Eh bien, tu serais toujours Paimon, juste un peu plus trempée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110511
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110511,
					"content": "#Hein ? Je croyais que j'allais moi aussi pouvoir utiliser le phlogistique et devenir « Paimon Pyro{NON_BREAK_SPACE}» !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110512,
					"content": "Je ne pense pas, parce que tu n'as pas été choisie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110513
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110513,
					"content": "Attends un peu, Chikya... Tu savais que cette source thermale serait le cadeau final, mais tu as prétendu que tu étais à la recherche d'un « élixir qui guérit toutes les blessures », et que tu le partagerais avec nous aussi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110514,
					"content": "Héhé, il y a tant de blessures différentes en ce monde. Comment un seul élixir pourrait être capable de toutes les guérir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110515
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110515,
					"content": "Mais en fin de compte, la sagesse est la solution à tous nos soucis. Oui, je t'ai trompée cette fois-ci, ma petite Paimon. Mais quand on fait des erreurs, on en tire des leçons et on fait un pas de plus vers la résolution de nos problèmes... N'est-ce pas là un résultat merveilleux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110516
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110516,
					"content": "Je vois, euh... J'imagine que tu n'as pas tout à fait tort...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110517,
						750110519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110517,
					"content": "Est-ce que tes blessures sont guéries ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110518
					]
				},
				{
					"id": 750110518,
					"content": "Non, pas du tout. Mon cœur me fait encore souffrir à cause de la douleur lancinante de mes diverses blessures. En ce sens, j'ai également été trompée, terriblement même, par moi-même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110520
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110520,
					"content": "Même si je prenais un bain dans une source thermale remplie de phlogistique, je serais toujours incapable de l'utiliser. Par le passé, d'après les anciens rouleaux, les membres des tribus qui ne savaient pas encore manier le phlogistique n'apprenaient à le faire qu'en réussissant l'épreuve...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110521
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110521,
					"content": "Ça n'a donc eu aucun effet !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110522
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110522,
					"content": "Attends, tu es clairement de Natlan, Chikya... Mais tu ne peux pas utiliser le phlogistique ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110523,
					"content": "Hmm ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110524
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110524,
					"content": "Ta remarque est assez blessante dans un moment comme celui-ci, ma petite Paimon ! Oui, presque tout le monde à Natlan peut utiliser le phlogistique. Mais il y a une petite minorité de personnes qui en sont incapables.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110525
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110525,
					"content": "J'ai été gravement blessée quand j'étais petite. C'est en rapport avec l'Abîme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110526
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110526,
					"content": "C'était déjà un miracle que j'aie survécu, et j'étais en très mauvaise santé. Je vous ai dit que je pouvais voyager sur de grandes distances avec un iktomisaures sur le dos, mais je vous ai menti. En réalité, ils peuvent flotter et se rendre aussi légers qu'une plume, de sorte qu'ils ne pèsent presque rien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110527
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110527,
					"content": "C'est peut-être à cause de cette blessure que je ne peux pas utiliser le phlogistique. Peu importe comment je m'y prends, je n'y parviens pas. J'ai passé des heures à étudier les tissus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110528
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110528,
					"content": "Bien que d'autres les considèrent comme pratiquement obsolètes, je connais bien l'analyse des gravures phlogistiques grâce aux motifs. J'ai fait beaucoup d'efforts pour mémoriser toutes leurs significations, ce qui m'a permis de développer une excellente mémoire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110529
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110529,
					"content": "Pour moi, enseigner aux enfants de notre tribu les rudiments du phlogistique était aussi l'occasion d'observer comment ils découvrent cette capacité à l'utiliser. D'ailleurs, les enfants m'apprécient beaucoup !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110530
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110530,
					"content": "Je connais tout ce qu'il y a à savoir sur le phlogistique. Plus je le comprends, plus je l'admire. Mais plus j'en suis admirative, plus j'ai de regrets et plus je suis frustrée de ne pas pouvoir l'utiliser moi-même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110531
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110531,
					"content": "#*soupir* À vrai dire, c'est toi, {M#mon petit}{F#ma petite} {NICKNAME}, qui t'es {M#donné}{F#donnée} du mal pour terminer les épreuves tout au long de la route. Je comprends que pour apprendre les compétences de mes ancêtres, il faut faire des sacrifices...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110532
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110532,
					"content": "Mais je n'ai tout simplement pas ce genre de courage. C'est peut-être pour cela que je ne peux pas utiliser le phlogistique, haha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110533
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110533,
					"content": "Chikya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110534
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110534,
					"content": "Raouh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110535
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110535,
					"content": "Ce n'est rien, j'ai déjà accepté la situation. Si cela ne fonctionne pas cette fois-ci, il y aura toujours une prochaine fois. Je finirai bien par trouver un moyen !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110536
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110536,
					"content": "#Merci beaucoup... Je te remercie de tout cœur, {NICKNAME}. Je sais que je ne cesse de le répéter, mais tu as un bel avenir devant toi, {M#mon petit}{F#ma petite}. Tu es non seulement incroyablement {M#talentueux}{F#talentueuse}, mais tu es aussi très {M#gentil}{F#gentille}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110537
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110537,
					"content": "#Contrairement à moi, pour qui tout semble être déjà figé maintenant... {M#Mon petit}{F#Ma petite}, je suis sûre que tu vas encore vivre des aventures formidables à l'avenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110538
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110538,
					"content": "C'est vraiment super, je dois dire que je t'envie un peu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110539
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110539,
					"content": "#{NICKNAME}, l'avenir te réserve de belles choses. Où que ta route te mène, je te souhaite que tes voyages se déroulent à jamais sans encombre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110540
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110540,
					"content": "Je te souhaite la même chose...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110541
					]
				},
				{
					"id": 750110541,
					"content": "#Je suis {M#sûr}{F#sûre} que tu atteindras tes objectifs !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110542
					]
				},
				{
					"id": 750110542,
					"content": "Il n'y a peut-être pas d'élixir qui guérit toutes les blessures, mais je suis sûre que tu trouveras un médicament capable de te guérir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110543
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110543,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110544
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110544,
					"content": "#Haha, merci ma petite Paimon, {NICKNAME}... Et toi aussi, {REALNAME[ID(2)|SHOWHOST(true)]}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110545
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110545,
					"content": "#Tes mots m'ont beaucoup touchée, {NICKNAME}. Je suis vraiment motivée ce coup-ci, parce que tu es quelqu'un de fiable, {M#mon petit}{F#ma petite}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110546
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110546,
					"content": "Très bien, laissez-moi me reposer ici un peu plus longtemps. Cette source thermale est très relaxante, en fin de compte. Je vais m'y baigner encore un peu, puis je retournerai fouiller les anciens rouleaux à la recherche d'un remède...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110547
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110547,
					"content": "*soupir* Je risque cependant de me faire disputer pour m'être enfuie de chez moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110548
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110548,
					"content": "#Mais comme tu l'as dit {NICKNAME}, je vais devoir travailler pour atteindre mes objectifs !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110519,
					"content": "As-tu appris à utiliser le phlogistique ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110520
					]
				}
			]
		}
	]
}