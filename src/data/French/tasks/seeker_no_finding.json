			"dialogs": [
				{
					"id": 750110201,
					"content": "Pfiou, ça doit être le dernier mécanisme, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110202,
					"content": "Celui-ci n'est pas différent des autres. Chikya, tu es sûre qu'on ne t'a pas roulée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110203,
					"content": "Ouh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110204
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110204,
					"content": "Bien sûr que non ! Lorsqu'il s'agit de déchiffrer des rouleaux anciens, j'ai une grande confiance... Une certaine confiance... Enfin, un certain degré de confiance en mes capacités !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110205
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110205,
					"content": "Ta confiance diminue à mesure que tu parles ! Au secours !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110206,
					"content": "Quoi qu'il en soit, je suis presque sûre que ce n'est pas le dernier mécanisme. Si je me souviens bien, il devrait être plus grand et... plus complet ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110207
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110207,
					"content": "Les îles flottantes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110208
					]
				},
				{
					"id": 750110208,
					"content": "#{M#Mon petit}{F#Ma petite}... Même si tu es très {M#prometteur}{F#prometteuse}, personne ne te comprendra si tu ne fais pas de phrases complètes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110209
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110209,
					"content": "Quant à savoir si le trésor et l'élixir sont réels... Eh bien, on ne le saura qu'après avoir essayé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110210
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110210,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110211
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110211,
					"content": "Si cela ne marche pas cette fois-ci, cela marchera la prochaine fois. Et si ce n'est pas ici, ce sera ailleurs. Tant que l'on continue, un miracle se produira tôt ou tard !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110212,
						750110214
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110212,
					"content": "Ton optimisme est vraiment sans bornes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110213
					]
				},
				{
					"id": 750110213,
					"content": "Je vais prendre ça comme un compliment !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110216
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110216,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110217
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110217,
					"content": "#Héhé, {REALNAME[ID(2)|SHOWHOST(true)]} est aussi très enthousiaste. Allez, {NICKNAME}, utilise le phlogistique pour activer le mécanisme !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110214,
					"content": "Si nous parvenons à nous motiver pour continuer d'essayer, ce sera déjà un miracle en soi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110215
					]
				},
				{
					"id": 750110215,
					"content": "Ne sois pas si pessimiste !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110216
					],
					"speakerTitle": "Chikya"
				}
			]
