			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Pedrush",
					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130150101,
					"content": "#Super, vous vous êtes aussi {M#réveillés}{F#réveillées} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150102
					],
					"speakerTitle": "Pedrush"
				},
				{
					"id": 130150102,
					"content": "Les gens se sont réveillés les uns après les autres. Nous avons des bonnes nouvelles de la ville aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150103
					],
					"speakerTitle": "Pedrush"
				},
				{
					"id": 130150103,
					"content": "Tout est revenu dans l'ordre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150104
					],
					"speakerTitle": "Pedrush"
				},
				{
					"id": 130150104,
					"content": "Oui, après beaucoup de mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150105
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150105,
					"content": "De nombreuses personnes se rassembleront aussi plus tard. Veuillez maintenir l'ordre sur place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150106
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150106,
					"content": "#Je vais aller à l'Académie avec {M#eux}{F#elles}. On reviendra un peu plus tard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahida"
				}
			]
		},
		{
			"id": 1301502,
			"completionStepIds": [
				1301502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301502",
							"2"
						],
						"stepId": 1301502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sitt",
					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130150201,
					"content": "Archon Dendro, que puis-je faire pour vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150202
					],
					"speakerTitle": "Sitt"
				},
				{
					"id": 130150202,
					"content": "J'aimerais savoir si un chercheur du Kshahrewar qui est dans le coma se trouvait sur vos listes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150203
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150203,
					"content": "Très bien, veuillez patienter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150204
					],
					"speakerTitle": "Sitt"
				},
				{
					"id": 130150204,
					"content": "Un peu plus tard...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130150205
					]
				},
				{
					"id": 130150205,
					"content": "Désolée pour l'attente, Archon Dendro. Il y a effectivement un chercheur du Kshahrewar dans le coma qui s'est retrouvé dans cet état à cause d'opérations non autorisées de l'Akasha. Il s'appelle Beynuni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150206
					],
					"speakerTitle": "Sitt"
				},
				{
					"id": 130150206,
					"content": "Il reçoit des soins au Bimarestan et n'a pas repris conscience à ce jour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150207
					],
					"speakerTitle": "Sitt"
				},
				{
					"id": 130150207,
					"content": "Hein ? Il ne s'appelait pas Moseis ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150208,
					"content": "Je pense qu'il a changé son nom pour que personne n'arrive à l'identifier. Il ne voulait pas être dérangé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150209
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150209,
					"content": "Merci de bien transmettre ces connaissances aux matras et de leur demander de les introduire dans le cerveau de Beynuni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150210
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150210,
					"content": "D'accord. Mais par souci de sécurité, j'ai besoin de connaître le motif de la demande.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150211
					],
					"speakerTitle": "Sitt"
				},
				{
					"id": 130150211,
					"content": "En résumé, ce concentré abrite sa conscience qui a été piégée dans un rêve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150212
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150212,
					"content": "Cet individu a mis en danger la sécurité de Sumeru avec ses actions. Je rapporterai les détails de la situation au général mahamatra quand il se réveillera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150213
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150213,
					"content": "Je comprends, je vais soumettre votre demande de ce pas. Merci, Archon Dendro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150214
					],
					"speakerTitle": "Sitt"
				},
				{
					"id": 130150214,
					"content": "Hmm, de rien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150215
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150215,
					"content": "Les gens devraient être tous rassemblés aux Moments oniriques. Rentrons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahida"
				}
			]
		},
		{
			"id": 1301503,
			"completionStepIds": [
				1301503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301503",
							"2"
						],
						"stepId": 1301503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130150301,
					"content": "Écoutons en silence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150302,
					"content": "Je me demande ce qu'elle va dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150303,
					"content": "Bonjour à tous, dormeurs qui venez de vous réveiller.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150304
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150304,
					"content": "Je suis vraiment désolée d'avoir interrompu vos beaux rêves et de l'avoir fait de façon un peu froide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150305
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150305,
					"content": "Les rêves ont un pouvoir fantastique. Ils nous incitent à rester résolus face à l'adversité et nous encouragent à réaliser nos ambitions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150306
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150306,
					"content": "Mais ils ont aussi le potentiel d'exploiter les gens, d'induire nos sens en erreur et de déformer la vérité. Malheureusement, vous avez été les proies d'une machination élaborée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150307
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150307,
					"content": "Comme ce que j'ai déjà dit, je suis en train d'apprendre. Je ne peux pas dire que je comprends votre immense douleur pour l'instant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150308
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150308,
					"content": "Mais regardez autour de vous. Nombreux sont celles et ceux qui partagent cette souffrance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150309
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150309,
					"content": "Soyez fiers d'être ici ensemble et de regarder vers l'avenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150310
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150310,
					"content": "Le chemin de la vie est trop long pour en voir la fin. C'est pourquoi on se pose des questions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150311
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150311,
					"content": "Quel est le sens de ma vie ? Quel est son but ? Pourquoi dois-je continuer d'éprouver de la douleur ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150312
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150312,
					"content": "Certes, il est facile de tout arrêter et d'abandonner la réflexion pour répéter ce qu'on connaît déjà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150313
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150313,
					"content": "Quand vous avez ce genre d'idée, regardez les gens et ce qui se passe autour de vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150314
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150314,
					"content": "Certains travaillent dur toute la journée pour que leur famille mange un repas chaud.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150315
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150315,
					"content": "D'autres parcourent le continent pour créer des œuvres d'art qui résonnent aux quatre coins de celui-ci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150316
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150316,
					"content": "Il y en a aussi qui cherchent à percer les secrets du monde, pour empêcher une catastrophe à venir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150317
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150317,
					"content": "La vie ne tourne pas autour de vous. Ce sont vos actions qui la façonnent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150318
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150318,
					"content": "Vos amis et vos parents se souviennent de ce que vous avez fait. Des inconnus peuvent aussi bénéficier de vos agissements.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150319
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150319,
					"content": "Ainsi, beaucoup de gens continueront d'aller de l'avant pour se frayer un chemin, peu importe la douleur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150320
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150320,
					"content": "Une fois que vous aurez commencé à marcher sur ce chemin, vous finirez par connaître les réponses à ces grandes questions existentielles, mais elles vous sembleront moins importantes qu'avant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150321
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150321,
					"content": "Cependant, si vous estimez que la vie n'est rien d'autre qu'un néant sans fond, c'est ce qu'elle deviendra pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150322
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150322,
					"content": "Vous êtes libres de choisir la manière de vivre votre vie, mais en tant que votre Archon, je dois vous ouvrir les yeux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150323
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150323,
					"content": "Abandonner la réalité au profit du rêve sera votre décision et celle de personne d'autre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahida"
				}
			]
		},
		{
			"id": 1301504,
			"completionStepIds": [
				1301504
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301504",
							"2"
						],
						"stepId": 1301504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130150401,
					"content": "Vous êtes si éloquente ! J'ai failli me laisser convaincre par ce chercheur dans le rêve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150402,
					"content": "Il est très doué pour manipuler les faiblesses de la nature humaine, mais tout ce qu'il disait le concernait aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150403
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150403,
					"content": "Ce rêve était incroyablement beau et séduisant. Impossible pour des gens ordinaires d'y voir clair, alors ils s'étaient facilement perdus dedans.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150404
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150404,
					"content": "Mais il n'est jamais trop tard pour se réveiller.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150405
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150405,
					"content": "Vous avez beaucoup appris.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150406
					]
				},
				{
					"id": 130150406,
					"content": "Hein ? Pourquoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150407
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150407,
					"content": "Vous avez de l'empathie pour les autres maintenant.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150408
					]
				},
				{
					"id": 130150408,
					"content": "Oui ! Vous dites que vous ne comprenez pas les émotions humaines, mais nous avons clairement vu toutes vos hésitations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150409,
					"content": "Vous êtes aussi partie de leur point de vue pour le discours de tout à l'heure. C'était excellent !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150410,
					"content": "Merci à vous. J'ai été touchée par les histoires tristes que nous avons entendues en chemin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150411
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150411,
					"content": "Les victimes estimaient être dans leur bon droit, alors leurs désirs leur paraissaient raisonnables...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150412
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150412,
					"content": "Ils ont donc essayé de s'opposer à nous pour protéger leurs rêves. Je peux comprendre leur choix.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150413
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150413,
					"content": "Mais ma compréhension et tous mes sentiments ne peuvent probablement pas équivaloir à ne serait-ce qu'un centième de la douleur qu'ils ont éprouvée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150414
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150414,
					"content": "Et je n'ose pas considérer cela comme de l'empathie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150415
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150415,
					"content": "Vous êtes trop exigeante envers vous-même. Bien sûr que c'est de l'empathie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150416,
						130150417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150416,
					"content": "Personne n'a une empathie absolue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150418
					]
				},
				{
					"id": 130150418,
					"content": "Héhé, d'accord. Ce n'est qu'en voyant le monde que je grandirai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150419
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150419,
					"content": "L'émotion et la connaissance sont deux choses totalement différentes. C'est difficile de les décrire clairement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150420
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150420,
					"content": "Beynuni... Enfin, Moseis a dit que je n'avais pas connu la séparation absolue, mais je suis convaincue qu'il a tort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150421
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150421,
					"content": "Quand je suis entrée dans le rêve, j'ai été enveloppée par une sorte de chaleur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150422
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150422,
					"content": "Cette sensation était si douce que j'avais l'impression d'être revenue au début de ma vie. Je ne voulais plus me réveiller.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150423
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150423,
					"content": "(A-t-elle vu quelque chose ?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150424
					]
				},
				{
					"id": 130150424,
					"content": "Mais quand j'ai ouvert mes yeux, cette sensation avait disparu, sans laisser aucune trace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150425
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150425,
					"content": "C'est comme si on gommait des mots écrits au crayon sur un papier. Ils disparaissent, mais les marques qu'ils ont laissées sont encore là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150426
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150426,
					"content": "Après avoir vécu toutes ces péripéties en rêve, je pense qu'il n'y a pas besoin de vouloir en savoir plus là-dessus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150427
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150427,
					"content": "Mais je suis sûre d'avoir été soutenue par cette douce force jusqu'à maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150428
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150428,
					"content": "Si je m'attarde trop sur sa nature exacte, je ne ferais que mettre la charrue avant les Géosaures.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150429
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150429,
					"content": "Après ce discours à mon peuple, je perdrai la face si je ne peux pas le suivre moi-même, héhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150430
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150430,
					"content": "(La Molrani Rukkhadevata a créé Nahida avec ses actions.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150431
					]
				},
				{
					"id": 130150431,
					"content": "(Bien que le monde l'ait oubliée, les pensées et la volonté de Nahida sont les preuves de son existence.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150432
					]
				},
				{
					"id": 130150432,
					"content": "(Je dois respecter leurs décisions plutôt que de vouloir dire la vérité.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150433
					]
				},
				{
					"id": 130150433,
					"content": "Qu'est-ce qu'il y a ? Tu n'as pas l'air dans ton assiette, tout à coup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150434
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150434,
					"content": "J'ai senti plusieurs fois de l'hésitation de ta part ? Y a-t-il quelque chose que tu voudrais me dire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150435,
						130150436
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150435,
					"content": "J'ai oublié.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150437
					]
				},
				{
					"id": 130150437,
					"content": "Héhé, je vois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150438
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150438,
					"content": "Que dirais-tu de faire quelques étirements ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150439
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150439,
					"content": "Une nouvelle journée est sur le point de commencer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150436,
					"content": "Ce n'est rien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150437
					]
				},
				{
					"id": 130150417,
					"content": "Ayez plus confiance en vous.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150418
					]
				}
			]
		},
