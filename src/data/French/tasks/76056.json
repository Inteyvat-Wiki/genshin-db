			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Terho"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760560101,
					"content": "#Hé, {M#l'ami}{F#l'amie} ! Ce n'est pas ennuyeux à mourir de tirer sur la cible toute la journée{NON_BREAK_SPACE}? Avec ce niveau de compétence, vous ne voulez pas plutôt échanger quelques coups ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Terho"
				}
			]
		},
		{
			"id": 7605602,
			"completionStepIds": [
				7605601
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7605601",
							"2"
						],
						"stepId": 7605601,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"7605601",
							"0"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Terho"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760560201,
					"content": "Juste quelques coups ? Je peux vous en donner plus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760560202
					]
				},
				{
					"id": 760560202,
					"content": "#Haha ! C'est le bon état d'esprit ! Rien ne vaut une bonne bagarre entre de vrais combattants, hein ? Bielov, occupe-toi un peu de notre {M#invité}{F#invitée}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560205
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560205,
					"content": "Oui, patron ! Ce sera plié en deux temps trois mouvements !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bielov"
				}
			]
		},
		{
			"id": 7605603,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7605601",
							"2"
						],
						"stepId": 7605601,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"7605601",
							"0"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Terho"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760560301,
					"content": "#{M#Désolé, je suis occupé}{F#Désolée, je suis occupée} ailleurs...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760560302
					]
				},
				{
					"id": 760560302,
					"content": "Pas de soucis. On est juste en train de tuer le temps ici de toute façon. Venez nous voir quand vous voulez... ou si vous vous ennuyez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Terho"
				}
			]
		},
		{
			"id": 7605604,
			"completionStepIds": [
				7605602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7605602",
							"2"
						],
						"stepId": 7605602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Terho"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760560401,
					"content": "D—Désolé, patron... Je vous ai déçus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560402
					],
					"speakerTitle": "Bielov"
				},
				{
					"id": 760560402,
					"content": "On ne faisait que jouer de toute façon. Ce n'est pas grave. Viens faire une pause sur le côté, Bielov.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560403
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560403,
					"content": "#Vous êtes bien balèze, {M#l'ami}{F#l'amie} ! Je m'appelle Terho, enchanté !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560404
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560404,
					"content": "#Je m'appelle {NICKNAME}, {M#enchanté}{F#enchantée}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760560405
					]
				},
				{
					"id": 760560405,
					"content": "Je vois que vous savez de l'expérience réelle en matière de combat. On va devoir se montrer à la hauteur. Le premier affrontement ne compte pas. Recommençons ! À toi, Incali !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560406
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560406,
					"content": "Hmph, vous ne vous souvenez de mon existence que quand on a des problèmes... Bref... À nous deux, l'as du combat !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Incali"
				}
			]
		},
		{
			"id": 7605605,
			"completionStepIds": [
				7605603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7605603",
							"2"
						],
						"stepId": 7605603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Terho"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760560501,
					"content": "#J'ai perdu ? Contre {M#un passant}{F#une passante} en plus ? Impossible !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560502
					],
					"speakerTitle": "Incali"
				},
				{
					"id": 760560502,
					"content": "Hmph, Incali n'a rien pu faire non plus... Je n'aurais pas dû prendre ça à la légère.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560503
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560503,
					"content": "#Ce n'est pas votre faute, patron. On ne savait pas qu'{M#il}{F#elle} serait si {M#fort}{F#forte}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560504
					],
					"speakerTitle": "Bielov"
				},
				{
					"id": 760560504,
					"content": "Patron ! On ne peut pas les laisser s'en tirer comme ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560505
					],
					"speakerTitle": "Incali"
				},
				{
					"id": 760560505,
					"content": "Oh ? Nous ne sommes donc pas seulement là pour nous battre ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760560506
					]
				},
				{
					"id": 760560506,
					"content": "Ne vous méprenez pas. Incali voulait juste dire... qu'on ne pouvait pas abandonner comme ça. Après tout, les chasseurs de trésors ont une réputation à défendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560507
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560507,
					"content": "#{NICKNAME}, je vous lance un défi officiel. Cette fois-ci, c'est du sérieux. Donnons tout ce qu'on a ! Qu'en dites-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560508
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560508,
					"content": "Dans ce cas, affrontez-moi tous les trois en même temps.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760560509
					]
				},
				{
					"id": 760560509,
					"content": "Très bien, on ne retiendra pas nos coups !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Terho"
				}
			]
		},
		{
			"id": 7605606,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
