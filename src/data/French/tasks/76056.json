					"content": "#Ah, vous revoilà ! C'est à Bielov d'abord ! Alors {M#l'ami}{F#l'amie}, {M#prêt}{F#prête} à vous mesurer à nous ?",
					"roleType": "TALK_ROLE_NPC",
