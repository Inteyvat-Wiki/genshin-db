				"objectNames": [
					"Terho"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760560601,
					"content": "#Je n'arrive pas à croire que j'ai perdu contre {M#un passant}{F#une passante}... trois fois !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560602
					],
					"speakerTitle": "Incali"
				},
				{
					"id": 760560602,
					"content": "Non, on a perdu deux fois chacun et le patron, une fois. Ça va encore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560603
					],
					"speakerTitle": "Bielov"
				},
				{
					"id": 760560603,
					"content": "#Quoi ? Une défaite reste une défaite ! Ça ne sert à rien de se prendre la tête dessus. {NICKNAME} est vraiment {M#exceptionnel}{F#exceptionnelle} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560604
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560604,
					"content": "#Vous ne pouvez même pas me battre tous les deux en temps normal. Maintenant que vous avez affronté {M#un vrai expert}{F#une vraie experte}, vous savez que vous avez encore un long chemin à faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560605
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560605,
					"content": "Et moi dans tout ça ? Peut-être que je devrais envisager une retraite anticipée. Je me demande si Vaino recrute encore pour son terrain d'entraînement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Terho"
				}
			]
		},
		{
			"id": 7605607,
