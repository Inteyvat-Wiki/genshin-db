				"points": []
			},
			"dialogs": [
				{
					"id": 726680101,
					"content": "Ah, mais d'ailleurs, les vœux de Momiji, Jiawei et Nantuck se sont tous réalisés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680102,
					"content": "Ah bon ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726680103
					]
				},
				{
					"id": 726680103,
					"content": "Regarde, Jiawei a épousé une femme riche, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680104,
					"content": "Nantuck est devenu un écrivain connu grâce à son livre sur le léviathan lunaire, même si ce qui est raconté dedans est faux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680105,
					"content": "Enfin, Momiji est désormais la meilleure pêcheuse d'Inazuma ! Elle a réussi à attraper le léviathan lunaire qui avait échappé à son père.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680106,
					"content": "Il n'y a donc aucune raison que ton vœu ne se réalise pas ! Héhéhé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680107,
					"content": "Et toi ? Qu'as-tu souhaité ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726680108
					]
				},
				{
					"id": 726680108,
					"content": "Je ne peux pas te le dire ! Il ne se réalisera pas sinon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680109,
					"content": "Le léviathan lunaire ne t'en voudra pas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726680110
					]
				},
				{
					"id": 726680110,
					"content": "Bon, d'accord. Ouvre grand tes oreilles, je ne le répéterai pas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680111,
					"content": "J'ai souhaité que ton vœu se réalise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680112,
					"content": "Tu peux parler plus fort ? Je ne t'entends pas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726680113
					]
				},
				{
					"id": 726680113,
					"content": "Ahem, j'ai dit que je ne me répéterai pas ! Tant pis si tu n'as pas écouté ! J'ai envie d'aller m'acheter des bonbons lalala ~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}