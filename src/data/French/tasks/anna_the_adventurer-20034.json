			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bennett",
					"Fischl",
					"Anna",
					"Oz"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200340201,
					"content": "Fischl, tu cours trop vite, c'est dangereux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340202
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 200340202,
					"content": "La foudre du jugement divin de la Princesse du châtiment ne laissera jamais le mal se propager...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340203
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 200340203,
					"content": "Hé, mais c'est Bennett et Fischl ! Bonjour !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340204
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340204,
					"content": "#Anna ! Et {M#le voyageur}{F#la voyageuse} ! Vous êtes ici en mission pour la Guilde des aventuriers{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340205
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 200340205,
					"content": "#Oh ! Voilà {M#celui}{F#celle} qui a reçu la grâce de la princesse. C'est sans aucun doute le destin qui vous amène en ce lieu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340206
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 200340206,
					"content": "Mademoiselle Fischl ne pensait pas vous voir ici. Elle est très heureuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340207
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 200340207,
					"content": "J'accompagne Anna pour une mission.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340208
					]
				},
				{
					"id": 200340208,
					"content": "Oui, on est ici pour escorter un ballon de transport.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340209
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340209,
					"content": "Mais on a soudainement aperçu une bande de Pilleurs de trésors se précipiter vers nous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340210
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340210,
					"content": "Excusez-moi, c'est de ma faute...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340211
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 200340211,
					"content": "Fischl et moi sommes aussi en mission. On doit traquer une bande de Pilleurs de trésors...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340212
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 200340212,
					"content": "Après beaucoup efforts, Oz est parvenu à les localiser et on s'apprêtait à aller les attraper... Jusqu'à ce que je trébuche sur une branche et que je tombe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340213
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 200340213,
					"content": "Les Pilleurs de trésors ont entendu du bruit, ont fait demi-tour et ont commencé à s'enfuir. On a donc été obligés de les prendre en chasse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340214
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 200340214,
					"content": "Soyez sans crainte. Le rayon violet de la rétribution décidera du destin de ces infâmes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340215
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 200340215,
					"content": "#Mais, mademoiselle, c'est {M#le voyageur}{F#la voyageuse} qui a attrapé ces bandits...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340216
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 200340216,
					"content": "O—Oz !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340217
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 200340217,
					"content": "Dans tous les cas, on vous doit de grands remerciements. Heureusement que vous étiez là pour les stopper !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340218
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 200340218,
					"content": "On dirait que la chance me sourit aujourd'hui !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340219
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 200340219,
					"content": "Tant mieux si l'on a pu vous aider.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340220
					]
				},
				{
					"id": 200340220,
					"content": "Héhé. Bon, on va ramener ces Pilleurs de trésors à la Guilde des aventuriers. Quant à vous, restez vigilants pendant votre mission et regardez bien où vous mettez les pieds !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bennett"
				}
			]
		},
