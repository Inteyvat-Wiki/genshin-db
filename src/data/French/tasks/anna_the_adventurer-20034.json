			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anna",
					"Anthony"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200340101,
					"content": "Bon... Il y a de nouvelles missions à accomplir aujourd'hui, c'est parti !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340102,
						200340106
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340102,
					"content": "Tu ne manques pas d'entrain.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340103
					]
				},
				{
					"id": 200340103,
					"content": "Et comment ! C'est très intéressant d'être une aventurière.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340104
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340104,
					"content": "Par contre... Il y a encore plein de choses avec lesquelles je ne suis pas familière quand je suis en mission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340105
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340105,
					"content": "#{M#Voyageur}{F#Voyageuse}, est-ce que je peux vous demander de m'accompagner encore une fois ? J'ai quelques conseils à vous demander.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340108
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340108,
					"content": "Alors, allons-y vite. La mission d'aujourd'hui est...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340109
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340109,
					"content": "Oh... Encore une mission d'escorte de ballon de transport...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340106,
					"content": "Tu veux que je vienne avec toi ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340107
					]
				},
				{
					"id": 200340107,
					"content": "Vous voulez bien ? J'ai plein de choses à vous demander.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340108
					],
					"speakerTitle": "Anna"
				}
			]
		},
		{
			"id": 2003402,
			"completionStepIds": [
				2003406
			],
