			"dialogs": [
				{
					"id": 200340301,
					"content": "Bennett est fiable, comme à son habitude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340302
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340302,
					"content": "Et Fischl... Elle a toujours l'air aussi imposante lorsqu'elle parle !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340303,
						200340308
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340303,
					"content": "À propos de Bennett...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340304
					]
				},
				{
					"id": 200340304,
					"content": "Bennett ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340305
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340305,
					"content": "Quand j'ai rejoint la Guilde des aventuriers, Bennett m'a éclairée sur de nombreuses questions et m'a beaucoup aidée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340306
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340306,
					"content": "Mais j'ai entendu dire qu'il était toujours malchanceux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340307
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340307,
					"content": "C'est vraiment injuste ! C'est quelqu'un de bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340313
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340313,
					"content": "#Pfiou... Voilà notre mission terminée. Merci à vous, {M#voyageur}{F#voyageuse}. Je retourne à la Guilde des aventuriers faire mon rapport.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340314
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340314,
					"content": "Mais pourquoi ça fait plusieurs jours qu'on m'envoie escorter des ballons de transport ? Il n'y a pas d'autres missions, à la Guilde des aventuriers ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340308,
					"content": "À propos de Fischl...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340309
					]
				},
				{
					"id": 200340309,
					"content": "Fischl ? Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340310
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340310,
					"content": "Elle... Elle aussi, elle est très fiable ! C'est une excellente archère et elle a accompli beaucoup de missions...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340311
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340311,
					"content": "Même si je ne comprends pas toujours ce qu'elle raconte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340312
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340312,
					"content": "En tout cas... elle est aussi une aventurière expérimentée ! Euh, non... Une enquêtrice expérimentée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340313
					],
					"speakerTitle": "Anna"
				}
			]
		},
		{
			"id": 2003404,
			"completionStepIds": [],
