			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kano Nana"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190570801,
					"content": "#{M#Voyageur}{F#Voyageuse}, comment allez-vous ? Mon cousin vous a causé beaucoup d'ennuis, je suppose ? Ce garçon a juste un sacré caractère, il n'a pas réellement de mauvaises intentions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570802
					],
					"speakerTitle": "Kano Nana"
				},
				{
					"id": 190570802,
					"content": "Si une quelconque négligence vous offense, n'ayez pas peur de lui donner une leçon. S'il résiste, vous pourrez dire que je vous ai donné mon accord.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kano Nana"
				}
			]
		},
		{
			"id": 1905709,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
