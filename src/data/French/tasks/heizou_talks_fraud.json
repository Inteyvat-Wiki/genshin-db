			"trigger": {
				"objectNames": [
					"Etsu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190570701,
					"content": "Excusez-moi, je devrais tenir ma langue. Ne faites pas attention à mes paroles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570702
					],
					"speakerTitle": "Etsu"
				},
				{
					"id": 190570702,
					"content": "Ah, monsieur Heizou ? Je pense qu'il déteste les gens comme moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570703
					],
					"speakerTitle": "Etsu"
				},
				{
					"id": 190570703,
					"content": "Bien qu'il soit resté poli et amical, il traite les condamnés pour fraude différemment... Il a vraiment une dent contre nous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570704
					],
					"speakerTitle": "Etsu"
				},
				{
					"id": 190570704,
					"content": "S'est-il déjà fait avoir lui aussi ? Incroyable, qui serait assez rusé pour tromper monsieur Heizou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Etsu"
				}
			]
		},
		{
			"id": 1905708,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
