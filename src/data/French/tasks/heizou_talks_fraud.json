				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iba"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190570901,
					"content": "Il ne faut pas se frotter au petit Heizou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570902
					],
					"speakerTitle": "Iba"
				},
				{
					"id": 190570902,
					"content": "Hein ? Vous voulez savoir ce qui m'est arrivé ? Il n'y a pas grand-chose à dire, ça s'est déroulé de manière assez simple.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570903
					],
					"speakerTitle": "Iba"
				},
				{
					"id": 190570903,
					"content": "Quand j'ai entendu que c'était le petit Heizou qui enquêtait, j'ai su que c'était fini. Il ne lui a pas fallu beaucoup d'efforts pour que j'avoue tout, après tout, c'est de « La tempête » dont on parle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570904
					],
					"speakerTitle": "Iba"
				},
				{
					"id": 190570904,
					"content": "« La tempête » ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190570905
					]
				},
				{
					"id": 190570905,
					"content": "C'est le surnom du petit Heizou, vous n'en avez pas entendu parler ? C'est comme ça que les détenus l'appelaient.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570906
					],
					"speakerTitle": "Iba"
				},
				{
					"id": 190570906,
					"content": "Nulle part où s'échapper, nulle part où se cacher. Pour les criminels, Heizou est comme une tempête.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570907
					],
					"speakerTitle": "Iba"
				},
				{
					"id": 190570907,
					"content": "Hein, si j'avais su, je n'aurais rien fait de tout ça en premier lieu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iba"
				}
			]
		}
	]
