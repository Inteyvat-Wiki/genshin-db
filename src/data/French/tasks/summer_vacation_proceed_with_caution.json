					"nextDialogs": [
						400110733
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110733,
					"content": "J'ai entendu Jean... Euh, la Grande Maîtresse Jean dire que tu avais toujours voulu jouer avec un harpastum, c'est vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110734
