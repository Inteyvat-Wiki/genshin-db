	"talks": [
		{
			"id": 4001101,
			"completionStepIds": [
				4001101
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4001101",
							"2"
						],
						"stepId": 4001101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Jean",
					"Barbara",
					"Klee"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400110101,
					"content": "Ahh... Il fait tellement beau. On se croirait dans un rêve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110102,
					"content": "Bonjour ! W—Waouh, c'est quoi ces tenues !?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110103,
					"content": "Héhé ! Alors, de quoi on a l'air ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110104
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110104,
					"content": "#On a mis nos tenues d'été ! Je sais qu'on n'est pas {M#venus}{F#venues} pour s'amuser... mais on ne peut quand même pas manquer une belle journée d'été au bord de la mer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110105
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110105,
					"content": "Ça... Ça n'a pas l'air bizarre au moins ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110106
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110106,
					"content": "Une tenue aussi légère et estivale, ce n'est définitivement pas fait pour moi... Ah, héhé... Pardonne-moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110107,
						400110108
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110107,
					"content": "Non, ce n'est pas vrai du tout.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110109
					]
				},
				{
					"id": 400110109,
					"content": "#Vraiment...? Merci, {M#voyageur}{F#voyageuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110110
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110110,
					"content": "C'est surprenant de penser que la Grande Maîtresse Jean emporterait une tenue d'été.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110111,
					"content": "Oh non, ce n'est pas le genre de ma grande sœur d'emporter une telle tenue elle-même. C'est Lisa et moi qui l'avons choisie pour elle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110112
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110112,
					"content": "Elle a dit « grande sœur » sans même s'en rendre compte ? Je crois que le soleil tape déjà sur la tête de Barbara !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110113,
					"content": "Il y a toute une histoire derrière ma tenue d'été...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110114
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110114,
					"content": "Je pensais que la pochette que Lisa m'avait confiée était un plan de secours d'urgence. Je ne me doutais pas qu'elle contenait une tenue d'été...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110115
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110115,
					"content": "Tous ces accessoires... C'est définitivement le travail de Lisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110116,
					"content": "Les chevaliers de l'Ordre de Favonius n'arrêtent pas d'essayer de me faire prendre des congés. J'imagine que je travaille un peu trop...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110117
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110117,
					"content": "#Venez ici, {M#tous}{F#toutes} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110118
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110118,
					"content": "C'est la voix de Klee !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110119
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110119,
					"content": "J'ai vu quelque chose de bizarre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110120
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110120,
					"content": "Hein ? Qu'est-ce qu'il se passe ? Qu'est-ce que tu veux dire par quelque chose de bizarre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110121,
					"content": "Regardez la mer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110122
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110122,
					"content": "Vous voyez ? Il y a quelque chose de bizarre qui flotte dans l'eau !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110123
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110123,
					"content": "Cet appareil élancé... On dirait une bouée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110124
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110124,
					"content": "#Mais on n'a rien vu de tel quand on est {M#arrivés}{F#arrivées} hier...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110125
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110125,
					"content": "Ça doit être le Roi Dodo qui les a mises là !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110126
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110126,
					"content": "Des appareils bizarres qui apparaissent du jour au lendemain... Il y a quelque chose qui cloche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110127,
					"content": "Eh bien, puisqu'il ne s'est pas encore montré, est-ce que ça veut dire qu'il a changé d'avis ? Ou peut-être...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110128
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110128,
					"content": "Peut-être que ces bouées sont des indices et il attend que je le trouve !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110129
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110129,
					"content": "Est-ce que ça pourrait être la raison pour laquelle ces bouées sont soudainement apparues ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110130
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110130,
					"content": "Allons voir de plus près.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110131
					]
				},
				{
					"id": 400110131,
					"content": "Tout à fait. On ne résoudra rien en restant sur la plage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110132,
					"content": "Est-ce que c'est sûr d'aller là-bas au moins ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110133
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110133,
					"content": "Peut-être, mais on doit inspecter ces bouées quoi qu'il en soit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110134
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110134,
					"content": "Il est difficile de dire ce qui nous attendra en mer. Au cas où, préparez-vous au combat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110135
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110135,
					"content": "#Quand vous serez {M#prêts}{F#prêtes}, retrouvons-nous ici, et on ira ensemble sur le bateau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110136,
						400110137
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110136,
					"content": "Ça, c'est la Grande Maîtresse Jean !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110138
					]
				},
				{
					"id": 400110138,
					"content": "Ce—Ce n'est pas ça. C'est juste que c'est mon devoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110139
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110139,
					"content": "À présent, je vous confie les préparatifs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110137,
					"content": "Même en tenue d'été, elle reste toujours aussi sérieuse.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110138
					]
				},
				{
					"id": 400110108,
					"content": "Vous êtes magnifique !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110109
					]
				}
			]
		},
		{
			"id": 4001102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4001109",
							"2"
						],
						"stepId": 4001109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jean"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400110201,
					"content": "Qu'est-ce que ces bouées peuvent bien vouloir dire...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110202,
						400110206
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110202,
					"content": "Parlez-moi de cet archipel...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110203
					]
				},
				{
					"id": 400110203,
					"content": "Ces îles sont coupées du monde extérieur, un peu comme un jardin secret créé par la nature elle-même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110204
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110204,
					"content": "#Nous sommes {M#arrivés ici guidés}{F#arrivées ici guidées} par cette lettre, et avec l'aide de Venti et de Dvalin... Tout semble s'enchaîner un peu trop facilement. Je suis un peu inquiète.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110205
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110205,
					"content": "#Mais je suis ici pour {M#tous}{F#toutes} vous protéger, alors n'aie pas peur. Quoi que ces îles nous réservent, je l'affronterai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110206,
					"content": "Parlez-moi de cette tenue d'été...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
