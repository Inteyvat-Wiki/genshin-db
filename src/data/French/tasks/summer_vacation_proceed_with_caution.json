					"nextDialogs": [
						400110737
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110737,
					"content": "La diaconesse est tellement gentille...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110738
					]
				},
				{
					"id": 400110738,
					"content": "#Alors, ne te laisse pas abattre, Klee ! Quand on aura rencontré le Roi Dodo, on pourra {M#tous}{F#toutes} t'aider à le convaincre de te laisser avec Dodoco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110739
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110739,
					"content": "D'accord !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110740
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110740,
					"content": "Redoublons d'efforts. Nous devons le trouver.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110741
					]
				},
				{
					"id": 400110741,
					"content": "Ouais !",
