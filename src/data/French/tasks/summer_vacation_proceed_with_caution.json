					"content": "Oui ! Je pensais justement au Ludi Harpastum !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110735
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110735,
					"content": "J'ai fait cet harpastum spécialement pour toi. Maintenant ça peut être le Ludi Harpastum tous les jours, héhé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
