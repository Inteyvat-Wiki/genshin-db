					"nextDialogs": [
						400110615
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110615,
					"content": "Oh, tu connais ce genre de machine ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110616
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110616,
					"content": "Non, je ne peux faire que des suppositions. Cette machine n'a pas l'air de venir de cette île... Regardez son accoutrement. On dirait qu'elle vient d'Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110617
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110617,
					"content": "Inazuma ? Mais c'est pas censé être très loin ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110618,
					"content": "Alors cette machine ne vient pas d'ici ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110619
					]
				},
				{
					"id": 400110619,
					"content": "On dirait bien. Cette zone maritime est indépendante et ne borde aucun pays. Donc il n'est certainement pas d'ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110620
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110620,
					"content": "Mais étant donné la situation à Inazuma, comment une telle chose a-t-elle pu arriver ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110621
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110621,
					"content": "Une machine abandonnée... C'est bizarre ! Quelqu'un l'a apportée ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110622,
					"content": "Oh non ! Le Roi Dodo ne bouge plus !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110623
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110623,
					"content": "Klee, peut-être que le Roi Dodo est fatigué.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110624
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110624,
					"content": "Voilà, c'est ça. Le Roi Dodo s'est probablement endormi. Il t'attendait tellement patiemment et puis *bâille* c'était l'heure de dormir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110625,
					"content": "Allons jouer avec Klee quelque part et revenons une fois que le Roi Dodo se sera réveillé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110626
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110626,
					"content": "Vraiment ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110627
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110627,
					"content": "Bien sûr !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110628
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110628,
					"content": "Hmm... Non, je comprends maintenant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110629
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110629,
					"content": "Ce n'est pas le Roi Dodo. Le vrai Roi Dodo est ailleurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110630
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110630,
					"content": "Hein ? Vraiment ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110631
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110631,
					"content": "Je n'abandonnerai pas. Roi Dodo, attendez-moi ! On va vous trouver !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110632
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110632,
					"content": "Et la voilà repartie... Elle ne lâche pas facilement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110633
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110633,
					"content": "Klee, attends-nous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Barbara"
				}
			]
		},
		{
