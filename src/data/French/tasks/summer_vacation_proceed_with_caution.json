			},
			"dialogs": [
				{
					"id": 400110701,
					"content": "Chevalier honoraire, regardez ici !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110702
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110702,
					"content": "Hein ? C'est quoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110703,
					"content": "Regardez ces pierres empilées et ces petites fleurs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110704
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110704,
					"content": "On dirait un mémorial pour quelqu'un.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110705,
						400110706
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110705,
					"content": "Vous êtes très observatrice.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110707
					]
				},
				{
					"id": 400110707,
					"content": "Hé, vous me gênez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110708
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110708,
					"content": "Mais la seule autre chose dans les parages, c'est cette machine en habits d'Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110709,
					"content": "Est-ce que le mémorial pourrait être pour la machine ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110710
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110710,
					"content": "Peut-être qu'elle a accompli une action qui mérite qu'on la commémore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110711
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110711,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110712
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110712,
					"content": "Tout porte à croire qu'il y a déjà eu une présence humaine dans ces eaux. Et pourtant, nous n'avons pas assez d'indications pour en déduire de quelle civilisation il s'agissait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110713
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110713,
					"content": "Et jusqu'à présent, nous n'avons toujours vu personne ni aucune pierre tombale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110714
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110714,
					"content": "Grande Maîtresse Jean, puis-je aller voir là-bas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110715
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110715,
					"content": "Oui, mais fais attention !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110716
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110716,
					"content": "D'accord !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110717
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110717,
					"content": "Combien d'autres secrets cachent encore ces îles ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110718
					]
				},
				{
					"id": 400110718,
					"content": "#Klee est trop jeune pour avoir le sens du danger. {M#Voyageur}{F#Voyageuse}, le reste d'entre nous doit rester vigilant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110719
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110719,
					"content": "Pour être honnête, j'ai d'abord pensé que cette lettre n'était qu'une farce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110720
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110720,
					"content": "C'est ce qu'on pensait aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110721
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110721,
					"content": "J'avais des doutes aussi, mais qui ferait une telle farce à une enfant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110722
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110722,
					"content": "Une lettre qui nous amène à activer des mécanismes sur un archipel désert... C'est bizarre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110723
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110723,
					"content": "Je me demande s'il ne s'agit pas d'une sorte de piège, qui se referme lentement sur nous. Nous devons rester sur nos gardes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110724
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110724,
					"content": "Mademoiselle Barbara !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110725
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110725,
					"content": "Klee, qu'est-ce qui ne va pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110726
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110726,
					"content": "Est-ce que vous pensez que le Roi Dodo ne veut pas me voir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110727
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110727,
					"content": "Pourquoi le Roi Dodo ne voudrait pas te voir, Klee ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110728
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110728,
					"content": "Dodoco m'aime, et... et j'aime Dodoco, donc le Roi Dodo ne pourra jamais nous séparer. C'est pour ça que le Roi Dodo ne veut pas nous voir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110729
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110729,
					"content": "*pleure* Je ne veux pas qu'il nous sépare.",
