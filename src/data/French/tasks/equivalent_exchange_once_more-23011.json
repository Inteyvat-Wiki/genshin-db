			"dialogs": [
				{
					"id": 230110601,
					"content": "Alors ? Où est le bois que j'ai acheté ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110602
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 230110602,
					"content": "Vous racontez ce qui s'est passé à Victor...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230110603
					]
				},
				{
					"id": 230110603,
					"content": "Encore des monstres ? C'est moi ou les convois du monde entier se font toujours attaquer par des monstres...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110604
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 230110604,
					"content": "Enfin, peu importe. Du moment que j'ai mon bois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110605
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 230110605,
					"content": "Tiens, ta récompense. Tu peux vérifier la somme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110606
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 230110606,
					"content": "Euh... Lili, comment va-t-elle ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110607
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 230110607,
					"content": "Je n'ai pas pu lui dire au revoir en personne quand je suis parti. Elle était en colère, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110608,
						230110610
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 230110608,
					"content": "Elle va très bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110609
					]
				},
				{
					"id": 230110609,
					"content": "Tant mieux, hum... Ne me regarde pas comme ça, je me soucie juste d'elle !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110614
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 230110614,
					"content": "#Bon, n'en parlons plus... Voilà ta récompense, {M#voyageur}{F#voyageuse} et pas un mora de moins.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victor"
				},
				{
					"id": 230110610,
					"content": "Retourne donc lui rendre visite.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110611
					]
				},
				{
					"id": 230110611,
					"content": "Monsieur Vsevolod me mettrait une raclée, laisse tomber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110612
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 230110612,
					"content": "Je n'ose pas trop non plus lui envoyer de lettre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110613
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 230110613,
					"content": "Recevoir une lettre d'un Fatui... Ça n'augure rien de bon, hahaha...",
