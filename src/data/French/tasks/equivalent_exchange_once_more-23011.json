					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110302
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110302,
					"content": "À propos du bois de Victor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110303
					]
				},
				{
					"id": 230110303,
					"content": "Le bois que ce Fatui a commandé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110304
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110304,
					"content": "*soupir* Ne m'en parlez pas, faire du commerce avec les Fatui n'apporte vraiment rien de bon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110305
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110305,
					"content": "Mon convoi a été attaqué par des monstres sur le chemin. Les hommes ont pu se sauver et rentrer, mais la charrette a été détruite et le bois est resté sur place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110306
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110306,
					"content": "Je n'ose pas y retourner et je n'ai trouvé personne pour me débarrasser de ces montres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110308
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110308,
					"content": "Je ne fais pas partie des Fatui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110309
					]
				},
				{
					"id": 230110309,
					"content": "#Vous n'êtes pas {M#un}{F#une} Fatui ? Dans ce cas, pourquoi travaillez-vous pour lui ? Étrange...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110310
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110310,
					"content": "Quoi qu'il en soit, je vais laisser ma charrette là-bas pour l'instant et voir si j'arrive à engager quelqu'un pour s'en charger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110311
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110311,
					"content": "Si vous voulez aller chercher le bois immédiatement, je vais vous indiquer l'emplacement approximatif sur la carte. Vous pourrez faire vos recherches là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110312
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110312,
					"content": "Rah, côtoyer ces Fatui ne m'apporte que des malheurs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hamawi"
				}
			]
