					"nextDialogs": [
						230110503
					]
				},
				{
					"id": 230110503,
					"content": "#Ce bois, c'est... Vous avez déjà chassé les monstres ? Je ne vous voyais pas comme {M#un habile combattant}{F#une habile combattante}...",
					"roleType": "TALK_ROLE_NPC",
