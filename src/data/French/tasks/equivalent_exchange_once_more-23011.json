			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Victor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230110101,
					"content": "Hmm... Comment sculpter cette partie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110102,
						230110103
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 230110102,
					"content": "Salut !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110104
					]
				},
				{
					"id": 230110104,
					"content": "Bon sang, qui est-ce ? Laissez-moi tranquille, je...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110105
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 230110105,
					"content": "#Ah ?! {M#Voyageur}{F#Voyageuse} ?! Qu'est-ce que tu fais à Sumeru ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110106
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 230110106,
					"content": "C'est Rudolf qui t'envoie me casser la figure ? Je n'ai rien fait de mal à part offrir un petit cadeau à Lili il y a très longtemps !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110107,
						230110109
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 230110107,
					"content": "Je suis juste ici en voyage...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110108
					]
				},
				{
					"id": 230110108,
					"content": "#Toujours en voyage, hein... Tu es vraiment {M#plein}{F#pleine} d'énergie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110112
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 230110112,
					"content": "Mais je ne m'attendais vraiment pas à te rencontrer à Sumeru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110113
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 230110113,
					"content": "Quand j'ai été transféré de Mondstadt, j'ai d'abord reçu l'ordre de retourner directement à Snezhnaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110114
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 230110114,
					"content": "Mais sur le chemin du retour, j'ai reçu un autre ordre : aller à la Ville de Sumeru pour assister monsieur Vsevolod. Cet ordre m'a également placé sous la direction de Son Excellence Pulcinella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110115,
						230110116
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 230110115,
					"content": "Pulcinella ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110117
					]
				},
				{
					"id": 230110117,
					"content": "Oui... Euh, je ferais mieux de m'arrêter là. Sinon, monsieur Vsevolod va me reprocher de ne pas faire attention à la confidentialité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110118
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 230110118,
					"content": "*soupir* Les noms des Exécuteurs ne sont pas non plus secrets, je ne sais pas pourquoi il est si nerveux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110119
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 230110119,
					"content": "Qu'est-ce que tu fais à Sumeru ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110120
					]
				},
				{
					"id": 230110120,
					"content": "Oh, monsieur Vsevolod et moi sommes responsables de la coordination du soutien logistique. En résumé, nous faisons des achats un peu partout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110121
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 230110121,
					"content": "Ça n'a peut-être pas l'air très important, mais c'est tout de même mieux que de rester sans rien faire dans la cathédrale de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110122
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 230110122,
					"content": "Héhé ! En plus, j'ai pas mal de temps libre avec ce travail et personne n'est sur mon dos en permanence...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110123
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 230110123,
					"content": "Je me suis donc remis à faire des sculptures en bois. Il y a plein de bois à Sumeru, et c'est parfait pour m'exercer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110124
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 230110124,
					"content": "Je n'aurais jamais cru que mes sculptures auraient eu autant de succès auprès des enfants. Ils n'arrêtaient pas de m'embêter, alors je leur ai promis de leur offrir une à tous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110125,
						230110128
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 230110125,
					"content": "Tu es un Fatui pourtant, non ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110126
					]
				},
				{
					"id": 230110126,
					"content": "Oui et alors ? *soupir* ... Qui a dit qu'un Fatui ne pouvait pas offrir de jouets aux enfants ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110127
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 230110127,
					"content": "Et puis je ne suis qu'un petit gestionnaire de logistique. Les grosses affaires, je les laisse volontiers à mes supérieurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110130
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 230110130,
					"content": "Bref, c'est ma situation du moment. Je n'ai pas pu rentrer à Snezhnaya, mais j'adore Sumeru. Ici, il y a de quoi manger et s'amuser... De plus, l'environnement est impeccable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110131
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 230110131,
					"content": "Après le travail, j'achète de quoi manger, puis je cherche un lieu ensoleillé pour sculpter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110132
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 230110132,
					"content": "Par contre... Haha, tout le monde me regarde d'un air méfiant, comme la première fois que tu m'as parlé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110133
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 230110133,
					"content": "Je n'y peux rien de toute façon, je suis un Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110134,
						230110135
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 230110134,
					"content": "Je ne te fais toujours pas confiance.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110136
					]
				},
				{
					"id": 230110136,
					"content": "Bon, d'accord... En tout cas, je suis content de ma vie actuelle et j'ai même réussi à mettre quelques économies de côté.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110137
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 230110137,
					"content": "D'ici à quelques années, je m'installerai peut-être définitivement à Sumeru. Qui sait ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110138
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 230110138,
					"content": "#Hum, laisse tomber. Puisque tu es à Sumeru, on peut poursuivre notre «{NON_BREAK_SPACE}échange de bons procédés » ? Qu'en dis-tu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110139
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 230110139,
					"content": "Mais cette fois-ci, je n'ai plus d'histoire à raconter. Je te payerai en moras sonnants et trébuchants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110140,
						230110141
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 230110140,
					"content": "Je préfère.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110143
					]
				},
				{
					"id": 230110143,
					"content": "Bon, je t'explique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110144
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 230110144,
					"content": "Il y a quelques jours, j'ai commandé un lot de bois à Hamawi. Mais jusqu'à présent, il ne me l'a toujours pas livré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110145
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 230110145,
					"content": "Je ne peux pas aller le voir durant mon temps de travail, sinon, monsieur Vsevolod va me passer un savon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110146
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 230110146,
					"content": "#{M#Voyageur}{F#Voyageuse}, va voir Hamawi pour moi et demande-lui quand il pourra me livrer mon bois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110147,
						230110149
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 230110147,
					"content": "Prépare ma récompense.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110148
					]
				},
				{
					"id": 230110148,
					"content": "Ne t'inquiète pas, c'est comme si c'était fait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110151
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 230110151,
					"content": "#Bref, je compte sur toi, {M#voyageur}{F#voyageuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victor"
				},
				{
					"id": 230110149,
					"content": "#Tu ne manigances rien de louche, hein{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110150
					]
				},
				{
					"id": 230110150,
					"content": "Ça s'est toujours bien passé lors de nos échanges, non ? Ne t'inquiète pas, je suis trop paresseux pour ces magouilles, je préfère vivre une vie tranquille...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110151
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 230110141,
					"content": "C'est une mission des Fatui ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110142
					]
				},
				{
					"id": 230110142,
					"content": "Bien sûr que non, c'est juste une mission pour mon compte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110143
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 230110135,
					"content": "N'essaye pas de te lier d'amitié avec moi, je ne te fais pas confiance !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110136
					]
				},
				{
					"id": 230110128,
					"content": "Tu ne serais pas en train de soutirer des renseignements aux enfants ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110129
					]
				},
				{
					"id": 230110129,
					"content": "Jamais de la vie ! Bonjour le gros cliché sur les Fatui !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110130
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 230110116,
					"content": "Un autre Exécuteur ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110117
					]
				},
				{
					"id": 230110109,
					"content": "Eh oui. Allez, rentre à Mondstadt avec moi !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110110
					]
				},
				{
					"id": 230110110,
					"content": "Hahaha. Tu vas me menotter pour m'y emmener ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110111
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 230110111,
					"content": "Bien, trêve de plaisanteries. Je suis occupé avec mon travail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110112
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 230110103,
					"content": "V—Victor ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110104
					]
				}
			]
		},
