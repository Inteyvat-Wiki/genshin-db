			},
			"dialogs": [
				{
					"id": 711630301,
					"content": "#Qu'est-ce qui se passe ? Comment on est {M#arrivés}{F#arrivées} là ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630302,
					"content": "Alors ? La petite breloque que je vous ai fabriquée vous plaît ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630303
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630303,
					"content": "C'est là que vous étiez, Zibai ! Qu'est-ce que c'est que cette ombrelle ? Elle a soudainement fait « wouf », avant de nous transporter ici !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630304,
					"content": "#On dirait que je ne suis pas la seule à avoir du mal à me souvenir des choses. Avez-vous déjà oublié que nous sommes {M#montés}{F#montées} dessus ensemble ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630305
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630305,
					"content": "Ça vous rappelle quelque chose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630306
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630306,
					"content": "Oh ! C'est... le chariot lunaire ! Pas étonnant que ça me disait quelque chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630307,
					"content": "Haha, ce n'est qu'une réplique créée à partir de mes souvenirs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630308
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630308,
					"content": "Et tout ça, grâce au jade brisé que vous m'avez rendu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630309
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630309,
					"content": "Oh ! C'était ça, la petite breloque que vous vouliez fabriquer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630310,
					"content": "Exactement. Ce chariot en jade peut vous transporter rapidement où vous le souhaitez et faciliter votre voyage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630311
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630311,
					"content": "#Prenez-le, mes {M#chers}{F#chères} guides.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630312
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630312,
					"content": "Ouah, mais c'est génial... Je croyais que vous disiez ça par politesse !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630313,
					"content": "Je pensais que ça me prendrait du temps, étant donné l'état de détérioration avancé du jade. Son énergie spirituelle avait complètement disparu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630314
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630314,
					"content": "Mais heureusement que nous sommes au Vallon Chenyu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630315
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630315,
					"content": "Qu'est-ce qu'il y a de si spécial ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630316,
					"content": "Savez-vous exactement où nous nous trouvons dans le Vallon Chenyu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630317
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630317,
					"content": "Hum... Au Port Yilong ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630318,
					"content": "Haha, tu as beaucoup à apprendre sur cet endroit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630319
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630319,
					"content": "Sous nos pieds se trouve l'un des points d'intersection des lignes énergétiques de Liyue. Il en existe huit de ce type au total...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630320
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630320,
					"content": "La vie, la mort, le repos, l'occultation, l'initiation, le terrain, l'effroi et la blessure.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630321
					]
				},
				{
					"id": 711630321,
					"content": "Tu connais mieux cet endroit que je ne le pensais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630322
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630322,
					"content": "Oh ! Je m'en souviens maintenant. Ce sont les huit portes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630323,
					"content": "Exactement. Nous sommes actuellement au centre de la plus auspicieuse de ces portes : la porte de la vie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630324
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630324,
					"content": "La porte de la vie symbolise la croissance, la prospérité et la revitalisation. C'est pour cette raison que j'ai pu reconstituer aussi rapidement l'énergie spirituelle du jade et fabriquer ce chariot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630325
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630325,
					"content": "Ouah, c'est vraiment pratique ! Le Vallon Chenyu est un lieu plein de merveilles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630326,
					"content": "Oui... Vous devriez vivre ici, dans la paix et la prospérité...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630327
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630327,
					"content": "« Vous » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630328,
					"content": "Non, rien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630329
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630329,
					"content": "Bon, j'ai fait tout ce que je souhaitais faire. Vous pouvez retourner à vos occupations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630330
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630330,
					"content": "J'ai prévu de faire une promenade au sommet de la montagne. Nos chemins se séparent ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630331
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630331,
					"content": "Merci, Zibai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630332
					]
				},
				{
					"id": 711630332,
					"content": "Je t'en prie. Tu m'as réveillée de mon sommeil, c'est moi qui te suis redevable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630333
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630333,
					"content": "C'est l'œuvre de Zhongli, et personne d'autre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630334
					]
				},
				{
					"id": 711630334,
					"content": "Et je lui ai dit la même chose qu'à toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630335
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630335,
					"content": "#Il a dit que tu étais {M#parti}{F#partie} pour un long voyage...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630336
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630336,
					"content": "Ta prochaine destination serait-elle cette lointaine contrée enneigée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630337
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630337,
					"content": "Oui, nous nous dirigeons vers Snezhnaya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630338
					]
				},
				{
					"id": 711630338,
					"content": "Snezhnaya... Hmm, je ne connais pas cet endroit, mais aucun voyage ne se passe sans encombre quand il y a de la neige et de la glace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630339
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630339,
					"content": "#Si tu as besoin d'aide {NICKNAME}, tu sais où me trouver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630340
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630340,
					"content": "Bien sûr.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630341
					]
				},
				{
					"id": 711630341,
					"content": "Prends soin de toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zibai"
				}
			]
		}
	]
}