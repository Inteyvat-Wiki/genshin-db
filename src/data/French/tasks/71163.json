				]
			},
			"dialogs": [
				{
					"id": 711630201,
					"content": "#On dirait que Zibai n'est pas là... C'est elle qui nous a {M#invités}{F#invitées} à venir, pourtant ! Où peut-elle bien être{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630202,
					"content": "Huh ! Cette ombrelle me semble familière... On l'a déjà vue quelque part ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630203,
					"content": "Peut-être que c'est celle de Zibai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630204
					]
				},
				{
					"id": 711630204,
					"content": "Je crois que tu as raison... Mais pourquoi aurait-elle laissé son ombrelle près de la porte ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630205,
					"content": "Elle a une mauvaise mémoire...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630206
					]
				},
				{
					"id": 711630206,
					"content": "Qu'est-ce qu'on va faire ? Vu comment les choses évoluent, j'ai peur qu'elle oublie comment tenir ses baguettes au beau milieu d'un repas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630207,
					"content": "*soupir* On devrait aller la chercher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630208,
					"content": "Attends... Je ne crois pas que c'est vraiment une ombrelle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630209
					]
				},
				{
					"id": 711630209,
					"content": "Ah ? Du coup, qu'est-ce que c'est ? Hmm... Laisse-moi regarder de plus près...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630210,
					"content": "Ouah !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
