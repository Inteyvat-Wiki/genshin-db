			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Antei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722370301,
					"content": "Vous êtes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370302
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370302,
					"content": "Antei ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722370303,
					"content": "Oui, c'est moi. Je me sens... un peu bizarre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370304
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370304,
					"content": "Je me souviens avoir pourchassé ces scélérats, puis j'ai arraché un noyau et je l'ai jeté dans un camp. Mes blessures étaient plutôt graves, alors j'étais sur le point de perdre conscience...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370305
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370305,
					"content": "Je me suis réveillé et en vous voyant, je ne me sens plus aussi mal. Dites-moi, vais-je bientôt mourir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370306
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370306,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722370307
					]
				},
				{
					"id": 722370307,
					"content": "... Tout compte fait, ne me dites rien. Vous êtes ici pour m'arrêter à nouveau ? J'ai déjà prouvé mon innocence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370308
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370308,
					"content": "C'étaient ces gens de Khaenri'ah qui ont volé le livre de la bibliothèque. Certes, je leur servais de garde du corps, mais je n'étais pas de mèche avec eux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370309
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370309,
					"content": "J'ai donc suivi leur délégation diplomatique jusqu'ici et je les ai tous vaincus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370310
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370310,
					"content": "Mais j'ai passé énormément de temps à combattre une machine géante qu'ils avaient avec eux. À la fin, j'ai réussi à lui arracher son noyau, non pas sans me blesser gravement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370311
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370311,
					"content": "Cette machine s'est ensuite effondrée sur le livre. Je ne peux pas le récupérer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370312
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370312,
					"content": "Eh beh, les jibashiri de Byakuyakoku sont incroyablement forts...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722370313,
					"content": "#Vous n'êtes pas des {M#aspirants}{F#aspirantes} au poste de jibashiri ? *soupir* Tant pis. Vous savez, les jibashiri étaient les héros qui ont battu les Élémentosaures abyssaux. Ce n'est qu'ensuite qu'ils sont devenus des forces de l'ordre, les juges des enfers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370314
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370314,
					"content": "Le noyau de la machine se trouve au camp. Vous pouvez aller voir si vous ne me croyez pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Antei"
				}
			]
		},
		{
			"id": 7223704,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
