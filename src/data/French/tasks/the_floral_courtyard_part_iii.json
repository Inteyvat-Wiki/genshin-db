			},
			"dialogs": [
				{
					"id": 726890101,
					"content": "Ah, c'est vous. Pile à l'heure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726890102
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726890102,
					"content": "Après ces deux séances de pratique, votre connaissance de l'ikebana a connu une progression fulgurante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726890103
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726890103,
					"content": "C'est pour cette raison que j'ai modifié légèrement le thème d'aujourd'hui pour vous permettre d'explorer une nouvelle perspective.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726890104
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726890104,
					"content": "#On est {M#prêts}{F#prêtes}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726890105
					]
				},
				{
					"id": 726890105,
					"content": "C'est ce que tu dis, mais je ne peux pas m'empêcher d'être un peu nerveuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726890106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726890106,
					"content": "Haha, pas de panique. Détendez-vous et respirez calmement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726890107
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726890107,
					"content": "Avec le talent dont vous avez fait preuve, il vous suffira d'accorder au thème l'attention qu'il mérite pour y arriver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726890108,
						726890111
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726890108,
					"content": "Vous nous flattez, mais continuez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726890109
					]
				},
				{
					"id": 726890109,
					"content": "Le thème d'aujourd'hui est « Les feuilles de jade se reposent, les fleurs naissent dans le vent ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726890110
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726890110,
					"content": "Je me demande ce que vous en ferez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726890111,
					"content": "J'ai autre chose à faire...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726890112
					]
				},
				{
					"id": 726890112,
					"content": "Je comprends. Il est vrai que l'ikebana requiert votre attention totale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726890113
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726890113,
					"content": "Une fois que vous aurez terminé vos tâches et serez libres de toute distraction, votre cour fleurie n'en sera que plus réussie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fushizome"
				}
			]
		},
		{
			"id": 7268903,
			"completionStepIds": [],
