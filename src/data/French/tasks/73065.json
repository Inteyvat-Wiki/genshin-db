				{
					"id": 730650201,
					"content": "D'accord, à quoi veux-tu jouer ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730650202
					]
				},
				{
					"id": 730650202,
					"content": "#Arapratap a préparé plein de trésors et va tous les placer ici. {M#Le nara}{F#La nara} va devoir bien regarder et les compter...",
