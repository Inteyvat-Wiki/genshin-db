					"nextDialogs": [
						730650203
					],
					"speakerTitle": "Arapratap"
				},
				{
					"id": 730650203,
					"content": "#Tout de suite après, Arapratap rangera tous les trésors et {M#le nara doré}{F#la nara dorée} devra dire à Arapratap combien il y avait de trésors d'un certain type.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730650204
					],
					"speakerTitle": "Arapratap"
				},
				{
					"id": 730650204,
					"content": "#{M#Gentil}{F#Gentille} nara, es-tu {M#prêt}{F#prête} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730650205
					],
					"speakerTitle": "Arapratap"
				},
				{
					"id": 730650205,
					"content": "Allons-y.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
