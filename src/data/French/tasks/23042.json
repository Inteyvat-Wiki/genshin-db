			"dialogs": [
				{
					"id": 230420801,
					"content": "#{M#Voyageur}{F#Voyageuse}, qu'est-ce que vous faites ici ? Pourquoi faites-vous tant d'allers-retours ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420802
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420802,
					"content": "Au fait, est-ce que vous aidez Nermin à faire quelque chose ces derniers temps ? Ou... avez-vous entendu quelque chose à son sujet, par hasard ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420803
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420803,
					"content": "J'ai l'impression qu'elle est très occupée ces derniers temps, mais je ne sais pas ce qu'elle fait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420804,
						230420806
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420804,
					"content": "Elle est... Elle est très occupée avec ses fleurs.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420805
					]
				},
				{
					"id": 230420805,
					"content": "Ah oui ? C'est vrai ? Mais je n'ai pas vu de nouvelles fleurs dans sa maison...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420806,
					"content": "Elle est... Elle est très occupée à cuisiner.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420807
					]
				},
				{
					"id": 230420807,
					"content": "Hein ? Est-ce que c'est Hilmi et ses amis qui l'embêtent encore pour avoir de la soupe de pois-menthe ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420808
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420808,
					"content": "Ces gamins... Attendez un peu que je sois libre, je vais leur souffler dans les bronches.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raef"
				}
			]
		},
