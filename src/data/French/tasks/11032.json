				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huixin",
					"Ganyu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110320201,
					"content": "#Maîtresse Ganyu, merci d'avoir accepté mon invitation ! Et en ce qui vous concerne {M#tous les deux}{F#toutes les deux}, votre présence est également très appréciée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320202
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320202,
					"content": "Bien sûr !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110320203,
					"content": "C'est si gentil de votre part, Huixin. Vous vous êtes donnée beaucoup de mal pour organiser ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320204
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320204,
					"content": "Haha, en vérité... En plus de vous remercier pour toute votre aide, il y a quelque chose que j'aimerais vous dire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320205
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320205,
					"content": "Oh ? S'il y a quelque chose qui requiert mon aide, dites-le moi tout de suite. Pas besoin d'hésiter !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320206
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320206,
					"content": "Ah... Non, non, je n'ai pas vraiment besoin d'aide. Euh... Pourriez-vous m'écouter un petit peu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320207
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320207,
					"content": "Avec plaisir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320208
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320208,
					"content": "Héhé... Quand j'étais petite fille, mon père me racontait beaucoup d'histoires sur vous, maîtresse Ganyu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320209
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320209,
					"content": "Même si j'ai le plus grand respect pour mon père, j'ai toujours admiré à quel point vous êtes douce et fiable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320210
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320210,
					"content": "J'ai décidé de rejoindre le personnel du Pavillon Yuehai uniquement par admiration pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320211
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320211,
					"content": "Je ne savais pas que vous aviez une si haute opinion de moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320212
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320212,
					"content": "Cependant, travailler au Pavillon Yuehai s'est avéré être en fait une tâche ardue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320213
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320213,
					"content": "Je ne peux pas me comparer à une secrétaire aussi remarquable que vous. Je... doute souvent de moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320214
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320214,
					"content": "Je ne suis pas d'accord. Vous êtes une excellente secrétaire à part entière.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320215
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320215,
					"content": "Haha, merci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320216
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320216,
					"content": "Au fil des années, je suis également devenue mère...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320217
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320217,
					"content": "Oh ! Alors oncle Tian est grand-père !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110320218,
					"content": "Influencée par mes idéaux de jeunesse, ma fille a suivi mes traces et est également devenue secrétaire au Pavillon Yuehai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320219
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320219,
					"content": "Au début, je m'inquiétais pour elle. Ce n'est pas un travail facile, après tout. Pour dire la vérité, je ne sais toujours pas si elle est assez capable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320220
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320220,
					"content": "Mais après tout ce qui s'est passé cette fois-ci... J'ai décidé de soutenir son choix.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320221
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320221,
					"content": "Alors, qu'est-ce qui vous a fait changer d'avis ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320222
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320222,
					"content": "Le fait qu'elle vous aura à ses côtés, maîtresse Ganyu, comme aînée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320223
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320223,
					"content": "Vous pourriez l'aider, douce comme vous l'êtes toujours, et lui dire : « votre mère faisait ça comme ça ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320224
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320224,
					"content": "Ce serait... une belle image.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320225
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320225,
					"content": "Si ce n'est pas trop demander, elle aura peut-être encore besoin de vos conseils dans vingt ans...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320226
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320226,
					"content": "Huixin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320227
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320227,
					"content": "Je... Je n'ai jamais pensé que je comptais autant pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320228
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320228,
					"content": "Héhé, comme lorsque vous m'avez montré le tour de mon père ! Vous avoir comme « témoin » met les gens à l'aise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320229
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320229,
					"content": "« Témoin »...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320230
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320230,
					"content": "... Il est vrai que j'ai été témoin de milliers d'années d'histoire du Port de Liyue. Tous les changements qu'il a traversés, les histoires de ses habitants...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320231
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320231,
					"content": "Mais j'ai toujours considéré cela comme la source de ma solitude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320232
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320232,
					"content": "Huixin, vous ne savez pas à quel point ces mots sont importants pour moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320233
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320233,
					"content": "Vous m'avez fait comprendre que je partage un autre lien avec les gens du Port de Liyue, en dehors de mon contrat avec le Souverain de la Roche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320234
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320234,
					"content": "Ils comptent sur moi, m'acceptent et espèrent que je serai le témoin de leurs histoires.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320235
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320235,
					"content": "Bien sûr ! Vous êtes irremplaçable pour nous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320236
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320236,
					"content": "Héhéhé... Oui. Et c'est pourquoi je ne peux pas vous décevoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320237
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320237,
					"content": "Hourra ! Ganyu a enfin retrouvé le moral !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110320238,
					"content": "Même si j'ai été supplantée, je souhaite me battre pour ma place...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320239
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320239,
					"content": "Je ne vous laisserai pas tomber. Je vais remplir le contrat et continuer à travailler en tant que secrétaire des Sept Étoiles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320240,
						110320241
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320240,
					"content": "Je vous ai dit que vous n'aviez pas été...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110320242
					]
				},
				{
					"id": 110320242,
					"content": "Quoi qu'il en soit, je vais rentrer et voir par moi-même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320243
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320243,
					"content": "J'ai peur que tout ne soit parti à vau-l'eau depuis mon absence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320244
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320244,
					"content": "Pas de temps à perdre ! Retournons au travail !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320245
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320245,
					"content": "Bonne chance, maîtresse Ganyu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320246
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320246,
					"content": "Aaaaaah ?! On part déjà ? Mais j'ai encore faim !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110320241,
					"content": "Vous n'avez pas été renvoyée. C'est un malentendu !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110320242
					]
				}
			]
		},
		{
			"id": 1103203,
			"completionStepIds": [
				1103204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1103204",
							"2"
						],
						"stepId": 1103204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Baixiao",
					"Baishi",
					"Baiwen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110320301,
					"content": "Ahhhh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320302
					],
					"speakerTitle": "Baishi"
				},
				{
					"id": 110320302,
					"content": "Baishi, allez-vous bien ? Vous êtes-vous assoupie ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320303
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 110320303,
					"content": "Regardez... Regardez qui est de retour !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320304
					],
					"speakerTitle": "Baixiao"
				},
				{
					"id": 110320304,
					"content": "Vous avez même du temps pour vous reposer ? Il semble que vous trois soyez un bon remplacement après tout...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320305
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320305,
					"content": "Pas du tout ! Nous faisons juste... Nous travaillons depuis trop longtemps. Si on ne fait pas de pause...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320306
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 110320306,
					"content": "Nous n'aurions jamais survécu assez longtemps pour vous revoir sans cela, dame Ganyu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320307
					],
					"speakerTitle": "Baixiao"
				},
				{
					"id": 110320307,
					"content": "Dame Ganyu, vous nous avez manqué...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320308
					],
					"speakerTitle": "Baishi"
				},
				{
					"id": 110320308,
					"content": "Oh, c'est étonnamment gentil de votre part. Autant que je me souvienne, nous ne nous sommes rencontrées qu'une seule fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320309
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320309,
					"content": "Nous avons prié jour et nuit pour que vous reveniez et repreniez vos fonctions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320310
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 110320310,
					"content": "Pour nous, vous êtes tel l'Adepte qui descend sauver le monde humain...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320311
					],
					"speakerTitle": "Baishi"
				},
				{
					"id": 110320311,
					"content": "Oubliez toutes nos plaintes futiles d'avant ; délivrez-nous simplement de ce travail ardu, s'il vous plaît...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320312
					],
					"speakerTitle": "Baixiao"
				},
				{
					"id": 110320312,
					"content": "D'accord, d'accord, je comprends.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320313
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320313,
					"content": "Veuillez séparer les affaires en cours en affaires gouvernementales, commerciales et civiles. Marquez les tâches qui n'ont pas été commencées et celles qui sont en cours...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320314
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320314,
					"content": "Je m'occupe du reste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320315
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320315,
					"content": "Bien sûr ! Tout de suite !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320316
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 110320316,
					"content": "Enfin... Nous sommes sauvées...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320317
					],
					"speakerTitle": "Baishi"
				},
