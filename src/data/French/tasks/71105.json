			"dialogs": [
				{
					"id": 711050101,
					"content": "Grand-père...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050102
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050102,
					"content": "Hé, petite, qu'est-ce que tu fais dehors à cette heure-ci ? Comment tu t'appelles ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050103,
					"content": "Je m'appelle Xiangjun... Je cherche mon grand-père, il a été enlevé par des démons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050104
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050104,
					"content": "Des... démons ? Quel genre de démons ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050105,
					"content": "J—Je ne sais pas... Grand-père a dit qu'ils vivent dans les montagnes, et que je ne devrais pas m'y promener toute seule... Mais ça fait trois jours qu'il est parti maintenant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050106
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050106,
					"content": "Je pense qu'il essaye juste de te faire peur, tu ne crois pas ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050107
					]
				},
				{
					"id": 711050107,
					"content": "Je pense aussi... A-t-il dit ce qu'il allait faire dans ces montagnes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050108,
					"content": "Grand-père est l'herboriste du village. Il a récemment découvert une herbe divine, qui ne pousserait que dans des zones irriguées par l'eau bénite à proximité du Mont Xuanlian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050109
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050109,
					"content": "Peut-être qu'il est tombé sur des démons qui gardent l'eau bénite ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050110
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050110,
					"content": "Ne t'inquiète pas trop, Xiangjun. Ton grand-père a peut-être simplement eu un petit souci. Mais il commence à se faire très tard maintenant. On va te raccompagner chez toi, d'accord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050111,
					"content": "Mais je dois sauver grand-père...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050112
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050112,
					"content": "On va s'en occuper.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050113
					]
				},
				{
					"id": 711050113,
					"content": "Vous feriez ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050114
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050114,
					"content": "Parfaitement ! Mais si tu ne rentres pas à la maison, ton grand-père risque d'encore plus s'inquiéter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050115,
					"content": "Oh... C'est justement ce que je veux éviter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050116
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050116,
					"content": "Alors laisse-nous nous en occuper, d'accord ? Mais avant toute chose, nous allons te raccompagner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050117,
					"content": "Ce n'est pas la peine. Je vis au Village de Qiaoying, je peux rentrer toute seule.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050118
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050118,
					"content": "#Mais, pourriez-vous aller chercher mon grand-père maintenant, s'il vous plaît{NON_BREAK_SPACE}? Je m'inquiète vraiment pour lui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050119
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050119,
					"content": "Oui, on s'en occupe. Est-ce que tu sais par où il est parti ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050120,
					"content": "Il est parti par là, c'est tout ce que je sais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050121
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050121,
					"content": "Nous allons commencer par là alors.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050122
					]
				},
				{
					"id": 711050122,
					"content": "Merci beaucoup ! Je vais rentrer et vous attendre sagement à la maison.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				}
			]
		},
		{
			"id": 7110502,
