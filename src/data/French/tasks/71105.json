				]
			},
			"dialogs": [
				{
					"id": 711050601,
					"content": "Ce doit être ici, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050602,
					"content": "Comment se fait-il qu'il n'y ait personne ? Ni aucune empreinte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050603,
					"content": "Il a peut-être déjà fait demi-tour ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050604
					]
				},
				{
					"id": 711050604,
					"content": "Ça m'étonnerait. Il était blessé, il n'a pas pu aller bien loin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050605,
					"content": "Mais il n'est pas ici non plus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050606
					]
				},
				{
					"id": 711050606,
					"content": "Peut-être que quelqu'un l'a vu et a décidé de l'aider ? C'est possible...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050607,
					"content": "Tu penses qu'on devrait aller voir au Village de Qiaoying ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050608,
					"content": "Prenons d'abord un peu de cette eau bénite.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050609
					]
				},
				{
					"id": 711050609,
					"content": "Tu as raison. Si le grand-père de Xiangjun a été secouru, il en aura sans doute besoin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050610,
					"content": "#Tout pour aider les autres, tu es vraiment {M#attentionné}{F#attentionnée}, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7110508,
			"completionStepIds": [
				7110508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7110508",
							"2"
						],
						"stepId": 7110508,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Oncle Luo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711050801,
					"content": "#Oh, {M#voyageur}{F#voyageuse}. Vous avez l'air {M#pressé}{F#pressée}. Quel est le problème ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050802
					],
					"speakerTitle": "Oncle Luo"
				},
				{
					"id": 711050802,
					"content": "Nous cherchons Xiangjun et son grand-père. Est-ce que vous savez où ils vivent ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050803,
					"content": "#Xiangjun ? Je n'ai jamais entendu ce nom. Je connais tout le monde au village, vous êtes {M#sûrs}{F#sûres} qu'elle est d'ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050804
					],
					"speakerTitle": "Oncle Luo"
				},
				{
					"id": 711050804,
					"content": "Ce n'est pas possible... Nous avons rencontré cette petite fille qui nous a dit qu'elle s'appelait Xiangjun et qu'elle vivait ici. Elle nous a demandé de l'aider à retrouver son grand-père...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050805,
					"content": "Elle a un grand radeau en bambou !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050806,
					"content": "Il y en a beaucoup dans le coin, mais Xiangjun... Je suis pratiquement sûr qu'il n'y a personne de ce nom dans notre village. Comment s'appelle son grand-père ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050807
					],
					"speakerTitle": "Oncle Luo"
				},
				{
					"id": 711050807,
					"content": "C'est un herboriste.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050808
					]
				},
				{
					"id": 711050808,
					"content": "Un herboriste ? Laissez-moi réfléchir... Il y en avait bien un ici, mais il est mort il y a trois ans...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050809
					],
					"speakerTitle": "Oncle Luo"
				},
				{
					"id": 711050809,
					"content": "Il est mort ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050810,
					"content": "Oui. Il est tombé sur des monstres et... *soupir* Bref, je ne pense pas que ce soit la personne que vous cherchiez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050811
					],
					"speakerTitle": "Oncle Luo"
				},
				{
					"id": 711050811,
					"content": "Il avait toujours l'air un peu à côté de ses pompes. Il ne s'est jamais marié, et n'a jamais eu d'enfant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050812
					],
					"speakerTitle": "Oncle Luo"
				},
				{
					"id": 711050812,
					"content": "Quoi... Donc vous voulez dire que cette Xiangjun que nous avons rencontrée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050813,
					"content": "... Serait-elle un démon ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050814,
					"content": "Quel genre d'herbes votre herboriste cueillait ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050815
					]
				},
				{
					"id": 711050815,
					"content": "Des fleurs et des herbes que nous n'avions jamais vues. Je ne m'y connais pas vraiment, donc je ne peux pas vous aider...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050816
					],
					"speakerTitle": "Oncle Luo"
				},
				{
					"id": 711050816,
					"content": "Mais je pense que nous l'avons trouvé près du Mont Xuanlian. Il tenait encore une bouteille d'eau en main.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050817
					],
					"speakerTitle": "Oncle Luo"
				},
				{
					"id": 711050817,
					"content": "Il disait qu'il avait une herbe divine dans son jardin qui devait être arrosée avec de l'eau bénite. Du grand n'importe quoi si vous voulez mon avis, ce n'est que de l'eau de rivière... Elle n'a rien de spécial ! Pourquoi perdre la vie pour quelque chose comme ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050818
					],
					"speakerTitle": "Oncle Luo"
				},
				{
					"id": 711050818,
					"content": "*soupir* Enfin, après l'avoir enterré, nous avons versé l'eau dans son jardin. J'espère que ça lui permettra de reposer en paix...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050819
					],
					"speakerTitle": "Oncle Luo"
				},
				{
					"id": 711050819,
					"content": "L'eau bénite du Mont Xuanlian ? Nous avons été en chercher justement... L'herboriste dont vous parlez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050820
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050820,
					"content": "Je pense que nous parlons de la même personne.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050821
					]
				},
				{
					"id": 711050821,
					"content": "C'est étrange, c'est certain... Pourquoi ne viendriez-vous pas avec moi ? Je vais vous montrer son jardin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050822
					],
					"speakerTitle": "Oncle Luo"
				},
				{
					"id": 711050822,
					"content": "Si vous avez ramené de l'eau, je suppose que vous pourriez la verser dans son jardin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Oncle Luo"
				}
			]
		},
