			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 711050501,
					"content": "« Au début, je craignais les monstres, mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050502
					],
					"speakerTitle": "Note à la provenance inconnue"
				},
				{
					"id": 711050502,
					"content": "... mes jambes ne suivent plus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050503
					],
					"speakerTitle": "Note à la provenance inconnue"
				},
				{
					"id": 711050503,
					"content": "... Et j'ai sommeil... Le Mont Xuanlian est pourtant juste là... J'y arriverai, Xiangjun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050504
					],
					"speakerTitle": "Note à la provenance inconnue"
				},
				{
					"id": 711050504,
					"content": "J'arriverai à cette source d'eau bénite... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050505
					],
					"speakerTitle": "Note à la provenance inconnue"
				},
				{
					"id": 711050505,
					"content": "Oh non... Il s'est fait attaquer par des monstres et il a été gravement blessé... Mais il a continué malgré tout ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050506,
					"content": "Dépêchons-nous, j'espère qu'on pourra l'aider !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7110506,
