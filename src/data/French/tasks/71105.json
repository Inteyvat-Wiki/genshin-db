			},
			"dialogs": [
				{
					"id": 711051101,
					"content": "S'il n'y a rien d'autre, je vais vous laisser regarder à votre aise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711051102
					],
					"speakerTitle": "Oncle Luo"
				},
				{
					"id": 711051102,
					"content": "Donc il n'y a vraiment aucune Xiangjun...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711051103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711051103,
					"content": "Je vais me renseigner. Il s'agit peut-être d'une erreur. Elle s'est peut-être trompée de village ou quelque chose comme ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711051104
					],
					"speakerTitle": "Oncle Luo"
				},
				{
					"id": 711051104,
					"content": "Merci d'avoir fait le voyage et d'avoir arrosé les herbes pour « l'adepte ». Je suis sûr qu'il veillera sur vous en remerciement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Oncle Luo"
				}
			]
		}
	]
