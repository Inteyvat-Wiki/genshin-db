			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 711050201,
					"content": "« J'ai trop dormi ! Je dois rentrer aujourd'hui, ou il n'y aura personne pour s'occuper de Xiangjun... Grr, quel idiot...! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050202
					],
					"speakerTitle": "Note à la provenance inconnue"
				},
				{
					"id": 711050202,
					"content": "« Si je me souviens bien, il devrait y avoir un raccourci. Un sentier qui relie la Vallée Yaodie au Mont Xuanlian. Je dois juste traverser cette grotte et je devrais y être... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050203
					],
					"speakerTitle": "Note à la provenance inconnue"
				},
				{
					"id": 711050203,
					"content": "« J'ai entendu qu'il y avait des monstres à proximité, mais je dois essayer... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050204
					],
					"speakerTitle": "Note à la provenance inconnue"
				},
				{
					"id": 711050204,
					"content": "Cela ressemble à quelque chose que son grand-père aurait pu laisser derrière lui. Il a dû emprunter ce sentier, suivons-le !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7110505,
			"completionStepIds": [
				7110505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7110505",
