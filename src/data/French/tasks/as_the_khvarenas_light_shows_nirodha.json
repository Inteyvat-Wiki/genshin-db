				{
					"id": 732562006,
					"content": "L'honneur de manœuvrer ce canon vous revient donc, mon yasnapati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sorush"
				}
			]
		},
		{
