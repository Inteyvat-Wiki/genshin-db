			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nasejuna",
					"Sorush",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732560401,
					"content": "Admirez, le moment destiné va enfin se produire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560402
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560402,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732560403
					]
				},
				{
					"id": 732560403,
					"content": "Mais c'est juste une porte ordinaire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732560404,
					"content": "Ahem, je voulais dire que nous pourrons accéder aux ruines en ouvrant cette porte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560405
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560405,
					"content": "C'est la première fois que j'entre dans des ruines dahriennes, je suis tout excité !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560406
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560406,
					"content": "Hein ? Vous débordiez tellement d'assurance que j'ai cru que vous vous étiez déjà aventuré dans des ruines.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732560407,
					"content": "#Bon, je ne peux pas vraiment dire que je l'ai fait, mais la lecture des notes d'enquête de René m'a transporté{NON_BREAK_SPACE}! C'est un ouvrage écrit par un chercheur spécialisé dans les temps anciens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560408
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560408,
					"content": "Les notes d'enquête de René ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732560409
					]
				},
				{
					"id": 732560409,
					"content": "Vous n'en avez jamais entendu parler ? Je pensais que seul un individu vivant isolé dans le désert n'en avait pas connaissance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560410
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560410,
					"content": "Ce sont des notes qui contiennent de nombreuses informations que le peuple de Dahri a laissées derrière lui. L'auteur affirme avoir découvert des connaissances qui « transcendent l'humanité » dans ces ruines.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560411
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560411,
					"content": "J'ai vraiment de plus en plus de mal à croire vos propos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732560412,
					"content": "Bref, entrer dans les ruines devrait être un jeu d'enfant grâce à ces notes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560413
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560413,
					"content": "Si vous ne me croyez pas, nous n'avons qu'à essayer ! Par exemple, pour défaire ce mécanisme... Et voilà !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560414
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560414,
					"content": "<color=#00E1FFFF>« Tournez les trois engrenages pour afficher trois types de runes. Connectez le rectangle au symbole triangulaire en bas, sans bouger ce symbole. »</color> Suivez mes instructions et nous devrions nous en sortir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nasejuna"
				}
			]
		},
