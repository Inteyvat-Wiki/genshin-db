					"nextDialogs": [
						732561002
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561002,
					"content": "Hein ? Ce n'est pas ce que j'avais prévu. Y aurait-il un problème ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561003
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561003,
					"content": "On dirait que nous devons aller jeter un coup d'œil au centre de contrôle où se trouvent les relais. C'est sur le chemin vers les terrains de test.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561004
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561004,
					"content": "#Ah, le centre de contrôle se trouve dans la direction par laquelle vous êtes {M#arrivés}{F#arrivées}. Allons-y ensemble.",
