				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732562301,
					"content": "Honorable émissaire et son yasnapati, je crains ne pas pouvoir vous accompagner plus loin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562302
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562302,
					"content": "Encore un problème ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732562303
					]
				},
				{
					"id": 732562303,
					"content": "Les textes disent que des périls qu'aucun être humain ordinaire ne peut espérer surmonter nous attendent plus loin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562304
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562304,
					"content": "Une fois arrivés là-bas, nous serons sur les terrains où les Dahriens conduisaient des tests sur leurs machines. Il devrait même y avoir un prototype incomplet d'une machine géante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562305
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562305,
					"content": "Les archives dahriennes de mes notes indiquent que cet endroit a été autrefois modifié pour en faire des fortifications depuis lesquelles il était possible d'attaquer les monstres. Cela s'est révélé inefficace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562306
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562306,
					"content": "Ce n'est pas logique. Pourquoi les Dahriens qui ont provoqué le cataclysme auraient besoin de créer des machines pour combattre les monstres ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562307
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562307,
					"content": "Aucune importance, les mécanismes sur les terrains de test devraient marcher, maintenant que nous avons activé les systèmes de contrôle de ces ruines.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562308
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562308,
					"content": "L'hymne final que nous recherchons se trouve sûrement à l'intérieur de ce Golem. Je ne vais pas m'y risquer, mais je suis certain que son obtention sera facile pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562309
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562309,
					"content": "Permettez-moi de rester ici en attendant votre retour et obtenir tous les hymnes de la khvarena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562310
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562310,
					"content": "Vous n'êtes qu'un être humain ordinaire, après tout. Cette demande est tout à fait normale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562311
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732562311,
					"content": "Merci de votre permission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562312
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562312,
					"content": "Nasejuna échappe encore à cette tâche, mais je suis bien contente de ne pas avoir à vous supporter tous les deux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7325624,
