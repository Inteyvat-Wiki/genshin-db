			"dialogs": [
				{
					"id": 732562001,
					"content": "Ce canon bizarre est sorti du sol ! Est-ce qu'on doit tirer avec sur cette grande machine là-bas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732562002,
					"content": "Hmm... La conception est vraiment réfléchie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732562003,
					"content": "Tu as juste une imagination débordante, Blanche flottante. Le nasuraia a dit que cet endroit a été modifié et que c'était précédemment des terrains de tests de performance pour les machines.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
