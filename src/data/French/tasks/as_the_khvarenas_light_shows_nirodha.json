					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562703
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562703,
					"content": "J'ai examiné les noyaux d'énergie... Ils ont été très bien préservés. Il ne reste qu'à installer le bloc d'énergie en leur sein.",
					"roleType": "TALK_ROLE_NPC",
