			"dialogs": [
				{
					"id": 732561201,
					"content": "Je le savais. Le problème vient de ces relais. L'énergie des noyaux ne les atteint pas, il faut trouver un moyen de l'acheminer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561202
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561202,
					"content": "Ces relais sont tous scellés dans du cristal... Comme ces ruines ne fonctionnent pas grâce à l'énergie de la souillure, la khvarena ne les a pas repérés...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561203
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561203,
					"content": "La seule explication possible est qu'un individu capable de manier la khvarena les a intentionnellement scellés. Y aurait-il une intention particulière derrière cette action ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561204
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561204,
					"content": "Bon, nous pourrons en discuter plus tard. Pour l'instant, brisons les sceaux des cristaux gris grâce à la khvarena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561205
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561205,
					"content": "Des farranoyaux avec du pouvoir de la khvarena se trouvent à proximité. Vous devriez le sentir, honorable émissaire, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561206
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561206,
					"content": "Hmph, évidemment que oui. Êtes-vous en train de douter de ma puissance de garde fleurie ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561207
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732561207,
					"content": "Pas du tout, je n'oserais jamais. Guidez-nous, honorable émissaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561208
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561208,
					"content": "Nous devons trouver les farranoyaux, retirer les cristaux gris et utiliser le mélangeur pour relier ces relais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nasejuna"
				}
			]
