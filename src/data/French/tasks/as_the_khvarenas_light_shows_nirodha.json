					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732562004,
					"content": "Le dispositif que nous avons déverrouillé tout à l'heure sert à activer ces terrains de tests.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
