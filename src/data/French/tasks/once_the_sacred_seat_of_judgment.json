			"dialogs": [
				{
					"id": 751890401,
					"content": "Nous avons enfin le permis d'entrer au Cœur de la Montagne sacrée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890402,
					"content": "« Non. Comme je l'ai déjà dit, ce n'est plus qu'une coquille vide... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890403
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751890403,
					"content": "« Un objet fabriqué à partir d'une simple écaille sans aucune information sur son propriétaire ne peut pas devenir un permis. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890404
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751890404,
					"content": "« Sinon, cette chose deviendrait une clé universelle que n'importe quel dragon pourrait utiliser... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890405
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751890405,
					"content": "Nous devons vite trouver un dragon qui fera l'affaire !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751890406
					]
				},
				{
					"id": 751890406,
					"content": "#Où allons-nous trouver un dragon comme celui-là... Hmm, {REALNAME[ID(2)|SHOWHOST(true)]} compte aussi comme un dragon, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890407,
					"content": "Ouh hmm ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890408
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890408,
					"content": "« Pas... pour le moment, non. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890409
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751890409,
					"content": "Qu'est-ce qu'on fait maintenant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890410,
					"content": "« Il y a longtemps, après que le grand souverain a pénétré au Cœur de la Montagne sacrée, d'autres personnes disposaient également de ce permis, mais elles ne l'ont jamais utilisé. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890411
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751890411,
					"content": "« Peut-être que ce permis placé bien en vue a été laissé précisément à cette fin... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Serviteur de source secrète"
				}
			]
		},
