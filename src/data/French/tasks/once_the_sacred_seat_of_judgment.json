			"dialogs": [
				{
					"id": 751890501,
					"content": "« Je savais que vous viendriez ici, alors je suis arrivé plus tôt pour vous accueillir comme il se doit... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890502
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751890502,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890503
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890503,
					"content": "« Même si je sais que ce n'est que par politesse, je suis vraiment content de vous voir. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890504
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751890504,
					"content": "Ah, c'est donc vous. Euh, quel est votre nom cette fois ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890505,
					"content": "« Cette fois, le nom appartenait à un scribe de la Chambre de délibération. Depuis l'invention des serviteurs de source secrète, il n'écrivit pratiquement plus rien lui-même. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890506
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751890506,
					"content": "« Vous pouvez m'appeler... Awanyu. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890507
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751890507,
					"content": "Eh bien, Awanyu, êtes-vous ici pour nous aider à obtenir le permis pour entrer au Cœur de la Montagne sacrée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890508,
					"content": "« Sans ce dernier, l'assemblage astral établi au Cœur de la Montagne sacrée attaquera immédiatement les intrus... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890509
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751890509,
					"content": "« ... J'ai récupéré les données de cet Awanyu. Le permis d'entrée au Cœur de la Montagne sacrée a été déposé auprès de la Chambre de délibération. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890510
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751890510,
					"content": "« C'est pourquoi je n'ai pas eu d'autre choix que de venir ici... Ce lieu où se rassemble cette bande d'incompétents fiers de leur inutilité. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890511
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751890511,
					"content": "« Des imposteurs qui se permettent de juger leurs pairs... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Serviteur de source secrète"
				}
			]
		},
