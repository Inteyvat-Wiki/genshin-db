				]
			},
			"dialogs": [
				{
					"id": 751890301,
					"content": "« Allons-y. Voyons où ils ont caché le permis... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890302
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751890302,
					"content": "« On dirait qu'ils l'ont simplement laissé là... Ils n'ont même pas pensé à le dissimuler... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890303
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751890303,
					"content": "« Il n'empêche, on dirait que ce n'est plus qu'une coquille vide... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890304
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751890304,
					"content": "Waouh, d'où sortent ces Limiers de faille tout à coup...? Oh non, le permis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890305,
					"content": "« C'est sûrement parce que la porte n'est plus protégée. Ils ont dû en profiter pour entrer. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890306
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751890306,
					"content": "Qu'allons-nous faire maintenant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890307,
					"content": "« Ce n'est pas grave. Nous allons simplement activer l'appareil de purification de la Chambre de délibération. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890308
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751890308,
					"content": "« Là-bas... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Serviteur de source secrète"
				}
			]
		},
