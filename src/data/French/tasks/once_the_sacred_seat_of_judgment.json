			"dialogs": [
				{
					"id": 751890701,
					"content": "Menace d'ennemi sombre détectée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890702
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751890702,
					"content": "Sauvegarde interne... Mode autoréparation activé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890703
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751890703,
					"content": "Ah ! Je n'aurais jamais pensé qu'il y aurait ce genre de mécanisme ici... Ces monstres ont été éliminés en un instant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890704,
					"content": "« Cet endroit a été construit pour résister aux ravages du temps. Il est non seulement capable de se défendre, mais aussi de s'auto-réparer... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890705
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751890705,
					"content": "C'est doré et brillant... J'ai envie de toucher !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890706,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890707
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890707,
					"content": "« Haha, je ne vous le conseille pas... Cet objet ne fait pas la différence entre ami et ennemi, et brûle tout ce qu'il touche. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890708
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751890708,
					"content": "« C'est stupide et brutal. Hmph, pas étonnant de la part de ces imbéciles... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890709
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751890709,
					"content": "Mais nous pourrions aussi l'utiliser pour percer le bouclier qui protège le permis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890710,
						751890712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890710,
					"content": "Ça vaut la peine d'essayer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751890711
					]
				},
				{
					"id": 751890711,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890716
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890716,
					"content": "Enfin... Nous devons trouver un moyen de faire monter ce truc !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890712,
					"content": "C'est une très bonne suggestion...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751890713
					]
				},
				{
					"id": 751890713,
					"content": "Broaah, raouh yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890714
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890714,
					"content": "« En effet. Qui aurait pensé que notre émissaire blanche pouvait avoir des paroles aussi profondes... Quelle sagesse impressionnante. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890715
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751890715,
					"content": "... Je ne vois vraiment pas ce qu'il y a de surprenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890716
					],
					"speakerTitle": "Paimon"
				}
