						],
						"pointId": 72
					}
				]
			},
			"dialogs": [
				{
					"id": 751890601,
					"content": "« Là, la lumière gravée qui active l'écaille, c'est le permis... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890602
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751890602,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890603
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890603,
					"content": "On peut voir toute la cité sacrée d'ici !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890604,
					"content": "« Oui, mais ce ne sont en réalité que les tristes vestiges d'une gloire révolue... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890605
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751890605,
					"content": "Ouh hmm... Yaa ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890606
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890606,
					"content": "« Vous voulez vraiment savoir quel a été le verdict ? Héhé... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890607
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751890607,
					"content": "« Ceux qui souhaitaient un jugement sacré savaient bien que le Seigneur de toutes les flammes feignait simplement la mort. Mais lorsque le véritable roi a fait l'une des apparitions dont il a le secret... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890608
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751890608,
					"content": "« Les treize dirigeants et les trois princes, qui avaient été si bavards jusque-là, se sont immédiatement rétractés et la farce qu'était ce jugement s'est arrêtée... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890609
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751890609,
					"content": "Ouh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890610
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890610,
					"content": "« Plus tard, les trois princes sont morts dans des batailles contre l'humanité, dix dirigeants ont connu leur fin lors de la chute de la cité sacrée de Tollan, et un seul est resté à Chichen Uctokah... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890611
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751890611,
					"content": "« Mais un dirigeant a survécu jusqu'à ce jour... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890612
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751890612,
					"content": "« Mais sans doute pas sous la forme qu'il aurait souhaité conserver... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890613
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751890613,
					"content": "« Très bien... Continuons vers le Cœur de la Montagne sacrée. C'est là que nous trouverons tout ce qui a été enfoui... et la destination finale de ce voyage. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890614
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751890614,
					"content": "#« Ma mission ici touche à sa fin... Ô {M#élu}{F#élue} des dragons, comme cet endroit était magnifique autrefois... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890615
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751890615,
					"content": "« Atteignez la lumière gravée dans les flammes... Obtenez la permission d'atteindre le Cœur de la Montagne sacrée... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890616
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751890616,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890617
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890617,
					"content": "Awanyu... Il est encore parti ! Je n'ai même pas eu le temps de m'habituer à son nom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890618,
					"content": "Mais au moins, on a enfin obtenu le permis pour aller au Cœur de la Montagne sacrée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890619,
					"content": "Ouh hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890620
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890620,
					"content": "La lumière ici... a disparu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
