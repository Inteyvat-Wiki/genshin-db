			"dialogs": [
				{
					"id": 737130101,
					"content": "Ta-da ! On y est ! Commençons par cette partie peu profonde. On aura l'impression d'entrer dans un tableau qui se dévoile sous nos yeux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737130102,
					"content": "Ah... C'est vous. Et vous avez amené de nouveaux compagnons ? Ce sont... des Fongus ? Je n'en ai entendu parler que dans les livres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130103
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 737130103,
					"content": "Oh, il y a même une mélusine ici !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130104,
						737130105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737130104,
					"content": "C'est un plaisir de vous revoir, Marine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737130106
					]
				},
				{
					"id": 737130106,
					"content": "En fait, je suis en train de travailler. Je cueille des maréalgues pour les conserves de cette année. Beaucoup d'autres sont rentrées au village pour aider aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130107
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 737130107,
					"content": "Enghiene et la petite Roxane ont toutes les deux pris congé pour revenir aider. Elles sont déjà au travail, et je vais moi-même aller dans l'eau d'ici peu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130108
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 737130108,
					"content": "Vous savez... Enghiene n'avait pas tort. Les Fongus bleus ressemblent vraiment un peu à des maréalgues...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130109
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 737130109,
					"content": "Pas dans le sens culinaire ! Je voulais juste dire qu'ils sont mignons. Rien d'autre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130110
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 737130110,
					"content": "♫ ♪ ~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130111
					],
					"speakerTitle": "Chapotoc"
				},
				{
					"id": 737130111,
					"content": "Héhé ! Vous avez l'œil pour repérer ce qui est mignon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130112,
						737130113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737130112,
					"content": "Les Fongus sont vraiment adorables.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737130114
					]
				},
				{
					"id": 737130114,
					"content": "Bref, j'étais ravie de vous voir. Je dois y aller... Profitez bien du reste de votre séjour ici !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130115
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 737130115,
					"content": "Bon, et si on y allait aussi ? On va faire de superbes photos sous-marines à Fontaine avec nos amis les Fongus !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737130113,
					"content": "Les mélusines sont tout aussi adorables.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737130114
					]
				},
				{
					"id": 737130105,
					"content": "Salut ! C'est la première fois que je vous vois par ici.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737130106
					]
				}
			]
		}
	]
