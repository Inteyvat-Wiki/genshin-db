				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730600401,
					"content": "Le Bosquet des Rêves... Une douce mélodie, le bruit de l'eau, le bruit du battement d'ailes des oiseaux et de leurs pattes marchant sur les branches...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600402
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730600402,
					"content": "#Quand j'ai parlé avec {M#le}{F#la} nara et Paimon... Paimon était amusante. Quel dommage que Paimon ne veuille pas devenir une graine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600403
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730600403,
					"content": "C'est parce que Paimon n'est pas une aranara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600404
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730600404,
					"content": "Tout va bien au Bosquet des Rêves désormais. Arabalika est dans les Ruines de Dahri, mais je ne suis pas inquiet. Cependant, il y a beaucoup de Fongus au Monument de Yasna. Je suis inquiet pour Aranakula...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapandu"
				}
			]
		},
