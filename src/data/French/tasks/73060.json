			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aranakula",
					"Arapandu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730600201,
					"content": "#Tu sembles n'avoir peur de rien, {M#nara doré}{F#nara dorée}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600202
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730600202,
					"content": "#{M#Le nara doré}{F#La nara dorée} est {M#un nara courageux}{F#une nara courageuse}, comme nara Varuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600203
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730600203,
					"content": "#Même si je me fais du souci pour Arabalika qui est dans les Ruines de Dahri et Arakunti qui est dans le Bosquet des rêves, je suis sûr qu'avec {M#le nara doré}{F#la nara dorée}, tout ira bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600204
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730600204,
					"content": "Maintenant que l'outil varuna est guéri, des méchants n'iront plus semer le désordre dans la pépinière. Donc j'aimerais lui offrir des fleurs qui y ont poussé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakula"
				}
			]
		},
		{
			"id": 7306003,
