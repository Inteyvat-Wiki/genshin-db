			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arapandu",
					"Arabalika"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730600301,
					"content": "Arabalika va bien, mais je suis toujours inquiet pour Aranakula qui se trouve au Monument de Yasna et Arakunti qui est dans le Bosquet des rêves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600302
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730600302,
					"content": "Aranakula... Il y a trop de méchants champignons, si Aranakula se fait encore attraper par eux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600303
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730600303,
					"content": "#Trop s'inquiéter, c'est inutile. {M#Le nara doré}{F#La nara dorée} est très {M#fort}{F#forte}, {M#il}{F#elle} va battre le gros morceau de fer tel un vent violent qui fait craquer du bois pourri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600304
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730600304,
					"content": "Tant que l'outil varuna est guéri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapandu"
				}
			]
		},
		{
