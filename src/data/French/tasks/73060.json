			"dialogs": [
				{
					"id": 730600701,
					"content": "Aranakula est au Monument de Yasna. Il y a beaucoup de champignons là-bas, c'est inquiétant... Arabalika...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600702
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730600702,
					"content": "Arabalika n'ira pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600703
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730600703,
					"content": "Aranakula, il est fort pour se cacher, les champignons ne le trouveront pas. Pourquoi es-tu inquiet, Arapandu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
