				"points": []
			},
			"dialogs": [
				{
					"id": 730600501,
					"content": "Arabalika devrait bientôt revenir des Ruines de Dahri. Avec l'ararakalari d'Arabalika, on n'aura peur ni du gros morceau de fer ni du Fongus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600502
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730600502,
					"content": "Si Aranakula était à moitié aussi fort qu'Arabalika, il pourrait protéger la pépinière.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600503
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730600503,
					"content": "Aranakula n'a que la moitié de la moitié de la force d'Arabalika.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600504
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730600504,
					"content": "*sanglote* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600505
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730600505,
					"content": "#Aranakula peut devenir plus courageux, tout comme le {M#le nara doré}{F#la nara dorée}, il te faudra juste du temps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapandu"
				}
			]
		},
