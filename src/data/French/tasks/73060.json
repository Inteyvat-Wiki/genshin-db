			},
			"dialogs": [
				{
					"id": 730600601,
					"content": "Il y a beaucoup de méchants au Monument de Yasna, mais au moins, Aranakula est de retour. C'est bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600602
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730600602,
					"content": "#{M#Le nara doré}{F#La nara dorée} a esquivé les méchants avec Aranakula et a purifié le souvenir de la pierre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600603
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730600603,
					"content": "Une fois l'outil varuna guéri, les fleurs de la pépinière pourront être ramenées ici. Les aranaras ne l'oublieront pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600604
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730600604,
					"content": "Il ne reste plus qu'Arakunti dans le Bosquet des rêves. Quand Arakunti sera revenu, on pourra aller éliminer les méchants parasites qui rongent les racines de l'outil varuna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapandu"
				}
			]
		},
