			"dialogs": [
				{
					"id": 751130401,
					"content": "#Ouah, je n'aurais jamais imaginé que vous vous en sortiriez aussi bien ! Je vous ai clairement {M#sous-estimé}{F#sous-estimée} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751130402
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 751130402,
					"content": "#Après toute cette préparation, je n'arrive pas à croire que les prix du défi ont fini par être remportés par {M#un parfait inconnu}{F#une parfaite inconnue} de passage... C'est presque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751130403
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 751130403,
					"content": "... C'est presque comme l'un de ces récits héroïques, tout droit sorti d'un rouleau tissé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751130405
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 751130405,
					"content": "Peut-être qu'un jour, vos actes héroïques entreront dans nos légendes ? Enfin... C'est même très probable !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751130406
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 751130406,
					"content": "#Que diriez-vous d'une petite photo ensemble, {M#cher héros}{F#chère héroïne} ? Je pourrais peut-être m'en vanter à l'avenir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Urubamba"
				}
			]
