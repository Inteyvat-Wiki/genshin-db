			"dialogs": [
				{
					"id": 751130101,
					"content": "#{M#Gentil guerrier}{F#Gentille guerrière}, mes sauriens sont sains et saufs grâce à vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751130106
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 751130106,
					"content": "Vous avez fait preuve d'un courage et d'une gentillesse sans pareil. Moi, Urubamba, je serais honoré de vous entraîner pour le défi guerrier ! Tout ça, gratuitement !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751130104,
						751130105
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 751130104,
					"content": "Commençons !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 751130105,
					"content": "Je dois me préparer...",
