						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kazuha",
					"Mona",
					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400680301,
					"content": "Ça ressemble à une île normale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680302,
					"content": "... Il y a une odeur de brûlé dans l'air.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680303
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680303,
					"content": "Hum... Mon disque d'eau est plus dégagé, mais je ne peux toujours pas y voir clair...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680304
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680304,
					"content": "Hé ! Regardez ce que j'ai découvert !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680305
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680305,
					"content": "Cet objet... est un tambour ou une plante ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680306
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680306,
					"content": "Un instrument de musique fabriqué à partir d'une plante ? Dans ce cas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680307
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680307,
					"content": "Xinyan, cette île est en rapport avec toi, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680308
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680308,
					"content": "C'est un instrument de musique pour moi ? Laissez-moi l'essayer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680309
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680309,
					"content": "Attendez une minute. Nous avons été transportés dans un lieu assez particulier quand j'ai touché la rocaille du bonsaï hier. Xinyan, vous faudrait-il un peu de temps pour vous préparer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680310
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680310,
					"content": "C'est vrai, mais je ne m'inquiète pas. Je suis toujours prête pour la musique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				}
			]
		},
		{
			"id": 4006804,
			"completionStepIds": [
