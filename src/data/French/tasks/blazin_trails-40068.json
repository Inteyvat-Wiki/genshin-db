			"dialogs": [
				{
					"id": 400680401,
					"content": "*tousse* J'ai avalé un peu de poussière...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680402,
					"content": "Ça va, Paimon ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680403
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680403,
					"content": "Comme prévu, nous voilà dans un autre endroit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680404
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680404,
					"content": "Il a l'air désert... Xinyan, t'es sûre que cette illusion est liée à toi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680405
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680405,
					"content": "Oui, je crois, mais... c'est bizarre, pourquoi est-ce si désert ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680406
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680406,
					"content": "Regardez, ça brille là-bas. C'est comme si on était invités à s'y rendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680407,
					"content": "Oui, allons voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680408
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680408,
					"content": "Mais non ! C'est trop facile, ça doit être un piège !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680409,
					"content": "C'est peut-être le cas, mais nous n'avons pas d'autre issue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680410
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680410,
					"content": "C'est vrai...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680411
					]
				},
				{
					"id": 400680411,
					"content": "Si c'est l'illusion de Xinyan, il n'y aura pas de piège.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680412
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680412,
					"content": "Tu sais toujours quoi dire ! Ça me remonte le moral.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680413
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680413,
					"content": "Vous avez raison, allons-y prudemment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
