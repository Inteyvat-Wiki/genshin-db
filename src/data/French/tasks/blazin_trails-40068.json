					"content": "La porte est verrouillée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680502,
						400680504
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680502,
					"content": "#Mona, transforme-toi en eau et passe en dessous{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680503
					]
				},
				{
					"id": 400680503,
					"content": "Ne dis pas de bêtises.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680506
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680506,
					"content": "Xinyan, pourquoi tu as verrouillé la porte ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680507,
					"content": "Hahaha, je ne sais pas du tout...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680508
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680508,
					"content": "Mais j'ai tendance à mettre la clé sous le pot de fleurs près de la porte, donc... la clé de cette porte pourrait être dans les environs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680509
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680509,
					"content": "Oh ! Y a-t-il un pot de fleurs dans le coin ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680510,
					"content": "Non, mais... Il y a ça.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680511
					]
				},
				{
					"id": 400680511,
					"content": "Ça vaut la peine d'essayer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680504,
					"content": "Kazuha saute de toutes tes forces et passe au-dessus !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680505
					]
				},
				{
					"id": 400680505,
					"content": "... Continuons de réfléchir à la question.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680506
					],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
