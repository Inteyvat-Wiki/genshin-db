					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400680901,
					"content": "Waouh ! Une grande fleur !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680902,
					"content": "Il faut chaud... Est-ce que c'est à cause de cette fleur ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680903
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680903,
					"content": "Eh bien, je ne pensais pas qu'on aurait des invités.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680904
					],
					"speakerTitle": "Cœur enflammé"
				},
				{
					"id": 400680904,
					"content": "Aaaaaaaah, elle parle !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680905,
						400680906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680905,
					"content": "L'écureuil a parlé hier...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680907
					]
				},
				{
					"id": 400680907,
					"content": "Je sais, mais... Mais c'est différent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680908,
					"content": "Bonjour, nous avons été transportés ici après avoir touché des plantes ressemblant à des tambours sur la plage. Êtes-vous la maîtresse des lieux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680909
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680909,
					"content": "Nous sommes dans le temple de la musique et je n'en suis qu'une simple gardienne. Mes amis, êtes-vous à la recherche de la musique extrême ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680910
					],
					"speakerTitle": "Cœur enflammé"
				},
				{
					"id": 400680910,
					"content": "Et comment !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680911
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680911,
					"content": "Pourquoi crées-tu de la musique ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680912
					],
					"speakerTitle": "Cœur enflammé"
				},
				{
					"id": 400680912,
					"content": "Pour me rebeller !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680913
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680913,
					"content": "Tu sais de quoi tu parles ! Je suis heureuse de faire ta connaissance, toi qui partages cet idéal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680914
					],
					"speakerTitle": "Cœur enflammé"
				},
				{
					"id": 400680914,
					"content": "Eh beh, elle s'entend parfaitement avec cette fleur bizarre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680915,
					"content": "Une personne sociable peut se faire de nombreux amis, peu importe où elle se trouve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680916
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680916,
					"content": "Vous êtes venus me voir pour aller plus loin dans le temple, mais je suis désolée. Ma voix est la seule qui puisse ouvrir l'entrée du temple et elle est actuellement éraillée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680917
					],
					"speakerTitle": "Cœur enflammé"
				},
				{
					"id": 400680917,
					"content": "Ça va ? Est-ce que tu veux, euh, des médicaments contre le rhume ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680918
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680918,
					"content": "Non, de l'eau de montagne suffira. Cela fait un moment que je n'en ai pas bu. Si vous pouviez m'en donner, je retrouverais ma voix et je pourrai vous ouvrir le chemin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680919
					],
					"speakerTitle": "Cœur enflammé"
				},
				{
					"id": 400680919,
					"content": "De l'eau de montagne ? Tu veux dire de l'eau de source ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680920
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680920,
					"content": "Oui. Quiconque boit cette eau, un adulte fatigué, un oiseau somnolant, un enfant innocent... peut chanter d'une belle voix.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680921
					],
					"speakerTitle": "Cœur enflammé"
				},
				{
					"id": 400680921,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680922
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680922,
					"content": "OK, je vais t'aider à en trouver. Dis-moi où elle est.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680923
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680923,
					"content": "Merci ! L'eau claire permet aux plantes de grandir, de s'épanouir et de grimper jusqu'aux hautes montagnes en surmontant les difficultés... La source se trouve sur les montagnes protégées par ces plantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680924
					],
					"speakerTitle": "Cœur enflammé"
				},
				{
					"id": 400680924,
					"content": "Sur la montagne ! Je croyais que de l'eau de mer aurait fait l'affaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680925
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680925,
					"content": "L'eau de source des montagnes et l'eau de mer sont complètement différentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680926
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680926,
					"content": "Par contre, vous aurez besoin de ma force pour retrouver cette eau. Ma chère amie, donne-moi ta main pour que je puisse te partager ce que je vois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680927
					],
					"speakerTitle": "Cœur enflammé"
				},
				{
					"id": 400680927,
					"content": "Très bien ! En me serrant la main, tu deviens officiellement mon amie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680906,
					"content": "Le bateau a parlé hier...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680907
					]
				}
			]
		},
