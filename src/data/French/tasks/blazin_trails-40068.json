			},
			"dialogs": [
				{
					"id": 400681201,
					"content": "Regardez, il y a une note.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681202
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400681202,
					"content": "Je vois, cette île est vraiment intéressante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681203
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400681203,
					"content": "Ce ton et cette signature... C'est Albedo, notre ami de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400681204,
					"content": "Albedo est un alchimiste talentueux. Il est déjà venu sur cette île, et ce papier doit être une de ses notes de recherche laissée ici pour de futurs aventuriers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400681205,
					"content": "Oh ? C'était donc lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681206
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400681206,
					"content": "Il veut dire que toute cette île a été transformée en instrument de musique ? Par les Archons, c'est génial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681207
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400681207,
					"content": "Et ça a aussi un rapport avec les cours d'eau souterrains. Peut-être qu'il faut toutes les désobstruer pour « jouer » de cette île...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400681208,
					"content": "C'est logique de nettoyer un instrument avant d'en jouer.",
					"roleType": "TALK_ROLE_NPC",
