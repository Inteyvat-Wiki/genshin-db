			"dialogs": [
				{
					"id": 400681001,
					"content": "Ouah, on est enfin sortis !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400681002,
					"content": "On y voit plus clair à l'extérieur. La chaleur de la grotte ne me déplaisait pas pour autant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681003
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400681003,
					"content": "L'eau se trouve dans les montagnes voisines. Cherchons-la ensemble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681004
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400681004,
					"content": "Attendez, comment peut-il y avoir de la lumière provenant de sous le sol ? C'est... un cours d'eau ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681005
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400681005,
					"content": "D'après les paroles de la fleur... Ce cours d'eau est lié aux plantes qui nous mèneront à l'eau de source des montagnes. Suivons-le.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				}
			]
		},
		{
