				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400680201,
					"content": "Debout ! Le soleil s'est levé, ça pique les yeux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680202,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680203
					]
				},
				{
					"id": 400680203,
					"content": "Paimon, je dors les yeux fermés.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680204
					]
				},
				{
					"id": 400680204,
					"content": "Ben oui, c'est bien pour ça que tu ne l'as pas vu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680205,
					"content": "#{NICKNAME}, avez-vous bien dormi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680206,
						400680207
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680206,
					"content": "Bof.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680208
					]
				},
				{
					"id": 400680208,
					"content": "Comme tout le monde. Je me suis levé en premier pour faire une promenade. J'ai cueilli des fruits pour notre petit déjeuner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680209
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680209,
					"content": "Je me suis retenue de ne pas les manger parce que je t'attendais !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680210,
					"content": "Tout le monde partage des fruits pour le petit déjeuner et discute...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400680211
					]
				},
				{
					"id": 400680211,
					"content": "Hein ? Fischl est partie de bon matin ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680212,
					"content": "Oui, je crois qu'elle souhaite être seule. D'après ses dires, elle aurait une mission d'aventurière à accomplir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680213
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680213,
					"content": "C'est un mensonge à coup sûr ! Nous sommes ici pour faire renaître l'Empire de la nuit éternelle, pourquoi irait-elle soudainement travailler pour la Guilde des aventuriers ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680214,
					"content": "Ça suffit, Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680215
					]
				},
				{
					"id": 400680215,
					"content": "Je pense qu'elle doit être tracassée par quelque chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680216
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680216,
					"content": "On voulait que Mona l'accompagne, mais elle a refusé sous prétexte que Mona ne pouvait pas prendre part à sa mission, car elle ne connaît pas le travail d'aventurière.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680217
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680217,
					"content": "Fischl n'utilise même plus l'excuse de l'Empire de la nuit éternelle pour être seule...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680218,
					"content": "Elle doit être particulièrement préoccupée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680219
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680219,
					"content": "*soupir* En tant qu'amie, j'aimerais l'aider. Par contre, elle avait vu juste : nous irons explorer d'autres îles aujourd'hui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680220
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680220,
					"content": "Hein ? C'est vrai ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680221
					]
				},
				{
					"id": 400680221,
					"content": "Tout le monde a approuvé à l'unanimité !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680222,
					"content": "Je n'étais pas là, moi !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680223
					]
				},
				{
					"id": 400680223,
					"content": "Ah. Paimon a voté pour toi. Elle a dit que comme vous êtes d'inséparables partenaires, son opinion vaut pour la tienne, et vice versa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680224
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680224,
					"content": "#Héhé, tu es {M#un aventurier}{F#une aventurière}. Tu ne raterais pas ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680225,
					"content": "(Cette Paimon... Enfin bon...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680226
					]
				},
				{
					"id": 400680226,
					"content": "Fischl nous a recommandé d'agir ensemble. Elle a une autre affaire à tirer au clair et nous rejoindra plus tard. Ne nous inquiétons pas pour elle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680227
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680227,
					"content": "Malgré son excentricité, elle n'en reste pas moins une aventurière expérimentée. Je pense que nous devons avoir confiance en elle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680228
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680228,
					"content": "Je ne connais pas Fischl depuis longtemps et c'est présomptueux de ma part de dire cela, mais je crois qu'elle est... en conflit avec elle-même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680229
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680229,
					"content": "Vous avez raison...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680230,
					"content": "Un conflit avec autrui peut être résolu ou abandonné, mais ce n'est pas le cas avec soi-même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680231
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680231,
					"content": "... J'ai aussi eu mes moments difficiles, je comprends ce qu'elle ressent. Bien que j'ignore ce qui la tracasse, je sais qu'elle a besoin de solitude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680232
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680232,
					"content": "Je suis d'accord. Dommage pour le voyage d'aujourd'hui... C'est plus marrant quand on est tous ensemble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680233
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680233,
					"content": "Tu as toujours aimé faire les choses en équipe, Xinyan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680234,
					"content": "#Ah, c'est vrai. J'ai oublié de vous le dire, mais ce matin, une illusion est apparue sur l'île au nord. Allons-y dès que {NICKNAME} aura fini de manger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680207,
					"content": "Plutôt bien !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680208
					]
				}
			]
		},
		{
			"id": 4006803,
