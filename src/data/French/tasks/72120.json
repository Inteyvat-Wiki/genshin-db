			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721200101,
					"content": "Ha, magnifique ! Les tests se sont parfaitement déroulés. Les scarabutos ont été totalement purifiés !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200102
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200102,
					"content": "Eh bien, alors...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721200103
					]
				},
				{
					"id": 721200103,
					"content": "Il ne nous reste plus qu'à planifier notre itinéraire et les choses sérieuses pourront commencer. Cependant, pour éviter ces Fatui... Il semble qu'on doive emprunter la route la plus longue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200104
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200104,
					"content": "Ce truc est... plutôt encombrant. On ferait bien de s'assurer qu'on puisse emprunter des chemins faciles d'accès.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200105
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200105,
					"content": "C'est pour cela que je voudrais vous demander d'aller voir au Fourneau Mikage s'il y a des routes impraticables et de les remettre en état le cas échéant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200106
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200106,
					"content": "Je n'ai pas encore décidé de notre itinéraire, mais avoir plus de possibilités ne pourra certainement pas faire de mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200107
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200107,
					"content": "Je ne sais pas comment réparer les routes, vous savez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721200108
					]
				},
				{
					"id": 721200108,
					"content": "Vous n'avez pas besoin d'en faire des routes... euh, parfaitement fiables. Vous avez juste à placer une planche de bois pour qu'on puisse déplacer cet appareil dessus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200109
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200109,
					"content": "Ah, vous n'avez qu'à récupérer des planches dans le coin. Je vais continuer à bricoler notre machine pour la rendre aussi fiable que possible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
		{
			"id": 7212002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
