				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721200301,
					"content": "Alors, vous avez examiné toutes les routes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200302
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200302,
					"content": "Je les ai réparées du mieux que j'ai pu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721200303
					]
				},
				{
					"id": 721200303,
					"content": "Bien. A—Alors, on part dans un instant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200304
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200304,
					"content": "Qu'est-ce que vous faites ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721200305
					]
				},
				{
					"id": 721200305,
					"content": "Je... Je réfléchis ! Je réfléchis à toutes les possibilités, vous comprenez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200306
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200306,
					"content": "Par exemple, que ferons-nous si ces fous masqués ont déjà extrait le noyau quand nous entrons ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200307
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200307,
					"content": "Ils pourraient l'insérer dans le corps d'un Gardien des ruines pour le rendre incontrôlable et qu'il nous envoie voler dans les airs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200308
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200308,
					"content": "Ou peut-être qu'une créature élémentaire abominable va apparaître pendant qu'on purifiera le Fourneau Mikage et qu'elle va dévorer le noyau d'une seule bouchée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200309
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200309,
					"content": "E—Et le pire de tous : qu'est-ce qui se passera si le serpent légendaire profite de l'occasion pour revenir à la vie. Alors là on est foutus ! Fou-tus !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200310,
						721200311
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200310,
					"content": "Reprenez-vous, Xavier...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721200312
					]
				},
				{
					"id": 721200312,
					"content": "Ah ! Hum, désolé, je... Voilà que mes vieilles habitudes me reprennent. J'envisage toujours les scénarios catastrophe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200313
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200313,
					"content": "Je vais mettre au point un plan et le moment venu, on y va et on arrange tout ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200314
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200314,
					"content": "Pourvu que tout aille bien, pourvu que tout aille bien, pourvu que tout aille bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200311,
					"content": "Ça n'arrivera pas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721200312
					]
				}
			]
		},
