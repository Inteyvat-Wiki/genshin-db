			},
			"dialogs": [
				{
					"id": 721200201,
					"content": "J'espère que tout ira bien. Plus vite on règle cette affaire, mieux ce sera. Qui sait ce qui pourrait arriver si on tarde davantage...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
		{
			"id": 7212003,
			"completionStepIds": [
				7212009
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7212009",
							"2"
						],
						"stepId": 7212009,
						"stateName": "QUEST_STATE_UNFINISHED"
