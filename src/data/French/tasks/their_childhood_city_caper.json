			"dialogs": [
				{
					"id": 240050301,
					"content": "C'est donc ça, L'Oiseau de vapeur ? Ça n'a rien de spécial...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050302,
						240050303
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050302,
					"content": "Un lieu très ordinaire, oui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050304
					]
				},
				{
					"id": 240050304,
					"content": "#Waouh, donc il y a vraiment un oiseau mécanique ici{NON_BREAK_SPACE}?! Trop cool !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050305
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050305,
					"content": "Mon père m'emmène souvent ici pour acheter le journal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050306
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050306,
					"content": "Il adore lire L'Oiseau de vapeur. En fait, il pourrait passer toute la journée à lire les journaux. Parfois, il découpe même des articles qu'il garde dans un livre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050307
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050307,
					"content": "Il appelle ça des « revues de presse ». Parfois, il les lit à voix haute pour ma mère et moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050308
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050308,
					"content": "Ça ne nous intéresse pas trop. On se contente de dire « oui, oui », « oh » ou « vraiment ? »... Mais il est tellement concentré qu'il ne le remarque même pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050309
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050309,
					"content": "Qu'entend-il par « revue de presse » ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050310
					]
				},
				{
					"id": 240050310,
					"content": "En résumé, c'est quelqu'un qui exprime ses opinions en public.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050311
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050311,
					"content": "Le père de Lovi, monsieur Delerue, travaille en tant que scientifique à l'Institut de recherche de Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050320
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050320,
					"content": "Il écrit aussi des revues de presse sur L'Oiseau de vapeur pour partager ses analyses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050312
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050312,
					"content": "C'est sûr qu'il aime donner son opinion sur... Sur à peu près tout en fait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050313
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050313,
					"content": "Parfois, il va penser à quelque chose alors qu'il est en train de parler. Il va alors se précipiter dans la maison pour l'écrire. Dans ces moments-là, il ne prend même pas le temps de manger, il boit juste du thé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050314
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050314,
					"content": "Hmm ? On peut gagner sa vie juste en donnant son opinion ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050315
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050315,
					"content": "Ce n'est pas aussi simple que ça. Pour publier une revue de presse digne de ce nom, il y a des règles à suivre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050316
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050316,
					"content": "Hé ! Euh... Quelqu'un a faim ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050317
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050317,
					"content": "Monsieur Louis m'a dit qu'il avait récemment commencé à vendre des frites au fruit bullé. On devrait goûter, je vous invite !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050318
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050318,
					"content": "Oh... OK. Allez frangin, arrête de divaguer, on y va !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050319
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050319,
					"content": "Vous êtes irrécupérables...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050303,
					"content": "Il n'y a vraiment rien de particulier, c'est clair.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050304
					]
				}
			]
		},
