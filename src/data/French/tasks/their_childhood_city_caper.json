			"dialogs": [
				{
					"id": 240050401,
					"content": "Monsieur Louis ! Je voudrais quelques portions de frites au fruit bullé, s'il vous plaît !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050402
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050402,
					"content": "Oh, Lovi ! Je suis désolé, mais il y a beaucoup de gens au port aujourd'hui. J'ai servi tous les fruits bullés que j'avais préparés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050403
					],
					"speakerTitle": "Louis"
				},
				{
					"id": 240050403,
					"content": "M—Mais je vous avais dit que je viendrais. J'ai même amené des amis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050404
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050404,
					"content": "*soupir* Je suis désolé. Il y avait trop de monde, et j'ai oublié... Il reste encore des frites normales. C'est pour la maison.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050405
					],
					"speakerTitle": "Louis"
				},
				{
					"id": 240050405,
					"content": "D'accord. Merci, monsieur Louis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050406,
						240050407
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050406,
					"content": "Il ne vous manque que des fruits bullés ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050408
					]
				},
				{
					"id": 240050408,
					"content": "Il me reste les autres ingrédients, donc si vous pouviez me ramener des fruits bullés, je pourrais faire la sauce directement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050409
					],
					"speakerTitle": "Louis"
				},
				{
					"id": 240050409,
					"content": "#Super ! Vous êtes {M#le meilleur}{F#la meilleure} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050410
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050410,
					"content": "Merci !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050411
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050411,
					"content": "Je suis désolé. On dirait qu'il y a toujours quelque chose qui ne va pas quand on vous voit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050412,
						240050413
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050412,
					"content": "Ce n'est rien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050414
					]
				},
				{
					"id": 240050414,
					"content": "OK, alors... Il faut que je prenne exemple sur vous. Monsieur Delerue dit souvent que je suis trop impassible, ce qui me compliquerait la tâche si je veux écrire des revues de presse à l'avenir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050415
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050415,
					"content": "*tousse* Bref, je vais m'occuper d'eux ici. Je compte sur vous pour ramener les fruits bullés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050413,
					"content": "Ce serait dommage de ne pas pouvoir goûter ces fameuses frites au fruit bullé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050414
					]
				},
				{
					"id": 240050407,
					"content": "Je pourrais vous en ramener.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050408
					]
				}
			]
		},
