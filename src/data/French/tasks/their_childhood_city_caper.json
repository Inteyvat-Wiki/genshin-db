			"dialogs": [
				{
					"id": 240050201,
					"content": "Waouh... J'aimerais faire la planche ou prendre un bain dans la fontaine !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050202
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050202,
					"content": "Et tu aurais de sérieux ennuis. Contente-toi de l'admirer, s'il te plaît.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050203
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050203,
					"content": "Pourquoi les fontaines sont-elles si grandes, si on ne peut même pas jouer dedans ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050204
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050204,
					"content": "Elles sont jolies, mais si on doit se contenter de les regarder, c'est juste de l'eau, sans plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050205
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050205,
					"content": "Ce n'est pas une fontaine ordinaire. Mais... Mon père avait mentionné ces fontaines ordinaires... Qu'est-ce qu'il avait dit déjà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050206
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050206,
					"content": "« L'objectif principal de l'embellissement de la Cour de Fontaine est la résolution des problèmes de déclaration fiscale. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050207
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050207,
					"content": "Monsieur Delerue m'a expliqué cette théorie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050208
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050208,
					"content": "Haha. Tu parles exactement comme mon père... Pas étonnant que mon père t'apprécie tellement, et qu'il prend toujours une pile de livres pour discuter avec toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050209
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050209,
					"content": "Je n'ai rien compris, mais je suis sûr que mon frère était encore négatif.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050210
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050210,
					"content": "Lovi, allons trouver un autre endroit pour jouer. Pour une fois, tu ne dois pas étudier aujourd'hui, si ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050211
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050211,
					"content": "Bon, allons voir ailleurs. Laissez-moi réfléchir... L'Oiseau de vapeur devrait encore être ouvert, allons-y !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lovi"
				}
			]
		},
