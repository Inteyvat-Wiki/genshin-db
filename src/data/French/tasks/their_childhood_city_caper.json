			"dialogs": [
				{
					"id": 240051101,
					"content": "Il est toujours aussi sérieux, ton frère ? Je ne l'ai jamais vu sourire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240051102
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240051102,
					"content": "Il n'était pas comme ça avant, c'est depuis qu'il a commencé à lire avec ton père. Maintenant, il fronce toujours les sourcils, et je ne sais pas ce qu'il pense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240051103
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240051103,
					"content": "Argh, ça ressemble beaucoup à mon père. Ma mère dit qu'il semble lutter contre quelque chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240051104
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240051104,
					"content": "Mais contre quoi ? S'est-il disputé avec ta mère ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240051105
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240051105,
					"content": "Non, ils ne se disputent jamais !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240051106
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240051106,
					"content": "Les adultes sont trop bizarres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verut"
				}
			]
		},
