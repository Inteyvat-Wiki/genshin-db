				"points": []
			},
			"dialogs": [
				{
					"id": 240050101,
					"content": "Allez, par ici ! On n'est pas encore passé devant cette grande maison, si ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050102
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050102,
					"content": "Ne va pas si vite, Verut, tu vas encore tomber. Fais attention aussi, Lovi. Ton père dit que tu as la santé fragile, tu risques d'attraper un rhume.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050103
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050103,
					"content": "Argh, ton frère est toujours sur notre dos, comme ma mère !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050104
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050104,
					"content": "Oui, tu as raison.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050105
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050105,
					"content": "Arrêtez, tous les deux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050106,
						240050107
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050106,
					"content": "On se retrouve !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050108
					]
				},
				{
					"id": 240050108,
					"content": "Bonjour ! On n'a pas joué à cache-cache cette fois-ci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050109
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050109,
					"content": "En fait, on vient d'y jouer... Et on s'est fait remonter les bretelles par mademoiselle Nour aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050110
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050110,
					"content": "Elle est toujours si sérieuse quand elle travaille. Elle est toujours sur le dos des gens. Je lui ai donné des biscuits pourtant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050111
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050111,
					"content": "Enfin, peu importe, on commençait à se lasser de toute façon. J'allais emmener Verut et Aurèle manger quelque chose de délicieux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050112
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050112,
					"content": "Vous voulez vous joindre à nous pour... Euh... Comment ça s'appelle encore ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050113
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050113,
					"content": "Une balade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050114
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050114,
					"content": "Voilà, pour une balade !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050115
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050115,
					"content": "Allons sur la place là-bas, je veux voir la fontaine !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050116,
						240050117
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050116,
					"content": "Très bien, je te suis, mademoiselle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050118
					]
				},
				{
					"id": 240050118,
					"content": "Super ! Commençons par la place là-bas. Les fontaines y sont vraiment magnifiques.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050117,
					"content": "Très bien, je vous suis.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050118
					]
				},
				{
					"id": 240050107,
					"content": "Qu'est-ce que vous faites ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050108
					]
				}
			]
		},
		{
