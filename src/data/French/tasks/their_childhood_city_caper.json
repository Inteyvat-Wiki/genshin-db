			"dialogs": [
				{
					"id": 240050601,
					"content": "Ça devrait suffire, merci. Ça ne devrait pas prendre longtemps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050602
					],
					"speakerTitle": "Louis"
				},
				{
					"id": 240050602,
					"content": "Louis commence à préparer la sauce...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240050603
					]
				},
				{
					"id": 240050603,
					"content": "Et voilà ! Comme je l'ai dit, ces délicieuses frites sorties tout droit du four sont offertes par la maison. Elles sont prêtes à être dégustées, mais attention, c'est chaud !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050604
					],
					"speakerTitle": "Louis"
				},
				{
					"id": 240050604,
					"content": "Servez-vous, elles sont délicieuses !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050605
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050605,
					"content": "Au fait, n'en parle pas à mon père, Aurèle, ou il va encore me faire la morale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050606
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050606,
					"content": "Haha. Ne t'en fais pas. Je ne pense de toute façon pas que monsieur Delerue s'intéresse aux frites.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050607
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050607,
					"content": "Euh... Et moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050608
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050608,
					"content": "Contente-toi de manger. Quant à ma part, vous pouvez vous la partager, je ne suis pas un grand fan de frites.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050609
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050609,
					"content": "Haha, dans ce cas, je ne vais pas me gêner ! Allez, servez-vous aussi, c'est grâce à vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050610
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050610,
					"content": "Au fait, je voudrais acheter du café pour monsieur Delerue quand on aura fini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050611
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050611,
					"content": "Hé, tu ne peux pas faire ça ! Ça fait longtemps que ma mère lui a interdit d'en boire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050612
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050612,
					"content": "Il tousse beaucoup à chaque fois qu'il en boit, il en perd même parfois la voix.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050613
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050613,
					"content": "Mon père dit que c'est pour le travail, mais quel genre de travail vous fait souffrir comme ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050614
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050614,
					"content": "... Est-ce là le prix à payer pour écrire une revue de presse exceptionnelle ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050615
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050615,
					"content": "Ce travail n'a vraiment pas l'air facile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aurèle"
				}
			]
		},
