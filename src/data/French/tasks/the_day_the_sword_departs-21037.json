			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210370301,
					"content": "Merci ! Ça fera l'affaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370302,
						210370305
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370302,
					"content": "Vous n'avez pas l'air très content.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370303
					]
				},
				{
					"id": 210370303,
					"content": "Ah oui ? Non, ce n'est rien, hahaha... Je ne veux pas vous embarrasser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370304
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370304,
					"content": "C'est juste que je suis encore un peu réticent à l'idée de quitter Liyue si soudainement. J'ai habité si longtemps ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370305,
					"content": "Quand allez-vous partir ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370306
					]
				},
				{
					"id": 210370306,
					"content": "Nous partirons quand nous aurons toutes nos provisions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370307
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370307,
					"content": "Ah, et cette aventurière qui m'avait accompagné au Gouffre fera partie du voyage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370308
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370308,
					"content": "Quand elle a appris que je partais pour Fontaine, elle m'a dit qu'elle était très intéressée par ce voyage et a donc décidé de venir avec nous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370309
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370309,
					"content": "Le marchand est ravi d'avoir une aventurière pour le protéger... Mais pour être tout à fait honnête, je ne suis pas très doué pour communiquer avec ce genre de personnes excessivement enthousiastes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370310
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370310,
					"content": "Je ne m'imaginais pas qu'un jour, je partirais si loin de mon pays...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
			]
		},
		{
			"id": 2103704,
			"completionStepIds": [],
