			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Que'er",
					"Zhiruo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210370401,
					"content": "Dis, Zhiruo... T—Tu ne penses pas qu'il fait exprès ? Ça se voit qu'il ne veut pas rester avec moi ! *sniff* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370402
					],
					"speakerTitle": "Que'er"
				},
				{
					"id": 210370402,
					"content": "Que'er, vous avez passé tant de temps ensemble, comment pourrait-il ne pas comprendre tes sentiments ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370403
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 210370403,
					"content": "S'il est décidé à quitter Liyue et à partir en voyage, c'est qu'il doit avoir ses raisons. Qu'y a-t-il de mal à voyager avec lui ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370404
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 210370404,
					"content": "Je ne veux pas partir de Liyue ! Pourquoi on ne peut pas rester ici, lui et moi ? Le Clan Guhua... Je me fiche du Clan Guhua !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370405
					],
					"speakerTitle": "Que'er"
				},
				{
					"id": 210370405,
					"content": "Dans ce cas, pourquoi ne lui répètes-tu pas ce que tu viens de dire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370406
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 210370406,
					"content": "J—Je... Il n'a que le Clan Guhua en tête... S—Si je lui dis tout ça, il va me détester...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370407
					],
					"speakerTitle": "Que'er"
				},
				{
					"id": 210370407,
					"content": "*soupir* Que'er...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiruo"
				}
			]
		},
