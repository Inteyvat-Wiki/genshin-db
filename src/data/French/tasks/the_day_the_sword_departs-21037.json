			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210370101,
					"content": "Liyue... J'ignore quand je reviendrai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370102
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370102,
					"content": "Que vous arrive-t-il ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370103
					]
				},
				{
					"id": 210370103,
					"content": "#Ah, c'est vous, {M#voyageur}{F#voyageuse}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370104
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370104,
					"content": "Eh bien, mon itinéraire pour me rendre à Fontaine est enfin fixé. Dans quelques jours, je partirai d'ici avec ce marchand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370105
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370105,
					"content": "Il lui reste des affaires à régler avant de partir. Je vais donc en profiter pour vérifier que j'ai bien tout préparé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370106,
						210370107
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370106,
					"content": "Vous ne comptez pas visiter le Karst Jueyun une dernière fois ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370108
					]
				},
				{
					"id": 210370108,
					"content": "Haha, j'ai peur de regretter ma décision si je fais ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370109
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370109,
					"content": "Je pense que je vais juste rester ici et observer un peu la ville une dernière fois. J'ai vécu si longtemps dans cet endroit... et j'ignore quand je reviendrai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370110
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370110,
					"content": "Au fait, Que'er... *soupir* Que'er n'a pas voulu m'accompagner en fin de compte. J'ai demandé à Zhiruo de prendre soin d'elle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370111
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370111,
					"content": "Je lui ai laissé une partie de mes économies. Elle est plus futée que moi, elle saura s'occuper d'elle-même sans aucun problème.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370112
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370112,
					"content": "... Peut-être qu'un jour, elle comprendra ma décision.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370113
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370113,
					"content": "#À propos, {M#voyageur}{F#voyageuse}, j'aimerais vous demander quelque chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370114
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370114,
					"content": "Pourriez-vous me rapporter un peu de terre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370115,
						210370116
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370115,
					"content": "Euh, pas de problème...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370117
					]
				},
				{
					"id": 210370117,
					"content": "Puisque je vais quitter mon pays natal, autant prendre avec moi le plus de souvenirs possibles, n'êtes-vous pas d'accord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370118
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370118,
					"content": "Si j'emporte une poignée de terre de Liyue, je pourrai au moins dire que je n'aurai pas perdu toutes mes attaches avec cet endroit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370119
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370119,
					"content": "Pourquoi ne pas le faire vous-même ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370120
					]
				},
				{
					"id": 210370120,
					"content": "Hahaha... Ne vous l'ai-je pas déjà dit ? Si je m'en vais faire un dernier tour, une myriade d'émotions surgiront dans mon esprit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370121
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370121,
					"content": "Et j'ai peur que le courage de quitter mon pays natal, qu'il m'a été si difficile à amasser, ne parte en fumée en un instant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370122
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370122,
					"content": "#Je compte donc sur vous pour me rapporter un peu de terre, {M#voyageur}{F#voyageuse}. J'ai marqué l'endroit sur votre carte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370123
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370123,
					"content": "Qu'est-ce que cet endroit a de si spécial ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370124
					]
				},
				{
					"id": 210370124,
					"content": "Ahem... Disons que... J'amenais souvent Que'er là-bas pour l'entraîner à l'épée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370125
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370125,
					"content": "#Bref ! Je compte sur vous pour me rapporter un peu de terre, {M#voyageur}{F#voyageuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370116,
					"content": "Qu'avez-vous l'intention de faire avec de la terre ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370117
					]
				},
				{
					"id": 210370107,
					"content": "Vous ne comptez pas aller faire un dernier tour ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370108
					]
				}
			]
		},
