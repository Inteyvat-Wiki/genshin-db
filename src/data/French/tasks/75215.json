			"trigger": {
				"objectNames": [
					"Kerih"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752150101,
					"content": "Alors ? Le camp d'entraînement vous intéresse ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150102
					],
					"speakerTitle": "Kerih"
				},
				{
					"id": 752150102,
					"content": "#Servez-vous des équipements comme vous le souhaitez, mais évitez de vous blesser. Après tout, vous êtes bien {M#maigrichon}{F#maigrichonne}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150103,
						752150104
					],
					"speakerTitle": "Kerih"
				},
				{
					"id": 752150103,
					"content": "Hé, je fais pas mal d'exercice physique au quotidien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752150105
					]
				},
				{
					"id": 752150105,
					"content": "Ah oui ? Avant de vous vanter comme ça, mesurez-vous d'abord à ce gros bloc à côté de vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150106
					],
					"speakerTitle": "Kerih"
				},
				{
					"id": 752150106,
					"content": "<color=#00E1FFFF>Attaquez</color> ou <color=#00E1FFFF>frappez-le</color> pour marquer des points selon votre force. Allez, je veux voir ce que vous avez dans le ventre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kerih"
				},
				{
					"id": 752150104,
					"content": "Sachez que je peux faire valser un Brutocollinus d'un seul coup de poing.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752150105
					]
				}
			]
		},
		{
			"id": 7521502,
			"completionStepIds": [
				7521502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7521502",
