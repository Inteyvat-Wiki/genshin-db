			},
			"dialogs": [
				{
					"id": 752150301,
					"content": "Ce n'est pas le plus difficile de trouver de nouveaux élèves. C'est plutôt la suite, lorsque beaucoup d'entre elles commencent à trouver des excuses pour prendre un jour de repos ou arrêtent tout simplement de venir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150302
					],
					"speakerTitle": "Kerih"
				},
				{
					"id": 752150302,
					"content": "L'entraîneur a trouvé toutes sortes d'idées pour qu'ils restent motivés, notamment le défi du bloc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150303
					],
					"speakerTitle": "Kerih"
				},
				{
					"id": 752150303,
					"content": "Mais certains essayent de faire un meilleur score en percutant le bloc, mais ils finissent blessés inutilement. Du coup, le nombre de gens qui esquivent l'entraînement n'a fait qu'augmenter...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kerih"
				}
			]
		},
