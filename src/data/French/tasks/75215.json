						],
						"stepId": 7521502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kerih"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752150201,
					"content": "Sérieusement ? Vous avez cassé un coin de ce bloc ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150202
					],
					"speakerTitle": "Kerih"
				},
				{
					"id": 752150202,
					"content": "Varesa est la dernière personne à l'avoir fait... Tout comme elle, on dirait que vous avez un don pour ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150203,
						752150204
					],
					"speakerTitle": "Kerih"
				},
				{
					"id": 752150203,
					"content": "Ce n'était pas si facile.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752150205
					]
				},
				{
					"id": 752150205,
					"content": "#Les apparences sont vraiment trompeuses. Vous savez, je vous aurais bien {M#engagé}{F#engagée} comme {M#entraîneur}{F#entraîneuse} ici, si vous le vouliez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150206
					],
					"speakerTitle": "Kerih"
				},
				{
					"id": 752150206,
					"content": "Ah oui. Goûtez à cette fruitée chargée. Nos élèves en raffolent. Apparemment, cette boisson peut stimuler les performances athlétiques.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kerih"
				},
				{
					"id": 752150204,
					"content": "Les doigts dans le nez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752150205
					]
				}
			]
		},
		{
			"id": 7521503,
