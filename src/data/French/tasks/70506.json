			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lisa",
					"Jean"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705060201,
					"content": "Ah, ce goût sucré est vraiment pas mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060202
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060202,
					"content": "Ce café est riche et intense, l'amertume est parfaite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060203
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 705060203,
					"content": "#Je suis {M#content}{F#contente} si vous l'êtes aussi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060204
					]
				},
				{
					"id": 705060204,
					"content": "... À vrai dire, je te comprends, Lisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060205
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 705060205,
					"content": "Oh ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060206
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060206,
					"content": "Ces derniers temps, j'ai souvent l'impression de ne pas en faire assez. Mon efficacité au travail et mes capacités à m'occuper de tout genre d'affaires sont des aspects sur lesquels je dois encore travailler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060207
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 705060207,
					"content": "Toute cette pression que j'ai sur les épaules a fini par t'affecter sans que je m'en rende compte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060208
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 705060208,
					"content": "Je crois que vous ne saisissez toujours pas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060209
					]
				},
				{
					"id": 705060209,
					"content": "Pardon ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060210
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 705060210,
					"content": "Tu vois, mon petit chou a tout de suite compris.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060211
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060211,
					"content": "Je te vois travailler si dur, alors j'ai voulu t'emmener boire un coup pour te changer les idées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060212
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060212,
					"content": "Mais tu continues de penser au travail à la taverne, et ça me frustre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060213
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060213,
					"content": "Quelqu'un qui est stressé en permanence comme toi s'écroulera de fatigue un jour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060214
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060214,
					"content": "Tout à fait.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060215
					]
				},
				{
					"id": 705060215,
					"content": "#C'est ce que tu penses aussi, {NICKNAME} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060216
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 705060216,
					"content": "Hum, en gros... Mon problème, c'est que je ne sais pas me reposer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060217
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 705060217,
					"content": "Comme les Liyuéens le disent si bien : « Il y a un équilibre à tout. »",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060218
					]
				},
				{
					"id": 705060218,
					"content": "Oui ! Travaillez quand il le faut, sans oublier de vous reposer. Vous avez toutes les deux besoin de bien plus de repos que vous ne le pensez !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705060219,
					"content": "C'est une façon intéressante de voir les choses...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060220
					]
				},
				{
					"id": 705060220,
					"content": "Pfft...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060221
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060221,
					"content": "J—Je comprends maintenant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060222
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 705060222,
					"content": "#Merci à {M#tous}{F#toutes}. Cette taverne n'est pas seulement un lieu où l'on vient consommer des boissons, il peut égayer l'esprit aussi. C'est pour cette raison que Kaeya et Lisa aiment venir ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060223
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 705060223,
					"content": "Oui, mais pas tout à fait. Le plus important dépend aussi de qui prépare nos boissons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060224
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060224,
					"content": "Tu as réussi à persuader Jean aujourd'hui, merci. Je suis impressionnée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060225,
						705060226
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060225,
					"content": "Je vous en prie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060227
					]
				},
				{
					"id": 705060227,
					"content": "Héhé, on se voit plus tard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060228
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060228,
					"content": "Je reviendrai me détendre ici quand j'en aurai l'occasion à l'avenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060229
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 705060229,
					"content": "Génial ! Prenez soin de vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705060226,
					"content": "#{M#Content}{F#Contente} d'avoir été utile.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060227
					]
				}
			]
		}
	]
}