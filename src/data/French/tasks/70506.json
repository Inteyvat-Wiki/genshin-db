			},
			"dialogs": [
				{
					"id": 705060101,
					"content": "Salut, mon petit chou. Quel plaisir de te voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060102
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060102,
					"content": "C'est plutôt particulier de se croiser dans ce genre d'endroit, mais comme Lisa, je suis contente de te voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060103
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 705060103,
					"content": "*soupir* Quoi que tu dises, une taverne est un lieu propice au divertissement et à la détente, Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060104
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060104,
					"content": "Tu sais, il m'en a fallu du temps pour persuader ce bourreau du travail à daigner se lever de son bureau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060105
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060105,
					"content": "Ça fait à peine quelques instants que nous sommes ici, mais l'inquiétude se lit déjà sur le visage de Jean...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060106
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060106,
					"content": "Lisa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060107
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 705060107,
					"content": "L'Ordre de Favonius est très occupé...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060108
					]
				},
				{
					"id": 705060108,
					"content": "C'est vrai. Jean se fait du souci pour tout le monde en tant que Grande Maîtresse suppléante !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705060109,
					"content": "Ceci dit... Comment les gens disent déjà ? « Puisqu'on est déjà là... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705060110,
					"content": "#Pourquoi ne pas demander à {NICKNAME} de vous préparer quelques boissons ? Ça vous changera les idées !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705060111,
					"content": "Voyez ça comme une façon de vous relaxer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060112
					]
				},
				{
					"id": 705060112,
					"content": "*soupir* Jean est vraiment la seule personne que je connaisse qui a besoin qu'on lui apprenne à se détendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060113
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060113,
					"content": "Mon petit chou, tu pourrais me préparer un poème d'amour ? Dans une tasse moyenne, et plus sucré que d'habitude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060114
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060114,
					"content": "Et toi, Jean ? Qu'est-ce qui te ferait plaisir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060115
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060115,
					"content": "Un café sera suffisant, dans une tasse moyenne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060116
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 705060116,
					"content": "Mais vous buvez toujours du café, Jean. Pourquoi ne pas essayer autre chose cette fois-ci ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705060117,
					"content": "C'est gentil de proposer, mais j'ai besoin de quelque chose pour me maintenir éveillée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060118
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 705060118,
					"content": "C'est noté. Je reviens tout de suite.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060119
					]
				},
				{
					"id": 705060119,
					"content": "Merci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				}
			]
		},
		{
			"id": 7050602,
			"completionStepIds": [
				7050604
