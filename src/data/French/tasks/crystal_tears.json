			"dialogs": [
				{
					"id": 3830401,
					"content": "Youpi ! Ça a marché !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3830402,
					"content": "Elle a l'air totalement différente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830403
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3830403,
					"content": "Ses pouvoirs Anémo ont été restaurés... On devrait pouvoir s'en servir à présent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830404
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3830404,
					"content": "#Merci infiniment, {NICKNAME} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830405
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3830405,
					"content": "Bien... Où devrions-nous invoquer Stormterror ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830406
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3830406,
					"content": "Pas dans l'enceinte de Mondstadt en tout cas, les dégâts seraient trop importants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830407
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3830407,
					"content": "Il y a aussi le Domaine de l'Aurore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830408
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3830408,
					"content": "Hé. Même si ça ne serait pas une si grande perte, je préfère autant qu'on ne le fasse pas là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830409
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3830409,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830410
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3830410,
					"content": "Le lieu idéal serait un endroit en hauteur ou au bord de la mer, là où le vent souffle. Il faut que mes paroles puissent être transportées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830411
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3830411,
					"content": "Ça ne marchera pas si l'air est trop sec ou s'il en manque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830412
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3830412,
					"content": "OK. Au bord de la mer ou en hauteur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3830413,
					"content": "Le meilleur endroit serait donc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830414,
						3830415,
						3830416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3830414,
					"content": "Une falaise ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3830418
					]
				},
				{
					"id": 3830418,
					"content": "Il y a des reliefs au sud de la plage à l'est du Lac Tombétoile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830419
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3830419,
					"content": "#Ah ! C'est la plage sur laquelle tu t'es {M#réveillé.}{F#réveillée.}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3830420,
					"content": "En grimpant en direction de la saillie de terrain, on atteint le lieu qu'on appelle <color=#00E1FFFF>Falaise Arrachétoile</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830421
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3830421,
					"content": "Barde... Le vent des océans et le vent des hauteurs – il me semble qu'on devrait trouver les deux là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830422
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3830422,
					"content": "Voyons voir... La Falaise Arrachétoile ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830423
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3830423,
					"content": "... Oui, l'endroit est parfait, en effet. Voilà de quoi mettre mes chants en valeur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830424
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3830424,
					"content": "Bien. On se prépare, et on se retrouve à la Falaise Arrachétoile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830425
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3830425,
					"content": "Ne soyez pas en retard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830426
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3830426,
					"content": "À vos ordres, chef !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3830427,
					"content": "Oh, hum... pardon. Je ne l'ai pas fait exprès.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				},
				{
					"id": 3830415,
					"content": "Une plage ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3830418
					]
				},
				{
					"id": 3830416,
					"content": "Dans le ciel ? Tu pourrais jouer de la lyre en planant dans les airs...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3830417
					]
				},
				{
					"id": 3830417,
					"content": "Même Amber n'aurait jamais une idée pareille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830418
					],
					"speakerTitle": "Jean"
				}
			]
		}
	]
