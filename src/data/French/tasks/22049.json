			"dialogs": [
				{
					"id": 220490301,
					"content": "#Ah, vous êtes {M#revenu}{F#revenue} ! Comment c'était ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490302,
						220490304
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490302,
					"content": "Les feux d'artifice étaient très beaux.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490303
					]
				},
				{
					"id": 220490303,
					"content": "Je suis content que vous les aimez, haha !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490306
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490306,
					"content": "Bon, je dois tenir la boutique. Nous avons beaucoup de clients récemment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490307
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490307,
					"content": "Pourquoi Yoimiya n'est pas encore revenue ? Je me demande ce qu'elle peut bien faire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490304,
					"content": "#Je suis {M#resté}{F#restée} sur ma faim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490305
					]
				},
				{
					"id": 220490305,
					"content": "Vous avez vraiment aimé ces feux d'artifice, n'est-ce pas ? Très bien, je vous en donnerai davantage la prochaine fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490306
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				}
			]
		}
