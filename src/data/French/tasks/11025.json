				"points": []
			},
			"dialogs": [
				{
					"id": 110240301,
					"content": "Je vais rester un instant ici. J'ai bien peur que ces instants de nostalgie ne seront que de moins en moins nombreux avec le temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240302,
						110240305,
						110240308
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240302,
					"content": "La Déesse du Sel... C'est moche.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110240303
					]
				},
				{
					"id": 110240303,
					"content": "Au temps de la Guerre des Archons, le bien et le mal étaient jugés d'après des critères différents d'aujourd'hui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240304
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240304,
					"content": "Bien sûr, celui que je suis maintenant aurait préféré qu'elle vive à une époque plus clémente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240305,
					"content": "Ces reliques ne risquent pas de renforcer Ortell ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110240306
					]
				},
				{
					"id": 110240306,
					"content": "Les pouvoirs contenus par la salière et le mètre ne représentent rien aux yeux d'Ortell.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240307
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240307,
					"content": "Si un jour, il se réveille à nouveau... Ah, je suis d'avis que même alors il sera vaincu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240308,
					"content": "Qu'allez-vous faire à présent ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110240309
					]
				},
				{
					"id": 110240309,
					"content": "Excellente question. J'aurais pu y répondre sans effort autrefois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240310
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240310,
					"content": "Mais aujourd'hui... Oui, je pense que je vais continuer comme consultant du Funérarium Wangsheng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240311
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240311,
					"content": "Mais si cette expérience vous a plu, pourquoi ne pas vous joindre à moi la prochaine fois que je pars... consigner l'histoire de Liyue ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				}
			]
		}
	]
}