				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220350204,
					"content": "Hum, on a causé pas mal de remous cette fois aussi. Amano et Andou feront en sorte que le voleur en ville apprenne la nouvelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350205
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350205,
					"content": "Combien de temps ça va nous prendre encore ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220350206
					]
				},
				{
					"id": 220350206,
					"content": "Pas trop longtemps. Dès que la présidente sera prête, nous pourrons conclure cette affaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350207
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350207,
					"content": "#Cette rémunération est pour vous, {M#voyageur}{F#voyageuse}. Merci pour votre aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350208
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350208,
					"content": "C'est le montant que la directrice a choisi elle-même. Ça devrait être assez pour ce que vous avez fait. Prenez-la. Nous aurons aussi peut-être besoin de votre aide plus tard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				}
			]
		},
