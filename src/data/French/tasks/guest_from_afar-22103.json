			"dialogs": [
				{
					"id": 221030201,
					"content": "C'est réglé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030202
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030202,
					"content": "Pas encore...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221030203
					]
				},
				{
					"id": 221030203,
					"content": "Réglez ça tant qu'il en est encore temps. Qui sait quand le jeune homme reviendra par ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030204
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030204,
					"content": "Nous serions obligés de fermer pendant un moment si les choses dégénèrent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				}
			]
		},
