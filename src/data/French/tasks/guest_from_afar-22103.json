			"dialogs": [
				{
					"id": 221030101,
					"content": "Quelle plaie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030102
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030102,
					"content": "Qu'est-ce qu'il se passe ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221030103
					]
				},
				{
					"id": 221030103,
					"content": "Oh ? Excusez-moi. L'auberge est en proie à l'agitation ces derniers temps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030104
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030104,
					"content": "Nos hôtes n'arrêtent pas de se faire attaquer par des monstres dans les environs. Certains n'osent plus revenir faire des affaires ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030105
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030105,
					"content": "Ça va finir par dégénérer si on laisse faire ces monstres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030106
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030106,
					"content": "#Je vois que vous êtes {M#un voyageur}{F#une voyageuse}. Ça vous dirait de vous en occuper pour nous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030107,
						221030108
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030107,
					"content": "Pourquoi pas !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221030109
					]
				},
				{
					"id": 221030109,
					"content": "Merci d'avoir accepté de m'aider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030113
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030113,
					"content": "C'est pourquoi je préfère que ça soit vous qui vous vous en chargiez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030108,
					"content": "Ces monstres sont-ils dangereux ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221030110
					]
				},
				{
					"id": 221030110,
					"content": "Pas vraiment, ils sont le cadet de mes soucis, honnêtement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030111
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030111,
					"content": "Je m'inquiète plutôt d'un certain jeune homme. Si jamais un monstre lui tombait dessus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030112
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030112,
					"content": "Disons qu'il assure sa défense d'une manière particulière et ne tient pas compte des dégâts qu'il provoque autour de lui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030113
					],
					"speakerTitle": "Verr Goldet"
				}
			]
		},
