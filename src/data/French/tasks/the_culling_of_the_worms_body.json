				"points": []
			},
			"dialogs": [
				{
					"id": 735150101,
					"content": "#Vous voilà, {M#aventurier}{F#aventurière}. On était sur le point de commencer l'installation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150102
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150102,
					"content": "Si tout se passe bien, on va pouvoir donner une bonne leçon à ce monstre aujourd'hui !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150103
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150103,
					"content": "Pendant le processus de charge, il se peut que des monstres tentent de nous déranger. Le moment venu, veillez sur la progression de la charge et sur l'état du canon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150104,
						735150105
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735150104,
					"content": "Je m'en occupe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150106
					]
				},
				{
					"id": 735150106,
					"content": "#Merci beaucoup, {M#aventurier}{F#aventurière}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150107
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735150107,
					"content": "Tenez, j'ai une idée ! Puisque vous vous êtes donné tant de mal pour notre canon anti-Wenut, l'honneur de le tester pour la première fois vous reviendra !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150108,
						735150110
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150108,
					"content": "Vous ne voulez pas le faire vous-même ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150109
					]
				},
				{
					"id": 735150109,
					"content": "Je me contenterai de regarder les tirs s'abattre au sol ! Et puis, si je laisse quelqu'un d'autre s'occuper de l'allumage, je pourrai admirer le tir du canon dans toute sa splendeur ! Que demander de plus ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150112
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150112,
					"content": "Tout ce que vous avez à faire est de protéger les chargeurs des monstres et d'attendre que l'énergie se remplisse. Guettez le moment où le Wenut révèle son point faible et tirez dessus à pleine puissance !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150113
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150113,
					"content": "Les dispositifs d'allumage et d'autocorrection se chargeront du reste !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150114
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150114,
					"content": "#Ça a l'air impressionnant. Moi aussi, j'ai envie de voir ça, {NICKNAME} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735150115,
					"content": "Très bien, je vais m'en charger.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150116
					]
				},
				{
					"id": 735150116,
					"content": "D'accord, alors on fait comme ça ! Laissez-moi vous expliquer comment ça fonctionne...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150110,
					"content": "Je ne sais pas comment le manipuler...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150111
					]
				},
				{
					"id": 735150111,
					"content": "Ne vous en faites pas ! Je l'ai conçu pour qu'il soit simple d'utilisation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150112
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150105,
					"content": "Pas de problème.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150106
					]
				}
			]
		}
	]
}