					}
				]
			},
			"dialogs": [
				{
					"id": 716664001,
					"content": "Je suis de retour ! Comment se passe le super entraînement éblouissant aux combats de scarabées d'Arataki ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664002
					],
					"speakerTitle": "Compétitrice suréquipée"
				},
				{
					"id": 716664002,
					"content": "Vous arrivez à pic, Yanfei !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716664003,
					"content": "Ma sauveuse ! Merci pour le permis ! Et pour le super panneau !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664004
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716664004,
					"content": "Attends, je connais ce regard... Vous voulez faire des combats de scarabées ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664005
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716664005,
					"content": "Je ne peux pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664006
					],
					"speakerTitle": "Compétitrice suréquipée"
				},
				{
					"id": 716664006,
					"content": "J'ai une bonne cliente qui fait beaucoup de commerce international. Bref, elle m'a couverte de cadeaux quand je l'ai aidée à gagner un gros procès, et j'ai reçu un scarabuto dans tout ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664007
					],
					"speakerTitle": "Compétitrice suréquipée"
				},
				{
					"id": 716664007,
					"content": "Je ne savais pas comment m'en occuper, alors j'ai demandé à grand-mère de le faire pour moi. Maintenant, il a l'air d'être devenu costaud...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664008
					],
					"speakerTitle": "Compétitrice suréquipée"
				},
				{
					"id": 716664008,
					"content": "Ça ne vous dérange pas si je me joins à la compétition ? Ou vous avez peur que je casse l'ambiance ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664009
					],
					"speakerTitle": "Compétitrice suréquipée"
				},
				{
					"id": 716664009,
					"content": "Nous ne devons pas refuser la demande de notre sauveuse, Roi oni. Malgré son manque d'expérience, son scarabuto est l'un des plus robustes et des plus impressionnants qu'il m'a été donné de voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664010
					],
					"speakerTitle": "Grand Maître Hanakado"
				},
				{
					"id": 716664010,
					"content": "Je vois !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664011
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716664011,
					"content": "#Bon, c'est l'heure d'envoyer le Bras droit du Roi oni et Titan cramoisi. Je sais que mon {M#ami}{F#amie} gardera son calme !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664012,
						716664013
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716664012,
					"content": "Tout à fait !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716664014
					]
				},
				{
					"id": 716664014,
					"content": "#Je joue contre {NICKNAME} ? D'accord !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664015
					],
					"speakerTitle": "Compétitrice suréquipée"
				},
				{
					"id": 716664015,
					"content": "Je ne connais pas encore bien ce jeu, alors je m'excuse d'avance si jamais je fais des erreurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Compétitrice suréquipée"
				},
				{
					"id": 716664013,
					"content": "Merci de ta confiance !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716664014
					]
				}
			]
		},
