			},
			"dialogs": [
				{
					"id": 716664101,
					"content": "Votre scarabuto est vraiment costaud, Yanfei ! Qu'est-ce que madame Ping lui a donné à manger ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716664102,
					"content": "Tu vois ? Le scarabuto de ta sauveuse ne doit pas être sous-estimé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664103
					],
					"speakerTitle": "Grand Maître Hanakado"
				},
				{
					"id": 716664103,
					"content": "Tout comme la dernière fois, quand mes subordonnés t'avaient donné du fil à retordre. L'épée la plus tranchante ne peut pas toucher sa cible si elle n'est pas maniée par un épéiste qui saura exploiter son potentiel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664104
					],
					"speakerTitle": "Grand Maître Hanakado"
				},
				{
					"id": 716664104,
					"content": "#Euh... B—Bien dit, Grand Maître... Hum, heureusement que mon {M#ami}{F#amie} a su garder la tête froide !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664105
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716664105,
					"content": "Je vois, je vois ! Je pense que je vais peut-être bien m'amuser avec ces combats de scarabées !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664106
					],
					"speakerTitle": "Compétitrice suréquipée"
				},
				{
					"id": 716664106,
					"content": "C'était vraiment cool ! Merci tout le monde ! Je vais rester pour continuer à jouer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Compétitrice suréquipée"
				}
			]
		},
