			"dialogs": [
				{
					"id": 710050501,
					"content": "Je vais y réfléchir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050502
					]
				},
				{
					"id": 710050502,
					"content": "Hum... Soit, comme vous voulez. Peut-être avez-vous une meilleur offre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050503
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050503,
					"content": "Mais je peux vous garantir que vous ne le regretterez pas si vous me cédez l'objet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050504
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050504,
					"content": "Réfléchissez. Si vous me le vendez aujourd'hui, vous ne croyez pas que je vous mettrai au courant d'affaires intéressantes plus tard ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050505
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050505,
					"content": "Et puis, j'ajouterai quelques bricoles à mon prix...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050506
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050506,
					"content": "Réfléchissez, et revenez-vite me voir si vous décidez de me vendre l'anneau !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bolai"
				}
			]
		},
