						"stepId": 7100534,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7100536",
							"2"
						],
						"stepId": 7100536,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Linlang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710050901,
					"content": "Je cherche quelqu'un pour examiner cette antiquité...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050902
					]
				},
				{
					"id": 710050902,
					"content": "Une antiquité ? Vous vous adressez à la bonne personne. Je dirais que je suis la plus exacte dans mes estimations à Liyue. Montre-moi donc ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050903
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050903,
					"content": "Oui... La pierre et la bague sont de qualité. L'objet a l'air d'être très ancien... et pourtant est très bien conservé. C'est plutôt rare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050904
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050904,
					"content": "Quant à l'inscription « Le monde n'est que souffrance », je dois reconnaître que ça ne me dit rien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050905
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050905,
					"content": "Où donc avez-vous trouvé cet objet ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050906
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050906,
					"content": "J'ai trouvé l'anneau vers la Pente Cuijue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050907
					]
				},
				{
					"id": 710050907,
					"content": "Les ruines vers la Pente Cuijue... Vous avez le courage d'aller là-bas ? Vous devez savoir vous débrouiller.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050908
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050908,
					"content": "Est-ce que vous avez vu neuf piliers avec en leur centre une tablette de pierre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050909
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050909,
					"content": "Pas la peine de prendre cet air étonné, vraiment. J'ai entendu beaucoup de gens venus faire affaire par ici mentionner le lieu. Beaucoup pensent qu'il abrite un trésor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050910
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050910,
					"content": "Certains disent même que les piliers et les ruines ont été érigés autrefois par les ancêtres des habitants de Liyue pour venir à bout d'un conflit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050911
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050911,
					"content": "Enfin, ce ne sont que des légendes. Après tout, si neuf piliers suffisaient à résoudre une guerre, ça se saurait et le monde serait en paix depuis bien longtemps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050912
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050912,
					"content": "Enfin, qu'il y ait du vrai ou non là-dedans, cet anneau a été trouvé là-bas, et doit avoir quelque chose à voir avec ce qu'on raconte j'imagine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050913
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050913,
					"content": "Il a un nom, une histoire, et est de bonne qualité qui plus est. Vous pouvez en tirer un bon prix.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050914
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050914,
					"content": "... Ne vous en faites pas, je ne vais pas vous demander comment vous avez fait pour entrer dans ces ruines. Je fais juste du commerce. Le reste ne m'intéresse pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050915
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050915,
					"content": "Je dirais que cet anneau vaut bien <color=#00E1FFFF>200 000 moras</color>. Qu'est-ce que vous en dites ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linlang"
				}
			]
		},
