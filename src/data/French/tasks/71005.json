					"nextDialogs": [
						710050402
					]
				},
				{
					"id": 710050402,
					"content": "Bravo ! Une décision rapide ! Tenez, voici la somme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050403
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050403,
					"content": "Ah, cet anneau est un véritable trésor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050404
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050404,
					"content": "Je suis sûr qu'il doit y avoir d'autres gemmes de ce type dans ces ruines...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bolai"
				}
			]
		},
		{
