			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710051201,
					"content": "« Cupidité, désir, envie, jalousie, colère, luxure, prétention, compétition, chaos... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710051202
					],
					"speakerTitle": "Inscription"
				},
				{
					"id": 710051202,
					"content": "« Ces neuf désirs mortels ont le pouvoir de soigner le monde comme de le détruire. Le feu qui les brûle jamais ne faiblit, ni ne faiblira. Que neuf piliers représentant les neuf désirs soient érigés pour défaire les conflits qui empoisonnent notre monde. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710051203
					],
					"speakerTitle": "Inscription"
				},
				{
					"id": 710051203,
					"content": "« Celui qui brise ces piliers et pénètre en ce lieu réveillera la guerre sur le monde. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710051204
					],
					"speakerTitle": "Inscription"
				},
				{
					"id": 710051204,
					"content": "« Toi qui lis ces lignes, va trouver le trésor gisant à l'intérieur, et amène la paix sur Liyue. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inscription"
				}
			]
		},
