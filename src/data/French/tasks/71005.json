			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bolai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710050301,
					"content": "Je cherche quelqu'un pour examiner cette antiquité...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050302
					]
				},
				{
					"id": 710050302,
					"content": "Oh, je n'y connais pas grand-chose sur le sujet. Mais ça ne coûte rien de jeter un œil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050303
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050303,
					"content": "Cet anneau... Incrusté de jade, à ce que je vois – et de bonne qualité en plus. Rien que ça doit valoir quelque chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050304
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050304,
					"content": "Il y a quelque chose gravé sur l'anneau... « Le monde n'est que souffrance. » Puis-je vous demander l'origine de cette bague ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050305
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050305,
					"content": "J'ai trouvé l'anneau vers la Pente Cuijue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050306
					]
				},
				{
					"id": 710050306,
					"content": "La Pente Cuijue, la Pente Cuijue... Tsss. Quel dommage, le Karst Jueyun est juste à côté...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050307
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050307,
					"content": "Si cet anneau était issu d'une ruine du Karst Jueyun, nul doute qu'il se vendrait un bon prix.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050308
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050308,
					"content": "Mais sans aucune histoire d'origine, il perd beaucoup de son prix. Ça reste un objet de bonne qualité, et quelqu'un sera sûrement intéressé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050309
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050309,
					"content": "Je vous en donne <color=#00E1FFFF>180 000 moras</color>, et je rajoute quelques bricoles. Qu'en dites-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bolai"
				}
			]
		},
