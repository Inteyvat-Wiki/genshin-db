						411260803
					]
				},
				{
					"id": 411260803,
					"content": "Une lettre de papa ? Je sais déjà ce qu'elle va dire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260804
					],
					"speakerTitle": "Petite Liu"
				},
				{
					"id": 411260804,
					"content": "Il ne pourra pas revenir au village à cause de son travail, c'est ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260805
					],
					"speakerTitle": "Petite Liu"
				},
				{
					"id": 411260805,
					"content": "J'avais espéré que papa serait avec les Millelithes qui sont venus au village...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260806
					],
					"speakerTitle": "Petite Liu"
				},
				{
					"id": 411260806,
					"content": "Mais ce n'est pas si mal, il aurait pu être en danger ici avec ces rochers géants qui tombent du ciel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260807,
						411260809
					],
					"speakerTitle": "Petite Liu"
				},
				{
					"id": 411260807,
					"content": "Tu n'as pas peur ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260808
					]
				},
				{
					"id": 411260808,
					"content": "Si, un peu... mais avec les Millelithes, nous ne craignons rien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260811
					],
					"speakerTitle": "Petite Liu"
				},
				{
					"id": 411260811,
					"content": "Tiens, tu pourrais donner cette lettre de réponse à mon papa ? Il doit sans doute s'inquiéter pour moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260812
					],
					"speakerTitle": "Petite Liu"
				},
				{
					"id": 411260812,
					"content": "*soupir* C'est étrange. Papa a toujours du travail urgent à chaque fois qu'il est censé me rendre visite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Petite Liu"
				},
				{
					"id": 411260809,
					"content": "Ne va pas t'aventurer toute seule dans la nature.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260810
					]
				},
				{
					"id": 411260810,
