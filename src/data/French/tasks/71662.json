			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Catherine"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716620101,
					"content": "#{M#Voyageur}{F#voyageuse}, tu tombes bien. J'ai une mission à te confier et rien qu'à toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620102,
						716620103
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 716620102,
					"content": "Encore une mission dangereuse ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620104
					]
				},
				{
					"id": 716620104,
					"content": "Cette mission concerne un donjon inconnu à ce jour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620105
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 716620105,
					"content": "La Guilde des aventuriers enquête dessus depuis très longtemps, mais nous n'avons toujours pas réussi à trouver d'informations pertinentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620106
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 716620106,
					"content": "Honglang, le responsable de cette enquête, a dit souhaiter trouver un aventurier qui sait vite s'adapter à toutes les situations pour l'aider...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620107
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 716620107,
					"content": "#Et c'est à toi que j'ai pensé en premier, {M#voyageur}{F#voyageuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620108
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 716620108,
					"content": "Qu'est-ce que c'est que ce donjon ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620109
					]
				},
				{
					"id": 716620109,
					"content": "Honglang t'attend à son entrée à l'instant où je te parle. Si tu acceptes de l'aider, tu peux aller le retrouver pour qu'il t'en fasse part de vive voix.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620110
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 716620110,
					"content": "#Je compte sur toi, {M#voyageur}{F#voyageuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Catherine"
				},
				{
					"id": 716620103,
					"content": "Encore une mission difficile ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620104
					]
				}
			]
		},
		{
			"id": 7166202,
			"completionStepIds": [
				7166202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7166202",
							"2"
						],
						"stepId": 7166202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Honglang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716620201,
					"content": "Qu'est-ce qu'il a ce donjon au juste ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620202
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620202,
					"content": "À propos de la mission...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620203
					]
				},
				{
					"id": 716620203,
					"content": "#Ah ? Vous... Attendez, c'est vous l'{M#aventurier}{F#aventurière} dont Catherine m'a parlé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620204
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620204,
					"content": "Elle m'a assuré que vous faisiez preuve d'une adaptabilité remarquable, que vous aviez été dans toutes sortes d'aventures, sans compter votre talent incontesté et...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620205,
						716620206
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620205,
					"content": "C'est exact.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620207
					]
				},
				{
					"id": 716620207,
					"content": "C'est génial ! Avec votre aide, je me sens tout de suite un peu plus rassuré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620208
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620208,
					"content": "Quel est le problème de ce donjon ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620209
					]
				},
				{
					"id": 716620209,
					"content": "Ah, j'ai failli oublier... Permettez-moi de vous expliquer la situation...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620210
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620210,
					"content": "Eh bien, une équipe d'aventuriers a découvert une grande porte étrange dans la nature... Nous nous tenons actuellement devant celle-ci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620211
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620211,
					"content": "En traversant cette porte, les aventuriers sont rentrés à l'intérieur d'un donjon inconnu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620212
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620212,
					"content": "Selon leurs dires, c'était comme s'ils avaient pénétré dans une « demeure vide ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620213,
						716620214
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620213,
					"content": "C'est-à-dire ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620215
					]
				},
				{
					"id": 716620215,
					"content": "#Ce que cette expression désigne plus exactement est un lieu de «{NON_BREAK_SPACE}cinquante-deux pas de long, cinquante-deux pas de large et de hauteur inconnue ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620216
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620216,
					"content": "Ce lieu se présentait avec un sol recouvert des dalles de pierre dans ce périmètre, mais une fumée grise recouvrait tout ce qui était au-delà des cinquante-deux pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620217
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620217,
					"content": "De plus, lorsque quelqu'un dépassait la limite des cinquante-deux pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620218
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620218,
					"content": "Il faisait mystérieusement demi-tour ou disparaissait soudainement pour réapparaître derrière les autres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620219
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620219,
					"content": "En bref, personne n'a jamais réussi à aller plus loin que cinquante-deux pas, peu importe les moyens employés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620220
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620220,
					"content": "Ils ont utilisé des outils dans leur exploration ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620221
					]
				},
				{
					"id": 716620221,
					"content": "Évidemment, mais les objets qu'ils jetaient revenaient à leur endroit d'origine. Même la lumière des torches disparaissait au-delà de cette distance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620222
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620222,
					"content": "En gros, vous souhaitez qu'on explore ce donjon pour vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716620223,
					"content": "Exactement, mais... ce ne sera pas une simple exploration.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620224
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620224,
					"content": "Vous aurez du mal à comprendre si l'on reste ici, venez à l'intérieur avec moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620214,
					"content": "Une demeure vide ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620215
					]
				},
				{
					"id": 716620206,
					"content": "Euh, plus ou moins.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620207
					]
				}
			]
		},
		{
			"id": 7166203,
			"completionStepIds": [
				7166204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7166204",
							"2"
						],
						"stepId": 7166204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Honglang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716620301,
					"content": "C'est...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716620302,
					"content": "C'est donc ici la « demeure vide » dont vous parliez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620303,
						716620304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716620303,
					"content": "Ça ressemble à n'importe quel donjon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620305
					]
				},
				{
					"id": 716620305,
					"content": "Mais oui ! C'est un donjon comme on en trouve lors de nos explorations de ruines, non ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716620306,
					"content": "C'est bien ce donjon que nous devons explorer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620307
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620307,
					"content": "Quant à la raison de son apparence actuelle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620308
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620308,
					"content": "Eh bien, c'est parce qu'il vient de se transformer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620309
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620309,
					"content": "Hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716620310,
					"content": "Il s'est « transformé » ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620311
					]
				},
				{
					"id": 716620311,
					"content": "Tout à fait. Ce donjon prend une forme différente selon les pensées d'une personne qui s'y trouve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620312
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620312,
					"content": "Le chef du groupe d'aventuriers qui a pénétré ici a déclaré qu'ils commençaient à perdre patience après avoir passé tellement de temps à tourner en rond.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620313
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620313,
					"content": "Et là, un membre du groupe se plaignit d'une voix discrète :",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620314
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620314,
					"content": "« Si ces ruines étaient ordinaires, on aurait déjà terminé de les explorer. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620315
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620315,
					"content": "Affamés et épuisés, les autres aventuriers lui donnèrent raison l'un après l'autre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620316
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620316,
					"content": "Comme de plus en plus d'aventuriers partageaient ce point de vue, le donjon s'est soudainement transformé en « ruines ordinaires ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620317
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620317,
					"content": "Ces ruines avaient des mécanismes, des chemins, des trésors et même des torches allumées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620318
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620318,
					"content": "Incapables de savoir comment procéder, les aventuriers sont retournés à la Guilde pour faire leur rapport.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620319
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620319,
					"content": "Nous avons donc rapidement déployé de la main-d'œuvre pour faire des recherches approfondies sur ce donjon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620320
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620320,
					"content": "Cependant, la seule chose qu'on ait découverte est qu'il change selon les pensées des gens qui y pénètrent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620321
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620321,
					"content": "Si plusieurs personnes y entrent, le donjon prendra l'apparence souhaitée par celle dont le désir est le plus fort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620322
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620322,
					"content": "Ouah ! L'intérieur pourrait donc ressembler au Port de Liyue si on le voulait ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716620323,
					"content": "Nous avons essayé de le matérialiser, mais en vain... Je crois que c'est parce que notre désir de transformer l'intérieur du donjon en Port de Liyue n'était pas assez intense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620324
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620324,
					"content": "En résumé, nous cherchons des aventuriers pour entrer dans ce donjon et leur demander de le transformer sans cesse selon leurs désirs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620325
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620325,
					"content": "Ainsi, nous pourrions peut-être découvrir les conditions qui amènent ce donjon à se transformer et obtenir les réponses que nous cherchons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620326,
						716620327
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620326,
					"content": "Comment faire ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620328
					]
				},
				{
					"id": 716620328,
					"content": "Vous voyez ce mécanisme là-bas ? C'est un déclencheur que nous avons installé, un aventurier en a eu l'idée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620329
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620329,
					"content": "Il a simplement formulé le vœu suivant : « J'aimerais que la capacité de transformation du donjon soit activée par un mécanisme. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620330
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620330,
					"content": "Le donjon lui a accordé ce vœu, mais nous avons dû le faire matérialiser plusieurs fois pour qu'il ne disparaisse pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620331
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620331,
					"content": "Pas bête comme idée...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620332
					]
				},
				{
					"id": 716620332,
					"content": "Sans de telles mesures préventives, le donjon changerait à chaque instant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620333
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620333,
					"content": "Ceci dit, d'une autre perspective, ce donjon est un endroit idéal pour entraîner les aventuriers. Après tout, il peut changer selon les envies de chacun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620334
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620334,
					"content": "Si ce n'est toujours pas clair pour vous, essayez par vous-même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620335
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620335,
					"content": "Vous voyez ce « jeton d'aventure » doré ? C'est un petit objet que nous avons réussi à faire apparaître par notre volonté.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620336
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620336,
					"content": "#{M#Voyageur}{F#Voyageuse}, essayez de vous en emparer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620327,
					"content": "Il faut faire quelque chose en particulier ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620328
					]
				},
				{
					"id": 716620304,
					"content": "J'ai une impression de déjà-vu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620305
					]
				}
			]
		},
