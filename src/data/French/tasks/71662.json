				{
					"id": 716620401,
					"content": "#Oh ! Vous êtes {M#arrivé}{F#arrivée} à comprendre comment vous servir de ce donjon très vite. C'est bien un exploit digne de vous.",
					"roleType": "TALK_ROLE_NPC",
