			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xudong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220140101,
					"content": "#{M#Voyageur}{F#Voyageuse}, comme on se revoit. Héhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140102,
						220140104
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140102,
					"content": "Vous avez besoin d'aide ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140103
					]
				},
				{
					"id": 220140103,
					"content": "Vous vous souvenez du repas que je vous ai promis la dernière fois ? Eh bien, je me prépare à le cuisiner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140106
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140106,
					"content": "Je suis capable d'aller chercher des ingrédients frais aux quatre coins de Teyvat si c'est pour cuisiner un bon plat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140107
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140107,
					"content": "La question des ingrédients est déjà réglée, alors je réfléchis désormais à une recette.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140108
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140108,
					"content": "Où sont passées Julie et Parvaneh ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140109
					]
				},
				{
					"id": 220140109,
					"content": "Parvaneh a dit qu'elle allait continuer de chercher des ingrédients pour son « assaisonnement suprême ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140110
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140110,
					"content": "Julie est partie avec elle dans les contrées sauvages... Elles m'ont dit qu'elles n'iraient pas bien loin, alors inutile de s'inquiéter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140111
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140111,
					"content": "À vrai dire, j'ai besoin de votre aide. Bien que j'aie rassemblé plusieurs ingrédients inazumiens frais, je ne sais pas vraiment quoi en faire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140112
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140112,
					"content": "On a donc de l'herbe marine, du ganoderma marin et, euh... de la fleur de cerisier...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140113
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140113,
					"content": "Ces ingrédients sont tous frais, mais je n'ai aucune idée de comment les préparer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140114
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140114,
					"content": "Au départ, je voulais consulter un chef inazumien. Mais le plat risquait de ressembler à n'importe quel plat qu'on peut trouver ici. Il me fallait de la nouveauté.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140115
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140115,
					"content": "C'est pourquoi j'ai envie de préparer un plat avec ces ingrédients d'Inazuma, mais à la façon d'un chef liyuéen. Peut-être que j'inventerai un nouveau plat de cette façon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140116
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140116,
					"content": "#Dites-moi, {M#voyageur}{F#voyageuse}. Pourriez-vous vous rendre à Liyue et demander conseil au chef Mao du Restaurant Wanmin de ma part ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140117,
						220140119
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140117,
					"content": "C'est comme si c'était fait.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140118
					]
				},
				{
					"id": 220140118,
					"content": "Merci. Je vous attendrai ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140124
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140124,
					"content": "J'espère qu'il aura de bonnes idées...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140119,
					"content": "Vous voulez un peu de peps dans votre plat ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140120
					]
				},
				{
					"id": 220140120,
					"content": "Du peps ? Qu'est-ce que c'est ? La surprise d'un plat incroyablement bon ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140121
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140121,
					"content": "S'il existe une recette capable de donner cette sensation, je suis preneur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140122
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140122,
					"content": "Mais je ne connais personne en mesure de l'inventer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140123
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140123,
					"content": "Bref, allez voir le chef Mao d'abord.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140124
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140104,
					"content": "Vous m'invitez à manger ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140105
					]
				},
				{
					"id": 220140105,
					"content": "Hahaha, c'est exact !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140106
					],
					"speakerTitle": "Xudong"
				}
			]
		},
		{
			"id": 2201402,
			"completionStepIds": [
				2201402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201402",
							"2"
						],
						"stepId": 2201402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chef Mao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220140201,
					"content": "#Oh, mais c'est {M#le voyageur}{F#la voyageuse} ! Qu'est-ce que je vous sers aujourd'hui ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140202
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140202,
					"content": "Je viens pour vous demander conseil...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140203
					]
				},
				{
					"id": 220140203,
					"content": "Alors comme ça, Xudong est parti à Inazuma pour perfectionner sa cuisine... Quelle persévérance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140204
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140204,
					"content": "Vous le connaissez ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140205
					]
				},
				{
					"id": 220140205,
					"content": "On va dire que oui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140206
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140206,
					"content": "Il a toujours dit qu'il fallait qu'il voyage partout dans le monde pour élever son art... Mais je ne pensais pas qu'il le ferait réellement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140207
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140207,
					"content": "On dirait bien qu'il lui arrive d'être dans des impasses aussi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140208,
						220140210
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140208,
					"content": "Vous savez comment résoudre son problème ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140209
					]
				},
				{
					"id": 220140209,
					"content": "Je ne garantis rien, mais je peux au moins essayer du mieux que je peux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140214
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140214,
					"content": "De l'herbe marine, du ganoderma marin et, euh... de la fleur de cerisier, c'est ça ? Ce sont vraiment des ingrédients étranges...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140215
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140215,
					"content": "Ma foi, on pourrait confectionner un plat avec l'herbe marine et le ganoderma... mais d'autres ingrédients sont quand même nécessaires pour compléter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140216
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140216,
					"content": "#{M#Voyageur}{F#Voyageuse}, pourriez-vous me ramener du piment de Jueyun et de la volaille ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140217,
						220140219
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140217,
					"content": "Aucun problème.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140218
					]
				},
				{
					"id": 220140218,
					"content": "Merci infiniment. Revenez me voir dès que vous les aurez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140219,
					"content": "Vous avez choisi des ingrédients assez classiques...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140220
					]
				},
				{
					"id": 220140220,
					"content": "Hahaha ! Bien évidemment, ce sont les ingrédients que je connais le mieux. Revenez me voir dès que vous les avez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140221
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140221,
					"content": "Je ne vois vraiment pas comment intégrer la fleur de cerisier dans le plat... Je me demande ce qu'un chef inazumien en ferait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140210,
					"content": "Peut-être que Xiangling aura une idée ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140211
					]
				},
				{
					"id": 220140211,
					"content": "Peut-être bien. Xiangling a toujours fait preuve d'une grande créativité dans sa cuisine après tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140212
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140212,
					"content": "Mais elle est partie ramasser des pousses de bambou au Village de Qingce. Vous mettrez du temps avant de pouvoir la rejoindre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140213
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140213,
					"content": "Xudong doit vouloir une réponse rapide, alors je vais m'y coller pour cette fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140214
					],
					"speakerTitle": "Chef Mao"
				}
			]
		},
		{
