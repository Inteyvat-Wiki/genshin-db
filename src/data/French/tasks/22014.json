			},
			"dialogs": [
				{
					"id": 220140601,
					"content": "Ces pousses de bambou ont l'air plutôt bien,",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140602
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140602,
					"content": "Oh, mais c'est toi ! Que fais-tu ici ? Qu'est-ce que je te sers aujourd'hui ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140603,
						220140604
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140603,
					"content": "J'aimerais te demander conseil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140607
					]
				},
				{
					"id": 220140607,
					"content": "... Cuisiner des ingrédients d'Inazuma façon Liyue ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140608
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140608,
					"content": "#Héhé, tu es {M#tombé}{F#tombée} sur la bonne personne ! Un jour, on m'a raconté qu'il existait une technique de cuisine à Inazuma qui consistait à faire frire des ingrédients dans une casserole après les avoir roulés dans de la farine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140609
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140609,
					"content": "Je crois que le plat qu'on obtient avec cette technique s'appelle « tempura ». Il faut le servir avec une sauce spéciale aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140610
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140610,
					"content": "La sauce dans laquelle on les trempe a éveillé ma curiosité la dernière fois que j'en ai fait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140615
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140615,
					"content": "Et il y a tellement d'ingrédients que j'ai essayés, comme le nectar de Fleur mensongère, la fleur enflammée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140611
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140611,
					"content": "Je parie qu'il y a de la bave de Blob dedans...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140612
					]
				},
				{
					"id": 220140612,
					"content": "Pas du tout ! La bave de Blob ne se marie pas bien avec ce genre de plat, voyons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140616
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140616,
					"content": "Je crois que je mettrais un peu de poudre d'aile d'Électroluciole pour donner une dimension gustative supplémentaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140613
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140613,
					"content": "Je suis sûre que vous ne vous en souvenez pas, alors je vais vous en faire. Et vous pourrez l'apporter à Xudong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140614
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140614,
					"content": "*soupir* Si seulement je pouvais aller à Inazuma. Il y a tellement de plats que je n'ai jamais encore goûtés...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140604,
					"content": "Tu parles vraiment comme le chef Mao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140605
					]
				},
				{
					"id": 220140605,
					"content": "#Tu as été au restaurant aussi ? Mais on dirait que tu n'y es pas {M#allé}{F#allée} pour manger...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140606
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140606,
					"content": "Est-ce que tu as un problème culinaire à résoudre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140607
					],
					"speakerTitle": "Xiangling"
				}
			]
