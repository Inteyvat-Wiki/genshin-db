			"trigger": {
				"objectNames": [
					"Chef Mao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220140401,
					"content": "La quantité devrait aller. Prenez votre mal en patience encore un petit peu, le temps que je réfléchisse à comment incorporer ces ingrédients...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140402
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140402,
					"content": "Et voilà. Hum, cela dit, je n'ai pas l'impression que ce plat change beaucoup de ce que je fais d'habitude...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140403
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140403,
					"content": "Apportez-le à Xudong. J'espère que cela l'aidera...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chef Mao"
				}
			]
		},
		{
			"id": 2201405,
