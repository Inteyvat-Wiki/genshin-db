				"points": []
			},
			"dialogs": [
				{
					"id": 722100101,
					"content": "Oh, miaou, miaou... Où est-ce qu'ils sont allés ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100102,
					"content": "Qu'est-ce qui se passe ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100103
					]
				},
				{
					"id": 722100103,
					"content": "Ah, c'est vous. Certains de mes petits amis se sont enfuis, et je ne sais pas où ils sont allés. Je suis vraiment inquiète...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100104,
					"content": "C'est dangereux de s'aventurer à l'extérieur. Je leur ai répété mille fois que ces créatures poilues avec des bâtons... et que ces boules de feu et d'eau, c'était dangereux pour eux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100105,
					"content": "S'ils marchent dans la zone qui fait des éclairs, leurs poils vont se hérisser. Je ne voudrais pas qu'une chose pareille leur arrive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100106
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100106,
					"content": "Mais il y en a toujours qui ne veulent rien entendre. Je dois me fatiguer à les ramener à chaque fois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100107
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100107,
					"content": "Il y en a encore qui se sont enfuis aujourd'hui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100108
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100108,
					"content": "Je vous en prie, aidez-moi à retrouver Konbumaru et Hachihou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100109
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100109,
					"content": "Qui est Konbumaru ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100110
					]
				},
				{
					"id": 722100110,
					"content": "C'est un gentil gamin. Le Konbumaru actuel est vraiment intelligent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100111
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100111,
					"content": "Actuel ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100112
					]
				},
				{
					"id": 722100112,
					"content": "Hibiki parlait de Konbumaru parfois. Je ne peux pas prétendre que je comprenais, mais vu l'expression qu'elle avait en en parlant, je dirais que c'est une bonne chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100113
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100113,
					"content": "Je nomme les petits en référence à de bonnes choses. Quand ils grandissent et finissent par me quitter, je redonne leurs noms à d'autres chatons que je recueille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100114
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100114,
					"content": "Konbumaru aime les endroits en hauteur. Vous devriez commencer vos recherches par là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100115
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100115,
					"content": "Et Hachihou...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100116
					]
				},
				{
					"id": 722100116,
					"content": "C'est un petit chat très agile qui raffole du poisson. À tel point qu'il va parfois au bord de la mer pour attraper les poissons échoués sur le rivage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100117
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100117,
					"content": "Mais c'est très dangereux. L'eau est une des choses les plus effrayantes qui soit... Il y a très, très longtemps, je crois qu'un Tanuki est tombé dedans et a failli ne jamais en sortir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100118
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100118,
					"content": "Vous trouverez probablement Hachihou près d'une étendue d'eau salée, en train de chercher du poisson ou du crabe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100119
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100119,
					"content": "Vos descriptions sont assez vagues...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100120
					]
				},
				{
					"id": 722100120,
					"content": "Vraiment ? Un endroit en hauteur et près d'une étendue d'eau salée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100121
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100121,
					"content": "Euh, pourquoi ne pas montrer notre carte à Neko...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722100122,
					"content": "Décidément, vous avez vraiment du mal à comprendre. Ici, c'est l'endroit élevé et là, l'étendue d'eau salée. Ils seront sûrement à ces endroits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100123,
						722100125
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100123,
					"content": "On va s'en occuper.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100124
					]
				},
				{
					"id": 722100124,
					"content": "Eh bien, je compte sur vous. Miaou miaou, quelle bande de petits coquins...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100125,
					"content": "#Je ne suis pas {M#doué}{F#douée} pour attraper les chats...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100126
					]
				},
				{
					"id": 722100126,
					"content": "Miaou miaou, ne vous en faites pas. Ces chatons ne sont pas craintifs... C'est justement parce qu'ils n'ont personne avec qui jouer qu'ils s'enfuient dans la nature.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100127
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100127,
					"content": "Eh bien, je compte sur vous. Miaou miaou, quelle bande de petits coquins...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
