				},
				{
					"id": 722100302,
					"content": "Ouah ! Ce chaton est plutôt féroce, fais attention...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100303,
						722100305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722100303,
					"content": "Miaou, miaou...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100304
					]
				},
				{
					"id": 722100304,
					"content": "Miaou miaou ? Miaou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100307
					],
					"speakerTitle": "Konbumaru"
				},
				{
					"id": 722100307,
					"content": "Il faisait le dur, mais il t'a quand même laissé le prendre, héhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722100305,
					"content": "#Je suis {M#venu}{F#venue} pour te ramener à la maison.",
					"roleType": "TALK_ROLE_PLAYER",
