			"dialogs": [
				{
					"id": 722100401,
					"content": "Vous les avez trouvés ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100402
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100402,
					"content": "Les voilà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100403
					]
				},
				{
					"id": 722100403,
					"content": "Vous deux ! Pourquoi vous n'êtes pas aussi sages que Meshi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100404
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100404,
					"content": "Meshi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100405
					]
				},
				{
					"id": 722100405,
					"content": "Hahaha, vous les nommez vraiment d'après de bonnes choses...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722100406,
					"content": "Miaou, miaou miaou miaou... miaou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100407
					],
					"speakerTitle": "Hachihou"
				},
				{
					"id": 722100407,
					"content": "Miaou ! Miaou miaou !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100408
					],
					"speakerTitle": "Konbumaru"
				},
				{
					"id": 722100408,
					"content": "Arrêtez de discuter ! Sinon je ne viendrais plus vous chercher et je... je vous laisserai crier famine du lever du soleil jusqu'au moment où il se couche et je vous laisserai retrouver le chemin du retour tous seuls.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100409
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100409,
					"content": "Miaou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100410
					],
					"speakerTitle": "Konbumaru"
				},
				{
					"id": 722100410,
					"content": "C'est bien, mon petit. L'essentiel, c'est que tu sois rentré sain et sauf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100411
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100411,
					"content": "Merci, je vous dois beaucoup. Sans vous, ces petits seraient morts de faim dans la nature.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100412
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100412,
					"content": "Je pense qu'ils seraient rentrés d'eux-mêmes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100413
					]
				},
				{
					"id": 722100413,
					"content": "Quoi qu'il en soit, vous avez toute ma reconnaissance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100414
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100414,
					"content": "Revenez nous rendre visite si vous avez le temps. Je pourrais avoir besoin de votre aide à nouveau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
