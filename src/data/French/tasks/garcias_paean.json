			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lutong",
					"Garcia",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710980101,
					"content": "Monsieur, il convient de mentionner que nous avons mangé de la soupe de radis pendant six jours d'affilée, y compris aujourd'hui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980102
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980102,
					"content": "Malgré notre situation financière fort inconvenante, nous ne devrions pas faire l'impasse sur nos problèmes de digestion...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980103
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980103,
					"content": "Vous avez raison, mon cher Lutong ! Toujours aussi perspicace !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980104
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980104,
					"content": "Ces problèmes de digestion nous ont sans doute empêchés de savourer ce plat à sa juste valeur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980105
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980105,
					"content": "Il nous faut quelqu'un d'autre pour nous servir de témoin ! Une tierce partie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980106
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980106,
					"content": "Vous me flattez, mais je voulais dire que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980107,
						710980108
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980107,
					"content": "Que faites-vous tous les deux ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980109
					]
				},
				{
					"id": 710980109,
					"content": "#Voilà, nous les avons {M#trouvés}{F#trouvées} ! Génial !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980110
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980110,
					"content": "Euh, pardon ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980111,
					"content": "Nous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980112
					]
				},
				{
					"id": 710980112,
					"content": "C'est exact ! Avez-vous déjà goûté à la soupe de radis ? Connaissez-vous son goût et sa recette ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980113
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980113,
					"content": "Monsieur, il conviendrait mieux de leur expliquer les tenants et les aboutissants de notre démarche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980114
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980114,
					"content": "#Bien sûr que ça nous connaît ! {NICKNAME} sait en cuisiner !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980115,
					"content": "Paimon, on ferait mieux d'éviter de se précipiter...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980116
					]
				},
				{
					"id": 710980116,
					"content": "Permettez-moi d'expliquer cette mission... J'espère que vous l'accepterez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980117
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980117,
					"content": "Je suis Lutong et voici mon employeur, monsieur Garcia, de Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980118
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980118,
					"content": "Il est en train de concevoir une machine qui s'appelle... l'Arithmétrice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980119
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980119,
					"content": "Concrètement, c'est un outil qui permettrait à ses utilisateurs d'effectuer des calculs arithmétiques. Est-ce correct, monsieur ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980120
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980120,
					"content": "Tout à fait, mon cher Lutong. Vous avez bien résumé les fonctionnalités de l'Arithmétrice avec concision.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980121
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980121,
					"content": "Concision... Nous devons être concis. Le transformateur est encore trop complexe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980122
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980122,
					"content": "Mais quel est le rapport avec la soupe de radis ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980123,
					"content": "Je pense que vous êtes le plus à même de répondre à cette question, monsieur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980124
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980124,
					"content": "Comment devrais-je le simplifier... Oh ! Oui, bien évidemment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980125
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980125,
					"content": "#Hmm... Commençons par les choses simples, savez-vous ce qu'est une «{NON_BREAK_SPACE}formule » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980126
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980126,
					"content": "Pas vraiment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980127,
					"content": "Je ne vois pas non plus...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980128
					]
				},
				{
					"id": 710980128,
					"content": "D'accord, ce n'est pas grave. Vous voyez, une formule est... Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980129
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980129,
					"content": "C'est une équation utilisée pour exprimer le rapport entre plusieurs quantités et qui peut être appliquée à certaines situations...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980130
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980130,
					"content": "Hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980131,
					"content": "C'est impressionnant...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980132
					]
				},
				{
					"id": 710980132,
					"content": "En gros, nous aimerions élaborer une formule pour la soupe de radis grâce à l'Arithmétrice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980133
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980133,
					"content": "Monsieur Garcia pense qu'avec la bonne formule, nous pourrions convertir la recette de la soupe de radis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980134
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980134,
					"content": "... En une sorte de « procédure standard ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980135
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980135,
					"content": "... En une sorte de « procédure pour les nuls ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980136
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980136,
					"content": "Si cette procédure est suivie à la lettre, quiconque pourra obtenir une délicieuse soupe de radis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980137
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980137,
					"content": "Votre méthode a l'air compliquée... Il ne suffirait pas de demander à quelqu'un de vous montrer comment faire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980138,
					"content": "Cependant, le résultat obtenu dépend du talent de chacun dans ce cas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980139
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980139,
					"content": "Monsieur Garcia et moi-même n'avons aucune prédisposition culinaire. Il est peu probable que nous puissions accomplir cet exploit, même en suivant les cours d'un chef.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980140
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980140,
					"content": "Je pense que monsieur Yanxiao qui travaille à cette auberge est la personne la plus experte en ce qui concerne cette question...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980141,
						710980143
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980141,
					"content": "Vous voulez qu'on vous aide à trouver cette formule ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980142
					]
				},
				{
					"id": 710980142,
					"content": "Évidemment que non, je n'oserais jamais vous en demander autant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980145
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980145,
					"content": "#Nous souhaiterions plutôt vous demander d'être une « tierce partie impartiale{NON_BREAK_SPACE}».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980146
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980146,
					"content": "Pour faire simple, vous n'aurez qu'à goûter la soupe de radis que monsieur Garcia cuisine selon la formule et donner vos impressions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980147
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980147,
					"content": "#En gros, on doit servir de {M#goûteurs}{F#goûteuses} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980148
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980148,
					"content": "Tu simplifies un peu trop la chose...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980149
					]
				},
				{
					"id": 710980149,
					"content": "Ça ira, ne t'inquiète pas ! Je n'ai jamais mangé de soupe de radis préparée selon une formule, j'ai envie d'y goûter !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980150
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980150,
					"content": "Parfait. Rendons-nous en cuisine, monsieur Yanxiao nous la prête gentiment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980151
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980151,
					"content": "Monsieur Garcia ? Devrions-nous procéder de la même manière qu'auparavant pour cette expérience ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980152
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980152,
					"content": "Hmm ? Oh, mes excuses. J'étais distrait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980153
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980153,
					"content": "C'est le bazar dans ma tête, trop de paramètres à prendre en considération... Mais oui, recommençons avec notre procédure en trois étapes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980143,
					"content": "Vous voulez qu'on vous apprenne à cuisiner ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980144
					]
				},
				{
					"id": 710980144,
					"content": "Hum, pas vraiment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980145
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980108,
					"content": "Si vous vous interrogez sur la recette de la soupe de radis...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980109
					]
				}
			]
		},
		{
			"id": 7109803,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7109804",
							"3"
						],
						"stepId": 7109804,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yanxiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710980301,
					"content": "Ça existe vraiment des gens qui n'arrivent pas à faire de la soupe de radis ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980302
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 710980302,
					"content": "Et comment je suis censé savoir la quantité exacte des ingrédients que je mets dans mes plats ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980303
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 710980303,
					"content": "C'est avec l'intuition qu'on cuisine, non ? Aucun chef ne s'embête avec ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980304
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 710980304,
					"content": "S'ils ne m'avaient pas payé autant, ça fait belle lurette que j'aurais été me plaindre à la patronne...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980305
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 710980305,
