	"talks": [
		{
			"id": 7109801,
			"completionStepIds": [
				7109803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7109803",
							"2"
						],
						"stepId": 7109803,
						"stateName": "QUEST_STATE_UNFINISHED"
