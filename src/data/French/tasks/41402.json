			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Jitong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414020201,
					"content": "#{M#Voyageur}{F#Voyageuse}, attendez une seconde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020202
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020202,
					"content": "Qu'est-ce qu'il y a ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020203
					]
				},
				{
					"id": 414020203,
					"content": "#Je sais que c'est un peu soudain, mais... Êtes-vous {M#intéressé}{F#intéressée} par les Daguerréotypes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020204,
						414020205
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020204,
					"content": "Un petit peu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020206
					]
				},
				{
					"id": 414020206,
					"content": "Ce type de Daguerréotype est un modèle spécial ! En direct des laboratoires de Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020207
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020207,
					"content": "Les clichés qui en sortent ont des couleurs que ne proposent pas les Daguerréotypes classiques.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020208,
						414020209
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020208,
					"content": "Comment ça...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020210
					]
				},
				{
					"id": 414020210,
					"content": "Hé ! Pourquoi cet air sceptique ? Si vous ne me croyez pas, allez demander à la Guilde des aventuriers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020211
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020211,
					"content": "Moi non plus, je n'y croyais pas... J'ai trafiqué cet appareil des journées sans arriver à le faire fonctionner ! C'est un aventurier de la Guilde qui a fini par me donner un coup de main.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020212
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020212,
					"content": "Vous voyez, une subtile différence de conception sépare ce Daguerréotype des modèles de base.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020213
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020213,
					"content": "Il faut ajouter une espèce de fluide, c'est ça qui donne aux clichés certains effets spéciaux. Ça les rend bien meilleurs que ceux des Daguerréotypes lambdas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020214
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020214,
					"content": "#Alors ? Si vous êtes {M#intéressé}{F#intéressée}, vous pouvez déjà essayer celui-ci. Même si les fluides sont plutôt limités, c'est suffisant pour voir de quoi il retourne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020215
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020215,
					"content": "Je prévois d'aller à Fontaine pour acheter d'autres fluides par la suite, donc n'hésitez pas à repasser de temps en temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020216,
						414020217
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020216,
					"content": "Eh bien... Merci...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020219
					]
				},
				{
					"id": 414020219,
					"content": "Et ce Daguerréotype, vous n'avez qu'à le garder. Si ça vous plaît, n'hésitez pas à revenir me voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020217,
					"content": "Combien coûtent ces fluides ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020218
					]
				},
				{
					"id": 414020218,
					"content": "Oh... Ahem, ne vous inquiétez pas pour ça. Ils sont déjà bon marché à l'unité, alors si vous voulez en acheter une grande quantité, vous pourrez bénéficier d'une belle réduction...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020219
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020209,
					"content": "C'est vrai ou...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020210
					]
				},
				{
					"id": 414020205,
					"content": "Pas vraiment, en fait...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020206
					]
				}
			]
		},
		{
			"id": 4140203,
			"completionStepIds": [
				4140203
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4140203",
							"2"
						],
						"stepId": 4140203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jitong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414020301,
					"content": "Bon, je vous offre ce Daguerréotype. Prenez en soin !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020302,
						414020303
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020302,
					"content": "... Vous me le donnez ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020304
					]
				},
				{
					"id": 414020304,
					"content": "Ces fluides vous tiendront déjà pendant un moment. Si vous êtes à court... Vous n'avez qu'à venir m'en acheter, vous voyez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020305
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020305,
					"content": "Et puis, je compte parler au marchand à l'occasion pour importer encore plus de fluides différents.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020306
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020306,
					"content": "Si ça vous intéresse, n'hésitez pas à revenir me voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020307
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020307,
					"content": "Eh bien, je ne m'attendais pas à ce que l'achat de ce Daguerréotype se transforme en une si bonne affaire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020303,
					"content": "Que se passe-t-il quand il n'y a plus de fluide ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020304
					]
				}
			]
		}
	]
}