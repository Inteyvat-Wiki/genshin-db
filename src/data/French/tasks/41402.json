			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Jitong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414020101,
					"content": "Oh, c'est vous ! Juste la personne à qui je voulais parler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020102,
						414020103
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020102,
					"content": "Qu'est-ce qu'il y a ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020104
					]
				},
				{
					"id": 414020104,
					"content": "Non, pas besoin ! J'ai enfin le fin mot de l'histoire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020105
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020105,
					"content": "J'ai retrouvé le marchand qui me l'avait vendu, l'autre jour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020106
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020106,
					"content": "Je lui ai dit qu'il y avait un problème avec l'appareil, mais impossible de lui faire entendre quoi que ce soit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020107
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020107,
					"content": "Heureusement que j'avais les clichés que vous avez pris, sinon, je ne serais pas arrivé à lui faire entendre raison.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020108
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020108,
					"content": "Après les avoir examinés, il a finalement accepté de jeter un œil à la cargaison de Daguerréotypes qu'il m'avait vendue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020109
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020109,
					"content": "Et puis hier, le voilà qui revient me donner une bouteille avec une sorte de fluide bizarre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020110
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020110,
					"content": "Il m'a expliqué que ce type de Daguerréotype fonctionnait différemment des modèles de base. Il faut y ajouter un peu de ce fluide pour que les clichés sortent normalement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020111
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020111,
					"content": "Sinon, les clichés sortent comme ceux que vous avez pris l'autre fois... Des grosses taches de couleur et rien de net...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020112,
						414020113
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020112,
					"content": "Tant que l'appareil n'est pas cassé...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020114
					]
				},
				{
					"id": 414020114,
					"content": "Eh bien, pour être honnête, c'est ce fluide qui m'intrigue plus que la machine maintenant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020115
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020115,
					"content": "Pensez-y... La plupart des gens n'achètent qu'un Daguerréotype, non ? Une fois acheté, on peut s'en servir tout le temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020116
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020116,
					"content": "Mais ce fluide s'épuise ! Quand on n'en a plus, obligé d'en racheter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020117
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020117,
					"content": "Et puis, selon ce marchand, différents fluides peuvent produire différents effets sur les clichés. Il fait des recherches pour en développer davantage...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020118
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020118,
					"content": "Ces fluides... Peut-être que c'est là qu'il y a des moras à se faire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020119
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020119,
					"content": "Ah, pardon ! Je parle tout seul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020120
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020120,
					"content": "Merci pour votre aide ! Passez-moi donc ce Daguerréotype que j'ajoute un peu de fluide...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020113,
					"content": "Alors... Problème résolu ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020114
					]
				},
				{
					"id": 414020103,
					"content": "Vous avez encore besoin de photographier des couleurs ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020104
					]
				}
			]
		},
		{
			"id": 4140202,
