			"dialogs": [
				{
					"id": 220400101,
					"content": "On ne peut pas continuer comme ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400102
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400102,
					"content": "Qu'est-ce qu'il y a ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220400103
					]
				},
				{
					"id": 220400103,
					"content": "Je suis désolée. Je me suis perdue dans mes pensées. Vous êtes ici pour du prêt-à-porter ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400104
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400104,
					"content": "Bien que la soie liyuéenne de haute qualité soit toujours en rupture, il nous faut quand même proposer de nouveaux kimonos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400105
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400105,
					"content": "Vous aviez l'habitude d'acheter la matière première à Liyue ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220400106
					]
				},
				{
					"id": 220400106,
					"content": "Oui, nous avons toujours pu nous procurer de la soie liyuéenne de haute qualité, comme de la soie de fleur de soie fabriquée par la Guilde des marchands de Feiyun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400107
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400107,
					"content": "Cependant, étant donné la situation actuelle à Inazuma... nous n'avons pas été en mesure d'en importer depuis un moment. On a dû compter sur notre stock restant pour continuer de faire tourner la boutique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400108
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400108,
					"content": "Mais la soie s'utilise rapidement, alors notre stock s'amenuise...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400109
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400109,
					"content": "Au départ, je voulais concevoir des motifs originaux ou utiliser des teintures novatrices et créer de nouveaux tissus pour attirer la clientèle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400110
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400110,
					"content": "Mais je n'ai pas d'idées de motifs originaux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400111
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400111,
					"content": "#{M#Voyageur}{F#Voyageuse}, vous qui avez vu des choses, avez-vous des suggestions de motifs originaux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400112
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400112,
					"content": "Je ne crois pas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220400113
					]
				},
				{
					"id": 220400113,
					"content": "Oh, je vois. Je ne voudrais pas vous déranger, mais pourriez-vous demander l'opinion d'autres étrangers sur la question ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400114
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400114,
					"content": "Je suis seule dans la boutique pour l'instant, alors je ne peux pas la laisser sans surveillance. Je ne peux que compter sur les autres pour ce genre de tâches.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400115
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400115,
					"content": "Je m'en charge.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220400116
					]
				},
				{
					"id": 220400116,
					"content": "Génial. Voyons... Allez demander l'avis de mademoiselle Tang Wen et de monsieur Ramsay. Ils auront peut-être des nouvelles idées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ogura Mio"
				}
			]
		},
