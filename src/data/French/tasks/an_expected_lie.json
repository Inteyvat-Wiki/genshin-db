			"dialogs": [
				{
					"id": 741360401,
					"content": "Il s'avère qu'il répétait « cinq » pour nous donner un indice pour résoudre l'énigme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741360402,
					"content": "Pourquoi a-t-il eu recours à une approche aussi compliquée alors qu'il aurait pu tout simplement nous le dire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741360403,
					"content": "Hmph, qui sait ce que ce type mijote... Mais il a l'air d'avoir essayé de nous mener à Nacker.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360404
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360404,
					"content": "Les combinaisons de plongée se trouvaient juste à côté de cette maison. C'est presque comme si elles avaient été préparées spécialement pour nous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360405,
						741360406
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360405,
					"content": "On dirait que c'est lui qui nous a trouvés d'abord.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360407
					]
				},
				{
					"id": 741360407,
					"content": "Aucune valeur pour la recherche... Mais j'ai... J'y ai consacré tant d'efforts...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360408
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741360408,
					"content": "Mademoiselle Fusilier... Elle n'a pas arrêté de marmonner depuis tout à l'heure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741360409,
					"content": "#Mais... {NICKNAME}, as-tu l'impression d'être {M#observé}{F#observée} ? Je... J'ai toujours l'impression que quelqu'un nous regarde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741360410,
					"content": "... Je vais marcher devant, continuons à regarder l'intérieur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360406,
					"content": "Quoi qu'il en soit, occupons-nous d'abord de Nacker.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360407
					]
				}
			]
		},
