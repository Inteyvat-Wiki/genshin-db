			"dialogs": [
				{
					"id": 741361001,
					"content": "Edwin... Je le savais ! C'est vous qui les avez guidés ici... Vous êtes jaloux de moi ! Vous avez peur que mes recherches surpassent les vôtres !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361002
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741361002,
					"content": "Oui, je suis tellement jaloux de votre ignorance et de votre inconscience. Pas étonnant que vous meniez la belle vie à l'Institut avant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361003
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361003,
					"content": "Si Choiseul voyait cette scène, il s'évanouirait sûrement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361004,
						741361005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741361004,
					"content": "Mieux vaut qu'il ne se réveille jamais.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361006
					]
				},
				{
					"id": 741361006,
					"content": "Rentrez à l'Institut avec eux et reconnaissez votre erreur, je retourne à mes recherches... J'espère que vous n'avez pas cassé mon matériel ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361007,
						741361008
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361007,
					"content": "Qui vous a permis de reprendre vos recherches ?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361009
					]
				},
				{
					"id": 741361009,
					"content": "Qu'allez-vous faire ? Me ramener à l'Institut ? Comment puis-je mener des recherches dans ce cas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361010
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361010,
					"content": "Cet imbécile de Raimondo a dû mettre la pagaille là-bas, et il y a aussi cet idiot de Choiseul... Ah, j'ai mal à la tête rien que d'y penser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361011
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361011,
					"content": "C'est vous qui avez mis l'Institut sens dessus dessous ! N'accusez pas les autres !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741361012,
					"content": "Moi ? Je vois, maintenant l'Institut m'a imputé toute la responsabilité de l'explosion du Laboratoire central, n'est-ce pas ? Je n'étais même pas à l'Institut à ce moment-là !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361013
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361013,
					"content": "Il y a tellement d'idiots à l'Institut qu'il suffit de verser une tasse de café pour casser l'équipement et provoquer une explosion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361014
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361014,
					"content": "Alors pourquoi vous ne leur avez pas expliqué ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361015
					]
				},
				{
					"id": 741361015,
					"content": "Expliquer ? Je ne vais pas leur servir de bouc émissaire. J'ai beaucoup de recherches à faire et je n'ai pas de temps à perdre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361016
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361016,
					"content": "Du coup, vous avez décidé de travailler avec Concini ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361017
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741361017,
					"content": "Concini n'est pas mieux... Il n'arrive même pas à mettre la main sur un appareil de précision, je dois tout fabriquer moi-même. Heureusement, il est prêt à tout payer, alors mes recherches avancent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361018
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361018,
					"content": "Mais à ma grande surprise, ce cher Nacker est arrivé avec ce prototype de noyau qui n'était même pas entièrement fonctionnel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361019
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361019,
					"content": "Je l'ai déjà modifié ! J'ai utilisé une technologie que vous n'auriez jamais pu développer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361020
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741361020,
					"content": "Haha ! Monsieur Nacker, Concini étant absent, vous pouvez arrêter de vous mentir à vous-même. Vous n'avez pas de dignité en tant que chercheur ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361021
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361021,
					"content": "Vous...! Ce n'est pas entièrement fonctionnel simplement parce que vous ne savez pas les réparer ! Mais moi, je sais et je peux le faire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361022
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741361022,
					"content": "Dans ce cas, prenez ce tas de ferraille et retournez à l'Institut pour gagner une bouchée de pain, j'ai d'autres chats à fouetter. Et vous, Fusi... Je ne me souviens plus de votre nom... Je vous laisse vous en occuper.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361023
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361023,
					"content": "Pourquoi ces deux-là se chamaillent sans cesse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361024
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741361024,
					"content": "... Ça suffit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361025
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361025,
					"content": "Qu'est-ce que vous faites ? Arrêtez de me faire perdre mon temps ! Je dois me remettre au travail !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361026
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361026,
					"content": "J'ai dit... Ça suffit !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361027
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361027,
					"content": "Edwin Eastinghouse ! Vous, vous êtes le coupable de l'explosion de l'Institut !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361028
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361028,
					"content": "Nacker ! Vous, vous avez volé des ressources de l'Institut !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361029
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361029,
					"content": "Et vous avez fait exploser l'Institut à nouveau.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361030
					]
				},
				{
					"id": 741361030,
					"content": "Vous avez tous les deux compromis les intérêts de l'Institut de recherche de Fontaine... En tant qu'enquêtrice spéciale, je vous ramènerai tous à l'Institut en attendant qu'une décision soit prise à votre égard !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361031
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361031,
					"content": "Zut...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361032
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741361032,
					"content": "Oh, s'il vous plaît...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361033
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361033,
					"content": "Lemarcq et moi allons escorter ces deux personnes. Après avoir travaillé dur pendant si longtemps... L'Institut devrait nous récompenser, pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361034
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741361034,
					"content": "N'oubliez pas de garder le silence pendant le trajet. Votre vie pourrait prendre fin plus tôt que prévu sinon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741361008,
					"content": "Stop, ne bougez plus !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361009
					]
				},
				{
					"id": 741361005,
					"content": "Moi aussi, je suis sur le point de m'évanouir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361006
					]
				}
			]
		},
