				"points": []
			},
			"dialogs": [
				{
					"id": 741363401,
					"content": "Ah, c'est vous... Vous êtes de retour ! Je savais que vous ne trouveriez pas, même si vous faisiez cinq fois le tour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363402
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741363402,
					"content": "Asseyez-vous donc et prenez une tasse de thé. Je viens d'acheter cinq tasses... et quelques bols.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363403
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741363403,
					"content": "Vous aimez bien le chiffre cinq, monsieur Edwin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363404
					],
					"speakerTitle": "Lemarcq"
				},
				{
					"id": 741363404,
					"content": "Oh, c'est un chiffre magique qui, utilisé correctement, peut ouvrir la porte de l'inspiration !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363405
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741363405,
					"content": "D'ailleurs, il y a cinq portes vers l'inspiration et il faut tourner la poignée au moins cinq fois... Cinq ! Vous savez ? Cinq fois !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363406
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741363406,
					"content": "Désolé, mais j'ai vraiment envie de vous donner cinq baffes, alors fermez-la, d'accord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lemarcq"
				}
			]
		}
