			"dialogs": [
				{
					"id": 741360601,
					"content": "C'est un si grand espace ouvert, avec... rien à l'intérieur. Mais où est la personne que nous cherchons ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741360602,
					"content": "Les plantes autour d'ici ont été dégagées, la construction semble encore très récente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360603
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360603,
					"content": "... Je me suis retrouvée dans ce pétrin juste pour lui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360604
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741360604,
					"content": "Bref, je vais d'abord descendre seul pour jeter un coup d'œil, vous restez avec mademoiselle l'institutrice, et s'il arrive quelque chose... Quittez cet endroit avec elle en vitesse pour sa sécurité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360605
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360605,
					"content": "Mais il n'y a rien ici, comment la situation pourrait empirer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360606
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360606,
					"content": "Couic ! Bip bip !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360607
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360607,
					"content": "Ah ! Attention ! Quelque chose arrive !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
