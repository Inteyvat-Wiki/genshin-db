			"dialogs": [
				{
					"id": 741360901,
					"content": "Sbires de l'Institut ! Combien Choiseul et Raimondo vous ont-ils payé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360902,
						741360903
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360902,
					"content": "Ils m'ont juste donné un titre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360904
					]
				},
				{
					"id": 741360904,
					"content": "Vous... Vous... Écoutez, lâchez-moi, mon générateur de champ est presque terminé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360905
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360905,
					"content": "Quand j'aurai réussi à le synchroniser avec le noyau cinétique d'arkhium, je deviendrai le plus grand ingénieur cinétique qui existe !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360906
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360906,
					"content": "... S'approprier les accomplissements des autres et se prétendre le plus grand ingénieur. Vous êtes né avant la honte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360907
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741360907,
					"content": "Je comprends enfin pourquoi monsieur Ed... Euh, Edwin, était réticent de vous laisser participer au projet de recherche principal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360908
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741360908,
					"content": "Edwin ne comprend pas du tout l'utilité de cette merveille ! Vous qui êtes également de l'Institut... Vous connaissez sa valeur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360909
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360909,
					"content": "Aidez-moi, je peux... Je peux le développer avec vous, et le moment venu, personne ne sera plus célèbre que nous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360910
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360910,
					"content": "Laissez tomber Edwin, Raimondo ou Choiseul... Personne ne pourra plus nous dominer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360911,
						741360912
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360911,
					"content": "Raimondo disait donc vrai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360913
					]
				},
				{
					"id": 741360913,
					"content": "Les accomplissements de mons... d'Edwin appartiennent à l'Institut. Je ne suis venue que pour les récupérer, le reste... ne m'intéresse pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360914
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741360914,
					"content": "Mademoiselle Fusilier a changé sa façon de se référer à Edwin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741360915,
					"content": "Ne soyez pas stupide ! Vous ne savez pas les avantages que monsieur Concini peut nous offrir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360916
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360916,
					"content": "On ne pourrait jamais les obtenir, même en travaillant pour Edwin pendant dix mille ans ! Edwin et l'Institut cherchent à nous utiliser... Nous devons penser à nous-mêmes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360917
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360917,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360918
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741360918,
					"content": "Bon, c'est fini les bêtises. Taisez-vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360919
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360919,
					"content": "Et qui êtes-vous ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360920
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360920,
					"content": "Le Port de Lumidouce est sous ma protection, et si vous dites un mot de plus, c'est mon poing dans votre figure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360921
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360921,
					"content": "#{NICKNAME}, aidez-moi à le ligoter. Prenez ce noyau avec vous, il est temps pour nous de rentrer et de terminer notre mission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360912,
					"content": "Vous avez beaucoup pris sur vous, monsieur Nacker.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360913
					]
				},
				{
					"id": 741360903,
					"content": "Pas un centime. Je suis bénévole.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360904
					]
				}
			]
		},
