			},
			"dialogs": [
				{
					"id": 741361101,
					"content": "#Mademoiselle Fusilier ! {NICKNAME}, vous êtes de retour ! Je suis sûr que vous avez réglé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361102
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361102,
					"content": "Oh, non...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361103
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361103,
					"content": "Ah ! Monsieur Choiseul va vraiment s'évanouir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741361104,
					"content": "Je ne m'attendais pas à ce que vous retourniez à l'Institut, Choiseul. Et moi qui pensais que vous passeriez votre vie à vous occuper de la paperasse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361105
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361105,
					"content": "C'est... C'est impossible ! Nom d'un Archon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361106
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361106,
					"content": "Raimondo, qu'est-ce que ça fait de reprendre mon travail ? Y a-t-il quelque chose à dire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361107
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361107,
					"content": "... Comme nous nous retrouvons, monsieur Edwin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361108
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361108,
					"content": "Ha ! Regardez autour de nous. Vous êtes vraiment doué pour faire le ménage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361109
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361109,
					"content": "... Tsss. Ce n'est même pas très bien nettoyé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361110
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741361110,
					"content": "Principalement, parce qu'il ne vous a pas jeté dehors.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361111
					]
				},
				{
					"id": 741361111,
					"content": "#Merci beaucoup d'avoir ramené ces deux personnes, {M#chercheur aîné}{F#chercheuse aînée} d'honneur {NICKNAME} et mademoiselle Fusilier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361112
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361112,
					"content": "La malchance et les problèmes de l'Institut de recherche de Fontaine prennent fin aujourd'hui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361113
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361113,
					"content": "Hahaha ! Génial. L'Institut de recherche de Fontaine va tomber dans un silence de mort, toute étincelle d'inspiration aura disparu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361114
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361114,
					"content": "Vous avez déjà fait assez d'étincelles à l'Institut de recherche de Fontaine. Il est temps de laisser les choses se calmer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361115
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361115,
					"content": "Raimondo Havenport, vous ne comprenez pas du tout la recherche. Vous êtes incapable de diriger l'Institut du génie cinétique de Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361116
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361116,
					"content": "Mais je sais comment gérer correctement l'Institut d'ingénierie cinétique de Fontaine, Edwin Eastinghouse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361117
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361117,
					"content": "Ce que vous devez faire maintenant, c'est rester à l'écart de la recherche et de l'arkhium. Le monde se portera bien mieux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361118
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361118,
					"content": "Au bout d'un moment, le personnel de la Maison Gardiennage arrive et emmène Nacker et Edwin. Ils quittent enfin l'Institut de recherche de Fontaine pour de bon...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741361119
					]
				},
				{
					"id": 741361119,
					"content": "Que les Archons soient loués, mon cauchemar se termine enfin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361120
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361120,
					"content": "Monsieur Chaussivert et monsieur Lemarcq, c'est vous ? J'ai déjà entendu parler de votre aide dans le travail de notre Institut. On est en train de préparer les cadeaux de remerciement pour vous, alors veuillez vous reposer ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361121
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361121,
					"content": "Hahaha, je ne pensais pas que quelqu'un comme moi se retrouverait impliqué dans les affaires de l'Institut un jour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361122
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741361122,
					"content": "Ne parlez pas de vous-même comme ça ! Cher monsieur, vous êtes à la fois sincère et gentil, vous êtes vraiment quelqu'un de bien ! Peut-être que nous vous demanderons de nous aider de nouveau à l'avenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361123
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361123,
					"content": "#Et vous... {M#Chercheur aîné}{F#Chercheuse aînée} d'honneur, vous avez rendu un grand service à l'Institut. Comment pourrais-je vous remercier ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361124,
						741361125
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361124,
					"content": "Ne provoquez plus d'explosions.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361128
					]
				},
				{
					"id": 741361128,
					"content": "D'ailleurs... Où est mademoiselle Fusilier ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741361129,
					"content": "... Laissons-la se calmer pour l'instant. Mademoiselle Fusilier a longtemps idolâtré Edwin Eastinghouse, mais elle a vu son vrai visage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361130
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361130,
					"content": "Edwin et Nacker ont également besoin de se calmer... J'espère qu'ils réfléchiront à leurs erreurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361131
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361131,
					"content": "Seront-ils enfermés à la Forteresse de Méropide pour le reste de leur vie ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361132
					]
				},
				{
					"id": 741361132,
					"content": "Compte tenu de leur dangerosité, j'espère qu'ils n'en sortiront jamais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361133
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361133,
					"content": "Quant à l'Institut de recherche de Fontaine... Hélas, j'espère qu'il ne m'arrivera pas de devoir demander leur aide...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361134
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361134,
					"content": "#Au nom de l'Institut de recherche de Fontaine, je vous remercie une fois de plus, {M#chercheur aîné}{F#chercheuse aînée} d'honneur. Si vous avez d'autres questions... Je suis tout ouïe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361125,
					"content": "Pouvez-vous me donner un titre plus prestigieux ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361126
					]
				},
				{
					"id": 741361126,
					"content": "Théoriquement, vous avez déjà le titre suprême... Mais je pourrais essayer de demander un titre encore plus spécial pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361127
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361127,
					"content": "#Par exemple... {M#Chercheur aîné}{F#Chercheuse aînée} d'honneur en chef, ça vous va ? Hahahaha !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361128
					],
					"speakerTitle": "Choiseul"
				}
			]
		},
