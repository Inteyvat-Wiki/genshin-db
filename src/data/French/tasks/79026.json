			"dialogs": [
				{
					"id": 790260101,
					"content": "Bienvenue ! Bienvenue !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260102
					],
					"speakerTitle": "Chef de troupe du théâtre du crépuscule"
				},
				{
					"id": 790260102,
					"content": "Bienvenue !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260104
					],
					"speakerTitle": "Chef de troupe du théâtre du crépuscule"
				},
				{
					"id": 790260104,
					"content": "#Vous êtes {M#le}{F#la} célèbre {NICKNAME} ! Et il y a aussi la meilleure des compagnons, Son Excellence dame Paimon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260105
					],
					"speakerTitle": "Chef de troupe du théâtre du crépuscule"
				},
				{
					"id": 790260105,
					"content": "Ouah ! Comment connaissez-vous nos noms ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790260106,
					"content": "#Je ne peux pas ne pas connaître les noms des {M#chers invités}{F#chères invitées} d'honneur de notre île, car je suis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260107
					],
					"speakerTitle": "Chef de troupe du théâtre du crépuscule"
				},
				{
					"id": 790260107,
					"content": "Vous êtes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790260108,
					"content": "Je suis le célèbre chef du théâtre du crépuscule !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260109
					],
					"speakerTitle": "Chef de troupe du théâtre du crépuscule"
				},
				{
					"id": 790260109,
					"content": "Alors il existe vraiment des gens qui se considèrent eux-mêmes célèbres...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790260110
					]
				},
				{
					"id": 790260110,
					"content": "Vous dites que vous êtes célèbre, mais on n'a jamais entendu parler de vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790260111,
					"content": "#Cela n'a pas d'importance ! Maintenant, vous en avez entendu parler {M#tous les deux}{F#toutes les deux} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260112
					],
					"speakerTitle": "Chef de troupe du théâtre du crépuscule"
				},
				{
					"id": 790260112,
					"content": "Après des préparatifs laborieux, nous allons bientôt jouer la première de notre pièce de théâtre, le « Conte de la princesse à l'épée » !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260113
					],
					"speakerTitle": "Chef de troupe du théâtre du crépuscule"
				},
				{
					"id": 790260113,
					"content": "Il y a cinq actes au total, et chaque acte est divisé en deux parties...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260114
					],
					"speakerTitle": "Chef de troupe du théâtre du crépuscule"
				},
				{
					"id": 790260114,
					"content": "#{M#Chers invités}{F#Chères invitées}, vous êtes là au bon moment ! Le prologue est sur le point de commencer ! Veuillez vous asseoir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260115
					],
					"speakerTitle": "Chef de troupe du théâtre du crépuscule"
				},
				{
					"id": 790260115,
					"content": "Il y a encore des choses à préparer en coulisses, si vous voulez bien m'excuser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260116
					],
					"speakerTitle": "Chef de troupe du théâtre du crépuscule"
				},
				{
					"id": 790260116,
					"content": "Vous êtes sur le point d'assister à la toute première représentation de la meilleure pièce jamais jouée par le théâtre du crépuscule ! Profitez-en bien !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chef de troupe du théâtre du crépuscule"
				}
			]
		}
	]
