			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206010601,
					"content": "#... Tu t'en es déjà {M#occupé}{F#occupée} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010602
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010602,
					"content": "Eh oui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010603
					]
				},
				{
					"id": 206010603,
					"content": "#Tu es vraiment très {M#fort}{F#forte}... Si seulement je l'étais aussi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010604
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010604,
					"content": "Moi aussi, j'aimerais bien pouvoir tuer les démons et sauver l'innocent, comme on dit... Mais quelques Brutocollinus et je perds le combat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010605
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010605,
					"content": "Hum... J'ai euh... J'aurais une faveur à te demander.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010606
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010606,
					"content": "Si je suis venu ici au Temple des Mille Vents, c'est parce que... Je vais bientôt passer l'évaluation de la Guilde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010607
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010607,
					"content": "Je me suis dit que si je montrais de quoi j'étais capable maintenant, ça serait sûrement pris en compte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010608
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010608,
					"content": "Mais non seulement j'ai échoué, mais en plus j'ai bien failli y laisser quelques membres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010609
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010609,
					"content": "Est-ce que... Est-ce que tu pourrais ne pas parler de tout ça à maître Cyrus ? Si ça s'apprend, je vais rater l'évaluation, c'est tout vu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010610,
						206010612
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010610,
					"content": "D'accord.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010611
					]
				},
				{
					"id": 206010611,
					"content": "Oh, merci, merci mille fois ! Je te jure que je ferai attention dorénavant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010612,
					"content": "Ce n'est pas une bonne idée je trouve.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010613
					]
				},
				{
					"id": 206010613,
					"content": "Je sais bien... Et puis maître Cyrus dit toujours qu'un aventurier doit savoir faire face à ses erreurs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010614
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010614,
					"content": "Mais... *soupir* Tant pis, tant pis. J'espère juste que Cyrus ne sera pas trop en colère après moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
		{
