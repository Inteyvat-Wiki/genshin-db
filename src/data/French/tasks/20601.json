				{
					"id": 206010701,
					"content": "Ah, vous revoilà, et avec Jack ! Mais... Il a l'air amoché...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010702
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206010702,
					"content": "Qu'est-ce qu'il s'est passé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010703
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206010703,
					"content": "Jack a avancé trop tôt, et a été blessé...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010704
					]
				},
				{
					"id": 206010704,
					"content": "Exactement ce que je m'étais imaginé. *soupir* Il n'a pas écouté ce que je lui ai dit et répété...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010705
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206010705,
					"content": "Je sais qu'il veut faire ses preuves, mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010706
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206010706,
					"content": "Bon, assez parlé. Je vois ce qu'il s'est passé, j'irai lui parler face-à-face.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010707
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206010707,
					"content": "Tenez, c'est pour vous. Mettons que c'est pour les risques que vous avez courus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
