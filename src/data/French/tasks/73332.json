			"dialogs": [
				{
					"id": 733320201,
					"content": "C'est ce qu'elles sont devenues ? Pitoyable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733320202
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733320202,
					"content": "De quoi tu parles, Sorush ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733320203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733320203,
					"content": "Rien de spécial, j'ai juste vu l'état pitoyable de mes semblables. Ce n'est pas grave.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733320204
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733320204,
					"content": "Tu me donnes envie d'en savoir plus maintenant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733320205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733320205,
					"content": "Laisse-moi voir... Oh, c'est vraiment un arbre étrange ! Il est en forme de cercle et ressemble presque à une porte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733320206,
						733320207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733320206,
					"content": "Si nous la traversons...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733320208
					]
				},
				{
					"id": 733320208,
					"content": "Haha, tu me donnes envie de voir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733320209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733320209,
					"content": "... Ces arbres de fravashi ne sont pas des portes. Vous dérangerez les paris résiduelles qui les habitent si vous les traversez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733320210
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733320210,
					"content": "C'est donc un arbre de fravashi ? Où sont les paris résiduelles ? Je ne les vois pas du tout !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733320211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733320211,
					"content": "Bien sûr que tu ne les vois pas. Elles sont encore piégées dans leur obsession du passé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733320212
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733320212,
					"content": "C'est indépendant de leur volonté, mais les voir s'accrocher autant à ce monde... m'est insupportable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733320213
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733320213,
					"content": "Ces arbres sont luxuriants, pourtant. Je les trouve plutôt sympathiques.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733320214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733320214,
					"content": "Hmph. Tu ignores tout, Blanche flottante. Ces arbres de fravashi sont des paris qui ont usé de leurs dernières forces pour se transformer, après avoir combattu contre la souillure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733320215
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733320215,
					"content": "Elles étaient tellement épuisées qu'elles ne pouvaient plus garder leur forme physique et ont été rejetées par l'Éden car il les considère comme souillées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733320216
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733320216,
					"content": "La légende veut que dans les temps anciens, l'Ordre des Sceptiques organisait un rituel de purification pour qu'elles puissent rentrer à l'Éden du vourukasha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733320217
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733320217,
					"content": "Malheureusement, plus personne n'est en mesure de conduire ce rituel. Tout ce qu'on peut faire, c'est de garder ces arbres de fravashi en vie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733320218
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733320218,
					"content": "Hélas, cela ne fait que prolonger leur douleur. Je crois qu'il ne reste plus rien d'elles, à part ces souvenirs atroces qu'elles doivent endurer toutes seules.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733320219,
						733320220
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733320219,
					"content": "Nous devrions les aider.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733320221
					]
				},
				{
					"id": 733320221,
					"content": "Je ne peux pas les laisser dans cet état, non plus ! Elles doivent tellement souffrir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733320222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733320222,
					"content": "Cela reste le destin des paris. Leurs souhaits sont exaucés en ayant la possibilité de protéger ces terres sous cette forme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733320223
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733320223,
					"content": "C'est ton avis. Peut-être qu'elles ne sont pas d'accord avec toi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733320224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733320224,
					"content": "À leur place, je voudrais rentrer à l'Éden du vourukasha pour être avec les autres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733320225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733320225,
					"content": "Comment oses-tu nous dédaigner ainsi, Blanche flottante ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733320226
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733320226,
					"content": "Hmph. Très bien, je vais la réveiller grâce à mon pouvoir et vous faire écouter sa voix grêle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733320220,
					"content": "Il doit y avoir un moyen de les sauver...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733320221
					]
				},
				{
					"id": 733320207,
					"content": "Elle pourrait nous mener quelque part.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733320208
					]
				}
			]
		},
