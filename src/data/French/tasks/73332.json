				},
				{
					"id": 733320312,
					"content": "C'est indépendant de leur volonté, mais les voir s'accrocher autant à ce monde... Absurde et pathétique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733320313
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733320313,
					"content": "Ils sont un peu bizarres, mais ce n'est pas une raison de dire qu'ils sont pathétiques !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733320314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733320314,
					"content": "Je pensais que tu te sentirais chez toi, entourée de toutes ces plantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733320315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733320315,
					"content": "Hmph, je ne me sens véritablement chez moi que sur le champ de bataille. Seule une bataille qui dure jusqu'à la fin des temps peut être perçue comme l'éternité !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733320316
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733320316,
					"content": "Tu devrais te mettre cela dans ton petit crâne maintenant que tu m'accompagnes, Blanche flottante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733320317
					],
					"speakerTitle": "Sorush"
				},
				{
