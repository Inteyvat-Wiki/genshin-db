			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sukhovykh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760010101,
					"content": "Excusez-moi ! J'ai une question à vous poser...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760010102,
					"content": "#Vous montrez les objets que vous avez reçus tout à l'heure aux deux Gardiens de lumière. Vous leur parlez également de l'individu étrange aux côtés de qui vous vous êtes {M#battus}{F#battues} contre la Chasse sauvage et qui portait l'uniforme de Gardien de lumière...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760010103
					]
				},
				{
					"id": 760010103,
					"content": "... C'était peut-être Sigurd ? Il n'a toujours pas trouvé le repos, on dirait. Si seulement j'avais pu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010104
					],
					"speakerTitle": "Lushne"
				},
				{
					"id": 760010104,
					"content": "Arrêtez, Lushne. Ce n'est pas une responsabilité que tu dois porter tout seul. Tant que la Chasse sauvage existe, il continuera à se battre contre elle. Tout ce qu'on peut faire, c'est accomplir notre mission du mieux qu'on peut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010105
					],
					"speakerTitle": "Sukhovykh"
				},
				{
					"id": 760010105,
					"content": "Du coup, ce Sigurd faisait partie des Gardiens de lumière ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760010106,
					"content": "Oui, c'était un collègue extraordinaire. Quand la Chasse sauvage a envahi Nod-Krai, il s'est battu jusqu'à la fin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010107
					],
					"speakerTitle": "Sukhovykh"
				},
				{
					"id": 760010107,
					"content": "On raconte que même les bêtes les plus déchaînées sursautent lorsque cette alarme retentit. Tous ceux qui l'entendent ont trop peur pour continuer à avancer... Mais qui aurait cru que vous trouveriez ses reliques ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010108
					],
					"speakerTitle": "Sukhovykh"
				},
				{
					"id": 760010108,
					"content": "Si vous pouvez, ramenez-les sur sa tombe. Elle se trouve près des ruines du champ de bataille à l'est sur l'Île de Lempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010109
					],
					"speakerTitle": "Sukhovykh"
				},
				{
					"id": 760010109,
					"content": "Pas de problème.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760010110
					]
				},
				{
					"id": 760010110,
					"content": "Merci. J'espère que son esprit pourra bientôt trouver le repos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sukhovykh"
				}
			]
		},
