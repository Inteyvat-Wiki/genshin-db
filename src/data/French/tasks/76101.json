					],
					"speakerTitle": "Olav"
				},
				{
					"id": 761010202,
					"content": "Hein ? Le starshyna... Nikita ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010203,
					"content": "#Attends, {NICKNAME}, Nikita... ce ne serait pas le vieux monsieur qui nous avait demandé de chercher la mèche d'argent ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010204
