					"nextDialogs": [
						761010205,
						761010206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010205,
					"content": "Oui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761010207
					]
				},
				{
					"id": 761010207,
					"content": "Ah, le vieux... Il voulait sûrement juste vous faire une petite blague.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
