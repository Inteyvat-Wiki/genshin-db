			},
			"dialogs": [
				{
					"id": 761010301,
					"content": "Papy, on est de retour !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010302
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761010302,
					"content": "Ah, vous voilà sains et saufs. Comment était-ce à la Falaise Kipumaki ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010303
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010303,
					"content": "Vous faites un rapide résumé de ce qui s'est passé...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761010304
					]
				},
				{
					"id": 761010304,
					"content": "C'est bien ce que je pensais... Même d'ici, c'est évident. Le Pilier d'Embla est tombé, totalement envahi par l'Abîme... et par ce démon immortel qu'ils appellent le « professeur ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010305
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010305,
					"content": "Cela dit, tout est calme pour le moment. Je suppose que mademoiselle Alia continue de se battre pour le maintenir à distance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010306
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010306,
					"content": "Elle fait tout ça pour nous, il ne faut pas qu'on gâche cette opportunité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010307
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010307,
					"content": "Grâce à Flins et aux autres, les préparatifs sont presque terminés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010308
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010308,
					"content": "Maintenant que vous avez rapporté la lame spirale, la flèche de Terpikeraunas est enfin prête.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010309
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010309,
					"content": "Euh... c'est quoi la « flèche de Terpikeraunas » ? C'est une autre relique puissante, comme la mèche d'argent et la lame spirale ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010310,
					"content": "Haha, elle les surpasse toutes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010311
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010311,
					"content": "Il y a cinq siècles, le forge-torche n'était pas assez fort pour vaincre le démon immortel, et n'a pu que le sceller sous la Falaise Kipumaki. Malgré tout, il n'a jamais faibli. Aux côtés de la première Émissaire de chantelune, ils ont persévéré dans l'espoir d'une victoire future.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010312
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010312,
					"content": "Ils ont forgé cet arc et cette flèche selon un art ancestral, afin qu'ils soient prêts le jour venu pour éliminer le démon immortel. Depuis lors, ils ont été transmis de génération en génération chez les Gardiens de lumière.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010313
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010313,
					"content": "Maintenant, le moment est enfin venu pour elle d'accomplir son destin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010314
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010314,
					"content": "Waouh... Ça a l'air incroyable ! À quoi ça ressemble ? On peut la voir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010315,
					"content": "Vous l'avez déjà vue, petite. Nous sommes à l'intérieur de la flèche de Terpikeraunas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010316,
						761010318
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010316,
					"content": "Ah ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761010317
					]
				},
				{
					"id": 761010317,
					"content": "V—Vous n'allez quand même pas nous propulser ? Hein ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010320,
					"content": "Cette grande halle a été construite pour abriter la flèche de Terpikeraunas. La lame spirale que vous avez récupérée est la pointe de flèche qui avait disparu depuis longtemps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010321
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010321,
					"content": "Une fois la lame spirale mise en place, la flèche de Terpikeraunas sera prête à être tirée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010322
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010322,
					"content": "Mais c'est une cheminée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010323,
					"content": "Oui, c'est bien une cheminée, mais c'est aussi le mécanisme même qui transforme la lame spirale en pointe de flèche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010324
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761010324,
					"content": "Nous devons agir avant l'éclosion de l'œuf du cataclysme. Cet arc et cette flèche nous ont été transmis pour ce moment précis. Mettons fin à cette menace !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010325
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010325,
					"content": "Pendant que vous préparez le tir, ce monstre immortel tentera sûrement une dernière attaque. Peu importe ce qui nous attend, nous l'arrêterons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010326
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010326,
					"content": "Concentrez-vous sur le lancement de la flèche de Terpikeraunas. Nous comptons sur vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010318,
					"content": "#Est-ce que je vais être {M#propulsé}{F#propulsée} avec la flèche ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761010319
					]
				},
				{
					"id": 761010319,
					"content": "#{NICKNAME} est vraiment notre arme de dernier recours ! ... Non, c'est forcément une blague !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010320
					],
					"speakerTitle": "Paimon"
				}
			]
		},
