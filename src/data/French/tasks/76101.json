			"dialogs": [
				{
					"id": 761010101,
					"content": "#{NICKNAME} ! Paimon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010102
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761010102,
					"content": "Héhé, on dirait qu'on arrive pile au bon moment ! Il y a une super ambiance de fête.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010103,
					"content": "Tout le monde a travaillé dur ces derniers jours. Maintenant que les choses se sont enfin calmées, nous avons pu trouver un moment pour nous réunir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010104
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761010104,
					"content": "Ça n'a pas dû être facile pour vous non plus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761010105
					]
				},
				{
					"id": 761010105,
					"content": "#Je n'ai fait que ce qu'on attendait de moi, mais... si vous n'étiez pas {M#intervenu}{F#intervenue} à ce moment-là, j'imagine que les choses auraient pu se terminer très différemment. Nous aurions peut-être quand même gagné... mais le coût aurait été bien plus élevé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010106
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761010106,
					"content": "Allez, on fait partie de votre escouade aussi, non ? Pas la peine d'être aussi sérieux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010107,
					"content": "Vous avez raison. Oh, on dirait que le vieux s'apprête à parler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010108
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761010108,
					"content": "Camarades et frères d'armes, nous ne nous sommes pas réunis pour une simple célébration. C'est aussi l'occasion d'honorer la lutte difficile qui a mené à notre triomphe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010109
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010109,
					"content": "N'oublions pas tous ceux qui ont tout donné pour rendre cette victoire possible. Par leur sang, ils ont honoré le serment que nous avons tous fait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010110
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010110,
					"content": "Durant cette bataille, l'escouade d'enquête des « Orioles des nuits terrifiantes », menée par Illuga, s'est chargée de ce qui fut probablement la mission la plus périlleuse de toutes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010111
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010111,
					"content": "#En particulier, {NICKNAME} et son amie se sont {M#portés}{F#portées} volontaires sans hésitation dans ce moment critique et ont joué un rôle qui s'est avéré déterminant pour la réussite de l'opération.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010112
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010112,
					"content": "#{M#Ils}{F#Elles} ont bravé tous les dangers, persévéré à travers la tempête, et forgé un chemin vers la victoire depuis les profondeurs du désespoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010113
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010113,
					"content": "L'héritage de leurs actes, et de tous ceux qui ont combattu pour les vivants et les générations à venir, sera gravé dans l'histoire, à jamais indélébile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010114
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010114,
					"content": "Nous avons gagné, certes. Mais cette victoire a eu un prix terrible. Nous pouvons faire une pause pour pleurer, pour nous souvenir des disparus, mais ne nous laissons pas briser par le chagrin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010115
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010115,
					"content": "L'avenir pour lequel nous nous sommes battus est à portée de main, et nous portons la flamme de ceux qui ont éclairé notre chemin avant nous. Leur lumière doit continuer de briller, et nous, de persévérer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010116
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010116,
					"content": "Aujourd'hui, levons nos verres : à la victoire, aux âmes courageuses dont la bravoure ne sera jamais oubliée, et à l'avenir que nous avons juré de protéger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nikita"
				}
			]
		},
