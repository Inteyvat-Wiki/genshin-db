					{
						"sceneId": 3,
						"position": [
							5610.782,
							375.311,
							9961.593
						],
						"pointId": 361100061
					}
				]
			},
			"dialogs": [
				{
					"id": 761011301,
					"content": "La porte vers le ciel maudit est ouverte, et tu t'accroches encore à cette misérable quantité de kuuvahki comme si ça avait de l'importance ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011302
					],
					"speakerTitle": "« Professeur »"
				},
				{
					"id": 761011302,
					"content": "Pourtant... Comment se fait-il que je sois encore piégé ici ? Ah, je comprends... La meule Sampo refuse encore de céder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011303
					],
					"speakerTitle": "« Professeur »"
				},
				{
					"id": 761011303,
					"content": "Regardez qui est enfin arrivé. Quel honneur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011304
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 761011304,
					"content": "... Qui va là ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011305
					],
					"speakerTitle": "« Professeur »"
				},
				{
					"id": 761011305,
					"content": "Cette silhouette... Relya ? Ah, te voilà. Je savais que tu étais encore en vie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011306
					],
					"speakerTitle": "« Professeur »"
				},
				{
					"id": 761011306,
					"content": "À présent, ordonne au pouvoir de la meule Sampo de se plier à ma volonté ! Tu réussiras, avec le sang de l'héritier sacré qui brûle en toi... Ces trois autres n'étaient que de risibles échecs, mais pas toi, non. Tu as toujours été l'élu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011307
					],
					"speakerTitle": "« Professeur »"
				},
				{
					"id": 761011307,
					"content": "Hah... Il pense vraiment que je suis Relya. Comme c'est ironique, ce moine fou qui autrefois pouvait persuader n'importe qui n'arrive même plus à voir clair maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011308
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 761011308,
					"content": "Relya, ne vacille pas. Tu n'as pas oublié notre rêve, n'est-ce pas ? Ne veux-tu pas réclamer le nom et la place qui t'ont toujours été destinés ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011309
					],
					"speakerTitle": "« Professeur »"
				},
				{
					"id": 761011309,
					"content": "Imagine, un Élysium pour les déshonorés et les oubliés, un endroit où les fiers nobles nivéoles s'agenouilleront devant toi. Dans la cour royale de l'étoile pâle, moi seul, un autre humain, peux concrétiser ta vision.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011310
					],
					"speakerTitle": "« Professeur »"
				},
				{
					"id": 761011310,
					"content": "Maintenant, je ne suis plus qu'à un pas de l'ascension vers les étoiles... Lorsque l'Élysium au-delà des cieux se déploiera sur ce monde, tous les autres seront balayés, ne laissant que nous, les élus, pour hériter de ce qui restera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011311
					],
					"speakerTitle": "« Professeur »"
				},
				{
					"id": 761011311,
					"content": "Quand cette aube viendra, toute la pourriture de cette ère sera lavée. Dis-moi, n'est-ce pas là le monde dont tu as toujours rêvé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011312
					],
					"speakerTitle": "« Professeur »"
				},
				{
					"id": 761011312,
					"content": "Non. Il n'a jamais désiré cet avenir... Et comment osez-vous encore répéter le même mensonge dans un moment pareil ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011313
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 761011313,
					"content": "Vous vous êtes servi de lui depuis le début. Chaque promesse, chaque mensonge, vous avez tout orchestré pour qu'il s'empare de la meule Sampo pour vous. Et cet « Élysium » dont vous ne cessez de parler ? Il n'a jamais été destiné qu'à vous seul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011314
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 761011314,
					"content": "Même sa déchéance, le chemin qui l'a transformé en maître voleur, tout ça n'était qu'un piège que vous aviez manigancé avec le grand duc Alvis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011315
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 761011315,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011316
					],
					"speakerTitle": "« Professeur »"
				},
				{
					"id": 761011316,
					"content": "Vous m'avez peut-être appelée Relya par erreur, mais ce nom me convient tout autant. Je porte son rôle et son héritage, et je prendrai le nom de Reed Miller sans la moindre hésitation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011317
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 761011317,
					"content": "Rauthvangi. Moine fou. « Professeur ». Serpent immortel... Ton histoire s'arrête ici. J'y mettrai fin au nom de Reed Miller.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011318
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 761011318,
					"content": "On a vraiment réussi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011319
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761011319,
					"content": "Cette fois, nous avons vraiment enterré ce démon immortel...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011320
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761011320,
					"content": "#« Ce serpent immortel se relèvera deux fois encore, pour être terrassé trois fois de plus... Jusqu'à ce qu'il soit définitivement terrassé par les héros de la sphère sublunaire...{NON_BREAK_SPACE}»\\nAux côtés des courageux ratnikis, vous triomphez enfin du « professeur »...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761011321
					]
				},
				{
					"id": 761011321,
					"content": "Vous restez à Piramida pendant quelques jours après l'événement...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		}
	]
