			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hoffman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411230301,
					"content": "Avez-vous réussi à chasser les Pilleurs de trésors ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230302
					],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 411230302,
					"content": "Oui, il n'en reste aucun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230303
					]
				},
				{
					"id": 411230303,
					"content": "Merveilleux, vous m'ôtez une épine du pied.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230304
					],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 411230304,
					"content": "J'espère que ces malfrats ont appris leur leçon et qu'ils n'oseront plus remettre les pieds ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230305
					],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 411230305,
					"content": "Eh bien, s'il n'y a rien d'autre...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230306
					]
				},
				{
					"id": 411230306,
					"content": "Ah, attendez une minute ! J'ai encore besoin de votre aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230307
					],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 411230307,
					"content": "À vrai dire, nous avons reçu une multitude de rapports sur des monstres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230308
					],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 411230308,
					"content": "Apparemment, les météorites les auraient rendus plus agressifs que d'habitude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230309
					],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 411230309,
					"content": "Les défenses autour de la cité sont solides, aucune inquiétude à avoir. Mais une météorite s'est écrasée près de Deauclaire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230310
					],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 411230310,
					"content": "Nous avons envoyé des renforts aux chasseurs, mais les environs sont difficiles à surveiller à cause de leur topographie particulière.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230311
					],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 411230311,
					"content": "Si les monstres parvenaient à attaquer le village, les choses pourraient se gâter...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230312
					],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 411230312,
					"content": "Pourriez-vous vous rendre à Deauclaire pour surveiller ces monstres ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230313,
						411230315
					],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 411230313,
					"content": "C'est d'accord.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230314
					]
				},
				{
					"id": 411230314,
					"content": "Je compte sur vous alors. Je vous enverrai des renforts dès que je pourrai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 411230315,
					"content": "Comment vont les choses à Deauclaire ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230316
					]
				},
				{
					"id": 411230316,
					"content": "Honnêtement, elles ne vont pas bien. Nous sommes déjà pris d'assaut à cause des météorites et il faut en plus garder l'œil sur les monstres et les Pilleurs de trésors...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230317
					],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 411230317,
					"content": "Nous ne pouvons pas nous occuper de toutes ces choses à la fois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230318
					],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 411230318,
					"content": "Je vous confie donc cette tâche et je vous enverrai des renforts dès que possible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hoffman"
				}
			]
		},
		{
			"id": 4112304,
