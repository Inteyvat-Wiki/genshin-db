					"Hoffman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411230901,
					"content": "Comment les choses se passent-elles ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230902
					],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 411230902,
					"content": "Deauclaire est en sécurité.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230903
					]
				},
				{
					"id": 411230903,
					"content": "C'est rassurant. Je m'inquiétais vraiment de ne pas pouvoir venir en aide...",
					"roleType": "TALK_ROLE_NPC",
