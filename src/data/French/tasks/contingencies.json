				"objectNames": [
					"Morro"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411230401,
					"content": "Aaah !! N—N'approchez pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230402
					],
					"speakerTitle": "Morro"
				},
				{
					"id": 411230402,
					"content": "Oh ! Vous n'êtes pas un monstre. Qui êtes-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230403
					],
					"speakerTitle": "Morro"
				},
				{
					"id": 411230403,
					"content": "Qu'en est-il des monstres ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230404
					]
				},
				{
					"id": 411230404,
					"content": "Qu'est-ce que vous pensez ? J'étais en train de les fuir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230405
					],
					"speakerTitle": "Morro"
				},
				{
					"id": 411230405,
					"content": "Ils étaient juste là, en groupe. On aurait dit qu'ils se préparaient à attaquer le village.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230406
					],
					"speakerTitle": "Morro"
				},
				{
					"id": 411230406,
					"content": "Ils n'auraient fait qu'une bouchée de moi si je ne m'étais pas vite enfui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230407
					],
					"speakerTitle": "Morro"
				},
				{
					"id": 411230407,
					"content": "Où sont-ils maintenant ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230408
					]
				},
				{
					"id": 411230408,
					"content": "Pas loin du village. Vous pourrez les apercevoir à quelques pas d'ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230409
					],
					"speakerTitle": "Morro"
				},
				{
					"id": 411230409,
					"content": "Vous devriez plutôt vous mettre à l'abri. Je vais reprendre un peu mon souffle ici avant d'aller prévenir tout le monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Morro"
				}
			]
		},
		{
			"id": 4112308,
			"completionStepIds": [
				4112308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
