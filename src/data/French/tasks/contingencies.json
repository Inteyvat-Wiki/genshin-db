			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Morro"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411230801,
					"content": "#Ah, c'est vous ! Qu'est-ce que vous êtes {M#allé}{F#allée} faire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230802
					],
					"speakerTitle": "Morro"
				},
				{
					"id": 411230802,
					"content": "J'ai vaincu tous les monstres.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230803
					]
				},
				{
					"id": 411230803,
					"content": "#C—Comment ? À vous {M#tout seul}{F#toute seule} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230804
					],
					"speakerTitle": "Morro"
				},
				{
					"id": 411230804,
					"content": "Allez vérifier si vous ne me croyez pas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230805
					]
				},
				{
					"id": 411230805,
					"content": "Je n'ose pas y aller... Ils me tueront s'ils me voient...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230806
					],
					"speakerTitle": "Morro"
				},
				{
					"id": 411230806,
					"content": "#Je vais juste rapporter aux chevaliers que vous vous êtes {M#débarrassé}{F#débarrassée} de ces monstres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230807
					],
					"speakerTitle": "Morro"
				},
				{
					"id": 411230807,
					"content": "Ils pourront vérifier par eux-mêmes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Morro"
				}
			]
		},
		{
			"id": 4112309,
