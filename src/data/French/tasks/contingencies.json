			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hoffman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411230101,
					"content": "#Salutations, {M#voyageur}{F#voyageuse}. Vous feriez mieux de ne pas quitter la Cité de Mondstadt par les temps qui courent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230102
					],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 411230102,
					"content": "Qu'est-ce qu'il se passe ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230103
					]
				},
				{
					"id": 411230103,
					"content": "Vous avez sans doute remarqué qu'il pleuvait des météorites, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230104
					],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 411230104,
					"content": "J'ignore pourquoi, mais il y en a de plus en plus. C'est dangereux de rester hors des murs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230105
					],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 411230105,
					"content": "Nous, chevaliers, en avons plein les bras ici... Et la cerise sur le gâteau : les Pilleurs de trésors sont aussi de sortie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230106
					],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 411230106,
					"content": "Ces scélérats sont prêts à tout pour satisfaire leur cupidité et j'ai bien peur qu'ils ne profitent de la situation...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230107
					],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 411230107,
					"content": "Pourriez-vous les chasser de Mondstadt pour nous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230108
					],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 411230108,
					"content": "J'ai bien conscience que c'est le travail de l'Ordre de Favonius, mais je n'ai pas assez d'hommes... Aidez-nous, je vous en prie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230109,
						411230111
					],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 411230109,
					"content": "Je m'en occupe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230110
					]
				},
				{
					"id": 411230110,
					"content": "Merci du fond du cœur. Je m'excuse d'abuser de votre gentillesse, surtout pendant de telles circonstances.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 411230111,
					"content": "Les Pilleurs de trésors n'ont pas peur des météorites ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230112
					]
				},
				{
					"id": 411230112,
					"content": "Ils ne reculent devant rien pour mettre la main sur le moindre mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230113
					],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 411230113,
					"content": "Merci du fond du cœur. Je m'excuse d'abuser de votre gentillesse, surtout pendant de telles circonstances.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hoffman"
				}
			]
		},
		{
			"id": 4112303,
			"completionStepIds": [
				4112303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
