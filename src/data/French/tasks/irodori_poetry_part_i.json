			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ootomo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726910101,
					"content": "#{M#Jeune homme}{F#Jeune femme}, je vous vois vous promener dans cet endroit depuis tout à l'heure. Vous devez sûrement être une personne cultivée et raffinée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910102
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726910102,
					"content": "J'aimerais solliciter votre aide pour accomplir une tâche des plus sophistiquées. Qu'en dites-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910103
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726910103,
					"content": "Je vous écoute.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726910104
					]
				},
				{
					"id": 726910104,
					"content": "Ce barde itinérant de Mondstadt, Lenne, et moi-même, sommes comme de vieux amis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910105
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726910105,
					"content": "Ootomo a raison ! On ne se connaît que depuis quelques jours, mais j'admire son savoir et son affabilité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910106
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910106,
					"content": "Haha, vous me flattez, Lenne. En bref, nous avons décidé de développer notre amitié à travers la poésie en composant des œuvres ensemble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910107
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726910107,
					"content": "Ayant fait tout ce chemin jusqu'à Inazuma, Lenne souhaiterait aussi incorporer des éléments inazumiens dans son œuvre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910108
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726910108,
					"content": "Absolument, mais je n'ai pas le temps de visiter Inazuma à cause de mon programme trop chargé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910109
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910109,
					"content": "Que puis-je faire pour vous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726910110
					]
				},
				{
					"id": 726910110,
					"content": "#{M#Mon cher}{F#Ma chère}, je suis en train de composer un poème sur le thème de la nostalgie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910111
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910111,
					"content": "En contemplant les paysages d'un pays lointain, un vagabond ne peut s'empêcher de se souvenir de son foyer. C'est pour cette raison que je souhaite incorporer dans mon poème quelques éléments qui symbolisent cet endroit éloigné.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910112
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910112,
					"content": "Pourriez-vous prendre quelques photos avec votre Daguerréotype pour moi ? Elles me serviront d'inspiration.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910113
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910113,
					"content": "Inazuma devrait regorger de paysages uniques, n'est-ce pas ? Lorsqu'on parle de Mondstadt, tout le monde pense d'emblée aux pissenlits ou aux chrysanthèmes à aubes, par exemple.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910114
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910114,
					"content": "Oh, je vois. Dans ce cas, prendre des photos de produits locaux fera parfaitement l'affaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726910115,
					"content": "Oui, je compte sur vous ! Je vous donne aussi un exemplaire du poème comme référence. Je n'en ai rédigé que la moitié pour l'instant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910116
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910116,
					"content": "En ce qui concerne le nombre de photos, j'en aimerais <color=#00E1FFFF>quatre</color> avec des sujets différents. Je vous préparerai une récompense suffisante pour couvrir vos frais de déplacement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910117
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910117,
					"content": "Lenne nous a clairement expliqué ses attentes, c'est à nous de jouer maintenant. En route !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
