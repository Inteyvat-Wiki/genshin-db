			"dialogs": [
				{
					"id": 726910301,
					"content": "Ah, vous revoilà. Vous avez pris les photos ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910302
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910302,
					"content": "Oui, tenez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726910303
					]
				},
				{
					"id": 726910303,
					"content": "Merci beaucoup. Laissez-moi voir... Ce sont bien des choses que je n'ai jamais vues ! Oh, ce cliché est vraiment beau ! Vous avez bien fait de prendre celui-là aussi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910304
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910304,
					"content": "#{M#Mes chers}{F#Mes chères}, les photos que vous avez prises m'ont donné une inspiration soudaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910305
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910305,
					"content": "J'ai composé plusieurs vers et je vous avoue que je ne sais pas lequel utiliser...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910306
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910306,
					"content": "À vrai dire, je suis curieux de votre avis. Qu'en pensez-vous ? Quel vers choisiriez-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lenne"
				}
			]
		},
