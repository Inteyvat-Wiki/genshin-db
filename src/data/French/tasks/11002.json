			"dialogs": [
				{
					"id": 110020201,
					"content": "Je crois que nous sommes proches...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020202
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020202,
					"content": "Tu sais ce que tu vas cuisiner ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110020203,
					"content": "Bien sûr que non !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020204
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020204,
					"content": "Tu avais l'air si sûre de toi tout à l'heure !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110020205,
					"content": "C'est moi tout craché. Ça ne serait pas marrant si je le savais à l'avance !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020206
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020206,
					"content": "De même, il n'y aurait plus d'élément de surprise si je savais ce que je voulais avant de l'avoir trouvé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020207
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020207,
					"content": "Tu prends beaucoup de risques...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110020208,
					"content": "T'inquiète ! C'est comme ça que j'ai élaboré le menu du Wanmin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020209
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020209,
					"content": "Regardons par là. Je te fais signe quand je trouve un truc qui me plaît !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiangling"
				}
			]
		},
