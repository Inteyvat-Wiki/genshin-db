			"dialogs": [
				{
					"id": 730310101,
					"content": "Araja, Arama, on est de retour !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310102,
					"content": "#C'est si bon de revoir nara {NICKNAME} et Paimon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310103
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310103,
					"content": "#Eh bien, vous voilà de retour ! Tout le monde n'arrête pas de parler de comment {M#un grand et beau}{F#une grande et belle} nara {M#nommé}{F#nommée} {NICKNAME} les a beaucoup aidés. Ils sont tous très contents.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310104
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730310104,
					"content": "#C'est toujours agréable d'avoir quelqu'un pour aider ! N'est-ce pas, {NICKNAME} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310105,
						730310106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310105,
					"content": "Oh que oui !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310107
					]
				},
				{
					"id": 730310107,
					"content": "Non, ils sont contents car ils ont rencontré de nouveaux amis. Même si Aranakin, Aranaga et Aragaru ne se souviennent pas, la forêt se souvient de tout. L'histoire ne sera pas complètement perdue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310108
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730310108,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310109,
					"content": "Les préparatifs pour le Festival Utsava sont presque terminés. On a juste besoin d'encore un peu de temps !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310110
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310110,
					"content": "#Oui, grâce à l'aide de nara {NICKNAME} et de Paimon, le Festival Utsava est enfin sur le point de commencer. J'ai vraiment hâte d'y être...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araja"
				},
				{
					"id": 730310106,
					"content": "Oh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310107
					]
				}
			]
		},
