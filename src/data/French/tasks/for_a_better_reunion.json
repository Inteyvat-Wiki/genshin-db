			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730310601,
					"content": "Rana a l'air...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310602,
					"content": "J'ai envie de dire qu'elle fait de beaux rêves, mais ça ne me paraît pas tellement approprié...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310603,
					"content": "(Une vague image apparaît sur la « bulle » enveloppant Rana.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310604
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730310604,
					"content": "(Vous vous laissez emporter par cette image...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310605
					]
				},
				{
					"id": 730310605,
					"content": "Vous êtes au milieu d'une forêt où tout paraît immense et profond. En revanche, vous vous y sentez parfaitement à l'aise.\\nLe soleil rayonne à travers les feuilles et des mauvaises herbes aussi grandes que vous chuchotent et rient, vous touchant doucement la main lorsque vous passez devant elles.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730310606
					]
				},
				{
					"id": 730310606,
					"content": "En écoutant le bourdonnement des arbres et la musique du ruissellement de l'eau, vous entendez un cri d'inquiétude. En cherchant sa provenance, vous trouvez une petite personne.\\nIl semble qu'elle se soit endormie dans la prairie, fatiguée d'avoir tant pleuré. Vous allez à ses côtés et entonnez doucement le chant qui calme les esprits...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730310607
					]
				},
				{
					"id": 730310607,
					"content": "#... Hé, {NICKNAME} ! Qu'est-ce qui t'arrive ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310608,
					"content": "Je suis contente que tu ailles bien... J'ai cru que tu allais t'évanouir, j'étais morte d'inquiétude...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310609,
					"content": "#Nara {NICKNAME}, te voilà !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310610
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310610,
					"content": "Ouah ! Tu m'as fait peur !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310611,
					"content": "Ouah !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310612,
						730310613
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310612,
					"content": "Ouah !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310614
					]
				},
				{
					"id": 730310614,
					"content": "Non mais c'est incroyable ! Qu'est-ce que c'est que cette manie des aranaras de faire sursauter les gens comme ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310615,
					"content": "C'est toi, Blanchette-volante ! Avec ton « Ouah ! » si soudain...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310616
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310616,
					"content": "Je m'appelle Paimon, et pas Blanchette-volante ou je sais pas quoi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310617,
					"content": "Arana est à l'intérieur du sol en train de préserver la force de l'ararakalari. Comme ça, nara Rana ne fanera pas. Cependant, pour qu'elle soit forte à nouveau, on a besoin d'un bija.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310618
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310618,
					"content": "#Je vois. En parlant de ça, qu'est-il arrivé à {NICKNAME} à l'instant...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310619,
					"content": "(Décrire ce que vous venez de voir...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310620
					]
				},
				{
					"id": 730310620,
					"content": "Je pense que c'était un souvenir d'Arana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310621
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310621,
					"content": "Un souvenir...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310622,
					"content": "Arana va expliquer à Paimon. Les souvenirs et les rêves sont les pouvoirs des aranaras, ils sont les choses les plus précieuses pour nous. Avec eux, Arana est capable d'utiliser la force de l'ararakalari pour aider les naras et les aranaras dans le besoin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310623
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310623,
					"content": "#Certains naras sont capables de percevoir les souvenirs de l'ararakalari, comme {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310624
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310624,
					"content": "À t'entendre, l'ararakalari a l'air d'être quelque chose de très solennel ! Cette personne qui a utilisé l'ararakalari pour protéger Iotham dans la grotte, c'était toi, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310625,
					"content": "C'était bien Arana. Nara Iotham, nara Kavus et nara Sudabeh sont tous des amis d'Arana, donc Arana les protège.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310626
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310626,
					"content": "Ils vont souvent dans la forêt et jouent avec Arana. Arana leur apprend la forêt et le langage des fleurs et des plantes. Ce sont des amis très importants, comme nara Rana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310627
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310627,
					"content": "Peux-tu m'expliquer pour les enfants disparus...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310628
					]
				},
				{
					"id": 730310628,
					"content": "Oui, tiens ! Avant Iotham, c'est Kavus et Sudabeh qui ont disparu... pour finalement réapparaître au Village de Vimara. C'est toi qui es à l'origine de tout ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310629,
					"content": "Oui. Arana a vu de méchants naras et des naras des valukas les enlever. Arana a profité d'un moment d'inattention des méchants naras pour aider nara Kavus et nara Sudabeh a rentrer chez eux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310630,
						730310632
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310630,
					"content": "Je le savais...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310631
					]
				},
				{
					"id": 730310631,
					"content": "D'accord... mais pourquoi ne se souviennent-ils pas de tout ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310633
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310633,
					"content": "Arana a fait entrer les petits naras dans un rêve, ce qui a permis de leur enlever leurs mauvais souvenirs. De cette façon, comme les petits arbustes qui deviennent de grands arbres, les petits naras ne deviendront pas méchants quand ils grandiront.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310634
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310634,
					"content": "Sans ça, les petits naras auront toujours peur, et pendant longtemps. Ensuite, ils commenceront à croire au pouvoir de la peur. C'est alors qu'ils risquent de devenir des naras méchants qui font peur aux autres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310635
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310635,
					"content": "Ils sont amis avec Arana, donc Arana ne veut pas qu'ils deviennent des naras méchants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310636,
						730310638,
						730310640
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310636,
					"content": "Tu as raison.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310637
					]
				},
				{
					"id": 730310637,
					"content": "Ils deviendront de grands adultes ! Pendant qu'on y est, est-ce que tu as des informations sur ces naras méchants qui voulaient capturer les enfants ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310641
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310641,
					"content": "Arana ne les tolère pas. Ces naras méchants ne sont pas des enfants de la forêt et ils amènent des naras des valukas avec eux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310642
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310642,
					"content": "Au Village de Vimara, il y a un nara étrange. Ce n'est pas un enfant de la forêt, mais un enfant de la neige. Heureusement, on dirait bien que c'est un gentil nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310643
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310643,
					"content": "Il était souvent avec le petit nara, et le petit nara racontait beaucoup d'histoires sur lui. Mais Arana l'a vu parler avec les méchants nara, et en plus, ils parlaient des aranaras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310644
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310644,
					"content": "Au Village de Vimara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310645,
						730310646
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310645,
					"content": "Un collaborateur des Fatui ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310647
					]
				},
				{
					"id": 730310647,
					"content": "Comment est-ce possible ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310648
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310648,
					"content": "Ah... Je n'ose même pas imaginer ce genre de chose. Les gens du Village de Vimara sont censés être comme une famille... Et cette personne, c'est à cause d'elle que Rana est comme ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310649,
						730310650
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310649,
					"content": "Il faut attraper cet odieux personnage.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310651
					]
				},
				{
					"id": 730310651,
					"content": "Oui, on doit l'attraper coûte que coûte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310652
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310652,
					"content": "#Nara {NICKNAME}, Paimon, vous devez promettre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310653
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310653,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310654
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310654,
					"content": "Vous devez promettre de punir le méchant nara. Comme ça, nara Iotham, nara Kavus et nara Sudabeh n'auront plus jamais peur. Ils grandiront pour devenir de bons grands naras, comme le font les arbres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310655,
						730310656
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310655,
					"content": "Oui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310657
					]
				},
				{
					"id": 730310657,
					"content": "Nara Rana a bien grandi. Donc, elle ne peut plus voir Arana. Mais ce n'est pas grave, Arana est heureuse juste à l'idée de savoir qu'elle va bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310658
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310658,
					"content": "Ça fait très longtemps qu'Arana n'a pas joué avec nara Rana. Tant de soleils se sont levés et couchés, et la lune est même apparue dans le ciel. Tant de fruits ont poussé et sont retournés dans le sol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310659
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310659,
					"content": "Nara Rana n'a pas arrêté de grandir. Au début, elle faisait à peu près la même taille qu'Arana. Mais ensuite, elle est devenue aussi grande qu'un petit arbre. Après ça, elle n'est plus venue jouer avec Arana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310660
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310660,
					"content": "Arana lui a raconté beaucoup d'histoires sur la forêt. Les champitoiles sont le reflet des étoiles du ciel sur le sol. Si l'on voit un nilotpalotus fleurir, on aura de la chance jusqu'à ce que la lune se lève à nouveau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310661
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310661,
					"content": "Ces choses-là, Arana les enseigne aussi à nara Iotham et aux autres petits naras. Arana souhaite qu'ils grandissent aussi bien que nara Rana. Mais ils ne devraient jamais aller dans la Marana comme l'a fait Rana !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310662
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310662,
					"content": "Quand ils seront grands, est-ce qu'ils oublieront les histoires de la forêt ? Comme Rana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310663
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310663,
					"content": "Nara Iotham, nara Kavus et nara Sudabeh vont aussi grandir. Ce n'est pas grave s'ils oublient... À la fin, la forêt se souvient de tout. Rien ne disparaît.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310664
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310664,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310665
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310665,
					"content": "Rien ne disparaîtra. Toutes les bonnes choses ne s'effaceront pas. Toutes les douleurs viendront contribuer à l'apparition de bonnes choses...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310666
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310666,
					"content": "#Arana ! Nara {NICKNAME}, Paimon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310667
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310667,
					"content": "Arama ! Ça fait longtemps qu'Arana n'a pas vu Arama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310668,
						730310671
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310668,
					"content": "Tiens, tu n'as pas crié, Paimon ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310669
					]
				},
				{
					"id": 730310669,
					"content": "Non mais oh, je ne suis pas si facilement effrayée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310670
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310670,
					"content": "Arama, tu viens nous dire de retourner à Vanarana afin de fêter le Festival Utsava ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310672
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310672,
					"content": "#Oui ! Tout est prêt, il ne nous manque que nara {NICKNAME} et Paimon. Allez, on y va tous ensemble !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310673
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310673,
					"content": "Ouais ! Le Festival Utsava ! Mais Arana, tu n'y vas pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310674
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310674,
					"content": "Non, Arana n'y va pas. Si Arana s'en va d'ici trop longtemps, l'ararakalari risquera de s'effondrer et nara Rana sera en danger. Donc, Arana ne peut pas y aller.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310675
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310675,
					"content": "Oh non...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310676
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310676,
					"content": "#Ça ira. Si nara {NICKNAME} et Paimon sont {M#joyeux}{F#joyeuses}, Arana, Arama et tous les autres de Vanarana seront joyeux aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310677
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310677,
					"content": "Arana, le bija a besoin de ta force.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310678
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310678,
					"content": "Arana sera prête quand le moment sera venu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310679
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310679,
					"content": "#Ah oui, tiens, voilà pour toi, nara {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310680
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310680,
					"content": "Une petite fleur...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310681
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310681,
					"content": "Oui. Garde-la bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310682,
						730310683
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310682,
					"content": "J'en prendrai bien soin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310684
					]
				},
				{
					"id": 730310684,
					"content": "#Nara {NICKNAME}, merci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310685
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310685,
					"content": "#Retournons-y alors, nara {NICKNAME} et Paimon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310683,
					"content": "D'accord.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310684
					]
				},
				{
					"id": 730310671,
					"content": "On rentre pour le Festival Utsava ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310672
					]
				},
				{
					"id": 730310656,
					"content": "Je ferai de mon mieux.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310657
					]
				},
				{
					"id": 730310650,
					"content": "On va l'avoir, c'est sûr.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310651
					]
				},
				{
					"id": 730310646,
					"content": "Quelqu'un veut du mal aux enfants ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310647
					]
				},
				{
					"id": 730310638,
					"content": "Espérons-le.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310639
					]
				},
				{
					"id": 730310639,
					"content": "Ils deviendront de grands adultes ! Pendant qu'on y est, est-ce que tu as des informations sur ces naras méchants qui voulaient capturer les enfants ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310641
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310640,
					"content": "Dis-nous en plus sur les naras méchants...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310641
					]
				},
				{
					"id": 730310632,
					"content": "Explique-nous comment les enfants ont perdu la mémoire...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310633
					]
				},
				{
					"id": 730310613,
					"content": "J'ai une impression de déjà-vu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310614
					]
				}
			]
		},
