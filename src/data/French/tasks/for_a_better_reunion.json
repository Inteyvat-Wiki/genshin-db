					"nextDialogs": [
						730310310,
						730310311
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310310,
					"content": "Je me demande comment va Rana...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310315
					]
				},
				{
					"id": 730310315,
					"content": "#{NICKNAME}, allons voir Rana. Peut-être qu'elle va mieux ! Et on pourra l'amener ici !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310316,
						730310317,
						730310318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310316,
					"content": "Tu as raison.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310320
					]
				},
				{
					"id": 730310320,
					"content": "J'irai chercher Arana plus tard de mon côté. Allez-y vite !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310321
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310321,
					"content": "#Nara {NICKNAME} et Paimon, à bientôt !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310317,
					"content": "J'espère.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310320
					]
				},
				{
					"id": 730310318,
					"content": "Je ne suis pas très optimiste...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310319
					]
				},
				{
					"id": 730310319,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310311,
					"content": "Moi aussi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310312
					]
				},
				{
					"id": 730310312,
					"content": "Oui ! Je me demande comment ça sera différent des autres fêtes. En tout cas, pouvoir vivre une fête avec des amis, c'est vraiment génial !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310313,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310314,
					"content": "... Si seulement Rana était là avec nous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310306,
					"content": "Oui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310307
					]
				}
			]
