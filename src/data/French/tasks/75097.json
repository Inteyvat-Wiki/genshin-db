			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750970201,
					"content": "... Oui, il y a clairement quelque chose qui cloche. Tu ne parviens toujours pas à obtenir le pouvoir élémentaire de la Statue des Sept ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970202,
					"content": "Qu'est-ce qui ne va pas avec ces Statues des Sept ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970203,
						750970206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970203,
					"content": "Elles sont peut-être juste un peu vieilles et auraient besoin d'un peu d'entretien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970204
					]
				},
				{
					"id": 750970204,
					"content": "Mais elle brillait totalement quand tu l'as touchée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970205,
					"content": "Allez, Statue des Sept... Est-ce que tu fais correctement ton travail ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970208,
					"content": "Moi, je n'en ai aucune idée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970206,
					"content": "C'est peut-être parce que Natlan est particulière...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970207
					]
				},
				{
					"id": 750970207,
					"content": "Maintenant que tu le dis, il semblerait que Natlan ait été constamment affectée par l'influence de l'Abîme... Tu crois que ce serait à cause de ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970208
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7509703,
