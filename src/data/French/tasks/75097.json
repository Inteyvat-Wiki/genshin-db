			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750970101,
					"content": "Hein ? C'est moi ou les statues des Sept de Natlan sont un peu étranges ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970102,
					"content": "La première fois que tu la touches, la sensation ne devrait-elle pas être plus... intense ? Comme un genre de bourdonnement ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970103,
						750970105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970103,
					"content": "Je n'ai rien remarqué de spécial.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970104
					]
				},
				{
					"id": 750970104,
					"content": "Mais c'est quand même un peu étrange...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970108,
					"content": "Hmm, comment devrais-je le dire... Eh bien, j'ai toujours pensé qu'une connexion plus forte se créait lorsque tu touchais les statues...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970109,
					"content": "Cette fois, c'est plus comme appuyer sur un interrupteur. Il ne s'allume que lorsque tu le touches.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970110,
					"content": "C'est vrai ! Avant, lorsque tu touchais les Statues, tu pouvais ressentir la puissance élémentaire. Mais cette fois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970111,
					"content": "Est-ce qu'il y a cette sensation Pyro, quelque chose de vivant et intense ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970112,
						750970113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970112,
					"content": "(Vous cherchez en vous-même...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970114
					]
				},
				{
					"id": 750970114,
					"content": "Hein... Rien du tout...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970115,
					"content": "Je trouve que c'est étrange...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970113,
					"content": "(Il n'y a aucun signe de la sensation de chaleur à laquelle vous vous attendiez...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970114
					]
				},
				{
					"id": 750970105,
					"content": "En fait, le bourdonnement d'avant, c'était moi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970106
					]
				},
				{
					"id": 750970106,
					"content": "Oh ! Alors, tu as juste oublié de le faire cette fois-ci ? Eh bien, n'oublie pas la prochaine fois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970107,
					"content": "Mais oui, bien sûr ! Tu ferais mieux d'ajouter tes propres effets sonores chaque fois que tu touches une Statue des Sept !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970108
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7509702,
			"completionStepIds": [
				7509706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
