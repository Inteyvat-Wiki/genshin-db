				{
					"id": 222000504,
					"content": "Pas encore.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						222000505
					]
				},
				{
					"id": 222000505,
					"content": "Il me semble que le chef Mao du Restaurant Wanmin sait cuisiner la marmite de perche à dos noir. Tu pourrais aller lui demander.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000506
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000506,
					"content": "Pour ce qui est des œufs et graines de lotus à la vapeur, Gui l'herboriste devrait savoir comment faire. Il travaille au Cottage Bubu, à la Terrasse Yujing. Tu pourrais lui demander.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000507
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000507,
					"content": "J'ai entendu des marchands de Mondstadt dire que les pancakes du Bon Chasseur valaient le détour – et qu'ils remplissaient la panse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000508
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000508,
					"content": "Quant aux brochettes de poulet et de champignons... Rien de bien compliqué je pense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000509
					],
