			"dialogs": [
				{
					"id": 222000601,
					"content": "J'ai envie de manger de la perche-écureuil et du poulet pimenté de Jueyun... Il paraît qu'il existe tout un tas de plats de Mondstadt vraiment pas mauvais : le ragoût à la crème, les œufs au plat de Teyvat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000602
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000602,
					"content": "J'ai faim rien que d'y pens... *gargl* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000603
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000603,
					"content": "S'il te plaît, va me chercher quelque chose à manger... Que mon ventre arrête au moins pour la journée... *gargl* ...",
					"roleType": "TALK_ROLE_NPC",
