			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yicheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 222000201,
					"content": "Il paraît aussi que certains plats de Mondstadt valent le détour, comme le poisson grillé mondstadtois, le toast du pêcheur ou encore la soupe au lys calla et aux fruits de mer... *gargl* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000202
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000202,
					"content": "S'il te plaît, tu pourrais m'amener le plat qui à tes yeux a le plus de chances de me remplir le ventre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000203
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000203,
					"content": "Avec ça dans le ventre, mon estomac arrêtera au moins pour la journée j'espère...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yicheng"
				}
			]
		},
