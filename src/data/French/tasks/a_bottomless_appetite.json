					"nextDialogs": [
						222000706
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000706,
					"content": "J'ai entendu des marchands de Mondstadt dire que Le Bon Chasseur servait du ragoût à la crème, je ne sais pas ce qu'il vaut...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000707
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000707,
					"content": "Et puis il reste toujours les œufs au plat, rien de bien compliqué... *gargl* ...",
