			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yicheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 222000101,
					"content": "Bonjour ! Je peux... *gargl* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000102
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000102,
					"content": "Mon ventre n'arrête pas... Je voulais dire, je peux t'aider ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000103
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000103,
					"content": "Euh, pardon ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						222000104
					]
				},
				{
					"id": 222000104,
					"content": "*soupir* Mon estomac fait un bruit pas possible à chaque fois que j'ai faim... Au point de couvrir ce que je dis, c'est te dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000105
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000105,
					"content": "J'ai beau... *gargl* avoir été au Cottage Bubu, le médecin m'a dit que ce n'était pas une maladie, mais juste mon ventre quand j'ai faim... Ça ne se *gargl* soigne pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000106
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000106,
					"content": "Tant que je mange à ma faim, pas de problème. Mais... Je mange déjà plus que n'importe qui, et ça n'arrête pas. Si je mange davantage, je n'aurai plus un mora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000107
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000107,
					"content": "Jiayi m'a conseillé de grignoter entre les repas si je n'ai pas mangé à ma faim, pour qu'au moins ça n'influence pas le boulot...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000108
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000108,
					"content": "Mais... J'ai envie de grignoter un tas de trucs, et je n'ai aucune idée de ce qui serait le plus efficace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000109
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000109,
					"content": "#{M#Voyageur}{F#Voyageuse}, toi qui passe ton temps dehors, tu dois bien savoir quel genre de nourriture tient au ventre, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000110
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000110,
					"content": "Autant que tu m'aides à choisir parmi la liste de ce qui me fait envie le meilleur plat, et le plus consistant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000111
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000111,
					"content": "Qu'est-ce qui te fait envie cette fois-ci ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						222000112
					]
				},
				{
					"id": 222000112,
					"content": "Bon, qu'est-ce qui me fait envie... Il y a l'embarras du choix.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yicheng"
				}
			]
		},
		{
			"id": 2220002,
			"completionStepIds": [
				2220002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
