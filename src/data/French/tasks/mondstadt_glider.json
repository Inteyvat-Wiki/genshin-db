			"dialogs": [
				{
					"id": 4270401,
					"content": "Je crois que tu t'en sors bien ! Passons à la dernière étape.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270402
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270402,
					"content": "Tu as déjà plané dans cette direction auparavant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4270403,
					"content": "Tu pourras obtenir ton permis de planer après avoir réussi cette dernière épreuve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270404
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270404,
					"content": "#Concentre-toi sur le permis. {M#Prêt}{F#Prête}...",
