				},
				{
					"id": 741920402,
					"content": "Canotila ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920403
					]
				},
				{
					"id": 741920403,
					"content": "#Ah ? Vous êtes enfin de retour ! Je me faisais du souci ! Que se serait-il passé si vous n'étiez jamais {M#revenu}{F#revenue} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920404
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920404,
					"content": "#Après votre départ, je vous ai {M#attendu}{F#attendue} dehors pendant très longtemps. J'ai demandé de l'aide à d'autres mélusines, mais personne ne savait quoi faire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920405
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920405,
					"content": "(... Je crois que je suis ici depuis assez longtemps.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920406
					]
				},
				{
					"id": 741920406,
					"content": "Je dois y aller.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920407
					]
				},
				{
					"id": 741920407,
					"content": "#Hein ? {NICKNAME}, où allez-vous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920408
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920408,
					"content": "Ne vous inquiétez pas. Je reviendrai dès que je vous aurai trouvé, Canotila.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920409
					]
				},
				{
					"id": 741920409,
					"content": "Attendez-moi encore juste un petit moment, d'accord ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920410
					]
				},
				{
					"id": 741920410,
					"content": "Même si je sais que ça ne changera rien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920411,
						741920412
					]
				},
				{
					"id": 741920411,
					"content": "Croyez-moi.",
					"roleType": "TALK_ROLE_PLAYER",
