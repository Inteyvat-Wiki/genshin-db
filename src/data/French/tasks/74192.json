			"dialogs": [
				{
					"id": 741920101,
					"content": "Je vois que les flammes sur le trône se sont éteintes et que les cendres brûlées sont redevenues des arbres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920102
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920102,
					"content": "Les fleurs s'épanouissent à mesure que vous vous avancez, apportant un changement dans un avenir en déclin inévitable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920103
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920103,
					"content": "Canotila ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920104
					]
				},
				{
					"id": 741920104,
					"content": "#Ah, c'est {NICKNAME} ! Que faites-vous ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920105
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920105,
					"content": "Ah, c'est vrai ! Le papillon doré est revenu, je dois aller le voir ! À plus tard !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canotila"
				}
			]
		},
