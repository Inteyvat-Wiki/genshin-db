			"dialogs": [
				{
					"id": 741920201,
					"content": "*sniff* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920202
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920202,
					"content": "Canotila...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920203
					]
				},
				{
					"id": 741920203,
					"content": "#Hein ? {M#Monsieur}{F#Mademoiselle} {NICKNAME}... Qui êtes-vous ? Je croyais que personne d'autre que moi ne pouvait entrer ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920204
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920204,
					"content": "Comment connaissez-vous mon nom ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920205,
						741920207
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920205,
					"content": "On se connaît.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920206
					]
				},
				{
					"id": 741920206,
					"content": "Menteur ! Vous devez être comme ces monstres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920207,
					"content": "(Mentir...) C'est Serene qui m'a dit de venir vous chercher.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920208
					]
				},
				{
					"id": 741920208,
					"content": "Oh. Je suis vraiment une mauvaise fille... Elle s'inquiète toujours pour moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920209
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920209,
					"content": "#Je suis {NICKNAME}, vous vous rappelez ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920210
					]
				},
				{
					"id": 741920210,
					"content": "#{NICKNAME}, je me souviens... C'est un énorme monstre capable d'avaler le monde en une seule bouchée, mais il est gentil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920211,
						741920213
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920211,
					"content": "Ce n'est pas très gentil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920212
					]
				},
				{
					"id": 741920212,
					"content": "Je suis désolée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920214
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920214,
					"content": "Qu'est-ce qui s'est passé ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920215
					]
				},
				{
					"id": 741920215,
					"content": "J'ai vu certaines personnes fondre lentement et se transformer en monstres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920216
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920216,
					"content": "Ah, quelle horreur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920213,
					"content": "Merci.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920214
					]
				}
			]
		},
