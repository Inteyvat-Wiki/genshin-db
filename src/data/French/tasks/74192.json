			"dialogs": [
				{
					"id": 741920301,
					"content": "Puisque les souvenirs peuvent devenir des récits de livres, l'inverse peut aussi être possible...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920302
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920302,
					"content": "Canotila ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920303
					]
				},
				{
					"id": 741920303,
					"content": "#Ah, c'est {NICKNAME} {M#le monsieur}{F#la demoiselle} étrange. Qu'est-ce qui vous amène ici ? Vous avez besoin de quelque chose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920304
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920304,
					"content": "De quoi vous parlez...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920305
					]
				},
				{
					"id": 741920305,
					"content": "Hmm, j'ai beau y penser sous tous les angles, transformer des souvenirs en livre est un véritable exploit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920306
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920306,
					"content": "Le créateur de cet ouvrage a pu y arriver parce qu'il considérait sans doute les émotions qu'il a éprouvées dans ses souv{RUBY#[D]délires}enirs comme la chose la plus précieuse du monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920307
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920307,
					"content": "Mais ça ne change pas le fait que son contenu soit très difficile à comprendre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920308
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920308,
					"content": "... Et on ne sait pas quel effet ça aura sur les « lecteurs ». C'est tellement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canotila"
				}
			]
		},
