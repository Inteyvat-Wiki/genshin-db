			"dialogs": [
				{
					"id": 6080101,
					"content": "Pfiou, ça faisait longtemps que je n'avais pas électrocuté des gens pendant la Fête des alizées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080102
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 6080102,
					"content": "Ça arrivait beaucoup avant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080103
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 6080103,
					"content": "Que j'électrocute des gens ? Haha ! Non, pas vraiment. Juste une fois de temps en temps. Ça fait du bien de se défouler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080104
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 6080104,
					"content": "Mon ancien professeur m'en a même reparlé dans une lettre il y a quelques jours. Évidemment, j'ai bien insisté sur le fait que je traitais toujours les autres avec gentillesse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080105
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 6080105,
					"content": "C'est normal d'adopter la manière de faire de son professeur. Le mien était un gentil vieil homme du Spantamad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080106
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 6080106,
					"content": "Tu vois, cette fois-ci, je n'ai utilisé que des méthodes d'électrocution douces. Elles sont tellement douces que Jean n'aurait rien à redire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080107
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 6080107,
					"content": "On peut donc électrocuter des gens avec douceur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080108
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 6080108,
					"content": "Vous avez l'air de bonne humeur, mademoiselle Lisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080109
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 6080109,
					"content": "Disons que ça fait du bien de se dégourdir les jambes parfois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				}
			]
		},
