			},
			"dialogs": [
				{
					"id": 240100301,
					"content": "On ne peut pas être trop limité par des formes concrètes... Il faut faire ressortir la beauté et utiliser des méthodes symboliques...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100302
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100302,
					"content": "Non, non... Toujours non. Cette composition est trop intentionnelle...",
					"roleType": "TALK_ROLE_NPC",
