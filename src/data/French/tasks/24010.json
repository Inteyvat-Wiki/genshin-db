				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240100101,
					"content": "C'est une bonne idée... Mais est-ce que ça pourrait vraiment fonctionner...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100102
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100102,
					"content": "Alors, cette peinture ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100103
					]
				},
				{
					"id": 240100103,
					"content": "#Ah, c'est vous ! Merci pour votre aide avec les photos{NON_BREAK_SPACE}! Elles étaient vraiment inspirantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100104
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100104,
					"content": "J'ai déjà une idée approximative, et j'ai fait quelques tentatives, mais... Eh bien, elles ne sont pas à la hauteur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100105
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100105,
					"content": "Ne vous méprenez pas, je n'ai pas fait que des gribouillis sans aucune valeur esthétique non plus, mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100106
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100106,
					"content": "J'ai l'impression qu'il leur manque un petit truc en plus, ce quelque chose qui leur permettra de transcender l'ordinaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100107
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100107,
					"content": "Il y a quelque chose de trop... concret dans les choses que j'ai en tête. Si je les transpose directement sur la toile, ça ne fera pas honneur à la beauté que je souhaite transmettre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100108
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100108,
					"content": "*soupir* Je crains que ce soit un problème auquel chaque artiste doit faire face...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100109,
						240100119
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100109,
					"content": "Peut-être pourriez-vous essayer de peindre autre chose ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100110
					]
				},
				{
					"id": 240100110,
					"content": "Merci pour la suggestion, mais je crains que ce problème ne puisse pas être résolu par un simple changement de sujet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100111
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100111,
					"content": "Qu'il s'agisse de montagnes et de rivières, d'oiseaux et de bêtes, ou de notre société... Ce problème n'épargne personne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100112
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100112,
					"content": "C'est précisément dans leur recherche d'une solution que certains de mes collègues ont décomposé et transformé les paysages qu'ils ont vus en utilisant leurs émotions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100113
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100113,
					"content": "Un tel art met l'accent sur les émotions profondes avant tout, et le résultat sur la toile est... Comment puis-je l'expliquer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100114
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100114,
					"content": "Eh bien, qu'il s'agisse de personnages, de décors... Même la lumière porte un sentiment d'étrangeté qu'aucun sens esthétique traditionnel ne peut capturer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100115
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100115,
					"content": "Un regard simpliste conduirait la plupart à croire que ces peintures sont les idées de personnes ne connaissant rien à l'art, ou de fous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100116
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100116,
					"content": "Mais si vous vous concentrez et embrassez l'œuvre d'art devant vous, vous l'entendrez rugir au nom de l'artiste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100117
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100117,
					"content": "Ce rugissement vient du cœur et de l'âme de l'artiste, exprimant ses sentiments à haute voix... Et ces sentiments sont, le plus souvent, plus intenses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100118
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100118,
					"content": "Pourtant, leurs voix ne peuvent pas être perçues par l'oreille, uniquement par le cœur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100124
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100124,
					"content": "Quant à moi... Je ne veux pas encore céder sur le concret, alors j'ai trouvé une autre solution.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100125
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100125,
					"content": "J'ai décidé de me concentrer sur la couleur, et j'ai donc besoin de trouver des nuances plus fortes et des traits simples, mais puissants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100126
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100126,
					"content": "En même temps, j'ai besoin d'affaiblir l'éclairage et les compositions de scènes traditionnelles... Ces choses vont affecter mon expression, et je dois donc leur demander de quitter temporairement la scène...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100127
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100127,
					"content": "Mais le problème est que les couleurs fortes et intenses dictent l'utilisation de beaucoup de peinture et que je dois presser la peinture directement sur la toile pour obtenir l'effet nécessaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100128
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100128,
					"content": "Donc, je n'ai... Euh, plus de peinture. Cependant, je ne peux pas simplement déplacer mon chevalet pour le moment. Cela affecterait sûrement mon travail créatif...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100129
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100129,
					"content": "#{M#Voyageur}{F#Voyageuse}, pourrais-je vous demander de vous rendre chez Boucicaut ? Je lui ai commandé un lot de bonnes peintures, et elles devraient être prêtes maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100130
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100130,
					"content": "Ou peut-être... Pourriez-vous m'aider à trouver du nectar de fleur mensongère ? Ainsi, je pourrais faire un lot de peintures moi-même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100131,
						240100134
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100131,
					"content": "Vous pouvez utiliser du nectar pour faire de la peinture ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100132
					]
				},
				{
					"id": 240100132,
					"content": "Haha, bien sûr. Certains de mes collègues utilisent même des œufs d'oiseau !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100133
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100133,
					"content": "Il paraît que les peintures de ce type ont des couleurs délicates, mais des couches riches, parfaites pour représenter des paysages resplendissants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100136
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100136,
					"content": "Vous avez bon cœur, n'est-ce pas ? Vous ne refuseriez pas la requête d'un artiste ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100137,
						240100138
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100137,
					"content": "D'accord...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100139
					]
				},
				{
					"id": 240100139,
					"content": "D'accord, merci beaucoup ! Je vais attendre ici. Amenez-les-moi dès que vous les aurez, s'il vous plaît.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100138,
					"content": "Vous êtes irrécupérable... Je vais m'en occuper.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100139
					]
				},
				{
					"id": 240100134,
					"content": "Vous fabriquez vous-même des peintures ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100135
					]
				},
				{
					"id": 240100135,
					"content": "Haha, bien sûr ! C'est la première chose que vous devez apprendre en tant que peintre. C'est ainsi que vous gardez le contrôle sur l'image que vous créez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100136
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100119,
					"content": "Pourquoi ne pas essayer un autre style ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100120
					]
				},
				{
					"id": 240100120,
					"content": "Hmm, certains de mes collègues y ont pensé, et ils tentent actuellement d'utiliser des méthodes de peinture « figuratives » pour obtenir quelque chose de plus abstrait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100121
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100121,
					"content": "#Les plus radicaux d'entre eux souhaitent même abandonner complètement la représentation d'objets concrets et utiliser simplement des taches de peinture pour s'exprimer... Ils se disent «{NON_BREAK_SPACE}néodescriptionnistes{NON_BREAK_SPACE}».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100122
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100122,
					"content": "Mais je dois dire que même moi, je ne peux pas tout à fait saisir leur travail. Tout au plus, je ne peux que ressentir la beauté rythmique contenue dans les taches colorées et le travail au trait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100123
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100123,
					"content": "Quant à ce qu'exprime vraiment telle ou telle peinture... Je ne peux que demander à l'auteur de me l'expliquer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100124
					],
					"speakerTitle": "Depierris"
				}
			]
		},
		{
