	"talks": [
		{
			"id": 2401001,
			"completionStepIds": [
				2401001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2401001",
							"2"
						],
						"stepId": 2401001,
