			"dialogs": [
				{
					"id": 240100201,
					"content": "Bonjour, vous souhaitez acheter quelque chose en particulier ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100202
					],
					"speakerTitle": "Boucicaut"
				},
				{
					"id": 240100202,
					"content": "À propos des peintures de Depierris...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100203
					]
				},
				{
					"id": 240100203,
					"content": "Oh, vous venez chercher ses peintures ? Elles sont prêtes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100204
					],
					"speakerTitle": "Boucicaut"
				},
				{
					"id": 240100204,
					"content": "Il les termine vraiment vite. On dirait qu'il les jette directement dans l'eau après les avoir achetées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100205
					],
					"speakerTitle": "Boucicaut"
				},
				{
					"id": 240100205,
					"content": "Bon, les peintures qu'il a achetées sont toutes ici. Apportez-les-lui, s'il vous plaît.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Boucicaut"
				}
			]
		},
		{
