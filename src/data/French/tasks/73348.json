			"dialogs": [
				{
					"id": 733480101,
					"content": "Mais... Sans ces échantillons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480102,
						733480103
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480102,
					"content": "À propos des Purbiruni...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480104
					]
				},
				{
					"id": 733480104,
					"content": "Oui, et le herbad actuel. Qu'est-ce qui vous amène ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480105
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480105,
					"content": "#Des questions académiques, peut-être ? Vous ne ressemblez pas vraiment à {M#un chercheur}{F#une chercheuse} de l'Académie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480106
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480106,
					"content": "À propos de la lettre de recommandation de Khedive...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480107
					]
				},
				{
					"id": 733480107,
					"content": "Cette lettre a-t-elle vraiment été écrite par Khedive ? Laissez-moi voir ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480108
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480108,
					"content": "Hmm, donc ses recherches au Gouffre se passent bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480109
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480109,
					"content": "... Recherche sur les champignons... environnement aquatique... fossiles... caractéristiques géologiques uniques... échantillons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480110
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480110,
					"content": "Génial, parfait, époustouflant ! Il est toujours aussi astucieux et exceptionnel. C'était certain qu'il répondrait aux attentes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480111
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480111,
					"content": "Hmm... Je déteste admettre cela devant un étranger, mais les chercheurs des Pursina sont vraiment doués...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480112
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480112,
					"content": "De plus, Khedive a souligné plusieurs fois vos contributions exceptionnelles dans sa lettre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480113
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480113,
					"content": "Grâce à votre aide, ses recherches se sont déroulées « comme sur des boulettes », n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480114,
						733480115
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480114,
					"content": "Pitié, pas ça...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480116
					]
				},
				{
					"id": 733480116,
					"content": "Ah bon ? Hmm, désolé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480117
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480117,
					"content": "Un autre chapitre glorieux des annales académiques des Pursina sera écrit à son retour à l'Académie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480118
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480118,
					"content": "#Euh... Et l'amitié millénaire entre Purbiruni et Pursina sera encore renforcée{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480119
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480119,
					"content": "#Veuillez accepter ma gratitude, {NICKNAME}, au nom des Purbiruni et des Pursina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480120
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480120,
					"content": "Ah, j'ai failli oublier ! Il m'a également demandé de préparer des cadeaux pour vous dans la lettre... Pas de problème, juste un instant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480121
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480121,
					"content": "Pas une autre lettre, par pitié...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480122
					]
				},
				{
					"id": 733480122,
					"content": "#Bien sûr que non ! Pour votre travail acharné dans les recherches de Khedive, il est normal que vous soyez {M#récompensé}{F#récompensée} en moras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480123
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480123,
					"content": "Mais... Veuillez m'excuser. La journée a été très chargée, je n'ai pas emporté grand-chose avec moi. Veuillez patienter un moment ici, je vous prie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480124
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480124,
					"content": "Un autre chercheur très fier, hein ? Mais... Il semble vraiment différent de Khedive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480125,
					"content": "Il a l'air... pauvre en fait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480126,
					"content": "C—Comment ? Nous, les Purbiruni, sommes des chercheurs nés, nous ne nous soucions jamais des problèmes monétaires...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480127
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480127,
					"content": "Nous investissons la majeure partie de notre argent dans nos recherches. Pour tout le reste... on se serre la ceinture.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480128
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480128,
					"content": "Mais cela n'interfère jamais avec nos recherches. Au contraire, la libération des choses matérielles nous permet de voir d'autant plus clairement le chemin de la sagesse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480129
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480129,
					"content": "Je vais bientôt aller chercher votre paiement. Mais avant cela, j'ai une faveur à vous demander...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480130
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480130,
					"content": "#Khedive vous a décrit comme {M#un aventurier}{F#une aventurière} d'élite {M#vigoureux, expérimenté et exceptionnel}{F#vigoureuse, expérimentée et exceptionnelle} comme on en voit rarement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480131
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480131,
					"content": "Si, et j'insiste sur le « si », vous le voulez bien, pourriez-vous m'accorder une faveur, s'il vous plaît ? Il n'y a pas si longtemps, j'explorais le désert seul pour des recherches géologiques...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480132
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480132,
					"content": "Et... je n'ai pas embauché de garde parce que... j'étais à court de moras. Je pensais qu'un voyage rapide serait sûr, et qu'il n'y aurait pas de problème...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480133
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480133,
					"content": "Mais je n'ai pas eu de chance et j'ai croisé des Pilleurs de trésors sur le chemin du retour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480134
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480134,
					"content": "J'ai réussi à m'échapper vers la ville sans être blessé, mais ils ont pris la malle contenant mes notes et tous les échantillons géologiques.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480135
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480135,
					"content": "Cette malle n'a aucune valeur pour les marchands ni les Pilleurs de trésors... Mais j'y tiens comme à la prunelle de mes yeux ! Pour moi, sa valeur est inestimable !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480136
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480136,
					"content": "#Je n'ai pas eu la chance de trouver un aventurier assez gentil pour m'aider... {M#Voyageur}{F#Voyageuse}, accepteriez-vous de m'aider, s'il vous plaît ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480137,
						733480138
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480137,
					"content": "Je vais vous aider.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480139
					]
				},
				{
					"id": 733480139,
					"content": "Je ne sais pas comment vous remercier ! Sans vous, je ne sais pas ce que je ferais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480140
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480140,
					"content": "#J'ai marqué l'endroit où j'ai été attaqué. La malle ne devrait donc pas être loin{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480138,
					"content": "Vous pouvez compter sur moi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480139
					]
				},
				{
					"id": 733480115,
					"content": "L'entendre de la bouche de Khedive était largement suffisant...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480116
					]
				},
				{
					"id": 733480103,
					"content": "Excusez-moi, êtes-vous un chercheur des Purbiruni ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480104
					]
				}
			]
		},
