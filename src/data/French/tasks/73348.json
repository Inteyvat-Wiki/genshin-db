			"dialogs": [
				{
					"id": 733480301,
					"content": "#{M#Voyageur}{F#Voyageuse}, vous êtes de retour ! À propos de ma malle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480302,
						733480303
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480302,
					"content": "La voici.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480304
					]
				},
				{
					"id": 733480304,
					"content": "Excellent ! Merci beaucoup... Dire que vous avez une lettre de recommandation, et je vous fais encore travailler... Veuillez accepter ce paiement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480305,
						733480311
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480305,
					"content": "Comme disent toujours les Purbiruni...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480306
					]
				},
				{
					"id": 733480306,
					"content": "Hein ? Vous connaissez ça ? Oui, les Purbiruni ont ce commandement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480307
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480307,
					"content": "Mais cet avertissement vise à empêcher le non-respect des principes de la recherche pour des raisons monétaires ou externes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480308
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480308,
					"content": "Après tout, un chercheur qui effectue des recherches dans un but lucratif... n'est pas digne de ce titre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480309
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480309,
					"content": "Mais vous vous êtes donné tant de mal pour m'aider, vous méritez donc une récompense à la hauteur de vos efforts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480310
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480310,
					"content": "Merci encore pour votre aide et n'hésitez pas à me contacter si vous avez besoin de quoi que ce soit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480311,
					"content": "« La sagesse ne s'achète pas », en d'autres termes ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480306
					]
				},
				{
					"id": 733480303,
					"content": "Nous l'avons retrouvée.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480304
					]
				}
			]
