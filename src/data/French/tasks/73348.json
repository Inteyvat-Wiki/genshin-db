			"dialogs": [
				{
					"id": 733480901,
					"content": "*soupir* Ce financement dérisoire ne sera jamais suffisant pour mes recherches...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480902,
						733480903
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480902,
					"content": "Euh, excusez-moi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480904
					]
				},
				{
					"id": 733480904,
					"content": "Un chercheur des Purbiruni ? Vous devez chercher Sadife. Une visite pour lui... C'est plutôt rare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480905
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480905,
					"content": "Il est revenu à l'Académie récemment, il ne devrait donc pas être loin... C'est à quel sujet ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480906
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480906,
					"content": "À propos de la lettre de recommandation de Khedive...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480907
					]
				},
				{
					"id": 733480907,
					"content": "Khedive ? Donc ses recherches sont terminées ? Être riche doit être agréable, avoir toute une équipe d'observation pour le soutenir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480908
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480908,
					"content": "Moi ? Je ne peux même pas obtenir de subvention pour une sortie sur le terrain...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480909
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480909,
					"content": "Vous connaissez Khedive ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480910
					]
				},
				{
					"id": 733480910,
					"content": "Bien sûr ! Nous, pauvres chercheurs, qui dépendons de financements et ne gagnons jamais de moras, nous connaissons tous sa fabuleuse richesse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480911
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480911,
					"content": "Waouh, vous voulez dire... que ce Khedive... et les chercheurs de sa famille, ils sont tous riches ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480912,
					"content": "On va donc recevoir une grosse récompense ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480913,
					"content": "Certainement pas. Khedive est une exception. N'allez pas vous faire de fausses idées sur les chercheurs des Purbiruni et des Pursina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480914
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480914,
					"content": "Notamment ceux qui ont une majeure en astrologie et une mineure en histoire et en biologie... Dans leur domaine, les malchanceux voient même leurs demandes de financement complètement refusées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480915
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480915,
					"content": "De plus, ils répètent toujours quelque chose comme « La sagesse ne s'achète pas »...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480916
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480916,
					"content": "Hmm, je n'aurais pas dû dire ça... Voilà votre homme. Allez lui demander tout ce que vous voulez savoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480903,
					"content": "À propos d'un chercheur des Purbiruni...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480904
					]
				}
			]
