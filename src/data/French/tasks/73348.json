			"dialogs": [
				{
					"id": 733480401,
					"content": "#Regardez qui voilà ! Avez-vous trouvé un Purbiruni ? Pas si dur, n'est-ce pas{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480402,
						733480403
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480402,
					"content": "Nous en avons trouvé un, mais...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480404
					]
				},
				{
					"id": 733480404,
					"content": "Hmm ? Arrêtez de mâcher vos mots et crachez le morceau. Est-ce que quelqu'un vous a donné du fil à retordre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480405
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480405,
					"content": "Vous racontez à Khedive tout ce qui s'est passé avec Sadife...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						733480406
					]
				},
				{
					"id": 733480406,
					"content": "Ah, Sadife... Il est connu pour son entêtement, même ses professeurs ne peuvent pas toujours le comprendre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480407
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480407,
					"content": "Il refuse même toutes les sources de financement et insiste pour travailler seul, pour « conserver la pureté de sa recherche »...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480408
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480408,
					"content": "C'est donc vrai que « La sagesse ne s'achète pas » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480409,
					"content": "Eh bien, c'est la règle des Purbiruni... Haha, les Pursina sont beaucoup plus flexibles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480410
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480410,
					"content": "Eh bien... Pas exactement, c'est juste que j'ai beaucoup de moras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480411,
						733480412
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480411,
					"content": "Comment avez-vous gagné votre argent ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480413
					]
				},
				{
					"id": 733480413,
					"content": "C'est quoi ce scepticisme ? J'ai gagné ma richesse en travaillant dur, d'accord ? Savez-vous à quel point il est difficile de faire des transactions à terme ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480414,
						733480415
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480414,
					"content": "Des transactions à terme ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480416
					]
				},
				{
					"id": 733480416,
					"content": "C'est ça... Il faut connaître les volumes de transactions, les tendances du marché, et ensuite prendre les bonnes décisions d'investissement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480417
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480417,
					"content": "Au début, je pensais que j'investirais un peu pour le plaisir, je ne voulais pas que cela impacte mes recherches...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480418
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480418,
					"content": "Qui aurait pu s'attendre à ça... J'ai gagné de plus en plus de moras, et l'argent que j'avais investi n'a cessé d'augmenter...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480419
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480419,
					"content": "Je suis un chercheur professionnel ! Mes intérêts résident dans la recherche et le travail académique ! Ce sont les résultats académiques que je recherche, pas les moras ! C'est ce que je m'étais dit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480420
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480420,
					"content": "Cependant, chaque fois que je suis dans la Ville de Sumeru, je suis attiré par l'Échange et je me retrouve à négocier des transactions à terme les unes après les autres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480421
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480421,
					"content": "Alors mes ressources n'ont cessé d'augmenter, tandis que mes recherches... C'est le surplace COMPLET !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480422
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480422,
					"content": "Voilà où j'en suis ! J'ai embauché toute une équipe pour une expédition au Gouffre. Rester loin de tout centre d'échange est le seul moyen pour moi de faire des recherches !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480423
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480423,
					"content": "Sans résultats satisfaisants, je... Je ne sortirai pas du Gouffre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480415,
					"content": "Vous gagnez de l'argent grâce aux transactions à terme ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480416
					]
				},
				{
					"id": 733480412,
					"content": "Comment êtes-vous devenu si riche ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480413
					]
				},
				{
					"id": 733480403,
					"content": "Quelque chose est arrivé...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480404
					]
				}
			]
