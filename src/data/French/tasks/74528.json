			"dialogs": [
				{
					"id": 745280401,
					"content": "Ah, c'est vous. Nos chemins se croisent à nouveau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280402,
						745280403
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 745280402,
					"content": "Skirk, ça faisait longtemps.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280404
					]
				},
				{
					"id": 745280404,
					"content": "J'observe les « cicatrices » laissées sur ce monde. Une explosion a détruit cet endroit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280405
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 745280405,
					"content": "Mais aujourd'hui, les gens ont construit quelque chose de nouveau sur ces ruines.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280406
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 745280406,
					"content": "Toute chose a une fin, mais après le déclin, de nouvelles possibilités peuvent naître.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280407
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 745280407,
					"content": "#Vous êtes {M#devenu}{F#devenue} plus {M#fort}{F#forte} depuis notre dernière rencontre. Je vois que vous n'avez pas négligé votre entraînement. C'est bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280408,
						745280409
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 745280408,
					"content": "En vérité, j'ai un petit service à vous demander...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280410
					]
				},
				{
					"id": 745280410,
					"content": "Une photo ? Pour ce monde, je ne suis qu'une passante éphémère, alors pourquoi laisser une trace de mon existence ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280411,
						745280412
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 745280411,
					"content": "Mais pour moi, vous n'êtes pas qu'une simple passante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280413
					]
				},
				{
					"id": 745280413,
					"content": "... Puisque c'est ce que vous voulez, alors allez-y.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280414
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 745280414,
					"content": "On peut commencer quand vous voulez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Skirk"
				},
				{
					"id": 745280412,
					"content": "Toute retrouvaille mérite d'être célébrée.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280413
					]
				},
				{
					"id": 745280409,
					"content": "J'aimerais prendre une photo de vous.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280410
					]
				},
				{
					"id": 745280403,
					"content": "Qu'est-ce que vous faites ici ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280404
					]
				}
			]
		}
