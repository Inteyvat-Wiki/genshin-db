					"Flora"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200720401,
					"content": "Hé, par ici, par ici !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720402
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720402,
					"content": "Tu te souviens des fleurs que je t'ai demandé de déposer aux Monts Dosdragon ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720403
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720403,
					"content": "Ça fait déjà un jour, et j'aimerais bien voir l'effet qu'a eu le froid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720404
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720404,
					"content": "Pourrais-tu y retourner pour les ramasser et me les rapporter ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720405,
						200720407
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720405,
					"content": "Pas de problème.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200720406
					]
				},
				{
					"id": 200720406,
					"content": "Merci beaucoup ! Je vais attendre ici. Et reviens vite, hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720407,
					"content": "Je ne me souviens plus où je les ai mises...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200720408
					]
				},
				{
					"id": 200720408,
					"content": "Tu as oublié ? <color=#00E1FFFF>En dessous d'une Statue des Sept</color>, au <color=#00E1FFFF>bord d'une étendue d'eau</color> et aussi à l'<color=#00E1FFFF>entrée d'une grotte</color> !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720409
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720409,
					"content": "Laisse-moi te montrer à nouveau sur la carte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		}
	]
