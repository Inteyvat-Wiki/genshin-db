			"dialogs": [
				{
					"id": 200720301,
					"content": "Alors ? Et les fleurs enterrées ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720302
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720302,
					"content": "Avec celles-là, le compte est bon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200720303
					]
				},
				{
					"id": 200720303,
					"content": "Tu as tout récupéré ? C'est génial, montre-moi vite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720304
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720304,
					"content": "Voyons... C'est pas mal ça, oui... On dirait que c'est une méthode efficace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720305
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720305,
					"content": "Par contre, les Monts Dosdragon sont trop éloignés de Mondstadt. Je ne peux pas te déranger comme ça tous les deux jours. Je dois trouver une solution plus pratique...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720306
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720306,
					"content": "Quoi qu'il en soit, merci pour ton aide ! Prends ça comme remerciement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
		{
			"id": 2007204,
