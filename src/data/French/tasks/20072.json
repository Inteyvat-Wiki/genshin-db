			"dialogs": [
				{
					"id": 200720101,
					"content": "Alors ? Et les fleurs enterrées ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720102
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720102,
					"content": "Je n'ai pu récupérer qu'une boîte...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200720103
					]
				},
				{
					"id": 200720103,
					"content": "Tu n'as pas pu ramener les autres ? Euh... Ce n'est pas grave. Après tout, il est difficile de prévoir ce qui peut arriver dans les Monts Dosdragon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720104
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720104,
					"content": "Mais je ne peux rien comparer avec une seule boîte. Il me faudra attendre une autre occasion...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720105
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720105,
					"content": "Ça n'a pas dû être facile... Voilà une récompense ! J'aurai peut-être encore besoin de ton aide une prochaine fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
