					"Bolai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223060201,
					"content": "#Bonjour mon {M#ami}{F#amie} ! Vous cherchez quelque chose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060202
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223060202,
					"content": "Des cartes aux trésors.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223060203
					]
				},
				{
					"id": 223060203,
					"content": "Des cartes au trésor ? Oh, celles de Zhangsun ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060204
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223060204,
					"content": "Vous voulez aller les chercher ces trésors ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060205
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223060205,
					"content": "#Quelle {M#aventurier}{F#aventurière} ! Votre regard s'est illuminé au mot « trésors ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060206
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223060206,
					"content": "Je ne peux rien faire avec ces cartes, alors autant vous les donner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060207
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223060207,
					"content": "En contrepartie, pensez bien à partager équitablement le butin s'il y en a un.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060208
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223060208,
					"content": "Je les ai gardées si longtemps que je mérite un petit quelque chose quand même...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bolai"
				}
			]
		},
