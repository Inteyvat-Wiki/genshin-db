			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhangshun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223060101,
					"content": "Comment je vais faire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060102
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223060102,
					"content": "Qu'est-ce qu'il se passe ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223060103
					]
				},
				{
					"id": 223060103,
					"content": "J'étais matelot sur le Crux et un jour, je me suis malencontreusement blessé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060104
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223060104,
					"content": "Après avoir quitté la Flotte, j'ai vendu des cartes au trésor à Bolai pour me faire un peu de sous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060105
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223060105,
					"content": "Il m'a dit qu'il me donnerait une part du trésor s'il y en avait un, mais je n'ai pas eu de nouvelles depuis. Je ne pense pas qu'il soit parti à sa recherche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060106
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223060106,
					"content": "À ce rythme-là, même s'il y en avait un, on ne sera pas près de le trouver. Ça vous dit de m'aider à le chercher ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060107,
						223060109,
						223060116
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223060107,
					"content": "Pourquoi pas ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223060108
					]
				},
				{
					"id": 223060108,
					"content": "Merci beaucoup !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060120
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223060120,
					"content": "Rendez visite à <color=#00E1FFFF>Bolai</color> pour obtenir les <color=#00E1FFFF>cartes aux trésor</color>. Une fois que vous mettrez la main sur ces <color=#00E1FFFF>trésors</color>, <color=#00E1FFFF>amenez-les lui</color> directement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060121
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223060121,
					"content": "On s'est mis d'accord pour qu'il me réserve une part.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223060109,
					"content": "Pourquoi avoir quitté la flotte de votre navire ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223060110
					]
				},
				{
					"id": 223060110,
					"content": "J'ai une vieille blessure qui peut se réveiller à tout moment. Je ne voulais pas être un fardeau, alors je suis parti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060111
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223060111,
					"content": "Ensuite, j'ai ouvert mon petit commerce ici avec des matériaux que j'ai récupérés. Malheureusement, les affaires sont difficiles ici et mes marchandises s'amenuisent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060112
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223060112,
					"content": "J'ai gardé quelques cartes aux trésors de mon temps de marin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060113
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223060113,
					"content": "Mais comme je peine à marcher avec ma blessure, il est hors de question que je me lance à la chasse au trésor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060114
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223060114,
					"content": "Je les ai donc vendues à Bolai pour me faire quelques moras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060115
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223060115,
					"content": "Il n'ira pas non plus à la chasse au trésor, car ce n'est qu'un simple marchand après tout... Alors je ne peux que compter sur vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060107,
						223060116
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223060116,
					"content": "Vous pensez qu'il y en a un ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223060117
					]
				},
				{
					"id": 223060117,
					"content": "Hahaha ! Impossible ! Ces cartes faisaient partie d'un butin distribué à la Flotte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060118
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223060118,
					"content": "S'il y avait un véritable trésor à la clé, ça ferait belle lurette que quelqu'un l'aurait trouvé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060119
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223060119,
					"content": "Même si le trésor n'est pas gros, je pense qu'il y en aura assez pour trois personnes, alors je compte sur vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060120
					],
					"speakerTitle": "Zhangshun"
				}
			]
		},
