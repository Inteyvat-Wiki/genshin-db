			"dialogs": [
				{
					"id": 716540201,
					"content": "Waouh... Cette théière est encore bien plus grande à l'intérieur que celle de Madame Ping ! Et il y a même une maison énorme au milieu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716540202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716540202,
					"content": "Mais il n'y a rien du tout autour...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716540203,
						716540205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716540203,
					"content": "Paimon, va donc casser des pierres pour construire une maison !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716540204
					]
				},
				{
					"id": 716540204,
					"content": "Comme si je n'avais que ça à faire ! Et puis, tu as une épée, non ? Alors, va le faire toi-même !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716540207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716540207,
					"content": "Par contre... Pourquoi c'est vide comme ça, à part cette maison ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716540208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716540208,
					"content": "Hein ? Attends... Qu'est-ce que c'est ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716540205,
					"content": "Paimon, tu n'as qu'à creuser un gros trou et dormir dedans...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716540206
					]
				},
				{
					"id": 716540206,
					"content": "Tu vois pas la maison, là ? Pourquoi j'irais creuser un trou ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716540207
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
