					"Shibata"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190361701,
					"content": "#Ah, vous êtes... Vous êtes {M#le}{F#la} capitaine de l'Espadon II ! Je suis Shibata, gardien de cet endroit. Vous avez besoin de quelque chose, capitaine ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361702
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 190361702,
					"content": "Je voudrais me renseigner sur quelqu'un.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361703
					]
				},
				{
					"id": 190361703,
					"content": "Vous parlez à Shibata de votre mission de recherche.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						190361704
					]
				},
				{
					"id": 190361704,
					"content": "Ah, c'est le jeune détective, je le connais. Son nom est Shikanoin Heizou, il traînait toujours dans le coin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361705
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 190361705,
					"content": "Son Altesse Sangonomiya m'avait même envoyé garder un œil sur lui à l'époque, de peur qu'il ne fasse quelque chose de mal. Mais il s'est avéré qu'il était là simplement pour se promener.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361706
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 190361706,
					"content": "Voyons voir, je crois qu'il a aussi été vu récemment dans la zone à l'est de Sangonomiya. Vous pouvez aller voir si vous voulez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shibata"
				}
			]
		},
