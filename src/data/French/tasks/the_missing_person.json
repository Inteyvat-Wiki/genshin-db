				"objectNames": [
					"Sango"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190361601,
					"content": "#Vous n'êtes pas encore {M#parti}{F#partie} ? Se pourrait-il que vous ayez changé d'avis ? C'est mieux ainsi, il n'est pas avisé d'être mêlé à ce type.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361602
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361602,
					"content": "J'aimerais savoir quel est le malentendu qu'il y a entre vous.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361603
					]
				},
				{
					"id": 190361603,
					"content": "S'il disparaît pour de bon, ce ne sera pas plus mal, entendu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361604
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361604,
					"content": "#(Sourire pour être {M#poli}{F#polie}...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361605
					]
				},
				{
					"id": 190361605,
					"content": "Ne me regardez pas comme ça, haha. On a tous des personnes qu'on trouve gênantes dans notre vie, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361606
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361606,
					"content": "Quoi qu'il en soit, vous feriez mieux d'y aller avant que Shikanoin ne cause de sérieux problèmes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361607
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361607,
					"content": "Au fait, n'oubliez pas de me tenir au courant si vous trouvez des traces de sa fin tragique. Ça me rendra très heureuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				}
			]
		},
		{
