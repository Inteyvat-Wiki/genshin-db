			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji",
					"Sango"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190361401,
					"content": "#Si {M#le voyageur}{F#la voyageuse} est aussi indisponible, qu'allons-nous faire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361402
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361402,
					"content": "C'est ton problème, personne ne t'a demandé de te mettre dans ce pétrin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361403
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361403,
					"content": "#Ah, tu as de la chance, voilà {M#ton sauveur}{F#ta sauveuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361404
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361404,
					"content": "#Hmm ? Génial ! {M#Voyageur}{F#Voyageuse}, vous êtes là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361405
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361405,
					"content": "Ne vous inquiétez pas, je suis disponible.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361406
					]
				},
				{
					"id": 190361406,
					"content": "#Quand on parle {M#du flâneur}{F#de la flâneuse}, on en voit les cheveux blonds.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361407
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361407,
					"content": "Directrice !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361408
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361408,
					"content": "#Comparé {M#au voyageur}{F#à la voyageuse}, c'est plutôt vous qui êtes une personne oisive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361409
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361409,
					"content": "C'est pas vrai, je suis très occupée. Occupée à rester debout ici... toute la journée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361410
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361410,
					"content": "Même si vous ne voulez pas accepter cette mission, votre excuse est vraiment trop facile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361411
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361411,
					"content": "Il y a une mission que vous ne voulez pas accepter ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361412
					]
				},
				{
					"id": 190361412,
					"content": "Oui oui... C'est la raison pour laquelle je vous ai demandé de venir. Je vais vous expliquer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361413
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361413,
					"content": "Récemment, une personne importante de la Commission administrative a disparu. Il n'y a aucun moyen de la contacter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361414
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361414,
					"content": "Pour certaines raisons, la Commission administrative n'est pas en mesure de mener des recherches aux yeux de tous. Elle nous a donc secrètement demandé de trouver cette personne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361415
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361415,
					"content": "Qui s'appelle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361416
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361416,
					"content": "Kujou Sara. La générale a disparu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361417
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361417,
					"content": "Si elle avait vraiment disparu, vous ne pensez pas qu'ils retourneraient toute la Cité d'Inazuma pour la retrouver plutôt que de faire appel à nous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361418
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361418,
					"content": "#{M#Voyageur}{F#Voyageuse}, n'écoutez pas la directrice. Le nom de la personne disparue est Shikanoin Heizou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361419
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361419,
					"content": "C'est un détective spécial du Poste de police. Bien qu'il ne soit qu'un simple doushin, il est très talentueux et est donc très apprécié au Poste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361420
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361420,
					"content": "Hmm ? Talentueux ? Plus que moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361421
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361421,
					"content": "Directrice, ce n'est pas grave si vous ne voulez pas aider, mais au moins ne créez pas de problèmes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361422
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361422,
					"content": "#Pardon, {M#voyageur}{F#voyageuse}. Bien que j'aie accepté cette mission...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361423
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361423,
					"content": "Comme vous pouvez le voir, la directrice... n'a pas très envie de s'y impliquer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361424,
						190361425
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361424,
					"content": "Parce que la rémunération est trop faible ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361426
					]
				},
				{
					"id": 190361426,
					"content": "Raté ! Zéro !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361427
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361427,
					"content": "Si vous voulez savoir, c'est parce que je refuse catégoriquement de me mêler des affaires de ce gamin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361428
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361428,
					"content": "S'il devait y avoir quelque chose de plus agréable qu'une disparition de Shikanoin... Alors cela ne pourrait être que d'entendre que « Shikanoin a disparu depuis plus de cent ans » !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361429
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361429,
					"content": "Ahem... Pour résumer, il y a un petit conflit entre la directrice Sango et monsieur Heizou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361430
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361430,
					"content": "Je comprends... C'est une histoire de rivalité.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361431
					]
				},
				{
					"id": 190361431,
					"content": "Euh... Vous vous méprenez. C'est sans doute un peu plus grave que ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361432
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361432,
					"content": "La directrice a dit que monsieur Heizou était une pierre d'achoppement sur son chemin vers le temple sacré de la vérité...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361433
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361433,
					"content": "C'est un empêcheur de tourner en rond !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361434
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361434,
					"content": "*soupir* Malgré sa personnalité plutôt... Hum... Intéressante, monsieur Heizou est vraiment un homme bien. Il m'a appris beaucoup de choses autrefois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361435
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361435,
					"content": "#Même si la directrice ne me permet pas d'agir, je ne peux pas rester là les bras croisés. Je peux au moins confier cette mission à une personne capable et de confiance. Quelqu'un comme vous, {M#voyageur}{F#voyageuse} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361436,
						190361437
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361436,
					"content": "J'ai compris, je fais de la sous-traitance.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361438
					]
				},
				{
					"id": 190361438,
					"content": "Ah... Mais non, enfin ! Je vous donnerai toute la récompense de la Commission administrative, plus une somme supplémentaire de ma part.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361439
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361439,
					"content": "J'espère donc que vous pourrez accepter cette mission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361440
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361440,
					"content": "Si monsieur Heizou est vraiment en danger, je pense qu'il sera plus en sécurité avec vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361441,
						190361445
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361441,
					"content": "Vous le connaissez bien ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361442
					]
				},
				{
					"id": 190361442,
					"content": "En fait, on est très proches. C'est juste que Sango m'a toujours demandé de garder mes distances avec lui, et de ne pas agir comme si je le connaissais bien en public.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361443
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361443,
					"content": "C'est pour cela que quand les gens posent la question, j'ai l'habitude de dire que j'ai seulement rencontré monsieur Heizou quelques fois. Mais s'il ne s'était pas passé cet incident aujourd'hui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361444
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361444,
					"content": "Ahem... Trêve de bavardages, pourriez-vous m'aider à le chercher ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361449
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361449,
					"content": "C'est compris, j'y vais.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361450
					]
				},
				{
					"id": 190361450,
					"content": "Hum, c'est à peu près tout. Veuillez bien conserver le mandat du Poste de police. Si vous trouvez monsieur Heizou, vous n'avez qu'à retourner au Poste de police pour faire votre rapport.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361445,
					"content": "Pas de souci, mais j'ai besoin de plus d'informations.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361446
					]
				},
				{
					"id": 190361446,
					"content": "Génial ! On nous a dit que monsieur Heizou s'intéressait beaucoup à l'Île de Watatsumi avant sa disparition.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361447
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361447,
					"content": "Pendant la guerre, il semble avoir été envoyé en mission sur l'Île de Watatsumi. Lorsqu'elle s'est terminée, il a également fait de fréquents allers-retours là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361448
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361448,
					"content": "J'ai entendu dire que vous étiez très proche de Sangonomiya. J'ai donc pensé que l'Île de Watatsumi pourrait être le point de départ de votre enquête.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361449
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361437,
					"content": "J'ai compris, vous faites office d'intermédiaire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361438
					]
				},
				{
					"id": 190361425,
					"content": "Parce qu'il y a trop peu d'indices ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361426
					]
				}
			]
		},
		{
			"id": 1903615,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1903606",
							"2"
						],
						"stepId": 1903606,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190361501,
					"content": "#{M#Voyageur}{F#Voyageuse}, s'il vous plaît, ne tardez pas. J'espère que monsieur Heizou n'est pas en danger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361502
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361502,
					"content": "Parlez-moi plus de ce Shikanoin Heizou.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361503
					]
				},
				{
					"id": 190361503,
					"content": "Monsieur Heizou ? C'est un homme plein de vie ! Il est loquace, très vif et énergique, personne ne l'a jamais vu rester au même endroit sans avancer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361504
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361504,
					"content": "La directrice a toujours dit qu'il était comme une mouche qui bourdonne, ça doit être parce qu'il est capable de trouver chaque mauvais œuf avec une grande précision.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361505
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361505,
					"content": "Si c'est le cas, je pense que monsieur Heizou est plus qu'une simple mouche, c'est une mouche de haut rang !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361506
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361506,
					"content": "Même si son nez est bouché, ses yeux bandés et ses oreilles couvertes, il peut toujours trouver très précisément les mauvais œufs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361507
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361507,
					"content": "C'est incroyable, n'est-ce pas ? C'est comme s'il se fiait à quelque chose d'autre que ses cinq sens. C'est un sixième sens ? Son intuition ? Une aide divine ? Ou autre chose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361508,
						190361510
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361508,
					"content": "C'est une analogie originale, mais veuillez éviter de la répéter.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361509
					]
				},
				{
					"id": 190361509,
					"content": "Ah, la directrice dit toujours que je ne sais pas bien m'exprimer. Alors c'est donc vrai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361510,
					"content": "Cette métaphore était vraiment mauvaise, mais j'aimerais quand même en savoir plus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361511
					]
				},
				{
					"id": 190361511,
					"content": "Ahem, nous pourrons peut-être en parler une autre fois... La directrice nous regarde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				}
			]
		},
		{
			"id": 1903616,
