					"nextDialogs": [
						718240303
					]
				},
				{
					"id": 718240303,
					"content": "Parfait... Ça devrait lui remonter le moral.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240304
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718240304,
					"content": "Je me demande quel genre de souhait peut faire une enfant...",
