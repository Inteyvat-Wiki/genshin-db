			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yanxiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718240101,
					"content": "Je dois me dépêcher...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240102
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718240102,
					"content": "Comment vont les affaires ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240103
					]
				},
				{
					"id": 718240103,
					"content": "Dans le mur, voilà où elles vont ! C'est le Festival des lanternes, non ? Plein d'employés sont rentrés chez eux pour les fêtes. Du coup, on manque de bras. Je dois pratiquement tout faire moi-même...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240104
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718240104,
					"content": "Heureusement qu'il n'y a pas trop de monde, je me débrouille à peu près.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240105
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718240105,
					"content": "Ahem... Et puis, je dois encore te remercier pour la dernière fois. Sans ton aide, j'aurais eu bien du mal à reprendre du service...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240106,
						718240107
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718240106,
					"content": "Et sinon, dernièrement...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240108
					]
				},
				{
					"id": 718240108,
					"content": "Euh... Non ! Pas du tout, je te jure ! Si elle revient, je... Je te le dis, je ne pourrai pas le supporter...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240109
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718240109,
					"content": "Si tu veux vraiment en savoir plus sur elle... tu devrais simplement aller demander à la patronne. Moi, je... Je ne sais rien, je le jure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718240107,
					"content": "Et donc, elle est...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240108
					]
				}
			]
		},
		{
			"id": 7182402,
			"completionStepIds": [
				7182402
