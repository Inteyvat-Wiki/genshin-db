				"objectNames": [
					"Verr Goldet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718240201,
					"content": "#Quelles sont les nouvelles, {M#voyageur ?}{F#voyageuse ?}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240202
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718240202,
					"content": "À propos de Ming...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240203
					]
				},
				{
					"id": 718240203,
					"content": "Oh, elle ? Elle se comporte plutôt bien depuis l'incident de la dernière fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240204
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718240204,
					"content": "Mais elle me fait quand même un peu mal au cœur, cette petiote... À l'approche des fêtes, plus l'auberge s'anime, et plus elle se sent seule. Alors elle finit par causer tout un tas d'ennuis et effraie les clients.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240205
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718240205,
					"content": "Je suis sûre qu'elle veut simplement que quelqu'un joue avec elle. Ce n'est qu'une enfant, après tout...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240206,
						718240207
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718240206,
					"content": "Pourquoi ne pas lui offrir une lanterne céleste ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240208
					]
				},
				{
					"id": 718240208,
					"content": "Vous voulez lui donner une lanterne céleste ? Ma foi, ce n'est pas une mauvaise idée. Le seul problème, ça va être de la trouver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240209
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718240209,
					"content": "Pour la trouver, allez accrocher une lanterne céleste à l'un des arbres de la forêt voisine pendant la nuit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240210
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718240210,
					"content": "Comme ça, elle pourra sûrement la voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718240207,
					"content": "Je me demande si elle aime les lanternes célestes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240208
					]
				}
			]
		},
