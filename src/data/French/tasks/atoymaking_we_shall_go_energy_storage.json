			"trigger": {
				"objectNames": [
					"Bertrand"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726950101,
					"content": "Bertrand !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726950102,
					"content": "#Oh, {NICKNAME} et Paimon. Vous tombez à point nommé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950103
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950103,
					"content": "Ma merveilleuse... Enfin, ma méga-machine a terminé de traiter les matériaux que vous aviez ramenés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950104
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950104,
					"content": "Les résultats sont bons ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950105
					]
				},
				{
					"id": 726950105,
					"content": "Voyons, cette machine est mon invention ! Évidemment qu'elle produit de bons résultats ! Je vous signale que ma technique a été durement acquise à Fontaine !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950106
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950106,
					"content": "Et qui de mieux qu'un Fontainois pour savoir comment utiliser ce genre de machine ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950107
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950107,
					"content": "La dernière tentative n'a pas pris la tournure escomptée à cause de ce problème d'explosion dû à une préparation bâclée et un manque de main d'œuvre pour rassembler les matériaux requis. Les choses seront différentes cette fois-ci !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950108
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950108,
					"content": "Si vous le dites...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726950109,
					"content": "Si la machine produit encore des jouets explosifs, je peux dire adieu à mes dernières économies et aux restes de mes jours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950110
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950110,
					"content": "Même si vous n'avez pas confiance en moi, je vous assure que je suis prêt à mettre ma vie en jeu pour réussir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950111
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950111,
					"content": "Je n'aurais jamais cru qu'il y avait besoin d'autant de détermination pour fabriquer des jouets...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726950112,
					"content": "Bref, passons au prochain processus de notre travail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950113
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950113,
					"content": "Pour m'assurer que vous avez bien compris, permettez-moi de vous poser une question. Nous venons d'achever le premier des trois processus, la collecte de matières premières.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950114
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950114,
					"content": "#À présent, nous passons au processus suivant. S'agit-il de la « collection des noyaux{NON_BREAK_SPACE}» ou la « collection élémentaire » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950115,
						726950118
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950115,
					"content": "La collection des noyaux ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950116
					]
				},
				{
					"id": 726950116,
					"content": "Bravo... mais c'est faux. Vous auriez contribué à ma ruine si vous aviez procédé de cette façon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950117
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950117,
					"content": "La bonne réponse était la recharge élémentaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950121
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950121,
					"content": "Bref, la recharge élémentaire ne peut être accomplie qu'en s'exposant aux effets des éléments pendant une certaine durée tout en transportant le Collecteur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950122
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950122,
					"content": "Par exemple, je pourrais me tenir dans une rivière avec le Collecteur pour obtenir de l'élément Hydro. Si je voulais de l'élément Électro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950123
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950123,
					"content": "Il faudrait que la foudre s'abatte sur vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726950124,
					"content": "#Ah, vous êtes bel et bien des {M#aventuriers}{F#aventurières}, ma foi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950125
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950125,
					"content": "Vous avez une constitution physique solide, je suis certain que vous y survivrez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950126
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950126,
					"content": "C'est là-dessus que vous misez tout ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950127
					]
				},
				{
					"id": 726950127,
					"content": "Honnêtement, je pense que nous aurons de meilleures chances en nous approchant de créatures élémentaires. J'ai repéré trois endroits qu'elles fréquentaient lors de mes précédents voyages à Inazuma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950128
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950128,
					"content": "Au départ, je voulais prendre discrètement le bateau tout seul pour être au contact des créatures dans le cas où je n'aurais pas eu d'aide...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950129
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950129,
					"content": "C'est trop dangereux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726950130,
					"content": "Mais maintenant que vous êtes là, pourquoi ne pas tenter votre chance ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950131
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950131,
					"content": "Je compte sur vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950118,
					"content": "La collection élémentaire ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950119
					]
				},
				{
					"id": 726950119,
					"content": "Haha ! Ce n'est pas tout à fait cela, mais l'idée est là. Le processus suivant est la recharge élémentaire. Vous ne vous attendiez pas à ce que je vous propose deux fausses réponses, hein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950120
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950120,
					"content": "Je trouve son sourire particulièrement agaçant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950121
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
