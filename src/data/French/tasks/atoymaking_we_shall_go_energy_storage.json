			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bertrand"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726950201,
					"content": "Hmm... Les éléments dans le Collecteur devront être transférés dans la méga-machine après chaque collecte. Un cycle de production nécessiterait donc trois collectes... C'est vraiment embêtant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950202
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950202,
					"content": "Voyons voir si l'on peut simplifier les choses...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bertrand"
				}
			]
		},
		{
			"id": 7269503,
			"completionStepIds": [
				7269503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7269503",
							"2"
						],
						"stepId": 7269503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bertrand"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726950301,
					"content": "Comment vous vous en sortez avec le Collecteur de matériaux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950302
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950302,
					"content": "Pas trop mal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950303
					]
				},
				{
					"id": 726950303,
					"content": "Le Collecteur de matériaux est l'une des inventions qui me rend le plus fier de moi-même. Que ce soit de la collecte de matières premières comme avant, ou du stockage d'énergie élémentaire comme maintenant, il peut tout faire à la perfection.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950304
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950304,
					"content": "Pour tout vous dire, je songe même à changer son nom...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950305
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950305,
					"content": "Je trouve qu'il est déjà très bien comme ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950306,
						726950307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726950306,
					"content": "Moi aussi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950308
					]
				},
				{
					"id": 726950308,
					"content": "Ah bon ? Je pense qu'il ne reflète pas assez son génie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950309
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950309,
					"content": "Bon, passez-moi le Collecteur de matériaux. Comme précédemment, je vais devoir surveiller la production pendant un certain temps, d'autant plus que cela concerne de l'énergie élémentaire cette fois-ci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950310
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950310,
					"content": "On pourra passer à la suite après la stabilisation des réactions élémentaires au sein de la méga-machine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950311
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950311,
					"content": "Je compterai à nouveau sur vous le moment venu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950307,
					"content": "Ça lui va bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950308
					]
				}
			]
		}
	]
}