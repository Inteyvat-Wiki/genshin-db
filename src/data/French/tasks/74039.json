			},
			"dialogs": [
				{
					"id": 740390701,
					"content": "#Ça va, {NICKNAME} ? Vous vous sentez bien ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390702
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390702,
					"content": "Vraiment désolée... Je ne savais pas que la potion attirerait des choses étranges comme ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390703,
						740390710
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390703,
					"content": "#C'est arrivé parce que la potion m'a {M#transformé}{F#transformée} en radiateur...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390704
					]
				},
				{
					"id": 740390704,
					"content": "Euh, c'est comme ça que ça fonctionne ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390705,
					"content": "Waouh... C'est vrai ! Les animaux aquatiques confondent les choses chaudes avec le soleil, ce qui les attire. Cela signifie... que la potion a fonctionné ! Merci à vous deux, vraiment !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390706
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390706,
					"content": "Je ne pense vraiment pas que ce soit comme ça que ça marche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390707,
					"content": "Des animaux aquatiques...? Ce n'étaient pas des Pyroblobs ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390708
					]
				},
				{
					"id": 740390708,
					"content": "Je vois... Hmm, des hallucinations comme effets secondaires... D'accord, je l'ai noté. Eh bien, au moins, ce n'était pas complètement inefficace, mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390709
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390709,
					"content": "Mais ses effets étaient terribles ! Cette fois-ci, les énormes crabes ressemblaient à des Pyroblobs, mais que se passerait-il si un monstre plus dangereux arrivait la prochaine fois ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390720,
					"content": "Oui... Je vous ai déjà tant demandé, mais il y a une dernière potion qui a besoin d'être testée... Vous êtes toujours d'accord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390721,
						740390723
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390721,
					"content": "Tant que ce n'est pas toxique, allons-y.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390722
					]
				},
				{
					"id": 740390722,
					"content": "Mouais, ça, nous ne le saurons que lorsque tu l'auras bue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390725,
					"content": "Oui ! Merci beaucoup ! Eh bien, la troisième potion est... la potion de clairvoyance !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390726
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390726,
					"content": "Hein ? A—Attendez un instant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390727,
					"content": "La première était la potion super-top, la suivante était la potion chaud-dedans, et celle-ci s'appelle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390728,
					"content": "La potion de clairvoyance, ce qui signifie qu'elle « permet de voir clairement la vérité »... Quel est le problème ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390729
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390729,
					"content": "Euh... Ce n'est pas grand-chose... Je trouve simplement que ce nom est vraiment différent des autres ! C'est un virage à 360 degrés !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390730,
						740390731
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390730,
					"content": "Elles sont donc identiques dans ce cas ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390732
					]
				},
				{
					"id": 740390732,
					"content": "Hein..? Euh... Je n'y vois pas très clair ! Mais tu sais très bien ce que je voulais dire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390733
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390733,
					"content": "Haha, c'est parce que la grande potionniste a choisi les deux premiers noms, et j'ai choisi le troisième...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390734
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390734,
					"content": "Je ne suis pas douée pour les noms, donc ce n'est certainement pas aussi bien que les noms qu'elle a trouvés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390735
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390735,
					"content": "Vraiment ? Pour moi, c'est plutôt l'inverse... Vous devriez avoir plus confiance en vous ! C'est un bon nom pour une potion...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390736
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390736,
					"content": "Hmm, merci. Cette potion est différente des deux précédentes, donc elle pourrait être très dangereuse... Alors, faisons plutôt ça dans mon atelier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390737
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390737,
					"content": "Si nous sommes dans la mer, l'environnement devrait aider à modérer les effets de la potion, et mon atelier a tout ce qu'il faut pour faire face aux dangers...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390738
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390738,
					"content": "Waouh, c'est vraiment autre chose celle-là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390739,
					"content": "Allons-y.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390740
					]
				},
				{
					"id": 740390740,
					"content": "D'accord, suivez-moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390731,
					"content": "#Tu voulais dire 180 degrés, je suppose{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390732
					]
				},
				{
					"id": 740390723,
					"content": "#Eh bien, nous sommes {M#arrivés}{F#arrivées} jusqu'ici...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390724
					]
				},
				{
					"id": 740390724,
					"content": "Exactement ! On n'a pas fait tout ça pour s'arrêter maintenant ! Quoique... Je suis tout de même un peu inquiète...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390710,
					"content": "Ne vous inquiétez pas, les Pyroblobs sont faibles.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390711
					]
				},
				{
					"id": 740390711,
					"content": "#Haha... Non, {NICKNAME}, c'est parce que tu es trop {M#fort}{F#forte} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390712,
					"content": "Hmm. Attendez... Vous avez dit « Pyroblobs » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390713
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390713,
					"content": "Oh ! C'est vrai... En fait, nous n'avons vu qu'un tas de crabes énormes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390714,
						740390716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390714,
					"content": "Des crabes ? Oui, il est normal de voir des crabes près de la côte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390715
					]
				},
				{
					"id": 740390715,
					"content": "Mais tu n'étais vraiment pas dans ton état normal tout à l'heure !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390716,
					"content": "La sensation de brûlure était bien réelle. Je sentais les vagues de chaleur qui en émanaient...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390717
					]
				},
				{
					"id": 740390717,
					"content": "Je vois... Hmm, des hallucinations... D'accord, je l'ai noté. Eh bien, au moins, ce n'était pas complètement inefficace, mais... *soupir* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390718
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390718,
					"content": "L'important est que vous alliez bien ! C'est juste que... Désolée, la potion n'est pas encore un succès...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390719
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390719,
					"content": "#Ce n'est pas grave ! Même si elle sent mauvais, c'est au moins à moitié réussi. Vous voyez, {NICKNAME} va très bien maintenant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390720
					],
					"speakerTitle": "Paimon"
				}
			]
		},
