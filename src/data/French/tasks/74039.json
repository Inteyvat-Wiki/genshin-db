			"dialogs": [
				{
					"id": 740390601,
					"content": "Hmm, alors, avez-vous vaincu ces créatures si facilement grâce à la potion super-top ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390602,
						740390605
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390602,
					"content": "#Tout à fait ! On pourrait même dire que ça m'a {M#rendu}{F#rendue} super-top !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390603
					]
				},
				{
					"id": 740390603,
					"content": "C'est très mauvais comme slogan publicitaire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390604,
					"content": "Ah, merci, merci ! C'était donc dû aux effets de la potion. Voilà ce que la potion d'une grande potionniste peut faire pour vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390609
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390609,
					"content": "C'est vrai, oui. Terminons d'abord le test de la potion super-top. Ensuite, nous testerons la potion chaud-dedans !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390610
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390610,
					"content": "C'est vous qui, euh, avez trouvé ces noms ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390611,
					"content": "Non, je ne suis pas douée pour inventer des noms, alors je laisse les autres m'aider à en trouver de bien meilleurs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390612
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390612,
					"content": "Mais non, ne dites pas ça... Et puis, pour quelque chose comme les potions, l'important est de connaître leur utilité tout de suite, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390613,
					"content": "Hmm. Je n'ai jamais entendu ça avant... Mais vous avez raison ! C'est comme ça qu'une grande potionniste devrait procéder !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390614
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390614,
					"content": "#*tousse* Êtes-vous {M#prêt}{F#prête} à tester cette potion, {NICKNAME} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390615
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390615,
					"content": "Bien sûr, commençons.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390616
					]
				},
				{
					"id": 740390616,
					"content": "Oh... Celle-ci aussi sent le vieux grenier...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390617,
					"content": "Théoriquement, cette potion chaud-dedans vous épargnera des effets du froid et vous gardera au chaud ! En théorie, donc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390618
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390618,
					"content": "Vous buvez la potion de Vérénata. Ça sent le vieux cuir poussiéreux et moisi...\\nVous hésitez un instant avant de tout boire d'une traite. Le goût n'est pas mauvais, c'est un peu épicé avec des notes de cannelle et de gingembre... Ça vous rappelle le crépitement d'une cheminée un jour de pluie.\\nPar contre, vous ne ressentez pas d'effet.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740390619
					]
				},
				{
					"id": 740390619,
					"content": "Suivant les instructions de Vérénata, vous vous reposez un moment.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 740390605,
					"content": "Je n'ai pas ressenti grand-chose, mais c'était assez sucré.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390606
					]
				},
				{
					"id": 740390606,
					"content": "Hein ? Mais ça sentait mauvais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390607,
					"content": "Oh... C'est vrai ? Ai-je mal compris quelque chose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390608
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390608,
					"content": "Ne soyez pas trop déçue. Au moins, ce n'était pas toxique... On peut considérer ça comme une victoire, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390609
					],
					"speakerTitle": "Paimon"
				}
			]
		},
