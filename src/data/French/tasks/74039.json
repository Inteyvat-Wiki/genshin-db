			},
			"dialogs": [
				{
					"id": 740390501,
					"content": "Merci ! Essayons la première, alors !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390502
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390502,
					"content": "#N'en bois pas trop, {NICKNAME} ! N'avale pas si quelque chose ne va pas, d'accord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390503,
					"content": "Ne t'inquiète pas, Paimon, ça va aller.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390504
					]
				},
				{
					"id": 740390504,
					"content": "Hmm. Je suis juste inquiète, tu sais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390505,
					"content": "#Je suis {M#prêt}{F#prête}. Passez-moi la potion.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390506
					]
				},
				{
					"id": 740390506,
					"content": "Celle-ci s'appelle la potion super-top et devrait décupler vos forces ! En théorie, du moins...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390507
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390507,
					"content": "Vous buvez la potion de Vérénata d'une seule traite.\\nElle sent vraiment très mauvais, mais elle a un goût sucré et collant, et n'est pas difficile à avaler.\\nPar contre, vous ne ressentez aucun effet.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740390508
					]
				},
				{
					"id": 740390508,
					"content": "Suivant les instructions de Vérénata, vous attendez que les Primus briseurs s'activent.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
