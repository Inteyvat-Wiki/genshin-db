							2395.885,
							240.174,
							4934.881
						],
						"pointId": 5001
					}
				]
			},
			"dialogs": [
				{
					"id": 740390101,
					"content": "Hmm... Une bouillie de maréalgues, des entrailles broyées de sombrétoile, et un peu... Attendez, c'est combien « un peu » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390102
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390102,
					"content": "Hey, vous faites de la soupe ? ... Argh, ça sent vraiment bizarre...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390103,
					"content": "Hmm ? Ça sent bizarre ? Ce n'est pas possible. J'ai suivi exactement la formule que Carabosse m'a donnée, donc ça ne devrait pas sentir bizarre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390104,
						740390106
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390104,
					"content": "Ça sent le bar fermenté pendant trois ans dans une cuve de grenouilles mortes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390105
					]
				},
				{
					"id": 740390105,
					"content": "C'était indispensable ça ? J'ai cette image en tête maintenant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390108,
					"content": "Q—Quoi qu'il en soit, qu'est-ce que vous faites ? Vous avez besoin d'aide ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390109,
					"content": "C'est une potion ! Je suis en train de préparer une potion... qui aidera beaucoup de gens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390110
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390110,
					"content": "Oh, vous êtes potionniste alors ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390111,
					"content": "Pas encore ! Je ne suis que l'assistante d'une grande potionniste. Elle s'appelle Carabosse et moi, Vérénata, j'ai encore beaucoup à apprendre d'elle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390112
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390112,
					"content": "Haha. Eh bien, l'assistante d'une grande potionniste doit être une excellente assistante, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390113,
					"content": "Haha... Vous... A—Attendez, non ! Pas du tout !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390114
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390114,
					"content": "Je suis... Il y a tellement de choses que je ne sais toujours pas. Je travaille aussi dur que je peux pour l'aider à faire des potions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390115
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390115,
					"content": "Hmm, je vous ai dit mon nom, mais je ne connais pas encore le vôtre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390116
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390116,
					"content": "#Je m'appelle Paimon et voici {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390117,
					"content": "« Paimon ». Quel joli nom. Ça me rappelle une méduse blanche très bruyante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390118
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390118,
					"content": "#{NICKNAME}... Ce n'est pas courant, mais ça a le mérite d'être original. Ravie de vous rencontrer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390119
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390119,
					"content": "#Et, eh bien, vous m'avez demandé si j'avais besoin d'aide, et il s'avère que c'est le cas... Mais je ne sais pas si vous seriez {M#prêts}{F#prêtes} à m'aider...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390120
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390120,
					"content": "Demandez toujours.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390121
					]
				},
				{
					"id": 740390121,
					"content": "Exactement ! Si vous avez besoin d'aide, vous devriez demander !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390122,
					"content": "J'aimerais que vous... essayiez mes nouvelles potions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390123
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390123,
					"content": "Hmm ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390124,
					"content": "Je sais que ça sent mauvais et que ça a mauvais goût... Mais ça peut aider beaucoup de gens et guérir de nombreuses maladies. C'est très efficace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390125
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390125,
					"content": "Mais nous ne pouvons pas tomber malades, et nous n'aimons pas boire des choses étranges. Au fil du temps, on a cessé de m'aider à goûter mes potions, et c'est un vrai problème pour moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390126
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390126,
					"content": "Euh... C'est vous qui dites que ce truc est bizarre ! Ce n'est pas dangereux, au moins ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390127,
					"content": "Non, non. Cela ne nous empoisonne pas. Euh... Donc ce devrait être votre cas aussi... Enfin, en théorie, du moins.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390128
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390128,
					"content": "En tout, il y a trois potions qui doivent être testées. La première aidera les gens à mieux se battre ! La deuxième gardera les gens au chaud. Et la dernière, euh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390129
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390129,
					"content": "Carabosse dit qu'elle peut aider les gens à comprendre la vérité. C'est son explication... Je ne sais toujours pas ce que ça veut dire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390130
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390130,
					"content": "Ça semble dangereux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390131,
					"content": "Non, non, ce n'est pas dangereux... Acceptez-vous de m'aider ? Si oui, je vais vous y emmener maintenant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390106,
					"content": "Si tu te calmes un peu, tu pourras sentir le parfum des fleurs sucrantes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390107
					]
				},
				{
					"id": 740390107,
					"content": "Je ne te crois pas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390108
					],
					"speakerTitle": "Paimon"
				}
			]
		},
