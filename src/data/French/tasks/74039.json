			"dialogs": [
				{
					"id": 740390801,
					"content": "#Nous y sommes ! Voici mon atelier, c'est ici que je mène mes expérimentations{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390802
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390802,
					"content": "#Bon, pour la prochaine expérience, nous allons tester la potion de clairvoyance ! Vous êtes {M#prêt}{F#prête} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390803
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390803,
					"content": "#Je suis {M#prêt}{F#prête}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390804
					]
				},
				{
					"id": 740390804,
					"content": "Oh... Fais attention, s'il te plaît...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390805,
					"content": "Vous buvez la potion de Vérénata. L'odeur nauséabonde des algues mortes qui ont pourri sous le soleil tropical vous prend le nez, presque au point de vous rendre malade...\\nVous hésitez un instant, puis la videz d'une seule traite. Le goût de la potion elle-même n'est pas si mauvais. En réalité, elle n'a vraiment aucun goût distinct...\\nPar contre, vous ne ressentez aucun effet.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740390806
					]
				},
				{
					"id": 740390806,
					"content": "Suivant les instructions de Vérénata, vous vous reposez un moment. C'est presque comme si absolument rien n'avait changé.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740390807
					]
				},
				{
					"id": 740390807,
					"content": "Mais peu de temps après...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740390808
					]
				},
				{
					"id": 740390808,
					"content": "On dirait que rien n'a changé... Ouf, je suis soulagée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390809,
					"content": "#Oui, mais... {NICKNAME}, on aurait dit que vous étiez {M#sonné}{F#sonnée} pendant un moment. Ça va ? Vous avez vu quelque chose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390810
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390810,
					"content": "J'ai vu... la moitié d'un bateau semi-transparent ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390811
					]
				},
				{
					"id": 740390811,
					"content": "Vraiment ? C'est fascinant ! Mais... Euh... Pouvez-vous fournir une description plus détaillée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390812,
						740390815
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390812,
					"content": "Il était trop loin, je ne pouvais pas le voir clairement.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390813
					]
				},
				{
					"id": 740390813,
					"content": "#C'est vraiment intéressant ! ... Mais si {NICKNAME} n'est pas {M#sûr}{F#sûre} qu'{M#il}{F#elle} n'a pas pris un récif ou une épave pour un « navire fantôme », cela ne peut pas servir de preuve concrète des effets de la potion...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390814
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390814,
					"content": "Alors... *soupir* Les résultats de cette expérience ne sont pas concluants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390818
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390818,
					"content": "Merci beaucoup, j'ai pu recueillir des données très intéressantes ! Je pourrai les utiliser pour améliorer le prochain lot de potions !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390819
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390819,
					"content": "Hmm... « Bien que j'ai entendu quelque chose de très familier... » Oui, « Mais il y a encore tellement de choses à observer, et voir si d'autres sont témoins du même phénomène »...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390820
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390820,
					"content": "Hmm ? Ça veut dire que vous devez trouver d'autres personnes pour vous aider à tester vos potions ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390821
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390821,
					"content": "C'est exact. Parce que... Euh... Je dois avoir au moins deux témoins fiables qui voient la même chose afin de prouver que la potion peut vraiment permettre aux gens de voir la « vérité », vous comprenez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390822
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390822,
					"content": "Parce que la « vérité » ne sera pas limitée ou contrainte par les yeux et les perspectives du spectateur. Elle ne sera pas non plus déformée par ce qui est dans son cœur... En revanche, elle existe de façon objective, et se contente d'être.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390823
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390823,
					"content": "Hmm... Comme des dieux qui vivent des milliers d'années ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390824
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390824,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390825
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390825,
					"content": "Non. Plutôt comme ce sable blanc, comme les os des étoiles de mer, comme le fracas et le martèlement des vagues... C'est de ces choses qu'il est question.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390826
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390826,
					"content": "Mais la grande potionniste a aussi dit... que la « vérité » peut également être créée par les rêves et les souvenirs. Je ne comprends pas tout à fait, cela me semble contradictoire... Mais je fais de mon mieux pour comprendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390827
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390827,
					"content": "Waouh... Le sujet est devenu très profond tout d'un coup...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390828
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390828,
					"content": "Haha, alors ne parlons pas de telles choses pour l'instant ! Je tiens vraiment à vous remercier pour votre aide ! Prenez ceci, s'il vous plaît !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390829
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390829,
					"content": "Hmm... Et surtout, assurez-vous de revenir la prochaine fois que je préparerai une nouvelle potion !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390815,
					"content": "On aurait dit qu'il avait été coupé en deux par quelque chose d'énorme...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390816
					]
				},
				{
					"id": 740390816,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390817
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390817,
					"content": "Ah ! Désolée ! J'étais perdue dans mes pensées pendant un instant... Mais... Mais j'ai déjà tout écrit, merci beaucoup !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390818
					],
					"speakerTitle": "Vérénata"
				}
			]
		},
