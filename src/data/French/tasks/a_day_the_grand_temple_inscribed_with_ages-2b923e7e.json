			},
			"dialogs": [
				{
					"id": 760950101,
					"content": "#{NICKNAME}, Paimon... Merci. Je suis vraiment contente de vous avoir rencontré{F#e}s en fin de compte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950102
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950102,
					"content": "Héhé. Au contraire, on a plutôt l'impression que c'est nous qui vous avons entraînée dans tout ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950103,
					"content": "#Attendez... « En fin de compte »{NON_BREAK_SPACE}? Que voulez-vous dire{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950104,
					"content": "Je veux dire... Nos aventures étaient toutes assez dangereuses, mais j'ai vu tellement de choses incroyables.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950105
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950105,
					"content": "Ce n'est pas si mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950106
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950106,
					"content": "#Hé{NON_BREAK_SPACE}! Ne m'ignorez pas comme ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950107,
					"content": "#Je vous ai ignorée{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zeitlind"
				}
			]
		},
