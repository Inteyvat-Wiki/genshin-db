					}
				]
			},
			"dialogs": [
				{
					"id": 760950301,
					"content": "Istoria, on a pratiquement libéré les trois zones. La plupart des gens sont désormais en sécurité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950302,
					"content": "Et on a même retrouvé tout ce que Zeitlind avait perdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950303,
					"content": "Oh, merci beaucoup. Je dois dire que Nihilita a l'œil pour cerner les gens, maintenant qu'il l'a ouvert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950304
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950304,
					"content": "#Très bien, à vous maintenant{NON_BREAK_SPACE}! Vous avez mentionné qu'il existe un moyen d'accéder à un niveau supérieur et qu'il y a un prix à payer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950305,
					"content": "#Allez{NON_BREAK_SPACE}! Je n'ai pas peur de quelques aventures ni d'un peu de moras{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950306,
					"content": "#Oh{NON_BREAK_SPACE}! Et Zeitlind{NON_BREAK_SPACE}? Comment on va faire pour la renvoyer maintenant qu'elle a fini ce qu'elle devait faire ici{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950307,
					"content": "Je peux vous expliquer tout ça, mais vous devriez d'abord vous reposer. Je vous dirai tout en détail demain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950308
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950308,
					"content": "#D'accord. Mais euh, il n'y a pas de lit ici. Ni de nourriture{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950309,
					"content": "Ces besoins cessent d'exister ici. Réfléchissez-y. Vous êtes là depuis tout ce temps, et pourtant vous ne ressentez ni faim ni fatigue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950310
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950310,
					"content": "#Hein{NON_BREAK_SPACE}? Alors qu'est-ce que je vais faire pendant qu'on se repose{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950311,
					"content": "Cet endroit regorge de personnes remarquables de toutes les époques... Discuter avec elles pourrait être amusant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950312
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950312,
					"content": "#Très bien, mais je peux dormir quand je veux. Fatiguée ou pas, je dors toujours sur la tête de {NICKNAME}{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950313,
					"content": "#Zeitlind, après que vous vous serez un peu reposée, on pourrait discuter{NON_BREAK_SPACE}? C'est à propos de ce que j'ai mentionné précédemment, la chose pour laquelle j'avais besoin de temps pour réfléchir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950314
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950314,
					"content": "#Venez me parler plus tard, d'accord{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950315
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950315,
					"content": "D'accord.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950316
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950316,
					"content": "#{NICKNAME}, Paimon. Une fois que vous vous serez reposé{F#e}s, venez me voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Istoria"
				}
			]
		},
