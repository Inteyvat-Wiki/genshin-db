			},
			"dialogs": [
				{
					"id": 700030501,
					"content": "Hmm, c'était vraiment un chaton en fin de compte. Je me demande ce qu'il fait là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700030502,
					"content": "Miaou... Miaou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030503,
						700030504
					],
					"speakerTitle": "Chaton perdu"
				},
				{
					"id": 700030503,
					"content": "Miaou miaou miaou ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030505
					]
				},
				{
					"id": 700030505,
					"content": "Miaou miaou !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030506
					],
					"speakerTitle": "Chaton perdu"
				},
				{
					"id": 700030506,
					"content": "Euh... Je suis sûre qu'il ne comprend rien à ce que tu dis, tu sais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700030507,
					"content": "Bon, aidons-le déjà à descendre de là. Peut-être qu'Aramis saura à qui il appartient.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700030504,
					"content": "Tu t'es perdu ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030505
					]
				}
			]
		},
		{
			"id": 7000306,
			"completionStepIds": [
				7000308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
