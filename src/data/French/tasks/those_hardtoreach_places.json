				"objectNames": [
					"Aramis"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700030101,
					"content": "Oh, qu'est-ce que je vais bien pouvoir faire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030102
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700030102,
					"content": "Qu'est-ce qui vous arrive ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030103
					]
				},
				{
					"id": 700030103,
					"content": "À chaque Fête des alizées, les gens viennent pour déposer toutes sortes de fleurs en offrande pour la statue de l'Archon. Mais dès qu'une rafale arrive, les pétales s'envolent dans toute la ville.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030104
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700030104,
					"content": "Nous consacrons beaucoup d'efforts et de temps au nettoyage de ces pétales. Mais, même si je peux m'occuper de ceux qui restent sur la place, je ne peux pas faire grand-chose pour ceux qui finissent sur les toits et les remparts de la ville.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030105
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700030105,
					"content": "Certainement pas avec mes genoux, qui plus est...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030106
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700030106,
					"content": "Je peux aider.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030107
					]
				},
				{
					"id": 700030107,
					"content": "Vraiment ? Oh, ce serait merveilleux. Ces pétales sont assez faciles à repérer. Vous devriez pouvoir les apercevoir sans problème en grimpant sur les toits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aramis"
				}
			]
		},
