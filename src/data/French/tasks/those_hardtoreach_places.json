			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aramis"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700030601,
					"content": "Je suis désolé, je ne pense pas l'avoir déjà vu avant. Si c'était le cas, je m'en souviendrais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030602
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700030602,
					"content": "Oh, je vois... Mon bébé adore les fleurs. Je me disais qu'il avait probablement chassé des pétales jusqu'ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030603
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700030603,
					"content": "Tu as perdu ton chat ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030604
					]
				},
				{
					"id": 700030604,
					"content": "Miaou... Miaou !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030605
					],
					"speakerTitle": "Chaton perdu"
				},
				{
					"id": 700030605,
					"content": "Oh, mais c'est... Papillon ? Oh, c'est toi ! Où étais-tu passé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030606
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700030606,
					"content": "Il était sur les toits.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030607
					]
				},
				{
					"id": 700030607,
					"content": "C'est bien ce que je pensais... Merci beaucoup. Papillon adore chasser les pétales. Alors, pendant la Fête des alizées... Heureusement que tu l'as retrouvé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030608
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700030608,
					"content": "La prochaine fois que tu viens à La Queue de Chat, c'est ma tournée ! Enfin, tant que c'est sans alcool, s'entend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030609,
						700030610
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700030609,
					"content": "Évidemment...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030611
					]
				},
				{
					"id": 700030611,
					"content": "Haha... Merci encore. À bientôt et joyeuse Fête des alizées !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030612
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700030612,
					"content": "Je ne savais pas que les chats aussi étaient attirés par les fleurs. Cette fête est vraiment pleine de surprises... Eh bien, heureusement que vous avez retrouvé ce chaton.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030613
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700030613,
					"content": "S'il avait fallu que ce soit moi qui monte le sauver, mes genoux n'auraient jamais tenu le coup...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030614
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700030614,
					"content": "Merci de m'avoir aidé. Voici un petit quelque chose pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700030610,
					"content": "Ce sera pour la prochaine fois.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030611
					]
				}
			]
		}
	]
