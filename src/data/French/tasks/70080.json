			"dialogs": [
				{
					"id": 700800101,
					"content": "Après avoir frôlé la mort, c'est le goût de la bière qui me manque le plus. Même mon maître et le roi Deshret lui-même passeraient après.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700800102
					],
					"speakerTitle": "Venipi"
				},
				{
					"id": 700800102,
					"content": "Ah. Je ne savais pas que vous aimiez autant boire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700800103
					],
					"speakerTitle": "Kshama"
				},
				{
					"id": 700800103,
					"content": "À l'époque, lorsque nous livrions des briques au mausolée du roi Deshret, nous avions droit chaque jour à deux grandes chopes de bière gratuites.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700800104
					],
					"speakerTitle": "Venipi"
				},
				{
					"id": 700800104,
					"content": "D'ailleurs, Maukie fait-il partie de ceux qui ont été rétablis ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700800105
					],
					"speakerTitle": "Venipi"
				},
				{
					"id": 700800105,
					"content": "Non. Je soupçonne que les supérieurs ont l'intention de s'occuper de lui... en violation des règles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700800106
					],
					"speakerTitle": "Vitruvius"
				},
				{
					"id": 700800106,
					"content": "Je me demande si la note que je lui ai demandé d'apporter en secret lui a été utile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vitruvius"
				}
			]
		}
