			"dialogs": [
				{
					"id": 401181101,
					"content": "C'est la première fois que je bois un thé qui a ce goût. Le thé inazumien semble très différent de ce que nous avons à Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401181102
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401181102,
					"content": "Ah oui, il paraît que les habitants de Sumeru aiment mettre des épices dans leur thé, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401181103
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401181103,
					"content": "Oui, c'est vrai ! Mais je n'arrive toujours pas à m'y habituer... Si je devais choisir, je boirais du café, même si ça me donne parfois des insomnies.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Collei"
				}
			]
		},
