			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Klee",
					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401181001,
					"content": "Je veux faire du chariot tchou-tchou avec mademoiselle la générale ! Plus haut, plus haut, plus haut, et... Ouiiiiiii !! Mais euh, je suppose que le trajet lui donne un peu le vertige...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401181002
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401181002,
					"content": "Ah, tu as remarqué ? Très bien. Était-ce les étoiles tournant dans ses yeux hébétés qui t'ont mis sur la piste ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401181003
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401181003,
					"content": "Ouais. Hier, elle avait beaucoup de petites étoiles dorées flottant autour d'elle. Mais il y en a beaucoup moins aujourd'hui !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401181004
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401181004,
					"content": "Si maman était là, elle dirait probablement que les étoiles sont toutes des poissons tombés dans les nuages !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				}
			]
		},
		{
