				"points": []
			},
			"dialogs": [
				{
					"id": 401180901,
					"content": "En tant que descendant de l'illustre Clan Lawrence, j'ai acquis de nombreuses compétences au cours de mon voyage, par exemple... Faire du pain plat !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401180902
					],
					"speakerTitle": "Lessig"
				},
				{
					"id": 401180902,
					"content": "Bon, il devrait avoir atteint la bonne température.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401180903
					],
					"speakerTitle": "Lessig"
				},
				{
					"id": 401180903,
					"content": "Je ne savais pas que vous saviez cuisiner... Je pensais que vous seriez du genre à ne jamais vous approcher de la cuisine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401180904
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401180904,
					"content": "Ah, je voulais vous demander... Avez-vous du temps plus tard ? Pourriez-vous m'apprendre à préparer vos délicieuses collations ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401180905
					],
					"speakerTitle": "Lessig"
				},
				{
					"id": 401180905,
					"content": "Oh ? Mais cela pourrait prendre du temps. De plus, nous ne sommes pas ici pour nous amuser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401180906
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401180906,
					"content": "Vous vous inquiétez à nouveau de votre appartenance au Clan Lawrence... Mais vous avez dit vous-même que nous ne sommes que des gens ordinaires, alors pourquoi n'apprenons-nous pas l'un de l'autre comme le feraient des cousins normaux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lessig"
				}
			]
		},
		{
			"id": 4011810,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
