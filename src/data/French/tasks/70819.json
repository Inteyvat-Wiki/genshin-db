				"objectNames": [
					"Hannelore"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708190201,
					"content": "Oh... merci pour votre gentillesse, mais en tant que religieuse de l'Église de Favonius, je ne peux accepter de tels cadeaux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708190202
					],
					"speakerTitle": "Hannelore"
				},
				{
					"id": 708190202,
					"content": "Il me suffit de respirer un peu de ce parfum porté par la brise marine. Les belles choses appartiennent au vent, et non à une seule personne. C'est le principe de ceux qui marchent sur le chemin de la foi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708190203
					],
					"speakerTitle": "Hannelore"
				},
				{
					"id": 708190203,
					"content": "Malgré tout, votre gentillesse, chaleureuse comme la brise du sud, m'est parvenue. Veuillez accepter ce livre comme modeste cadeau en retour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708190204
					],
					"speakerTitle": "Hannelore"
				},
				{
					"id": 708190204,
					"content": "Que l'Archon Anémo veille sur vous. Et que le chemin qui s'ouvre à toi soit rempli, comme ce parfum, de vertu, de liberté et de compassion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hannelore"
				}
			]
		},
