			"dialogs": [
				{
					"id": 760520501,
					"content": "Glou... Glou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520502
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520502,
					"content": "Ouah, elle a tout bu d'une traite ! Je crois qu'elle aime ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520503,
					"content": "Hm... C'était fade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520504
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520504,
					"content": "F—Fade ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520505,
					"content": "Oui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520506,
						760520507
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520506,
					"content": "Peut-être que vous l'avez bue trop vite...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520508
					]
				},
				{
					"id": 760520508,
					"content": "Ça ira, merci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520509
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520509,
					"content": "Avant, je ne comprenais pas la joie des gens au moment des récoltes. Et un jour, j'ai touché un fruit mûr suspendu à une branche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520510
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520510,
					"content": "J'ai senti la vitalité qui se dégageait de sa peau. C'était la convergence de la lumière du soleil, de l'eau, de la terre et de l'air.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520511
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520511,
					"content": "Avec chaque bouchée, une saveur fraîche et sucrée déferlait sur moi comme des vagues de mousse rafraîchissantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520512
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520512,
					"content": "C'est ainsi que j'ai compris le pouvoir d'un parfum irrésistible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520513
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520513,
					"content": "Oh, intéressant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520514,
					"content": "Nous complétons le cycle de la nature en prenant cette vitalité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520515
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520515,
					"content": "L'ambiance s'est assombrie tout à coup...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520516,
					"content": "C'est pour cette raison que je préfère les fruits frais. Cela me permet de voir ce que je prends de ce monde, tel qu'il est avant que je le prenne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520517
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520517,
					"content": "Cela me rappelle ce que je dois en retour à ce monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520507,
					"content": "Et si je vous refaisais un verre ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520508
					]
				}
			]
		},
