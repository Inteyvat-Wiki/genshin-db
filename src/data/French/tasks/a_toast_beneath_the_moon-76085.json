			"dialogs": [
				{
					"id": 760850601,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850602
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760850602,
					"content": "Celle-ci est délicieuse !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850603
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760850603,
					"content": "C'est ma préférée jusqu'à présent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850604
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760850604,
					"content": "Waouh ! Enfin une boisson qui plaît à Columbina ! Je suis trop contente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760850605,
					"content": "Hum, désolée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850606
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760850606,
					"content": "Résumons : pas d'amertume notable, ne jamais ajouter le jus de fruits directement, c'est acceptable d'ajouter du lait mais c'est meilleur sans...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760850607,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850608
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760850608,
					"content": "C'est donc une boisson « plus légère »...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760850609
					]
				},
				{
					"id": 760850609,
					"content": "C'est super d'avoir trouvé la formule ! À l'avenir, on saura exactement comment préparer les boissons comme vous les aimez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760850610,
					"content": "... À l'avenir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850611
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760850611,
					"content": "#Bien sûr ! On est {M#amis}{F#amies}, n'hésitez pas à nous le dire dès que vous avez soif !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760850612,
					"content": "Attendez, c'est pour ça que vous ne finissez pas votre verre ? Ne me dites pas que vous le savourez en pensant que c'est la dernière fois que vous pourrez en boire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760850613,
					"content": "... Oh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850614
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760850614,
					"content": "C'est bon, ne vous inquiétez pas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760850615
					]
				},
				{
					"id": 760850615,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850616
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760850616,
					"content": "Merci pour cette délicieuse boisson.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				}
			]
		},
