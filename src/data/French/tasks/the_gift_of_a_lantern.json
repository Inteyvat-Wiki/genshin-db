			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jiangcheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718180201,
					"content": "Ma chérie, tu es revenue ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180202
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180202,
					"content": "#{M#Désolé}{F#Désolée}, vous vous trompez de personne...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180203
					]
				},
				{
					"id": 718180203,
					"content": "Qu'est-ce que tu racontes... Comment pourrais-je ne pas reconnaître ma propre femme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180204
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180204,
					"content": "J'étais justement en train de me dire qu'avec la nouvelle année qui arrive, il était grand temps d'acheter de nouveaux vêtements à notre fille...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180205
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180205,
					"content": "Oh... Tu as ramené quelqu'un, je vois... C'est la couturière, c'est ça ? Tu m'as devancé, on dirait !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180206
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180206,
					"content": "Monsieur Jiangcheng, c'est moi... Xiaobai... Je vous ai donné du tofu il y a quelques jours. Vous ne m'avez pas oubliée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180207
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718180207,
					"content": "Oh... Xiaobai... Bien sûr que je me souviens de toi ! L'autre jour encore, ton papa me vantait tes éloges...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180208
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180208,
					"content": "Euh... Quand est-ce que c'était, déjà... Chérie, tu t'en rappelles ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180209,
						718180210
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180209,
					"content": "... Euh, je m'en souviens...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180211
					]
				},
				{
					"id": 718180211,
					"content": "Ah, je me disais bien, j'ai une mémoire de fer... Et puis... Euh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180212
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180212,
					"content": "Monsieur Jiangcheng, reposez-vous un peu. Ne vous fatiguez pas trop...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180213
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718180213,
					"content": "#{M#Voyageur}{F#Voyageuse}, et si tu m'aidais à nettoyer un peu sa maison pendant que je lui tiens compagnie ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180214
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718180214,
					"content": "Je m'en charge.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180215
					]
				},
				{
					"id": 718180215,
					"content": "Merci beaucoup !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718180210,
					"content": "Bien sûr que oui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180211
					]
				}
			]
		},
		{
