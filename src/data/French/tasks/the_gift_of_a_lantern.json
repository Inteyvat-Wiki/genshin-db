			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xiaobai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718180501,
					"content": "#Merci pour ton aide, {M#voyageur}{F#voyageuse}. Si j'avais été seule, ça m'aurait pris une éternité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180502
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718180502,
					"content": "Je ne voulais pas que monsieur Jiangcheng reste tout seul pendant les fêtes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180503
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718180503,
					"content": "Et toi alors...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180504
					]
				},
				{
					"id": 718180504,
					"content": "Oh... Je vais rentrer, j'ai encore des choses à faire au moulin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180505
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718180505,
					"content": "Il appartenait à mon père... À sa mort, j'en ai hérité. J'ai donc quitté mon travail à Liyue pour revenir reprendre l'affaire familiale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180506
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718180506,
					"content": "Je ne sais pas vraiment comment l'expliquer, mais... Être ici, faire la même chose que lui... Je ne sais pas, je me sens un peu nostalgique...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180507
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718180507,
					"content": "Pendant le festival surtout, je repense à certaines choses que m'a dites mon père...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180508
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718180508,
					"content": "Oh, j'allais oublier. Après cette lanterne que j'ai préparée pour monsieur Jiangcheng, je dois aussi m'en faire une.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180509
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718180509,
					"content": "Mais j'ai déjà utilisé tout ce que j'avais... Je n'ai plus assez de matériaux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180510
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718180510,
					"content": "#Si je vais récupérer tout ce dont j'ai besoin maintenant, je ne finirai jamais à temps... {M#Voyageur}{F#Voyageuse}, pourrais-tu m'aider à récupérer quelques matériaux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180511
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718180511,
					"content": "Sans problème.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180512
					]
				},
				{
					"id": 718180512,
					"content": "Merci, c'est gentil de ta part.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiaobai"
				}
			]
		},
