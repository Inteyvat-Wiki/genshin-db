			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xiaobai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718180101,
					"content": "#Bonjour {M#voyageur}{F#voyageuse}, et merci pour la dernière fois ! Ça faisait longtemps que le Village de Qingce n'avait pas été aussi animé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180102
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718180102,
					"content": "Pas la peine de me remercier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180103
					]
				},
				{
					"id": 718180103,
					"content": "Les années précédentes, il n'y avait que Zhi et moi... Alors, on pouvait tout au plus préparer quelques lanternes célestes pour les enfants, accompagner un peu les personnes âgées, ou cuisiner quelques plats...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180104
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718180104,
					"content": "Grâce à ton aide, on a pu organiser un vrai Festival des lanternes cette année !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180105
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718180105,
					"content": "Même s'il y a de l'animation, j'aimerais bien rendre visite aux anciens du village... Aujourd'hui, je pense aller voir Jiangcheng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180106
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718180106,
					"content": "Si tu veux, tu n'as qu'à venir avec moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180107
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718180107,
					"content": "Je te suis.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180108
					]
				},
				{
					"id": 718180108,
					"content": "Parfait. Allons le voir chez lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiaobai"
				}
			]
		},
		{
			"id": 7181802,
			"completionStepIds": [
				7181802
