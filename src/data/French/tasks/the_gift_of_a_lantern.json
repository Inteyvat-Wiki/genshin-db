			"trigger": {
				"objectNames": [
					"Jiangcheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718180301,
					"content": "Ma chérie, viens papoter avec Xiaobai... Son père est un artisan tellement doué...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180302
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180302,
					"content": "Ils vendent même son tofu au Port de Liyue, c'est vraiment un bon produit !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180303
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180303,
					"content": "Mais qu'est-ce qui t'amène ici Xiaobai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180304
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180304,
					"content": "On vous apporte une lanterne céleste.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180305
					]
				},
				{
					"id": 718180305,
					"content": "Une lanterne céleste... Oh, c'est gentil... Tu m'en apportes chaque année, Xiaobai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180306
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180306,
					"content": "Chérie, tu te souviens ? Je fabriquais de superbes lanternes célestes quand j'étais plus jeune... Tous les voisins les adoraient et voulaient que j'en fasse pour eux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180307
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180307,
					"content": "Les lanternes offrent un si joli spectacle chaque année... Attends, je vais l'accrocher...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180308
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180308,
					"content": "Laissez-moi faire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180309
					]
				},
				{
					"id": 718180309,
					"content": "Bien, mais fais attention... Ne va pas te faire mal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiangcheng"
				}
			]
		},
		{
