			"dialogs": [
				{
					"id": 730151301,
					"content": "On n'aurait jamais trouvé cet endroit sans Aranakula pour nous guider...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151302,
					"content": "Par contre, je ne pense pas avoir vu de feuilles ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151303,
					"content": "Les feuilles... Les feuilles sont près du grand arbre, pas loin, mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151304
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151304,
					"content": "Hmm... C'est sûr ici. Les Fongus ne devraient pas venir. Aranakula peut nous y attendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151305,
					"content": "Arapandu nous a dit comment procéder, tu te souviens ? Il suffit d'orienter les feuilles des trois pierres vers la branche qui se trouve ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151306,
					"content": "#Merci nara {NICKNAME}, merci Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakula"
				}
			]
