				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aranakula",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730151101,
					"content": "#Oh ! Merci, nara {NICKNAME} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151102
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151102,
					"content": "La vana se souvient de tout ce qui s'est passé après la venue de nara Varuna. Les arbres s'en souviennent, ainsi que les graines. Mais je ne sais pas si nara Varuna comprend tout ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151103
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151103,
					"content": "#Donc, on laisse des souvenirs visibles, de sorte que quand nara Varuna reviendra dans la vana, {M#elle}{F#il} saura que la vana n'oubliera pas, et que les aranaras n'oublieront pas non plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151104
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151104,
					"content": "Je comprends maintenant... Le souvenir de la pierre est en fait un mémorial. D'ailleurs, les humains aussi construisent des mémoriaux pour ne pas oublier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151105,
					"content": "C'est parce que les naras sont des êtres qui oublient facilement.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151106
					]
				},
				{
					"id": 730151106,
					"content": "Comparé à la forêt, les naras sont comme de jeunes pousses. Ils ne peuvent pas pousser pour devenir de grands arbres, et ils n'ont pas de cernes qui peuvent tout garder en mémoire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151107,
					"content": "Nous, les aranaras, on ne partira pas de la vana, on restera toujours avec la vana. Les naras, en revanche, viennent et repartent, tout comme nara Varuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151108
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151108,
					"content": "Il y a beaucoup d'aranaras, tout comme il y a beaucoup de grands arbres dans la vana. Beaucoup d'aranaras, qui ont beaucoup de noms, tout comme les grands arbres ont beaucoup de branches et de feuilles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151109
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151109,
					"content": "#Tu te souviens de beaucoup des noms aranariens, {M#nara doré}{F#nara dorée}. En plus, tu te souviens du nom d'Aranakula. C'est comme si tu ramassais une feuille qui tombe et que tu savais de quel grand arbre elle provient.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151110
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151110,
					"content": "#Je crois comprendre que nara Varuna est {M#une}{F#un} nara {M#spéciale}{F#spécial} pour les aranaras. Et donc, vous avez construit un mémorial spécialement pour {M#elle}{F#lui}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151111,
					"content": "On a déjà pu voir des statues avec des visages uniques par le passé, même si ce n'était pas la même chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151112,
					"content": "Des statues ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151113
					]
				},
				{
					"id": 730151113,
					"content": "#Oui ! {NICKNAME}, tu n'as pas envie de savoir à quoi ressemble {M#cette}{F#ce} nara Varuna, après avoir entendu son histoire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151114,
					"content": "Puisque les aranaras savent faire de la musique, peut-être qu'ils sont bons dans d'autres domaines aussi ! Par exemple, se pourrait-il qu'ils sachent produire des sculptures réalistes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151115,
						730151117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151115,
					"content": "S'il existe de telles choses, alors j'aimerais les voir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151116
					]
				},
				{
					"id": 730151116,
					"content": "#N'est-ce pas ? Héhé. Nara Varuna, {M#une nara dorée}{F#un nara doré}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151119,
					"content": "Au fait, on peut aller réparer les branches et les feuilles de l'outil varuna maintenant, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151120,
					"content": "#Nara {NICKNAME}, Paimon, je vais vous montrer la voie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151117,
					"content": "L'art aranarien est si simple que c'est difficile à imaginer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151118
					]
				},
				{
					"id": 730151118,
					"content": "#Hmm... Peut-être que leur art est trop avancé pour toi, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151119
					],
					"speakerTitle": "Paimon"
				}
			]
		},
