			},
			"dialogs": [
				{
					"id": 730150901,
					"content": "#Nara {NICKNAME}, voici le souvenir de la pierre que les aranaras ont laissé pour nara Varuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150902
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150902,
					"content": "Enfin, on y est... Tout ça pour ne pas se faire repérer par les Fongus sur tout le chemin, c'était vraiment trop stressant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150903,
						730150905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150903,
					"content": "Ce n'est pas plus mal d'éviter de se battre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150904
					]
				},
				{
					"id": 730150904,
					"content": "Certes, mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150907,
					"content": "Oh... C'est donc ça, le souvenir de la pierre ? Ça ressemble à une stèle que les aranaras auraient construite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150908,
					"content": "#Nara {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150909
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150909,
					"content": "Je vais nettoyer les mauvaises graines.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150910
					]
				},
				{
					"id": 730150910,
					"content": "#Ne t'inquiète pas trop, Aranakula. Laisse faire nara {NICKNAME}, ça ne lui demandera pas beaucoup d'effort !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150905,
					"content": "On n'a qu'à considérer ça comme le fait de laisser quelques casse-croûtes d'urgence dans la forêt...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150906
					]
				},
				{
					"id": 730150906,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150907
					],
					"speakerTitle": "Paimon"
				}
			]
		},
