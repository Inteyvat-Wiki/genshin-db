			"dialogs": [
				{
					"id": 730152101,
					"content": "Les aranaras sont tout petits, pas étonnant qu'ils aient peur lorsqu'ils rencontrent des Fongus plus grands qu'eux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730152102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730152102,
					"content": "Paimon, tu n'as pas peur ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730152103
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730152103,
					"content": "Moi ? Bien sûr que non !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730152104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730152104,
					"content": "Oh... Aranakula est plus fort que Paimon, mais pas aussi courageux qu'elle. Si des Fongus attaquent, je vais me cacher dans l'<color=#00E1FFFF>endroit sûr</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakula"
				}
			]
