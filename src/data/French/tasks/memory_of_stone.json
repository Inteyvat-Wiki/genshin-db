			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Aranakula"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730150301,
					"content": "Tu dois certainement être Aranakula !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150302,
					"content": "Ouah ! Des naras m'ont repéré ! Que... Qu'est-ce que je dois faire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150303
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150303,
					"content": "#Attends ! Ne t'en va pas ! C'est Arapandu qui nous a dit de venir te trouver ici{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150304,
					"content": "#P—Puisque c'est Arapandu qui vous l'a dit, vous devez être des {M#gentils}{F#gentilles} naras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150305
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150305,
					"content": "#Tiens ? Aranakula, tu n'es pas un peu crédule ? Et si {NICKNAME} était {M#un méchant}{F#une méchante} nara et qu'{M#il}{F#elle} utilisait le nom d'Arapandu pour te tromper...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150306,
					"content": "#Ah ! {M#L—Le}{F#L—La} nara {M#doré}{F#dorée} est vraiment en train de mentir à Aranakula ? {M#L—Le}{F#L—La} nara {M#doré}{F#dorée} est vraiment {M#un méchant}{F#une méchante} nara ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150307
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150307,
					"content": "J'ai soudainement des remords...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150308,
					"content": "#N'écoute pas Paimon, je suis {M#un gentil}{F#une gentille} nara.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150309
					]
				},
				{
					"id": 730150309,
					"content": "#Super. Aramuhukunda soit loué, {M#le nara doré}{F#la nara dorée} est bel et bien {M#un gentil}{F#une gentille} nara. Nara {NICKNAME}, même si tu es beaucoup plus {M#grand}{F#grande} qu'Aranakula, Aranakula n'a pas peur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150310
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150310,
					"content": "Paimon... T'es petite, alors je n'ai pas peur non plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150311
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150311,
					"content": "Quoi ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150312,
						730150314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150312,
					"content": "C'est vrai que Paimon est petite...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150313
					]
				},
				{
					"id": 730150313,
					"content": "Ne me sous-estime pas, tu vas le regretter ! Hmph !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150316,
					"content": "Plus sérieusement, on est ici pour réparer l'outil varuna. Dans la vana, on devrait aussi trouver des branches et des feuilles de l'outil varuna, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150317,
					"content": "Arapandu a demandé à ce qu'on vienne t'aider, au cas où tu rencontrerais des problèmes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150318,
					"content": "Il y a beaucoup de méchants dans la vana... Il existe des routes sûres, mais on doit quand même faire attention. Et il y a des mauvaises graines partout, même celles de nara Varuna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150319
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150319,
					"content": "#Nara {NICKNAME}, t'es {M#grand}{F#grande}, et t'as l'air d'être aussi {M#fort}{F#forte} qu'Arabalika... Nara {NICKNAME}, peut-être que t'as une solution...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150320
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150320,
					"content": "#Nara {NICKNAME}, tu pourras peut-être m'aider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150321
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150321,
					"content": "#C'est la raison pour laquelle on est ici, pas vrai, {NICKNAME} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150322,
					"content": "Oui, laisse-nous nous en occuper.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150323
					]
				},
				{
					"id": 730150323,
					"content": "Aranakula a une autre requête. Avant de guérir l'outil varuna... Je veux récupérer le souvenir de la pierre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150324
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150324,
					"content": "« Le souvenir de la pierre » ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150325
					]
				},
				{
					"id": 730150325,
					"content": "La vana n'oublie jamais, les aranaras n'oublient jamais. Mais les aranaras ont laissé des souvenirs visibles. Après l'arrivée des méchants, il y avait des mauvaises graines partout...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150326
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150326,
					"content": "Pourquoi les aranaras parlent-ils toujours de manière énigmatique... Peu importe, quand on aura vu ce que c'est, on devrait comprendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150327,
					"content": "Bon alors, allons-y avec Aranakula !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150328,
					"content": "#{M#Gentil}{F#Gentille} nara, gentille Paimon ! Il ne faut pas attirer l'attention des méchants. Je connais une route sûre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150329
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150329,
					"content": "Hein ? Les méchants dont parle Aranakula, ça doit simplement être des Fongus. Pas de quoi s'inquiéter !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150330,
					"content": "#Héhé, tu sais, Aranakula, nara {NICKNAME} est très {M#fort}{F#forte} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150331,
					"content": "#{M#Il}{F#Elle} n'est pas seulement {M#fort}{F#forte}, {M#il}{F#elle} est très, très {M#fort}{F#forte} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150332,
					"content": "#On a déjà battu beaucoup de Fongus avec Arapandu ! Même Arapandu a reconnu qu'on était {M#forts}{F#fortes} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150333,
					"content": "#D'accord. Alors je pense que nara {NICKNAME} doit être aussi {M#fort}{F#forte} qu'Arabalika. Mais qu'en est-il de Paimon ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150334
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150334,
					"content": "Moi ? Quoi, moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150335
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150335,
					"content": "Il y a eu cette fois... Aranakula était poursuivi par des méchants. Aranakula s'est enfoui sous la terre, mais s'est fait déterrer par les méchants...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150336
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150336,
					"content": "Euh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150337
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150337,
					"content": "Le méchant avait une grande bouche baveuse et chaude, et elle sentait le fruit pourri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150338
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150338,
					"content": "Ouah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150339
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150339,
					"content": "Si Arabalika n'était pas arrivé à temps, Aranakula aurait été...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150340
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150340,
					"content": "*sniff* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150341
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150341,
					"content": "Ensuite, Arapandu a passé beaucoup de temps à me faire la morale. Le soleil s'est couché et s'est levé plusieurs fois, et même les graines plantées dans la pépinière ont eu le temps de germer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150342
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150342,
					"content": "C'était il y a vraiment très longtemps !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150343
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150343,
					"content": "#Mais quel est le rapport avec Paimon{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150344
					]
				},
				{
					"id": 730150344,
					"content": "Ouais, qu'est-ce que cela a à voir avec moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150345
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150345,
					"content": "Aranakula était plus fort que Paimon, mais Aranakula a failli se faire manger par les méchants. P—Paimon vraiment toute petite, c'est trop dangereux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150346
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150346,
					"content": "#O—On dirait que tu as raison... Hein, non ! {NICKNAME} est très {M#fort}{F#forte}, {M#il}{F#elle} me protégera, pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150347,
						730150349
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150347,
					"content": "Bien sûr.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150348
					]
				},
				{
					"id": 730150348,
					"content": "#Héhé, après tout, je suis ta meilleure amie, {NICKNAME} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150351
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150351,
					"content": "#Il y a beaucoup de méchants, Aranakula n'est pas de taille... Euh... Même si {M#le nara doré}{F#la nara dorée} est très {M#fort}{F#forte}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150352
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150352,
					"content": "Je connais un chemin sûr, alors empruntons-le, d'accord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150353
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150353,
					"content": "#Hein ? Dis-moi, Aranakula... Tu n'aurais pas particulièrement peur des Fongus{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150354
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150354,
					"content": "Bouhou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150355
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150355,
					"content": "Héhé ! Alors, c'était donc ça. C'est pas bien de m'utiliser comme excuse !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150356
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150356,
					"content": "Bon, dans ce cas, prenons le chemin sûr avec Aranakula, et faisons attention de ne pas attirer les Fongus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150357
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150357,
					"content": "Je sais comment m'y prendre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150358
					]
				},
				{
					"id": 730150358,
					"content": "C'est vrai, j'ai l'impression qu'on a fait ça déjà plein de fois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150359
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150359,
					"content": "Bien ! Je vais guider les naras sur un chemin sûr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150349,
					"content": "Tu pourras t'enfuir devant, si tu veux.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150350
					]
				},
				{
					"id": 730150350,
					"content": "Je ne vais pas te laisser et m'enfuir ! E—Enfin, je crois ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150351
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150314,
					"content": "Une petite Paimon, avec une grande énergie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150315
					]
				},
				{
					"id": 730150315,
					"content": "Exactement ! Je ne suis pas n'importe qui !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150316
					],
					"speakerTitle": "Paimon"
				}
			]
		},
