					"Aranakula"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730151601,
					"content": "Aranakula, on est de retour ! On compte sur toi pour le reste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151602,
					"content": "#Merci Paimon, merci nara {NICKNAME}. Je sais ce que j'ai à faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151603
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151603,
					"content": "Et voilà ! Il ne devrait plus y avoir de problème ici !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151604,
					"content": "J'espère que tout reviendra bientôt à la normale dans la forêt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151605
					]
				},
				{
					"id": 730151605,
					"content": "Guérir l'outil varuna, on peut y arriver, c'est sûr. Quant à la Marana... Elle doit être éliminée aussi, pour la vana, pour Sarva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151606
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151606,
					"content": "De même que le mémorial qui a été construit pour nara Varuna a été recouvert de mauvaises graines, le Hall d'Ashvattha a également été affecté à cause de la Marana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151607
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151607,
					"content": "C'était une pépinière que des naras et des aranaras avaient construit ensemble avant que nara Varuna n'arrive à Vanarana. Mais maintenant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151608
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151608,
					"content": "Seuls les enfants du Village de Vimara peuvent encore voir les aranaras. Pour les adultes, ils ne sont que des légendes... L'ancienne pépinière d'alors est quant à elle devenue déserte à cause de la Marana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151609,
					"content": "Je veux planter des fleurs partout dans la pépinière. Les naras ont oublié les aranaras, mais ce n'est pas grave, tant que les naras peuvent voir ces fleurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151610
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151610,
					"content": "Aranakula...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151611,
					"content": "#Nara {NICKNAME}, Paimon, merci beaucoup. Je ne vous oublierai jamais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151612
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151612,
					"content": "Aranakula va retourner au point de repos. Arapandu sera très content de savoir que le mémorial a été nettoyé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151613
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151613,
					"content": "#Nara {NICKNAME}, Paimon, voulez-vous retourner au point de repos avec Aranakula ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151614,
						730151616
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151614,
					"content": "Bien sûr.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151615
					]
				},
				{
					"id": 730151615,
					"content": "#Avoir {M#un}{F#une} nara {M#doré}{F#dorée} pour m'accompagner, ça me rassure beaucoup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151616,
					"content": "J'ai encore à faire ici...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151617
					]
				},
				{
					"id": 730151617,
					"content": "#Qu'Aramuhukunda veille sur vous, nara {NICKNAME} et Paimon. Attention à ne pas vous faire dévorer par des méchants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakula"
				}
			]
		},
