			"dialogs": [
				{
					"id": 715350401,
					"content": "Oh ? On dirait que vous avez un vrai talent pour les loisirs créatifs. Cette enveloppe-cadeau est magnifique, merci !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350402
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350402,
					"content": "C'est un peu comme votre cadeau pour moi ! Je n'ai rien sur moi à l'instant, mais dès que je retournerai à Sumeru, je ne manquerai pas de vous envoyer quelque chose en retour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350403
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350403,
					"content": "Je n'ai plus qu'à en faire une pour Candace pour la lui offrir avec le collier. Je suis sûre qu'elle va adorer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350404
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350404,
					"content": "Ah, d'ailleurs, je me demande si elle n'est pas déjà arrivée... Ça fait un bout de temps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dehya"
				}
			]
		}
	]
