			},
			"dialogs": [
				{
					"id": 715350201,
					"content": "#Quel plaisir de vous voir dans le coin, {NICKNAME} ! Vous êtes là pour le Festival des lanternes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350202
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350202,
					"content": "Vous fabriquez une enveloppe-cadeau ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715350203
					]
				},
				{
					"id": 715350203,
					"content": "Oui, j'essaye d'en faire une pour Candace, mais je ne suis pas satisfaite du résultat. J'allais recommencer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350204
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350204,
					"content": "Candace n'est pas venue avec vous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715350205
					]
				},
				{
					"id": 715350205,
					"content": "Non, mais elle devrait bientôt arriver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350206
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350206,
					"content": "Elle ne voulait pas m'accompagner à Liyue au début, elle disait qu'elle devait veiller sur le village.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350207
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350207,
					"content": "Je lui ai dit que tout le monde avait droit à un peu de répit en fin d'année. Je devais escorter une caravane à Liyue de toute façon, alors autant qu'elle en profite aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350208
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350208,
					"content": "J'ai même demandé à mes gars de protéger le village en son absence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350209
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350209,
					"content": "Mais je n'ai pas réussi à la persuader. Au bout du compte, elle a fini par changer d'avis parce que les villageois lui ont dit de prendre des congés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350210
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350210,
					"content": "Quand bien même, elle a insisté pour finir quelques tâches avant de venir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350211
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350211,
					"content": "Mais la caravane ne nous aurait pas attendues, alors je suis ici toute seule pour le moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350212
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350212,
					"content": "C'est tellement difficile de choisir un cadeau ! Il y a trop de choix !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350213
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350213,
					"content": "J'ai fini par lui prendre un collier, mais c'est là que j'ai entendu parler de la tradition des enveloppes-cadeaux. Du coup, j'ai décidé d'en fabriquer une.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350214
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350214,
					"content": "Du moins, j'ai essayé... Ça ne se passe pas trop comme prévu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350215
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350215,
					"content": "#Mais vous tombez à pic, {NICKNAME}. Auriez-vous des astuces à me donner ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350216
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350216,
					"content": "Pas de problème, je vais jeter un œil...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
