				"points": []
			},
			"dialogs": [
				{
					"id": 730590101,
					"content": "« Les grenades chantent, les pommes applaudissent... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590102
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730590102,
					"content": "Bonjour monsieur Khayyam ! Qu'est-ce que vous faites là ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730590103,
					"content": "Oh ! Bonjour, petite enfant blanche, et... *soupir* ... Désolé, ma mémoire se détériore, je n'arrive pas à me souvenir des noms après un certain temps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590104
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730590104,
					"content": "#Appelez-moi {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730590105
					]
				},
				{
					"id": 730590105,
					"content": "Haha... Très bien, donc vous étiez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590106
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730590106,
					"content": "Oui ! On est des javans, des jeunes gens courageux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730590107,
					"content": "Hmm... Alors, dites-moi, les aranaras se souviennent-ils encore de moi ? Se souviennent-ils de nous tous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590108
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730590108,
					"content": "Oh, euh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590109,
						730590112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730590109,
					"content": "Ils se souviennent de vous.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730590110
					]
				},
				{
					"id": 730590110,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730590111,
					"content": "Je vois... Mais je ne peux plus les voir ou les entendre pour savoir à quel point je leur manque... Quel dommage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590114
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730590114,
					"content": "Héhé... Je ne peux plus les voir. Je suis trop vieux pour voir leurs visages ou entendre leurs voix... C'est fini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590115
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730590115,
					"content": "Ahem... Désolé, je dois vous laisser. Peut-être que nous devrions juste espérer un miracle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590116
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730590116,
					"content": "Personne ne peut comprendre ni poursuivre les miracles, ils ne peuvent qu'être attendus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590117
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730590117,
					"content": "Khayyam part en titubant...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 730590112,
					"content": "Ils ne se souviennent pas de vous.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730590113
					]
				},
				{
					"id": 730590113,
					"content": "Mais... on peut redevenir amis avec eux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590114
					],
					"speakerTitle": "Paimon"
				}
			]
		},
