			"dialogs": [
				{
					"id": 760280301,
					"content": "#Te voilà enfin, {NICKNAME} ! Lorsque ces deux trucs lumineux sont entrés en collision, l'explosion m'a fait voler ! Heureusement, je n'ai rien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280302,
					"content": "Ça m'a pris beaucoup de temps pour voler jusqu'ici... mais je suis contente que tu ailles bien !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280303,
						760280308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280303,
					"content": "Moi aussi, j'ai volé pendant longtemps...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760280304
					]
				},
				{
					"id": 760280304,
					"content": "Je vois... Hein ? Comment ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280305,
					"content": "Vous racontez à Paimon ce que vous venez de voir...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760280306
					]
				},
				{
					"id": 760280306,
					"content": "#Hmm, je n'ai jamais entendu parler d'un endroit pareil en Teyvat... T'es {M#sûr}{F#sûre} que tu n'as pas halluciné, {NICKNAME} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280307,
					"content": "#Enfin, l'important, c'est que tu sois {M#sain et sauf}{F#saine et sauve} ! Il y a trop de choses bizarres qui se passent ici. Partons tant qu'on le peut...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280312,
					"content": "Je ne pensais pas que ce serait si dangereux, et on n'a même pas trouvé de trésor... Pourquoi une chose pareille apparaîtrait ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280313,
					"content": "Et si ces deux choses lumineuses n'étaient pas des Fées... alors qu'est-ce que c'était ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280308,
					"content": "#Je crois que j'ai été {M#emporté}{F#emportée} dans un endroit étrange...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760280309
					]
				},
				{
					"id": 760280309,
					"content": "Vous racontez à Paimon ce que vous venez de voir...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760280310
					]
				},
