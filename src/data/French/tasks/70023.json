						700230103
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700230103,
					"content": "Mani. Mi muhe mani. Unu du mani ! Hahahahaha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700230104
					],
					"speakerTitle": "Brutocollinus"
				},
				{
					"id": 700230104,
					"content": "Il m'a raconté une blague en Brutocollinus et ça l'a fait rire. Les pauvres, ils sont plutôt simples d'esprit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700230105
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700230105,
					"content": "Mi muhe <color=#00E1FFFF>kucha gusha</color>. Kucha gusha dada. Unu gusha dada !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700230106
					],
					"speakerTitle": "Brutocollinus"
				},
				{
					"id": 700230106,
					"content": "Il veut... Eh bien... Pas grave, j'ai mes notes !",
