			"dialogs": [
				{
					"id": 700230308,
					"content": "Hola ! C'est comme ça qu'on dit « bonjour » en Brutocollinus, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700230309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700230309,
					"content": "Apparemment, il veut nous dire un truc à propos de cet étrange Brutocollinus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700230301
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700230301,
					"content": "Yeye dada ! Mosi mita !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700230302
					],
					"speakerTitle": "Brutocollinus"
				},
				{
					"id": 700230302,
					"content": "Hahahaha, kucha gusha unu gusha. Unu kucha si !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700230303
					],
					"speakerTitle": "Brutocollinus"
				},
				{
					"id": 700230303,
					"content": "Wei ? Odomu tomo zido mi ! <color=#00E1FFFF>Mosi aba nunu</color> !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700230304
					],
					"speakerTitle": "Brutocollinus"
				},
				{
					"id": 700230305,
					"content": "Mosi mita dada !",
