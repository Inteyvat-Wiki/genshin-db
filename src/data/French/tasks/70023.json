					"nextDialogs": [
						700230307
					]
				},
				{
					"id": 700230306,
					"content": "Tomo, valo !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700230307
					]
				},
				{
					"id": 700230304,
					"content": "« <color=#00E1FFFF>Mosi aba nunu</color> »... Que disent les notes là-dessus ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700230305,
						700230306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700230307,
					"content": "Valo, mi tomo !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Brutocollinus"
				}
