			"dialogs": [
				{
					"id": 761800801,
					"content": "C'est vraiment amusant de jouer avec toi. J'ai hâte de recommencer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800802,
						761800803
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761800802,
					"content": "(Rester encore ici un moment.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800804
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761800804,
					"content": "Tu pars déjà ? D'accord... À la prochaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761800803,
					"content": "L'heure du thé est terminée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800804
					],
					"speakerTitle": "Sandrone"
				}
