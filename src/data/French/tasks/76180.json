			"dialogs": [
				{
					"id": 761800401,
					"content": "Avant, on se retrouvait toujours dans ton jardin, Sandrone. Aujourd'hui, c'est moi qui t'accueille pour le thé dans le mien... C'est une sensation assez nouvelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800402
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761800402,
					"content": "C'est toujours moi qui prépare tout... Je ne vois pas vraiment de différence...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800403
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761800403,
					"content": "Oui, c'est toujours aussi délicieux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800404
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761800404,
					"content": "#Hmm... J'ai entendu dire que {NICKNAME} venait souvent te rendre visite. Que faites-vous ensemble, dans ces moments-là ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800405
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761800405,
					"content": "#Hmm... Parfois on discute, on joue avec les kuuhenkis ou je les regarde peindre. Oh, et il m'arrive aussi de jouer aux échecs lunaires avec {M#lui}{F#elle}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800406
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761800406,
					"content": "Les échecs lunaires ? C'est ce jeu où il faut aligner trois pièces ? Qui gagne le plus souvent ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800407
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761800407,
					"content": "#Je n'ai pas compté, mais {NICKNAME} se débrouille très bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800408
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761800408,
					"content": "Héhé, c'est que tu n'as pas encore joué contre moi. Ça te dit, une partie ? Je vais te montrer ce que c'est, le vrai niveau. En cas d'égalité, ça comptera comme une victoire pour toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800409
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761800409,
					"content": "C'est parti !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				}
			]
		},
		{
			"id": 7618006,
			"completionStepIds": [
				7618004
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
