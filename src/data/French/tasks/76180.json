			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Columbina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761800601,
					"content": "Q—Quoi ? C'est impossible !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800602
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761800602,
					"content": "On dirait que tu as perdu, Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800603
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761800603,
					"content": "J—Je t'ai laissé gagner !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800604
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761800604,
					"content": "Vraiment ? Alors pourquoi tu as l'air si énervée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800605
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761800605,
					"content": "Zut alors... Refaisons une partie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800606
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761800606,
					"content": "Hmph, c'était un jeu d'enfant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800607
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761800607,
					"content": "Tu as gagné. Tu es vraiment douée, Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800608
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761800608,
					"content": "Jouons à quelque chose de plus difficile la prochaine fois. Je connais plein de jeux amusants basés sur les mathématiques.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800609
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761800609,
					"content": "Ça a l'air génial ! Haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800610
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761800610,
					"content": "Hein ? Qu'est-ce qu'il y a de si drôle ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800611
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761800611,
					"content": "Je peux à peine me souvenir de t'avoir vue aussi heureuse auparavant. Tu ne m'as presque jamais invitée à jouer... Tu me chassais, généralement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800612
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761800612,
					"content": "Hé... Ne me fais pas passer pour quelqu'un qui te maltraitait tout le temps, d'accord ? À partir de maintenant, je t'inviterai plus souvent à prendre le thé, ça te va ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800613
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761800613,
					"content": "Ça me plairait beaucoup. J'apprécie ces petits moments passés ensemble, Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				}
			]
		},
