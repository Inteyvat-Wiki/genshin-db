			"dialogs": [
				{
					"id": 752500101,
					"content": "Les visiteurs partent les uns après les autres avec des jouets dans les mains alors que des invités indésirables arrivent dans le Parc des alpagas...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752500102
					]
				},
				{
					"id": 752500102,
					"content": "Euh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500103
					]
				},
				{
					"id": 752500103,
					"content": "Les Fatui qui m'ont volé hier ! C'est vous... Que voulez-vous de plus ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500104
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752500104,
					"content": "Ne vous inquiétez pas, je m'en occupe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752500105
					]
				},
				{
					"id": 752500105,
					"content": "Non...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500106
					]
				},
				{
					"id": 752500106,
					"content": "Celui qui dirige les Fatui agite les mains, puis vous tend une note froissée. Vous la dépliez. Quelques phrases y sont gribouillées...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752500107
					]
				},
				{
					"id": 752500112,
					"content": "C'est donc de ça qu'il s'agissait hier... Donc, quand ils ont tendu la main, en fait ils payaient...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500113
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752500113,
					"content": "J—Je suis désolé... Je vous ai vraiment mal jugés... Vraiment, je tiens à m'excuser !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500114
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752500114,
					"content": "Ces jouets... S'il vous plaît, prenez-les tous ! Considérez ça comme un témoignage de ma gratitude !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500115
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752500115,
					"content": "Le chef des Fatui secoue la tête et lève trois doigts.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752500116
					]
				},
				{
					"id": 752500116,
					"content": "Je comprends... Vous êtes comme les autres héros de Natlan. De véritables modèles d'héroïsme...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500117
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752500117,
					"content": "Dans ce cas, je vais vous choisir trois jouets avec des couleurs qui vous correspondent le mieux. Merci pour votre compréhension !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aloha"
				}
			]
		},
