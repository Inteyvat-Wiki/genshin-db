			"dialogs": [
				{
					"id": 1903201201,
					"content": "Pfiou, je suis crevé. Enfin un peu de repos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201202
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201202,
					"content": "C'est un peu extrême quand même. Certains ont vraiment eu la peur de leur vie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201203
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201203,
					"content": "Qui êtes-vous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201204
					]
				},
				{
					"id": 1903201204,
					"content": "Hein ? Hé, c'est interdit de venir ici !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201205
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201205,
					"content": "*soupir* Peu importe. Je suppose que vous m'avez entendu de toute façon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201206
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201206,
					"content": "Je travaille ici, je joue le rôle d'un fantôme pour effrayer les gens, et c'est l'heure de ma pause. J'ai retiré mon costume, trop chaud et pas vraiment aéré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201207,
						1903201208
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201207,
					"content": "Donc il n'y a pas de mauvais esprits ici, n'est-ce pas ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201209
					]
				},
				{
					"id": 1903201209,
					"content": "Évidemment. Vous pensiez vraiment qu'il y aurait de vrais fantômes ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201210
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201210,
					"content": "Personne n'a envie de croiser un vrai fantôme, ni les visiteurs, ni les employés, vous savez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201211
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201211,
					"content": "Ils viennent juste ici pour l'ambiance, ou devrais-je dire, la chance... Tout le monde veut avoir la chance de ressentir le frisson de l'excitation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201212
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201212,
					"content": "Quand les gens se retrouvent dans une situation effrayante, ils disent des choses qu'ils n'oseraient jamais dire autrement. C'est ce qu'est le test de bravoure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201213,
						1903201214
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201213,
					"content": "Je pense que je comprends.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201215
					]
				},
				{
					"id": 1903201215,
					"content": "*soupir* Bon, c'est l'heure d'y retourner. Amusez-vous bien... Vous et la personne qui vous accompagne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201214,
					"content": "(Chongyun va être déçu.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201215
					]
				},
				{
					"id": 1903201208,
					"content": "Donc tout ça n'est qu'une illusion pour faire peur aux visiteurs, n'est-ce pas ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201209
					]
				}
			]
		}
	]
}