			"dialogs": [
				{
					"id": 750100201,
					"content": "Oh, il y a comme de la fourrure. Quelque chose de moelleux vous bloque la route...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750100202
					]
				},
				{
					"id": 750100202,
					"content": "Hmm ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100203
					],
					"speakerTitle": "Alpaga énergique"
				},
				{
					"id": 750100203,
					"content": "Raouh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100204
					],
					"speakerTitle": "« Œuf mi-cuit »"
				},
				{
					"id": 750100204,
					"content": "Hmm, hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100205
					],
					"speakerTitle": "Alpaga énergique"
				},
				{
					"id": 750100205,
					"content": "Euh ? Alors, vous êtes amis ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750100206,
					"content": "Yaa ! Yaa yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100207
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750100207,
					"content": "On dirait que quelqu'un qui s'occupe des alpagas vient calmer le yumkasaure...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750100208
					]
				},
				{
					"id": 750100208,
					"content": "Doucement, l'Œuf mi-cuit, doucement. C'est précisément pour tous ces jugements hâtifs que tu as hérité de ce surnom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100209
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100209,
					"content": "Raouh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100210
					],
					"speakerTitle": "« Œuf mi-cuit »"
				},
				{
					"id": 750100210,
					"content": "Désolée, il est très consciencieux et devient nerveux lorsque des étrangers approchent. Mais c'est aussi grâce à cet engagement que je peux facilement m'occuper des alpagas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100211
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100211,
					"content": "Alors, qu'est-ce qui vous amène ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100212,
						750100214
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100212,
					"content": "Nous cherchons l'aventure, tout simplement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100213
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750100213,
					"content": "#Oh, alors vous êtes des {M#aventuriers}{F#aventurières}. Peut-être que l'Œuf mi-cuit vous considère comme des adversaires dangereux qui dégagent une aura de menace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100216
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100216,
					"content": "Qui aurait cru que les yumkasaures pouvaient garder des alpagas ? Quand je l'ai vu de loin, j'ai cru qu'il s'attaquait aux bêtes, mais c'était un malentendu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750100217,
					"content": "Haha, ça arrive souvent. Il a peut-être l'air féroce, mais il s'entend bien avec les alpagas, on pourrait même dire qu'ils sont amis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100218
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100218,
					"content": "Raouh... Yaa ! Yaa yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100219
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750100219,
					"content": "Et alors, petit gars, tu veux aussi te lier d'amitié avec eux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100220
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100220,
					"content": "Yaa ! Yaa yaa yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100221
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750100221,
					"content": "#Waouh, on dirait bien, oui. C'est vrai que tu n'es généralement qu'avec {NICKNAME} et moi, donc un ami animal te ferait certainement plaisir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750100222,
					"content": "Ce serait une belle image : un petit tepetlisaure effronté entouré d'alpagas. Je pourrais manger trois bols de ragoût enflammé avant de m'ennuyer de ce spectacle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100223
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100223,
					"content": "Ah, mais bien sûr, cela dépend si mes alpagas sont d'accord. On ne peut pas forcer l'amitié, n'est-ce pas, l'Œuf mi-cuit ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100224
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100224,
					"content": "Mrrmph.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100225,
						750100228
					],
					"speakerTitle": "« Œuf mi-cuit »"
				},
				{
					"id": 750100225,
					"content": "#Oh, qu'est-ce que c'est ? Quelqu'un ne veut pas se lier d'amitié avec notre {REALNAME[ID(2)|SHOWHOST(true)]} ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750100226
					]
				},
				{
					"id": 750100226,
					"content": "Pas besoin d'être sur la défensive ! Laissons-lui une chance de se débrouiller !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750100227,
					"content": "Après tout, les enfants ont besoin de vivre leurs propres expériences pour grandir, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750100231,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100232
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750100232,
					"content": "Il a l'air très confiant, donc je ne m'en fais pas. Je vais rentrer me reposer maintenant. Venez me voir s'il y a un problème...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100233
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100233,
					"content": "Ou plutôt, demandez à l'Œuf mi-cuit. Après tout, c'est lui l'expert des alpagas... Je plaisante. Bonne chance pour te faire des amis, petit gars !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100228,
					"content": "#Ne vous inquiétez pas, si ça ne marche pas, {REALNAME[ID(2)|SHOWHOST(true)]} nous a toujours nous.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750100229
					]
				},
				{
					"id": 750100229,
					"content": "#Bien sûr, tu ne veux pas que {REALNAME[ID(2)|SHOWHOST(true)]} se sente mal si ça ne fonctionne pas... Mais ne soyons pas si pessimiste avant d'avoir essayé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750100230,
					"content": "#Les enfants ont besoin d'encouragements pour grandir en bonne santé. Alors, vas-y {REALNAME[ID(2)|SHOWHOST(true)]} ! Je crois en toi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750100214,
					"content": "Nous voulons profiter de la vie idyllique à la campagne...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750100215
					]
				},
				{
					"id": 750100215,
					"content": "Alors, vous êtes au bon endroit. Laissez les sauriens faire le travail, comme moi, et profitez de la vie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100216
					],
					"speakerTitle": "Wactana"
				}
			]
		},
