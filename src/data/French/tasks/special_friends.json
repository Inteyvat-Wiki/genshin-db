					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750101613,
					"content": "#Je suis sûre qu'elle sera heureuse d'apprendre que {REALNAME[ID(2)|SHOWHOST(true)]} s'est lié d'amitié avec un alpaga !",
					"roleType": "TALK_ROLE_NPC",
