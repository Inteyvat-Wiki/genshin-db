			"dialogs": [
				{
					"id": 750100101,
					"content": "« Je n'ai pas de grandes ambitions ni de désirs urgents, je suis une bergère comblée qui ne se soucie que de ses alpagas, de la belle nature et des choses simples de la vie... »",
					"roleType": "TALK_ROLE_NPC",
