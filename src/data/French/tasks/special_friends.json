			"dialogs": [
				{
					"id": 750101201,
					"content": "Te revoilà petit gars. Alors, t'es-tu fait des amis alpagas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101202
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750101202,
					"content": "Yaa ! Yaa yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101203
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750101203,
					"content": "Haha, tu as l'air tellement heureux que ça me rend heureuse aussi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101204
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750101204,
					"content": "#Vous devriez faire davantage attention aux alpagas. Le nouvel ami de {REALNAME[ID(2)|SHOWHOST(true)]} était en bien mauvaise posture quand nous l'avons trouvé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750101205,
					"content": "Oh non, vraiment ? Je dois dire à l'Œuf mi-cuit de faire plus attention à l'avenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101206,
						750101208
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750101206,
					"content": "Vous prenez vraiment ça à la légère !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750101207
					]
				},
				{
					"id": 750101207,
					"content": "C'est comme ça ! Je vis déjà mon rêve, alors félicitez-moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101211
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750101211,
					"content": "#Au fait, vous pouvez prendre ce jouet alpaga là-bas avec vous si {REALNAME[ID(2)|SHOWHOST(true)]} l'aime bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101212
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750101212,
					"content": "Yaa yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101213
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750101213,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} ne connaît pas les bonnes manières. Merci, Wactana !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101214
					],
					"speakerTitle": "Paimon"
				},
