						750101610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750101608,
					"content": "#Les amis de {REALNAME[ID(2)|SHOWHOST(true)]} sont aussi mes amis.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750101609
					]
				},
				{
					"id": 750101609,
					"content": "Et les miens aussi ! Non, attends. Quand est-ce que c'est devenu une compétition ?",
