			"dialogs": [
				{
					"id": 747060101,
					"content": "... Et celui-là ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060102
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 747060102,
					"content": "J'ai toujours l'impression qu'il manque quelque chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060103
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747060103,
					"content": "Columbina ? Furina ? Qu'est-ce que vous faites ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747060104,
					"content": "La réalisatrice Furina et moi sommes en train de faire un... « casting » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060105
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 747060105,
					"content": "On peut dire ça. Sauf que les « acteurs » que nous cherchons... sont des poissons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060106
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747060106,
					"content": "... Des poissons peuvent être « acteurs » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747060107,
					"content": "Les animaux acteurs ne sont plus rares de nos jours. On cherche à engager un petit poisson charismatique avec exactement l'attitude qu'il faut pour tourner quelques plans d'ambiance... C'est essentiel pour créer l'atmosphère.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060108
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747060108,
					"content": "Mais j'ai l'impression qu'on a vu tous les poissons des aquariums, et aucun ne correspond vraiment à ce qu'on cherche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060109
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747060109,
					"content": "#Vous pourriez demander de l'aide à Paimon et {NICKNAME} ? {M# Ils sont doués}{F# Elles sont douées} pour résoudre les problèmes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060110
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 747060110,
					"content": "Ça fait plaisir de voir que vous avez autant confiance en nous... Mais au sujet de choisir des poissons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060111,
						747060112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747060111,
					"content": "On pourrait essayer de recruter d'autres « candidats » ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747060113
					]
				},
				{
					"id": 747060113,
					"content": "Excellente idée ! Après tout, c'est vous qui avez de l'expérience en gestion d'océanarium.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060114
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747060114,
					"content": "Vous voulez dire que quand nous irons nager, il suffira qu'on garde l'œil ouvert ? Ça n'a pas l'air trop compliqué.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747060115,
					"content": "Alors c'est décidé ! Je vous expliquerai plus tard l'attitude que nous recherchons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060116
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747060116,
					"content": "#Je suppose que cela fait de vous des {M#dénicheurs}{F#dénicheuses} de talents ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060117
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 747060117,
					"content": "Vous avez vraiment appris plein de vocabulaire du monde du spectacle en passant du temps avec Furina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747060112,
					"content": "Ou même faire le casting en pêchant directement ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747060113
					]
				}
			]
		}
	]
