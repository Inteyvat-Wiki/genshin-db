			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Urubamba"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750460101,
					"content": "Hé oh ! Revenez mes petits ! Revenez !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460102
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460102,
					"content": "Bonjour.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460103
					]
				},
				{
					"id": 750460103,
					"content": "Ohé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460104
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460104,
					"content": "Je ne me sens pas bien. Je suis triste... Je n'arrive pas à aller mieux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460105
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460105,
					"content": "Il a suffi que je sorte un instant pour acheter du foin, et mes huit autres petits tatankasaures se sont volatilisés...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460106
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460106,
					"content": "Ce ne sont encore que des bébés ! Que va-t-il leur arriver s'ils se font embêter par des Brutocollinus... Et s'ils se perdent ? Ou qu'ils se retrouvent piégés ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460107
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460107,
					"content": "Âme charitable, auriez-vous vu mes petits tatankasaures par hasard ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460108
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460108,
					"content": "À quoi ressemblent-ils ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460109
					]
				},
				{
					"id": 750460109,
					"content": "J'ai élevé leur mère, vous savez. Elle est comme ma fille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460110
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460110,
					"content": "C'est l'un des plus beaux sauriens du Collectif de l'abondance. Elle a même gagné le premier prix du concours de beauté régional !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460111
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460111,
					"content": "Ces huit petits chenapans ont tous hérité de sa beauté. Ils ont une peau rose clair et un peu de violet sur leurs cornes en forme d'éventail parfaitement symétriques.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460112
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460112,
					"content": "Si vous les voyez, merci de bien vouloir me les ramener ici. Je compte sur vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460113
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460113,
					"content": "Mes petits sauriens... Je vous promets de ne plus être aussi sévère avec vous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460118
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460118,
					"content": "Je garderai l'œil ouvert.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460119
					]
				},
				{
					"id": 750460119,
					"content": "Merci, âme charitable. J'espère que vous battrez votre record au développé couché et que vous n'aurez pas de crampes lors de vos tractions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Urubamba"
				}
			]
		},
