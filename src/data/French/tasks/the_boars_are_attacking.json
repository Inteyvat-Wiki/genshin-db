				"points": []
			},
			"dialogs": [
				{
					"id": 4680401,
					"content": "Bonjour, vous avez des nouvelles de mon fils ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680601,
						4680701,
						4680801
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680601,
					"content": "Qui êtes-vous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680602
					]
				},
				{
					"id": 4680602,
					"content": "Mes collègues du Domaine de l'Aurore m'appellent le vieux Tunner. Je suis vigneron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680603
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680603,
					"content": "Ma famille possède ces terres depuis des générations ! Le raisin fermenté de tous les bons vins du coin vient très probablement de chez moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680604
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680604,
					"content": "Les propriétaires du Domaine de l'Aurore ont toujours été très généreux envers nous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680605
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680605,
					"content": "Mais je ne pense pas que mon fils devrait hériter de ces terres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680601,
						4680701,
						4680801
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680701,
					"content": "Votre fils ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680702
					]
				},
				{
					"id": 4680702,
					"content": "Il s'appelle Guy !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680703
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680703,
					"content": "Vous ne le connaissez pas ? C'est pas grave, vous le connaîtrez tôt ou tard. Tout le monde entendra parler de lui à Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680704
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680704,
					"content": "Mon fils m'a dit qu'il deviendrait le plus puissant des chevaliers de l'Ordre de Favonius. Je crois en lui !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680705
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680705,
					"content": "Depuis son enfance, j'ai beaucoup investi dans son éducation pour qu'il ait un meilleur avenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680706
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680706,
					"content": "Guy est déterminé à réaliser son rêve. Il est devenu écuyer à 16 ans, notre famille dépend de lui désormais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680601,
						4680701,
						4680801
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680801,
					"content": "Au revoir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680802
					]
				},
				{
					"id": 4680802,
					"content": "Au revoir ! Si vous croisez mon fils, dites-lui de revenir à la maison de temps en temps !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tunner"
				}
			]
		},
