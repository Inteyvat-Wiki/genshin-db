			},
			"dialogs": [
				{
					"id": 4680201,
					"content": "On peut vous aider ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680202
					]
				},
				{
					"id": 4680202,
					"content": "Vous êtes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680203
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680203,
					"content": "#Ah, des {M#voyageurs}{F#voyageuses}. C'est gentil de votre part.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680204
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680204,
					"content": "C'est la saison de la vigne en ce moment, mais un troupeau de sangliers sorti de nulle part guette la moindre opportunité de détruire le fruit de mon labeur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680205
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680205,
					"content": "Impossible de les repousser tout seul, et mon fils est absent en ce moment. Je ne peux rien faire pour les empêcher de détruire mon terrain...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680206
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680206,
					"content": "Si vous pouviez m'en débarrasser, je vous promets une très bonne récompense !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tunner"
				}
			]
		},
		{
			"id": 46803,
