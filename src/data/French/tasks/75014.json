			"dialogs": [
				{
					"id": 750140801,
					"content": "(Hmm... Je ne vois pas bien d'ici, mais ils pourraient nous repérer si nous nous approchons davantage. Il vaut mieux écouter d'où nous sommes pour le moment.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750140802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750140802,
					"content": "Nous sommes vraiment satisfaits de la qualité du dernier lot de marchandises. Encore une fois, merci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750140803
					],
					"speakerTitle": "Cuyen"
				},
				{
					"id": 750140803,
					"content": "De rien. Allons-nous procéder comme d'habitude ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750140804
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750140804,
					"content": "Oui, et il faut que ce soit livré avant la course de vol, car certaines personnes en auront besoin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750140805
					],
					"speakerTitle": "Cuyen"
				},
				{
					"id": 750140805,
					"content": "Aucun problème. Je pense qu'ils ont presque fini là-bas. On y va ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750140806
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750140806,
					"content": "(Hein ? Ils partent déjà ? Je ne m'attendais pas à ça... Nous ferions mieux de rentrer. Faisons attention à ne pas nous faire repérer.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
