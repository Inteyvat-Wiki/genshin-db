					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141023,
					"content": "#Génial, je suis {M#sûr}{F#sûre} de gagner quelque chose.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141024
					]
				},
				{
					"id": 750141024,
					"content": "#Tu devrais être un peu plus {M#ambitieux}{F#ambitieuse} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141025
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141013,
					"content": "Quoi ? Il me sous-estime ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141014
					]
				},
				{
					"id": 750141014,
					"content": "Non, ce n'est pas ça ! Que dirait Temach dans ce genre de situation...? Ah, je sais ! Le parcours d'entraînement ne vous a pas permis de montrer ce dont vous êtes capable !",
					"roleType": "TALK_ROLE_NPC",
