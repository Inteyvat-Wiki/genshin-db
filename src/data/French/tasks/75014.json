			"dialogs": [
				{
					"id": 750141001,
					"content": "#{M#Monsieur}{F#Mademoiselle} {NICKNAME} ! Je suis content que vous alliez bien, je m'inquiétais pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141002
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141002,
					"content": "C'était passionnant ! Mais, euh, on en reparlera plus tard parce que c'est compliqué...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141003,
					"content": "Vous racontez à Taruka ce que vous avez vu et entendu au camp...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750141004
					]
				},
				{
					"id": 750141004,
					"content": "Vraiment ? Vous avez vu mademoiselle Quilla, mais pas Lamizana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141005
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141005,
					"content": "Eh bien, ils ont parlé d'une course de vol et d'une transaction. Je n'en sais pas beaucoup plus, mais on dirait qu'ils parlaient de quelque chose qui serait utilisé pendant la course.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141006,
					"content": "Mademoiselle Quilla est une commerçante arrivée récemment et Paran dit qu'elle vend toutes sortes de marchandises. Peut-être que Lamizana lui a acheté quelque chose de dangereux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141007
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141007,
					"content": "Il prévoit donc bien quelque chose de dangereux pendant la course de vol !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141008,
						750141009
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141008,
					"content": "Quel genre de chose dangereuse ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141010
					]
				},
				{
					"id": 750141010,
					"content": "Je ne sais pas... Mais je suis sûr qu'il prépare quelque chose de dangereux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141011
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141011,
					"content": "#Ah, vous voilà, super ! Vous devez être {NICKNAME}. Lamizana m'a dit que vous aviez essayé le parcours d'entraînement et que vous vous en étiez très bien {M#sorti}{F#sortie}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141012,
						750141013
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750141012,
					"content": "Vous me flattez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141015
					]
				},
				{
					"id": 750141015,
					"content": "Voilà ce qu'il en est. La course de vol est sur le point de commencer, mais le concurrent qui devait affronter Lliwa s'est retiré à la dernière minute.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141016
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750141016,
					"content": "*soupir* Comme Taruka le sait, elle a toujours été extrêmement compétitive, elle ne sera donc pas contente de gagner sans concourir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141017
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750141017,
					"content": "Elle peut aussi se retirer, alors. Génial ! Je vais aller l'en convaincre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141018
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141018,
					"content": "Non, ce n'est pas une bonne idée ! Elle a passé beaucoup de temps à se préparer pour cette course, la meilleure solution serait de lui trouver un adversaire digne de ce nom...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141019
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750141019,
					"content": "#Et c'est pour ça que vous êtes venu trouver {NICKNAME} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141020
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141020,
					"content": "Oui. Si vous participez, nous vous récompenserons, quel que soit votre résultat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141021,
						750141023
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750141021,
					"content": "Vous me sous-estimez vraiment.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141022
					]
				},
				{
					"id": 750141022,
					"content": "Hein ? Oh, vous avez raison... Eh bien, si vous obtenez un bon résultat, nous vous donnerons le prix correspondant ainsi qu'une récompense supplémentaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141025
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750141025,
					"content": "Merci d'avoir accepté ! Vous recevrez la lettre d'invitation plus tard. J'ai d'autres préparatifs à faire, je ne vous reverrai donc probablement pas avant la course.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141026
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750141026,
					"content": "Paran part avec Carrewouaf...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750141027
					]
				},
				{
					"id": 750141027,
					"content": "#{NICKNAME}, tu as dit oui parce que ça va nous permettre d'enquêter de plus près, n'est-ce pas ? Si quelque chose se produit pendant la course, les concurrents seront certainement les premiers informés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141028,
						750141029
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141028,
					"content": "Je ne pense pas que ce soit aussi simple.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141031
					]
				},
				{
					"id": 750141031,
					"content": "D'ailleurs, la voix de Paran m'a semblé familière. Je l'ai déjà entendue quelque part récemment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141032
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141032,
					"content": "Il est responsable de tout ce qui concerne l'Aérocadémie. Carrewouaf et lui passent leur temps à courir partout, il serait donc très surprenant que vous n'ayez encore jamais entendu sa voix.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141033
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141033,
					"content": "C'est vrai ! J'ai l'impression d'avoir déjà lu quelque chose comme ça dans une histoire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141034
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141034,
					"content": "Si quelqu'un qui se fond dans le décor commet un crime, les gens sont tellement habitués à sa présence qu'ils ne soupçonneront généralement pas cette personne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141035
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141035,
					"content": "Hmm... C'est probablement mieux de ne pas dire ça devant lui. Sa famille a été exilée parce qu'un de ses proches a fait quelque chose de très grave.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141036
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141036,
					"content": "Les gens ont toujours utilisé ça comme excuse pour lui compliquer la vie... C'est peut-être pour ça qu'il est aussi strict avec lui-même, mais si prévenant envers les autres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141037
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141037,
					"content": "Même s'il est proche de Lamizana, je dois admettre que c'est un gars plutôt sympa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141038,
						750141040
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141038,
					"content": "Est-ce que Lamizana est une sorte de parasite ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141039
					]
				},
				{
					"id": 750141039,
					"content": "Je pense que même les parasites sont cent fois plus mignons que lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141041
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141041,
					"content": "Merci de me l'avoir dit ! Ce serait grave de le blesser, même par accident. Enfin, à propos de la course...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141042
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141042,
					"content": "#Taruka, tu n'as pas à t'inquiéter pour ta sœur. {NICKNAME} veillera sur elle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141043
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141043,
					"content": "Hmm... Je vous attendrai près de la ligne d'arrivée. Lamizana et moi devrions finir en premier, je vais donc le surveiller de près !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141044
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141044,
					"content": "Raouh ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141045
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750141045,
					"content": "#Cette épreuve ne te convient pas vraiment, {REALNAME[ID(2)|SHOWHOST(true)]}. Tu devras te contenter de la regarder avec moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141046
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141046,
					"content": "Raouh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750141040,
					"content": "On dirait que la vie est compliquée pour lui aussi.",
