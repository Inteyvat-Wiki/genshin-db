					"nextDialogs": [
						750141041
					]
				},
				{
					"id": 750141029,
					"content": "Non, je veux juste le prix de participation...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141030
					]
				},
				{
					"id": 750141030,
					"content": "Tu devrais suivre mes conseils, même si c'est juste pour avoir l'air plus cool !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
