				"points": []
			},
			"dialogs": [
				{
					"id": 190680301,
					"content": "Euh... C'est du poisson grillé... pour Quinn ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190680302
					],
					"speakerTitle": "Béatrice"
				},
				{
					"id": 190680302,
					"content": "J'ai souvent dit que j'allais lui apporter le déjeuner... Est-ce que ça marcherait ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190680303
					],
					"speakerTitle": "Béatrice"
				},
				{
					"id": 190680303,
					"content": "Enfin, puisque c'est recommandé par Noëlle, je vais tenter l'expérience !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Béatrice"
				}
			]
		},
