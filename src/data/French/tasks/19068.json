			"dialogs": [
				{
					"id": 190680401,
					"content": "Fruits frais, ils sont frais mes fruits... Oui ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190680402
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 190680402,
					"content": "Le cadeau de Béatrice...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190680403
					]
				},
				{
					"id": 190680403,
					"content": "Oh... Elle voulait que je mange quelque chose, ou quelque chose comme ça... Mais je n'ai pas vraiment faim là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190680404
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 190680404,
					"content": "Elle m'apporte souvent à manger, donc rien de bien inhabituel là-dedans...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quinn"
				}
			]
		},
		{
			"id": 1906805,
