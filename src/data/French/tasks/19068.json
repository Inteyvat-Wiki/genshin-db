			"trigger": {
				"objectNames": [
					"Béatrice"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190680201,
					"content": "Que... Qu'est-ce que c'est ? Ça a l'air bizarre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190680202
					],
					"speakerTitle": "Béatrice"
				},
				{
					"id": 190680202,
					"content": "Et ça sent bizarre aussi... Vous ne voulez quand même pas offrir ça à Quinn ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190680203
					],
					"speakerTitle": "Béatrice"
				},
				{
					"id": 190680203,
					"content": "Euh, bien sûr que non.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190680204
					]
				},
				{
					"id": 190680204,
					"content": "C'est bien ce que je me disais. Bon, je continue à vous attendre alors.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Béatrice"
				}
			]
		},
		{
			"id": 1906803,
