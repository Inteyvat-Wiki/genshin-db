				"points": []
			},
			"dialogs": [
				{
					"id": 190680501,
					"content": "Ouh là... Je sais pas pourquoi, mais de voir tout ça... J'ai le cœur qui bat sacrément vite dis donc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190680502
					],
					"speakerTitle": "Noëlle"
				},
				{
					"id": 190680502,
					"content": "Je ferais peut-être mieux d'aller faire autre chose... Histoire de me changer les idées...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190680503
					],
					"speakerTitle": "Noëlle"
				},
				{
					"id": 190680503,
					"content": "Mais je devrais peut-être d'abord finir celui-là. Juste celui-là, OK ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Noëlle"
				}
			]
		},
