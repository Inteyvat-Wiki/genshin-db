			"dialogs": [
				{
					"id": 190680601,
					"content": "#« Trouver le temps d'être {M#seuls tous}{F#seules toutes} les deux »... « Lui offrir un gâteau fait maison »...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190680602
					],
					"speakerTitle": "Notes de Noëlle"
				},
				{
					"id": 190680602,
					"content": "La belle calligraphie consigne les plus célèbres citations extraites du livre, mais la forme des mots devient de moins en moins précise au fur et à mesure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190680603
					],
					"speakerTitle": "Notes de Noëlle"
				},
				{
					"id": 190680603,
					"content": "Une partie du texte a été raturée et est illisible. On dirait que l'auteur était en proie à des émotions fortes à ce moment-là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Notes de Noëlle"
				}
			]
		}
