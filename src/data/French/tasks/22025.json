				"objectNames": [
					"Qiuyue"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220250301,
					"content": "Oui ? Ah, Tang Wen ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250307
					],
					"speakerTitle": "Qiuyue"
				},
				{
					"id": 220250307,
					"content": "Un goût bizarre dans la bouche, une perte d'appétit et impossibilité de manger quoi que ce soit ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250302
					],
					"speakerTitle": "Qiuyue"
				},
				{
					"id": 220250302,
					"content": "#Tout ça parce qu'elle a mangé un plat bizarre ? Vous êtes {M#sûr}{F#sûres} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250303
					],
					"speakerTitle": "Qiuyue"
				},
				{
					"id": 220250303,
					"content": "Ça ressemble plus à un problème de digestion, non ? Hum, laissez-moi réfléchir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250304
					],
					"speakerTitle": "Qiuyue"
				},
				{
					"id": 220250304,
					"content": "Eh bien, puisque je ne peux pas me prononcer sur sa condition il n'y a qu'un seul plat que je peux recommander : la soupe de porc aux pousses de bambou !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250305
					],
					"speakerTitle": "Qiuyue"
				},
				{
					"id": 220250305,
					"content": "C'est savoureux, tendre et appétissant, avec de la soupe à la fin pour aider à faciliter la digestion. Mmmm ! J'aimerais en manger là maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250306
					],
					"speakerTitle": "Qiuyue"
				},
				{
					"id": 220250306,
					"content": "Croyez-moi, tout ce dont Tang Wen a besoin en ce moment, c'est d'une soupe de porc aux pousses de bambou !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qiuyue"
				}
			]
		},
		{
			"id": 2202504,
