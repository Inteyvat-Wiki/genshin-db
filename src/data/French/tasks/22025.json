			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Li Xiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220250201,
					"content": "Qu'y a-t-il ? Ah... Tang Wen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250207
					],
					"speakerTitle": "Li Xiao"
				},
				{
					"id": 220250207,
					"content": "Perte d'appétit... Goût bizarre dans la bouche... Un plat pour la sauver ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250202
					],
					"speakerTitle": "Li Xiao"
				},
				{
					"id": 220250202,
					"content": "Je ne peux pas croire qu'elle ait rencontré un tel problème... C'est en effet un peu délicat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250203
					],
					"speakerTitle": "Li Xiao"
				},
				{
					"id": 220250203,
					"content": "Mais à mon avis, il n'est pas nécessaire que ce soit un plat particulièrement coûteux. Tant que le goût et la saveur sont uniques, et qu'il y a un peu de punch...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250204
					],
					"speakerTitle": "Li Xiao"
				},
				{
					"id": 220250204,
					"content": "Alors, voici ma suggestion : le Gooba de Jueyun ! Il possède à la fois une texture croquante unique et un bon piquant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250205
					],
					"speakerTitle": "Li Xiao"
				},
				{
					"id": 220250205,
					"content": "Cela fait plus de dix ans que j'ai goûté ce plat pour la première au Village de Qingce. J'y pense encore de temps en temps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250206
					],
					"speakerTitle": "Li Xiao"
				},
				{
					"id": 220250206,
					"content": "Quoi qu'il arrive, le Gooba de Jueyun est la solution.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Li Xiao"
				}
			]
		},
		{
			"id": 2202503,
			"completionStepIds": [
				2202503
