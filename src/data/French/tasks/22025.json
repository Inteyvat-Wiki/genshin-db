					"nextDialogs": [
						220250503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250503,
					"content": "Oh ? Quel arôme unique...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250504
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250504,
					"content": "Vite ! Laissez-moi goûter ça, s'il vous plaît !",
					"roleType": "TALK_ROLE_NPC",
