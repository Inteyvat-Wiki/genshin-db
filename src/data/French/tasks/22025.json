			"dialogs": [
				{
					"id": 220250401,
					"content": "Waouh, on a deux réponses différentes... Du Gooba de Jueyun et de la soupe de porc aux pousses de bambou... Ce sont des plats délicieux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250402,
					"content": "Que devrions-nous faire ? C'est dur de décider !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250403,
					"content": "Qu'est-ce que t'en penses, Paimon ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250404
					]
				},
				{
					"id": 220250404,
					"content": "Qui ? Moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250405,
					"content": "Dans ce cas... Si je devais choisir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250406,
					"content": "Je choisirais le poisson chihu grillé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250407,
					"content": "Un poisson chihu grillé, ça a l'air courageux comme choix... Si Tang Wen mange tout courageusement, tous ses problèmes seront réglés, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250408,
						220250409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250408,
					"content": "Tu t'y connais quand il s'agit de manger des choses...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250410
					]
				},
				{
					"id": 220250410,
					"content": "Voilà pourquoi je t'ai dit de décider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250411,
						220250412,
						220250413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250411,
					"content": "Dans ce cas... le délicieux Gooba de Jueyun !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250414
					]
				},
				{
					"id": 220250414,
					"content": "OK ! Dépêchons-nous de préparer ce plat et de le donner à Tang Wen !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250412,
					"content": "Préparons une délicieuse soupe de porc aux pousses de bambou !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250414
					]
				},
				{
					"id": 220250413,
					"content": "Allez pour un délicieux poisson chihu grillé !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250414
					]
				},
				{
					"id": 220250409,
					"content": "Ça ne colle pas trop au poisson chihu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250410
					]
				}
			]
		},
