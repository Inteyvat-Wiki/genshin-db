			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tang Wen",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220250101,
					"content": "Ah... J'ai tellement faim... Je ne me sens pas bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250102
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250102,
					"content": "Alors pourquoi ce changement ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250103
					]
				},
				{
					"id": 220250103,
					"content": "Je ne suis pas vraiment sûre... en tout cas, je ne me sens pas en forme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250104
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250104,
					"content": "C'est probablement parce qu'hier soir, j'ai mangé le plat que vous m'aviez fait hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250105
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250105,
					"content": "Le goût de ce plat était... particulier, mais il était au moins rassasiant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250106
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250106,
					"content": "Après ça, j'avais prévu de bien dormir, puis de travailler aujourd'hui, mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250107
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250107,
					"content": "À chaque fois que j'étais sur le point de m'endormir, l'odeur étrange de ce plat remontait de mon estomac ! Et ça me réveillait instantanément.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250108
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250108,
					"content": "Ce petit manège a continué jusqu'à l'aube...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250109
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250109,
					"content": "Ce n'est pas grave de moins dormir, ça m'arrive de faire des heures supplémentaires de temps en temps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250110
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250110,
					"content": "Mais je pensais que ce goût partirait aujourd'hui après avoir mangé un petit déjeuner ! Et ce n'est pas le cas, je le sens encore !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250111
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250111,
					"content": "Ce plat était-il aussi fort ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250112
					]
				},
				{
					"id": 220250112,
					"content": "Bref, j'ai l'impression que... seule un plat au goût unique peut le faire disparaître...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250113
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250113,
					"content": "Un plat au goût unique ? Pourquoi ne pas aller demander l'avis des gens à ce sujet ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250114,
					"content": "Ensuite, on cuisinera quelque chose pour Tang Wen... Peut-être que ça résoudra son problème !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250115,
					"content": "Vraiment ? C'est génial, merci beaucoup ! Si c'est plus pratique pour vous, allez interroger des gens de Ritou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250116
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250116,
					"content": "Je me souviens que Li Xiao, un marchand de Ritou, s'y connaît très bien en nourriture. Qiuyue, de la Société commerciale Chuyu, est aussi une amatrice de gastronomie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				}
			]
		},
		{
			"id": 2202502,
			"completionStepIds": [
				2202502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
