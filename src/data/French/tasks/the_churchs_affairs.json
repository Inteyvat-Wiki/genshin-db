					"Victoria"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190030601,
					"content": "Bonjour, que voulez-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030602
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030602,
					"content": "À propos du congé de Barbara...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030603
					]
				},
				{
					"id": 190030603,
					"content": "#Ah oui, Barbara vient de me demander une demi-journée de repos. Elle a dit qu'elle avait des projets avec {M#un ami}{F#une amie}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030604
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030604,
					"content": "#Je dois dire que c'est assez inhabituel de sa part de demander un congé juste pour voir {M#un ami}{F#une amie}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030605
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030605,
					"content": "Mais là n'est pas la question... Que vouliez-vous me demander ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030606
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030606,
					"content": "À propos du thé corail pétillant de la splendeur d'été...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030607
					]
				},
				{
					"id": 190030607,
					"content": "Oh ? Barbara a l'intention de vous accompagner pour acheter cette... boisson spéciale ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030608
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030608,
					"content": "#Alors vous devez être {M#l'ami}{F#l'amie} dont elle a parlé, je présume ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030609
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030609,
					"content": "Eh bien, vu que vous êtes le chevalier honoraire, je suppose que ça ira...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030610
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030610,
					"content": "Et s'il vous plaît, prenez bien soin de Barbara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030611
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030611,
					"content": "Pourquoi Barbara doit-elle toujours vous signaler ses déplacements ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030612
					]
				},
				{
					"id": 190030612,
					"content": "Eh bien, comme vous le savez peut-être déjà, Barbara est très populaire à Mondstadt, et ce, pour plusieurs raisons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030613
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030613,
					"content": "Les citoyens n'ont que des bonnes intentions, mais parfois un peu trop, au point que Barbara se retrouve souvent victime de son succès.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030614
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030614,
					"content": "Si quelqu'un la cherche tant qu'elle est à la cathédrale, on peut encore intervenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030615
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030615,
					"content": "Mais si elle se fait accoster par des fans pendant son temps libre, elle doit se débrouiller seule.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030616
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030616,
					"content": "Sans oublier qu'elle est... trop gentille. Elle essayera toujours de répondre aux requêtes des Mondstadtois, même si cela l'épuise encore plus que son travail habituel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030617
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030617,
					"content": "C'est pour ça que nous avons décidé avec Barbara qu'elle devrait toujours nous dire où elle se rend, juste au cas où il faudrait aller la sauver d'une foule un peu trop agitée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030618
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030618,
					"content": "J'espère vraiment que Barbara arrêtera un jour d'être aussi dévouée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "Victoria"
				}
			]
		},
