						190030702
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030702,
					"content": "À propos de l'itinéraire de Barbara...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030703
					]
				},
				{
					"id": 190030703,
					"content": "Oh, Barbara désire ramasser des herbes dans le Bois des Murmures ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030704
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030704,
					"content": "#Je vois... En fait, Barbara vient de demander une demi-journée pour aller voir {M#un ami}{F#une amie}. Et maintenant, elle a soudain l'intention d'aller ramasser des herbes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030705
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030705,
					"content": "Enfin, je suis sûre que Barbara a ses raisons... Allez-vous l'accompagner ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030706
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030706,
					"content": "Oui, je vais l'accompagner.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030707
					]
				},
				{
					"id": 190030707,
					"content": "Ah, elle sera donc entre de bonnes mains. Prenez bien soin de Barbara, chevalier honoraire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030708
					],
					"speakerTitle": "Victoria"
