			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20030401,
					"content": "C'est donc ici que vit la crème de la crème d'Inazuma, hein ? Je m'attendais à quelque chose d'un peu plus... cossu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030402,
						20030403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030402,
					"content": "Difficile de rivaliser avec la Chambre de Jade.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030404
					]
				},
				{
					"id": 20030404,
					"content": "#Bienvenue à la résidence Kamisato, {M#invités}{F#invitées} d'honneur. Mademoiselle Kamisato est ravie de pouvoir faire enfin votre connaissance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030405
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20030405,
					"content": "Est-ce que c'est la Shirasagi Himegimi dont vous n'avez pas arrêté de parler ? Alors, euh, elle est où ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030406,
					"content": "Hum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030407
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030407,
					"content": "Oh... derrière le paravent ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030408,
					"content": "Oui, haha, en tant qu'héritière de la Commission culturelle, c'est ainsi que mademoiselle Kamisato a l'habitude de se présenter à ses invités.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030409
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20030409,
					"content": "Considérez cela comme une ancienne tradition de la Commission culturelle. Pardonnez-moi si c'est une surprise inattendue pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030410,
						20030411
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20030410,
					"content": "Je pense que je comprends.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030412
					]
				},
				{
					"id": 20030412,
					"content": "C'est compréhensible, c'est une personne très importante après tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030413,
					"content": "Je vous prie de pardonner mon manque de courtoisie de vous recevoir de cette façon... surtout après un voyage aussi long et fastidieux sur les océans.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030414
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030414,
					"content": "J'ai attendu votre arrivée avec une grande impatience. Thomas m'a dit que vous aviez le pouvoir de changer le cours du temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030415
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030415,
					"content": "Actuellement à Inazuma, au nom du décret de saisie, les aspirations du peuple sont bafouées sans raison.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030416
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030416,
					"content": "Même si la Commission culturelle est au service de la Shogun, c'est avec le peuple que nous partageons les liens les plus étroits, compte tenu du contact que nous entretenons avec lui dans l'exercice de nos fonctions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030417
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030417,
					"content": "Le pouvoir d'une Commission augmente et diminue en fonction de la confiance que lui accordent ses membres. Nous ne pouvons pas rester indifférents à cette situation, ce serait ignorer notre propre destin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030418
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030418,
					"content": "#{M#Voyageur}{F#Voyageuse}, avec un pouvoir comme le vôtre, nous pourrions...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030419,
						20030420
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030419,
					"content": "Je suis ici pour rencontrer la Shogun Raiden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030421
					]
				},
				{
					"id": 20030421,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030422
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030422,
					"content": "Vous voyez, mademoiselle, c'est comme je vous avais dit... Cela ne nous mènera nulle part...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030423
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20030423,
					"content": "Je vais partir à présent.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030424
					]
				},
				{
					"id": 20030424,
					"content": "Non, s'il vous plaît... Attendez ! S'il vous plaît... Ne partez pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030425
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030425,
					"content": "*soupir* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030426
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030426,
					"content": "Qu'y a-t-il ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030427
					]
				},
				{
					"id": 20030427,
					"content": "Je vous présenterai à la Shogun Raiden, à une condition... Vous devez exaucer trois petits souhaits pour moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030428
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030428,
					"content": "Quels sont vos souhaits ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030429,
					"content": "Ils concernent trois personnes dont les yeux divins ont été confisqués... Peut-être qu'une fois que vous les aurez rencontrées, vous comprendrez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030430
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030430,
					"content": "Un guerrier qui garde un village, un ancien samouraï qui a contribué à l'exécution du décret de saisie, et un maître épéiste déterminé à devenir le meilleur au monde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030431,
					"content": "C'est ça. Veuillez faire tout votre possible pour les aider. J'attendrai votre retour ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030432,
						20030433
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030432,
					"content": "Je respecterai votre volonté.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030434
					]
				},
				{
					"id": 20030434,
					"content": "Héhé... Vous avez toute ma gratitude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030435
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030435,
					"content": "Continuez comme ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20030433,
					"content": "Ce n'est pas une mince affaire...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030434
					]
				},
				{
					"id": 20030420,
					"content": "Je ne suis pas là pour lancer une rébellion.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030421
					]
				},
				{
					"id": 20030411,
					"content": "(C'est un peu décevant...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030412
					]
				},
				{
					"id": 20030403,
					"content": "Difficile de rivaliser avec le Domaine de l'Aurore.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030404
					]
				}
