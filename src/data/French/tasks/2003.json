						20030502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030502,
					"content": "Je suis désolée, notre établissement n'est pas ouvert au public. J'ai bien peur que vous deviez partir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030503
					],
					"speakerTitle": "Kozue"
				},
				{
					"id": 20030503,
					"content": "Attendez ! Nous ne faisons pas partie du public...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030504,
					"content": "#Dans ce cas... Vous devez être des {M#étrangers infiltrés}{F#étrangères infiltrées} dans le pays... à en juger par votre accoutrement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030505
					],
					"speakerTitle": "Kozue"
				},
				{
					"id": 20030505,
					"content": "Est-ce que nos vêtements sont si... Oh ! Euh... Ce que je veux dire, c'est que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030506,
					"content": "Voici notre lettre d'invitation.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030507
					]
				},
				{
					"id": 20030507,
					"content": "Hmm, le sceau de la Commission culturelle... Ça doit venir de monsieur Thomas. Vous avez plus de ressources que je ne le pensais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030508
					],
					"speakerTitle": "Kozue"
				},
				{
					"id": 20030508,
					"content": "Auquel cas, bienvenue au Salon de thé Komore, c'est un havre de paix pour la Commission culturelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030509
					],
					"speakerTitle": "Kozue"
				},
				{
					"id": 20030509,
					"content": "Eh bien, c'est déjà beaucoup mieux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
