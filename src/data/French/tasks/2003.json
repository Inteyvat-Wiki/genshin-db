	"talks": [
		{
			"id": 200301,
			"completionStepIds": [
				200301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200301",
							"2"
						],
						"stepId": 200301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Thomas"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20030101,
					"content": "Eh bien, maintenant qu'on est ici, où est Thomas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030102,
					"content": "*soupir* Je ne le vois nulle part, tu penses qu'il a oublié sa promesse de nous rencontrer ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030103,
					"content": "Qui a oublié sa promesse ? Je commençais à penser que vous m'aviez oublié !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030104
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20030104,
					"content": "Q—Q—Quoi !? Est-ce que c'est ce chien qui nous parle ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030105,
					"content": "#Hahaha, calmez-vous, pas besoin d'avoir l'air aussi {M#surpris}{F#surprises}. C'est la première fois que vous me voyez sous cette forme, c'est ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030106,
						20030107
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20030106,
					"content": "Alors vous êtes un... chien ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030108
					]
				},
				{
					"id": 20030108,
					"content": "Hein, alors vous n'avez jamais rien vu de tel quand vous étiez au Port de Liyue ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030109
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20030109,
					"content": "Maintenant que vous le dites, ça me semble soudainement plus familier...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030110,
						20030111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030110,
					"content": "Ça reste bizarre...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030112
					]
				},
				{
					"id": 20030112,
					"content": "Hahaha. D'accord, d'accord, je me suis assez amusé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030113
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20030113,
					"content": "Hé ! Vous êtes à ça d'avoir un surnom méchant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030114,
					"content": "Eh bien, j'avais du temps à tuer, étant donné que je vous attends ici depuis un moment... comme à Ritou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030115
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20030115,
					"content": "Alors j'ai trouvé cette façon de vous accueillir amusante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030116
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20030116,
					"content": "Mais, plus sérieusement, j'aimerais m'excuser pour ce petit « test » que vous avez passé plus tôt. Même si c'était nécessaire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030117
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20030117,
					"content": "Je voulais savoir si je pouvais vous présenter devant mademoiselle Kamisato, et si vous auriez le courage d'affronter la foudre à nos côtés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030118
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20030118,
					"content": "N'allez pas penser que je vais vous pardonner juste parce que d'un coup vous êtes devenu sérieux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030119,
					"content": "Haha... Désolé, c'était de trop ? Toutes mes excuses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030120,
						20030121
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20030120,
					"content": "Alors, est-ce qu'on a passé votre « test » ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030122
					]
				},
				{
					"id": 20030122,
					"content": "Vous vous considérez au-dessus des « lois » depuis le début, pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030123
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20030123,
					"content": "Naturellement, cela est dû à votre détermination inébranlable et à votre résolution.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030124
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20030124,
					"content": "Il y a longtemps, nous avions un ami à peu près comme vous... mais quand la foudre l'a frappé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030125,
						20030126
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20030125,
					"content": "Vous voulez dire l'ami de Kazuha...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030127
					]
				},
				{
					"id": 20030127,
					"content": "Ah, alors vous avez entendu parler de son histoire, hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030128
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20030128,
					"content": "Sa flamme brûle d'autant plus fort dans nos cœurs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030129
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20030129,
					"content": "Est-ce qu'on va pouvoir rencontrer la Shirasagi Himegimi ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030130
					]
				},
				{
					"id": 20030130,
					"content": "Oui, bien sûr. Je vais vous conduire à la résidence Kamisato, où se trouve la Commission culturelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030131
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20030131,
					"content": "#Mais avant cela, il y a un autre endroit où j'espérais que vous m'accompagneriez, {M#tous}{F#toutes} les deux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030132
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20030132,
					"content": "Oh ? Où ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030133,
					"content": "J'aimerais vous conduire à la Statue de la divinité omniprésente. Elle est encore en construction pour le moment, mais vous pouvez déjà la voir de pratiquement n'importe où sur l'Île de Narukami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20030126,
					"content": "Vous voulez dire qu'il est mort en duel devant le trône...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030127
					]
				},
				{
					"id": 20030121,
					"content": "« Le courage d'affronter la foudre »...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030122
					]
				},
				{
					"id": 20030111,
					"content": "Je sais reconnaître un chien quand j'en vois un.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030112
					]
				},
				{
					"id": 20030107,
					"content": "Où est le Thomas à l'apparence humaine ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030108
					]
				}
			]
		},
		{
			"id": 200302,
			"completionStepIds": [
				200302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200302",
							"2"
						],
						"stepId": 200302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Thomas"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20030201,
					"content": "Cette zone a vraiment l'air triste. Les gens ne doivent pas venir souvent ici, pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030202,
					"content": "Hein, est-ce que ma vue me joue des tours, ou il y a des choses incrustées dans la statue...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030203,
					"content": "Des yeux divins.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030204
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20030204,
					"content": "Des yeux divins ! Vous voulez dire que tous les yeux divins qui ont été confisqués par le décret de saisie ont été incrustés dans cette statue !?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030206,
					"content": "Pourquoi la Shogun a-t-elle ordonné un décret de saisie ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030207
					]
				},
				{
					"id": 20030205,
					"content": "Alors vous avez déjà entendu parler du décret de saisie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030206
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20030207,
					"content": "Avant d'essayer de vous expliquer, je devrais peut-être vous rappeler que Mondstadt est la cité de la liberté, et Liyue celle des contrats...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030208
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20030208,
					"content": "Pour ce qui est d'Inazuma... Elle est connue sous le nom de nation de l'éternité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030209
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20030209,
					"content": "La Shogun Raiden est à la fois le dirigeant le plus puissant du pays et sa divinité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030210
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20030210,
					"content": "L'« éternité » en question... c'est son mandat éternel et immuable à régner sur Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030211
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20030211,
					"content": "En tant que telle, elle s'appuie sur les Trois Commissions pour administrer les affaires de la nation et sur le décret de confinement pour limiter les mouvements de son peuple.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030212
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20030212,
					"content": "La Shogun souhaite maintenir Inazuma en état de stase, permettant au temps de s'y écouler sans l'affecter, pour toute l'éternité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030213
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20030213,
					"content": "On dirait que chaque divinité a des idées bien arrêtées...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030214,
					"content": "Bien sûr, il s'agit de ma propre compréhension limitée des choses. Quant à la raison du récent décret de saisie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030215
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20030215,
					"content": "Peut-être que la Shogun croit que les yeux divins accordent aux gens le pouvoir de changer, et que son éternité ne peut permettre à une telle instabilité d'exister.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030216
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20030216,
					"content": "Quoi qu'il en soit, le fait est que la Shogun Raiden a chargé la Commission administrative de fouiller la nation à la recherche d'yeux divins, et d'incruster chacun d'eux dans cette statue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030217
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20030217,
					"content": "... et cette Statue de la divinité omniprésente peut être considérée comme le symbole de l'éternité d'Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030218
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20030218,
					"content": "Mais dans ce cas, vous ne trouvez pas que la Shogun Raiden est un peu... égoïste ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030219,
					"content": "#Haha, {M#seuls des étrangers tels}{F#seules des étrangères telles} que vous oseraient prononcer de telles paroles à l'encontre de la Shogun Raiden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030220
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20030220,
					"content": "Et pourtant... Je suis d'accord. Le décret de saisie ne devrait tout simplement pas exister, et mademoiselle Kamisato s'est engagée à le combattre dès le jour où il a été prononcé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030221
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20030235,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20030223,
					"content": "C'était quoi ce... son à l'instant ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030224
					]
				},
				{
					"id": 20030221,
					"content": "#Hein ? {NICKNAME}, qu'est-ce qu'il y a ? On dirait qu'il y a quelque chose qui ne va pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030222,
					"content": "Un son ? Quel son ? Je n'ai rien entendu... Est-ce qu'il s'est passé quelque chose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030223
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20030225,
					"content": "Je pouvais entendre le son de... l'ambition de ces gens.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030226
					]
				},
				{
					"id": 20030224,
					"content": "Ouais, tu as touché la statue, et puis... et puis quoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030226,
					"content": "Leur « ambition » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030227
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20030227,
					"content": "Hmm... Cela semble confirmer les rumeurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030228
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20030228,
					"content": "Vous avez déjà entendu parler de cela ? On dit que lorsque l'ambition d'une personne atteint une certaine intensité, les divinités la considèrent avec bienveillance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030229
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20030229,
					"content": "C'est de là que viennent les yeux divins... En d'autres termes, un œil divin représente l'ambition d'une personne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030230
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20030230,
					"content": "Donc, si ce que vous dites est vrai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030231
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20030232,
					"content": "Alors un œil divin est un symbole d'ambition et non de pouvoir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030233
					]
				},
				{
					"id": 20030231,
					"content": "... Alors l'ambition de ces personnes est plus forte que je ne l'imaginais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030232
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20030233,
					"content": "Bien. Il est temps d'aller à la prochaine étape de notre visite de l'Île de Narukami : la résidence Kamisato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030234
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20030234,
					"content": "Ouf, enfin !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
