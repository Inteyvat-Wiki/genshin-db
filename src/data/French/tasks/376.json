			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Diluc"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3760601,
					"content": "Bonsoir, maître Diluc. Auriez-vous vu passer deux voleurs ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760602
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 3760602,
					"content": "Que s'est-il passé ? Pourquoi avoir amené autant de gardes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760603
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760603,
					"content": "Vous ne le savez donc pas ? Des malotrus ont tenté de voler la lyre sacrée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760604
					],
					"speakerTitle": "Myers"
				},
				{
					"id": 3760604,
					"content": "Oh ? Comme c'est étrange.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760605
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760605,
					"content": "N'est-ce pas ? La lyre sacrée est un trésor qui a appartenu à l'Archon Anémo. Elle fait partie de notre patrimoine culturel et...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760606
					],
					"speakerTitle": "Myers"
				},
				{
					"id": 3760606,
					"content": "Pourquoi voler un objet qu'on ne peut pas revendre ? Ils se feraient bien plus d'argent en volant mes caves...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760607
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760607,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760608
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 3760608,
					"content": "Oh, veuillez m'excuser. Je parlais tout seul. Ils sont partis dans cette direction.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760609
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760609,
					"content": "Très bien, je vous remercie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Myers"
				}
			]
		},
		{
			"id": 37607,
