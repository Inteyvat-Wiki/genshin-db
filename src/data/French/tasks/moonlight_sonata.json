			"dialogs": [
				{
					"id": 760290201,
					"content": "Aino ? Tu es là ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290202,
					"content": "Oh ! C'est toi, Paimon ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290203
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290203,
					"content": "#Bonjour ! Vous êtes {M#venus}{F#venues} me voir ? Avec des encas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290204
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290204,
					"content": "Je savais que tu allais en demander ! Tiens, on t'a pris ça sur le chemin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290205,
					"content": "Héhé, donne-moi tout ça vite ! Ineffa va bientôt revenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290206
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290206,
					"content": "À quoi on joue aujourd'hui ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290207
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290207,
					"content": "Haha... En fait, on aimerait te demander de l'aide...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290208,
					"content": "Ouah ! Éloignez ce truc bizarre de moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290209
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290209,
					"content": "« Ce truc bizarre » ? Tu parles de la lyre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290210,
					"content": "Je vous ai dit que je déteste les choses que la science ou les principes mécaniques ne peuvent pas expliquer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290211
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290211,
					"content": "Je vous le dis, cette lyre... apparaît sur le pas de ma porte de nulle part. Et après l'avoir réparée, elle disparaît !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290212
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290212,
					"content": "Mais ça ne veut pas dire que je crois à ces superstitions effrayantes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290213
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290213,
					"content": "Ah... Je crois qu'il y a un malentendu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290214,
					"content": "C'est-à-dire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290215,
						760290216
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290215,
					"content": "Cette lyre appartient à une amie...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290217
					]
				},
				{
					"id": 760290217,
					"content": "Elle n'a pas de mauvaises intentions. C'est juste qu'elle avait ses raisons de venir prendre la lyre discrètement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290218,
					"content": "Vraiment ? Vous ne me mentez pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290219
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290219,
					"content": "Dans ce cas, je... je vous fais confiance ! Je vais réparer ça... un peu plus minutieusement que d'habitude...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290220
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290220,
					"content": "Patientez un instant pendant que je m'en occupe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290221
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290221,
					"content": "On peut toujours compter sur Aino... Je me sens un peu mal de la voir courir dans tous les sens. Les dépôts mystérieux d'objets ont l'air de lui faire peur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290222,
					"content": "Oui, nous devrions la récompenser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290223
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760290223,
					"content": "Tout à f... Aaah ! Que faites-vous ici ?! Vous m'avez fait peur !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290224,
					"content": "Je voulais vous donner quelque chose avant de rentrer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290225
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760290225,
					"content": "Qu'est-ce que c'est ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290226,
					"content": "Des « trésors » que la kuuhenki a récupérés. Elle voulait remercier l'artisane, et a pensé qu'elle les apprécierait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290227
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760290227,
					"content": "Ooh... C'est un tas de pièces mécaniques bizarres. Pas de souci, on les donnera à Aino tout à l'heure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290228,
					"content": "Faites attention sur le chemin du retour ! Ne laissez personne vous voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290229,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290230
					]
				},
				{
					"id": 760290230,
					"content": "Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290231
					]
				},
				{
					"id": 760290231,
					"content": "Qu'est-ce qu'il y a ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290232,
					"content": "Regarde là-bas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290233
					]
				},
				{
					"id": 760290233,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290234,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290235
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290235,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290236
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760290236,
					"content": "Calcul de ressemblance en cours...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290237
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290237,
					"content": "De ressemblance ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290238,
					"content": "Ressemblance avec les statues de la Déesse de la lune de Nod-Krai... 95 %...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290239,
						760290241
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290239,
					"content": "C—C'est une actrice !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290240
					]
				},
				{
					"id": 760290240,
					"content": "#La fréquence cardiaque de {NICKNAME} augmente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290243
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290243,
					"content": "C'est bon, je l'ai réparée ! Elle ne devrait plus jamais se casser ! Mes encas... Oh ! I—Ineffa...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290244
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290244,
					"content": "« Mes encas » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290245
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290245,
					"content": "Euh, « mais en cas » de doute, vous pouvez revenir me voir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290246
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290246,
					"content": "...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290247
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290247,
					"content": "Hmm ? Qui est cette personne derrière vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290248
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290248,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290249,
						760290250
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760290249,
					"content": "La cliente qui voulait faire réparer la lyre !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290251
					]
				},
				{
					"id": 760290251,
					"content": "(Elle me dit quelque chose... Est-ce que je l'ai déjà vue ? Peu importe. Je crois que j'ai bien caché les encas que Paimon a apportés...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290252
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290252,
					"content": "O—Oui ! Elle a aussi apporté ces pièces mécaniques pour te remercier pour la réparation, Aino !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290253
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290253,
					"content": "Hmm ? Voyons voir ça... Ouah ! Ce sont des pièces anciennes et rares ! Je peux vraiment les prendre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290254
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290254,
					"content": "... Oui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290255
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760290255,
					"content": "Merci beaucoup ! Si vous avez besoin de réparer quoi que ce soit à l'avenir, n'hésitez pas à venir me voir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290256
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290256,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290257
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290257,
					"content": "Hum, on ferait mieux de rentrer ! On reviendra un autre jour pour passer du temps avec vous deux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290258
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290258,
					"content": "(On doit sortir Columbina de là, sinon Ineffa va la reconnaître !)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290259
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290259,
					"content": "D—D'accord ! À la prochaine !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290260
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290260,
					"content": "(Je dois me dépêcher de rentrer pour nettoyer un peu, sinon Ineffa va trouver des miettes !)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290261
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290261,
					"content": "Très bien. À la prochaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290262
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290262,
					"content": "... Aino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290263
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290263,
					"content": "Q—Qu'est-ce qu'il y a ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290264
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290264,
					"content": "Voudrais-tu conserver ces pièces mécaniques à l'abri ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290265
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290265,
					"content": "Quoi ? Mais pourquoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290266
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290266,
					"content": "Il semblerait que ce soit des « cadeaux de la Déesse de la lune ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290267
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290267,
					"content": "Hein ? Qu'est-ce que tu racontes ? Je devrais vérifier tes circuits plus tard...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290250,
					"content": "Celle qui est timide !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290251
					]
				},
				{
					"id": 760290241,
					"content": "Il y a une marge d'erreur, non ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290242
					]
				},
				{
					"id": 760290242,
					"content": "Marge d'erreur minimale. Évaluation de la conclusion : fiable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290243
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290216,
					"content": "Cette amie a un peu peur des inconnus...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290217
					]
				}
			]
