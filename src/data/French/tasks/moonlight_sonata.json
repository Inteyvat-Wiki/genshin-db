			"dialogs": [
				{
					"id": 760290101,
					"content": "Bonjour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290102
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760290102,
					"content": "Ah ? Vous sortez, Columbina ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290103,
					"content": "Oui, je vais faire réparer une lyre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290104
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760290104,
					"content": "... Quoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290105,
					"content": "La lyre d'une des kuuhenkis s'est cassée. Elle aime beaucoup sa lyre, alors je voulais la faire réparer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290106
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760290106,
					"content": "Les kuuhenkis ont beaucoup de talents...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290107,
					"content": "Oui, elle joue souvent ici. Parfois, je chante aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290108
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760290108,
					"content": "Vous savez, je trouve que vous gâtez beaucoup les kuuhenkis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290109,
					"content": "Elles m'ont tenu compagnie pendant tout ce temps, et elles m'apportent souvent des objets amusants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290110
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760290110,
					"content": "(Lauma nous avait dit que l'instinct des kuuhenkis leur dictait de rendre les Déesses de la lune heureuses.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290111
					]
				},
				{
					"id": 760290111,
					"content": "Si je peux me permettre, comment comptez-vous faire réparer cette lyre ? Vous aviez dit ne pas vouloir que les gens vous voient, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290112,
					"content": "Hm... J'avais l'habitude de demander aux animaux ou aux kuuhenkis de déposer les objets à réparer devant la porte d'une artisane.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290113
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760290113,
					"content": "Elle finit généralement par les réparer après les avoir vus. Mais parfois, elle ne les voit pas tout de suite et cela peut prendre plusieurs jours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290114
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760290114,
					"content": "C'est une méthode pour contourner le problème.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290115,
					"content": "Et si on s'en occupait pour vous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290116
					]
				},
				{
					"id": 760290116,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290117
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760290117,
					"content": "Ne vous inquiétez pas. Peut-être qu'on pourra même vous la ramener aujourd'hui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290118,
					"content": "... D'accord. Merci bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290119
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760290119,
					"content": "Pas de problème ! Chez qui vous déposez vos objets d'habitude ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290120,
					"content": "J'ignore son nom, mais il y a un grand bras mécanique près de sa porte. Elle vit dans une maison ronde, qui ressemble à une conque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290121
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760290121,
					"content": "(Ah, mais c'est...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290122
					]
				},
				{
					"id": 760290122,
					"content": "Souvent, il y a une odeur de kniepertie qui s'en dégage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290123
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760290123,
					"content": "Je crois que je sais qui c'est...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
