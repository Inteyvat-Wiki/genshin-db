					"nextDialogs": [
						700081403
					]
				},
				{
					"id": 700081403,
					"content": "Se « saouler avec modération » pendant la Fête des alizées, hein... Pas étonnant qu'il y ait autant de clients au Cadeau de l'Ange...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081404
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700081404,
					"content": "Eh bien, je pense que ça va. Les enfants et les gardes aussi ont droit d'avoir une boisson pour profiter de la fête.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081405
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700081405,
					"content": "Je vais continuer à peaufiner ce mélange. Et merci pour ton aide ! Tiens, voici un petit quelque chose pour te remercier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081406
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700081406,
					"content": "Ah, oui... Et joyeuse Fête des alizées !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Margaret"
