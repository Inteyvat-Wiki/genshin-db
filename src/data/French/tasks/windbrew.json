				{
					"id": 700081201,
					"content": "Bonjour. Que puis-je faire pour vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081202
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700081202,
					"content": "Voici la nouvelle boisson de La Queue de Chat...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700081203
					]
				},
				{
					"id": 700081203,
					"content": "Mes excuses, je suis en service. Je ne peux pas boire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081204
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700081204,
					"content": "C'est sans alcool.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700081205
					]
				},
				{
					"id": 700081205,
					"content": "Ah bon ? Eh bien... Dans ce cas... Je suppose que ça ira. J'ai un peu soif en plus, voyons voir ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081206
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700081206,
					"content": "Oh ! C'est bon. Et puis, cette sensation de fraîcheur, ça revigore bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081207
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700081207,
					"content": "C'est une nouvelle invention de La Queue de Chat, c'est ça ? J'irai en prendre un verre plus tard si j'ai le temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aramis"
				}
			]
		},
