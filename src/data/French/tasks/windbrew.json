					"nextDialogs": [
						700081305
					]
				},
				{
					"id": 700081305,
					"content": "Vraiment ? Je veux bien essayer alors...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081306
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 700081306,
					"content": "Trop bon ! C'est sucré, c'est frais ! Alors c'est ça la nouvelle boisson de La Queue de Chat ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081307
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 700081307,
