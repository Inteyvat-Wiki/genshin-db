			"dialogs": [
				{
					"id": 700081101,
					"content": "*soupir* Une fête n'est pas complète sans un petit verre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081102
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 700081102,
					"content": "Voici la nouvelle boisson de La Queue de Chat...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700081103
					]
				},
				{
					"id": 700081103,
					"content": "Oh, tu veux que je goûte, c'est ça ? Haha ! Je suis ton homme, je m'y connais en alcool.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081104
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 700081104,
					"content": "Voyons voir... Hein ? Cette boisson... Ça n'a aucun goût d'alcool, ça ressemble presque à du lait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081105
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 700081105,
					"content": "Hmm, ça a quand même bon goût. Mais une boisson comme ça, sans alcool, ça ne va pas vraiment avec la fête.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081106
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 700081106,
					"content": "Et puis, il y a pas mal de gens qui ont hâte de se saouler – avec modération – pendant la Fête des alizées. Je doute qu'une boisson comme ça soit populaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nimrod"
				}
			]
		},
