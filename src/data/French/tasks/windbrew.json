					"Margaret"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700080101,
					"content": "Hmm, c'est vrai qu'une boisson spéciale en plus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080102
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080102,
					"content": "Qu'est-ce qu'il se passe ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700080103
					]
				},
				{
					"id": 700080103,
					"content": "Oh, c'est toi. Je réfléchissais juste à lancer une nouvelle boisson spéciale, sur le thème de la Fête des alizées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080104
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080104,
					"content": "Tout le monde s'amuse en ville pendant la fête, et je suis sûre que les gens seraient ravis d'avoir des collations et des boissons pour profiter au mieux de l'ambiance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080105
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080105,
					"content": "Par contre, boire trop d'alcool monte à la tête, sans compter le risque de se faire amener en cellule de dégrisement par les chevaliers...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080106
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080106,
					"content": "Sans compter que rien n'est pire que l'odeur d'alcool pour casser l'ambiance...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080107
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080107,
					"content": "Oh, vraiment ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700080108
					]
				},
				{
					"id": 700080108,
					"content": "J'ai bien entendu dire que certaines personnes apprécient ce genre d'ambiance, quand tout le monde a bien bu. Mais quand même, s'écrouler ivre sur le bord de la route pendant une fête, ce n'est pas l'idéal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080109
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080109,
					"content": "C'est pour ça que j'ai décidé de créer une boisson rafraîchissante et sans alcool, à base de lait et avec un petit goût de « vent ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080110
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080110,
					"content": "Je pense utiliser deux ingrédients particuliers pour souligner le goût du « vent » : le pissenlit et le chrysanthème à aubes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080111
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080111,
					"content": "#Mais si je suis seule à préparer ce qu'il faut, ça va me prendre beaucoup trop de temps. {M#Voyageur}{F#Voyageuse}, pourrais-tu m'aider à récupérer des ingrédients ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080112,
						700080116
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080112,
					"content": "Je vais chercher des pissenlits.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700080113
					]
				},
				{
					"id": 700080113,
					"content": "Merci beaucoup. J'ai entendu dire que les pissenlits de la Falaise Arrachétoile sont de bonne qualité. Tu peux en récupérer là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080114
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080114,
					"content": "Moi, je vais aller chercher des chrysanthèmes à aubes. On se retrouve ici une fois qu'on a fini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080115
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080115,
					"content": "Comme ça, on pourra préparer les boissons tout de suite, et puis on ira demander à quelques passants d'essayer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080116,
					"content": "Je vais chercher des chrysanthèmes à aubes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700080117
					]
				},
				{
					"id": 700080117,
					"content": "Alors je compte sur toi. Les chrysanthèmes à aubes près de Ventlevé sont de bonne qualité, tu n'as qu'à en récupérer là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080118
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080118,
					"content": "Je vais chercher des graines de pissenlits de mon côté. On se retrouve ici quand on a tout récupéré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080119
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080119,
					"content": "Comme ça, on pourra préparer les boissons tout de suite, et puis on ira demander à quelques passants d'essayer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Margaret"
				}
			]
