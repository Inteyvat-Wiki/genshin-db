				"points": []
			},
			"dialogs": [
				{
					"id": 700081802,
					"content": "Très jolis chrysanthèmes à aubes... Je me demande quelle saveur on va obtenir si on les utilise dans notre mélange...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Margaret"
				}
			]
		},
		{
			"id": 7000838,
			"completionStepIds": [
				7000815,
				7000817
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Margaret"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700083801,
					"content": "Bon, on dirait qu'on a tout ce qu'il faut. On peut commencer la préparation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083802
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083802,
					"content": "Je me demande quel goût ça va avoir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700083803
					]
				},
				{
					"id": 700083803,
					"content": "Oh, tu veux goûter aussi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083804
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083804,
					"content": "Eh bien... Le mélange en lui-même n'est pas bien compliqué. Il te suffit de suivre les étapes dans l'ordre et ça devrait être bon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083805
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083805,
					"content": "#Alors, tu veux essayer d'en faire toi-même, {M#voyageur}{F#voyageuse} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083806
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083806,
					"content": "Allez, je tente le coup.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700083807
					]
				},
				{
					"id": 700083807,
					"content": "Parfait ! Bon, laisse-moi déjà t'expliquer la recette. Et tâche de t'en souvenir, hein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083808
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083808,
					"content": "On ajoute d'abord une <color=#00E1FFFF>fleur sucrante</color>, puis normalement on verse l'alcool qui sert de base au cocktail... Mais dans le cas présent, on utilise du <color=#00E1FFFF>lait</color> pour obtenir une saveur plus sucrée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083809
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083809,
					"content": "Pour plus de saveur, on rajoute en plus un <color=#00E1FFFF>chrysanthème à aubes</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083810
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083810,
					"content": "Ensuite, il ne faut pas mélanger tout de suite ! Il faut <color=#00E1FFFF>laisser reposer</color> un peu pour que les fleurs puissent dégager tout leur parfum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083811
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083811,
					"content": "Puis, on saupoudre de <color=#00E1FFFF>graines de pissenlit</color>. Comme ça, c'est aussi beau qu'une mer d'étoiles. Pour finir, on ajoute des <color=#00E1FFFF>glaçons</color> et c'est prêt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083812
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083812,
					"content": "Voilà, c'est dans cet ordre-là. Et ne va pas mélanger les étapes, sinon tu vas tout gâcher. N'oublie pas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083813
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083813,
					"content": "Si tu te souviens des étapes, tu peux essayer. Si tu as oublié, n'hésite pas à me demander encore une fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Margaret"
				}
			]
		},
