						"pointId": 360700068
					}
				]
			},
			"dialogs": [
				{
					"id": 760240501,
					"content": "#Vous n'êtes pas {M#sûrs}{F#sûres} de ce qui se passe, mais vous décidez d'aller voir la petite fille d'abord...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760240502
					]
				},
				{
					"id": 760240502,
					"content": "Faites attention à ces belettes voleuses. La Valléemoley est devenue leur repaire depuis un moment. Si elles s'en prennent à vous, vous deviendrez des gens sans ombre aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240503
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240503,
					"content": "Des belettes voleuses ? Où ça ? Et comment ça, des « gens sans ombre » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240504,
					"content": "Ouah ! C'est quoi cette machine ?! La belette voleuse s'en sert pour nous attaquer ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240505,
					"content": "Elles ont été élevées par des humains, et sont même peut-être plus intelligentes que certains. C'est comme ça qu'elles ont chassé les grands types.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240506
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240506,
					"content": "Il faut <color=#00E1FFFF>retirer le noyau d'énergie</color> et normalement, c'est bon. Les grands types ont essayé, mais ils n'ont jamais réussi, alors ça ne doit pas être facile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240507
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240507,
					"content": "#Hmm, on peut arrêter les belettes voleuses en s'emparant du noyau d'énergie. Et si on tentait, {NICKNAME} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240508,
					"content": "C'est dangereux de laisser la petite toute seule ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240509,
					"content": "Si c'est toi qui me le demandes, Paimon, je le ferai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240510
					]
				},
				{
					"id": 760240510,
					"content": "Reste cachée ici pour le moment, petite... Ah, comment tu t'appelles ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240511,
					"content": "Hein ? Mais c'est toi la plus petite d'entre nous, non ? Je ne comprends pas... Je suis plus grande que toi, alors ne m'appelle pas comme ça ! Enfin bref... Je m'appelle Auni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240512
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240512,
					"content": "#Hum, mettons ça de côté pour l'instant ! Allons-y, {NICKNAME}. On doit s'occuper de ces belettes voleuses !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
