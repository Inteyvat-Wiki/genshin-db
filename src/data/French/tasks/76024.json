			"dialogs": [
				{
					"id": 760240601,
					"content": "Je pense que les Grandes belettes voleuses essaient d'imiter les grands types et faire de la famille Moley leurs subordonnés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240602
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240602,
					"content": "Mais les grands types ont échoué, et elles aussi. Ces belettes ont détruit la Valléemoley, alors la famille Moley a dû se cacher dans un trou quelque part.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240603,
						760240605
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240603,
					"content": "On ne peut pas trop en demander à des taupes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240604
					]
				},
				{
					"id": 760240604,
					"content": "#Oui, ce ne sont que des taupes renifleuses... et les belettes voleuses ont déjà des armes super dangereuses{NON_BREAK_SPACE}! D'ailleurs, c'est fou qu'elles sachent se servir de ça{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240607,
					"content": "La Valléemoley appartient à nouveau à grand-père Moley et à sa famille. Comme promis, voici vos moras. Merci de m'avoir aidée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240608
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240608,
					"content": "Ah oui, je voulais aussi vous donner ça. Helka a dit qu'elle ne veut pas de fiction dans son carnet, ou ce sera difficile de distinguer le vrai du faux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240609
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240609,
					"content": "Mais je ne suis pas certaine que ce soit important... Il y a du vrai, même dans le faux, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240610
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240610,
					"content": "#Bref, à bientôt, {NICKNAME} et petite Paimon. Je viendrai vous demander de l'aide si les Grandes belettes voleuses recommencent leurs bêtises.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240611
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240611,
					"content": "#{NICKNAME}, notre réputation grandit ! Enfin, ce serait bien si ces belettes restaient à leur place. Prends soin de toi, Auni !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240612,
					"content": "Oui ! Bonne route à vous deux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240605,
					"content": "Elles ont dû s'appuyer sur les humains pour ça aussi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240606
					]
				},
				{
					"id": 760240606,
					"content": "Après tout, ce ne sont que des taupes renifleuses... En regardant les choses sous un autre angle, les belettes voleuses ont réussi à mettre la main sur ces machines dangereuses grâce aux humains. C'est donc normal que d'autres humains règlent ce problème !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240607
					],
					"speakerTitle": "Paimon"
				}
			]
		},
