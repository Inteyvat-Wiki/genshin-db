			"dialogs": [
				{
					"id": 760241501,
					"content": "Oh, regardez. C'est toute la famille Moley. Grand-père, papa, maman, petit Moley, toute petite Moley... et les autres aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241502
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760241502,
					"content": "#Des taupes renifleuses ! Mais comment tu fais pour les différencier{NON_BREAK_SPACE}? Elles se ressemblent toutes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760241503,
					"content": "Grâce à leur personnalité, évidemment ! Tu comprendrais si tu les connaissais depuis longtemps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241504
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760241504,
					"content": "Ils ont la mauvaise habitude de mendier auprès des humains. *soupir* Les pauvres... Qu'est-ce qu'il leur arriverait si on venait à disparaître ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241505
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760241505,
					"content": "... Les humains ? Disparaître ? Les taupes seraient encore là après ça ? Je ne pense pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760241506,
					"content": "#Linnea dit que les espèces animales s'éteignent pour diverses raisons. Du coup, c'est pareil pour les humains. Tu ne le savais pas, petite Paimon{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241507,
						760241509
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760241507,
					"content": "J'espère que je vivrai plus longtemps qu'une taupe renifleuse...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760241508
					]
				},
				{
					"id": 760241508,
					"content": "Ça ne répond pas vraiment à la question d'Auni, non ? Hmm... En y réfléchissant bien, les humains sont dans une situation dangereuse avec toutes ces choses qui les menacent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760241512,
					"content": "Bref, que va-t-on faire avec ces trois belettes voleuses maintenant qu'on a retrouvé les taupes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760241513,
					"content": "Si personne n'a d'idée, on peut toujours les livrer au personnel du Navire amiral...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241514
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760241514,
					"content": "#Des trésors ! Ou devrait-on parler de pot-de-vin{NON_BREAK_SPACE}? Peu importe. Si elles nous donnent tout ça, on ne va pas refuser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760241515,
					"content": "#Au moins, elles ont l'air désolées. Laissons-les partir cette fois-ci, {NICKNAME}. Et pas parce qu'elles nous ont donné tous ces trésors, bien sûr !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760241509,
					"content": "On dit que certains insectes existaient avant les humains...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760241510
					]
				},
				{
					"id": 760241510,
					"content": "Ils seront probablement encore là quand on aura disparu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760241511
					]
				},
				{
					"id": 760241511,
					"content": "On va perdre contre les insectes ? Ça m'énerve rien que d'y penser !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241512
					],
					"speakerTitle": "Paimon"
				}
			]
		}
