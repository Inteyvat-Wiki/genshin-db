			"dialogs": [
				{
					"id": 760240101,
					"content": "Hah, c'est la fin pour vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240102,
					"content": "#C'est la première fois que je vois la Grande belette voleuse d'aussi près... Oh, elle aussi, elle est plus grande que toi, Paimon{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240115
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240115,
					"content": "#Qu... Hé ! Peut-on arrêter de me rappeler que je suis petite{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240118,
					"content": "#Mais peu importe sa taille, elle reste une canaille{NON_BREAK_SPACE}! Personne ne va assister à ses funérailles non plus... si elles en organisaient.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240132
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240132,
					"content": "Ah oui ! J'ai entendu Helka dire qu'il y avait des gens étranges qui mangeaient des viandes tout aussi étranges, comme de la belette voleuse. Il y a aussi des gens qui collectionnent les animaux empaillés...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240133
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240133,
					"content": "Du coup, il n'y aura pas besoin de funérailles après...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240134
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240134,
					"content": "Euh, Auni... Tu dis sérieusement toutes ces choses horrifiantes comme si c'était normal ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240135,
					"content": "(Elle a l'air terrifiée.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240136
					],
					"speakerTitle": "Grande belette voleuse"
				},
				{
					"id": 760240136,
					"content": "Stop ! Arrêtez de vous enfuir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240137,
					"content": "Hein ? Elles ne sont pas en train de fuir, on dirait même qu'elles nous attendent ? Allons voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7602402,
			"completionStepIds": [
				7602402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
