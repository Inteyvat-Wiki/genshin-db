			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Auni"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							1648.494,
							213.477,
							9656.33
						],
						"pointId": 11564
					},
					{
						"sceneId": 3,
						"position": [
							1651.032,
							213.487,
							9656.428
						],
						"pointId": 360700011
					},
					{
						"sceneId": 3,
						"position": [
							1650.233,
							213.48,
							9657.646
						],
						"pointId": 360700069
					}
				]
			},
			"dialogs": [
				{
					"id": 760240201,
					"content": "#Vous êtes plus {M#fort}{F#forte} que ces grands types, {NICKNAME}. Comme quoi, la taille ne fait pas tout{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240202
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240202,
					"content": "#T'as vu ? Héhé, {NICKNAME} n'est pas {M#le plus grand}{F#la plus grande}, mais {M#il}{F#elle} peut terrasser des monstres qui font dix fois sa taille les doigts dans le nez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240203,
						760240205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240203,
					"content": "Mais non, c'est Paimon la vraie pro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240204
					]
				},
				{
					"id": 760240204,
					"content": "Hein ?! La flatterie ne te mènera nulle part... ou peut-être que si... La prochaine fois qu'on mangera un repas délicieux, je te donnerai la moitié de ma part.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240206,
					"content": "#Du coup, vous pouvez chasser les Grandes belettes voleuses de la Valléemoley, {NICKNAME} ? Ce n'est pas chez elles, mais elles mettent toujours le bazar là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240207
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240207,
					"content": "Les funérailles qui auraient dû avoir lieu ici n'ont pas pu être organisées, et grand-père Moley a failli perdre la vie par leur faute aussi. Si on veut organiser de nouvelles funérailles, il faut trouver un autre endroit où les tenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240208
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240208,
					"content": "Hein ?! Les belettes voleuses ont vraiment... Mais quand tu parles de funérailles, tu veux dire qu'il y a des gens qui les tiennent ici ? Pourquoi ? Il y a d'autres endroits, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240209,
					"content": "Bien sûr. J'ai terminé tous les préparatifs, puis j'ai réfléchi aux chansons à chanter aussi. Regardez, mais en silence. On doit laisser le défunt reposer en paix.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240210
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240210,
					"content": "Auni sort une petite boîte d'allumettes de sa poche et l'ouvre. Un scarabée avec de jolies couleurs se trouve sur un tissu avec des motifs floraux. Il y a même quelques pétales pour décorer.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760240211
					]
				},
				{
					"id": 760240211,
					"content": "Il se repose éternellement, alors on doit lui organiser des funérailles. J'ai choisi les petites collines avec des machines dessus, mais elles sont toutes occupées par les belettes voleuses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240212
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240212,
					"content": "Si la famille de grand-père Moley n'a pas réussi à s'échapper, c'est qu'elle est sans doute morte. Leur maison a été détruite par les belettes voleuses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240213
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240213,
					"content": "#({NICKNAME}, ce grand-père Moley serait...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240214,
						760240216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240214,
					"content": "(Un petit animal, je suppose.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240215
					]
				},
				{
					"id": 760240215,
					"content": "(Je pense aussi. Certainement un ami animal.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240218,
					"content": "#Hmm, et si on t'aidait à attraper ces vilaines belettes voleuses ? En ce qui concerne la famille de grand-père Moley, on pourra la chercher après s'être {M#occupés}{F#occupées} des belettes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240219,
					"content": "Ouah, vous êtes vraiment de gentilles personnes. Je vous inviterai aux funérailles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240220
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240220,
					"content": "T—Tu n'es pas obligée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240221,
					"content": "D'accord. Dans ce cas, prenez la sculpture en sucre que j'ai achetée tout à l'heure... Ah, je n'ai rien dit, j'ai déjà tout mangé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240222
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240222,
					"content": "Bon, j'ai encore l'argent de poche que Jurva m'a donné. Tenez, vous pouvez vous acheter des sculptures en sucre avec.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240223
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240223,
					"content": "Quand on demande de l'aide à quelqu'un, il faut récompenser la personne et la remercier. C'est la bonne façon de faire les choses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240224,
						760240226
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240224,
					"content": "Paimon, je ne pensais pas que tu prendrais les bonbons d'une enfant...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240225
					]
				},
				{
					"id": 760240225,
					"content": "Attends un peu ! Pourquoi tu parles comme si j'étais une méchante ? Auni, tu es bien polie pour une enfant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240227,
					"content": "#Merci ! Mais je n'ai pas assez de moras pour que vous achetiez une sculpture {M#chacun}{F#chacune}. Vous n'en n'aurez pas plus en me complimentant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240228
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240228,
					"content": "Tu es aussi très pragmatique... D'après toi, on doit s'occuper de plusieurs belettes voleuses. C'est ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240229,
					"content": "Oui. Celle qui vient de s'enfuir n'est pas la Grande belette voleuse que j'ai vue. Je ne sais pas combien de sbires elle a.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240230
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240230,
					"content": "Là-bas, on peut trouver la même main mécanique qui tire des balles, alors il y aura peut-être davantage de belettes voleuses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240231
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240231,
					"content": "D'accord, on ne va pas laisser ces belettes voleuses s'en tirer cette fois-ci. On va leur donner une bonne leçon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240226,
					"content": "C'est très honorable de ta part, Auni.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240227
					]
				},
				{
					"id": 760240216,
					"content": "(Ça pourrait être quelqu'un qui vivait ici.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240217
					]
				},
				{
					"id": 760240217,
					"content": "#(Hein ? Mais on dirait que personne n'habite ici. En tout cas, pas de façon définitive... C'est sans doute l'un de ses amis animaux{NON_BREAK_SPACE}! Elle tient des funérailles pour des insectes, après tout.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240205,
					"content": "Je n'y vais pas de main morte avec les petits monstres non plus !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240206
					]
				}
			]
		},
