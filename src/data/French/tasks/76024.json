						"pointId": 360700070
					}
				]
			},
			"dialogs": [
				{
					"id": 760240401,
					"content": "Tiens, j'ai remarqué que toutes les belettes voleuses s'enfuyaient vers la petite colline là-bas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240402,
					"content": "#Oui, les grands types qui ont entraîné les belettes voleuses ont apporté cette chose. Puis, la Grande belette voleuse s'en est servie pour leur passer un savon et les envoyer valser. Ils ont passé un sale quart d'heure{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240403,
						760240404
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240403,
					"content": "C'est difficile à imaginer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240406
					]
				},
				{
					"id": 760240406,
					"content": "#Bref, allons voir cette colline. Garde les yeux grands ouverts, {NICKNAME}. Une embuscade des belettes voleuses nous attend peut-être... Et je ne veux pas passer un sale quart d'heure !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240404,
					"content": "#Zut, si j'étais {M#arrivé}{F#arrivée} à temps...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240405
					]
				},
				{
					"id": 760240405,
					"content": "#Quoi ? Tu aurais voulu les aider ? Non, ça aurait été juste pour te marrer{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240406
					],
					"speakerTitle": "Paimon"
				}
			]
		},
