			"dialogs": [
				{
					"id": 760240801,
					"content": "Ah, je dois organiser ces funérailles. Est-ce que j'invite les membres de la Clique de la conque ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240802,
						760240805,
						760240808
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240802,
					"content": "À propos de la Clique de la conque...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240803
					]
				},
				{
					"id": 760240803,
					"content": "Vous voulez nous rejoindre ? Allez voir Jurva, il est au « Speranza », Helka ne pourra pas être présente pour participer au vote...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240804
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240804,
					"content": "Mais ça va aller, Jurva se débrouillera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240805,
					"content": "À propos des taupes renifleuses...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240806
					]
				},
				{
					"id": 760240806,
					"content": "Je suppose qu'elles ont pris certaines habitudes des humains après avoir vécu aussi longtemps à leurs côtés. Ça arrive avec les belettes voleuses aussi, et les sauriens de Natlan, d'après ce qu'on m'a dit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240807
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240807,
					"content": "Je ne sais pas si c'est une bonne ou une mauvaise chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240808,
					"content": "Au revoir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240809
					]
				},
				{
					"id": 760240809,
					"content": "Bonne route !",
