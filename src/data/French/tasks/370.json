					"Jean"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3700201,
					"content": "Oh ? C'est Jean, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3700202,
					"content": "Je crois qu'elle est en train de discuter avec quelqu'un...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3700203,
					"content": "On pourrait aller lui dire bonjour quand elles auront terminé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3700204,
					"content": "... Et voilà où nous en sommes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700205
					],
					"speakerTitle": "Anastasia"
				},
				{
					"id": 3700205,
					"content": "L'Ordre de Favonius semble incapable de maîtriser Stormterror. Pourquoi ne pas laisser la protection de Mondstadt aux Fatui ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700206
					],
					"speakerTitle": "Anastasia"
				},
				{
					"id": 3700206,
					"content": "Nous avons les moyens de nous débarrasser facilement de ce monstre, il suffit de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700207
					],
					"speakerTitle": "Anastasia"
				},
				{
					"id": 3700207,
					"content": "Pardon ? Ce « monstre » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700208
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700208,
					"content": "Qu'y a-t-il ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700209
					],
					"speakerTitle": "Anastasia"
				},
				{
					"id": 3700209,
					"content": "Hum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700210
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700210,
					"content": "Honnêtement, je m'attendais à davantage de diplomatie de votre part.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700211
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700211,
					"content": "Si je comprends bien, votre intention est d'éliminer l'un des Quatre Vents de Mondstadt ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700212
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700212,
					"content": "Je vous interdis de prononcer ce genre de balivernes devant les chevaliers de l'Ordre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700213
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700213,
					"content": "Détendez-vous, ce n'est pas aussi fou que vous le pensez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700214
					],
					"speakerTitle": "Anastasia"
				},
				{
					"id": 3700214,
					"content": "Enfin... Assez de négociations pour aujourd'hui, j'imagine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700215
					],
					"speakerTitle": "Anastasia"
				},
				{
					"id": 3700215,
					"content": "Au point où nous en sommes, c'est plutôt un aimable échange d'opinions, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700216
					],
					"speakerTitle": "Anastasia"
				},
				{
					"id": 3700216,
					"content": "Je tâcherai de m'en rappeler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700217
					],
					"speakerTitle": "Anastasia"
				},
				{
					"id": 3700217,
					"content": "#Ah, te voilà de retour, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700218
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700218,
					"content": "Grâce à ton aide, les flux élémentaires se sont stabilisés. Merci beaucoup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700219
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700219,
					"content": "Les choses commencent enfin à se tasser après la dernière attaque de Stormterror – pour l'instant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700220
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700220,
					"content": "Mais la pression de la délégation augmente de jour en jour...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700221
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700221,
					"content": "La délégation ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3700222,
					"content": "Laquelle ? Celle du Port de Liyue ou de la Cité d'Inazuma ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3700223,
					"content": "De Snezhnaya. Ils vénèrent l'Archon Cryo là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700224
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700224,
					"content": "Leurs diplomates se font appeler les Fatui. As-tu déjà entendu parler d'eux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700225
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700225,
					"content": "Ah, je vois. Oh oui, j'en ai entendu parler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3700226,
					"content": "Pas en termes très élogieux, cela dit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3700227,
					"content": "Je ne pense pas que nous devrions éliminer Stormterror.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700228
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700228,
					"content": "Les Fatui ont toujours convoité le pouvoir de l'Archon Anémo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700229
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700229,
					"content": "Je doute que leurs intentions soient aussi bonnes qu'ils veulent le laisser paraître.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700230
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700230,
					"content": "En parlant de pouvoir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3700231
					]
				},
				{
					"id": 3700231,
					"content": "#Oui, {NICKNAME} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700232
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700232,
					"content": "Il y a quelque chose que j'aimerais montrer aux chevaliers de l'Ordre...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3700233
					]
				},
				{
					"id": 3700233,
					"content": "Bien sûr. Allons donc au quartier général.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700234
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700234,
					"content": "Nous ferions mieux de ne pas poursuivre notre discussion ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				}
			]
		},
		{
			"id": 37005,
			"completionStepIds": [
				37005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"37005",
							"2"
						],
						"stepId": 37005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jean"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3700401,
					"content": "Nous avons un cristal imbibé d'un certain pouvoir... Pourrais-tu y jeter un coup d'œil, Lisa ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700402
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700402,
					"content": "Bien sûr, laisse-moi voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700403
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700403,
					"content": "Je peux distinguer quelques impuretés, mais si on regarde de plus près...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700404
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700404,
					"content": "Pardon, je ne crois pas être en mesure de vous fournir une analyse détaillée tout de suite. Il me faut un peu de temps, et j'aurais besoin de jeter un coup d'œil dans la section réservée de la bibliothèque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700405
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700405,
					"content": "D'accord. Lisa, je compte sur toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700406
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700406,
					"content": "Je vous préviendrai dès que je trouve du nouveau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700407
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700407,
					"content": "Mais en toute franchise, je ne promets rien. Beaucoup de textes anciens et autres documents... Aïe !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700408
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700408,
					"content": "Ça fait mal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700409
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700409,
					"content": "Je ne peux pas m'approcher de ce cristal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700410
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700410,
					"content": "Je vois... On dirait bien qu'il réagit à l'œil divin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700411
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700411,
					"content": "Il semblerait que les impuretés et l'énergie élémentaire se repoussent mutuellement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700412
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700413,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3700414
					]
				},
				{
					"id": 3700412,
					"content": "#{NICKNAME} possède pourtant aussi des pouvoirs élémentaires et n'a apparemment aucun problème à s'en approcher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700413
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700415,
					"content": "Petit chou ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3700417
					]
				},
				{
					"id": 3700416,
					"content": "D'accord, je le garderai sur moi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3700417
					]
				},
				{
					"id": 3700414,
					"content": "Je pense qu'on devrait confier ce cristal au petit chou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700415,
						3700416
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700417,
					"content": "Quel phénomène étrange...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700418
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700418,
					"content": "#As-tu une idée de ce qui te rend si {M#spécial}{F#spéciale} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700419
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700420,
					"content": "Je ne sais pas quelle conclusion en tirer non plus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700421
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700421,
					"content": "#{NICKNAME}, au nom de l'Ordre de Favonius, je te redemande de nous apporter ton aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700422
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700422,
					"content": "Je te prie d'accepter le titre de chevalier honoraire, ainsi que ma gratitude en tant que Grande Maîtresse suppléante de l'Ordre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700423
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700424,
					"content": "Chevalier honoraire ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3700426,
					"content": "Nous sollicitons à nouveau ton aide pour trouver la réponse à ces questions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700427
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700427,
					"content": "La colère de Stormterror et ces étranges cristaux... La réponse qu'on cherche pourra sans doute nous aider à ramener la paix à Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700428
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700428,
					"content": "Que le vent te guide vers la vérité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700429
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700429,
					"content": "Reviens me voir si tu trouves du nouveau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				},
				{
					"id": 4820221,
					"content": "Il faut suivre <color=#00E1FFFF>le parcours indiqué</color> jusqu'à la fin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820222
					],
					"speakerTitle": "Amber"
				}
			]
		}
	]
}