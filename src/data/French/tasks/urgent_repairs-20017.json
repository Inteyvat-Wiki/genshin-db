			},
			"dialogs": [
				{
					"id": 200170401,
					"content": "Merci infiniment !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170402
					],
					"speakerTitle": "Farah"
				},
				{
					"id": 200170402,
					"content": "On dirait que ces monstres ne veulent pas partir d'ici. En tout cas, je refuse de rester plus longtemps. C'est trop dangereux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170403
					],
					"speakerTitle": "Farah"
				},
				{
					"id": 200170403,
					"content": "Ils ont encore saccagé mon véhicule. Ça ne sert à rien de le réparer, alors je vais juste attacher le tout avec une corde... Mais où est-elle passée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170404
					],
					"speakerTitle": "Farah"
				},
				{
					"id": 200170404,
					"content": "#Punaise, ces satanés monstres se sont enfuis avec ! {M#Voyageur}{F#Voyageuse}, pourrais-tu me chercher une <color=#00E1FFFF>corde</color> ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farah"
				}
			]
		},
		{
