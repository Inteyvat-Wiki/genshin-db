			"dialogs": [
				{
					"id": 200170301,
					"content": "Ça fera l'affaire, merci. Je vais commencer les réparations dès que je me serai lavé les mains.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170302
					],
					"speakerTitle": "Farah"
				},
				{
					"id": 200170302,
					"content": "Hein ? I—Ils reviennent !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farah"
