			"dialogs": [
				{
					"id": 200170601,
					"content": "Parfait. Elle devrait tenir jusqu'à ce que j'atteigne la ville.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170602
					],
					"speakerTitle": "Farah"
				},
				{
					"id": 200170602,
					"content": "Merci beaucoup. J'espère que nous aurons l'occasion de nous recroiser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170603
					],
					"speakerTitle": "Farah"
				},
				{
					"id": 200170603,
					"content": "Par contre, je ne sais pas comment je vais me débarrasser de l'odeur. Beurk !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farah"
				}
