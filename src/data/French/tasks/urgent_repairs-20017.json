			"trigger": {
				"objectNames": [
					"Farah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200170101,
					"content": "Ne me frappez pas ! Par pitié ! ... Ah, c'est vous. Où est-ce qu'ils sont ? Vous les avez tous chassés ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170102
					],
					"speakerTitle": "Farah"
				},
				{
					"id": 200170102,
					"content": "Merci de m'avoir sauvé ! Ils sont tous partis ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170103
					],
					"speakerTitle": "Farah"
				},
				{
					"id": 200170103,
					"content": "Pfiou. Je vous dois une fière chandelle, mais on dirait que je ne vais pas pouvoir attraper le prochain convoi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170104
					],
					"speakerTitle": "Farah"
				},
				{
					"id": 200170104,
					"content": "Mon chariot est endommagé aussi. Il faut que je le fasse réparer et que je file avant que mes fruits pourrissent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170105
					],
					"speakerTitle": "Farah"
				},
				{
					"id": 200170105,
					"content": "Ça sent vraiment mauvais quand ça arrive. Même une bonne lessive n'enlèvera pas cette odeur putride...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170106
					],
					"speakerTitle": "Farah"
				},
				{
					"id": 200170106,
					"content": "En attendant, j'aurais besoin de jeter un coup d'œil à mes fruits. Je sens déjà que certains ont mal tourné...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170107
					],
					"speakerTitle": "Farah"
				},
				{
					"id": 200170107,
					"content": "J'aurais aussi besoin de matériaux pour rafistoler mon véhicule. Une <color=#00E1FFFF>planche solide</color> devrait suffire, pourriez-vous aller me la chercher ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farah"
				}
			]
		},
		{
			"id": 2001702,
