			"dialogs": [
				{
					"id": 200430401,
					"content": "Tu as trouvé les <color=#00E1FFFF>pommes crépusculaires</color> ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430402
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430402,
					"content": "Pas encore.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430403
					]
				},
				{
					"id": 200430403,
					"content": "Il y en a plein de <color=#00E1FFFF>pommes crépusculaires</color> à l'extérieur de la cité. Vas-y vite, s'il te plaît.",
					"roleType": "TALK_ROLE_NPC",
