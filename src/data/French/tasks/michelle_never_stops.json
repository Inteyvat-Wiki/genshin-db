			},
			"dialogs": [
				{
					"id": 200430601,
					"content": "Vous avez pu parler à Quinn ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430602
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430602,
					"content": "Oui, il vous a dit de vous reposer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430603
					]
				},
				{
					"id": 200430603,
					"content": "Il n'y a rien à faire au stand de fruits aujourd'hui, alors profitez-en pour souffler un peu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200430604,
					"content": "Ah bon ? Il faut que je trouve quelque chose à faire pour m'occuper...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430605
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430605,
					"content": "Pourquoi ?! C'est le moment de se reposer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200430606,
					"content": "Vous ne le ressentez pas ? Les vents de Barbatos sont en train de travailler dur, eux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430607
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430607,
					"content": "Nous devons contribuer aussi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430608
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430608,
					"content": "Qu'est-ce que vous avez fait pour transpirer autant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430609
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430609,
					"content": "Je vois que vous n'étiez pas en train de bayer aux corneilles ! C'est bien ! Plus on travaille et plus on est récompensés par Barbatos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430610
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430610,
					"content": "Buvez un peu de lait avant de partir. Il y a tant à faire dans ce monde avant de se reposer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michelle"
				}
			]
		},
