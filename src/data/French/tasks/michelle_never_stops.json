				"points": []
			},
			"dialogs": [
				{
					"id": 200430301,
					"content": "Où est passé cette fichue livraison ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430302
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430302,
					"content": "Que s'est-il passé ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430303
					]
				},
				{
					"id": 200430303,
					"content": "J'ai vendu toutes mes pommes crépusculaires. J'en avais commandé plusieurs lots tout à l'heure, mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430304
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430304,
					"content": "Elles ne sont toujours pas arrivées et mes clients ne peuvent pas attendre là toute la journée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430305
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430305,
					"content": "Eury est passée trois fois pour <color=#00E1FFFF>trois pommes crépusculaires</color>. C'est une de mes habituées, je n'ai pas envie de perdre une bonne cliente comme elle !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430306
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430306,
					"content": "Je dois m'occuper de mon stand. Si seulement quelqu'un avait la gentillesse d'aller chercher ces pommes crépusculaires pour moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430307,
						200430309
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430307,
					"content": "Je peux y aller si c'est urgent.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430308
					]
				},
				{
					"id": 200430308,
					"content": "Pour de vrai ? Merci mille fois !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430309,
					"content": "Michelle arrive bientôt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430310
					]
				},
				{
					"id": 200430310,
					"content": "Attendez un peu, elle ne peut pas le faire avec l'état de son dos !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200430311,
					"content": "Aidons-le !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
