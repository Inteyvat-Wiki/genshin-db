			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30100101,
					"content": "Je me souviens de tout !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100102,
					"content": "#... Bien, vous vous êtes rapidement {M#adaptés}{F#adaptées} cette fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100103
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100103,
					"content": "À la fin de la nuit dernière...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100104
					]
				},
				{
					"id": 30100104,
					"content": "Oui... Même si on a éteint les terminaux akashiens la nuit dernière, on a quand même entendu ce bip. Pourquoi ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100105,
						30100106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100105,
					"content": "On nous a implanté d'autres formes de terminaux akashiens ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100107
					]
				},
				{
					"id": 30100107,
					"content": "#Maintenant, au moins, on est {M#sûrs}{F#sûres} d'une chose. L'Akasha a quelque chose à voir avec ce qui nous piège dans ce cycle !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100108,
					"content": "Mais je ne comprends toujours pas... Pourquoi l'Akasha irait aussi loin, si tout ce qu'il voulait était la sagesse de chacun ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100109,
					"content": "En effet, il est extrêmement difficile pour les rats de laboratoire sur la table d'expérimentation de comprendre pourquoi ils sont traités de cette façon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100110
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100110,
					"content": "Si on est des rats de laboratoire, Nahida, alors qu'est-ce que vous êtes, vous ? Vous ne nous avez jamais rien dit sur vous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100111,
					"content": "Hmm... Je suppose que je suis la lune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100112
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100112,
					"content": "La lune ? Comme la lune de la divination ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100113,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100114
					]
				},
				{
					"id": 30100114,
					"content": "Dans tous les cas, connaître mon identité ne vous aidera pas à découvrir la vérité, alors je vous suggère de vous concentrer sur autre chose. Ne vous laissez pas distraire et ne manquez aucun indice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100115
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100115,
					"content": "Hmpf... Très bien. Dehya nous a beaucoup aidés hier, alors retournons la voir. Si je ne me trompe pas, les kidnappeurs devraient se montrer bientôt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100106,
					"content": "On n'a pas réussi à rompre le lien avec eux ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100107
					]
				}
			]
		},
		{
			"id": 301002,
			"completionStepIds": [
				301002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301002",
							"2"
						],
						"stepId": 301002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dehya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30100201,
					"content": "Ah, vous voilà. Je me suis déjà occupée de ces kidnappeurs. Mademoiselle, vous êtes blessée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100202
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100202,
					"content": "Attendez, il y a quelque chose qui cloche...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100203
					]
				},
				{
					"id": 30100203,
					"content": "Hein ? Dehya ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100204,
					"content": "#Qu'est-ce qui ne va pas ? Pourquoi vous me regardez {M#tous}{F#toutes} les deux comme ça{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100205
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100205,
					"content": "V—Vous avez réussi à vous en sortir indemne cette fois !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100206,
					"content": "Hein ? Qu'est-ce que tu veux dire par « cette fois » ? Et en plus, pourquoi être surpris que j'aie réussi à m'en sortir indemne ? Ces kidnappeurs sont des amateurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100207,
						30100208
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100207,
					"content": "Vous n'avez pas besoin de vous habituer à votre nouvelle lame ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100209
					]
				},
				{
					"id": 30100209,
					"content": "Chut... Comment vous savez pour mon espadon ? Je n'en ai parlé à personne. S'il vous plaît, ne dites rien à mademoiselle Dunyarzad !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100210
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100210,
					"content": "Alors Dehya a perdu la mémoire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100211,
						30100212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100211,
					"content": "Pendant ce combat...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100213
					]
				},
				{
					"id": 30100213,
					"content": "Quelque chose d'étrange... Eh bien, vous savez déjà que j'ai une nouvelle lame. Si je devais dire quelque chose, je dirais que c'est bizarre qu'une nouvelle arme puisse sembler si familière.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100214
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100214,
					"content": "C'est comme si... Je l'avais déjà utilisée pour combattre un nombre incalculable de fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100215
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100215,
					"content": "#Ce que vous dites, c'est que même si vous ne vous souvenez pas de l'avoir utilisée pour vous battre, votre corps, lui... semble la connaître parfaitement{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100216,
					"content": "C'est ça. Les mercenaires et les guerriers se fient beaucoup à la mémoire musculaire. La mémorisation des mouvements par le cerveau n'a que peu d'importance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100217
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100217,
					"content": "#{NICKNAME}, qu'est-ce que tu en penses ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100218,
						30100219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100218,
					"content": "#Est-ce que ce serait parce qu'on a retiré nos terminaux akashiens hier{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100220
					]
				},
				{
					"id": 30100220,
					"content": "Oui, je suis pleine d'espoir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100221,
					"content": "#Se pourrait-il... qu'on soit déjà libres{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100222
					]
				},
				{
					"id": 30100222,
					"content": "Ooh ! Tu as raison, une chose pareille ne serait jamais arrivée lors des samsaras précédents.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100223,
					"content": "#On ne pourra en être {M#sûrs}{F#sûres} qu'à la fin de la journée.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100224
					]
				},
				{
					"id": 30100224,
					"content": "#Même si je n'ai aucune idée de ce dont vous parlez, je n'ai pas l'impression qu'on soit {M#sortis}{F#sorties} d'affaire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100225
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100225,
					"content": "#On n'est pas {M#sortis}{F#sorties} d'affaire, alors vous voulez qu'on emmène Dunyarzad se reposer pendant que vous allez voir s'il reste des kidnappeurs là-bas, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100226,
					"content": "Comment vous savez ce que j'allais dire... Vous pouvez lire dans les pensées ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100227
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100227,
					"content": "Ne vous en faites pas ! Allez-y.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100219,
					"content": "Ça n'est jamais arrivé avant...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100220
					]
				},
				{
					"id": 30100212,
					"content": "Avez-vous ressenti quelque chose d'étrange ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100213
					]
				},
				{
					"id": 30100208,
					"content": "La période de rodage vous vaut généralement quelques égratignures.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100209
					]
				}
			]
		},
		{
			"id": 301003,
			"completionStepIds": [
				301003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301003",
							"2"
						],
						"stepId": 301003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30100301,
					"content": "... Ouf, enfin la nuit. À part la blessure de Dehya, tout semble être resté pareil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100302,
					"content": "Écoutez, Nahida ! On a découvert que Dehya s'en était bien sortie aujourd'hui, alors qu'elle se blessait à chaque fois qu'elle rencontrait les kidnappeurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100303,
					"content": "Est-ce que vous pensez que le samsara a été brisé ? On a sauvé Dunyarzad ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100304,
					"content": "Oh ? Bien joué, on dirait que vous avez fait de sacrés progrès. Dans ce cas... Je vous recommande de bien vous reposer ce soir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100305
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100305,
					"content": "Hé, c'est quoi cette réponse ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100306,
					"content": "Demain arrive toujours, c'est une question de bon sens. Mais en réalité, vous ne saurez que demain est arrivé que lorsque vous l'aurez réellement vécu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100307
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100307,
					"content": "#Combien de fois avons-nous vécu « aujourd'hui » ? Est-il possible qu'«{NON_BREAK_SPACE}aujourd'hui » soit suivi d'« hier » ? Est-ce que « demain » existe vraiment, au-delà d'un concept inventé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100308
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100308,
					"content": "Il est même possible que... ce monde tout entier soit un mensonge, et que son histoire n'ait été qu'un interminable Festival Sabzeruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100309
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100309,
					"content": "C'est bon, s'il vous plaît, arrêtez ! Mon cerveau est en train d'exploser !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100310,
					"content": "Héhé... Maintenant vous voyez pourquoi ça ne sert à rien de gaspiller son énergie aujourd'hui pour des choses qui seront découvertes le lendemain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100311
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100311,
					"content": "Reposez-vous bien ! Et utilisez les toilettes si vous avez besoin de vous soulager...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100312
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100312,
					"content": "Hein ? Attendez, qu'est-ce que vous venez de dire ? J'ai bien entendu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100313,
					"content": "Hmm ? Les gens disent qu'ils se sentent généralement mieux après un passage là-bas. C'est pourquoi je vous ai dit d'y aller. C'est si étrange que ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100314
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100314,
					"content": "Argh... C'est tellement étrange et dépourvu de toute logique que je ne sais même plus quoi dire... Vous étiez encore en train d'épiloguer sur l'existence il y a une minute !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100315,
					"content": "... Allons nous reposer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100316
					]
				},
				{
					"id": 30100316,
					"content": "#Oui... Même si tous les jours de ce festival sont joyeux, j'ai l'impression que ça fait longtemps qu'on ne s'est pas {M#détendus}{F#détendues}. {NICKNAME}, retournons à la chambre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100317,
