					]
				},
				{
					"id": 207400502,
					"content": "Alors, tu as trouvé ces graines de pissenlit ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400503
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400503,
					"content": "Oui, les voilà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207400504
					]
				},
				{
					"id": 207400504,
					"content": "Ah, merci ! Ça devrait faire l'affaire. J'irai les planter tout à l'heure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400505
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400505,
					"content": "J'en profiterai pour replanter les autres fleurs que tu as cueillies pour moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400506
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400506,
					"content": "Ah oui, tiens, en récompense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400507
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400507,
					"content": "Il faut que je me dépêche de m'occuper de ces fleurs, sans oublier de planter les pissenlits...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
