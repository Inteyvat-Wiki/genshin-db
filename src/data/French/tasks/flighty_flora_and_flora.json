			"dialogs": [
				{
					"id": 207400401,
					"content": "À propos des fleurs...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207400402
					]
				},
				{
					"id": 207400402,
					"content": "Alors, tu en as trouvé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400403
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400403,
					"content": "Oui, j'ai tout trouvé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207400404
					]
				},
				{
					"id": 207400404,
					"content": "Ah, des fleurs bien fraîches... Merci. Une fois que je les aurais arrangées dehors, je suis sûre que les clients suivront.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400405
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400405,
					"content": "J'aurais un autre petit service à te demander... Le vent a aussi emporté les pissenlits qui étaient dans la boutique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400406
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400406,
					"content": "Ce n'est jamais une mauvaise chose que les graines de pissenlit se répandent au vent, mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400407
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400407,
					"content": "Ne pas trouver de pissenlits chez une fleuriste de Mondstadt, c'est juste... anormal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400408
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400408,
					"content": "Les pissenlits ne peuvent pas être cueillis comme les autres fleurs ; il faut les faire pousser...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400409
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400409,
					"content": "Est-ce que tu pourrais aller me chercher des graines de pissenlit ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400410,
						207400412
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400410,
					"content": "Pas de problème.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207400411
					]
				},
				{
					"id": 207400411,
					"content": "Merci, je te laisse régler ça alors. On trouve beaucoup de pissenlits à l'extérieur de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400412,
					"content": "Où est-ce que je peux en trouver ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207400413
					]
				},
				{
					"id": 207400413,
					"content": "Il y a beaucoup de pissenlits aux environs de Mondstadt, ça ne devrait pas poser de problème.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
