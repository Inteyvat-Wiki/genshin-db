			"dialogs": [
				{
					"id": 230020201,
					"content": "Alors ? Avez-vous cueilli les champignons ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hanbei"
				}
			]
		},
		{
			"id": 2300203,
			"completionStepIds": [
				2300205
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2300205",
							"2"
						],
						"stepId": 2300205,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_ITEM_NUM_LESS_THAN",
						"rawParams": [
							"101955",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hanbei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230020301,
					"content": "Très bien, ça devrait suffire. Ils ont l'air beaux et frais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020302
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020302,
					"content": "Voici votre récompense, merci à vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020303
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020303,
					"content": "Brut ou net ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020304
					]
				},
				{
					"id": 230020304,
					"content": "Net, évidemment. Ne vous inquiétez pas, vous n'aurez pas besoin de retourner à Inazuma pour payer des impôts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020305
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020305,
					"content": "Par contre, je ne sais pas si la politique fiscale du Shogunat a été révisée depuis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020306
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020306,
					"content": "Hum, je vais trouver du temps pour écrire à Yousuke sur le sujet.",
