			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaeya",
					"Rosalia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705040101,
					"content": "#Oh, quelle surprise. C'est toi {M#le barman}{F#la barmaid} aujourd'hui ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040102
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040102,
					"content": "Dans ce cas, j'aimerais bien une mort de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040103
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040103,
					"content": "Vous avez vraiment le don de mettre les gens dans l'embarras dès que vous ouvrez la bouche, Kaeya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040104
					],
					"speakerTitle": "Rosalia"
				},
				{
					"id": 705040104,
					"content": "Ah, mais c'était seulement pour voir sa réaction. D'ailleurs, je ne pensais pas que vous viendriez boire ici aujourd'hui, chère Rosalia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040105
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040105,
					"content": "#Les clients de la taverne sont exigeants, je voulais simplement donner {M#au voyageur}{F#à la voyageuse} une occasion de s'entraîner davantage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040106
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040106,
					"content": "Et voilà qu'il recommence avec son baratin !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705040107,
					"content": "C'est une méprise, mes intentions ne sont que les meilleures ! Tu devrais même me remercier. Tiens, et si tu me préparais quelque chose de simple, comme une allée baignée de lune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040108
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040108,
					"content": "Un grand verre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040109
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040109,
					"content": "Voyons... Je vais prendre un thé. N'importe lequel, dans un verre pas trop grand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040110
					],
					"speakerTitle": "Rosalia"
				},
				{
					"id": 705040110,
					"content": "C'est noté. Je reviens tout de suite.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705040111
					]
				},
				{
					"id": 705040111,
					"content": "Prends ton temps. Patienter pour une bonne boisson fait partie du plaisir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				}
			]
		},
		{
			"id": 7050402,
			"completionStepIds": [
				7050404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7050404",
							"2"
						],
						"stepId": 7050404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rosalia",
					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705040201,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040202
					],
					"speakerTitle": "Rosalia"
				},
				{
					"id": 705040202,
					"content": "Qu'y a-t-il Rosalia ? La boisson ne vous plaît pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705040203,
					"content": "Je peux vous en refaire une...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705040204
					]
				},
				{
					"id": 705040204,
					"content": "Non, ça n'a rien à voir. C'est juste que je ne bois pas souvent de thé et son goût me rappelle certaines choses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040205
					],
					"speakerTitle": "Rosalia"
				},
				{
					"id": 705040205,
					"content": "En rapport avec l'Église ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040206
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040206,
					"content": "Oui. Un jour, elle a organisé un événement auquel je ne pouvais pas assister, mais sœur Barbara m'a gardé du thé et un dessert...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040207
					],
					"speakerTitle": "Rosalia"
				},
				{
					"id": 705040207,
					"content": "Le dessert n'était plus bon, alors elle l'a repris discrètement, mais le thé avait à peu près le même goût que celui-ci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040208
					],
					"speakerTitle": "Rosalia"
				},
				{
					"id": 705040208,
					"content": "C'est rare de vous voir comme ça, Rosalia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705040209,
					"content": "On dirait bien qu'il y a une fan de thé noir de plus à Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040210
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040210,
					"content": "Je préfère quand même quelque chose de plus fort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040211
					],
					"speakerTitle": "Rosalia"
				},
				{
					"id": 705040211,
					"content": "Et toi, Kaeya, comment trouves-tu ta boisson ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705040212
					]
				},
				{
					"id": 705040212,
					"content": "Si je te dis ses défauts, tu m'en referas une ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040213
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040213,
					"content": "Hahaha, je plaisante. Jamais je n'oserais te faire ce genre de bassesse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040214
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040214,
					"content": "*soupir* Kaeya est toujours aussi imprévisible ! Comment faites-vous pour supporter sa compagnie lors de vos beuveries...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705040215,
					"content": "Ah bon ? Personnellement, je ne me soucie pas de ce qui se passe dans sa tête. Tant qu'on parle de boissons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040216
					],
					"speakerTitle": "Rosalia"
				},
				{
					"id": 705040216,
					"content": "De plus, Kaeya ne s'intéresse qu'aux personnes ou choses qui l'intriguent. Vous, le patron de la taverne...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040217
					],
					"speakerTitle": "Rosalia"
				},
				{
					"id": 705040217,
					"content": "Hé, ce n'est pas très sympa de dévoiler les secrets de votre compagnon de beuverie de longue date, vous savez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040218
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040218,
					"content": "Vous pensez que j'en dis trop ? Franchement, ce n'est rien du tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040219
					],
					"speakerTitle": "Rosalia"
				},
				{
					"id": 705040219,
					"content": "Je suis constamment entourée de personnes très sérieuses au quotidien. L'ambiance détendue de la taverne me sied mieux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040220
					],
					"speakerTitle": "Rosalia"
				},
				{
					"id": 705040220,
					"content": "Oh ? C'est l'heure de parler de ces gens ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040221
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040221,
					"content": "D'ailleurs, je connais quelqu'un qui pourrait facilement se placer parmi les trois personnes les plus sérieuses de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040222
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040222,
					"content": "À quel point est-il sérieux... Oh, facile : je n'arriverai même pas à lui arracher une réaction en lui disant ses quatre vérités.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040223
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040223,
					"content": "Il existe un tel classement ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705040224,
					"content": "Bien sûr. J'ai des classements pour tout : buveurs invétérés, bourreaux du travail, pires cuisiniers, plus grands détenteurs de sombres secrets...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040225
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040225,
					"content": "Les Mondstadtois ont vraiment trop de temps libre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705040226,
					"content": "Vous en connaissez beaucoup des gens qui n'ont pas de travail ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040227,
						705040228
					],
					"speakerTitle": "Rosalia"
				},
				{
					"id": 705040227,
					"content": "Pas vraiment...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705040229
					]
				},
				{
					"id": 705040229,
					"content": "#Hmm, il n'existe pas de classement dans lequel on pourrait se placer ensemble avec {NICKNAME} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705040230,
					"content": "#Si, celui des {M#meilleurs barmans}{F#meilleures barmaids}, par exemple.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040231
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040231,
					"content": "C—C'est vrai ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705040232,
					"content": "#Génial, {NICKNAME} ! On a réussi à se faire un nom !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705040233,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040234
					],
					"speakerTitle": "Rosalia"
				},
				{
					"id": 705040234,
					"content": "Cette ambiance n'est pas désagréable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040235
					],
					"speakerTitle": "Rosalia"
				},
				{
					"id": 705040235,
					"content": "N'est-ce pas ? Je me sens heureux rien qu'en les regardant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040236
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040236,
					"content": "#Une taverne doit avoir une atmosphère amicale et chaleureuse, c'est le plus important pour attirer des clients. On dirait bien que vous méritez votre titre de « {M#meilleurs barmans}{F#meilleures barmaids} ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040237
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040237,
					"content": "Quoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705040238,
					"content": "#Non, rien. Merci pour votre accueil {M#tous}{F#toutes} les deux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040239
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040239,
					"content": "Oui, je devrais y aller moi aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040240
					],
					"speakerTitle": "Rosalia"
				},
				{
					"id": 705040240,
					"content": "Au passage, ce thé noir était excellent. Je m'en ferai à l'avenir... Si j'arrive à me lever assez tôt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040241
					],
					"speakerTitle": "Rosalia"
				},
				{
					"id": 705040241,
					"content": "À la prochaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040242
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040242,
					"content": "À bientôt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 705040228,
					"content": "Je crois que je sais de qui Kaeya parle...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705040229
					]
				}
			]
		}
	]
}