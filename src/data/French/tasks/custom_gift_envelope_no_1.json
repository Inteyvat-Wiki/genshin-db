			"dialogs": [
				{
					"id": 715330101,
					"content": "Hum, ça ne m'a pas l'air bon non plus... Ces enveloppes-cadeaux sont vraiment difficiles à faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330102
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 715330102,
					"content": "Tu fais des enveloppes-cadeaux, Mika ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715330103
					]
				},
				{
					"id": 715330103,
					"content": "#{NICKNAME} ! Quelle coïncidence ! Je ne m'attendais pas à vous voir ici !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330104
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 715330104,
					"content": "Tu es venu célébrer le Festival des lanternes ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715330105
					]
				},
				{
					"id": 715330105,
					"content": "Ah ? Non, pas du tout. Je suis venu ici pour livrer un courrier. C'est le hasard qui a fait que ce soit en plein Festival des lanternes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330106
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 715330106,
					"content": "Klee a dit qu'elle voulait vraiment une enveloppe-cadeau du Festival des lanternes, alors j'ai voulu en acheter une pour la ramener.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330107
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 715330107,
					"content": "Imaginez ma surprise quand j'ai découvert qu'il fallait les fabriquer soi-même...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330108
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 715330108,
					"content": "J'ai pris beaucoup de temps à essayer d'en faire une, mais j'ai beau la regarder sous toutes les coutures, j'ai l'impression que quelque chose cloche. Je ne sais pas où je me suis trompé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330109
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 715330109,
					"content": "#{NICKNAME}, vous en savez plus que moi sur les coutumes de Liyue... Pourriez-vous me donner quelques conseils pour l'améliorer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330110
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 715330110,
					"content": "Je vais réfléchir un peu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
