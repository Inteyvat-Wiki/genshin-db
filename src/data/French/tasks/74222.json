	"talks": [
		{
			"id": 7422201,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7422201",
							"2"
						],
						"stepId": 7422201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Moce"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742220101,
					"content": "#Restez sur vos gardes, {M#citoyen}{F#citoyenne} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220102,
						742220106,
						742220109,
						742220116
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220102,
					"content": "Qu'est-ce que tu fais là ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220103
					]
				},
				{
					"id": 742220103,
					"content": "Moi ? Comme vous pouvez le constater, je suis toujours occupé à repousser la menace barbare. Leurs attaques se font de plus en plus pressantes récemment, et ils pourraient même avoir envoyé des espions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220104
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220104,
					"content": "Ce n'est pas une mince affaire, il faut être plus vigilants avant l'arrivée des renforts !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220105
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220105,
					"content": "#S'il y a autre chose, veuillez le signaler à mon vicaire, {M#citoyen}{F#citoyenne}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220106,
					"content": "Un enfant tout seul dans cet endroit...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220107
					]
				},
				{
					"id": 742220107,
					"content": "Hein ? Un enfant ? Où ça ? Est-ce que l'une de nos nouvelles recrues a violé les ordres militaires en ramenant des membres de sa famille au camp sans autorisation...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220108
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220108,
					"content": "*soupir* Le dominus Cassiodor a encore été trop gentil avec ces nouvelles recrues. Si cela s'était produit il y a trente ans, un tribun aurait déjà dégainé son fouet...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220109,
					"content": "Y a-t-il autre chose de suspect ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220110
					]
				},
				{
					"id": 742220110,
					"content": "Pas encore. Cependant, les barbares sont comme des bêtes rusées. Ils attaquent toujours lorsque vous vous y attendez le moins. Prendre les gens par surprise est leur spécialité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220111
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220111,
					"content": "Ils utiliseront toutes les méthodes les plus sordides pour infiltrer nos villes et découvrir nos secrets. Le moindre relâchement peut conduire à un désastre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220112
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220112,
					"content": "*soupir* Il y a trente ans, lorsque j'ai suivi le dominus Boethius dans son expédition vers le nord, ils n'étaient qu'un groupe de sauvages primitifs et n'auraient jamais utilisé ces méthodes perfides. Où ont-ils appris tout ça...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220113
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220113,
					"content": "Il y a trente ans... Tes parents n'étaient même pas encore nés...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220114
					]
				},
				{
					"id": 742220114,
					"content": "#Hein ? Qu'est-ce que vous venez de dire, {M#citoyen}{F#citoyenne} ? J'ai bien peur qu'avec l'âge, mon ouïe ne s'affaiblisse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220115
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220115,
					"content": "*soupir* Je repense à l'époque où nous avions conquis Bituria, j'entendais les cloches des barbares se rassembler à des kilomètres de distance. Le temps ne nous pardonnera jamais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220116,
					"content": "Au revoir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220117
					]
				},
				{
					"id": 742220117,
					"content": "#Au revoir, {M#citoyen}{F#citoyenne}. Si vous rencontrez quelqu'un de suspect, n'hésitez pas à me le signaler !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Moce"
				}
			]
		},
		{
			"id": 7422202,
			"completionStepIds": [
				7422202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7422202",
							"2"
						],
						"stepId": 7422202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Giovanni"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742220201,
					"content": "*soupir* Je me demande quand cette bataille se terminera...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220202
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220202,
					"content": "Qu'est-ce que vous faites sur le toit ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220203
					]
				},
				{
					"id": 742220203,
					"content": "#Je surveille les activités barbares, bien sûr. Dernièrement... Attendez une minute, {M#citoyen}{F#citoyenne}, comment êtes-vous {M#arrivé}{F#arrivée} jusqu'à la tour de guet ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220204
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220204,
					"content": "C'est moi qui devrais vous poser la question...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220205
					]
				},
				{
					"id": 742220205,
					"content": "Enfin, peu importe. Le tribun Mettius dit que les attaques barbares se rapprochent, et que des espions pourraient s'être déjà infiltrés dans nos rangs. Nous devons rester sur nos gardes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220206
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220206,
					"content": "Mais vous pensez que les barbares s'embêteraient avec une petite ville isolée comme la nôtre ? Sans parler d'envoyer des espions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220207
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220207,
					"content": "Il n'y a pas de petit butin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220208
					]
				},
				{
					"id": 742220208,
					"content": "Vous avez raison ! Je vais devoir me ressaisir. Mais à en juger par votre façon de parler, vous semblez avoir de l'expérience dans le domaine, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220209
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220209,
					"content": "Si oui, peut-être pourriez-vous m'aider à inspecter la zone ? Si les barbares ont été actifs dans la zone, ils ont dû laisser des traces, comme des épées en bois ou quelque chose comme ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220210
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220210,
					"content": "Euh, comme des enfants qui jouent à la guerre ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220211
					]
				},
				{
					"id": 742220211,
					"content": "Eh bien, ce sont des barbares. Le fait qu'ils utilisent des bâtons de bois comme armes ne serait pas vraiment surprenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220212
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220212,
					"content": "Bien, je compte sur vous. Si vous trouvez quelque chose, faites-le-moi savoir. C'est aussi l'un des devoirs civiques des citoyens de Remuria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Giovanni"
				}
			]
		},
		{
			"id": 7422207,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
