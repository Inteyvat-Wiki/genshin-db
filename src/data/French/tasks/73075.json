			"dialogs": [
				{
					"id": 730750101,
					"content": "#Merci à vous, nara {NICKNAME} et Paimon. La pépinière de Vanarana est désormais pleine de viparyas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730750102
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730750102,
					"content": "Les viparyas ici sont très heureux, donc, Arakara est heureux aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730750103
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730750103,
					"content": "#Le Festival Utsava est fini. Avant que {M#le nara doré}{F#la nara dorée} ne quitte la vana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730750104
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730750104,
					"content": "Vous obtenez un viparyas.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730750105
					]
				},
				{
					"id": 730750105,
					"content": "#Voilà un viparyas heureux pour {M#le nara doré}{F#la nara dorée}. J'espère que {NICKNAME} et Paimon seront heureux. Ce viparyas ne fanera jamais, néanmoins...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730750106
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730750106,
					"content": "N'oubliez pas de lui parler de temps en temps, et c'est encore mieux si vous pouvez lui jouer de la musique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730750107
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730750107,
					"content": "#La terre n'oubliera pas, et les aranaras n'oublieront pas. J'espère que nara {NICKNAME} et Paimon n'oublieront pas non plus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakula"
				}
			]
		},
