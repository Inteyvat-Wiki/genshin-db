			"dialogs": [
				{
					"id": 730750201,
					"content": "#Le Festival Utsava avec nara {NICKNAME} est comme celui que nara Varuna et les aranaras ont passé ensemble... Cela fait longtemps que je n'ai pas été aussi heureux *sniff* ...",
					"roleType": "TALK_ROLE_NPC",
