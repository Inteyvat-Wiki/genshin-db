			},
			"dialogs": [
				{
					"id": 706900301,
					"content": "Oh ? Vous avez déjà fini le tri ? C'est allé beaucoup plus vite que prévu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900302
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900302,
					"content": "Que voudrais-tu en échange mon petit chou ? Tu m'as libéré tout l'après-midi en m'aidant avec ça. Et si on passait du temps ensemble ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900303,
						706900305
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900303,
					"content": "#J'aimerais être {M#payé}{F#payée}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706900304
					]
				},
				{
					"id": 706900304,
					"content": "Ah, c'est tout ? Ne t'inquiète pas, je n'oublierai pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900306
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900306,
					"content": "Ah, tu l'as aussi remarqué. Ils ont des titres si étranges, leur contenu l'est d'autant plus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900307
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900307,
					"content": "Sans compter que nous sommes dans la plus grande bibliothèque du nord de Teyvat, mais je n'ai reconnu aucun des titres de la liste. Je ne vois vraiment pas comment c'est possible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900308
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900308,
					"content": "À moins que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900309
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900309,
					"content": "#En fait, on est {M#tombés}{F#tombées} sur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706900310,
					"content": "Des ennuis, je suppose ? Je préfère m'en tenir à l'écart, si ça ne vous dérange pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900311
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900311,
					"content": "D'ailleurs, si un livre existe dans ce monde, il a forcément sa place dans cette bibliothèque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900312
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900312,
					"content": "Il vaut mieux qu'ils restent ici plutôt qu'ils ne tombent entre les mains de quelqu'un de plus... louche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900313
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900313,
					"content": "En tout cas, voici votre rémunération. Merci encore pour toute votre aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900305,
					"content": "J'aimerais vous poser des questions sur ces livres...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706900306
					]
				}
			]
		}
	]
