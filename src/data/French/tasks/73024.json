			"dialogs": [
				{
					"id": 730240101,
					"content": "Merci beaucoup. Vous m'avez bien aidée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240102
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240102,
					"content": "Comme vous pouvez le voir, je suis brigadière forestière, et mon nom est Rana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240103,
						730240105
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240103,
					"content": "#Je m'appelle {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240104
					]
				},
				{
					"id": 730240104,
					"content": "Mon nom est Paimon ! On vient d'un autre pays.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730240107,
					"content": "#Je vois. Hmm... Vous n'êtes pas {M#habillés}{F#habillées} comme des {M#habitants}{F#habitantes} de la forêt, et vous n'avez pas non plus l'air de venir du désert. Par contre, vos vêtements sont aérés, ce qui est parfait pour voyager à Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240108
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240108,
					"content": "Huh ? Rana, si vous êtes brigadière forestière...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240109,
						730240123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730240109,
					"content": "#Vous devez connaître Tighnari, non{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240110
					]
				},
				{
					"id": 730240110,
					"content": "#Oh ! {NICKNAME}, vous aussi, vous connaissez Tighnari ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240111
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240111,
					"content": "Tighnari n'est pas facile à approcher, mais il est très gentil. Il s'est vraiment bien occupé de moi pendant ma formation. Et puis il faut dire qu'il a de belles oreilles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240112
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240112,
					"content": "Oui ! J'ai vraiment envie de les toucher...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240113,
						730240116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730240113,
					"content": "Moi aussi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240114
					]
				},
				{
					"id": 730240114,
					"content": "Hmm... Si je m'approche discrètement de lui en volant, arriverais-je à les toucher ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730240115,
					"content": "Haha ! Tighnari se mettra en colère si tu fais ça sans demander sa permission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240118
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240118,
					"content": "N'est-ce pas ? Elles ont l'air reluisantes. Je suis curieuse de savoir quelle sensation elles donnent au toucher. Elles ont aussi l'air de fasciner l'enfant qui est avec lui en ce moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240119
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240119,
					"content": "Ah ? Rana, est-ce que tu serais en train de parler de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730240120,
					"content": "Collei ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240121
					]
				},
				{
					"id": 730240121,
					"content": "#Tiens ? {NICKNAME}, vous connaissez aussi Collei ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240122
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240122,
					"content": "Collei n'est pas en bonne santé. Malgré cela, elle travaille dur pour protéger la forêt et éliminer la siccité. Tout le monde s'inquiète pour elle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240141
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240141,
					"content": "Ahem ! Quoi qu'il en soit, la responsabilité d'une brigadière forestière est de protéger la forêt, d'aider les voyageurs et de les guider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240142
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240142,
					"content": "#Comme vous l'avez vu, {NICKNAME} et Paimon, la forêt est... Comment dire, en mauvais état ces derniers temps. Les bêtes sauvages et les Fongus sont devenus particulièrement agressifs. Et la siccité...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240143
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240143,
					"content": "Pourquoi ne pas faire route commune ? Le Village de Vimara est sur mon itinéraire de patrouille. De là-bas, il vous sera facile de longer le fleuve jusqu'au Port Ormos ou à la Ville de Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240144,
						730240146
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240144,
					"content": "OK. Allons-y.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240145
					]
				},
				{
					"id": 730240145,
					"content": "Très bien, je m'assurerai de votre sécurité !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240146,
					"content": "OK, mais je dois m'occuper d'autres choses avant ça...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240147
					]
				},
				{
					"id": 730240147,
					"content": "#Je vois, je vous attends ici. Soyez {M#prudents}{F#prudentes} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240116,
					"content": "Paimon, tu n'as qu'à voler en étant très discrète.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240117
					]
				},
				{
					"id": 730240117,
					"content": "Hé ! Ça va mettre Tighnari en colère, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730240123,
					"content": "#Vous devez connaître Collei, non{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240124
					]
				},
				{
					"id": 730240124,
					"content": "#Ah ? {NICKNAME}, vous avez rencontré cette petite ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240125
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240125,
					"content": "Collei n'est pas en bonne santé. Malgré cela, elle travaille dur pour protéger la forêt et éliminer la siccité. Tout le monde s'inquiète pour elle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240126
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240126,
					"content": "Toutefois, elle est en compagnie d'un mentor aux jolies oreilles, donc tout devrait bien aller pour elle !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240127
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240127,
					"content": "Hein ? Ces oreilles... Est-ce que tu parles de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240128,
						730240138
					],
					"speakerTitle": "Paimon"
				},
				{
