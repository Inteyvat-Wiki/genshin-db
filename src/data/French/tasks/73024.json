					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240503,
						730240505
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240503,
					"content": "#Je m'appelle {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240504
					]
				},
				{
					"id": 730240504,
					"content": "Mon nom est Paimon ! On vient d'un autre pays.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730240507,
					"content": "#Je vois. Hmm... Vous n'êtes pas {M#habillés}{F#habillées} comme des {M#habitants}{F#habitantes} de la forêt, et vous n'avez pas non plus l'air de venir du désert. Par contre, vos vêtements sont aérés, ce qui est parfait pour voyager à Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240508
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240508,
					"content": "Ahem ! Quoi qu'il en soit, la responsabilité d'une brigadière forestière est de protéger la forêt, d'aider les voyageurs et de les guider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240509
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240509,
					"content": "#Comme vous l'avez vu, {NICKNAME} et Paimon, la forêt est... Comment dire, en mauvais état ces derniers temps. Les bêtes sauvages et les Fongus sont devenus particulièrement agressifs. Et la siccité...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240510
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240510,
					"content": "Pourquoi ne pas faire route commune ? Le Village de Vimara est sur mon itinéraire de patrouille. De là-bas, il vous sera facile de longer le fleuve jusqu'au Port Ormos ou à la Ville de Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240511,
						730240513
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240511,
					"content": "OK. Allons-y.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240512
					]
				},
				{
					"id": 730240512,
					"content": "Très bien, je m'assurerai de votre sécurité !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240513,
					"content": "OK, mais je dois m'occuper d'autres choses avant ça...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240514
					]
				},
				{
					"id": 730240514,
					"content": "#Je vois, je vous attends ici. Soyez {M#prudents}{F#prudentes} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240505,
					"content": "On vient d'un pays très lointain...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240506
					]
				},
				{
					"id": 730240506,
					"content": "#Oui ! Moi, c'est Paimon, et {M#lui}{F#elle}, c'est {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240507
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}