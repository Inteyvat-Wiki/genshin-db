					"nextDialogs": [
						191211503
					]
				},
				{
					"id": 191211503,
					"content": "Des gens ont parlé de lui derrière son dos ? Ce n'est pas possible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191211504
					],
					"speakerTitle": "Masanobu"
				},
				{
					"id": 191211504,
					"content": "Il fait un travail fantastique et reste toujours modeste à ce sujet. Pourquoi quelqu'un le critiquerait-il ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191211505
					],
					"speakerTitle": "Masanobu"
				},
				{
					"id": 191211505,
					"content": "Hein, je ne comprends pas. Essayez de demander à quelqu'un d'autre.",
