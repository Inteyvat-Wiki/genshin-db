			},
			"dialogs": [
				{
					"id": 191211401,
					"content": "... Vous me demandez ce que je pense que Thomas pourrait faire de mieux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191211402
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 191211402,
					"content": "Il est suffisamment occupé comme ça, vous ne trouvez pas ? Je le vois rarement ici à la Commission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191211403
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 191211403,
					"content": "Et quand il y est, le plus souvent, il est occupé avec des tâches ménagères.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191211404
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 191211404,
					"content": "Je pense qu'il devrait continuer à faire ce qu'il fait. Chacun a sa propre façon de vivre, et Thomas ne fait pas exception.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Takashi"
				}
			]
		},
