			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Corbeau sérieux",
					"Corbeau lugubre",
					"Mona",
					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400720201,
					"content": "Ne bougez pas. Qui va là ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720202
					],
					"speakerTitle": "Corbeau sérieux"
				},
				{
					"id": 400720202,
					"content": "Vous n'êtes pas des sujets de l'Empire de la nuit éternelle. Que faites-vous ici ? Dites-le-moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720203
					],
					"speakerTitle": "Corbeau lugubre"
				},
				{
					"id": 400720203,
					"content": "Il y a même des gardes ici !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400720204,
					"content": "Du calme, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400720205
					]
				},
				{
					"id": 400720205,
					"content": "Hein ? Qu'est-ce que tu fais ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400720206,
					"content": "Nous sommes les vassaux de Sa Prinzessin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400720207
					]
				},
				{
					"id": 400720207,
					"content": "#Je suis {M#celui}{F#celle} qui a traversé la mer des étoiles.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400720208
					]
				},
				{
					"id": 400720208,
					"content": "Comment pouvez-vous le prouver ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720209
					],
					"speakerTitle": "Corbeau sérieux"
				},
				{
					"id": 400720209,
					"content": "Hmph, ces questions effrontées ne font que démontrer votre manque de perspicacité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720210
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400720210,
					"content": "« Que mon peuple soit à jamais libre et au-dessus des anciennes lois. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720211
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400720211,
					"content": "C—C'est la devise de l'Empire de la nuit éternelle ! Ce sont vraiment les vassaux de Sa Prinzessin !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720212
					],
					"speakerTitle": "Corbeau lugubre"
				},
				{
					"id": 400720212,
					"content": "Je... Nous avons outrepassé notre autorité ! Veuillez nous pardonner...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720213
					],
					"speakerTitle": "Corbeau sérieux"
				},
				{
					"id": 400720213,
					"content": "Pourquoi restez-vous plantés là si vous savez que vous avez tort ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400720214,
					"content": "Nous nous retirons tout de suite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720215
					],
					"speakerTitle": "Corbeau sérieux"
				},
				{
					"id": 400720215,
					"content": "Ils sont partis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400720216,
					"content": "C'est le tome II de « L'hymne de la Terre sainte ». Vous êtes prêts ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720217
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400720217,
					"content": "C'est parti !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4007204,
			"completionStepIds": [
				4007204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
