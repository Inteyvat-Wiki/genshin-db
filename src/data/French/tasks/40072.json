						"rawParams": [
							"4007204",
							"2"
						],
						"stepId": 4007204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Narrateur",
					"Xinyan",
					"Kaedehara Kazuha",
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400720401,
					"content": "« Cependant, une brume sombre se dirigeait vers l'Empire de la nuit éternelle. Taslak, le dragon maléfique, pénétra dans les entrailles de la terre et traversa l'océan pour se diriger vers le sommet de la tour. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720402
					],
					"speakerTitle": "Narrateur"
				},
				{
					"id": 400720402,
					"content": "Hein ? Un dragon ? Je ne vois que le ciel qui se couvre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720403
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400720403,
					"content": "Un dragon... C'est peut-être une métaphore ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720404
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400720404,
					"content": "Vous pensez ? Tous ceux qui s'opposaient à Fischl et qui ont essayé de détruire sa petite fantaisie seraient considérés comme ses ennemis jurés et représentés par ce Taslak ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
		{
			"id": 4007210,
			"completionStepIds": [
				4007210
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
