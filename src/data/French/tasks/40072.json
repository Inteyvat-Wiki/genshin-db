			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Leon",
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400721001,
					"content": "Heureusement, il y a quelqu'un... Hein ? Encore vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721002
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400721002,
					"content": "C'est plutôt à nous de vous demander pourquoi vous êtes encore là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
		{
			"id": 4007213,
			"completionStepIds": [
				4007213
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007213",
							"2"
						],
						"stepId": 4007213,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kazuha",
					"Xinyan",
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400721301,
					"content": "On est revenus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400721302,
					"content": "Je crois que nous avons vu par inadvertance le vrai visage du dragon maléfique à l'instant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721303
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400721303,
					"content": "*soupir* Comme je comprends Fischl. Il y a toujours des gens qui pensent que notre passion est une perte de temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721304
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400721304,
					"content": "Hum ? Vous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721305
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400721305,
					"content": "Je suis Arnold « Je connais le chemin ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721306
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400721306,
					"content": "Je le sais, mais pourquoi êtes-vous revenu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721307
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400721307,
					"content": "Oh, je pensais que vous seriez en route pour trouver le tome III de « L'hymne de la Terre sainte ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721308
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400721308,
					"content": "Vous avez vu juste...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721309
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400721309,
					"content": "Ma chère demoiselle, nul besoin de faire quoi que ce soit pour moi. Admirer votre beauté est le plus beau des cadeaux que vous puissiez me faire. Je suis là pour vous donner toutes les réponses à vos questions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721310
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400721310,
					"content": "Le troisième tome de l'œuvre sacrée est situé au dernier étage de la cité impériale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721311
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400721311,
					"content": "Y a-t-il des gardes en place ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721312
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400721312,
					"content": "Oh, mais évidemment. Votre question est d'une bêtise, mon cher monsieur. Aucun pays ne laisserait son livre le plus précieux sans protection.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721313
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400721313,
					"content": "Cela veut dire qu'il y aura encore des gardes des corbeaux là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721314
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400721314,
					"content": "Garder l'œuvre sacré est le plus grand honneur d'un sujet. Mais ce n'est pas grave, j'ai cru comprendre que cette gente dame souhaitait seulement la lire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721315
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400721315,
					"content": "Votre visage est si charmant et reflète votre sagacité. Vos compagnons sont semblables à des héros, je suis sûr qu'ils seront capables de lire les histoires de nos textes sacrés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721316
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400721316,
					"content": "Les actes de Son Altesse ont été relayés par le seigneur Oz, grand scribe de la cour. Son récit est devenu un trésor de l'Empire de la nuit éternelle. Chaque fois que je le lis, je souhaite le bonheur de Son Altesse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arnold"
				}
			]
		},
		{
			"id": 4007218,
			"completionStepIds": [
				4007218
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007218",
							"2"
						],
						"stepId": 4007218,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Leon",
					"Kaedehara Kazuha",
					"Xinyan",
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400721801,
					"content": "Je suis désolé de me montrer à vous dans cet état. Je suis trop faible actuellement pour jouer le rôle d'un chevalier des corbeaux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721802
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400721802,
					"content": "Jouer le rôle ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721803
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400721803,
					"content": "C'est embarrassant de l'admettre, mais je ne suis pas un vrai chevalier. En réalité, je suis un comédien qui vient de trouver un nouvel emploi et qui se prépare à jouer le rôle d'un chevalier au sein d'une troupe de théâtre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721804
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400721804,
					"content": "Il n'y a pas de quoi être fier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400721805,
					"content": "Vous ne le savez sans doute pas, mais le théâtre est un élément important de la culture de l'Empire de la nuit éternelle. Une bonne performance est la meilleure chose que l'on puisse offrir à Sa Prinzessin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721806
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400721806,
					"content": "Oh, ça fait donc partie de votre culture locale ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721807
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400721807,
					"content": "Exactement ! Je suis donc très heureux d'avoir été choisi pour jouer ce rôle de chevalier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721808
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400721808,
					"content": "Pourquoi Votre Prinzessin aime-t-elle tant le théâtre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721809
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400721809,
					"content": "Sa Prinzessin a dit : « Consacrez-moi une célébration : jouez une pièce de théâtre dans la nature sauvage. Prosternez-vous devant moi et offrez-moi des rêves purs à la gloire de la nuit éternelle. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721810
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400721810,
					"content": "Je pense que ce doit être parce que Sa Prinzessin sait ce qu'est l'art véritable. Elle peut donc discerner les joies et les peines les plus profondes de la nature humaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721811
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400721811,
					"content": "L'âme du théâtre réside dans la convergence et la sublimation des émotions. Les personnes qui comprennent la comédie ont un cœur sensible et rempli de beaux sentiments.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721812
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400721812,
					"content": "... Je vois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721813
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400721813,
					"content": "Merci pour votre réponse, cher chevalier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721814
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400721814,
					"content": "Oh ! Vous êtes enclin à me considérer comme tel, merci beaucoup !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721815
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400721815,
					"content": "Eh bien, en emportant cette gloire avec moi, je m'en vais vers le champ de bataille. Au revoir, mes amis ! Nos chemins se croiseront à nouveau si le destin le veut !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721816
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400721816,
					"content": "Je n'ai pas envie de vous revoir, mais soyez quand même prudent la prochaine fois !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400721817,
					"content": "Ah oui, retenez bien le mot de passe pour ouvrir la porte : « À mon commandement, prenez votre envol ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leon"
				}
			]
		}
	]
}