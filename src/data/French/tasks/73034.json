			},
			"dialogs": [
				{
					"id": 730340201,
					"content": "Oh ? Qu'est-ce que tu regardes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340202,
					"content": "Ce carnet explique comment s'occuper des fleurs.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730340203
					]
				},
				{
					"id": 730340203,
					"content": "Vraiment ? Montre-moi ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340204,
					"content": "#« Elles doivent être plantées dans une zone vaste avec un bon ensoleillement...{NON_BREAK_SPACE}»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340205,
					"content": "Collei n'a pas dû avoir le temps de la déplacer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340206,
					"content": "Héhé, prenons-en soin pour elle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340207,
					"content": "Euh... Bon, sortons-la d'abord et mettons-la à côté de la maison.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340208,
					"content": "Mais pas trop loin, sinon Collei ne la retrouvera pas à son retour et risque de s'inquiéter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7303406,
			"completionStepIds": [
				7303406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
