				]
			},
			"dialogs": [
				{
					"id": 760780401,
					"content": "Normalement, une fois les monstres des environs éliminés, les failles devraient disparaître d'elles-mêmes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780402
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780402,
					"content": "Alors pourquoi la Chasse sauvage est-elle encore là ? C'est vraiment étrange.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780403
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780403,
					"content": "Aurais-je négligé quelque chose ? Quelque chose d'autre qui aurait été corrompu par la Chasse sauvage ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
		},
		{
			"id": 7607805,
