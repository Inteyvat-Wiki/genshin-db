				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2423.771,
							211.958,
							9661.866
						],
						"pointId": 13639
					}
				]
			},
			"dialogs": [
				{
					"id": 760780201,
					"content": "Oh, c'est une lanterne. Tous les Gardiens de lumière en ont une, c'est un outil important pour disperser la Chasse sauvage...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780202
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780202,
					"content": "La lanterne est encore là. Sur sa housse, l'odeur de la Chasse sauvage reste, mais son porteur a disparu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780203
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780203,
					"content": "Je vois. C'est déconcertant, mais il n'est pas difficile de savoir ce qui s'est passé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780204
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780204,
					"content": "Les sacrifices des Gardiens de lumière sont parfois aussi silencieux qu'un murmure. C'est toujours regrettable d'apprendre la disparition d'un collègue de cette façon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780205
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780205,
					"content": "... Permets-moi de m'occuper la lanterne que tu as laissée, ô anonyme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780206
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780206,
					"content": "Son corps sera purifié et sa lumière rallumée. Elle trouvera une nouvelle place auprès d'un autre Gardien de lumière qui a juré de protéger Nod-Krai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780207
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780207,
					"content": "Flins nettoie soigneusement la lanterne et la range.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760780208
					]
				},
				{
					"id": 760780208,
					"content": "Cette lanterne est sans doute la raison pour laquelle la Chasse sauvage n'avait pas complètement disparu. Je vais garder cette lanterne, jusqu'à ce qu'un collègue du quartier général vienne la chercher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780209
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780209,
					"content": "... Oh, il y a quelque chose en dessous de la lanterne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780210
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780210,
					"content": "C'est sûrement une relique laissée par le même collègue. Je devrais peut-être la garder avec la lanterne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				}
			]
		},
		{
