					}
				]
			},
			"dialogs": [
				{
					"id": 760780501,
					"content": "Il y a aussi une lanterne du serment ici. Elle devait appartenir à quelqu'un qui est venu avant nous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780502
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780502,
					"content": "La lanterne est encore souillée par la corruption de la Chasse sauvage. Ce n'est pas difficile d'imaginer ce qui s'est passé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780503
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780503,
					"content": "Dès le jour où nous prenons la lanterne du serment, nos vies sont liées à la flamme qui brûle en son sein, jusqu'au moment où notre mission légitime est accomplie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780504
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780504,
					"content": "Vous qui vous êtes battu jusqu'à votre dernier souffle pour la paix et la sécurité de Nod-Krai, je vous témoigne mon plus profond respect.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780505
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780505,
					"content": "Je vais prendre votre lanterne pour l'instant. Soyez rassuré, la couronne des héros tombés au combat préservera votre héritage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780506
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780506,
					"content": "Je vais la ramener au quartier général, raviver sa flamme et la confier à quelqu'un qui mérite de perpétuer votre volonté.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780507
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780507,
					"content": "Illuga nettoie la lanterne, puis la range soigneusement.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760780508
					]
				},
				{
					"id": 760780508,
					"content": "La Chasse sauvage a été éliminée de cet endroit, et l'esprit de notre prédécesseur a enfin trouvé le repos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
		}
	]
