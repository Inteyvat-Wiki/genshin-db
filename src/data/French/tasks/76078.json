			"dialogs": [
				{
					"id": 760780301,
					"content": "(Les monstres se sont dispersés, mais les ténèbres demeurent. Vous aurez peut-être besoin de l'aide d'un professionnel qui connaît bien la Chasse sauvage).",
					"roleType": "TALK_ROLE_NPC",
