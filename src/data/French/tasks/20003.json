			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Goth"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200030101,
					"content": "*soupir* Je suppose que je vais devoir régler ça moi-même...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030102
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030102,
					"content": "Mes vieux os vont tomber en morceaux à ce rythme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030103
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030103,
					"content": "Vous avez quelque chose d'urgent à faire ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030104
					]
				},
				{
					"id": 200030104,
					"content": "#{M#Voyageur}{F#Voyageuse} ? Oh... Je ne dirais pas que c'est quelque chose d'urgent, mais je suis débordé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030105
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030105,
					"content": "Comme vous le savez, les Fatui ont réservé tout mon hôtel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030106
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030106,
					"content": "Et en tant que propriétaire du Grand Hôtel Goth, c'est naturellement moi qui dois m'occuper d'eux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030107
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030107,
					"content": "Je dois coordonner le traiteur, les réparations et terminer d'autres tâches en tout genre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030108
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030108,
					"content": "Dernièrement, les meubles de certaines pièces ont été endommagés. J'ai dû contacter des fournisseurs pour qu'ils livrent du bois approprié aux menuisiers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030109
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030109,
					"content": "En plus de cela, je dois aussi collecter le loyer de plusieurs maisons en ville... Et Marvin est toujours introuvable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030110
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030110,
					"content": "*soupir* Je me demande combien d'années mes vieux os vont encore pouvoir supporter cela. Quand est-ce que Marvin deviendra enfin responsable ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030111,
						200030112
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030111,
					"content": "Je vais vous aider.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030113
					]
				},
				{
					"id": 200030113,
					"content": "Vous voulez m'aider ? Je ne voudrais pas vous déranger... Si seulement Marvin avait comme vous le sens des responsabilités, je ne serais pas aussi fatigué...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030114
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030114,
					"content": "Dans ce cas, pourriez-vous m'aider à trouver du bois d'épicéa et de bouleau ? Je dois en fournir au menuisier le plus vite possible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030112,
					"content": "Reposez-vous d'abord un peu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030113
					]
				}
			]
		},
