				"objectNames": [
					"Goth"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200030301,
					"content": "Merci. Ça devrait être suffisant. Je vais l'apporter au menuisier. Ah, et il faut aussi que j'aille collecter le loyer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030302
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030302,
					"content": "*soupir* Mais est-ce que la locataire sera chez elle ? L'Astro... Astro... Mona quelque chose... Je ne me rappelle plus son nom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030303
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030303,
					"content": "L'astromancienne Mona Megistus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030304
					]
				},
				{
					"id": 200030304,
					"content": "Oui voilà ! Ah... Ce n'est pas un nom facile à mémoriser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030305
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030305,
					"content": "Tiens ? Mona n'a pas payé son loyer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200030306,
					"content": "Et comment ! Tous mes autres locataires ont payé, il ne reste plus qu'elle !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030307
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030307,
					"content": "J'y suis allé à plusieurs reprises, mais elle n'était jamais à la maison.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030308
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030308,
					"content": "#{M#Voyageur}{F#Voyageuse}, est-ce que vous pouvez aller la voir pour moi et lui demander de payer son loyer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Goth"
				}
			]
		},
