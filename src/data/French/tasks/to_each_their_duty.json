			"trigger": {
				"objectNames": [
					"Hoffman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411220101,
					"content": "*soupir* On dirait bien qu'il n'y a pas d'autre moyen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220102
					],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 411220102,
					"content": "Qu'est-ce qu'il se passe ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220103
					]
				},
				{
					"id": 411220103,
					"content": "Ah, c'est vous. Eh bien... Vous êtes au courant pour la pluie de météorites j'imagine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220104
					],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 411220104,
					"content": "On a eu de la chance, aucune météorite n'a touché la ville. Ce n'est pas le cas à l'extérieur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220105
					],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 411220105,
					"content": "Pas mal de gens sont venus se réfugier en ville, et avec tous ceux qui sont endormis, on ne sait plus où donner de la tête.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220106
					],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 411220106,
					"content": "Je pensais rappeler les chevaliers de l'Ordre envoyés à l'extérieur de la cité. Il faut d'abord reprendre la situation en main ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220107
					],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 411220107,
					"content": "Mais ils sont partis à plusieurs endroits différents, et personne n'est disponible pour aller les chercher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220108
					],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 411220108,
					"content": "Vous accepteriez d'aller leur montrer cet ordre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220109
					],
					"speakerTitle": "Hoffman"
				}
			]
		},
		{
			"id": 4112202,
			"completionStepIds": [
				4112202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
