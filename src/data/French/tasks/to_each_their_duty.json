			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411220201,
					"content": "Bonjour, je peux vous aider ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220202
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220202,
					"content": "J'ai ici un ordre...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220203
					]
				},
				{
					"id": 411220203,
					"content": "Un ordre ? En effet, voyons voir... On rappelle les effectifs pour aider en ville...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220204
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220204,
					"content": "*soupir* Ça ne me pose pas de problème de rentrer en ville, mais regardez ces deux enfants. Ils refusent de partir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220205
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220205,
					"content": "J'ignore où sont leurs familles, et je ne peux pas les forcer à me suivre. Je ne peux que rester ici en attendant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220206
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220206,
					"content": "Si je rentre, qui sait ce qui leur arrivera...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220207
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220207,
					"content": "J'ai bien essayé de les convaincre à plusieurs reprises. Ils ne veulent pas entendre un mot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220208
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220208,
					"content": "À moins que... Vous iriez leur parler ? Peut-être qu'ils vous écouteront.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220209
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220209,
					"content": "Si vous arrivez à les convaincre de partir et de rentrer bien sagement, alors je pourrai partir l'esprit tranquille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220210
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220210,
					"content": "Je vais essayer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220211
					]
				},
				{
					"id": 411220211,
					"content": "Merci beaucoup !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mack"
				}
			]
		},
		{
