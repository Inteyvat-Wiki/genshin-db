			"dialogs": [
				{
					"id": 411220601,
					"content": "Bonjour. Vous avez besoin d'aide ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220602
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220602,
					"content": "J'ai ici un ordre...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220603
					]
				},
				{
					"id": 411220603,
					"content": "Un ordre ? Laissez-moi voir... Hum, on nous demande de rentrer en ville ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220604
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220604,
					"content": "Désolé, mais il faudra attendre un moment pour que je puisse suivre cet ordre. J'ai une tâche plus importante à terminer d'abord.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220605
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220605,
					"content": "Les monstres du coin sont devenus particulièrement agressifs, sans doute à cause de ces météorites.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220606
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220606,
					"content": "Il faut que je m'en occupe, la zone n'est pas sûre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220607
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220607,
					"content": "Je ne vois personne...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220608
					]
				},
				{
					"id": 411220608,
					"content": "C'est justement parce qu'il n'y a personne dans les environs que j'ai décidé de profiter de l'occasion et de nettoyer la zone des monstres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220609
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220609,
					"content": "C'est une tâche importante, et je ne peux pas partir tant que je n'ai pas fini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220610,
						411220611
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220610,
					"content": "Laissez-moi vous aider.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220612
					]
				},
				{
					"id": 411220612,
					"content": "Bonne idée. Les monstres se sont justement réunis à plus d'un endroit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220613
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220613,
					"content": "Partageons-nous le travail. Vous allez de votre côté et moi du mien, et on se retrouve quand on en a fini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220611,
					"content": "Je m'en occupe avec vous.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220612
					]
				}
			]
		},
