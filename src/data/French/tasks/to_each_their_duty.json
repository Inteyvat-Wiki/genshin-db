			},
			"dialogs": [
				{
					"id": 411220501,
					"content": "Alors, vous avez réussi à les convaincre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220502
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220502,
					"content": "D'une certaine manière, oui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220503
					]
				},
				{
					"id": 411220503,
					"content": "Excellente nouvelle ! Tant qu'ils sont d'accord... Une minute, comment ça, « d'une certaine manière » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220504
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220504,
					"content": "On va avoir besoin de votre aide.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220505
					]
				},
				{
					"id": 411220505,
					"content": "Mon aide ? Comment ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220506
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220506,
					"content": "Les amener à l'endroit le plus haut de Mondstadt ? C'est un peu dangereux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220507
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220507,
					"content": "Et il s'agit d'enfants, qui plus est. Mieux vaut que j'en discute avec l'Ordre d'abord...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220508
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220508,
					"content": "Je vous rappelle que j'ai un ordre avec moi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220509
					]
				},
				{
					"id": 411220509,
					"content": "Cet ordre n'a rien à voir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220510
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220510,
					"content": "Enfin, tant que ces deux-là rentrent se mettre en sécurité en ville... Je trouverai bien un moyen pour les faire grimper quelque part.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220511
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220511,
					"content": "Vous allez vraiment les accompagner, hein...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220512
					]
				},
				{
					"id": 411220512,
					"content": "Bien sûr. Je suis un chevalier... et un adulte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220513
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220513,
					"content": "Une promesse est une promesse, et on ne revient pas sur la parole donnée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220514
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220514,
					"content": "#Merci pour votre aide, {M#voyageur}{F#voyageuse}. Je m'occupe de les ramener à Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220515
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220515,
					"content": "Et je trouverai bien un moyen de leur trouver l'endroit qu'il faut...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mack"
				}
			]
		},
