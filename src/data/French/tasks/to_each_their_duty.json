					"nextDialogs": [
						411220804
					]
				},
				{
					"id": 411220804,
					"content": "Haha, vous savez vous débrouiller, à ce que je vois. Merci pour votre aide. Le coin sera plus sûr pour un moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220805
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220805,
					"content": "Mais je crains de devoir rester encore un peu ici. D'autres monstres se sont sûrement répandus à travers les Montagnes du guet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220806
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220806,
					"content": "Je compte rester ici, et voir si je peux collecter des informations. Ça me permettra aussi d'être là si jamais quelqu'un venait à se mettre en danger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220807
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220807,
					"content": "Il reste encore des gens qui n'ont pas compris qu'il valait mieux rentrer en ville...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220808
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220808,
					"content": "Expliquez ceci quand vous rentrerez. Je suis sûr qu'Hoffman comprendra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Harry"
