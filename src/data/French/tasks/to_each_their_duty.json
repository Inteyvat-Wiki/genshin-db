			"dialogs": [
				{
					"id": 411220401,
					"content": "Bonjour, qu'est-ce que vous voulez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220402
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220402,
					"content": "Tu sais ce qui se passe ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220403
					]
				},
				{
					"id": 411220403,
					"content": "Je sais, mais on veut juste voir les météorites. On rentrera quand on en aura vu, promis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220404
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220404,
					"content": "Vous pouvez aussi les voir à l'intérieur de la cité.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220405
					]
				},
				{
					"id": 411220405,
					"content": "Il faudrait aller super haut pour ça ! J'ai déjà essayé, et à chaque fois les gardes m'ont attrapé et m'ont grondé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220406
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220406,
					"content": "C'est pour ça que j'ai amené Jill ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220407
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220407,
					"content": "Le monsieur qui est là voudra bien vous aider.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220408
					]
				},
				{
					"id": 411220408,
					"content": "Ah bon ? Vous voulez dire qu'il nous trouvera un endroit d'où on peut voir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220409
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220409,
					"content": "Non, ça se peut pas... Le monsieur est bizarre, toujours sévère...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220410
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220410,
					"content": "Mais j'ai un ordre exprès.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220411
					]
				},
				{
					"id": 411220411,
					"content": "Ah bon ?! Je peux voir ? Waouh... C'est vraiment un papier des chevaliers de l'Ordre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220412
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220412,
					"content": "C'est à cause de cet ordre que le monsieur va nous accompagner voir les météorites ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220413
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220413,
					"content": "Héhé, super, c'est encore mieux d'être en ville.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220414
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220414,
					"content": "Bon, vous pouvez aller lui dire que c'est d'accord. Moi, je vais parler avec Jill.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220415
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220415,
					"content": "Rien que d'y penser... Je suis trop impatient.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Will"
				}
			]
		},
