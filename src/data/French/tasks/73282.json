			"trigger": {
				"objectNames": [
					"Masseira"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732820101,
					"content": "Ah, vous voilà ! Ne partez pas, j'ai bien peur que ce soit la dernière fois que je vous demande un service.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820102,
						732820104
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732820102,
					"content": "Alors dites-moi comment je peux vous aider.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820103
					]
				},
				{
					"id": 732820103,
					"content": "C'est Tadhla. Elle veut parler avec vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820106
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732820106,
					"content": "Hein ? Qu'est-ce qu'il y a ? Vous êtes bien sérieux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732820107,
					"content": "#Les ruines au nord, là ou vous vous êtes {M#rencontrés}{F#rencontrées} la première fois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820108,
						732820110
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732820108,
					"content": "Qu'est-ce que vous dites ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820109
					]
				},
				{
					"id": 732820109,
					"content": "#Les ruines au nord, là ou vous vous êtes {M#rencontrés}{F#rencontrées} la première fois... Retenez bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732820110,
					"content": "Bien compris.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820111
					]
				},
				{
					"id": 732820111,
					"content": "Bien. S'il vous plaît, prenez bien soin d'elle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732820104,
					"content": "#Je suis {M#occupé}{F#occupée} par autre chose...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820105
					]
				},
				{
					"id": 732820105,
					"content": "Écoutez-moi, je vous en prie... Tadhla veut vous parler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820106
					],
					"speakerTitle": "Masseira"
				}
			]
		},
