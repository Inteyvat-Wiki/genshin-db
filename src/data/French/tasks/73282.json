				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Liloupar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732820601,
					"content": "Grr... Masseira a disparu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732820602,
					"content": "Il a laissé cette note... Hmph, il est rusé comme un vieux renard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820603
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732820603,
					"content": "#Si vous lisez ceci, cela signifie que je suis me suis déjà réfugié dans un abri au fond de la vallée.\\nSi votre tête est toujours sur vos épaules, ne soyez pas {M#attristé}{F#attristée} par le choix de Tadhla.\\n\\nCette chasse n'est pas terminée. Ce n'est que le début de la tempête.\\nMoi, Masseira, chasseur et aîné de la tribu des Tanit, vous donne cet avertissement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820604
					],
					"speakerTitle": "Examiner"
				},
				{
					"id": 732820604,
					"content": "Hein ? Je ne comprends pas ce qu'il a voulu dire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732820605,
					"content": "Il semble qu'il ait fait face à une sorte de pression et qu'il ait fui la tribu après vous avoir laissé ce message. Hmph, la tribu des Tanit n'est pas aussi paisible qu'elle en a l'air.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Liloupar"
				}
			]
		},
		{
			"id": 7328228,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7328207",
							"2"
						],
						"stepId": 7328207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tadhla"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732822801,
					"content": "(Tadhla est mal à l'aise. Elle évite votre regard, puis baisse la tête nerveusement.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822802,
						732822805
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822802,
					"content": "Ça va ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822803
					]
				},
				{
					"id": 732822803,
					"content": "Désolée, mais la chasse est terminée. Et moi, je suis le faucon de mon père.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822804
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822804,
					"content": "Mais... Je vais bien, ne vous en faites pas pour moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822808,
						732822810
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822808,
					"content": "C'est un peu extrême...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822809
					]
				},
				{
					"id": 732822809,
					"content": "Extrême ? Je ne sais pas. Je vis comme ça depuis que je suis enfant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822814
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822814,
					"content": "Par contre... Votre histoire, à Paimon et vous, votre voyage...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822815
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822815,
					"content": "Si l'occasion se présente, j'aimerais vous en entendre parler davantage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822816
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822816,
					"content": "D'accord, on a plein plein d'histoires à raconter !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822817,
						732822818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732822817,
					"content": "Je te raconterai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822819
					]
				},
				{
					"id": 732822819,
					"content": "Pffft...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822820
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822820,
					"content": "Ahem, désolée. C'est juste que je suis heureuse... Merci à toi... Euh, je veux dire, je vous remercie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822818,
					"content": "Si ça t'intéresse, je peux t'en parler quand tu veux.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822819
					]
				},
				{
					"id": 732822810,
					"content": "Tu n'as jamais pensé à vivre pour toi-même ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822811
					]
				},
				{
					"id": 732822811,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822812
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822812,
					"content": "... Non, jamais. Je n'y ai jamais pensé, et je n'en ai jamais ressenti l'envie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822813
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822813,
					"content": "Le désert est un endroit froid et cruel, je n'ai pas le temps de penser à moi-même. Si je ne suis plus là, beaucoup de gens pourront continuer à vivre, mais si c'est la tribu qui n'est plus là... Je ne pourrai jamais survivre toute seule.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822814
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822805,
					"content": "Parle-moi de ta relation avec Masseira...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822806
					]
				},
				{
					"id": 732822806,
					"content": "Comme je l'ai dit, Masseira est mon père, et je suis son faucon. Je suis ses ordres, chasse et risque ma vie pour lui... Car il représente la volonté des Tanit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822807
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822807,
					"content": "Le jour où je ne pourrai plus exécuter pleinement les ordres de mon père, ma vie de faucon prendra fin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822808,
						732822810
					],
					"speakerTitle": "Tadhla"
				}
			]
		},
		{
			"id": 7328229,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7328207",
							"2"
						],
						"stepId": 7328207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Masseira"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732822901,
					"content": "#Ah, c'est vous, très {M#estimé maître}{F#estimée maîtresse} des djinns. Que puis-je faire pour vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822902,
						732822906
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732822902,
					"content": "Parlons de Tadhla...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822903
					]
				},
				{
					"id": 732822903,
					"content": "Elle vous apprécie beaucoup, je peux le voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822904
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732822904,
					"content": "Ne vous inquiétez pas, je ne vais pas m'en mêler. C'est ça, d'être jeune, après tout...",
