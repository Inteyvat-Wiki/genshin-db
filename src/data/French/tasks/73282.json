		{
			"id": 7328204,
			"completionStepIds": [
				7328204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7328204",
							"2"
						],
						"stepId": 7328204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tadhla"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732820401,
					"content": "Je savais que vous viendriez. Je suis heureuse de vous voir ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820402,
						732820403
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732820402,
					"content": "On m'a dit que tu me cherchais ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820404
					]
				},
				{
					"id": 732820404,
					"content": "J'ai toujours aimé le désert à ce moment de la journée, il est magnifique. C'est ce que je préfère.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820405
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732820405,
					"content": "Cependant, je regrette de ne jamais avoir eu la chance d'observer le soleil ici avec des amis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820406
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732820406,
					"content": "C'est vrai, tout le désert est recouvert d'une couche de rouge... C'est à la fois beau et paisible...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732820407,
					"content": "Enfin bon, Tadhla, c'est pour ça que tu nous as fait venir ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732820408,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820409
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732820409,
					"content": "Vous êtes l'hôte des Tanit, et pour les faucons, vous êtes une proie potentielle... Mais moi, j'espère que c'est vous qui survivrez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820410
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732820410,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820411
					]
				},
				{
					"id": 732820411,
					"content": "Et donc... Je suis désolée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732820403,
					"content": "Comment ça va, ces temps-ci ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820404
					]
				}
			]
		},
		{
			"id": 7328206,
			"completionStepIds": [
				7328206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
