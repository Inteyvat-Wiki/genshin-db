				"points": []
			},
			"dialogs": [
				{
					"id": 4620401,
					"content": "Laisse-moi voir ! Qu'est-ce qu'il y a dedans ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620402,
					"content": "« Elle ne l'aime point. La passion qui jaillit dans l'eau claire de la source n'est qu'artifice. Et aux heures froides et solitaires apparaît la vérité en son cœur. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620407,
					"content": "Il y a une carte qui va avec.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620403,
					"content": "Encore une énigme ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620404,
					"content": "J'en ai déjà la tête qui tourne. Je crois que j'ai trop réfléchi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620405,
					"content": "Tu n'as rien fait du tout...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620406
					]
				},
				{
					"id": 4620406,
					"content": "Je te laisse t'amuser avec ça. Rappelle-toi que Kaeya peut t'aider en cas de difficulté.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
