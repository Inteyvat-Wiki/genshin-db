			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Val"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4620301,
					"content": "Pourquoi ça n'arrive qu'à moi ce genre de choses ? Je n'aurais pas dû <color=#00E1FFFF>l'aider</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620302
					],
					"speakerTitle": "Val"
				},
				{
					"id": 4620302,
					"content": "Qui ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620303,
					"content": "Merci infiniment ! Vous êtes bien plus efficaces que les gens de l'Ordre de Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620304
					],
					"speakerTitle": "Val"
				},
				{
					"id": 4620304,
					"content": "#Ce n'était rien du tout ! {NICKNAME} a l'habitude de zigouiller des monstres pendant ses voyages.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620305,
					"content": "#Vous êtes {M#le voyageur}{F#la voyageuse} ? C'est amusant, je ne pensais pas me faire sauver par <color=#00E1FFFF>la personne que je suis censée rencontrer</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620306
					],
					"speakerTitle": "Val"
				},
				{
					"id": 4620306,
					"content": "Ah, vous êtes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620307,
					"content": "Pour la peine, je vais vous donner ces renseignements gratuitement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620308
					],
					"speakerTitle": "Val"
				},
				{
					"id": 4620308,
					"content": "Construire son réseau est très important dans notre milieu après tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620309,
						4620311
					],
					"speakerTitle": "Val"
				},
				{
					"id": 4620309,
					"content": "Pour de vrai ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620310
					]
				},
				{
					"id": 4620310,
					"content": "Bien sûr, sans vous je ne serais plus de ce monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620312
					],
					"speakerTitle": "Val"
				},
				{
					"id": 4620312,
					"content": "On en a de la chance !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620313,
					"content": "Enfin, c'est plutôt Kaeya qui en a... Il était censé payer pour les infos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620314,
					"content": "Ouvrez grand vos oreilles, je vous rapporte donc ce que je sais sur les Ruines de l'Arcadia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620315
					],
					"speakerTitle": "Val"
				},
				{
					"id": 4620315,
					"content": "« Trois géants à six bras trônent à la cité près du lac. Deux protègent la statue et un garde le trésor. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620316
					],
					"speakerTitle": "Val"
				},
				{
					"id": 4620316,
					"content": "Euh, c'est tout ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620325,
					"content": "Il y a aussi cette carte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620317
					],
					"speakerTitle": "Val"
				},
				{
					"id": 4620317,
					"content": "C'est là que le trésor se situe ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620318,
					"content": "Notre piste est donc une énigme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620319,
					"content": "#Ça devrait être du gâteau pour toi, {NICKNAME} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620320,
						4620321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620320,
					"content": "Je n'aurais pas mieux dit !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620322
					]
				},
				{
					"id": 4620322,
					"content": "Si tu as du mal à résoudre cette énigme, on peut toujours demander de l'aide à Kaeya. Il a de la cervelle, à mon avis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620326,
					"content": "Je vous laisse toutes les informations. Vous pourrez y jeter un coup d'œil quand bon vous semblera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620327
					],
					"speakerTitle": "Val"
				},
				{
					"id": 4620327,
					"content": "Merci beaucoup, Val !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620323,
					"content": "« Trois géants à six bras trônent à la cité près du lac. Deux protègent la statue et un garde le trésor. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620324,
					"content": "Ça veut dire quoi ? Tu devrais réfléchir si tu ne veux pas solliciter Kaeya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620321,
					"content": "J'espère...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620322
					]
				},
				{
					"id": 4620311,
					"content": "Merci beaucoup.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620312
					]
				}
			]
		},
