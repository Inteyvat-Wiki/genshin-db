			},
			"dialogs": [
				{
					"id": 4620501,
					"content": "#{NICKNAME} ! Vous voilà de retour, et avec les renseignements.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620502
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620502,
					"content": "Oui, et non. La situation est un peu compliquée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620503,
					"content": "On nous a dit : « Trois géants à six bras trônent à la cité près du lac. Deux protègent la statue et un garde le trésor. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620504,
					"content": "Une énigme ? Pas vraiment original. Laissez-moi réfléchir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620505
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620505,
					"content": "La « cité près du lac » fait clairement référence à Mondstadt. Hum... En ce qui concerne les géants à six bras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620506
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620506,
					"content": "Des crabes ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620507
					]
				},
				{
					"id": 4620507,
					"content": "Des crabes géants !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620508,
					"content": "Sans parler d'où de tels crabes pourraient vivre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620509
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620509,
					"content": "Les crabes ont huit pattes, pas six.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620516
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620516,
					"content": "Des moulins à vent peut-être ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620517
					]
				},
				{
					"id": 4620517,
					"content": "Je crois que ça parle de moulins à vent, non ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620518
					]
				},
				{
					"id": 4620518,
					"content": "Pas mal !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620519
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620519,
					"content": "Un moulin à vent a six ailes... Ça colle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620510
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620510,
					"content": "Ouais !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620511,
					"content": "Donc, sur les trois moulins à vent, deux sont près de la statue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620512
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620512,
					"content": "Le dernier garde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620513
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620513,
					"content": "Le trésor !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620514
					],
