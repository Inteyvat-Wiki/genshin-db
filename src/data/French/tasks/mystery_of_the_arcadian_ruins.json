				"objectNames": [
					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4620701,
					"content": "« Elle ne l'aime point. La passion qui jaillit dans l'eau claire de la source n'est qu'artifice. Et aux heures froides et solitaires apparaît la vérité en son cœur. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620702
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620702,
					"content": "Une idée sur la signification ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620703,
					"content": "C'est un passage que vous avez arraché d'un roman à l'eau de rose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620704
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620704,
					"content": "En même temps, c'était bizarre qu'une personne aussi intelligente que moi n'ait pas pu trouver la réponse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620705,
					"content": "Hahaha, mais non ! Je plaisantais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620706
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620706,
					"content": "Hmph, un peu de sérieux s'il vous plaît, Kaeya !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620707,
					"content": "Cette énigme est difficile à décoder. Hmm, de l'eau claire ? ... Peut-être que ça pourrait désigner Deauclaire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620708
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620717,
					"content": "Quand les gens se baignent tout nus dedans ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4620724,
					"content": "Quand le niveau d'eau change ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4620708,
					"content": "« La passion qui jaillit dans l'eau claire de la source »... Quand est-ce qu'on trouve de la passion dans une source ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620709
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620718,
					"content": "Ici, plus personne ne fait ça de nos jours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620719,
					"content": "Ça ne serait quand même pas un de tes loisirs ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620720,
					"content": "Mes excuses. Ce que tu fais de ton temps libre ne regarde que toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620721,
					"content": "Hé ! Pour qui vous nous prenez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620723,
					"content": "Hmm, et si ça désignait le changement du niveau d'eau ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4620722,
					"content": "Haha. Après, si la « passion » en question ne « jaillit » pas de la source, alors elle vient des personnes qui s'y baignent, j'imagine ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620725,
					"content": "C'est une bonne idée, comme lorsqu'il y a une cascade, par exemple...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620726,
					"content": "La solution à cette énigme se cache donc près de la cascade sur la montagne derrière Deauclaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620727,
					"content": "Il n'y a que cet endroit qui me vient à l'esprit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620709,
					"content": "Hum, la partie sur la cascade... Ça doit faire référence à la falaise à la gauche de la chute d'eau. Je l'avais déjà remarquée en patrouillant par le passé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620710
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620710,
					"content": "Enfin, les « heures froides et solitaires » doit sans doute faire référence à l'élément Cryo qui peut être manipulé par le détenteur d'un œil divin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620711
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620712,
					"content": "Merci pour votre aide, Kaeya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620713
					]
				},
				{
					"id": 4620711,
					"content": "Tu devrais certainement <color=#00E1FFFF>emmener quelqu'un qui maîtrise l'élément Cryo</color> avec toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620712
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620713,
					"content": "Je t'en prie. Si les chevaliers ne pouvaient pas résoudre une simple énigme, comment pourraient-ils résoudre des crimes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620714
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620714,
					"content": "On vous laisse avec vos crimes. Nous, on se rend à Deauclaire tout de suite !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620715,
					"content": "... Comment ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620716
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620716,
					"content": "Ahem, je veux dire qu'on vous laisse les résoudre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
