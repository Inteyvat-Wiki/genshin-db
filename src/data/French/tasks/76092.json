			},
			"dialogs": [
				{
					"id": 760920201,
					"content": "« La nuit et la lune illuminées par les étoiles ont été tuées par le silence. Nous qui nous servons du carburant de sang et d'os annonçons que la longue nuit demeure encore. Grâce aux lanternes que nous brandissons, aucun spectre ne se réveillera de son sommeil. Ce pacte est scellé par les esprits lunaires. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Examiner"
				}
			]
		}
