				"points": []
			},
			"dialogs": [
				{
					"id": 760920101,
					"content": "Vous feriez mieux de partir ! Cet endroit est très dangereux. Si la Chasse sauvage apparaît, je ne pourrai pas assurer votre sécurité !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920102,
						760920109,
						760920112
					],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920102,
					"content": "Savez-vous quand la Chasse sauvage apparaîtra ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760920103
					]
				},
				{
					"id": 760920103,
					"content": "C'est mon travail en tant que Gardien de lumière.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920104
					],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920104,
					"content": "Vous voyez cette pierre de maréoscellage ? Pour m'assurer de l'éradication totale de la Chasse sauvage, je dois monter la garde ici pendant trois jours et trois nuits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920105
					],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920105,
					"content": "Une pierre de maréoscellage ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760920106
					]
				},
				{
					"id": 760920106,
					"content": "Ce sont des sceaux placés par les Gardiens de lumière pour repousser l'imprégnation de la Chasse sauvage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920107
					],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920107,
					"content": "J'ignore comment ça fonctionne, mais si l'air souillé que la Chasse sauvage laisse derrière elle n'est pas nettoyé, la Chasse sauvage a tendance à revenir au même endroit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920108
					],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920108,
					"content": "C'est pour ça que nous plaçons ces pierres dans les lieux où la Chasse sauvage a été repoussée. Elles nous protègent en cas de recrudescence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920109,
					"content": "Je n'ai pas peur de la Chasse sauvage !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760920110
					]
				},
				{
					"id": 760920110,
					"content": "#Je ne sais pas pourquoi vous êtes aussi {M#confiant}{F#confiante}, mais la Chasse sauvage est un ennemi qu'il ne faut pas prendre à la légère.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920111
					],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920111,
					"content": "Permettez-moi de vous donner un conseil : redoublez de prudence si vous êtes dans un lieu avec une pierre de maréoscellage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920112,
					"content": "Je vous laisse.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760920113
					]
				},
				{
					"id": 760920113,
					"content": "Bonne route.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rolf"
				}
			]
		},
