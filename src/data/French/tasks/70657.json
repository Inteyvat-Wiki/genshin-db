			"dialogs": [
				{
					"id": 706570101,
					"content": "Bonjour, je m'appelle Lizzie, membre de l'Ordre de Favonius. Je suis sûre que vous êtes déjà au courant : Mondstadt a organisé tout un tas d'activités amusantes pendant la Fête des alizées !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570102,
						706570103
					],
					"speakerTitle": "Lizzie"
				},
				{
					"id": 706570102,
					"content": "Oui, j'en ai entendu parler...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706570104
					]
				},
				{
					"id": 706570104,
					"content": "Je suis en charge de l'accueil des visiteurs à Mondstadt, et de m'assurer que chacun profite au maximum de la fête !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570105
					],
					"speakerTitle": "Lizzie"
				},
				{
					"id": 706570105,
					"content": "Les activités du festival ne se trouvent pas forcément en ville. Si personne ne l'explique, certains risquent bien de passer à côté d'excellents jeux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570106
					],
					"speakerTitle": "Lizzie"
				},
				{
					"id": 706570106,
					"content": "Je vous recommande maintenant « Dans le mille » !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570107
					],
					"speakerTitle": "Lizzie"
				},
				{
					"id": 706570107,
					"content": "#Le nom parle de lui-même : il s'agit de toucher des cibles en l'air. Plus vous êtes rapide et {M#précis}{F#précise}, et plus votre score est élevé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570108,
						706570109
					],
					"speakerTitle": "Lizzie"
				},
				{
					"id": 706570108,
					"content": "Ça m'a l'air intéressant.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706570110
					]
				},
				{
					"id": 706570110,
					"content": "Le mieux encore c'est que vous alliez voir par vous-même. Je vous indique où sur votre carte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570111
					],
					"speakerTitle": "Lizzie"
				},
				{
					"id": 706570111,
					"content": "Vous pouvez même obtenir des récompenses diverses en fonction de votre score. Que vous tentiez votre chance une fois ou que vous cherchiez la perfection, vous avez de quoi vous amuser !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570112,
						706570113
					],
					"speakerTitle": "Lizzie"
				},
				{
					"id": 706570112,
					"content": "Intéressant.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706570114
					]
				},
				{
					"id": 706570114,
					"content": "Oui, vous devriez tenter le coup ! Et n'oubliez pas de venir me voir plus tard si vous voulez en savoir plus sur d'autres activités.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570115
					],
					"speakerTitle": "Lizzie"
				},
				{
					"id": 706570115,
					"content": "Amusez-vous bien !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lizzie"
				},
				{
					"id": 706570113,
					"content": "Merci pour la présentation.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706570114
					]
				},
				{
					"id": 706570109,
					"content": "Ça m'a l'air difficile.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706570110
					]
				},
				{
					"id": 706570103,
					"content": "C'est la première fois que j'en entends parler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706570104
					]
				}
			]
		}
	]
