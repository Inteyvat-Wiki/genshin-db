	"talks": [
		{
			"id": 4000102,
			"completionStepIds": [
				4000102
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4000102",
							"2"
						],
						"stepId": 4000102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400010201,
					"content": "#Nous sommes enfin {M#arrivés}{F#arrivées} à <color=#00E1FFFF>Liyue</color> !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010202,
					"content": "#Excusez-moi, {M#jeune homme}{F#jeune demoiselle} ! Combien pour cette étrange chose qui flotte à vos côtés ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010203,
						400010205
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010203,
					"content": "Ça n'est pas à vendre !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010204
					]
				},
				{
					"id": 400010204,
					"content": "Ça n'est pas à vendre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010209,
					"content": "Hahaha... De toute façon, je suis fauché, alors je n'aurais pas pu débourser grand-chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010210
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010210,
					"content": "Je ne suis qu'un petit marchand, je ne vends pas de trésors rares ou exotiques.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010211
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010211,
					"content": "Vous savez, plus vous parlez, plus vous avez l'air louche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010212,
					"content": "Eh bien, quelqu'un n'est pas dans son assiette. Est-ce que quelques bonbons vous aideraient à vous faire sentir mieux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010213
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010213,
					"content": "#Ouhhhh ! C'est bon, on peut lui faire confiance, {NICKNAME} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010214,
					"content": "Vous êtes là pour le Festival des lanternes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010215
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010215,
					"content": "La lanterne Mingxiao de cette année promet d'être grandiose ! La plaustrite qu'on utilisera pour la faire léviter est la plus grosse qu'on ait découverte en vingt ans.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010216
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010216,
					"content": "Elle est si énorme qu'on en viendrait même à se demander si cette cité flottante dans les nuages existe vraiment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010217
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010217,
					"content": "Elle serait certainement aussi maintenue dans les airs grâce à de la plaustrite de taille similaire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010218
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010218,
					"content": "Ça a l'air génial !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010219,
					"content": "#Hahahaha ! J'espère que nous nous recroiserons. En tout cas, bienvenue au <color=#00E1FFFF>Port de Liyue</color> ! ... Je ne devrais peut-être pas parler au nom de tout le monde, mais vous serez toujours les {M#bienvenus}{F#bienvenues} dans ma boutique au moins !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010205,
					"content": "Vous n'avez pas les moyens, croyez-moi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010206
					]
				},
				{
					"id": 400010206,
					"content": "C'est très bizarre dit comme ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010207,
					"content": "Juste par curiosité, combien espérais-tu tirer de moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010208,
					"content": "En fin de compte, je préfère ne pas entendre ta réponse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010209
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4000103,
			"completionStepIds": [
				4000103
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4000103",
							"2"
						],
						"stepId": 4000103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jiangzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400010301,
					"content": "#Regarde, {NICKNAME} ! Il y a un gros rocher qui flotte dans le ciel retenu par des chaînes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010302,
					"content": "Sans ces chaînes, qui sait où il partirait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010303,
					"content": "C'est la plaustrite qui sera placée à l'intérieur de la lanterne Mingxiao. Le marché aux lanternes s'est organisé tout autour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010304
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010304,
					"content": "Et vous êtes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010305,
					"content": "Je m'appelle Jiangzhou et c'est moi qui m'occupe de surveiller la progression de la fabrication de la lanterne Mingxiao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010306
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010306,
					"content": "C'est la première fois que vous venez, je me trompe ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010307
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010307,
					"content": "Oui, mais comment le savez-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010308,
					"content": "Je me serais rappelée de quelqu'un avec une jolie mascotte flottante !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010309
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010309,
					"content": "Si vous avez des questions sur le festival, n'hésitez pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010310
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010310,
					"content": "La lanterne Mingxiao ? Qu'est-ce donc ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010311
					]
				},
				{
					"id": 400010311,
					"content": "Les petites lanternes individuelles relâchées pendant le festival s'appellent « lanternes célestes » ; « lanterne Mingxiao » est le nom donné à la grande lanterne commune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010312
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010312,
					"content": "Presque tous les commerçants de Liyue ont un stand au marché aux lanternes, mais malgré cette popularité, c'est la seule période de l'année où ils ne pensent pas au profit. Le marché existe dans le seul but de collecter les fonds et les matériaux nécessaires à la construction de la lanterne Mingxiao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010313
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010313,
					"content": "Vous pouvez nous aider si vous le voulez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010314
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010314,
					"content": "Qu'est-ce qu'on obtient en échange ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010315,
					"content": "Vous aurez eu la chance de participer à un chantier honorable. Vos vœux deviendront réalité lorsqu'il sera temps d'accueillir la nouvelle année pendant la...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010316
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010316,
					"content": "Vous n'avez rien d'un peu plus concret ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010317,
					"content": "Ah... Pourquoi être si terre-à-terre ? Avoir les pieds sur terre ne devrait pas empêcher d'avoir la tête dans les étoiles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010318
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010318,
					"content": "Enfin... Tous ceux ayant contribué à la fabrication de la lanterne Mingxiao sont récompensés au <color=#00E1FFFF>marché aux lanternes</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010319
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010319,
					"content": "Ça veut dire qu'on nous donnera à manger si on le fait ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010320,
					"content": "#Allons-y, {NICKNAME} ! Renseignons-nous auprès de quelqu'un du <color=#00E1FFFF>marché aux lanternes</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4000106,
			"completionStepIds": [
				4000106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4000106",
							"2"
						],
						"stepId": 4000106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Madame Ping"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400010601,
					"content": "La lanterne Mingxiao de cette année célèbre Brise-Cieux. Il était plutôt du genre frimeur, ça lui plairait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010602,
						400010611
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 400010602,
					"content": "Parlez-moi de Brise-Cieux.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010603
					]
				},
				{
					"id": 400010603,
					"content": "C'est lui qui a inspiré le design de la lanterne Mingxiao de cette année.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010604
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 400010604,
					"content": "J'espère que la lanterne aura des bois assez grands. Ils étaient sa fierté, après tout...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010605
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 400010605,
					"content": "On raconte que les bois de Brise-Cieux ont été créés à partir de l'essence même du pouvoir divin du Souverain de la Roche, et qu'ils étaient l'objet le plus dur de tout Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010606
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 400010606,
					"content": "Il demanda à son ami de les lui trancher, et c'est de cette manière qu'il vainquit la menace qui s'abattait sur Liyue, stabilisant la montagne qui menaçait de s'effondrer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010607
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 400010607,
					"content": "Il utilisa ses bois encore couverts de sang pour rehausser la montagne, et comme si ce sacrifice ne suffisait pas, il continua à se battre jusqu'à verser sa dernière goutte de sang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010608
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 400010608,
					"content": "C'est grâce à lui si aujourd'hui les Monts Tianheng tiennent toujours debout. Le sang qu'il a perdu s'est transformé en ce qui est maintenant la Rivière Bishui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010609
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 400010609,
					"content": "Je ne sais pas si vous croyez à cette histoire, mais ça me fait plaisir que vous m'écoutiez la raconter.",
