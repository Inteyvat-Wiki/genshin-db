				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Musheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223001001,
					"content": "Haha ! Du minerai. Vous savez parler à un Liyuéen, vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001002
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001002,
					"content": "Nos ancêtres savaient comment extraire le métal du minerai par fusion, mais ce minerai avait une tout autre utilisation auparavant, plus importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001003
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001003,
					"content": "On raconte qu'au commencement du Port de Liyue, les premiers colons construisirent des fourneaux en roche, qu'ils alimentèrent en feu en frappant des pierres l'une contre l'autre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001004
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001004,
					"content": "Le feu leur fournit réconfort, et leur permit de cuisiner, de se nourrir, et d'exploiter la terre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001005
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001005,
					"content": "Tout cela grâce à la pierre ; les colons croyaient que les pierres étaient un don du Souverain de la Roche, voyez-vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001006
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001006,
					"content": "On lui donna aussi le surnom de « Dieu des fourneaux ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001007
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001007,
					"content": "Sous sa bénédiction, les flammes des fourneaux ne s'éteignaient jamais, leur garantissant ainsi un commerce florissant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001008
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001008,
					"content": "N'oubliez pas d'adresser une pensée au Souverain de la Roche la prochaine fois que vous mangerez dans un restaurant liyuéen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Musheng"
				}
			]
		},
		{
			"id": 2230011,
			"completionStepIds": [
				2230011
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2230011",
							"2"
						],
						"stepId": 2230011,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Musheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223001101,
					"content": "Vous devez avoir parcouru beaucoup de chemin pour cueillir cette plante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001102
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001102,
					"content": "Comme vous le voyez, le Port de Liyue est grand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001103
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001103,
					"content": "Bien évidemment, elle ne s'est pas faite en un jour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001104
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001104,
					"content": "Au temps de nos ancêtres, il n'y avait rien sur ces terres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001105
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001105,
					"content": "Ils suèrent sang et eau pour rendre l'endroit cultivable, et finirent par édifier cette belle cité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001106
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001106,
					"content": "Vous le savez aussi sans doute, mais il est difficile de cultiver les terres rocheuses et montagneuses près du Port de Liyue. Pourtant, certaines plantes arrivent à pousser dessus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001107
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001107,
					"content": "Chacune de ces plantes a des propriétés qui furent d'un grand secours pour les premiers colons, qui y virent l'intervention du Souverain de la Roche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001108
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001108,
					"content": "Les histoires de nos ancêtres ont toujours eu du succès ici. Aujourd'hui, beaucoup d'aventuriers liyuéens sont encore inspirés par ces récits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001109
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001109,
					"content": "Nombreux sont ceux qui se considèrent les héritiers de cet esprit pionnier, et beaucoup vénèrent le Souverain de la Roche sous le nom de « Dieu des colons ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001110
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001110,
					"content": "Les aventuriers de Liyue s'imposent ainsi d'être aussi inébranlables que la roche face aux défis qu'ils affrontent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Musheng"
				}
			]
		},
		{
			"id": 2230012,
			"completionStepIds": [
				2230012
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2230012",
							"2"
						],
						"stepId": 2230012,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Musheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223001201,
					"content": "Oh, où avez-vous trouvé ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001202
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001202,
					"content": "J'ai entendu dire qu'on n'en trouve plus qu'à la Terrasse Yujing de nos jours...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001203
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001203,
					"content": "Vous avez l'œil. Cette fleur fera un excellent objet pour animer mon récit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001204
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001204,
					"content": "D'une certaine manière, on peut dire que le lys verni fournit un bon exemple de ce qui fait vivre Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001205
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001205,
					"content": "#Vous avez l'air {M#confus}{F#confuse}. Réfléchissez un peu, qu'est-ce qui rend cette fleur spéciale ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001206
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001206,
					"content": "Tout à fait, le lys verni est une plante très précieuse, dont on peut tirer un bon prix et obtenir une bonne quantité de moras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001207
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001207,
					"content": "Vous saviez que notre monnaie, le mora, a été nommée d'après l'Archon Géo ? Il s'appelait Morax.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001208
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001208,
					"content": "C'est l'une des raisons pour lesquelles on le considère souvent comme le dieu de la fortune. Tous les commerçants de Liyue lui rendent hommage avant d'aller travailler, par exemple en brûlant de l'encens en son honneur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001209
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001209,
					"content": "Après tout, c'est lui l'être le plus riche du monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001210
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001210,
					"content": "Et même parmi les Sept... J'imagine qu'il reste le plus riche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Musheng"
				}
			]
		},
		{
			"id": 2230013,
			"completionStepIds": [
				2230013
