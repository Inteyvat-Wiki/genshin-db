					"Musheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223001301,
					"content": "Vous aimez manger vous aussi ? Liyue est le paradis des gourmands, goûtez autant de spécialités locales que vous pourrez !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001302
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001302,
					"content": "Quel est le rapport avec l'Archon Géo ? Ah ! Bonne question ! Vous avez sans doute vu pas mal de restaurants ayant un panneau vantant leur ancienneté, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001303
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001303,
					"content": "Si vous entrez et posez la question, on vous racontera à chaque fois la même histoire : L'Archon Géo a autrefois honoré les lieux de sa présence, commandé tel ou tel plat, félicité le chef, etc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001304
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001304,
					"content": "Sans débattre de la véracité de ce que les tenanciers racontent, personne ne discute le fait que l'Archon Géo est resté à Liyue durant un long, très long moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001305
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001305,
					"content": "Les historiens de Liyue le considèrent comme l'être ayant vécu le plus longtemps au monde, et l'appellent même « Dieu de l'histoire ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001306
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001306,
					"content": "À dire vrai, je pense que nul ne sait vraiment combien de temps l'Archon Géo vécut dans ce monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Musheng"
				}
			]
		},
