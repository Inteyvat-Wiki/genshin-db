			"dialogs": [
				{
					"id": 223008001,
					"content": "Regardez-moi l'heure qu'il est ! Le temps passe vite quand on discute !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008002
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223008002,
					"content": "J'espère que vous êtes maintenant plus au fait de qui est l'Archon Géo et de ce qu'il représente ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008003
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223008003,
					"content": "J'en sais un peu plus maintenant...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223008004
					]
				},
				{
					"id": 223008004,
					"content": "C'est bien, mais l'histoire du Souverain de la Roche ne s'arrête pas là. J'espère que nous aurons l'occasion et le temps d'en reparler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008005
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223008005,
					"content": "#Eh bien, vous avez organisé toutes ces notes ? Vous êtes vraiment {M#sérieux}{F#sérieuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008006
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223008006,
					"content": "Bien, vous n'avez qu'à me les confier. Quand j'en aurai le temps, je les consulterai pour trouver davantage d'histoires.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008007
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223008007,
					"content": "Une fois que je les aurai recoupées et arrangées, je vous donnerai le résultat de mon travail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008008
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223008008,
					"content": "Par contre, les histoires sur le Souverain de la Roche sont légion... Je vais devoir bien organiser tout ça, et ça va me prendre un peu de temps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008009
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223008009,
					"content": "Bon, je vous donne déjà ça. Et encore merci de m'avoir prêté votre oreille !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Musheng"
				}
			]
		}
