			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Musheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223000101,
					"content": "Ça devrait aller...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000102
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000102,
					"content": "Qu'est-ce que vous faites ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223000103
					]
				},
				{
					"id": 223000103,
					"content": "Je suis en train de vénérer le Souverain de la Roche. À ce que je vois, vous n'êtes pas d'ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000104
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000104,
					"content": "Nous sommes au Temple Yiyan. Les Liyuéens y viennent pour prier le Souverain de la Roche et implorer ses bonnes grâces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000105
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000105,
					"content": "Je ne peux pas souvent venir ici, car j'habite loin. J'essaye donc de rester un peu plus longtemps à chaque fois que je viens...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000106
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000106,
					"content": "Il m'est arrivé de lire de nombreux textes anciens sur le Souverain de la Roche, et ses exploits m'émerveillent à chaque lecture.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000107
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000107,
					"content": "Quand je pense à tout ce qu'il a fait pour Liyue, tout le trajet que j'ai fait pour venir ici le remercier en valait vraiment la peine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000108
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000108,
					"content": "J'imagine que vous ne savez probablement pas grand-chose sur lui, mais je peux vous raconter une chose ou deux si vous le voulez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000109
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000109,
					"content": "Hum... Mais les paroles sont insuffisantes pour lui rendre justice comme il se doit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000110
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000110,
					"content": "Je sais. Allez chercher des objets au <color=#00E1FFFF>Port de Liyue</color> que je pourrais utiliser comme accessoires pour rendre mon récit un peu plus vivant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000111,
						223000113
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000111,
					"content": "Pas de problème.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223000112
					]
				},
				{
					"id": 223000112,
					"content": "Bien, allez-y vite. Je vous attends ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000113,
					"content": "Qu'est-ce que vous voulez exactement ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223000114
					]
				},
				{
					"id": 223000114,
					"content": "Tout objet qui pourrait avoir un rapport avec le <color=#00E1FFFF>Port de Liyue</color> ou le <color=#00E1FFFF>Souverain de la Roche</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000115
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000115,
					"content": "En réalité, je ne connais pas tant d'histoires que ça... et certaines ne sont pas très intéressantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000116
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000116,
					"content": "Nous en parlerons davantage à votre retour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Musheng"
				}
			]
		},
