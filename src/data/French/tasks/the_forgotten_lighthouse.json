			},
			"dialogs": [
				{
					"id": 762050301,
					"content": "Un trésor ! Trop bien !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050302,
					"content": "Mais... j'ai vraiment mal à la tête. Franchement, Nicole avait-elle vraiment besoin de crier aussi fort juste pour faire apparaître cet escalier...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050303,
					"content": "Qu'est-ce qu'il y a ? Vous vous plaignez déjà ? Vous n'avez pas peur qu'une puissante sorcière comme moi claque des doigts et transforme ces jolis trésors en navets ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050304,
						762050305
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050304,
					"content": "E—Elle ne voulait pas dire de mal...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050306
					]
				},
				{
					"id": 762050306,
					"content": "Héhé, bien sûr que non. Vous savez bien que je ne suis pas le genre d'ange rancunier qui note chaque petit affront dans un coin de sa tête.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050307
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050307,
					"content": "#... Et ainsi, lorsque l'heure de vérité sonna enfin, {NICKNAME} et Paimon gravirent les sept marches pour découvrir qu'une silhouette familière les attendait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050308
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050308,
					"content": "Des flammes rayonnantes convergèrent pour former des ailes dans son dos. Sa silhouette demeurait aussi noble et belle que le jour de leur première rencontre, mais ses yeux brillaient désormais d'une lueur cruelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050309
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050309,
					"content": "#« Pourquoi ? » demandèrent {NICKNAME} et Paimon à l'unisson.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050310
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050310,
					"content": "« Tout a commencé le jour où Paimon m'a reproché de parler trop fort. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050311
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050311,
					"content": "Les mots sont magiques ici, vous savez ! Alors ne dites pas des choses aussi effrayantes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050305,
					"content": "Allez, ne le prenez pas à cœur...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050306
					]
				}
			]
		},
