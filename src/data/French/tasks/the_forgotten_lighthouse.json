				]
			},
			"dialogs": [
				{
					"id": 762050101,
					"content": "#Qu'est-ce que je vais faire...? {M#Ils}{F#Elles} vont bientôt arriver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050102
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050102,
					"content": "#On est là ! Nicole, pourquoi vous ne nous laissez pas entrer{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050103,
					"content": "Oh là là... Oh là là... Je suis vraiment désolée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050104
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050104,
					"content": "Vous n'êtes pas encore prête ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050105
					]
				},
				{
					"id": 762050105,
					"content": "Comment dire... Oh, zut, j'ai bien peur de ne pas pouvoir l'expliquer très clairement. Il va falloir que je vous raconte toute l'histoire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050106
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050106,
					"content": "Tout a commencé la première fois que les sorcières ont défié l'Archon Anémo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050107
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050107,
					"content": "Nicole, c'était... il y a bien trop longtemps !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050108,
					"content": "Argh... Ce n'est pas juste ! C'est embarrassant de devoir dire ça moi-même... Non ! On n'y peut rien, les faits sont les faits... Tant qu'Alice n'en entend pas parler, personne ne se moquera...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050109
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050109,
					"content": "Oh là là, son monologue intérieur s'échappe encore... Et en plus, ça ne vient même pas vraiment de sa « bouche »...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050110,
					"content": "Chut...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050111
					]
				},
				{
					"id": 762050111,
					"content": "J'ai décidé de cacher les plumes en haut du bureau. Je me suis dit que si je rendais les choses plus difficiles, le sentiment d'accomplissement serait plus grand...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050112
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050112,
					"content": "Mais je ne suis vraiment pas très douée pour contrôler ces courants d'air capricieux. Je ne peux m'élever que jusqu'à une certaine hauteur avant de me heurter à une sorte de plafond invisible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050113
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050113,
					"content": "Vous ne pouvez pas utiliser la magie pour faire redescendre les plumes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050114,
					"content": "Mais où serait l'amusement dans tout ça ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050115
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050115,
					"content": "Bon, d'accord... C'est vraiment compliqué...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050116,
					"content": "Nicole, vous pourriez dire quelque chose ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050117
					]
				},
				{
					"id": 762050117,
					"content": "Qu'est-ce que vous voulez que je dise ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050118,
						762050119
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050118,
					"content": "À Simulanka, les mots sont de la magie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050120
					]
				},
				{
					"id": 762050120,
					"content": "Oh ! Je vois ce que vous voulez dire ! D'accord, je vais essayer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050121
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050121,
					"content": "Argh... Ce n'est pas juste ! C'est embarrassant de devoir dire ça moi-même...",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						762050122
					]
				},
				{
					"id": 762050122,
					"content": "Non ! On n'y peut rien, les faits sont les faits...",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						762050123
					]
				},
				{
					"id": 762050123,
					"content": "Tant qu'Alice n'en entend pas parler, personne ne se moquera...",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				},
				{
					"id": 762050119,
					"content": "Peut-être pourriez-vous dire quelque chose qui deviendrait un escalier...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050120
					]
				}
			]
		},
