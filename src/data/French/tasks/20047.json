			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Doolan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200470101,
					"content": "Ça ne sert à rien de faire un plan quand on part à l'aventure ! On ne le respectera jamais !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470102
					],
					"speakerTitle": "Patty la Curieuse"
				},
				{
					"id": 200470102,
					"content": "Peut-être, mais il faut se préparer à toutes les possibilités !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470103
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470103,
					"content": "Pourquoi vous vous disputez ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470104
					]
				},
				{
					"id": 200470104,
					"content": "Patty et moi-même voudrions explorer le <color=#00E1FFFF>Temple des Mille Vents</color>, mais elle n'a aucune expérience.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470105
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470105,
					"content": "L'intérieur grouille de monstres de nos jours, sans parler du Gardien des ruines à l'entrée... Nous sommes cuits si jamais on fonce tête baissée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470106
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470106,
					"content": "Je pense à la sécurité de Patty... Enfin, surtout à la mienne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470107
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470107,
					"content": "C'est pour ça que je suis en train de lui expliquer qu'il nous faut un plan en béton pour notre aventure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470108
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470108,
					"content": "Je crains qu'elle n'arrive pas à se contrôler et fonce toute seule si nous partons en reconnaissance aux alentours du temple.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470109
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470109,
					"content": "Je dois garder un œil sur elle, alors pourriez-vous faire ce travail de reconnaissance pour moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470110,
						200470113
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470110,
					"content": "Hmm, d'accord.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470111
					]
				},
				{
					"id": 200470111,
					"content": "Parfait ! Rapportez-moi tout ce que vous verrez. Le bon déroulement de cette aventure en dépend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470112
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470112,
					"content": "N'oubliez pas un seul détail, compris ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470113,
					"content": "Je peux garder un œil sur Patty pendant que vous le faites.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470114
					]
				},
				{
					"id": 200470114,
					"content": "Non, vous ne pouvez pas ! On doit encore discuter de plein de choses ensemble !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470115
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470115,
					"content": "Allez-y pour moi, s'il vous plaît !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Doolan"
				}
			]
		},
