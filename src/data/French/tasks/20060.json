				},
				{
					"id": 200600902,
					"content": "Voilà votre remède.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200600903
					]
				},
				{
					"id": 200600903,
					"content": "Merci beaucoup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600907
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600907,
					"content": "J'ai tellement honte... Mon fiston se bat corps et âme, mais il n'y a pas grand-chose que je puisse faire pour l'aider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600908
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600908,
					"content": "Ne pas le déranger en est une...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600909
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600909,
					"content": "Prenez ça en guise de remerciement de ma part.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tunner"
				},
