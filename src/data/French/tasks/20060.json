				"objectNames": [
					"Tunner"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200600101,
					"content": "#Bonjour {M#cher invité}{F#chère invitée} ! Est-ce que vous connaissez Guy, mon fils ? *tousse* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600102
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600102,
					"content": "Qu'est-ce qu'il vous arrive ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200600103
					]
				},
				{
					"id": 200600103,
					"content": "Rien de grave. Juste un rhume qui a un peu de mal à guérir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600104
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600104,
					"content": "J'ai vu les religieuses de la <color=#00E1FFFF>cathédrale</color> et elles ne pouvaient pas me soigner, alors elles m'ont prescrit un remède pour soulager les symptômes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600105
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600105,
					"content": "Je me fais vieux et je ne peux plus beaucoup marcher. Moco et Hillie étaient toujours là pour aider à préparer mes remèdes avant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600106
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600106,
					"content": "Elles sont occupées aujourd'hui *tousse* <color=#00E1FFFF>Gillianna</color> saura quoi faire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600107
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600107,
					"content": "J'ai juste besoin que quelqu'un lui ramène <color=#00E1FFFF>3 fleurs sucrantes</color> pour la préparation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600108,
						200600110
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600108,
					"content": "D'accord.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600109
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600109,
					"content": "*tousse* Merci beaucoup...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600112
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600112,
					"content": "Apportez 3 fleurs sucrantes à Sœur Gillianna à la cathédrale pour qu'elle fasse mon remède. <color=#00E1FFFF>Ne dites rien à Guy.</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600113
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600113,
					"content": "On m'a dit que l'Ordre et l'Église entretiendraient des liens. Maintenant que le fiston est chevalier de l'Ordre, il doit faire attention à son image...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600114
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600114,
					"content": "Je ne me le pardonnerais jamais s'il se mettait dans l'embarras à cause de moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600115
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600115,
					"content": "Pardon, je parle trop... Allez-y et faites attention à vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600110,
					"content": "Vous pouvez demander ça à Guy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600111
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600111,
					"content": "Guy n'a pas le temps pour ça. Il est sans doute en train de pourchasser des monstres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600112
					],
					"speakerTitle": "Tunner"
				}
			]
		},
