			},
			"dialogs": [
				{
					"id": 200600501,
					"content": "Bonjour ! Est-ce que vous accepteriez de me vendre ces fleurs que vous tenez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600502
					],
					"speakerTitle": "Guy"
				},
				{
					"id": 200600502,
					"content": "Mon père souffre d'une vilaine toux depuis longtemps, mais Gillianna m'a dit qu'elle n'avait plus d'ingrédients pour faire un remède.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600503,
						200600506
					],
					"speakerTitle": "Guy"
				},
				{
					"id": 200600503,
					"content": "J'en ai besoin pour un remède aussi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200600504
					]
				},
				{
					"id": 200600504,
					"content": "Ah bon ? Tant pis alors...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600505
					],
					"speakerTitle": "Guy"
				},
				{
					"id": 200600505,
					"content": "Pardon du dérangement. Foncez à la cathédrale, Gillianna y est encore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guy"
				},
				{
					"id": 200600506,
					"content": "Les fleurs sucrantes sont faciles à trouver.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200600507
					]
				},
				{
					"id": 200600507,
					"content": "Ah ? Je sais, mais je suis coincé à garder cette porte !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600508
					],
					"speakerTitle": "Guy"
				},
				{
					"id": 200600508,
					"content": "J'ai même pris du temps sur ma pause de midi pour aller voir Gillianna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600509
					],
					"speakerTitle": "Guy"
				},
				{
					"id": 200600509,
					"content": "Je ne vous retiens pas plus longtemps. Gillianna devrait encore être à la cathédrale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guy"
				}
			]
		},
