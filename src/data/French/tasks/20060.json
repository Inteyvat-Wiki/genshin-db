					"Gillianna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200600801,
					"content": "C'est prêt ! Rappelez-vous bien que ce remède ne fera que le soulager. Il a vraiment besoin de prendre ses médicaments et de se reposer pour guérir complètement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600802
					],
					"speakerTitle": "Gillianna"
				},
				{
					"id": 200600802,
					"content": "Je n'ai pas arrêté de lui répéter, mais il ne veut rien entendre de la part de quiconque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600803
					],
					"speakerTitle": "Gillianna"
				},
				{
					"id": 200600803,
					"content": "Bref, rapportez ça à Tunner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600804,
						200600806
					],
					"speakerTitle": "Gillianna"
				},
				{
					"id": 200600804,
					"content": "Merci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600805
					],
					"speakerTitle": "Gillianna"
				},
				{
					"id": 200600805,
					"content": "De rien, je ne fais que mon devoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gillianna"
				},
				{
					"id": 200600806,
					"content": "J'espère que ça ne vous embête pas trop.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600807
					],
					"speakerTitle": "Gillianna"
				},
				{
					"id": 200600807,
					"content": "Je vous en prie ! *soupir* Si quelqu'un était là pour s'occuper de Tunner, on n'en serait pas là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gillianna"
				}
			]
		},
