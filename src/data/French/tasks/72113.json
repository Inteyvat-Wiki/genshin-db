						721130609
					]
				},
				{
					"id": 721130609,
					"content": "Voyons voir... « ... La première moitié est « Au milieu de la nuit brumeuse »... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130610,
					"content": "Et il n'y a pas la suite... Je ne sais pas ce qu'est la seconde moitié.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130611,
					"content": "Puisqu'un langage codé est utilisé, cela veut sûrement dire qu'il y a un secret qui se cache derrière tout ça, non ?",
