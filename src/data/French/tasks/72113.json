					"Gendou Ringo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721131001,
					"content": "Qui êtes-vous ? Qu'est-ce que vous voulez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131002
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131002,
					"content": "On voulait vous poser les mêmes questions ! Qui êtes-vous, Gendou ? Et pourquoi nous attaquez-vous par surprise ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721131003,
					"content": "Quel manque de politesse. Répondez à ma question.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131004
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131004,
					"content": "#Je suis {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131005
					]
				},
				{
					"id": 721131005,
					"content": "Je connais vos noms. Dites-moi où vous avez entendu le code secret.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131006,
						721131008
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131006,
					"content": "C—C'est Paimon qui me l'a révélé...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131007
					]
				},
				{
					"id": 721131007,
					"content": "Hé, mais qu'est-ce que tu racontes ?! Dépêche-toi de dire la vérité à mademoiselle Gendou, t'as vu son regard noir ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721131010,
					"content": "#... Je vois. Vous êtes {M#tombés}{F#tombées} par hasard sur cette note. Dans ce cas, Momoka doit déjà être...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131011
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131011,
					"content": "Qui est Momoka ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131012
					]
				},
				{
					"id": 721131012,
					"content": "Une de mes camarades, celle qui a écrit cette note. Hélas, il semblerait qu'elle ne soit plus en mesure de remplir son devoir envers Inazuma. Quel dommage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131013
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131013,
					"content": "Hmph, je sais que vous avez beaucoup de questions à me poser, et cela ne sert à rien de vous le cacher plus longtemps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131014
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131014,
					"content": "Momoka et moi sommes des ninjas du Shuumatsuban. Notre organisation s'occupe des menaces de l'extérieur. Ces bandes de papier sont une façon de communiquer nos missions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131015
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131015,
					"content": "À cause de cela, nous avons subi beaucoup de rancune et de danger. Par exemple, de la part de ces personnes dangereuses et étranges qui ont infiltré Inazuma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131016,
						721131018
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131016,
					"content": "Les Mondstadtois.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131017
					]
				},
				{
					"id": 721131017,
					"content": "Comment ça, les Mondstadtois ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131020
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721131020,
					"content": "Le code secret nous permet de reconnaître nos collègues.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131021
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131021,
					"content": "Cependant, chaque code est unique. Il semblerait que Momoka ait délibérément écrit son code pour nous laisser un message.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131022
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131022,
					"content": "... Elle avait l'intention d'appâter les ennemis qui auraient essayé d'utiliser ce code.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131023
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131023,
					"content": "Donc...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131024
					]
				},
				{
					"id": 721131024,
					"content": "Vous avez immédiatement compris quand vous avez vu que votre contact n'était pas Momoka, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131025
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721131025,
					"content": "Bien entendu. C'est pourquoi il a fallu que je fasse la lumière sur cette situation. Mais c'était très étrange. Je n'arrivais pas à percer ce mystère.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131026
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131026,
					"content": "Si vous étiez vraiment des espions de Snezhnaya, alors pourquoi auriez-vous terminé votre mission sans en référer aux Fatui ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131027
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131027,
					"content": "#... C'est pour cette raison que je vous ai {M#crus}{F#crues} quand vous m'avez parlé du camp abandonné.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131028
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131028,
					"content": "#À en juger par vos actions, il m'a été possible de comprendre que vous étiez des {M#amis}{F#amies} d'Inazuma et non des {M#ennemis}{F#ennemies}, et que vous aviez utilisé le code juste par curiosité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131029
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131029,
					"content": "#Nous voilà {M#innocentés}{F#innocentées} ! Mais je suis quand même un peu agacée, vous vous êtes servie de nous comme main-d'œuvre gratuite pendant tout ce temps !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131030
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721131030,
					"content": "... Mais cette personne était-elle la vraie Gendou Ringo ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131031
					]
				},
				{
					"id": 721131031,
					"content": "Hmph, vous avez donc remarqué. La Gendou qui vous a confié des missions par la suite était une usurpatrice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131032
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131032,
					"content": "Quoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131033
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721131033,
					"content": "Je me suis fait surprendre par des espions des Fatui pendant que je vous suivais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131034
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131034,
					"content": "Comme je connais une ou deux techniques ninja, j'ai pu simuler ma mort pour qu'ils me lâchent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131035
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131035,
					"content": "Ils ont tout simplement envoyé quelqu'un déguisé en utilisant mon apparence pour me remplacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131036,
						721131037
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131036,
					"content": "C'est pour ça que vous étiez devenue bizarre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131038
					]
				},
				{
					"id": 721131038,
					"content": "Hein ? En gros, la gentille mademoiselle Gendou était une fausse ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131039
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721131039,
					"content": "« Gentille » ? Hmph, je vois qu'elle a eu un certain succès.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131040
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131040,
					"content": "En tout cas, je suppose qu'ils vous ont pris pour de véritables membres du Shuumatsuban et ont voulu se servir de vous pour infiltrer notre organisation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131041
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131041,
					"content": "C'était l'occasion d'agir pour moi, en vous amenant ici par mes propres moyens en l'absence de l'imposteur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131042
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131042,
					"content": "Écoutez, je vais vous proposer un choix.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131043
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131043,
					"content": "Travaillez pour nous en tant que membre externe. Ils ne savent pas que je suis en vie, ce qui est en notre faveur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131044,
						721131047,
						721131048
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131044,
					"content": "Et si je refuse ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131045
					]
				},
				{
					"id": 721131045,
					"content": "Oh, essayez donc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131046
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131046,
					"content": "#Les Fatui sont aussi nos ennemis, {NICKNAME}. Pourquoi pas ne pas s'allier au Shuumatsuban ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131049
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721131049,
					"content": "Sage décision. Libre à vous de vous servir de tout ce qui se trouve dans cet entrepôt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131050
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131050,
					"content": "Sur ce, je vous contacterai dès que j'aurais du nouveau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131051
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131051,
					"content": "J'espère que notre coopération se fera sans problème. Au revoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131052
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131047,
					"content": "Vous avez raison.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131049
					]
				},
				{
					"id": 721131048,
					"content": "C'est d'accord.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131049
					]
				},
				{
					"id": 721131037,
					"content": "C'est pour ça que vous savez ce qu'était un omikuji.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131038
					]
				},
				{
					"id": 721131018,
					"content": "Les Fatui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131019
					]
				},
				{
					"id": 721131019,
					"content": "Exact.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131020
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131008,
					"content": "Écoutez, voici ce qui s'est passé...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131009
					]
				},
				{
					"id": 721131009,
					"content": "On a trouvé un camp abandonné sur une montagne...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131052
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}