					"content": "Hé, c'est écrit « infortune » !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130403,
					"content": "Je me souviens de cette situation ! Il est dit... « Accrochez la bande de papier qui prédit une mauvaise fortune sur le portique d'omikuji pour renverser le sort ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130404,
					"content": "« Puis offrez un agréable repas à Paimon, et vous changerez l'infortune en fortune. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130405,
					"content": "C'est vrai ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130406
					]
				},
				{
					"id": 721130406,
					"content": "Bien sûr ! Tu oserais remettre en question la sagesse des anciens ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130407,
					"content": "La sagesse des anciens est étonnante ! Bref, cherchons d'abord ce portique d'omikuji !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
