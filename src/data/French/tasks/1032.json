			},
			"dialogs": [
				{
					"id": 10293301,
					"content": "Ushi, on dirait que notre petit melon lavande s'est endormi. À ton avis, de quoi elle est en train de rêver ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293302
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10293302,
					"content": "Meuh ? Meuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293303
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10293303,
					"content": "Elle est épuisée, elle qui est d'habitude si enjouée... Ah, pauvre petite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293304
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10293304,
					"content": "Et puis ce petit gars a aussi l'air crevé. Je commence à m'inquiéter pour eux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293305
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10293305,
					"content": "Meuh, meuh, meuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293306
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10293306,
					"content": "Je dors comme ça quand je suis en prison ? T'es un rigolo, toi. C'est vrai que quand je dors, je suis beau comme un prince...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293307
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10293307,
					"content": "#{NICKNAME} ?! Depuis quand tu es ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
