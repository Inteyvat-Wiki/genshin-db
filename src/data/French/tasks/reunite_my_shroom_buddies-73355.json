			"dialogs": [
				{
					"id": 733550101,
					"content": "Hé, un Fongus vient de passer. Est-ce que c'est normal ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550102,
					"content": "C'est plutôt dangereux de laisser des Fongus se balader en ville, non ? À moins que ce soit ceux qui ont été spécialement dressés...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550103,
					"content": "Attends, pourquoi j'ai une impression de déjà-vu ? On a déjà vécu quelque chose de similaire, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550104,
						733550107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550104,
					"content": "Attends, ce ne serait pas Chapotoc ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550105
					]
				},
				{
					"id": 733550105,
					"content": "C'est ça ! Chapotoc ! Notre ami Fongus qu'on a rencontré à Sumeru !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550106,
					"content": "Aaaaaah ! Ça fait tellement qu'on ne l'a pas vu ! Allons lui dire bonjour !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550107,
					"content": "De quels Fongus « spécialement dressés » tu parles ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550108
					]
				},
				{
					"id": 733550108,
					"content": "Je crois que c'est... Chapotoc ? Notre ami Fongus qu'on a rencontré à Sumeru !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550109
					],
					"speakerTitle": "Paimon"
				},
				{
