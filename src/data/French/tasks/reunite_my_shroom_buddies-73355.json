			"dialogs": [
				{
					"id": 733550201,
					"content": "Hmm ? On dirait que je n'ai pas besoin de laisser un message à la Guilde des aventuriers. Le destin finit toujours par nous réunir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550202
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550202,
					"content": "Comme on se retrouve, Comète dorée et Compagnon argenté !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550203
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550203,
					"content": "#Vous voir {M#tous les deux si radieux et pleins}{F#toutes les deux si radieuses et pleines} de vie me donne la douce impression que le temps s'est arrêté.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550204,
						733550208
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550204,
					"content": "Ça faisait longtemps, Haniyyah !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550205
					]
				},
				{
					"id": 733550205,
					"content": "C'est vraiment vous, Haniyyah et Chapotoc !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550206,
					"content": "Pas étonnant que ce message m'a donné une impression si familière... Ça veut dire que mon lien avec Chapotoc est toujours aussi fort !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550207,
					"content": "♪ ~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550212
					],
					"speakerTitle": "Chapotoc"
				},
				{
					"id": 733550212,
					"content": "J'avais imaginé tant de façons différentes de nous retrouver. Un grand festin ou une fête de bienvenue un peu créative, quelque chose digne d'une vraie surprise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550213
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550213,
					"content": "#Mais au final, tout ça me semblait un peu trop formel. Vous étiez très {M#occupés}{F#occupées}, et je craignais que vous prendre trop de temps ne vous cause des ennuis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550214
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550214,
					"content": "Et puis, les Fongus préfèrent les environnements calmes et paisibles. Restons plutôt simples, retrouvons-nous dans une ambiance détendue et décontractée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550215
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550215,
					"content": "C'est vrai ! Les lectures de prose de Haniyyah ont enfin porté leurs fruits. Après tout, un état d'esprit calme fait des merveilles dans nos vies !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550216
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 733550216,
					"content": "Au bout du compte, ce genre de bavardage insouciant est ce qu'il y a de plus joyeux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550217
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 733550217,
					"content": "♫ ~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550218
					],
					"speakerTitle": "Pyrojoie"
				},
				{
					"id": 733550218,
					"content": "Souka est là aussi ! Je vois aussi Pyrojoie et... Qui est-ce ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550219,
					"content": "Voici mon ami Fongus, Danse-brise. Vous nous avez battu avec Chapotoc en seizième de finale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550220
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 733550220,
					"content": "Héhé, vous vous en souvenez bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550221,
						733550222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550221,
					"content": "Ça commence à me revenir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550223
					]
				},
				{
					"id": 733550223,
					"content": "Comme vous pouvez le constater, mes chers gros bonnets, nous n'avons pas besoin de planifier l'heure ou le lieu de notre prochaine rencontre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550224
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 733550224,
					"content": "Haniyyah et moi avons acheté ce quartier commercial et l'avons transformé en aire de jeux des cham-p'tit-gnons !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550225
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 733550225,
					"content": "Attendez, vous êtes en train de dire que ces installations ne sont pas louées pour le nouveau jeu de plateau, mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550226,
					"content": "Tu as tout compris. À partir de maintenant, nous allons vivre au Port Bayda et promouvoir le jeu de plateau des Fongus, tout en partageant notre théorie sur la communication avec les animaux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550227
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550227,
					"content": "N'hésitez pas à passer jouer avec les amis Fongus quand vous avez le temps !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550228
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550228,
					"content": "♪ ~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550229,
						733550230
					],
					"speakerTitle": "Chapotoc"
				},
				{
					"id": 733550229,
					"content": "Youpi ! Des copains Fongus !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550231
					]
				},
				{
					"id": 733550231,
					"content": "C'est vraiment l'une des meilleures nouvelles de la journée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550232,
					"content": "Depuis le premier tournoi de Fongus, j'ai eu plein d'idées pour jouer avec Chapotoc. On va enfin pouvoir toutes les réaliser maintenant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550233,
					"content": "Dommage qu'on n'ait pas apporté de friandises pour nos amis Fongus... Ce serait tellement génial si on pouvait se blottir contre eux et savourer de la délicieuse nourriture !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550234,
					"content": "Pas besoin de s'en faire pour ça. Dans le cadre du perfectionnement de mon ouvrage « Sur les communautés fongiques », j'ai mené des recherches fondamentales sur les aliments que les Fongus apprécient.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550235
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550235,
					"content": "Mon objectif est d'identifier des ingrédients que les Fongus et les humains peuvent manger, pour que nos compagnons n'aient pas à passer toute l'année à se nourrir uniquement de chaque parfum de gelée merveilleuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550236
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550236,
					"content": "Un jour, je trouverai des ingrédients qui satisferont à la fois les goûts des humains et des Fongus, et je créerai de délicieux plats que nous pourrons tous savourer ensemble !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550237
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550237,
					"content": "Quand il sera temps de passer de la théorie à la pratique, je m'occuperai moi-même de la cuisine. Au cas où Haniyyah finirait par brûler notre onzième marmite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550238
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 733550238,
					"content": "On dirait que le jour où on s'assoira en cercle pour partager un repas avec nos amis Fongus n'est plus très loin, pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550239,
						733550240
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550239,
					"content": "On attendra de tes nouvelles, Haniyyah !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550241
					]
				},
				{
					"id": 733550241,
					"content": "N'hésitez pas à revenir visiter l'aire de jeux des cham-p'tit-gnons dès que vous en aurez l'occasion. Nous serons toujours avec nos amis Fongus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550242
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550242,
					"content": "Qui sait ? La surprise pourrait arriver encore plus tôt que vous ne le pensez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550243
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 733550243,
					"content": "♪ !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chapotoc"
				},
				{
					"id": 733550240,
					"content": "#J'ai hâte de goûter au festin de Souka{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550241
					]
				},
				{
					"id": 733550230,
					"content": "On va pouvoir se voir tout le temps maintenant !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550231
					]
				},
				{
					"id": 733550222,
					"content": "Cette atmosphère chaleureuse et accueillante m'aide à me détendre...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550223
					]
				},
				{
					"id": 733550208,
					"content": "Même si je ne me souviens plus très bien... Bonjour à vous deux !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550209
					]
				},
				{
					"id": 733550209,
					"content": "C'est vraiment Haniyyah et Chapotoc ! On s'est rencontrés au Tournoi de dompteur de la Coupe des nilotpalotus. Ce sont des amis de longue date !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550210,
					"content": "Après ça, je me souviens qu'on s'est recroisés près du Port Ormos et à la Cour de Fontaine. Ça fait déjà si longtemps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550211,
					"content": "♪ ~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550212
					],
					"speakerTitle": "Chapotoc"
				}
			]
		}
	]
