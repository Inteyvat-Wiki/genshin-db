					"nextDialogs": [
						3180203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3180203,
					"content": "Apparemment, c'est comme à Mondstadt... Prie devant une Statue des Sept, et les Sept Archons te répondront.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3180204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3180204,
					"content": "Liyue est le domaine de l'Archon Géo, alors les statues d'ici sont sculptées à son effigie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3180205
					],
					"speakerTitle": "Paimon"
				},
				{
