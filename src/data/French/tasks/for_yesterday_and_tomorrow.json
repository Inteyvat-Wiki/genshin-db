			"dialogs": [
				{
					"id": 741850101,
					"content": "Monsieur Este, on est de retour !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850102,
					"content": "Oh, mais alors... Attendez, mais qui êtes-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850103
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850103,
					"content": "#Hein ? Vous ne nous reconnaissez pas ? C'est {NICKNAME} et moi, Paimon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850104,
					"content": "#{NICKNAME} et Paimon... J'ai déjà entendu ces noms, mais ça devait sûrement être dans un rêve !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850105
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850105,
					"content": "Oh, mais vous étiez bien conscient à ce moment-là, monsieur Este ! Et en bas, on a même vu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850106,
					"content": "*soupir* J'ai rêvé que tous les habitants du village s'étaient changés en pierre, me laissant seul et sans défense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850107
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850107,
					"content": "#Jusqu'à l'arrivée de deux {M#héros}{F#héroïnes} qui ont eu la dure tâche de sauver tout le monde... Ce n'était donc pas un rêve ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850108,
						741850109
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850108,
					"content": "Peut-être, ou peut-être pas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850110
					]
				},
				{
					"id": 741850110,
					"content": "Oui ! De toute façon, tout le monde est redevenu normal, pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850111,
					"content": "Cependant, je remarque que beaucoup d'habitants du village ont fait des rêves étranges. Qu'est-ce qui a bien pu se passer ? Est-ce qu'on a tous été victimes d'une hypnose collective ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850112
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850112,
					"content": "Ça va peut-être prendre une journée entière pour tout vous expliquer... Oubliez cette histoire d'hypnose pour l'instant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850113,
					"content": "Oh ? En parlant d'hypnose, vous avez aussi apporté un chat avec vous ! Il a l'air très intelligent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850114,
						741850116
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850114,
					"content": "C'est vrai qu'il est très intelligent.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850115
					]
				},
				{
					"id": 741850115,
					"content": "C'est notre compagnon, mais on ne peut pas l'emmener avec nous en voyage...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850118,
					"content": "Quelle coïncidence ! Nous avons un espace réservé aux chats dans notre club. Mais aucun animal ne l'occupe depuis que notre chercheur sur l'hypnose est parti en voyage avec son chat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850119
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850119,
					"content": "Si ça ne vous dérange pas, vous pouvez le laisser ici et nous nous en occuperons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850120
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850120,
					"content": "Je ne sais pas pourquoi, mais j'ai l'impression que nous avons un lien spécial. Je vais prendre soin de lui pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850121
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850121,
					"content": "Notre maison à chats se trouve de l'autre côté du bâtiment. Vous la verrez si vous en faites le tour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Este"
				},
				{
					"id": 741850116,
					"content": "C'est notre compagnon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850117
					]
				},
				{
					"id": 741850117,
					"content": "C'est bien vrai, mais on ne peut pas l'emmener avec nous en voyage...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850109,
					"content": "Ça n'a aucune importance.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850110
					]
				}
			]
		},
