			"dialogs": [
				{
					"id": 741850301,
					"content": "Héhé, Osse, c'est ta nouvelle maison maintenant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850302,
					"content": "Miaou ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850303
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741850303,
					"content": "Mais c'est quand même un peu bizarre. Cassiodor aurait dû quitter cet endroit, non ? Dans ce cas, qui est Osse ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850304,
					"content": "#Est-ce le chat qui n'a pas été habité par Cassiodor ou est-ce Monsieur Os qui nous a {M#accompagnés}{F#accompagnées} durant toutes ces aventures ? Rah, tout ça me donne le tournis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850305,
						741850307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850305,
					"content": "Tu n'es pas faite pour réfléchir à ce genre de questions complexes, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850306
					]
				},
				{
					"id": 741850306,
					"content": "Je n'ai vraiment rien compris...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850309,
					"content": "Quoi qu'il en soit, on a trouvé une nouvelle maison pour Osse. Si on a du temps, on viendra jouer avec lui !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850310,
					"content": "Miaou miaou !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Osse"
				},
				{
					"id": 741850307,
					"content": "Osse est Osse.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850308
					]
				},
				{
					"id": 741850308,
					"content": "Même si je n'ai rien compris, c'est plutôt logique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850309
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
