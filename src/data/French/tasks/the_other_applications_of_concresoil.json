			},
			"dialogs": [
				{
					"id": 230091101,
					"content": "#{M#Voyageur}{F#Voyageuse} ! Vous tombez bien, j'étais justement inquiet de n'avoir personne pour m'aider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091102
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091102,
					"content": "Vous avez fait des progrès dans vos recherches ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230091103
					]
				},
				{
					"id": 230091103,
					"content": "Euh... Je ne parlerais pas vraiment de progrès, juste d'un client qui m'a fait une suggestion intéressante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091104
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091104,
					"content": "Il a dit qu'il faisait pousser des fleurs, et que la chose qui le préoccupait le plus était de trouver de la bonne terre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091114
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091114,
					"content": "La terre doit avoir une bonne perméabilité tout en étant suffisamment nutritive, et retenir l'eau sans être détrempée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091105
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091105,
					"content": "Il a vu tellement d'améliorations dans ma polyterre qu'il a voulu me demander d'en concevoir une spécifique à la culture des fleurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091106
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091106,
					"content": "Je trouve l'idée intéressante, et je cherche donc d'autres matériaux pour améliorer ma polyterre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091107
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091107,
					"content": "Cette fois, je veux vous demander de m'aider à trouver de la terre fertile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091108
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091108,
					"content": "Je vais vous marquer l'emplacement de cette terre sur la carte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091109,
