			},
			"dialogs": [
				{
					"id": 230090201,
					"content": "J'ai besoin de plus de matériaux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090202
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090202,
					"content": "Comment ça se passe avec votre polyterre ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230090203
					]
				},
				{
					"id": 230090203,
					"content": "Très bien ! Je peux vous dire que les applications de ce genre de terre dépassent mon imagination.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090204
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090204,
					"content": "On peut l'utiliser pour fabriquer des poteries, aussi bien que pour réparer des fissures dans les maisons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090205
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090205,
					"content": "Tant que l'on ajuste la proportion de mélange de chaque type de terre, il n'y a aucun problème à l'utiliser directement pour construire une maison.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090206
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090206,
					"content": "Mais... puisque beaucoup de gens viennent me commander cette terre, je suis à nouveau à court de matériaux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090207
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090207,
					"content": "#Et le plus important est que la bave de Blob est également épuisée. {M#Voyageur}{F#Voyageuse}, pourriez-vous m'aider à trouver trois autres portions de bave de Blob ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090208,
						230090209
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090208,
					"content": "Je m'en occupe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230090212
					]
				},
				{
					"id": 230090212,
					"content": "#S'il vous plaît, {M#voyageur}{F#voyageuse}, aidez-moi à trouver trois autres portions de bave de Blob.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090209,
					"content": "Et les autres matériaux ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230090210
					]
				},
				{
					"id": 230090210,
					"content": "J'ai commandé tous les autres matériaux auprès de diverses sources ou j'ai demandé à d'autres personnes de s'en occuper.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090211
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090211,
					"content": "Mais la bave de Blob a été consommée trop rapidement, contrairement à ce à quoi je m'attendais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090212
					],
					"speakerTitle": "Akim"
				}
			]
		},
