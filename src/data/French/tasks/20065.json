						200650202
					],
					"speakerTitle": "Eileen"
				},
				{
					"id": 200650202,
					"content": "Non, pas encore.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200650203
					]
				},
				{
					"id": 200650203,
					"content": "Les aventuriers que j'ai rencontrés étaient tous pareils.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650204
					],
					"speakerTitle": "Eileen"
				},
				{
					"id": 200650204,
					"content": "Ils sont doués pour se battre contre des monstres, mais quand il s'agit de casser des mannequins...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650205
					],
					"speakerTitle": "Eileen"
				},
				{
					"id": 200650205,
					"content": "Ils vont même jusqu'à renforcer les mannequins, comme si c'était trop facile pour eux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650206
					],
					"speakerTitle": "Eileen"
				},
				{
					"id": 200650206,
					"content": "Si c'est un défi qu'ils cherchent, pourquoi ne pas juste aller affronter un gros méchant monstre dans la nature ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eileen"
