			"dialogs": [
				{
					"id": 200650101,
					"content": "Qu'est-ce que je suis censée faire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650102
					],
					"speakerTitle": "Eileen"
				},
				{
					"id": 200650102,
					"content": "Qu'est-ce qu'il t'arrive ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200650103
					]
				},
				{
					"id": 200650103,
					"content": "Je m'entraîne pour la sélection de l'Ordre de Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650104
					],
					"speakerTitle": "Eileen"
				},
				{
					"id": 200650104,
					"content": "Mais je suis loin d'être aussi puissante que Jean...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650105
					],
					"speakerTitle": "Eileen"
				},
				{
					"id": 200650105,
					"content": "Je pense que je devrais me concentrer davantage sur la technique que sur la force.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650106
					],
					"speakerTitle": "Eileen"
				},
				{
					"id": 200650106,
					"content": "Par exemple, je me demandais comment je pourrais casser tous ces mannequins en un coup...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650107
					],
					"speakerTitle": "Eileen"
				},
				{
					"id": 200650107,
					"content": "Ils sont beaucoup plus résistants qu'ils n'en ont l'air... Je ne sais pas comment mon père les a obtenus, mais ça n'a pas dû être facile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eileen"
				}
