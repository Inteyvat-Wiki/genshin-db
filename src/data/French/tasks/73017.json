			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Arakunti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730170201,
					"content": "Ah ! C'est toi, Arakunti ! On t'a enfin trouvé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170202,
					"content": "Je pourrais ne pas l'être.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170203
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170203,
					"content": "Quoi ? Qu'est-ce que ça signifie ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170204,
					"content": "Je pourrais très bien être les arbres, la pluie, un rêve de la vana ou les cordes d'un instrument de musique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170205
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170205,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170206,
					"content": "#Je n'ai pas compris un mot de ce qu'il vient de dire ! {NICKNAME}, tu comprends, toi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170207,
						730170209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170207,
					"content": "Je n'ai rien compris moi non plus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170208
					]
				},
				{
					"id": 730170208,
					"content": "Je sais ce que chaque mot signifie, mais mis ensemble, ça ne fait aucun sens pour moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170213,
					"content": "#{M#Nara doré}{F#Nara dorée}, petite chose volante, pourquoi me cherchez-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170214
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170214,
					"content": "Je ne suis pas une « petite chose volante » ! Quoique... Ah, et zut ! Bref, je m'appelle « Paimon » !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170215,
					"content": "#{M#Le « nara doré »}{F#La « nara dorée »} a aussi un nom. {M#Il}{F#Elle} s'appelle {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170216,
					"content": "C'est Arapandu qui nous a dit que tu te trouvais dans le Bosquet des rêves. Il nous a demandé de venir te voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170217,
					"content": "Paimon, tu peux dire à Arapandu que je me porte bien, que le Bosquet des rêves va bien et que les rêves d'eau vont bien aussi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170218
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170218,
					"content": "#D'accord... {NICKNAME}, retournons voir Arapandu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170219,
					"content": "Pas du tout ! On est ici pour réparer l'outil varuna ! C'était moins une, on s'est presque fait mener par le bout du nez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170220,
					"content": "#Paimon, tu pourras dire à Arapandu qu'Arakunti n'a pas envie de tenir ton nez{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170221
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170221,
					"content": "Arapandu n'a peut-être pas envie de savoir ça.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170222
					]
				},
				{
					"id": 730170222,
					"content": "Moi non plus ! Qu'est-ce qu'il a à la fin, cet aranara !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170223,
					"content": "Je me souviens qu'Arapandu avait dit quelque chose...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170224
					]
				},
				{
					"id": 730170224,
					"content": "Arapandu nous a dit qu'Arakunti était « farouche vis-à-vis des naras »... Est-ce que ça veut dire qu'il ne sait pas communiquer avec les gens ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170225,
					"content": "C'est nous qui ne savons pas comment communiquer avec les aranaras.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170226
					]
				},
				{
					"id": 730170226,
					"content": "Ah ! Vu comme ça, c'est vrai, on est chez eux... C'est à nous de nous adapter à eux et d'apprendre à communiquer avec eux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170227,
					"content": "Mais maintenant que j'y pense... Quelle est la manière que les aranaras utilisent pour communiquer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170228,
						730170230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170228,
					"content": "Qu'est-ce que tu en penses, petite chose volante ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170229
					]
				},
				{
					"id": 730170229,
					"content": "#Si {M#le nara doré}{F#la nara dorée} ne le sait pas, comment moi, la petite chose volante, puis-je le savoir ? Tant qu'à faire, autant te poser la question, Arakunti !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170233,
					"content": "Arakunti, tu pourrais nous dire comment les aranaras communiquent entre eux ? On veut apprendre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170234,
					"content": "Pourquoi vous voulez apprendre ? Les naras sont les naras, Paimon est Paimon et les aranaras sont les aranaras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170235
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170235,
					"content": "... Oh, j'ai compris ! Paimon, tu veux devenir une graine et être enterrée dans le sol ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170236
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170236,
					"content": "Non ! Pas du tout !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170237,
					"content": "#Et toi, {M#nara doré}{F#nara dorée}, tu veux devenir une graine ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170238,
						730170240
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170238,
					"content": "Non merci.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170239
					]
				},
				{
					"id": 730170239,
					"content": "Les graines, c'est bien. C'est dommage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170242
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170242,
					"content": "À force de parler, on a oublié la raison pour laquelle on était ici : le Festival Utsava !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170243,
					"content": "Pour que le Festival Utsava ait lieu, il faut qu'on répare l'outil varuna afin que le climat revienne à la normale et qu'il n'y ait plus toutes ces satanées spores !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170244,
					"content": "Tu as raison. Il faut le faire pour le Festival Utsava, pour le centre de la Terre bleue !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170245
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170245,
					"content": "Le Bosquet des rêves humide, c'est bien, mais les spores, c'est pas bien. Les champignons qui courent, c'est pas bien non plus, quand il pleut trop, les champignons deviennent difficiles à cuire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170246
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170246,
					"content": "Ouah ! Tu es vraiment lucide !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170247
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170247,
					"content": "#Allons réparer l'outil varuna, nara {NICKNAME} et Paimon. Suivez-moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170240,
					"content": "Si c'est possible, j'aimerais bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170241
					]
				},
				{
					"id": 730170241,
					"content": "Ne dis pas de bêtises ! Il va te prendre au sérieux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170230,
					"content": "Bon... On peut commencer par essayer de parler en métaphores.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170231
					]
				},
				{
					"id": 730170231,
					"content": "#Je vais essayer ! {M#Le nara doré}{F#La nara dorée} est... {M#Il}{F#Elle} est... Euh... Comme l'œuf au plat de Teyvat ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170232,
					"content": "... Demandons à Arakunti !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170209,
					"content": "J'arrive à peu près à deviner.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170210
					]
				},
				{
					"id": 730170210,
					"content": "Super ! Alors, qu'est-ce qu'il a voulu dire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170211,
					"content": "Il dit qu'il peut se transformer en beaucoup d'autres choses !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170212
					]
				},
				{
					"id": 730170212,
					"content": "#C'est vrai ? {NICKNAME}, n'essaye pas de me faire marcher...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170213
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
