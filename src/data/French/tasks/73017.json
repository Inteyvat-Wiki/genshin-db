			"dialogs": [
				{
					"id": 730171001,
					"content": "Les rêves humides, les rêves secs... Ding dong, tic-tac, frou-frou, c'est la chanson de la vana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171002
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171002,
					"content": "#Nara {NICKNAME} ? Les feuilles se trouvent dans les rêves, et la branche est ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
