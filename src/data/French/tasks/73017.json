			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arakunti",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730170401,
					"content": "Les racines d'un grand arbre, c'est bien, on peut entendre une respiration humide, c'est comme une mélodie du sommeil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170402
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170402,
					"content": "Euh... Je ne comprends pas toujours ce que dit Arakunti, mais bon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170403,
					"content": "C'est vraiment énorme à l'intérieur, c'est ça qu'on appelle des racines noueuses ? J'ai l'impression que l'atmosphère ici est différente de celle des autres endroits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170404,
					"content": "C'est ici qu'on va trouver les feuilles qui canalisent l'énergie vers l'outil varuna...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170405,
					"content": "C'est ici, tout en n'étant pas ici. Tu peux les entendre, les sentir, voir leurs nervures, mais tu ne peux pas les trouver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170406
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170406,
					"content": "Ah oui ? Mais pourquoi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170407,
					"content": "Si Paimon ne peut pas les trouver, est-ce que je peux, moi ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170408
					]
				},
				{
					"id": 730170408,
					"content": "#{M#Le nara doré}{F#La nara dorée} peut voir la mélodie, elle ressemble à la brise fraîche de la nuit, aux gouttes d'une pluie soudaine et aux rêves qui se brisent en mille morceaux sur la surface d'un lac.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170409
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170409,
					"content": "À t'entendre, ça a l'air grandiose.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170410
					]
				},
				{
					"id": 730170410,
					"content": "#C'est tout {NICKNAME}, ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170411,
					"content": "Héhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170412
					]
				},
				{
					"id": 730170412,
					"content": "#Héhé... Hé, non ! {NICKNAME}, ne me vole pas mes expressions !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170413,
					"content": "#Nara {NICKNAME} devient Paimon... C'est encore plus effrayant que de danser avec des champignons dans la Marana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170414
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170414,
					"content": "Difficile de s'imaginer une telle chose...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170415
					]
				},
				{
					"id": 730170415,
					"content": "Et c'est pour ça que ça n'arrivera pas ! Ça vaut mieux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170416,
					"content": "Et toi, Arakunti, tu ne peux pas être un peu plus clair ? Où est-ce qu'on doit aller pour trouver les feuilles ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170417,
					"content": "Il faut chercher dans les rêves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170418
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170418,
					"content": "Oh... Une petite minute, pourquoi tu ne nous l'as pas dit dès le départ ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170419,
					"content": "Parce que Paimon a demandé pourquoi, pas où.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170420
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170420,
					"content": "Tiens donc... Je crois avoir réussi à trouver le moyen de communiquer avec les aranaras !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170421,
					"content": "Arakunti, peux-tu nous dire où se trouvent exactement les trois feuilles que nous cherchons ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170422,
					"content": "Oui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170423
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170423,
					"content": "Ouah, il ne répond qu'à des questions directes... Alors, où se trouvent exactement ces trois endroits ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170424,
					"content": "Ici, là-bas et à un autre endroit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170425
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170425,
					"content": "D'accord... Euh, non ! Tu ne nous as rien dit du tout, là !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170426,
					"content": "C'est la grande défaite de Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170427
					]
				},
				{
					"id": 730170427,
					"content": "#La grande défaite de Paimon est aussi celle de {NICKNAME} ! Les indications d'Arakunti ne nous fournissent aucune piste... Comment va-t-on trouver ces trois endroits...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170428,
					"content": "L'outil varuna a été fabriqué par le meilleur des aranaras. Les liens entre les branches et les feuilles sont à la fois visibles et invisibles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170429
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170429,
					"content": "#Nara {NICKNAME}, tu peux voir les aranaras. Si tu peux voir les traces laissées par les aranaras, tu pourras trouver la bonne direction.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170430
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170430,
					"content": "J—Je crois que j'ai compris !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170431,
					"content": "Si on suit leurs empreintes, on devrait pouvoir trouver les aranaras, pas vrai ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170432
					]
				},
				{
					"id": 730170432,
					"content": "Bouhouhou... Tu ne m'as même pas laissé répondre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
