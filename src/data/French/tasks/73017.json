			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Arakunti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730171201,
					"content": "On est de retour !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171202,
					"content": "#Je vous ai {M#entendus}{F#entendues}. Les sanglots se sont transformés en une mélodie douce, mais pour la faire rejoindre le grand flux sonore, il faut encore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171203
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171203,
					"content": "Il faut encore ton aide, Arakunti ! Héhé, on te laisse te charger du reste !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171204,
					"content": "Oui, je sais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171205
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171205,
					"content": "Oh ! Alors il ne devrait pas y avoir de problème, pas vrai ! J'espère qu'on pourra vite réparer l'outil varuna, sinon les Bois d'Apam seront pleins de spores... Rien que d'y penser, j'ai envie de... Atchoum !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171206,
					"content": "Je n'arrive pas à croire que les aranaras ne réagissent pas du tout aux spores... Comment se fait-il qu'ils ne soient pas du tout affectés ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171207,
					"content": "Nous autres, les aranaras, on fait cuire des champignons, donc ce n'est pas qu'on n'est pas affectés. Les spores sont trop petites et nombreuses, c'est difficile de les attraper.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171208
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171208,
					"content": "Quand l'outil marchait bien, il n'y avait pas autant de champignons dans la vana. Donc si on répare l'outil varuna, tout ira mieux. À part la Marana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171209
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171209,
					"content": "Ça va aller.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171210
					]
				},
				{
					"id": 730171210,
					"content": "#Ouais ! {NICKNAME} et moi, on va aider !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171211,
					"content": "On va trouver une solution pour la Marana.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171212
					]
				},
				{
					"id": 730171212,
					"content": "#Nara {NICKNAME}, tu es nara Varuna ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171213
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171213,
					"content": "Hein ? Pourquoi tu demandes ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171214,
					"content": "#Arapandu a dit que nara Varuna était {F#un nara doré et courageux}{M#une nara dorée et courageuse}. Avec les aranaras, {F#il}{M#elle} a réparé l'outil varuna, chassé la pluie noire et la boue, puis ramené la lune et le soleil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171215
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171215,
					"content": "#Nara {NICKNAME} aide aussi les aranaras à guérir l'outil varuna. Puis, tu es aussi {M#doré et courageux}{F#dorée et courageuse}, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171216
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171216,
					"content": "Mais nara Varuna, c'était il y a très longtemps, non...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171217,
					"content": "#Donc nara Varuna n'est pas {M#retournée}{F#retourné} dans la vana ? Et nara {NICKNAME} est {M#un nara complètement différent}{F#une nara complètement différente} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171218
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171218,
					"content": "Est-ce que différents naras peuvent avoir des mélodies similaires ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171219,
						730171220
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171219,
					"content": "Peut-être bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171221
					]
				},
				{
					"id": 730171221,
					"content": "Je n'ai jamais rencontré nara Varuna, mais Arapandu m'en a beaucoup parlé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171222
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171222,
					"content": "#Sa mélodie ressemble beaucoup à celle de nara {NICKNAME}. Quand on l'entend, ça rend heureux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171223
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171223,
					"content": "#Tout à fait, je suis toujours très heureuse avec {NICKNAME} ! Si un jour {NICKNAME} me quitte, de la même manière que nara Varuna a quitté la forêt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171224,
					"content": "*sniff* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171225,
					"content": "#Arapandu est sûrement en train de nous attendre au point de repos. Nara {NICKNAME}, retournes-y avec moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171226,
						730171228
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171226,
					"content": "Allons-y.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171227
					]
				},
				{
					"id": 730171227,
					"content": "Oui, allons-y ensemble !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171228,
					"content": "Mais j'ai encore à faire ici...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171229
					]
				},
				{
					"id": 730171229,
					"content": "C'est pas grave, Arakunti peut rentrer tout seul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171220,
					"content": "Je ne sais pas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171221
					]
				}
			]
		}
	]
