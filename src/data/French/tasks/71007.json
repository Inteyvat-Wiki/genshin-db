			"dialogs": [
				{
					"id": 710070101,
					"content": "Alors, cette peinture ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710070102
					]
				},
				{
					"id": 710070102,
					"content": "J'ai peint à côté des statues depuis le moment où leurs yeux se sont allumés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070103
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070103,
					"content": "Mais... Comment dire... J'ai le sentiment de n'avoir pas réussi à peindre la peinture que je voulais peindre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070104
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070104,
					"content": "Comme s'il manquait quelque chose... Je ne sais pas si tu me comprends ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070105
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070105,
					"content": "Un peu comme un plat qu'on cuisine en respectant la recette et les ingrédients, mais auquel il manque malgré tout un petit quelque chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070106
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070106,
					"content": "*soupir* Je n'arrive pas à exprimer ce sentiment correctement... Tout ce que je sais faire, c'est peindre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070107
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070107,
					"content": "Hahaha, tu peux te moquer, si tu veux. J'ai la tête qui tourne à force de peindre. J'aurais bien pris une pause, mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070108
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070108,
					"content": "À chaque fois que je ferme les yeux, je peux voir les yeux des statues briller, comme si elles me regardent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070109
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070109,
					"content": "C'est pour ça que je suis venu par ici me reposer, les yeux des statues ne devraient pas se voir d'ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070110
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070110,
					"content": "Ah oui, tiens, je t'offre cette toile. C'est une de mes plus belles je trouve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070111
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070111,
					"content": "Si ça ne t'ennuie pas maintenant, j'aimerais me reposer un moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070112
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070112,
					"content": "Mais je me demande quand même... Qu'est-ce qu'il manque à mes peintures...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
		}
	]
}