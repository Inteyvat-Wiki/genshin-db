	"talks": [
		{
			"id": 301101,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301101",
							"2"
						],
						"stepId": 301101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30110101,
					"content": "... On est toujours le même jour !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110102,
					"content": "Comme prévu, ce n'est pas aussi simple qu'on le pensait.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110103
					]
				},
				{
					"id": 30110103,
					"content": "Nahida, vous saviez déjà hier soir qu'on n'avait pas réussi à s'échapper du samsara ! Pourquoi vous ne nous avez rien dit ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110104,
					"content": "Quel intérêt ? Tout ce que cela t'aurait apporté, c'est une nouvelle nuit d'angoisse, et le lendemain aurait été tout aussi insaisissable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110105
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110105,
					"content": "Donc autant... vous laisser vous reposer dans ce moment d'espoir fugace. Ce sont des occasions rares, mais elles permettent de se vider l'esprit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110106
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110106,
					"content": "Hmm, c'est vrai... Nahida, vous veillez toujours si bien sur nous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110107,
					"content": "Bien sûr. Après tout, du moins ces derniers temps, vous êtes tout ce que j'ai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110108
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110108,
					"content": "Attendez... Qu'est-ce que ça veut dire ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110109,
					"content": "#Héhéhé... Ce que je veux dire, c'est que même si c'est moi qui vous ai demandé de résoudre cette énigme, vous êtes toujours les {M#seuls}{F#seules} à pouvoir me voir et sentir ma présence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110110
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110110,
					"content": "En d'autres termes, si vous n'étiez pas là, je pourrais aussi bien ne pas exister. C'est pourquoi vous deux avez été tout pour moi. Vous comprenez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110111
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110111,
					"content": "C'est un peu confus ce dont parle Nahida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110112,
					"content": "#Bref, assez bavardé. Alors, {M#voyageur}{F#voyageuse}, les nouveaux indices d'hier t'ont-ils {M#aidé}{F#aidée} à mieux comprendre la situation ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110113
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110113,
					"content": "La théorie de la boucle temporelle est en effet incorrecte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110114
					]
				},
				{
					"id": 30110114,
					"content": "Hein ? Pourquoi abandonner ta précédente théorie ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110115,
						30110116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110115,
					"content": "Dehya s'est améliorée au combat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110117
					]
				},
				{
					"id": 30110117,
					"content": "#Oh oui, tu as raison. Comment on est {M#passés}{F#passées} à côté de ça ? Dans une boucle temporelle, la condition physique devrait simplement se réinitialiser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110118,
					"content": "Alors, quelle est ta nouvelle hypothèse ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110116,
					"content": "La maladie de Dunyarzad s'est également aggravée...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110117
					]
				}
			]
		},
		{
			"id": 301102,
			"completionStepIds": [
				301102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301102",
							"2"
						],
						"stepId": 301102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dehya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30110201,
					"content": "... Vous voilà enfin. Ça m'a pris du temps pour vous trouver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110202
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110202,
					"content": "Comme prévu, Dehya n'a pas non plus été blessée aujourd'hui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110203,
					"content": "Blessée ? Pourquoi ça ? Ne me sous-estimez pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110204
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110204,
					"content": "Eh bien, vous devez encore vous habituer à votre nouvelle lame...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110205,
					"content": "Pour dire la vérité, je trouve ça aussi assez étrange. Elle m'a soudainement parue familière... Attendez une seconde, comment vous savez que j'ai une nouvelle épée ? Je n'en ai parlé à personne...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110206
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110206,
					"content": "#{NICKNAME}, est-ce que tu peux expliquer la situation ? J'en ai un peu marre de le faire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110207,
						30110208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110207,
					"content": "On n'a pas besoin de tout expliquer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110209
					]
				},
				{
					"id": 30110209,
					"content": "Oh, ça marche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110210,
					"content": "Vous êtes soudainement devenue plus à l'aise avec votre épée parce que...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110211,
						30110212
					]
				},
				{
					"id": 30110211,
					"content": "Nous revivons plusieurs fois le même jour.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110213
					]
				},
				{
					"id": 30110213,
					"content": "... Qu'est-ce qui vous est arrivé pendant que j'étais partie ? Vous avez subi un lavage de cerveau ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110214
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110214,
					"content": "Hmm, ne vous posez pas trop de questions. Prenez juste ce qu'on vous dit pour argent comptant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110215,
					"content": "... D'accord. Si je vous comprends bien, vous êtes en train de me dire que mon corps s'est déjà habitué à cette épée, mais que mon cerveau ne s'en souvient pas, c'est ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110216
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110216,
					"content": "Oui, votre mémoire est effacée tous les jours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110217,
					"content": "Eh bien, je me dois d'objecter. Ce n'est pas possible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110218
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110218,
					"content": "Hein ? Comment ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110219,
					"content": "Si on a réellement revécu le Festival Sabzeruz jour après jour, qu'est-il arrivé aux objets qu'on a utilisés, à l'argent qu'on a dépensé et à la nourriture qu'on a mangée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110220
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110220,
					"content": "Le bon sens me dit que mon portefeuille aurait dû se vider depuis longtemps. C'est impossible que je ne l'aie pas remarqué.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110221
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110221,
					"content": "J'y ai pensé aussi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110222,
						30110223
					]
				},
				{
					"id": 30110222,
					"content": "Mais si les sages sont derrière tout ça...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110224
					]
				},
				{
					"id": 30110224,
					"content": "Oui... Ils peuvent utiliser l'Akasha pour enregistrer ce que chacun a fait ce jour-là, puis utiliser les ressources de la ville pour tout reconstituer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110225,
					"content": "C'est peu probable, mais ce n'est pas totalement impossible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110226,
					"content": "Non, c'est impossible. J'ai des preuves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110227
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110227,
					"content": "Des preuves ? Où ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110228,
					"content": "#*soupir* Vous êtes étonnamment {M#sérieux}{F#sérieuses} vu l'absurdité de la discussion. Bien, je vais continuer à jouer le jeu encore un peu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110229
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110229,
					"content": "Venez avec moi. Mademoiselle Dunyarzad, venez aussi, s'il vous plaît. Je ne peux toujours pas garantir que cette zone soit sûre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110223,
					"content": "S'ils utilisent toutes les ressources de la ville et les informations de l'Akasha...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110224
					]
				},
				{
					"id": 30110212,
					"content": "Et nos souvenirs de la journée sont effacés chaque nuit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110213
					]
				},
				{
					"id": 30110208,
					"content": "Allons droit au but.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110209
					]
				}
			]
		},
		{
			"id": 301103,
			"completionStepIds": [
				301103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301103",
							"2"
						],
						"stepId": 301103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dehya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30110301,
					"content": "Voici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110302
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110302,
					"content": "Hein ? C'est un mannequin d'entraînement en bois, non ? Et alors ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110303,
					"content": "Vous voyez ces marques sur le mannequin ? Elles sont le résultat de plusieurs jours d'entraînement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110304
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110304,
					"content": "Admettons que les sages ne le remplacent pas tous les jours, ne devrait-il pas être réduit en miettes à l'heure qu'il est ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110305
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110305,
					"content": "C'est exact, mais s'ils l'avaient fait ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110306,
					"content": "Alors les sages auraient dû reproduire toutes les marques que j'ai laissées lors des sessions d'entraînement précédentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110307
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110307,
					"content": "Je suis une artiste martiale et mon école a toujours insisté sur l'importance du contrôle des mouvements.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110308
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110308,
					"content": "La force, l'angle et le point d'entrée de chaque coup sont calculés délibérément. C'est pourquoi je me souviens de chaque marque sur le mannequin, ainsi que de mon état d'esprit lors de chaque frappe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110309
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110309,
					"content": "On dit que chaque épéiste possède un style unique, et que le même épéiste ne peut pas porter deux fois le même coup. Il serait impossible de copier ces marques.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110310
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110310,
					"content": "C'est vraiment impossible ? Et s'ils avaient utilisé une machine sophistiquée pour graver chaque marque ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110311,
					"content": "Les gens disent souvent qu'une photo prise par un Daguerréotype ne pourra jamais remplacer une peinture faite par un artiste car elle n'a pas d'âme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110312
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110312,
					"content": "C'est la même chose ici. D'un simple coup d'œil, je peux différencier des marques qui résultent d'un entraînement au combat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110313,
						30110314
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110313,
					"content": "... Ça a du sens.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110315
					]
				},
				{
					"id": 30110315,
					"content": "#Ouf... Les choses sont plus claires pour vous à présent ? Hé, vous connaissez ce jeu, le Cérébrexercice, super populaire auprès des chercheurs de nos jours{NON_BREAK_SPACE}? C'est étonnamment amusant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110316
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110316,
					"content": "Bon, il se fait tard. Je ferais mieux d'aller escorter mademoiselle Dunyarzad au spectacle de Nilou. À plus tard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110317
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110317,
					"content": "*soupir* Retour à la case départ. Notre théorie de la suppression de la mémoire est-elle également fausse ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110318,
					"content": "#Mais au moins, on est {M#arrivés}{F#arrivées} à d'autres conclusions, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110319,
						30110320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110319,
					"content": "On n'est pas dans une boucle temporelle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110321
					]
				},
				{
					"id": 30110321,
					"content": "Oui, c'est vrai. Alors maintenant... on peut trouver de nouvelles idées ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110322,
						30110323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110322,
					"content": "Réfléchissons...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110324
					]
				},
				{
					"id": 30110324,
					"content": "Quelque chose d'étrange ? Pour moi, tout est étrange dernièrement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110325,
					"content": "Comment se fait-il... qu'on n'ait jamais pensé à quitter la ville ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110326
					]
				},
				{
					"id": 30110326,
					"content": "Hein ? Quitter la ville... Tu as raison ! C'est vraiment étrange qu'on n'ait jamais pensé à une solution aussi simple. Beaucoup de choses devraient être plus claires si on peut confirmer l'écoulement du temps en dehors de la ville.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110327,
					"content": "#Je n'arrive pas à le croire... Est-ce qu'on est {M#passés}{F#passées} à côté de ça parce qu'on était trop {M#focalisés}{F#focalisées} sur nos hypothèses, ou qu'on était trop {M#fatigués}{F#fatiguées}{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110328,
						30110329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110328,
					"content": "C'est vraiment bizarre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110330
					]
				},
				{
					"id": 30110330,
					"content": "Et si on retournait demander à Nahida ? Il y a peut-être quelque chose qui nous échappe à propos du fait de quitter la ville.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110329,
					"content": "On aurait dû y penser il y a longtemps.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110330
					]
				},
				{
					"id": 30110323,
					"content": "J'ai eu soudain l'impression de quelque chose d'étrange...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110324
					]
				},
				{
					"id": 30110320,
					"content": "On n'est pas dans le monde réel.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110321
					]
				},
				{
					"id": 30110314,
					"content": "On dirait qu'on va devoir abandonner cette hypothèse...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110315
					]
				}
			]
		},
		{
			"id": 301104,
			"completionStepIds": [
				301104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301104",
							"2"
						],
						"stepId": 301104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30110401,
					"content": "Nahida, on est de retour !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110402,
					"content": "Vous arrivez tôt aujourd'hui. Vous avez trouvé du nouveau ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110403
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110403,
					"content": "#D'une certaine façon. On est presque {M#sûrs}{F#sûres} maintenant qu'on n'est pas dans une boucle temporelle, et qu'on n'est pas non plus dans le monde réel. Mais en même temps, on a une nouvelle question...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110404,
						30110405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110404,
					"content": "Que se passera-t-il si on essaye de quitter la ville ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110406
					]
				},
				{
					"id": 30110406,
					"content": "Quitter la ville... Selon mes souvenirs, vous en avez déjà parlé deux fois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110407
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110407,
					"content": "!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110408
					]
				},
				{
					"id": 30110408,
					"content": "#Vraiment ? Mais on n'en a pas le moindre souvenir ! Qu'est-ce qui s'est passé après qu'on en a parlé ? Qu'avons-nous dit quand on est {M#rentrés}{F#rentrées}{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110409,
					"content": "#Laissez-moi réfléchir... Je ne pense pas que vous m'ayez dit ce qu'il en était. Oh, il est probablement plus exact de dire que vous n'êtes jamais {M#revenus}{F#revenues} ces deux nuits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110410
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110410,
					"content": "Mais vous restez parfois dehors toute la nuit, alors à l'époque, je n'y avais pas prêté attention.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110411
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110411,
					"content": "#C'est vrai qu'on perd parfois un peu la notion du temps pendant qu'on enquête. Et avant qu'on s'en rende compte, c'est déjà le lendemain. Mais quand même... {M#Aucun}{F#Aucune} de nous ne se souvient avoir quitté la ville.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110412,
					"content": "Vraiment ? C'est bizarre. En théorie, je devrais déjà avoir réveillé tous vos souvenirs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110413,
						30110414
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110413,
					"content": "Réessayons demain.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110415
					]
				},
				{
					"id": 30110415,
					"content": "Oui ! Il y a quelque chose de louche là-dedans. Il faudra approfondir tout ça demain !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110416,
					"content": "*bip* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110414,
					"content": "Peut-être que c'est la clé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110415
					]
				},
				{
					"id": 30110405,
					"content": "Avons-nous déjà essayé de quitter la ville ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110406
					]
				}
			]
		},
