			"dialogs": [
				{
					"id": 30111113,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111101,
						30111102
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30111101,
					"content": "On n'est pas dans une boucle temporelle...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30111103
					]
				},
				{
					"id": 30111103,
					"content": "Ooh ! Alors le bip qu'on entend chaque nuit pourrait juste indiquer la suppression de nos souvenirs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30111104,
					"content": "C'est pour ça qu'au réveil, tout le monde pense que le Festival Sabzeruz n'a pas encore eu lieu. C'est déjà le lendemain, mais tout le monde pense qu'on est encore le jour d'avant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30111105,
					"content": "Mais la mémoire musculaire ne peut pas être effacée. C'est pourquoi Dehya est devenue de plus en plus efficace avec son espadon ! Tout prend son sens !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30111106,
					"content": "... Hm, brillante déduction.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111107
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30111107,
					"content": "Nahida, dites-nous si on a raison ou pas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30111108,
					"content": "Pour dire les choses simplement, c'est un peu comme si vous aviez confondu un papillon cristallin Pyro avec une luciole dans la nuit. Vous avez perdu de vue sa vraie nature en vous concentrant sur l'idée que les deux brillent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111109
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30111109,
					"content": "C'est pas simple du tout...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30111110,
					"content": "#On s'est encore {M#trompés}{F#trompées}, hein...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30111111
					]
				},
				{
					"id": 30111111,
					"content": "Pourquoi ne pas retourner parler à mademoiselle Dehya ? Vous pourriez apprendre quelque chose de nouveau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111112
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30111112,
					"content": "#C'est vrai... Elle nous a {M#aidés}{F#aidées} à trouver le dernier indice, après tout. Allons-y !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30111102,
					"content": "Ce sont nos souvenirs qui sont effacés à la fin de chaque journée.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30111103
					]
				}
			]
		},
