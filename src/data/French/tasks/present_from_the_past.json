			"dialogs": [
				{
					"id": 110040301,
					"content": "J'ai trouvé un Arbre congelé, et je vais le cuisiner... ♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040302
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110040302,
					"content": "Encore meilleur, quand on l'aura assaisonné... ♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040303,
						110040305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110040303,
					"content": "Arrête de jouer son jeu !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110040304
					]
				},
				{
					"id": 110040304,
					"content": "Détends-toi un peu ! Quoi de plus merveilleux que de trouver des ingrédients rares ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040307
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110040307,
					"content": "Ah, il y a quelque chose par ici !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040308
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110040308,
					"content": "Ça doit être le sanglier que le chasseur poursuivait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110040309,
					"content": "Je n'ai jamais vu de sanglier comme lui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110040310,
					"content": "Ah, mais si ! Je m'en souviens ! C'était dans « Histoire naturelle de Liyue » !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040311
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110040311,
					"content": "Ce motif... Il n'y a aucun doute possible ! Ce sanglier appartient à une espèce éteinte depuis 300 ans !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040312
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110040312,
					"content": "Hein ?! Comment ça se fait que celui-là vive encore ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040313,
						110040315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110040313,
					"content": "Parce qu'il a été gelé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110040314
					]
				},
				{
					"id": 110040314,
					"content": "C'est plausible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110040317,
					"content": "J'ai lu que l'extinction de cette espèce a été provoquée par la chasse intensive. La viande de ces sangliers était vraiment prisée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040318
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110040318,
					"content": "De l'Arbre congelé, et du sanglier d'une espèce éteinte... La récolte a été bonne !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040319
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110040319,
					"content": "La victoire est à nous !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110040320
					]
				},
				{
					"id": 110040320,
					"content": "Rentrons à Deauclaire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110040315,
					"content": "Parce que son espérance de vie est exceptionnellement longue ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110040316
					]
				},
				{
					"id": 110040316,
					"content": "C'est de l'abus à ce niveau !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110040305,
					"content": "Et qu'on l'aura fait sauté... ♪",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110040306
					]
				},
				{
					"id": 110040306,
					"content": "Hahaha ! C'est pas encore ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040307
					],
					"speakerTitle": "Xiangling"
				}
			]
		}
	]
