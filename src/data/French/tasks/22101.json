			"dialogs": [
				{
					"id": 221010201,
					"content": "Vous avez terminé ? Il n'y a plus de monstres ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010202
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010202,
					"content": "Pas encore.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221010203
					]
				},
				{
					"id": 221010203,
					"content": "Prenez votre temps. Les monstres dérangent nos hôtes à l'extérieur, mais ils n'oseraient jamais mettre un pied dans l'auberge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010204
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010204,
					"content": "Je les... hum, persuaderais très gentiment de partir si c'était le cas. Mes hôtes ne risquent rien avec moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010205
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010205,
					"content": "Personne ne dirige une auberge sans connaître quelques rudiments de combat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
