			"trigger": {
				"objectNames": [
					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721160101,
					"content": "Cela va prendre encore un peu de temps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160102
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160102,
					"content": "Avez-vous réussi à obtenir les données nécessaires ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160103
					]
				},
				{
					"id": 721160103,
					"content": "Ah, c'est vous ! Formidable. Je n'ai pas encore réussi à collecter toutes les données dont j'avais besoin. Je pense que cela va prendre un peu plus de temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160104
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160104,
					"content": "Ceci dit, j'en ai profité pour réfléchir à la structure du purificateur d'urgence...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160105,
						721160107
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160105,
					"content": "C'est quoi le purificateur d'urgence ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160106
					]
				},
				{
					"id": 721160106,
					"content": "Juste une petite astuce de dernière minute.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160109
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160109,
					"content": "Selon le plan dont nous avons discuté précédemment, nous devons faire face aux Fatui et au Tatarigami en même temps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160110
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160110,
					"content": "Je suis confiant que vous pourrez vous occuper des Fatui, et moi, bien sûr, je devrai me charger de l'énergie du Tatarigami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160111
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160111,
					"content": "Ce purificateur d'urgence a pour but de s'occuper du Tatarigami, mais pour créer cet instrument, j'ai encore besoin de votre aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160112,
						721160113
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160112,
					"content": "De quelle manière ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160117
					]
				},
				{
					"id": 721160117,
					"content": "Nous aurons besoin de certains matériaux spéciaux pour garantir que cet appareil fonctionne correctement dans le Fourneau Mikage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160118
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160118,
					"content": "La moelle cristalline, qui contient le pouvoir inerte du Tatarigami, est très appropriée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160119
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160119,
					"content": "En vérité, le secret du fameux tamahagane réside dans le fait de fondre l'acier en y ajoutant ce matériau à l'aide d'une méthode spéciale pour augmenter la résistance de l'acier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160120
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160120,
					"content": "Bien entendu, c'est un secret de fabrication.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160121
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160121,
					"content": "Si ma mémoire est bonne, ce minerai cristallin devrait se trouver dans les environs. Pourriez-vous m'aider à en obtenir trois morceaux, s'il vous plaît ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160122
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160122,
					"content": "Je m'en charge.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160123
					]
				},
				{
					"id": 721160123,
					"content": "Eh bien, je vous remercie. Apportez-moi trois morceaux de moelle cristalline dès que vous mettrez la main dessus !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160113,
					"content": "Je pensais que vous lui donneriez un nom plus officiel...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160114
					]
				},
				{
					"id": 721160114,
					"content": "Pourquoi, c'est son nom officiel : « purificateur d'urgence » !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160115
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160115,
					"content": "À moins que... vous parliez du numéro et de la date de fabrication ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160116
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160116,
					"content": "Eh bien, étant donné qu'il s'agit d'un dispositif d'urgence, nous n'avons pas besoin de telles informations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160117
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160107,
					"content": "Cela fait partie des « mesures d'urgence » ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160108
					]
				},
				{
					"id": 721160108,
					"content": "On peut dire ça... Bien que je fournisse rarement ce genre d'aide à mes clients habituellement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160109
					],
					"speakerTitle": "Xavier"
				}
			]
		},
