						750190753
					],
					"speakerTitle": "Uchu"
				},
				{
					"id": 750190753,
					"content": "Bonne chance, à bientôt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190746,
					"content": "Tu peux vraiment encore grandir, Paimon ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190747
					]
				},
				{
					"id": 750190747,
					"content": "Bien sûr ! Tu vas voir, je serai aussi grande que trois montagnes avant que tu ne te rendes compte de quoi que ce soit !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190748
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190712,
					"content": "Vous n'étiez pas mal non plus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190713
					]
				},
				{
					"id": 750190713,
					"content": "Haha, ce n'est pas la peine de me complimenter comme ça. Maintenant, si j'étais plus jeune, qui sait comment ça aurait pu se passer ? Ah, comme j'aurais aimé pouvoir vous affronter à ce moment-là.",
