			},
			"dialogs": [
				{
					"id": 750190301,
					"content": "... Nous ne pouvons même pas en discuter ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190302
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190302,
					"content": "Manqu, regarde-moi. N'as-tu pas entendu ce que Titu a dit ? Personne n'a tenté cet exploit depuis près de 500 ans.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190303
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190303,
					"content": "Même si tu prétends avoir trouvé une entrée potentielle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190304
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190304,
					"content": "Et alors ? Écoute-moi bien : aucun humain ni compagnon saurien qui a emprunté cette voie n'en est jamais revenu. Pas un seul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190305
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190305,
					"content": "Euh, pardonnez ma franchise, mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190306
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190306,
					"content": "Voilà notre gars de l'Association des reliques. Et là-bas... C'est le chef tribal ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190307,
					"content": "Hé ! Le monsieur des reliques !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190308,
					"content": "#Ah, c'est vous, {NICKNAME}... Paimon et {REALNAME[ID(2)|SHOWHOST(true)]}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190309
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190309,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190310
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190310,
					"content": "Waouh, un tepetlisaure avec un foulard rouge sur la queue ! Il déborde d'énergie et semble différent dès le premier coup d'œil ! Allez mon petit, encore une fois !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190311
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190311,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190312
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190312,
					"content": "#Pas mal ! Alors tu es {REALNAME[ID(2)|SHOWHOST(true)]} ? Et je suppose que ça fait de vous deux {M#ceux}{F#celles} qu'il a {M#choisis}{F#choisies}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190313
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190313,
					"content": "#{NICKNAME} et Paimon, on dirait que vos noms sont sur toutes les lèvres ces derniers temps. Manqu n'a pas arrêté de parler de vous, et Titu vous a {M#mentionnés}{F#mentionnées} à son retour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190314
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190314,
					"content": "#Il ne serait pas exagéré de qualifier vos récents actes de « légendaires », et jusqu'à présent, vous avez été de {M#vrais amis}{F#vraies amies} pour nous, les Enfants des échos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190315,
						750190316
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190315,
					"content": "Pas besoin d'en faire autant.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190317
					]
				},
				{
					"id": 750190317,
					"content": "#Haha, {M#quel jeune homme}{F#quelle jeune femme} extraordinaire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190318
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190318,
					"content": "#Et c'est à ce titre, Manqu, que je t'ai déjà dit que ça ne se faisait pas d'entraîner nos {M#invités}{F#invitées} dans un gouffre de feu simplement pour prouver une hypothèse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190319
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190319,
					"content": "#Ce n'est en tout cas pas comme ça que je traiterais mes {M#invités}{F#invitées}, moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190320
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190320,
					"content": "*soupir* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190321
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190321,
					"content": "De quoi parlez-vous ? Quelque chose à propos de danger et d'un gouffre de feu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190322,
					"content": "Désolé, laissez-moi vous expliquer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190323
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190323,
					"content": "Vous vous souvenez de ce dont nous avons parlé précédemment ? Pour retirer la marque de la bénédiction du seigneur des flammes, vous devez apporter les deux types de jetons requis au volcan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190324
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190324,
					"content": "L'un des jetons se trouve dans les ruines au-delà des terres des Enfants des échos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190325
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190325,
					"content": "Il y a cependant des conditions à remplir pour entrer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190326
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190326,
					"content": "D'après une coutume ancienne... que je viens tout juste de trouver sur un rouleau tissé, d'ailleurs, car ça fait des siècles que personne n'a eu envie de s'y essayer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190327
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190327,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190328
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190328,
					"content": "Si vous souhaitez emmener votre compagnon saurien au volcan en vue d'un rituel de purification de la bénédiction du seigneur des flammes, vous devez obtenir l'approbation du chef tribal à laquelle appartient le saurien concerné...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190329
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190329,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190330
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190330,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190331
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190331,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190332,
					"content": "#Puisque {REALNAME[ID(2)|SHOWHOST(true)]} est un tepetlisaure, ça signifie le chef des Enfants des échos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190333
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190333,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190334,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190335
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190335,
					"content": "Mais, c'est vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190336,
					"content": "#Eh bien, oui, mais pour être honnête, je ne sais pas si cette règle s'applique aux étrangers. Enfin, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190337
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190337,
					"content": "Depuis des centaines d'années, nombreux sont ceux qui ont tenté de libérer leur compagnon saurien de cette malédiction qui touche leur lignée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190338
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190338,
					"content": "Mais pas un seul n'a réussi... C'est pourquoi les tribus ont peu à peu abandonné la coutume...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190339
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190339,
					"content": "Pas un seul ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190340
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190340,
					"content": "Oui, le voyage est à ce point dangereux. On dit aussi que l'épreuve permettant d'obtenir le jeton mettra à l'épreuve non seulement le guerrier qui s'avancera, mais aussi son compagnon saurien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190341
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190341,
					"content": "Bien que vous ne fassiez pas partie de la tribu, je ne veux pas que vous mouriez en vain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190342
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190342,
					"content": "#Alors s'il vous plaît {NICKNAME}, je vous suggère de laisser {REALNAME[ID(2)|SHOWHOST(true)]} ici avec nous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190343
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190343,
					"content": "Je veillerai à ce qu'on prenne bien soin de lui jusqu'à ce qu'il soit temps pour lui d'entrer au Fief nocturne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190344
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190344,
					"content": "Mais... si nous faisons ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190345
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190345,
					"content": "#... Comme je l'ai dit, {REALNAME[ID(2)|SHOWHOST(true)]} ne pourra pas grandir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190346
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190346,
					"content": "Raouh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190347
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190347,
					"content": "On dirait que ce n'est pas ce qu'il veut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190348
					]
				},
				{
					"id": 750190348,
					"content": "Je veux essayer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190349
					]
				},
				{
					"id": 750190349,
					"content": "Malgré l'immense péril ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190350
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190350,
					"content": "Oui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190351
					]
				},
				{
					"id": 750190351,
					"content": "Et toi, petit gaillard ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190352
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190352,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190353
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190353,
					"content": "Haha ! Inflexible et résolu, mais passionné. Vos cœurs sont chaleureux comme du phlogistique de qualité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190354
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190354,
					"content": "Très bien. Alors, je vous autorise à effectuer le pèlerinage au volcan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190355
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190355,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190356
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190356,
					"content": "Super ! Allons chercher ce premier jeton !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190357
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190357,
					"content": "#Non, pas encore. Maintenant que vous êtes {M#qualifiés}{F#qualifiées}, vous devez réussir l'épreuve de témoin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190358
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190358,
					"content": "Selon les coutumes anciennes, le guerrier et son compagnon saurien doivent obtenir ensemble la plume d'un quetzal vert du fond des bois et offrir une étole de peaux d'animaux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190359
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190359,
					"content": "Et ensemble, vous devez remporter cinquante batailles pour notre tribu, et offrir quatre-vingt-seize gemmes de grande qualité...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190360,
						750190361
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190360,
					"content": "Euh, je n'aurais pas droit à...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190362
					]
				},
				{
					"id": 750190362,
					"content": "Allez, Manqu, oublie ça. De quand datent ces traditions ? Un âge de pierre révolu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190363
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190363,
					"content": "Le but de ces formalités était de favoriser le lien entre l'humain et le saurien et qu'ils perfectionnent leurs compétences... Mais c'est du passé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190364
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190364,
					"content": "#De plus, ni {NICKNAME} ni {REALNAME[ID(2)|SHOWHOST(true)]} ne semblent avoir besoin de ce genre de preuve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190365
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190365,
					"content": "#Pour dire les choses simplement, {NICKNAME}, nous avons ici à Natlan un moyen très simple de gérer de telles situations...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190366
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190366,
					"content": "Combattez-moi et montrez-moi ce que vous avez dans le ventre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190367
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190367,
					"content": "Et comment !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190368
					]
				},
				{
					"id": 750190368,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190369
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190369,
					"content": "Attendez, ici ? Oh, vous voulez dire sur scène ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190370
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190370,
					"content": "Bien sûr que non, haha, la scène n'est pas du tout prévue à cet effet... Nos arènes se trouvent dans la montagne à l'arrière.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190371
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190371,
					"content": "Allons-y, direction la montagne pour montrer ce que vous valez !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190361,
					"content": "Est-ce que vous pourriez me faire une réduction ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190362
					]
				},
				{
					"id": 750190316,
					"content": "",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190317
					]
				}
			]
		},
		{
			"id": 7501906,
