					"Manqu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750190601,
					"content": "#Encore une fois, pardonnez ma franchise... Mais même si je suis conscient de votre force, soyez {M#prudents}{F#prudentes}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190602
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190602,
					"content": "Il n'a pas obtenu d'antique nom, mais Pacal n'est pas à prendre à la légère pour autant... À condition qu'il ait continué à s'entraîner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190603
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190603,
					"content": "#Si vous êtes {M#prêts}{F#prêtes}, nous pouvons commencer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manqu"
				}
			]
		},
		{
			"id": 7501907,
