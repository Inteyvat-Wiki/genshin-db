			},
			"dialogs": [
				{
					"id": 750190701,
					"content": "Génial ! Nous avons gagné !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190702,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190703
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190703,
					"content": "*soupir* Je pense que même le meilleur guerrier de notre tribu ne pourrait pas vous vaincre... C'était en effet une défaite retentissante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190704
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190704,
					"content": "Qu'est-ce que tu en penses, hein, mon pote ? On dirait que nous avons besoin de plus d'entraînement !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190705
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190705,
					"content": "Mmmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190706
					],
					"speakerTitle": "Uchu"
				},
				{
					"id": 750190706,
					"content": "C'était en effet un duel remarquable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190707
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190707,
					"content": "De bien jolis mots, Manqu, mais est-ce tout ce que tu as ? Tu veux peut-être essayer aussi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190708
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190708,
					"content": "Non, merci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190709
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190709,
					"content": "#Bouh... Quel ennui. Ah, c'était un super match ! {NICKNAME}... Vous êtes redoutable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190710,
						750190712
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190710,
					"content": "J'étais juste en train de m'échauffer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190711
					]
				},
				{
					"id": 750190711,
					"content": "#Haha ! Et {M#arrogant}{F#arrogante} en plus ! Mais j'apprécie votre attitude. Les plus forts devraient aussi affirmer un peu leur domination ! Sinon, quel intérêt y aurait-il à devenir fort ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190714
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190714,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190715
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190715,
					"content": "#Haha, on dirait qu'on prend vraiment bien soin de toi, {REALNAME[ID(2)|SHOWHOST(true)]}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190716
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190716,
					"content": "#Bien sûr ! {REALNAME[ID(2)|SHOWHOST(true)]} est notre fidèle compagnon, vous savez !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190717,
					"content": "Et c'est très bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190718
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190718,
					"content": "Comme promis, voici la preuve de votre accomplissement de la part d'un chef tribal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190719
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190719,
					"content": "Quant à son nom officiel, eh bien, Manqu, à toi de jouer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190720
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190720,
					"content": "Le talisman de Waxaklahun Ubah Kan... Le Sage de la flamme dérobée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190721
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190721,
					"content": "Je n'arrive jamais à mémoriser ce nom, mais je me souviens qu'à la mort du roi-dragon Pyro, et après que le premier Archon Pyro a été ressuscité des flammes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190722
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190722,
					"content": "Le Sage et l'Archon ont chacun rapporté un jeton du volcan, et quiconque réunit les deux peut entrer dans le feu purificateur du volcan et purger toutes les malédictions et les calamités.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190723
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190723,
					"content": "Combien de temps ce Sage a-t-il vécu, Manqu ? J'ai l'impression qu'il y a des histoires sur lui de l'époque tribale à celle d'Ochkanatlan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190724
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190724,
					"content": "... Et même à l'époque de l'épingle d'ombre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190725
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190725,
					"content": "Eh bien, il a été le premier humain à utiliser du phlogistique... Et qui sait quel fut le sort de ces personnages légendaires ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190726
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190726,
					"content": "Certains disent que son corps et son esprit se sont transformés en phlogistique, ne faisant plus qu'un avec les vents, les terres et les fleurs de Natlan, lui accordant le pouvoir d'entendre toutes les prières qui lui sont adressées par les tribus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190727
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190727,
					"content": "Certains disent que chaque époque a eu son propre successeur au titre de Sage, et que ça continue aujourd'hui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190728
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190728,
					"content": "Mais, et excusez ma franchise, ce sont pour la plupart des spéculations de conteurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190729
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190729,
					"content": "Haha. Fais attention à ce que tu dis, tu vas encore mettre Titu en colère.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190730
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190730,
					"content": "Bon, ma tâche ici est terminée. Oh, la coutume exige encore une chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190731
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190731,
					"content": "Et c'est d'accorder ma bénédiction à l'âme courageuse qui va tenter sa chance ainsi qu'à son compagnon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190732
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190732,
					"content": "Hmm ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190733
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190733,
					"content": "Oh, encore un rituel ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190734,
					"content": "Héhé, c'est juste un peu de soutien moral.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190735
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190735,
					"content": "#Alors, {NICKNAME} et {REALNAME[ID(2)|SHOWHOST(true)]}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190736
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190736,
					"content": "Je suis là.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190737
					]
				},
				{
					"id": 750190737,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190738
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190738,
					"content": "Puissiez-vous voler à travers les montagnes comme l'oiseau le plus robuste ;\\nQue les marées violentes se brisent sur vous comme si vous étiez de la roche incassable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190739
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190739,
					"content": "Puissiez-vous ne craindre aucune difficulté, car le monde en sera forcément rempli.\\nPuissiez-vous ne jamais vous oublier l'un l'autre, car le destin comporte toujours son lot d'adieux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190740
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190740,
					"content": "#Puissiez-vous atteindre votre destination et obtenir ce que vous désirez... Et surtout, j'espère que vous reviendrez {M#sain et sauf}{F#saine et sauve}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190741
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190741,
					"content": "Comptez sur moi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190742
					]
				},
				{
					"id": 750190742,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190743
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190743,
					"content": "Hein ? Attendez, et moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190744
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190744,
					"content": "Haha ! Quant à vous, petite Paimon... Puissiez-vous manger à votre faim et boire à votre soif, dormir du sommeil du juste et connaître une belle croissance !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190745,
						750190746
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190745,
