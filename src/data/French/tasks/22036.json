					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360409
					]
				},
				{
					"id": 220360409,
					"content": "Ajoutez d'abord des <color=#37FFFF>feuilles broyées</color> à l'engrais, puis ajoutez <color=#37FFFF>de l'eau</color>. Enfin, <color=#37FFFF>mélangez bien</color> avant d'utiliser sur vos champs.",
