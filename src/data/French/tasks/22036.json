			"dialogs": [
				{
					"id": 220360501,
					"content": "Nous nous rencontrons à nouveau, les jeunes. De quoi s'agit-il cette fois-ci ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360502,
						220360503
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220360502,
					"content": "Je ne suis pas là pour vous poser des questions aujourd'hui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360504
					]
				},
				{
					"id": 220360504,
					"content": "Oh, vous venez de la part de Vahid ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360505
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220360505,
					"content": "J'avais entendu parler d'un magasin qui vendait un engrais novateur à Ritou. Ça m'intéressait de l'essayer, alors j'y suis allé pour rencontrer son propriétaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360506
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220360506,
					"content": "S'il fonctionne, les récoltes augmenteront et j'aurais une chance de faire revivre notre village.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360507
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220360507,
					"content": "C'est un vieux croûton comme moi qui doit encore me décarcasser pour notre village... Les jeunes ? On ne peut pas compter sur eux, hmph.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360508
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220360508,
					"content": "Maintenant, dites-moi, comment utilise-t-on cet engrais ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360509,
						220360510,
						220360511
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220360509,
					"content": "Ajoutez d'abord l'eau, puis les feuilles broyées et remuez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360512
					]
				},
				{
					"id": 220360512,
					"content": "Cet engrais est sophistiqué... D'accord, je m'en souviendrai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Konda Densuke"
				},
				{
