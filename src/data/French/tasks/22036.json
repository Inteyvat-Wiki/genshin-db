			},
			"dialogs": [
				{
					"id": 220360101,
					"content": "C'est difficile de faire des affaires ici. Ma marchandise est pourtant excellente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360102
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360102,
					"content": "C'est vraiment étrange. Pourquoi ai-je si peu de clients ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360103
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360103,
					"content": "Qu'est-ce qu'il y a ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360104
					]
				},
				{
					"id": 220360104,
					"content": "#Oh, c'est vous, {M#voyageur}{F#voyageuse}. *soupir* Ne m'en parlez pas, je n'ai pas réussi à vendre le moindre engrais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360105
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360105,
					"content": "N'avez-vous pas Alrani pour vous aider ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360106
					]
				},
				{
					"id": 220360106,
					"content": "Elle m'a aidé un peu, mais le problème, c'est qu'aucun de nous ne sait comment promouvoir ces produits. Nous attendons que les clients viennent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360107
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360107,
					"content": "Mais vous savez comment sont les choses à Ritou. Personne n'achète jamais rien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360108
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360108,
					"content": "Je suis donc allé demander conseil aux messieurs de la Chambre de commerce, qui m'ont suggéré de me lancer dans quelque chose... le « marketing ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360109
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360109,
					"content": "Plus précisément, il s'agit de parler davantage aux clients des effets et du principe des engrais, puis de faire de la publicité et de proposer des échantillons gratuits...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360110
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360110,
					"content": "Mais... je ne comprends pas vraiment tous ces trucs compliqués. Je n'ai pas fabriqué cet engrais, alors comment pourrais-je en parler ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360111
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360111,
					"content": "Cependant, même si je ne fais que réciter les instructions, il faudra quand même que je promeuve le produit un peu partout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360112
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360112,
					"content": "#Alrani est déjà en train de le faire, et j'irai plus tard aussi. {M#Voyageur}{F#Voyageuse}, pourriez-vous nous aider dans cette tâche ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360113,
						220360116
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360113,
					"content": "Laissez-moi faire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360114
					]
				},
				{
					"id": 220360114,
					"content": "#Génial ! Je compte sur vous, {M#voyageur}{F#voyageuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360115
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360115,
					"content": "Vous devrez vous rendre au Village de Konda. Ce n'est pas loin d'ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360119
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360119,
					"content": "Il y a un monsieur nommé Konda Densuke qui a montré un certain intérêt pour notre engrais. Il est également venu au magasin et a discuté avec moi un peu plus tôt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360120
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360120,
					"content": "Si vous pouviez lui faire la promotion de certains de nos produits et lui offrir un essai gratuit, il achètera peut-être notre engrais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360116,
					"content": "Où est allée Alrani ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360117
					]
				},
				{
					"id": 220360117,
					"content": "Elle a dit qu'elle avait besoin de rassembler des matériaux et qu'elle devait aller assez loin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360118
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360118,
					"content": "Vous devrez vous rendre au Village de Konda. Ce n'est pas loin d'ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360119
					],
					"speakerTitle": "Vahid"
				}
			]
		},
		{
			"id": 2203602,
