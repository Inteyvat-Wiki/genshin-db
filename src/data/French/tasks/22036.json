			"dialogs": [
				{
					"id": 220360201,
					"content": "À propos des instructions pour l'engrais...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360202
					]
				},
				{
					"id": 220360202,
					"content": "Ah oui, c'est vrai, je ne vous ai pas expliqué. L'engrais doit être utilisé d'une certaine manière.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360203
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360203,
					"content": "Voyons voir... selon les instructions du manuel, ça devrait être...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360204
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360204,
					"content": "Ajoutez d'abord de l'<color=#37FFFF>eau</color> à l'engrais, puis ajoutez des <color=#37FFFF>feuilles broyées</color>. Enfin, <color=#37FFFF>mélangez bien</color> avant d'utiliser sur vos champs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360205
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360205,
					"content": "Ne vous trompez surtout pas, car des problèmes pourraient se produire avec le produit, et cela affectera notre impression auprès du client. Nos affaires sont en jeu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360206,
						220360208
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360206,
					"content": "C'est noté.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360207
					]
				},
				{
					"id": 220360207,
					"content": "Je vous laisse faire, alors. Une fois que vous aurez remis les faveurs anahitiennes au client, prenez son premier paiement comme récompense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360208,
					"content": "Pourriez-vous répéter ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360209
					]
				},
				{
					"id": 220360209,
					"content": "Ajoutez d'abord de l'<color=#37FFFF>eau</color> à l'engrais, puis ajoutez des <color=#37FFFF>feuilles broyées</color>. Enfin, <color=#37FFFF>mélangez bien</color> avant d'utiliser sur vos champs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360210
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360210,
					"content": "#Je compte vraiment sur vous, {M#voyageur}{F#voyageuse}... Faisons de notre mieux. Peut-être que les affaires seront meilleures ce mois-ci !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vahid"
				}
			]
		},
