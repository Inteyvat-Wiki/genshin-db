			"dialogs": [
				{
					"id": 4510501,
					"content": "... Vous voulez vraiment nous donner votre aide ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510502
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510502,
					"content": "Les loups chassent avec instinct. Ça marche, mais tendre des pièges est très amusant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510503
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510503,
					"content": "On fait le piège, puis on chasse sanglier. Oui ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510504
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510504,
					"content": "J'espère que l'explosion n'éclatera pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Razor"
				}
			]
		},
