					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4510101,
					"content": "#Nous voilà {M#arrivés}{F#arrivées} sur le Territoire des Loups. Les habitants de Mondstadt n'y mettent pas souvent les pieds.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510102,
					"content": "Ce lieu est proche de la cité, mais l'environnement est intact. La loi de la nature règne ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510103,
					"content": "Et aussi la loi du plus fort. Les Blobs qu'on trouve dans cette zone sont énooooormes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510104,
					"content": "Ah tiens, en voilà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510105,
					"content": "... Ils nous ont repérés ! Préparons-nous à les combattre !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 45103,
			"completionStepIds": [
				45104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"45104",
							"2"
						],
						"stepId": 45104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Razor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4510301,
					"content": "M—Merci... Aaah ! Des loups ! Au secours !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510303,
					"content": "Pas besoin... s'inquiéter. Les loups sont... amis à moi. Qui vous êtes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510304
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510304,
					"content": "#Oh, nous sommes juste des {M#voyageurs}{F#voyageuses} ordinaires.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510305,
					"content": "Pas ordinaires, vous deux. Votre odeur... *sniff* familière...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510306
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510306,
					"content": "Euh, tu veux dire qu'on sent mauvais ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510307,
					"content": "Vous sentez pareil que l'Ordre de Favonius. Ils sont amis avec moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510308,
						4510309
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510308,
					"content": "Comment tu t'appelles ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4510310
					]
				},
				{
					"id": 4510310,
					"content": "Je suis Razor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510311
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510311,
					"content": "Tu fais aussi partie de l'Ordre de Favonius ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510312,
					"content": "Non.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510314
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510314,
					"content": "Hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510315,
					"content": "Une meute de loups ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4510316
					]
				},
				{
					"id": 4510316,
					"content": "Oui, c'est ma famille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510317
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510317,
					"content": "C'est ta famille ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510318,
					"content": "Oui, ils m'ont élevé. Nous sommes une famille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510319
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510319,
					"content": "J'ai tellement de questions qui me passent par la tête tout de suite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510320,
					"content": "#Ils sont en colère contre moi. J'ai gâché leur embuscade parce que je vous ai {M#aidés}{F#aidées}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510321
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510321,
					"content": "#Ne t'en fais pas, {NICKNAME} te capturera un beau sanglier pour te remercier !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510322,
					"content": "#{M#Il}{F#Elle} est plus {M#fort}{F#forte} qu'elle en a l'air.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510323,
					"content": "Pas la peine. La meute va mourir de faim si on attend...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510324
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510324,
					"content": "Mais non ~ On va réussir ! Attends sagement ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510309,
					"content": "Tu fais aussi partie de l'Ordre de Favonius ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4510313
					]
				},
				{
					"id": 4510313,
					"content": "Je suis Razor. Pas un chevalier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510314
					],
					"speakerTitle": "Razor"
				}
			]
		},
		{
