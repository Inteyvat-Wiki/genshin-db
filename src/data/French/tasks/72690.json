				"points": []
			},
			"dialogs": [
				{
					"id": 726900101,
					"content": "Ce jour est enfin arrivé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900102
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726900102,
					"content": "L'essence de la composition des cours fleuries n'a plus de secret pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900103
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726900103,
					"content": "Il est donc temps de tester votre maîtrise avec une véritable épreuve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900104
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726900104,
					"content": "Quoi ? On s'y connaît déjà assez pour vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726900105,
					"content": "Une véritable épreuve... Vous voulez dire que ce thème sera beaucoup plus difficile ? J'ai peur soudainement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726900106,
					"content": "On vient à peine de commencer à apprendre l'ikebana...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726900107
					]
				},
				{
					"id": 726900107,
					"content": "En effet, la préparation des fleurs demande une longue période de pratique pour être maîtrisée. Néanmoins, la planification et la structuration des cours fleuries reposent davantage sur l'intention et l'inspiration.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900108
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726900108,
					"content": "En ne prenant que ces deux derniers éléments en compte, vous m'avez déjà montré l'étendue de votre talent. Je ne pense pas que vous ayez besoin de vous exercer davantage avec des thèmes floraux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900109
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726900109,
					"content": "Je devrais plutôt dire que ce sont les paysages que vous avez vus pendant vos voyages, et que je ne pourrais imaginer, qui vous ont donné une vision unique des choses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900110
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726900110,
					"content": "Je vois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726900111,
					"content": "#C'est vrai qu'on a voyagé à de nombreux endroits et qu'on a pu voir plein de choses. Ça nous a quand même pas mal {M#inspirés}{F#inspirées}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726900112,
					"content": "On a passé tout ce temps à apprendre l'ikebana. Combien d'inspiration nous reste-t-il après ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900113,
						726900114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726900113,
					"content": "Notre voyage continuera.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726900115
					]
				},
				{
					"id": 726900115,
					"content": "Tu as raison !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726900116,
					"content": "Merci, mademoiselle Fushizome ! Sans vous, on n'aurait jamais découvert ce talent caché en nous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726900117,
					"content": "Je vous en prie. Eh bien, je vous propose de terminer votre initiation en beauté avec la plus splendide des cours fleuries.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900118,
						726900122
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726900118,
					"content": "On vous écoute.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726900119
					]
				},
				{
					"id": 726900119,
					"content": "Le thème d'aujourd'hui est...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900120
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726900120,
					"content": "« Branches recourbées comme des arcs-en-ciel, teintes d'une myriade de couleurs ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900121
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726900121,
					"content": "J'ai hâte de voir votre travail le plus abouti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726900122,
					"content": "J'ai autre chose à faire...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726900123
					]
				},
				{
					"id": 726900123,
					"content": "Je comprends. Il est vrai que l'ikebana requiert votre attention totale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900124
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726900124,
					"content": "Une fois que vous aurez terminé vos tâches et serez libres de toute distraction, votre cour fleurie n'en sera que plus réussie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726900114,
					"content": "L'inspiration nous viendra.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726900115
					]
				}
			]
		},
		{
			"id": 7269003,
