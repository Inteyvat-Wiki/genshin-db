			"dialogs": [
				{
					"id": 700650101,
					"content": "Certaines personnes refusent décidément d'écouter. Je l'ai déjà dit, ce n'est pas le moment de gravir la montagne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650102
					],
					"speakerTitle": "Mann"
				},
				{
					"id": 700650102,
					"content": "Doucement, vieux Mann. Calmons-nous et discutons-en.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650103
					],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 700650103,
					"content": "On s'entendait très bien tout à l'heure à la Brasserie nocturne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650104
					],
					"speakerTitle": "Lipphart"
				},
				{
					"id": 700650104,
					"content": "Mais dès que j'ai mentionné que j'allais au Pic Vent-repos, il m'a attrapée et traînée jusqu'ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650105
					],
					"speakerTitle": "Lipphart"
				},
				{
					"id": 700650105,
					"content": "#Oh, Hoffman. Que se passe-t-il ici{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700650106,
					"content": "Comme vous pouvez le constater, le vieux Mann fait ce qu'il peut pour tenir les gens à l'écart du Pic Vent-repos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650107
					],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 700650107,
					"content": "Bref, permettez-moi de faire les présentations. Voici Lipphart, une aventurière.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650108
					],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 700650108,
					"content": "#Ce que j'ai vu... Ce que j'ai ressenti... C'était terrifiant{NON_BREAK_SPACE}! Vous ne voulez sûrement pas entendre ça{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650109
					],
					"speakerTitle": "Mann"
				},
				{
					"id": 700650109,
					"content": "#On dirait que je n'irai nulle part aujourd'hui, alors racontez l'histoire{NON_BREAK_SPACE}! Voyez ça comme une prolongation de notre moment arrosé de tout à l'heure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650110
					],
					"speakerTitle": "Lipphart"
				},
				{
					"id": 700650110,
					"content": "#C'est vraiment si dangereux que ça{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650111
					],
					"speakerTitle": "Lipphart"
				},
				{
					"id": 700650111,
					"content": "#Le sanatorium est hanté{NON_BREAK_SPACE}! Sérieusement{NON_BREAK_SPACE}! J'ai vu des fantômes de mes propres yeux{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650112
					],
					"speakerTitle": "Mann"
				},
				{
					"id": 700650112,
					"content": "#Des fantômes{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700650113,
					"content": "C'est arrivé hier soir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mann"
				}
			]
		}
