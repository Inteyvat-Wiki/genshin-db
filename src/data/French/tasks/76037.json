					"content": "(À propos des trafiquants...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760370502
					]
				},
				{
					"id": 760370502,
					"content": "« Cible : Gang nouveau du fer et du sel. Recherchés pour : suspicion de contrebande et de trafic à grande échelle de produits dangereux soumis à restrictions. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370503
					],
					"speakerTitle": "Primes"
				},
				{
					"id": 760370503,
					"content": "« Notre enquête indique que le gang maintient un avant-poste provisoire dans <color=#00E1FFFF>un campement sur la plage nord à l'extérieur du village</color>. Les personnes qui aideront à mettre fin à leurs opérations de contrebande seront généreusement récompensées par la Spina di Rosula. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Primes"
				}
			]
