			"dialogs": [
				{
					"id": 760370101,
					"content": "Les détails des primes sont affichés sur le panneau. Je peux vous en dire plus aussi, mais si vous cherchez à négocier, je vous suggère d'aller au marché aux puces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370107,
						760370102,
						760370108
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760370107,
					"content": "Présenter les preuves que les cibles ont été neutralisées",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 760370102,
					"content": "À propos des cibles mises à prix...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760370103
					]
				},
				{
					"id": 760370103,
					"content": "Il y a quatre cibles pour le moment, mais des informations sur trois d'entre eux. La première est Hidimbi la diseuse de bonne aventure sumérienne, recherchée pour escroquerie. Elle est souvent aperçue près des <color=#00E1FFFF>quais sud du port</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370104
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760370104,
					"content": "Un Oni des mers inazumien qui a fauché la vie de plusieurs marchands itinérants dans le <color=#00E1FFFF>Couloir vide</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370105
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760370105,
					"content": "Des membres d'un gang de trafiquants de marchandises dangereuses qui seraient cachés dans un <color=#00E1FFFF>campement sur la plage nord à l'extérieur du village</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370106
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760370106,
					"content": "Le cruel pirate Hark, la « Mâchoire fendue ». Pas d'indice sur sa position pour le moment. On suppose qu'il se cache.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760370108,
					"content": "Au revoir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760370109
					]
				},
				{
					"id": 760370109,
					"content": "Au revoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leszek"
				}
			]
		},
