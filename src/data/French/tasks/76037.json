			},
			"dialogs": [
				{
					"id": 760370301,
					"content": "(À propos de Hidimbi...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760370302
					]
				},
				{
					"id": 760370302,
					"content": "« Cible : Hidimbi, diseuse de bonne aventure sumérienne. Femme, âge inconnu. Recherchée pour : sorcellerie et escroquerie. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370303
					],
					"speakerTitle": "Primes"
				},
				{
					"id": 760370303,
					"content": "« Cette femme m'a escroqué 18 millions de moras ! Elle m'a affirmé que si je portais le collier qu'elle avait soi-disant demandé à Al-Ahmar, la divinité de l'amour, les femmes auraient le coup de foudre pour moi ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370304
					],
					"speakerTitle": "Primes"
				},
				{
					"id": 760370304,
					"content": "« En réalité, Al-Ahmar n'est pas du tout la divinité de l'amour. Ça fait des milliers d'années qu'il est mort, sans avoir même pas réussi à conquérir le cœur de la femme qu'il aimait. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370305
					],
					"speakerTitle": "Primes"
				},
				{
					"id": 760370305,
					"content": "« Le collier qu'elle m'a vendu est bien authentique, mais il s'agit d'un objet maudit qui m'a empêché de trouver l'amour. La personne qui la retrouvera et qui brisera la malédiction sera généreusement récompensée. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Primes"
				}
			]
		},
		{
			"id": 7603704,
