							-9.541,
							0.032,
							11.813
						],
						"pointId": 4
					}
				]
			},
			"dialogs": [
				{
					"id": 150290101,
					"content": "En ce qui concerne le tissage du rouleau lui-même, il n'y a rien à faire. Par contre, ta participation est essentielle si on veut transmettre la technique de Huitzilin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290102
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290102,
					"content": "Que dites-vous, Citlali ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290103,
					"content": "Suivez-moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290104
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290104,
					"content": "Ouah, cet endroit... Vous tissez aussi des rouleaux d'habitude ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290105,
					"content": "Des rouleaux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290106
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290106,
					"content": "Des rouleaux ? Je croyais que tu allais me montrer ton chef-d'œuvre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290107
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290107,
					"content": "C'est ce que je fais ! La technique que je suis sur le point de te montrer a un lien direct avec les rouleaux tissés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290108
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290108,
					"content": "*soupir* D'accord, alors quelle est cette technique ? Peut-elle renverser le cours d'une guerre ou empêcher un désastre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290109
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290109,
					"content": "Tu veux probablement me défier, hein ? Je sais que tu n'as pas la force pour un vrai combat, alors je vais te laisser me battre avec des mots.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290110
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290110,
					"content": "*tousse* ... Ma vieille amie, ma vie touche à sa fin. J'ai bien peur de... ne pas avoir de temps pour un autre duel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290111
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290111,
					"content": "Hé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290112
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290112,
					"content": "Ne t'inquiète pas. Comme les autres membres de notre tribu, je crois... que la mort n'est pas la fin, mais le début d'une nouvelle existence dans le Fief nocturne, où tout est fait de souvenirs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290113
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290113,
					"content": "Sais-tu pourquoi nos ancêtres ont tenu à utiliser des rouleaux tissés colorés pour documenter notre histoire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290114
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290114,
					"content": "Parce que... l'histoire est faite des souvenirs d'un peuple.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290115
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290115,
					"content": "Nous donnons à nos rouleaux une teinte orangée pour que les morts puissent encore sentir la chaleur du soleil couchant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290116
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290116,
					"content": "Nous les décorons avec des noyaux de granifruit pour qu'ils puissent encore profiter de l'abondance de nos récoltes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290117
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290117,
					"content": "Je sais... Mais pourquoi me confies-tu quelque chose d'aussi important et pas à l'un de tes élèves ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290118
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290118,
					"content": "Héhé... J'admets que je suis un peu égoïste en tant qu'amie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290119
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290119,
					"content": "*tousse* Je n'ai pas beaucoup de temps, Citlali. Je ne suis pas sûre... de vraiment pouvoir t'expliquer ma décision. Mais je sais que tu la comprendras un jour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290120
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290120,
					"content": "Mais pourrais-tu accepter ma dernière volonté ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290121
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290121,
					"content": "... Juste pour cette fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290122
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290122,
					"content": "Je comprends maintenant, Huitzilin. Comme tu l'avais dit... Griffouille, aide-moi à déplacer ça dehors. Je vais le colorer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290123
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290123,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290124
					],
					"speakerTitle": "Tlapo"
				},
				{
					"id": 150290124,
					"content": "#{NICKNAME} et Paimon, venez avec moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlali"
				}
			]
		},
