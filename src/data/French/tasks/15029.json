					{
						"sceneId": 3,
						"position": [
							-2002.646,
							176.821,
							9639.377
						],
						"pointId": 9679
					}
				]
			},
			"dialogs": [
				{
					"id": 150290201,
					"content": "Nous sommes des oiseaux qui s'envolent à travers le temps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290203
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290203,
					"content": "(Cinématique)",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150290204
					]
				},
				{
					"id": 150290204,
					"content": "Je savais que tu comprendrais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290205
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290205,
					"content": "Mais c'est le rouleau spécial ! Comment avez-vous su le tisser, Citlali ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290206,
					"content": "Tu te souviens du « cadeau des esprits », Paimon ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290207
					]
				},
				{
					"id": 150290207,
					"content": "Attendez, vous avez vécu plus de deux cents ans, vous savez comment tisser le rouleau spécial... Mais alors... C'est vous qui êtes à l'origine du « cadeau des esprits » !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290208,
					"content": "Je n'avais pas spécialement envie de parler aux personnes désignées, alors j'utilisais des illusions pour les distraire quand je leur remettais les rouleaux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290209
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290209,
					"content": "Si cela s'est transformé en une sorte d'intervention divine, c'est parce que personne n'était assez compétent pour voir clair dans ma combine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290210
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290210,
					"content": "Pourquoi le leur cachez-vous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290211
					]
				},
				{
					"id": 150290211,
					"content": "Vous avez fait ça toute seule pendant toutes ces années ? Même si vous n'aimez pas interagir avec les gens, pourquoi ne pas avoir appris à quelqu'un d'autre comment faire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290212,
					"content": "#... {NICKNAME}, tu peux voir la couleur spéciale, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290213
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290213,
					"content": "Oui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290214
					]
				},
				{
					"id": 150290214,
					"content": "L'essence de cette couleur est le souvenir. Pour terminer le rouleau spécial, il faut rechercher la couleur dans ses souvenirs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290215
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290215,
					"content": "Transmettre la technique à quelqu'un, c'est partager ses souvenirs avec cette personne. Il faut laisser des traces de votre couleur dans sa mémoire, et c'est pareil pour elle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290216
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290216,
					"content": "Même si je ne l'ai confirmé qu'aujourd'hui, je m'en doutais depuis longtemps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290217
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290217,
					"content": "Et depuis la mort de Huitzilin, je n'avais plus envie de nouer ce genre de liens avec les gens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290218
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290218,
					"content": "Je vois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290219,
					"content": "C'était sa dernière volonté, alors je me suis résignée à assumer ce fardeau pour toujours. Après tout, le temps n'est pas ce qui me manque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290220
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290220,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290221
					],
					"speakerTitle": "Tlapo"
				},
				{
					"id": 150290221,
					"content": "Mais Griffouille n'a jamais cessé de désigner de nouveaux candidats pour tisser le rouleau, même s'il savait exactement ce que j'en pensais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290222
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290222,
					"content": "Il n'a jamais cessé d'essayer de vous trouver de nouveaux amis ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290223
					]
				},
				{
					"id": 150290223,
					"content": "Je savais exactement ce qu'il faisait. Oui, je suppose que quelqu'un avec qui je partage des souvenirs pourrait être considéré comme un ami, mais je n'en suis jamais arrivée là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290224
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290224,
					"content": "Tu as gagné cette fois-ci, Griffouille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290225
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290225,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290226
					],
					"speakerTitle": "Tlapo"
				},
				{
					"id": 150290226,
					"content": "Prends ça. Je suppose... que c'est ma réponse à ce que tu m'as dit l'autre soir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290227
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290227,
					"content": "Qu'est-ce que c'est ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290228,
					"content": "Si je devais choisir ma couleur, ce serait celle de ce mouchoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290229
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290229,
					"content": "De nombreuses personnes existent dans mes souvenirs, et je sais qu'un jour, j'en deviendrai un aussi... Un souvenir qui vit dans la tête de quelqu'un d'autre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290230
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290230,
					"content": "#Comme tu vivras encore longtemps, tu es {M#le candidat idéal}{F#la candidate idéale} pour porter ce souvenir... J'espère que ma couleur restera toujours dans ta mémoire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290231
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290231,
					"content": "#Ça veut dire que je suis officiellement votre {M#ami}{F#amie} ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290232
					]
				},
				{
					"id": 150290232,
					"content": "... Garde-le en sécurité. Tu as intérêt à ne pas oublier ma couleur quand j'aurai quitté ce monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290233
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290233,
					"content": "Ouah, c'est un peu tôt pour parler de mort, non ? Ça ne fait que quelques secondes que l'amitié a été officialisée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290234,
					"content": "C'est ce que font les amis, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290235
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290235,
					"content": "#C'est un engagement bien solennel... Citlali, si {NICKNAME} doit aussi laisser sa couleur dans votre esprit, ce sera probablement du doré, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290236,
					"content": "#À vrai dire, {M#il}{F#elle} a déjà marqué mon esprit. Tu te souviens de l'effet secondaire qui me permettait de lire dans ses pensées ? Eh bien, j'ai finalement découvert le fond du problème.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290237
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290237,
					"content": "Le partage des sens permet aux consciences des personnes impliquées de communiquer. Les souvenirs y compris.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290238
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290238,
					"content": "#Je ne le savais pas, mais nous avons {M#tous}{F#toutes} les deux la capacité de voir la « couleur des souvenirs ». Lorsque j'ai partagé mes sens avec toi, une connexion s'est créée entre nos souvenirs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290239
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290239,
					"content": "Et c'est cette connexion qui a fait rater mon sort initial...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290240
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290240,
					"content": "#Ça veut dire que... vous pouvez entendre les pensées de {NICKNAME} parce que vous avez {M#chacun}{F#chacune} laissé des traces de couleur dans vos souvenirs respectifs ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290241,
					"content": "#Et c'est pourquoi {NICKNAME} peut aussi entendre les vôtres ! Parce que ça marche dans les deux sens, pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290242,
					"content": "Ça aurait pu, mais seuls ceux qui sont formés aux arts mystiques peuvent maintenir ce niveau de connexion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290243
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290243,
					"content": "#C'est pourquoi je peux encore entendre les pensées de {NICKNAME}, mais {M#lui}{F#elle} n'entend pas les miennes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290244
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290244,
					"content": "Mais pas d'inquiétude. Maintenant que j'ai compris comment cela fonctionne, je vais m'en débarrasser en un rien de temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290245
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290245,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290246
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290246,
					"content": "(J'ai menti. Le fait d'entendre les pensées de l'autre dépend de la force de la connexion entre nos souvenirs.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290247
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290247,
					"content": "(Après tout ce que nous venons de vivre, je parie que tu peux encore m'entendre.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290248
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290248,
					"content": "(!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290249
					]
				},
				{
					"id": 150290249,
					"content": "(Je le savais...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290250
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290250,
					"content": "(Y a-t-il un moyen de résoudre ça ?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290251
					]
				},
				{
					"id": 150290251,
					"content": "#(Étant donné que le lien entre nos souvenirs est déjà présent, le seul moyen d'éliminer l'effet est que {M#l'un}{F#l'une} d'entre nous oublie l'autre.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290252
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290252,
					"content": "(...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290253
					]
				},
				{
					"id": 150290253,
					"content": "(Haha, je plaisantais... Je suis une shamane légendaire de ma tribu. Maintenant que je connais la cause de cet effet, je peux évidemment trouver le moyen d'y remédier.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290254
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290254,
					"content": "(Cela prendra probablement encore un peu de temps, mais prends ton mal en patience.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290255
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290255,
					"content": "(D'ailleurs, je suis un livre ouvert. Je ne pense à rien d'embarrassant... Oh, euh, sauf quand j'ai bu quelques verres.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290256,
						150290259
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290256,
					"content": "(Oh, donc on peut arrêter ça ? C'est dommage...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290257
					]
				},
				{
					"id": 150290257,
					"content": "(Dommage ? Si jamais la télépathie te manque, je pourrai toujours partager à nouveau mes sens avec toi.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290258
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290258,
					"content": "(Je ne te promets rien, cependant. Parfois, il vaut mieux garder certaines pensées pour soi.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290261
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290261,
					"content": "Hum ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290259,
					"content": "(Oh, donc on peut arrêter ça ? Tant mieux.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290260
					]
				},
				{
					"id": 150290260,
					"content": "(N'est-ce pas ? Parfois, il vaut mieux garder certaines pensées pour soi.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290261
					],
					"speakerTitle": "Citlali"
				}
			]
		},
