			"dialogs": [
				{
					"id": 150295101,
					"content": "Ah, la victoire de Natlan sur l'Abîme ! C'est parfait pour ce rouleau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150295102
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150295102,
					"content": "Je me demande dans combien de temps l'aîné Tlapo désignera la prochaine personne responsable ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150295103
					],
					"speakerTitle": "Aywastin"
				},
				{
					"id": 150295103,
					"content": "En parlant de lui, j'ai appris qu'il avait disparu hier ! Savez-vous ce qui s'est passé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150295104
					],
