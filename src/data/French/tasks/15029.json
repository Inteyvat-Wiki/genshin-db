			"dialogs": [
				{
					"id": 150290401,
					"content": "Ah, vous avez terminé ? Votre enquête sur la Bataille des sept couleurs est sans doute une réussite. J'espère que vous partagerez ce que vous avez appris.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290402
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290402,
					"content": "Le rouleau est terminé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290403
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150290403,
					"content": "La sagesse de l'aîné Tlapo est infaillible !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290404
					],
					"speakerTitle": "Aywastin"
				},
				{
					"id": 150290404,
					"content": "#{NICKNAME} va tout vous raconter en détail...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290405,
					"content": "Vous partagez tout ce que vous avez appris sur la couleur spéciale, sans parler de la contribution de Citlali.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150290406
					]
				},
				{
					"id": 150290406,
					"content": "Je vois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290407
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290407,
					"content": "Vous n'avez pas l'air surpris du tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290408,
					"content": "C'est tout à fait logique ! L'histoire est constituée des souvenirs d'un peuple. Si nous voulons la représenter, une teinture dérivée des souvenirs des gens tombe sous le sens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290409
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290409,
					"content": "Il ne reste plus qu'à préserver cette technique secrète...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290410
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290410,
					"content": "D'après votre description, l'apprentissage de la technique semble demander que le détenteur précédent partage ses souvenirs ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290411
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290411,
					"content": "Euh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290412,
					"content": "Dans ce cas, je dois travailler avec nos prêtres pour réinventer la technique selon les principes que vous avez décrits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290413
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290413,
					"content": "#Après tout, les souvenirs sont précieux. Ils sont destinés à être partagés avec nos proches. Je ne peux pas vous priver de ce choix, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290414
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290414,
					"content": "Vous avez accompli votre tâche de manière admirable. Il nous appartient désormais de trouver un moyen de perpétuer cet héritage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290415
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290415,
					"content": "D'accord ! On vous laisse faire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290416,
					"content": "Oh, et remerciez grand-mère Itztli de ma part.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290417
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290417,
					"content": "Nous avons interrogé le marchand fontainois qu'elle a appréhendé. Il s'avère que c'est à cause de lui que certains membres de notre tribu ont commencé à remettre en question notre histoire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290418
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290418,
					"content": "Il a engagé des gens pour répandre des informations erronées sur la Bataille des sept couleurs. Les récentes frictions au sein de notre tribu sont entièrement de son fait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290419
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290419,
					"content": "Nous avons désormais un dossier sur ses crimes et commencerons à collaborer avec les autorités de Fontaine dans quelques jours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290420
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290420,
					"content": "C'était lui qui était à l'origine de la controverse ! J'imagine que c'est plus facile d'enquêter lorsque les gens remettent en cause quelque chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290421,
					"content": "Bref, cette situation est réglée ! Les gens ne remettent pas en cause leur propre histoire de nulle part.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290422,
					"content": "Merci, Biram. On va vous laisser.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290423
					]
				},
				{
					"id": 150290423,
					"content": "À bientôt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Biram"
				}
			]
		},
