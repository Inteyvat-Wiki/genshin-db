					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290503,
					"content": "Vous auriez pu dire qu'il s'agissait d'un « cadeau des esprits »...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290504
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290504,
