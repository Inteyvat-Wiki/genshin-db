			"dialogs": [
				{
					"id": 150290501,
					"content": "Vous lui avez tout raconté ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290502
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290502,
					"content": "Oui ! Nous avons omis de parler de votre rôle dans l'histoire, mais on dirait que le chef Biram se doutait de quelque chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
