			},
			"dialogs": [
				{
					"id": 240070501,
					"content": "Voyons voir... Cet engrenage peut être utilisé, et si j'arrive à ouvrir ce roulement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070502
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070502,
					"content": "Pourquoi as-tu besoin de tout ça ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070503
					]
				},
				{
					"id": 240070503,
					"content": "J'aimerais fabriquer une marionnette mécanique. En fait, j'apprends toujours secrètement sur ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070504
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070504,
					"content": "Une fois que j'aurai tout compris, je vais faire un énorme Méka horlogoïde. Papa n'en croira pas ses yeux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070505
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070505,
					"content": "J'ai lu beaucoup de livres dans sa chambre, et j'ai fabriqué quelques composants de base selon les instructions qu'ils contiennent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070506
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070506,
					"content": "Si je persiste, je suis sûre de pouvoir y arriver !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070507
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070507,
					"content": "Mais je ne peux pas étudier en ville, sinon il le découvrira, la surprise serait gâchée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070508
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070508,
					"content": "C'est pour ça que cet endroit est devenu le laboratoire secret de Lovi, pour ses recherches sur les machines horlogoïdes. Et moi... Je suis son assistant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070509
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070509,
					"content": "Trêve de bavardage, assistant ! Commençons nos recherches ! Aujourd'hui, on doit fabriquer un bras mécanique mobile !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070510
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070510,
					"content": "À vos ordres, madame ! Commençons les recherches !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verut"
				}
			]
		}
