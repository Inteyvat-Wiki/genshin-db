			"dialogs": [
				{
					"id": 240070401,
					"content": "C'est... Ce sont des vêtements en lambeaux ? Ils sont complètement délavés...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070402
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070402,
					"content": "Est-ce que quelqu'un a déjà nettoyé la zone ? Pourquoi il n'y a pas de composants...",
