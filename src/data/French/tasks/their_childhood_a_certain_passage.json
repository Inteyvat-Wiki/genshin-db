			"dialogs": [
				{
					"id": 240070301,
					"content": "Bingo ! Cet engrenage est presque complet. Regardez, il y a même un roulement entier là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070302
					],
					"speakerTitle": "Verut"
				},
				{
