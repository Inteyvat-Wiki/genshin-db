				"points": []
			},
			"dialogs": [
				{
					"id": 240070101,
					"content": "Tu as trouvé quelque chose d'intéressant, Lovi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070102
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070102,
					"content": "Non, il n'y a rien ici !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070103
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070103,
					"content": "Qu'est-ce que vous faites ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070104
					]
				},
				{
					"id": 240070104,
					"content": "On cherche un trésor. Haha... Vous voulez venir avec nous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070105,
						240070108
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070105,
					"content": "Un trésor ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070106
					]
				},
				{
					"id": 240070106,
					"content": "N'écoutez pas Verut, on cherche juste des composants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070107
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070107,
					"content": "Les composants sont aussi une sorte de trésor... Il devrait y en avoir par ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070114
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070114,
					"content": "Hmm... On dirait qu'on ne va rien trouver ici. Devrions-nous changer d'endroit ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070115
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070115,
					"content": "D'accord ! Continuons d'avancer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070116,
						240070117
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070116,
					"content": "Je vais vous accompagner.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070118
					]
				},
				{
					"id": 240070118,
					"content": "Waouh, vous commencez à parler comme mon frère...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070119
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070119,
					"content": "Continuons d'avancer. Je suis sûr qu'il y a beaucoup de composants dans l'eau à proximité...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070117,
					"content": "N'allez pas n'importe où.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070118
					]
				},
				{
					"id": 240070108,
					"content": "Hé, où est Aurèle ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070109
					]
				},
				{
					"id": 240070109,
					"content": "Mon frère est allé poser des questions à monsieur Delerue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070110
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070110,
					"content": "Et nous, on ne peut qu'être sages... et chercher un trésor ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070111
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070111,
					"content": "Vous voulez vous joindre à nous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070112
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070112,
					"content": "N'écoutez pas Verut, on cherche juste des composants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070113
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070113,
					"content": "Les composants sont aussi une sorte de trésor... Il devrait y en avoir par ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070114
