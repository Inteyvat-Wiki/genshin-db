			"dialogs": [
				{
					"id": 201040301,
					"content": "Qu'est-ce que... Vous avez tout brûlé ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040302
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040302,
					"content": "Ce n'est pas un savon qu'on va se prendre... On va se faire virer, c'est sûr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040303
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040303,
					"content": "Euh, ben... Hum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040304
					]
				},
				{
					"id": 201040304,
					"content": "Si on avait su, on aurait mieux fait de continuer à la main...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040305
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040305,
					"content": "C'est la fin des haricots...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040306
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040306,
					"content": "Euh, héhé...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040307
					]
				},
				{
					"id": 201040307,
					"content": "#{M#Voyageur}{F#Voyageuse}, mieux vaut que vous partiez... C'est nous les responsables...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040308
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040308,
					"content": "On n'aurait jamais dû demander à quelqu'un qui ne sait pas faire le ménage, c'est notre faute...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040309
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040309,
					"content": "Qu'est-ce que la maîtresse va nous faire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040310
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040310,
					"content": "Oh là là, oh là là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hillie"
				}
			]
