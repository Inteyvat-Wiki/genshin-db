			"dialogs": [
				{
					"id": 201040201,
					"content": "Alors ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040202
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040202,
					"content": "Vous avez réussi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040203
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040203,
					"content": "J'ai fini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040204
					]
				},
				{
					"id": 201040204,
					"content": "Ouah ! Impressionnant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040205
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040205,
					"content": "#Pas étonnant, vous êtes {M#le fameux voyageur}{F#la fameuse voyageuse} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040206
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040206,
					"content": "La maîtresse ne va pas être fâchée, merci !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040207
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040207,
					"content": "Tenez, c'est pour vous, en remerciement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040208
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040208,
					"content": "Bon, il faut qu'on se dépêche de nettoyer ce qui reste... Encore merci !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Moco"
				}
			]
		},
