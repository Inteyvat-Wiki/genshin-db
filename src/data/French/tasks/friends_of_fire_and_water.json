			"dialogs": [
				{
					"id": 751080101,
					"content": "On a dit qu'on cuisinerait, mais qu'allons-nous préparer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080102,
					"content": "Je me souviens qu'on nourrissait Grobaiebaie le boudiné avec du poisson. Ça devrait faire l'affaire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080103,
					"content": "#Si on veut que le boudiné et {REALNAME[ID(2)|SHOWHOST(true)]} se régalent... Le poisson grillé à la menthe de Natlan devrait les ravir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080104,
						751080105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080104,
					"content": "C'est ma spécialité.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080106
					]
				},
				{
					"id": 751080106,
					"content": "Commençons alors. Je serai là pour te donner des conseils.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080107,
						751080109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080107,
					"content": "Faire des incisions plus profondes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080108
					]
				},
				{
					"id": 751080108,
					"content": "D'accord, le poisson aura plus de goût grâce à ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080111,
						751080113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080111,
					"content": "Mettons un peu plus de sel pour un peu plus de bonheur !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080112
					]
				},
				{
					"id": 751080112,
					"content": "#Mmm, c'est vraiment riche en goût. {REALNAME[ID(2)|SHOWHOST(true)]} et le boudiné vont adorer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080115,
						751080117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080115,
					"content": "Ajoutons de la sauce à la menthe à gogo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080116
					]
				},
				{
					"id": 751080116,
					"content": "Un goût aussi rafraîchissant ne peut qu'être excellent !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080119,
						751080121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080119,
					"content": "Les piments sont indispensables.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080120
					]
				},
				{
					"id": 751080120,
					"content": "Il faut que ce soit juste assez piquant pour ouvrir l'appétit !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080123,
						751080125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080123,
					"content": "Grillé à feu vif ! Tendre à l'intérieur et croustillant à l'extérieur !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080124
					]
				},
				{
					"id": 751080124,
					"content": "Héhé... Ça a l'air tellement délicieux que j'en salive déjà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080127,
					"content": "#Après un superbe processus de cuisson, le poisson que vous avez spécialement grillé pour {REALNAME[ID(2)|SHOWHOST(true)]} et le boudiné est prêt...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 751080125,
					"content": "Rôti lentement, tendre et juteux !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080126
					]
				},
				{
					"id": 751080126,
					"content": "#Ouah, super ! La recette secrète de poisson grillé de {NICKNAME}... Tu pourrais peut-être en faire une de tes spécialités et en préparer pour d'autres amis !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080121,
					"content": "Les créatures de Fontaine pourraient être allergiques à la nourriture épicée...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080122
					]
				},
				{
					"id": 751080122,
					"content": "Mais on aura l'impression qu'il manque quelque chose s'il n'y a pas de piment. Pourquoi ne pas en ajouter un peu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080123,
						751080125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080117,
					"content": "Une créature aquatique comme le boudiné n'aimera pas la fraîcheur de la menthe, non ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080118
					]
				},
				{
					"id": 751080118,
					"content": "Je ne pense pas. Un boudiné se sentira sec lorsqu'il est sur la terre ferme et il aura chaud. La sauce à la menthe devrait le rafraîchir, tu ne penses pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080119,
						751080121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080113,
					"content": "Le goût est parfait. Il n'y a pas besoin de sel.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080114
					]
				},
				{
					"id": 751080114,
					"content": "C'est vrai. Il y aura d'autres assaisonnements, alors on n'en a pas forcément besoin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080115,
						751080117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080109,
					"content": "Faire des incisions moins profondes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080110
					]
				},
				{
					"id": 751080110,
					"content": "C'est plutôt bien. Ça devrait alléger les choses, tout en gardant une partie du goût de poisson que le boudiné aime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080111,
						751080113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080105,
					"content": "Pas ce que je sais faire de mieux, mais d'accord.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080106
					]
				}
			]
		},
