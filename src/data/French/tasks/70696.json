			"dialogs": [
				{
					"id": 706960201,
					"content": "Miko nous a donné une belle collection de bandes dessinées. Puisque le but est de les partager avec le groupe, pourquoi ne pas les placer quelque part où tout le monde pourra les voir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706960202,
					"content": "Mettons-les près du support à livres du campement de la Légion des âmes embrasées. Comme ça, tout le monde pourra les lire plus facilement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706960203,
					"content": "Vous empruntez un support à livres et vous y rangez les bandes dessinées offertes par Miko.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706960204
					]
				},
				{
					"id": 706960204,
					"content": "Super, c'est pas mal comme ça ! Les gens pourront venir les lire quand ils auront du temps.",
