			"dialogs": [
				{
					"id": 706960101,
					"content": "#Bonjour, {M#mon petit}{F#ma petite}. Quelle agréable surprise. Où tes voyages t'ont-ils mené dernièrement ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960102
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 706960102,
					"content": "Vous parlez à Miko de Minnie, de la Légion des âmes embrasées et de la compétition organisée à Dosdragon.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706960103
					]
				},
				{
					"id": 706960103,
					"content": "Tout le monde a l'air adorable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960104
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 706960104,
					"content": "Ça a dû être une fameuse aventure pour eux. Ils viennent des quatre coins de Teyvat, ont traversé les frontières pour rencontrer d'autres personnes qui partagent les mêmes passions... Ah, voilà une belle histoire empreinte du romantisme de la jeunesse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960105
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 706960105,
					"content": "La Légende des âmes embrasées semble compter un sacré nombre d'amateurs. Il est peut-être temps de lancer une nouvelle série de réimpressions...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960106
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 706960106,
					"content": "C'est normal de témoigner notre gratitude à des fans aussi dévoués.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960107
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 706960107,
					"content": "Pourquoi pas des bandes dessinées gratuites ? Hmm... Vous êtes plutôt nombreux, il faut que je m'assure d'en avoir assez pour tout le monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960108,
						706960109
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 706960108,
					"content": "Merci.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706960110
					]
				},
				{
					"id": 706960110,
					"content": "Ce sont des éditions originales, vous n'en trouverez nulle part ailleurs à la vente. Prenez-en bien soin maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 706960109,
					"content": "Je ne manquerai pas de les partager avec le groupe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706960110
					]
				}
			]
		},
