			"dialogs": [
				{
					"id": 200440101,
					"content": "Qu'est-ce que je suis censée faire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440102
					],
					"speakerTitle": "Eileen"
				},
				{
					"id": 200440102,
					"content": "Qu'est-ce qu'il t'arrive ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200440103
					]
				},
				{
					"id": 200440103,
					"content": "Je m'entraîne pour la sélection de l'Ordre de Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440104
					],
					"speakerTitle": "Eileen"
				},
				{
					"id": 200440104,
					"content": "Mais je suis loin d'être aussi puissante que Jean...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440105
					],
					"speakerTitle": "Eileen"
				},
				{
					"id": 200440105,
					"content": "Je pense que je devrais me concentrer davantage sur la technique que sur la force.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440106
					],
					"speakerTitle": "Eileen"
				},
				{
					"id": 200440106,
					"content": "Par exemple, je me demandais comment je pourrais casser tous ces mannequins en un coup...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440107
					],
					"speakerTitle": "Eileen"
				},
				{
					"id": 200440107,
					"content": "Si tu as un peu de temps libre, ça te dit de réfléchir avec moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440108,
						200440109
					],
					"speakerTitle": "Eileen"
				},
				{
					"id": 200440108,
					"content": "Ça marche.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200440110
					]
				},
				{
					"id": 200440110,
					"content": "Merci. Prends ton temps, ces mannequins n'iront nulle part.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440111
					],
					"speakerTitle": "Eileen"
				},
				{
					"id": 200440111,
					"content": "Moi non plus d'ailleurs... Je suis coincée ici jusqu'à ce que je trouve la solution...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440114
					],
					"speakerTitle": "Eileen"
				},
				{
					"id": 200440114,
					"content": "Si seulement mon arme était plus grande ou si j'avais un pouvoir élémentaire comme Jean, j'en serais pas là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eileen"
				},
				{
					"id": 200440109,
					"content": "Voyons voir ça ensemble...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200440112
					]
				},
				{
					"id": 200440112,
					"content": "Tu aimes bien combattre en équipe ? C'est super d'avoir quelqu'un sur qui on peut compter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440113
					],
					"speakerTitle": "Eileen"
				},
				{
					"id": 200440113,
					"content": "Le mieux que je puisse faire est de me battre seule...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440114
					],
					"speakerTitle": "Eileen"
				}
			]
		},
