					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 80000201,
					"content": "On dirait... qu'il y a quelqu'un !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000202,
					"content": "Est-ce que c'est... ce fameux Maître voleur ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000203,
					"content": "Mais pourquoi est-il dans cette position... Il est en train de prier ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000204,
					"content": "Hein ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000205,
					"content": "C'est... C'est...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000206,
						80000207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000206,
					"content": "Une... Statue des Sept !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000208
					]
				},
				{
					"id": 80000208,
					"content": "Mais... Cette Statue des Sept... Pourquoi est-elle suspendue la tête en bas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000209,
					"content": "Et ses mains... Je me souviens qu'elles tiennent un orbe d'habitude, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000210,
					"content": "Mais... Cette statue, elle tient... Qu'est-ce que c'est ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000211,
					"content": "Euh... J'ai un très mauvais pressentiment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000212,
					"content": "Et ce Maître voleur n'a pas bougé d'un pouce. Est-ce que tu penses qu'il est...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000213,
					"content": "Euh, bonjour ? Ça va ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000214,
					"content": "(Il n'y a aucune réaction, ni aucun signe de respiration.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000215
					]
				},
				{
					"id": 80000215,
					"content": "... Il... Il est mort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000216,
					"content": "#{NICKNAME}, je... Je ne me sens pas bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000217,
						80000218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000217,
					"content": "Quel endroit terrible...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000219
					]
				},
				{
					"id": 80000219,
					"content": "Sortons d'ici, et en vitesse ! On doit raconter tout ça à Ganyu et à Lan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000220
					],
					"speakerTitle": "Paimon"
