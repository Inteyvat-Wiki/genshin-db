			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ganyu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80000101,
					"content": "Oui, c'est vrai... Je sais bien qu'ils ont l'audace de s'en prendre à tout...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000102
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000102,
					"content": "Que ce soit des anciens artéfacts issus des Sept Archons, des dieux ou des dragons... Rien n'échappe à leurs ambitions avides.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000103
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000103,
					"content": "Pourtant, cette fois, c'est différent... Pour qui se prennent-ils... À vouloir s'attaquer aux trésors de l'Ordre de l'Abîme ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000104
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000104,
					"content": "#Oh, {M#voyageur}{F#voyageuse}, c'est vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000105
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000105,
					"content": "Oh, Ganyu ! Qu'est-ce que vous faites ici avec Lan ? Vous êtes en mission ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000106,
					"content": "#Bonjour {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000107
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000107,
					"content": "Nous parlions des Pilleurs de trésors.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000108
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000108,
					"content": "Oui, on se disait simplement que même ces perfides Pilleurs devraient savoir qu'il ne faut pas s'approcher de l'Abîme. C'est une puissance trop dangereuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000109
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000109,
					"content": "Mais nous avons récemment reçu des informations du Bureau des affaires civiles selon lesquelles deux des plus importants Pilleurs de trésors de Liyue et de Mondstadt envisagent une grande opération conjointe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000110
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000110,
					"content": "Deux des plus importants Pilleurs de trésors ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000111,
					"content": "Oui, ils sont connus sous le nom de « Grande Sœur du Sud » et de « Rapace du Nord ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000112
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000112,
					"content": "Oh ! Le Rapace ! Je me souviens, il avait essayé d'échapper à Amber à Mondstadt... Mais qui est cette « Grande sœur du Sud » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000113,
						80000114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000113,
					"content": "« Grande sœur »... Ça veut dire que c'est la sœur aînée ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000116
					]
				},
				{
					"id": 80000116,
					"content": "Vous avez raison. C'est elle qui est à la tête des Pilleurs de trésors de Liyue. Si je comprends bien, ils l'appellent tous « Grande Sœur », ou juste « Cheffe ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000117
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000117,
					"content": "Certains racontent même que le Dieu des voleurs lui a accordé sa bénédiction pour la récompenser de ses exploits, faisant d'elle la « Grande Sœur des dieux »... Mais ce n'est probablement qu'une rumeur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000118
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000118,
					"content": "Quoi qu'il en soit, les Pilleurs de trésors ont découvert des ruines jusqu'alors inexplorées que l'Ordre de l'Abîme protège dans le plus grand secret.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000119
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000119,
					"content": "Malgré le danger que ça implique, tout ce qui intéresse les Pilleurs de trésors, c'est de découvrir quels genres de trésors pourraient se trouver à l'intérieur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000120
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000120,
					"content": "Ils ont déjà prévu d'envoyer une troupe faire diversion, pendant qu'un voleur expert s'infiltrera pour s'emparer des trésors.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000121
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000121,
					"content": "Et c'est pour cette raison que la Cheffe et le Rapace auraient recruté un certain « Maître voleur » de Fontaine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000122
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000122,
					"content": "Un « Maître voleur » ? Ça en jette comme titre, ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000123,
					"content": "En effet. C'est un individu qui sort de l'ordinaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000124
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000124,
					"content": "Ce Maître voleur est très respecté parmi les Pilleurs de trésors... Un peu à la manière dont nous, les aventuriers, admirons les aventuriers célèbres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000125,
						80000127
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000125,
					"content": "Comme Alice par exemple ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000126
					]
				},
				{
					"id": 80000126,
					"content": "Ah, alors vous connaissez l'auteure du Guide de voyage en Teyvat ? Correct, le Maître voleur est une personne aussi renommée qu'elle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000129
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000129,
					"content": "Par conséquent, bien qu'ils jouissent d'un statut relativement important à Liyue et à Mondstadt, Grande sœur et le Rapace ont dû se démener pour convaincre un voleur de son envergure de superviser cette opération.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000130
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000130,
					"content": "Avec les changements majeurs qui ont récemment eu lieu à Liyue, le Bureau des affaires civiles et les Millelithes ont déjà les mains pleines. Ils n'ont pas le temps d'enquêter sur les rumeurs portant sur les activités des Pilleurs de trésors.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000131
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000131,
					"content": "Mais tout ce qui touche à l'Abîme me donne l'impression qu'un danger inconnu se cache sous la surface...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000132
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000132,
					"content": "J'ai donc décidé de venir à la Guilde des aventuriers pour publier une mission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000133,
						80000134
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000133,
					"content": "Eh bien, puisque je suis là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000135
					]
				},
				{
					"id": 80000135,
					"content": "Oui ! Laissez-nous cette mission !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000136,
					"content": "Oh, merci beaucoup...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000137
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000137,
					"content": "Bien, l'affaire est entre les mains d'un membre fiable de la Guilde. Eh bien, bonne chance ! La Guilde s'occupera des détails de cette mission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000134,
					"content": "Moi aussi, je comprends le danger de l'Abîme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000135
					]
				},
				{
					"id": 80000127,
					"content": "Comme Stanley par exemple ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000128
					]
				},
				{
					"id": 80000128,
					"content": "Oh, alors vous avez rencontré la légende vivante en personne pendant que vous étiez à Mondstadt ? Correct, le Maître voleur est quelqu'un d'aussi renommé que lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000129
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000114,
					"content": "Est-ce que c'est cette « Cheffe » que les Pilleurs de trésors mentionnent parfois ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000115
					]
				},
				{
					"id": 80000115,
					"content": "Vous en savez déjà beaucoup, je vois... Je suppose que vous avez dû croiser la route de ces Pilleurs de trésors plus d'une fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000116
					],
					"speakerTitle": "Lan"
				}
			]
		},
		{
			"id": 800002,
			"completionStepIds": [
				800004
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800004",
