				"points": []
			},
			"dialogs": [
				{
					"id": 722010201,
					"content": "Pouhahahahaha !! Ah... Hahaha ! Je n'arrive plus à... respirer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010202
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010202,
					"content": "Je suis en train de pleurer de rire, hahahaha !! Ah, ma chère Chikapu, si seulement tu étais là !!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010203,
						722010204
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010203,
					"content": "Je dois dire que vous me tapez sérieusement sur les nerfs.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010205
					]
				},
				{
					"id": 722010205,
					"content": "Hahahaha... Désolé, désolé... Ne vous mettez pas en colère, s'il vous plaît...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010206
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010206,
					"content": "Ma femme et moi avons toujours aimé jouer des tours aux gens. Nous n'avons jamais fait le même deux fois. Tout le monde les trouvait drôles !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010207
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010207,
					"content": "Elle est tombée gravement malade par la suite et y a succombé jeune... C'est elle qui m'a dit de faire cette blague à quelqu'un devant sa tombe ou son esprit ne pourrait pas quitter ce monde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010208
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010208,
					"content": "Voilà, c'était le vœu de Chikapu. Comment avez-vous trouvé ça ? Pas mal, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010209,
						722010210,
						722010211
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010209,
					"content": "C'était nul.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010212
					]
				},
				{
					"id": 722010212,
					"content": "Allez ! Vous, étrangers, n'êtes pas drôles !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010213
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010213,
					"content": "Même ma blague du pulvérisateur d'eau n'a pas réussi à vous décrocher un sourire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010214
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010214,
					"content": "Bon, j'y vais. À plus !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010210,
					"content": "Vous avez failli nous faire tuer !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010212
					]
				},
				{
					"id": 722010211,
					"content": "Je vais avoir du mal à vous faire confiance maintenant.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010212
					]
				},
				{
					"id": 722010204,
					"content": "C'est quoi votre problème ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010205
					]
				}
			]
		},
