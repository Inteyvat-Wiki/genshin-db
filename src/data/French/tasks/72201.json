			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rero"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722010101,
					"content": "#Ah, {M#passants}{F#passantes} au bon cœur... Je vous en prie, ayez pitié de moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010102,
						722010103
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010102,
					"content": "Qu'est-ce qui vous arrive ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010104
					]
				},
				{
					"id": 722010104,
					"content": "Merci de vous arrêter pour écouter les jérémiades d'un vieillard... *soupir* Venez, venez, laissez-moi vous en dire plus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010105
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010105,
					"content": "Je n'ai jamais eu de chance dans ma vie, pas une fois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010106
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010106,
					"content": "Lorsque je n'étais qu'un nouveau-né, le prêtre a fait tomber une lampe et a brûlé toute la chevelure de ma tante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010107
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010107,
					"content": "Oh non...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010108
					]
				},
				{
					"id": 722010108,
					"content": "Plus tard, j'ai contracté une étrange maladie, et à partir de là, j'ai souffert d'une maladresse chronique. Plus tard, je suis tombé de mon berceau, me cassant six côtes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010109
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010109,
					"content": "Un peu plus tard, mon père m'a frappé sur la tête avec sa pelle par accident lorsqu'il essayait de sauver mon cousin qui était en train de s'étouffer en mangeant des champignons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010110
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010110,
					"content": "Et puis, il y a eu cette fois où mon pinson bien-aimé a été dévoré par le Wen Kamuy de ma famille. D'ailleurs, le Wen Kamuy en question s'est fait pousser du haut d'une falaise par un sanglier...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010111
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010111,
					"content": "Après, la fille que j'aimais a accidentellement sacrifié le prêtre à l'Oiselle du tonnerre, alors elle a été exilée de l'île...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010112
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010112,
					"content": "En grandissant, ma grand-mère est morte parce qu'elle me trouvait trop moche et mon grand-père l'a suivie peu de temps après...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010113
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010113,
					"content": "Et puis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010114
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010114,
					"content": "Votre famille était là pour vous, non ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010115
					]
				},
				{
					"id": 722010115,
					"content": "En parlant de famille... Quand j'ai atteint la majorité, notre shaman m'a dit que je ne pourrais pas avoir d'enfant parce que... Attendez que je vous montre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010116,
						722010117
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010116,
					"content": "Ça ira !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010118
					]
				},
				{
					"id": 722010118,
					"content": "*soupir* Je vois, mais pourriez-vous au moins écouter une dernière chose que j'ai à dire ? Si ça ne vous gêne pas, j'aimerais que vous m'aidiez à faire quelque chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010119,
						722010120
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010119,
					"content": "Je vous écoute.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010121
					]
				},
				{
					"id": 722010121,
					"content": "Il y a quelque temps, j'ai fait tomber mon anneau en or dans la tombe de ma femme quand je l'ai enterrée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010122
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010122,
					"content": "Cet anneau est la dernière de mes possessions, mais je n'ose pas aller le déterrer de peur que l'esprit de ma femme se mette en colère contre moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010123
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010123,
					"content": "Vous me demandez de piller une tombe ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010124
					]
				},
				{
					"id": 722010124,
					"content": "#Hum, eh bien, vous êtes {M#un étranger}{F#une étrangère}... Je suis sûr que vous faites toutes sortes de choses...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010125
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010125,
					"content": "#Ah non, non, non... Je voulais dire que {M#seul un étranger}{F#seule une étrangère} comme vous ne risquerait pas de fâcher les esprits d'ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010126
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010126,
					"content": "Rendez-vous au Sanctuaire de Chirai, c'est là que ma femme repose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010120,
					"content": "Du moment que ce n'est pas un truc bizarre...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010121
					]
				},
				{
					"id": 722010117,
					"content": "J'en sais trop, stop !!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010118
					]
				},
				{
					"id": 722010103,
					"content": "Vous avez besoin d'aide ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010104
					]
				}
			]
		},
