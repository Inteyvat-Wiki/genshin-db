			"dialogs": [
				{
					"id": 762000801,
					"content": "Andouille de chat... Mais où es-tu passé...? Oh ! Vous l'avez trouvé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000802
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000802,
					"content": "Il était piégé dans ces népenthes doubles là-bas. Ce ne sont que des plantes, mais elles sont carnivores et peuvent digérer des luciolunes en à peine quelques jours...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000803
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000803,
					"content": "Heureusement que nous l'avons trouvé à temps. Il est juste un peu faible pour l'instant, mais qui sait ce qui aurait pu arriver si nous avions tardé à intervenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000804
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000804,
					"content": "Q—Quel soulagement... C'est dangereux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000805
					],
					"speakerTitle": "Jukka"
				},
				{
					"id": 762000805,
					"content": "Hmph, tu ne peux t'en prendre qu'à toi-même pour avoir rampé là-dedans, andouille de chat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000806
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000806,
					"content": "Eh bien, ce n'est pas vraiment la faute du chat. Ces népenthes doubles dégagent une odeur particulière. Les humains n'y sont pas sensibles, mais les insectes et autres petites créatures peuvent être attirés par cette odeur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000807
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000807,
					"content": "C'est ainsi que ces plantes piègent leurs proies. On trouve ici un nombre inhabituel de népenthes doubles, et les petits animaux sont également affectés par leur présence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000808
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000808,
					"content": "Oh... Je vois. Quoi qu'il en soit, le fait qu'il y ait autant de ces plantes qui poussent ici n'est certainement pas un bon signe, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000809
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000809,
					"content": "Exactement. Si on les ignore, elles pourraient causer de sérieux problèmes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000810
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000810,
					"content": "Très bien, alors nous nous occuperons du désherbage. Jukka, viens nous aider !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000811
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000811,
					"content": "Ces plantes ont fait souffrir notre pauvre andouille de chat. Nous devons leur rendre la pareille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000812
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000812,
					"content": "Grâce à l'aide des deux chasseurs de trésors, la prolifération inhabituelle des népenthes doubles dans la zone est enfin éradiquée...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						762000813
					]
				},
				{
					"id": 762000813,
					"content": "Ouf... C'est enfin terminé. Il est temps de rentrer au Village de Nasha. Merci beaucoup de nous avoir aidés à retrouver cette andouille de chat, mademoiselle. Sans votre aide, qui sait combien de temps il serait resté coincé là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000814
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000814,
					"content": "Maintenant que j'y pense, Marja, si tu n'avais pas crié aussi fort tout à l'heure, on l'aurait peut-être trouvé plus tôt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000815
					],
					"speakerTitle": "Jukka"
				},
				{
					"id": 762000815,
					"content": "Q—Qu'est-ce que tu racontes ? Peu importe, l'important, c'est qu'il soit en sécurité maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000816
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000816,
					"content": "(Même si elle l'appelle tout le temps « andouille de chat », elle tient vraiment à son compagnon, héhé.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000817
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000817,
					"content": "Oui, c'est vrai. L'important, c'est qu'il aille bien. C'est dangereux par ici dans la nature sauvage. Soyez prudents, vous aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000818
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000818,
					"content": "Merci. Nous ferons attention.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000819
					],
					"speakerTitle": "Jukka"
				},
				{
					"id": 762000819,
					"content": "Et bonne chance pour votre enquête. Au revoir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marja"
				}
			]
		},
