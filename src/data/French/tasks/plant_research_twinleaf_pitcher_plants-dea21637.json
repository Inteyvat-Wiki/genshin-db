			"dialogs": [
				{
					"id": 762000201,
					"content": "Excusez-moi, auriez-vous vu un chat tigré dans les parages ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000202
					],
					"speakerTitle": "Jukka"
				},
				{
					"id": 762000202,
					"content": "Un chat tigré ? Hmm, je ne crois pas... Lumi, ça te dit quelque chose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000203
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000203,
					"content": "Ya-ho ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000204
					],
					"speakerTitle": "Lumi"
				},
				{
					"id": 762000204,
					"content": "On dirait que Lumi ne l'a pas vu non plus. Vous avez perdu votre chat ? Je peux vous aider à le chercher ! Je connais très bien le coin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000205
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000205,
					"content": "Hé, Jukka ! Nous n'avons pas les moyens de payer les services d'une aventurière. Et puis, ce n'est qu'une andouille de chat, tant pis pour lui s'il s'est perdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000206
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000206,
					"content": "Ne dis pas ça, Marja. Il serait triste s'il t'entendait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000207
					],
					"speakerTitle": "Jukka"
				},
				{
					"id": 762000207,
					"content": "Comme s'il pouvait nous entendre ! Si c'était le cas, il serait déjà revenu. Ça fait des heures qu'on crie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000208
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000208,
					"content": "Pas besoin de me payer pour ça. J'avais de toute façon l'intention de faire un tour dans les environs. Je vais profiter de l'occasion pour jeter un œil. Allons-y, Lumi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000209
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000209,
					"content": "(Il y a peu, cet endroit était désert. Aujourd'hui, il regorge de népenthes doubles.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000210
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000210,
					"content": "(Peut-être qu'un animal a transporté les graines jusqu'ici, mais je ne peux pas les laisser se propager comme ça...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linnea"
				}
			]
		},
