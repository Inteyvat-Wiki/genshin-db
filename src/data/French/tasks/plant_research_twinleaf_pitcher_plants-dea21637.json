			"dialogs": [
				{
					"id": 762000501,
					"content": "Lumi, tu penses aussi qu'il est ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000502
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000502,
					"content": "Ya-hoho !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000503
					],
					"speakerTitle": "Lumi"
				},
				{
					"id": 762000503,
					"content": "Le chat piégé est secouru...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						762000504
					]
				},
				{
					"id": 762000504,
					"content": "C'est donc toi qu'ils cherchaient, hein ? Hm... Tu n'as pas l'air blessé. Heureusement que nous t'avons trouvé à temps, sinon qui sait ce qui aurait pu t'arriver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000505
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000505,
					"content": "Quoi qu'il en soit, commençons par te ramener à tes amis !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linnea"
				}
			]
		},
