			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732011301,
					"content": "« Après tant d'années, ce café est toujours aussi vivant ! Chaque fois que je viens ici, je ne peux m'empêcher de penser à tous ces après-midi que j'ai passés à discuter avec lui sur l'interprétation de chaque symbole. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011302
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732011302,
					"content": "Ce café ne serait pas aussi vivant sans vous. Revenez souvent nous voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tableau de messages"
				}
