			},
			"dialogs": [
				{
					"id": 732010101,
					"content": "Ceci est le forum du Café Puspa. Pour certaines raisons, je serai temporairement la gérante suppléante du café. Si vous souhaitez nous faire part de vos remarques, n'hésitez pas à laisser des messages.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tableau de messages"
				}
			]
		},
		{
			"id": 7320102,
			"completionStepIds": [
				7320102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320102",
							"2"
						],
						"stepId": 7320102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010201,
					"content": "« Cette semaine, nous continuerons avec la légende d'Antara ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010202
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732010202,
					"content": "« Présenté par notre invité spécial : Maddah, le conteur du Café Puspa ! Ne manquez pas ce rendez-vous ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010203
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732010203,
					"content": "Monsieur Maddah... Nous vous offrons une tasse de café gratuite si vous arrêtez de poster des publicités ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tableau de messages"
				}
			]
		},
		{
			"id": 7320103,
			"completionStepIds": [
				7320103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320103",
							"2"
						],
						"stepId": 7320103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010301,
					"content": "« Héhé, Gata, héhé. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010302
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732010302,
					"content": "Gata aussi a l'air de bien vous aimer, madame Nilou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tableau de messages"
				}
			]
		},
		{
			"id": 7320104,
			"completionStepIds": [
				7320104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320104",
							"2"
						],
						"stepId": 7320104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010401,
					"content": "« Le club d'Invocation des Sept du Café Puspa cherche des membres ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010402
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732010402,
					"content": "« Si vous souhaitez discuter de stratégie et de techniques de jeu, venez me trouver à la table de jeu ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010403
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732010403,
					"content": "Monsieur Nayab, commandez au moins une tasse de café si vous voulez jouer aux cartes ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tableau de messages"
				}
			]
		},
		{
			"id": 7320105,
			"completionStepIds": [
				7320105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320105",
							"2"
						],
						"stepId": 7320105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010501,
					"content": "« Plusieurs cas de contrebande de concentrés de connaissances ont eu lieu récemment. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010502
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732010502,
					"content": "« Les matras rappellent aux étudiants qu'ils doivent effectuer des demandes régulières pour obtenir les connaissances qu'ils recherchent. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010503
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732010503,
					"content": "« Obtenir des connaissances interdites par des biais illégaux entraînera une expulsion de l'Académie. Veuillez agir avec prudence. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tableau de messages"
				}
			]
		},
		{
			"id": 7320106,
			"completionStepIds": [
				7320106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320106",
							"2"
						],
						"stepId": 7320106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010601,
					"content": "« Pour un étudiant comme moi, qui prépare ses examens, l'atmosphère d'ici est beaucoup plus conviviale que celle de la taverne. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010602
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732010602,
					"content": "« Il y a du café pour me revigorer et d'anciens étudiants qui peuvent me donner des conseils. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010603
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732010603,
					"content": "« Et la gérante suppléante a prédit que je réussirais à l'examen d'entrée de l'Académie cette année ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010604
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732010604,
					"content": "Que votre souhait se réalise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tableau de messages"
				}
			]
		},
		{
			"id": 7320107,
			"completionStepIds": [
				7320107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320107",
							"2"
						],
						"stepId": 7320107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010701,
					"content": "« Faites gaffe, tout le monde ! Mon ami a rencontré le Radja rishboland au milieu de la nuit dans la forêt du nord-ouest ! Il a eu de la chance de revenir sain et sauf. En tout cas, ne sortez pas après le coucher du soleil ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tableau de messages"
				}
			]
		},
		{
			"id": 7320108,
			"completionStepIds": [
				7320108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320108",
							"2"
						],
						"stepId": 7320108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010801,
					"content": "« Les dernières recherches de la grande chercheuse Pursina suggèrent que boire du café permet d'améliorer les facultés cognitives du cerveau. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010802
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732010802,
					"content": "« Si vous cherchez à entrer à l'Académie, venez souvent boire du café ici. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010803
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732010803,
					"content": "Je vous remercie de faire de la publicité pour notre café, mais boire du café aura pour unique effet de vous donner un peu plus d'énergie... De plus, les mahamatas pourraient prendre des mesures contre des déclarations infondées telles que celles-ci, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tableau de messages"
				}
			]
		},
		{
			"id": 7320109,
			"completionStepIds": [
				7320109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320109",
							"2"
						],
						"stepId": 7320109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010901,
					"content": "« Si vous venez jouer aux cartes dans ce café, ne faites pas comme moi. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010902
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732010902,
					"content": "« Je n'aurais pas dû inventer une carte qui n'existe pas pour duper les autres joueurs en jouant à l'Invocation des Sept »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010903
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732010903,
					"content": "« Le seigneur Chacal m'a aidé à me rendre compte de mes erreurs. J'écris ce message pour me confesser. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010904
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732010904,
					"content": "« La plupart des gens sont incapables de se rendre compte de leurs erreurs. Mais... qui est ce seigneur Chacal, déjà ? »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tableau de messages"
				}
			]
		},
		{
			"id": 7320110,
			"completionStepIds": [
				7320110
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320110",
							"2"
						],
						"stepId": 7320110,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732011001,
					"content": "« J'ai entendu dire que de nombreux bandits sont apparus dans le désert, et que plusieurs caravanes marchandes refusent d'emprunter les routes le traversant. Le prix des noix d'ajilenakh devrait subir une augmentation significative. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011002
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732011002,
					"content": "« C'est génial ! Je vais tout de suite vendre tous mes champignons pour me procurer des noix d'ajilenakh ! Haha ! C'est peut-être ça, le courage qui se transmet au sein du Clan Alkindi ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011003
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732011003,
					"content": "Je vous souhaite de faire fortune, mais je tiens à préciser que notre café n'est pas responsable des pertes financières qui pourraient résulter des informations publiées sur ce tableau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tableau de messages"
				}
			]
		},
		{
			"id": 7320111,
			"completionStepIds": [
				7320111
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320111",
							"2"
						],
						"stepId": 7320111,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732011101,
					"content": "« Depuis que j'ai pris ma retraite de la Légion des trente, je prends une tasse de café ici tous les jours. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011102
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732011102,
					"content": "« Tous les jours, la gérante suppléante me sert le même café, et le conteur raconte la même histoire. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011103
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732011103,
					"content": "« Ce recommencement perpétuel est sans doute la véritable signification de la vie à Sumeru. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tableau de messages"
				}
			]
		},
		{
			"id": 7320112,
			"completionStepIds": [
				7320112
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320112",
							"2"
						],
						"stepId": 7320112,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732011201,
					"content": "« Les histoires racontées par monsieur Maddah sont peut-être démodées, mais il est très doué pour leur donner du rythme. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011202
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732011202,
					"content": "« Toutefois, de nos jours, tout le monde a l'habitude de s'informer auprès de l'Akasha. Les gens sont donc inconsciemment incapables de voir la sophistication derrière ces techniques et la maturité de cette forme d'art. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011203
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732011203,
					"content": "« Je ne partage pas votre avis. Aucune forme d'art n'est éternelle. Le jour où toute la valeur d'un art a été exploitée, celui-ci perd sa raison d'être. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011204
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732011204,
					"content": "« Par exemple, lorsque les fruits sont trop mûrs, ils tombent sur la terre et nourrissent de nouvelles plantes. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011205
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732011205,
					"content": "« C'est pourquoi j'ai toujours méprisé les matérialistes comme vous. L'art est un fruit précieux du temps libre, comment pouvez-vous le mettre sur le même plan qu'un produit issu de l'exploitation ayant pour but d'être consommé ? »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011206
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732011206,
					"content": "« Les personnes oisives, c'est comme les gens qui marchent sur une terre ronde : ça n'existe pas. Pourquoi n'utilisez-vous pas votre intelligence et ne réfléchissez pas un instant ? Toute activité de production peut-elle exister sans échange commercial ? »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011207
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732011207,
					"content": "« Encore un débat houleux entre vous deux... Quoi qu'il en soit, monsieur Kaveh, il est temps de payer vos notes de ce mois-ci. Faut-il mettre tout cela sur le compte de monsieur Alhaitham, comme d'habitude ? »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011208
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732011208,
					"content": "« Non. Je veux que ce type gâté connaisse la dure réalité du monde des affaires. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011209
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732011209,
					"content": "« Mademoiselle, mettez-les sur le compte du seigneur Sangemah Bay. Après tout, ce n'est qu'en ayant suffisamment de troquets que l'art peut fleurir ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tableau de messages"
				}
			]
		},
		{
			"id": 7320113,
			"completionStepIds": [
				7320113
