			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bertrand"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726970101,
					"content": "#Héhé ! Vous voilà, {NICKNAME} et Paimon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970102
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970102,
					"content": "Mon usine à jouets va bientôt ouvrir ses portes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970103
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970103,
					"content": "Votre usine à jouets ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726970104,
					"content": "Ahem... Ce n'est que la méga-machine et moi-même pour l'instant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970105
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970105,
					"content": "Bref. J'ai simplifié les processus de la machine et cela a considérablement réduit le temps de production.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970106
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970106,
					"content": "La production est loin d'être instantanée, mais on peut au moins la qualifier de « rapide ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970107
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970107,
					"content": "Ouah, ça m'a l'air impressionnant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726970108,
					"content": "Au passage, j'ai effectué quelques améliorations sur le Collecteur de matériaux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970109
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970109,
					"content": "Avant, il fallait que vous reveniez ici après chaque processus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970110
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970110,
					"content": "Ce n'était pas très optimal, alors j'ai bidouillé l'appareil. Désormais, il se met à jour en fonction de votre progression au cours de chaque processus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970111
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970111,
					"content": "Il change de configuration tout seul...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726970112,
					"content": "... Selon les matériaux collectés ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726970113,
					"content": "Je ne comprends pas trop...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726970114
					]
				},
				{
					"id": 726970114,
					"content": "Hum, comment pourrais-je vous l'expliquer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970115
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970115,
					"content": "Admettons que le premier processus requiert dix pommes crépusculaires, qu'il faut de l'élément Hydro pour terminer le deuxième et vaincre trois Hydroblobs pour le troisième.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970116
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970116,
					"content": "Une fois que vous avez collecté les dix pommes crépusculaires avec le Collecteur, il les prendra en compte et sera en mesure d'estimer que le premier processus est terminé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970117
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970117,
					"content": "Ensuite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970118
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970118,
					"content": "J'ai compris ! L'appareil changera de mode pour collecter les matériaux du processus suivant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726970119,
					"content": "Exactement ! Il se mettra en mode de recharge élémentaire pour collecter de l'énergie Hydro et changera de configuration une fois que ce sera fait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970120,
						726970121
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970120,
					"content": "Il passera au troisième processus...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726970122
					]
				},
				{
					"id": 726970122,
					"content": "Oui ! Et il vous suffira de vaincre deux Hydroblobs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970123
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970123,
					"content": "Ça me semble beaucoup plus pratique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726970124,
					"content": "Et comment ! J'ai passé une nuit blanche rien que pour parvenir à ce résultat ! C'est ce que j'appelle « l'ultime 3 en 1 »...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970125
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970125,
					"content": "Le Collecteur de matériaux est vraiment génial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726970126,
					"content": "C'est vrai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726970127
					]
				},
				{
					"id": 726970127,
					"content": "Héhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970128
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970128,
					"content": "S'il est aussi génial, pourquoi vous nous le donnez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726970129,
					"content": "Je suis coincé à Ritou pour le moment, comme vous le voyez. Je ne peux pas collecter de matériaux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970130
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970130,
					"content": "Allez, aidez-moi un peu. Dès que les jouets se seront vendus, vous aurez une part des bénéfices et je vous donne même un jouet gratis !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970141
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970141,
					"content": "Vous vous souvenez du bon que je vous ai donné ? Eh bien, il est toujours valide pour un jouet gratuit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970142
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970142,
					"content": "Du moment que vous en avez créé le modèle, évidemment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970131
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970131,
					"content": "Quoi ? On a mis du sang, de la sueur et des larmes dans cette collecte de matériaux ! Tout ça pour quelques moras et un jouet ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726970132,
					"content": "#C'est scandaleux ! Partons, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726970133,
					"content": "Attendez... Que diriez-vous d'une plus grande part des bénéfices et deux... Non, trois jouets ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970134
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970134,
					"content": "On y va, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726970135
					]
				},
				{
					"id": 726970135,
					"content": "Quatre ! Je vous en donne quatre ! C'est ma dernière offre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970136
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970136,
					"content": "*soupir* Si je n'étais pas endetté jusqu'au cou, vous auriez pu tous les avoir si vous le vouliez. Malheureusement, il faut que je rembourse l'Association du commerce international...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970137
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970137,
					"content": "Bon, juste parce que vous me faites de la peine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726970138
					]
				},
				{
					"id": 726970138,
					"content": "*soupir* Oui, on accepte de vous aider parce que vous êtes en détresse. Pas besoin de moras et des quatre jouets.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726970139,
					"content": "Héhé, merci du fond du cœur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970140
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970140,
					"content": "Je suis vraiment soulagé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970121,
					"content": "Il entrera en processus d'activation des noyaux...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726970122
					]
				}
			]
		}
	]
}