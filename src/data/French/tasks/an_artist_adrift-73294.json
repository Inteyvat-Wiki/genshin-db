				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Julien"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732941201,
					"content": "On est de retour ! C'était donc bien votre animal de compagnie, Julien !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941202,
					"content": "(Il fait un bruit menaçant.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941203
					],
					"speakerTitle": "Chien"
				},
				{
					"id": 732941203,
					"content": "... Ouah. Pourquoi grognes-tu, Poivre ? Moi qui te nourris tous les jours !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941204
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941204,
					"content": "(Oh, ce chien a un nom ! Par contre, est-ce que Julien va bien ? Il se dispute avec un chien quand même...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941205,
						732941207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941205,
					"content": "(Ils ont l'air de bien s'entendre.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941206
					]
				},
				{
					"id": 732941206,
					"content": "(C'est vraiment l'impression qu'ils te donnent ?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941244,
					"content": "Julien ! On a récupéré ce que vous avez perdu. Poivre est bien votre animal de compagnie, non ? Pourquoi vous nous avez menti tout à l'heure ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941209,
					"content": "Cet ingrat, mon animal de compagnie ? Je préférerais avoir un Limier de faille comme compagnon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941210
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941210,
					"content": "Je doute que vous soyez des compagnons pendant bien longtemps...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941211
					]
				},
				{
					"id": 732941211,
					"content": "C'est vrai. Vous perdez connaissance rien qu'avec un estomac vide... Si vous tombiez sur un Limier de faille, il faudrait beaucoup plus qu'un simple œuf au plat de Teyvat pour résoudre le problème.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941212,
					"content": "D'ailleurs, votre chien était en train de garder une planche à dessin sur la plage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941213,
						732941215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941213,
					"content": "Il voulait peut-être la cacher ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941214
					]
				},
				{
					"id": 732941214,
					"content": "Ouah ! Mauvais chien !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941217,
					"content": "(Il aboie en protestation.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941218
					],
					"speakerTitle": "Chien"
				},
				{
					"id": 732941218,
					"content": "Tu râles en plus ? J'aurais pu déjà être de retour à Fontaine si je ne t'avais pas suivi dans cette voie sans issue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941219
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941219,
					"content": "Hein ? Vous nous aviez dit avoir emprunté la voie maritime pour admirer les paysages, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941220,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941221
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941221,
					"content": "Bon, j'avoue tout. Je ne l'ai pas fait pour admirer les paysages, mais parce que j'ai suivi ce chien jusqu'ici. Les routes sont sinueuses et il est facile de se perdre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941222
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941222,
					"content": "Oh, c'était donc pour ça. Vous auriez juste pu nous dire la vérité dès le début. Pourquoi nous avez-vous menti ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941223,
					"content": "Euh... P—Pour préserver mon image d'artiste renommé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941224
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941224,
					"content": "J'ai l'impression que vous nous mentez à chaque fois que vous bégayez comme ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941225,
					"content": "#En revanche, {NICKNAME} et moi, on connaît pas mal d'endroits avec une belle vue. Ça vous dirait qu'on vous y emmène ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941226,
					"content": "Non, ça va. J'apprécie vos intentions, mais en tant qu'artiste renommé, j'estime que les paysages les plus beaux sont ceux que l'on découvre soi-même...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941227
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941227,
					"content": "Ah, le thé est prêt à être servi. Auriez-vous par hasard des œufs au plat sur vous ? Ils feraient d'excellents encas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941228,
						732941230
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941228,
					"content": "Des œufs au plat et du thé...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941229
					]
				},
				{
					"id": 732941229,
					"content": "#C'est bizarre comme combinaison ! {NICKNAME} est {M#un}{F#une} pro des fourneaux, {M#il}{F#elle} peut nous préparer autre chose, héhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941232,
					"content": "Vous prenez le thé avec quelques encas.\\nLa boisson a un goût particulier...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732941233
					]
				},
				{
					"id": 732941233,
					"content": "Euh, ce thé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941234,
					"content": "C'est un ami qui me l'a vendu. Il m'a dit que ce breuvage pouvait éveiller la sagesse en vous. Je le trouve très bon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941235,
						732941237
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941235,
					"content": "#Je suis {M#ravi}{F#ravie} de ne pas avoir ce genre d'ami.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941236
					]
				},
				{
					"id": 732941236,
					"content": "Pourquoi ? C'est bien d'en avoir. D'ailleurs, je suis venu ici sur la recommandation d'un ami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941240
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941240,
					"content": "Merci pour vos services aujourd'hui. Je ne sais pas si cette récompense est à la hauteur, mais tenez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941241
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941241,
					"content": "Ce n'est rien... Mais vous êtes sûr que vous n'avez pas besoin de notre aide pour trouver de l'inspiration ? J'ai le sentiment que vous allez encore vous perdre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941242,
					"content": "L'objectif d'un pèlerinage... Enfin, celui d'un voyage, est de l'entreprendre soi-même. Je ne souhaite pas vous déranger plus que ça. J'y arriverai seul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941243
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941243,
					"content": "Si vous le dites... N'allez pas vous évanouir de faim, hein !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941237,
					"content": "Pourrais-je avoir une autre tasse de ce thé ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941238
					]
				},
				{
					"id": 732941238,
					"content": "#Tes papilles gustatives sont normales, {NICKNAME} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941239,
					"content": "Haha ! Je ne voudrais pas sembler pingre, mais il faut que j'en garde pour moi. Mon séjour à Sumeru durera un certain temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941240
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941230,
					"content": "Quelle douce illusion...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941231
					]
				},
				{
					"id": 732941231,
					"content": "Hum... Mais il manque quelque chose non ? C'est tristounet de boire du thé tout seul. Préparons quelques encas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941215,
					"content": "Il voulait peut-être empêcher la planche à dessin d'être volée ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941216
					]
				},
				{
					"id": 732941216,
					"content": "Mais il s'est enfui dès qu'on l'a vu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941207,
					"content": "(Je ne sens pas d'odeur d'alcool.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941208
					]
				},
				{
					"id": 732941208,
					"content": "(Peut-être qu'il se comporte habituellement comme ça ? Il n'a pas l'air facile à vivre.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941244
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}