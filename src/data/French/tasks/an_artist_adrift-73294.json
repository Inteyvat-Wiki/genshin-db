			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Julien"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732940101,
					"content": "Ugh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940102
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940102,
					"content": "#Ce monsieur n'a pas l'air d'aller bien... Il doit être affamé ! Donnons-lui un peu de nourriture, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940103,
						732940105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940103,
					"content": "J'espère qu'il pourra reprendre des forces.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940104
					]
				},
				{
					"id": 732940104,
					"content": "#En toute objectivité, je pense que tu cuisines bien, {NICKNAME} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940107,
					"content": "Vous donnez un œuf au plat de Teyvat à l'homme affaibli.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732940108
					]
				},
				{
					"id": 732940108,
					"content": "Je... Je reviens à la vie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940109
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940109,
					"content": "Ouah, il devait vraiment avoir faim. Ce n'était qu'un œuf au plat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940110,
					"content": "Cette saveur était revitalisante... Ah, si j'avais su que c'était aussi délicieux, j'aurais acheté l'œuf mystérieux que ce type m'avait proposé ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940111
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940111,
					"content": "Quel œuf mystérieux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940112,
					"content": "On raconte que cet œuf repousse la malchance pendant un jour s'il est mangé. J'aurais dû en acheter un... Non, peut-être même douze...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940113
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940113,
					"content": "Hum, c'est une affaire pas nette. Je reconnais une arnaque quand j'en vois une. Et comment en êtes-vous arrivé là ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940114,
					"content": "Je suis... un artiste fontainois renommé, en voyage à Sumeru pour trouver l'inspiration. Appelez-moi Julien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940115,
						732940117
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940115,
					"content": "De l'inspiration ? Ici ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940116
					]
				},
				{
					"id": 732940116,
					"content": "Il existe sûrement des endroits plus inspirants qu'ici, non ? Avec une meilleure vue, et surtout, moins dangereux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940119,
					"content": "Si vous êtes vraiment un artiste de Fontaine, vous pouvez m'expliquer ce que vous faites sans vos affaires ? Vous êtes un espion des Fatui, hein ! Avouez tout !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940120,
					"content": "Vous extrapolez ! C'est à se demander quel genre de vécu vous avez eu pour avoir de telles réflexions ! Mais n'ayez crainte, je suis vraiment peintre. Et c'est tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940121
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940121,
					"content": "Je m'apprêtais à rentrer à Fontaine après avoir fait le plein d'inspiration ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940122
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940122,
					"content": "Mais je n'aurais jamais cru que le climat de Sumeru pouvait être aussi sec. Lorsque j'ai traversé le Vallon Chenyu, le climat était encore relativement humide. Ensuite, les tempêtes de sable ont commencé à faire rage lorsque j'ai franchi les limites de Sumeru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940123
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940123,
					"content": "Je suis plus habitué au climat humide, alors j'avais prévu de rentrer par voie maritime pour admirer différents paysages. Hélas, mon radeau a été emporté et je ne sais pas nager...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940124
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940124,
					"content": "J'imagine que la vie à Fontaine n'est pas de tout repos pour vous.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940125
					]
				},
				{
					"id": 732940125,
					"content": "Vous avez raison. Enfin, pas seulement parce que je ne sais pas nager... *soupir* Oubliez ça. J'ai trouvé un endroit où me reposer près de l'eau et quelques feuilles de thé qui n'ont pas été complètement détruites. Permettez-moi de vous remercier...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940126
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940126,
					"content": "Vous nous invitez à prendre le thé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940127,
					"content": "Évidemment ! Je dois exprimer ma reconnaissance pour l'œuf au plat. Comment puis-je vous appeler ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940128
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940128,
					"content": "Ah, on a failli oublier de se présenter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940129,
						732940130,
						732940132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940129,
					"content": "#{NICKNAME} et Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940134
					]
				},
				{
					"id": 732940134,
					"content": "Vous avez de superbes prénoms. Bref, quoi qu'il en soit, je vous invite à venir prendre le thé dans mon humble campement. C'est tout près.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940130,
					"content": "#{NICKNAME}, l'émissaire de la justice et Paimon, son assistante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940131
					]
				},
				{
					"id": 732940131,
					"content": "#Voici {NICKNAME} et je suis Paimon, sa meilleure amie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940132,
					"content": "Chevelure d'or et crinière d'argent.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940133
					]
				},
				{
					"id": 732940133,
					"content": "#{NICKNAME}, chevelure d'or et Paimon, crinière d'argent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940117,
					"content": "Il y a vraiment des gens qui s'autoproclament « renommés » ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940118
					]
				},
				{
					"id": 732940118,
					"content": "Ouais !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940105,
					"content": "Haha, mais ce n'est pas de toi qu'il s'agit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940106
					]
				},
				{
					"id": 732940106,
					"content": "On a tous failli tomber dans les pommes à cause d'un estomac vide, au moins une fois dans notre vie, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940107
					],
					"speakerTitle": "Paimon"
				}
			]
		},
