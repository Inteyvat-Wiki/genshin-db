			"dialogs": [
				{
					"id": 747050101,
					"content": "Hmm, je dirais... celui-ci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050102
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 747050102,
					"content": "Je vois ce que vous voulez dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050103
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747050103,
					"content": "Pourquoi celui-ci ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050104
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 747050104,
					"content": "Regardez la couleur de sa queue. C'est ce qu'il y a de plus tendance dans tout l'aquarium.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050105
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 747050105,
					"content": "Les couleurs sont un peu voyantes à mon goût, mais d'accord, je vais prendre ça comme un compliment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050106
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 747050106,
					"content": "Ouah ! Il y en a du monde ! Vous êtes là pour voir les poissons ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747050107,
					"content": "Oui ! Je viens de terminer une scène, alors j'en profite pour admirer cet aquarium.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050108
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747050108,
					"content": "De quoi parliez-vous à l'instant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747050109,
					"content": "Nous étions en train de décider quel poisson ressemblait le plus à Chiori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050110
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 747050110,
					"content": "Vous faites ça aussi ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747050111,
					"content": "Oh... Haha, eh bien, en fait c'est Columbina qui en a parlé la première. Ça avait l'air amusant, puis on a commencé à le faire aussi sans nous en rendre compte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050112
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747050112,
					"content": "C'est donc contagieux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747050113,
					"content": "Oh, regardez ! Celui-là vous ressemble, Chevreuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050114
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 747050114,
					"content": "Comment ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050115
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 747050115,
					"content": "Il ne s'arrête jamais, il fait des longueurs dans l'aquarium. Exactement comme vous, toujours en train de vous entraîner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050116
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 747050116,
					"content": "... C'est donc comme ça que vous me voyez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chevreuse"
				}
			]
		}
	]
}