			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shogun Raiden",
					"Yae Miko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120320101,
					"content": "Inazuma va être confrontée à de nombreuses épreuves, mais j'y suis déjà préparée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320102,
						120320107,
						120320112,
						120320117,
						120320122,
						120320128
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320102,
					"content": "À propos de ces « épreuves »...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320103
					]
				},
				{
					"id": 120320103,
					"content": "Abroger le décret de confinement aurait de nombreuses implications. Il serait incorrect de dire que cela présenterait uniquement des avantages sans qu'il n'y ait de conséquences.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320104
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320104,
					"content": "Par exemple, il m'est facile de prévoir que le monde extérieur pourrait représenter une menace pour le commerce à Inazuma. Ce sont des problèmes que je devrai traiter moi-même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320105
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320105,
					"content": "Je vois que tu prends tout cela très au sérieux, Ei. Ma seule préoccupation est de savoir s'il serait possible de rendre l'accès payant au Sanctuaire de Narukami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320106
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320106,
					"content": "Miko...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320107,
					"content": "À propos du regard des dieux...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320108
					]
				},
				{
					"id": 120320108,
					"content": "Le regard de Makoto s'est toujours posé sur le peuple d'Inazuma. Je croyais qu'elle faisait cela par devoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320109
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320109,
					"content": "Mais maintenant, je comprends que c'était un regard empli d'allégresse et d'espoir. Ce n'était pas un simple devoir, mais aussi une joie pour elle. Son amour pour l'humanité était profond.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320110
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320110,
					"content": "Les gens du passé étaient dignes du regard des dieux, et il en va de même pour les gens du présent ainsi que ceux du futur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320111
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320111,
					"content": "Je n'ignorerai plus jamais leur ferveur et leurs rêves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320112,
					"content": "À propos des siècles d'affrontement...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320113
					]
				},
				{
					"id": 120320113,
					"content": "Pour être franche, c'était une torture interminable. Nous n'en voyions pas le bout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320114
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320114,
					"content": "Je devais rester concentrée à tout moment au milieu d'une bataille sans fin. Un seul moment de relâchement, et l'épée de la Shogun aurait eu raison de moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320115
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320115,
					"content": "Il est indéniable que je n'aurais pas été à la hauteur sans expérience au combat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320116
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320116,
					"content": "Tu as aussi ta part de mérite là-dedans.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320117,
					"content": "À propos des dégâts sur le cerisier sacré...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320118
					]
				},
				{
					"id": 120320118,
					"content": "Ne t'inquiète pas, je n'ai pas oublié. Je m'assurerai de rappeler aux Commissions administrative et culturelle de s'occuper de cela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320119
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320119,
					"content": "Ce ne sont pas seulement les monstres qui m'inquiètent, mais aussi tout ce qui pourrait s'échapper du cerisier sacré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320120
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320120,
					"content": "C'est difficile à dire. Les lignes énergétiques contiennent bien plus que de simples souvenirs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320121
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320121,
					"content": "Étant donné que tu as compris la gravité de la situation, j'espère que tu ne ménageras pas tes efforts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320122,
					"content": "Yae Miko a dit qu'elle avait placé sa divinité...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320123
					]
				},
				{
					"id": 120320123,
					"content": "Ahem ! Je n'ai rien dit de la sorte, et tu ferais mieux d'arrêter d'inventer des rumeurs absurdes en ma présence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320124
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320124,
					"content": "Il y a certaines choses qu'il vaut mieux ne pas répéter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320125
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320125,
					"content": "Crois-moi, tu n'as pas envie de savoir ce qu'il en coûte de me trahir. Considère ce que je t'ai dit comme un secret entre nous deux, d'accord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320126
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320126,
					"content": "De quoi êtes-vous en train de parler ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320127
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320127,
					"content": "De rien. J'ai envie de manger du tofu frit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320128,
					"content": "Je n'ai pas d'autres questions.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		}
	]
}