	"talks": [
		{
			"id": 1203201,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1203201",
							"2"
						],
						"stepId": 1203201,
						"stateName": "QUEST_STATE_UNFINISHED"
