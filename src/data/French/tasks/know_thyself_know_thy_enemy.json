					"nextDialogs": [
						120010815
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010815,
					"content": "Un truc me chiffonne... Pourquoi une organisation aussi importante accepterait de nous aider ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010816,
					"content": "La Guilde des marchands de Feiyun ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010817
					]
				},
				{
					"id": 120010817,
					"content": "J'en ai entendu parler à mon arrivée à Liyue. Il me semble qu'un grand nombre de commerçants en fait partie.",
