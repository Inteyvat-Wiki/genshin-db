					"nextDialogs": [
						120010820
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010820,
					"content": "N'ayez crainte : une fois qu'ils auront lu ma missive savamment rédigée, nul doute qu'ils passeront à l'action.",
