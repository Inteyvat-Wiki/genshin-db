					"nextDialogs": [
						120010821,
						120010822
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010821,
					"content": "Vous pensez vraiment que ça va fonctionner ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010823
					]
				},
				{
					"id": 120010823,
					"content": "Nous ne sommes pas assez nombreux pour donner la leçon que mérite le notable Maocai. Il nous faut des renforts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010824
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010824,
					"content": "Qui plus est, je préférerais éviter que l'on sache que je suis impliqué.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010825
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010825,
					"content": "Pourquoi donc ? Vous ne faites ça que pour aider Chang le Neuvième, pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010826
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010826,
					"content": "« L'anonymat est la seule récompense du juste. » Telle est la voie de la chevalerie ; le souvenir de la justice rendue est mon unique rétribution.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010827
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010827,
					"content": "Pour chaque goutte de bonté dont on me fait montre, je me dois de répondre par un puits de gratitude. Je ne cherche ni la gloire, ni la richesse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010828
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010828,
					"content": "Pff, tout ça pour dire que vous voulez juste continuer à lire des livres tranquillement dans votre coin.",
