					"nextDialogs": [
						120010806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010806,
					"content": "Maintenant, je sais à quoi m'en tenir. J'ai une lettre que vous allez remettre au domestique de la Guilde des marchands de Feiyun.",
