				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120010201,
					"content": "Et comment on va faire pour le savoir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010202,
						120010203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010202,
					"content": "Il va falloir trouver une preuve incriminante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010204
					]
				},
				{
					"id": 120010204,
					"content": "Donc tu suggères qu'on aille le voir ? Avec un peu de chance, on le prendra sur le fait. Sinon, on peut essayer de le menacer ! Peut-être qu'il nous avouera tout ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010205,
					"content": "Essayons de parler au garde d'abord.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010206
					]
				},
				{
					"id": 120010206,
					"content": "OK ! Je te suis !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010203,
					"content": "Et si on le prenait la main dans le sac ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010204
					]
				}
			]
		},
		{
			"id": 1200103,
			"completionStepIds": [
				1200103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
