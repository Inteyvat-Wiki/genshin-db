					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Grand Wu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120010301,
					"content": "Qui va là ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010302,
						120010304
					],
					"speakerTitle": "Grand Wu"
				},
				{
					"id": 120010302,
					"content": "#Je suis {M#un commerçant}{F#une commerçante} de Mondstadt, j'ai rendez-vous avec le notable Maocai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010303
					]
				},
				{
					"id": 120010303,
					"content": "Ah bon ? Il n'en a pas parlé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010306
					],
					"speakerTitle": "Grand Wu"
				},
				{
					"id": 120010306,
					"content": "Notre maître a une urgence aujourd'hui, alors tous ses rendez-vous ont été annulés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010307
					],
					"speakerTitle": "Grand Wu"
				},
				{
					"id": 120010307,
					"content": "Une urgence ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010308,
					"content": "Le patron cherche à conclure une grosse affaire ces derniers temps. Ce matin, il est parti à la rencontre du client en question.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010309
					],
					"speakerTitle": "Grand Wu"
				},
				{
					"id": 120010309,
					"content": "Et où est-il maintenant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010310,
					"content": "Pardon, je n'ai pas le droit de vous le dire. C'est un de ses ordres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010311
					],
					"speakerTitle": "Grand Wu"
				},
				{
					"id": 120010311,
					"content": "#Pardon ? Mais je vous rappelle que je ne suis pas {M#un banal visiteur}{F#une banale visiteuse} !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010312
					]
				},
				{
					"id": 120010312,
					"content": "J—J'entends bien ! Ne le prenez pas mal, je n'insinue pas le contraire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010313,
						120010314
					],
					"speakerTitle": "Grand Wu"
				},
				{
					"id": 120010313,
					"content": "Amenez-moi au notable Maocai ou je vous le ferai regretter.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010315
					]
				},
				{
					"id": 120010315,
					"content": "Pardon ! Je suis désolé ! Il est en train de négocier au Kiosque Xinyue !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010316
					],
					"speakerTitle": "Grand Wu"
				},
				{
					"id": 120010316,
					"content": "Par pitié, ne lui dites pas que c'est moi qui vous l'ai dit !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010317
					],
					"speakerTitle": "Grand Wu"
				},
				{
					"id": 120010317,
					"content": "#{M#MON maître}{F#MA maîtresse} a d'autres chats à fouetter que de continuer à parler à des gardes comme vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010318,
					"content": "#Vous avez de la chance que votre insolence soit bien le cadet des soucis de {NICKNAME} lorsqu'{M#il}{F#elle} parlera affaires avec votre patron !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010319,
					"content": "M—Merci ! Merci ! Que l'Archon Géo bénisse vos affaires !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010320
					],
					"speakerTitle": "Grand Wu"
				},
				{
					"id": 120010320,
					"content": "#Tu m'as bien caché tes talents d'{M#acteur}{F#actrice}, {NICKNAME} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010321,
						120010323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010321,
					"content": "J'ai juste improvisé sur le coup...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010322
					]
				},
				{
					"id": 120010322,
					"content": "Vraiment ? En tout cas, Paimon sait maintenant de quoi tu es capable !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010325,
					"content": "Bon, je pense que les Fatui sont les clients dont le garde nous parlait tout à l'heure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010326,
						120010327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010326,
					"content": "Je le crois aussi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010328
					]
				},
				{
					"id": 120010328,
					"content": "En avant vers le Kiosque Xinyue !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010327,
					"content": "Rien ne sert de courir ; il faut partir à point...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010328
					]
				},
				{
					"id": 120010323,
					"content": "Tu t'es aussi bien débrouillée, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010324
					]
				},
				{
					"id": 120010324,
					"content": "Héhé, j'accepte aussi les compliments sous forme de nourriture !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010314,
					"content": "Souhaitez-vous expliquer ces frais supplémentaires à votre patron, ou devrais-je le faire ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010315
					]
				},
				{
					"id": 120010304,
					"content": "#Je m'appelle {NICKNAME} et je suis {M#un client privilégié}{F#une cliente privilégiée} de votre employeur !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010305
					]
				},
				{
					"id": 120010305,
					"content": "C'est bizarre, vous n'êtes pas sur la liste...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010306
					],
					"speakerTitle": "Grand Wu"
				}
			]
		},
		{
			"id": 1200107,
			"completionStepIds": [
				1200107
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200107",
							"2"
						],
						"stepId": 1200107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Notable Maocai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120010701,
					"content": "Je comprends. Ne vous inquiétez pas, notre transaction se passera comme prévu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010702
					],
					"speakerTitle": "Notable Maocai"
				},
				{
					"id": 120010702,
					"content": "La personne que j'ai envoyée n'en est pas si sûre... Quelqu'un vous résiste ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010703
					],
					"speakerTitle": "Usurier"
				},
				{
					"id": 120010703,
					"content": "Oh. On a juste eu un petit problème de matière première, alors on n'a pas encore pu se procurer de cœur de lapis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010704
					],
					"speakerTitle": "Notable Maocai"
				},
				{
					"id": 120010704,
					"content": "Nul besoin de vous inquiéter. Si Chang le Neuvième refuse de me le vendre, je peux me le procurer ailleurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010705
					],
					"speakerTitle": "Notable Maocai"
				},
				{
					"id": 120010705,
					"content": "Parfait. Nous vous rappelons que seul le résultat compte pour nous, les Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010706
					],
					"speakerTitle": "Usurier"
				},
				{
					"id": 120010706,
					"content": "Nous acceptons de vous aider jusqu'à un certain degré dans cette transaction, mais si elle s'avère infructueuse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010707
					],
					"speakerTitle": "Usurier"
				},
				{
					"id": 120010707,
					"content": "Vous vous rendrez vite compte que vous ne serez plus en mesure de vous payer nos faveurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010708
					],
					"speakerTitle": "Usurier"
				},
				{
					"id": 120010708,
					"content": "J'entends bien. Je vous dois ma protection, et je ne compte pas vous décevoir.",
