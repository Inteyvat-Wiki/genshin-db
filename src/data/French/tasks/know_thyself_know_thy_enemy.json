					"nextDialogs": [
						120010818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010818,
					"content": "Ça serait génial qu'elle nous aide, mais le fera-t-elle ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010819
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010819,
					"content": "Ne vous inquiétez pas, j'en suis certain. Je pense qu'ils ne supportent pas l'injustice, tout comme moi.",
