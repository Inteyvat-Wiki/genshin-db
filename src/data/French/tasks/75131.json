			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 751310401,
					"content": "Hmm, du feu qui bouge comme s'il était vivant, des apparitions rémanentes inquiétantes et un Daguerréotype capable de prendre des photos automatiquement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751310402,
					"content": "Je crois qu'un mystère se cache derrière tout ça ! Si ça se trouve, c'est un trésor !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751310403,
					"content": "Tu as remarqué quelque chose, Paimon ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751310404
					]
				},
				{
					"id": 751310404,
					"content": "Honnêtement... Rien du tout ! Mais le propriétaire du Daguerréotype a dû le mettre ici pour capturer ce qui se passe lorsqu'il y a des secousses...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751310405,
					"content": "Il ne nous reste plus qu'à remettre le Daguerréotype à sa place et à attendre que la terre se mette à trembler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751310406,
					"content": "Et quand le moment sera venu... Les indices sur l'emplacement du trésor vont se montrer, tout comme cette apparition rémanente !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
