				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Matzahtli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751310101,
					"content": "De la pluie biologique brûlante... Attendez, comme dans les légendes ? Des volcans qui évoluent et se répandent comme des créatures vivantes, transformant tout ce qui les entoure en d'autres volcans ? Oh non ! Ce serait un désastre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310102,
						751310103
					],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310102,
					"content": "Ce n'est pas comme ça que les volcans marchent...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751310104
					]
				},
				{
					"id": 751310104,
					"content": "Vous avez raison. Pas de magma, pas de volcan. Ils ne peuvent pas apparaître de nulle part. Si c'était le cas, cet endroit serait devenu une zone dangereuse depuis longtemps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310105
					],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310105,
					"content": "Mais... Et si la légende était vraie ? Rah, si seulement ce Daguerréotype auto-enregistreur fonctionnait correctement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310106
					],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310106,
					"content": "Attendez ! Que faire si le Daguerréotype ne fonctionne pas correctement et qu'on n'obtient aucune image ? Ce serait un vrai gâchis ! Non, je dois vérifier, juste pour être sûr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310103,
					"content": "#{M#Désolé}{F#Désolée} de vous interrompre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751310107
					]
				},
				{
					"id": 751310107,
					"content": "Au revoir... Ah, se passerait-il quelque chose d'autre ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matzahtli"
				}
			]
		},
		{
			"id": 7513102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7513105",
							"3"
						],
						"stepId": 7513105,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Matzahtli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751310201,
					"content": "La pluie biologique brûlante est en fait des oiseaux flufeux qui tombent du ciel ? Pas étonnant, ils couvrent beaucoup plus de terrain qu'une éruption normale !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310202
					],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310202,
					"content": "Oh, et si l'un d'entre eux s'écrasait sur ma maison un jour ? Il faut que je trouve une solution pour éviter ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310203,
						751310206
					],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310203,
					"content": "C'est peu probable que ça arrive.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751310204
					]
				},
				{
					"id": 751310204,
					"content": "C'est vrai. Les oiseaux flufeux ne s'envolent qu'à cause des éruptions volcaniques. Ma maison n'est pas proche d'un volcan, alors je n'ai probablement rien à craindre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310205
					],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310205,
					"content": "#Mais bon... Et s'il y avait un jour une grande éruption hors de contrôle{NON_BREAK_SPACE}? Personne ne serait à l'abri, non ? Je dois réfléchir à un plan... Juste au cas où.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310206,
					"content": "#{M#Désolé}{F#Désolée} de vous interrompre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751310207
					]
				},
				{
					"id": 751310207,
					"content": "Ne vous inquiétez pas, vous ne m'interrompez pas... Bref, commençons par renforcer le toit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matzahtli"
				}
			]
		},
		{
			"id": 7513103,
			"completionStepIds": [
				7513106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
