				"points": []
			},
			"dialogs": [
				{
					"id": 701020102,
					"content": "Que savez-vous de cette dent ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020103
					]
				},
				{
					"id": 701020103,
					"content": "Une dent ? Faites-moi voir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020104
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701020104,
					"content": "Hmm... Cette forme, cette taille... C'est vraiment inhabituel...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020105
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701020105,
					"content": "Je ne sais pas grand-chose sur ce genre de choses... Par contre, Orban a l'habitude de travailler avec toutes sortes de matériaux pour forger ses armes. Peut-être qu'il en saura plus !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020106
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701020106,
					"content": "Vous pouvez lui demander. Il est juste à côté, vous ne pouvez pas le rater !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iris"
				}
			]
		},
		{
			"id": 7010202,
			"completionStepIds": [
				7010207
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7010207",
