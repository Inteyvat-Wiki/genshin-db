						701020302
					]
				},
				{
					"id": 701020302,
					"content": "Vous revoilà ! En fait, ces crocs... Oh, vous les avez déjà trouvés !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020303
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020303,
					"content": "Je suis confus... J'ai rencontré un petit souci. Peu importe comment je m'y prends, je n'arrive pas à faire la moindre égratignure sur cette dent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020304
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020304,
					"content": "Est-ce vraiment un croc de dragon... Selon ce que j'ai lu, pour forger une arme en crocs de dragon, il faut utiliser des méthodes très spéciales...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020305
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020305,
					"content": "L'une d'entre elles consiste à... imbuer le croc de dragon d'une espèce de « force vitale » en rapport avec les dragons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020306
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020306,
					"content": "Ensuite, il faut utiliser ce croc gorgé de force vitale pour façonner les autres crocs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020307
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020307,
					"content": "Par contre, pour ce qui est de le « nourrir d'une force vitale »... Pas la moindre idée de ce que ça désigne...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020308
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020308,
					"content": "#{M#Voyageur}{F#Voyageuse}, vous avez une idée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020309
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020309,
					"content": "Je... Euh, je vais trouver quelque chose...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020310
					]
				},
				{
					"id": 701020310,
					"content": "Parfait ! Je vous rends cette dent, et je vous laisse faire alors !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020311
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020311,
					"content": "Si ce truc est vraiment un croc de dragon, alors les dragons sont vraiment des créatures compliquées et dangereuses...",
