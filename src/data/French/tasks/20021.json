			"dialogs": [
				{
					"id": 200210101,
					"content": "Pourquoi faut-il avoir un permis de planer juste pour utiliser un planeur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210102
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200210102,
					"content": "#Anthony, tu as déjà passé l'examen du permis de planer{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210103
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200210103,
					"content": "Je n'utilise jamais de planeur donc non, je n'ai jamais passé le permis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210104
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200210104,
					"content": "Tu veux passer ton permis de planer ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200210105
					]
				},
				{
					"id": 200210105,
					"content": "Oui. Le planeur est un objet indispensable pour tout aventurier qui se respecte, alors je veux m'entraîner à l'utiliser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210106
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200210106,
					"content": "Mais je n'imaginais pas qu'il fallait un permis juste pour ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210107
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200210107,
					"content": "Je me suis déjà inscrite à l'examen, mais... J'ai encore certaines choses à mémoriser...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210108
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200210108,
					"content": "#{M#Voyageur}{F#Voyageuse}, j'ai entendu Amber dire que vous avez déjà réussi votre permis de planer. Est-ce que vous pourriez m'aider à réviser pour l'examen ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210109,
						200210113
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200210109,
					"content": "#C'est Amber qui sera ton examinatrice{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200210110
					]
				},
				{
					"id": 200210110,
					"content": "Non, c'est juste que je l'ai croisée lorsque je me suis inscrite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210111
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200210111,
					"content": "#Elle vous a {M#mentionné}{F#mentionnée} quand elle m'expliquait les détails de l'examen. Elle m'a dit que vous aviez réussi haut la main.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210112
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200210112,
					"content": "Je me demandais si je pouvais vous poser quelques questions sur le permis de planer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210115
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200210115,
					"content": "Alors... J'ai trois questions à vous poser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210116
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200210116,
					"content": "Hmm, première question : combien de personnes peuvent utiliser un planeur en même temps pour voler ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200210113,
					"content": "Bien sûr.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200210114
					]
				},
				{
					"id": 200210114,
					"content": "#Super ! Merci beaucoup, {M#voyageur}{F#voyageuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210115
					],
					"speakerTitle": "Anna"
				}
			]
		},
