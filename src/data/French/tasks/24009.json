				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240090801,
					"content": "Avez-vous déjà pris la photo ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090802
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090802,
					"content": "Oui, voilà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090803
					]
				},
				{
					"id": 240090803,
					"content": "Voyons voir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090804
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090804,
					"content": "#Ah ! C'est parfait ! Je ne m'attendais pas à ce que vous soyez aussi {M#doué}{F#douée}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090805
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090805,
					"content": "Je devrais vraiment pouvoir exploiter cette photo !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090806
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090806,
					"content": "Merci beaucoup. Hmm... Où ai-je laissé ces moras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090807
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090807,
					"content": "Très bien, voici pour vous ! Si l'occasion se présente à l'avenir, revenez m'aider à prendre quelques photos supplémentaires !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090808
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090808,
					"content": "Hmm... Comment exploiter au maximum cette photo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				}
			]
		},
		{
			"id": 2400909,
			"completionStepIds": [
				2400901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
