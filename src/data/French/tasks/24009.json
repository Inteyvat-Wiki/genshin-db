			"dialogs": [
				{
					"id": 240091001,
					"content": "Merci pour votre aide ! Cela devrait suffire à me remplir l'estomac...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091002
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091002,
					"content": "Voici votre récompense, vous l'avez bien méritée. C'est le moment de reprendre des forces...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091003
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091003,
					"content": "La prochaine fois, je ferai peut-être mieux d'apporter des biscuits que je peux ranger dans mon sac...",
