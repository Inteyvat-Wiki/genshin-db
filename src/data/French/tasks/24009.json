			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240090201,
					"content": "Voyons... Ces amis m'ont donné quelques suggestions que j'ai écrites dans mon carnet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090202
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090202,
					"content": "Plantes aquatiques... Ondulant... Ombre et lumière... Changer... Qu'est-ce que j'écrivais ? Avais-je trop bu ? ... Ouais, ça doit être ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090203
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090203,
					"content": "Ahem. Prenez une photo de plantes aquatiques.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090204
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090204,
					"content": "Il semble que j'étais très intéressé par les lumières et les ombres sur les plantes aquatiques lorsque j'ai pris ces notes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				}
			]
		},
		{
			"id": 2400904,
