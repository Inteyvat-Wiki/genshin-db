					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240091101,
					"content": "Ça manque de tension... Que se passe-t-il ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091102
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091102,
					"content": "J'ai l'impression qu'il me manque quelque chose... de décisif...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091103,
						240091105
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091103,
					"content": "Vous prenez des photos ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091104
					]
				},
				{
					"id": 240091104,
					"content": "C'est ça. Ce Daguerréotype est ma source d'inspiration pour peindre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091107
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091107,
					"content": "Je m'appelle Depierris et je suis peintre. Ravi de vous rencontrer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091108
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091108,
					"content": "Oh, euh... Également...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091109
					]
				},
				{
					"id": 240091109,
					"content": "D'ordinaire, je vous aurais offert un café, mais hélas, il n'y en a pas à proximité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091110
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091110,
					"content": "#Hmm. Eh bien, pourquoi ne prendriez-vous pas ce fonta ? Portons un toast, et nous aurons officiellement fait connaissance ! ... Êtes-vous déjà {M#allé}{F#allée} à Fontaine ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091111
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091111,
					"content": "Non, c'est la première fois.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091112
					]
				},
				{
					"id": 240091112,
					"content": "Ah, alors vous allez passer un bon moment ! Baladez-vous dans la ville et admirez ce qui vous entoure, comme les aqueroutes qui s'étendent au-dessus de votre tête !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091113
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091113,
					"content": "Ensuite, vous pouvez sortir dans les rues et voir les machines complexes, même si elles n'ont pas toutes une valeur esthétique. Enfin, ce n'est que l'avis d'un humble peintre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091114
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091114,
					"content": "Pour finir, je vous recommande de vous asseoir dans un café pour en déguster un.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091115
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091115,
					"content": "#Qui sait, peut-être que quelqu'un viendra vous parler{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091116
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091116,
					"content": "Cependant, si la personne qui vous approche annonce faire partie du Daguerréoclub...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091117
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091117,
					"content": "Alors, méfiez-vous de leurs bêtises... Enfin, certains d'entre eux en ont fait récemment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091118,
						240091120
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091118,
					"content": "Qu'ont-ils fait ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091119
					]
				},
				{
					"id": 240091119,
					"content": "Quoi, demandez-vous ? Juste mettre la vie culturelle de notre grande Fontaine sur le chemin de l'anéantissement !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091122
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091122,
					"content": "Maintenant, ce n'est pas une simple campagne de peur. Savez-vous de quoi ils parlent dans ce club ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091123
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091123,
					"content": "« Si on ne parle que d'images, alors les photos prises par les Daguerréotypes sont nettement supérieures aux peintures. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091124
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091124,
					"content": "Je veux dire, écoutez ce non-sens : si nous ne parlons que d'images... C'est n'importe quoi, peu importe à quel point ils proclament que c'est la vérité !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091125
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091125,
					"content": "Si nous présentions simplement les images telles qu'elles sont, que fait-on de l'esthétique ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091126
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091126,
					"content": "Eh bien, il est vrai que certains d'entre nous sont en train de trouver comment dessiner des œuvres naturalistes toujours meilleures... Mais même cela trouve sa source dans leur sens de l'esthétique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091127
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091127,
					"content": "L'esthétique ! La clé, c'est l'esthétique, vous comprenez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091128,
						240091129
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091128,
					"content": "Pas vraiment...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091130
					]
				},
				{
					"id": 240091130,
					"content": "L'observation du monde à travers les yeux de l'artiste n'est qu'un premier pas. Nous devons explorer la sensibilité et la beauté à travers le pinceau pour offrir un chef-d'œuvre venant du cœur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091131
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091131,
					"content": "Je ne veux pas dire que tous ceux qui aiment les Daguerréotypes sont des imbéciles rustres dépourvus de tout sens artistique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091132
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091132,
					"content": "J'ai beaucoup d'amis qui aiment les Daguerréotypes, et j'adore leur parler. Parfois, leurs photos m'inspirent, et mes peintures les inspirent à leur tour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091133
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091133,
					"content": "#Mais ces gens qui ne connaissent rien à l'art et ne savent que dire des bêtises... Oh, ce qu'ils m'énervent{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091134
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091134,
					"content": "Ils déshonorent ceux qui aiment la photographie et la peinture ! Ils sont vraiment... *tousse* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091135
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091135,
					"content": "Calmez-vous, buvez un peu d'eau.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091136
					]
				},
				{
					"id": 240091136,
					"content": "Ah, merci... Je ne peux pas m'empêcher de m'énerver chaque fois que je parle de ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091137
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091137,
					"content": "C'est pourquoi, avec des amis, nous avons décidé d'utiliser ce Daguerréotype pour prendre une série de photos et les utiliser comme référence pour créer une série de peintures.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091138
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091138,
					"content": "Ensuite, nous exposerons ces peintures à côté des images utilisées pour les créer. Comme ça, tout le monde pourra voir la différence entre la peinture et la photographie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091139
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091139,
					"content": "Malheureusement... *soupir* Je ne suis pas satisfait des différentes photos que j'ai prises. Mes amis me disent que les meilleurs sites se trouvent dans les terres les plus dangereuses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091140
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091140,
					"content": "Sous l'eau, par exemple, ou sur les falaises, ou peut-être dans les bois profonds où peu d'humains vont... Mais je n'ose pas aller seul dans de tels endroits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091141
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091141,
					"content": "Et engager des aventuriers pourrait prendre trop de temps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091142
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091142,
					"content": "Hmm... Que diriez-vous de travailler pour un artiste ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091143,
						240091144
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091143,
					"content": "Tant que je ne dois pas peindre...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091145
					]
				},
				{
					"id": 240091145,
					"content": "C'est parfait ! Nous ne ferons que ce pour quoi nous sommes bons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091146
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091146,
					"content": "Vous n'avez pas non plus à vous soucier du paiement. J'engage souvent des aventuriers comme gardes lors de mes voyages d'inspiration, donc je connais les règles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091147
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091147,
					"content": "C'est juste que cette affaire était trop urgente, et je n'ai pu embaucher personne à temps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091148
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091148,
					"content": "Eh bien, c'est réglé, alors. Avec votre aide, je deviens de plus en plus confiant dans mes chances de produire du bon travail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091144,
					"content": "#Je ne suis vraiment {M#doué}{F#douée} que pour les trucs d'aventurier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091145
					]
				},
				{
					"id": 240091129,
					"content": "Je pense ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091130
					]
				},
				{
					"id": 240091120,
					"content": "Je dois m'inquiéter ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091121
					]
				},
				{
					"id": 240091121,
					"content": "Tout comme ils l'ont fait pour Fontaine, ils détruiront la vie culturelle à laquelle vous auriez dû participer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091122
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091105,
					"content": "Êtes-vous un amateur de Daguerréotype ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091106
					]
				},
				{
					"id": 240091106,
					"content": "Hmm ? Non, non, ce n'est qu'un outil de référence, je suis de loin plus friand de mon pinceau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091107
					],
					"speakerTitle": "Depierris"
				}
			]
		},
