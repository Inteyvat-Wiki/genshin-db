			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240090101,
					"content": "#{M#Voyageur}{F#Voyageuse}, vous arrivez au bon moment ! Je viens de trouver un merveilleux endroit pour prendre des photos. Tout ce dont j'ai besoin, c'est d'un petit coup de main !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090102
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090102,
					"content": "Toujours à la recherche d'inspiration, n'est-ce pas ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090103
					]
				},
				{
					"id": 240090103,
					"content": "Bien sûr. C'est loin d'être suffisant. Une seule photo ne me permettra pas de créer un tableau entier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090104
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090104,
					"content": "J'ai généralement besoin de plusieurs dizaines d'images, parfois même une centaine, comme matériel de référence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090105,
						240090106
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090105,
					"content": "Tant que ça...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090107
					]
				},
				{
					"id": 240090107,
					"content": "Comme je vous l'ai déjà dit, l'objectif de la peinture est la « création ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090108
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090108,
					"content": "#Si vous imprimez simplement les choses que vous voyez sur la toile telles quelles, ce n'est pas de la «{NON_BREAK_SPACE}peinture », c'est de la « photographie ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090109
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090109,
					"content": "Ce qu'un peintre doit vraiment faire, c'est utiliser sa sensibilité et son sens esthétique pour observer le monde qui l'entoure, avant de s'en inspirer et de le représenter à sa façon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090110
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090110,
					"content": "Jusqu'à ce que le plus bel aspect de chaque objet puisse être extrait pour être représenté sur la toile et ainsi compléter votre peinture.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090111,
						240090112
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090111,
					"content": "#Je ne suis pas {M#sûr}{F#sûre} de comprendre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090113
					]
				},
				{
					"id": 240090113,
					"content": "Vous... OK. Fondamentalement, je n'utiliserai que les plus belles parties de ces images comme référence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090114
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090114,
					"content": "Par exemple, l'équilibre ombre-lumière est ici excellent, mais le paysage manque de contraste, je ne prendrai donc que le premier en référence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090115
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090115,
					"content": "L'autre photo contient un voyageur dans une pose des plus fascinantes, et la suivante présente un superbe bâtiment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090116
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090116,
					"content": "C'est presque comme jouer avec un puzzle dans votre esprit, la beauté du produit final dépendant uniquement de votre esthétique et de votre compréhension.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090117
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090117,
					"content": "Ce n'est pas une façon rigoureuse de dire les choses, puisque nous pouvons également changer ou abstraire les vues dans le matériel de référence lui-même... Mais c'est tout ce que vous devez comprendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090118,
						240090119
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090118,
					"content": "Vous avez donc toujours besoin de mon aide.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090120
					]
				},
				{
					"id": 240090120,
					"content": "Euh... D'accord, oui, c'est vrai ! Vos compétences de photographe sont incroyables. Mes amis ont voulu venir vous voir en personne après avoir vu votre travail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090121
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090121,
					"content": "Je suis sûr qu'avec votre aide, je pourrai créer quelque chose de vraiment extraordinaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090122
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090122,
					"content": "Alors, s'il vous plaît, dans l'intérêt de l'esthétique, et pour la récompense que je vous ai préparée, veuillez accepter de m'aider !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090119,
					"content": "Je vais donc devoir continuer à vous aider à trouver l'inspiration.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090120
					]
				},
				{
					"id": 240090112,
					"content": "Vous pourriez faire plus simple !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090113
					]
				},
				{
					"id": 240090106,
					"content": "Les images ont-elles des usages différents ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090107
					]
				}
			]
		},
		{
			"id": 2400902,
			"completionStepIds": [
				2400902
