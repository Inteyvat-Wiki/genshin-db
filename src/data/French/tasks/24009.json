			},
			"dialogs": [
				{
					"id": 240090401,
					"content": "Voyons... Ces amis m'ont donné quelques suggestions que j'ai écrites dans mon carnet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090402
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090402,
					"content": "« Les grandes ruines sous-marines ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090403
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090403,
					"content": "Sérieusement ? J'ai écrit ces mots avec une telle force que le papier a failli se déchirer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090404
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090404,
					"content": "Mais je suppose qu'un tel endroit pourrait avoir une beauté unique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090405
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090405,
					"content": "Eh bien, veuillez prendre une photo d'une telle ruine. Plus elle est grande, mieux c'est, et plus elle est horriblement détruite, également !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				}
			]
		},
		{
			"id": 2400906,
			"completionStepIds": [
				2400906
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2400906",
							"2"
						],
						"stepId": 2400906,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240090601,
					"content": "Voyons... Ces amis m'ont donné quelques suggestions que j'ai écrites dans mon carnet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090602
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090602,
					"content": "Qu'est-ce que j'ai écrit ici ? Laissez-moi voir... Euh, sous l'eau... Des rochers escarpés... Des plantes sur des rochers... Les contours des rochers...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090603
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090603,
					"content": "Euh, oui, c'est vrai. J'étudiais les roches de manière obsessionnelle pour leur capacité à exposer au mieux la beauté naturelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090604
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090604,
					"content": "Quoi qu'il en soit, j'aimerais que vous m'aidiez à prendre quelques photos de rochers sous-marins. Je me demande à quoi ressembleront leurs contours...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				}
			]
