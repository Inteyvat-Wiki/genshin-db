					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240090901,
					"content": "Non... Ça ne va pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090902,
						240090903
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090902,
					"content": "De quel genre de photos avez-vous besoin cette fois ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090904
					]
				},
				{
					"id": 240090904,
					"content": "Pas besoin de prendre des photos cette fois. J'ai une autre faveur à vous demander.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090905
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090905,
					"content": "Ahem. C'est assez embarrassant, mais, euh... Pourriez-vous m'aider à trouver quelque chose à manger ? Genre... une baguette à l'ail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090906,
						240090907
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090906,
					"content": "Vous... n'avez rien apporté à manger ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090908
					]
				},
				{
					"id": 240090908,
					"content": "Si ! J'ai apporté beaucoup de pain, ainsi que de la confiture et de la viande séchée. Cela aurait dû suffire pour la journée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090909
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090909,
					"content": "Mais j'ai tout mis de côté pour me concentrer sur la peinture, et j'ai vite été captivé... Quand j'ai commencé à avoir faim, la nourriture avait disparu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090910
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090910,
					"content": "Peut-être qu'un animal ou un passant affamé s'en est sorti sans se faire prendre. J'espère que ça aura apaisé sa faim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090911
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090911,
					"content": "Malheureusement, le mien devra être rempli d'une autre manière... Et je ne peux pas retourner en ville maintenant. Pas avant d'avoir rassemblé suffisamment de matériel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090912,
						240090913
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090912,
					"content": "Attendez juste un instant, alors.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090914
					]
				},
				{
					"id": 240090914,
					"content": "Je compte sur vous alors. Vous pouvez en trouver en ville.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090915
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090915,
					"content": "Haha... Oh, je me sens un peu faible. C'est peut-être la faim, ou peut-être que j'ai trop réfléchi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090913,
					"content": "Je vais vous chercher ça.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090914
					]
				},
				{
					"id": 240090907,
					"content": "Vous n'aviez... pas de quoi acheter à manger ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090908
					]
				},
				{
					"id": 240090903,
					"content": "Où allons-nous prendre des photos cette fois ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090904
					]
				}
			]
		},
