			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 227010401,
					"content": "Très bien, l'endroit me paraît tout indiqué.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010402
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010402,
					"content": "Qu'est-ce qu'il y a à la fin...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010403
					]
				},
				{
					"id": 227010403,
					"content": "*soupir* C'est au sujet de Que'er, ma condisciple. Nous avons toujours été inséparables pendant l'entraînement. Ses talents égalent les miens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010404
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010404,
					"content": "Nous sommes venus ici pour obtenir guidance auprès des Adeptes, mais le voyage a été ardu, et ma condisciple est un vrai moulin à paroles... Elle s'est enrhumée il y a quelques jours, et souffre maintenant de mal de gorge...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010405
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010405,
					"content": "Je devine que vous êtes quelqu'un aux nombreux talents, aussi vous demandé-je humblement de m'aider à trouver trois fleurs de Qingxin au sommet de ce pic, avec lesquelles je pourrai concocter une infusion qui saura adoucir ses maux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010406,
						227010408
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010406,
					"content": "Je vois, très bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010407
					]
				},
				{
					"id": 227010407,
					"content": "#Je m'en remets donc à vous, mon {M#ami}{F#amie}. Que'er est une enfant à l'énergie inépuisable, et je n'ose la laisser seule pendant que je pars à la recherche de quelque médicament.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010408,
					"content": "Pourquoi se cacher ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010409
					]
				},
				{
					"id": 227010409,
					"content": "Ah, je vois que cela a piqué votre intérêt. Que'er est d'un naturel combatif, et refuse tout idée de faiblesse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010410
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010410,
					"content": "Oserai-je mentionner devant elle qu'elle a besoin de médecine, nul doute qu'elle rejetterait la suggestion sans plus attendre. C'est pourquoi je n'ai d'autre choix que d'agir dans son dos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010411
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010411,
					"content": "Je n'ose aller moi-même chercher de quoi la soigner et la laisser seule, aussi me suis-je adressé à vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
			]
		},
		{
			"id": 2270105,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
