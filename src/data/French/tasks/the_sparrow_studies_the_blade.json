			"dialogs": [
				{
					"id": 227010101,
					"content": "#Arrêtez-vous un instant, l'{M#ami}{F#amie}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010102
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010102,
					"content": "#Je devine à votre allure que vous êtes comme nous, {M#pratiquant}{F#pratiquante} d'arts martiaux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
			]
		},
		{
			"id": 2270102,
			"completionStepIds": [
				2270101,
				2270106
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2270101",
							"2"
						],
						"stepId": 2270101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 227010201,
					"content": "Que me voulez-vous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010202
					]
				},
				{
					"id": 227010202,
					"content": "Hé ! Montrez-lui un peu plus de respect quand vous lui parlez, compris ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010203
					],
					"speakerTitle": "Que'er"
				},
				{
					"id": 227010203,
					"content": "Petite sœur, allons. C'est moi qui ai choisi de lui parler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010204
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010204,
					"content": "Hmph ! Tant que c'est pas un de ces idiots de chercheur d'Adepte qui essaye de passer devant nous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010205
					],
					"speakerTitle": "Que'er"
				},
				{
					"id": 227010205,
					"content": "#Ça va, ça va. Pourquoi ne pas te reposer un instant pendant que je dis quelques mots à notre {M#ami}{F#amie} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010206
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010206,
					"content": "Mais, qu'est-ce que tu as à lui dire que tu ne peux pas dire en face de moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010207
					],
					"speakerTitle": "Que'er"
				},
				{
					"id": 227010207,
					"content": "Ce n'est rien d'important... Tu trouverais sûrement ça ennuyeux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010208
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010208,
					"content": "Hum, compris, tu veux encore parler du Clan Guhua... Bon, si tu ne veux pas que j'écoute, alors je vous laisse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010209
					],
					"speakerTitle": "Que'er"
				},
				{
					"id": 227010209,
					"content": "#Mon {M#ami}{F#amie}, suivez-moi, je vous prie, que nous parlions un moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
			]
		},
