			},
			"dialogs": [
				{
					"id": 227010701,
					"content": "C'est pour ton mal de gorge.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010702
					]
				},
				{
					"id": 227010702,
					"content": "#{M#Mon ami}{F#Mon amie} ! Je...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010703
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010703,
					"content": "... Pfff, tu insinues que je suis faible, c'est ça ? Un peu de vent et je suis malade ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010704
					],
					"speakerTitle": "Que'er"
				},
				{
					"id": 227010704,
					"content": "Mais bon, au moins ces fleurs devraient aider pour le mal de tête de grand frère.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010705
					],
					"speakerTitle": "Que'er"
				},
				{
					"id": 227010705,
					"content": "Petite sœur, écoute-moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010706
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010706,
					"content": "Grand frère, trouve-toi un coin à l'abri du vent. Je te ferai du thé sucré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010707
					],
					"speakerTitle": "Que'er"
				},
				{
					"id": 227010707,
					"content": "Quant à toi... Tiens, et va-t'en maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Que'er"
				}
			]
		},
