					"Sun Yu",
					"Que'er"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 227010501,
					"content": "Vous voilà de retour. Avez-vous mené à bien la mission dont je vous avais parlé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010502
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010502,
					"content": "Et voilà, tenez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010503
					]
				},
				{
					"id": 227010503,
					"content": "#Voilà qui devrait suffire. Je vous remercie, {M#mon ami}{F#mon amie}. Veuillez accepter ceci en gage de remerciement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010504
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010504,
					"content": "Ah ? Qu'est-ce que c'est toutes ces fleurs de Qingxin ? Oh, tu as encore mal à la tête ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Que'er"
				}
			]
		},
		{
			"id": 2270106,
			"completionStepIds": [
				2270105
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2270105",
							"2"
						],
						"stepId": 2270105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu",
					"Que'er"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 227010601,
					"content": "C'est ça, c'est pour son mal de tête.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010602
					]
				},
				{
					"id": 227010602,
					"content": "Grand frère, pourquoi demander à quelqu'un d'autre ? J'aurais pu m'en charger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010603
					],
					"speakerTitle": "Que'er"
				},
				{
					"id": 227010603,
					"content": "Et puis on sait pas qui c'est en plus, et si jamais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010604
					],
					"speakerTitle": "Que'er"
				},
				{
					"id": 227010604,
					"content": "... Allons, petite sœur. Cette personne a été assez bonne pour nous venir en aide, point n'est nécessaire d'en parler de la sorte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010605
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010605,
					"content": "Merci encore. Tenez, veuillez accepter ce modeste présent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010606
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010606,
					"content": "Bon et ensuite ouste ! Si grand frère est malade, pas la peine de rester comme ça en plein dans le vent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010607
					],
					"speakerTitle": "Que'er"
				},
				{
					"id": 227010607,
					"content": "Allez, viens vite te mettre à l'abri du vent, grand frère ! Je te ferai du thé sucré...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Que'er"
				}
			]
		},
		{
			"id": 2270107,
			"completionStepIds": [
				2270105
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
