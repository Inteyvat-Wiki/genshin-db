			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aabid",
					"Adil"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190780801,
					"content": "Vous avez entendu ? Aux dernières nouvelles, Alkami a recruté Kaveh en tant que professeur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780802
					],
					"speakerTitle": "Aabid"
				},
				{
					"id": 190780802,
					"content": "Je parie que les affaires n'en seront que meilleures.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780803
					],
					"speakerTitle": "Adil"
				},
				{
					"id": 190780803,
					"content": "Il y a de quoi être jaloux. En toute honnêteté, Alkami n'a jamais été un bon architecte. Personne ne paierait pour des cours avec lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780804
					],
					"speakerTitle": "Aabid"
				},
				{
					"id": 190780804,
					"content": "En tout cas, il sait faire sa pub... L'Académie accepte seulement ceux qui ont réussi l'examen d'entrée, donc peu de gens peuvent espérer étudier l'architecture au sein du Kshahrewar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780805
					],
					"speakerTitle": "Adil"
				},
				{
					"id": 190780805,
					"content": "Le centre de formation est une aubaine pour les autres qui n'ont pas cette possibilité ou qui veulent rapidement se lancer dans le secteur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780806
					],
					"speakerTitle": "Adil"
				},
				{
					"id": 190780806,
					"content": "Il se débrouille vraiment bien en affaires...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aabid"
				}
			]
		},
