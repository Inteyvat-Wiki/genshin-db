			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Adan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190780401,
					"content": "Bonjour, je peux vous aider ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780402,
						190780403
					],
					"speakerTitle": "Adan"
				},
				{
					"id": 190780402,
					"content": "Connaissez-vous Alkami ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190780404
					]
				},
				{
					"id": 190780404,
					"content": "Alkami ? Ce gars fortuné qui est devenu célèbre récemment ? Oui, il m'a commandé des meubles sur mesure. Il a mis la main à la bourse, et pas qu'un peu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780405
					],
					"speakerTitle": "Adan"
				},
				{
					"id": 190780405,
					"content": "J'ai cru comprendre qu'il avait fait fortune en étant un architecte de renom autrefois. Il a ouvert un centre de formation pour partager son expérience avec d'autres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780406
					],
					"speakerTitle": "Adan"
				},
				{
					"id": 190780406,
					"content": "J'aurais inscrit mon enfant si les frais de scolarité n'étaient pas si exorbitants. L'architecture a l'air d'être une profession lucrative...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Adan"
				},
				{
					"id": 190780403,
					"content": "Avez-vous entendu parler d'un certain Alkami ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190780404
					]
				}
			]
		},
		{
			"id": 1907808,
			"completionStepIds": [
				1907808
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
