				"points": []
			},
			"dialogs": [
				{
					"id": 190785001,
					"content": "Monsieur Kaveh avait l'air très fâché.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190785002
					],
					"speakerTitle": "Uzayr"
				},
				{
					"id": 190785002,
					"content": "Et alors ? Je parie qu'il panique parce qu'on lui volera tous ses projets quand on aura terminé notre formation !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190785003
					],
					"speakerTitle": "Waiz"
				},
				{
					"id": 190785003,
					"content": "Je ne crois pas que ça arrivera... Monsieur Kaveh est très célèbre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190785004
					],
					"speakerTitle": "Tanisha"
				},
				{
					"id": 190785004,
					"content": "Qui sait ? Mon père m'a dit que les gens deviennent arrogants et bornés quand la célébrité leur monte à la tête. Monsieur Alkami est une perle rare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Waiz"
				}
			]
		},
