			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120220101,
					"content": "Hein ? Kokomi n'est pas encore arrivée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220102,
					"content": "C'est bizarre. Elle n'a pas l'air du genre à arriver en retard... Euh, attendons encore un peu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220103,
					"content": "Comment se fait-il qu'elle ne soit toujours pas là ? Tu penses qu'elle pourrait avoir des problèmes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220104,
					"content": "Allons demander à ce soldat là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220701,
					"content": "Vous cherchez Son Altesse ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220702
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220702,
					"content": "J'ai bien peur qu'elle ne soit pas là pour le moment. J'ignore où elle est partie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220703
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220703,
					"content": "C'est tellement étrange... Je suppose que c'est partie remise alors ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220704,
					"content": "Pas nécessairement. Si je me souviens bien, Son Altesse a pris des dispositions spéciales pour un tel scénario dans ses directives opérationnelles générales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220705
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220705,
					"content": "Laissez-moi voir... Ah oui, nº98... <color=#00E1FFFF>« Si un visiteur lointain vient me voir et qu'on ne sait pas où me trouver, ordonnez-lui de se diriger au sud jusqu'à ce qu'il arrive à un arbre au feuillage pourpre. »</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220706
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220706,
					"content": "La note de bas de page précise que cela ne s'applique que lorsque Son Altesse n'a fait aucune communication concernant ses allées et venues avant de disparaître, et même alors seulement lorsque le visiteur en question a un statut privilégié.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220707
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220707,
					"content": "En ce qui me concerne, vous correspondez à la description. Je garde cette directive sur moi en permanence. Je suis sûr que c'est la chose à faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220708
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220708,
					"content": "Kokomi pense vraiment à tout ! Très bien, allons trouver l'endroit dont elle parle pour y jeter un œil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1202202,
			"completionStepIds": [
				1202208
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1202208",
							"2"
						],
						"stepId": 1202208,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sangonomiya Kokomi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120220204,
					"content": "Kokomi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220205,
					"content": "Alors, c'est là que vous êtes ! On avait prévu de se retrouver pour préparer le festin de la victoire aujourd'hui. Qu'est-ce qui s'est passé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220206,
					"content": "Oh... C'est vous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220207
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220207,
					"content": "Je—Je suis désolée... Je ne me sens pas comme d'habitude aujourd'hui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220208
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220208,
					"content": "*halète* Vous êtes tombée malade ? On va chercher un docteur tout de suite !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220209,
					"content": "Non, non, ce n'est rien de tout ça... C'est juste que mon énergie est complètement épuisée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220210
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220210,
					"content": "V—Vous utilisez de l'énergie ? *halète* Vous voulez dire que... Vous êtes comme un Gardien des ruines !?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220211,
					"content": "Non, c'est juste une façon de parler. *soupir* J'ai honte de l'admettre, mais je ne peux pas toujours être la personne que je présente au monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220212,
						120220213
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220212,
					"content": "Tout le monde vous en demandait tellement hier...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220214
					]
				},
				{
					"id": 120220214,
					"content": "Ah... Vous avez remarqué ? Je suppose que je ne maîtrise toujours pas la capacité à cacher ce que je ressens. Il faut que j'y travaille...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220215
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220215,
					"content": "Pour être honnête, je n'ai pas vraiment les épaules pour diriger. Au départ, mon rêve c'était de me renseigner sur la stratégie militaire et de devenir peut-être conseillère.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220216
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220216,
					"content": "Communiquer constamment avec les gens, essayer de leur faire garder courage, devoir lire entre les lignes, s'assurer que chacun obtienne la reconnaissance qu'il mérite... C'est tellement difficile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220217
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220217,
					"content": "Vous êtes censé faire que les gens se sentent bien par votre seule présence, tout en leur imposant le respect... Ce n'est pas quelque chose de naturel pour moi. À vrai dire, c'est quelque chose que je n'ai jamais voulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220218
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220218,
					"content": "Mais du fait de mon héritage, j'étais destinée à devenir la Prêtresse divine tôt ou tard. Que je le veuille ou non, c'est ainsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220219
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220219,
					"content": "Alors à chaque fois que je me sens dépassée, je viens ici pour me perdre dans un livre et me détendre un moment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220220
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220220,
					"content": "Ne vous inquiétez pas, mon travail n'en est pas affecté. J'ai confié les préparatifs du festin de la victoire à quelqu'un d'autre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220221
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220221,
					"content": "Je dois faire un discours ce soir et je ne dois donner aux troupes aucune raison de penser que quoi que ce soit n'aille pas. Cette paix a été durement gagnée, et je veux qu'ils se sentent rassurés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220222
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220222,
					"content": "Y a-t-il quelque chose qu'on puisse faire pour vous aider ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220223,
					"content": "Je devrais me sentir bientôt à nouveau pleine d'énergie si je me repose un peu plus longtemps. *soupir* Si seulement je pouvais écouter une bonne lecture sur la stratégie militaire, je suis sûre que ça accélérerait le processus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220224
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220224,
					"content": "J'étais en train de lire un livre la dernière fois que je suis venue ici, mais je n'en ai parcouru que la moitié. Où est-ce que je l'ai mis déjà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220225
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220225,
					"content": "On va le trouver pour vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220226,
					"content": "Et ensuite on vous le lira, pour vous aider à récupérer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220227,
					"content": "Vous feriez ça pour moi ? Merci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220228
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220228,
					"content": "#Héhé... J'ai vraiment de la chance que vous soyez {M#revenus}{F#revenues} sur l'Île de Watatsumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220213,
					"content": "Je pouvais sentir que c'était difficile pour vous...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220214
					]
				}
			]
		},
