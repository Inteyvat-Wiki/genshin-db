			"dialogs": [
				{
					"id": 120220301,
					"content": "#{NICKNAME}, est-ce que c'est le livre militaire que Kokomi recherche ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220302,
					"content": "#« {M#Le}{F#La} capitaine de l'Espadon II est {M#revenu}{F#revenue} aujourd'hui. Énergie +4... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220303,
					"content": "Ah, c'est... c'est juste, euh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220304,
						120220305
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220304,
					"content": "On n'a rien vu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220306
					]
