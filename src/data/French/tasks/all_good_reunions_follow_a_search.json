						752470403
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470403,
					"content": "Calme-toi un peu, poto. Je sais que tu es excité, mais on doit d'abord comprendre ce qui se passe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470404
