					"nextDialogs": [
						752470457
					],
					"speakerTitle": "Challwa"
				},
				{
					"id": 752470457,
					"content": "Sérieusement, poto ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470458
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470458,
					"content": "Mais oui ! Sérieusement, poto ?! Qui aurait cru que Cacucu était aussi chanceux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470459
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470459,
					"content": "Haha ! Bravo, poto !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470460
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470460,
					"content": "Cacucu, mon po... Non. Monsieur Cacucu, j'ai une humble requête à t'adresser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470461
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470461,
					"content": "On dit que la chance se transmet en se serrant la main. Ça te dérange si je...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470462
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470462,
					"content": "Haha ! Pas de problème, poto !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470463,
						752470466
					],
					"speakerTitle": "Cacucu"
				},
				{
