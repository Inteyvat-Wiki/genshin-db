			"dialogs": [
				{
					"id": 752475101,
					"content": "Re-coucou, poto !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475102
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752475102,
					"content": "Tout à l'heure, j'ai essayé de dire à Ifa qu'il s'était trompé de date.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475103
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752475103,
					"content": "Mais je me suis arrêté. Être mur, c'est savoir passer outre certaines choses parfois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cacucu"
				}
			]
		}
