			"dialogs": [
				{
					"id": 752470101,
					"content": "C'est sans doute l'endroit de la photo. Regarde, Ororon et Ifa sont déjà là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470102,
					"content": "Coucou !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470103,
					"content": "Ah, on dirait une Paimon heureuse. Génial ! Pas besoin d'être sur ses gardes alors.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470104
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470104,
					"content": "Une Paimon en colère est tout aussi inoffensive.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470105
					]
				},
				{
					"id": 752470105,
					"content": "Hmph ! Attention à ce que tu dis, toi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470106,
					"content": "Il suffit de lui donner une friandise.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470107
					]
				},
				{
					"id": 752470107,
					"content": "Hé ! Ne me prends pas pour Cacucu ! Tu ne peux pas t'en sortir avec moi, juste en me donnant un biscuit ! Hum... Bon, ça pourrait peut-être aider...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470108,
					"content": "Tant pis ! Je suis de bonne humeur aujourd'hui, et tu ne gâcheras pas ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470109,
					"content": "D'ailleurs, en parlant de Cacucu... Où est-il ? Ne me dites pas que le roi capybara l'a dévoré ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470110,
					"content": "Quoi ? Tu t'entends au moins, poto ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470111
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470111,
					"content": "Cacucu s'est allié à l'ennemi pour nous embêter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470112
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470112,
					"content": "Vous embêter ? Cacucu ? Hahaha, pas mal la blague, Ororon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470113,
					"content": "Ce n'était pas une blague.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470114
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470114,
					"content": "Hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470115,
					"content": "Qui est cet ennemi ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470116
					]
				},
				{
					"id": 752470116,
					"content": "Il a dit qu'il s'appelait Cacasha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470117
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470117,
					"content": "Hein ? Ça veut dire que c'est un asha qui parle ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470118,
					"content": "Hep hep hep ! Ororon est en train de raconter n'importe quoi. Je vais tout expliquer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470119
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470119,
					"content": "Cacucu est en train de... jouer à cache-cache avec un asha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470120
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470120,
					"content": "En gros, ils jouent ensemble contre nous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470121
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470121,
					"content": "Cacucu est rapide et Cacasha peut se déguiser... On est face des adversaires redoutables.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470122
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470122,
					"content": "On n'a pas arrêté de jouer avec eux avant votre arrivée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470123
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470123,
					"content": "Et Cacucu est vraiment doué à ce jeu. Je suis fier de lui, certes... mais je suis aussi lessivé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470124
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470124,
					"content": "Tu aurais dû aller aux cours de fitness d'Iansan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470125
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470125,
					"content": "*soupir* J'ai mal au dos, à force de chercher ces petits chenapans !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470126
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470126,
					"content": "Évidemment, tu n'es pas allé au cours de fitness d'Iansan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470127
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470127,
					"content": "... C'est bon, j'ai compris ! J'irai quand on rentrera, d'accord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470128
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470128,
					"content": "Hé, vous devriez continuer à les chercher, non ? Ce n'est pas en vous chamaillant que vous allez les trouver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470129,
					"content": "Eh bien, un beau citron vient de tomber du ciel...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470130
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470130,
					"content": "Qui ? Moi ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470131
					]
				},
				{
					"id": 752470131,
					"content": "Eh oui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470132
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470132,
					"content": "D'accord, je me mets au travail.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470133
					]
				},
				{
					"id": 752470133,
					"content": "#Courage, {M#grand-père}{F#autre grand-mère} ! Et toi aussi, grand-mère Paimon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470134
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470134,
					"content": "Amusez-vous bien, et appelez-nous si vous avez besoin d'aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470135
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470135,
					"content": "Je pensais qu'on deviendrait des ashas nous aussi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470136
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470136,
					"content": "Oh non... Ne me dis pas que vous allez vous cacher aussi et nous forcer à vous trouver ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470137,
					"content": "Eh si ! Maintenant, je suis « Orasha » et lui, c'est « Ifasha ». On va se cacher ! Bonne chance !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470138
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470138,
					"content": "Quoi ? Hé, poto...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470139
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470139,
					"content": "Désolé... Ça vous dérangerait de jouer le jeu pour l'instant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470140,
						752470141
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470140,
					"content": "Pas du tout. C'est marrant !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470142
					]
				},
				{
					"id": 752470142,
					"content": "Merci à vous deux ! Bon, je dois aller trouver une cachette !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470141,
					"content": "Ne t'inquiète pas, j'ai encore de l'énergie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470142
					]
				}
			]
		},
