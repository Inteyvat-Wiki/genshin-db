			"dialogs": [
				{
					"id": 752475001,
					"content": "Content, poto ? Tu t'es bien amusé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475002
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752475002,
					"content": "Ouah, poto !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475003
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752475003,
					"content": "Je pense que ça veut dire oui. Joyeux anniversaire, poto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475004
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752475004,
					"content": "D'ailleurs, pourquoi tu ne m'as pas parlé du plan ? Sérieusement, on ne se fait pas de cachotteries entre potos !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475005
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752475005,
					"content": "Haha... Pour être honnête, je voulais voir si tu te souvenais de l'anniversaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475006
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752475006,
					"content": "... Tu as changé, Ifa. Comment je peux te faire confiance quand tu trahis un poto de la sorte ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475007
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752475007,
					"content": "Eh bien, je m'en suis souvenu. J'ai gardé du miel frais pour Cacucu. Je connais le prix à payer quand on oublie son anniversaire, et je n'avais pas la moindre envie de me faire picorer pendant toute une année.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475008
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752475008,
					"content": "Impossible, poto ! T'es le meilleur, poto !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cacucu"
				}
			]
		},
