			"dialogs": [
				{
					"id": 740590201,
					"content": "#{NICKNAME}, Paimon ! Ça fait longtemps !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590202
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590202,
					"content": "Vous recherchez les mêmes pierres étranges que la dernière fois ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590203
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590203,
					"content": "Oui, mais on a autre chose à vous dire aussi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590204,
					"content": "Vous remettez le prototype d'horloge à Puca et lui parlez des plans de Chesil qui souhaite fabriquer des horloges avec le minerai étrange.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740590205
					]
				},
				{
					"id": 740590205,
					"content": "Mais c'est génial ! C'est vraiment possible de faire ça avec ces pierres ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590206
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590206,
					"content": "Hein ? Seulement les parties à l'intérieur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590207,
					"content": "On peut même l'entendre sous l'eau... Je n'ai jamais vu une horloge pareille !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590208
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590208,
					"content": "Chesil disait qu'elle avait une structure d'huître... ou de palourde, je ne sais plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590209,
					"content": "Héhé, entendre le son de l'horloge me rend heureuse !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590210
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590210,
					"content": "Je n'aurais jamais cru que des pierres aussi banales auraient servi à faire quelque chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590211
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590211,
					"content": "Je pensais que seules les gemmes pouvaient être transformées en objets impressionnants, comme le fait ma sœur. J'ignorais qu'on pouvait faire ce genre de choses avec des pierres ordinaires...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590212
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590212,
					"content": "Chacun a sa propre valeur et sa propre mission dans la vie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740590213
					]
				},
				{
					"id": 740590213,
					"content": "Oui, je me sens beaucoup mieux vis-à-vis de moi-même maintenant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590214
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590214,
					"content": "Puca pose l'horloge dans un endroit agréable à regarder.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740590215
					]
				},
				{
					"id": 740590215,
					"content": "Il ne vous reste plus qu'à préparer le minerai et à le vendre à Chesil dès qu'il en a besoin !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590216,
					"content": "Vous pourrez ouvrir votre propre atelier de gemmes, comme votre sœur !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590217,
					"content": "Vous avez collecté beaucoup de pierres différentes, après tout. Peut-être que vous trouverez une utilité à chacune d'entre elles !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590218,
					"content": "Oui, je vais préparer les pierres comme il faut ! Merci beaucoup !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590219
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590219,
					"content": "N'hésitez pas à revenir me voir si vous avez besoin de pierres !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590220
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590220,
					"content": "Héhé, de rien !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
