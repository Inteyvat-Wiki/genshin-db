				]
			},
			"dialogs": [
				{
					"id": 740590101,
					"content": "Ah, c'est vous qui m'avez vendu ces gemmes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590102
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590102,
					"content": "Exactement ! Vous avez dit quelque chose à propos de les transformer en jolis accessoires la dernière fois que nous nous sommes rencontrés... Vous en êtes où ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590103,
					"content": "J'ai hâte de voir ce que ça a donné !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590104,
					"content": "Hum... J'ai bien peur de vous décevoir à ce sujet...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590105
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590105,
					"content": "Hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590106,
					"content": "Je voulais incruster ces gemmes dans des bijoux, mais le minerai est trop difficile à polir finement à la main...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590107
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590107,
					"content": "Et le pire, c'est qu'il perd complètement sa lueur initiale après avoir été taillé et poli. Qui l'aurait cru ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590108
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590108,
					"content": "Enfin, ils ne sont pas du tout faits pour être transformés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590109
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590109,
					"content": "Oh, je ne pensais pas que ça finirait comme ça. On croyait que ces pierres pouvaient être utiles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590110,
					"content": "Utiles ? Elles le sont...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590126
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590126,
					"content": "Chesil place une horloge mécanique sur le comptoir tout en parlant.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740590111
					]
				},
				{
					"id": 740590111,
					"content": "Regardez cette nouvelle horloge mécanique. Elle a été fabriquée à partir de ces minerais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590112
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590112,
					"content": "Après m'être lamenté de mon erreur dans mon jugement, j'allais m'en débarrasser...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590113
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590113,
					"content": "C'est là que des horlogers sont venus et ont vu les débris de notre tentative de traitement du matériau. Le minerai était si robuste qu'ils en ont pris avec eux pour les incorporer à leurs travaux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590114
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590114,
					"content": "Et quelle a été ma surprise de voir que sa haute résistance à l'abrasion en faisait un matériau supérieur à ceux traditionnellement utilisés pour fabriquer les pièces qui bougent en horlogerie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590115
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590115,
					"content": "Mais s'il est utilisé dans ce domaine, l'approvisionnement devra être encore plus stable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590116,
						740590117
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590116,
					"content": "On peut régler ça...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740590118
					]
				},
				{
					"id": 740590118,
					"content": "Vous parlez de Puca et des veines de minerais à Chesil.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740590119
					]
				},
				{
					"id": 740590119,
					"content": "Je vois. C'est une heureuse coïncidence ! Le prototype d'horloge a été créé selon le dernier modèle étanche en structure de palourde. En d'autres termes, il était destiné à être utilisé par une mélusine dès le départ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590120
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590120,
					"content": "Dans ce cas, pourriez-vous l'amener à mademoiselle Puca et lui expliquer la situation ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590121
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590121,
					"content": "Après tout, je n'ai jamais fait d'affaires avec des mélusines... Si mademoiselle Puca pouvait nous approvisionner en minerai de manière stable, nous pourrions établir une nouvelle ligne de production.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590122
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590122,
					"content": "Je m'assurerai de lui rendre visite personnellement à l'avenir ! Hmm... Ce serait pas mal de s'inspirer de l'esthétique des mélusines pour mes prochains produits aussi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590123
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590123,
					"content": "Héhé, on dirait que Puca en aura quelque chose à en tirer si ça réussit !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590124,
					"content": "Oh, ce serait l'occasion pour Puca de créer son propre atelier de gemmes ! Allons-lui parler !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590125,
					"content": "Je compte sur vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590117,
					"content": "Vous pouvez directement voir avec Puca...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740590118
					]
				}
			]
		},
