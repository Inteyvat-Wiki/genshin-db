			"dialogs": [
				{
					"id": 225011201,
					"content": "Après réflexion, votre inquiétude n'est pas sans raisons, je dois le reconnaître. Mieux vaut que je m'abstienne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011202
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011202,
					"content": "Tant mieux...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225011203
					]
				},
				{
					"id": 225011203,
					"content": "Et puis, qui a dit qu'il fallait à tout prix une vue grandiose pour écrire de la poésie ? La beauté du monde est dans les détails...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011204
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011204,
					"content": "Le spectacle d'une simple et frêle fleur doit aussi suffire à l'amant des muses, après tout. Mais il existe déjà tellement de poèmes sur le sujet...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011205
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011205,
					"content": "#*soupir* « Nul n'en sait autant que le spectateur », comme on dit. Quelle fleur se prête le plus à l'exercice à vos yeux, {M#mon ami}{F#mon amie} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
			]
		},
