			"dialogs": [
				{
					"id": 225010301,
					"content": "Il existe un meilleur moyen d'aller observer les météorites.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010302
					]
				},
				{
					"id": 225010302,
					"content": "Un meilleur moyen... C'est vrai que si je suis à côté, je ne verrai pas le paysage dans son entièreté... Ce manque de perspective est ennuyeux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
