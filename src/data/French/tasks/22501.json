			"dialogs": [
				{
					"id": 225011301,
					"content": "Hum... Après réflexion, cette pluie de météores reste une occasion comme il s'en présente peu, je ne vais pas la rater.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011302
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011302,
					"content": "Vous...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225011303
					]
				},
				{
					"id": 225011303,
					"content": "Mais, si je commence par aller observer ce spectacle de près, je ne verrai que les pierres, mais point le monde qui les entoure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011304
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011304,
					"content": "« L'arbre qui cache la forêt » est la némésis du poète. Aucun doute que ne m'inspirer que des météorites vues de près ne mènera à aucun poème de valeur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011305
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011305,
					"content": "C'est pourquoi je considère observer la vue d'un poste plus reculé, pour ensuite seulement aller chercher l'inspiration de plus près...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011306
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011306,
					"content": "Hum, et... C'est vrai que les monstres ne sont pas rares dans les environs, et je n'ai guère les moyens pour l'instant d'aller chercher quelqu'un pour m'accompagner...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011307
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011307,
					"content": "Que diriez-vous de marcher à mes côtés, et de veiller à ce qu'aucun monstre ne nous barre le chemin ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011308,
						225011310
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011308,
					"content": "Pas de problème.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225011309
					]
				},
				{
					"id": 225011309,
					"content": "Ah, voilà qui est parfait ! Je vous suis très reconnaissant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011310,
					"content": "Promettez-moi d'abord que vous n'irez pas toucher les pierres...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225011311
					]
				},
				{
					"id": 225011311,
					"content": "Hum... Vous avez ma parole. Pourquoi irais-je donc les toucher en sachant qu'un sommeil sans réveil m'attend ? Je ne suis pas aussi dénué de raison...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011312
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011312,
					"content": "Mais tout de même... Je me demande à quoi rêvent les malheureux qui s'endorment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011313
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011313,
					"content": "*tousse* Je plaisante, bien sûr. Je vous laisse aller nous débarrasser de ces monstres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
			]
