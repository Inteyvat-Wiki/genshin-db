			},
			"dialogs": [
				{
					"id": 225010601,
					"content": "Pourquoi vouloir à tout prix écrire quelque chose qui choque le monde...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010602
					]
				},
				{
					"id": 225010602,
					"content": "Ah mais justement ! Les meilleurs vers sont ceux inspirés par le divin, et la plus douée des mains est guidée par la chance. Et pourtant, je bloque depuis trop longtemps sur ce vers...",
					"roleType": "TALK_ROLE_NPC",
