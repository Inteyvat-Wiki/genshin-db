					"nextDialogs": [
						225010402
					]
				},
				{
					"id": 225010402,
					"content": "Impossible, malheureusement. Se réfugier dans un coin sans horizons pour rédiger un poème ne résulte qu'en fadaises sans queue ni tête.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
