				{
					"id": 225010501,
					"content": "Il y a des monstres dans la région des météorites.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010502
					]
				},
				{
					"id": 225010502,
					"content": "Haha, j'ai parcouru Liyue dans toutes les directions, et mon chemin a croisé à maintes reprises celui de créatures en tout genre. Et si vraiment le danger est trop grand... Je peux embaucher quelqu'un pour se joindre à moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
			]
		},
		{
