				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718291401,
					"content": "Goûtons tout ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291402
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718291402,
					"content": "Oh, ce goût... Si frais, si riche, mais avec la consistance du tofu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291403
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718291403,
					"content": "C'est aussi un plat très présentable et qui requiert du savoir-faire. Et accrocheur aussi : un plat de viande qui imite la cuisine végétarienne. Je suis sûr que pas mal de clients vont vouloir l'essayer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291404
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718291404,
					"content": "Pas mal, pas mal ! Et ça devrait plaire à la patronne !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291405
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718291405,
					"content": "Qui l'eût cru ? Pour quelqu'un qui mange à l'œil tous les jours, tu connais quand même quelques trucs. Que tu aies retenu cette recette...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291406
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718291406,
					"content": "Héhé. Je peux bien l'avouer : j'ai passé longtemps à l'étudier, nuit et jour – je croyais qu'elle cachait un genre de technique d'épée secrète...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291407
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291407,
					"content": "Maintenant que j'y repense, j'étais vraiment obsédé à m'entraîner sans m'arrêter... Ce n'est qu'une simple recette, qui irait y voir une technique martiale ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291408
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291408,
					"content": "Pourquoi s'entraîner comme ça...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718291409
					]
				},
				{
					"id": 718291409,
					"content": "Pour retrouver une certaine personne et obtenir justice, c'est tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291410
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291410,
					"content": "« C'est tout » ? Tu en parles comme si ce n'était rien !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291411
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718291411,
					"content": "Héhé, quoi qu'il en soit, une fois justice obtenue, je suis venu ici. La patronne a été assez bonne pour accepter que je reste dans les parages.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291412
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291412,
					"content": "Je n'ai plus d'attentes, à présent. Je ne brandirai plus mon arme, et je n'ai guère d'autres talents... Hahaha, l'un dans l'autre, passer le restant de mes jours ici n'est pas si mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291413
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291413,
					"content": "Bien, je suppose que je devrais vous donner une copie de cette recette. Vous pourrez la préparer pour votre usage quand l'envie vous prendra. C'est assez compliqué, mais excellent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291414,
						718291415
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291414,
					"content": "Merci.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718291417
					]
				},
				{
					"id": 718291417,
					"content": "Hum... Bon, mettons ce plat de côté pour que je puisse le montrer à la patronne quand elle rentrera...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291418
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718291418,
					"content": "Et ensuite... Hé, le pique-assiette, une minute. Ne t'en va pas comme ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291419
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718291419,
					"content": "Quoi, qu'est-ce qu'il y a ? C'est la seule recette que je puisse te donner, tu sais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291420
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291420,
					"content": "Allons. Tu disais que tu n'avais pas d'autres talents à part manier l'épée ? Alors vas-y, sors ton épée. Je vais t'apprendre à émincer la viande.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291421
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718291421,
					"content": "Émincer la viande ? J'ai bien peur que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291422
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291422,
					"content": "Ça viendra vite. Aujourd'hui tu apprends à préparer la viande, demain tu apprends à cuisiner un plat. Apprends-en plusieurs, et tu as un autre talent à ajouter à la liste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291423
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718291423,
					"content": "Qu'est-ce que tu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291424
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291424,
					"content": "Hmpf. Si je t'apprends quelques plats, je n'aurai plus besoin de voir ta tête dans les parages si souvent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291425
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718291425,
					"content": "Allez, on se bouge ! Traîne comme ça, et tu peux faire une croix sur tes boulettes de viande demain !",
