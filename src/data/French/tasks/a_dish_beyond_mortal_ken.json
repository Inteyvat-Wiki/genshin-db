						718290704
					]
				},
				{
					"id": 718290704,
					"content": "Eh bien... peut-être que notre ami le pique-assiette peut nous indiquer quoi faire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290705
