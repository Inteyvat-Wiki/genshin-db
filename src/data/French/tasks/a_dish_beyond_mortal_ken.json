			]
		},
		{
			"id": 7182903,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182902",
							"2"
						],
						"stepId": 7182902,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jiangxue"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718290301,
					"content": "#Tiens ? {M#Un invité spécial}{F#Une invitée spéciale}, à ce que je vois. En général, c'est juste le chef et moi, à manger en silence. Votre présence va peut-être égayer notre routine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290302
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290302,
					"content": "Mais le chef a l'air ennuyé, on dirait. Pourquoi tirer cette tête...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiangxue"
				}
			]
		},
		{
			"id": 7182904,
			"completionStepIds": [
				7182903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182903",
							"2"
						],
						"stepId": 7182903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jiangxue",
					"Yanxiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718290401,
					"content": "Ces boulettes de viande ne sont pas mauvaises. La viande fond en bouche et le bouillon est savoureux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290402
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290402,
					"content": "Oh ? Des œufs de crabe dans la viande ? Ça explique ce goût si frais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290403
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290403,
					"content": "#Tenez, {M#voyageur}{F#voyageuse}, essayez donc, je vous montre. D'abord, ouvrez la boulette de viande à l'aide des baguettes, puis trempez-la dans le bouillon, et accompagnez-la de riz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290404,
						718290405,
						718290407
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290404,
					"content": "Merci, merci...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290409
					]
				},
				{
					"id": 718290409,
					"content": "Profitez bien de ce repas, tous les deux. Ça pourrait bien être le dernier que je prépare ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290410
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290410,
					"content": "Le dernier ? D'où tu sors ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290411
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290411,
					"content": "Oh, c'est ma faute ? La patronne en a marre de te voir me nourrir tous les jours ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290412
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290412,
					"content": "C'est un peu injuste, quand on pense que j'ai offert pas mal de mes plus belles prises à l'auberge. Ça devrait au moins couvrir une partie des frais. Et puis, la patronne n'est pas du genre radin, pourtant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290413
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290413,
					"content": "Arrête un peu ton cinéma, quelques poissons, rien de plus, et ils ont quasiment tous finis dans ton ventre de toute façon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290414
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290414,
					"content": "Alors, en fait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290415
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290415,
					"content": "*soupir* Bon, ça va, autant te le dire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290416
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290416,
					"content": "Joli, délicieux, qui ait du style, qui soit préparé de manière artisanale, et qui ait aussi de la personnalité...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290417
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290417,
					"content": "Hahaha, je ne suis pas sûr qu'il existe un plat au monde qui puisse répondre aux exigences de la patronne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290418
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290418,
					"content": "Ça te fait rire ? On verra si tu ris encore quand tu te pointeras ici et que je serai parti !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290419
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290419,
					"content": "Pardon, pardon, ce n'est pas drôle. Alors c'est pour ça que tu fais une tête de dix mètres de long.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290420
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290420,
					"content": "Difficile d'avoir le moral au beau fixe quand ta patronne attend un miracle de ta part...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290421
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290421,
					"content": "Hmm, il y a peut-être un moyen de résoudre ça. Je ne vaux rien en cuisine, mais je connais la recette d'un plat unique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290422
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290422,
					"content": "J'ai fait la découverte de ce plat durant un voyage à l'étranger, un jour où j'étais l'invité d'un gros poisson local. Il s'agit du « poulet façon tofu ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290423
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290423,
					"content": "Impossible de deviner qu'il s'agit d'un plat de viande à son aspect. C'est un mets aussi délicat que le tofu, rehaussé par le goût de la viande et des herbes. Un plat de viande qui imite la cuisine végétarienne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290424
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290424,
					"content": "J'ai été tellement surpris après l'avoir goûté que j'en ai demandé la recette à mon hôte... Mais moi et les fourneaux, ça fait deux, et la recette prend la poussière dans un tiroir depuis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290425,
						718290428
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290425,
					"content": "Comment donc avez-vous réussi à mettre la main sur une telle recette ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290426
					]
				},
				{
					"id": 718290426,
					"content": "Ah... Pour faire court, j'ai aidé quelqu'un, et j'ai été invité à un banquet en retour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290427
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290427,
					"content": "Ça n'a pas dérangé le chef qui avait inventé cette recette de la partager avec moi. Il savait que les gens capables de la réussir se comptent sur les doigts d'une main.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290429
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290429,
					"content": "Et c'est un euphémisme. D'après le chef, seuls ceux qui excellent en cuisine ET au maniement de l'épée ont une chance de réussir ce plat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290430
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290430,
					"content": "Hmpf, quel genre de plat requiert qu'on sache utiliser une épée ? Mon couteau de cuisine fait parfaitement l'affaire pour couper la viande.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290431
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290431,
					"content": "J'ai peur que tu ne finisses par couper ta planche en deux plutôt que d'émincer la viande suffisamment fin avec un couteau comme le tien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290432
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290432,
					"content": "D'après ce chef, la clé est dans la façon de couper la viande, justement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290433
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290433,
					"content": "Et pour cela, la maîtrise de l'épée est indispensable. Il faut d'abord utiliser le fil de l'épée pour couper puis émincer la viande, avant d'utiliser le plat de la lame pour la travailler jusqu'à obtenir la texture voulue. Ensuite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290434
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290434,
					"content": "Attends, une minute... Cette recette ne nous sert à rien. Je n'ai rien d'un pro de l'épée, et tu ne vaux rien en cuisine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290435
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290435,
					"content": "Où trouver un épéiste qui sache aussi cuisiner ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290436
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290436,
					"content": "Eh bien... Ce que tu cherches se trouve peut-être juste sous tes yeux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290437,
						718290439
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290437,
					"content": "M—Moi ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290438
					]
				},
				{
					"id": 718290438,
					"content": "Absolument. N'est-ce pas un heureux tour du destin que vous sachiez manier aussi bien l'épée que la casserole ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290441
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290441,
					"content": "#Pourquoi ne pas laisser {M#le voyageur}{F#la voyageuse} tenter l'expérience ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290442
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290442,
					"content": "Mais la patronne veut que Yanxiao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290443
					]
				},
				{
					"id": 718290443,
					"content": "La patronne a seulement demandé à Yanxiao d'inventer un nouveau plat. Elle n'a pas précisé qui devait le cuisiner, jusqu'à preuve du contraire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290444
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290444,
					"content": "J'ai raison ou pas, chef ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290445
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290445,
					"content": "Euh... Oui ! Ça me paraît solide comme logique !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290446
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290446,
					"content": "Mais quels ingrédients faut-il pour préparer ce poulet façon tofu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290447
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290447,
					"content": "À dire vrai, rien qui ne sorte de l'ordinaire. De la volaille, du jambon, des œufs et des gueules-de-loup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290448
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290448,
					"content": "... Il me reste de la volaille et du jambon dans la cuisine, mais... on est à court d'œufs et de gueules-de-loup...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290449
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290449,
					"content": "Ah, je n'aurais pas préparé cette omelette aux matsutake si j'avais su...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290450
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290450,
					"content": "#{M#Voyageur}{F#Voyageuse}, tu irais me chercher une portion de chaque ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290451
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290451,
					"content": "Quand tu auras tout récupéré, on s'attellera ensemble à ce poulet façon tofu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290452
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290452,
					"content": "Hum... Je te revaudrai ton aide, ça va sans dire... Et merci d'avance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290439,
					"content": "C'est vrai que je me débrouille en cuisine...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290440
					]
				},
				{
					"id": 718290440,
					"content": "Et l'épée n'a pas de secrets pour vous, n'est-ce pas ? J'ai vu de mes propres yeux ce dont vous étiez capable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290441
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290428,
					"content": "Ça ne doit pas être facile à préparer, tout ça...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290429
					]
				},
				{
					"id": 718290405,
					"content": "Vous êtes un expert, à ce que je vois...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290406
					]
				},
				{
					"id": 718290406,
					"content": "Hahaha, même un idiot finit par apprendre quelques trucs à manger de tels délices tous les jours. Laissez-moi vous montrer comment se mange ce poisson à la vapeur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290409
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290407,
					"content": "Tu ne manges pas avec nous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290408
					]
				},
				{
					"id": 718290408,
					"content": "Moi ? J'ai bien peur d'être déjà plein... plein d'angoisse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290409
					],
					"speakerTitle": "Yanxiao"
				}
			]
