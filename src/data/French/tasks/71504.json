				"points": []
			},
			"dialogs": [
				{
					"id": 715040101,
					"content": "*tousse* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040102
					],
					"speakerTitle": "Hussein"
				},
				{
					"id": 715040102,
					"content": "Hussein, ça va ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715040103,
					"content": "J'ai moi aussi été affecté. J'ai dû passer trop de temps dans les tunnels pour trouver un moyen de déplacer les Pointes de Pursina jusqu'au point de rupture des lignes énergétiques.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040104
					],
					"speakerTitle": "Hussein"
				},
				{
					"id": 715040104,
					"content": "Rien de grave, toutefois. Je me suis reposé un moment, et je me sens déjà beaucoup mieux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040105
					],
					"speakerTitle": "Hussein"
				},
				{
					"id": 715040105,
					"content": "Je suis tout de même parvenu à une solution. Après tout, trouver un moyen de déplacer les Pointes de Pursina ne peut pas être plus difficile que chercher une excuse pour repousser la date limite de mon rapport de recherche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040106
					],
					"speakerTitle": "Hussein"
				},
				{
					"id": 715040106,
					"content": "Puisque le sol est couvert de boue noire, on peut utiliser un ballon pour faire flotter les Pointes dans l'air et les transporter dans les tunnels.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040107
					],
					"speakerTitle": "Hussein"
				},
				{
					"id": 715040107,
					"content": "Ça semble être une bonne idée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715040108,
					"content": "Mais évidemment, cela ne nous aidera à résoudre notre problème de boue noire que dans une certaine mesure. Il sera quand même difficile de déplacer le ballon dans les tunnels bloqués par la boue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040109
					],
					"speakerTitle": "Hussein"
				},
				{
					"id": 715040109,
					"content": "Et c'est sans parler des monstres qui seront attirés par la boue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040110
					],
					"speakerTitle": "Hussein"
				},
				{
					"id": 715040110,
					"content": "J'ai bien peur que ce soit à vous de régler ce problème.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040111
					],
					"speakerTitle": "Hussein"
				},
				{
					"id": 715040111,
					"content": "#Pas de souci ! {NICKNAME} et moi, on va botter les fesses des monstres qui s'approcheront du ballon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040112,
						715040113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715040112,
					"content": "On comptera sur toi tout à l'heure, alors.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715040114
					]
				},
				{
					"id": 715040114,
					"content": "M—Moi, je serai juste à côté de toi pour t'encourager, c'est tout...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715040115,
					"content": "Hahaha *tousse* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040116
					],
					"speakerTitle": "Hussein"
				},
				{
					"id": 715040116,
					"content": "Ouh là. Je ris juste un peu, et voilà comme je tousse... Bref. Tu et Hao sont en train d'emballer les Pointes de Pursina et de préparer le ballon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040117
					],
					"speakerTitle": "Hussein"
				},
				{
					"id": 715040117,
					"content": "Au départ, je voulais faire tout ça moi-même, mais rien que de rester debout me fait tousser comme pas possible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040118
					],
					"speakerTitle": "Hussein"
				},
				{
					"id": 715040118,
					"content": "Quel embarras. Il va falloir que je me mette au sport en plus de mes travaux de recherche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040119
					],
					"speakerTitle": "Hussein"
				},
				{
					"id": 715040119,
					"content": "Allez vite les retrouver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hussein"
				},
				{
					"id": 715040113,
					"content": "Je te prêterai mon épée.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715040114
					]
				}
			]
		},
