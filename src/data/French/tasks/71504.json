					"Hao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715040201,
					"content": "#Hé, {NICKNAME} ! Tu arrives pile-poil, on vient de finir d'emballer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040202
					],
					"speakerTitle": "Tu"
				},
				{
					"id": 715040202,
					"content": "Ce type de Sumeru t'a déjà expliqué, je suppose ? On va utiliser ce ballon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040203
					],
					"speakerTitle": "Tu"
				},
				{
					"id": 715040203,
					"content": "Qui c'est que tu appelles « ce type de Sumeru » ? Hussein est venu nous aider à régler notre problème de boue noire. C'est un chercheur émérite, aie un peu de respect !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040204
					],
					"speakerTitle": "Hao"
				},
				{
					"id": 715040204,
					"content": "D—De quoi tu parles ? C'est juste une façon amicale de parler de lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040205
					],
					"speakerTitle": "Tu"
				},
				{
					"id": 715040205,
					"content": "Passons. Le ballon peut maintenant être utilisé et le dispositif pour nettoyer la boue noire est prêt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040206
					],
					"speakerTitle": "Hao"
				},
				{
					"id": 715040206,
					"content": "#{NICKNAME}, si tu as besoin de l'aide de la star de la mine... *tousse* Laisse tomber, je ne pense pas pouvoir t'aider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040207
					],
					"speakerTitle": "Tu"
				},
				{
					"id": 715040207,
					"content": "C'est bien que tu t'en rendes compte. Tu ferais mieux de te reposer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040208
					],
					"speakerTitle": "Hao"
				},
				{
					"id": 715040208,
					"content": "*soupir* Bon, quand tu voudras commencer à déplacer le dispositif, tu n'auras qu'à activer le ballon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tu"
				}
			]
		},
