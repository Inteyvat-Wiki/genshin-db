			"dialogs": [
				{
					"id": 761490101,
					"content": "#Quoi{NON_BREAK_SPACE}?! Qui est-ce{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490102
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490102,
					"content": "#{NICKNAME}, {M#celui}{F#celle} qui appartient à cette époque.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761490103
					]
				},
				{
					"id": 761490103,
					"content": "Bien que je ne connaisse rien de votre époque, je m'appelle Alara. J'étais jadis un ascète de l'ère du silence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490104
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490104,
					"content": "Je ne sais plus combien de temps s'est écoulé depuis mon arrivée. Même ce lieu a brisé ma méditation silencieuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490105
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490105,
					"content": "Il est donc vrai que cultiver un esprit sans pensée ni désir conduit à se réincarner dans le paradis inconscient du mal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490106
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490106,
					"content": "Ce n'était rien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761490107
					]
				},
				{
					"id": 761490107,
					"content": "Pas besoin de me remercier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761490108
					]
				},
				{
					"id": 761490108,
					"content": "#Merci quand même{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490109
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490109,
					"content": "Vous sauver relève plus d'un coup de tête. Cela dit, nous comptons bien trouver une autre solution que la méditation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490110
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490110,
					"content": "#Vous ne pratiquez pas la méditation{NON_BREAK_SPACE}? Peut-être que ce n'est simplement pas enseigné à votre époque{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490111
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490111,
					"content": "La première fois que j'ai quitté cet endroit, cela m'a pris des centaines d'années. J'ai renoncé à ma quête de la vérité... et à mon désir ardent de revoir mes proches.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490112
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490112,
					"content": "Cette fois, je ne suis pas prêt à renoncer à ces choses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490113
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490113,
					"content": "Moi non plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490114
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490114,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490115
					],
					"speakerTitle": "Dex"
				},
				{
					"id": 761490115,
					"content": "Dex a récupéré un autre fragment de nécromuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490116
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490116,
					"content": "Nécromuse ? Ah, vous voulez parler de la technique de méditation Maranasati. Je la connais, on la pratique pour entraîner son esprit à affronter la mort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490117
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490117,
					"content": "Maintenant que Zeitlind a été retrouvée, essayons de trouver un moyen de sortir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490118
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490118,
					"content": "On peut vraiment sortir d'ici par nous-mêmes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490119
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490119,
					"content": "Melanta et Nihilita peuvent se déplacer librement dans cet endroit. Ils amènent généralement des personnes avec eux. Dex devrait pouvoir faire de même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490120
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490120,
					"content": "♪ ~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490121
					],
					"speakerTitle": "Dex"
				},
				{
					"id": 761490121,
					"content": "Ça fait trois fragments de nécromuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490122
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490122,
					"content": "Ah, mais je dois préciser qu'il s'agit d'un nom provisoire, car je n'ai aucune idée de l'usage que Dex en fera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490123
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490123,
					"content": "Et ensuite, Dex ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490124
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490124,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490125
					],
					"speakerTitle": "Dex"
				},
				{
					"id": 761490125,
					"content": "Suivons les directions qu'il nous indique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Istoria"
				}
			]
		},
