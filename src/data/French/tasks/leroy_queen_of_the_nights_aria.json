			"dialogs": [
				{
					"id": 741560401,
					"content": "#Je suis tellement stressée, {NICKNAME} ! D'après ce qui est écrit sur cette note, on a juste à l'attendre ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560402,
						741560403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741560402,
					"content": "Alors faisons preuve de patience.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741560404
					]
				},
				{
					"id": 741560404,
					"content": "Très bien, c'est toi qui vois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741560405,
					"content": "#Après avoir attendu tranquillement l'espace d'un instant, une fenêtre s'ouvre avec un grincement, et un visage familier apparaît. Benoît sort la tête et, après vous avoir {M#vu}{F#vues}, il sort prudemment par la fenêtre.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741560406
					]
				},
				{
					"id": 741560406,
					"content": "Benoît, mais qu'est-ce que ça veut dire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741560407,
					"content": "Allons, partons ! Il ne faut surtout pas qu'ils nous voient.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741560403,
					"content": "J'ai quelques questions à lui poser.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741560404
					]
				}
			]
		},
