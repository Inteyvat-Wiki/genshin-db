			"dialogs": [
				{
					"id": 741560801,
					"content": "Salut, cher papa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560802
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560802,
					"content": "... C'est trop tard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560803
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741560803,
					"content": "Quelle ne fut pas ma surprise quand Automne m'a dit que vous alliez faire une fugue. Nous vous avons enfermé depuis si longtemps, mais vous ne lâchez pas l'affaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560804
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560804,
					"content": "#Et vous profitez de la présence de ces deux « {M#héros}{F#héroïnes} de la justice », en les incitant à vous aider dans votre évasion. Votre instinct de survie m'émeut énormément.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560805
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560805,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741560806,
					"content": "Vous aviez tellement d'endroits où vous échapper, alors pourquoi choisir celui où vous emmeniez fréquemment Automne se promener ? C'est vraiment stupide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560807
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560807,
					"content": "Je...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560808
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741560808,
					"content": "Pas besoin d'explications. Je peux comprendre que dans la panique, on choisisse les lieux qui nous sont les plus familiers... N'ai-je pas raison ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560809
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560809,
					"content": "Heureusement, Automne est partie après vous. Elle n'est pas encore arrivée ici et je ne souhaite pas parler de ce genre de choses devant elle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560810
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560810,
					"content": "Qu'avez-vous en tête ? Je n'arrive pas à comprendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560811
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560811,
					"content": "Au motif d'un mariage arrangé, vous l'avez vendue à un inconnu. Vous l'avez même vendue deux fois. La première, c'était contre cette grande maison à la Cour de Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560812
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560812,
					"content": "Et la deuxième fois en l'envoyant chez quelqu'un d'autre afin que sa propriété et tous ses biens deviennent les vôtres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560813
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560813,
					"content": "Lorsqu'elle a été victime de harcèlement et d'humiliation, vous avez fermé les yeux sur ça. Elle vous a confié l'enfant issu de son deuxième mariage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560814
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560814,
					"content": "Mais vous avez choisi de vous débarrasser de son enfant aussi, en échange d'une grosse somme qui était supposée être sa pension alimentaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560815
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560815,
					"content": "Comment pouvez-vous encore inviter chez vous des enfants et leur offrir des friandises en toute conscience, après tout ce que vous avez fait ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560816
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560816,
					"content": "N'avez-vous jamais éprouvé ne serait-ce qu'une once de culpabilité ? Ça me sidère.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560817
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560817,
					"content": "Pour être honnête, j'ai rencontré Automne lorsqu'elle errait comme une vagabonde. C'est une mère très douce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560818
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560818,
					"content": "Elle s'est très bien occupée de Penny, la fille de mon ami. La gamine pleure en demandant à voir « Tata Automne » quand elle s'absente plus d'une journée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560819
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560819,
					"content": "Oh, et si vous pensez avoir encore une chance de remédier à la situation, vous vous trompez. Automne a maintenant beaucoup d'amis, je ne suis pas le seul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560820
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560820,
					"content": "Peu importe où vous comptez vous enfuir, nous vous poursuivrons jusqu'aux confins de Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560821
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560821,
					"content": "Pourquoi des personnes comme elle souffrent et ne possèdent rien, alors que des crapules comme vous ont tout ce qu'elles désirent ? Ce n'est pas normal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560822
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560822,
					"content": "Pas besoin de philosopher, il n'en vaut pas la peine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560823
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741560823,
					"content": "Oh, tu m'as entendu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560824
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560824,
					"content": "Alors c'est vous, Automne ! Je comprends enfin ce qui s'est passé. La famille Leroy est vraiment compliquée. *soupir* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560825
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741560825,
					"content": "#{NICKNAME}, nous avons fait tout ce chemin en suivant Benoît, et je constate que beaucoup de choses sont différentes de ce qu'on pouvait penser au départ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560826
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741560826,
					"content": "Maintenant qu'on sait comment tout s'est déroulé, est-ce qu'on devrait continuer de s'impliquer dans cette affaire ? C'est toi qui vois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
