			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Morticia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741561101,
					"content": "Ce sont leurs affaires, nous ne devrions pas nous en mêler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561102
					]
				},
				{
					"id": 741561102,
					"content": "Automne, tu veux vraiment me faire ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561103
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741561103,
					"content": "Quel enfant du Fleuve cendré a eu autant de chance que toi ? Les friandises que tu mangeais, tes robes en satin, les romans que tu adorais lire, tout ça demandait beaucoup d'argent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561104
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741561104,
					"content": "Pendant que les autres enfants avaient froid et faim, tu t'amusais à mettre des colliers et des robes à ton chien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561105
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741561105,
					"content": "C'est moi qui t'ai donné cette vie. Tu ne penses pas que je mérite une récompense ? Si tu veux obtenir quelque chose, il y a un prix à payer en retour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561106
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741561106,
					"content": "Est-ce que j'ai été cruel envers toi ? J'ai été assez généreux comme ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561107
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741561107,
					"content": "Automne, réfléchis-y à deux fois. Quand n'ai-je pas pensé à toi ? À chaque fois que tu t'es retrouvée dans de beaux draps, c'est toi, et toi seule, qui a pris de mauvaises décisions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561108
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741561108,
					"content": "Mon bon Benoît, vous êtes vraiment un beau-parleur. Vous vous donnez le rôle d'un père plus que généreux pour atteindre vos objectifs égoïstes. Tout ce que vous faites, c'est pour vous-même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561109
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561109,
					"content": "Ta gentillesse était calculée. Tu m'as adoptée pour mieux me revendre ensuite. Pas besoin d'être mielleux avec moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561110
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561110,
					"content": "Tu me fais tellement pitié que je souhaite en finir rapidement avec toi. Mais avant ça, dis-moi où se trouve ma fille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561111
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561111,
					"content": "Je n'ai trouvé aucune trace d'elle dans notre ancienne maison, ni dans celle où tu habites maintenant. Où l'as-tu emmenée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561112
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561112,
					"content": "Si je parle, est-ce que tu me laisseras partir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561113
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741561113,
					"content": "Non, mais je te ferai quitter ce monde sans souffrance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561114
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561114,
					"content": "... Si je ne parle pas, tu me tues, et si je parle, tu me tues quand même... Héhé, pourquoi devrais-je me montrer arrangeant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561115
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741561115,
					"content": "*soupir* ... Automne, tu ne pouvais pas lui raconter un bobard ? Nous ne saurons jamais où elle se trouve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561116
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561116,
					"content": "Mais moi, je sais où elle se trouve, héhé. Je ne vous dirai rien, je ne vous le dirai jamais !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561117
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741561117,
					"content": "Vous ne la retrouverez jamais, jamais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561118
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741561118,
					"content": "Je vais le ramener chez lui. Une objection ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561119
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561119,
					"content": "Allez-y, nous n'avons pas à nous en mêler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561120
					]
				},
				{
					"id": 741561120,
					"content": "On vous laisse vous occuper de la situation. Ce ne sont plus nos affaires.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561121,
					"content": "Benoît marmonne « vous ne la retrouverez jamais » sans cesse pendant qu'Automne l'emmène en silence.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741561122
					]
				},
				{
					"id": 741561122,
					"content": "Je ne voulais pas en parler au début. Après tout, il y a toujours un mandat d'arrêt émis contre elle, et moi aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561123
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561123,
					"content": "Si vous vous rendez à la Maison Gardiennage pour nous dénoncer, vous gagnerez certainement beaucoup d'argent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561124
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561124,
					"content": "Mais je vous déconseille fortement de le faire, car si jamais il vous prend l'envie de nous dénoncer, mes amis ne vous oublieront pas. Mais vous pouvez toujours essayer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561125,
						741561126
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561125,
					"content": "Je ne vous dénoncerai pas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561127
					]
				},
				{
					"id": 741561127,
					"content": "Haha, je savais que vous alliez être raisonnable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561128
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561128,
					"content": "Alors dans ce cas, cette rose arc-en-ciel est pour vous. Nous aimons cette fleur parce qu'elle symbolise beaucoup de choses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561129
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561129,
					"content": "Pour le moment, elle représente un avertissement. J'espère que vous tiendrez parole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561130
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561130,
					"content": "Adieu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561131
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561131,
					"content": "Alors... Ça explique vraiment beaucoup de choses. C'est une famille compliquée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561132,
					"content": "Je ne sais vraiment pas quoi dire. Heureusement qu'on ne les a pas dénoncés à la Maison Gardiennage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561133,
					"content": "C'est quand même triste pour Automne, elle ne retrouvera plus jamais sa fille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561134,
					"content": "Au début, je pensais que Benoît était une bonne personne. Euh... Dis-moi, je ne suis pas crédule à ce point ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561135,
						741561136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561135,
					"content": "Ce n'est que maintenant que tu en as conscience ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561137
					]
				},
				{
					"id": 741561137,
					"content": "C'en est trop ! Tu te moques de moi, même dans des moments comme ça ! Hmph, je ne te le pardonnerai jamais, à moins que tu ne m'invites à l'Hôtel Debord pour manger quelque chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561136,
					"content": "Paimon, tu es naïve.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561137
					]
				},
				{
					"id": 741561126,
					"content": "Je n'ai pas besoin d'argent.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561127
					]
				}
			]
		},
