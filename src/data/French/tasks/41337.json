					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhiruo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413370601,
					"content": "Vous êtes ici pour... lâcher une lanterne ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370602
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370602,
					"content": "Seuls les membres du Clan Guhua connaissent cet endroit, et pourtant vos visages ne me sont pas familiers...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370603
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370603,
					"content": "On est là de la part de quelqu'un.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370604
					]
				},
				{
					"id": 413370604,
					"content": "Il existe encore des membres du Clan Guhua qui se souviennent de cet endroit ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370605
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370605,
					"content": "Je n'ai vu personne à mon arrivée ici, et j'étais plutôt triste, je dois le reconnaître.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370606
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370606,
					"content": "Cela me fait chaud au cœur de voir qu'il reste des disciples Guhua qui se souviennent de ce lieu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370607
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370607,
					"content": "Les membres du clan avaient l'habitude de lâcher une lanterne ici ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370608
					]
				},
				{
					"id": 413370608,
					"content": "Oui... À cette époque, une fois les lanternes terminées, le maître nous réunissait et on partait tous ensemble, lui devant et nous derrière avec les lanternes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370609
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370609,
					"content": "Une longue procession tout le long de la montagne... Un spectacle magnifique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370610
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370610,
					"content": "Mais, maintenant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370611
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370611,
					"content": "... Lâchons déjà cette lanterne céleste, d'accord ? On pourra discuter du reste sur la route, ce n'est pas pressé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiruo"
				}
			]
		},
		{
