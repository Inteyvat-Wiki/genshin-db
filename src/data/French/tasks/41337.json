			"dialogs": [
				{
					"id": 413370901,
					"content": "Il ne restait presque plus de disciples quand j'ai quitté le Clan Guhua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370902
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370902,
					"content": "Le maître ne m'en a pas voulu. Il m'a juste demandé de vivre une bonne vie.",
