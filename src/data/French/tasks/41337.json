					"nextDialogs": [
						413371009
					],
					"speakerTitle": "Que'er"
				},
				{
					"id": 413371009,
					"content": "Oh... Je n'irais pas jusqu'à dire qu'on se connaissait bien. Zhiruo était douée pour soigner les blessures. Tout le monde allait la voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371010
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413371010,
					"content": "Haha, maintenant que j'y pense, il y en avait sûrement beaucoup qui l'aimaient bien dans le clan.",
