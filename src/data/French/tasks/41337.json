					"nextDialogs": [
						413371013
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413371013,
					"content": "Cette Zhiruo et toi... Vous aviez quel genre de relation ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371014
					],
					"speakerTitle": "Que'er"
				},
				{
					"id": 413371014,
					"content": "Euh... Nous n'étions pas si proches que ça, vraiment. Plutôt des condisciples.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371015
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413371015,
					"content": "Oh... Alors toi et moi, quelle relation on a ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371016
					],
					"speakerTitle": "Que'er"
				},
				{
					"id": 413371016,
					"content": "Haha, mais on est frère et sœur de clan, bien sûr !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
