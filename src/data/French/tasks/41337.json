					"id": 413370912,
					"content": "Dites-lui... que Zhiruo lui souhaite un joyeux Festival des lanternes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370913
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370913,
					"content": "Moi aussi, je vous souhaite de passer un bon Festival des lanternes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370914
					]
				},
				{
					"id": 413370914,
					"content": "#Eh bien, merci. Soyez {M#prudent}{F#prudente} sur le chemin du retour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiruo"
				}
