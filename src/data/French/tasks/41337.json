					"nextDialogs": [
						413371011
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413371011,
					"content": "Et toi, grand frère ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371012
					],
					"speakerTitle": "Que'er"
				},
				{
					"id": 413371012,
					"content": "Oh, euh... Je...",
