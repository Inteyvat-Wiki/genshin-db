	"talks": [
		{
			"id": 4133702,
			"completionStepIds": [
				4133702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4133702",
							"2"
						],
						"stepId": 4133702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413370201,
					"content": "Si je lâche une lanterne dans les environs, peut-être les Adeptes la verront-ils ? Mais pour ce qui est des matériaux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370202
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370202,
					"content": "Que faites-vous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370203
					]
				},
				{
					"id": 413370203,
					"content": "Oh, veuillez m'excuser, nous étions en train d'envisager de lâcher une lanterne céleste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370204
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370204,
					"content": "Notre seul souci est que nous n'avons pas assez de matériaux à disposition...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370205
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370205,
					"content": "#{M#Mon bon ami}{F#Ma bonne amie}, seriez-vous d'accord pour...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370206
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370206,
					"content": "Et c'est reparti... Clan Guhua par-ci, Clan Guhua par là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370207
					],
					"speakerTitle": "Que'er"
				},
				{
					"id": 413370207,
					"content": "Le Festival des lanternes n'a lieu qu'une fois pas an, et tout ce à quoi tu penses c'est faire un vœu pour le Clan Guhua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370208
					],
					"speakerTitle": "Que'er"
				},
				{
					"id": 413370208,
					"content": "Ne sommes-nous pas tous deux des disciples du Clan Guhua ? C'est à nous qu'incombe la responsabilité de redonner au Clan Guhua sa gloire d'antan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370209
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370209,
					"content": "Si tu le dis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370210
					],
					"speakerTitle": "Que'er"
				},
				{
					"id": 413370210,
					"content": "#{M#Mon bon ami}{F#Ma bonne amie}, nous aideriez-vous à trouver les matériaux nécessaires à la confection de quelque lanterne céleste ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370211,
						413370213
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370211,
					"content": "Comptez sur moi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370212
					]
				},
				{
					"id": 413370212,
					"content": "Mille mercis !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370216
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370216,
					"content": "J'ai vérifié, et je pense qu'il ne nous manque qu'une fleur de Qingxin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370217
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370217,
					"content": "Celles que j'ai cueillies se sont fanées, et sont j'ai bien peur inutiles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370218
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370218,
					"content": "Ces fleurs peuvent servir à la fabrication de lanternes célestes ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370219
					]
				},
				{
					"id": 413370219,
					"content": "Haha, il s'agit d'une méthode unique mise au point avec les autres disciples du clan un jour que nous n'avions rien de mieux à faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370220
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370220,
					"content": "Il est si plaisant de ressentir cet arôme floral se dégager des lanternes célestes qui s'élancent dans les cieux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370221
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370221,
					"content": "Une fois que vous avez trouvé ce qu'il faut, revenez me voir. J'attendrai votre retour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370213,
					"content": "Votre condisciple semble avoir quelque chose à vous dire...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370214
					]
				},
				{
					"id": 413370214,
					"content": "Bah, ce n'est rien. Faisons comme Sun Yu dit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370215
					],
					"speakerTitle": "Que'er"
				},
				{
					"id": 413370215,
					"content": "*soupir* Petite sœur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370216
					],
					"speakerTitle": "Sun Yu"
				}
			]
		},
