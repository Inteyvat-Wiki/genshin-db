					"Zhiruo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413370701,
					"content": "Je me souviens, un de mes frères de clan m'a défiée à l'épée un jour qu'on lâchait la lanterne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370702
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370702,
					"content": "Je n'avais même pas encore acquiescé qu'une des sœurs du clan avait déjà versé de l'eau à ses pieds.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370703
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370703,
					"content": "Le sol s'est mis à glisser... Il n'a même pas eu le temps de tirer sa lame qu'il s'est retrouvé les fesses par terre. Comme j'ai ri... Tellement, d'ailleurs, que je suis tombée à mon tour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370704
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370704,
					"content": "Et au lieu de se mettre en colère, lui m'a simplement pointée du doigt en riant... Puis tout le monde a explosé de rire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370705
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370705,
					"content": "Je me demande bien ce qu'il est devenu, tiens...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiruo"
				}
			]
		},
