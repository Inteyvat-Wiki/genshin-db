			},
			"dialogs": [
				{
					"id": 413370801,
					"content": "J'ai aussi connu un garçon qui m'a redonné espoir dans le clan. Il était beau, courtois et d'un talent exceptionnel... On aurait pu penser qu'il serait l'élu qui raviverait la tradition...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370802
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370802,
					"content": "Mais il passait son temps à disparaître... *soupir* Je suppose que placer mes espoirs en lui était une erreur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370803
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370803,
					"content": "Mieux vaut oublier tout ça et ne pas s'attendre à son retour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiruo"
				}
			]
		},
