			"dialogs": [
				{
					"id": 700070801,
					"content": "À propos du bruit dans la bibliothèque...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070802
					]
				},
				{
					"id": 700070802,
					"content": "Je vois... On va devoir passer à la vitesse supérieure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070803
					],
					"speakerTitle": "Wyratt"
				},
				{
					"id": 700070803,
					"content": "Lisa a bien dit que tous ceux qui enfreignent les règles de la bibliothèque doivent en subir les conséquences...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070804
					],
					"speakerTitle": "Wyratt"
				},
				{
					"id": 700070804,
					"content": "Allez donc dire que ça vient de Lisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070805
					],
					"speakerTitle": "Wyratt"
				},
				{
					"id": 700070805,
					"content": "Corner des pages, mettre des roses dans des livres, les ranger à l'envers... Que des violations flagrantes des règles de la bibliothèque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070806,
					"content": "Allons-y. On doit transmettre l'avertissement de Lisa à tous ceux qui restent dans la bibliothèque sans lire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
