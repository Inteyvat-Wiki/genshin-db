			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ella Musk"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700070101,
					"content": "Ye ika gusha mosi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070102,
						700070103
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070102,
					"content": "Tu n'as pas l'air de bonne humeur...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070104
					]
				},
				{
					"id": 700070104,
					"content": "Désolée... C'est juste que la bibliothèque est plutôt bruyante ces jours-ci. Je ne peux pas étudier le Brutocollinus en paix.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070105
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070105,
					"content": "Une fois que la Fête des alizées commence, beaucoup de personnes se donnent rendez-vous ici. Au début, tout le monde se contentait de lire en silence, mais là ça discute, ça s'agite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070106
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070106,
					"content": "Et en plus... Ils ont fait tout un tas de choses horribles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070107
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070107,
					"content": "Corner des livres... Coller des trucs bizarres entre les pages... Et ils ont même rangé des livres à l'envers sur les étagères !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070108
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070108,
					"content": "Une bibliothèque n'est pas un lieu pour des escapades en amoureux ! Ça ne fait que perturber ceux qui lisent et font des recherches !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070109,
						700070111
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070109,
					"content": "C'est à Wyratt de maintenir l'ordre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070110
					]
				},
				{
					"id": 700070110,
					"content": "Que peut-il faire ? Faire partir tout le monde n'est qu'une solution temporaire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070113
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070113,
					"content": "C'est pourquoi j'ai besoin de ton aide. Il faudrait les convaincre de se calmer un peu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070114,
						700070115
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070114,
					"content": "Compte sur moi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070116
					]
				},
				{
					"id": 700070116,
					"content": "Merci. Tu vois ces trois couples là-bas ? Ce sont eux qui font le plus de bruit. Si tu peux leur faire comprendre à quel point c'est énervant, je pourrai continuer mes recherches en paix.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070117
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070117,
					"content": "Mais fais attention, ils ne sont pas vraiment coopératifs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070115,
					"content": "Je vais essayer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070116
					]
				},
				{
					"id": 700070111,
					"content": "Tu peux en parler à Lisa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070112
					]
				},
				{
					"id": 700070112,
					"content": "Mais j'ai entendu dire qu'elle était en patrouille avec la Grande Maîtresse suppléante. Si elle était là, ces couples ne se laisseraient pas aller comme ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070113
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070103,
					"content": "Tu fais encore plus peur que d'habitude...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070104
					]
				}
			]
		},
		{
			"id": 7000702,
			"completionStepIds": [
				7000702
