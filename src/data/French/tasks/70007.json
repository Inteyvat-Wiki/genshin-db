			"dialogs": [
				{
					"id": 700071001,
					"content": "Hein ! Quoi ? Lisa va bientôt revenir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700071002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700071002,
					"content": "Si elle apprend que des gens ne respectent pas les livres et les cornent, elle va être furax, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700071003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700071003,
					"content": "C'est vrai, il ne faut surtout pas la mettre en colère...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700071004
					]
				},
				{
					"id": 700071004,
					"content": "Qu'est-ce qu'on va bien pouvoir faire ? Oh ! Peut-être qu'on a encore le temps de tout ranger, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700071005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700071005,
					"content": "Voilà qui était très ingénieux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700071006
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700071006,
					"content": "C'est Wyratt qui en a eu l'idée.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700071007
					]
				},
				{
					"id": 700071007,
					"content": "La réputation de Lisa n'est plus à faire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700071008
					]
				},
				{
					"id": 700071008,
					"content": "Quand même, ça aurait rendu Lisa folle de voir la bibliothèque dans cet état. Une bibliothèque, c'est un lieu d'apprentissage après tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700071009
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700071009,
					"content": "Je peux enfin continuer mes recherches en paix. Tiens, je te donne ça pour te remercier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
