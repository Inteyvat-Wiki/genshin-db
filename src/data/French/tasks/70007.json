			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Homme plutôt rationnel",
					"Femme plutôt rationnelle"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700070401,
					"content": "Ton affirmation selon laquelle, je cite, « les fluctuations des émotions peuvent influencer l'exactitude des recherches et des analyses » ne repose sur aucun argument précis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070402
					],
					"speakerTitle": "Femme plutôt rationnelle"
				},
				{
					"id": 700070402,
					"content": "Ah, j'en suis bien conscient. Mes recherches se heurtent à un mur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070403
					],
					"speakerTitle": "Homme plutôt rationnel"
				},
				{
					"id": 700070403,
					"content": "Vous arrivez à point nommé. J'ai un petit souci qui nécessite un avis extérieur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070404
					],
					"speakerTitle": "Homme plutôt rationnel"
				},
				{
					"id": 700070404,
					"content": "Si je veux prouver la véracité de ma théorie, je dois contrôler mes émotions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070405
					],
					"speakerTitle": "Homme plutôt rationnel"
				},
				{
					"id": 700070405,
					"content": "Mais je n'y arriverai jamais... Surtout pas quand je discute avec elle. Je n'arrive pas à garder mon calme ou à réfléchir posément.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070406
					],
					"speakerTitle": "Homme plutôt rationnel"
				},
				{
					"id": 700070406,
					"content": "Moi aussi, je trouve ça étrange. Tu as bien dormi la nuit dernière ? Ou c'est à cause de ce qu'on a bu hier ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070407,
						700070408
					],
					"speakerTitle": "Femme plutôt rationnelle"
				},
				{
					"id": 700070407,
					"content": "Quoi qu'il en soi : vous ne devriez pas parler si fort dans la bibliothèque.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070408
					]
				},
				{
					"id": 700070408,
					"content": "Quoi qu'il en soit : mettez-la un peu en sourdine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070409
					]
				},
				{
					"id": 700070409,
					"content": "Désolé, mais je n'aurai pas l'esprit en paix tant que je n'aurai pas résolu cette énigme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070410
					],
					"speakerTitle": "Homme plutôt rationnel"
				},
				{
					"id": 700070410,
					"content": "Il... Il n'écoute rien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070411,
					"content": "Hé, de toute façon, vous n'avez pas à déranger tout le monde comme ça. Et arrêtez de mettre les livres à l'envers quand vous les rangez sur les étagères !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070412,
					"content": "Bon... On dirait qu'ils nous ignorent complètement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
