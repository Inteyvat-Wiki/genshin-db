			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jeune homme amoureux",
					"Jeune femme amoureuse"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700070201,
					"content": "C'est vraiment émouvant... Dommage que ça ne se termine pas bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070202
					],
					"speakerTitle": "Jeune homme amoureux"
				},
				{
					"id": 700070202,
					"content": "On ne va pas finir comme eux, hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070203
					],
					"speakerTitle": "Jeune femme amoureuse"
				},
				{
					"id": 700070203,
					"content": "Bien sûr que non. Si on était séparés chacun d'un côté du monde, je trouverais le moyen de te ramener à moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070204,
						700070205
					],
					"speakerTitle": "Jeune homme amoureux"
				},
				{
					"id": 700070204,
					"content": "Veuillez rester silencieux dans la bibliothèque.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070206
					]
				},
				{
					"id": 700070206,
					"content": "Hein ? Je parle à voix basse depuis tout à l'heure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070207
					],
					"speakerTitle": "Jeune femme amoureuse"
				},
				{
					"id": 700070207,
					"content": "Oh, un obstacle sur le chemin de notre amour...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070208
					],
					"speakerTitle": "Jeune homme amoureux"
				},
				{
					"id": 700070208,
					"content": "Il faut aussi ranger les livres dont vous n'avez plus besoin à leur place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070209,
					"content": "Regardez tous ces livres qui traînent. Pensez un peu à la personne qui devra tout ranger sur les étagères...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070210,
					"content": "D'accord, d'accord, compris. Vous ne pouvez pas nous laisser un peu tranquilles ? Vous arrivez vraiment au pire moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070211
					],
					"speakerTitle": "Jeune homme amoureux"
				},
				{
					"id": 700070211,
					"content": "« Au pire moment »...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070212,
					"content": "Peu importe les obstacles se dressant devant nous, promets-moi de rester comme tu es et de ne jamais changer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070213
					],
					"speakerTitle": "Jeune femme amoureuse"
				},
				{
					"id": 700070213,
					"content": "Je te le promets sur ma vie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070214
					],
					"speakerTitle": "Jeune homme amoureux"
				},
				{
					"id": 700070214,
					"content": "Non, ne dis pas ça... La simple idée de te perdre un jour me brise le cœur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070215
					],
					"speakerTitle": "Jeune femme amoureuse"
				},
				{
					"id": 700070215,
					"content": "Ah, ta douceur si enivrante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070216
					],
					"speakerTitle": "Jeune homme amoureux"
				},
				{
					"id": 700070216,
					"content": "C'est comme parler à un mur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070205,
					"content": "Plusieurs personnes se plaignent du bruit que vous faites.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070206
					]
				}
			]
		},
