			"trigger": {
				"objectNames": [
					"Illusioniste",
					"Femme béate d'admiration"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700070301,
					"content": "Hein ? Qu'est-ce que vous voulez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070302,
						700070303
					],
					"speakerTitle": "Femme béate d'admiration"
				},
				{
					"id": 700070302,
					"content": "Silence dans la bibliothèque.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070304
					]
				},
				{
					"id": 700070304,
					"content": "Désolée, je vais faire attention. C'est juste que c'est parfois plus fort que moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070305
					],
					"speakerTitle": "Femme béate d'admiration"
				},
				{
					"id": 700070305,
					"content": "Comme par exemple quand je trouve cette rose rien que pour toi dans les pages d'un livre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070306
					],
					"speakerTitle": "Illusioniste"
				},
				{
					"id": 700070306,
					"content": "Une rose tirée d'un livre et qui te ressemble : délicate et si intelligemment belle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070307
					],
					"speakerTitle": "Illusioniste"
				},
				{
					"id": 700070307,
					"content": "Oh... Trop fort !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070308
					],
					"speakerTitle": "Femme béate d'admiration"
				},
				{
					"id": 700070308,
					"content": "Vous faites trop de bruit ! Et puis, les livres ne sont pas des accessoires pour vos tours de passe-passe ! Vous allez les abîmer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070309,
					"content": "Euh, Paimon, évite de crier...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070310
					]
				},
				{
					"id": 700070310,
					"content": "Oh, désolée. Je n'ai pas fait exprès...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070311,
					"content": "Vous voyez, parfois c'est juste plus fort que soi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070312
					],
					"speakerTitle": "Femme béate d'admiration"
				},
				{
					"id": 700070312,
					"content": "Je vais faire attention maintenant. Je suis vraiment désolée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070313
					],
					"speakerTitle": "Femme béate d'admiration"
				},
				{
					"id": 700070313,
					"content": "Apparemment, c'est rentré dans une oreille et ressorti de l'autre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070303,
					"content": "Plusieurs personnes se plaignent du bruit que vous faites.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070304
					]
				}
			]
		},
		{
