			"dialogs": [
				{
					"id": 740121001,
					"content": "Tirer le levier...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740121002
					]
				},
				{
					"id": 740121002,
					"content": "#Ah ! {NICKNAME}, qu'est-ce que tu fais ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740121003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740121003,
					"content": "Vous tirez sur le levier sans aucune hésitation.\\nLa tour entière se met à trembler violemment et un bruit assourdissant se fait entendre. Comme si le ciel s'effondrait...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740121004
					]
				},
				{
					"id": 740121004,
					"content": "Enfin, la machine crache un tas de rubans de papier qui tombent directement dans vos mains.\\nLe silence revient...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740121005
					]
				},
				{
					"id": 740121005,
					"content": "C'est... C'est tout ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740121006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740121006,
					"content": "Hmm... Il est difficile de lire ce qu'il y a d'inscrit dessus, mais ça semble assez important...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740121007
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740121007,
					"content": "#{NICKNAME}, gardons ça pour le moment. Ce truc pourrait nous être utile par la suite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
