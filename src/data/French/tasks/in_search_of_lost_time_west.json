			"dialogs": [
				{
					"id": 740120501,
					"content": "Ouah, il est sévère ! Je n'aimerais pas travailler pour lui !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740120502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740120502,
					"content": "Quel culot de parler d'honneur collectif... Il n'y a pas d'honneur à affamer des gens !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740120503,
						740120505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740120503,
					"content": "Il y a une part de vérité dans ce qu'il dit...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740120504
					]
				},
				{
					"id": 740120505,
					"content": "C'est n'importe quoi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740120506
					]
				},
				{
					"id": 740120504,
					"content": "Euh... La discipline est importante... Mais il n'est pas nécessaire d'aller aussi loin, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740120507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740120506,
					"content": "Mais oui ! Les gens qui ne savent pas faire leur travail sont ceux qui ont une fixation bizarre sur les règles et la discipline...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740120507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740120507,
					"content": "Hein ? Alors... Si on frappe la marmite, peut-être qu'on pourra faire descendre le capitaine Shumilov...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740120508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740120508,
					"content": "#De cette façon, on pourra monter là-bas... Essayons, {NICKNAME} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
