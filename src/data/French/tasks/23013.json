				"points": []
			},
			"dialogs": [
				{
					"id": 230130201,
					"content": "Lutong, nos économies...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130202
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130202,
					"content": "On trouvera un moyen de s'en sortir, monsieur Garcia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130203
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130203,
					"content": "Il y a un vieux dicton à Liyue qui dit : « Quand on arrive au pied d'une montagne, il y a toujours un chemin. ». Je pense qu'il convient parfaitement à la situation actuelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130204
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130204,
					"content": "Ça veut dire que même si une montagne nous barre la route, il y a toujours un moyen de la franchir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130205
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130205,
					"content": "Ah, c'est une jolie métaphore. Ça me donne l'impression que la situation n'est pas si dramatique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130206
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130206,
					"content": "Monsieur Garcia, est-ce que vous pensez que la personne qui a écrit cette phrase a trouvé un moyen de franchir la montagne ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130207
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130207,
					"content": "Hein ? Oh non...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				}
			]
		},
		{
			"id": 2301303,
			"completionStepIds": [
				2301303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
