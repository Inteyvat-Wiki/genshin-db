			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Garcia",
					"Lutong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230130101,
					"content": "Mon cher Lutong, êtes-vous sûr que l'endroit que nous recherchons est bien ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130102
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130102,
					"content": "J'en suis sûr, monsieur Garcia. C'est là qu'il y a le plus souvent des Blobs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130103
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130103,
					"content": "Je n'ai aucun doute que c'est là que les Blobs se rassemblent, ce qui m'inquiète, c'est...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130104
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130104,
					"content": "... Vous ne trouvez pas qu'il y a trop de Blobs ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130105
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130105,
					"content": "Monsieur Garcia, c'est ce qui arrive quand on manque de fonds.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130106,
						230130107
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130106,
					"content": "Garcia ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230130108
					]
				},
				{
					"id": 230130108,
					"content": "#{M#Voyageur}{F#Voyageuse} ! Quelle chance de vous voir ici à Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130109
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130109,
					"content": "Qu'est-ce que vous faites ici ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230130110
					]
				},
				{
					"id": 230130110,
					"content": "Hahaha, je suis ici pour...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130111
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130111,
					"content": "... Chercher des ennuis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130112
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130112,
					"content": "... Vivre l'aventure. Merci, Lutong. Est-ce que vous pourriez juste...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130113
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130113,
					"content": "Comme vous voudrez, monsieur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130114
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130114,
					"content": "Bon, revenons-en au sujet. Je suis ici pour trouver de la bave de Blob pour fabriquer du lubrifiant pour mon Arithmétrice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130115
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130115,
					"content": "Mais d'une part, la bave de Blob vendue sur le marché est généralement de mauvaise qualité en raison de la durée de stockage. Et d'autre part...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130116
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130116,
					"content": "... Monsieur Garcia a acheté trop de livres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130117
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130117,
					"content": "... D'autre part, on a eu beaucoup de dépenses... de première nécessité ! Ce qui nous a laissés à court d'argent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130118
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130118,
					"content": "C'est pourquoi nous sommes ici pour essayer d'obtenir directement de la bave de Blob fraîche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130119
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130119,
					"content": "Mais comme vous pouvez le voir, mon cher Lutong, malgré ses origines liyuéennes, ne connaît ni les arts martiaux ni la cuisine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130120
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130120,
					"content": "Je m'y connais quand même en comptabilité avec les règles fiscales compliquées du Bureau des affaires civiles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130121
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130121,
					"content": "... Et moi, je ne peux quand même pas me permettre de taper quelqu'un avec les pièces de mon Arithmétrice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130122
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130122,
					"content": "Vous avez besoin d'un coup de main ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230130123
					]
				},
				{
					"id": 230130123,
					"content": "Dans un sens...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130124
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130124,
					"content": "Oui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130125
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130125,
					"content": "Lutong, est-ce que... euh, est-ce qu'on a encore de l'argent ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130126
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130126,
					"content": "#Après avoir payé {M#le voyageur}{F#la voyageuse}, je pense qu'on pourra encore trouver un moyen de survivre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130127
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130127,
					"content": "#Parfait ! {M#Voyageur}{F#Voyageuse}, s'il vous plaît, rapportez-moi de la bave de Blob, je vous en supplie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130107,
					"content": "Qu'est-ce qui vous amène ici ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230130108
					]
				}
			]
		},
		{
