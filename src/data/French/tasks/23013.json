			"dialogs": [
				{
					"id": 230135001,
					"content": "Monsieur, on dirait bien que c'est l'endroit que nous cherchions. Maintenant, il ne nous reste plus qu'à embaucher quelques personnes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135002
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135002,
					"content": "Monsieur ? Monsieur Garcia, est-ce que vous m'écoutez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135003
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135003,
					"content": "Hmm ? Euh... Bien sûr que je vous écoute. Eh bien, rentrons embaucher quelqu'un, cela ne devrait pas nous prendre trop de temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135004
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230135004,
					"content": "Ça... Ça va ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230135005
					]
				},
				{
					"id": 230135005,
					"content": "#Hahaha, ce n'est rien, {M#voyageur}{F#voyageuse}... Je vais très bien. Pourquoi pensez-vous le contraire, hmm ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135006
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230135006,
					"content": "Je me consacre en ce moment corps et âme à mes recherches pour l'Arithmétrice, et je sens que je ne suis plus qu'à un pas du succès.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135007
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230135007,
					"content": "Si ça ne vous dérange pas, pourriez-vous m'amener un peu de bave de Blob ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135008
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230135008,
					"content": "Je n'ai plus besoin de m'embêter à rentrer en ville pour embaucher quelqu'un puisque vous êtes là. Et puis, je vais pouvoir vous offrir une plus grosse récompense comme je viens de gagner un peu d'argent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135009,
						230135010
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230135009,
					"content": "Comptez sur moi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230135011
					]
				},
				{
					"id": 230135011,
					"content": "#Bien, alors je compte sur vous, {M#voyageur}{F#voyageuse}. Je dois encore réfléchir à la manière dont je dois modifier la structure de l'Arithmétrice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230135010,
					"content": "Ce n'est pas un problème...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230135011
					]
				}
			]
		},
