				{
					"id": 230135201,
					"content": "#{M#Voyageur}{F#Voyageuse}, vous avez trouvé de la bave de Blob ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135202
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230135202,
					"content": "Et voici.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230135203
					]
				},
				{
					"id": 230135203,
					"content": "#Très bien, cela suffira. Lutong, pouvez-vous d'abord donner la récompense {M#au voyageur}{F#à la voyageuse} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135204
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230135204,
					"content": "Je vais jeter un œil à la qualité de ces baves de Blob...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135205
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230135205,
					"content": "#Voici votre récompense. Encore merci pour votre aide, {M#voyageur}{F#voyageuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135206
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135206,
					"content": "Repassez donc nous voir quand vous aurez le temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135207
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135207,
					"content": "J'aurai peut-être besoin d'un coup de main, si l'état psychologique de monsieur Garcia se dégrade.",
