			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Garcia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230130301,
					"content": "#{M#Voyageur}{F#Voyageuse}, vous avez trouvé de la bave de Blob ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130302
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130302,
					"content": "Oui, la voilà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230130303
					]
				},
				{
					"id": 230130303,
					"content": "Super ! Ça devrait suffire. Je vais pouvoir commencer les essais à mon retour. Avec ce lubrifiant, mon Arithmétrice devrait pouvoir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130304
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130304,
					"content": "Je dois retourner à mes recherches. Lutong, je vous laisse vous occuper du reste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130305
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130305,
					"content": "Oui, monsieur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130306
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130306,
					"content": "#{M#Voyageur}{F#Voyageuse}, veuillez accepter cette récompense. Merci beaucoup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130307
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130307,
					"content": "Et euh... À mon avis, on pourrait avoir besoin de votre aide plus tard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130308
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130308,
					"content": "Ne vous inquiétez pas, tant que je suis en charge de la comptabilité, vous recevrez une rémunération raisonnable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130309
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130309,
					"content": "... *soupir* La raison pour laquelle je voyage avec monsieur Garcia est que je ne veux pas passer toute ma vie à faire des comptes dans un département du Bureau des affaires civiles de Liyue, comme mes parents.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130310
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130310,
					"content": "Mais maintenant... En plus d'aider monsieur Garcia dans ses calculs, je suis obligé de m'occuper de ses comptes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130311
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130311,
					"content": "C'est peut-être le destin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				}
			]
		},
		{
