			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lutong",
					"Garcia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230131101,
					"content": "Monsieur Garcia, encore une fois, je vous suggère sincèrement de vendre quelques livres pour récolter des fonds.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131102
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230131102,
					"content": "Mais non ! Pas question ! Cher Lutong, vous me demandez de vendre mon âme !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131103
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131103,
					"content": "Mais monsieur, le problème en fait est que personne ne voudrait payer pour votre âme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131104,
						230131105
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230131104,
					"content": "Qu'est-ce que vous faites encore ici ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230131106
					]
				},
				{
					"id": 230131106,
					"content": "#{M#Voyageur}{F#Voyageuse} ? Qu'est-ce qui vous amène ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131107
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131107,
					"content": "Euh... Mon dernier essai a échoué, j'ai eu un problème avec la dilution de la bave de Blob...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131108
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131108,
					"content": "Au lieu de lubrifier les roulements de l'Arithmétrice, le lubrifiant que j'ai fabriqué les faisait se gripper encore plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131109
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131109,
					"content": "Alors, j'ai besoin de plus de bave de Blob pour mes expériences. Pouvez-vous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131110,
						230131111
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131110,
					"content": "Je m'en occupe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230131120
					]
				},
				{
					"id": 230131120,
					"content": "#{M#Voyageur}{F#Voyageuse}, s'il vous plaît, apportez-moi de la bave de Blob. Je vous donnerai une bonne récompense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230131111,
					"content": "Vous n'avez aucun moyen de gagner de l'argent ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230131112
					]
				},
				{
					"id": 230131112,
					"content": "Ce n'est pas que nous n'avons aucun moyen de gagner de l'argent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131113
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131113,
					"content": "... C'est que nous n'avons pas la capacité de gagner de l'argent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131114
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230131114,
					"content": "Merci pour la précision, Lutong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131115
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131115,
					"content": "Hélas, c'est un peu gênant à admettre... J'ai dit que j'avais construit une Arithmétrice, mais cette machine est assez limitée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131116
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131116,
					"content": "En fait, cette machine ne peut même pas faire le calcul de manière totalement autonome. Je dois faire beaucoup de travail manuel pour l'aider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131117
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131117,
					"content": "Mais bien sûr... Je vais la perfectionner ! Je suis intimement convaincu que mon Arithmétrice sera une grande invention !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131118
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131118,
					"content": "Une... Une invention qui fera date dans l'histoire ! Et après, je suis sûr que je trouverai un moyen de gagner de l'argent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131119
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131119,
					"content": "M—Mais avant ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131120
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131105,
					"content": "Vous avez encore besoin de bave de Blob ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230131106
					]
				}
			]
		},
