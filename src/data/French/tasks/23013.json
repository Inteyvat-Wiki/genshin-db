			"dialogs": [
				{
					"id": 230135101,
					"content": "#{M#Voyageur}{F#Voyageuse}, vous tombez vraiment bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135102,
						230135103
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135102,
					"content": "Garcia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230135104
					]
				},
				{
					"id": 230135104,
					"content": "Évidemment que c'est à cause de mademoiselle Kaia. Monsieur Garcia n'en parle pas, mais il est de plus en plus distrait dans son travail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135105
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135105,
					"content": "Et puis, il ne va plus à ce café. À chaque fois, c'est moi qu'il envoie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135106
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135106,
					"content": "Même monsieur Ahangar m'a dit qu'il pouvait parler avec monsieur Garcia si c'était nécessaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135107
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135107,
					"content": "Je ne sais pas non plus comment aider monsieur Garcia à s'en sortir. Après tout, je n'ai aucune expérience en la matière.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135108
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135108,
					"content": "*soupir* On dirait bien qu'un fossé de plus me sépare de monsieur Garcia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135103,
					"content": "Son comportement, c'est à cause de...",
