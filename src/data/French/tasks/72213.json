			"trigger": {
				"objectNames": [
					"Neko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722130101,
					"content": "« Raie mue née ration »...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130102,
					"content": "Où en est la statue ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130103
					]
				},
				{
					"id": 722130103,
					"content": "Cet humain sculpteur de pierre est fort doué, miaou miaou miaou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130104,
					"content": "La statue est terminée ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130105
					]
				},
				{
					"id": 722130105,
					"content": "Pas encore, mais à peine j'avais tourné la tête qu'il avait ramené une énorme pierre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130106
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130106,
					"content": "Puis, il a commencé à la frapper, toc-toc, bam-bam, en marmonnant à propos d'« envoyeur » et d'« énumération ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130107
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130107,
					"content": "Que veulent dire « envoyeur » et « énumération » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130108
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130108,
					"content": "C'est « employeur » et « rémunération ».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130109
					]
				},
				{
					"id": 722130109,
					"content": "Pour faire simple : vous lui avez demandé un service, alors il faut le payer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722130110,
					"content": "Ah bon ? Les humains se préoccupent de ce genre de choses... Très bien, il aura le droit de me caresser les oreilles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130111
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130111,
					"content": "Euh, je crois que ça ne sera pas assez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722130112,
					"content": "Oh ? Dans ce cas-là, je vais lui donner à manger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130113
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130113,
					"content": "Je pense qu'il veut des moras...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130114
					]
				},
				{
					"id": 722130114,
					"content": "Des moras ? Ces pièces ne sont pas seulement faites pour remplir la boîte à offrandes ? Bizarre, je ne pensais pas que les humains aimaient ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130115
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130115,
					"content": "C'est important de rémunérer les gens pour leurs services rendus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130116
					]
				},
				{
					"id": 722130116,
					"content": "Hmpf. Je vous fais confiance, étant donné toute l'aide que vous m'avez apportée. Je parlerai à l'humain sculpteur de pierre quand il reviendra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130117
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130117,
					"content": "Mais il a arrêté de toc-toc, bam-bam. On dirait qu'il a un bâton en bois dans les mains, je ne sais pas pourquoi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130118
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130118,
					"content": "Un bâton en bois ? D'habitude, on sculpte avec un marteau et un burin, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722130119,
					"content": "Il a peut-être cassé ses outils...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130120
					]
				},
				{
					"id": 722130120,
					"content": "#{NICKNAME}, retrouvons monsieur Ooshima. On pourra l'aider !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
