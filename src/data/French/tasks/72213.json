			"trigger": {
				"objectNames": [
					"Ooshima Junpei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722130501,
					"content": "Superbe ! Je pense que ça ira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130502
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130502,
					"content": "Je vais trouver un endroit convenable pour installer un fourneau et commencer la fabrication de mes outils.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130503
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130503,
					"content": "Allez en informer madame la grande prêtresse suppléante, s'il vous plaît. Je vais ranger un peu ici pendant ce temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				}
			]
		},
		{
			"id": 7221306,
			"completionStepIds": [
				7221304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221304",
							"2"
						],
						"stepId": 7221304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Neko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722130601,
					"content": "Miaou miaou miaou, qu'y a-t-il ? Ne vous inquiétez pas, je suis en train de préparer une généreuse « énumération ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130602,
						722130603
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130602,
					"content": "« Rémunération ».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130605
					]
				},
				{
					"id": 722130605,
					"content": "Bon, peu importe. Hum, les outils de l'humain sculpteur de pierre... Monsieur Ooshima se sont cassés et on lui a donné les matériaux nécessaires pour les réparer. Il ne devrait plus y avoir de problèmes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722130606,
					"content": "Mmh ? Des problèmes, vous dites ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130607,
						722130608
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130607,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130609
					]
				},
				{
					"id": 722130609,
					"content": "Tant mieux. J'ai hâte de voir à quoi cette pierre va ressembler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130610
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130610,
					"content": "Hibiki a dit que de bonnes choses se produiraient une fois que cette pierre à mon image serait faite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130611
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130611,
					"content": "Ah, j'ai vraiment hâte ! Quel genre de bonnes choses arriveront ? Si ça se trouve, Hibiki reviendra enfin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130608,
					"content": "Non, il n'y a aucun problème. Tout va bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130609
					]
				},
				{
					"id": 722130603,
					"content": "Combien de moras ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130604
					]
				},
				{
					"id": 722130604,
					"content": "Comment ça « combien » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130605
					],
					"speakerTitle": "Neko"
				}
			]
		}
	]
