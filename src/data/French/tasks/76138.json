				]
			},
			"dialogs": [
				{
					"id": 761380201,
					"content": "Dame Nefer ? Et monsieur Zompaynco. Que puis-je faire pour vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380202
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761380202,
					"content": "Notre invité natlanois voulait rendre visite aux Descendants de givrelune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380203
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380203,
					"content": "Mais pour des raisons de politesse, il a préféré demander à quelqu'un de le présenter. La parole est à vous, monsieur Zompaynco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380204
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380204,
					"content": "B—Bonjour mademoiselle Lyylikki ! C'est un plaisir de vous rencontrer. Euh, j'ai apporté ce fossile de Natlan et...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380205
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380205,
					"content": "Merci, monsieur Zompaynco... Hmm, mais on s'est déjà rencontrés, non ? Vous n'avez pas besoin de faire autant de manières.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380206
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761380206,
					"content": "Hein ? Comment m'avez-vous remarqué ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380207
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380207,
					"content": "Vous étiez toujours là quand je distribuais les repas, non ? Vous vous promeniez près de la queue, mais vous ne la faisiez jamais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380208
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761380208,
					"content": "Je pensais que vous vouliez une part, mais que vous étiez trop timide. Du coup, je vous en mettais toujours une de côté.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380209
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761380209,
					"content": "Mais vous n'êtes jamais venu les récupérer. Si vous n'étiez pas venu aujourd'hui, j'aurais demandé à quelqu'un d'aller voir si vous n'avez pas besoin d'aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380210
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761380210,
					"content": "Ah... D—Désolé, je ne savais pas trop comment vous aborder...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380211
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380211,
					"content": "Hum, mademoiselle Lyylikki... Pourrais-je rendre visite aux Descendants de givrelune ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380212
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380212,
					"content": "Bien sûr. Nous avons accueilli quelques invités de l'extérieur par le passé, mais pourquoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380213
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761380213,
					"content": "J'aimerais prendre des photos et des notes, consulter des archives, et si possible... poser des questions sur les légendes locales !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380214
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380214,
					"content": "Je fais partie de l'Association des reliques sauriennes de Natlan. Ce serait génial si je pouvais trouver des ressources en lien avec mes recherches.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380215
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380215,
					"content": "Je vois... Vous souhaitez consulter nos archives ? Laissez-moi réfléchir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380216
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761380216,
					"content": "Maintenant que vous avez fait connaissance, vous n'avez plus besoin de moi. Je vous laisse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380217
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380217,
					"content": "Merci, dame Nefer ! Je dois quand même vous rémunérer pour votre service. Ce ne serait pas correct de ma part sinon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380218
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380218,
					"content": "Comme vous le souhaitez, monsieur Zompaynco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380219
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380219,
					"content": "J'y vais. Passez une agréable journée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nefer"
				}
			]
		}
	]
}