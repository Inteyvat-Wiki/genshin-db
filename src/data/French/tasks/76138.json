			"dialogs": [
				{
					"id": 761380101,
					"content": "Dame Nefer ! Quelle coïncidence, vous tombez bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380102
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380102,
					"content": "Vous vous êtes décidé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380103
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380103,
					"content": "Pardon ? C'est-à-dire ? Vous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380104
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380104,
					"content": "Je sais que vous avez toujours voulu rendre visite aux Descendants de givrelune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380105
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380105,
					"content": "Vous espérez faire la connaissance de Lyylikki et de vous servir de votre amitié pour avoir un accès aux Descendants de givrelune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380106
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380106,
					"content": "Vous... Vous le saviez depuis le début ? Pourtant, je l'avais gardé pour moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380107
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380107,
					"content": "Monsieur Zompaynco, lorsque vous gardez un secret, il faut aussi cacher le fait que vous en gardez un.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380108
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380108,
					"content": "Sinon, le vent trouvera les failles du mur que vous avez érigé, peu importe sa hauteur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380109
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380109,
					"content": "*soupir* Je n'ai jamais été doué pour cacher mes pensées, même quand j'étais encore dans ma ville natale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380110
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380110,
					"content": "Maintenant que vous le savez, pourriez-vous me présenter ? Je ne suis pas d'ici et je ne veux pas déranger mademoiselle Lyylikki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380111
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380111,
					"content": "Soyez rassuré. Les Descendants de givrelune sont gentils. Que vous soyez un étranger ou que vous ayez une forme pas tout à fait humaine, ils vous réserveront un accueil chaleureux et courtois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380112
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380112,
					"content": "Hein ? Ah bon ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380113
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380113,
					"content": "Mais ça ne reste pas convenable de débarquer comme ça. Pourriez-vous me présenter, dame Nefer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380114
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380114,
					"content": "Très bien. Ils devraient avoir fini de distribuer les repas à l'heure qu'il est. C'est le moment idéal pour discuter. Allons-y.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380115
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380115,
					"content": "Je ne vous facturerai pas ce service. Je ne faisais que passer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380116
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380116,
					"content": "Merci beaucoup ! Je vais prendre mes affaires !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zompaynco"
				}
			]
		},
