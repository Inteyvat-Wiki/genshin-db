			"dialogs": [
				{
					"id": 760580101,
					"content": "Je n'ai jamais vu une belette voleuse aussi blanche. Tu crois qu'elle serait malade ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580102
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 760580102,
					"content": "T'as vu comment elle sautait ? Elle a même essayé de piquer de la nourriture à Jurva. Une belette malade ne ferait pas ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580103
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 760580103,
					"content": "Peut-être qu'elle appartient à une espèce rare. Linnea devrait savoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580104
					],
					"speakerTitle": "Jurva"
				},
				{
					"id": 760580104,
					"content": "Ouah ! C'est la voleuse de moras qui m'a dérobé ma petite réserve secrète !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760580105,
					"content": "La belette voleuse essaie de s'enfuir, mais les trois enfants sont plus rapides qu'elle et la plaquent au sol. Après avoir tenté de se débattre, elle abandonne. Vous en profitez pour expliquer ce qui s'est passé...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760580106
					]
				},
				{
					"id": 760580106,
					"content": "Ce n'est donc pas la première fois ? Dans ce cas, il faut lui donner une leçon ! On doit être puni quand on fait quelque chose de mal, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580107
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 760580107,
					"content": "Oui, mais... ce n'est qu'un animal. Il ne comprend rien de tout ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580108,
						760580109
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 760580108,
					"content": "Rends les moras de Paimon, et on sera quittes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760580110
					]
				},
				{
					"id": 760580110,
					"content": "Bref, rendons les moras à Paimon. Ce n'est pas comme si la belette pouvait les dépenser, alors ils devraient toujours être sur elle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580111
					],
					"speakerTitle": "Jurva"
				},
				{
					"id": 760580111,
					"content": "Ouais ! Ma petite réserve secrète est de retour !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760580112,
					"content": "J'aurais aimé pouvoir la garder jusqu'au retour de Helka, pour lui montrer une belette voleuse rare !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580113
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 760580113,
					"content": "Hein ? Mais elle ne travaille même pas... Le vol, ça ne compte pas ! Pourquoi devrait-on la nourrir gratuitement ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580114
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 760580114,
					"content": "D'accord, d'accord... mais qu'est-ce qu'on en fait ? Parlons-en à Katya plus tard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jurva"
				},
				{
					"id": 760580109,
					"content": "Même les animaux devraient comprendre la cruauté du monde...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760580110
					]
				}
			]
		}
	]
}