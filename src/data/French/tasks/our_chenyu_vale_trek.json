						"rawParams": [
							"7111007",
							"2"
						],
						"stepId": 7111007,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_ITEM_GIVING_ACTIVED",
						"rawParams": [
							"7111007"
