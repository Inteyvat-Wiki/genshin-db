			"dialogs": [
				{
					"id": 711101101,
					"content": "Hé, petite. Ce pélican est-il à toi ? Est-ce qu'on pourrait le prendre en photo avec le Village de Qiaoying ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101102,
					"content": "Hi hi ! Hi hi ang ang hi hi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101103
					],
					"speakerTitle": "Mingjing"
				},
				{
					"id": 711101103,
					"content": "Hein ? Qu'est-ce que tu racontes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101104,
					"content": "C'est du pélican, ça veut dire « Super, super ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101105
					],
					"speakerTitle": "Mingjing"
				},
				{
					"id": 711101105,
					"content": "Tu parles le pélican ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711101106
					]
				},
				{
					"id": 711101106,
					"content": "Juste un petit peu... J'ai remarqué qu'ils disaient toujours « Hi Hi ! » quand ils mangeaient. ... « Hi hi ! Hi hi ang ang hi hi ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101107
					],
					"speakerTitle": "Mingjing"
				},
				{
					"id": 711101107,
					"content": "Ça doit vouloir dire « Super, super ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101108
					],
					"speakerTitle": "Mingjing"
				},
				{
					"id": 711101108,
					"content": "Je les appelle donc comme ça désormais. Lorsqu'ils m'entendent, ils pensent certainement qu'il y a quelque chose à manger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101109
					],
					"speakerTitle": "Mingjing"
				},
				{
					"id": 711101109,
					"content": "Si vous voulez les prendre en photo, vous pouvez essayer de les appeler de cette façon ! C'est dommage, je dois rentrer à la maison. Sinon, je vous en aurais appris davantage !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101110
					],
					"speakerTitle": "Mingjing"
				},
				{
					"id": 711101110,
					"content": "Pas de problème, petite. Nous allons nous débrouiller. Merci, et rentre bien !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101111,
					"content": "#{NICKNAME}, allons essayer là-bas ! Si nous attirons vraiment un pélican, nous aurons une bien meilleure chance de gagner !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
