			"dialogs": [
				{
					"id": 711100101,
					"content": "#Êtes-vous ici pour participer au concours de photographie de paysages «{NON_BREAK_SPACE}Randonnée à Chenyu » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100102
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100102,
					"content": "Un concours de photographie de paysages ? De quoi s'agit-il ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100103,
					"content": "Comme son nom l'indique, il s'agit d'un concours de photographie visant à promouvoir les magnifiques paysages du Vallon Chenyu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100104
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100104,
					"content": "Nous avons demandé aux locaux de nous dire quels étaient leurs paysages préférés de la région. Les participants au concours sont maintenant invités à s'y rendre pour les immortaliser avec leur Daguerréotype.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100105
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100105,
					"content": "Une sélection des meilleurs clichés sera alors utilisée à des fins publicitaires. Ces clichés seront exposés au public lors d'un vernissage dans la rue du Poste Hezhe. Alors, ça vous dit ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100106,
						711100108
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100106,
					"content": "Je suis très pragmatique, qu'y a-t-il à gagner ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100107
					]
				},
				{
					"id": 711100107,
					"content": "#Si votre travail est sélectionné, vous serez évidemment {M#récompensé}{F#récompensée}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100110
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100110,
					"content": "Une surprise ? Waouh ! Il va falloir qu'on se donne à fond !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100111,
					"content": "#Haha, donc même si vous n'êtes pas {M#repris}{F#reprises} pour la sélection finale, nous avons préparé une petite récompense pour votre temps et vos efforts. Nous espérons qu'elle vous plaira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100112
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100112,
					"content": "#Et par où devrions-nous commencer{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100113
					]
				},
				{
					"id": 711100113,
					"content": "Prenez ce guide. Il reprend tous les paysages sélectionnés par les habitants du Vallon Chenyu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100115
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100115,
					"content": "Pourquoi certains d'entre eux sont barrés ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100116,
					"content": "Haha, car suffisamment de personnes se sont déjà inscrites pour ces lieux. Nous aimerions présenter le Vallon Chenyu de la manière la plus exhaustive possible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100117
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100117,
					"content": "Vous pouvez toujours vous inscrire pour les quatre emplacements restants. Vous pouvez en choisir un ou plusieurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100118
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100118,
					"content": "#Ah ! ... {NICKNAME}, nous ferions mieux de nous inscrire pour les quatre qui restent{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100119,
					"content": "Si nous avons une chance sur quatre de gagner, et que nous prenons quatre photos, à nous la surprise !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100120,
						711100123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100120,
					"content": "Ce n'est pas comme ça que fonctionnent les probabilités !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100121
					]
				},
				{
					"id": 711100121,
					"content": "Ah bon ? Mais quatre fois un quart font quatre quarts !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100122,
					"content": "Alors oui, mais...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100124
					]
				},
				{
					"id": 711100124,
					"content": "Haha, qu'est-ce qu'on attend alors ?! Allons-y sans plus attendre ! La surprise nous attend !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100123,
					"content": "Tu dois avoir raison.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100124
					]
				},
				{
					"id": 711100108,
					"content": "Très bien, personne ne peut prendre de meilleures photos que moi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100109
					]
				},
				{
					"id": 711100109,
					"content": "Vous ne manquez pas d'enthousiasme. Oh, et si ce que vous nous soumettez est présélectionné, nous avons également une surprise pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100110
					],
					"speakerTitle": "Fangju"
				}
			]
		},
