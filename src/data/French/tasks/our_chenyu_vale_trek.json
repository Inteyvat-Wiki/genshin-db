				"objectNames": [
					"Mali"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711100201,
					"content": "#Bonjour {M#cher ami}{F#chère amie}. Vous êtes aussi ici pour participer au concours de photographie de paysages ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100202
					],
					"speakerTitle": "Mali"
				},
				{
					"id": 711100202,
					"content": "En tant que photographe originaire de la nation qui a vu naître le Daguerréotype, Fontaine, laissez-moi vous rappeler que le plus important en photographie, c'est le Daguerréotype.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100203
					],
					"speakerTitle": "Mali"
				},
				{
					"id": 711100203,
					"content": "C'est pourquoi je veux vous présenter quelqu'un. À Fontaine, ses Daguerréotypes sont appréciés de tous. Ils sont abordables, et je sais comment m'en procurer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100204
					],
					"speakerTitle": "Mali"
				},
				{
					"id": 711100204,
					"content": "Hé... Ne faites pas cette tête désintéressée. Je vais demander une réduction supplémentaire, rien que pour vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100205
					],
					"speakerTitle": "Mali"
				},
				{
					"id": 711100205,
					"content": "Hé... ne partez pas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mali"
				}
			]
		},
