			"dialogs": [
				{
					"id": 711100801,
					"content": "Hmm... ces photos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100802
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100802,
					"content": "Qu'y a-t-il ? Elles ne sont pas assez bonnes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100803,
					"content": "Haha, au contraire... J'ai vu beaucoup de bonnes photos ces derniers jours, mais les vôtres sont différentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100805
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100805,
					"content": "Par exemple, cette photo du Village de Qiaoying. Le pélican donne une touche de vie au paisible village ce qui crée un contraste très intéressant. Une composition unique !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100806
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100806,
					"content": "Si ça ne tenait qu'à moi, votre travail serait sélectionné à tous les coups.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100807
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100807,
					"content": "Waouh ! Quel compliment ! Vous me faites un peu rougir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100808,
						711100810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100808,
					"content": "Pourquoi tu rougis ? Ce n'est pas toi qui as pris la photo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100809
					]
				},
				{
					"id": 711100809,
					"content": "Je suis flattée pour toi ! Je sais que tu es bien trop modeste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100811,
					"content": "Enfin, le processus de sélection sera terminé avant demain matin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100812
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100812,
					"content": "Ensuite, de huit à dix-huit heures, les photos sélectionnées seront exposées dans la rue du Poste Hezhe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100813
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100813,
					"content": "#Merci à {M#tous}{F#toutes} les deux pour votre participation au concours de photographie de paysages. N'oubliez pas de revenir demain !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100814
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100814,
					"content": "Nous n'allons pas manquer ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100810,
					"content": "Vu sous cet angle, c'est vrai que c'est flatteur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100811
					]
				}
			]
		},
