			"dialogs": [
				{
					"id": 711101001,
					"content": "Ah, vous voilà !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101002
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711101002,
					"content": "Avez-vous vu l'exposition ? Huit photos ont été sélectionnées pour cette édition de Randonnée à Chenyu, et la moitié d'entre elles sont les vôtres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101003
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711101003,
					"content": "Félicitations !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101004
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711101004,
					"content": "Waouh, c'est super !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101005,
					"content": "#Tu vois, {NICKNAME}! Quatre quarts, comme je l'avais dit ! Je suis vraiment douée avec les chiffres !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101006,
						711101007
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101006,
					"content": "C'est plutôt quatre huitièmes, en fait.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711101008
					]
				},
				{
					"id": 711101008,
					"content": "Haha, comme je m'y attendais, le jury a également beaucoup aimé vos autres clichés !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101009
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711101009,
					"content": "Je vous offre cet album « Randonnée à Chenyu » en édition limitée. Il inclut toutes les photos primées de cette édition. Vous le méritez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101010
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711101010,
					"content": "Alors c'est ça, la surprise ? Ça a l'air magnifique !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101011,
					"content": "Veuillez aussi accepter ces moras. Merci encore d'avoir participé, cette fois de ma part personnellement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101012
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711101012,
					"content": "C'est mon village natal, et vous en avez immortalisé la beauté sur des clichés qui lui permettront de séduire de nombreuses autres personnes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101013
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711101013,
					"content": "Merci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711101007,
					"content": "Waouh ! Les mathématiques sont vraiment ton point fort !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711101008
					]
				}
			]
