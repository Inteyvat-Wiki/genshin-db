					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fangju"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711100701,
					"content": "À en juger par l'expression détendue sur votre visage, vous êtes définitivement là pour soumettre des chefs-d'œuvre à notre concours, n'est-ce pas ? Vous pouvez simplement me les remettre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100702
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100702,
					"content": "Ah, pas mal du tout. Ça a dû vous demander beaucoup de patience pour capturer d'aussi beaux clichés. Bravo !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fangju"
				}
			]
		},
		{
