			},
			"dialogs": [
				{
					"id": 711101301,
					"content": "#Attendez ! N'approchez pas ! V—Vous êtes des gens respectables, n'est-ce pas{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101302
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101302,
					"content": "Hein ? Nous venons tout juste de vous sauver ! Vous vous êtes cogné la tête...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101303,
					"content": "Oh ! C'est vrai... je suis vraiment désolé. Jusqu'ici, cette édition de Randonnée à Chenyu n'a été synonyme que de malchance pour moi... M—Merci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101304
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101304,
					"content": "Vous participez également au concours de photographie de paysages ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711101305
					]
				},
				{
					"id": 711101305,
					"content": "Quoi, vous aussi ?! Quelle coïncidence ! Mais pour tout vous dire, je ne suis qu'un simple voyageur... Je n'ai tout simplement aucune chance contre ces Brutocollinus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101306
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101306,
					"content": "Je les ai croisés sur la route et ils m'ont traîné jusqu'ici sans aucune explication. Est-ce que les Brutocollinus exigent un droit de passage, maintenant ? C'est n'importe quoi ! ... J'ai eu de la chance de tomber sur vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101307
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101307,
					"content": "On dirait que ce n'était vraiment pas votre jour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101308,
					"content": "Pas seulement aujourd'hui ! Hier aussi, j'ai été extrêmement malchanceux. J'ai acheté un Daguerréotype au prix fort auprès d'un revendeur de Fontaine. Mais à peine avais-je pris quelques photos que l'appareil s'est cassé. Je suis donc retourné voir le vendeur, mais il n'y avait aucune trace de lui nulle part.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101309
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101309,
					"content": "Un commerçant sans aucuns scrupules... Vous devez faire attention à votre argent quand vous êtes en déplacement !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101310
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101310,
					"content": "Pardon, je digresse. Si vous participez également au concours, je suppose que vous êtes là pour prendre des photos du Mont Xuanlian, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101311
					],
