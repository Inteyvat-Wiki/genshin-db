			},
			"dialogs": [
				{
					"id": 711100301,
					"content": "#Bonjour, jeune {M#ami}{F#amie}, vous avez beaucoup voyagé à travers Teyvat. Vous avez dû avoir la chance d'admirer de nombreux paysages, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100302
					],
					"speakerTitle": "Zhuchun"
				},
				{
					"id": 711100302,
					"content": "Je me demande si les paysages sélectionnés pour ce concours pourront rivaliser avec ceux que vous avez vus ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhuchun"
				}
			]
		},
		{
			"id": 7111007,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
