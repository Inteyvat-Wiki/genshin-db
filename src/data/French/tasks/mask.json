				"points": []
			},
			"dialogs": [
				{
					"id": 191823901,
					"content": "(Le nom de Mérieux apparaît dans certaines coupures de presse antérieures, mais principalement dans les articles évoquant « une série de réceptions chaleureuses pour une forme d'art expérimentale » et des « sièges vides lors de performances d'avant-garde malgré les éloges de la critique »...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191823902
					],
					"speakerTitle": "Notes d'enquête"
				},
				{
					"id": 191823902,
					"content": "(Ces dernières années, de nombreuses critiques sont parues décrivant Mérieux comme un metteur en scène visionnaire, l'un des metteurs en scène les plus marquants de son époque...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191823903
					],
					"speakerTitle": "Notes d'enquête"
				},
				{
					"id": 191823903,
					"content": "(Les articles sont rédigés par divers experts dans des domaines variés. Corentin et Amaury sont les plus prolifiques d'entre eux.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Notes d'enquête"
				}
			]
