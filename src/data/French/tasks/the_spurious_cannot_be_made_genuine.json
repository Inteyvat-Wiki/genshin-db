						],
						"pointId": 13574
					}
				]
			},
			"dialogs": [
				{
					"id": 760470201,
					"content": "#Oh, mais ce sont nos {M#habitués}{F#habituées} ! Vous êtes {M#revenus}{F#revenues} acheter des coupons ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470202
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 760470202,
					"content": "Un petit oiseau m'a dit que vos coupons d'investissement étaient une arnaque...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760470203
					]
				},
				{
					"id": 760470203,
					"content": "#Sérieusement ? Vous êtes {M#sûrs}{F#sûres} que vous ne vous faites pas des idées parce que vous n'arrêtez pas de perdre dernièrement ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470204
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 760470204,
					"content": "Une entreprise qui ne fait que gagner de l'argent sans en perdre, ça n'existe pas dans ce monde. Certains gagnent, d'autres perdent. Quand j'étais à la Ville de Sumeru... Ahem, j'ai été malchanceux pendant un moment, mais on ne sait jamais quand ça changera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470205
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 760470205,
					"content": "Seuls ceux qui persistent arrivent à saisir l'« espoir ». Continuez à investir, et vous verrez des bénéfices un jour à coup sûr !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470206,
						760470208
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 760470206,
					"content": "D'accord. Je reviendrai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760470207
					]
				},
				{
					"id": 760470207,
					"content": "Quoi ? Tu vas accepter son explication comme ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760470209,
					"content": "#Ça finira mal pour vous. On est... Oui, on est les célèbres {NICKNAME} et Paimon. On a plein d'amis dans le Village de Nasha !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760470210,
					"content": "Des « amis » ? Attendez... Ce genre d'« amis » ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470211
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 760470211,
					"content": "#... Hein ? Euh, oui ! C'est bien ce que vous pensez ! On en a vraiment beaucoup{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760470212,
					"content": "Ah ! Pourquoi vous ne me l'avez pas dit plus tôt ?! Bon, je suis désolé. Je vais vous laisser tranquilles... Prenez tout ça ! Ne revenez jamais m'acheter des coupons d'investissement, je ne vous en vendrai plus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 760470208,
					"content": "Arrêtez de vouloir me rouler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760470209
					]
				}
			]
		}
	]
