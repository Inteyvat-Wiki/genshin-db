			"dialogs": [
				{
					"id": 760470101,
					"content": "#Hum... Je vous observe depuis un moment {M#tous}{F#toutes} les deux et...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470102
					],
					"speakerTitle": "Pechna"
				},
				{
					"id": 760470102,
					"content": "Vous nous espionnez ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760470103
					]
				},
				{
					"id": 760470103,
					"content": "#Oh non, je... Je viens souvent ici pour chercher des livres, et j'ai remarqué que vous étiez {M#intéressés}{F#intéressées} par un investissement. Je vous déconseille de le faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470104
					],
					"speakerTitle": "Pechna"
				},
				{
					"id": 760470104,
					"content": "C'est vrai qu'on n'a pas encore gagné beaucoup... Mais pourquoi nous déconseillez-vous d'y participer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760470105,
					"content": "Je pense qu'il n'y a pas « beaucoup de gains ». Le patron a encore de nombreuses dettes à rembourser et ne prendra pas le risque de perdre de l'argent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470106
					],
					"speakerTitle": "Pechna"
				},
				{
					"id": 760470106,
					"content": "Mon amie s'est fait avoir par une arnaque similaire, alors je vous conseille de ne pas recommencer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470107
					],
					"speakerTitle": "Pechna"
				},
				{
					"id": 760470107,
					"content": "#Ce serait une arnaque ? {NICKNAME}, il faut qu'on trouve ce type pour tirer les choses au clair !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
