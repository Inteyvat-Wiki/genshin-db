	"talks": [
		{
			"id": 201101,
			"completionStepIds": [
				201101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201101",
							"2"
						],
						"stepId": 201101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Catherine"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20110101,
					"content": "#Vers les étoiles et au-delà ! Que puis-je faire pour toi, {M#voyageur}{F#voyageuse} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110102,
						20110103
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 20110102,
					"content": "À propos du voyage vers Inazuma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110104
					]
				},
				{
					"id": 20110104,
					"content": "Ah oui, j'ai entendu dire que tu avais déjà pris tes dispositions auprès de la capitaine de la Flotte du Crux concernant ton voyage vers Inazuma. Est-ce que c'est vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110105
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 20110105,
					"content": "Maintenant que j'y pense, cela fait pas mal de temps que je suis allée là-bas. Je n'ai malheureusement aucune information récente à te donner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110106
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 20110106,
					"content": "#Te voilà ! Tu es {M#le voyageur}{F#la voyageuse} que Beidou va emmener à Inazuma, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110107,
						20110109
					],
					"speakerTitle": "Drake"
				},
				{
					"id": 20110107,
					"content": "Je t'ai attendu toute la journée !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110108
					]
				},
				{
					"id": 20110108,
					"content": "Oh, vraiment ? Héhé... C'est un honneur de te rencontrer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110110
					],
					"speakerTitle": "Drake"
				},
				{
					"id": 20110110,
					"content": "Le réapprovisionnement est presque terminé. Une fois qu'on aura fait le décompte des effectifs, on pourra partir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110111
					],
					"speakerTitle": "Drake"
				},
				{
					"id": 20110111,
					"content": "La capitaine Beidou m'a envoyé te chercher. On lève l'ancre dès que tu es à bord.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110112
					],
					"speakerTitle": "Drake"
				},
				{
					"id": 20110112,
					"content": "On dirait bien que Beidou tient sa parole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110113,
					"content": "Bien sûr ! Il y a de nombreuses choses sur lesquelles la capitaine Beidou est intraitable. Je suis sûr que tu t'en rendras compte quand tu seras à bord.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110114
					],
					"speakerTitle": "Drake"
				},
				{
					"id": 20110114,
					"content": "Alors tu vas partir ? Je suppose que des félicitations sont de mise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110115
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 20110115,
					"content": "Où que le voyage qui t'attend te mène, que ce soit vers les cieux éthérés ou les profondeurs de l'abîme, chaque pas est une nouvelle réalisation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110116
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 20110116,
					"content": "Jusqu'à notre prochaine rencontre, vers les étoiles et au-delà !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110117,
						20110118
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 20110117,
					"content": "Vers les étoiles et au-delà, Catherine !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110119
					]
				},
				{
					"id": 20110119,
					"content": "Oh... C'est un peu difficile de se dire au revoir à présent... On se voyait pratiquement tous les jours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110120,
					"content": "#Héhé, eh bien si tel est le cas alors pourquoi ne pas venir me trouver lorsque vous serez {M#arrivés}{F#arrivées} ? Je vous attendrai sur l'Île de Narukami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110121,
						20110122
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 20110121,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110123
					]
				},
				{
					"id": 20110123,
					"content": "Alors il y a une autre Catherine à Inazuma ! Tu vois, on n'avait pas besoin d'être aussi tristes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110124,
					"content": "Haha, eh bien, je suppose qu'il est temps pour toi de faire tes adieux au Port de Liyue. Maintenant que j'ai délivré mon message, je retourne là-bas. Le navire est stationné au large de la Forêt de pierre de Guyun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110125
					],
					"speakerTitle": "Drake"
				},
				{
					"id": 20110125,
					"content": "D'accord. Merci d'avoir fait tout ce chemin pour nous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110126,
					"content": "Je ne fais que suivre les ordres. On se retrouve à bord de l'Alcor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Drake"
				},
				{
					"id": 20110122,
					"content": "... Je le savais !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110123
					]
				},
				{
					"id": 20110118,
					"content": "Tu vas nous manquer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110119
					]
				},
				{
					"id": 20110109,
					"content": "On dirait que notre contact vient d'arriver.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110110
					]
				},
				{
					"id": 20110103,
					"content": "À propos de la Flotte du Crux...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110104
					]
				}
			]
		},
		{
			"id": 201103,
			"completionStepIds": [
				201103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201103",
							"2"
						],
						"stepId": 201103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Beidou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20110301,
					"content": "Haha, te voilà enfin !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110302
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110302,
					"content": "Toutes ces années, qu'il pleuve ou qu'il vente, la Flotte du Crux n'a jamais subi le moindre retard. Si cela avait été quelqu'un d'autre, j'aurais déjà mis les voiles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110303,
						20110304
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110303,
					"content": "Toutes mes excuses, capitaine !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110305
					]
				},
				{
					"id": 20110305,
					"content": "Hahaha, pas besoin de prendre cet air sérieux. Je plaisantais. Tu es juste à l'heure, l'équipage vient de terminer les derniers préparatifs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110306
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110306,
					"content": "*soupir* Eh bien, maintenant que tout le monde est là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110307
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110307,
					"content": "Mettons le cap sur ce pays aux prises avec les tempêtes et les orages... La nation de l'« éternité » !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110308
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110308,
					"content": "Levez l'ancre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110304,
					"content": "C'est un honneur d'être à bord !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110305
					]
				}
			]
		},
		{
			"id": 201107,
			"completionStepIds": [
				201107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201107",
							"2"
						],
						"stepId": 201107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Thomas"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20110701,
					"content": "Enfin, te voilà. Tu m'as fait attendre, capitaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110702
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20110702,
					"content": "#Et il semble que nous ayons quelques {M#passagers clandestins}{F#passagères clandestines}... ou plutôt devrais-je dire quelques {M#invités}{F#invitées} de marque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110703
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20110703,
					"content": "Hé ! Chut !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110704,
					"content": "Tu peux blâmer ta Shogun toute-puissante pour ça. Les tempêtes autour d'Inazuma se sont intensifiées dernièrement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110705
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110705,
					"content": "Ma flotte est totalement à la hauteur de ce genre de défi, mais le mauvais temps nous a causé du retard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110706
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110706,
					"content": "À présent, laissez-moi faire les présentations. Voici Thomas, un partenaire commercial que j'ai rencontré récemment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110707
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110707,
					"content": "Hé, vous n'avez pas idée à quel point j'étais impatient de vous rencontrer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110708
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20110708,
					"content": "Thomas, ces deux-là sont...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110709
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110709,
					"content": "#Pas besoin de les présenter, leur réputation les précède. Il semble que même les mers orageuses ne puissent tenir à distance les rumeurs sur les exploits de ces {M#étrangers}{F#étrangères}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110710,
						20110711
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20110710,
					"content": "#{M#Ravi}{F#Ravie} de vous rencontrer, Thomas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110712
					]
				},
				{
					"id": 20110712,
					"content": "Héhé, c'est toujours agréable à entendre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110713,
					"content": "Ha, avec un peu de chance, ça rendra les choses un peu plus faciles ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110714
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110714,
					"content": "#{NICKNAME}, Thomas vit à Ritou depuis longtemps. Il ne serait pas exagéré de dire qu'il est le négociateur local.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110715
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110715,
					"content": "Si tu as le moindre problème, parles-en à Thomas. Et s'il essaye de t'embobiner, je m'occuperai personnellement de lui la prochaine fois que je serai là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110716
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110716,
					"content": "Héhéhé, pas la peine de s'inquiéter. Je suis sûr qu'on va bien s'entendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110717
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20110717,
					"content": "Bien. Alors, c'est réglé. Je m'en vais à présent. Je ne voudrais pas me faire attraper avec mon équipage ici. J'ai un fugitif à bord, après tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110718
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110718,
					"content": "Oh, c'est vrai. Kazuha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110719,
					"content": "#À la prochaine fois, {M#voyageur}{F#voyageuse}. Rappelle-toi de toujours donner le meilleur de toi-même, quelles que soient les « tempêtes » qui t'attendent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110720,
						20110721
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110720,
					"content": "#Je me sens {M#prêt}{F#prête}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110722
					]
				},
				{
					"id": 20110722,
					"content": "Bonne route, capitaine Beidou ! Au revoir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110723
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110723,
					"content": "À présent, pour commencer, on va vous enregistrer au poste de contrôle de la frontière.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110724
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20110724,
					"content": "#Hum, je croyais qu'on était {M#censés}{F#censées} adopter un profil bas... On va directement voir le gouvernement ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110725,
					"content": "Haha, ne sous-estimez pas la portée du décret de confinement. Vous ne pouvez pas échapper à une inspection, même si vous le vouliez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110726
					],
					"speakerTitle": "Thomas"
				},
