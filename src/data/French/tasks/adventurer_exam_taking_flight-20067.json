			"dialogs": [
				{
					"id": 200670101,
					"content": "Où est-ce que j'ai bien pu me tromper...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200670102
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200670102,
					"content": "Qu'y a-t-il ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200670103
					]
				},
				{
					"id": 200670103,
					"content": "#{M#Voyageur}{F#Voyageuse}... *sniff* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200670104
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200670104,
					"content": "J'ai étudié assidûment depuis notre séance d'entraînement de la dernière fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200670105
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200670105,
					"content": "Après cela, j'ai demandé à Jack de m'aider à faire un examen blanc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200670106
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200670106,
					"content": "Et... j'ai échoué à l'examen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200670107
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200670107,
					"content": "#Je ne sais pas du tout à quel endroit je me suis trompée... {M#Voyageur}{F#Voyageuse}, est-ce que vous pouvez superviser mon entraînement une nouvelle fois ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200670108,
						200670109
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200670108,
					"content": "Bien sûr.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200670110
					]
				},
				{
					"id": 200670110,
					"content": "#Merci pour votre aide, {M#voyageur}{F#voyageuse} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200670111
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200670111,
					"content": "Hmm, première question : combien de personnes peuvent utiliser un planeur en même temps pour voler ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200670109,
					"content": "(Est-ce que j'ai donné des mauvaises réponses la dernière fois ?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200670110
					]
				}
			]
		},
