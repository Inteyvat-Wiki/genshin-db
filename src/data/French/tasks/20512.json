					"speakerTitle": "Anthony"
				},
				{
					"id": 205120302,
					"content": "Voici.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120303
					]
				},
				{
					"id": 205120303,
					"content": "Beurk... C'est vraiment très... euh, condensé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120304
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120304,
					"content": "Ça peut vraiment servir dans la préparation de médicaments...? Je goûterai une fois que ce sera prêt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120305
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120305,
					"content": "Si jamais quelque chose venait à m'arriver... Allez trouver Anna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120306
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120306,
					"content": "... Et confiez-la aux bons soins de sœur Grace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120307
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120307,
					"content": "Dites-lui juste que... j'ai dû partir à l'étranger pour le travail. S'il vous plaît. C'est ma dernière requête.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120308
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120308,
					"content": "Hé là, pas la peine de s'en faire comme ça.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120309
					]
				},
				{
					"id": 205120309,
					"content": "Mais ce médicament a vraiment l'air... *soupir* Quoi qu'il en soit, avant que j'oublie, tenez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120310
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120310,
					"content": "Et n'oubliez pas ce que je viens de vous dire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
