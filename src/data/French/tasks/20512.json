			"dialogs": [
				{
					"id": 205120101,
					"content": "Cette ordonnance est vraiment de plus en plus étrange...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120102
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120102,
					"content": "Comment va Anna ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120103
					]
				},
				{
					"id": 205120103,
					"content": "Ah, c'est vous. Eh bien, ça peut paraître difficile à croire, mais elle dit qu'elle se sent beaucoup mieux à présent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120104
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120104,
					"content": "Peut-être que l'ordonnance fonctionne vraiment ? J'ai moi-même du mal à y croire, pour être franc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120105
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120105,
					"content": "Enfin, que ce soit le cas ou pas, autant continuer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120106
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120106,
					"content": "D'après l'ordonnance... Hum. Pourriez-vous me trouver, euh... de la bave d'Hydroblob condensée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120107,
						205120112,
						205120117
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120107,
					"content": "Ça m'a l'air un peu plus normal cette fois-ci.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120108
					]
				},
				{
					"id": 205120108,
					"content": "... « Normal » ? Je dirais plutôt le contraire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120109
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120109,
					"content": "Enfin... Au moins, ça ne devrait pas être trop difficile à se procurer. Je me suis renseigné, et on m'a dit qu'il suffisait de vaincre des Blobs géants pour en obtenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120110
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120110,
					"content": "Jack prétend même qu'on peut attirer les Blobs géants en s'en prenant aux petits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120111
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120111,
					"content": "Je n'ai guère de talent pour le combat, alors je m'en remets à vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120112,
					"content": "Ça devrait être comestible, pas de souci à se faire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120113
					]
				},
				{
					"id": 205120113,
					"content": "Et comment le savez-vous ? Vous avez déjà essayé ? ... Euh, pourquoi vous ne dites plus rien ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120114
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120114,
					"content": "Enfin, passons. Trouver des Hydroblobs ne devrait pas être trop compliqué. Je me suis renseigné et il paraît qu'on peut trouver de la bave condensée en vainquant des Blobs géants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120115
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120115,
					"content": "Jack prétend même qu'on peut attirer les Blobs géants en s'en prenant aux petits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120116
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120116,
					"content": "Je n'ai guère de talent pour le combat, alors je m'en remets à vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120117,
					"content": "Je sais où en trouver, justement.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120118
					]
				},
				{
					"id": 205120118,
					"content": "Ah... Voilà une excellente nouvelle. Vous avez l'air de savoir de quoi vous parlez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120119
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120119,
					"content": "Bien, alors je compte sur vous. Vous devriez pouvoir obtenir de la bave condensée en vainquant des Blobs géants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120120
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120120,
					"content": "Jack prétend même qu'on peut attirer les Blobs géants en s'en prenant aux petits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120121
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120121,
					"content": "Bon courage, et merci !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		},
