				{
					"id": 790610501,
					"content": "Désolée, Rozel. Je ne peux pas t'accompagner quand même...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610502
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610502,
					"content": "Je peux me contenter de rester ici. Comme ça, il y aura quelqu'un qui attendra ton retour après toutes ces aventures.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610503
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610503,
					"content": "Mais Esnoir, je...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610504
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610504,
					"content": "Je ne suis ni assez intelligent, ni assez courageux, Rozel. Mais je pense que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610505
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610505,
					"content": "Je pense que la brise souffle à travers les buissons, que les rivières s'écoulent dans les lacs et que le cycle se renouvelle. À la fin, elles reviendront à l'endroit où tout a commencé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610506
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610506,
					"content": "Peut-être qu'après avoir vécu autant de changements, leur dernier vœu est de redevenir comme elles étaient avant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610507
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610507,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610508
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610508,
					"content": "Je t'attendrai ici, à la maison, comme je l'ai toujours fait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Esnoir"
				}
			]
		},
