							"79061"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790610401,
					"content": "Rozel... Peut-être que je peux t'accompagner, mais... Je ne sais pas quoi préparer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610402
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610402,
					"content": "C'est simple. Ramène du pain et de la confiture, puis fais preuve de curiosité. Porte une tenue confortable et prends-en une de rechange.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610403
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610403,
					"content": "Enfin, prépare-toi psychologiquement aussi, parce que tu vas peut-être devoir jeter certaines de ces choses en chemin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610404
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610404,
					"content": "Oh, ça m'a l'air compliqué. Je ne veux pas les jeter, parce que toutes ces choses m'appartiennent et je les aime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610405
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610405,
					"content": "Tu découvriras d'autres choses qui te seront précieuses après t'en être séparée, mon cher Esnoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610406
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610406,
					"content": "Ce sera un voyage intéressant, crois-moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rozel"
				}
			]
		},
