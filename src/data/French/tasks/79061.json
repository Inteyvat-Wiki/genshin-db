							711.991
						],
						"pointId": 297
					}
				]
			},
			"dialogs": [
				{
					"id": 790610101,
					"content": "Rozel, peu importe combien de fois tu vas me le demander, je ne ferai pas ce long voyage avec toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610102
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610102,
					"content": "Je suis ton ami, et ça ne changera jamais. Je n'ai rien contre toi, mais... Je n'aime pas voyager.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610103
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610103,
					"content": "Esnoir, ce n'est pas aussi effrayant qu'on le pense. C'est juste un voyage, rien de plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610104
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610104,
					"content": "Il y a beaucoup de fleurs que nous n'avons jamais vues dans le monde extérieur, des gens que nous n'avons jamais rencontrés, et même des nuages de formes différentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610105
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610105,
					"content": "Tu te souviens des graines de fleurs que je t'ai ramenées ? Je peux t'assurer que tu n'as jamais vu de telles fleurs auparavant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610106
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610106,
					"content": "Ce ne sont encore que des graines. Je vais les planter et attendre qu'elles fleurissent pour voir ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610107
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610107,
					"content": "Si tu m'accompagnes en voyage, nous aurons peut-être la chance d'en voir directement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610108
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610108,
					"content": "Rozel... Je suis désolé, mais je ne veux pas voyager ni devenir comme ces aventureux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610109
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610109,
					"content": "Ils ne s'intéressent qu'à la valeur des tapis, et ils ignorent complètement la beauté des chapeaux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610110
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610110,
					"content": "C'est l'effet que les longs voyages ont sur les gens, et ça me fait peur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610111
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610111,
					"content": "C'est vrai. Mais tu as vu tout ce qu'ils ramènent dans leurs valises ? Des cartes, des échantillons de plantes et des carnets de voyage remplis d'histoires !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610112
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610112,
					"content": "Nous sommes comme le vent qui traverse différents buissons, comme le ruisseau qui traverse lacs et rivières... Nous vivons constamment de nouvelles choses et nous évoluons au cours de ces expériences. Nous ne pouvons plus être les mêmes qu'avant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610113
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610113,
					"content": "C'est comme cela que les voyages nous font changer, et cela m'effraie aussi... Mais je suis aussi reconnaissant pour tous ces changements.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610114
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610114,
					"content": "Tu peux comparer ça à une tranche de pain tartinée des deux côtés. Peu importe le soin avec lequel tu la manipules, tu vas gâcher de la crème.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610115
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610115,
					"content": "Dans ce cas, j'étalerais la crème séparément. Comme ça, je pourrai même essayer différentes saveurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610116,
						790610117
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610116,
					"content": "C'est une bonne idée. Ça devrait vous rassasier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610118
					]
				},
				{
					"id": 790610118,
					"content": "C'est vous, vous êtes enfin de retour. Rozel m'a beaucoup parlé de la beauté du monde extérieur, et il m'a souvent invité à voyager avec lui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610119
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610119,
					"content": "Vous connaissez bien le monde extérieur ? Est-ce vraiment... comme il l'a décrit ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610117,
					"content": "Ça devrait vous permettre de garder les mains propres.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610118
					]
				}
			]
		},
		{
			"id": 7906102,
			"completionStepIds": [
				7906101
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
