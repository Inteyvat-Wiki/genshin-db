							998.028,
							216.884,
							711.501
						],
						"pointId": 294
					}
				]
			},
			"dialogs": [
				{
					"id": 790610301,
					"content": "La vie dans le <color=#FFCC33FF>monde intérieur</color> n'est pas si mal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610302
					]
				},
				{
					"id": 790610302,
					"content": "Oui, c'est ici que vous vivez après tout, Esnoir. Vous devez aimer cet endroit, j'en suis sûre. Et puis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610303,
						790610304,
						790610305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790610303,
					"content": "Vous avez beaucoup d'amis ici.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610306
					]
				},
				{
					"id": 790610306,
					"content": "Exactement ! C'est précisément la peur de perdre tout cela qui m'inquiète.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610307
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610307,
					"content": "Tout cela est merveilleux... Je ne veux pas que cela change, et je ne veux pas non plus changer moi-même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610308
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610308,
					"content": "... Mais un long voyage changerait toutes ces choses, n'est-ce pas, Rozel ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610309
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610309,
					"content": "Oui, certaines seraient différentes. Je ne veux pas te mentir ni te rendre triste, Esnoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610310
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610310,
					"content": "D'accord... Je comprends ce que tu ressens, et j'espère que tu me comprends aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610311
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610311,
					"content": "Je vais encore y réfléchir et je te donnerai ma réponse plus tard... Mais pour l'instant, nous devrions prendre le thé ensemble et nous détendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610312
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610312,
					"content": "D'accord, je vais t'accompagner, Esnoir. Le prochain départ n'est pas pour tout de suite, nous pouvons y réfléchir ensemble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610304,
					"content": "Il y a énormément de belles fleurs.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610306
					]
				},
				{
					"id": 790610305,
					"content": "Et plein de délicieux gâteaux.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610306
					]
				}
			]
		},
		{
			"id": 7906104,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7906102",
							"2"
						],
						"stepId": 7906102,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
							"0",
