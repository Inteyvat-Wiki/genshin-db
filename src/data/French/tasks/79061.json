			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 100,
						"position": [
							998.028,
							216.884,
							711.501
						],
						"pointId": 294
					}
				]
			},
			"dialogs": [
				{
					"id": 790610201,
					"content": "Oui, le <color=#FFCC33FF>monde extérieur</color> regorge de choses nouvelles à découvrir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610202
					]
				},
				{
					"id": 790610202,
					"content": "Oui, il y a plein de plats délicieux et d'activités amusantes à l'extérieur. Vous pourrez vivre des expériences intéressantes et rencontrer des gens extraordinaires. Comme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610203,
						790610204,
						790610205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790610203,
					"content": "Des gens qui savent apprécier la vraie beauté des choses.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610206
					]
				},
				{
					"id": 790610206,
					"content": "Vraiment ? Je pensais que le monde extérieur ne pensait qu'à cette « valeur » et que la majorité des gens veut porter un chapeau, mais n'ose tout simplement pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610207
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610207,
					"content": "C'est... comme les différents chocolats saupoudrés sur un gâteau. Ils ont tous leur propre saveur unique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790610208,
					"content": "Si tous les chocolats avaient le même goût, le gâteau ne serait-il pas trop ordinaire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610209,
						790610210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790610209,
					"content": "C'est très joliment dit, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610211
					]
				},
				{
					"id": 790610211,
					"content": "C'est bien normal après avoir écouté toutes ces histoires, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790610212,
					"content": "Vous pensez ? Je dois y réfléchir... Peut-être qu'un voyage pas trop loin ne serait pas si mal...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610213
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610213,
					"content": "Prends ton temps, Esnoir. Le prochain départ n'est pas pour tout de suite. D'ici là, nous pourrons y réfléchir ensemble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610210,
					"content": "Tu t'es bien acclimatée, Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610211
					]
				},
				{
					"id": 790610204,
					"content": "De brillants idéaux qui jamais ne faiblissent.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610206
					]
				},
				{
					"id": 790610205,
					"content": "Ceux qui travaillent sans relâche à la réalisation de leurs rêves.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610206
					]
				}
			]
		},
		{
			"id": 7906103,
