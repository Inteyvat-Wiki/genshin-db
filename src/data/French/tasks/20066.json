			},
			"dialogs": [
				{
					"id": 200660101,
					"content": "Qu'est-ce que je suis censée faire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660102
					],
					"speakerTitle": "Eileen"
				},
				{
					"id": 200660102,
					"content": "Qu'est-ce qu'il vous arrive ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200660103
					]
				},
				{
					"id": 200660103,
					"content": "Je m'entraîne pour la sélection de l'Ordre de Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660104
					],
					"speakerTitle": "Eileen"
				},
				{
					"id": 200660104,
					"content": "Mais je suis loin d'être aussi puissante que Jean...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660105
					],
					"speakerTitle": "Eileen"
				},
				{
					"id": 200660105,
					"content": "Je pense que je devrais me concentrer davantage sur la technique que sur la force.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660106
					],
					"speakerTitle": "Eileen"
				},
				{
					"id": 200660106,
					"content": "Par exemple, je me demandais comment je pourrais casser tous ces mannequins en un coup... mais mon père s'est donné tellement de mal pour me les ramener, je ne dois pas le décevoir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660107
					],
					"speakerTitle": "Eileen"
				},
				{
					"id": 200660107,
					"content": "Si tu as un peu de temps libre, ça te dit de réfléchir avec moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660108,
						200660109
					],
					"speakerTitle": "Eileen"
				},
				{
					"id": 200660108,
					"content": "Laisse-moi réfléchir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200660110
					]
				},
				{
					"id": 200660110,
					"content": "Merci. Prends ton temps, ces mannequins n'iront nulle part.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660111
					],
					"speakerTitle": "Eileen"
				},
				{
					"id": 200660111,
					"content": "Moi non plus d'ailleurs... Je suis coincée ici jusqu'à ce que je trouve la solution...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660114
					],
					"speakerTitle": "Eileen"
				},
				{
					"id": 200660114,
					"content": "À cette distance, je pourrais briser les pieux d'un côté et balancer une bombe sur l'autre côté.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660115
					],
					"speakerTitle": "Eileen"
				},
				{
					"id": 200660115,
					"content": "Je rigole ! Où trouver une bombe de toute façon ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eileen"
				},
				{
					"id": 200660109,
					"content": "Voyons voir ça ensemble...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200660112
					]
				},
				{
					"id": 200660112,
					"content": "Tu aimes bien combattre en équipe ? C'est super d'avoir quelqu'un sur qui on peut compter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660113
					],
					"speakerTitle": "Eileen"
				},
				{
					"id": 200660113,
					"content": "Le mieux que je puisse faire est de me battre seule...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660114
					],
					"speakerTitle": "Eileen"
				}
			]
		},
