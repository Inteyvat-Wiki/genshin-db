					"Nahuatlalli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752400101,
					"content": "#Bienvenue à la Coupe des héros d'Ayar, mon {M#ami}{F#amie}. Je suis l'organisatrice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752400102
					],
					"speakerTitle": "Nahuatlalli"
				},
				{
					"id": 752400102,
					"content": "Aujourd'hui, c'est le dernier jour de la compétition. Si vous voulez gagner, vous devrez vaincre nos trois meilleurs guerriers d'affilée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752400107
					],
					"speakerTitle": "Nahuatlalli"
				},
				{
					"id": 752400107,
					"content": "#C'est quoi, la Coupe des héros d'Ayar{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752400108
					]
				},
				{
					"id": 752400108,
					"content": "C'est un combat pour la gloire d'Ayar ! Utilisez vos poings, vos armes ou toute autre méthode pour vaincre votre adversaire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752400109
					],
					"speakerTitle": "Nahuatlalli"
				},
				{
					"id": 752400109,
					"content": "Est-ce qu'Ayar est une personne, ou bien...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752400110
					]
				},
				{
					"id": 752400110,
					"content": "#Mon {M#ami}{F#amie}, seul les champions ont le droit de poser des questions ici !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752400111
					],
					"speakerTitle": "Nahuatlalli"
				},
				{
					"id": 752400111,
					"content": "Montez sur scène ! Nous verrons bien si vous avez la force de gagner ce respect.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahuatlalli"
				}
			]
		},
