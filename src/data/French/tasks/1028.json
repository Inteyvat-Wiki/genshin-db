						10280809
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10280809,
					"content": "C'est important de se ravitailler. Ce n'est qu'en conservant suffisamment d'énergie physique et mentale qu'on sera capables d'affronter l'inconnu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280810
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280810,
					"content": "Et ça, même Ushi le sait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280811
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280811,
					"content": "Bon, d'accord. Je vous en fais deux chacun... Hé, vous avez déjà commencé à manger ?!",
