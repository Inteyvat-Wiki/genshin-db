						10280807
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10280807,
					"content": "Tu as entendu ? Ushi dit que tu as raison... Une minute ! Ushi, tu n'es pas de mon côté ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280808
					],
					"speakerTitle": "Arataki Itto"
				},
				{
