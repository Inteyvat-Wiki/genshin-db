	"talks": [
		{
			"id": 102804,
			"completionStepIds": [
				102804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102804",
							"2"
						],
						"stepId": 102804,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yanfei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10280401,
					"content": "Hein ? Attendez, ça ne va pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280402
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280402,
					"content": "Comment... comment ça se fait qu'on soit revenus ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280403,
					"content": "On est déjà venus ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280404
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280404,
					"content": "Oui, c'est d'ici qu'on est partis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280405
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280405,
					"content": "Pourtant, on ne s'est pas trompés de route. On n'a fait que suivre le chemin qui mène vers la sortie, et on ne s'est jamais retournés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280406
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280406,
					"content": "Oui, c'est ce qui me semble aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280407
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280407,
					"content": "#{M#Voyageur}{F#Voyageuse}, on allait dans la bonne direction, tu confirmes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280408
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280408,
					"content": "Oui, on ne s'est pas trompés.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280409
					]
				},
				{
					"id": 10280409,
					"content": "C'est bizarre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280410,
					"content": "Il existe à Inazuma une légende qui raconte l'histoire d'un marchand qui fut victime de la ruse d'un Tanuki. Il passa toute la nuit au même endroit, à tourner en rond jusqu'au matin, sans jamais pouvoir s'échapper...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280411
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280411,
					"content": "C'est une histoire connue. Moi aussi, je l'ai entendue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280412,
					"content": "Tout le monde la connaît, alors ? Je suis sûr que c'est ce qui est en train de nous arriver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280413
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280413,
					"content": "Mais ne vous en faites pas, j'ai un assistant qui sait exorciser les démons. Je vais l'appeler, attendez un peu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280414
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280414,
					"content": "Incroyable. Un Oni qui a un ami exorciste... Itto est vraiment ouvert d'esprit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280415,
					"content": "Heureux les simples d'esprit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280416
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280416,
					"content": "Viens à moi, Ushi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280417
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280417,
					"content": "Meuh !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280418
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10280418,
					"content": "Lui, c'est Ushi. C'est un membre de réserve du gang Arataki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280419
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280419,
					"content": "Meuh, meuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280420
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10280420,
					"content": "#Oh, Ushi est en train de saluer tout le monde. Vous pouvez l'appeler Ushi, ou «{NON_BREAK_SPACE}steak Ushi{NON_BREAK_SPACE}», c'est comme vous préférez. Ushi a un bon sens de l'orientation, il pourra nous guider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280421
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280421,
					"content": "Je ne savais pas que les gangs avaient des membres de réserve...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280422
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280422,
					"content": "Je ne suis pas sûre de ce plan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280423
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280423,
					"content": "Qui sait si ça va marcher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280424
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280424,
					"content": "En avant, Ushi ! Trouve la voie vers la sortie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280425
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280425,
					"content": "Meuh !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280426
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10280426,
					"content": "Ushi cherche une sortie cachée dans les environs...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						10280427
					]
				},
				{
					"id": 10280427,
					"content": "Meuh... Meuh, meuh... Meuh !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280428
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10280428,
					"content": "Hein ? Quoi... Vraiment ? Non, incroyable !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280429
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280429,
					"content": "Qu'est-ce qu'il y a ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280430,
					"content": "Ushi dit qu'il a cherché partout, mais qu'il n'a pas trouvé de sortie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280431
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280431,
					"content": "Mais puisqu'on a pu entrer, il n'y a pas de raison pour qu'on ne puisse pas sortir. Allez, je vais aller voir moi-même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280432
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280432,
					"content": "Vous avez remarqué ? Au départ, on pensait qu'on avait fait une chute. Il y avait même un trou dont on ne voyait pas le bout au-dessus de nous. Mais maintenant, même cette sortie a disparu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280433
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280433,
					"content": "Comment est-ce possible ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280434
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280434,
					"content": "On dirait que ces structures souterraines cachent plus de choses que l'on ne s'imaginait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280435
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280435,
					"content": "... Je vais inspecter les lieux à nouveau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280436
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280436,
					"content": "Il n'y a que des rochers ici. Est-ce que... Est-ce qu'on s'est mal souvenus et que ce n'est pas ici qu'on est tombés ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280437,
					"content": "Quoi, t'as la frousse ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280438
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280438,
					"content": "J—Je ne suis pas une froussarde !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280439
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280439,
					"content": "Meuh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280440
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10280440,
					"content": "Même Ushi dit que tu as peur. C'est pas grave, tu peux le dire si tu as peur. On te protège.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280441
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280441,
					"content": "Je suis là, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280442
					]
				},
				{
					"id": 10280442,
					"content": "#On ne peut pas rester là à se tourner les pouces. Continuons à chercher une issue. Shinobu, reste ici avec ma bienfaitrice, je prends {NICKNAME} et Paimon avec moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280443
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280443,
					"content": "D'accord. Faites attention à vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280444
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280444,
					"content": "Vous n'avez pas besoin de m'appeler votre « bienfaitrice », appelez-moi Yanfei, ça suffira. Je vois pourquoi vous êtes le patron du gang Arataki maintenant, monsieur Itto. Vous avez l'allure d'un chef.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280445
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280445,
					"content": "Vous êtes trop gentille. Vous pouvez m'appeler Itto tout court. Puisqu'on est une équipe, on doit se soutenir mutuellement. Paimon, si tu as toujours peur, je peux te couvrir les yeux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280446
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280446,
					"content": "Le groupe se divise pour faire des recherches dans les environs, sans parvenir à trouver quoi que ce soit...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						10280447
					]
				},
				{
					"id": 10280447,
					"content": "... *soupir* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280448
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280448,
					"content": "Il n'y a vraiment pas de sortie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280449
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280449,
					"content": "Meuh !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280450
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10280450,
					"content": "Si vous voulez mon avis, il y a quelque chose qui cloche avec cet endroit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280451
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280451,
					"content": "Patron, comment ça se passe de votre côté ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280452
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280452,
					"content": "Rien de nouveau.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280453
					]
				},
				{
					"id": 10280453,
					"content": "En plus de ça, j'aurais juré avoir vu des ombres bouger il y a une seconde... Cet endroit n'est quand même pas hanté, j'espère ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280454
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280454,
					"content": "Ce n'est probablement pas le bon moment pour poser cette question, mais je ne peux pas m'en empêcher. Itto, tu es un Oni... Donc ça veut dire que tous les endroits où tu vas sont hantés, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280455
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280455,
					"content": "Non, enfin ! Je parle de ces fantômes qui brillent ou qui apparaissent et disparaissent soudainement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280456
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280456,
					"content": "Euh ? Itto... tu as peur des fantômes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280457
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280457,
					"content": "Oups. On dirait qu'elle vous a percé à jour, patron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280458
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280458,
					"content": "M—Moi, peur des fantômes ? Arrêtez de dire n'importe quoi, vous deux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280459
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280459,
					"content": "Hihi, à te voir comme ça, j'ai tout de suite moins peur... Hé, vacheron ! Si tu as peur, je peux te couvrir les yeux, tu sais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280460
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280460,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280461
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280461,
					"content": "Bon, je vais faire quelque chose pour m'occuper.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280462
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280462,
					"content": "(Hmm ? Shinobu est allée ramasser des pierres, puis elle a sorti quelques brindilles et des melons lavandes de sa poche...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280463
					]
				},
				{
					"id": 10280463,
					"content": "On ajoute un peu de sel... et un peu de poivre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280464
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280464,
					"content": "Tu es en train de faire griller des melons lavandes ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280465
					]
				},
				{
					"id": 10280465,
					"content": "Oui. C'est très bon, tu pourras goûter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280466
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280466,
					"content": "D'accord.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280467
					]
				},
				{
					"id": 10280467,
					"content": "Euh... Il y en a des salés et des sucrés. Qu'est-ce que tu préfères ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280468
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280468,
					"content": "Tout me va.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280469
					]
				},
				{
					"id": 10280469,
					"content": "D'accord, alors tu n'as qu'à essayer les deux. On doit tous garder notre calme, surtout dans ce genre de situation difficile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280470
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280470,
					"content": "Si je comprends bien la situation, il semble y avoir un secret que le patron et moi ne sommes pas censés connaître. Mais ne t'inquiète pas, je vais distraire le patron pendant que tu discutes avec les autres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280471
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280471,
					"content": "Ooh, je me disais que je sentais une odeur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280472
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280472,
					"content": "Vous en voulez, Yanfei ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280473
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280473,
					"content": "Je n'ai pas faim, vous pouvez manger sans moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280474
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280474,
					"content": "Au fait, Shinobu. Ça faisait longtemps que je ne t'avais pas vue !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280475
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280475,
					"content": "Oui, la dernière fois, c'était quand je faisais mes études à Liyue. Vous aviez remplacé mon prof pour un cours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280476
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280476,
					"content": "J'ai été remplaçante ? Ah, je me souviens. C'était pendant l'hiver, c'est ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280477
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280477,
					"content": "Voilà. Tout le monde disait que votre cours était passionnant. En y repensant, je devrais sans doute vous appeler « senpai ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280478
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280478,
					"content": "Pourquoi pas. Je dois dire que ça me plaît. Héhé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280479
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280479,
					"content": "Qui aurait pu imaginer qu'on se retrouverait toutes les deux au milieu d'une telle mésaventure. Ça doit être le destin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280480
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280480,
					"content": "Vous donnez même des cours, Yanfei ? Impressionnant.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280481
					]
				},
				{
					"id": 10280481,
					"content": "Ses cours sont parsemés d'humour en plus d'être ludiques. Tous les étudiants l'adorent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280482
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280482,
					"content": "Hahaha, tu me flattes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280483
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280483,
					"content": "Ah, vous êtes tous là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280484
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280484,
					"content": "Yelan, on s'est séparés en plusieurs groupes pour chercher une sortie, mais on n'a rien trouvé. Et toi ? Tu as quelque chose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280485
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280485,
					"content": "Non.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280486
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280486,
					"content": "D'autre part... Ça ne me fait pas plaisir de le dire, mais il va falloir se préparer psychologiquement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280487
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280487,
					"content": "Si on n'arrive pas à trouver de sortie, on va devoir rester ici pendant un moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280488
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280488,
					"content": "... C'est ce que je me suis dit aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280489
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280489,
					"content": "... Je vois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280490
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280490,
					"content": "Mais c'est tout de même absurde, qui a déjà vu un lieu souterrain avec une entrée, mais pas de sortie... Je vais continuer à chercher une solution.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280491
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280491,
					"content": "Si jamais vous trouvez une issue, soyez sûrs de prendre toutes les précautions nécessaires avant de vous y aventurer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280492
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280492,
					"content": "(Au fait, Xiao aussi est ici. Il nous avait dit que si on se retrouvait dans une situation difficile, il suffisait d'appeler son nom.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280493
					]
				},
				{
					"id": 10280493,
					"content": "(Hmm, ça peut être une solution.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280494
					]
				},
				{
					"id": 10280494,
					"content": "#Hé, tu as l'air bien {M#sérieux}{F#sérieuse}. Tu as un plan ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280495
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280495,
					"content": "Tu te souviens que Xiao est ici ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280496
					]
				},
				{
					"id": 10280496,
					"content": "Xiao... Ah, oui ! Tu veux l'appeler pour qu'il vienne nous aider ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280497
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280497,
					"content": "On peut essayer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280498
					]
				},
				{
					"id": 10280498,
					"content": "Oui, essaye pour voir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280499
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280499,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280500
					]
				},
				{
					"id": 10280500,
					"content": "Xiao, vous m'entendez ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280501
					]
				},
				{
					"id": 10280501,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280502,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280503
					]
				},
				{
					"id": 10280503,
					"content": "Xiao ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280504
					]
				},
				{
					"id": 10280504,
					"content": "Pas de réponse... Moi qui croyais que Xiao viendrait, peu importe l'endroit où l'on se trouve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280505,
					"content": "Donc même Xiao n'arrive pas à sentir notre présence ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280506,
					"content": "(...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280507
					]
				},
				{
					"id": 10280507,
					"content": "(Si c'est ça, alors qu'est-ce que ça signifie ? Dans quel genre d'endroit nous trouvons-nous ?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
