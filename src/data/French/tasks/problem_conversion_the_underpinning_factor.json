				"points": []
			},
			"dialogs": [
				{
					"id": 230220101,
					"content": "Si on renforce la résistance ici, il faut que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220102
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220102,
					"content": "Si tu décides d'utiliser ce plan, tu ne verras pas de grande différence avec la version précédente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220103
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230220103,
					"content": "Vous êtes encore en train de faire des plans pour le bateau ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230220104
					]
				},
				{
					"id": 230220104,
					"content": "#Ah, {M#voyageur}{F#voyageuse}, vous êtes là. Oui, c'est ça. Après le dernier essai en mer, Qishan et moi avons discuté... Euh... De la conception de certaines parties clés du bateau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220105
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220105,
					"content": "Nous avons... bien échangé, et nous sommes maintenant prêts à essayer un nouveau modèle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220106
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220106,
					"content": "Cela étant, nous avons quelques divergences dans le choix des matériaux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220107
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220107,
					"content": "Mais cette fois, j'ai suivi les conseils de Qishan : dépenser une petite fortune pour me procurer de bons matériaux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220108
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220108,
					"content": "#Seulement voilà, {M#voyageur}{F#voyageuse}, je ne suis pas capable de déplacer tous ces matériaux seul. Qishan n'est pas assez robuste elle non plus. Pourriez-vous...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220109,
						230220110
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220109,
					"content": "Je vais vous aider à les déplacer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230220111
					]
				},
				{
					"id": 230220111,
					"content": "Merci, je sais que je peux compter sur vous. Allons-y.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220112
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220112,
					"content": "Cette fois, les matériaux ont été choisis par Qishan elle-même, il n'y aura donc probablement pas de problème...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220113
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220113,
					"content": "Et puis j'ai d'autres récompenses pour vous. Merci beaucoup pour votre aide...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220110,
					"content": "N'en dites pas plus. On y va.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230220111
					]
				}
			]
		},
