			"dialogs": [
				{
					"id": 230220501,
					"content": "Très bien ! Ça devrait suffire. Veuillez accepter ceci en guise de récompense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220502
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220502,
					"content": "Dis donc, ces matériaux sont vraiment légers... Qishan, tu es sûre qu'ils sont solides ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220503
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220503,
					"content": "Crois-moi, ils sont meilleurs que ceux que tu as choisis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220504
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230220504,
					"content": "Cette fois-ci, je vais te demander de me préparer un gilet de sauvetage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220505
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220505,
					"content": "Fais-moi confiance... Il n'y aura pas de problème.",
					"roleType": "TALK_ROLE_NPC",
