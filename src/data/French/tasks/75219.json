			"dialogs": [
				{
					"id": 752190101,
					"content": "#Ah, c'est {NICKNAME} ! Attendez, s'il vous plaît !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190102
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190102,
					"content": "Vous voilà enfin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190103
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190103,
					"content": "Oh ? Qu'est-ce qui vous arrive ? Vous avez besoin de notre aide ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190104,
					"content": "Haha, pas vraiment. J'avais juste un colis pour vous deux, je me demandais même comment j'allais vous trouver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190105
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190105,
					"content": "#Mais vous êtes {M#apparus}{F#apparues} devant moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190106
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190106,
					"content": "Un colis ! De qui ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190107,
					"content": "À vrai dire, il en a fait du chemin... Après avoir changé de mains plusieurs fois, ce colis a fini chez la Guilde des aventuriers avant d'avoir été transmis aux coursiers des Êtres des canopées...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190108
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190108,
					"content": "La situation à Natlan ces derniers temps a été quelque peu particulière. Les caravanes marchandes n'ont pas pu circuler pendant un moment. L'expéditeur n'a pas laissé son nom dessus, mais d'après la signature, on dirait que ça vient de Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190109
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190109,
					"content": "Vous avez l'air d'avoir beaucoup d'amis là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190110,
						752190111
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190110,
					"content": "Du coup, je vais le réceptionner.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752190112
					]
				},
				{
					"id": 752190112,
					"content": "Ma journée commence si bien ! Je suis tombé sur vous par la grâce de l'Archon Pyro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190113
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190113,
					"content": "Bon, je vais continuer mes livraisons. Bonne journée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190114
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190114,
					"content": "Bon courage !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190115,
					"content": "Un colis de Fontaine, hein... Enfin, c'est presque une lettre au vu de la taille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190116,
					"content": "Ouvrons-le pour voir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190117,
					"content": "Oh, c'est de Charlotte ! Elle nous a envoyé la photo qu'on a prise tous ensemble avant notre départ de Fontaine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190118,
					"content": "On l'a prise il n'y a pas si longtemps que ça, mais j'ai l'impression qu'une éternité est passée depuis !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190119,
					"content": "Héhé, gardons-la précieusement !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190111,
					"content": "Vous pouvez me le remettre !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752190112
					]
				}
			]
		}
	]
}