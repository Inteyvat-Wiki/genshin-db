					"Wangya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718190101,
					"content": "*soupir* ... Ça n'en finit jamais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190102
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190102,
					"content": "Quel est le problème ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190103
					]
				},
				{
					"id": 718190103,
					"content": "Rien de bien méchant ! Je suis juste en train d'organiser tout ce qui doit être fait pendant le Festival des lanternes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190104
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190104,
					"content": "C'est juste que... Plus j'en fais, et plus il y a de choses à faire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190105
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190105,
					"content": "Des collègues s'occupent d'une partie du travail, mais je suis en charge de coordonner la livraison des lanternes célestes cette année. Je dois vite tout préparer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190106,
						718190107
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190106,
					"content": "La livraison des lanternes célestes ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190108
					]
				},
				{
					"id": 718190108,
					"content": "C'est vrai, vous n'êtes pas au courant... Quand je parle de la « livraison des lanternes célestes », ça ne veut pas simplement dire qu'il faut livrer des lanternes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190109
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190109,
					"content": "Pour faire simple, il s'agit de jouer le rôle d'ambassadeur, de transmettre les vœux de tout le monde, et de créer une ambiance festive en somme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190110
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190110,
					"content": "Par exemple, même si la plupart des gens ne travaillent pas pendant le festival, y compris certains marchands et leurs employés...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190111
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190111,
					"content": "Il faut quand même maintenir l'ordre ou régler quelques affaires urgentes ! Et donc, certains Millelithes doivent rester à leur poste pendant le festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190112
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190112,
					"content": "Alors, le Bureau des affaires civiles s'arrange généralement pour leur envoyer des cadeaux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190113
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190113,
					"content": "Aujourd'hui, je dois « livrer des lanternes célestes » aux Millelithes chargés de la sécurité de la ville.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190114
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190114,
					"content": "Malheureusement, comme je suis à court de personnel, certaines livraisons n'ont pas pu avoir lieu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190115
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190115,
					"content": "#{M#Voyageur}{F#Voyageuse}, pourriez-vous m'aider à livrer ces cadeaux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190116
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190116,
					"content": "Avec plaisir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190117
					]
				},
				{
					"id": 718190117,
					"content": "Vraiment ? Vous me tirez une épine du pied, merci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190118
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190118,
					"content": "Qui faut-il aller voir ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190119
					]
				},
				{
					"id": 718190119,
					"content": "Voyons voir... Alors, les Millelithes qui n'en ont pas encore reçu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190120
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190120,
					"content": "Xiangming... Hongyi et... Cai Le.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190121
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190121,
					"content": "Je vous indique où ils se trouvent, et merci encore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190107,
					"content": "Combien de lanternes faut-il livrer ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190108
					]
				}
			]
		},
		{
