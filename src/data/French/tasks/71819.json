					"Xiangming"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718190201,
					"content": "Oui ? Qu'est-ce qu'il y a ? Je suis en service...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190202
					],
					"speakerTitle": "Xiangming"
				},
				{
					"id": 718190202,
					"content": "Un cadeau du festival...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190203
					]
				},
				{
					"id": 718190203,
					"content": "Moins fort ! Je suis en pleine mission ! Comment ça, un cadeau ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190204
					],
					"speakerTitle": "Xiangming"
				},
				{
					"id": 718190204,
					"content": "Hein ? C'est le Bureau des affaires civiles qui vous envoie ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190205
					],
					"speakerTitle": "Xiangming"
				},
				{
					"id": 718190205,
					"content": "Une nouvelle année, un nouveau Festival des lanternes... Et dire que je voulais retourner voir ma famille plus tôt cette année...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190206
					],
					"speakerTitle": "Xiangming"
				},
				{
					"id": 718190206,
					"content": "Mais avec tout ce qui se passe ici des derniers temps, ce n'est pas le moment de se détendre... Je suppose que je serai encore en retard...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190207
					],
					"speakerTitle": "Xiangming"
				},
				{
					"id": 718190207,
					"content": "Merci d'avoir fait tout ce chemin, et merci pour le cadeau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190208
					],
					"speakerTitle": "Xiangming"
				},
				{
					"id": 718190208,
					"content": "*soupir* Mais pourquoi il traîne dans le coin, celui-là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiangming"
				}
			]
		},
