					"Wangya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718190701,
					"content": "Vous revoilà ! Comment ça s'est passé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190702
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190702,
					"content": "Tout a été livré en mains propres.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190703
					]
				},
				{
					"id": 718190703,
					"content": "Merci, ça m'aide vraiment... Je n'aurais pas pu m'en charger si vous n'aviez pas été là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190704
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190704,
					"content": "Et ils restent de service pendant tout le festival ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190705
					]
				},
				{
					"id": 718190705,
					"content": "Eh bien... Le Bureau des affaires civiles essaye quand même de s'organiser pour alterner les gardes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190706
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190706,
					"content": "Mais Liyue est grande, et il y a beaucoup d'endroits à protéger et à patrouiller.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190707
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190707,
					"content": "Et même en alternant les gardes, il manque des hommes. Il faut toujours des gens de service pendant les fêtes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190708
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190708,
					"content": "En plus, comme le Festival des lanternes est célébré dans toute la ville, certains endroits nécessitent encore plus de monde... Peu importe comment on s'y prend, on manque toujours d'effectifs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190709,
						718190710
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190709,
					"content": "Ça n'a pas l'air facile...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190711
					]
				},
				{
					"id": 718190711,
					"content": "Eh bien, c'est notre devoir ! Tant que le festival se déroule bien, c'est tout ce qui compte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190712
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190712,
					"content": "D'ailleurs, beaucoup de gens ont besoin d'un coup de main pendant le festival. Si vous voulez, vous pouvez les aider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190713
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190713,
					"content": "Plus il y a de gens célébrant le Festival des lanternes, plus l'ambiance est à la fête !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190714
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190714,
					"content": "On livre des lanternes célestes parce qu'on espére que tout le monde pourra en lâcher une et faire un vœu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190715
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190715,
					"content": "À la longue, le festival se répandra peut-être sur tout le continent. Ce serait formidable si le monde entier pouvait découvrir l'ambiance du Festival des lanternes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190716
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190716,
					"content": "Après tout, il s'agit d'une fête destinée à rassembler les gens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190717
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190717,
					"content": "Bon, j'ai encore beaucoup à faire. J'espère que vous passerez un bon moment pendant le festival !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190710,
					"content": "Je vous plains vraiment.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190711
					]
				}
			]
		},
