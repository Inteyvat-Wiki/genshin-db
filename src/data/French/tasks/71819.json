			"dialogs": [
				{
					"id": 718190301,
					"content": "Qu'est-ce qu'il a, ce puits, à la fin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190302
					],
					"speakerTitle": "Hongyi"
				},
				{
					"id": 718190302,
					"content": "Un cadeau du festival...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190303
					]
				},
				{
					"id": 718190303,
					"content": "Oh, ça vient du Bureau des affaires civiles ? Merci beaucoup !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190304
					],
					"speakerTitle": "Hongyi"
				},
				{
					"id": 718190304,
					"content": "Par contre, je dois encore rester un peu à mon poste. J'ai peur que des civils ne viennent chercher de l'eau pendant le festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190305
					],
					"speakerTitle": "Hongyi"
				},
				{
					"id": 718190305,
					"content": "*soupir* ... Je ne sais pas ce qui est arrivé au puits, mais l'eau n'est plus potable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hongyi"
				}
			]
		},
