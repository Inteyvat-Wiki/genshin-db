			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cai Le"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718190601,
					"content": "Avez-vous décroché la lanterne ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190602
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190602,
					"content": "La voilà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190603
					]
				},
				{
					"id": 718190603,
					"content": "Faites-moi voir... Oui, c'est celle-là ! Merci, je vais la leur ramener.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190604
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190604,
					"content": "Ça fait un moment... J'espère qu'ils sont toujours là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190605
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190605,
					"content": "À propos du cadeau...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190606
					]
				},
				{
					"id": 718190606,
					"content": "#Ça vient du Bureau des affaires civiles, c'est ça ? Merci, c'est gentil d'être {M#venu}{F#venue} m'apporter ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190607
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190607,
					"content": "Tout ça fait aussi partie de votre devoir de Millelithe ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190608
					]
				},
				{
					"id": 718190608,
					"content": "Vous voulez dire... Retrouver les lanternes perdues ? Haha, bien sûr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190609
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190609,
					"content": "Ramasser des lanternes, chasser des malfrats, terrasser des monstres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190610
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190610,
					"content": "La mission d'un Millelithe est d'aider ceux dans le besoin !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190611
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190611,
					"content": "Eh bien, merci encore ! Je dois me dépêcher de rejoindre ces enfants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190612
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190612,
					"content": "Et puis, j'ai encore d'autres tâches à finir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cai Le"
				}
			]
		},
		{
			"id": 7181907,
			"completionStepIds": [
				7181909
			],
