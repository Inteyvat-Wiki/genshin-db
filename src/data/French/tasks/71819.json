			"dialogs": [
				{
					"id": 718190401,
					"content": "*sniff* ... Je... J'avais pas encore écrit mon souhait... *sniff* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190402
					],
					"speakerTitle": "Yixian"
				},
				{
					"id": 718190402,
					"content": "Du calme, sœurette, le Millelithe est allé la chercher pour toi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190403
					],
					"speakerTitle": "Yizhu"
				},
				{
					"id": 718190403,
					"content": "À propos de Cai Le...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190404
					]
				},
				{
					"id": 718190404,
					"content": "Vous cherchez ce gentil Millelithe ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190405
					],
					"speakerTitle": "Yizhu"
				},
				{
					"id": 718190405,
					"content": "Pendant qu'elle écrivait son souhait, Yixian n'a pas fait attention et sa lanterne céleste s'est envolée par là-bas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190406
					],
					"speakerTitle": "Yizhu"
				},
				{
					"id": 718190406,
					"content": "Ce Millelithe nous a dit qu'il l'avait vue accrochée à un arbre. Alors, il est parti la chercher pour nous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190407,
						718190408
					],
					"speakerTitle": "Yizhu"
				},
				{
					"id": 718190407,
					"content": "Est-ce qu'elle est si spéciale que ça, cette lanterne ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190409
					]
				},
				{
					"id": 718190409,
					"content": "C'est ce que je lui ai dit, à Yixian... Mais elle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190410
					],
					"speakerTitle": "Yizhu"
				},
				{
					"id": 718190410,
					"content": "*sniff* ... Non... Non... C'est mon grand frère qui l'a faite pour moi, il y a passé plein de temps en plus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190411
					],
					"speakerTitle": "Yixian"
				},
				{
					"id": 718190411,
					"content": "Sœurette, le Millelithe va bientôt revenir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190412
					],
					"speakerTitle": "Yizhu"
				},
				{
					"id": 718190412,
					"content": "#Désolé, si vous êtes {M#pressé}{F#pressée}, vous pourrez le trouver par là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yizhu"
				},
				{
					"id": 718190408,
					"content": "Vous ne pouvez pas en faire une autre ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190409
					]
				}
			]
		},
		{
			"id": 7181905,
			"completionStepIds": [
				7181906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
