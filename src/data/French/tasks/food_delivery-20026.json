					"nextDialogs": [
						200260302
					]
				},
				{
					"id": 200260302,
					"content": "Oh ! Mes <color=#00E1FFFF>boulettes de radis frites</color> préparées comme je l'avais demandé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260303
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 200260303,
					"content": "Je le savais, l'œuf fait des merveilles au niveau de la texture et de l'arôme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260304
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 200260304,
					"content": "Hahaha ! Mes goûts en matière de nourriture sont vraiment les meilleurs !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260305
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 200260305,
					"content": "Ah oui. Voici pour vous, merci !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ernest"
