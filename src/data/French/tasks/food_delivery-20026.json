			"dialogs": [
				{
					"id": 200260101,
					"content": "Livraison de repas",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260102
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260102,
					"content": "#Bonjour {M#voyageur}{F#voyageuse} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260103
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260103,
					"content": "Pardon ? Vous ne venez que pour manger ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260104
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260104,
					"content": "Je sais, je sais ! Mais je vous promets que je vous ferai le meilleur repas qui existe si vous m'aidez d'abord !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260105
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260105,
					"content": "Ernest qui travaille au Domaine de l'Aurore commande souvent des plats pour les marier avec un vin. Il nous fait donc souvent des demandes spéciales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260106
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260106,
					"content": "Cette fois-ci, il voudrait des <color=#00E1FFFF>boulettes de radis frites</color> avec un œuf dans la préparation. Malheureusement, je n'en ai plus !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260107
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260107,
					"content": "Si vous pouviez aller me chercher quelques œufs d'oiseau, je vous en serais reconnaissante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260108,
						200260111
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260108,
					"content": "Je pourrais, mais...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200260109
					]
				},
				{
					"id": 200260109,
					"content": "Il y en a plein dans les environs de Ventlevé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260110
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260110,
					"content": "Je compte de nouveau sur vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260111,
					"content": "Je suis ici pour manger, moi. Je meurs de faim !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200260112
					]
				},
				{
					"id": 200260112,
					"content": "Il y en a plein dans les environs de Ventlevé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260113
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260113,
					"content": "Une fois que vous aurez terminé la livraison, je vous récompenserai avec un de nos plats spéciaux ! Promis !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				}
			]
		},
