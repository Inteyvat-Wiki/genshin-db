						200260404
					]
				},
				{
					"id": 200260404,
					"content": "Voyons voir, je compte... La somme y est ! Merci beaucoup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260405
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260405,
					"content": "Pour vous récompenser : un <color=#00E1FFFF>gratin au crabe, jambon et légumes</color> tout droit sorti du four ! Mangez-le tant qu'il est encore chaud.",
