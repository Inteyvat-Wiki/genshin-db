					"content": "Ça fera l'affaire. Une seconde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260203
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260203,
					"content": "C'est prêt ! Allez livrer ces <color=#00E1FFFF>boulettes de radis frites</color> à Ernest tout de suite !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260204
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260204,
					"content": "Pas la peine de me regarder comme ça, je sais que vous mourrez de faim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260205
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260205,
					"content": "Une surprise vous attendra à votre retour !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				}
			]
