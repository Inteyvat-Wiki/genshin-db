			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Klee",
					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401171301,
					"content": "Hé Kaeya, tu as promis de me raconter l'histoire du djinn dans la bouteille si j'étais sage. Tu te rappelles ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171302
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401171302,
					"content": "Ah c'est juste. Où en étais-je arrivé...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171303
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171303,
					"content": "Ah, je me souviens ! Le djinn était sorti et allait manger le jeune berger qui avait ouvert la bouteille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171304
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401171304,
					"content": "Le djinn ouvrit sa grande bouche menaçante, mais le jeune berger eut soudain une idée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171305
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171305,
					"content": "A-t-il jeté une bombe rebondissante dans la bouche du djinn ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171306
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401171306,
					"content": "Haha, je suis sûr que c'est ce qu'il aurait fait s'il en avait eu une.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171307
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171307,
					"content": "Mais le jeune berger n'avait rien de tel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171314
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171314,
					"content": "Il dit au génie : « Attends, comment ton corps massif peut-il tenir dans une si petite bouteille ? Je ne le croirai jamais à moins de l'avoir vu de mes propres yeux ! »...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171308
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171308,
					"content": "Le djinn se mit en colère et dit : « Mouahaha. Ignorant, tu oses remettre en question mes pouvoirs ?! »...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171309
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171309,
					"content": "Le djinn retourna alors à l'intérieur de la bouteille, et le garçon s'empressa de la refermer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171310
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171310,
					"content": "Youpi ! Ça veut dire que le djinn ne reviendra plus jamais !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171311
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401171311,
					"content": "Mais il arrive à dormir dans une si petite bouteille, le djinn ? Ce n'est probablement pas très confortable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171312
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401171312,
					"content": "Non, mais il a été capturé et enfermé dans la bouteille parce qu'il a fait beaucoup de mauvaises choses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171313
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171313,
					"content": "Donc, ce qu'il faut retenir, c'est que si tu fais quelque chose de mal et que tu ne veux pas être enfermée, tu ne dois pas te faire prendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171314
					],
					"speakerTitle": "Kaeya"
				}
			]
		},
		{
			"id": 4011714,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
