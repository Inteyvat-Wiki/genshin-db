			"trigger": {
				"objectNames": [
					"Collei",
					"Eula"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401171401,
					"content": "Klee a dit qu'ils avaient découvert de mystérieux rails sur lesquels vous pouvez rouler à l'aide d'un « chariot tchou-tchou super amusant ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171402
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401171402,
					"content": "Ah, j'ai entendu quelque chose à ce sujet aussi. Apparemment, c'est un chariot qui file sur un parcours « terrifiant » à une vitesse « incontrôlable »...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171403
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401171403,
					"content": "Oui, ça doit être ça. Il semble que lorsque le chariot roule sur une pente abrupte, votre corps commence à flotter comme s'il était en apesanteur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171404
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401171404,
					"content": "Vraiment ? Hmm, j'ai entendu dire que le sac de Klee avait failli s'envoler pendant le trajet. Si Kaeya n'avait pas réussi à l'attraper rapidement, d'innombrables bombes rebondissantes auraient été projetées en l'air.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171405
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401171405,
					"content": "Oh non, ça a l'air plutôt dangereux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171406
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401171406,
					"content": "*soupir* Mais si vous voulez vraiment faire un tour, je vous accompagnerai si j'ai le temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171407
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401171407,
					"content": "Hein ? Mais Eula, comment avez-vous su...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171408
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401171408,
					"content": "C'est évident que vous voulez essayer... Mais que ce soit clair, je ne vous aiderai pas à ramasser quoi que ce soit qui s'envole pendant le trajet. Veillez donc à vider vos poches avant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171409
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401171409,
					"content": "Ah oui, bien sûr !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Collei"
				}
			]
		},
		{
