					"content": "Qui aurait cru que je me retrouverais dans un tel pétrin... Alors que j'avais dit à Alice que sa fille pouvait me rendre visite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171502
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401171502,
					"content": "Mais comme l'a dit la générale... Si nous pouvons restaurer le domaine, alors...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Idyia"
				}
