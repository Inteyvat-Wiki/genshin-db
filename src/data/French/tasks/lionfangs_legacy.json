			"trigger": {
				"objectNames": [
					"Brutocollinus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101120601,
					"content": "Regardez, c'est l'<color=#00E1FFFF>Écu éclatant de l'honneur</color> !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120602
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120602,
					"content": "N'importe quoi ! C'est juste une planche en bois !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120603,
					"content": "Un bout de bois pourri avec une poignée... Qui l'utiliserait comme bouclier ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120604,
					"content": "Et puis elle est couverte de taches d'alcool... Je suis sûr qu'elle vient d'un tonneau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120605
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101120605,
					"content": "Certes. Mais mon intuition de barde me dit qu'il s'agit bien là du fameux Écu éclatant de l'honneur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120606
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120606,
					"content": "On juge un guerrier aux cicatrices qu'il arbore ; il en va de même pour un bouclier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120607
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120607,
					"content": "Un bouclier intact est un bouclier qui n'a pas vu le champ de bataille. Mais un bouclier abîmé et usé, n'est-ce pas là la preuve d'une existence passée au combat ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120608
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120608,
					"content": "Le vrai combattant se bat jusqu'à la fin, même quand il est à bout de force, jusqu'à n'avoir plus de sang à offrir. Une telle volonté n'est-elle pas l'image même de l'honneur ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120609,
						101120610,
						101120611
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120609,
					"content": "Venti a raison !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120612
					]
				},
				{
					"id": 101120612,
					"content": "C'est pas faux... Un bouclier qui a servi ne peut pas être comme neuf...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120613,
					"content": "Bon, dans ce cas... Peut-être que si on demande gentiment, on pourrait récupérer ce fameux bouclier ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120614,
					"content": "Ahem, bien le bonjour, monsieur le Brutocollinus !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120615,
					"content": "Dala ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120616
					],
					"speakerTitle": "Brutocollinus"
				},
				{
					"id": 101120616,
					"content": "#Euh, {NICKNAME}, je te laisse t'en occuper. Essaye de voir si tu peux utiliser des mots Brutocollinus, tu en as déjà entendu... Ou alors peut-être avec le langage du corps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120617,
						101120618,
						101120619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120617,
					"content": "Je t'échange ton bouclier contre des moras.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120622
					]
				},
				{
					"id": 101120622,
					"content": "Biadam !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120623
					],
					"speakerTitle": "Brutocollinus"
				},
				{
					"id": 101120623,
					"content": "Hum, je crois qu'<color=#00E1FFFF>il n'est pas très content</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120624,
						101120625,
						101120626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120624,
					"content": "Tiens, cette fleur sucrante est pour toi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120627
					]
				},
				{
					"id": 101120627,
					"content": "Mosi mita !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120628
					],
					"speakerTitle": "Brutocollinus"
				},
				{
					"id": 101120628,
					"content": "On dirait que <color=#00E1FFFF>ça marche pour l'instant</color>, on peut peut-être continuer d'essayer de communiquer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120631,
						101120633
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120631,
					"content": "Venti, chante. Toi, donne-moi le bouclier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120632
					]
				},
				{
					"id": 101120632,
					"content": "Hein ? Soit... En ce cas je vais jouer un morceau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120634
					],
					"speakerTitle": "Venti"
				},
