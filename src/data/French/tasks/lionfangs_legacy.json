						101120633
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120626,
					"content": "Kucha pupu gusha ye !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120629
					]
				},
				{
					"id": 101120618,
					"content": "J'aimerais que tu nous donnes ton bouclier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120622
					]
				},
				{
					"id": 101120619,
					"content": "Vin plata dada !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120620
					]
				},
				{
					"id": 101120620,
					"content": "Mosi mita !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120621
					],
					"speakerTitle": "Brutocollinus"
				},
				{
					"id": 101120621,
					"content": "On dirait que <color=#00E1FFFF>ça marche pour l'instant</color>, on peut peut-être continuer d'essayer de communiquer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120624,
						101120625,
						101120626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120610,
					"content": "Moi aussi, je crois qu'il s'agit bien du bouclier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120612
					]
				},
				{
					"id": 101120611,
					"content": "Bien vu, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120612
					]
				}
			]
		},
