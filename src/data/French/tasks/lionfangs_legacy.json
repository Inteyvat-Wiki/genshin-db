			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101121001,
					"content": "Merci, merci infiniment ! On les a vraiment trouvés !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121002
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101121002,
					"content": "Papa ! Maman ! Regardez les armes légendaires que j'ai trouvées !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121003
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101121003,
					"content": "Hé, attends !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121004
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121004,
					"content": "Et le vin que tu avais promis ? Tu sais, ça n'a pas été une partie de plaisir, et—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121005
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121005,
					"content": "Tiens, Stanley ? Que faites-vous par ici ? Envie de prendre l'air ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121006
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121006,
					"content": "Oh, ah... Hahahaha, héhé... Qu—Qu'est-ce que vous faites ici, barde ? Vous, euh... vous prenez l'air vous aussi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121007
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101121007,
					"content": "En effet, rien de tel qu'une petite balade digestive ; on en a profité pour aider un ami à chercher quelque chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121008
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121008,
					"content": "(Plus ça va et plus je me dis que Stanley est peut-être un sacré menteur...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121009,
						101121010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101121009,
					"content": "(Moi aussi...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101121011
					]
				},
				{
					"id": 101121011,
					"content": "(Alors Stanley serait venu avant nous pour placer l'épée et le bouclier, pour ne pas faire de peine à Jack ?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101121012,
					"content": "Un aventurier comme vous doit sûrement connaître la Vallée Dadaupa comme sa poche non ? Après tout, vous vous êtes déjà battus dans les environs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121013
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121013,
					"content": "Ah, bien sûr, bien sûr ! Je retrouverais mon chemin les yeux fermés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121014
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101121014,
					"content": "Ah, c'est admirable, sans aucun doute. Une telle mémoire, et une telle persévérance...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121015
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121015,
					"content": "C'est ce qu'on attend d'un grand aventurier tel que moi ! Mais vous devriez faire attention : le coin est plein de Brutocollinus !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121016
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101121016,
					"content": "Enfin, je... Hum, je vais y aller maintenant. Au revoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121017
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101121017,
					"content": "Il n'a définitivement pas l'esprit tranquille, hein...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121018
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101121018,
					"content": "Que veux-tu... Personne ne lui a demandé de raconter des bêtises à Jack.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121019
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121019,
					"content": "Enfin... Je dois dire que je suis quand même assez intrigué.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121020
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121020,
					"content": "Voilà quelqu'un incapable de laisser le passé derrière lui, et qui en abandonne le présent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121021
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121021,
					"content": "Je me demande... Quel chemin prendrait-il, s'il n'avait d'autre choix que de faire face au présent ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121022
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121022,
					"content": "Comment ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121023
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101121023,
					"content": "Haha, je me parle à moi-même, c'est tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121024
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121024,
					"content": "#Ah oui, j'allais oublier, {NICKNAME}. Allons faire un tour au <color=#00E1FFFF>Cadeau de l'Ange</color> ce soir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121010,
					"content": "#(J'en suis même {M#sûr}{F#sûre}.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101121011
					]
				}
			]
