					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101120401,
					"content": "Regardez, la fameuse <color=#00E1FFFF>Épée brillante de vaillance</color> !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120402
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120402,
					"content": "Non... Quand même pas ? Ça m'a l'air d'être juste une épée de base, et en mauvais état qui plus est !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120403,
					"content": "Pourquoi les Brutocollinus se sont-ils mis à adorer un truc comme ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120404,
					"content": "(Hum... On dirait bien que quelqu'un a jeté une vieille épée sur ce tas que les Brutocollinus vénéraient...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120405
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120405,
					"content": "Hein ? Mais c'est une épave ! Et tellement quelconque... Je ne sais pas quoi dire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120406
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101120406,
					"content": "Dis-moi, Jack... As-tu déjà entendu par hasard parler des papillons cristallins Anémo ? On en trouve dans la campagne autour de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120407
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120407,
					"content": "De jour, tu n'y prêterais pas plus attention que ça. Mais à la nuit tombée... C'est une autre affaire : leur éclat est sublime, et on dirait vraiment de vrais cristaux volant dans l'air.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120408
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120408,
					"content": "Il en va de même avec la vaillance, ne trouves-tu pas ? Quand tout va bien, le courage ne sert à rien ; mais qu'une épreuve se présente, et c'est la vaillance qui te permet de t'en sortir – un peu à la manière d'une lumière te guidant hors des ténèbres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120409,
						101120410,
						101120411
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120409,
					"content": "Tu sais vraiment manier les mots.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120412
					]
				},
				{
					"id": 101120412,
					"content": "Tu... Tu as raison ! C'est comme tu dis ! C'est bien l'Épée brillante de vaillance !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120413
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101120413,
					"content": "Bien, une de trouvée. Ne reste plus que le bouclier à présent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120414
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120414,
					"content": "Allons explorer les environs ; elle est sûrement quelque part dans la <color=#00E1FFFF>Vallée Dadaupa</color> et— Hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120415
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120415,
					"content": "Il y a quelqu'un !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120416,
					"content": "Stanley ? Que peut-il donc bien faire ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120417
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120417,
					"content": "Il a l'air bizarre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120418,
					"content": "Qu'est-ce qu'il a ? Pourquoi est-ce qu'il s'est arrêté comme ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120419
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101120419,
					"content": "Il n'a rien. C'est juste une belette voleuse qui est passée par là à balancer des moras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120420
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120420,
					"content": "Hein ? Où ça ? Je veux le voir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120421
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101120421,
					"content": "Tu n'étais pas venu chercher un bouclier ? Tu feras ça un autre jour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120410,
					"content": "Surprenante déclaration.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120412
					]
				},
				{
					"id": 101120411,
					"content": "J'y croirais presque...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120412
					]
				}
			]
		},
		{
			"id": 1011206,
			"completionStepIds": [
				1011206
			],
