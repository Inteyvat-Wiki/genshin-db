			"dialogs": [
				{
					"id": 111240101,
					"content": "Cette stèle a été érigée par l'Adepte Taille-Monts. L'inscription décrit Azhdaha comme un terrible dragon, et met en garde les générations futures : restez à distance de cet endroit... et de ce sceau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111240102
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111240102,
					"content": "Ah... La ligne séparant le bien du mal est ténue. S'il fallait résumer le bien et le mal qui habitent Azhdaha en une phrase... Celle-ci ferait bien l'affaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111240103
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111240103,
					"content": "(Zhongli se tient sous l'arbre...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111240104
					]
				},
				{
					"id": 111240104,
					"content": "(Le calme environnant n'est troublé que par la douce mélodie du vent. Le temps semble devenir une rivière invisible, qui s'écoule paisiblement...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111240105
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111240105,
					"content": "(Un moment fugace, mille ans dans le monde des mortels. La pierre peut le sentir, tout comme la terre et les dieux.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				}
			]
		},
