	"talks": [
		{
			"id": 7000102,
			"completionStepIds": [
				7000102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7000102",
							"2"
						],
						"stepId": 7000102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Val"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700010201,
					"content": "#Ah, {M#voyageur}{F#voyageuse}, on se croise à nouveau. Vous sentez l'ambiance qui règne en ville ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010202
					],
					"speakerTitle": "Val"
				},
				{
					"id": 700010202,
					"content": "C'est sympa, oui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010203
					]
				},
				{
					"id": 700010203,
					"content": "Oui, c'est bien. Cependant... Bien que cela ne corresponde pas tout à fait avec l'ambiance festive, pourriez-vous m'aider avec quelque chose en rapport avec la Fête des alizées ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010204
					],
					"speakerTitle": "Val"
				},
				{
					"id": 700010204,
					"content": "Pour être plus précise, « ce monsieur » aimerait votre aide pour une certaine affaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010205
					],
					"speakerTitle": "Val"
				},
				{
					"id": 700010205,
					"content": "N'est-ce pas mal vu de demander de l'aide à quelqu'un pendant la Fête des alizées ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010206
					]
				},
				{
					"id": 700010206,
					"content": "Oh, ne vous inquiétez pas pour ça. Cette requête n'entre pas dans le cadre habituel du festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010207
					],
					"speakerTitle": "Val"
				},
				{
					"id": 700010207,
					"content": "Comme vous l'avez sûrement remarqué, la Fête des alizées est une période très animée. Les gens vont et viennent, se passent et se bousculent... Presque tout le monde est immergé dans l'ambiance festive. Les chevaliers de l'Ordre sont donc trop occupés au maintien de l'ordre pour prêter attention à autre chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010208
					],
					"speakerTitle": "Val"
				},
				{
					"id": 700010208,
					"content": "Des foules sans défense, des chevaliers débordés... Pour ces Pilleurs de trésors, c'est l'occasion rêvée de faire basse besogne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010209
					],
					"speakerTitle": "Val"
				},
				{
					"id": 700010209,
					"content": "Selon les renseignements de « ce monsieur », plusieurs Pilleurs de trésors ont déjà profité du brouhaha ambiant pour s'infiltrer en ville. Ils s'activent déjà au milieu des échoppes, feignant de profiter de la fête, alors qu'ils ne font en fait que du repérage pour leurs bassesses futures.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010210
					],
					"speakerTitle": "Val"
				},
				{
					"id": 700010210,
					"content": "Si les chevaliers se mobilisent en nombre pour les débusquer, ça alertera les Pilleurs de trésors, et ça ruinera également l'ambiance. Pourtant, on ne peut pas les laisser agir à leur guise...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010211
					],
					"speakerTitle": "Val"
				},
				{
					"id": 700010211,
					"content": "Et c'est donc là que j'entre en jeu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010212
					]
				},
				{
					"id": 700010212,
					"content": "Bien sûr. « Ce monsieur » a spécifiquement demandé votre aide pour cette affaire. Selon lui, vous êtes la meilleure personne pour cette tâche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010213
					],
					"speakerTitle": "Val"
				},
				{
					"id": 700010213,
					"content": "Bon, venons-en aux faits. Selon les renseignements que j'ai collectés, les Pilleurs de trésors infiltrés transportent tous un <color=#00E1FFFF>petit sac</color> pour pouvoir se reconnaître entre eux. De plus, ils utilisent un <color=#00E1FFFF>mot de passe</color> pour s'identifier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010214
					],
					"speakerTitle": "Val"
				},
				{
					"id": 700010214,
					"content": "<color=#00E1FFFF>« Quand le vent souffle les fleurs, c'est là que doivent faire attention les spectateurs »</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010215,
						700010216
					],
					"speakerTitle": "Val"
				},
				{
					"id": 700010215,
					"content": "C'est facile à retenir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010217
					]
				},
				{
					"id": 700010217,
					"content": "Si quelqu'un connaît la fin de cette phrase, ça signifie que c'est un de ces Pilleurs de trésors infiltrés. Avec un peu de chance, l'un d'eux vous dévoilera l'emplacement de leur base.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010218
					],
					"speakerTitle": "Val"
				},
				{
					"id": 700010218,
					"content": "Une fois cette information obtenue, profitez-en pour vous occuper d'eux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010219
					],
					"speakerTitle": "Val"
				},
				{
					"id": 700010219,
					"content": "Et je ne peux pas simplement le dire aux chevaliers ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010220
					]
				},
				{
					"id": 700010220,
					"content": "Eh bien, ils sont déjà épuisés à force de maintenir l'ordre pendant le festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010221
					],
					"speakerTitle": "Val"
				},
				{
					"id": 700010221,
					"content": "Dans des moments comme ceux-ci, cela va sans dire qu'il est préférable d'alléger un peu leur fardeau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010222
					],
					"speakerTitle": "Val"
				},
				{
					"id": 700010222,
					"content": "Bien, nous comptons sur vous, chevalier honoraire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Val"
				},
				{
					"id": 700010216,
					"content": "Ça leur ressemble bien...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010217
					]
				}
			]
		},
		{
			"id": 7000103,
			"completionStepIds": [
				7000103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
