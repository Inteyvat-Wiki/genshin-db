				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Citoyen agité"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700010401,
					"content": "Oui ? Qu'est-ce qu'il y a ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010402
					],
					"speakerTitle": "Citoyen agité"
				},
				{
					"id": 700010402,
					"content": "« Quand le vent souffle les fleurs... »",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010403
					]
				},
				{
					"id": 700010403,
					"content": "Du vent ? Des fleurs ? Vous voulez dire des pissenlits ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010404
					],
					"speakerTitle": "Citoyen agité"
				},
				{
					"id": 700010404,
					"content": "Et alors ? Il n'y a pas de problème, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010405
					],
					"speakerTitle": "Citoyen agité"
				},
				{
					"id": 700010405,
					"content": "#Oh, {M#désolé}{F#désolée} de vous importuner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700010406,
					"content": "Eh bien, ce n'est qu'un honnête citoyen, on dirait. Bon, allons demander à quelqu'un d'autre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7000105,
			"completionStepIds": [
				7000107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7000107",
							"2"
						],
						"stepId": 7000107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Citoyen abattu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700010501,
					"content": "Je me demande si j'ai encore une chance...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010502
					],
					"speakerTitle": "Citoyen abattu"
				},
				{
					"id": 700010502,
					"content": "Hein ? Qu'est-ce que vous voulez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010503
					],
					"speakerTitle": "Citoyen abattu"
				},
				{
					"id": 700010503,
					"content": "« Quand le vent souffle les fleurs... »",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010504
					]
				},
				{
					"id": 700010504,
					"content": "Oui, c'est vrai, c'est cette période de l'année. Je sais, je sais, je devrais profiter de la fête, c'est ça hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010505
					],
					"speakerTitle": "Citoyen abattu"
				},
				{
					"id": 700010505,
					"content": "Eh bien, ce n'est pas faux. Pourquoi déprimer simplement parce qu'on a été rejeté... La fête n'est pas encore terminée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010506
					],
					"speakerTitle": "Citoyen abattu"
				},
				{
					"id": 700010506,
					"content": "Merci pour vos encouragements. Je vais me reprendre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010507
					],
					"speakerTitle": "Citoyen abattu"
				},
				{
					"id": 700010507,
					"content": "#On dirait qu'il nous a mal {M#compris}{F#comprises}. Au moins, il n'était pas suspect...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7000106,
			"completionStepIds": [
				7000111
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7000111",
							"2"
						],
						"stepId": 7000111,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Val"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700010601,
					"content": "Qu'est-il arrivé aux Pilleurs de trésors ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010602
					],
					"speakerTitle": "Val"
				},
				{
					"id": 700010602,
					"content": "C'est de l'histoire ancienne.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010603
					]
				},
				{
					"id": 700010603,
					"content": "#Ah, comme prévu de la part du chevalier honoraire. Bien joué ! La façon dont vous avez tiré les vers du nez de ce Pilleur de trésors aussi, du joli travail... Comme on pouvait s'y attendre de {M#celui}{F#celle} qui plaît tant à « ce monsieur ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010604
					],
					"speakerTitle": "Val"
				},
				{
					"id": 700010604,
					"content": "Euh, vous... Vous me surveilliez ?",
