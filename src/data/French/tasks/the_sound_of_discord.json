			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Citoyen suspect"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700010301,
					"content": "Il y a vraiment de l'animation partout. C'est merveilleux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010302
					],
					"speakerTitle": "Citoyen suspect"
				},
				{
					"id": 700010302,
					"content": "« Quand le vent souffle les fleurs... »",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010303
					]
				},
				{
					"id": 700010303,
					"content": "Hein ? Oh... « C'est là que doivent faire attention les spectateurs ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010304
					],
					"speakerTitle": "Citoyen suspect"
				},
				{
					"id": 700010304,
					"content": "Tu es donc des nôtres. Tu arrives juste à temps : j'ai repéré une paire de petits tourtereaux insouciants. Et si on allait à la pêche aux moras, hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010305
					],
					"speakerTitle": "Citoyen suspect"
				},
				{
					"id": 700010305,
					"content": "Tu attires leur attention, et moi, je m'empare de leur bourse. Et une fois que c'est fait, on retourne à Ventlevé pour retrouver les autres. Je me demande ce qu'ils ont attrapé de beau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010306
					],
					"speakerTitle": "Citoyen suspect"
				},
				{
					"id": 700010306,
					"content": "Mais avant ça, tu vas devoir faire un petit tour avec moi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010307
					]
				},
				{
					"id": 700010307,
					"content": "Hein ! Mais attends, tu n'es pas un Pilleur de trésors. Qui es-tu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010308
					],
					"speakerTitle": "Citoyen suspect"
				},
				{
					"id": 700010308,
					"content": "Juste un chevalier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010309
					]
				},
				{
					"id": 700010309,
					"content": "Eh bien, comme ça l'Ordre de Favonius va s'occuper de ce type. Mais je me demande comment les chevaliers sont arrivés si vite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700010310,
					"content": "Ma foi, peu importe. Bon, il a dit qu'il fallait aller à Ventlevé pour retrouver les autres, non ? On y va.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7000104,
			"completionStepIds": [
				7000106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
