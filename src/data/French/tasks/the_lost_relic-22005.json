					"nextDialogs": [
						220050303
					]
				},
				{
					"id": 220050303,
					"content": "Hum, non, c'est... c'est trop léger, ma relique historique ne peut pas être là-dedans...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050304
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050304,
