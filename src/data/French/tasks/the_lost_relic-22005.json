				"points": []
			},
			"dialogs": [
				{
					"id": 220050101,
					"content": "Où peut-il bien être...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050102
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050102,
					"content": "Qu'est-ce que tu fais ici ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050103
					]
				},
				{
					"id": 220050103,
					"content": "Oh, d'où tu sors ?! Tu m'as fait peur !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050104
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050104,
					"content": "Moi ? Je... fais des recherches sur l'architecture et les reliques des Plaines Guili. Tu peux m'appeler Bao'er.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050105
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050105,
					"content": "J'étais tellement absorbée par mes recherches que j'ai perdu le paquet que j'avais avec moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050106
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050106,
					"content": "Il y avait un tré... un très vieil objet historique à l'intérieur et euh... hum. Tu m'aiderais à le retrouver ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050107,
						220050108,
						220050109
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050107,
					"content": "Pas de problème.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050110
					]
				},
				{
					"id": 220050110,
					"content": "Ah, parfait, parfait ! J'ai dû le perdre dans le coin, ou un peu plus loin. Enfin, jette un œil, tu devrais le trouver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050108,
					"content": "À quoi ressemble le paquet ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050111
					]
				},
				{
					"id": 220050111,
					"content": "C'est un paquet classique, quoi... Quatre faces, un haut et un bas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050112
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050112,
					"content": "Pourquoi j'y ai mis une ancienne relique, me demanderas-tu ? Eh bien, parce que euh... c'est pratique !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050113
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050113,
					"content": "Et puis, j'y ai mis pas mal de vêtements, ça protégera le, euh, l'objet. Allez, aide-moi vite !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050109,
					"content": "Quel genre d'objet est-ce donc ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050114
					]
				},
				{
					"id": 220050114,
					"content": "Hum, c'est un euh, truc historique quoi ! Tu ne comprendrais pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050115
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050115,
					"content": "Il faut être une pro comme moi pour comprendre sa valeur. Je t'en prie, j'aurais bien besoin d'un coup de main !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				}
			]
		},
