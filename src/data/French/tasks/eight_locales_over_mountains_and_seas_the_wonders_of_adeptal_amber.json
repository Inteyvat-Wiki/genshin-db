			"dialogs": [
				{
					"id": 722610101,
					"content": "Taille-Monts !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610102,
					"content": "Paille-Mou !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610103
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610103,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610104,
					"content": "On dirait qu'il n'est pas là. C'est embêtant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610105,
					"content": "Ne manquons pas de respect envers les Adeptes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610106
					]
				},
				{
					"id": 722610106,
					"content": "C'est quoi « Adeptes », Paimon ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610107
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610107,
					"content": "Hmm, ce sont des gens très spéciaux... Ou devrais-je dire des animaux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610108,
					"content": "Comme moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610109
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610109,
					"content": "Non ! Je voulais dire qu'ils ont des pouvoirs magiques...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610110,
					"content": "Ils font « boum boum » et tout ? Je suis aussi Adepte, alors.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610111
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610111,
					"content": "Hum, les Adeptes sont plus « âgés » et ils ont une certaine... prestance ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610112,
					"content": "Oh, Kichiboushi pas Adepte. Ioroi est Adepte !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610113
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610113,
					"content": "Ah... Comment t'expliquer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610114,
					"content": "Les Adeptes sont des êtres anciens qui protègent Liyue...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610115
					]
				},
				{
					"id": 722610115,
					"content": "Kichiboushi comprend. Ioroi protège Forêt de Chinju, donc pas Adepte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610116
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610116,
					"content": "Ce n'est pas exactement comme ça que ça marche, mais bon, le principal, c'est que tu ne te trompes plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610117,
					"content": "Enfin, on est devant la demeure d'un Adepte. Prenons une photo de Kichiboushi ici !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610118,
					"content": "Ouais ! Kichiboushi très sage pour photo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610119
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610119,
					"content": "C'est bien, Kichiboushi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7226102,
			"completionStepIds": [
				7226104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
