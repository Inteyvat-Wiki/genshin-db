			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Kichiboushi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722610201,
					"content": "La photo est géniale !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610202,
					"content": "Mouhaha ! Kichiboushi, c'est le plus beau !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610203
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610203,
					"content": "Ce petit n'a aucune modestie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610204,
					"content": "Oh, Paimon. Adeptes utilisent quoi comme pouvoirs magiques ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610205
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610205,
					"content": "Ils sont très forts ! Par exemple...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610206,
					"content": "Commençons par l'ambre qui se trouve dans le coin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610207
					]
				},
				{
					"id": 722610207,
					"content": "Ambre ? Kézako ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610208
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610208,
					"content": "Ah ! Je m'en souviens, Taille-Monts possède des fleurs qui peuvent produire de l'ambre pour piéger les intrus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610209,
					"content": "Paille-Mou très fort, défend Liyue en piégeant méchants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610210
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610210,
					"content": "Il y a très très longtemps, il y a les quatre Oni d'Ogata qui viennent dans la forêt pour se bagarrer et attaquer les Tanukis. Ioroi se transforme en fonctionnaire et leur donne de la nourriture de Bake-danuki à manger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610211
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610211,
					"content": "Après, Ioroi et Roi Otogi jettent dans du papier pour les sceller.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610212
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610212,
					"content": "Je ne connaissais pas cette histoire. C'est pour ça qu'Ioroi a paniqué en voyant la photo de Kichiboushi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610213,
					"content": "Ioroi n'est pas Adepte, parce qu'il défend pas Liyue, mais il protège forêt et Tanukis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610214
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610214,
					"content": "Chacun a des choses différentes à protéger.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610215
					]
				},
				{
					"id": 722610215,
					"content": "Hmm ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610216
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610216,
					"content": "Tu comprendras quand tu grandiras, Kichiboushi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610217
					]
				},
				{
					"id": 722610217,
					"content": "C'est pour ça que tu dois t'entraîner dur pour devenir un Bake-danuki ultra fort !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610218,
					"content": "Hmm, c'est sûr ! Kichiboushi, le Bake-danuki qui fait trembler la terre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610219
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610219,
					"content": "Je me demande vraiment à quoi ressemblait Ioroi avant d'être scellé ! Il devait sans doute être amusant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610220,
					"content": "Ah, je me souviens de ces Pilleurs de trésors qui étaient emprisonnés dans l'ambre tout à coup...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610221,
					"content": "#Ils avaient même cru qu'on était des «{NON_BREAK_SPACE}{M#messagers}{F#messagères} des Adeptes{NON_BREAK_SPACE}».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610222
					]
				},
				{
					"id": 722610222,
					"content": "J'ai l'impression que c'était il y a une éternité, mais ça ne fait pas si longtemps que ça, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610223,
					"content": "Hmm ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610224
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610224,
					"content": "Ahem, après notre arrivée à Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610225,
					"content": "#« Le rituel de la descente n'a lieu qu'une fois par an ! Haha ! Moi, {NICKNAME}, vais me remplir la panse avec de la bonne nourriture. C'est parti, Paimon ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610226,
					"content": "« Et il y a aussi des offrandes ! Moi, Paimon, je vais immédiatement m'y rendre en volant ! »",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610227
					]
				},
				{
					"id": 722610227,
					"content": "???",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610228
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610228,
					"content": "Arrête de raconter n'importe quoi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610229
					]
				},
				{
					"id": 722610229,
					"content": "D'accord...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610230,
					"content": "Vous racontez ce qu'il s'est passé à Liyue en employant des termes simples.\\nVous arrêtez votre récit au moment où vous avez rendu visite aux Adeptes.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722610231
					]
				},
				{
					"id": 722610231,
					"content": "#... Ensuite, {NICKNAME} et moi sommes {M#allés}{F#allées} au Pavillon Liuli de tout à l'heure pour manger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610232,
					"content": "Paille-Mou et Pouffe-Nuages très forts ! Ils construisent maison qui bouge !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610233
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610233,
					"content": "Pouf... Euh, Souffle-Nuages aime beaucoup la nourriture aussi ! On a dû lui préparer plein de plats avant de la rencontrer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610234,
					"content": "Gourmande, comme Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610235,
						722610236
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610235,
					"content": "Absolument.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610237
					]
				},
				{
					"id": 722610237,
					"content": "Hé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610238,
					"content": "T'es Adepte, Paimon ? Très forte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610239
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610239,
					"content": "Ouah, je ne sais pas comment réagir. Même si c'était un compliment, je ne me sens pas tout à fait à l'aise...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610240
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610240,
					"content": "Par contre, je ne suis pas du tout une Adepte !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610241,
					"content": "Kichiboushi veut jouer avec Adeptes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610242
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610242,
					"content": "Les Adeptes ne se montrent jamais en général... Mais on peut toujours jeter un œil aux alentours, c'est joli ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610243,
					"content": "Kichiboushi, c'est parti !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610236,
					"content": "Elle peut voler aussi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610237
					]
				}
			]
		},
		{
			"id": 7226104,
			"completionStepIds": [
				7226107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
