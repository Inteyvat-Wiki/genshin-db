			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Kichiboushi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722610401,
					"content": "Ouf, on t'a retrouvé ! Tu n'as rien, Kichiboushi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610402,
					"content": "*sniff* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610403
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610403,
					"content": "Ne t'inquiète pas, tout va bien. Ne pars pas tout seul devant la prochaine fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610404,
						722610408,
						722610410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610404,
					"content": "Tu agis comme sa grande sœur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610405
					]
				},
				{
					"id": 722610405,
					"content": "Je suis plus âgée que lui, ça va de soi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610406,
					"content": "On ne dirait pas vraiment...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610407
					]
				},
				{
					"id": 722610407,
					"content": "Hé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610412,
					"content": "#Hmm hmm. Merci {NICKNAME}, merci Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610413
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610413,
					"content": "J'ai cru que j'étais scellé encore. Ça fait peur. Mais je peux entendre Paimon m'appeler, alors j'ai plus peur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610414
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610414,
					"content": "Ah oui, c'est vrai qu'Ioroi nous a dit que des petits Tanukis s'étaient fait sceller...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610415,
					"content": "Dans l'ambre, ça fait peur. C'est tout noir. On voit rien. On peut pas parler, on peut pas bouger, on peut pas badaboum. C'est comme devenir caillou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610416
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610416,
					"content": "Ioroi est caillou, mais très puissant. Il peut parler, voir, mais pas bouger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610417,
						722610420
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610417,
					"content": "Tu voudrais aider Ioroi, Kichiboushi ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610418
					]
				},
				{
					"id": 722610418,
					"content": "Ouais ! Aider les autres Tanukis caillou aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610419
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610419,
					"content": "Mais on est avec toi maintenant Kichiboushi. On ne te laissera pas te faire sceller !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610422,
					"content": "Ouais !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610423
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610423,
					"content": "Mais il faut que tu sois sage, hein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610424,
					"content": "Compris.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610425
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610425,
					"content": "Bien ! Alors, on s'arrête là pour aujourd'hui, d'accord ? Tu dois être fatigué, il faut que tu te reposes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610426,
					"content": "Kichiboushi pas fatigué !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610427
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610427,
					"content": "Ah, quelle plaie ! Si tu n'es pas sage, je ne sais pas où on va aller pour la suite de ton parcours...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610428,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610429
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610429,
					"content": "Kichiboushi admet à contrecœur qu'il est fatigué...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722610430
					]
				},
				{
					"id": 722610430,
					"content": "Pfiou, Kichiboushi ressemble à un petit enfant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610431,
					"content": "Tu t'y prends de mieux en mieux avec les enfants, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610432
					]
				},
				{
					"id": 722610432,
					"content": "Tu trouves ? C'est peut-être parce que ça fait longtemps que je voyage à tes côtés, héhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610433,
						722610435
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610433,
					"content": "C'est moi l'enfant ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610434
					]
				},
				{
					"id": 722610434,
					"content": "Non ! Par contre, on a joué avec beaucoup d'enfants, pas vrai ? Comme Ming et Changchang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610437,
					"content": "J'ai vraiment beaucoup appris en voyageant avec toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610438
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610438,
					"content": "La leçon d'aujourd'hui : les Bane-danuki et les Adeptes ne s'entendraient pas forcément.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610439
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610439,
					"content": "À présent, on doit réfléchir à notre prochaine destination...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610435,
					"content": "En effet, on a dû s'occuper de pas mal d'enfants...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610436
					]
				},
				{
					"id": 722610436,
					"content": "Exactement ! Ming et Changchang, par exemple...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610420,
					"content": "On te protégera.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610421
					]
				},
				{
					"id": 722610421,
					"content": "Oui ! Tu n'as rien à craindre tant qu'on sera avec toi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610408,
					"content": "Tu agis comme sa mère.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610409
					]
				},
				{
					"id": 722610409,
					"content": "Hé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610410,
					"content": "Tu agis comme sa grand-mère.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610411
					]
				},
				{
					"id": 722610411,
					"content": "#« {NICKNAME}, tu dois manger plus. Tu es en pleine croissance. Tu ne vas jamais grandir si tu ne manges pas plus que ça. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610412
					],
					"speakerTitle": "Paimon"
				}
			]
