			"dialogs": [
				{
					"id": 750150601,
					"content": "Cette plage aux eaux peu profondes est superbe ! Il fait chaud, lumineux et il y a d'autres pêcheurs. Peut-être que c'est un bon coin de pêche !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150602,
					"content": "Que dirais-tu de pêcher ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150603,
					"content": "Je vais peut-être attraper une autre guide...",
