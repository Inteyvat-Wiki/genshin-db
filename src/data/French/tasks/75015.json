			"dialogs": [
				{
					"id": 750150501,
					"content": "Ouf, enfin fini... Je vais pouvoir commencer à pêcher !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150502,
					"content": "Tenez-vous prêts, je vais en attraper un gros !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150503,
					"content": "Malheureusement, la surface reste aussi immobile qu'un miroir, il n'y a pas la moindre ondulation.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750150504
					]
				},
				{
					"id": 750150504,
					"content": "Euh... Est-ce que l'eau d'ici est super bonne ? Les poissons ne veulent pas en sortir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150505,
						750150508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150505,
					"content": "À nous la victoire, héhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750150506
					]
				},
				{
					"id": 750150506,
					"content": "Ça y est, « À nous la victoire ! »... C'est faux, ça ne fait que commencer, il reste encore un long chemin à parcourir pour atteindre la victoire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150507,
					"content": "Il est un peu tôt pour me donner espoir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150511,
					"content": "Ouh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150512
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150512,
					"content": "Tu l'as eu, tu as réussi !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750150513
					]
				},
				{
					"id": 750150513,
					"content": "Hé, arrête de me distraire... Sérieusement !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150514,
					"content": "Oh ?! Ça mord, ça mord ! Remontons la ligne pour voir ce que j'ai attrapé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150515,
					"content": "#Qu'est-ce que... Ce n'est pas un poisson, c'est une bouteille ! Et elle est même attachée à l'une des planches de bois du coin de pêche... Euh, heureusement que tu attrapes souvent des choses étranges toi aussi, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150516,
					"content": "On dirait que tu peux attraper n'importe quoi... Sauf du poisson.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750150517
					]
				},
				{
					"id": 750150517,
					"content": "Hé, tu attrapes aussi tout le temps des trucs bizarres ! Et puisque j'ai pêché la bouteille, regardons ce qu'il y a dedans...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150518,
					"content": "Serait-ce ces deux-là qui ont laissé derrière eux ce tas de trucs à l'instant ? Les gens qui sont obsédés par la pêche sont... plutôt effrayants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150519,
					"content": "On dirait qu'ils utilisent cette bouteille pour se transmettre des messages... On ferait mieux de la remettre où nous l'avons trouvée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150520,
					"content": "En tout cas, je sens que ce sera du poisson la prochaine fois !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150521,
					"content": "La canne à pêche plie soudainement vers le bas et commence à être violemment tirée.\\nOn dirait que quelque chose de gros et de lourd des profondeurs a mordu à l'hameçon...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750150522
					]
				},
				{
					"id": 750150522,
					"content": "Ça mord, enfin ! Ça doit être un sacré poisson... Allez, gros morceau, viens me voir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150523,
					"content": "Allez, on le remonte !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750150524
					]
				},
				{
					"id": 750150524,
					"content": "Yaa yaa !!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150525
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150525,
					"content": "#Voyant Paimon se débattre,\\n{REALNAME[ID(2)|SHOWHOST(true)]} et vous la saisissez...\\nMais la ligne est tirée avec une telle force...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750150526
					]
				},
				{
					"id": 750150526,
					"content": "Que dans un puissant fracas, le poisson s'échappe...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750150527
					]
				},
				{
					"id": 750150527,
					"content": "*sniff* Ça devait être énorme, sinon ça n'aurait jamais pu s'échapper !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150528,
					"content": "Ça m'énerve... Quoi ? Il nage encore près de la surface ! Quelle blague !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150529,
					"content": "Yaa yaa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150530
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150530,
					"content": "Non, non et non, la mer est trop dangereuse ! Et de toute façon, tu ne le rattraperas jamais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150531
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150531,
					"content": "Ouh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150532
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150532,
					"content": "#Si seulement il y avait un moyen d'attraper ce poisson, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150508,
					"content": "Ce ne sera pas long, calme-toi !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750150509
					]
				},
				{
					"id": 750150509,
					"content": "Hmm, tu as probablement raison. Après tout, une fois que ça commence à mordre, tout s'accélère. Comme quand on va cueillir une fleur sucrante, mais qu'on tombe sur une Fleur mensongère...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150510,
					"content": "Tout ce que tu as à faire, c'est de rester concentrée et d'attendre... Et attendre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150511
					],
					"speakerTitle": "Paimon"
				}
			]
		},
