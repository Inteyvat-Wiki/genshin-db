			"dialogs": [
				{
					"id": 750150401,
					"content": "#Tada ! Qu'est-ce que je t'avais dit ? Si quelqu'un pouvait prendre le dessus sur cet adversaire insaisissable, c'est bien {NICKNAME} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150402,
					"content": "Maintenant que j'y pense, si on verse tous les appâts d'un coup et qu'on laisse les poissons tellement manger qu'ils remonteraient à la surface... Ça compterait toujours comme de la pêche, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150403,
					"content": "Ha... Ha raouh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150404
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150404,
					"content": "Tu trouves aussi ? Je le vois à ton regard brillant ! Héhé, essayons la prochaine fois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150405,
					"content": "Ha raouh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150406
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150406,
					"content": "#Attends, ce n'est pas encore prêt ! Nous devons d'abord attendre que {NICKNAME} ait fini de le cuisiner !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150407,
					"content": "Une fois le poisson grillé, chacun s'assoit et mange à sa faim.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750150408
					]
				},
				{
					"id": 750150408,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150409
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150409,
					"content": "J'ai l'impression que ce poisson grillé est particulièrement bon. Je n'en attendais pas moins du poisson que j'ai pêché, héhé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150410,
					"content": "Excellent travail, Paimon ! C'est toi qui es responsable de la pêche dorénavant !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750150411
					]
				},
				{
					"id": 750150411,
					"content": "*soupir* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150412,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150413
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150413,
					"content": "Mais ne crois pas que tu vas t'en tirer comme ça. Si tu veux du poisson, il va falloir aider la prochaine fois !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150414,
					"content": "Ouh hmm ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150415
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150415,
					"content": "Hmph, regarde qui fait l'idiot maintenant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
