			"dialogs": [
				{
					"id": 733430101,
					"content": "Ouah, toute cette zone a repris vie en un instant ! Tu es sacrément forte, Sorush !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733430102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733430102,
					"content": "Les pouvoirs des paris sont incroyables.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733430103
					]
				},
				{
					"id": 733430103,
					"content": "Il n'en faut pas beaucoup pour vous surprendre ! Sauver les fleurs de la sunyata n'a rien de difficile pour moi, mes pouvoirs vont bien au-delà de cela !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733430104
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733430104,
					"content": "La corrosion obscure s'étend encore, et ces fleurs de la sunyata ne sont qu'une de ses nombreuses victimes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733430105
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733430105,
					"content": "Les autres bassins de fleurs n'ont pas été épargnés. Sefana doit être très énervée en ce moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733430106
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733430106,
					"content": "Cette Sefana dont tu nous parles, c'est cette pari qui s'occupe assidûment des fleurs ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733430107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733430107,
					"content": "#Et si on allait l'aider, {NICKNAME} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733430108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733430108,
					"content": "Ce genre de petit accomplissement saura agrémenter la grande cause que je sers. Compte tenu de cela, mon yasnapati, je vous demanderai de prendre soin des fleurs de la sunyata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733430109
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733430109,
					"content": "Je te tiendrai au courant quand j'en rencontrerai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733430110
					]
				},
				{
					"id": 733430110,
					"content": "#Oui ! Travaillons {M#tous}{F#toutes} ensemble pour sauver ces jolies fleurs !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
