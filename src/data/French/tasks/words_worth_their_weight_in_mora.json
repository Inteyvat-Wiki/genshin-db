					"Oncle Tian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718050501,
					"content": "#Je peux faire quelque chose pour vous, {M#jeune homme}{F#jeune femme} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050502
					],
					"speakerTitle": "Oncle Tian"
				},
				{
					"id": 718050502,
					"content": "C'est Jifang qui m'envoie vous apporter votre commande de livre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718050503
					]
				},
				{
					"id": 718050503,
					"content": "Euh... Ah, ça me revient. J'avais commandé un exemplaire de « Versets d'Equilibrium ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050504
					],
					"speakerTitle": "Oncle Tian"
				},
				{
					"id": 718050504,
					"content": "C'est en effet cet ouvrage. Je pensais que Jifang avait complètement oublié ma commande !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050505
					],
					"speakerTitle": "Oncle Tian"
				},
				{
					"id": 718050505,
					"content": "Tout va bien maintenant que je l'ai. L'assemblage du livre est de qualité... Cette sacrée Jifang est toujours aussi minutieuse dans son travail de libraire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050506
					],
					"speakerTitle": "Oncle Tian"
				},
				{
					"id": 718050506,
					"content": "Merci ! Je l'emporte avec moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Oncle Tian"
				}
			]
		},
