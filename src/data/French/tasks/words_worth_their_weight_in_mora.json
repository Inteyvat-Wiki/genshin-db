					"Notable Dean"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718050401,
					"content": "#Vous avez quelque chose à me dire, {M#jeune homme}{F#jeune femme} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050402
					],
					"speakerTitle": "Notable Dean"
				},
				{
					"id": 718050402,
					"content": "C'est Jifang qui m'envoie vous apporter votre commande de livre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718050403
					]
				},
				{
					"id": 718050403,
					"content": "Ça fait des lustres que j'ai commandé ce quatrième tome de « L'Archon Invisible » ! Qu'est-ce qui lui a pris autant de temps ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050404
					],
					"speakerTitle": "Notable Dean"
				},
				{
					"id": 718050404,
					"content": "Laissez-moi regarder... Ah, c'est la première édition ! Ça explique tout, alors...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050405
					],
					"speakerTitle": "Notable Dean"
				},
				{
					"id": 718050405,
					"content": "Et moi qui pensais que Jifang avait oublié ma commande...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050406
					],
					"speakerTitle": "Notable Dean"
				},
				{
					"id": 718050406,
					"content": "#Merci de me l'avoir apportée, {M#jeune homme}{F#jeune femme}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Notable Dean"
				}
			]
		},
