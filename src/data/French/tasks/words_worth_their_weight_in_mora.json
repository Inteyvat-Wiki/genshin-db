					"nextDialogs": [
						718050602
					]
				},
				{
					"id": 718050602,
					"content": "Vous les avez livrées ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050603
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718050603,
					"content": "Oui, c'est fait.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718050604
					]
				},
				{
					"id": 718050604,
					"content": "Merci beaucoup. La Librairie Wanwen existe encore aujourd'hui grâce à la fidélité de nos clients de longue date.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050605
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718050605,
					"content": "Ceux-ci sont de véritables férus de livres. Ils devraient être heureux d'avoir de bons ouvrages sous la main.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050606
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718050606,
					"content": "#Merci encore pour votre aide, {M#voyageur}{F#voyageuse}. Prenez ceci en guise de remerciement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050607
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718050607,
					"content": "N'hésitez pas à venir me voir si un livre vous intéresse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jifang"
				}
			]
		},
