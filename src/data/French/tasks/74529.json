			"dialogs": [
				{
					"id": 745290401,
					"content": "#Ah, {NICKNAME}, te voilà. Contente de te voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290402,
						745290403
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290402,
					"content": "Citlali, ça faisait longtemps.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290404
					]
				},
				{
					"id": 745290404,
					"content": "Eh bien, il m'arrive aussi de sortir me promener de temps en temps, figure-toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290405
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290405,
					"content": "Et puis, hier soir, les augures m'ont prédit que si je sortais aujourd'hui, il m'arriverait de bonnes choses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290406
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290406,
					"content": "Et voilà, à peine sortie de chez moi que la chance me sourit déjà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290407,
						745290408
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290407,
					"content": "Que la chance soit doublement avec nous !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290409
					]
				},
				{
					"id": 745290409,
					"content": "Pourquoi pas... mais j'ai passé une nuit blanche avant-hier pour finir de lire le dernier tome de mon roman léger !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290410
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290410,
					"content": "Regarde-moi un peu, ça va ma tête ? Mes cernes doivent avoir disparu, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290411,
						745290412
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290411,
					"content": "Vous avez l'air aussi en forme que d'habitude.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290413
					]
				},
				{
					"id": 745290413,
					"content": "C'est vrai ? Tu n'as pas intérêt à me mentir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290414
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290414,
					"content": "Je te préviens, je garde toutes les photos ratées... Et je te donne uniquement la plus belle du lot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290412,
					"content": "Vous rayonnez littéralement !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290413
					]
				},
				{
					"id": 745290408,
					"content": "Laissez-moi vous prendre en photo !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290409
					]
				},
				{
					"id": 745290403,
					"content": "C'est étonnant, vous n'êtes pas chez vous à faire la grasse matinée ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290404
					]
				}
			]
		}
	]
