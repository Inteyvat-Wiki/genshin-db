			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kayabuki Ikkei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726600101,
					"content": "#Bonjour {M#étranger}{F#étrangère} ! Ça vous dit de croiser un peu le fer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600102,
						726600104
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600102,
					"content": "#Je suis {M#un habitué}{F#une habituée} des combats.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600103
					]
				},
				{
					"id": 726600103,
					"content": "Génial ! Je ne m'étais donc pas trompé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600106
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600106,
					"content": "Voilà : récemment, certaines personnes ont de nouveau organisé un Hyakunin Ikki en secret.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600107,
						726600109
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600107,
					"content": "Vous voulez dire le Hyakunin Isshu ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600108
					]
				},
				{
					"id": 726600108,
					"content": "Non, « Hyakunin Ikki ». Je ne sais pas ce qu'est ce « Hyakunin Isshu »...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600110
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600110,
					"content": "Cette pratique a été initiée par les Tengunites, qui imitaient les Tengu. En résumé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600111
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600111,
					"content": "Quand les temps étaient durs, qu'ils n'avaient pas le moral, qu'un événement heureux s'était produit ou tout simplement s'ils s'ennuyaient...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600112
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600112,
					"content": "Ils avaient l'habitude de se lancer dans des combats acharnés que ce soit pour célébrer ou se débarrasser de la malchance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600113
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600113,
					"content": "Ça peut arriver n'importe quand alors...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600114
					]
				},
				{
					"id": 726600114,
					"content": "... Oui, en effet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600115
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600115,
					"content": "Quoi qu'il en soit, trouvons un autre endroit pour discuter de ça. Il y a trop de monde ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600109,
					"content": "Je vous écoute.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600110
					]
				},
				{
					"id": 726600104,
					"content": "Vous avez une mission pour moi ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600105
					]
				},
				{
					"id": 726600105,
					"content": "On ne peut pas vraiment appeler ça une mission, mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600106
					],
					"speakerTitle": "Kayabuki Ikkei"
				}
			]
		},
		{
			"id": 7266002,
			"completionStepIds": [
				7266002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7266002",
							"2"
						],
						"stepId": 7266002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kayabuki Ikkei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726600201,
					"content": "On est arrivés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600202
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600202,
					"content": "Vous pouvez entrer au dojo du Hyakunin Ikki seulement par cette porte un peu bizarre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600203,
						726600204
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600203,
					"content": "Oh, c'est excitant.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600205
					]
				},
				{
					"id": 726600205,
					"content": "Les Tengunites ont été dissous pour trouble à l'ordre et la moralité publics, mais certains continuent d'organiser le tournoi Hyakunin Ikki de temps en temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600206
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600206,
					"content": "Monstres, aventuriers et guerriers du monde entier ayant soif de combat se retrouvent ici pour se livrer à des batailles épiques dans cette arène.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600207
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600207,
					"content": "N'hésitez pas à ramener vos amis aussi. Après tout, plus on est de fous, plus on rit !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600208
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600208,
					"content": "#Vous semblez être {M#un aventurier}{F#une aventurière} qui a voyagé aux quatre coins du monde. Je suis certain que vous devez avoir beaucoup de compagnons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600209
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600209,
					"content": "Vous ne participez pas ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600210
					]
				},
				{
					"id": 726600210,
					"content": "Moi ? Si, comme spectateur ! Je vous encouragerai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600211
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600211,
					"content": "À vrai dire, mon objectif est d'écrire le roman de combat le plus palpitant et de gagner le premier prix du concours « Ce roman est génial ! » de la Chambre Yae.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600212
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600212,
					"content": "Mon instinct me dit que vous serez l'étoile la plus brillante dans l'arène.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600213,
						726600214
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600213,
					"content": "Je ferai de mon mieux.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600215
					]
				},
				{
					"id": 726600215,
					"content": "#D'ailleurs, j'ai déjà donné un nom à ce roman : « Hyakunin Ikki - Le tournoi des meilleurs combattants ». Si vous le voyez chez les éditions de la Chambre Yae un jour, n'oubliez pas de lire le passage qui raconte l'apparition remarquée d'{M#un étranger blond}{F#une étrangère blonde} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600216
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600216,
					"content": "J'ai hâte de voir comment vous vous en sortirez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600214,
					"content": "Bien évidemment.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600215
					]
				},
				{
					"id": 726600204,
					"content": "C'est un peu louche votre truc.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600205
					]
				}
			]
		}
	]
}