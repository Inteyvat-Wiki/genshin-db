			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Risutaiosu",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722450401,
					"content": "Plus un geste !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450402
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450402,
					"content": "Hé ! Stop ! Je vous ai dit de ne pas bouger !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450403
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450403,
					"content": "Je ne peux pas m'arrêter de bouger...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450404,
						722450405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450404,
					"content": "Si on demande à Paimon de ne plus bouger...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722450406
					]
				},
				{
					"id": 722450406,
					"content": "Jamais !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450407,
					"content": "Hum, d'accord. Tournez-vous ? Je n'ai jamais vu de tels accoutrements.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450408
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450408,
					"content": "Ils sont un peu moches, mais intéressants malgré tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450409
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450409,
					"content": "Si tu les trouves aussi moches, pourquoi t'embêter à les regarder...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450410,
					"content": "Vraiment, c'était plus facile de demander aux servantes de poser pour moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450411
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450411,
					"content": "Mais je me suis lassé de l'apparence des habitants de Byakuyakoku et de la manière dont ils s'habillent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450412
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450412,
					"content": "La façon dont vous vous habillez est unique dans le coin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450413
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450413,
					"content": "Oh, je vois. C'est donc comme ça que ces vêtements sont conçus... Vous, les étrangers, êtes vraiment sans vergogne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450414
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450414,
					"content": "D'accord... Si les vêtements sont taillés ainsi, alors la forme du corps devrait être comme ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450415
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450415,
					"content": "Qu'est-ce que tu fais ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450416,
					"content": "Je sculpte. Je mélange de la boue à de l'eau, puis je modèle le tout avec mes deux mains. Il n'y a que dans ces moments que je me sens calme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450417
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450417,
					"content": "Et vous savez ce qui ne me calme absolument pas ? Assister à l'assemblée régulière et devoir lire à haute voix des textes écrits par des adultes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450418
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450418,
					"content": "... Ça y est, votre silhouette a aussi fini par me lasser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450419
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450419,
					"content": "Arrêtez de me déranger maintenant. Faites ce que vous aviez à faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450405,
					"content": "Est-ce qu'elle tombe ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722450406
					]
				}
			]
		},
		{
			"id": 7224505,
			"completionStepIds": [
				7224505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224505",
							"2"
						],
						"stepId": 7224505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ion",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722450501,
					"content": "#Ouh là ! {M#Voyageur}{F#Voyageuse}, vous en faites une mine ! Venez voir par là, je vais lire votre avenir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450502
					],
					"speakerTitle": "Ion"
				},
				{
					"id": 722450502,
					"content": "Je suis Ion, celui qui ne rate jamais ses prédictions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450503
					],
					"speakerTitle": "Ion"
				},
				{
					"id": 722450503,
					"content": "Pour de vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450504,
					"content": "On dirait un marchand de tapis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450505,
					"content": "(Et je me souviens de ce qu'il y a d'écrit sur sa tombe...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450506,
					"content": "Pourquoi vous me regardez comme ça ? Ne vous inquiétez pas, je lis souvent l'avenir des gens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450507
					],
					"speakerTitle": "Ion"
				},
				{
					"id": 722450507,
					"content": "Ceci dit, peu de gens à Byakuyakoku connaîtront un destin joyeux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450508
					],
					"speakerTitle": "Ion"
				},
				{
					"id": 722450508,
					"content": "C'est pourquoi je leur mens, en leur disant qu'ils auront de la chance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450509
					],
					"speakerTitle": "Ion"
				},
				{
					"id": 722450509,
					"content": "Je pensais qu'ils seraient heureux au moins.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450510
					],
					"speakerTitle": "Ion"
				},
				{
					"id": 722450510,
					"content": "Résultat ? Ils m'ont dit que j'étais incapable de prédire quoi que ce soit. C'était vexant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450511
					],
					"speakerTitle": "Ion"
				},
				{
					"id": 722450511,
					"content": "Vraiment ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450512,
					"content": "Eh bien, je vais vous prouver que je peux le faire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450513
					],
					"speakerTitle": "Ion"
				},
				{
					"id": 722450513,
					"content": "Euh, d'accord !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450514,
					"content": "Hmm... Je me concentre... Ah, mais pourquoi y a-t-il autant d'interférences ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450515
					],
					"speakerTitle": "Ion"
				},
				{
					"id": 722450515,
					"content": "Hein ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450516
					],
					"speakerTitle": "Ion"
				},
				{
					"id": 722450516,
					"content": "Q—Qu'est-ce qui se passe ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450517,
					"content": "Je n'arrive pas à lire votre avenir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450518
					],
					"speakerTitle": "Ion"
				},
				{
					"id": 722450518,
					"content": "Pourquoi ? Mes prédictions ne sont pas tout à fait exactes d'habitude, mais je n'ai jamais raté une séance de divination.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450519
					],
					"speakerTitle": "Ion"
				},
				{
					"id": 722450519,
					"content": "Tu n'es peut-être pas aussi bon que tu le crois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450520,
					"content": "... On dirait bien. Je dois continuer à m'entraîner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ion"
				}
			]
		},
