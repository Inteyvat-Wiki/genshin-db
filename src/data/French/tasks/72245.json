			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Surepio",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722450301,
					"content": "#{M#Voyageurs venus}{F#Voyageuses venues} de loin, vous m'avez l'air {M#fatigués}{F#fatiguées}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450302
					],
					"speakerTitle": "Surepio"
				},
				{
					"id": 722450302,
					"content": "Vous ne pouvez pas continuer dans cet état. La fatigue est l'origine des maladies, vous savez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450303
					],
					"speakerTitle": "Surepio"
				},
				{
					"id": 722450303,
					"content": "Vous devez faire en sorte de vous reposer assez au quotidien pour *tousse* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450304
					],
					"speakerTitle": "Surepio"
				},
				{
					"id": 722450304,
					"content": "*tousse* ... Grandir en bonne santé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450305
					],
					"speakerTitle": "Surepio"
				},
				{
					"id": 722450305,
					"content": "Tu n'as pas l'air bien en point non plus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450306,
					"content": "Haha, c'est une vieille maladie qui revient parfois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450307
					],
					"speakerTitle": "Surepio"
				},
				{
					"id": 722450307,
					"content": "#{M#Voyageur}{F#Voyageuse}, ce n'est qu'en ayant un corps en bonne santé que vous pourrez avoir une âme saine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450308
					],
					"speakerTitle": "Surepio"
				},
				{
					"id": 722450308,
					"content": "*soupir* Si seulement j'avais plus de temps devant moi, je serais devenu le plus grand médecin de tous les temps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450309
					],
					"speakerTitle": "Surepio"
				},
				{
					"id": 722450309,
					"content": "De cette façon, j'aurais pu quitter ma chambre en bonne santé pour jouer dehors comme je l'aurais voulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Surepio"
				}
			]
		},
		{
			"id": 7224504,
