			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Orupeusu",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722450701,
					"content": "#*soupir* C'est donc vous {M#le voyageur venu}{F#la voyageuse venue} de loin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450702
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450702,
					"content": "Que recherchez-vous ? Vous voir traverser toutes ces distances est d'une tristesse !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450703
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450703,
					"content": "D'une tristesse ? Qu'est-ce qu'il y a de triste à ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450704,
					"content": "Pour un barde tel que moi, il n'y a que des choses tristes en ce bas-monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450705
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450705,
					"content": "Des séparations ont eu lieu pour que des rencontres se fassent et tous les êtres vivants reviendront un jour à la terre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450706
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450706,
					"content": "#Les retrouvailles sont trop courtes pour apaiser la peine causée par les longues séparations... En ce qui vous concerne, {M#voyageur}{F#voyageuse}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450707
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450707,
					"content": "Seuls ceux qui sont à la recherche de quelque chose plongent dans un autre monde comme vous l'avez fait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450708
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450708,
					"content": "Pour toutes les personnes sédentaires, ces voyages sont quelque chose de romantique. Mais pour les voyageurs eux-mêmes, ceux-ci ne représentent rien d'autre qu'une douleur indicible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450709
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450709,
					"content": "Je vous aurais chanté une chanson si vous étiez de mon temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450710
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450710,
					"content": "Cependant, j'ai juré à quelqu'un que je ne chanterai plus jusqu'à ce que j'entende à nouveau sa voix.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450711
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450711,
					"content": "#Je ne peux que vous souhaiter bonheur et réussite, même si vous avez l'air beaucoup plus {M#âgé}{F#âgée} que moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450712
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450712,
					"content": "J'espère que vos vœux deviendront réalité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orupeusu"
				}
			]
		}
	]
}