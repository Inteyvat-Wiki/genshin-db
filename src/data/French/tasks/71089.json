			"dialogs": [
				{
					"id": 710890101,
					"content": "Elle est bien longue cette lettre. C'est de la part de Zhiqiong !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710890102,
					"content": "Oui, c'est bien elle qui l'a écrite...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710890103
					]
				},
				{
					"id": 710890103,
					"content": "Raah, mais où est-ce qu'elle est partie encore ? Prévenons Jinwu d'abord.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
