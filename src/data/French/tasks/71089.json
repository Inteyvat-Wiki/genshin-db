			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinwu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710890201,
					"content": "Jinwu, regardez ce qu'on a trouvé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710890202,
					"content": "Détendez-vous. Qu'est-ce que vous avez trouvé ? Ça concerne Zhiqiong ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890203
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890203,
					"content": "Elle a laissé cette lettre et continue d'avancer dans le Gouffre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710890204
					]
				},
				{
					"id": 710890204,
					"content": "... Merci de m'avoir prévenue. Montrez-moi ce qu'elle a écrit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890205
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890205,
					"content": "Jinwu lit la lettre dans ses moindres détails.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710890206
					]
				},
				{
					"id": 710890206,
					"content": "Cette enfant... Je n'ai pas vu les choses dans de telles proportions, alors je ne peux pas vraiment critiquer son choix, mais peut-être que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890207
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890207,
					"content": "Peut-être que j'ai reconnu ses découvertes trop tard ou que je n'ai pas fait assez preuve de respect et de compréhension envers elle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890208
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890208,
					"content": "L'exploration aurait été très difficile sans ses cartes... Mais je n'avais que son état de santé en tête, au lieu de voir ses efforts et tout le travail qu'elle a fait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890209
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890209,
					"content": "Son travail est différent de celui d'un mineur, comment ai-je pu ignorer ce fait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890210
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890210,
					"content": "Elle ne veut pas qu'on l'oublie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710890211
					]
				},
				{
					"id": 710890211,
					"content": "C'est le cas de tous les gens qui n'ont pas les faveurs des dieux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890212
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890212,
					"content": "Qui voudrait être oublié ? Mais personne ne fait de fixation dessus comme Zhiqiong...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890213
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890213,
					"content": "Et pourtant, quand je pense à l'instant où j'ai décidé de renoncer à mes aspirations... que je me rends compte que je suis habituée à vivre une vie ordinaire et monotone...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890214
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890214,
					"content": "Je me dis que je n'ai pas le droit de juger Zhiqiong...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				}
			]
		}
	]
}