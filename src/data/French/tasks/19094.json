					"nextDialogs": [
						190940704,
						190940705
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 190940704,
					"content": "On dirait que ça va demander beaucoup de travail...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190940706
					]
				},
				{
					"id": 190940706,
					"content": "Hmm, je suis heureux, sœur Grace sera heureuse et le public le sera également... N'est-ce pas merveilleux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 190940705,
					"content": "Tu ne le fais pas seulement pour le vin ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190940706
					]
				}
			]
		},
