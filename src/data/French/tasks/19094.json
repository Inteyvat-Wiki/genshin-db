			"dialogs": [
				{
					"id": 190940701,
					"content": "... Kaeya n'est pas toujours facile, mais un verre gratuit est toujours le bienvenu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190940702
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 190940702,
					"content": "Tu peux toujours refuser.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190940703
					]
				},
				{
					"id": 190940703,
					"content": "Bien que je ne comprenne pas vraiment toutes les conventions et règles que l'Église de Favonius a pour les chorales et les hymnes, ça devrait aller ! Tant qu'il y a de l'amour pour la musique, je pourrai aider.",
