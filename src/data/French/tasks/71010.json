			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710100101,
					"content": "Mon frère d'armes et moi-même sommes rompus au combat depuis notre plus jeune enfance. Notre quête a toujours été de repousser les forces du mal, et de protéger ce monde de la corruption – quand bien même en l'absence d'un œil divin, la tâche ne fut guère aisée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100102
					],
					"speakerTitle": "Trésor des ruines"
				},
				{
					"id": 710100102,
					"content": "Nous avons trouvé refuge en ces lieux pour perfectionner nos techniques, et partir à la recherche d'un œil divin. Que ce monument par nous érigé soit le témoignage de nos actions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100103
					],
					"speakerTitle": "Trésor des ruines"
				}
			]
		},
		{
			"id": 7101002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7101006",
							"3"
						],
						"stepId": 7101006,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710100201,
					"content": "Le destin a voulu que mon frère d'armes trouve son œil divin en premier. Mais au lieu d'en faire bon usage contre les monstres qui peuplent ce monde, c'est en ces termes qu'il m'a parlé : « Les monstres sont-ils mauvais par nature ? » À ces mots, je répondis : « Ils détruisent tout sur leur passage ; à cause d'eux combien d'innocents ont déjà péri ? N'est-ce donc point une raison suffisante pour brandir ton arme ? » Je soupçonne à présent que l'excès de méditation a eu raison de lui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100202
					],
					"speakerTitle": "Trésor des ruines"
				},
				{
					"id": 710100202,
					"content": "Peu importe, ma mission demeure inchangée, même en l'absence d'œil divin – même en l'absence de mon fidèle compagnon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100203
					],
					"speakerTitle": "Trésor des ruines"
				}
			]
		},
		{
			"id": 7101003,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
