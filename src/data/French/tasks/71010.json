			},
			"dialogs": [
				{
					"id": 710100301,
					"content": "Les monstres peuplant ce monde en sont le fléau, et c'est le devoir du combattant que de les pourfendre jusqu'à ce que la terre des hommes en soit à jamais libérée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100302
					],
					"speakerTitle": "Trésor des ruines"
				},
				{
					"id": 710100302,
					"content": "Les monstres ne méritent aucune pitié, et seul le tranchant de l'épée saura en venir à bout !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
