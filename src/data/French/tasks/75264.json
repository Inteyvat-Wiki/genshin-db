					"Zhaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752640401,
					"content": "Écoutez, vous vous trompez de personne... Mon maître s'appelle Kanei, et moi, c'est Zhaka... C'est lui que vous devriez poursuivre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640402
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640402,
					"content": "Je n'arriverai jamais à faire des poupées au même niveau que mon maître...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640403
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640403,
					"content": "Vous avez été kidnappé ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752640404
					]
				},
				{
					"id": 752640404,
					"content": "Hein ? Attendez, vous n'êtes pas de mèche avec eux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640405
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640405,
					"content": "Bien sûr que non ! Vous n'avez pas vu qu'on vient de leur botter le derrière ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752640406,
					"content": "Vraiment ? C'est génial ! Ça veut dire que je suis enfin libre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640407
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640407,
					"content": "Évidemment ! Vous pouvez rentrer chez vous. Mais... qu'est-ce qu'il s'est passé au juste ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752640408,
					"content": "Ces types sont sortis de nulle part pour tenter de fabriquer des poupées contrefaites et les vendre dans la Station. Mais comme ils ne sont pas très doués, ils ont essayé de kidnapper mon maître, Kanei, pour qu'il les aide...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640409
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640409,
					"content": "Sauf que les choses ont mal tourné et c'est moi qu'ils ont attrapé à la place... Je n'apprends la peinture avec mon maître que depuis trois jours... Je ne suis pas du tout qualifié...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640410
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640410,
					"content": "Enfin bref, encore merci de m'avoir sauvé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640411
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640411,
					"content": "Azhka, rentrons à la maison !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640412
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640412,
					"content": "~ !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Azhka"
				}
			]
		}
