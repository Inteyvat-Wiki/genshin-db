					"speakerTitle": "Paimon"
				},
				{
					"id": 731050823,
					"content": "Vous racontez à Niloofar ce qui s'est passé, et lui donnez le mot d'Alrani...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
