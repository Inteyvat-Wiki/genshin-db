			},
			"dialogs": [
				{
					"id": 731053001,
					"content": "Alrani, j'espère que tu vas bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053002,
						731053005
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731053002,
					"content": "Quel genre de personne était Alrani quand elle était à l'Académie ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731053003
					]
				},
				{
					"id": 731053003,
					"content": "Alrani est une fille qui travaille dur, même si parfois... elle s'obstine dans des voies sans issue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053004
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731053004,
					"content": "Elle est une étudiante plus que compétente, et je crois qu'elle deviendra une excellente chercheuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731053005,
					"content": "Est-il difficile pour les étudiants de voir leurs thèses approuvées par l'Académie ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731053006
					]
				},
				{
					"id": 731053006,
					"content": "Honnêtement, oui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053007
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731053007,
					"content": "L'examen de thèse est une affaire... très compliquée. Le candidat doit prendre en compte non seulement l'orientation de ses travaux de recherche, mais aussi la quantité de sources qu'il fournit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053008
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731053008,
					"content": "De plus, il doit se demander combien d'autres thèses traitent d'un sujet similaire et si son sujet entre en conflit avec d'autres. Après la proposition de thèse, il rencontrera également toutes sortes de difficultés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053009
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731053009,
					"content": "*soupir* Mais je dois dire qu'Alrani est vraiment malchanceuse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Niloofar"
				}
			]
		},
