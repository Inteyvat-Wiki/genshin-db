				},
				{
					"id": 731050810,
					"content": "C'est une pilleuse d'énigmes ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050812
					]
				},
				{
					"id": 731050812,
					"content": "Personne ne connaît son but. Si je connais cette anecdote, c'est parce que mon tuteur l'a rencontrée une fois dans la nature.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050813
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050813,
					"content": "La question qu'elle lui a posée était : « Qu'est-ce qui peut rapidement remplir une pièce vide ? »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050814
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050814,
					"content": "Hum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050815
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050815,
					"content": "C'est le vent, non ? J'ai raison ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050816,
					"content": "Euh... La lumière d'une bougie ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050817
					]
				},
				{
					"id": 731050817,
					"content": "Mon tuteur a répondu : « Les énergies élémentaires sont omniprésentes »...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050818
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050818,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050819
					]
				},
				{
					"id": 731050819,
					"content": "C'est de la triche !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050820
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050820,
					"content": "Hahaha... Quoi qu'il en soit, Narzam a renvoyé mon tuteur en ville, et lui a même dit au revoir poliment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050821
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050821,
					"content": "Si c'est elle qui est avec Alrani, alors je ne suis pas inquiète.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050822
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050822,
					"content": "Mais Alrani ne peut pas rester là-bas éternellement. Je dois trouver un moyen de l'aider à résoudre le problème de sa thèse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050811,
					"content": "Quel est son but ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050812
					]
				}
			]
		},
