			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Niloofar",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731050101,
					"content": "Alrani... Où diable es-tu allée...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050102
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050102,
					"content": "Alrani ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050103
					]
				},
				{
					"id": 731050103,
					"content": "Hein ? Ce nom... Je m'en souviens, c'était la jeune femme qui écrivait toujours des articles universitaires, non ? On l'a rencontrée à l'Île de Watatsumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050104,
					"content": "Ah oui ! Elle a dit qu'elle était de l'Académie et qu'elle rassemblait des matériaux. Elle devrait être de retour maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050105,
					"content": "Mais... Cette demoiselle semble très anxieuse... Allons lui demander ce qui s'est passé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050106,
					"content": "Si Alrani est de retour à l'Académie, ça tombe bien, on va pouvoir aller lui dire bonjour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050107,
					"content": "#Bonjour, que se passe-t-il avec Alrani{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050108
					]
				},
				{
					"id": 731050108,
					"content": "#Êtes-vous {M#des aventuriers envoyés}{F#des aventurières envoyées} par la Guilde des aventuriers ?! Avez-vous trouvé Alrani ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050109
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050109,
					"content": "#Je sais que je vous ai {M#relancés}{F#relancées} à de nombreuses reprises et je suis vraiment désolée, mais je suis très inquiète pour elle et je...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050110
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050110,
					"content": "Calmez-vous, on n'est pas de la Guilde des aventuriers, on est juste de passage...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050111,
					"content": "Excusez-moi, vous êtes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050112
					]
				},
				{
					"id": 731050112,
					"content": "#N'êtes-vous pas des {M#aventuriers}{F#aventurières} ? Désolée, comme il n'y a pas eu de nouvelles de la guilde, je... j'étais trop anxieuse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050149
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050149,
					"content": "Vous racontez ce que vous avez vécu avec Alrani jusqu'à présent...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731050113
					]
				},
				{
					"id": 731050113,
					"content": "#Alors, vous êtes {M#le voyageur}{F#la voyageuse} dont Alrani a parlé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050114
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050114,
					"content": "Je m'appelle Niloofar, je suis une chercheuse de l'Académie... J'imagine que ça se voit, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050115
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050115,
					"content": "Malgré mon statut de chercheuse, je consacre maintenant la majeure partie de mon énergie à guider les étudiants dans leurs recherches.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050116
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050116,
					"content": "Alrani est l'une de mes étudiantes et elle a toujours eu du mal à écrire des papiers...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050117
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050117,
					"content": "Alors vous... vous êtes le tuteur d'Alrani ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050118
					]
				},
				{
					"id": 731050118,
					"content": "Mademoiselle Alrani a dit que son tuteur n'était pas satisfait de plusieurs de ses papiers et qu'elle avait dû les réécrire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050119,
					"content": "Ah non, ce n'est pas le moment de parler de ça. Qu'est-il arrivé à mademoiselle Alrani ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050120,
					"content": "Elle... Elle a disparu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050121
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050121,
					"content": "Il y a quelque temps, Alrani est revenue d'Inazuma toute joyeuse avec une thèse sur la culture populaire de l'Île de Watatsumi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050122,
						731050123
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050122,
					"content": "Alrani prend ses recherches très au sérieux.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050124
					]
				},
				{
					"id": 731050124,
					"content": "Dès que je l'ai lue, j'ai su que sa thèse était très bien écrite et d'une qualité exceptionnelle à tous égards...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050125
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050125,
					"content": "Cependant... Elle est revenue trop tard ! Je lui ai demandé de m'envoyer une première version à l'avance, mais je n'ai jamais eu de réponse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050126
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050126,
					"content": "Au moment où elle est revenue avec la version complète de sa thèse, quelqu'un d'autre avait déjà soumis une thèse avec exactement le même contenu que le sien, et celle-ci avait déjà passé l'examen préliminaire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050127
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050127,
					"content": "J'ai fait tout ce que je pouvais pour l'aider... Pourtant, son travail a quand même été rejeté...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050128
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050128,
					"content": "Ah bon ? Mademoiselle Alrani a commencé à collecter des matériaux il y a longtemps. Comment cela a-t-il pu prendre autant de temps...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050129,
					"content": "Attendez... C'était à Inazuma... Ça veut dire que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050130,
					"content": "#C'est à cause du décret de confinement{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050131
					]
				},
				{
					"id": 731050131,
					"content": "Oh non...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050132,
					"content": "Je ne savais pas comment lui annoncer cette nouvelle... J'avais prévu d'attendre quelques jours et de trouver une manière subtile de lui en parler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050133
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050133,
					"content": "Mais une commère a pris les devants et lui a tout raconté.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050134
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050134,
					"content": "Après cela, Alrani a disparu. Je l'ai cherchée partout dans l'Académie, mais je ne l'ai pas trouvée. Je n'avais pas d'autre choix que de confier cette mission à la Guilde des aventuriers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050135
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050135,
					"content": "Un aventurier est tombé sur le carnet d'Alrani quelque part, mais il n'a trouvé aucune trace d'elle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050136
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050136,
					"content": "Les aventuriers devraient être en train de la chercher partout à l'heure qu'il est...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050137
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050137,
					"content": "Je... Je ne sais vraiment pas quoi faire *sniff* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050138,
						731050140
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050138,
					"content": "Je vais moi aussi vous aider à chercher Alrani.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050139
					]
				},
				{
					"id": 731050139,
					"content": "Oui, on est là pour vous aider ! Alors... Commençons par l'endroit où le carnet a été trouvé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050142,
					"content": "Vous voulez m'aider ? Merci beaucoup !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050143
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050143,
					"content": "Je vais vous indiquer sur la carte l'endroit où le carnet a été trouvé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050144
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050144,
					"content": "Ah oui, et pour la rémunération...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050145,
						731050146
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050145,
					"content": "On en reparlera plus tard.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050147
					]
				},
				{
					"id": 731050147,
					"content": "Alors, on compte sur vous. Je reste ici en attente des nouvelles de la Guilde des aventuriers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050148
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050148,
					"content": "Alrani, j'espère que tu vas bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050146,
					"content": "Je la demanderai à Alrani.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050147
					]
				},
				{
					"id": 731050140,
					"content": "Où se trouve ce carnet ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050141
					]
				},
				{
					"id": 731050141,
					"content": "On va vous aider à retrouver mademoiselle Alrani !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050123,
					"content": "Alrani a travaillé très dur pour ses recherches.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050124
					]
				}
			]
		},
		{
			"id": 7310505,
			"completionStepIds": [
				7310505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310505",
							"2"
						],
						"stepId": 7310505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gobley",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731050501,
					"content": "Arrêtez, s'il vous plaît ! Ce n'est qu'un malentendu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050502,
						731050505
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050502,
					"content": "Je ne crois pas, non.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050503
					]
				},
				{
					"id": 731050503,
					"content": "Qu'as-tu fait à mademoiselle Alrani ? Dis-nous la vérité !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050504,
					"content": "Sinon... Sinon, tu vas recevoir des coups !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050507,
					"content": "N—Non, s'il vous plaît, écoutez-moi ! C'est vraiment un malentendu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050508
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050508,
					"content": "Comment oserions-nous faire quelque chose à cette jeune demoiselle ? Elle est plus forte que nous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050509,
						731050510
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050509,
					"content": "Qu'est-ce que tu veux dire ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050511
					]
				},
				{
					"id": 731050511,
					"content": "Laissez-moi vous raconter...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050512
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050512,
					"content": "Il y a quelque temps, on manquait d'argent, alors avec notre cheffe, on a cherché un moyen de faire fortune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050513
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050513,
					"content": "Pfff ! Piller et voler autrui, c'est ça que vous voulez dire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050514,
					"content": "Eh bien... On est tous des Pilleurs de trésors. C'est comme ça qu'on se fait de l'argent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050515
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050515,
					"content": "Alors que nous étions en train de faire des plans dans le camp, nous avons soudainement vu une jeune fille portant un grand sac se diriger vers le camp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050516
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050516,
					"content": "Elle avait l'air complètement blasée, ça nous a tous surpris.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050517
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050517,
					"content": "On se préparait à lui bondir dessus, et elle s'est juste laissée tomber à côté du feu de camp, pleurant et jetant un tas de livres dans le feu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050518
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050518,
					"content": "Ça nous a tous fait peur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050519,
						731050520
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050519,
					"content": "Même elle arrive à vous faire peur...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050521
					]
				},
				{
					"id": 731050521,
					"content": "Certes, on est Pilleurs de trésors, mais on n'a jamais fait de mal à personne ! Tout ce qu'on fait, c'est simplement voler quelques trucs et s'emparer de trésors...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050522
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050522,
					"content": "Avant qu'on n'ait eu le temps de réagir, elle nous a donné un sac de moras et nous a demandé de l'enfermer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050523
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050523,
					"content": "Q—Quoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050524,
						731050525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050524,
					"content": "Ça n'a aucun sens...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050526
					]
				},
				{
					"id": 731050526,
					"content": "Personne n'osait l'approcher au début. Mais elle refusait de manger ou de boire, et demandait incessamment à être enfermée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050527
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050527,
					"content": "Finalement, notre cheffe nous a demandé de fabriquer une cage avec des branches pour qu'elle puisse aller dedans.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050528,
						731050529
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050528,
					"content": "Votre cheffe est gentille...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050530
					]
				},
				{
					"id": 731050530,
					"content": "Eh bien, notre cheffe a toujours eu du respect pour les personnes instruites. Elle dit qu'elle aimerait aller à l'école un jour...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050531
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050531,
					"content": "Hum, la jeune demoiselle est par là. Allez voir par vous-même si vous ne me croyez pas. Notre cheffe doit être encore en train d'essayer de lui faire entendre raison...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050532
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050532,
					"content": "Si vous arrivez à convaincre cette jeune demoiselle de partir d'ici, on sera plus que d'accord pour vous récompenser !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050529,
					"content": "Vous avez été gentils avec Alrani...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050530
					]
				},
				{
					"id": 731050525,
					"content": "Alors, vous l'avez enfermée ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050526
					]
				},
				{
					"id": 731050520,
					"content": "N'êtes-vous pas des Pilleurs de trésors...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050521
					]
				},
				{
					"id": 731050510,
					"content": "Donc elle est bien avec vous.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050511
					]
				},
				{
					"id": 731050505,
					"content": "Qu'as-tu fait à Alrani ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050506
					]
				},
				{
					"id": 731050506,
					"content": "Ne nous mens pas ! Ou bien... Ou bien tu vas recevoir des coups !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050507
					],
					"speakerTitle": "Paimon"
				}
			]
		},
