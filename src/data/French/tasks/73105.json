			"dialogs": [
				{
					"id": 731053101,
					"content": "Autre chose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053102,
						731053108
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731053102,
					"content": "Pourquoi êtes-vous si...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731053103
					]
				},
				{
					"id": 731053103,
					"content": "« Gentille » avec Alrani ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053104
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731053104,
					"content": "Ne vous méprenez pas. Il y a des raisons toutes simples à cela. Tout d'abord, Alrani m'a payée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053105
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731053105,
					"content": "Deuxièmement, je ne prends que de l'argent, pas des vies. Ma réputation dans ce cercle serait ruinée si j'abandonnais Alrani dans la nature.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053106
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731053106,
					"content": "Troisièmement, elle est une personne instruite qui a un bel avenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053107
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731053107,
					"content": "Pouvoir l'aider nous donnerait un peu de crédit en tant que Pilleurs de trésors, je suppose ? Hum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731053108,
					"content": "Combien vous a-t-elle payée ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731053109
					]
				},
				{
					"id": 731053109,
					"content": "Pas une petite somme. Elle a dit qu'elle l'avait gagnée en fabriquant des engrais. Je ne sais pas ce que c'est, mais ça m'est égal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053110
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731053110,
					"content": "Elle a payé, et je l'aide temporairement, c'est aussi simple que ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Narzam"
				}
			]
