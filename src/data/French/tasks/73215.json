			},
			"dialogs": [
				{
					"id": 732150101,
					"content": "#Bonjour, mon {M#ami narien}{F#amie narienne} ! Hmm... J'ai l'impression d'avoir quelque chose à te dire, je ne m'en souviens plus, mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150102
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 732150102,
					"content": "#Ce n'est pas grave. Nous sommes {M#heureux}{F#heureuses} de vous revoir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150103,
					"content": "Merci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150104,
						732150106
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 732150104,
					"content": "À propos de Mawtiyima...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150105
					]
				},
				{
					"id": 732150105,
					"content": "Elle ne parle plus, mais elle va bien. La forêt se rétablit également... Merci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 732150106,
					"content": "À propos de la perte de mémoire...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150107
					]
				},
				{
					"id": 732150107,
					"content": "L'oubli ? Ah oui, le pouvoir du kusava est épuisé, alors les souvenirs disparaissent, petit à petit, comme des gouttes de rosée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranaga"
				}
			]
		},
