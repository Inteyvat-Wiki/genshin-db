			"dialogs": [
				{
					"id": 732150501,
					"content": "#Bonjour {M#nara doré}{F#nara dorée} ! Bonjour petite Blanche-volante !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150502
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 732150502,
					"content": "Hé, je ne suis pas petite ! Regarde-toi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150503,
					"content": "Je ne suis pas petit non plus ! Hmm... Au fait, qu'est-ce que vous faites ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150504
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 732150504,
					"content": "Nous sommes ici juste pour vous voir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150505
					]
				},
				{
					"id": 732150505,
					"content": "Ouais. Après tout, on a vaincu beaucoup de méchants dans le passé, et on a chanté ensemble, et on a sauvé Meuhtiya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150506,
					"content": "Mawtiyima !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150507
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 732150507,
					"content": "Ah oui !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150508,
					"content": "Euh... Désolé... Ce que vous avez dit doit être vrai, mais je ne m'en souviens pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150509
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 732150509,
					"content": "Ah, ce n'est pas grave ! Ne sois pas triste !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150510,
					"content": "(Il ne s'en souvient vraiment pas...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
