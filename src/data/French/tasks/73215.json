			"dialogs": [
				{
					"id": 732150201,
					"content": "Bonjour, bonjour !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150202
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 732150202,
					"content": "Bonjour, petit ! Tu te souviens de nous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150203,
					"content": "Blanche-volante, je ne suis pas petit ! Vous ne vous souvenez plus de la chanson que je vous ai apprise ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150204
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 732150204,
					"content": "Si, je m'en souviens.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150205
					]
				},
				{
					"id": 732150205,
					"content": "Super !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150206
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 732150206,
					"content": "Promettez-moi que vous vous en souviendrez même si je l'oublie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakin"
				}
			]
		},
