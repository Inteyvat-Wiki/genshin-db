			"dialogs": [
				{
					"id": 732150601,
					"content": "#{M#Nara doré}{F#Nara dorée}, Blanche-volante, vous voilà !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150602
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 732150602,
					"content": "Oui ! On est là !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150603,
					"content": "Héhé... J'ai probablement oublié beaucoup de choses, alors il vous faudra me les rappeler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150604
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 732150604,
					"content": "C'est à cause du kusava ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150605
					]
				},
				{
					"id": 732150605,
					"content": "Oui... Aranaga aurait dû vous le dire, le pouvoir est dans la mémoire, et sans mémoire, il n'y a pas de pouvoir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150606
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 732150606,
					"content": "On a dû vivre quelque chose avant, mais on ne s'en souvient pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150607
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 732150607,
					"content": "Haha, mais ce n'est rien ! On peut encore recommencer avec de nouveaux souvenirs ! Pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150608
