			"dialogs": [
				{
					"id": 732150401,
					"content": "#Bonjour, {M#nara doré}{F#nara dorée} et Blanche-volante !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150402
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 732150402,
					"content": "Bonjour ! Comment vas-tu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150403,
					"content": "Je vais bien, mais pourquoi êtes-vous ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150404
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 732150404,
					"content": "Ah ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150405,
					"content": "Hum... On est curieux. Il doit y avoir une raison, mais je ne sais pas pourquoi vous êtes là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150406
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 732150406,
					"content": "Parce qu'on connaît bien cet endroit, après toutes les aventures qu'on a vécues avec vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150407,
					"content": "Ah bon ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150408
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 732150408,
					"content": "Il ne se souvient de rien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
