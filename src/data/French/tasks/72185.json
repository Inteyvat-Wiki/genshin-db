			},
			"dialogs": [
				{
					"id": 721850301,
					"content": "#{M#Voyageur}{F#Voyageuse}, vous êtes de retour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850302
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850302,
					"content": "Alors ? Vous avez eu des informations ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850303
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850303,
					"content": "À propos des commentaires des clients...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721850304
					]
				},
				{
					"id": 721850304,
					"content": "Hmm, la « Pizza aux champignons » originelle... J'aimerais bien l'essayer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850305
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850305,
					"content": "Il faut du fromage, des choux et des champignons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850306
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850306,
					"content": "On a tout sauf le fromage, généralement, on n'en stocke pas beaucoup...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850307
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850307,
					"content": "#{M#Voyageur}{F#Voyageuse}, pourriez-vous me ramener une portion de fromage ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850308,
						721850310
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850308,
					"content": "C'est comme si c'était fait.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721850309
					]
				},
				{
					"id": 721850309,
					"content": "Merci beaucoup ! Une portion suffira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850310,
					"content": "N'avez-vous pas besoin du fromage habituellement ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721850311
					]
				},
				{
					"id": 721850311,
					"content": "Je ne peux pas dire que je ne l'utilise pas du tout, mais très peu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850312
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850312,
					"content": "Après tout, peu de plats de mon restaurant nécessitent du fromage, donc on n'en stocke pas beaucoup...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850313
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850313,
					"content": "#Alors, je compte sur vous, {M#voyageur}{F#voyageuse}. Ramenez-moi une portion de fromage, s'il vous plaît.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kiminami Anna"
				}
			]
		},
