			"dialogs": [
				{
					"id": 721850201,
					"content": "*soupir* Existe-t-il dans ce monde des plats inédits qui puissent satisfaire mes papilles ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850202
					],
					"speakerTitle": "Matsumoto"
				},
				{
					"id": 721850202,
					"content": "À propos de la pizza du Restaurant Kiminami...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721850203
					]
				},
				{
					"id": 721850203,
					"content": "Ah, la pizza dont vous parlez n'est pas mal du tout, et elle contient de nombreux ingrédients locaux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850204
					],
					"speakerTitle": "Matsumoto"
				},
				{
					"id": 721850204,
					"content": "Mais j'ai goûté auparavant la vraie « Pizza aux champignons ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850205
					],
					"speakerTitle": "Matsumoto"
				},
				{
					"id": 721850205,
					"content": "Je me rappelle que la pizza est faite de fromage, de choux et de champignons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850206
					],
					"speakerTitle": "Matsumoto"
				},
				{
					"id": 721850206,
					"content": "Hahaha, je pense juste que les plats étrangers feraient mieux de garder leurs saveurs exotiques.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matsumoto"
				}
			]
		},
		{
			"id": 7218503,
