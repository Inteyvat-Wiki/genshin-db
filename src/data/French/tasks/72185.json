			"dialogs": [
				{
					"id": 721850501,
					"content": "Merci. C'est bon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850502
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850502,
					"content": "La pizza aux champignons authentique de Mondstadt... Je ne sais pas si je peux réussir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850503
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850503,
					"content": "C'est fait !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850504
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850504,
					"content": "Cette pizza a l'air... plutôt pas mal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850505
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850505,
					"content": "#Merci de votre aide, {M#voyageur}{F#voyageuse}. Prenez ceci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850506
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850506,
					"content": "Je ferai en sorte de savourer chaque bouchée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850507
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850507,
					"content": "Si c'est bon... Je vais la lancer officiellement comme nouveau plat.",
					"roleType": "TALK_ROLE_NPC",
