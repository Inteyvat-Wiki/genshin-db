			"dialogs": [
				{
					"id": 722110401,
					"content": "Comme ça sent bon... Vous avez réussi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110402
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110402,
					"content": "Oui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110403
					]
				},
				{
					"id": 722110403,
					"content": "Miaou miaou ! Merveilleux, je veux goûter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110404
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110404,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110405
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110405,
					"content": "Mmm, c'est un peu différent de ce que faisait Hibiki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110406
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110406,
					"content": "Je suis certaine que c'est super bon. Allez, goûtons !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110407,
					"content": "Oh, c'est délicieux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110408,
					"content": "... Miaou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110409
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110409,
					"content": "(Est-ce que Neko fait la tête, car le plat ne ressemble pas à celui de Hibiki ?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110410,
					"content": "C'est délicieux. J'ai bien fait de m'en remettre à vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110411
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110411,
					"content": "Génial.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110412
					]
				},
				{
					"id": 722110412,
					"content": "C'est vrai que c'est différent de ce que préparait Hibiki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110413
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110413,
					"content": "Mais en le mangeant, j'ai pu revivre ces moments de convivialité partagés avec elle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110414
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110414,
					"content": "#Comment avez-vous fait, {M#humain}{F#humaine} ? Vous pouvez faire de la magie ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110415,
						722110416
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110415,
					"content": "Ça fait longtemps que personne ne vous a donné à manger.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110417
					]
				},
				{
					"id": 722110417,
					"content": "En tout cas, je vous remercie. Ça fait des années que je n'ai pas mangé un aussi bon repas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110418
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110418,
					"content": "Les petits aimeront aussi. Pourriez-vous leur en apporter ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110419
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110419,
					"content": "J'ai aimé après tout, alors je suis sûre qu'ils apprécieront. Peut-être même qu'ils seront plus obéissants après ce délicieux repas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110416,
					"content": "La personne qui a préparé le repas y a mis tout son cœur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110417
					]
				}
			]
		},
		{
			"id": 7221105,
			"completionStepIds": [
