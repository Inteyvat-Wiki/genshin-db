					"Neko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722110501,
					"content": "Avez-vous donné à manger aux petits ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110502
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110502,
					"content": "Ils ont adoré.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110503
					]
				},
				{
					"id": 722110503,
					"content": "Vraiment ? Je suis ravie, miaou miaou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110504
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110504,
					"content": "Je n'avais pas mangé quelque chose d'aussi bon depuis longtemps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110505
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110505,
					"content": "Miaou miaou miaou... Je n'ai plus besoin de nourriture ni d'eau, mais je ne peux pas résister à un repas avec du riz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110506
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110506,
					"content": "C'est pour ça que j'ai nommé ce chaton « Meshi ». Le riz est la meilleure chose au monde pour moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110507
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110507,
					"content": "Quel était le nom du plat que faisait Hibiki ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110508
					]
				},
				{
					"id": 722110508,
					"content": "Un nom ? Les plats sont censés avoir des noms ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110509
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110509,
					"content": "Celui-ci s'appelle le « pâté miaou revigorant ».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110510
					]
				},
				{
					"id": 722110510,
					"content": "Quel nom compliqué, mais je l'aime bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110511
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110511,
					"content": "... Vous avez raison. Les plats sont des bonnes choses et toutes les bonnes choses doivent avoir des noms.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110512
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110512,
					"content": "Miaou miaou, je poserai la question à Hibiki quand elle reviendra. Vous pourrez lui préparer votre plat aussi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110513
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110513,
					"content": "Et elle vous fera le sien. Comme ça, vous pourrez manger deux plats différents, tout aussi délicieux l'un que l'autre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110514
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110514,
					"content": "Voilà une raison de plus de restaurer ce sanctuaire. On mangera tous ensemble au retour de Hibiki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110515
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110515,
					"content": "Merci, ce plat était merveilleux. Miaou miaou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
