			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kiminami Anna",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722110702,
					"content": "Parfait ! Un moment, je pense savoir quoi faire à présent !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110703
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110703,
					"content": "C'est prêt !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110704
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110704,
					"content": "Ouh, ça sent divinement bon ! J'ai envie de goûter...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110705,
					"content": "Comment devrait-on appeler ce plat ? Hmm... C'est pour un chat qui parle, après tout. Que pensez-vous de « pâté miaou revigorant » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110706
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110706,
					"content": "Et voilà ! C'est pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110707
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110707,
					"content": "Ah, laissez-moi aussi vous écrire la recette.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110708
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110708,
					"content": "#Youpi, {NICKNAME} peut me cuisiner du pâté miaou maintenant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110709,
						722110712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110709,
					"content": "Tu es un chat maintenant ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110710
					]
				},
				{
					"id": 722110710,
					"content": "Hé, c'est pas sympa ! La bonne nourriture est universelle, tu sais !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110711,
					"content": "En tout cas, on vous doit une fière chandelle, mademoiselle Kiminami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110713,
					"content": "Ce n'est rien, ne vous inquiétez pas ! Prenez ce plat et la recette en cadeau pour Neko.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110714
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110714,
					"content": "J'irai lui rendre visite au Sanctuaire d'Asase dès que j'aurai du temps libre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110715
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110715,
					"content": "Allez, mettez-vous en route. Vous ne voudriez pas la faire attendre trop longtemps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110712,
					"content": "Merci.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110713
					]
				}
			]
		},
		{
			"id": 7221108,
			"completionStepIds": [
				7221101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
