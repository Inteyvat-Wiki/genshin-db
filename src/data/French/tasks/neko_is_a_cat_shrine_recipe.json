			},
			"dialogs": [
				{
					"id": 722111101,
					"content": "Bonjour et bienvenue au Restaurant Kiminami. Que puis-je faire pour vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111102
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111102,
					"content": "#Ah, mais c'est vous ! Vous êtes {M#l'ami}{F#l'amie} de mademoiselle Kamisato ! N'hésitez pas, je vous prie. Comment puis-je vous être utile aujourd'hui ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111103
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111103,
					"content": "On doit cuisiner quelque chose pour Neko...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111104
					]
				},
				{
					"id": 722111104,
					"content": "Neko ? C'est un chat ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111105
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111105,
					"content": "Vous connaissez Neko ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722111106,
					"content": "Non, pas du tout. C'est juste que c'est un nom qui semble tout trouvé pour un chat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111107
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111107,
					"content": "Vous avez de l'intuition...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111108
					]
				},
				{
					"id": 722111108,
					"content": "#Peu importe pour le moment. Je vais vous raconter comment nous sommes {M#arrivés}{F#arrivées} chez vous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722111109,
					"content": "Vous dites qu'il y a un certain Sanctuaire d'Asase sur l'Île de Seirai qui abrite un chat qui parle ?! Et que ce chat vous a demandé de lui préparer un repas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111110
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111110,
					"content": "Vraiment ?! Je n'ai jamais entendu une histoire pareille !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111111,
						722111112
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111111,
					"content": "C'est pourtant vrai...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111113
					]
				},
				{
					"id": 722111113,
					"content": "Sur l'Île de Seirai, c'est ça ? J'irai faire un tour dès que je pourrai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111114
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111114,
					"content": "Alors, à propos de ce repas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111115
					]
				},
				{
					"id": 722111115,
					"content": "Ah, j'oubliais. Laissez-moi réfléchir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111116
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111116,
					"content": "Hum, un plat qui plairait à un chat, hein...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111117
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111117,
					"content": "C'est difficile ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722111118,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111119
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111119,
					"content": "Ça va être difficile, n'est-ce pas ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111120
					]
				},
				{
					"id": 722111120,
					"content": "C'est un défi pour le nom de la famille Kiminami ! Mais je le relèverai, quoi qu'il en coûte !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111121
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111121,
					"content": "#D'accord, je vais vous faire un plat à base de poisson, de viande crue, d'herbes marines et de riz auquel aucun chat ne pourra résister ! Laissez-moi m'en occuper, {M#voyageur}{F#voyageuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111122
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111122,
					"content": "Moi aussi, j'en veux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111123,
						722111124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722111123,
					"content": "Moi aussi, d'ailleurs...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111125
					]
				},
				{
					"id": 722111125,
					"content": "D'accord !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111126
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111126,
					"content": "Je vais réfléchir à la recette. Préparez-moi trois portions d'herbes marines pendant ce temps, s'il vous plaît.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111127,
						722111129
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111127,
					"content": "Très bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111128
					]
				},
				{
					"id": 722111128,
					"content": "Trois portions suffiront. Ramenez-les-moi quand vous les aurez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111129,
					"content": "Vous vous en sortez ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111130
					]
				},
				{
					"id": 722111130,
					"content": "J'ai quelques idées, mais elles n'ont pas encore tout à fait pris forme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111131
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111131,
					"content": "Allez me chercher trois portions d'herbes marines en attendant. Merci beaucoup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111124,
					"content": "On vous laisse faire, alors.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111125
					]
				},
				{
					"id": 722111112,
					"content": "Vous pouvez aller voir par vous-même si vous ne me croyez pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111113
					],
					"speakerTitle": "Kiminami Anna"
				}
			]
		}
	]
