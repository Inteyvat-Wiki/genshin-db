		},
		{
			"id": 7106607,
			"completionStepIds": [
				7106601
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106601",
							"2"
						],
						"stepId": 7106601,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Taliesin",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710660701,
					"content": "Hum hum... Désolé, toutes mes excuses. Je suis un poète, donc j'aime raconter les choses de manière dramatique. Ça rend les histoires plus intéressantes, vous voyez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660702
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660702,
					"content": "Héhé. En réalité, j'ai trouvé cet anneau il y a plusieurs années dans un trou de belette voleuse. J'ai vu qu'il était en bon état, et il était joli, alors je l'ai gardé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660703
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660703,
					"content": "Pff, alors ce n'est qu'un simple objet volé que vous avez pris à un... voleur !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710660704,
					"content": "Ne dites pas ça... Non, je l'ai ramassé ! C'est mon trésor et j'y tiens beaucoup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660705
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660705,
					"content": "Vous avez des pistes pour retrouver votre anneau ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660706
					]
				},
				{
					"id": 710660706,
					"content": "Hmm... Il paraît qu'il y a des belettes voleuses qui font souvent surface dans les environs. Peut-être que ce sont ces petites créatures qui ont profité de mon sommeil pour me le subtiliser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660707
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660707,
					"content": "Il y a vraiment des gens qui enlèvent leur anneau pour dormir...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710660708,
					"content": "Jamais vu ça.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660709
					]
				},
				{
					"id": 710660709,
					"content": "En tout cas, je ne ferais jamais ça, moi ! Parce qu'il faudrait encore réfléchir où le mettre et ça prend du temps. Du temps que je pourrais utiliser à dormir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710660710,
					"content": "Tu penses vraiment qu'il existe des anneaux à ta taille ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660711
					]
				},
				{
					"id": 710660711,
					"content": "Hmph, bien sûr ! Le monde est grand, tu ne sais pas tout ce qu'on peut y trouver !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710660712,
					"content": "Bon, vous n'allez pas non plus critiquer les habitudes des autres ?! Occupez-vous de vos affaires ! Quelle impolitesse !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660713
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660713,
					"content": "En tout cas, si vous voulez m'aider à trouver mon anneau... Gardez un œil sur les trous de belettes voleuses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660714
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660714,
					"content": "J'ai entendu dire que les Pilleurs de trésors avaient érigé un camp suspect à cet endroit de la carte. Je vous le marque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660715
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660715,
					"content": "On dit que les belettes voleuses apparaissent souvent dans cette zone. Il est très probable que cela ait un lien avec ces scélérats de Pilleurs de trésors. Bref, j'aimerais que vous vous y rendiez pour aller voir ce qui se passe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660716
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660716,
					"content": "Tss... Vous vous êtes fait subtiliser un anneau par des belettes voleuses à qui vous l'aviez vous-même volé. L'anneau a retrouvé son propriétaire légitime, justice est faite !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710660717,
					"content": "Arrêtez de vous moquer de moi, s'il vous plaît !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				}
			]
		},
		{
			"id": 7106608,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
