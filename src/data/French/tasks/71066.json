				{
					"id": 710660201,
					"content": "Vous êtes de retour ! Alors, vous avez trouvé quelque chose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660202
					],
					"speakerTitle": "Taliesin"
				},
				{
