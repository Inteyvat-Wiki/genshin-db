			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Clitopho"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710660801,
					"content": "Bonjour, il s'est passé quelque chose récemment ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660802
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710660802,
					"content": "À propos des belettes voleuses...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660803
					]
				},
				{
					"id": 710660803,
					"content": "Ah, vous voulez parler des belettes voleuses du Gouffre ? Haha, c'était moi qui devais m'en occuper, mais j'ai fait un peu n'importe quoi... Il n'y a pas grand-chose à dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660804
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710660804,
					"content": "Hum... Je n'arriverais pas à les attraper une nouvelle fois. Ces saletés sortent de nulle part et se font la belle avant qu'on ait le temps de cligner des yeux ! Elles sont impossibles à suivre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660805
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710660805,
					"content": "Par contre, si c'est un objet perdu que vous cherchez à leur reprendre, je peux vous donner un petit conseil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660806
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710660806,
					"content": "Les Pilleurs de trésors nourrissent les belettes voleuses à des heures fixes. Il y a trois types de belettes voleuses...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660807
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710660807,
					"content": "Les plus coriaces sont les grandes belettes voleuses d'or. Ensuite, il y a les belettes collectionneuses de trésors, qui sont les plus communes. Enfin, il y a ces idiotes de belettes apprenties voleuses. Mais les heures auxquelles elles apparaissent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660808
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710660808,
					"content": "*soupir* Il devrait y avoir un livret d'entraînement sur lequel sont indiquées les heures auxquelles les belettes sont nourries. Celui ou celle qui a pris ça en note devrait se trouver à côté de l'endroit où les belettes voleuses apparaissent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660809
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710660809,
					"content": "Ah oui, j'ai failli oublier ! Pour appeler les belettes, il faut siffler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660810
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710660810,
					"content": "Siffler ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660811
					]
				},
				{
