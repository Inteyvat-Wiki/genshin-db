					"Taliesin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710660301,
					"content": "Oui, c'est lui ! Merci énormément !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660302
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660302,
					"content": "Tenez, prenez ceci en guise de récompense. Ce n'est pas grand-chose, j'espère que vous ne m'en voudrez pas trop. Je vais écrire un poème à propos de ce que vous avez fait, et je le déclamerai partout !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				}
			]
		},
