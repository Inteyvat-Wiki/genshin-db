					"Shenhe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705090101,
					"content": "#{NICKNAME}, bonjour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090102
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090102,
					"content": "Bonjour ! J'aurais été surprise de vous voir ici si nous n'avions pas déjà croisé quelques-uns de nos amis tout à l'heure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090103,
					"content": "Oh, mais c'est Shenhe ! Bah, ça alors ! J'en suis toute étonnée, du coup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090104,
					"content": "Ce lieu n'est pas facile à trouver. « Cadeau de l'Ange »... Quel nom compliqué à prononcer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090105
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090105,
					"content": "Heureusement que sieur Zhongli a eu l'amabilité de m'indiquer la direction.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090106
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090106,
					"content": "On a dû vous indiquer le chemin ? Attendez un peu, vous avez fait toute cette route pour une boisson ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090107,
					"content": "Absolument.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090108
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090108,
					"content": "#Parce que nous sommes... {M#amis}{F#amies}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090109
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090109,
					"content": "Qu'est-ce qui vous ferait plaisir ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705090110
					]
				},
				{
					"id": 705090110,
					"content": "Voici la carte !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090111,
					"content": "Une vision bo... boréale, c'est une boisson glacée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090112
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090112,
					"content": "Euh, je pense que c'est une référence au Loup du Nord, alors je suppose qu'elle est très froide, oui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090113,
					"content": "Pomme de pin au caramel... En quoi est-ce une boisson ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090114
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090114,
					"content": "Oh, je l'ai goûtée tout à l'heure. En fait, c'est un café au caramel. « Pomme de pin »... est une référence à la couleur de la boisson !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090115,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090116
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090116,
					"content": "Tous ces noms sont bien étranges, je ne comprends pas du tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090117
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090117,
					"content": "Je vous laisse choisir pour moi. Une boisson au goût de fleur de Qingxin ou de muguet bleu me conviendra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090118
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090118,
					"content": "Ces herbes médicinales ne poussent pas dans les environs. Si vous souhaitez quelque chose d'amer, il faudra se contenter de café...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090119,
					"content": "Je peux vous proposer une boisson sucrée pour changer ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705090120
					]
				},
				{
					"id": 705090120,
					"content": "... D'accord.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090121
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090121,
					"content": "C'est une bonne idée. Vous vous êtes entraînée avec les Adeptes pendant si longtemps, un peu de changement ne vous ferait pas de mal !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090122,
					"content": "Préparons-lui un baiser enneigé ! Je pense qu'elle va adorer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7050902,
			"completionStepIds": [
				7050903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7050903",
							"2"
						],
						"stepId": 7050903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shenhe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705090201,
					"content": "C'est très sucré, ça glisse tout seul dans la bouche et sans aucune amertume. Qu'est-ce que c'est ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090202
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090202,
					"content": "On appelle cette boisson « baiser enneigé » ! Il faut fouetter le lait jusqu'à obtenir une mousse légère et l'ajouter au jus de fruits, comme si la boisson était couverte par de la neige.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090203,
					"content": "Par contre, ne me demandez pas pourquoi le « baiser »... Je n'arrive pas à l'expliquer non plus... Peut-être que c'est vendeur comme mot ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090204,
					"content": "Vendeur ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090205
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090205,
					"content": "Non ? Vous ne trouvez pas ? Euh, je disais ça comme ça, hein... Disons que c'est quand même romantique !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090206,
					"content": "Romantique ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090207
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090207,
					"content": "Hum... C'est difficile à expliquer ! Ne me faites pas inventer des histoires.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090208,
						705090209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090208,
					"content": "La mousse de lait n'a pas beaucoup de goût...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705090210
					]
				},
				{
					"id": 705090210,
					"content": "Oh, c'est vrai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090211,
						705090212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090211,
					"content": "Lorsque vous sentez le sucré du jus de fruits...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705090213
					]
				},
				{
					"id": 705090213,
					"content": "... Ah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090214
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090214,
					"content": "Je vois... Je crois que je comprends.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090215
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090215,
					"content": "Hein ? Vraiment ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090216,
					"content": "Hé mais, pourquoi c'est moi qui ne comprends plus rien ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090217,
					"content": "Il m'arrive de mâcher des herbes médicinales quand je me promène en montagne. J'ai déjà vu des pousses percer le sol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090218
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090218,
					"content": "Ma joie d'alors ressemble beaucoup à ce que je ressens maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090219
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090219,
					"content": "#Merci de m'avoir fait comprendre ce... nom de boisson compliqué, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090220
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090220,
					"content": "J'aurais sans doute besoin de votre aide plus tard aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090212,
					"content": "C'est comme si une pousse de plante brisait la neige pour venir vous embrasser...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705090213
					]
				},
				{
					"id": 705090209,
					"content": "On dirait la neige sur les montagnes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705090210
					]
				}
			]
		}
	]
}