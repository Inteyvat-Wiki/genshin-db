			"dialogs": [
				{
					"id": 741870901,
					"content": "On dirait que vous venez de résoudre le problème de tout à l'heure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870902
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870902,
					"content": "Dans ce cas, je vous suggère de vous diriger vers votre prochain objectif.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870903
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870903,
					"content": "Oui, Este, je vous laisse vous en occuper...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870904
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870904,
					"content": "Et puis, plutôt que de laisser la phobos ou un accordeur départager le bien du mal, fiez-vous plutôt à votre propre jugement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870905
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870905,
					"content": "Le sébaste a créé la phobos pour nous libérer de l'esclavage du destin, mais notre obéissance aveugle nous mènera à un asservissement encore plus terrible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870906
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870906,
					"content": "À l'avenir, vous pourriez à nouveau faire face à un tel choix. Le moment venu, j'espère que vous prendrez la bonne décision.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870907
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870907,
					"content": "Dominus Cassiodor, pourquoi parlez-vous soudainement de tout ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870908
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870908,
					"content": "Cependant, je me souviendrai de vos paroles et me fierai à mon propre sens de la justice. Vous avez ma parole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870909
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870909,
					"content": "Très bien, disons-nous au revoir pour l'instant. Je pense que nous nous reverrons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Osse"
				}
			]
		},
