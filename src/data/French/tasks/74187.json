				"points": []
			},
			"dialogs": [
				{
					"id": 741870701,
					"content": "Très bien... Vous avez raison, nous devons réfléchir à nos actions. Mais je ne sais pas non plus ce qui s'est passé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870702
					],
					"speakerTitle": "Chef"
				},
				{
					"id": 741870702,
					"content": "Depuis que la guerre a éclaté, j'ai un étrange sentiment qui me ronge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870703
					],
					"speakerTitle": "Chef"
				},
				{
					"id": 741870703,
					"content": "Nous devrions être à la poursuite de la liberté et du bonheur, mais la phobos nous a conduits ici petit à petit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870704
					],
					"speakerTitle": "Chef"
				},
				{
					"id": 741870704,
					"content": "Qu'est-ce qui a bien pu mal tourner ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870705
					],
					"speakerTitle": "Chef"
				},
				{
					"id": 741870705,
					"content": "Si vous rencontrez le sébaste à votre retour, veuillez lui rapporter la situation du terrain et faites-lui part de nos doutes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870706
					],
					"speakerTitle": "Chef"
				},
				{
					"id": 741870706,
					"content": "Nous comptons sur vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870707
					],
					"speakerTitle": "Chef"
				},
				{
					"id": 741870707,
					"content": "Bien sûr, on le fera !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
