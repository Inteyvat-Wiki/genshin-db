			"dialogs": [
				{
					"id": 741870801,
					"content": "D'ailleurs, vous ne faites pas semblant d'être des barbares sournois pour essayer de nous piéger avec vos mensonges, j'espère ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870802
					],
					"speakerTitle": "Chef"
				},
				{
					"id": 741870802,
