			"dialogs": [
				{
					"id": 741871201,
					"content": "La phobos est une création parfaite. En tant que Rémurien, je vous conseille de ne pas la remettre en question.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741871202,
						741871204
					],
					"speakerTitle": "Chef"
				},
				{
					"id": 741871202,
					"content": "Une création parfaite ? Rien n'est parfait.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741871203
					]
				},
				{
					"id": 741871203,
					"content": "Vous voulez parler de philosophie avec moi ? Allez plutôt parler aux experts en musique de la cité royale. Le devoir d'un soldat est d'obéir aux ordres, je ne comprends pas les questions trop complexes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chef"
				},
				{
					"id": 741871204,
					"content": "Le silence de la phobos est synonyme de refus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741871205
					]
