			"dialogs": [
				{
					"id": 741870201,
					"content": "#Hé, espèce de crétin ! Comment ça se fait qu'il y ait encore tant de caisses ici{NON_BREAK_SPACE}? Tu traînes des pieds. Combien de temps ça va te prendre ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870202
					],
					"speakerTitle": "Chef"
				},
				{
					"id": 741870202,
					"content": "C'est pas ça, chef ! Ces trésors sont vraiment trop lourds ! On les transporte sur le bateau depuis ce matin, mais il en reste encore plein...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870203
					],
					"speakerTitle": "Celui qu'on appelle « Crétin »"
				},
				{
					"id": 741870203,
					"content": "À quoi te servent tes gros bras alors ?! Ce sont des trésors ! C'est normal qu'ils pèsent leur poids !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870204
					],
					"speakerTitle": "Chef"
				},
				{
					"id": 741870204,
					"content": "En plus de ça, on a récupéré les trésors de ces maudits barbares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870205
					],
					"speakerTitle": "Chef"
				},
				{
					"id": 741870205,
					"content": "Tss, ces sales cafards ne méritent que de vivre comme les insectes qu'ils sont, leur laisser tous ces trésors serait un énorme gâchis !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870206
					],
					"speakerTitle": "Chef"
				},
				{
					"id": 741870206,
					"content": "Mais il va falloir des navires supplémentaires si vous voulez ramener tout ça à Remuria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870207
					],
					"speakerTitle": "Celui qu'on appelle « Crétin »"
				},
				{
					"id": 741870207,
					"content": "Espèce de crétin ! Comment les bateaux de transport de l'empire pourraient-ils accomplir une chose pareille ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870208
					],
					"speakerTitle": "Chef"
				},
				{
					"id": 741870208,
					"content": "Dans ce cas, il faudrait détruire tout ce qu'on ne peut pas emporter ! Rien ne doit tomber entre les mains de ces barbares !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870209
					],
					"speakerTitle": "Celui qu'on appelle « Crétin »"
				},
				{
					"id": 741870209,
					"content": "Oh, j'ai l'impression d'avoir déjà entendu cette conversation...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870210,
						741870211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870210,
					"content": "#La première fois que nous sommes {M#arrivés}{F#arrivées} à Petrichor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870212
					]
				},
				{
					"id": 741870212,
					"content": "Oui ! Les aventuriers malchanceux qu'on a chassés ont dit quelque chose de similaire, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870213,
					"content": "Et leurs propos sont encore pires qu'avant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870214,
					"content": "Comment ça a pu arriver ? Ils se sont transformés en golems après que leur navire a coulé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870215,
					"content": "Ça me fait peur rien que d'y penser !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870216,
					"content": "Êtes-vous de la Legio IX ? Que faites-vous ici ? Vous auriez dû battre en retraite au Fort Charybdis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870217
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870217,
					"content": "Hé, Este ! Ne gâchez pas notre plan !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870218
					],
					"speakerTitle": "Chef"
				},
				{
					"id": 741870218,
					"content": "#De toute façon, ces barbares sont plus faciles à gérer que des poissons morts{NON_BREAK_SPACE}! Vous pouvez bien nous laisser nous détendre ici encore un peu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870219
					],
					"speakerTitle": "Chef"
				},
				{
					"id": 741870219,
					"content": "Ces trésors... *soupir* Je ne sais pas quels ordres l'accordeur qui vous supervise vous a donnés...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870220
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870220,
					"content": "Mais le sébaste nous a ordonné de conquérir ces tribus ignorantes afin de les libérer des chaînes du destin, non ? Ce que vous avez fait... était sans aucun doute un crime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870221
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870221,
					"content": "Hein ? Notre commandant, le dominus Boethius, nous a demandé de punir sévèrement ces barbares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870222
					],
					"speakerTitle": "Chef"
				},
				{
					"id": 741870222,
					"content": "De plus, nous n'avons été punis d'aucune façon, ce qui signifie que la phobos et Sa Majesté le sébaste approuvent nos actions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870223
					],
					"speakerTitle": "Chef"
				},
				{
					"id": 741870223,
					"content": "Alors de quels crimes parlez-vous ? Vous cherchez à créer des ennuis ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870224
					],
					"speakerTitle": "Chef"
				},
				{
					"id": 741870224,
					"content": "Mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870225
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870225,
					"content": "Eh bien, on dirait qu'il y a un autre Este ? Les choses deviennent de plus en plus étranges.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870226,
					"content": "Je crois que c'est le bon moment pour répondre aux interrogations que vous aviez eues plus tôt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870227
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870227,
					"content": "L'Este du village est probablement un descendant des Rémuriens. Son ancêtre m'a suivi pour rejoindre la nouvelle nation et est devenu un simple Fontainois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870228
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870228,
					"content": "De ce fait, la Symphonie qui ne fait qu'enlever l'âme des Fontainois est inefficace contre lui. Cependant, la mélodie qui a enregistré les souvenirs de son ancêtre s'est accrochée à cette statue, car elle n'avait nulle part où aller.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870229
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870229,
					"content": "L'Este d'ici est en fait l'ancêtre de l'Este du village ? Este le rusé ? Et les autres ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870230,
					"content": "Ce sont des âmes qui errent ici parce qu'elles sont perdues dans les souvenirs du passé. Allons jeter un coup d'œil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870231
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870231,
					"content": "Vous avancez avec Monsieur Os...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741870232
					]
				},
				{
					"id": 741870232,
					"content": "Bonjour, Este !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870233,
					"content": "Bonjour, mais qui êtes-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870234
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870234,
					"content": "Vous n'avez pas l'air d'être des Rémuriens. Se pourrait-il que vous soyez des barbares ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870235,
						741870236
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870235,
					"content": "#Je ne suis qu'{M#un voyageur}{F#une voyageuse} de passage.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870237
					]
				},
				{
					"id": 741870237,
					"content": "Vous êtes sur un champ de bataille, c'est dangereux ! Peu importe qui vous êtes, vous feriez mieux de déguerpir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870238
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870238,
					"content": "C'est moi, Este. Cela faisait bien longtemps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870239
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870239,
					"content": "... Par les cieux. Dominus Cassiodor, c'est vous ! C'est rare de vous voir apparaître sous cette forme, j'ai failli ne pas vous reconnaître.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870240
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870240,
					"content": "#Et ces deux personnes... Ce sont vos {M#servants}{F#servantes} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870241,
						741870242
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870241,
					"content": "On dirait bien que oui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870245
					]
				},
				{
					"id": 741870245,
					"content": "Dominus Cassiodor, qu'est-ce que vous faites ici ? Le sébaste ne vous a donc pas envoyé à... Bon sang, pourquoi je ne m'en souviens pas ? Est-ce que c'était un rêve ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870246
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870246,
					"content": "Ça semble être le cas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870247
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870247,
					"content": "Haha, vous savez vraiment plaisanter ! Je suppose que c'est le sébaste qui vous a encore confié une mission secrète !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870248
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870248,
					"content": "Vous avez raison. Mais au fait, pourquoi ces soldats de la Legio IX gardent-ils ces chaînes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870249
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870249,
					"content": "Ces chaînes... Tu parles des trésors ? Je crois qu'ils les ont volés pendant la bataille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870250
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870250,
					"content": "Le sébaste estime que la guerre est un mal nécessaire pour réaliser nos ambitions et a interdit ce genre de comportement depuis bien longtemps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870251
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870251,
					"content": "Mais vous savez, c'est quelque chose d'assez courant de nos jours... Nous sombrons dans l'obscurité, mais les gens ne le voient pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870252
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870252,
					"content": "Dominus Cassiodor, y a-t-il quelque chose qui ne va pas ? La phobos était censée nous apporter le bonheur, mais je ne ressens qu'une douleur inexplicable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870253
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870253,
					"content": "Je cherche également une réponse à cette question, mais on dirait qu'il va falloir d'abord résoudre le problème qui s'est présenté à nous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870254
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870254,
					"content": "Ces gens restent quand même des membres de notre légion, alors essayons de résoudre les choses de manière pacifique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Este"
				},
				{
					"id": 741870242,
					"content": "#Je suis {M#son maître}{F#sa maîtresse}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870243
					]
				},
				{
					"id": 741870243,
					"content": "... Hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870244
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870244,
					"content": "#Ouah ! {NICKNAME}, ne complique pas les choses ! C'était juste une blague ! Continuez, Este, je vous en prie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870236,
					"content": "J'ai un côté barbare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870237
					]
				},
				{
					"id": 741870211,
					"content": "C'étaient les « Pilleurs de trésors » que nous avons rencontrés plus tôt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870212
					]
				}
			]
		},
