							1641.498,
							588.635,
							4626.62
						],
						"pointId": 3
					}
				]
			},
			"dialogs": [
				{
					"id": 741870601,
					"content": "Ahem, les soldats de la Legio IX.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870602,
					"content": "#Qui êtes-vous ? Des {M#assistants}{F#assistantes} d'Este ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870603,
						741870605,
						741870607
					],
					"speakerTitle": "Chef"
				},
				{
					"id": 741870603,
					"content": "Oui, c'est exact.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870604
					]
				},
				{
					"id": 741870604,
					"content": "#On n'est pas des {M#assistants}{F#assistantes} ordinaires, mais vraiment très {M#forts}{F#fortes} ! On est {M#venus}{F#venues} avec le dominus Cassiodor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870609,
					"content": "#({NICKNAME}, Paimon... Je vois que vous avez un certain talent pour jouer la comédie.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870610
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870610,
					"content": "Hmm... Le dominus Cassiodor, vous dites ? J'ai entendu dire que le sébaste l'avait envoyé en Arémorique. Il est déjà de retour ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870611
					],
					"speakerTitle": "Chef"
				},
				{
					"id": 741870611,
					"content": "Eh bien, à nos côtés se trouve...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870612,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870613
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870613,
					"content": "Hum... Bref, on est ici pour voir la situation des légions en première ligne !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870614,
					"content": "D'accord. C'est bien ce que je me disais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870615
					],
					"speakerTitle": "Chef"
				},
				{
					"id": 741870615,
					"content": "Même si nous n'avons pas suivi la plus grande partie des troupes au Fort Charybdis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870616
					],
					"speakerTitle": "Chef"
				},
				{
					"id": 741870616,
					"content": "... En tant qu'arrière-garde, nous sommes restés ici pour terminer de « nettoyer ». C'est tout à fait normal !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870617
					],
					"speakerTitle": "Chef"
				},
				{
					"id": 741870617,
					"content": "C'est aussi un ordre de la phobos ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870618
					]
				},
				{
					"id": 741870618,
					"content": "Ah ça... La phobos devait guider tous nos faits et gestes. Cependant, depuis que nous sommes arrivés ici, nous ne pouvons pas ressentir sa mélodie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870619
					],
					"speakerTitle": "Chef"
				},
				{
					"id": 741870619,
					"content": "Par conséquent, on ne peut qu'agir selon les instructions du dominus Boethius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870620,
						741870623
					],
					"speakerTitle": "Chef"
				},
				{
					"id": 741870620,
					"content": "C'est le type grossier...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870621
					]
				},
				{
					"id": 741870621,
					"content": "Hé ! Comment osez-vous parler ainsi de lui ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870622
					],
					"speakerTitle": "Chef"
				},
				{
					"id": 741870622,
					"content": "En tant que noble accordeur, monsieur Boethius a agi conformément aux instructions du sébaste, et ses ordres sont de même importance que ceux de la phobos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870626,
						741870628
					],
					"speakerTitle": "Chef"
				},
				{
					"id": 741870626,
					"content": "Peut-être que la phobos peut, elle aussi, se tromper.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870627
					]
				},
				{
					"id": 741870627,
					"content": "Vous venez de Remuria ? Ne me dites pas que vous ignorez que c'est le sébaste ainsi que la prophétesse infaillible qui l'ont créée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chef"
				},
				{
					"id": 741870628,
					"content": "Mais vous ne recevez pas la mélodie non plus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870629
					]
				},
				{
					"id": 741870629,
					"content": "C'est vrai, mais à qui pourrions-nous bien faire confiance, si ce n'est à la phobos ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870630
					],
					"speakerTitle": "Chef"
				},
				{
					"id": 741870630,
					"content": "Comment pourrait-elle rester indifférente si nous nous égarions ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chef"
				},
				{
					"id": 741870623,
					"content": "Le sébaste ne vous a pas permis de faire du mal à des innocents.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870624
					]
				},
				{
					"id": 741870624,
					"content": "Faire du mal à des innocents... Bien que le sébaste nous ait ordonné de sauver ces humains vulnérables...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870625
					],
					"speakerTitle": "Chef"
				},
				{
					"id": 741870625,
					"content": "Mais nos actions sont tacitement approuvées par la phobos. Est-ce que les décrets de la phobos pourraient violer la sainte volonté du sébaste ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870626,
						741870628
					],
					"speakerTitle": "Chef"
				},
				{
					"id": 741870605,
					"content": "#Nous sommes des émissaires {M#spéciaux envoyés}{F#spéciales envoyées} par Sa Majesté le sébaste.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870606
					]
				},
				{
					"id": 741870606,
					"content": "#Des émissaires ? Oh, c'est bien ça ! Et on est {M#venus}{F#venues} avec le dominus Cassiodor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870607,
					"content": "#Nous sommes les {M#serviteurs}{F#serviteuses} de Cassiodor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870608
					]
				},
				{
					"id": 741870608,
					"content": "#C'est ça ! On est ses {M#serviteurs}{F#serviteuses} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870609
					],
					"speakerTitle": "Paimon"
				}
			]
		},
