			"dialogs": [
				{
					"id": 710190201,
					"content": "Il y a une pierre géante dans ce grand pot. Je crois qu'on appelle ça une « rocaille » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710190202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710190202,
					"content": "D'habitude, c'est dans les jardins qu'on en trouve, non ? Pourquoi en avoir placé une à cet endroit ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710190203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710190203,
					"content": "Puis on dirait qu'il y a un symbole étrange dessus... Ça ne me rassure pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710190204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710190204,
					"content": "Puisqu'on y est, partons à la recherche d'une montagne qui ressemble à cette rocaille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710190205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710190205,
					"content": "Ça serait cool qu'on trouve quelque chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
