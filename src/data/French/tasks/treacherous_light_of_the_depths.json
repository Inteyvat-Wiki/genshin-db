			},
			"dialogs": [
				{
					"id": 740812401,
					"content": "Ce sont ces rubans perforés que nous devions récupérer, pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740812402,
					"content": "Vous présentez les rubans perforés que vous avez récupérés à Sévigne...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740812403
					]
				},
				{
					"id": 740812403,
					"content": "Oui, c'est bien ça. Vous êtes vraiment efficaces et ne faites pas traîner les choses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812404
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740812404,
					"content": "Cette tâche est simple ! On aura fini en un rien de temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740812405,
					"content": "C'est quand même impressionnant. Sans exagérer, certains de mes collègues peuvent carrément passer une journée entière à chercher un seul document...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812406
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740812406,
					"content": "Bref, pourriez-vous ramener ces rubans perforés à Chisseray, s'il vous plaît ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812407
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740812407,
					"content": "Dites-lui que je ne prévois pas de rentrer pour le moment. Oh, et aussi, veuillez lui demander de prendre contact avec Maillardet pour venir récupérer les prototypes qui sont ici au plus vite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812408
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740812408,
					"content": "#D'accord. Alors, {NICKNAME}, est-ce qu'on revient par là où on est {M#venus}{F#venues} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740812409,
					"content": "Ce ne sera pas la peine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812410
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740812410,
					"content": "Vous êtes aptes à faire de la plongée, non ? Il y a un passage sous-marin par ici qui devrait mener à l'extérieur. Il était temporairement fermé pour éviter les accidents, mais je vais vous ouvrir la voie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812411
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740812411,
					"content": "#Super ! {NICKNAME}, repartons par la voie sous-marine !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740812412,
					"content": "La borne pour ouvrir le passage se trouve à l'intérieur. Je vais m'en occuper. Vous vous en sortirez sans mon aide ? Vous ne risquez pas de vous perdre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812413
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740812413,
					"content": "#Vous nous sous-estimez ! Je suis la meilleure guide de Teyvat. Avec moi, comment {NICKNAME} pourrait-{M#il}{F#elle} se perdre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740812414,
					"content": "Vous êtes vraiment dignes de confiance. Je compte sur vous deux pour livrer le message et ramener les rubans perforés. J'espère que ça ne vous dérange pas si je ne vous accompagne pas vers la sortie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sévigne"
				}
			]
		},
