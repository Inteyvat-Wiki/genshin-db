							4411.186,
							372.68,
							3835.364
						],
						"pointId": 6385
					},
					{
						"sceneId": 3,
						"position": [
							4411.186,
							372.68,
							3834.401
						],
						"pointId": 6386
					}
				]
			},
			"dialogs": [
				{
					"id": 740811701,
					"content": "Euh... On n'a pas fait une grosse bêtise, j'espère ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811702,
					"content": "J'ai l'impression d'avoir ressenti une secousse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811703,
						740811704
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811703,
					"content": "Moi aussi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811705
					]
				},
				{
					"id": 740811705,
					"content": "Euh, c'est peut-être parce que nous avons actionné le mécanisme du niveau supérieur tout à l'heure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811706,
					"content": "Cette porte-là était verrouillée auparavant, non ? Quelques Mékas horlogoïdes ont même été postés à l'entrée pour surveiller...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811707,
						740811708
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811707,
					"content": "J'ai ouvert la porte après les avoir « mis en veille ».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811709
					]
				},
				{
					"id": 740811709,
					"content": "#Euh, on n'avait pas vraiment d'option ! Ce sont eux qui nous ont {M#agressés}{F#agressées} en premier, c'était de la légitime défense, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811710,
					"content": "Les prototypes de Maillardet... étaient censés être à l'arrêt, et puis après tout, depuis qu'il a découvert un bon emplacement sur l'Île d'Erinnyes, il est rarement revenu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811711
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811711,
					"content": "En y réfléchissant bien, si on peut présenter les résultats de nos travaux de recherche dehors dans un jardin magnifique, qui serait disposé à retourner dans un laboratoire sombre, humide et en décrépitude comme celui-ci ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811712
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811712,
					"content": "Après le départ de monsieur Bossuet, tout le monde s'est dispersé aux quatre coins de l'Institut de recherche de Fontaine en emportant tout, il ne reste même pas un canapé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811713
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811713,
					"content": "Seuls les prototypes sont restés ici et attendent ceux qui ne reviendront pas. Initialement, ils étaient simplement là en mode veille, ce qui ne devait pas causer de souci, mais maintenant, c'est différent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811714
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811714,
					"content": "Regardez ça, ces machines sont toutes cassées, leurs ressorts sont sur le point de se détacher. Si Maillardet découvrait ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811715,
						740811716
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811715,
					"content": "#C'est ma faute, je suis {M#désolé}{F#désolée}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811718
					]
				},
				{
					"id": 740811718,
					"content": "Désolée, est-ce que cette machine coûte cher ? Si on doit rembourser...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811719,
					"content": "Pas de panique. Ce que je voulais dire, c'est que si Maillardet découvrait ça, il éclaterait de rire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811720
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811720,
					"content": "Il avait l'habitude d'interrompre lui-même la danse des prototypes. Ensuite, après avoir été battu, il restait assis à rire de bon cœur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811721
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811721,
					"content": "Au fait, après toute cette discussion, je ne me suis pas encore présentée. Je suis chercheuse à l'Institut de recherche de Fontaine, vous pouvez m'appeler Sévigne. Et vous deux, c'est quoi, vos noms ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811722
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811722,
					"content": "#Je suis Paimon, {M#lui}{F#elle}, c'est {NICKNAME}, nous sommes... Euh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811723,
						740811725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811723,
					"content": "Nous ne faisons que passer, nous n'avons aucune intention particulière.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811724
					]
				},
				{
					"id": 740811724,
					"content": "Oui ! Nous sommes simplement de passage, nous ne sommes pas du tout à la recherche d'un trésor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811726
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811726,
					"content": "Oh, vous voulez dire que vous comptez organiser des activités de chasse aux trésors dans des ruines pour les touristes ? Eh bien, vous avez choisi le mauvais endroit, même si on dirait des ruines ici... Tout compte fait, ce sont aussi des ruines.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811727
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811727,
					"content": "Cependant, cet endroit n'est pas encore considéré comme un lieu recommandé pour le tourisme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811728
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811728,
					"content": "Bon, alors nous partons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811729,
					"content": "... Un instant, vous connaissez le Nouvel Institut de recherche de Fontaine ? Si vous partez, j'aimerais que vous me rendiez service. Allez voir Chisseray pour moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811730,
						740811731
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811730,
					"content": "Mais nous n'allons pas au Nouvel Institut de recherche de Fontaine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811732
					]
				},
				{
					"id": 740811732,
					"content": "Comment faire alors ? J'ai encore des tâches à accomplir, les prototypes de Maillardet sont à nouveau endommagés, il faut rapidement trouver quelqu'un pour les récupérer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811733
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811733,
					"content": "#Hmm... {NICKNAME}, et si on lui rendait service ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811734,
					"content": "Super ! Si vous êtes d'accord pour faire passer le message, je vous confierai aussi la tâche de récupérer les rubans perforés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811735,
						740811736
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811735,
					"content": "Si j'avais su, je n'aurais pas touché aux dispositifs à l'extérieur...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811746
					]
				},
				{
					"id": 740811746,
					"content": "Ne dites pas ça. C'est du gâteau pour vous ce genre de tâche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811737
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811737,
					"content": "De cette manière, je peux faire rembourser le coût de la mission en les faisant passer pour des frais de récupération des données de recherche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811738
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811738,
					"content": "Ah bon ? Ça ne pose vraiment aucun problème ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811739,
					"content": "Après tout, vous m'avez bien aidée dans mes travaux de recherche. C'est tout à fait normal, il n'y a aucun souci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811740
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811740,
					"content": "Et puis, si c'est contraire aux règles, l'administration refusera. Dans ce cas-là, j'assumerai moi-même les frais de la mission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811741
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811741,
					"content": "Vous faites souvent ce genre de choses ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811742
					]
				},
				{
					"id": 740811742,
					"content": "Personnellement, non. Pour les autres, je ne sais pas, j'ai entendu quelques rumeurs auparavant, mais... Non, je ne dois pas divulguer ce genre d'informations à n'importe qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811743
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811743,
					"content": "Il y a trois rubans perforés à récupérer, ils sont sur les étagères. Ça ne devrait pas être difficile à trouver, merci de me donner un coup de main.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811744
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811744,
					"content": "Pendant ce temps-là, je dois réexaminer les prototypes, étant donné que personne ne les a entretenus depuis longtemps... Ce serait problématique s'ils devenaient hors de contrôle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811745
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811745,
					"content": "Bien, nous reviendrons vous voir une fois que nous aurons récupéré les rubans perforés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811736,
					"content": "D'accord, vous pouvez compter sur moi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811737
					]
				},
				{
					"id": 740811731,
					"content": "Nous avons d'autres trésors à trouver.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811732
					]
				},
				{
					"id": 740811725,
					"content": "D'ailleurs, il y a des trésors ici ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811726
					]
				},
				{
					"id": 740811716,
					"content": "Avez-vous songé à augmenter la résistance des prototypes ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811717
					]
				},
				{
					"id": 740811717,
					"content": "C'est ce que Maillardet a fait. Peut-être que le produit final sera aussi robuste que vous l'espérez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811718
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811708,
					"content": "Tiens, c'est étrange, pourquoi la porte s'est ouverte ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811709
					]
				},
				{
					"id": 740811704,
					"content": "Ça doit être votre imagination.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811705
					]
				}
			]
		},
