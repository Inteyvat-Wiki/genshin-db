			"dialogs": [
				{
					"id": 740813101,
					"content": "Bonjour ! En ce qui concerne Sévigne...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740813102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740813102,
					"content": "Vous expliquez la situation à Chisseray et lui remettez les trois rubans perforés que vous avez récupérés...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740813103
					]
				},
				{
					"id": 740813103,
					"content": "Je me faisais du souci pour elle et j'hésitais à aller la voir. Je ne m'attendais pas à une chose pareille. Merci de m'avoir apporté de ses nouvelles... ainsi que les rubans perforés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740813104
					],
					"speakerTitle": "Chisseray"
				},
				{
					"id": 740813104,
					"content": "Jamais je n'aurais cru que les prototypes de Maillardet seraient encore opérationnels et Sévigne continuait de travailler dans un environnement dangereux. Je vais devoir aller discuter avec les responsables administratifs pour arranger la récupération des machines.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740813105
					],
					"speakerTitle": "Chisseray"
				},
				{
					"id": 740813105,
					"content": "Ce serait aussi l'occasion de se renseigner sur la question du remboursement des frais... Sévigne a vraiment eu une idée brillante. Cependant, nous ne savons pas si les agents administratifs considéreront que c'est conforme aux règles, alors je vais devoir avancer l'argent pour l'instant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740813106
					],
					"speakerTitle": "Chisseray"
				},
				{
					"id": 740813106,
					"content": "Quoi qu'il en soit, je vous remercie pour votre aide. Veuillez accepter cette récompense pour avoir accompli la mission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chisseray"
				}
