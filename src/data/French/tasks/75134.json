			"dialogs": [
				{
					"id": 751340201,
					"content": "Raouh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340202
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751340202,
					"content": "L'extérieur a été corrodé par l'Abîme. On dirait que ça va s'effondrer à tout moment. C'est ce que Coco voulait nous montrer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340203,
					"content": "On ne sait pas non plus ce qu'il y a à l'intérieur, mais je suis presque sûre qu'il ne s'agit pas de l'autel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340204,
					"content": "« Une logique rigide ne nous mènera nulle part... »",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340205
					]
				},
				{
					"id": 751340205,
					"content": "Je comprends maintenant. Coco a refusé de venir à cause de l'Abîme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340206,
					"content": "On doit s'occuper de l'Abîme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340207
					]
				},
				{
					"id": 751340207,
					"content": "Oui, c'est sûrement pour ça que Coco n'a pas voulu entrer. Il faut s'en débarrasser !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340208,
					"content": "#Allons-y, {REALNAME[ID(2)|SHOWHOST(true)]} !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340209
					]
				},
				{
					"id": 751340209,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340210
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751340210,
					"content": "Et moi, alors ? Vous abusez !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340211,
					"content": "C'est l'heure du ménage !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
