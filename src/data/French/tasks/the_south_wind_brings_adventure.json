				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Stanley",
					"Jack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101110401,
					"content": "*halète* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110402
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101110402,
					"content": "J'ai bien cru que j'allais y passer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110403
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110403,
					"content": "C'est vrai qu'il s'en est fallu de peu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110404
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110404,
					"content": "Tu dois être Jack l'aventurier, si je ne m'abuse ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110405
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110405,
					"content": "Oui, et vous êtes...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110406
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110406,
					"content": "On est venus te chercher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101110407,
					"content": "Eileen a un message pour toi. Elle a dit qu'elle ne pourra pas discuter de votre prochaine aventure ensemble aujourd'hui et que ce n'est que partie remise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110408
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110408,
					"content": "Oh... Et vous êtes venus jusqu'ici pour me le transmettre – et vous m'avez sauvé en plus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110409
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110409,
					"content": "Tsss ! Pas de quoi en faire un fromage ! Rien que Stanley, votre serviteur, n'aurait pu résoudre lui-même !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110410
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101110410,
					"content": "Hé, c'est vous Stanley, l'aventurier légendaire qui a voyagé jusqu'à la Mare Jivari !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101110411,
					"content": "C'est bien moi en effet !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110412
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101110412,
					"content": "Haha, c'est un honneur que de rencontrer une telle célébrité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110413
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110413,
					"content": "Très bien, et à présent, que fait-on ? On revient sur nos pas, ou on continue ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110414,
						101110417
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110414,
					"content": "Qu'en dites-vous, Stanley ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110415
					]
				},
				{
					"id": 101110415,
					"content": "#Haha, {M#voyageur}{F#voyageuse}, c'est le grand Stanley qui vous accompagne !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110416
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101110416,
					"content": "Vous ne voudriez tout de même pas rebrousser chemin ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110419
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101110419,
					"content": "Bien, le vote est unanime alors : continuons !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110417,
					"content": "Jack, qu'en dis-tu ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110418
					]
				},
				{
					"id": 101110418,
					"content": "Je crois qu'on ferait mieux de continuer d'avancer. Avec Stanley à nos côtés, on ne craint rien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110419
					],
					"speakerTitle": "Jack"
				}
			]
		},
		{
			"id": 1011106,
			"completionStepIds": [
				1011106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1011106",
							"2"
						],
						"stepId": 1011106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101110601,
					"content": "#{M#Voyageur}{F#Voyageuse}, je crois bien que j'ai trouvé quelque chose d'intéressant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110602
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110602,
					"content": "Serais-tu assez aimable pour utiliser à nouveau le détecteur ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110603
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110603,
					"content": "Oh ! Stanley a lui aussi un ami imaginaire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101110604,
					"content": "On dirait un combattant qui a vu plus d'un champ de bataille... Couvert de cicatrices de la tête aux pieds, et l'air déterminé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110605,
						101110608
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110605,
					"content": "On dirait l'image que Stanley se fait de lui-même dans ses histoires.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110606
					]
				},
				{
					"id": 101110606,
					"content": "Tu veux dire que son ami imaginaire serait en fait une version idéalisée de lui-même ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110607
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110607,
					"content": "Intéressant... Mais est-ce vraiment le cas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110611
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110611,
					"content": "Bien, si vous voulez bien m'excuser, je vais y aller.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110612
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101110612,
					"content": "Au revoir, Stanley !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110613
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110613,
					"content": "Dites-moi, vous avez un peu de temps ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110614
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110614,
					"content": "Hmm ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110615
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110615,
					"content": "Il y a quelques jours, Stanley a bu jusqu'à plus soif, et m'a confié un secret qu'il n'a jamais confié à personne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110616
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110616,
					"content": "Les armes qu'il portait lors de ses aventures... Il s'agissait de deux armes ayant appartenu à la grande Vennessa : l'<color=#00E1FFFF>Épée brillante de vaillance</color>, et l'<color=#00E1FFFF>Écu éclatant de l'honneur</color> !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110617
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110617,
					"content": "Vous ne me croirez peut-être pas, mais... Apparemment, les deux sont toujours ici à Mondstadt, du côté de la <color=#00E1FFFF>Vallée Dadaupa</color> !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110618
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110618,
					"content": "#Vous êtes tellement {M#forts tous les deux}{F#fortes toutes les deux}, vous pourriez peut-être aller les chercher ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110619,
						101110621
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110619,
					"content": "Ce genre d'arme légendaire existe vraiment ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110620
					]
				},
				{
					"id": 101110620,
					"content": "Bien sûr ! C'est de Stanley le grand aventurier qu'on parle !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110623
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110623,
					"content": "Si seulement j'arrive à mettre la main sur quelque chose d'aussi impressionnant, alors peut-être que ma famille acceptera l'idée que je devienne un aventurier...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110624
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110624,
					"content": "J'ai encore beaucoup à apprendre, et puis mes parents ne me soutiennent pas du tout...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110625
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110625,
					"content": "Alors si vous pouvez m'aider, ça serait vraiment sympa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110626
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110626,
					"content": "Je n'ai pas osé en parler à Stanley, parce que c'est très égoïste de ma part... Mais je jure qu'une fois que j'en aurai fini avec les armes je les lui rendrai aussitôt !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110627
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110627,
					"content": "Oh, pauvre Jack... Allez, il faut qu'on l'aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110628,
						101110629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101110628,
					"content": "D'accord.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110630
					]
				},
				{
					"id": 101110630,
					"content": "Venti, tu te joins à nous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101110631,
					"content": "Hum, je ne sais pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110632
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110632,
					"content": "Oh, encore une chose ! J'ai une bouteille d'un excellent vin qu'on m'avait offert il y a quelques années ; elle est à vous si vous me ramenez les armes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110633
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110633,
					"content": "La <color=#00E1FFFF>Vallée Dadaupa</color>, c'est bien ça ? N'attendons pas plus longtemps, en route !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110629,
					"content": "On ne peut pas l'ignorer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110630
					]
				},
				{
					"id": 101110621,
					"content": "Stanley a juste abandonné deux artéfacts au beau milieu de nulle part ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110622
					]
				},
				{
					"id": 101110622,
					"content": "Les génies ont toujours un côté excentrique, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110623
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110608,
					"content": "À dire vrai, ses histoires sonnent un peu bizarre, non ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110609
					]
				},
				{
					"id": 101110609,
					"content": "Ah, toi aussi, tu les trouves étranges ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110610
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110610,
					"content": "On dirait bien que ses récits cachent quelque chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110611
					],
					"speakerTitle": "Venti"
				}
			]
		}
	]
}