				},
				{
					"id": 220100917,
					"content": "Comment ? Mais s'il continue dans cette voie, il se finira noyé dans tous ces détails !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100918
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100918,
					"content": "#Hahaha ! Regarde, même {M#le voyageur}{F#la voyageuse} est de mon côté ! Cela prouve que mon idée est intéressante !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100919
