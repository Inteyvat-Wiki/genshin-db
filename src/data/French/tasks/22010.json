			"dialogs": [
				{
					"id": 220100801,
					"content": "Les doushins préservent l'ordre à Hanamizaka. Aucun individu suspect n'échappe à leur surveillance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100802
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100802,
					"content": "Les gardes du territoire ennemi ont la même responsabilité qu'eux. Mais pour rendre les choses plus palpitantes, je vais décupler leur force par... dix !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100803,
						220100805
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100803,
					"content": "Dix ?! C'est aléatoire comme chiffre !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100804
					]
				},
				{
					"id": 220100804,
					"content": "C'est de cette façon qu'on se rend compte de la force du héros !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100806
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100806,
					"content": "Voyons... Je sais ! Je vais lui donner le pouvoir de métamorphose ! Il pourra changer de forme physique et de voix à souhait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100807
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100807,
					"content": "C'est un élément qui sort de nulle part...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100808
					]
				},
				{
					"id": 220100808,
					"content": "C'est son pouvoir secret. Il doit bien s'en servir quand le besoin se fait sentir, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100809
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100809,
					"content": "Vous venez tout juste de l'inventer...",
