			},
			"dialogs": [
				{
					"id": 220100301,
					"content": "Dans le chapitre que je suis en train d'ébaucher, le héros aimerait vendre des objets qu'il a accumulés au cours de ses aventures pour gagner un peu d'argent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100302
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100302,
					"content": "Dans ce cas, il faudrait que je me rende à un endroit avec des commerçants...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100303
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100303,
					"content": "Je réfléchis... Oui, allons faire un tour à l'Épicerie Tsukumomono.",
