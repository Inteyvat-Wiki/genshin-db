				"points": []
			},
			"dialogs": [
				{
					"id": 220100401,
					"content": "Dans le chapitre que je suis en train d'ébaucher, le héros décide de se rendre seul en territoire ennemi pour en découdre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100402
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100402,
					"content": "Pour cela, il lui faut obtenir des renseignements. Comment pourrai-je lui faciliter la tâche ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100403
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100403,
					"content": "Allons voir comment les doushins font leur travail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
