			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shigeru",
					"Junkichi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220100101,
					"content": "Junkichi, tu as jusqu'à demain pour remettre ton manuscrit. Assez traîné !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100102
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100102,
					"content": "Tu as beau me mettre la pression, je reste bloqué à un passage crucial de mon histoire. Je ne sais pas comment continuer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100103
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100103,
					"content": "Pourquoi vous vous disputez ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100104
					]
				},
				{
					"id": 220100104,
					"content": "#{M#Voyageur}{F#Voyageuse} ? Vous tombez à pic, j'ai besoin de quelqu'un pour m'aider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100105
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100105,
					"content": "Je suis Shigeru, éditeur de la Chambre Yae, et voici Junkichi, l'auteur dont je m'occupe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100106
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100106,
					"content": "Son roman « Onibudo » est très apprécié du public, mais il n'arrive jamais à terminer ses manuscrits à l'heure. Parfois, il les rend avec plusieurs semaines de retard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100107
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100107,
					"content": "C'est encore le même manège aujourd'hui. S'il ne rend pas son texte demain, la parution du chapitre de son histoire dans le magazine du mois sera compromise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100108
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100108,
					"content": "Repoussons simplement la sortie, non ? Les lecteurs fidèles l'achèteront quand même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100109
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100109,
					"content": "Tu te fiches de moi ? La popularité de ton roman en pâtira s'il n'y a pas de parutions régulières !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100110
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100110,
					"content": "Je n'y peux rien si je ne suis pas inspiré. Autant prendre son temps pour réfléchir à une suite intéressante plutôt que d'écrire un chapitre de remplissage !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100111
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100111,
					"content": "Mais tous les autres auteurs ont déjà rendu leur travail, il ne reste plus que toi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100112
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100112,
					"content": "Peut-être que Junkichi a vraiment besoin d'inspiration...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100113
					]
				},
				{
					"id": 220100113,
					"content": "#Exactement ! Notre {M#ami}{F#amie} sait exactement de quoi je parle. Il me faut de l'inspiration !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100114
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100114,
					"content": "Peut-être que je saurais quoi écrire ensuite en regardant autour de moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100115
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100115,
					"content": "C'est ce que tu m'as dit la dernière fois aussi. Résultat ? Un jour de retard ! Je ne me ferai pas avoir de nouveau !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100116
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100116,
					"content": "Je te promets que je serai dans les temps cette fois-ci ! Fais-moi confiance !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100117
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100117,
					"content": "Ah là là... Bon, je t'accorde une dernière chance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100118
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100118,
					"content": "Mais pas une seule seconde de retard, suis-je bien clair ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100119
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100119,
					"content": "D'accord, c'est compris...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100120
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100120,
					"content": "Je ne peux vraiment pas être en retard cette fois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100121,
						220100122
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100121,
					"content": "Cherchons des choses qui pourraient vous inspirer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220100122,
					"content": "Trouvons l'inspiration.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100123
					]
				},
				{
					"id": 220100123,
					"content": "Même si on la cherche, l'inspiration n'est pas une chose qui nous vient facilement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100124
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100124,
					"content": "Mais je n'ai pas d'autre choix que d'aller me promener pour l'instant, sinon Shigeru mettra ma maison sens dessus dessous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		},
