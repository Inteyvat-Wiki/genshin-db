					"nextDialogs": [
						220100810
					]
				},
				{
					"id": 220100810,
					"content": "Je... P—Pas du tout ! C'était déjà prévu depuis le début.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100811
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100811,
					"content": "Bon, c'est réglé. Rentrons à présent, je vais faire part de mon idée à Shigeru.",
