					"content": "Ensuite, tu feras de nouveaux chapitres en écrivant sur toutes sortes de détails complexes liés à ces éléments. Ai-je tort ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220101110
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220101110,
					"content": "Je sais que tu aimes ton personnage, mais pourrais-tu arrêter de lui donner autant de pouvoirs ?! Les lecteurs ne comprendront plus rien !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220101111
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220101111,
					"content": "J'ai toujours écrit mon histoire de cette manière ! Ces éléments rendent l'histoire trépidante, je suis certain que les lecteurs apprécieront !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220101112
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220101112,
					"content": "Arrête avec tes inepties ! Les lecteurs s'emmêlent déjà les pinceaux rien qu'avec les mots que tu as créés de toutes pièces !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220101113
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220101113,
					"content": "#Je refuse de continuer cette conversation, tu es trop vieux jeu ! Laissons {M#le voyageur}{F#la voyageuse} trancher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220101114
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220101114,
					"content": "#Dites-nous, {M#voyageur}{F#voyageuse}. Qui de nous deux a raison ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220101107,
					"content": "Avec quoi ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220101108
					]
				}
