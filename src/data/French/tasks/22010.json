					"Junkichi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220100601,
					"content": "Les étincelles volent, les marteaux et les enclumes s'entrechoquent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100602
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100602,
					"content": "La Forge d'Amenoma est un endroit débordant d'énergie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100603
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100603,
					"content": "Avec l'aide de simples outils, les forgerons sont capables de transformer des bases d'armes et du minerai brut en des armes d'une qualité exceptionnelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100604
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100604,
					"content": "Et si l'alchimie était utilisée pendant la forge, on obtiendrait une arme divine qui rendrait le héros invincible, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100605,
						220100606
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100605,
					"content": "L'alchimie n'a rien de si extraordinaire...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100608
					]
				},
				{
					"id": 220100608,
					"content": "Cette idée n'est vraiment pas mal du tout ! Allez, notre héros se retrouve en possession d'une arme qui le rend invincible grâce à l'alchimie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100609
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100609,
					"content": "Il faudrait aussi lui donner un nom à cette arme... et une histoire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100610
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100610,
					"content": "Oui, ça me plaît !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100611
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100611,
					"content": "#Rentrons à présent, {M#voyageur}{F#voyageuse}. Je dois parler de mon idée à Shigeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100606,
					"content": "Vous vous méprenez sur l'alchimie...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100607
					]
				},
				{
					"id": 220100607,
					"content": "Ah bon ? Mais l'alchimie n'est-elle pas justement l'art de rendre l'impossible possible ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100608
					],
					"speakerTitle": "Junkichi"
				}
