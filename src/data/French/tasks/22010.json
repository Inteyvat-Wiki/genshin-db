			"dialogs": [
				{
					"id": 220100701,
					"content": "On trouve toutes sortes d'objets à l'Épicerie Tsukumomono, même des butins d'aventure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100702
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100702,
					"content": "Comme Aoi le dit toujours : « Un objet aussi dénué de valeur soit-il, trouve toujours acheteur. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100703
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100703,
					"content": "Hmm, on dirait qu'il faut mettre en avant les éléments du produit susceptibles d'intéresser l'acheteur si on veut en tirer un bon prix.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100704
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100704,
					"content": "Si je venais à incorporer ça dans mon histoire, il faudrait que je passe du temps à décrire le jeu psychologique entre les personnages. Cela ne correspond pas vraiment au style du roman...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100705
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100705,
					"content": "Le héros pourrait être capable de lire dans les pensées de l'acheteur... Cela lui permettra de cerner directement ses attentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100706,
						220100708
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100706,
					"content": "N'ajoutez pas des éléments qui sortent de nulle part !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100707
					]
				},
				{
					"id": 220100707,
					"content": "Ça fait partie du développement du personnage, pas de quoi en faire tout un plat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100710
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100710,
					"content": "J'ai retrouvé l'inspiration ! Je sais exactement ce que je vais écrire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100711
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100711,
					"content": "#Rentrons à présent, {M#voyageur}{F#voyageuse}. Je dois parler de mon idée à Shigeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100708,
					"content": "Ça sort quand même un peu de nulle part...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100709
					]
				},
				{
					"id": 220100709,
					"content": "Je ferai en sorte que ça se raccorde à l'histoire, ça ne devrait pas poser problème.",
