			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cazcal"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250212609,
					"content": "(Hora se détend peu à peu. Il s'étire et les griffes de ses pattes sortent. On dirait qu'il est temps de les lui couper.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212610
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250212610,
					"content": "Grâce aux conseils de Cazcal, vous coupez les griffes de Hora avec soin.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250212601
					]
				},
				{
					"id": 250212601,
					"content": "#Hahaha, je ne m'attendais pas à ce que vous soyez aussi {M#doué}{F#douée} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212602
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212602,
					"content": "Raouh raouh, raouh raouh, raouh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212603
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250212603,
					"content": "Hora vous remercie aussi. Vous l'avez toiletté si soigneusement. Il pourra sans aucun doute creuser plus vite dans la terre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212604
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212604,
					"content": "Prenez ceci en guise de remerciement. Euh... Au fait, si vous devez vous occuper d'autres petits sauriens à l'avenir, ne répétez pas bêtement la méthode que je vous ai enseignée aujourd'hui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212605
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212605,
					"content": "Chaque bébé saurien a un tempérament différent, il faut s'adapter. Même après tout ce temps, je sais seulement comment faire pour m'occuper de Hora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212606
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212606,
					"content": "Mais je m'en satisfais. Après tout, Hora et moi, sommes partis pour rester longtemps ensemble...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212607
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212607,
					"content": "Hein ? Où est passé Hora ? Non, ne me dites pas qu'il s'est enfui à nouveau ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212608
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212608,
					"content": "Hé ! Horaaaaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				}
			]
		},
