			},
			"dialogs": [
				{
					"id": 250212709,
					"content": "(Au lieu de se détendre, Hora vous regarde d'un air perplexe.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212710
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212710,
					"content": "(Cazcal a pris le relais juste à temps. Après un nettoyage méticuleux, il est finalement arrivé à couper les griffes de Hora...)",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250212701
					]
				},
				{
					"id": 250212701,
					"content": "#Ce n'est rien. Ça m'arrive parfois de mal le comprendre, mais il sait que vous êtes {M#un très bon ami}{F#une très bonne amie} à lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212702
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212702,
					"content": "Raouh raouh, raouh !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212703
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250212703,
					"content": "Hahaha, vous voyez, je vous l'avais dit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212704
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212704,
					"content": "Merci beaucoup ! Allez, prenez ça en guise de remerciement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212705
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212705,
					"content": "Les intentions de petits sauriens sont tellement difficiles à deviner. J'arrive à savoir la plupart des choses qui passent par la tête de Hora seulement parce que j'ai passé beaucoup de temps avec lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212706
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212706,
					"content": "Mais je m'en satisfais. Après tout, Hora et moi, sommes partis pour rester longtemps ensemble...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212707
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212707,
					"content": "Hein ? Où est passé Hora ? Non, ne me dites pas qu'il s'est enfui à nouveau ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212708
					],
					"speakerTitle": "Cazcal"
				},
				{
