	"talks": [
		{
			"id": 4134001,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4134001",
							"2"
						],
						"stepId": 4134001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gui l'herboriste"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413400101,
					"content": "Désolé de devoir vous déranger pendant les fêtes... Vous savez, chaque année pendant le festival, le Cottage Bubu doit faire face à un afflux de patients, et nous sommes débordés de travail !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400102
					],
					"speakerTitle": "Gui l'herboriste"
				},
				{
					"id": 413400102,
					"content": "Pourquoi donc...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400103
					]
				},
				{
					"id": 413400103,
					"content": "Pendant le festival, tout le monde prend des congés pour rendre visite à sa famille. Et bien sûr, ça entraîne tout un tas de festins, accompagnés des vins et des viandes les plus excentriques...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400104
					],
					"speakerTitle": "Gui l'herboriste"
				},
				{
					"id": 413400104,
					"content": "Autant dire que les indigestions sont inévitables, ou même toutes sortes d'allergie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400105
					],
					"speakerTitle": "Gui l'herboriste"
				},
				{
					"id": 413400105,
					"content": "J'ai beau répéter de « consommer avec modération », mes conseils entrent par une oreille et sortent de l'autre pendant les fêtes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400106
					],
					"speakerTitle": "Gui l'herboriste"
				},
				{
					"id": 413400106,
					"content": "On vient encore de me contacter pour des médicaments contre les indigestions et les maux d'estomac. Mais je ne peux pas délaisser le Cottage Bubu non plus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400107
					],
					"speakerTitle": "Gui l'herboriste"
				},
				{
					"id": 413400107,
					"content": "#{M#Voyageur}{F#Voyageuse}, vous pourriez peut-être m'aider à livrer les médicaments ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gui l'herboriste"
				}
			]
		},
		{
			"id": 4134002,
