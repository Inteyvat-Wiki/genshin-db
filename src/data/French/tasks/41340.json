			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhihua"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413400201,
					"content": "J'ai peut-être mangé quelque chose de bizarre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400202
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 413400202,
					"content": "J'ai des médicaments de la part de Gui l'herboriste...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400203
					]
				},
				{
					"id": 413400203,
					"content": "Oh, merci ! C'est le truc pour les maux de ventre que je lui ai demandé ? J'ai des problèmes d'indigestion... Ah, ça fait vraiment mal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400204
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 413400204,
					"content": "Je me promenais dans le marché, en grignotant à droite à gauche... Je ne me suis pas rendu compte que j'avais englouti autant de choses...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400205
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 413400205,
					"content": "Qu'avez-vous mangé ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400206
					]
				},
				{
					"id": 413400206,
					"content": "Voyons... Du riz sauté, du poisson cru, des fruits, plein de crevettes... Ah oui, et il y avait du vin sacrément bon aussi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400207,
						413400208
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 413400207,
					"content": "Pas étonnant que vous ayez mal au ventre...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400209
					]
				},
				{
					"id": 413400209,
					"content": "Mais c'est justement pour ça que j'ai besoin de ce médicament ! Pensez-y, si on ne pouvait pas manger ce qu'on voulait pendant les fêtes, la vie serait bien morose, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400210
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 413400210,
					"content": "Quoi qu'il en soit, merci bien. J'en profiterai pour faire une petite pause.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 413400208,
					"content": "Vous devriez faire un peu plus attention, festival ou pas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400209
					]
				}
			]
		},
		{
			"id": 4134003,
			"completionStepIds": [
				4134004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
