			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gui l'herboriste"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413400401,
					"content": "Vous revoilà. Avez-vous livré les médicaments ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400402,
						413400403
					],
					"speakerTitle": "Gui l'herboriste"
				},
				{
					"id": 413400402,
					"content": "Oui, mais je pense que vous n'êtes pas au bout de vos peines...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400404
					]
				},
				{
					"id": 413400404,
					"content": "Ah, que peut-on y faire. Sans faire attention à son style de vie, ce genre de maux de ventre est récurrent. On ne peut que guérir, et pas prévenir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400405
					],
					"speakerTitle": "Gui l'herboriste"
				},
				{
					"id": 413400405,
					"content": "Enfin bon, je peux au moins enfin faire une petite pause...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400406
					],
					"speakerTitle": "Gui l'herboriste"
				},
				{
					"id": 413400406,
					"content": "Les lanternes célestes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400407
					]
				},
				{
					"id": 413400407,
					"content": "Les lanternes célestes ? ... En général, on n'en lâche pas ici. Ça sert à faire des vœux, vous savez. Qu'est-ce que le Cottage Bubu pourrait bien souhaiter ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400408
					],
					"speakerTitle": "Gui l'herboriste"
				},
				{
					"id": 413400408,
					"content": "Les autres établissements espèrent avoir de plus en plus de clients, mais ici, nos clients sont malades. On ne peut quand même pas leur souhaiter de se sentir mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400409,
						413400410
					],
					"speakerTitle": "Gui l'herboriste"
				},
				{
					"id": 413400409,
					"content": "Vous êtes vraiment gentil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400411
					]
				},
				{
					"id": 413400411,
					"content": "Mais bon, personnellement, j'aimerais quand même en lâcher une. Après tout, c'est le festival...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400412
					],
					"speakerTitle": "Gui l'herboriste"
				},
				{
					"id": 413400412,
					"content": "Ça fait plusieurs jours que j'en fabrique une, mais je suis trop pris, j'ai à peine avancé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400413
					],
					"speakerTitle": "Gui l'herboriste"
				},
				{
					"id": 413400413,
					"content": "Même quand je peux me permettre de faire une pause comme maintenant, je ne peux que bricoler quelques instants. À ce rythme-là, quand j'aurais fini, le festival sera déjà terminé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400414
					],
					"speakerTitle": "Gui l'herboriste"
				},
				{
					"id": 413400414,
					"content": "Je vais vous aider.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400415
					]
				},
				{
					"id": 413400415,
					"content": "Vraiment ? Je vous en serais très reconnaissant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gui l'herboriste"
				},
				{
					"id": 413400410,
					"content": "Vous êtes vraiment honnête.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400411
					]
				},
				{
					"id": 413400403,
					"content": "Je crois que ça ne servira pas bien longtemps...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400404
					]
				}
			]
		},
