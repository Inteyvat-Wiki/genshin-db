				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Guanhai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413400301,
					"content": "Oh, oh... J'en peux plus... Que... Qu'est-ce que vous voulez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400302
					],
					"speakerTitle": "Guanhai"
				},
				{
					"id": 413400302,
					"content": "J'ai un médicament de la part de Gui l'herboriste...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400303
					]
				},
				{
					"id": 413400303,
					"content": "Oh, merci ! Le médicament que j'avais commandé... Vous êtes rapide, je dois dire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400304
					],
					"speakerTitle": "Guanhai"
				},
				{
					"id": 413400304,
					"content": "Ouf, ça ira beaucoup mieux avec ça ! J'imagine que ça doit être un coup de froid dû aux vents de la côte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400305
					],
					"speakerTitle": "Guanhai"
				},
				{
					"id": 413400305,
					"content": "Ce ne serait pas plutôt une indigestion...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400306
					]
				},
				{
					"id": 413400306,
					"content": "Impossible ! J'ai un estomac en acier ! Je vous jure, avant je pouvais manger trois poissons entiers pour mon souper.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400307
					],
					"speakerTitle": "Guanhai"
				},
				{
					"id": 413400307,
					"content": "Et même maintenant, personne ne m'arrive à la cheville quand il s'agit de faire bonne chère !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400308
					],
					"speakerTitle": "Guanhai"
				},
				{
					"id": 413400308,
					"content": "Bon, n'en parlons plus. Je dois me dépêcher de prendre ce médicament... Un concours d'alcool m'attend dans pas longtemps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400309,
						413400310
					],
					"speakerTitle": "Guanhai"
				},
				{
					"id": 413400309,
					"content": "Prenez quand même soin de vous.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400311
					]
				},
				{
					"id": 413400311,
					"content": "Haha, pas de souci. Je ne suis pas encore croûlant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400312
					],
					"speakerTitle": "Guanhai"
				},
				{
					"id": 413400312,
					"content": "Mais merci quand même ! Je ferai plus attention.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guanhai"
				},
				{
					"id": 413400310,
					"content": "Mieux vaut prévenir que guérir, vous savez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400311
					]
				}
			]
		},
		{
