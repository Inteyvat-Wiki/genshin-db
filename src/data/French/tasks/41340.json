						"stepId": 4134004,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4134001",
							"3"
						],
						"stepId": 4134001,
						"stateName": "QUEST_STATE_FINISHED"
