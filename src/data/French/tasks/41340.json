			"dialogs": [
				{
					"id": 413400701,
					"content": "Ah, vous voilà ! J'ai écrit mon souhait sur la lanterne céleste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400702
					],
					"speakerTitle": "Gui l'herboriste"
				},
				{
					"id": 413400702,
					"content": "Juste dans les temps pour la relâcher ensemble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400801
					],
					"speakerTitle": "Gui l'herboriste"
				},
				{
					"id": 413400801,
					"content": "Mon souhait est bien sûr une bonne santé pour tous les Liyuéens !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400802
					],
					"speakerTitle": "Gui l'herboriste"
				},
				{
					"id": 413400802,
					"content": "Et les affaires du Cottage Bubu ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400803
					]
				},
				{
					"id": 413400803,
					"content": "Haha, c'est pour ça que j'ai dit que c'était mon souhait, et pas celui du Cottage...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400804
					],
					"speakerTitle": "Gui l'herboriste"
				},
				{
					"id": 413400804,
					"content": "Si je prescris des remèdes aux gens, c'est parce que je ne supporte pas de les voir souffrir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400805
					],
					"speakerTitle": "Gui l'herboriste"
				},
				{
					"id": 413400805,
					"content": "Comme le dit le vieil adage : « Le médicament qu'on préfère est celui qui prend la poussière... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400806
					],
					"speakerTitle": "Gui l'herboriste"
				},
				{
					"id": 413400806,
					"content": "Haha, et puis... Si tout le monde a la santé, j'aurais plus de temps libre. C'est bien aussi, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400807
					],
					"speakerTitle": "Gui l'herboriste"
				},
				{
					"id": 413400807,
					"content": "Oh, j'allais oublier. J'ai encore un médicament à livrer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400808
					],
					"speakerTitle": "Gui l'herboriste"
				},
				{
					"id": 413400808,
					"content": "Désolé, je dois y aller ! Bon Festival des lanternes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gui l'herboriste"
				}
			]
