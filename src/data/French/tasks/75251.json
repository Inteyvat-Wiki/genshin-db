				},
				{
					"id": 752510102,
					"content": "Waouh ! Mais qui êtes-vous ?! Pourquoi vous venez de tomber d'un arbre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752510103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752510103,
					"content": "Je suis Papar ! Hayne, on n'était pas d'accord pour boire une autre tournée ? Quelle soirée ! Je suis si heureux qu'on se soit rencontrés...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
