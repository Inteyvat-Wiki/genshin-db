					"nextDialogs": [
						752510108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752510108,
					"content": "Hein ? Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752510109
					],
					"speakerTitle": "Papar"
				},
				{
					"id": 752510109,
					"content": "Hayne ! Où es-tu ? Continuons à b—boire !",
