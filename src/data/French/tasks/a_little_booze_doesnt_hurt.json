			"dialogs": [
				{
					"id": 200490201,
					"content": "Pommes ou pommes crépusculaires ? Le choix est difficile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490202
					],
					"speakerTitle": "Eury"
				},
				{
					"id": 200490202,
					"content": "*soupir* Si Nimrod était là, je n'aurais eu qu'à prendre ce qu'il veut...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490203
					],
					"speakerTitle": "Eury"
				},
				{
					"id": 200490203,
					"content": "#Je suis {M#désolé}{F#désolée}, Eury ! Nous n'avons plus de pommes crépusculaires.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490204
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200490204,
					"content": "Oh, bon tant pis. Je vais vous prendre des pommes alors.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490205
					],
					"speakerTitle": "Eury"
				},
				{
					"id": 200490205,
					"content": "Ah, pardon. Ça ne va pas être possible non plus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490206
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200490206,
					"content": "Pourquoi ? Il n'y a pas d'autre choix.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490207
					],
					"speakerTitle": "Eury"
				},
				{
					"id": 200490207,
					"content": "Permettez-moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200490208,
					"content": "De ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490209
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200490209,
					"content": "De vous aider, bien sûr.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200490210
					]
				},
				{
					"id": 200490210,
					"content": "Ne vous inquiétez pas, on va aller chercher quelques <color=#00E1FFFF>pommes crépusculaires</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200490211,
					"content": "Vous feriez ça pour moi ? Merci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490212
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200490212,
					"content": "C'est parfait, Nimrod préfère les pommes crépusculaires. Je vous attends ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eury"
				}
