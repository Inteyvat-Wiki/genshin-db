			},
			"dialogs": [
				{
					"id": 200490101,
					"content": "J'ai vraiment besoin d'un verre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490102
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490102,
					"content": "Mais si Eury le découvre, c'est la fin des haricots...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490103
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490103,
					"content": "Ça va ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200490104
					]
				},
				{
					"id": 200490104,
					"content": "Hein ? Oh, oui. J'ai juste besoin d'un petit verre, rien de grave !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490105
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490105,
					"content": "Ma femme ne supporte pas de me voir boire, alors je ne le fais pas devant elle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490106
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490106,
					"content": "J'attends qu'elle parte faire les courses avant de m'enfiler quelques verres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490107
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490107,
					"content": "Quand on a un problème, c'est bien de l'admettre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200490108
					]
				},
				{
					"id": 200490108,
					"content": "Allez quoi, je ne suis pas le seul à Mondstadt qui aime la boisson.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490109
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490109,
					"content": "J'aimerais que tu distraies Eury pendant un petit moment, histoire que je prenne un verre ou deux, quoi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490110
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490110,
					"content": "Quand Eury fait les courses, il suffit qu'il y ait un peu trop de choix pour qu'elle y reste toute la journée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490111
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490111,
					"content": "Elle n'arrêtera pas d'hésiter si on lui présente deux options.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490112,
						200490114
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490112,
					"content": "D'accord, j'ai compris.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200490113
					]
				},
				{
					"id": 200490113,
					"content": "#Je compte sur toi ! Que le vin de la fortune coule toujours dans ton verre, mon {M#ami}{F#amie} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490114,
					"content": "Vous avez l'intention de rester jusqu'à quand ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200490115
					]
				},
				{
					"id": 200490115,
					"content": "Haha, tout dépend de combien de temps tu arriveras à retenir Eury.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490116
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490116,
					"content": "N—Non, je plaisante ! Je veux juste boire un verre et avoir le temps de le savourer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490117
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490117,
					"content": "Je promets que je ne prendrai qu'un seul verre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nimrod"
				}
			]
		},
