			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Liloupar",
					"Tirailleur Fatui A",
					"Tirailleur Fatui B",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732790401,
					"content": "Chut... Regardez... Il y a des gens là-bas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790402,
					"content": "#Hmm... {M#Mon maître}{F#Ma maîtresse}, ces gens... C'est ceux-là même dont vous n'arrêtez pas de parler ? Les Foutui, c'est ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790403
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790403,
					"content": "Ce sont les Fatui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790404
					]
				},
				{
					"id": 732790404,
					"content": "Il y a une différence ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790405
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790405,
					"content": "Parle moins fort ! On va se faire repérer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790406,
					"content": "Ne t'inquiète pas, ils ne peuvent pas m'entendre. Si tu ne me crois pas, regarde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790407
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790407,
					"content": "Hé ! Gros lard, je suis là ! À table, c'est l'heure de manger !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790408
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790408,
					"content": "Hmm ? Tu as entendu quelque chose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790409
					],
					"speakerTitle": "Tirailleur Fatui A"
				},
				{
					"id": 732790409,
					"content": "Non, qu'est-ce qu'il y a ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790410
					],
					"speakerTitle": "Tirailleur Fatui B"
				},
				{
					"id": 732790410,
					"content": "Oh... J'ai cru que c'était l'heure de passer à table.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790411
					],
					"speakerTitle": "Tirailleur Fatui A"
				},
				{
					"id": 732790411,
					"content": "Héhé, vous avez vu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790412
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790412,
					"content": "Je ne connaissais pas cette facette enfantine de toi, Liloupar ! Héhé, c'est un peu mignon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790413,
					"content": "Regardez, là-bas ! Ce ne serait pas Tadhla qu'ils ont enfermée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790414,
					"content": "Hmm, laissez-moi me souvenir : grande, bronzée, des cheveux de couleur claire... Ça doit être elle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790415,
					"content": "#Tu as bonne mémoire, petite. Passons à l'action, {M#mon maître}{F#ma maîtresse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790416
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790416,
					"content": "#Allez, {NICKNAME}, à nous de jouer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7327906,
