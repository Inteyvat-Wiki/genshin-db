			"dialogs": [
				{
					"id": 732790201,
					"content": "Alors ? Vous l'avez trouvée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790202
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790202,
					"content": "Ah, il vous faut plus de temps, c'est ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790203
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790203,
					"content": "Trouvez-la vite, s'il vous plaît... Le temps n'attend pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Masseira"
				}
			]
		},
		{
			"id": 7327904,
			"completionStepIds": [
				7327904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
