				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Masseira",
					"Tadhla",
					"Liloupar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732790701,
					"content": "Ah, mon petit faucon est de retour ! Merci beaucoup !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790702
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790702,
					"content": "Désolée... Je suis tombée dans une embuscade. C'est grâce à leur aide que j'ai pu revenir vous voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790703
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790703,
					"content": "#« Leur aide » ? Je te signale que tu parles de notre très {M#estimé maître}{F#estimée maîtresse} des djinns !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790704
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790704,
					"content": "Désolée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790705
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790705,
					"content": "Il n'y a pas de problème ! Tadhla est blessée, vous devriez être gentil avec elle !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790706,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790707
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790707,
					"content": "... Tu es blessée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790708
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790708,
					"content": "... Désolée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790709
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790709,
					"content": "Par des animaux ? Ou des humains ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790710
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790710,
					"content": "C'étaient des gens du nord. Ils m'ont attaquée par surprise... Quand ils ont vu que je les suivais, ils se sont mis en embuscade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790711
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790711,
					"content": "C'est toi qui aurais dû leur tendre une embuscade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790712
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790712,
					"content": "Non mais regarde-moi ça ! Un faucon qui se fait mordre par sa proie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790713
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790713,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790714
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790714,
					"content": "Va te reposer, tu en as grand besoin. Je viendrai soigner tes plaies dans un moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790715
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790715,
					"content": "Tadhla acquiesce en silence, et s'en va lentement en contenant sa douleur.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732790716
					]
				},
				{
					"id": 732790716,
					"content": "Masseira, vous êtes un peu sévère avec Tadhla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790717,
						732790720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790717,
					"content": "Vous ne vous entendez pas bien ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790718
					]
				},
				{
					"id": 732790718,
					"content": "Hein ? Non, pas du tout, que dites-vous ! Tadhla est mon faucon préféré... Je l'adore, mais je ne la gâte pas. Comment voulez-vous nourrir un faucon qui rentre sans ramener de proie ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790719
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790719,
					"content": "Ah, c'est donc ça... Cette fille finira par connaître un triste sort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790723
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790723,
					"content": "#Tenez, acceptez ceci. Je vous remercie, très {M#estimé maître}{F#estimée maîtresse} des djinns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790724
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790724,
					"content": "Ahem, vous n'auriez pas oublié quelque chose ? Il y a deux autres personnes présentes ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790725
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790725,
					"content": "Héhé, dont une qu'on ne pourrait considérer comme une personne...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790726
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790726,
					"content": "Oh... J'avais oublié, cette petite fée n'est pas une personne. Malgré tout, on devrait nous aussi recevoir des remerciements, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790727
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790727,
					"content": "Hé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790728,
					"content": "Haha, toutes mes excuses. Tenez, veuillez accepter ceci comme récompense supplémentaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790729
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790729,
					"content": "Chouette, une récompense en plus !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790730
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790730,
					"content": "#Ce n'est toujours pas grand-chose, mais puisque {M#mon maître}{F#ma maîtresse} n'a pas d'objection, on va faire avec.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790731
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790731,
					"content": "Parfait. Euh... Si vous avez le temps, j'espère que vous reviendrez... Je pense que mon faucon aura encore besoin de votre aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790720,
					"content": "Ne soyez pas trop dur avec Tadhla.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790721
					]
				},
				{
					"id": 732790721,
					"content": "Dur ? Au contraire, je suis trop laxiste avec elle, et sa technique a régressé... Je ne fais que l'éduquer. Elle est un faucon exceptionnel, comment pourrais-je la blesser ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790722
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790722,
					"content": "Dans ce cas, quel sort finissent par connaître les faucons ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790723
					],
					"speakerTitle": "Liloupar"
				}
			]
		}
	]
}