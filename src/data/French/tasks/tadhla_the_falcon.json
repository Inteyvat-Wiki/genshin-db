			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Masseira",
					"Liloupar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732790101,
					"content": "#Ah, {NICKNAME} ! Quelle surprise pour moi de recevoir l'honorable visite {M#du}{F#de la} très {M#estimé maître}{F#estimée maîtresse} des djinns !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790102
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790102,
					"content": "#Génial, encore un laquais du désert. {M#Mon maître}{F#Ma maîtresse}... *soupir* Peu importe, je fais confiance à votre jugement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790103
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790103,
					"content": "Vous avez une minute à me consacrer ? J'attendais votre venue avec autant d'impatience que j'attends la lune et la pluie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790104
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790104,
					"content": "Épargnez-nous vos belles paroles, ça sonne faux. Dites-nous directement ce que vous voulez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790105
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790105,
					"content": "Très bien, madame djinn... C'est vrai, j'ai quelque chose à vous demander.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790106
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790106,
					"content": "Haha, ce n'est rien de très grave... C'est Tadhla, mon faucon... Je crois qu'elle est en danger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790107
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790107,
					"content": "#*soupir* Si mes jambes n'étaient pas si fragiles, je ne vous aurais pas {M#dérangé}{F#dérangée}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790108
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790108,
					"content": "J'ai compris. Vous voulez qu'on aille la sauver, ensuite, vous allez nous remercier, nous donner plein de moras, et puis on mangera un grand repas pour fêter tout ça ! Pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790109,
					"content": "Euh... Oui, c'est ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790110
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790110,
					"content": "Si c'est bien ça, alors on s'en charge !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790111,
					"content": "Paimon est toujours très perspicace dans ces moments-là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790112
					]
				},
				{
					"id": 732790112,
					"content": "*soupir* Bon, d'accord. Faisons-le pour cette petite gourmande de Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790113
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790113,
					"content": "Merci infiniment... Je vous laisse vous en occuper.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790114
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790114,
					"content": "Ah, euh... Laissez-moi vous indiquer l'endroit où elle est apparue la dernière fois sur votre carte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790115
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790115,
					"content": "La personne que vous devez trouver, Tadhla, est grande, bronzée, avec des cheveux longs de couleur claire, et elle manie un arc long. Voilà, vous devriez avoir suffisamment d'informations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790116
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790116,
					"content": "Bon, vous avez bien retenu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790117
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790117,
					"content": "Euh... Une grande fille bronzée aux cheveux longs de couleur claire qui manie un arc long ! Héhé, j'ai bonne mémoire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790118,
					"content": "Oui... Que le vent vous guide à travers les tempêtes de sable et vous mène loin du danger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790119
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790119,
					"content": "Bon, alors c'est parti !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7327902,
			"completionStepIds": [],
