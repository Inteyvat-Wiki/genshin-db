						"rawParams": [
							"7327906",
							"2"
						],
						"stepId": 7327906,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tadhla",
					"Liloupar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732790601,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790602
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790602,
					"content": "#Euh... C'est toi, Tadhla ? On est {M#venus}{F#venues} te sauver !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790603,
					"content": "Oui ? Ah, oui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790604
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790604,
					"content": "Vous les avez laissé partir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790605,
						732790606
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790605,
					"content": "Ils ne représentent plus une menace.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790607
					]
				},
				{
					"id": 732790607,
					"content": "... Ils vont rentrer et avertir les autres. Bientôt, ils sauront tous qu'on est ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790608
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790608,
					"content": "Tiens donc ! Les grands esprits se rencontrent. J'aime bien cette fille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790609
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790609,
					"content": "Ça ne fait rien. S'ils reviennent nous chercher, on leur bottera les fesses une nouvelle fois ! Par contre, tu es blessée... Tu as besoin d'aide ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790610,
					"content": "Ça va. Je peux toujours marcher. Je pourrai trouver un endroit pour mourir seule.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790611
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790611,
					"content": "Ouf, ça va, elle pourra trouver un endroit pour... Hé, non ! Ça ne va pas du tout !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790612,
					"content": "Je plaisante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790613
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790613,
					"content": "Haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790614
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790614,
					"content": "Elle dit ça l'air de rien... J'aime son sens de l'humour !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790615
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790615,
					"content": "Merci. Rentrons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790616,
						732790618
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790616,
					"content": "Tu peux marcher sans problème ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790617
					]
				},
				{
					"id": 732790617,
					"content": "Pas vraiment, mais je n'ai pas besoin qu'on me soutienne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790618,
					"content": "Tu ne veux pas te reposer un peu ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790619
					]
				},
				{
					"id": 732790619,
					"content": "Me reposer ? Non, on se connaît à peine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790620
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790620,
					"content": "Je pense quand même qu'on peut faire connaissance, qu'en dis-tu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790621
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790621,
					"content": "Merci, mais plus tard alors.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790606,
					"content": "Il n'est pas nécessaire de les éliminer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790607
					]
				}
			]
		},
		{
			"id": 7327907,
			"completionStepIds": [
				7327907
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7327907",
