				"points": []
			},
			"dialogs": [
				{
					"id": 745240401,
					"content": "#Tiens donc, {M#mon petit}{F#ma petite} ? Aurais-tu eu vent de mon programme d'aujourd'hui pour venir me voir exprès ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240402,
						745240403
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240402,
					"content": "Vous venez d'aller voir la Shogun ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745240404
					]
				},
				{
					"id": 745240404,
					"content": "Héhé, quel flair ! Je n'ai fait qu'apporter quelques douceurs et les romans légers les plus en vogue à une amie qui n'aime guère sortir de chez elle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240405
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240405,
					"content": "Ei s'est aussi mise à suivre les dernières sorties ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745240406
					]
				},
				{
					"id": 745240406,
					"content": "Elle prétend vouloir comprendre l'évolution des loisirs et des goûts des habitants d'Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240407
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240407,
					"content": "On vient d'en parler. Au début, elle analysait sérieusement les préférences des lecteurs à travers le contenu des histoires...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240408
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240408,
					"content": "#... Mais au fil de la discussion, elle m'a soudainement demandé avec intérêt{NON_BREAK_SPACE}: «{NON_BREAK_SPACE}Qu'est-ce qui arrive à ce personnage à la fin{NON_BREAK_SPACE}?{NON_BREAK_SPACE}»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240409
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240409,
					"content": "On dirait que même Ei n'a pas pu s'empêcher d'être captivée par une belle histoire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240410,
						745240411
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240410,
					"content": "L'expression que vous avez eue à l'instant...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745240412
					]
				},
				{
					"id": 745240412,
					"content": "#Oh ? Voilà donc ce que tu es {M#venu}{F#venue} faire aujourd'hui ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240413
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240413,
					"content": "#Je vois. Notre {M#petit voyageur}{F#voyageuse} pense souvent à moi pendant son périple et souhaite prendre quelques clichés en souvenir, hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240414
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240414,
					"content": "Je te laisse faire alors. Choisis bien l'angle, d'accord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240411,
					"content": "Elle mérite vraiment d'être immortalisée.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745240412
					]
				},
				{
					"id": 745240403,
					"content": "Je sens une odeur sucrée...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745240404
					]
				}
			]
		}
	]
