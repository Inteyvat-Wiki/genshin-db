			},
			"dialogs": [
				{
					"id": 751260601,
					"content": "Dire que ces choses se sont produites... Milchi, et la personne qui a laissé ces notes... Tout le monde a été si courageux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751260602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751260602,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751260603
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751260603,
					"content": "C'est... cet œuf de saurien endormi mentionné dans ces notes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751260604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751260604,
					"content": "#Tu penses que nous devrions utiliser l'éclosoir, {REALNAME[ID(2)|SHOWHOST(true)]} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751260605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751260605,
					"content": "Yaa ! Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751260606
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751260606,
					"content": "Hmm, il a l'air en bon état, et il y a un manuel d'utilisation. Essayons, d'accord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751260607,
						751260608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751260607,
					"content": "Je ne sais pas si ça va fonctionner, mais nous pouvons essayer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751260609
					]
				},
				{
					"id": 751260609,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751260608,
					"content": "Bien, notre petit bonhomme va avoir de nouveaux amis !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751260609
					]
				}
			]
		}
	]
