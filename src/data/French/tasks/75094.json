				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"#{REALNAME[ID(2)|SHOWHOST(true)]}",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750940601,
					"content": "Ouf... J'ai eu peur ! Les monstres ont attaqué de nulle part. Heureusement, je suis super forte !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940602,
						750940604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940602,
					"content": "Alors je compterai sur toi la prochaine fois.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940603
					]
				},
				{
					"id": 750940603,
					"content": "Hein ? Non non non, tu ne peux pas compter sur moi ! Je ne combattrai plus de monstres aussi horribles !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940606,
					"content": "Yaa ! Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940607
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940607,
					"content": "#{NICKNAME}, on dirait qu'il commence à s'inquiéter. Trouvons un moyen de faire éclore l'œuf !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940608,
					"content": "Activer l'éclosoir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940609
					]
				},
				{
					"id": 750940609,
					"content": "L'éclosoir est à nouveau opérationnel...\\nEnsuite, nous n'avons pas d'autres choix que d'attendre...\\nLes heures passent, mais l'œuf de saurien ne bouge pas. Pas le moins du monde...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750940610
					]
				},
				{
					"id": 750940610,
					"content": "Hmm... Hmm ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940611
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940611,
					"content": "Bizarre. On dirait qu'il ne s'est rien passé. Nous avons peut-être fait une erreur ? Réessayons !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940612,
						750940632
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940612,
					"content": "Réessayer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940613
					]
				},
				{
					"id": 750940613,
					"content": "Vous redémarrez l'éclosoir conformément aux instructions...\\nMais comme lors de la tentative précédente, il ne se passe rien du tout...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750940614
					]
				},
				{
					"id": 750940614,
					"content": "Oh... Combien de temps devons-nous attendre, mes yeux fatiguent... J'ai la tête qui tourne et l'estomac qui gargouille...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940615,
					"content": "Raouh... Ku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940616
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940616,
					"content": "Quoi ?! Attends, l'œuf a bougé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940617,
						750940627
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940617,
					"content": "Que dirais-tu d'attendre encore quelques minutes...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940618
					]
				},
				{
					"id": 750940618,
					"content": "Après un long moment...\\nL'œuf de saurien n'a plus bougé et ne montre aucun signe d'éclosion.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750940619
					]
				},
				{
					"id": 750940619,
					"content": "Toujours aucune réaction... L'éclosoir serait cassé ? Mais ses lumières sont allumées ! Le problème vient peut-être de l'œuf ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940620,
					"content": "... Hmm, je pense qu'attendre ne sert à rien... Et si nous prenions simplement l'œuf avec nous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940621,
						750940624
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940621,
					"content": "Peu importe à quel point tu as faim, n'espère même pas manger l'œuf de saurien...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940622
					]
				},
				{
					"id": 750940622,
					"content": "Waah ! Waah !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940623
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940623,
					"content": "#Je ne mangerais jamais cet œuf ! Ne laisse pas {REALNAME[ID(2)|SHOWHOST(true)]} imaginer de pareilles choses !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940626,
					"content": "Petit, ce que j'essaye de dire... C'est que si le problème vient vraiment de l'œuf, alors peut-être qu'il ne pourra jamais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940634
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940634,
					"content": "Raouh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940635
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940635,
					"content": "#Ne sois pas triste, {REALNAME[ID(2)|SHOWHOST(true)]}. On ne peut rien y faire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940636,
						750940637
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940636,
					"content": "Ce sont peut-être simplement les conditions qui ne sont pas idéales...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940638
					]
				},
				{
					"id": 750940638,
					"content": "Tu as raison ! Peut-être que l'œuf n'éclot pas parce qu'il pense que Natlan n'a pas changé et que ce n'est pas le bon foyer pour lui !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940639
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940639,
					"content": "Après tout, il se cache ici depuis si longtemps, il ne peut donc pas savoir à quel point Natlan est devenu un endroit merveilleux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940640
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940640,
					"content": "Ramenons-le et prenons-en bien soin ! Chaque jour, nous lui raconterons des histoires sur ces magnifiques paysages, ces aventures palpitantes et toutes les personnes merveilleuses que nous avons rencontrées !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940641
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940641,
					"content": "Enfin, nous lui ferons savoir à quel point la nation de Natlan est géniale aujourd'hui ! Une fois intrigué, il éclora sûrement tout seul !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940642
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940642,
					"content": "... Grr hmm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940637,
					"content": "Ou alors... L'œuf estime que ce n'est pas encore le bon moment...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940638
					]
				},
				{
					"id": 750940624,
					"content": "#Qu'en penses-tu, {REALNAME[ID(2)|SHOWHOST(true)]} ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940625
					]
				},
				{
					"id": 750940625,
					"content": "Hmm... Hmm ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940626
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940627,
					"content": "Ce n'est pas ça du tout.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940628
					]
				},
				{
					"id": 750940628,
					"content": "#Hein ?! Mais... Tout à l'heure... J'imaginais des choses ? Non, ce n'est pas possible. Tu l'as vu, {REALNAME[ID(2)|SHOWHOST(true)]} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940629,
					"content": "Hmm... Hmm ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940630
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940630,
					"content": "#Ah... Il ne l'a pas vu non plus ? Était-ce vraiment juste mon imagination ? Alors, qu'est-ce qu'on fait, {NICKNAME} ? Allons-nous simplement continuer d'attendre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940631,
					"content": "Ou... Le problème pourrait-il vraiment venir de l'œuf ? M—Mais si c'est le cas, est-ce que ça veut dire qu'il n'éclora jamais ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940634
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940632,
					"content": "Le problème vient probablement de l'œuf.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940633
					]
				},
				{
					"id": 750940633,
					"content": "Hein ? Alors, est-ce que... ça veut dire que cet œuf pourrait ne jamais éclore ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940634
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940604,
					"content": "Oh, je vois.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940605
					]
				},
				{
					"id": 750940605,
					"content": "Exactement ! Avec cette apparence effrayante, je pensais qu'il s'agissait d'un ennemi extrêmement puissant ! Quelle déception. Les attaques de notre jeune compagnon sont plus puissantes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940606
					],
					"speakerTitle": "Paimon"
				}
			]
		},
