			"dialogs": [
				{
					"id": 200140201,
					"content": "#Vous avez battu tous les monstres. Vous êtes vraiment {M#fort}{F#forte} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140202
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140202,
					"content": "Ce qui est écrit dans le carnet de l'aventurier est donc vrai : il y a plusieurs moyens de battre des monstres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140203
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140203,
					"content": "Mais pour être honnête, ça me fait un peu peur d'être aussi près d'eux... Heureusement que vous êtes ici avec moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140204
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140204,
					"content": "Il faut que tu t'entraînes davantage.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140205
					]
				},
				{
					"id": 200140205,
					"content": "Oui, je sais. Devenir une aventurière n'est pas facile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140206
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140206,
					"content": "#Merci, {M#voyageur}{F#voyageuse}. Je vais retourner à la cité. Si je reste trop longtemps à l'extérieur, mon frère va encore se faire du souci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140207
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140207,
					"content": "Je dois continuer de m'entraîner encore plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				}
			]
		},
