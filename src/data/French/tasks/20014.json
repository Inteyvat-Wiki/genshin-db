			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anthony",
					"Anna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200140101,
					"content": "Anna, réfléchis-y encore. Je pense qu'il faut voir les choses sur le long terme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140102
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140102,
					"content": "C'est bon, arrête de t'inquiéter pour moi ! Ça va aller, je t'assure !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140103,
						200140104
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140103,
					"content": "Anna, comment va ta santé ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140105
					]
				},
				{
					"id": 200140105,
					"content": "#{M#Voyageur}{F#Voyageuse} ! Vous arrivez pile au bon moment. Aidez-moi à faire entendre raison à Anna, elle voudrait devenir aventurière !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140106
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140106,
					"content": "Pourquoi ne pourrais-je pas être une aventurière ? Je suis en très bonne santé maintenant. En plus, Cyrus a dit que j'avais l'esprit vif et que c'était une qualité idéale pour une aventurière !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140107
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140107,
					"content": "Ça fait combien de temps que tu te sens mieux ? Si tu deviens une aventurière et que tu tombes malade à nouveau, comment tu vas faire ? Et puis, les parents ne seront pas d'accord...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140108
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140108,
					"content": "J'en ai déjà parlé aux parents. Ils m'ont dit qu'ils accepteraient que je devienne aventurière si je réussissais l'examen de la Guilde des aventuriers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140109
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140109,
					"content": "Q—Quoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140110,
						200140111
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140110,
					"content": "Du calme...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140112
					]
				},
				{
					"id": 200140112,
					"content": "Cyrus m'a préparé un programme d'entraînement il y a quelques jours. Ça fait déjà un moment que je m'entraîne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140113
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140113,
					"content": "Le programme comprend de l'exploration, de la recherche de nourriture en cas d'urgence, de la survie dans la nature...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140114
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140114,
					"content": "Mais j'ai entendu dire que les aventuriers doivent aussi souvent se battre contre des monstres dans la nature.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140115
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140115,
					"content": "J'aimerais beaucoup apprendre cette compétence, mais je ne trouve personne pour me l'enseigner...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140116
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140116,
					"content": "Et puis, mon frère...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140117
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140117,
					"content": "C'est non ! Ces monstres sont très dangereux. Si tu dois vraiment y aller, il faut que tu trouves un aventurier expérimenté pour t'accompagner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140118
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140118,
					"content": "J'ai déjà demandé à Jack et il a dit oui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140119
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140119,
					"content": "Arrête un peu, tu crois que je ne connais pas Jack ? Il n'est même pas capable de s'occuper de lui-même quand il sort de la cité, comment pourrait-il s'occuper de toi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140120
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140120,
					"content": "Je ne pense pas pouvoir trouver un aventurier expérimenté en si peu de temps, et je n'ai pas assez d'argent pour poster une mission...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140121,
						200140122
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140121,
					"content": "Sinon, je n'ai qu'à t'accompagner.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140123
					]
				},
				{
					"id": 200140123,
					"content": "Quoi ? Vous voulez bien m'aider ? Génial !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140124
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140124,
					"content": "Tu as entendu, Anthony ? Tu peux avoir le cœur tranquille !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140125
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140125,
					"content": "Euh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140126
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140126,
					"content": "#*soupir* Bon, d'accord. Je sais combien {M#le voyageur}{F#la voyageuse} est {M#fort}{F#forte}. Je serai plus rassuré {M#s'il}{F#si elle} t'accompagne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140127
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140127,
					"content": "Cependant, je veux que tu sois prudente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140128
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140128,
					"content": "C'est tout. Tu as bien compris ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140129
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140129,
					"content": "Oui, oui, j'ai compris. Tu me l'as répété des milliards de fois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140130
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140130,
					"content": "#Allons-y, {M#voyageur}{F#voyageuse}. J'ai déjà demandé à Jack l'emplacement du camp où nous devons aller.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140122,
					"content": "Je connais deux ou trois choses en matière de combat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140123
					]
				},
				{
					"id": 200140111,
					"content": "Comment se passe ton entraînement ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140112
					]
				},
				{
					"id": 200140104,
					"content": "Anthony, qu'est-ce que vous êtes en train de faire ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140105
					]
				}
			]
		},
