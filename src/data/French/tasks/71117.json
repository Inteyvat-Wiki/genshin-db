			"dialogs": [
				{
					"id": 711170401,
					"content": "Je crois que cette stèle en pierre dit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711170402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711170402,
					"content": "Elle dit qu'on peut faire venir des amis qu'on n'a pas vus depuis longtemps en jetant de la viande crue dans la rivière ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711170403,
						711170406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711170403,
					"content": "Tu peux lire ce qu'il y a d'écrit ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711170404
					]
				},
				{
					"id": 711170404,
					"content": "Ne me sous-estime pas... C'est possible de deviner en se basant sur les morceaux lisibles !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711170405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711170405,
					"content": "Je peux bien lire les deux dernières lignes, alors je ne pense pas me tromper !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711170408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711170408,
					"content": "Bref, jetons cette viande crue dedans. Peut-être qu'un Adepte va se montrer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711170406,
					"content": "Hum, je pense qu'il s'agit plutôt de donner de la nourriture que de revoir des amis...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711170407
					]
				},
				{
					"id": 711170407,
					"content": "Vraiment ? Hmph, je ne pense pas que mon interprétation soit fausse !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711170408
					],
					"speakerTitle": "Paimon"
				}
