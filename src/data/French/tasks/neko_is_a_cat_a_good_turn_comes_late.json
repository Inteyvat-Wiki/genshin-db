				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722160101,
					"content": "Vous êtes enfin là. L'humain sculpteur de pierre a dit qu'il était sur le point de finir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160102,
					"content": "Venez avec moi, c'est juste là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
		{
			"id": 7221602,
			"completionStepIds": [
				7221602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221602",
							"2"
						],
						"stepId": 7221602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ooshima Junpei",
					"Neko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722160201,
					"content": "Pfiou, j'en ai presque terminé. C'est sans doute la plus grande œuvre qu'il m'ait été donné de réaliser...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160202
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160202,
					"content": "Ah, vous voilà. Vous aussi, madame la grande prêtresse suppléante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160203
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160203,
					"content": "La statue est-elle terminée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160204
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160204,
					"content": "Oui, comme vous pouvez le voir ! J'ai fait exprès de laisser un bout de pierre ici. J'attendais que madame la grande prêtresse suppléante revienne me voir avant de l'enlever.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160205
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160205,
					"content": "C'est gentil de votre part.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160206
					]
				},
				{
					"id": 722160206,
					"content": "Héhé, bien sûr. Les statues d'un sanctuaire doivent être traitées avec le plus grand respect.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160207
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160207,
					"content": "Miaou miaou, est-ce que c'est si important de frapper sur la pierre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160208
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160208,
					"content": "Hum, comment vous expliquer... Disons que d'habitude, les choses que l'on transforme en statues sont très importantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160209
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160209,
					"content": "Tu devrais te faire une statue de nourriture, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160210
					]
				},
				{
					"id": 722160210,
					"content": "Hé, c'est méchant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722160211,
					"content": "Ça veut dire que vous faites des statues de bonnes choses ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160212
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160212,
					"content": "Hahaha ! Ce sont mieux que des « bonnes choses » ! Les statues sont des « monuments éternels » !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160213
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160213,
					"content": "Ce n'est pas un monument éternel que je veux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160214
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160214,
					"content": "Je souhaite seulement que Hibiki puisse voir ce moi en pierre si elle revient et qu'elle se perd en chemin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160215
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160215,
					"content": "Ainsi, elle saura où elle se trouve et où aller ensuite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160216
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160216,
					"content": "Oh, je vois. Vous avez l'air de bien aimer cette « Hibiki », madame la grande prêtresse suppléante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160217
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160217,
					"content": "Neko...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160218
					]
				},
				{
					"id": 722160218,
					"content": "Hibiki peut revenir à tout moment. Domeki et elle ont dit que quelque chose de bien allait se produire une fois cette pierre achevée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160219
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160219,
					"content": "Dites-moi, humain sculpteur de pierre. Avez-vous besoin d'autre chose de ma part ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160220
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160220,
					"content": "Non, pas vraiment... Maintenant que vous êtes là, je peux tailler ce bout de pierre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160221
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160221,
					"content": "Trois... deux... un !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160222
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160222,
					"content": "Qu'est-ce que c'est que ce nuage ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160223,
						722160224
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160223,
					"content": "Il a pris la forme d'un chat...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160225
					]
				},
				{
					"id": 722160225,
					"content": "C'est Hibiki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160226
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160226,
					"content": "Hein ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160227
					]
				},
				{
					"id": 722160227,
					"content": "Hibiki ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160228
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160228,
					"content": "Miaou miaou miaou ! Je suis sûre que c'était elle ! Une bonne chose est arrivée, comme elle l'avait dit !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160229
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160229,
					"content": "Ses paroles se réalisent ! Il fallait terminer cette pierre pour qu'une bonne chose se produise !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160230
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160230,
					"content": "C'est génial ! Hibiki disait la vérité !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160231
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160231,
					"content": "Elle va vraiment revenir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160232
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160232,
					"content": "Euh, youpi ! Hahaha, je ne sais pas trop ce qui se passe, mais si madame la grande prêtresse suppléante est heureuse, c'est qu'un heureux événement s'est produit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160233
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160233,
					"content": "Neko...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160234
					]
				},
				{
					"id": 722160234,
					"content": "Grâce à votre aide, le sanctuaire resplendit à nouveau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160235
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160235,
					"content": "La boîte à offrandes est réparée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160236
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160236,
					"content": "Le portique d'Emma aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160237
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160237,
					"content": "La pierre à mon image a été sculptée aussi ! Toutes les conditions sont réunies pour le retour de Hibiki !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160238
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160238,
					"content": "Et Domeki, Janome et tous les amis d'Hibiki aussi ! Ils reviendront, j'en suis sûre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160239
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160239,
					"content": "Vous... Vous êtes une si bonne personne ! Mieux que ce repas ! Hibiki vous adorera, c'est sûr !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160240
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160240,
					"content": "Je dois rassembler tous mes petits et préparer son retour. Puis, bien évidemment, je donnerai des instructions quant à l'accueil de tous les fidèles qui reviendront visiter le sanctuaire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160241
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160241,
					"content": "Mais je dois aussi m'occuper de certaines affaires d'abord...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160242
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160242,
					"content": "Hibiki... Miaou miaou miaou ! C'est génial, vraiment génial !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160224,
					"content": "Qu'est-ce qui est train de se passer ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160225
					]
				}
			]
		},
		{
			"id": 7221603,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221602",
							"3"
						],
						"stepId": 7221602,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ooshima Junpei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722160301,
					"content": "Madame la grande prêtresse suppléante a l'air toute contente. Cette « Hibiki » doit lui être très chère.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160302
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160302,
					"content": "Le problème, c'est qu'on ne sait toujours pas où elle se trouve...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7221604,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221602",
							"3"
						],
						"stepId": 7221602,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Etsuko",
					"Taisuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722160401,
					"content": "« Hibiki », « Sanctuaire d'Asase » et « Domeki »... Ce sont des noms qui ont retenu notre attention.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160402,
						722160407
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160402,
					"content": "D'où est-ce que vous sortez tous les deux ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160403
					]
				},
				{
					"id": 722160403,
					"content": "Vous faisiez un boucan pas possible ici, alors nous sommes venus voir ce qui se passait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160404
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160404,
					"content": "Mais il y a quelque chose que vous devriez savoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160405
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160405,
					"content": "Taisuke, explique-leur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160406
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160406,
					"content": "Ah... Très bien, Etsuko. Ce que je vais vous raconter concerne... l'Île de Seirai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160408
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160408,
					"content": "L'histoire de cet endroit est très obscure. La Guilde des aventuriers a tenté de se renseigner sur cette île, mais n'a jamais réussi à savoir grand-chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160409
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160409,
					"content": "D'après nos informations, cette île était un lieu qui rassemblait des pirates, il y a plusieurs siècles. Le Shogunat s'est débarrassé d'eux et a fait migrer la population à d'autres endroits...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160410
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160410,
					"content": "Si je ne m'abuse, ce « Domeki » est vraisemblablement « Ako Domeki », le chef des pirates qui a choisi d'entrer en conflit direct avec le Shogunat. Son nom est mentionné dans les archives.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160411
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160411,
					"content": "Toujours d'après nos informations, Ako Domeki a mené sa flotte dans une bataille navale contre le Shogunat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160412
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160412,
					"content": "Ils ont été rapidement neutralisés et forcés de battre en retraite sur l'Île de Seirai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160413
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160413,
					"content": "Cependant, une tempête s'est déclenchée soudainement sur l'île lorsque le Shogunat était à sa recherche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160414
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160414,
					"content": "Ako Domeki et sa flotte ont été pris dedans... Personne ne les a revus depuis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160415
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160415,
					"content": "Une tempête...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160416
					]
				},
				{
					"id": 722160416,
					"content": "Je prends la suite. Bien évidemment, le plus grand mystère reste les circonstances de l'apparition de cette tempête.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160417
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160417,
					"content": "Bien que la flotte d'Ako Domeki ait été victime de cette tempête qui l'a quasiment décimée, on ne peut pas dire que celle du Shogunat ait été épargnée non plus. Les rescapés ont été forcés de rentrer sur l'Île de Narukami. Cela prendra pas mal de temps avant que la flotte ne puisse se reconstituer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160418
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160418,
					"content": "C'est comme si cette tempête s'était déclenchée au bon moment... Comme si quelqu'un la contrôlait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160419
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160419,
					"content": "Vous vous souvenez des pierres de protection ? Figurez-vous que leurs sceaux ont été délibérément retirés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160420
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160420,
					"content": "Une fois qu'on les a scellées à nouveau, le calme est revenu sur l'île.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160421
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160421,
					"content": "Je ne vais pas tirer de conclusions hâtives, mais je pense que ces deux événements sont liés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160422
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160422,
					"content": "On pourrait demander l'avis de dame Neko...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160423
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160423,
					"content": "... Oublie ça. Les textes disent que Domeki est porté disparu. Mais étant donné qu'il a été pris dans la tempête, il est sans doute...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160424
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160424,
					"content": "Nous continuerons d'explorer l'île pour rassembler des informations à propos de cet incident pendant encore un bout de temps, avant de retourner à la Guilde des aventuriers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160425
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160425,
					"content": "#Peut-être que nous aurons l'occasion de travailler à nouveau ensemble, {M#voyageur}{F#voyageuse}. Qui sait ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160426
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160426,
					"content": "Avec plaisir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160427
					]
				},
				{
					"id": 722160427,
					"content": "Oui, nous aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160428
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160428,
					"content": "Taisuke, préparons-nous à partir. L'exploration ne va pas se faire toute seule.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160429
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160429,
					"content": "Hum... À propos de dame Neko...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160430
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160430,
					"content": "Tu peux continuer à voir ce chat comme tu le faisais jusque-là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160431
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160431,
					"content": "Mais évite de lui dire des choses que tu ne devrais pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160432
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160432,
					"content": "Elle a l'air si heureuse... Il ne faudrait pas qu'un rabat-joie vienne tout gâcher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160433
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160433,
					"content": "Compris ! Etsuko, tu es si...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160434
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160434,
					"content": "... Je ne cherche qu'à effectuer nos missions le plus efficacement possible. Allez, au boulot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160435
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160435,
					"content": "Île de Seirai... Il semblerait que nous n'avons pas terminé de percer tous tes mystères...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160407,
					"content": "Vous savez quelque chose dessus ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160408
					]
				}
			]
		}
	]
}