				"objectNames": [
					"Mardava"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700730101,
					"content": "Je veux m'entraîner avec ce grand gaillard.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700730102
					]
				},
				{
					"id": 700730102,
					"content": "#Béni soit-il{NON_BREAK_SPACE}! Même mon seigneur doit garder son corps divin souple, afin que les tranches tombées deviennent tendres et savoureuses. Ne vous retenez pas. Ne montrez aucune pitié{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mardava"
				}
			]
		},
		{
			"id": 7007302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7007302",
							"2"
						],
						"stepId": 7007302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mardava"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700730201,
					"content": "Ô mon seigneur, Maha{RUBY#[D]Descendant du seigneur qui accorde la vie} Vasudevayaputra, que vos jivas{RUBY#[D]racines de la vie}thaya s'enfoncent profondément dans le roc de ces terres. Que votre goût surpasse celui de toutes les divinités des cieux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mardava"
				}
			]
		},
		{
			"id": 7007303,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7007302",
							"2"
						],
						"stepId": 7007302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mardava"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700730301,
					"content": "Qu'est-ce que c'est que ça...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700730302
					]
				},
				{
					"id": 700730302,
					"content": "#Quelle question bénie{NON_BREAK_SPACE}! Voici le vénéré descendant du seigneur{RUBY#[S]Bifrons} qui accorde la vie, un Fongus sacré né d'une saveur parfaite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700730303
					],
					"speakerTitle": "Mardava"
				},
				{
					"id": 700730303,
					"content": "#Nagahvaya invoque sans cesse le seigneur de la verdure et le seigneur du jar{RUBY#[D]Pushpavatika}din des fleurs. Makani Khagan prie éternellement le seigneur des sables. Mais demandez-leur vous-même{NON_BREAK_SPACE}: parmi ces trois grands seigneurs, lequel a meilleur goût que le mien{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700730304
					],
					"speakerTitle": "Mardava"
				},
				{
					"id": 700730304,
					"content": "#Sachez-le{NON_BREAK_SPACE}: ne pas nuire est la voie de la droiture. Sans la chair divine de notre seigneur, nous serions contraints de prendre la vie des bêtes, des oiseaux et des plantes pour survivre... Hélas, que ce serait pitoyable{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700730305
					],
					"speakerTitle": "Mardava"
				},
				{
					"id": 700730305,
					"content": "#Quelle chance{NON_BREAK_SPACE}! Lorsque la Maîtresse de l'espace m'emporta loin de la terre, les ji{RUBY#[D]spores}vas de mon seigneur m'accompagnèrent. Et comme vous pouvez le constater, elles ont prospéré jusqu'à ce jour, conférant une saveur suprême et merveilleuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mardava"
				}
			]
		},
		{
			"id": 7007304,
