			"dialogs": [
				{
					"id": 761830201,
					"content": "C'est important de prendre le temps de se détendre de temps en temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830202,
						761830203
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 761830202,
					"content": "(Rester encore ici un moment.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830204
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761830204,
					"content": "Très bien. On se retrouve à Snezhnaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 761830203,
					"content": "L'heure du thé est terminée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830204
					],
					"speakerTitle": "Sandrone"
				}
			]
