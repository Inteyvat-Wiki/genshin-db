			"dialogs": [
				{
					"id": 761830101,
					"content": "Merci pour ton invitation, Sandrone. Les douceurs ont toujours ce goût familier... Ça me rappelle de bons souvenirs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830102
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 761830102,
					"content": "De rien. Si tu veux, on pourrait se voir plus souvent quand je serai de retour à Snezhnaya. Ce sera comme au bon vieux temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830103
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761830103,
					"content": "Bien sûr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830104
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 761830104,
					"content": "En parlant de Snezhnaya, comment vont les choses de ton côté ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830105
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761830105,
					"content": "Les plans de Sa Majesté la Tsarine ont fait quelques progrès initiaux, mais le projet Stuzha s'avère plus difficile à mettre en œuvre que ce que le maire avait anticipé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830106
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 761830106,
					"content": "Il semblerait que nous allons toutes les deux être très occupées à partir de maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830107
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761830107,
					"content": "Mais nous trouverons sans doute un moment pour prendre un thé de temps à autre ou aller voir un spectacle de la Troupe Korolevskiy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830124
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 761830124,
					"content": "Oui. Nous trouverons sans doute un moment pour prendre un thé de temps à autre ou aller voir un spectacle de la Troupe Korolevskiy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830108
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 761830108,
					"content": "Odette danse-t-elle toujours le ballet ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830109
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761830109,
					"content": "Oui. Chaque fois que je la vois, j'ai l'impression qu'elle ne cesse de s'améliorer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830110
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 761830110,
					"content": "Incroyable. J'aimerais beaucoup la voir se produire à nouveau quand je serai de retour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830111
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761830111,
					"content": "Je trouve cela vraiment fascinant. Bien qu'elle ait appris son art auprès de Rosalyne, leurs tempéraments et leurs styles ne pourraient être plus différents.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830112
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761830112,
					"content": "Ce n'est pas forcément une mauvaise chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830113
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 761830113,
					"content": "C'est vrai... Rosalyne dansait avec une passion ardente, tandis qu'Odette est aussi froide qu'un bloc de glace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830114
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761830114,
					"content": "Elle semble porter un lourd fardeau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830115
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 761830115,
					"content": "Et pourtant, quand elle se produit sur scène, ses mouvements sont si purs, comme si son cœur était libre de la moindre imperfection.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830116
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761830116,
					"content": "Ou peut-être qu'elle a enfermé tout ça quelque part où personne ne peut le voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830117
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 761830117,
					"content": "Peut-être. Au fond, n'est-ce pas ce que fait la glace, recouvrir les fissures ? Mais elle n'est pas fragile, elle est déterminée. Je dirais même qu'elle est dangereuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830118
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761830118,
					"content": "Au moins à ce niveau, elle ressemble à Rosalyne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830119
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 761830119,
					"content": "Parce qu'elle est dangereuse ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830120
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761830120,
					"content": "Parce qu'elle est résolue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830121
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 761830121,
					"content": "C'est vrai. Pas étonnant qu'on murmure qu'elle est la favorite pour hériter du titre de « Signora ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830122
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761830122,
					"content": "Haha... Une fois que nous la connaîtrons mieux, nous pourrions l'inviter à prendre le thé avec nous. J'espère qu'elle ne refusera pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830123
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761830123,
					"content": "Espérons-le.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830124
					],
					"speakerTitle": "Arlecchino"
				}
			]
		},
