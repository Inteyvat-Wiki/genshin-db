		},
		{
			"id": 4121002,
			"completionStepIds": [
				4121002
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4121002",
							"2"
						],
						"stepId": 4121002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sucrose"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412100201,
					"content": "Hé, mais c'est Sucrose !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100202,
					"content": "Tu es venue explorer la montagne aussi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100203,
					"content": "Ouah ! Tu m'as fait peur... J'étais en train de réviser mon rapport de recherche !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100204
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100204,
					"content": "Pour moi, tu fixais le vide...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100205,
					"content": "P—Pas du tout ! J'étais en train de penser à un nom pour l'espèce de fleur sucrante que j'ai inventée, qui produisent des graines quatre fois plus grosses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100206,
						412100207
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100206,
					"content": "Je suis certaine que c'est délicieux.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100208
					]
				},
				{
					"id": 412100208,
					"content": "Ça t'intéresse ? Génial, je te montrerai les fruits de mon travail la prochaine fois !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100209
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100209,
					"content": "J'en aurais eu quelques-unes sur moi si je n'étais pas venue dans ces montagnes, dommage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100210
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100210,
					"content": "D'ailleurs, tu n'étais pas censée être en ville ? Que fais-tu ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100211,
					"content": "Timaeus et moi étions en train d'aider Albedo à trier des données pour ses recherches. Timaeus vient tout juste de partir, vous ne l'avez pas vu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100212
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100212,
					"content": "Pas du tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100213,
					"content": "Il m'a dit qu'il n'était pas aussi doué qu'Albedo en ce qui concerne les données.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100214
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100214,
					"content": "Albedo est capable de réussir instantanément des choses qui nous prennent un temps considérable. Tout un fossé nous sépare en matière de connaissances et d'expérience...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100215
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100215,
					"content": "Timaeus avait l'air assez déprimé par ça, alors il est parti prendre l'air et m'a laissé continuer seule.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100216
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100216,
					"content": "(Il l'a un peu laissée en plan...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100217
					]
				},
				{
					"id": 412100217,
					"content": "Je voulais faire un tour dans les environs aussi après avoir terminé, mais j'ai trouvé des choses intéressantes en fouillant ces rapports.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100218
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100218,
					"content": "Mais bon... *soupir* Je suppose que ma recherche sur ces secrets devra attendre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100219
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100219,
					"content": "Des secrets ? Ohh, quels secrets ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100220,
					"content": "Ah, vous auriez un peu de temps ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100221
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100221,
					"content": "Nous sommes libres comme l'air !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100222,
					"content": "Je peux vous demander un service ? Je crois qu'Albedo nous cache quelque chose, à Timaeus et à moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100223
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100223,
					"content": "C'est votre professeur, non ? Pourquoi aurait-il des choses à cacher à ses élèves ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100224,
					"content": "Tu as raison, mais j'ai l'impression qu'il cache toujours quelque chose... Je pense qu'il s'agit d'un grand secret d'alchimie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100225
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100225,
					"content": "Comment peux-tu en être aussi sûre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100226,
					"content": "Timaeus et moi sommes deux grands passionnés d'alchimie. Je ne vois pas ce qu'Albedo pourrait nous cacher d'autre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100227
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100227,
					"content": "Hmm, c'est vrai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100228,
					"content": "Pourriez-vous m'aider à percer son secret à jour ? Je suis vraiment trop curieuse ! S'il vous plaît !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100229
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100229,
					"content": "#Qu'est-ce que tu en penses, {NICKNAME} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100230,
						412100231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100230,
					"content": "Si Sucrose le veut, qui suis-je pour refuser ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100232
					]
				},
				{
					"id": 412100232,
					"content": "Waouh ! Merci du fond du cœur !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100233
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100233,
					"content": "D'accord, d'accord. On y va !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100231,
					"content": "#Je suis aussi {M#curieux}{F#curieuse} du secret d'Albedo !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100232
					]
				},
				{
					"id": 412100207,
					"content": "Peut-on vraiment en manger ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100208
					]
				}
			]
		},
		{
			"id": 4121003,
			"completionStepIds": [
				4121004
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
