			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412100301,
					"content": "Albedo !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100302,
					"content": "C'est encore nous.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100303
					]
				},
				{
					"id": 412100303,
					"content": "Oh ? Qu'est-ce qui vous amène ici de nouveau ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100304
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100304,
					"content": "#Vous vous êtes {F#perdues}{M#perdus} sur le chemin ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100305
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100305,
					"content": "Non !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100306,
						412100307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100306,
					"content": "Sucrose nous a demandé de percer votre secret.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100308
					]
				},
				{
					"id": 412100308,
					"content": "Moi ? Un secret ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100309
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100309,
					"content": "Mais qu'est-ce que tu fais ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100310,
					"content": "Il ne faut pas mettre les pieds dans le plat comme ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100311,
					"content": "Albedo voit à travers notre jeu de toute façon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100312
					]
				},
				{
					"id": 412100312,
					"content": "Oui, mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100313,
					"content": "Ah, vous tombez bien. J'ai besoin de vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100314
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100314,
					"content": "Attrapez !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100315
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100315,
					"content": "Oh, c'est quoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100316,
					"content": "Une épée, comme vous pouvez le voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100317,
						412100318
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100317,
					"content": "La forge vous intéresse ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100319
					]
				},
				{
					"id": 412100319,
					"content": "Je n'ai pas forgé cette arme, mais je lui ai ajouté quelques propriétés alchimiques.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100320
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100320,
					"content": "Ça vous dit d'essayer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100321
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100321,
					"content": "Vous me la donnez ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100322
					]
				},
				{
					"id": 412100322,
					"content": "#D'après mes recherches, vous êtes {M#le seul}{F#la seule} capable de la manier pour des raisons particulières.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100323
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100323,
					"content": "J'aurais besoin d'informations à son sujet assez rapidement, alors ça ne vous dérangerait pas de l'utiliser en combat ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100324
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100324,
					"content": "#Attendez un peu, comment est-ce possible ? De tous les gens qui vivent en Teyvat, {NICKNAME} est {M#le seul}{F#la seule} capable de manier cette épée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100325,
					"content": "Il y a des effets secondaires ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100326
					]
				},
				{
					"id": 412100326,
					"content": "Perspicace de votre part. En effet, cette épée est maudite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100327
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100327,
					"content": "Ce qui fait qu'une personne ordinaire ne peut la manier, vous êtes l'exception.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100328
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100328,
					"content": "Hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100329,
					"content": "#Disons que vous êtes {M#immunisé}{F#immunisée} contre cette malédiction. Vers qui pourrais-je me tourner si ce n'est vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100330
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100330,
					"content": "Assez papoté. Allez affronter quelques monstres pour voir. Dans certains cas, la pratique sert aussi de théorie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100318,
					"content": "Les alchimistes doivent aussi être des forgerons ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100319
					]
				},
				{
					"id": 412100307,
					"content": "Sucrose pense que vous lui cachez quelque chose.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100308
					]
				}
			]
		},
		{
			"id": 4121004,
			"completionStepIds": [
				4121006
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4121006",
							"2"
						],
						"stepId": 4121006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Homme féroce"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412100401,
					"content": "#Par ici ! C'est {M#ce morveux}{F#cette morveuse} qui l'a !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100402
					],
					"speakerTitle": "Homme féroce"
				},
				{
					"id": 412100402,
					"content": "Rendez-la-nous, sales voleurs !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100403
					],
					"speakerTitle": "Homme féroce"
				},
				{
					"id": 412100403,
					"content": "Des Pilleurs de trésors ? Ils ont fait le déplacement jusqu'ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100404,
					"content": "Trêve de bavardage ! Redonnez-la-nous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100405
					],
					"speakerTitle": "Homme féroce"
				},
				{
					"id": 412100405,
					"content": "Attention !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				}
			]
		},
		{
			"id": 4121005,
			"completionStepIds": [
				4121008
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4121008",
							"2"
						],
						"stepId": 4121008,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412100501,
					"content": "#Des Pilleurs de trésors qui osent nous traiter de {M#voleurs}{F#voleuses} ! C'est l'hôpital qui se fiche de la charité !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100502,
					"content": "Ils n'ont pas perdu de temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100503,
						412100504
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100503,
					"content": "C'est vous le voleur, Albedo ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100505
					]
				},
				{
					"id": 412100505,
					"content": "Pas du tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100506
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100506,
					"content": "Pourtant, ils avaient l'air de parler de cette épée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100507,
					"content": "Pourquoi ce regard accusateur ? Je vous répète que je n'ai pas volé cette épée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100508
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100508,
					"content": "Les chevaliers de l'Ordre ont intercepté un groupe de Pilleurs de trésors près de la cité. Les biens qu'ils trafiquaient ont été confisqués...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100509
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100509,
					"content": "Et cette épée en faisait partie. Nous pensions qu'elle avait été subtilisée à quelqu'un, mais personne n'est venu la réclamer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100510
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100510,
					"content": "Je l'ai remarquée par hasard dans notre entrepôt. Une épée aussi ancienne n'a pas grande utilité en dehors de l'alchimie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100511
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100511,
					"content": "Hein ? Vous vous l'êtes appropriée, juste comme ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100512,
					"content": "Et... qu'est-ce qu'il s'est passé ? Vous l'avez juste prise avec vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100513,
					"content": "Oui. Je voulais l'utiliser dans le cadre de mes expériences, mais j'ai découvert ses origines dans la foulée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100514
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100514,
					"content": "Cette arme ancienne est une épée magique légendaire forgée par un artisan disparu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100515
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100515,
					"content": "Une épée magique ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100516,
					"content": "Apparemment, le forgeron aurait disparu peu après la création de cette épée dont la trace fut également perdue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100517
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100517,
					"content": "On peut supposer qu'elle a été volée par les Pilleurs de trésors et qu'on n'en a plus entendu parler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100518
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100518,
					"content": "Le créateur de cette épée a disparu ?! C'est louche !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100519,
					"content": "Vous m'étonnez qu'elle est maudite !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100520,
					"content": "Tout à fait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100521
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100521,
					"content": "Dire qu'un humain a pu forger une arme pareille...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100522
					]
				},
				{
					"id": 412100522,
					"content": "Connaissez-vous l'histoire de <color=#00E1FFFF>Durin</color> et de cette montagne ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100523
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100523,
					"content": "<color=#00E1FFFF>Durin</color> est le dragon noir qui terrorisait Mondstadt il y a plusieurs siècles avant d'être vaincu par <color=#00E1FFFF>Barbatos</color> et <color=#00E1FFFF>Dvalin</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100524
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100524,
					"content": "Après la bataille, Durin s'est abattu au sommet de cette montagne enneigée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100525
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100525,
					"content": "La neige au sommet de cette montagne n'a jamais fondu, ce qui est très curieux. C'est à se demander si la chute de Durin ici était une coïncidence ou non...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100526
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100526,
					"content": "Pourquoi ça ne le serait pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100527
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100527,
					"content": "Cet endroit a peut-être été choisi parce que la neige était capable de sceller le poison qui émanait du dragon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100528
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100528,
					"content": "Barbatos a sans doute dû y penser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100529
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100529,
					"content": "Barbatos était-il si génial que ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100530
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100530,
					"content": "Ce ne sont que des spéculations de ma part. Je n'ai aucune preuve, mais je suis persuadé que cette montagne et Durin sont liés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100531
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100531,
					"content": "Je crois même que l'épée que je vous ai confiée a été forgée avec les restes de Durin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100532
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100532,
					"content": "Des restes de dragon ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100533
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100533,
					"content": "Ses yeux, griffes et écailles ont été moulus en poudre pour recouvrir l'épée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100534
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100534,
					"content": "De cette façon, le venin de Durin a imprégné l'arme pour devenir sa source de puissance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100535
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100535,
					"content": "C'est une technique très avancée. Je suppose que le forgeron a voulu essayer l'arme après l'avoir forgée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100536
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100536,
					"content": "Mais en ce faisant, il s'est lui-même empoisonné rien qu'en la brandissant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100537
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100537,
					"content": "Hélas, les humains ordinaires ne peuvent pas supporter un tel pouvoir. Le forgeron a dû devenir fou et courir à sa perte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100538
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100538,
					"content": "Hiii...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100539
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100539,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100540
					]
				},
				{
					"id": 412100540,
					"content": "Or vous avez purifié les larmes de Dvalin. Un exploit dont peu sont capables.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100541
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100541,
					"content": "Non seulement vous ne succombez pas au poison, mais vous pouvez même l'éliminer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100542
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100542,
					"content": "#D'où ma conclusion : vous {M#seul}{F#seule} êtes capable de manier cette épée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100543
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100543,
					"content": "Cette épée est quand même énorme !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100544
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100544,
					"content": "Et elle brille ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100545
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100545,
					"content": "Et voilà le début de notre expérience.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100546
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100546,
					"content": "L'épée est faible pour le moment, mais elle peut absorber de l'énergie pour se renforcer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100547
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100547,
					"content": "On pourrait presque dire qu'elle est vivante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100548
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100548,
					"content": "#Je vous la confie, {M#voyageur}{F#voyageuse}. Utilisez-la autant que vous voulez, j'aurais besoin que vous la renforciez pour moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100549
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100549,
					"content": "Nous aurons très bientôt tous les éléments de réponse qu'il nous faut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100504,
					"content": "Vous leur avez volé quelque chose ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100505
					]
				}
			]
		}
	]
}