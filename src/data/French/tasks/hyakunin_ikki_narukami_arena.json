				"points": []
			},
			"dialogs": [
				{
					"id": 727270201,
					"content": "Nous y voilà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270202
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270202,
					"content": "Comme toujours, cette porte un peu bizarre vous permettra d'accéder à l'arène.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270203,
						727270204
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270203,
					"content": "... Elle n'a pas changé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727270207
					]
				},
				{
					"id": 727270207,
					"content": "Je serai encore là pour vous soutenir et documenter vos exploits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270208,
						727270209
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270208,
					"content": "J'ai trop hâte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727270210
					]
				},
				{
					"id": 727270210,
					"content": "J'espère que vous nous montrerez à nouveau vos talents d'épéiste !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270209,
					"content": "Ce tournoi est une corvée...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727270210
					]
				},
				{
					"id": 727270204,
					"content": "Quelles sont les règles du Hyakunin Ikki ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727270205
					]
				},
				{
					"id": 727270205,
					"content": "Les règles sont similaires aux précédentes éditions. Monstres, aventuriers et guerriers des quatre coins de Teyvat qui brûlent d'envie de se battre se rassemblent pour se livrer à des combats épiques dans l'arène.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270206
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270206,
					"content": "Comme la dernière fois, vous pourrez vous battre avec des camarades. Après tout, plus on est de fous, plus on rit !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270207
					],
					"speakerTitle": "Kayabuki Ikkei"
				}
			]
		}
	]
}