				"objectNames": [
					"Kayabuki Ikkei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 727270101,
					"content": "#Bien le bonjour, {M#guerrier étranger}{F#guerrière étrangère} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270102,
						727270104
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270102,
					"content": "Comme on se retrouve.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727270103
					]
				},
				{
					"id": 727270103,
					"content": "#Ah, comme on se revoit ! Vous êtes toujours aussi {M#rayonnant}{F#rayonnante}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270106
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270106,
					"content": "... Ahem, il semblerait qu'un nouveau Hyakunin Ikki ait été organisé en secret ces derniers jours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270107,
						727270112
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270107,
					"content": "D'ailleurs, d'où est-ce que ça vient ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727270108
					]
				},
				{
					"id": 727270108,
					"content": "Au début, le Hyakunin Ikki était un événement organisé par les Tengunites pour célébrer des événements mémorables ou surmonter une déception en livrant des combats acharnés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270109
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270109,
					"content": "Artistes martiaux et monstres mettent leurs identités et différends de côté pour profiter de la pure joie que ça leur procure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270110
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270110,
					"content": "On raconte que le guerrier qui l'emporte sur les autres peut repartir avec toutes sortes de trésors...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270111
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270111,
					"content": "... Cela dit, depuis la dissolution des Tengunites, je ne sais pas vraiment qui organise le tournoi, ni d'où viennent les récompenses...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270115
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270115,
					"content": "En tout cas, il ne convient pas d'en discuter ici. Comme d'habitude, suivez-moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270116
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270116,
					"content": "Kayabuki Ikkei vous amène sur une petite île hors de la Cité d'Inazuma...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 727270112,
					"content": "... Encore ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727270113
					]
				},
				{
					"id": 727270113,
					"content": "Peut-être que vos exploits au combat ont attiré encore plus de personnes. Même les spectateurs étaient si enthousiastes qu'on aurait dit qu'ils voulaient tenter leur chance dans l'arène.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270114
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270114,
					"content": "À vrai dire, je ne pensais pas qu'un autre Hyakunin Ikki aurait eu lieu si tôt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270115
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270104,
					"content": "Et vous êtes...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727270105
					]
				},
				{
					"id": 727270105,
					"content": "Vous m'avez oublié ? ... Ah, désolé, pendant le dernier Hyakunin Ikki, j'étais tellement occupé par l'écriture de vos exploits que j'ai oublié de vous acclamer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270106
					],
					"speakerTitle": "Kayabuki Ikkei"
				}
			]
		},
		{
			"id": 7272702,
			"completionStepIds": [
				7272702
			],
