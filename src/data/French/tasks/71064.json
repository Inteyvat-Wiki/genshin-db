			"dialogs": [
				{
					"id": 710640502,
					"content": "À propos de la fleur de clairvoyance...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640501
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640501,
					"content": "On raconte que la fleur de clairvoyance n'est visible qu'aux yeux de ceux qui ont des aspirations tellement grandes qu'ils peuvent paraître fous aux yeux des autres. Ce n'est donc pas quelque chose à la portée de tout le monde... Hmm, je me demande de quel type de fleur il s'agit ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang"
				}
			]
		},
