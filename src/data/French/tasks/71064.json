						"rawParams": [
							"7106408",
							"3"
						],
						"stepId": 7106408,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710640201,
					"content": "(Une petite stèle sur laquelle est écrit la chose suivante...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640202
					],
					"speakerTitle": "Stèle en pierre"
				},
				{
					"id": 710640202,
					"content": "« Lors de la bataille du Gouffre, j'ai perdu l'usage de mes membres. Je n'ai donc d'autre choix que de dicter ces paroles et les faire graver en ce lieu. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640203
					],
					"speakerTitle": "Stèle en pierre"
				},
				{
					"id": 710640203,
					"content": "« Bien que j'aie réussi à sortir de cette bataille ardue en ayant la vie sauve, mes nuits sont hantées par le souvenir de mes compagnons tombés au front. De surcroît, je suis devenu infirme et je déteste le fait de ne pas avoir pu les accompagner dans leur trépas. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640204
					],
					"speakerTitle": "Stèle en pierre"
				},
				{
					"id": 710640204,
					"content": "« J'ai tenté de me donner la mort, mais cela a été futile : le Souverain de la Roche l'a appris et m'a sévèrement réprimandé, me réveillant aussitôt de ma léthargie. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640205
					],
					"speakerTitle": "Stèle en pierre"
				},
				{
					"id": 710640205,
					"content": "#« Hélas, je suis incapable de rendre la grâce que m'a accordée le Souverain de la Roche lorsqu'il m'a offert cette armure et ce casque de Millelithe, ils ne feraient que prendre la poussière en ma possession. Je les ai donc disposés en ce lieu en attente qu'une personne destinée à les recevoir vienne les acquérir.{NON_BREAK_SPACE}»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640206
					],
					"speakerTitle": "Stèle en pierre"
				},
				{
					"id": 710640206,
					"content": "« Mes chers, il n'y a plus rien que nous puissions faire dans cette vie, retrouvons-nous donc dans la prochaine en tant que camarades. L'heure venue, partageons à nouveau une coupe de vin en l'honneur de notre fratrie, avant de défendre Liyue contre l'ennemi ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Stèle en pierre"
				}
			]
		},
		{
			"id": 7106403,
			"completionStepIds": [
				7106411
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106411",
							"2"
						],
						"stepId": 7106411,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710640301,
					"content": "Incroyable, tu as vraiment réussi à le trouver... Alors c'est ça, le trésor des Millelithes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640302
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640302,
					"content": "Je n'ai aucune idée de ce qu'il contient, mais... je suis sûr que le soldat des Millelithes qui a laissé ce trésor serait soulagé d'apprendre qu'il a enfin été trouvé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640303
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640303,
					"content": "Cinq cents ans se sont écoulés depuis ce désastre... Quand je pense que cet endroit a été le théâtre d'une bataille intense, et qu'un nombre incalculable de nos ancêtres se sont sacrifiés, je ne peux m'empêcher de me demander si...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640304
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640304,
					"content": "... Si toutes les personnes qui sont allées se battre aux côtés du Souverain de la Roche pensaient vraiment que leur combat serait commémoré par les gens à travers les siècles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640305
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640305,
					"content": "N'ont-ils jamais eu de doutes quant à ce qu'ils étaient en train de faire ? Comment des gens du commun dépourvus d'œil divin ont-ils pu rester fidèles à un dieu qui n'a jamais daigné leur prêter un regard, et le suivre jusqu'à la mort ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640306,
						710640307
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640306,
					"content": "Leur dieu ne s'est jamais éloigné d'eux.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710640308
					]
				},
				{
					"id": 710640308,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640309
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640309,
					"content": "Oui, tu as raison. Qu'on ait un œil divin ou non, on cherche toujours à se battre pour un futur aux possibilités infinies. C'est ce qu'on appelle la motivation, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640310
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640310,
					"content": "On est comme eux. Ce qui nous motive, ce ne sont pas les bons moments du passé ou la réalisation de soi-même dans le présent... C'est de nous soutenir mutuellement en laissant derrière nous quelque chose de nous-mêmes qui symbolise notre époque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640311
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640311,
					"content": "Peut-être qu'un jour, dans un avenir lointain, le Gouffre deviendra aussi notre mémorial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640314
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640314,
					"content": "Tous ces puits et ces tunnels creusés par les mineurs à la sueur de leur front, génération après génération... Ils sont aussi le témoignage du chemin ardu que l'on a décidé d'emprunter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640312
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640312,
					"content": "Tout comme cette stèle, cet endroit sera là dans cent, voire mille ans, pour témoigner du fait que les sacrifices qui ont été faits ici n'ont pas été vains.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640313
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640313,
					"content": "Héhé, de toute évidence, je ne vivrai pas pour voir cela de mes propres yeux, mais... j'espère qu'un jour, quelqu'un viendra ici pour lever son verre en l'honneur des pauvres mineurs que nous sommes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640307,
					"content": "Ils sont également restés fidèles à leurs convictions.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710640308
					]
				}
			]
		},
