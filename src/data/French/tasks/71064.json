	"talks": [
		{
			"id": 7106402,
			"completionStepIds": [
				7106410
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
