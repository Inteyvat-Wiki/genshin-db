			},
			"dialogs": [
				{
					"id": 230181601,
					"content": "Vous êtes de retour. Comment ça s'est passé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181602
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230181602,
					"content": "Il n'a pas mangé de viande depuis des jours...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230181603
					]
				},
				{
					"id": 230181603,
					"content": "Comment ? Je voulais seulement qu'il mange plus sainement, pas qu'il arrête de consommer de la viande !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181604
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230181604,
					"content": "Tout ça pour mieux recevoir la faveur de l'Archon Dendro ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181605
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230181605,
					"content": "Bon... Il faut que je trouve autre chose pour la prochaine fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181606
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230181606,
					"content": "Merci beaucoup pour votre aide, veuillez accepter ceci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zakariya"
				}
			]
		},
