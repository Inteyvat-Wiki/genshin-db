			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zakariya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230180101,
					"content": "*soupir* Que dois-je faire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180102,
						230180103
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180102,
					"content": "Est-ce que je peux vous aider ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180119
					]
				},
				{
					"id": 230180119,
					"content": "Ces derniers temps, nous manquons vraiment d'effectifs. Je ne me suis pas reposé depuis plusieurs jours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180120
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180120,
					"content": "#{M#Voyageur}{F#Voyageuse}, si vous êtes libre, pourriez-vous m'aider à distribuer des médicaments aux patients à proximité ? Aussi, veuillez vérifier leur état de santé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180121,
						230180124
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180121,
					"content": "Je m'en occupe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180122
					]
				},
				{
					"id": 230180122,
					"content": "Je compte sur vous. Pour l'amour de l'Archon Dendro, j'ai vraiment besoin de l'aide de quelqu'un qui ne soit pas obsédé par sa faveur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180123
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180123,
					"content": "Ah, pour l'amour de l'Archon Dendro... Je le dis souvent moi-même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180124,
					"content": "Vous feriez mieux de vous reposer un peu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180125
					]
				},
				{
					"id": 230180125,
					"content": "Je ne peux pas me reposer. L'état de certains patients s'est dégradé et ils ont été placés ailleurs. Je dois encore leur prescrire leurs médicaments.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180126
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180126,
					"content": "*soupir* Ils vont certainement me redemander comment faire pour mieux recevoir la faveur de l'Archon Dendro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180127
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180127,
					"content": "#S'il vous plaît, {M#voyageur}{F#voyageuse}. J'ai vraiment besoin de l'aide de quelqu'un qui ne soit pas obsédé par la faveur de l'Archon Dendro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180103,
					"content": "Qu'est-ce qui se passe ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180104
					]
				},
				{
					"id": 230180104,
					"content": "#Vous êtes {M#un voyageur}{F#une voyageuse} ? Bienvenue au Bimarestan, un hôpital qui... répand la faveur de l'Archon Dendro aux masses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180105
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180105,
					"content": "Nous fournissons des soins médicaux à tous ceux qui en ont besoin, riches ou pauvres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180106
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180106,
					"content": "De ce fait... Nous faisons face à une grande vague de patients récemment et nous sommes débordés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180107
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180107,
					"content": "Même si la gentillesse de l'Archon Dendro envers l'homme est infinie... Le budget et les effectifs de l'hôpital sont bien limités.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180108
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180108,
					"content": "Certains patients ignorent même les instructions des médecins et demandaient seulement comment ils pourraient mieux recevoir la faveur de l'Archon Dendro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180109
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180109,
					"content": "Haha, la faveur de l'Archon Dendro... Bon sang !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180110
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180110,
					"content": "Si l'Archon Dendro pouvait leur accorder sa faveur aussi facilement, ils ne tomberaient pas malades en premier lieu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180111
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180111,
					"content": "... Oups, pardon. J'aurais dû garder ça pour moi. N'allez pas le dire à Golshan, ou elle va encore me passer un savon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180112,
						230180115
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180112,
					"content": "Vous n'êtes pas un fervent dévot de l'Archon Dendro ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180113
					]
				},
				{
					"id": 230180113,
					"content": "Bien sûr que si. Y a-t-il quelqu'un dans la Ville de Sumeru qui ne l'est pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180114
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180114,
					"content": "Mais vous pouvez remplacer le mot « fervent », disons que je suis un... dévot relativement rationnel de l'Archon Dendro, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180118
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180118,
					"content": "Hum... Désolé, la fatigue a raison de moi. Ce n'est que mon avis personnel, ne le prenez pas au sérieux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180119
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180115,
					"content": "Certaines personnes pensent que la guérison est la manifestation de la grâce de l'Archon Dendro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180116
					]
				},
				{
					"id": 230180116,
					"content": "*soupir* Sachez juste que cette idée existe, n'y croyez pas comme ces patients.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180117
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180117,
					"content": "Si l'Archon Dendro était vraiment toute-puissante, je n'aurais eu qu'à donner des champignons à mes patients pour qu'ils guérissent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180118
					],
					"speakerTitle": "Zakariya"
				}
			]
		},
		{
			"id": 2301802,
