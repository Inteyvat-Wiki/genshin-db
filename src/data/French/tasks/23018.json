					"Zakariya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230180201,
					"content": "Voici le médicament pour Gurgen, qui se trouve à côté du champ où poussent des plantes médicinales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180202
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180202,
					"content": "Il a travaillé si dur l'autre jour qu'il s'est blessé au bras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180203
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180203,
					"content": "Donnez-lui ce médicament, puis proposez-lui de prier l'Archon Dendro à la maison aujourd'hui pour qu'il arrête de travailler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180204,
						230180205
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180204,
					"content": "D'accord.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180207
					]
				},
				{
					"id": 230180207,
					"content": "Revenez me voir quand les médicaments seront distribués, votre récompense sera prête d'ici là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180205,
					"content": "Prier l'Archon Dendro ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180206
					]
				},
				{
					"id": 230180206,
					"content": "Vous croyez qu'il suivrait mon conseil si je ne le formulais pas ainsi ? Bon, faites ce que j'ai dit et tout ira bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180207
					],
					"speakerTitle": "Zakariya"
				}
			]
		},
		{
			"id": 2301803,
			"completionStepIds": [
				2301803
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2301803",
							"2"
						],
						"stepId": 2301803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gurgen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230180301,
					"content": "Hein ? C'est...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180302
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230180302,
					"content": "Voilà vos médicaments. Et n'oubliez pas de prier l'Archon Dendro à la maison.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180303
					]
				},
				{
					"id": 230180303,
					"content": "Ah, merci beaucoup. Prier l'Archon Dendro... Oui, c'est important...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180304
					],
