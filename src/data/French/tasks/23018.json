						230181803
					]
				},
				{
					"id": 230181803,
					"content": "Comment ? On peut manger de la viande dans le cadre d'un régime sain ? Les chercheurs de l'Académie font ça aussi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181804
					],
					"speakerTitle": "Aftab"
				},
				{
					"id": 230181804,
					"content": "C'est... C'est donc ça ! Et moi qui avais peur que ma consommation de viande énerve l'Archon Dendro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181805
					],
					"speakerTitle": "Aftab"
				},
				{
					"id": 230181805,
					"content": "Puisque les chercheurs le font... Ça ira si je mange de la viande aussi, merci beaucoup !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aftab"
