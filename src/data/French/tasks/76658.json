			"dialogs": [
				{
					"id": 766580101,
					"content": "Bonjour, Ginette ! Avez-vous reçu tous les robots qu'on a trouvés ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766580102,
					"content": "Oui ! Merci à vous deux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580103
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766580103,
					"content": "D'ailleurs, on a fait de nouvelles découvertes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766580104,
					"content": "Ah bon ? Dites-moi tout !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580105
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766580105,
					"content": "Vous racontez à Ginette ce que vous venez de voir.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						766580106
					]
				},
				{
					"id": 766580106,
					"content": "Les comportements que vous avez décrits... Les robots avaient l'air de vous apprécier, alors ils vous ont envoyé un message. Une invitation à jouer ensemble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580107
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766580107,
					"content": "Vraiment ? Trop cool !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766580108,
					"content": "Hmm... Je le savais !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580109
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766580109,
					"content": "Vous saviez quoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766580110,
					"content": "Maintenant, je suis certaine que ma vision ne peut être réalisée quà travers les interactions entre ces robots. Plus on récupérera d'unités, plus on se rapprochera de mon plan initial...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580111
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766580111,
					"content": "Ils peuvent communiquer avec les autres. Tout ce qu'on doit faire, c'est de retrouver le reste des robots... Mes idées créatives portent enfin leurs fruits !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580112
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766580112,
					"content": "Ouah, vous avez l'air bien contente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766580113,
					"content": "Ah ! Désolée, je me suis emportée... J'aurai encore besoin de votre aide. Voilà, j'ai indiqué la prochaine zone sur la carte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580114
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766580114,
					"content": "Mettons-nous en route ! Je suis aussi curieuse où ça va nous mener !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
