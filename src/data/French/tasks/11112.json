					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120216
					],
					"speakerTitle": "Petit Wu"
				},
				{
					"id": 111120216,
					"content": "Ah, les bonnes saveurs de son enfance, je suis sûr qu'il serait aux anges !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120217
					],
					"speakerTitle": "Petit Wu"
				},
				{
					"id": 111120217,
					"content": "Compris ! On revient tout de suite !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120212,
					"content": "(C'est tout Paimon ça...)",
