					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120803
					],
					"speakerTitle": "Congzi"
				},
				{
					"id": 111120803,
					"content": "J'ai inscrit nos cinq noms à l'intérieur de la lanterne. Vous savez, pendant le Festival des lanternes, on relâche des lanternes comme celle-ci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120804
					],
					"speakerTitle": "Congzi"
				},
				{
					"id": 111120804,
					"content": "Peu importe ce que les années nous réservent, ou les routes que nous prenons... Tant que ce rituel est respecté, nous restons les mêmes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120805
					],
					"speakerTitle": "Congzi"
				},
				{
					"id": 111120805,
					"content": "Et pour ce qui est de P'tit Costaud, nous avons discuté entre nous et avons décidé de ne pas insister.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120806
					],
					"speakerTitle": "Petit Wu"
				},
				{
					"id": 111120806,
					"content": "Mais si vous en avez l'occasion, dites-lui que... nous allons bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120807
					],
					"speakerTitle": "Mumu"
