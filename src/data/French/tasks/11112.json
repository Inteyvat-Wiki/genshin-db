			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111120101,
					"content": "Tout se passe si vite. Je suis un peu larguée pour dire vrai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120102,
						111120103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120102,
					"content": "Je ne pensais pas que nous allions tomber sur P'tit Costaud comme ça...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120104
					]
				},
				{
					"id": 111120104,
					"content": "En fait, ce n'est pas une surprise du tout ! Vous vous souvenez de ce que je vous ai dit ? Il n'y a que peu de mauvais esprits en ce monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120105
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120105,
					"content": "C'est un coup du sort qui lui a fait quitter la Pente Wuwang, et maintenant, pour une raison inconnue, il ne peut plus y retourner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120106
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120106,
					"content": "Ça semble un peu tiré par les cheveux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120107,
					"content": "En fait... Elle a plutôt raison.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120108
					],
					"speakerTitle": "P'tit Costaud"
				},
				{
					"id": 111120108,
					"content": "Hein ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120109,
					"content": "Héhé, ne doutez pas de mon instinct professionnel !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120110
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120110,
					"content": "Je voulais juste voir comment allaient mes amis. C'est pour ça que je suis revenu au Port de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120111
					],
					"speakerTitle": "P'tit Costaud"
				},
				{
					"id": 111120111,
					"content": "Je vous jure que je ne voulais rien faire de mal ! Je ne voulais effrayer personne !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120112
					],
					"speakerTitle": "P'tit Costaud"
				},
				{
					"id": 111120112,
					"content": "Il y a quelques jours, plusieurs personnes sont venues à la Pente Wuwang pour s'amuser. Quand je les ai entendues dire qu'elles venaient du Port de Liyue, j'ai décidé de suivre l'une d'entre elles jusqu'ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120113
					],
					"speakerTitle": "P'tit Costaud"
				},
				{
					"id": 111120113,
					"content": "Oh, ce doit être ce pauvre Luocheng. Bien qu'il ne vous ait pas vu, il a ressenti votre aura. Et c'est pour ça qu'il a fait tous ces cauchemars...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120114
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120114,
					"content": "Hein ? Il m'a ressenti ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120115
					],
					"speakerTitle": "P'tit Costaud"
				},
				{
					"id": 111120115,
					"content": "Je suppose, sinon il n'aurait pas eu aussi peur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120116
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120116,
					"content": "Pourquoi n'êtes-vous pas directement venu voir Meng ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120117
					]
				},
				{
					"id": 111120117,
					"content": "C'est vrai, Hu Tao et Meng vous ont cherché partout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120118,
					"content": "Oh... C'est parce que je ne les ai pas retrouvés. Je n'étais jamais allé au Port de Liyue, alors je me suis perdu dans la ville.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120119
					],
					"speakerTitle": "P'tit Costaud"
				},
				{
					"id": 111120119,
					"content": "Pas étonnant ! Même avant, P'tit Costaud n'avait aucun sens de l'orientation. Il n'osait même pas descendre de la montagne si personne ne l'accompagnait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120120
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111120120,
					"content": "Tout ça parce que tu t'es perdu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120121,
					"content": "Pourtant, les fantômes peuvent voler, non ? Ça n'aurait pas été plus facile en survolant la ville ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120122,
					"content": "Je... n'ose pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120123
					],
					"speakerTitle": "P'tit Costaud"
				},
				{
					"id": 111120123,
					"content": "C'est trop haut, j'ai trop peur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120124
					],
					"speakerTitle": "P'tit Costaud"
				},
				{
					"id": 111120124,
					"content": "Ah oui, c'était le seul d'entre nous qui n'osait pas regarder en bas de la montagne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120125
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111120125,
					"content": "Hahaha, tu n'as vraiment pas changé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120126,
						111120127
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111120126,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120128
					]
				},
				{
					"id": 111120128,
					"content": "Je sais bien qu'il ne faut pas que les gens me voient. Et avec tous ces gens qui vont et viennent dans le Port de Liyue, je n'avais pas d'autre choix que de me cacher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120129
					],
					"speakerTitle": "P'tit Costaud"
				},
				{
					"id": 111120129,
					"content": "... Si ce Monolithe des lignes énergétiques ne m'avait pas attiré jusqu'ici, je ne vous aurais jamais retrouvés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120130
					],
					"speakerTitle": "P'tit Costaud"
				},
				{
					"id": 111120130,
					"content": "Je suis tellement soulagé que tu ne sois pas devenu un mauvais esprit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120131
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111120131,
					"content": "Je vous avais bien dit de faire confiance à mon instinct professionnel ! Bon, nous n'avons qu'à raccompagner ce gamin perdu à la Pente Wuwang et tout sera résolu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120132
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120132,
					"content": "Mais il a dit qu'il voulait rendre visite à ses amis. Donc, en plus de moi, il y a toujours Petit Wu, Mumu et Congzi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120133
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111120133,
					"content": "Bon... Dans ce cas, nous devons accéder à sa requête. Comme ça en plus, ils pourront nous aider à préparer la cérémonie d'adieu pour P'tit Costaud.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120134
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120134,
					"content": "Meng et moi, nous allons ramener P'tit Costaud à la Pente Wuwang. Vous, vous devez retrouver ces trois personnes et leur demander à chacun un objet qui les représente. Ensuite, venez nous voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120135
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120135,
					"content": "Ce sont tous des amis. On ne peut pas y aller tous ensemble ? Ou au moins avec P'tit Costaud ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120136,
					"content": "Hmm... Il ne vaut mieux pas. Je ne veux pas leur faire peur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120137
					],
					"speakerTitle": "P'tit Costaud"
				},
				{
					"id": 111120137,
					"content": "Je ne veux pas que les gens ordinaires deviennent superstitieux. Moins ils en savent, mieux c'est !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120138
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120138,
					"content": "Donc, faites attention à ce que vous dites quand vous leur demandez des objets !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120127,
					"content": "Peut-être que « P'tit Costaud » n'est pas le nom le plus approprié...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120128
					]
				},
				{
					"id": 111120103,
					"content": "P'tit Costaud n'est pas un mauvais esprit ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120104
					]
				}
			]
		},
		{
			"id": 1111202,
			"completionStepIds": [
				1111202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1111202",
							"2"
						],
						"stepId": 1111202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Petit Wu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111120201,
					"content": "Bonjour, est-ce que vous vous souvenez de nous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120202,
					"content": "Encore vous... Désolé, je n'ai vraiment pas besoin des services de votre funérarium.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120203,
						111120204
					],
					"speakerTitle": "Petit Wu"
				},
				{
					"id": 111120203,
					"content": "Meng nous a raconté son histoire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120205
					]
				},
				{
					"id": 111120205,
					"content": "Oui, Meng et moi avons grandi ensemble. On se voit encore, de temps en temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120206
					],
					"speakerTitle": "Petit Wu"
				},
				{
					"id": 111120206,
					"content": "Je ne sais pas pourquoi il s'est mis à travailler pour le Funérarium Wangsheng. Pour être honnête, je trouve la directrice vraiment bizarre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120207
					],
					"speakerTitle": "Petit Wu"
				},
				{
					"id": 111120207,
					"content": "Mais il doit avoir ses raisons. Il est seul à présent, et il a du mal à oublier ce qui est arrivé à P'tit Costaud...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120208
					],
					"speakerTitle": "Petit Wu"
				},
				{
					"id": 111120208,
					"content": "Vous en a-t-il parlé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120209
					],
					"speakerTitle": "Petit Wu"
				},
				{
					"id": 111120209,
					"content": "Oui, il l'a fait ! Dites, si vous pouviez choisir une chose à donner à P'tit Costaud, que choisiriez-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120210,
					"content": "Juste, en théorie, vous savez. Nous ne parlons que d'hypothèse ici. C'est pas comme si on allait lui rendre hommage ou quoi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120211,
						111120212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120211,
					"content": "(Je crois que tu en dis déjà trop là.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120213
					]
				},
				{
					"id": 111120213,
					"content": "Euh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120214
					],
					"speakerTitle": "Petit Wu"
				},
				{
					"id": 111120214,
					"content": "Peut-être que je lui préparerais un plat bien épicé, il adorait ça ! Surtout le poulet pimenté de Jueyun avec double ration de piments !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120215
					],
					"speakerTitle": "Petit Wu"
				},
				{
					"id": 111120215,
