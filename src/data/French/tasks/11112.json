			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mumu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111120401,
					"content": "Encore vous... *soupir* Je vous ai dit que je n'avais que faire des services du funérarium !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120402
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120402,
					"content": "Meng nous a parlé de vous. Vous êtes bons amis, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120403,
					"content": "Oh, oui, vous avez raison... Mais c'est vrai ça, il a rejoint le Funérarium Wangsheng il n'y a pas longtemps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120404
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120404,
					"content": "Et il n'a pas fallu longtemps pour qu'on devine pourquoi. Nous sommes des amis d'enfance après tout... C'est à cause de ce qu'il s'est passé avec P'tit Costaud.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120405
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120405,
					"content": "Malheureusement, il est impossible de raisonner avec lui. Ne plus s'appesantir sur le passé est un processus douloureux, et j'en sais quelque chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120406
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120406,
					"content": "Donc, vous êtes là pour P'tit Costaud ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120407
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120407,
					"content": "Comment avez-vous deviné !? On n'a rien dit du tout...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120408,
					"content": "Haha, je suis un homme d'affaires, je n'en parlerai à personne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120409
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120409,
					"content": "Quand on sait que je m'appelle Mumu, on peut se dire que je suis un peu lent à la détente. Ça m'a causé pas mal de soucis quand j'ai commencé dans les affaires, mais à la fin... J'ai réussi à prouver à quelques-uns le contraire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120410
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120410,
					"content": "Prenez donc ceci. C'est une boîte à jouets haut de gamme que nous rêvions tous de posséder quand nous étions enfants. À l'époque, aucun de nous ne pouvait se le permettre, nous étions sans le sou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120411
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120411,
					"content": "Maintenant que mes affaires sont en plein essor, j'ai fini par en acheter des dizaines. C'était comme un rêve devenu réalité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120412
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120412,
					"content": "Waouh, alors vous êtes genre... super riche ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120413,
					"content": "Haha ! Pour moi, c'est un souvenir de mon enfance. Sans elle, je n'en serais pas où j'en suis aujourd'hui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120414
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120414,
					"content": "Donc, après moi, j'imagine que vous devez aller voir Petit Wu et Congzi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120415
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120415,
					"content": "#Hmm, on est déjà {M#allés}{F#allées} voir Petit Wu. Maintenant, direction Congzi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120416,
					"content": "Je vois. Pour Congzi, nous n'avons qu'à nous retrouver à la passerelle de la Pente Feiyun, juste au-dessus des escaliers menant aux quais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120417
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120417,
					"content": "J'ai encore des trucs à régler, et je viens dès que j'ai fini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mumu"
				}
			]
		},
