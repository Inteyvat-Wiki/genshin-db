					"nextDialogs": [
						111120502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120502,
					"content": "Nous nous retrouvons souvent ici pour parler du bon vieux temps. C'est devenu une sorte d'habitude depuis toutes ces années.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120503
					],
					"speakerTitle": "Petit Wu"
				},
				{
					"id": 111120503,
					"content": "Notre village a été complètement détruit il y a longtemps. Du coup, nous n'avons nulle part où rentrer... Maintenant, notre foyer, c'est là où se trouvent nos amis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120504
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120504,
					"content": "Ils m'ont dit que vous cherchiez des objets personnels, c'est ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120505
					],
					"speakerTitle": "Congzi"
				},
				{
					"id": 111120505,
					"content": "Je fabrique des lanternes célestes artisanales au Port de Liyue. Je suppose que c'est ce qui me représente le mieux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120506
					],
					"speakerTitle": "Congzi"
				},
				{
					"id": 111120506,
					"content": "Il y a quelques jours, j'ai acheté des fragments de plaustrite de bonne qualité. Ils sont stockés dans l'entrepôt des quais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120507
					],
					"speakerTitle": "Congzi"
				},
				{
					"id": 111120507,
					"content": "J'ai déjà prévenu l'administrateur. Pourriez-vous y aller pour les récupérer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120508
					],
					"speakerTitle": "Congzi"
				},
				{
					"id": 111120508,
					"content": "#Eh bien, on dirait que vous savez déjà tout ! {NICKNAME}, on y va tout de suite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
