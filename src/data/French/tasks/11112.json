					"Petit Wu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111120301,
					"content": "Très bien, ça devrait amplement suffire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120302
					],
					"speakerTitle": "Petit Wu"
				},
				{
					"id": 111120302,
					"content": "Bon, je m'en vais à mes fourneaux. J'imagine que vous avez d'autres personnes à voir, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120303
					],
					"speakerTitle": "Petit Wu"
				},
				{
					"id": 111120303,
					"content": "Quand tout le monde sera prêt, je vous apporterai le plat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120304
					],
					"speakerTitle": "Petit Wu"
				},
				{
					"id": 111120304,
					"content": "Génial ! À tout à l'heure, alors !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120305,
					"content": "(Hein ? Comment il a deviné ?)",
