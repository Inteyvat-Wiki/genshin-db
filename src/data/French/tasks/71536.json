			"dialogs": [
				{
					"id": 715360301,
					"content": "#C'est donc comme ça qu'il faut faire... Cette enveloppe-cadeau est merveilleuse, {NICKNAME}, merci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360302
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360302,
					"content": "Il ne me reste plus qu'à en fabriquer quelques-unes pour les offrir avec les souvenirs que j'ai achetés. Les gens vont les adorer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360303
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360303,
					"content": "Mais je vais garder celle-ci pour moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
