			},
			"dialogs": [
				{
					"id": 715360101,
					"content": "#Joyeuse fête des Lanternes, {NICKNAME}. Apparemment, vous avez aidé Dehya à fabriquer l'enveloppe-cadeau. Elle est magnifique, merci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360102
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360102,
					"content": "Tout est réglé au village ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715360103
					]
				},
				{
					"id": 715360103,
					"content": "Oui, grâce à Dehya et aux autres. Je peux dormir sur mes deux oreilles en sachant que le village n'est pas livré à lui-même en mon absence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360104
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360104,
					"content": "Profitez-en pour bien vous reposer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715360105
					]
				},
				{
					"id": 715360105,
					"content": "Oui. Dehya veut visiter le Village de Qiaoying dans quelques jours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360106
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360106,
					"content": "Elle a dit que le paysage était magnifique et que ce village était connu pour son thé. C'est un cadeau parfait à ramener chez nous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360107
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360107,
					"content": "Je vais aussi suivre la tradition et fabriquer quelques enveloppes-cadeaux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360108
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360108,
					"content": "Mais notre programme est plein à craquer grâce à Dehya, et avec toutes ces courses à faire, je ne suis pas sûre d'avoir le temps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360109
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360109,
					"content": "#Elle m'a dit que vous étiez {M#doué}{F#douée} pour faire des enveloppes-cadeaux. Pourriez-vous me montrer comment vous vous y prenez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360110
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360110,
					"content": "D'accord, je m'en occupe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
