				{
					"id": 733280201,
					"content": "Mille câlins à toi ! J'attendrai de te revoir avec impatience !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280202,
						733280206
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280202,
					"content": "Où est-ce qu'on se reverra, la prochaine fois ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280203
					]
				},
				{
					"id": 733280203,
					"content": "Qui sait ? Peut-être à Celestia ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280204
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280204,
					"content": "Hahahaha ! Je plaisante ! Mais si tu veux venir me voir là-bas, j'y serai à coup sûr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280205
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280205,
					"content": "Ne me demande pas pourquoi, je le sais, c'est tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280208
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280208,
					"content": "Bon, alors à la prochaine fois !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280206,
					"content": "Mille câlins à toi aussi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280207
					]
				},
				{
					"id": 733280207,
					"content": "Haha, merci !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
