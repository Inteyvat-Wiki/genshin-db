			"dialogs": [
				{
					"id": 742230401,
					"content": "Oh... C'est comme ça qu'il faut faire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230402
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230402,
					"content": "Vraiment impressionnant. Auriez-vous déjà servi dans l'armée du roi divin par hasard ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230403
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230403,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230404
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230404,
					"content": "Notre officier salue également votre performance ! On dirait que je dois m'entraîner davantage !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venier"
				}
			]
		},
