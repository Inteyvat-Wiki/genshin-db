			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742230201,
					"content": "Cent trente-six... Bon, encore quatorze, et je pourrai faire une pause.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230202
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230202,
					"content": "Vous avez besoin d'aide ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742230203
					]
				},
				{
					"id": 742230203,
					"content": "De l'aide ? Non, merci. Pourquoi aurais-je besoin d'aide pendant l'entraînement ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230204
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230204,
					"content": "Ce n'est qu'en renforçant mon physique que je pourrai rejoindre la Légion athanatoi et devenir un soldat honorable, comme cet officier !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230205
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230205,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230206
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230206,
					"content": "J'ai oublié de vous présenter. Voici mon instructeur. Ce n'est qu'en réussissant son test que j'aurai une chance d'être promu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230207,
						742230210
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230207,
					"content": "Ce n'est pas une statue ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742230208
					]
				},
				{
					"id": 742230208,
					"content": "#De quoi parlez-vous, {M#citoyen}{F#citoyenne} ? Les Rémuriens ne ressemblent-ils pas tous à ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230209
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230209,
					"content": "Alors, vous voulez essayer ? Si vous parvenez à briser ces piliers de pierre simultanément, vous aurez réussi la première partie de l'épreuve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230213
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230213,
					"content": "Ne les sous-estimez cependant pas ! Je m'entraîne depuis longtemps, et je peux à peine en briser un d'un seul coup de poing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230210,
					"content": "De l'épreuve ? Quelle épreuve ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742230211
					]
				},
				{
					"id": 742230211,
					"content": "Un test de compétences au combat, évidemment. Même si vous obtenez l'immortalité, les compétences au combat ne peuvent être acquises que par l'entraînement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230212
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230212,
					"content": "Alors, vous voulez essayer ? Si vous parvenez à briser ces piliers de pierre simultanément, vous aurez réussi la première partie de l'épreuve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230213
					],
					"speakerTitle": "Venier"
				}
			]
		},
