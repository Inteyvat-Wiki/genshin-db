				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10140401,
					"content": "Ainsi donc, voici la cloche purificatrice... Elle est très bien conservée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140402
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140402,
					"content": "Sortons aussi les baumes que nous avons préparés plus tôt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140403,
						10140405
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140403,
					"content": "Vous connaissez Madame Ping ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140404
					]
				},
				{
					"id": 10140404,
					"content": "Bien sûr. Comment aurais-je pu savoir que la cloche purificatrice lui appartenait autrement ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140407
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140407,
					"content": "Vous ne nous dites pas tout... Il y a visiblement des sujets que vous ne voulez pas aborder, alors on n'insistera pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140408,
					"content": "Ah oui ! La grand-mère nous a demandé de vous transmettre un message :",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140409,
					"content": "« Qu'il vienne boire le thé à l'occasion. Je n'ai guère de possessions, mais j'ai toujours de quoi servir le thé. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140410,
					"content": "Hahaha, voilà un ton qui ne te sied guère ! Mais le fait est que son nécessaire à thé est d'excellente qualité ; le thé qui en sort est on ne peut plus parfumé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140411
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140411,
					"content": "Quand l'occasion se présentera, j'y passerai avec du bon thé, cela va sans dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140412
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140412,
					"content": "Bien ! C'est quoi la suite ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140413,
					"content": "La suite... Nous allons à présent aller chercher des <color=#00E1FFFF>cerfs-volants</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140414
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140414,
					"content": "Ohhh, des cerfs-volants ? On va vraiment aller faire voler des cerfs-volants ? C'est la pause, c'est ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140415,
					"content": "Haha, bien sûr que non. On dit que ce sont des jouets d'enfant, mais ils revêtent une tout autre signification dans les cérémonies de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140416
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140416,
					"content": "Je vous expliquerai plus tard. Pour l'instant, la prochaine tâche qui requiert notre attention est l'achat de ces cerfs-volants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140417
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140417,
					"content": "Oh, bien sûr... De plus en plus bizarre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140405,
					"content": "Vous êtes un Adepte ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140406
					]
				},
				{
					"id": 10140406,
					"content": "Un Adepte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140407
					],
					"speakerTitle": "Zhongli"
				}
			]
