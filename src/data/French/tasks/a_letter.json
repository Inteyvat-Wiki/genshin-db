					"nextDialogs": [
						741270307
					]
				},
				{
					"id": 741270307,
					"content": "Ahem ! Venez, promenons-nous dans les environs. Je pense que cet endroit sera parfait pour prendre une photo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270308
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270308,
					"content": "Je dois d'abord trouver un bon angle pour éviter de ne pas savoir quoi dire lorsque monsieur Roialte va m'interroger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270309
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270309,
					"content": "#{NICKNAME}, prenez des photos pour moi, s'il vous plaît. J'ai entendu dire que vous étiez très {M#doué}{F#douée}, vous prendrez sûrement de meilleures photos que les miennes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270310
