				]
			},
			"dialogs": [
				{
					"id": 741270101,
					"content": "... Comme je l'ai souligné avant, cher gestionnaire, les règles sont les règles et je ne peux rien y faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270102
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270102,
					"content": "Monsieur Roialte a en effet envoyé la liste de documents requis, et je les ai préparés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270103
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270103,
					"content": "Mais vous ne pouvez pas venir récupérer les documents comme bon vous semble. C'est contraire à notre procédure de livraison du courrier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270104,
						741270105
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270104,
					"content": "Iaune ? Iaune !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270107
					]
				},
				{
					"id": 741270107,
					"content": "Bonjour Iaune. Vous avez l'air en pleine forme, héhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270108,
					"content": "Vous aussi. C'est grâce à monsieur Roialte et monsieur Semaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270109
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270109,
					"content": "#Hein ? Iaune, vous connaissez {NICKNAME} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270110
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270110,
					"content": "#Bien sûr, {NICKNAME} m'a beaucoup aidé avant. Sans {M#lui}{F#elle}, je n'aurais pas pu continuer à travailler à la Maison Gestion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270111
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270111,
					"content": "#Ah bon ? {NICKNAME} est vraiment digne du titre de {M#chercheur aîné}{F#chercheuse aînée} d'honneur de l'Institut de recherche de Fontaine, hahaha !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270112,
						741270113
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270112,
					"content": "#Je suis {M#doué}{F#douée} pour apporter un soutien spirituel.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270114
					]
				},
				{
					"id": 741270114,
					"content": "En tout cas, sans votre soutien, je n'aurais... Je n'y serais pas arrivé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270115
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270115,
					"content": "#Monsieur Choiseul vient de dire que vous étiez {M#un chercheur aîné}{F#une chercheuse aînée} d'honneur de l'Institut de recherche de Fontaine ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270116
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270116,
					"content": "Oui, j'ai même le certificat honorifique.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270117
					]
				},
				{
					"id": 741270117,
					"content": "Et on a pris une photo ensemble aussi ! Je suis dessus, mais je n'ai pas eu de certificat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270118,
					"content": "#C'est exact. En reconnaissance des services rendus par {NICKNAME} à l'Institut, nous lui avons conféré le titre de {M#chercheur aîné}{F#chercheuse aînée} d'honneur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270119
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270119,
					"content": "#Quant à ces « services »... Je laisserai {NICKNAME} vous les raconter de vive voix. Revenons-en à nos Brutocollinus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270120
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270120,
					"content": "Je ne peux vraiment pas vous donner le document maintenant, Iaune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270121
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270121,
					"content": "Mais vous aviez dit vouloir demander à un chercheur de vous guider aux environs de l'Institut de recherche de Fontaine pour prendre des photos... Il n'y a pas de problème pour ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270122
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270122,
					"content": "#Je pense que {NICKNAME} est tout à fait {M#qualifié}{F#qualifiée} pour la tâche. {M#Il}{F#Elle} connaît les environs comme sa poche et sera à la hauteur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270123
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270123,
					"content": "#Qu'en pensez-vous, {M#monsieur}{F#mademoiselle} {NICKNAME} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270124,
						741270125
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270124,
					"content": "Pas de problème, je m'en occupe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270126
					]
				},
				{
					"id": 741270126,
					"content": "#Vous êtes si {M#gentil}{F#gentille}. Je suis rassuré de voyager avec vous. Quand je suis arrivé ici, j'ai vu des mékas hors de contrôle et des monstres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270127
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270127,
					"content": "La prise de photos ne pose pas le moindre problème, mais monsieur Choiseul...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270128
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270128,
					"content": "Iaune, je veux bien vous aider, mais les règles sont les règles. Ne m'en voulez pas, je ne suis qu'un officier administratif qui ne sait que tamponner des documents.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270129
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270129,
					"content": "Bon, d'accord... Je vais retourner discuter de ce sujet avec monsieur Roialte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270130
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270130,
					"content": "Au revoir, monsieur Choiseul, et bonne journée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270131
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270131,
					"content": "Merci à vous et bonne journée à l'Institut de recherche de Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270132
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270132,
					"content": "#{NICKNAME}, alors je compte sur vous pour me guider. Allons d'abord au Parc commémoratif de Mary-Ann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270125,
					"content": "#Je suis {M#heureux}{F#heureuse} de pouvoir aider Iaune.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270126
					]
				},
				{
					"id": 741270113,
					"content": "Je n'ai fait que réparer le Tamponnateur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270114
					]
				},
				{
					"id": 741270105,
					"content": "Alors je planerai là-bas avec vous plus tard.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270106
					]
				},
				{
					"id": 741270106,
					"content": "#{NICKNAME} ! Je suis tellement ravi de vous voir ici ! Quelle coïncidence !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270107
					],
					"speakerTitle": "Iaune"
				}
			]
		},
