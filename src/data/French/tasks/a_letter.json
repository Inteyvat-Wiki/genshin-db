				},
				{
					"id": 741270506,
					"content": "#{NICKNAME} ! Non... Je devrais vous appeler {M#monsieur le chercheur aîné}{F#mademoiselle la chercheuse aînée} d'honneur ! Ravi de vous voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270507
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270507,
					"content": "Iaune, pourquoi avez-vous l'air triste. Que se passe-t-il ?",
