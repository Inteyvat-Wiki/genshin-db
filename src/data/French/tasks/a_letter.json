						741270302
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270302,
					"content": "Je reconnais que ce bâtiment a bien l'air d'un hall, mais en quoi est-il « académique » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270303,
						741270304
