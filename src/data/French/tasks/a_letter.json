					}
				]
			},
			"dialogs": [
				{
					"id": 741270201,
					"content": "Hein... C'est ici le Parc commémoratif de Mary-Ann ? Ça ne ressemble pas du tout à un parc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270202
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270202,
					"content": "Monsieur Roialte doit être déçu. Il avait même prévu d'inviter quelqu'un à prononcer un discours ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270203
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270203,
					"content": "À en juger par l'environnement, je ne pense pas que le discours aura lieu... Et il n'y a même pas de bâtiment emblématique pour prendre une photo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270204
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270204,
					"content": "On peut prendre certains mékas comme souvenirs.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270205
					]
				},
				{
					"id": 741270205,
					"content": "Hahaha, vous êtes très drôle. Mais il n'y a pas de place pour ce genre de choses à la Maison Gestion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270206
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270206,
					"content": "Et même si on les emporte, je dois encore les évaluer, les enregistrer, les classer et les conserver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270207
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270207,
					"content": "#Hé ! C'était une blague, ne prenez pas ça au sérieux{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270208,
					"content": "En parlant de rapport... Je n'ai toujours pas récupéré le document et monsieur Roialte va encore être déçu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270209,
						741270211
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270209,
					"content": "Choiseul vous a mis dans l'embarras ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270210
					]
				},
				{
					"id": 741270210,
					"content": "Pas vraiment, parce que ma... Ma demande allait un peu à l'encontre des règles. Il est normal qu'il ne soit pas d'accord.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270212
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270212,
					"content": "Comme vous le savez, l'Institut de recherche de Fontaine est en train de planifier sa reconstruction. Nous devons passer par la Maison Gestion pour le personnel et les matériaux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270213
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270213,
					"content": "La Maison Gestion prend cette affaire très au sérieux et a demandé à monsieur Roialte de former une équipe pour mener une inspection sur place dans les environs de l'Institut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270214
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270214,
					"content": "Monsieur Roialte est donc resté à la Maison Gestion pour compter le personnel, et moi, j'ai été chargé de revenir à l'Institut pour coordonner la réception.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270215
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270215,
					"content": "Il se trouve que l'Institut devait envoyer une lettre de réponse à la Maison Gestion, alors je me suis dit que je pouvais la rapporter tant que j'y étais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270216
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270216,
					"content": "Mais monsieur Choiseul m'a fait savoir que ce comportement n'était pas conforme à la procédure et qu'il ne me la donnerait pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270217
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270217,
					"content": "Pas conforme à la procédure ? Laquelle ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270218,
					"content": "L'obtention de ce document doit vraiment être aussi réglementée ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270219
					]
				},
				{
					"id": 741270219,
					"content": "C'est plutôt courir dans tous les sens pour obtenir des approbations et des signatures, puis écouter le blabla sans fin des bureaucrates ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270220,
					"content": "En résumé, la plupart des correspondances officielles au sein de la Maison Gestion doivent être envoyées par courrier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270221
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270221,
					"content": "Quoi ? Et si les services qui correspondent se trouvent dans la même rue, voire juste l'un en face de l'autre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270222,
					"content": "... C'est pour assurer la traçabilité de toutes les lettres officielles au sein de la Maison Gestion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270223
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270223,
					"content": "Ils aiment vraiment se créer des ennuis.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270224
					]
				},
				{
					"id": 741270224,
					"content": "Je pense que les gens y sont habitués...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270225
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270225,
					"content": "Bref, n'en parlons plus et passons à l'endroit suivant. Laissez-moi voir le mémo que monsieur Roialte m'a écrit... Eh bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270226
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270226,
					"content": "C'est le Hall d'assemblée académique de l'Institut de recherche de Fontaine. C'est étrange, je n'ai pas vu de bâtiment avec ce panneau quand je suis arrivé ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270227
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270227,
					"content": "Je sais où c'est. Suivez-moi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270228
					]
				},
				{
					"id": 741270228,
					"content": "Vous êtes tellement fiable ! Qu'est-ce que je ferais sans vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270229
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270229,
					"content": "Dépêchons-nous d'y aller. Il y a peut-être encore plus de mékas hors de contrôle dans les environs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270211,
					"content": "De quoi discutiez-vous avec Choiseul ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270212
					]
				}
			]
		},
