			"dialogs": [
				{
					"id": 741270401,
					"content": "Par les Archons... C'est vraiment très haut !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270402
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270402,
					"content": "Parlez-vous du niveau académique de l'Institut de recherche ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270403
					]
				},
				{
					"id": 741270403,
					"content": "Non, je parle de la hauteur de cet endroit, même si le niveau académique de l'Institut était certainement aussi haut avant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270404
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270404,
					"content": "Mais maintenant... *soupir* Qui aurait cru que l'Institut de recherche souffrirait autant ? Je ne sais pas si les travaux de reconstruction pourront se dérouler sans accroc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270405
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270405,
					"content": "Notre dernier arrêt est... le Bureau d'évaluation des qualifications de l'Institut de recherche de Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270406
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270406,
					"content": "Je n'arrive pas à croire que vous êtes arrivé à prononcer ça d'une traite...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270407
					]
				},
				{
					"id": 741270407,
					"content": "Merci du compliment. Mais où se trouve cet endroit ? Je n'ai jamais vu ce bureau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270408
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270408,
					"content": "C'est bien Desnos, le responsable de ce bureau ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270409
					]
				},
				{
					"id": 741270409,
					"content": "#Oui ! C'est exact. Vous connaissez aussi cet endroit ? Pas étonnant que vous soyez {M#un chercheur aîné}{F#une chercheuse aînée} d'honneur. Vous êtes bien {M#informé}{F#informée} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270410
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270410,
					"content": "Ah... Je m'en souviens ! C'est le bureau dans les ruines, non ? Si... on peut encore appeler ça un bureau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270411,
					"content": "Peut-être que monsieur Desnos a raccourci le nom pour faciliter votre compréhension.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270412
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270412,
					"content": "Veuillez m'indiquer le chemin. Je dois récupérer des documents auprès de monsieur Desnos avant de retourner à la Maison Gestion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270413
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270413,
					"content": "Tout s'est bien déroulé aujourd'hui. Je peux rentrer me reposer bientôt. L'Institut de recherche de Fontaine fait les choses bien différemment de... Ahem, je n'ai rien dit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				}
			]
