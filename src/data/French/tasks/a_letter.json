					"nextDialogs": [
						741270502
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270502,
					"content": "Monsieur Roialte m'a envoyé ici pour mener une inspection. J'ai donc pensé à passer vous voir avec un peu de café.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270503
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270503,
					"content": "Je dois dire que l'environnement dans lequel vous travaillez est... plutôt difficile. Je pensais que le « bureau » aurait au moins une pièce digne de ce nom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270504
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270504,
					"content": "Cher Iaune, merci pour le café. Quant à mon environnement de travail... J'en suis content. Regardez, j'ai au moins un plafond intact.",
