					"speakerTitle": "Iaune"
				},
				{
					"id": 741270303,
					"content": "Il est académique dans la tête des chercheurs.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270305
					]
				},
				{
					"id": 741270305,
					"content": "Bon, heureusement que je ne suis pas là pour ce genre d'affaires aujourd'hui. En tout cas, ce bâtiment a l'air plutôt... intact.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270306
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270306,
					"content": "Il est seulement intact, rien de plus.",
