			"dialogs": [
				{
					"id": 140340201,
					"content": "C'est ainsi que les monstres sont anéantis et le sorcier vaincu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340202
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Jouée par Clorinde"
				},
				{
					"id": 140340202,
					"content": "La paix règne à nouveau dans la capitale. Les fonctionnaires manipulés par le sorcier commencent à réaliser leurs erreurs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340203
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Jouée par Clorinde"
				},
				{
					"id": 140340203,
					"content": "Certains se souviennent du nom des héros qui ont sauvé leur royaume, tandis que d'autres continuent leurs vies dans une douce ignorance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340204
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Jouée par Clorinde"
				},
				{
					"id": 140340204,
					"content": "Telle est l'histoire des chasseurs de la Maréchaussée. Ils poursuivent les fantômes dans l'obscurité et éliminent tous ceux qui représentent une menace...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340205
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Jouée par Clorinde"
				},
				{
					"id": 140340205,
					"content": "Ils protégeront toujours la ville et ses habitants, même si leurs accomplissements sont oubliés par ceux qu'ils servent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340206
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Jouée par Clorinde"
				},
				{
					"id": 140340206,
					"content": "Je suppose que nous sommes enfin arrivés à la fin du scénario ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340207
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340207,
					"content": "Oui. Vous avez atteint une fin positive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340208
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340208,
					"content": "Dans l'ensemble, c'est un bon scénario. Au début, je pensais qu'il s'agissait d'une histoire d'aventure ordinaire. Mais à mesure que nous progressions, l'intrigue et les moyens investis étaient toujours plus impressionnants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340209
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340209,
					"content": "Surtout la bataille finale ! Tous les effets étaient très réalistes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340210
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340210,
					"content": "Ah oui, c'est vrai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340211
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340211,
					"content": "Oh... C'est juste. Je ne m'attendais pas à ce que les armes que nous avons récupérées dans la salle du trésor aient de tels effets.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340212
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340212,
					"content": "Oui, la mienne m'a vraiment effrayée quand elle a commencé à briller ! Je l'ai bien examinée, mais je ne pense pas qu'elle brillera à nouveau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340213
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340213,
					"content": "Oh, ce sont des accessoires, nous devons donc les rendre ! Je vais laisser la mienne ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340214
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340214,
					"content": "Vous vous êtes bien amusée, Furina ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340215
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340215,
					"content": "Beaucoup, oui. N'oubliez pas de m'appeler la prochaine fois que vous aurez un nouveau scénario de ce genre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340216
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340216,
					"content": "Pas de problème.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340217
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340217,
					"content": "Dans ce cas, je vais rentrer. Je vais repenser aux événements de la journée sur la route.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340218
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340218,
					"content": "Quand Florian se réveillera, transmettez-lui mes salutations. Le pauvre, il a dû tomber de fatigue pour s'endormir ainsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340219
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340219,
					"content": "C'est vrai, ça n'a pas été facile pour lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340220
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340220,
					"content": "Très bien, à la prochaine !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340221
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340221,
					"content": "Bon, est-ce que je peux demander maintenant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340222
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340222,
					"content": "Je pense, oui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340223
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340223,
					"content": "Qu'est-ce qui vient de se passer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340224
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340224,
					"content": "... Vous avez donc remarqué ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340225
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340225,
					"content": "Haha... Dans la grotte, quand vous nous avez dit de fermer les yeux... C'était difficile de ne rien remarquer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340226
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340226,
					"content": "Je mourais d'envie de savoir ! Vous avez prétendu que tout allait bien, et Furina ne s'en est même pas rendu compte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340227
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340227,
					"content": "Aucun d'entre nous ne voulait être la personne qui briserait l'illusion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340228
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340228,
					"content": "Hein ? De quoi parlez-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340229,
						140340231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340229,
					"content": "Qu'est-ce que vous racontez ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140340230
					]
				},
				{
					"id": 140340230,
					"content": "Quoi ?! Ne me dites pas que vous aussi... Oh, désolée, il n'est pas trop tard pour vous boucher les oreilles ! Laissez-moi vous aider !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340233
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340233,
					"content": "Ce... ne serait pas un peu tard pour ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340234
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340234,
					"content": "Vous voulez dire que tout ce qui vient de se passer ne faisait pas partie du scénario ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340235,
					"content": "Il serait probablement plus exact de dire qu'il n'y a jamais vraiment eu de scénario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340236
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340236,
					"content": "Quoi ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340237,
					"content": "Tant de bruit... Ma tête...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340238
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340238,
					"content": "Levez-vous et dites-moi ce qui se passe, tout de suite !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340239,
					"content": "Ah ! Non, arrêtez de me secouer, s'il vous plaît ! Ma tête...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340240
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340240,
					"content": "Florian explique à tout le monde ce qui s'est réellement passé...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						140340241
					]
				},
				{
					"id": 140340241,
					"content": "J'ai bien entendu ? Vous avez improvisé toute la seconde moitié du scénario ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340242,
					"content": "Ce n'est pas bien de mentir aux gens, mais... C'était une très bonne histoire, Florian ! Et Clorinde est une spécialiste de l'improvisation !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340243,
					"content": "Oui, c'est vrai ! C'était comme regarder un magicien improviser un tour de magie spectaculaire après avoir oublié un accessoire important.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340244
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340244,
					"content": "Si j'avais su qu'il y avait quelque chose qui n'allait pas dans le coffre-fort, j'aurais sûrement eu peur et j'aurais filé dans la direction opposée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340245,
					"content": "Tout était sous contrôle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340246
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340246,
					"content": "Avec vous, tout est toujours sous contrôle. Cependant, ce que vous estimez être une situation facile à gérer effraierait la plupart des gens ordinaires.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340247
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340247,
					"content": "J'imagine que j'y suis habituée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340248
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340248,
					"content": "Votre vie doit être remplie de situations inattendues... Je comprends maintenant pourquoi vous êtes si douée pour improviser sur-le-champ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340249
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340249,
					"content": "Quant à vous, Florian...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340250
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340250,
					"content": "... Je ne vais pas chercher à me défendre. Je vais aller me rendre, j'avouerai mes crimes et j'accepterai ma punition.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340251
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340251,
					"content": "Je pense que vous avez déjà été suffisamment puni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340252
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340252,
					"content": "... Quoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340253
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340253,
					"content": "Bien qu'au début, vous ayez été aveuglé par la soif de profit et le désir de gloire, lors de la bataille finale, vous avez prouvé par vos actions que vous êtes un véritable chasseur de la Maréchaussée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340254
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340254,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340255
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340255,
					"content": "Vous serez bien plus utile à la ville en restant à la surface en tant que chasseur de la Maréchaussée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340256
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340256,
					"content": "Mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340257
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340257,
					"content": "Bien entendu, vous devrez quand même rendre les clés et aller vous excuser auprès des deux chasseurs que vous avez lésés. Vous devrez accepter toutes leurs conditions en matière de compensation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340258
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340258,
					"content": "... C'est compris.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340259
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340259,
					"content": "Mais à part ça... Vous avez déjà prouvé votre valeur lors de notre duel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340260
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340260,
					"content": "D'accord... Je ferai ce que vous dites. Je vais tout de suite rendre ces deux clés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340261
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340261,
					"content": "Merci beaucoup. Je ferai de mon mieux pour me montrer digne de la confiance que vous m'avez accordée. Je le jure sur mon nom et mon honneur de chasseur de la Maréchaussée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340262
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340262,
					"content": "À la prochaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340231,
					"content": "Haha, j'ai joué le jeu aussi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140340232
					]
				},
				{
					"id": 140340232,
					"content": "Quoi ? Ne me dites pas que Paimon... Oh, désolée, il n'est pas trop tard pour vous boucher les oreilles ! Paimon, laissez-moi vous aider !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340233
					],
					"speakerTitle": "Navia"
				}
			]
		},
		{
			"id": 1403403,
			"completionStepIds": [
				1403403,
				1403404,
				1403405,
				1403406,
				1403407,
				1403408,
				1403409,
				1403410,
				1403411
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1403403",
							"2"
						],
						"stepId": 1403403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Clorinde"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2525.035,
							469.746,
							4803.685
						],
						"pointId": 340300464
					}
				]
			},
			"dialogs": [
				{
					"id": 140340301,
					"content": "En parlant des chasseurs de la Maréchaussée... Que devrions-nous faire du trésor dans la grotte ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340302
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340302,
					"content": "Le laisser tel que nous l'avons trouvé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340303
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340303,
					"content": "Vraiment ? Vous ne voulez pas que les gens d'aujourd'hui se souviennent d'eux et leur rendent hommage ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340304,
					"content": "Non. Ils savaient ce qu'ils faisaient en choisissant de devenir des chasseurs de la Maréchaussée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340305
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340305,
					"content": "Même moi, je ne souhaite pas que les gens se souviennent de moi comme une chasseuse de la Maréchaussée. Je préfère être reconnue pour la duelliste mandatée que je suis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340306
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340306,
					"content": "C'est une voie très différente de celle empruntée par un magicien, mais j'admire votre décision.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340307
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340307,
					"content": "Attendez, je viens de penser à quelque chose. S'il n'y avait d'effets spéciaux, alors pourquoi nos armes brillaient-elles ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340308,
					"content": "Par le passé, les chasseurs de la Maréchaussée appliquaient des enchantements à leurs armes pour les aider à éliminer les monstres. Ces armes s'illuminent lorsque des monstres se trouvent à proximité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340309
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340309,
					"content": "Oh ! C'est pour ça que nous avons réussi à l'arrêter. Je pensais que les invocations avaient fonctionné.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340310
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340310,
					"content": "Les invocations ont probablement aussi aidé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340311
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340311,
					"content": "Qu'est-ce que ça signifie ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340312
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340312,
					"content": "Je suppose que ce Dévorateur vient de la même époque que les chasseurs de la Maréchaussée que nous avons vus dans cet endroit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340313
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340313,
					"content": "Tous les noms que vous avez cités appartiennent aux chasseurs les plus courageux qui ont autrefois anéanti d'innombrables monstres. Le Dévorateur a clairement réagi lorsqu'ils ont été prononcés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340314
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340314,
					"content": "Je ne pensais pas que des noms pouvaient avoir un tel pouvoir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340315,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340316
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340316,
					"content": "Navia, pendant votre invocation, vous avez dit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340317
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340317,
					"content": "Oui, je pensais ce que j'ai dit ! Enfin, ce sont les mots de mon personnage ! C'est bien que vous ayez entendu, mais ne m'obligez pas à me répéter. C'est gênant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340318
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340318,
					"content": "Merci pour vos aimables paroles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340319
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340319,
					"content": "D'accord, c'est bon. Ne devenez pas sentimentale !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340320
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340320,
					"content": "Euh... Enfin bref ! Je me mets en route, ne traînez pas trop !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
