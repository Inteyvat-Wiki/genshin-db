					"nextDialogs": [
						140340328
					]
				},
				{
					"id": 140340328,
					"content": "Je pense que son sens réside dans le voyage en lui-même et le monde que nous avons contribué à créer. Le temps que j'ai passé avec tout le monde et les choses que nous avons accomplies ensemble sont très précieux, même si personne ne s'en souvient.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140340329
					]
				},
				{
					"id": 140340329,
					"content": "Très bonne réponse, je vais tâcher de m'en souvenir.",
