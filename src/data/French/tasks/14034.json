			"dialogs": [
				{
					"id": 140340101,
					"content": "Finalement, vous atteignez l'égl{RUBY#[D]le sous-sol}ise décrite par Florian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340102
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Jouée par Clorinde"
				},
				{
					"id": 140340102,
					"content": "Vous sentez une aura menaçante dans l'air. Vous avez l'impression que votre ennemi est tout proche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340103
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Jouée par Clorinde"
				},
				{
					"id": 140340103,
					"content": "(C'est étrange... Cette sensation de malaise semble bien réelle... Comment est-ce possible ?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340104
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340104,
					"content": "L'heure de l'affrontement final est venue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340105
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Jouée par Clorinde"
				},
				{
					"id": 140340105,
					"content": "En route, tout le monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340106
					],
					"speakerTitle": "Lyney",
					"speakerSubtitle": "Chasseur de la Maréchaussée"
				},
				{
					"id": 140340106,
					"content": "Florian, attendez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340107
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340107,
					"content": "Qu'est-ce qu'il y a ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340108
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340108,
					"content": "Attendez-nous dehors. Le Dévorateur vous a déjà attaqué une fois, il lui serait donc facile de reprendre le contrôle de votre esprit et de votre corps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340109
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340109,
					"content": "Je ne pense pas que ce soit une bonne idée que vous vous en approchiez aussi près. S'il vous corrompt à nouveau, vous pourriez bien prendre une tout autre forme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340110
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340110,
					"content": "C'est bien pour ça que je dois y aller. Je dois être en première ligne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340111
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340111,
					"content": "Quoi ? Vous voulez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340112
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340112,
					"content": "Oui, je veux le piéger en moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340113
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340113,
					"content": "C'est trop risqué. Dans le pire des cas, je devrai vous tuer. Comprenez-vous à quel point c'est dangereux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340114
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340114,
					"content": "Je comprends, mais dans ce cas, vous aurez une cible claire et visible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340115
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340115,
					"content": "Il lui sera difficile de ne pas saisir l'opportunité de reprendre le contrôle sur un corps qui lui a échappé. De cette façon, vous n'aurez pas à craindre qu'il s'en prenne à l'un de vos amis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340116
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340116,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340117
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340117,
					"content": "Mademoiselle Clorinde, contrairement à moi, vous êtes une chasseuse de la Maréchaussée juste et puissante. C'est à cause de moi que le monstre a été libéré, il est donc normal que j'en assume la responsabilité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340118
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340118,
					"content": "Il faut que... je le fasse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340119
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340119,
					"content": "Considérez ça comme une demande d'affrontement en duel pour défendre mon honneur. Ne retenez pas vos coups, s'il vous plaît.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340120
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340120,
					"content": "... Je comprends.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340121
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340121,
					"content": "Florian, en tant que duelliste mandatée, j'accepte votre demande et vous exprime mon respect.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340122
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340122,
					"content": "... Merci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340123
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340123,
					"content": "Allons-y, il est temps de passer aux choses sérieuses. Le Dévorateur va à nouveau trembler sous les coups de lames des chasseurs de la Maréchaussée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clorinde"
				}
			]
		},
