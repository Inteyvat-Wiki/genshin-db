					"nextDialogs": [
						140340322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340322,
					"content": "Je vais aussi y aller. L'histoire d'aujourd'hui était tout bonnement incroyable. Je pense que je vais passer toute la nuit à la raconter chez moi !",
