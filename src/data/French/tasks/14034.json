						140340326
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340326,
					"content": "#{NICKNAME}... À votre avis, quel est l'intérêt de voyager si votre nom n'est pas connu et que vos actions ne sont pas appréciées par ceux que vous aidez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340327
					],
					"speakerTitle": "Clorinde"
				},
