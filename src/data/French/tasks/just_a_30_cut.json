			"dialogs": [
				{
					"id": 747030101,
					"content": "#Attendez... Ces comptes... Vous ne vous êtes pas {M#trompés}{F#trompées} dans les calculs ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030102
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747030102,
					"content": "Hmm ? Il y a un problème ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747030103,
					"content": "... Vous avez vraiment fait autant de bénéfices ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030104
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747030104,
					"content": "Vous regrettez d'avoir accepté de ne prendre que 30 % ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747030105
					]
				},
				{
					"id": 747030105,
					"content": "Vous me prenez vraiment pour quelqu'un d'aussi mesquin ? Je suis simplement impressionnée de voir à quel point vous avez bien géré cet Océanarium.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030106
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747030106,
					"content": "Je pense que le Festival cinématographique de Fontinalia a aussi sa part du mérite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747030107,
					"content": "Un tel revenu... Même après avoir payé le loyer du Wingalet, il reste encore un bénéfice considérable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030108
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747030108,
					"content": "Vous envisagez une reconversion ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747030109
					]
				},
				{
					"id": 747030109,
					"content": "Pas le moins du monde. Je n'ai aucune illusion concernant mon sens des affaires. Ma passion se trouve dans la construction de machines et l'étude de formules.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030110
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747030110,
					"content": "Cela dit... Voir cet endroit passer d'une pièce sans le moindre poisson à ce qu'il est aujourd'hui... C'est assez incroyable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030111
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747030111,
					"content": "Héhé, on doit aussi vous remercier de nous avoir prêté cet endroit ! Voir un espace qu'on a soi-même aménagé être apprécié par autant de gens, ça fait quand même plaisir, non, Sandrone ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747030112,
					"content": "Hmm. Peut-être un peu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030113
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747030113,
					"content": "Seulement un peu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747030114,
					"content": "C'est parce qu'elle s'est contentée de 30 %...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747030115
					]
				},
				{
					"id": 747030115,
					"content": "Je vous ai dit que ça m'était égal !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sandrone"
				}
			]
		}
	]
