			"dialogs": [
				{
					"id": 750013301,
					"content": "Étrange... Pourquoi les motifs dorés ont disparu, alors qu'il n'y a pas de gravure irisée sous ce pilier ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013302,
					"content": "Cela signifie que cette gravure irisée a été expulsée et qu'elle s'est brisée en morceaux... C'est mauvais. Il va falloir les retrouver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013303
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013303,
					"content": "Où se trouvent-ils ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013304,
					"content": "... Je ne sais pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013305
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013305,
					"content": "Pff...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013306,
					"content": "Bien qu'ils soient dispersés, ces morceaux restent néanmoins sous l'effet d'une restriction de force. Ils ne devraient pas être bien loin, on n'a qu'à chercher un peu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013307
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013307,
					"content": "Yaa, yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013308
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013308,
					"content": "Que se passe-t-il, tu veux aller là-bas ? Pour l'instant, nous avons des choses plus importantes à faire, alors on jouera plus tard, d'accord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013309,
					"content": "Hmm... Yaa ! Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013310
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013310,
					"content": "Tu veux dire que la gravure est là-bas ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750013311
					]
				},
				{
					"id": 750013311,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013312
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013312,
					"content": "Oh, j'ai entendu dire qu'aujourd'hui encore il y avait des sauriens capables de ressentir la force des gravures irisées. Je pensais que ce n'était qu'une rumeur, mais peut-être que c'est vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013313
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013313,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} n'est effectivement pas un tepetlisaure ordinaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013314
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013314,
					"content": "Tu as donc ce genre de talent. Hmph, malgré tout, tu es encore loin de m'égaler en tant que guide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013315,
					"content": "Hmm ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013316,
						750013318
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013316,
					"content": "Paimon est jalouse de toi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750013317
					]
				},
				{
					"id": 750013317,
					"content": "Je ne suis pas jalouse ! Je suis bien plus tolérante et ouverte d'esprit que tu ne le crois ! C'est juste ma façon de complimenter les autres !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013320,
					"content": "Mmh... Hmm ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013321
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013321,
					"content": "*soupir* Il n'a rien compris. Franchement, ce serait mieux s'il était un peu plus intelligent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013322,
					"content": "Il finira par comprendre un jour...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750013323
					]
				},
				{
					"id": 750013323,
					"content": "Oui, les personnes responsables des sauriens au sein du clan disent que cela prend beaucoup de temps pour créer une connexion émotionnelle avec eux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013324
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013324,
					"content": "Le secret, c'est de la patience et une communication constante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013325
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013325,
					"content": "#Exactement. Tout à l'heure, je n'ai pas compris ce que {REALNAME[ID(2)|SHOWHOST(true)]} essayait de nous dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013326,
					"content": "#Pardon, {REALNAME[ID(2)|SHOWHOST(true)]}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013327,
					"content": "Hmm, yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013328
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013328,
					"content": "Tu as répondu vite, cette fois !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013329,
					"content": "D'accord, on te suit vers l'endroit où tu veux aller et on verra s'il y a des motifs dorés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013318,
					"content": "Paimon te fait des compliments !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750013319
					]
				},
				{
					"id": 750013319,
					"content": "C'est vrai, mais ne prends pas la grosse tête...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013320
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}