				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730570501,
					"content": "Nara... Hmm, comment ça s'appelle ça ? Aranakin n'a pas besoin de ça pour dormir, donc ne connaît pas son nom...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570502
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570502,
					"content": "C'est un « lit » et il a l'air neuf... Quelqu'un a déjà dormi dessus ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570503,
					"content": "Héhé, Aranakin fait du rangement... Vous pouvez dormir ici si vous voulez !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakin"
				}
			]
		},
		{
