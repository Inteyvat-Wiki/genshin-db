					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730570901,
					"content": "« ... J'ai réparé l'oud qu'oncle Bakr avait cassé. Ne pleure plus, d'accord ? Si tu es triste, tu peux aller voir Khayyam ou moi... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570902
					],
					"speakerTitle": "Cahier abîmé"
				},
				{
					"id": 730570902,
					"content": "« ... Je suis admise à l'Académie ! Hourra pour moi, hein ? Je ne serai pas la femme d'un guerrier, mon objectif est de devenir la grande sage Siman ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570903
					],
					"speakerTitle": "Cahier abîmé"
				},
				{
					"id": 730570903,
					"content": "« ... Héhé, Irfan le musicien accompli et Khayyam le sage éminent ! Ne m'oubliez pas lorsque nous nous séparerons. Toi en particulier, Khayyam ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570904
					],
					"speakerTitle": "Cahier abîmé"
				},
				{
					"id": 730570904,
					"content": "« ... Au revoir, mon carnet ! Au revoir, Irfan, Siman, mes meilleurs amis ! Que la forêt se souvienne de nos aventures ! J'espère que nous ne nous oublierons pas les uns les autres... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570905
					],
					"speakerTitle": "Cahier abîmé"
				},
				{
					"id": 730570905,
					"content": "(... La suite est décousue et raconte les souvenirs des enfants qu'ils soient tristes ou heureux...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570906
					],
					"speakerTitle": "Cahier abîmé"
				},
				{
					"id": 730570906,
					"content": "« ... Aranakin a disparu, depuis je ne sais combien de temps. Il est temps pour moi de renoncer à mon oud. Je vais être artisan, comme mon père le voulait... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570907
					],
					"speakerTitle": "Cahier abîmé"
				},
				{
					"id": 730570907,
					"content": "(Quelque chose d'autre semble écrit là-dessus, mais ça a été effacé.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570908
					],
					"speakerTitle": "Cahier abîmé"
				},
				{
					"id": 730570908,
					"content": "« ... Si j'ai la chance de pouvoir relire ce carnet dans le futur, si je peux encore rencontrer miraculeusement Aranakin et les autres, s'il vous plaît, rendez-lui cette fleur... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570909
					],
					"speakerTitle": "Cahier abîmé"
				},
				{
					"id": 730570909,
					"content": "Hein ? Quelque chose est tombé du livre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570910,
					"content": "C'est une fleur ? Elle est identique à... celle que nous avons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
