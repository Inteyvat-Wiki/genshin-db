			"dialogs": [
				{
					"id": 730570601,
					"content": "Il y a des feuilles laissées par le nara à l'étage, mais... je ne peux pas les lire, je ne comprends pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570602
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570602,
					"content": "Ce sont... les feuilles sur lesquelles le nara garde ses souvenirs. Il écrivait dessus, et les assemblait. Mais Aranakin ne comprend pas les mots du nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570606
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570606,
					"content": "Tu parles... d'un carnet de notes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570603,
					"content": "Un carnet de notes ? Les naras gardent leurs souvenirs dedans ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570604
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570604,
					"content": "Hum, oui... Est-ce que ça dérange si on monte à l'étage pour voir ce qui y est écrit ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570605,
					"content": "Me déranger ? Pas du tout !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakin"
				}
			]
		},
