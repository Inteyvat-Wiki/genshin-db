			"dialogs": [
				{
					"id": 730570401,
					"content": "C'est la lyre narienne qu'Aranakin a gardée. Mais on n'est pas censé en jouer dans cet état... Elle n'est pas accordée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570402
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570402,
					"content": "(Il s'agit d'un oud ancien qui présente quelques fractures. Il semble avoir été soigneusement réparé et entretenu.)",
					"roleType": "TALK_ROLE_NPC",
