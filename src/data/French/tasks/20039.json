			"dialogs": [
				{
					"id": 200390401,
					"content": "Nous allons fabriquer de l'huile essentielle Électro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390402
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390402,
					"content": "C'est un produit alchimique de base, adapté aux débutants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390403
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390403,
					"content": "Pour cela, il nous faudra un électrocristal et une grenouille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390404
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390404,
					"content": "Ces deux ingrédients se trouvent facilement en dehors de la ville... Pardon ? Vous ne voyez pas de rapport ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390405
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390405,
					"content": "Hahaha ! Bien sûr qu'il y en a un. L'électrocristal pour le côté électrocutant et la grenouille pour le gras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390406
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390406,
					"content": "Après avoir rassemblé les matériaux nécessaires, essayez de fabriquer de l'huile essentielle Électro. Donnez tout ce que vous avez ! Je vous regarde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390407
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390407,
					"content": "Hmm, d'accord.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
