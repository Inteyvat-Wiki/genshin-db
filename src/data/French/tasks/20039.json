			"dialogs": [
				{
					"id": 200390101,
					"content": "Je voudrais en apprendre davantage sur l'alchimie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390102
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390102,
					"content": "Cet art ancien est si fascinant... Pourquoi personne ne l'apprécie ?",
