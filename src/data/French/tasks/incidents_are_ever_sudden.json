			"dialogs": [
				{
					"id": 750791601,
					"content": "N'y touche pas, c'est un prix. Si tu veux savoir de quoi il s'agit, tu peux terminer le parcours d'entraînement préparé par Temach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lamizana"
				}
			]
		},
		{
			"id": 7507917,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_NOT_RECEIVE",
						"rawParams": [
							"7507907",
							"1"
						]
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7507907"
						],
						"stepId": 7507907
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lamizana",
					"Taruka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750791701,
					"content": "Héhé, tu devrais vraiment faire quelque chose pour ton mauvais caractère. J'ai dit ça pour ton propre bien. À ton âge, il est temps de devenir plus raisonnable. Tu devrais m'écouter, c'est dans ton intérêt, même si tu ne te préoccupes pas de ta sœur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791702
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750791702,
					"content": "Raouh, ha raouh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791703
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750791703,
					"content": "Tu vois ? Il est d'accord avec moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791704
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750791704,
					"content": "Je ne pense pas être le plus déraisonnable de nous deux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791705
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750791705,
					"content": "Hé ! Petit insolent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lamizana"
				}
			]
		},
		{
			"id": 7507918,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_NOT_RECEIVE",
						"rawParams": [
							"7507909",
							"1"
						]
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7507909"
						],
						"stepId": 7507909
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paran"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750791801,
					"content": "Désolé, mademoiselle Quilla. Carrewouaf vous a-t-il blessée ? En général, il n'est pas aussi démonstratif avec les gens qu'il ne connaît pas. C'est vraiment étrange.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791802
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750791802,
					"content": "Haha, ce n'est rien. J'ai l'habitude d'interagir avec les animaux. Je suis très contente qu'il soit aussi affectueux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791803
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750791803,
					"content": "Au fait, tu manques beaucoup à Hawka. Lorsqu'il a appris que j'allais bientôt venir ici, il m'a demandé de prendre de tes nouvelles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791804
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750791804,
					"content": "... Oncle Hawka ? Pourquoi se soucierait-il de moi ? Euh, je suis désolé. Nous avons quelques différends, mais rien qui ne vaille la peine d'être mentionné...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paran"
				}
			]
		},
		{
			"id": 7507919,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_STATE_NOT_EQUAL",
						"rawParams": [
							"7507909",
							"3"
						],
						"stepId": 7507909,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lliwa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750791901,
					"content": "C'est vraiment ennuyeux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791902,
						750791905
					],
					"speakerTitle": "Lliwa"
				},
				{
					"id": 750791902,
					"content": "Qu'y a-t-il ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750791903
					]
				},
				{
					"id": 750791903,
					"content": "Eh bien, mon petit frère est beaucoup plus jeune que moi. C'est peut-être parce qu'il est dans ses années rebelles, mais il ne s'entend avec personne...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791904
					],
					"speakerTitle": "Lliwa"
				},
				{
					"id": 750791904,
					"content": "Enfin, je ne ferai qu'ajouter à vos problèmes en vous en parlant. Les choses vont sûrement s'améliorer quand il grandira !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
