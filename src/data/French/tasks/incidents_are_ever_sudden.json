					{
						"sceneId": 3,
						"position": [
							-1789.85,
							134.993,
							9752.751
						],
						"pointId": 9648
					}
				]
			},
			"dialogs": [
				{
					"id": 750790901,
					"content": "Je n'arrive pas à croire qu'on ait réussi à gagner le prix aussi facilement... Si seulement les missions de la Guilde des aventuriers étaient aussi simples !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790902,
					"content": "#{M#Monsieur}{F#Mademoiselle} {NICKNAME}, êtes-vous des {M#aventuriers}{F#aventurières} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790903
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790903,
					"content": "J'ai un Guide de l'aventurier, mais pas Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790904
					]
				},
				{
					"id": 750790904,
					"content": "#Hmph ! Je peux très bien être une aventurière dans l'âme sans quelque chose comme ça. Tout comme je suis aussi douée que {NICKNAME} en matière de vol, même si je n'ai pas de permis de planer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790905,
					"content": "Tu nous demandes ça parce que tu as une mission pour nous ? Attends, ne dis rien, laisse-moi deviner. Il n'y a qu'une seule possibilité...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790906,
					"content": "#Tu as dû voir à quel point {REALNAME[ID(2)|SHOWHOST(true)]} et nous étions proches et tu voudrais connaître notre secret ! C'est ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790907,
					"content": "Yaa ! Yaa yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790908
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750790908,
					"content": "Non, pas du tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790909
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790909,
					"content": "Hein ? Mais Lamizana a clairement dit que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790910,
					"content": "C'est lui qui a un problème. Il est vraiment doué pour convaincre les gens. Même Oberon l'écoute après qu'il lui a donné des biscuits sauriennaurus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790911
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790911,
					"content": "Ha raouh, raouh raouh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790912
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750790912,
					"content": "Arrête d'agir comme si c'était toi qui avais été lésé. Un qucusaure de premier ordre doit suivre un régime strict. En plus, tu es du genre à prendre du poids facilement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790913
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790913,
					"content": "Ce type doit avoir une idée derrière la tête pour flatter ma sœur, Lliwa... Je ne comprends pas pourquoi elle ne se méfie pas du tout de lui et se met à rire quand ils discutent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790914
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790914,
					"content": "Hein ? Il m'avait l'air sympa. Tu es sûr que ce n'est pas parce que tu ne l'apprécies pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790915,
					"content": "Non, ce n'est pas la seule raison. Il est très mystérieux ces derniers temps, mais je ne sais pas ce qu'il cache...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790916
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790916,
					"content": "Les adultes ont toujours beaucoup de choses à faire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790917
					]
				},
				{
					"id": 750790917,
					"content": "Oui, n'a-t-il pas mentionné une course de vol ? Peut-être que c'est pour ça qu'il est occupé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790918
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790918,
					"content": "Il a évoqué l'organisation d'une course de vol...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790919
					]
				},
				{
					"id": 750790919,
					"content": "Mais il ne s'est pas donné beaucoup de mal. C'est Paran qui fait tout le travail et qui court partout avec Carrewouaf récemment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790920
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790920,
					"content": "Il y a aussi ce que je l'ai entendu dire hier ! Il discutait à propos de quelque chose de dangereux avec les gens de l'extérieur. Je n'ai pas osé m'approcher trop près, donc je n'ai pas tout entendu, mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790921
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790921,
					"content": "#J'ai entendu « Soyez à l'heure le jour de la course de vol », « N'allez pas trop loin », « Des vies », « Je paierai l'autre moitié une fois que vous aurez réussi » et «{NON_BREAK_SPACE}Nous discuterons des détails au camp du nord demain soir »...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790922
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790922,
					"content": "Comment se fait-il que tu n'aies entendu que la seconde partie aussi clairement ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790923
					]
				},
				{
					"id": 750790923,
					"content": "C'est grâce à Oberon. Je ne sais pas pourquoi, mais il était très agité. Il voulait aller chez Lamizana, et je n'ai pas réussi à le retenir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790924
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790924,
					"content": "Ha raouh !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790925
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750790925,
					"content": "Ce n'était pas un compliment, gros malin. Quand je suis arrivé pour le rattraper, l'autre personne est partie. Et Lamizana s'est comporté de manière très étrange.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790926
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790926,
					"content": "Il a dû avoir peur que tout soit découvert. C'est pour ça qu'il a utilisé des prétextes pour venir m'embêter aujourd'hui. Il voulait juste me surveiller...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790927
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790927,
					"content": "Tu penses à des choses très complexes pour un enfant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790928
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790928,
					"content": "Je vois. Vous ne croyez pas non plus les paroles d'un enfant, c'est ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790929
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790929,
					"content": "#C'est pourquoi je voulais demander à {M#monsieur}{F#mademoiselle} {NICKNAME} de m'accompagner pour enquêter sur le camp du nord avec moi cette nuit. Juste au cas où il comploterait vraiment quelque chose de dangereux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790930
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790930,
					"content": "#Et il faudra alors l'arrêter ! Avec {M#monsieur}{F#mademoiselle} {NICKNAME} comme témoin, les autres me croiront certainement... Et Lliwa aussi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790931
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790931,
					"content": "#{M#Monsieur}{F#Mademoiselle} {NICKNAME}, si vous pensez que ce ne sont que les sottises d'un enfant et que vous ne voulez pas m'aider, veuillez au moins accepter de remettre un message pour moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790932
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790932,
					"content": "J'ai écrit une lettre expliquant la situation. Si je ne suis pas revenu demain, remettez-la à Lliwa. Je lui confie également Oberon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790933
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790933,
					"content": "Attends une minute ! C'est de plus en plus inquiétant. Ça ne peut pas être vrai... Hmm, mais si ça l'était...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790934
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790934,
					"content": "#{NICKNAME}, nous devrions enquêter là-dessus. Je vais faire des cauchemars si quelque chose lui arrive parce qu'on a refusé de l'aider !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790935
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790935,
					"content": "#Vous allez m'aider ? Hourra ! Allons-y ensemble ce soir, {M#monsieur}{F#mademoiselle} {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790936
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790936,
					"content": "Laisse-nous nous en occuper, tu devrais rester ici.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790937
					]
				},
				{
					"id": 750790937,
					"content": "C'est vrai. Un grand nombre de personnes n'est pas nécessaire pour ce genre d'enquête. Tu devrais rester ici et attendre de nos nouvelles. Tu vois, je suis aussi une aventurière chevronnée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790938
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790938,
					"content": "Eh bien... Vous avez raison. Je vais rester ici et m'occuper d'Oberon. Je dois aussi convaincre Lliwa de garder ses distances avec Lamizana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790939
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790939,
					"content": "Merci pour votre aide, je compte sur vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taruka"
				}
			]
		},
