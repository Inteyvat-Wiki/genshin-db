					{
						"sceneId": 3,
						"position": [
							-1787.074,
							135.002,
							9750.383
						],
						"pointId": 8791
					},
					{
						"sceneId": 3,
						"position": [
							-1789.631,
							134.809,
							9749.671
						],
						"pointId": 8792
