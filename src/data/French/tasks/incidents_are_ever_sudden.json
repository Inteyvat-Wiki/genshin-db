			"dialogs": [
				{
					"id": 750790301,
					"content": "#Bienvenue... Hmm, on dirait qu'au moins {M#l'un}{F#l'une} d'entre vous sait déjà voler. Est-ce {M#ce jeune homme}{F#cette demoiselle} qui veut apprendre à voler ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790302,
						750790304
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750790302,
					"content": "J'ai déjà un permis de planer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790303
					]
				},
				{
					"id": 750790303,
					"content": "Un permis de planer ? Je n'en ai jamais entendu parler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790305
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750790305,
					"content": "Nous prenons très au sérieux les progrès du chevaucheur et du saurien. Votre compagnon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790306
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750790306,
					"content": "Ouh, yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790307
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750790307,
					"content": "... Hmm, on dirait que l'Aérocadémie des pakpakas n'est pas l'endroit idéal pour montrer tes compétences. Ne le prends pas personnellement, ce n'est pas ta faute.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790308
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750790308,
					"content": "Raouh ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790309
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750790309,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} est encore jeune, mais il a beaucoup de potentiel.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790310
					]
				},
				{
					"id": 750790310,
					"content": "Le potentiel de vol d'un tepetlisaure est très loin de celui d'un qucusaure ou d'un iktomisaure !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790311,
					"content": "#Quoi qu'il en soit, {M#jeune homme}{F#jeune fille}, si notre formation en vol vous intéresse, je vous recommande d'essayer notre parcours d'entraînement !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790313
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750790313,
					"content": "Pour chevaucher un qucusaure, vous devez être capable d'esquiver les obstacles et de tourner avec agilité. Vous saurez où vous en êtes après avoir essayé le parcours d'entraînement !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790312
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750790312,
					"content": "Pour tout vous dire, nous avons travaillé très dur pour le promouvoir, préparer les prix et organiser la course. Si vous réussissez, vous pourrez aller demander votre prix à Lamizana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Temach"
				},
				{
					"id": 750790304,
					"content": "Que pouvez-vous m'apprendre ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790305
					]
				}
			]
		},
