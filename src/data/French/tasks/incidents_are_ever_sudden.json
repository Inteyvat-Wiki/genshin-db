			"dialogs": [
				{
					"id": 750790701,
					"content": "En tant que ton aîné et ton grand frère, laisse-moi t'apprendre à t'intégrer et à devenir populaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790702
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750790702,
					"content": "Merci, mais ce ne sera pas nécessaire. D'ailleurs, tu n'es pas mon grand frère...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790703
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790703,
					"content": "Et puis, tu pourrais arrêter de donner des biscuits à Oberon ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790704
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790704,
					"content": "Raouh raouh, ha raouh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790705
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750790705,
					"content": "Espèce de petit ignorant, s'il n'y avait pas ta sœur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790706
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750790706,
					"content": "Excusez-moi, je suis ici pour recevoir mon prix.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790707
					]
				},
				{
					"id": 750790707,
					"content": "Yaa ! Yaa yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790708
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750790708,
					"content": "Oh, c'est un invité rare. On ne voit pas de jeune tepetlisaure tous les jours ici. Et il y a aussi... Eh bien, vos compagnons sont vraiment de toutes les variétés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790709
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750790709,
					"content": "#Variétés ?! {REALNAME[ID(2)|SHOWHOST(true)]} et moi sommes bien plus différents que ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790710,
					"content": "Hmm ? Raouh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790711
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750790711,
					"content": "#Oh ? C'est vrai que nous sommes tous les deux des compagnons de {NICKNAME}, mais nous ne sommes pas tout à fait pareils. Je ne dis pas que l'un est meilleur que l'autre, ne sois pas triste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790712,
					"content": "La vérité blesse davantage quand elle est dite de manière involontaire...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790713
					]
				},
				{
					"id": 750790713,
					"content": "#Tu sais que ce n'est pas ce que je voulais dire, alors n'essaye pas de compliquer les choses. {REALNAME[ID(2)|SHOWHOST(true)]} est notre super compagnon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790714,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}, tu es un super compagnon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790715
					]
				},
				{
					"id": 750790715,
					"content": "Raouh ? Raouh !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790716
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750790716,
					"content": "#Héhé, je savais que {REALNAME[ID(2)|SHOWHOST(true)]} était un petit saurien intelligent qui verrait où je veux en venir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790717,
					"content": "J'envie vraiment votre complicité. Votre tenue vestimentaire montre clairement que vous n'êtes pas d'ici. Cependant, vous avez une confiance et une amitié profondes avec ce tepetlisaure. Quel est votre secret ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790718
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750790718,
					"content": "Pour être honnête, même si Taruka et son qucusaure sont des compagnons, ils ne s'entendent pas très bien. Si vous avez un secret, j'aimerais vraiment qu'il l'apprenne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790719
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750790719,
					"content": "Plutôt que de parler de moi... Où est leur prix ? Ne me dis pas qu'il n'est pas encore prêt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790720
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790720,
					"content": "Bien sûr qu'il est prêt ! Tu es doué pour changer de sujet. Enfin, nous en reparlerons plus tard...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790721
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750790721,
					"content": "Nous organiserons bientôt une course de vol. Si ça vous dit, ne manquez pas cette chance d'y assister et de voir mon incroyable performance ! Je dois y aller maintenant, j'ai d'autres affaires à régler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lamizana"
				}
			]
		},
