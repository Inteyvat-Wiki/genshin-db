			"dialogs": [
				{
					"id": 750876001,
					"content": "Bienvenue à l'Aérocadémie des pakpakas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750876002,
						750876003
					],
					"speakerTitle": "Cisik"
				},
				{
					"id": 750876002,
					"content": "Que faites-vous ici ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750876004
					]
				},
				{
					"id": 750876004,
					"content": "Nous apportons conseils et aide dont tous les cadets ont besoin. Les choses ont beaucoup changé, vous savez. À l'époque, ils ne pouvaient pas espérer autant d'attention de notre part.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750876005
					],
					"speakerTitle": "Cisik"
				},
				{
					"id": 750876005,
					"content": "Mais un jour, un formateur a été un peu... sévère avec ses mots, et le cadet à qui il s'est adressé avait un sacré tempérament... *soupir* Ce n'est pas un souvenir très joyeux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750876006
					],
					"speakerTitle": "Cisik"
				},
				{
					"id": 750876006,
					"content": "Bref, notre politique d'enseignement a été revue depuis. Quelqu'un de souriant ne risque pas de se faire gifler et personne ne déteste les compliments, pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cisik"
				},
				{
					"id": 750876003,
					"content": "Je vais y aller.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750876007
					]
				},
				{
					"id": 750876007,
					"content": "Je vous souhaite une bonne journée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cisik"
				}
			]
		}
	]
