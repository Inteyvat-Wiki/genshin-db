			},
			"dialogs": [
				{
					"id": 740650301,
					"content": "Qu'est-ce qui vous a pris tant de temps ? Nous avons déjà chassé les Aberrants fontemarins.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650302,
					"content": "Ah, ça m'arrive enfin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650303
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650303,
					"content": "De quoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650304,
					"content": "D'arriver sur les lieux quand le travail est déjà terminé ! Je n'ai plus rien à faire maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650305
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650305,
					"content": "C'est pour vous. Merci beaucoup. Je peux dormir sur mes deux oreilles cette nuit !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maupoil"
				}
			]
		}
	]
