			},
			"dialogs": [
				{
					"id": 740650101,
					"content": "#Oh, regardez ! C'est {NICKNAME} et Paimon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650102,
						740650103
					],
					"speakerTitle": "Décembre"
				},
				{
					"id": 740650102,
					"content": "On se connaît ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650104
					]
				},
				{
					"id": 740650104,
					"content": "#Ne soyez pas si {M#froids}{F#froides} avec moi. Je me souviens encore de ce qui s'est passé la dernière fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650105
					],
					"speakerTitle": "Décembre"
				},
				{
					"id": 740650105,
					"content": "Ce qui s'est passé la dernière fois... Ah ! Nous avons encore beaucoup de questions à poser !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650106,
					"content": "Ah oui ? Euh, c'était quand déjà la dernière fois ? J'ai tout oublié !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650107
					],
					"speakerTitle": "Décembre"
				},
				{
					"id": 740650107,
					"content": "Les sages disent qu'au lieu de s'occuper du passé, il vaut mieux prévoir l'avenir. Et si nous parlions de notre future coopération ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650108
					],
					"speakerTitle": "Décembre"
				},
				{
					"id": 740650108,
					"content": "J'ai quelques boulots bien rémunérés, mais personne pour les faire. Ça vous dit d'essayer si vous êtes libres ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650109
					],
					"speakerTitle": "Décembre"
				},
				{
					"id": 740650109,
					"content": "Hmph, ne croyez pas pouvoir nous duper aussi facilement cette fois-ci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650110,
					"content": "Combien vous payez ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650111
					]
				},
				{
					"id": 740650111,
					"content": "Hé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650112,
					"content": "#C'est pour ça que j'aime parler à des gens comme vous, {M#monsieur}{F#mademoiselle} {NICKNAME} ! Vous comprenez tout de suite ce que je veux dire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650113
					],
					"speakerTitle": "Décembre"
				},
				{
					"id": 740650113,
					"content": "Dans ce cas, je vais vous proposer un prix qui va vous satisfaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650114
					],
					"speakerTitle": "Décembre"
				},
				{
					"id": 740650114,
					"content": "Que diriez-vous de 100 coupons de crédit ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650115
					],
					"speakerTitle": "Décembre"
				},
				{
					"id": 740650115,
					"content": "100 ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650116,
					"content": "Oui, on dirait que vous êtes impressionnée par ma générosité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650117,
						740650119
					],
					"speakerTitle": "Décembre"
				},
				{
					"id": 740650117,
					"content": "Ce n'est même pas assez pour acheter un bouchon de fonta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650118
					]
				},
				{
					"id": 740650118,
					"content": "C'est vrai ! Je n'arrive pas à croire que vous ayez osé proposer ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650121,
					"content": "#Je ne suis pas assez généreux ? Ah, les jeunes... Ne soyez pas si {M#ingrats}{F#ingrates}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650122
					],
					"speakerTitle": "Décembre"
				},
				{
					"id": 740650122,
					"content": "Vous devriez savoir qu'il y a des tas de pauvres qui donneraient un bras pour faire un travail facile et rentable comme celui-ci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650123
					],
					"speakerTitle": "Décembre"
				},
				{
					"id": 740650123,
					"content": "Décembre, espèce d'escroc ! Je vous tiens enfin ! La dernière fois, vous étiez aussi en train d'arnaquer les nouveaux venus près de la salle du courrier en leur filant le sale boulot en échange d'une infime partie de la rémunération de la mission...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650124
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650124,
					"content": "#{NICKNAME} et Paimon ? Vous croyez à ses mensonges ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650125,
						740650127
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650125,
					"content": "Bouhouhou... On s'est déjà fait avoir une fois !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650126
					]
				},
				{
					"id": 740650126,
					"content": "*soupir* J'arrive trop tard, on dirait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650130
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650130,
					"content": "Bref, ne croyez pas tout ce qu'il dit. Il escroque les nouveaux de la Forteresse de Méropide ou ceux qui ne connaissent pas les règles. Il y a eu de nombreuses victimes de ses méfaits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650131
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650131,
					"content": "Moi ? Un escroc ? Un peu de respect, s'il vous plaît. Quelle est la différence entre nous ? Les geôliers proposent aussi des coupons de crédit en échange de petits boulots, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650132
					],
					"speakerTitle": "Décembre"
				},
				{
					"id": 740650132,
					"content": "Mais nous n'en gardons pas une partie pour nous-mêmes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650133
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650133,
					"content": "Qu'est-ce que vous insinuez ? Ne m'accusez pas sans preuve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650134
					],
					"speakerTitle": "Décembre"
				},
				{
					"id": 740650134,
					"content": "Oh, vous voulez voir les preuves ? Allons-y. La cellule d'isolement est calme et spacieuse, idéale pour consulter toutes les preuves. Mince, j'ai encore des problèmes à régler dans le Tunnel minier de géode...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650135
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650135,
					"content": "#{NICKNAME} et Paimon, si ça ne vous dérange pas, pourriez-vous m'aider...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650136
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650136,
					"content": "On n'est pas toujours à votre disposition !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650137,
					"content": "#Je suis {M#sûr}{F#sûre} que vous nous paierez bien, alors je m'en charge.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650138
					]
				},
				{
					"id": 740650138,
					"content": "Hé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650139,
					"content": "Haha ! Ne vous en faites pas, ce travail sera payé conformément aux règles. Vous connaissez les prix pratiqués, je ne vous arnaquerai pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650140
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650140,
					"content": "Le problème, c'est qu'il y a des Aberrants fontemarins dans le Tunnel minier de géode... La situation pourrait dégénérer si nous ne faisons rien, alors il faut s'en occuper le plus vite possible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650141
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650141,
					"content": "Je vais d'abord emmener ce type à la cellule d'isolement. Ça va me prendre un peu de temps pour passer le relais à mes collègues... Je vous rejoindrai dès que j'en aurai terminé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650142
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650142,
					"content": "D'accord, mais ne tardez pas trop.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650143,
					"content": "Je vais essayer, mais je ne peux pas accélérer les procédures même si je le voulais. Bref, je m'en remets à vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650127,
					"content": "Mais pas cette fois-ci.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650128
					]
				},
				{
					"id": 740650128,
					"content": "Cette fois-ci ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650129
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650129,
					"content": "Hum... Il s'est passé des choses avant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650119,
					"content": "C'est moi qui vous donnerai 100 coupons de crédit, travaillez pour moi et je récolterai des profits.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650120
					]
				},
				{
					"id": 740650120,
					"content": "Waouh, c'est ce que tu prévoyais de faire ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650103,
					"content": "J'ai un mauvais pressentiment...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650104
					]
				}
			]
		},
		{
