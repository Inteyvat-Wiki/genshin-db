				"points": []
			},
			"dialogs": [
				{
					"id": 200130301,
					"content": "#Merci, {M#voyageur}{F#voyageuse} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130302
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130302,
					"content": "Mon plan était de marcher sur les traces de Stanley, et m'aventurer où il s'était aventuré... Mais il a fallu que je tombe sur ces saletés à peine parti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130303
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130303,
					"content": "Je ne suis pas assez fort pour repousser les monstres. Stanley leur aurait mis une raclée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130304
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130304,
					"content": "Sinon, accompagne-moi ? ... Non, c'est une mauvaise idée. Je ne peux pas laisser quelqu'un d'autre faire mon boulot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130305
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130305,
					"content": "Je vais y aller ! Un petit cadeau pour toi ! J'ai ramassé des rations sur mon chemin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130306
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130306,
					"content": "Enfin, on ne peut pas tout à fait appeler ça des rations, mais c'est mieux que rien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		}
	]
