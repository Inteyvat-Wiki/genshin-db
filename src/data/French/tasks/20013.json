					"Jack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200130201,
					"content": "#Ah, c'était toi, {M#voyageur}{F#voyageuse}. Merci, vraiment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130202
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130202,
					"content": "Ça m'embête de te le demander, mais... Tu pourrais m'aider ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130203
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130203,
					"content": "Cette route bloquée est le dernier obstacle qui se dresse entre ma grande aventure et moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130204
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130204,
					"content": "Tu peux m'aider à la dégager ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130205,
						200130206
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130205,
					"content": "Bien sûr.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200130207
					]
				},
				{
					"id": 200130207,
					"content": "*soupir* Si seulement j'étais comme toi, j'aurais pu devenir un aventurier aguerri en un rien de temps !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130206,
					"content": "#Je suis {M#occupé}{F#occupée}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200130208
					]
				},
				{
					"id": 200130208,
					"content": "Je t'en supplie ! Mon aventure ne peut pas se terminer avant d'avoir commencé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
		{
