			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Batelier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721740101,
					"content": "Proche de la rivière... Les cyprès, l'absinthe et les pierres, tous sont vêtus d'argent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740102,
						721740103
					],
					"speakerTitle": "Batelier"
				},
				{
					"id": 721740102,
					"content": "Excusez-moi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740104
					]
				},
				{
					"id": 721740104,
					"content": "#Oh, qui avons-nous là ? Serait-ce des {M#invités}{F#invitées} ? Est-ce que vous êtes {M#venus}{F#venues} pour embarquer sur le bateau ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740105
					],
					"speakerTitle": "Batelier"
				},
				{
					"id": 721740105,
					"content": "#Aïe aïe aïe, vous avez l'air d'{M#étrangers}{F#étrangères}... Ça n'ira pas... Non, ça n'ira pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740106,
						721740107
					],
					"speakerTitle": "Batelier"
				},
				{
					"id": 721740106,
					"content": "« Ça n'ira pas » ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740108
					]
				},
				{
					"id": 721740108,
					"content": "L'esquif argenté navigue doucement à destination de la lune, mais il n'est pas fait pour vous... Ah, non ! Ne montez pas, vous allez le salir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740109
					],
					"speakerTitle": "Batelier"
				},
				{
					"id": 721740109,
					"content": "Oh là là... Le brouillard a disparu depuis longtemps... Oui, vraiment longtemps ! Qui n'a pas encore embarqué ? La dame du hall doré va être furieuse. Oh oui, très furieuse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740110
					],
					"speakerTitle": "Batelier"
				},
				{
					"id": 721740110,
					"content": "Un bateau ? Où ça ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740111
					]
				},
				{
					"id": 721740111,
					"content": "Haha... C'est l'esquif argenté, fils du soleil et des montagnes. Allez ! Tout le monde doit rentrer à la maison, tout le monde doit revenir, au manoir lunaire que l'or brûle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740112
					],
					"speakerTitle": "Batelier"
				},
				{
					"id": 721740112,
					"content": "Mais malheureusement... certains se sont perdus et n'ont toujours pas embarqué ! La dame, elle va être en colère. Oh, très, très en colère...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740113,
						721740114
					],
					"speakerTitle": "Batelier"
				},
				{
					"id": 721740113,
					"content": "Vous avez besoin d'aide ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740115
					]
				},
				{
					"id": 721740115,
					"content": "Venez tous à bord du bateau, c'est l'heure d'embarquer ! Ne continuez pas à errer, laissez vos regrets derrière vous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Batelier"
				},
				{
					"id": 721740114,
					"content": "Vous m'entendez ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740115
					]
				},
				{
					"id": 721740107,
					"content": "Qu'est-ce que vous racontez ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740108
					]
				},
				{
					"id": 721740103,
					"content": "Qui êtes-vous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740104
					]
				}
			]
		},
