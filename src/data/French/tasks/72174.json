			"dialogs": [
				{
					"id": 721740501,
					"content": "La lune d'argent brille, tout comme les cœurs... Ceux qui gardent les plaines brumeuses ne peuvent plus rester dans les bois... Montez à bord du bateau, oui, montez à bord !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Batelier"
