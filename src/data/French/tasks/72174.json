			"dialogs": [
				{
					"id": 721741001,
					"content": "Tout le monde est là... Tout le monde, sans exception...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721741002
					],
					"speakerTitle": "Batelier"
				},
				{
					"id": 721741002,
					"content": "#Merci, {M#étranger venu}{F#étrangère venue} de loin ! Le moment de larguer les amarres est enfin arrivé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721741003
					],
					"speakerTitle": "Batelier"
				},
				{
					"id": 721741003,
					"content": "À l'autre bout de la rivière... Les chênes, l'absinthe et les pierres, tous sont vêtus d'or...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721741004
					],
					"speakerTitle": "Batelier"
				},
				{
					"id": 721741004,
					"content": "Le paysage est magnifique... aussi loin qu'on puisse voir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Batelier"
				}
			]
		},
