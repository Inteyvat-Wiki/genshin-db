			"dialogs": [
				{
					"id": 200460301,
					"content": "#{M#Voyageur}{F#Voyageuse}, s'il vous plaît, prenez soin d'Anna. Elle ne contrôle plus son enthousiasme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460302
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200460302,
					"content": "Vous ne souhaitez pas qu'elle devienne aventurière ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200460303
					]
				},
				{
					"id": 200460303,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460304
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200460304,
					"content": "Je respecte les souhaits de ma sœur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460305
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200460305,
					"content": "Elle ne s'est pas débarrassée de sa maladie sans peine. Et maintenant, elle a la chance de pouvoir réaliser ses rêves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460306
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200460306,
					"content": "Je suis son frère, donc... je la soutiendrai sans condition.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460307
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200460307,
					"content": "C'est tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		}
	]
