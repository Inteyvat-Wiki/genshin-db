			"dialogs": [
				{
					"id": 706910101,
					"content": "Chevalier honoraire, par ici !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910102
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 706910102,
					"content": "Je me suis fait de nouvelles amies, tu veux jouer avec nous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910103
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 706910103,
					"content": "On nous a appris un nouveau jeu qui s'appelle la « Poursuite de la neige ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910104
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 706910104,
					"content": "Les règles ne sont pas difficiles. C'est juste une sorte de cache-cache très spécial !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910105
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 706910105,
					"content": "Oh ! Klee, Yaoyao et Sayu, vous êtes devenues amies ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706910106,
					"content": "Le nom me fait penser à une sorte de version améliorée de la Poursuite du vent. Héhé, j'ai hâte de jouer avec vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910107,
						706910108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706910107,
					"content": "Un jeu de cache-cache ? J'adore !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706910109
					]
				},
				{
					"id": 706910109,
					"content": "Atchoum... Même s'il ne fait plus aussi froid au campement, j'ai encore un peu sommeil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910110
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 706910110,
					"content": "#Hmm ? Est-ce que mes yeux me jouent des tours, ou est-ce que c'est {NICKNAME} et Paimon...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910111
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 706910111,
					"content": "#Tes yeux fonctionnent sans problème, c'est bien {NICKNAME} et Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910112,
						706910113
					],
					"speakerTitle": "Yaoyao"
				},
				{
					"id": 706910112,
					"content": "Bonjour Yaoyao et Sayu !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706910114
					]
				},
				{
					"id": 706910114,
					"content": "Bonne idée, si on bouge et qu'on s'amuse, on n'aura plus envie de faire la sieste !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910115
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 706910115,
					"content": "La bien trop sérieuse mademoiselle Aoi n'a-t-elle pas dit que passer plus de temps dans les montagnes enneigées serait bénéfique pour tes compétences, Sayu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910116
					],
					"speakerTitle": "Yaoyao"
				},
				{
					"id": 706910116,
					"content": "Oh, je n'arrive pas à croire que tu t'en souviens !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910117
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 706910117,
					"content": "Bon... Si je perds contre mes paires ou même contre ce super ninken... ce sera encore plus difficile de me la couler douce !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910118
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 706910118,
					"content": "On dirait que je vais devoir me retrousser les manches pendant ce voyage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910119
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 706910119,
					"content": "Ne t'inquiète pas, j'ai préparé une nouvelle recette de goulasch. J'ai ajouté du piment de Jueyun et du poivre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910120
					],
					"speakerTitle": "Yaoyao"
				},
				{
					"id": 706910120,
					"content": "Mange un peu avant de jouer, comme ça tu n'auras pas froid pendant la partie de cache-cache.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910121
					],
					"speakerTitle": "Yaoyao"
				},
				{
					"id": 706910121,
					"content": "Super ! Je vais d'abord en manger un bol entier !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910122
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 706910122,
					"content": "Moi aussi ! Moi aussi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706910123,
					"content": "Allons jouer à cache-cache dans les montagnes enneigées !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910124
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 706910124,
					"content": "Héhé ! Toute la montagne est recouverte de neige. C'est la cachette parfaite pour moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706910113,
					"content": "Vous voulez faire une partie de cache-cache ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706910114
					]
				},
				{
					"id": 706910108,
					"content": "J'aimerais beaucoup rencontrer tes nouvelles amies, Klee !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706910109
					]
				}
			]
		}
	]
}