			"dialogs": [
				{
					"id": 220370201,
					"content": "Qu'est-ce qui se passe avec ces champignons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370202,
						220370203
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370202,
					"content": "Je suis là pour vous débarrasser des champignons !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370205
					]
				},
				{
					"id": 220370205,
					"content": "#Avez-vous été {M#envoyé}{F#envoyée} par Vahid pour m'aider avec les champignons ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370206
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370206,
					"content": "Je m'en remets à vous. Il y a bien trop de champignons dans ces champs pour que je les cueille avec mes vieux os.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370207
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370207,
					"content": "Ces champignons poussent si vite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370203,
					"content": "Pardon pour les champignons !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370204
					]
				},
				{
					"id": 220370204,
					"content": "Au moins, c'est pas de ça qu'il manque pour le repas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370205
					],
					"speakerTitle": "Konda Densuke"
				}
			]
		},
		{
			"id": 2203703,
			"completionStepIds": [
				2203703
			],
