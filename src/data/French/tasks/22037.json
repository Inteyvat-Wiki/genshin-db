			"dialogs": [
				{
					"id": 220370301,
					"content": "Vous avez terminé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370302
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370302,
					"content": "Tous les champignons que j'ai cueillis sont ici.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370303
					]
				},
				{
					"id": 220370303,
					"content": "#C'est tout ? J'avais l'impression qu'il y en avait beaucoup plus. Vous êtes {M#sûr}{F#sûre} de pas en avoir oublié ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370304
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370304,
					"content": "#Mais je tiens quand même à vous remercier, {M#jeune homme}{F#jeune femme}. Prenez ceci en guise de rémunération.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370305
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370305,
					"content": "Mais cet engrais est vraiment puissant, il fait pousser les champignons très vite. Si seulement les cultures pouvaient pousser aussi vite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370306
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370306,
					"content": "Quand je serai libre, je vais certainement en racheter et réessayer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Konda Densuke"
				}
			]
		},
