				},
				{
					"id": 220370404,
					"content": "Tous les champignons que j'ai cueillis sont ici.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370405
					]
				},
				{
					"id": 220370405,
					"content": "Il y avait beaucoup de champignons, mais on dirait que vous les avez tous cueillis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370406
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370406,
					"content": "#Merci, {M#jeune homme}{F#jeune femme}. Je ne sais pas ce que j'aurais fait sans votre aide. Prenez ceci en guise de rémunération.",
					"roleType": "TALK_ROLE_NPC",
