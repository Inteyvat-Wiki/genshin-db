			"dialogs": [
				{
					"id": 761910201,
					"content": "Je te l'ai déjà répété plusieurs fois, garde les yeux bien ouverts. C'est de la marchandise de première qualité, spécialement demandée par des clients fidèles de Snezhnograd.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910202
					],
					"speakerTitle": "Alhoma"
				},
				{
					"id": 761910202,
					"content": "Et tu l'abandonnes comme ça ? Tu t'es adouci ? Tu t'es soudainement découvert une conscience ou quoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910203
					],
					"speakerTitle": "Alhoma"
				},
				{
					"id": 761910203,
					"content": "Patron, écoutez, ce n'est vraiment pas ma faute. Ces Brutocollinus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910204
					],
					"speakerTitle": "Yelo"
				},
				{
					"id": 761910204,
					"content": "Les Brutocollinus ? C'est ça ton excuse ? Continue comme ça et tu vas ruiner notre réputation de Pilleurs de trésors !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910205
					],
					"speakerTitle": "Alhoma"
				},
				{
					"id": 761910205,
					"content": "Je n'ai pas pu les gérer, patron. Je n'ai vraiment pas pu ! Le bleu et son ami vert étaient encore plus forts que ces Usuriers...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910206
					],
					"speakerTitle": "Yelo"
				},
				{
					"id": 761910206,
					"content": "(Ces deux-là... Ce sont clairement des contrebandiers.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910207
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910207,
					"content": "... Qui va là ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910208
					],
					"speakerTitle": "Alhoma"
				},
				{
					"id": 761910208,
					"content": "Du calme, Lumi ! Pas encore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910209
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910209,
					"content": "Qu'est-ce que c'est ? Hm... Sacrée trouvaille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910210
					],
					"speakerTitle": "Alhoma"
				},
				{
					"id": 761910210,
					"content": "Hé, tu peux bien te charger d'une gamine, non ? Ça a l'air assez solide. On va l'échanger et en rester là pour aujourd'hui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910211
					],
					"speakerTitle": "Alhoma"
				},
				{
					"id": 761910211,
					"content": "Oui, patron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910212
					],
					"speakerTitle": "Yelo"
				},
				{
					"id": 761910212,
					"content": "Tu oses t'en prendre à Lumi ? C'est à cause de types comme toi que la réputation des Pilleurs de trésors n'est plus que l'ombre d'elle-même...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910213
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910213,
					"content": "« Réputation » et Pilleurs de trésors dans la même phrase ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910214
					],
					"speakerTitle": "Yelo"
				},
				{
					"id": 761910214,
					"content": "Arrête de perdre ton temps avec elle !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alhoma"
				}
			]
		},
