						761910502
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910502,
					"content": "(Le capybara de contrebande n'est pas là... Se pourrait-il que les Brutocollinus aient quelque chose à voir là-dedans ?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910503
					],
					"speakerTitle": "Linnea"
				},
				{
