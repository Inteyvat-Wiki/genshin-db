				]
			},
			"dialogs": [
				{
					"id": 761910301,
					"content": "C'est bel et bien un capybara argenté... Pas de teinture, pas d'effet d'optique. C'est extrêmement rare... Absolument incroyable !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910302
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910302,
					"content": "J'ai cherché dans tout Natlan et je n'ai jamais réussi à en trouver un. On dirait que celui-ci a été capturé par des contrebandiers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910303
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910303,
					"content": "Mais il n'a pas l'air mal en point... Héhé, un capybara argenté ! Je n'aurais jamais imaginé en voir un de mes propres yeux ! J'aimerais juste... Oh, j'aimerais le caresser un peu, pour voir si son pelage argenté a une texture différente de celui des capybaras ordinaires...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910304
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910304,
					"content": "Aïe ! C'est brûlant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910305
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910305,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910306
					],
					"speakerTitle": "Capybara"
				},
				{
					"id": 761910306,
					"content": "Ah, j'ai failli oublier ! Tu es encore dans la marmite !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910307
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910307,
					"content": "Se pourrait-il que tu te sois tellement habitué au phlogistique liquide de Natlan que cette température ne te dérange même plus ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910308
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910308,
					"content": "Quoi qu'il en soit, tu viens avec moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910309
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910309,
					"content": "♪ ~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Capybara"
				}
			]
		},
