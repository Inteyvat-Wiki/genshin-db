			"dialogs": [
				{
					"id": 760710301,
					"content": "Merveilleux, merci ! Avec ce seigle frais, je vais enfin pouvoir faire du pain chaud et réconfortant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
