			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Beryna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760710101,
					"content": "Si je pouvais faire du bon pain, je suis sûre que ça remonterait le moral de tout le monde. Mais vu la situation actuelle, ce n'est pas si facile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710102,
						760710103
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratniki"
				},
				{
					"id": 760710102,
					"content": "Quelque chose ne va pas ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760710105
					]
				},
				{
					"id": 760710105,
					"content": "J'essaie de recréer un type de pain que ma mère me préparait quand j'étais petite. Il ressemblait un peu à un champignon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710106
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratniki"
				},
				{
					"id": 760710106,
					"content": "Si je me souviens bien, il faut d'abord faire cuire les champignons et les baies pour obtenir une garniture épaisse, puis l'envelopper dans une pâte fraîchement pétrie et cuire le tout au four.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710107
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratniki"
				},
				{
					"id": 760710107,
					"content": "Le plus important est d'utiliser de la farine de seigle fraîchement récolté. C'est ce qui donne au pain son goût réconfortant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710108
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratniki"
				},
				{
					"id": 760710108,
					"content": "Je suis venue ici dans l'espoir de récolter du seigle, mais on dirait que personne n'a eu le temps de s'occuper des champs ces derniers temps. Toutes sortes de petites créatures étranges errent dans les environs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710109
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratniki"
				},
				{
					"id": 760710109,
					"content": "Si monsieur Valdis était là, je suis sûre qu'il saurait s'en occuper. Je ne suis vraiment pas douée pour ce genre de choses...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710110
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratniki"
				},
				{
					"id": 760710110,
					"content": "Alors, euh... vous pourriez m'aider à ramasser un peu de seigle ? J'en ai juste besoin d'un tout petit peu. En échange, je peux vous apprendre à faire du pain chaud aux champignons. S'il vous plaît ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratniki"
				},
				{
					"id": 760710103,
					"content": "Au revoir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760710104
					]
				},
				{
					"id": 760710104,
					"content": "Hé, ne partez pas tout de suite. Vous pourriez me donner un coup de main ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710105
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratniki"
				}
			]
		},
