			"dialogs": [
				{
					"id": 240160401,
					"content": "Ouf... Merci pour votre aide. Sans vous, qui sait combien de temps ça m'aurait pris...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160402
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160402,
					"content": "#Cependant, si vous aviez été un peu plus {M#doux}{F#douce} avec le nettoyage, ça aurait été encore mieux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160403,
						240160404
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160403,
					"content": "#{M#Désolé}{F#Désolée}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160405
					]
				},
				{
					"id": 240160405,
					"content": "Ne vous méprenez pas ! Je ne vous blâme pas, vous m'avez vraiment rendu un énorme service.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160406
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160406,
					"content": "Voici pour vous. Merci encore pour votre aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160404,
					"content": "J'irai un peu plus doucement la prochaine fois...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160405
					]
				}
			]
		}
	]
