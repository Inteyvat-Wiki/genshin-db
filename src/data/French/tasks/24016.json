						],
						"pointId": 6694
					}
				]
			},
			"dialogs": [
				{
					"id": 240160101,
					"content": "Ça devrait faire l'affaire... J'espère que ces documents seront utiles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160102
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160102,
					"content": "Vous êtes toujours occupée à organiser les dossiers ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160103
					]
				},
				{
					"id": 240160103,
					"content": "#Oh ! {M#Chercheur aîné}{F#Chercheuse aînée} d'honneur, c'est un plaisir de vous revoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160104
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160104,
					"content": "C'est exact ! Je continue d'organiser les documents et les dossiers selon les instructions de monsieur Raimondo... Mais je vous l'avais déjà dit, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160105
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160105,
					"content": "Mais cet endroit est immense ! C'est beaucoup trop de travail pour une seule personne. Pourquoi n'a-t-il pas désigné quelqu'un pour vous aider ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240160106,
					"content": "L'Institut de recherche a de nombreux dossiers urgents à régler. C'est normal qu'il n'y ait personne pour m'aider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160107
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160107,
					"content": "Au moins, vous êtes la responsable...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160108
					]
				},
				{
					"id": 240160108,
					"content": "Vous voulez dire mon titre de responsable de l'équipe de récupération bibliographique de l'Institut ? *soupir* Ne vous moquez pas de moi, s'il vous plaît...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160109
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160109,
					"content": "De quoi suis-je réellement responsable ? Depuis le début, je n'ai été qu'une simple employée chargée de l'organisation des dossiers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160110
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160110,
					"content": "Après que monsieur Raimondo m'a assignée ici pour organiser les dossiers, j'ai été soudainement informée de mon nouveau titre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160111
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160111,
					"content": "Quelqu'un a dit que c'était l'idée de monsieur Choiseul. Apparemment, il pense que puisque notre travail est si lourd, nous donner de tels titres facilitera l'octroi d'une compensation supplémentaire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160112
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160112,
					"content": "Ah ! Ne le dites à personne d'autre, comment ai-je pu... Comment ai-je pu le dire à voix haute comme ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160113
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160113,
					"content": "Ne vous inquiétez pas, je ne le dirai à personne.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160114
					]
				},
				{
					"id": 240160114,
					"content": "C'est une bonne chose ! Après tout, c'est bien normal que ceux qui font tout le travail soient récompensés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240160115,
					"content": "Mais pourquoi utiliser une méthode aussi détournée ? Ne peuvent-ils pas simplement donner plus de moras aux personnes qui le méritent ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160116,
						240160117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240160116,
					"content": "C'est un procédé normal ici à l'Institut de recherche.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160118
					]
				},
				{
					"id": 240160118,
					"content": "*soupir* Je n'arrive jamais à comprendre ce que pensent messieurs Choiseul et Raimondo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160119
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160119,
					"content": "Mais je dois continuer à travailler, quoi qu'il arrive ! Il y a trop à faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160120
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160120,
					"content": "#{M#Chercheur aîné}{F#Chercheuse aînée} d'honneur, pourriez-vous me donner un coup de main si ça ne vous dérange pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160121,
						240160122
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160121,
					"content": "C'est mon devoir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160124
					]
				},
				{
					"id": 240160124,
					"content": "Dans ce cas, aidez-moi à ranger un peu, s'il vous plaît.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160125
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160125,
					"content": "Pendant le nettoyage, veillez à <color=#00E1FFFF>ne pas toucher les livres et les dossiers à proximité</color>. Ce serait terrible s'ils étaient endommagés...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160126
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160126,
					"content": "Je vous confie ça ! Quant à moi, je vais continuer d'organiser les fichiers ici. *soupir* Je n'avais jamais remarqué qu'il y avait autant de dossiers à l'Institut...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160122,
					"content": "N'oubliez pas de bien insister sur « honneur » dans mon titre !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160123
					]
				},
				{
					"id": 240160123,
					"content": "Haha, comptez sur moi ! Je témoignerai de votre gentillesse et de vos contributions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160124
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160117,
					"content": "Tant que vous recevez l'argent...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160118
					]
				}
			]
		},
