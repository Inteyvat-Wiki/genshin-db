				"points": []
			},
			"dialogs": [
				{
					"id": 240160301,
					"content": "Ouf... Merci pour votre aide. Sans vous, qui sait combien de temps ça m'aurait pris...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160302
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160302,
					"content": "#Pas étonnant que vous soyez {M#le chercheur aîné}{F#la chercheuse aînée} d'honneur. Peu importe ce que vous entreprenez, vous le faites très bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160303,
						240160304
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160303,
					"content": "#J'ai toujours été un peu {M#spécial}{F#spéciale}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160306
					]
				},
				{
					"id": 240160306,
					"content": "Je dois encore vous remercier pour votre aide. Acceptez ceci, s'il vous plaît.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160304,
					"content": "J'ai une certaine expérience dans le nettoyage.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160305
					]
				},
				{
					"id": 240160305,
					"content": "#Hein ? Vous êtes donc vraiment {M#polyvalent}{F#polyvalente} et résolument digne de votre titre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160306
					],
					"speakerTitle": "Chalmet"
				}
			]
		},
