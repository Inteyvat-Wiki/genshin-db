	"talks": [
		{
			"id": 7220501,
			"completionStepIds": [
				7220501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220501",
							"2"
						],
						"stepId": 7220501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kito",
					"Kina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722050101,
					"content": "Ah, j'avais pourtant juré que c'était dans ma poche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050102,
						722050103
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050102,
					"content": "Bonjour.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050104
					]
				},
				{
					"id": 722050104,
					"content": "Ça ne va pas, on avait promis qu'on les donnerait à grand-mère Una...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050105
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050105,
					"content": "Elle est âgée et ne se souvient pas de grand-chose... Récemment, elle radote sur les événements de sa jeunesse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050106
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050106,
					"content": "Les fleurs ceci, les fleurs cela... Elle a même parlé de fleurs d'au-delà de la mer de brouillard, des fleurs qui sont à la fois différentes et très jolies...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050107
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050107,
					"content": "Un jour, j'ai rêvé que le brouillard qui entoure l'île s'était évanoui d'un coup, et de l'autre côté de l'océan se trouvait une grande et magnifique maison qui n'était ni en bois... ni en or...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050108
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050108,
					"content": "Moi aussi, j'en ai rêvé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050109
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050109,
					"content": "Dans ce rêve, j'escaladais de hautes montagnes, puis je grimpais en haut d'un grand arbre pour cueillir plein de belles fleurs que je n'avais jamais vues de ma vie... mais je savais que c'étaient celles dont parlait grand-mère Una...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050110
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050110,
					"content": "Mais les fleurs étaient trop lourdes, alors je suis tombé de l'arbre. Je n'arrêtais pas de tomber... et c'est là que je me suis réveillé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050111
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050111,
					"content": "Ha ! Ça t'apprendra à toujours en vouloir plus. Je t'ai dit qu'on en avait assez, mais tu ne m'as pas écoutée ! Alors je suis tombée de l'arbre avec toi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050112
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050112,
					"content": "Nos poches sont vides maintenant... Comment on va faire pour grand-mère Una...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050103,
					"content": "Besoin d'aide ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050104
					]
				}
			]
		},
		{
			"id": 7220503,
			"completionStepIds": [
				7220512
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220512",
							"2"
						],
						"stepId": 7220512,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kito",
					"Kina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722050301,
					"content": "#Bonjour {NICKNAME} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050302,
						722050303
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050302,
					"content": "Salut !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050304
					]
				},
				{
					"id": 722050304,
					"content": "Merci pour les fleurs ! Mais pour tout te dire, j'ai l'impression que quelque chose cloche dans les environs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050305
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050305,
					"content": "Moi aussi, j'ai cette impression...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050306
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050306,
					"content": "Partout, on rencontre des gens malheureux et personne n'entend quand on leur parle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050307
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050307,
					"content": "Puis quand on cueille une jolie fleur, elle disparaît aussitôt après l'avoir mise dans notre sac...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050308,
						722050309
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050308,
					"content": "C'est parce que...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050310
					]
				},
				{
					"id": 722050310,
					"content": "Vraiment ? Je ne comprends pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050311
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050311,
					"content": "On doit partir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050312
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050312,
					"content": "L'homme en doré a dit la même chose... mais on ne peut pas encore partir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050313
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050313,
					"content": "On doit encore apporter de jolies fleurs à grand-mère Una !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050309,
					"content": "L'heure est venue de partir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050310
					]
				},
				{
					"id": 722050303,
					"content": "Vous avez l'air en forme tous les deux.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050304
					]
				}
			]
		},
		{
			"id": 7220505,
			"completionStepIds": [
				7220513
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220513",
							"2"
						],
						"stepId": 7220513,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kito",
					"Kina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722050501,
					"content": "Comme on se retrouve !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050502
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050502,
					"content": "Bonjour !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050503,
						722050504
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050503,
					"content": "Salut, tous les deux !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050505
					]
				},
				{
					"id": 722050505,
					"content": "Oui, toujours ici ! D'ailleurs, est-ce que tu sais à quoi sert ce gros rocher ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050506
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050506,
					"content": "Kito sait tout ! Et toi, tu sais ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050507,
						722050508
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050507,
					"content": "Aucune idée.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050509
					]
				},
				{
					"id": 722050509,
					"content": "J'ai entendu grand-père Mata dire qu'il s'agissait d'une pierre tombale qui sert à guider les esprits des défunts. Les esprits perdus sont attirés par elle et se réveillent à son emplacement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050510
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050510,
					"content": "Après ça, ils errent sur l'île à la recherche d'une personne qui pourrait réaliser leur vœu. Une fois qu'ils la trouvent... ils ne la lâchent pas jusqu'à ce que leur vœu soit exaucé. Ensuite, le batelier les emmène avec lui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050511
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050511,
					"content": "Certains de ces esprits sont gentils... et d'autres moins. C'est pour ça que ceux qui passent devant ces gros rochers dans la nuit doivent crier leur nom et celui de leur clan à voix haute !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050512
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050512,
					"content": "Ceux qui connaissent leurs ancêtres peuvent être confiants. Une fois qu'ils ont entendu d'où tu viens, ils te laissent tranquille !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050513
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050513,
					"content": "#Le petit problème avec toi, c'est que tu n'as pas de clan... Comme tu es {M#étranger}{F#étrangère}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050514
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050514,
					"content": "#Oh, c'est vrai. Alors, qu'est-ce que peut faire {NICKNAME} {M#s'il}{F#si elle} rencontre un mauvais esprit ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050515
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050515,
					"content": "#Héhé, tu sais quoi ? Tout ira bien parce que je vais {M#le}{F#la} protéger !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050516
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050516,
					"content": "Ouais ! Moi aussi, je vais t'aider à effrayer ces méchants esprits !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050508,
					"content": "À quoi ça sert ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050509
					]
				},
				{
					"id": 722050504,
					"content": "Vous êtes encore ici ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050505
					]
				}
			]
		},
		{
			"id": 7220507,
			"completionStepIds": [
				7220514
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220514",
							"2"
						],
						"stepId": 7220514,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kito",
					"Kina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722050701,
					"content": "#Salut, {NICKNAME}. On se rencontre une fois de plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050702
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050702,
					"content": "Kito n'a pas très envie de parler aujourd'hui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050703,
						722050704
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050703,
					"content": "Quelque chose ne va pas ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050705
					]
				},
				{
					"id": 722050705,
					"content": "Ce n'est rien... Je vais jouer tout seul, ne fais pas attention à moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050706
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050706,
					"content": "#Regarde, {NICKNAME}. Il boude dans son coin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050707,
						722050708
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050707,
					"content": "Que s'est-il passé ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050709
					]
				},
				{
					"id": 722050709,
					"content": "#Allez, Kito. Ne sois pas fâché après {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050710
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050710,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050711
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050711,
					"content": "... Désolé, je n'aurais pas dû me mettre en colère contre toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050712,
						722050713
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050712,
					"content": "Ce n'est rien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050714
					]
				},
				{
					"id": 722050714,
					"content": "L'homme en doré n'arrête pas de nous embêter pour qu'on monte sur son bateau... Il a parlé de nous emmener dans un endroit de la même couleur que ses habits et qu'il n'y avait pas de brouillard là-bas. Je veux rester avec grand-mère Una, moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050715
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050715,
					"content": "Il ne joue pas avec nous et ne raconte jamais rien d'intéressant... Tout ce qu'il fait, c'est venir nous dire de partir ! Il me donne la chair de poule...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050716
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050716,
					"content": "On va partir un jour ou l'autre... mais on a peur que grand-mère Una s'inquiète pour nous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050713,
					"content": "Dis-moi ce qu'il s'est passé au moins ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050714
					]
				},
				{
					"id": 722050708,
					"content": "Je peux aider ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050709
					]
				},
