			"dialogs": [
				{
					"id": 190010101,
					"content": "J'espère vraiment que Barbara va bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010102
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190010102,
					"content": "Qu'est-il arrivé à Barbara ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190010103
					]
				},
				{
					"id": 190010103,
					"content": "Sœur Barbara a dit qu'elle allait ramasser des herbes, mais elle n'est pas encore revenue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010104
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190010104,
					"content": "*soupir* Peut-être devrais-je le signaler à l'Ordre de Favonius...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010105
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190010105,
					"content": "Je peux aller chercher Barbara.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190010106
					]
				},
				{
					"id": 190010106,
					"content": "#Vous ? Eh bien... je suppose qu'en tant que chevalier honoraire, vous seriez {M#un}{F#une} très {M#bon candidat}{F#bonne candidate} pour cette tâche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010107
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190010107,
					"content": "Sans compter que cela m'éviterait la peine de le signaler à l'Ordre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010108
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190010108,
					"content": "Très bien, je vous laisse vous en occuper. Avant son départ, sœur Barbara a dit qu'elle se rendait vers le Territoire des Loups pour ramasser des herbes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010109
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190010109,
					"content": "Vous pourriez commencer par chercher là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "Victoria"
				}
			]
		},
