						210310305
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 210310305,
					"content": "Cette zone n'est pas sûre. Alors...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310306
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 210310306,
					"content": "Je ferai attention.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310307
					]
				},
				{
					"id": 210310307,
					"content": "Très bien. J'ai d'autres choses à régler. À bientôt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiao"
				},
				{
					"id": 210310303,
					"content": "Ces monstres, c'est vous ?",
					"roleType": "TALK_ROLE_PLAYER",
