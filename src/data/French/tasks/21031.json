			},
			"dialogs": [
				{
					"id": 210310101,
					"content": "Argh, il faut que je trouve quelque chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310102
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310102,
					"content": "Qu'y a-t-il ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310103
					]
				},
				{
					"id": 210310103,
					"content": "Ah, c'est vous. *soupir* Je préfère ne pas en parler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310104
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310104,
					"content": "Les affaires vont de mieux en mieux, et on a de plus en plus de clients.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310105
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310105,
					"content": "Il y en a certains qui cherchent un moment paisible en intimité, tandis que d'autres amènent leur famille en voyage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310106
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310106,
					"content": "Que l'activité soit en plein boom, c'est une bonne chose, bien sûr, mais il reste encore de nombreux monstres aux alentours...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310107
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310107,
					"content": "Si jamais un enfant sorti pour jouer ou une personne âgée en balade se retrouvait face à une telle créature...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310108
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310108,
					"content": "Pour éviter qu'un tel accident ne se produise, je dois sortir et chasser les monstres qui se trouvent près de l'auberge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310109
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310109,
					"content": "Mais je ne peux pas tous les chasser à moi tout seul, ils sont tellement nombreux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310110
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310110,
					"content": "#{M#Voyageur}{F#Voyageuse}, est-ce que vous pourriez me donner un coup de main ? Vous serez bien {M#récompensé}{F#récompensée}, je vous assure !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310111,
						210310112
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310111,
					"content": "Laissez-moi faire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310115
					]
				},
				{
					"id": 210310115,
					"content": "Je compte sur vous en tout cas. J'ai remarqué qu'il y avait plusieurs campements avec tout un tas de créatures dangereuses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310116
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310116,
					"content": "En plus, il y a un groupe de monstres qui s'est faufilé jusqu'à l'auberge pour s'installer dans le coin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310117
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310117,
					"content": "Argh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310118
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310118,
					"content": "Vous savez quoi ? Vous pouvez me laisser les plus dangereux. Aidez-moi simplement à éliminer ceux qui sont autour de l'auberge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310119
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310119,
					"content": "On se retrouvera ici une fois qu'on se sera occupés de tous les monstres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310120
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310120,
					"content": "*soupir* Ces monstres sont vraiment un problème...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310112,
					"content": "Vous vous débrouillez plutôt bien pourtant, non ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310113
					]
				},
				{
					"id": 210310113,
					"content": "Moi ? Eh bien... Je vous remercie, mais je fais ce que je peux, c'est tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310114
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310114,
					"content": "Et quand bien même, je ne peux pas tous les affronter tout seul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310115
					],
					"speakerTitle": "Huai'an"
				}
			]
		},
