			"dialogs": [
				{
					"id": 220410301,
					"content": "Avez-vous retrouvé Konbumaru ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410302
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410302,
					"content": "Oui, il est avec nous.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220410303
					]
				},
				{
					"id": 220410303,
					"content": "Hé, mais il s'échappe encore !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410304,
						220410305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220410304,
					"content": "Je vais le rattraper !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220410306
					]
				},
				{
					"id": 220410306,
					"content": "Ce n'est pas la peine de courir après lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410307
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410307,
					"content": "Ce petit est encore en colère contre moi... Je vais lui apprendre une leçon plus tard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410308
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410308,
					"content": "Il est bientôt adulte, mais il n'en fait qu'à sa tête. Que va-t-on faire si son comportement effraie les visiteurs du sanctuaire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410309
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410309,
					"content": "Ah oui, voici une récompense pour votre aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410310
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410310,
					"content": "*soupir* Pourquoi n'est-il pas aussi sage que Meshi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410305,
					"content": "Eh bien, je n'ai jamais...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220410306
					]
				}
