			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huaqing"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10200401,
					"content": "Halte !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200402
					],
					"speakerTitle": "Huaqing"
				},
				{
					"id": 10200402,
					"content": "Qui êtes-vous pour oser pénétrer en ce lieu sacré !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200403,
						10200404
					],
					"speakerTitle": "Huaqing"
				},
				{
					"id": 10200403,
					"content": "« Oser pénétrer » ? On ne fait que passer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200405
					]
				},
				{
					"id": 10200405,
					"content": "Oui, c'est quoi ce charabia !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200406,
					"content": "#Pour information, on est {M#invités}{F#invitées} ! Qu'est-ce que c'est que cette attitude...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200407,
					"content": "À moins que... Attends, ça ne serait quand même pas... Ningguang qui aurait tout manigancé ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200408,
					"content": "Nous inviter à la Chambre de Jade, et poster les Millelithes en chemin pour qu'ils nous arrêtent !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200409,
						10200410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200409,
					"content": "Hum, ça m'étonnerait quand même...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200411
					]
				},
				{
					"id": 10200411,
					"content": "Je... Vous ! C'est un piège, c'est ça ? Vous devriez avoir honte !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200412,
					"content": "Hein ?! On fait juste notre travail de gardes, qu'est-ce qu'il y a de honteux là-dedans ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200413
					],
					"speakerTitle": "Huaqing"
				},
				{
					"id": 10200413,
					"content": "Trêve de bavardages ! Arrêtez les instrus immédiatement !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200414
					],
					"speakerTitle": "Yang"
				},
				{
					"id": 10200414,
					"content": "Les voilà... C'est parti !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200410,
					"content": "On ne leur a pas parlé de l'invitation...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200411
					]
				},
				{
					"id": 10200404,
					"content": "« Lieu sacré » ? ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200405
					]
				}
			]
		},
		{
			"id": 102006,
			"completionStepIds": [
				102006
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102006",
							"2"
						],
						"stepId": 102006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10200601,
					"content": "Qu'est-ce qu'il se passe ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200602
					],
					"speakerTitle": "Huaqing"
				},
				{
					"id": 10200602,
					"content": "Maîtresse Keqing, ces deux étranges personnes sont apparues de nulle part, et trament visiblement quelque chose en rapport avec la baliste de Guizhong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200603
					],
					"speakerTitle": "Huaqing"
				},
				{
					"id": 10200603,
					"content": "Eh ! Qui vous appelez « étranges » ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200604,
					"content": "On ne fait que chercher le chemin menant à la Chambre de Jade.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200605
					]
				},
				{
					"id": 10200605,
					"content": "Ah ? Vous désirez vous rendre à la Chambre de Jade ? Qui êtes-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200606
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200606,
					"content": "#On a été {F#invitées}{M#invités} par l'une des Sept Étoiles en personne ! Et vous, vous êtes qui ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200607,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200608
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200608,
					"content": "Voilà qui tombe à point. Je suis justement « l'une des Sept Étoiles ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200609
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200609,
					"content": "???",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200610,
					"content": "Mon nom est Keqing. Je suis l'Alioth des Sept Étoiles de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200611
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200611,
					"content": "#Je sais qui vous êtes, {M#voyageur}{F#voyageuse}. Vous avez été {M#invité}{F#invitée} par Ningguang, n'est-ce pas ? Je n'imaginais pas vous rencontrer ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200612
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200612,
					"content": "Waouh ! Et moi, je n'aurais jamais imaginé rencontrer quelqu'un de riche et important dans ce coin paumé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200613,
					"content": "La baliste de Guizhong des ruines de l'ancienne cité de Tianheng était hors d'état depuis des années, et pourtant elle a été réparée en une nuit. Je suis venue comprendre ce qu'il s'était passé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200614
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200614,
					"content": "Ces Millelithes ne font que leur travail : monter la garde. Ils ne sont pas là pour arrêter qui que ce soit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200615
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200615,
					"content": "Oh, alors c'était juste un quiproquo ? Hum... Qui aurait pu le deviner ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200616,
					"content": "N'IMPORTE QUI aurait pu le deviner, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200617
					]
				},
				{
					"id": 10200617,
					"content": "Quoi qu'il en soit, qu'un simple mortel soit capable de réparer un mécanisme créé par un Adepte est un vrai mystère, même pour les Sept Étoiles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200618
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200618,
					"content": "Héhé, c'est parce que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200619,
						10200620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200619,
					"content": "(Paimon, chut ! Pas la peine d'en parler.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200621
					]
				},
				{
					"id": 10200621,
					"content": "Hein ?! Euh, ah oui ! Maîtresse euh... Alioth, savez-vous pourquoi la Megrez souhaite nous voir à la Chambre de Jade ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200622,
					"content": "Appelez-moi Keqing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200623
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200623,
					"content": "#Quant à la raison de cette invitation... J'imagine que Ningguang aimerait voir {M#le héros}{F#l'héroïne} qui a sauvé Mondstadt adopter une position plus... neutre, vis-à-vis des Adeptes. Ou tout du moins, ne pas se ranger entièrement de leur côté.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200624
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200624,
					"content": "On n'est du côté de personne ! On a parlé avec les Adeptes, et ils ne souhaitent que protéger Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200625,
					"content": "Ah, tu veux sans doute parler de leur arrogance moralisatrice, je me trompe ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200626
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200626,
					"content": "Hein ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200627
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200627,
					"content": "#Vous êtes {M#mortels}{F#mortelles}, et donc sous leur protection. En aucun cas ils ne vous auraient {M#considérés}{F#considérées} capables de tuer un dieu. Vous ne représentez pas de menace à leurs yeux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200628
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200628,
					"content": "Nul doute qu'ils jugent les efforts de Ningguang – interdire l'accès à la scène du crime, interroger les témoins, chercher le coupable – inutiles. Peut-être même s'imaginent-ils qu'il s'agit d'une manœuvre de distraction...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200629
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200629,
					"content": "Permettez-moi d'être directe : ils nous sous-estiment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200630
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200630,
					"content": "Dit comme ça, en effet...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200631,
					"content": "C'est bien la première fois que je rencontre quelqu'un de Liyue qui ne respecte ni les Archons ni les Adeptes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200632
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200632,
					"content": "Ah... Devrais-je faire preuve de respect à l'égard de leur notion du temps défaillante et de la condescendance dont ils font preuve envers les hommes, raisons pour lesquelles ils n'ont pas encore agi contre les Sept Étoiles ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200633
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200633,
					"content": "Peu importe, je ne devrais pas parler de la sorte. Ce scepticisme ne regarde que moi, après tout. Et Ningguang ne le partage pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200634
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200634,
					"content": "Enfin, je dois bien le reconnaître : les Adeptes ont su faire preuve de modération, cette fois-ci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200635
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200635,
					"content": "Le meurtre du Souverain de la Roche est une situation exceptionnelle en tous points. Qu'ils aient pris le temps de se réunir et de discuter plutôt que de sortir les armes directement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200636
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200636,
					"content": "Voilà qui est agréablement civilisé de leur part.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200637,
						10200638
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200637,
					"content": "Alors la paix reste négociable ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200639
					]
				},
				{
					"id": 10200639,
					"content": "Pour ce qui est de Ningguang... Si elle le pouvait, elle négocierait tout et n'importe quoi. Mais je doute que cela soit applicable ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200640
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200640,
					"content": "Le temps des Adeptes est depuis longtemps révolu. Quel futur pourra avoir Liyue si même les Sept Étoiles refusent d'accepter cette réalité ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200641
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200641,
					"content": "Hum... Un autre avis plutôt osé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200642
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200642,
					"content": "#*soupir* J'imagine qu'il vaut mieux que j'arrête ici. Je n'avais pas l'intention d'en dire autant, croyez-moi. Mais le fait est que vous savez écouter, {M#voyageur}{F#voyageuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200643
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200643,
					"content": "Bien, vous devriez aller à votre rendez-vous, mieux vaut ne pas être en retard. Ningguang a un emploi du temps surchargé jusqu'à l'année prochaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200644
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200644,
					"content": "L'élite des marchands de Liyue considère une invitation à la Chambre de Jade comme le plus grand des honneurs. Tous apportent des cadeaux dans l'espoir d'obtenir les faveurs de Ningguang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200645
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200645,
					"content": "« Les faveurs de Ningguang » ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200646,
						10200647
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200646,
					"content": "Paimon, ce n'est pas le plus important...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200648
					]
				},
				{
					"id": 10200648,
					"content": "Mais... Mais !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200649
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200649,
					"content": "Mais... Ah oui ! Offrir un cadeau lorsqu'on visite quelqu'un fait partie des coutumes de Liyue. On devrait faire de même nous aussi, pour euh... respecter la culture de Liyue !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200650
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200650,
					"content": "Tsss... Tu fais bien preuve de déférence, tout à coup...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200651
					]
				},
				{
					"id": 10200651,
					"content": "Assez parlé. Je vous laisse réfléchir à ce que vous pourriez lui offrir. Laissez-moi vous indiquer comment rejoindre la Chambre de Jade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200652
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200652,
					"content": "Vous n'aviez pas besoin de venir jusqu'aux Monts Tianheng, à vrai dire. Retournez au Port de Liyue, et allez chercher un « guide » au Pavillon Yuehai, et...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200653
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200653,
					"content": "#Puissent nos chemins se croiser à nouveau, {M#voyageur}{F#voyageuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200654
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200654,
					"content": "Eh bien, l'Alioth ne montre peut-être pas beaucoup de respect envers les Archons, mais je la trouve plutôt sympa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200655,
						10200656
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200655,
					"content": "Moi aussi, elle m'a laissé une assez bonne impression.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200657
					]
				},
				{
					"id": 10200657,
					"content": "Bon... Qu'est-ce qu'on va offrir à Ningguang alors ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200658
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200658,
					"content": "Décidément, cette histoire de cadeau te travaille...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200659
					]
				},
				{
					"id": 10200659,
					"content": "Hum... Ah, je sais ! J'ai rêvé d'un dessert super bon hier soir : les <color=#00E1FFFF>Blobs confits</color> !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200660
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200660,
					"content": "J'ai un super pressentiment que ça plaira à quelqu'un de riche et important comme Ningguang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200661
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200661,
					"content": "On n'a qu'à lui en offrir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200662,
						10200664
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200662,
					"content": "Tu as la recette ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200663
					]
				},
				{
					"id": 10200663,
					"content": "Malheureusement non... Mais avec un peu d'efforts on devrait y arriver !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200666
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200666,
					"content": "Allez, viens, on va chercher les ingrédients ! Pas de temps à perdre, la Megrez en personne nous attend !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200664,
					"content": "Comment tu veux faire quelque chose que tu as vu en rêve ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200665
					]
				},
				{
					"id": 10200665,
					"content": "Avec un peu d'effort on arrive à tout !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200666
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200656,
					"content": "Je partage certains de ses points de vue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200657
					]
				},
				{
					"id": 10200647,
					"content": "Paimon, tu as vraiment l'esprit mal placé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200648
					]
				},
				{
					"id": 10200638,
					"content": "Ningguang veut négocier avec les Adeptes, non ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200639
					]
				},
				{
					"id": 10200620,
					"content": "(On a juste bricolé un peu...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200621
					]
				}
			]
		},
		{
			"id": 102007,
			"completionStepIds": [
				102007
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102007",
							"2"
						],
						"stepId": 102007,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10200701,
					"content": "Ah ? On n'arrive que jusqu'ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200702,
					"content": "Si seulement ce champ de vent était plus puissant, on pourrait atteindre le sommet !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200703,
					"content": "Rentrons au Port de Liyue... On demandera aux Millelithes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200704
					]
				},
				{
					"id": 10200704,
					"content": "Hein ? Pourquoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200705,
					"content": "Le moyen de monter là-haut ne doit pas être secret, sinon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200706
					]
				},
				{
					"id": 10200706,
					"content": "Sinon quoi ? Oh, je comprends. Si c'était un secret, Ganyu ne nous aurait pas laissé chercher par nous-mêmes, c'est ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200707,
					"content": "Bon, faisons comme tu dis alors. On pourra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200708,
					"content": "Oh ! Attends ! Regarde en bas, là !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200709,
					"content": "#On est {M#arrivés}{F#arrivées} près de la <color=#00E1FFFF>baliste de Guizhong</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200710,
					"content": "Hum... Ça me donne une idée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200711,
					"content": "Et si on essayait de te tirer jusqu'à la Chambre de Jade avec la baliste ? Qu'est-ce que tu en dis ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200712,
						10200714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200712,
					"content": "Non merci. C'est la mort assurée.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200713
					]
				},
				{
					"id": 10200713,
					"content": "Ah... Dit comme ça, en effet...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200716,
					"content": "Mais si mes souvenirs sont bons, la baliste a une visée grossissante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200717
					]
				},
				{
					"id": 10200717,
					"content": "Oh, c'est vrai !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200718,
					"content": "On devrait pouvoir l'utiliser en effet... Peut-être qu'on arrivera à voir s'il y a un chemin pour grimper là-haut !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200714,
					"content": "Tu veux ma mort, c'est ça ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200715
					]
				},
				{
					"id": 10200715,
					"content": "Ah... J'ai en effet oublié de prendre cet aspect en compte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200716
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}