					"Sakaw"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751270101,
					"content": "#Oh, vous êtes aussi là pour prendre des photos ? De nombreux voyageurs étrangers vous ont déjà {M#précédés}{F#précédées}. Cette île flottante offre une vue magnifique, après tout...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270102
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 751270102,
					"content": "Dommage que je n'avais pas de Daguerréotype avant, j'ai dû demander à un marchand étranger de m'en apporter un.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270103
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 751270103,
					"content": "#Et vous, {M#voyageur}{F#voyageuse} ? Vous avez envie d'une photo ? Mais vous devrez la prendre vous-même, car la photographie n'est pas mon fort...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270104
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 751270104,
					"content": "Bizarre, la brume sur la mer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751270105
					]
				},
				{
					"id": 751270105,
					"content": "#La brume sur la mer ? De quoi parlez-vous, {M#voyageur}{F#voyageuse} ? Il ne peut pas y avoir de brume avec une brise marine aussi forte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270106
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 751270106,
					"content": "Je n'avais jamais vu de brume sur la mer de toute ma vie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270107
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 751270107,
					"content": "J'espère que vous n'avez pas confondu cet endroit avec les zones couvertes de brouillard au pied du Mont Jing Yuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270108
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 751270108,
					"content": "Je pense que oui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751270109
					]
				},
				{
					"id": 751270109,
					"content": "#Héhé, si vous voulez mon avis, je pense que vous êtes tout simplement trop {M#nerveux}{F#nerveuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270110
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 751270110,
					"content": "Vous devriez vous détendre pour une visite de Natlan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sakaw"
				}
			]
		}
	]
