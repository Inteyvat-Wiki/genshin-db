			"dialogs": [
				{
					"id": 761870301,
					"content": "Permettez-moi de vous remercier pour votre invitation au nom de mademoiselle Mamère, mademoiselle Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870302
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870302,
					"content": "Hmmm, cette nourriture est délicieuse. Merci, Sandrone. Vous êtes incroyablement douée en cuisine !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870303
					],
					"speakerTitle": "Mamère"
				},
				{
					"id": 761870303,
					"content": "Je suis contente que vous aimiez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870304
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761870304,
					"content": "Cependant, prototype 4ACV07, il me semble que c'est la première fois que nous nous rencontrons. Comment m'as-tu reconnue ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870305
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761870305,
					"content": "Ouah, c'est la première fois que j'entends quelqu'un appeler Seymour comme ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870306
					],
					"speakerTitle": "Mamère"
				},
				{
					"id": 761870306,
					"content": "Affirmatif. Bien que je sache que vous êtes douce et rayonnante, je ne vous avais jamais vue en personne auparavant, mademoiselle Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870307
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870307,
					"content": "Je peux vous reconnaître parce que votre apparence est identique à celle de ma maîtresse, mademoiselle Mary-Ann Guillotin. Elle est enregistrée de manière permanente dans mon unité de mémoire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870308
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870308,
					"content": "Mademoiselle Mary-Ann m'a parlé de vous. Puisque votre apparence ressemble à la sienne, le raisonnement logique nécessaire pour vous reconnaître est assez simple, mademoiselle Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870309
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870309,
					"content": "#Ah, même les premières créations d'Alain sont impressionnantes. Bien qu'il semble que tu aies bénéficié de quelques améliorations... Je suppose que je devrais t'appeler Seymour maintenant{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870310
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761870310,
					"content": "As-tu été troublé en me voyant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870311
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761870311,
					"content": "Négatif. Ma directive principale est d'accompagner et de protéger mademoiselle Mary-Ann au nom d'Alain Guillotin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870312
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870312,
					"content": "En conséquence, ma connaissance de mademoiselle Mary-Ann est complète. Sur la base d'une analyse logique d'espaces vectoriels de dimension finie, vous et mademoiselle Mary-Ann êtes totalement différentes, mademoiselle Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870313
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870313,
					"content": "Comme la différence entre les feuilles de thé du Vallon Chenyu et le fruit bullé de la Région Beryl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870314
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870314,
					"content": "Sandrone est-elle le thé ou le fruit bullé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870315
					],
					"speakerTitle": "Mamère"
				},
				{
					"id": 761870315,
					"content": "Recherche en cours... Données insuffisantes. Impossible de répondre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870316
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870316,
					"content": "(*soupir*... Je suis contente qu'Alain ait amélioré la conception de son module linguistique avant de me créer.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sandrone"
				}
			]
		},
