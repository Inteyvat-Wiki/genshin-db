			"dialogs": [
				{
					"id": 401460801,
					"content": "Après un certain temps, les affaires de la boutique d'alchimie continuent à se développer. De nouvelles opportunités se présentent aussi...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401460802
					]
				},
				{
					"id": 401460802,
					"content": "Oh, une commerçante étrangère est là. Allons voir.",
