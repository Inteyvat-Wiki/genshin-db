				]
			},
			"dialogs": [
				{
					"id": 401460101,
					"content": "Bonjour ! Je m'appelle Atefeh, je suis une commerçante itinérante de Sumeru. Enchantée de faire votre connaissance !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460102
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460102,
					"content": "Ouah, vous venez de loin ! Notre petite boutique est déjà aussi connue ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460103,
						401460105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401460103,
					"content": "C'est grâce à toi, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460104
					]
				},
				{
					"id": 401460104,
					"content": "Héhé ! Tu as devant toi, la star de la vente !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401460106,
					"content": "Haha ! Je suis bien d'accord. Tout le monde commence à vous connaître. Beaucoup de commerçants ont entendu parler de votre boutique de potions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460107
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460107,
					"content": "Mais la plupart des gens n'osent pas prendre le risque d'acheter ce genre de produit pas très commun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460108
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460108,
					"content": "Je trouve qu'il faut être prêt à saisir sa chance de faire fortune dès qu'elle se présente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460109
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460109,
					"content": "Le grand public ne connaît pas grand-chose au sujet des potions alchimiques pour l'instant, mais vous pourrez vous faire une place sur le marché avec un peu de publicité de votre part. Les moras vont affluer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460110
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460110,
					"content": "Après avoir généré assez de demande, vous pourrez multiplier vos prix de vente par dix... Héhé ! Avec tout cet argent, plus besoin de travailler pour le reste de l'année si vous le vouliez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460111
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460111,
					"content": "Par dix ? Sérieusement ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401460112,
					"content": "Tant qu'il y a de la demande, les gens sont prêts à payer le prix fort. C'est une sorte d'accord entre le consommateur et le vendeur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460113
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460113,
					"content": "Votre façon de raisonner me rappelle une certaine commerçante obsédée par les moras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401460114,
					"content": "Ah, mais vous venez de Sumeru ? Peut-être que vous la connaissez. Elle s'appelle Dori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401460115,
					"content": "Dori ? Le Seigneur Sangemah Bay ? Vous la connaissez vraiment ? C'est une commerçante très influente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460116,
						401460117
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460116,
					"content": "C'est mon amie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460118
					]
				},
				{
					"id": 401460118,
					"content": "Eh bien, je suis impressionnée ! Le Seigneur Sangemah Bay est mon idole ! Son sens des affaires et sa dévotion envers les moras m'inspirent beaucoup !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460119
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460119,
					"content": "J'ai eu la chance de visiter le Palais d'Alcazarzaray un jour. C'était magnifique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460120
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460120,
					"content": "J'espère devenir comme elle un jour, en train de nager dans les moras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460121
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460121,
					"content": "Hum, je crois qu'on l'a perdue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460122,
						401460124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401460122,
					"content": "Bonne chance !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460123
					]
				},
				{
					"id": 401460123,
					"content": "Merci beaucoup !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460126
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460126,
					"content": "Bref, on parlait d'une manière de gagner plein de moras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460127
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460127,
					"content": "En fait, c'est assez simple : vous produisez des potions et je les vendrai pour vous ailleurs en Teyvat !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460128
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460128,
					"content": "Si ça vous va, parlons plus concrètement des types de potions que vous devriez vendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460129,
						401460131
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460129,
					"content": "Consulter la commande de potions...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460130
					]
				},
				{
					"id": 401460130,
					"content": "Mon sens des affaires me dit qu'il y a beaucoup de demande pour ces potions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460131,
					"content": "Plus tard, peut-être...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460132
					]
				},
				{
					"id": 401460132,
					"content": "D'accord, mais ne tardez pas trop ou l'opportunité pourrait s'échapper.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460124,
					"content": "Revenons-en à nos affaires.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460125
					]
				},
				{
					"id": 401460125,
					"content": "Ahem, j'ai eu un moment d'égarement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460126
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460117,
					"content": "Nos chemins se sont croisés plusieurs fois.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460118
					]
				},
				{
					"id": 401460105,
					"content": "Nos efforts portent leurs fruits !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460106
					]
				}
			]
		},
