			"trigger": {
				"objectNames": [
					"Xinghuo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400030401,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030402
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 400030402,
					"content": "Qui êtes-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030403
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 400030403,
					"content": "#Jiayi nous a {M#envoyés}{F#envoyées} à votre recherche, il a dit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030404,
					"content": "Je vois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030405
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 400030405,
					"content": "Nous avons bien eu vent de votre affaire. Une enquête sera ouverte le plus vite possible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030406
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 400030406,
					"content": "J'espère que nos chemins auront la chance de se croiser de nouveau au Port de Liyue. Au revoir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030407
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 400030407,
					"content": "#{NICKNAME}, j'ai l'impression que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030408,
						400030413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030408,
					"content": "Cette menace n'est pas prise au sérieux.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030409
					]
				},
				{
					"id": 400030409,
					"content": "Exactement !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030410,
					"content": "Les Liyuéens ne savent pas la chance qu'ils ont de pouvoir manger une si bonne cuisine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030411,
					"content": "Nous, voyageurs, devons survivre dans la nature en nous nourrissant de toutes sortes de champignons suspects...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030412,
					"content": "Dis donc, le festival est vital pour toi non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030416,
					"content": "Commençons par revenir sur les lieux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030417,
					"content": "Les coupables aiment apparemment retourner sur les lieux de leurs crimes d'après les officiers de patrouille. C'est psychologique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030418,
					"content": "Mais là, le crime n'a même pas encore eu lieu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030419
					]
				},
				{
					"id": 400030419,
					"content": "C'est pourquoi nous n'avons pas de temps à perdre ! Avec tout ce matériel qui traîne, il suffit d'une étincelle pour tout faire flamber !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030413,
					"content": "#Je crois qu'on ferait mieux de se débrouiller {m#tous seuls}{F#toutes seules}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030414
					]
				},
				{
					"id": 400030414,
					"content": "Ouais !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030415,
					"content": "Avec toutes les aventures qu'on a vécues, on a l'expérience qu'il faut pour s'en occuper.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030416
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
