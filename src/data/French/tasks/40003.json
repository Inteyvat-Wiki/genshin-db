			"trigger": {
				"objectNames": [
					"Jiayi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400030201,
					"content": "C'est vous qui m'avez rapporté des événements suspects hier, si je ne me trompe pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030202
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 400030202,
					"content": "Je crains que nous soyons débordés par le festival. Le Bureau des Affaires Civiles ne possède pas suffisamment d'effectifs pour enquêter sur l'activité suspecte que vous nous avez signalée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030203
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 400030203,
					"content": "Pardon ? Vous êtes sérieux ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030204,
					"content": "J'en suis navré, vous avez eu la bonté de nous informer et... Attendez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030205
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 400030205,
					"content": "Je crois qu'une de nos escouades serait en mesure de vous aider. Elle n'a qu'une mission aujourd'hui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030206
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 400030206,
					"content": "Cette escouade est en train de se battre contre des monstres sur les Plaines Guili. Vous pouvez essayer de solliciter leur aide...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
				}
			]
		},
		{
			"id": 4000304,
			"completionStepIds": [
				4000304
