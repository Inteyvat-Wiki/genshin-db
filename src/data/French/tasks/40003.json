					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400030701,
					"content": "Je le savais !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030702,
						400030703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030702,
					"content": "On lui court après ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030704
					]
				},
				{
					"id": 400030704,
					"content": "Attends, il y a encore quelqu'un—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030703,
					"content": "C'est parti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030704
					]
				}
			]
		},
		{
