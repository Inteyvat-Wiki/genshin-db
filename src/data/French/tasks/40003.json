			"dialogs": [
				{
					"id": 400030901,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030902,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030903
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030903,
					"content": "#J'ai l'impression qu'il n'est pas très bavard, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030904,
					"content": "Je dirais que c'est un méchant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030905,
					"content": "Votre méthode de différenciation du bien et du mal est plutôt hasardeuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030906
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030906,
					"content": "Mais vous avez raison, je suis un esprit malveillant. On m'appelle Xiao. Je suis le Gardien Yaksha, pourfendeur de monstres et démons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030907
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030908,
					"content": "Je crois avoir entendu ce mot l'autre jour...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030910
					]
				},
				{
					"id": 400030909,
					"content": "Qu'est-ce qu'un Yaksha ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030910
					]
				},
				{
					"id": 400030907,
					"content": "Un Yaksha ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030908,
						400030909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030910,
					"content": "Euh, je pense que c'est un Adepte. Tu sais, ces esprits qui veillent sur Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030911
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030911,
					"content": "Ils protègent les humains, qui ignorent souvent leur existence, des monstres et des démons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030912,
					"content": "Mais alors, ça veut dire que vous êtes un gentil, contrairement à ce que vous dites !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030913,
					"content": "Pas vraiment... Nous ne faisons pas ça pour le bien de l'humanité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030914
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030914,
					"content": "Hé bah... Tout ce festival a été organisé pour rendre hommage aux héros de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030915,
					"content": "Et un de ces héros, qui est manifestement encore en vie, n'en a rien à faire. C'est du joli !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030916
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030916,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030917
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030917,
					"content": "Monsieur Xiao... Enfin, si c'est comme ça qu'on doit vous appeler... Pourquoi vous n'avez pas arrêté l'homme de tout à l'heure ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030918
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030918,
					"content": "Je suis uniquement venu car j'ai senti une présence maléfique par ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030919
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030919,
					"content": "Lorsqu'une chaîne est brisée au royaume des dieux et des démons, c'est moi qui veille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030920
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030920,
					"content": "#Mais la menace vient cette fois-ci du royaume des hommes ; c'est à toi qu'incombe cette responsabilité, {M#voyageur}{F#voyageuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030921
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030921,
					"content": "J'espère que vous saurez agir fermement quand le temps viendra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030922
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030922,
					"content": "Je ne souhaite pas que ma lance qui a pourfendu tant de démons ne soit souillée par du sang humain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030923
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030923,
					"content": "Qu'est-ce que c'est ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030924
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030925,
					"content": "Tu sais ce que ça représente, Paimon ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030926
					]
				},
				{
					"id": 400030924,
					"content": "C'est un symbole que votre suspect a laissé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030925
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030926,
					"content": "Pas du tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030927
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030927,
					"content": "#Vous allez devoir me montrer comment vous vous en sortez {M#seuls}{F#seules}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030928
					],
					"speakerTitle": "Xiao"
