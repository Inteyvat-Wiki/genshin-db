			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kabayama"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722340101,
					"content": "Alors ? C'est confortable ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340102
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340102,
					"content": "Vous êtes sorti de nulle part, ça m'a fait peur !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340103
					]
				},
				{
					"id": 722340103,
					"content": "Pardon, ce n'était pas mon intention.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340104
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340104,
					"content": "Mon nom est Kabayama. Je suis souvent assis là où vous vous trouvez. C'est très calme, et cela en fait un endroit approprié pour réfléchir aux grandes questions de la vie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340105
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340105,
					"content": "Vous... Vous voulez vous asseoir ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340106
					]
				},
				{
					"id": 722340106,
					"content": "Ah, merci, mais ce n'est pas nécessaire. Au fait, j'ai entendu dire que vous veniez d'ailleurs, c'est vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340107
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340107,
					"content": "Oui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340108
					]
				},
				{
					"id": 722340108,
					"content": "Vous devez donc connaître beaucoup de choses. Je ne me suis jamais aventuré à l'extérieur, bien que j'aie changé de domicile une multitude de fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340109
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340109,
					"content": "Tiens, en parlant de changer de domicile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340110
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340110,
					"content": "Étant donné que j'ai beaucoup déménagé dans ma jeunesse, je ne me suis pas fait beaucoup d'amis. J'ai découvert de magnifiques paysages quand je me déplaçais seul, mais je n'avais personne avec qui partager cela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340111
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340111,
					"content": "Hé, ça serait bien si vous pouviez aller voir ces paysages. Si vous tombez sur ces endroits, prenez le temps de vous asseoir et d'admirer la vue. Puis, si vous pouviez revenir me voir pour en discuter, ça serait encore mieux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340112
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340112,
					"content": "Un de ces endroits se situe en dessous de la Porte de Pierre située à l'endroit le plus élevé des Gorges, un autre dans l'étendue dégagée entourée par les coraux, à côté du Temple de la nuit sans fin. Enfin, le dernier se trouve à côté du grand mur effondré au Cœur du serpent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340113
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340113,
					"content": "J'ai laissé des repères à chacun de ces endroits et placé des lanternes dans les endroits en hauteur pour avoir de la lumière. Vous devriez pouvoir trouver ces lieux facilement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kabayama"
				}
			]
		},
		{
			"id": 7223402,
