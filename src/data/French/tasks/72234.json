			},
			"dialogs": [
				{
					"id": 722340201,
					"content": "Vous voilà de retour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340202
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340202,
					"content": "Vous n'avez toujours pas trouvé tous les endroits ? Quel dommage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340203
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340203,
					"content": "Je vais vous redire où ils se trouvent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340204
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340204,
					"content": "Un de ces endroits se situe en dessous de la Porte de Pierre située à l'endroit le plus élevé des Gorges, un autre dans l'étendue dégagée entourée par les coraux, à côté du Temple de la nuit sans fin. Enfin, le dernier se trouve à côté du grand mur effondré au Cœur du serpent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340205
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340205,
					"content": "J'ai laissé des repères à chacun de ces endroits et placé des lanternes dans les endroits en hauteur pour avoir de la lumière. Vous devriez pouvoir trouver ces lieux facilement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kabayama"
				}
			]
		},
		{
			"id": 7223403,
			"completionStepIds": [
				7223411
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7223411",
							"2"
						],
						"stepId": 7223411,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kabayama"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722340301,
					"content": "Vous êtes de retour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340302
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340302,
					"content": "#Alors ? Êtes-vous {M#allé}{F#allée} à tous les endroits dont je vous ai parlé ? Vous avez vu beaucoup de choses pendant vos voyages, donc j'imagine que de tels endroits doivent être assez ordinaires pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340303,
						722340304
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340303,
					"content": "Je les ai trouvés magnifiques. Ils ont un charme particulier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340305
					]
				},
				{
					"id": 722340305,
					"content": "Hé, quand j'y pense, je n'ai jamais pu partager tout ça avec quelqu'un. Savoir ce que vous en pensez est suffisant pour me satisfaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340306
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340306,
					"content": "Peut-être qu'il y a de bien plus beaux paysages à d'autres endroits. On ne peut pas nier que c'est très sombre ici. Il n'y a pas beaucoup de choix pour ce qui est de la nourriture et on doit se défendre contre les Élémentosaures...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340307
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340307,
					"content": "Mais ça fait longtemps que je vis à cet endroit, j'aurais du mal à m'en séparer. Quand je pense aux paysages que j'ai vus ici, je me sens un peu nostalgique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340308
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340308,
					"content": "Est-ce qu'il vous arrive d'avoir ce sentiment ? Même ce genre d'endroit peut finir par devenir votre maison si vous restez y vivre pendant longtemps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340309,
						722340310
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340309,
					"content": "Un peu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340311
					]
				},
				{
					"id": 722340311,
					"content": "Ah bon ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340312
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340312,
					"content": "En tout cas, merci de m'avoir écouté parler de toutes ces choses futiles. Tenez, ce n'est pas précieux, mais c'est tout ce que j'ai. Prenez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340310,
					"content": "Non, pas vraiment.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340311
					]
				},
				{
					"id": 722340304,
					"content": "Ils n'ont rien d'exceptionnel, j'en ai vu de bien plus beaux.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340305
					]
				}
			]
		}
	]
}