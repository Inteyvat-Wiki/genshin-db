			},
			"dialogs": [
				{
					"id": 4870501,
					"content": "Prince a des sens très développés ! Il s'est déjà enfui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870502,
					"content": "Essayons de nous approcher <color=#00E1FFFF>par-derrière</color>. Nous ferons moins de bruit comme ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870503,
					"content": "C'est ballot de ne pas savoir flotter dans les airs, hein ? Héhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870504,
					"content": "Tu peux toujours essayer de l'appâter avec du <color=#00E1FFFF>poisson</color>. Les chats adorent ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870505,
					"content": "Il y a plein de <color=#00E1FFFF>poissons</color> dans le lac si jamais tu n'en as pas. Maintenant, au boulot !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 48710,
