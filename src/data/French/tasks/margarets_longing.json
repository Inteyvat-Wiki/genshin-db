					"Margaret"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4870301,
					"content": "Prince ! Où étais-tu passé ? Heureusement que tu n'as rien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870302
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4870302,
					"content": "Il était vraiment difficile à trouver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870303,
					"content": "Oh, mon petit Prince ! Maman s'est fait un sang d'encre pour toi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870304
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4870304,
					"content": "Je crois qu'on devrait les laisser...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870305,
					"content": "Et voici tes cordes, Venti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870306,
					"content": "Vous les avez retrouvées ! J'avais complètement perdu espoir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870307
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870307,
					"content": "Pour vous remercier, permettez-moi de vous offrir un concert privé avec des cordes... Ah, Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870308
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870308,
					"content": "Hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870309,
					"content": "ATCHOUM !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870310
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870310,
					"content": "*tousse* Haha... Je crois que mon allergie aux chats commence à faire des siennes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870311
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870311,
					"content": "Maintenant je vois pourquoi tu avais besoin d'aide tout à l'heure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870312,
					"content": "Oui, merci ! Je vais vous laiss— ATCHOUM !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
