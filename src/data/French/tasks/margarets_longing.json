			"dialogs": [
				{
					"id": 4870101,
					"content": "Ce chat était donc à vous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870102
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870102,
					"content": "Venti ! Tu es venu nous aider ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870103,
					"content": "Vous aider pour quoi ? Au contraire, c'est moi qui ai besoin d'aide !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870104
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870104,
					"content": "Ah ? Tu ne parlais pas de Prince avec Margaret ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870105,
					"content": "C'est donc comme ça qu'il s'appelle... Ce chat m'a volé mes <color=#00E1FFFF>cordes en fer astral</color> !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870106
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870106,
					"content": "Même si ça fait plaisir de voir que l'esprit d'initiative cher à Mondstadt vit même à travers ses animaux de compagnie... Il ne manque quand même pas d'air !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870107
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870107,
					"content": "Haha ! Prince est un sacré chenapan, pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870108
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4870108,
					"content": "À qui la faute ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4870109
					]
				},
				{
					"id": 4870109,
					"content": "Vous avez des airs de Barbatos, vous savez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870110,
					"content": "Hahaha ! Je suis flatté par la comparaison ! Bon, retrouvons Prince.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870111
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870111,
					"content": "J'ai un spectacle ce soir, et sans mes cordes de rechange pour ma lyre, ça risque d'être tendu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870112
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870112,
					"content": "Pourquoi un chat te volerait des cordes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870113,
					"content": "Tout le monde sait que les chats aiment les baballes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870114
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4870114,
					"content": "Hein ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870115,
					"content": "Ces cordes ont été fabriquées en fer astral concentré en Anémo. Elles sont assez résistantes, alors je les enroule pour les emporter plus facilement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870116
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870116,
					"content": "C'est une astuce de barde itinérant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870117
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870117,
					"content": "Tes cordes possèdent de l'énergie Anémo, c'est bien ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870118,
					"content": "#Parfait ! {NICKNAME}, c'est l'heure d'utiliser ta <color=#00E1FFFF>vue élémentaire</color> !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870119,
					"content": "On trouvera sans doute des traces !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870122,
					"content": "Merci ! Prince devrait être quelque part sur la place du marché ou dans la zone résidentielle... Vous vous souvenez, je pense. C'est un chat noir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4870121,
					"content": "Avant que je n'oublie, prenez ce <color=#00E1FFFF>poisson</color> avec vous ! Ça vous aidera à le trouver, c'est sa nourriture préférée.",
