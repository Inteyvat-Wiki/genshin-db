			"dialogs": [
				{
					"id": 741910201,
					"content": "Votre Majesté, Votre Majesté ! Est-ce que tout va bien ? Vous avez encore fait un rêve ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910202
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910202,
					"content": "Tout ce bruit... Qu'est-ce qui s'est passé ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910203
					]
				},
				{
					"id": 741910203,
					"content": "Les citoyens sont rassemblés dans le hall et semblent avoir quelque chose à vous demander.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910204
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910204,
					"content": "Ces derniers temps, la mélodie de la phobos a été interrompue plusieurs fois et ils s'en inquiètent beaucoup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910205
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910205,
					"content": "Je n'ai pas d'autre choix que de faire cela...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910206
					]
				},
				{
					"id": 741910206,
					"content": "Je vous fais confiance. J'ai entendu parler des événements récents... Y a-t-il un problème avec la phobos ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910207
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910207,
					"content": "La phobos a tracé un chemin pour chacun afin de nous conduire vers le bonheur. En s'appuyant sur la puissance de calcul quasi infinie de Sybilla, il ne devrait y avoir aucun problème...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910208
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910208,
					"content": "Mais j'ai entendu des lamentations dans la musique.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910209
					]
				},
				{
					"id": 741910209,
					"content": "Quelqu'un aurait-il modifié la partition de la phobos ? Non, personne ne pourrait le faire, à l'exception de moi-même et des autres accordeurs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910210
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910210,
					"content": "Se pourrait-il que la prophétesse nous ait caché quelque chose...? Impossible, elle a consacré tout son être à la cause et sa prophétie a été confirmée par la mère des eaux. Elle n'aurait jamais de motivations égoïstes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910211
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910211,
					"content": "C'est peut-être parce qu'elle n'a aucune motivation égoïste...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910212
					]
				},
				{
					"id": 741910212,
					"content": "De nos jours, tout le monde compte sur le jugement et les décisions de la phobos. S'il y a un problème, ce serait le chaos au sein du peuple...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910213,
						741910214
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910213,
					"content": "J'ai besoin que vous vous rendiez à l'endroit où se trouvent ces gens aveuglés par leur foi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910215
					]
				},
				{
					"id": 741910215,
					"content": "Vous voulez donc séparer ma mélodie de la grande symphonie en cas d'incident ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910216
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910216,
					"content": "Non, il est encore trop tôt. Je crains que mon âme ne soit pas capable d'accepter un si grand destin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910217,
						741910218
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910217,
					"content": "Je vous fais confiance.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910219
					]
				},
				{
					"id": 741910219,
					"content": "... Je comprends, je m'y suis résolu. Si c'est votre souhait, je suis prêt à le réaliser pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910220,
						741910221
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910220,
					"content": "Ouranopolis, la ville du futur...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910222
					]
				},
				{
					"id": 741910222,
					"content": "Après le départ de ████, vous traversez un couloir doré et des voix discordantes se rapprochent de plus en plus.\\nCe n'est que lorsque vous montez sur le podium central du hall principal que les environs deviennent légèrement plus calmes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910223
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910223,
					"content": "Ô illustre sébaste, montrez-nous la voie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910224
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910224,
					"content": "Récemment, nombreux sont ceux qui n'arrivent plus à entendre la mélodie de la phobos. Notre peuple est effrayé et confus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910225
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910225,
					"content": "Notre plan grandiose avançait comme prévu : les barbares qui se cachaient dans l'ombre ont été éliminés un à un, et nous avons également assaini les eaux impures avec de l'essence d'ichor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910226
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910226,
					"content": "Cependant, vous avez l'intention d'arrêter cette noble guerre sans aucune raison. Pourquoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910227
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910227,
					"content": "J'ai ma propre opinion sur cette affaire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910228
					]
				},
				{
					"id": 741910228,
					"content": "Illustre sébaste, je n'ai pas l'intention de défier votre autorité, mais je pense que vous faites preuve de suffisamment de clémence envers ces barbares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910229
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910229,
					"content": "Nous avons apporté une harmonie glorieuse à cette terre. Les portes de Remuria sont ouvertes à tous ceux qui souhaitent rejoindre notre ordre doré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910230
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910230,
					"content": "Mais qu'ont fait ces barbares ? Ils ont détruit nos tours et massacré nos musiciens. Leurs âmes impures sont indignes de tout salut !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910231
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910231,
					"content": "Nous nettoyons les terres barbares par le sang. L'ordre et la civilisation s'épanouiront après leur destruction. C'est un très grand cadeau que nous faisons à ces ignorants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910232
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910232,
					"content": "Ce n'est pas ce que je veux...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910233
					]
				},
				{
					"id": 741910233,
					"content": "Sous les rayons du soleil, il ne devrait pas y avoir d'ombre. N'est-ce pas aussi votre grand idéal ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910234
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910234,
					"content": "Je pense que c'est le souhait de tous les citoyens de Remuria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910235
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910235,
					"content": "Sébaste, donnez-moi l'ordre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910221,
					"content": "Nous nous ferons connaître sous ce nouveau nom.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910222
					]
				},
				{
					"id": 741910218,
					"content": "Mais à partir de maintenant, vous ne serez plus « l'un d'entre nous »...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910219
					]
				},
				{
					"id": 741910214,
					"content": "Je vous accorde donc le libre-arbitre pour cette raison.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910215
					]
				}
			]
		}
	]
}