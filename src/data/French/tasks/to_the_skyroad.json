			"dialogs": [
				{
					"id": 751350101,
					"content": "C'est l'autel ? Il a l'air difficile à atteindre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751350102,
					"content": "#Nous pouvons voler, mais qu'en est-il de {REALNAME[ID(2)|SHOWHOST(true)]} et Bona ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751350103,
					"content": "Avez-vous oublié que je suis une aventurière du Clan des fleurplumes ? J'ai beaucoup d'expérience en matière de vol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350104
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751350104,
					"content": "#Je peux facilement voler vers là-bas, même avec {REALNAME[ID(2)|SHOWHOST(true)]}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350105
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751350105,
					"content": "J'ai aussi un permis de vol.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751350106
					]
				},
				{
					"id": 751350106,
					"content": "Tout ira bien. Je vous montrerai le chemin, alors il suffira de me suivre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350107
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751350107,
					"content": "On fait la course ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751350108
					]
				},
				{
					"id": 751350108,
					"content": "Ce n'est pas le moment ! Je vous montrerai le chemin, alors il suffira de me suivre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350109
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751350109,
					"content": "#J'ai l'impression que ça pourrait devenir super dangereux. On ne peut pas savoir ce qui pourrait arriver, alors accroche-toi bien, {REALNAME[ID(2)|SHOWHOST(true)]} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751350110,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				}
			]
		},
