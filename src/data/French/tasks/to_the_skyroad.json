			"dialogs": [
				{
					"id": 751350201,
					"content": "Hé, Bona ! Vous volez trop vite ! On n'arrive pas à suivre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751350202,
					"content": "Haha, désolée ! Je n'ai pas pu m'en empêcher en voyant l'Autel du feu primaire juste devant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350203
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751350203,
					"content": "Il suffit donc d'accéder au Tonatiuh grâce à cet autel ? Mais même si un énorme courant d'air nous élevait dans les airs, qui sait combien de temps il faudrait voler avant d'arriver là-bas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751350204,
					"content": "Ugh, ça m'inquiète rien que d'y penser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350205,
						751350207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751350205,
					"content": "N'aie pas peur, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751350206
					]
				},
				{
					"id": 751350206,
					"content": "D'accord, mais ne t'éloignes pas trop de moi, d'accord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751350209,
					"content": "Bref, allons faire offrande de la pyrophosphorite à l'autel. Ah, on en a deux morceaux alors... Mettons-les tous les deux, juste au cas où.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bona"
				},
				{
					"id": 751350207,
					"content": "Ouah, trop génial !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751350208
					]
				},
				{
					"id": 751350208,
					"content": "Pas vrai ? Moi aussi, j'adore. Aucun aventurier ne voudrait rater un tel défi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350209
					],
					"speakerTitle": "Bona"
				}
			]
		}
