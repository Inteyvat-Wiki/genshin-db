	"talks": [
		{
			"id": 4142201,
			"completionStepIds": [
				4142201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4142201",
							"2"
						],
						"stepId": 4142201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 414220101,
					"content": "J'ai tout expliqué à Rhodeia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220102
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220102,
					"content": "C'est l'une des Océanides les plus puissantes parmi nous. Mais elle a décidé de quitter Fontaine parce qu'elle tenait trop à l'ancien Archon Hydro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220103
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220103,
					"content": "Il m'est impossible à moi aussi de retourner à Fontaine. Laissez-moi tout vous expliquer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220104
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220104,
					"content": "Nous sommes des Océanides. Autrefois, nous étions les oreilles et les yeux de l'Archon Hydro, vivant dans les cours d'eau et les ruisseaux serpentant dans les terres de Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220105
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220105,
					"content": "Ah ! Encore une manigance d'un Archon, je le sens !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414220106,
					"content": "L'Archon Hydro d'alors n'avait aucune mauvaise intention. Elle voulait juste surveiller son territoire, et lier ses sujets entre eux. Mais à sa mort, le lien qui unissait beaucoup d'Océanides à Fontaine s'est brisé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220107
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220107,
					"content": "Rhodeia, qui est une des fées de source les plus puissantes, n'a pas accepté le nouvel Archon Hydro. Elle a préféré s'enfermer dans ses rêves d'autrefois. Et moi, je cherchais juste un endroit avec des eaux tranquilles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220108
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220108,
					"content": "Mais elle m'a sentie, et a cru que j'étais envoyée par Fontaine pour la tuer. C'est pour cette raison qu'elle a changé l'eau, pour me détruire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220109
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220109,
					"content": "Mais tu étais tellement petite et fragile quand on t'a rencontrée. Avait-elle vraiment besoin de faire tout ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414220110,
					"content": "L'esprit dominant d'une Océanide peut être très facilement brisé s'il entre en contact avec un esprit maléfique, aussi petit soit-il.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220111
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220111,
					"content": "Je voulais fusionner avec Rhodeia, j'en avais très envie ; c'est pour ça que j'ai utilisé les Hydroblobs pour voyager entre les cours d'eau depuis Fontaine et arriver jusqu'ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220112
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220112,
					"content": "Devant tant de détermination, Rhodeia s'est imaginée que je l'avais prise en chasse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220113
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220113,
					"content": "C'est vrai que c'est plutôt impressionnant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414220114,
					"content": "#C'est un peu comme moi avec {NICKNAME}, qui a l'amabilité de me transporter à travers les Sept Nations. Tant de chemin parcouru !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414220115,
					"content": "Arrête avec ça, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414220116
					]
				},
				{
					"id": 414220116,
					"content": "Je lui ai tout expliqué. L'eau devrait retrouver son goût normal. Et elle m'a demandé si je voulais fusionner avec l'eau de Qingce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220117
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220117,
					"content": "Oh, alors tu viens nous dire au revoir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414220118,
					"content": "J'ai encore un message à transmettre. Accompagnez-moi à nouveau à Deauclaire, s'il vous plaît.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Endora"
				}
			]
		},
		{
			"id": 4142202,
			"completionStepIds": [
				4142202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4142202",
							"2"
						],
						"stepId": 4142202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Finch"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414220201,
					"content": "Finch, Finch !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220202
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220202,
					"content": "Oh là, doucement, tu m'as fait peur !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220203
					],
					"speakerTitle": "Finch"
				},
				{
					"id": 414220203,
					"content": "Normal d'avoir peur. Endora apprend à une vitesse impressionnante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414220204,
					"content": "Non, c'est juste que... d'entendre mon nom comme ça, j'ai cru que c'était elle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220205
					],
					"speakerTitle": "Finch"
				},
				{
					"id": 414220205,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414220206,
					"content": "« À chaque petit pas qu'un enfant fait, c'est un voyage dans le monde où il est embarqué. Des bribes de savoir partagées, dont l'enfant sera imprégné... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220207
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220207,
					"content": "« Jour après jour, l'enfant sera plus âgé. Petit à petit, une vie se crée. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220208
					],
					"speakerTitle": "Finch"
				},
				{
					"id": 414220208,
					"content": "Je connais ce poème.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220209
					],
					"speakerTitle": "Finch"
				},
				{
					"id": 414220209,
					"content": "Notre existence diffère beaucoup de la vôtre. C'est peut-être pour ça qu'il nous est si difficile de nous comprendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220210
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220210,
					"content": "Mais nos vies sont les mêmes. Tous, nous suivons les méandres de la vie qui s'écoule vers l'océan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220211
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220211,
					"content": "C'est pour ça qu'elle m'a dit cela : « Quand toutes les étoiles disparaissent dans la nuit, tous les rêves, tous les fleuves, rejoignent le même océan. C'est à ce moment qu'enfin, nous nous reverrons. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220212
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220212,
					"content": "... Oh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220213
					],
					"speakerTitle": "Finch"
				},
				{
					"id": 414220213,
					"content": "Le fleuve de la vie continue à couler. Marche à grands pas, et ne t'arrête pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220214
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220214,
					"content": "Hahaha, c'est bien elle, en effet. Encore à me parler comme à un petit garçon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220215
					],
					"speakerTitle": "Finch"
				},
				{
					"id": 414220215,
					"content": "Bien, j'aimerais être un peu seul, maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220216
					],
					"speakerTitle": "Finch"
				},
				{
					"id": 414220216,
					"content": "#{NICKNAME}, rentrons donc voir Connor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4142203,
			"completionStepIds": [
				4142203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4142203",
							"2"
						],
						"stepId": 4142203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Connor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414220301,
					"content": "Ah, vous voilà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220302
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 414220302,
					"content": "J'étais en train de me dire qu'avec vous, tout serait résolu rondement, pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220303,
						414220304
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 414220303,
					"content": "Bien sûr.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414220305
					]
				},
				{
					"id": 414220305,
					"content": "L'eau devrait revenir à la normale d'ici quelques jours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414220306,
					"content": "Ah, je vois, je vois. Le problème est résolu, mais il faut un peu de temps pour que l'eau retrouve son état originel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220307
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 414220307,
					"content": "Bon, je vais contacter la Guilde des aventuriers pour leur dire que l'affaire est résolue. Merci vraiment à vous deux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Connor"
				},
				{
					"id": 414220304,
					"content": "Même si ça n'aura pas été simple...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414220305
					]
				}
			]
		},
		{
			"id": 4142204,
			"completionStepIds": [
				4142204
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4142204",
							"2"
						],
						"stepId": 4142204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 414220401,
					"content": "Mon espèce a pour habitude de fusionner pour montrer son amour. De cette manière, plusieurs consciences peuvent se comprendre sans aucun obstacle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220402
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220402,
					"content": "Mais comprendre les autres espèces du monde nous est difficile. C'est pour ça que nous observons, étudions et copions l'apparence des animaux. Ou pour le dire autrement : leur apparence devient partie de nous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220403
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220403,
					"content": "On dirait que regarder le fleuve de la vie s'écouler a fait naître des pensées profondes chez Endora, pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414220404,
					"content": "Je n'avais jamais réfléchi avant à ma vie future. J'ai toujours cru que fusionner avec Rhodeia... suffirait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220405
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220405,
					"content": "Mais Rhodeia n'a pas l'air heureuse, et elle comprend qu'elle ne fait qu'attendre que l'eau devienne mauvaise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220406,
						414220407
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220406,
					"content": "Que comptes-tu faire ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414220408
					]
				},
				{
					"id": 414220408,
					"content": "Je crois que ni Rhodeia ni l'esprit de Deauclaire ne veulent que je suive leur chemin. Mais elles détestent sûrement plus encore l'idée de vivre à Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220409
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220409,
					"content": "Vos existences sont vraiment trop bizarres, difficile de te donner un conseil. Mais pour moi, c'est quand même mieux de vivre heureux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414220410,
					"content": "J'ai décidé de suivre un chemin qui n'appartient à personne d'autre. Vous accompagner m'a emplie de joie ; je veux être heureuse comme ça tous les jours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220411
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220411,
					"content": "Je veux voyager avec vous. Je veux voir les fleurs des montagnes et les nuages dans le ciel avant de voir le fleuve de la vie se jeter dans l'océan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220412,
						414220413
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220412,
					"content": "Tu es la bienvenue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414220415
					]
				},
				{
					"id": 414220415,
					"content": "#{NICKNAME}... Cela signifie-t-il que la position de compagnon de voyage transcontinental n'est plus mon exclusivité ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414220413,
					"content": "Tu pourrais prendre la place de Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414220414
					]
				},
				{
					"id": 414220414,
					"content": "Hé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220415
					],
					"speakerTitle": "Paimon"
				},
