			"dialogs": [
				{
					"id": 706560101,
					"content": "#Bienvenue ! Êtes-vous {M#venu}{F#venue} ici pour défier le donjon ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560102,
						706560103
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 706560102,
					"content": "#Je suis un peu {M#intrigué}{F#intriguée}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706560104
					]
				},
				{
					"id": 706560104,
					"content": "Parfait ! Permettez-moi de faire les présentations. Je suis Plauen, membre de la Guilde des aventuriers. Je suis en charge de protéger l'entrée du donjon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560105
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 706560105,
					"content": "Selon les archives de la Guilde, ce donjon n'apparaît qu'à certains moments.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560106
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 706560106,
					"content": "Nous avons modifié un peu l'intérieur pour la Fête des alizées, afin d'en faire un défi spécial pour tous ceux qui sont prêts à tenter le coup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560107
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 706560107,
					"content": "Ce n'est pas dangereux ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706560108
					]
				},
				{
					"id": 706560108,
					"content": "Ne vous inquiétez pas ! Nous avons préparé cette activité spécialement pour la fête. Les participants sans expérience se font accompagner par un membre de la Guilde des aventuriers tout le long.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560109
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 706560109,
					"content": "#Mais {M#un aventurier aussi doué}{F#une aventurière aussi douée} que vous ne devrait pas avoir besoin d'aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560110
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 706560110,
					"content": "#Vous pouvez choisir de l'explorer {M#seul}{F#seule} ou avec vos amis. Terminez le donjon et vous obtiendrez une belle récompense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560111,
						706560112
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 706560111,
					"content": "J'ai compris.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706560113
					]
				},
				{
					"id": 706560113,
					"content": "Alors je ne prends pas plus de votre temps. J'espère que vous vous amuserez bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Plauen"
				},
				{
					"id": 706560112,
					"content": "S'il y a une récompense, je veux bien essayer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706560113
					]
				},
				{
					"id": 706560103,
					"content": "Ça a l'air assez spécial.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706560104
					]
				}
			]
		}
	]
