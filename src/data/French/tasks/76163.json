			"dialogs": [
				{
					"id": 761630101,
					"content": "... Sonnet. Tu sèches le travail et tu t'éclipses en douce pour t'amuser avec les humains de plus en plus souvent ces dernières années, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630102
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761630102,
					"content": "Q—Qu'est-ce que ça peut faire ! On n'a qu'à laisser le boulot aux émissaires lunaires, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630103
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761630103,
					"content": "Vous vous êtes entichées de notre nouveau maître, mes sœurs, et il est prêt à envoyer des subordonnés pour partager notre travail... Ai-je vraiment le choix ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630104
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761630104,
					"content": "D'ailleurs, toi aussi tu t'es bien amusée, Canon ! Tu as même participé à un festival humain !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630105
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761630105,
					"content": "... Cela faisait partie de mon devoir. Leur grand prêtre a invoqué mon nom. Il était tout à fait naturel que je réponde à leurs appels.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630106
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761630106,
					"content": "Se faire passer pour une simple fille ordinaire et danser devant sa propre statue, ça fait aussi partie de tes fonctions ? Première nouvelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630107
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761630107,
					"content": "... Aria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630108
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761630108,
					"content": "Canon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630109
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761630109,
					"content": "... Je ne t'ai pas demandé de m'appeler par mon nom... Oh, laisse tomber. Puisque la nouvelle émissaire lunaire ne rechigne pas à aider Sonnet dans son travail...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630110
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761630110,
					"content": "Zibai. Elle s'appelle Zibai. Tu devrais vraiment retenir le nom des gens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630111
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761630111,
					"content": "... Puisque Zibai n'a pas d'objections, je n'ai rien à ajouter. Cependant, Sonnet, en tant que volonté de la lune, tu ne dois pas oublier les formules fondamentales qui régissent le fonctionnement du monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630112
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761630112,
					"content": "Prépare-toi. Je vais te donner quelques problèmes fondamentaux sur la vérification des isomorphismes morphologiques. Tu ne retourneras pas à la surface tant que tu ne les auras pas tous résolus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630113
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761630113,
					"content": "Héhé, c'est cruel. On dirait un méchant de roman terrien qui essaie de ramener la princesse fugitive sur la lune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630114
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761630114,
					"content": "C'est exactement ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630115
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761630115,
					"content": "... Tu es la lune dans cette histoire. Ne dis pas ce genre de choses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canon"
				}
			]
		}
	]
}