					"Tailleferre"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742240901,
					"content": "C'est... Oui, c'est bien la partition de « L'étranger volant ». Vous l'avez retrouvée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240902
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240902,
					"content": "#Ça n'a pas dû être facile ! Vous êtes vraiment des {M#aventuriers}{F#aventurières} hors pair. Je savais que je pouvais compter sur vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240903
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240903,
					"content": "Haha. Mais qu'allez-vous faire de la partition ? Vous n'avez pas envie de la jouer à l'Opéra Épiclèse, et de peut-être faire fortune ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240904,
					"content": "Eh bien, c'est important de gagner de l'argent, mais je n'ai pas l'intention de garder cette partition pour moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240905
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240905,
					"content": "Cette œuvre ancienne appartient au patrimoine de l'humanité. Je la rendrai publique dès que j'aurai terminé mes recherches.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240906
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240906,
					"content": "La plus grande réussite n'est-elle pas de retrouver une œuvre que l'on croyait perdue et de combler un vide dans l'histoire de l'art ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240907,
						742240908
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240907,
					"content": "Courage !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240910
					]
				},
				{
					"id": 742240910,
					"content": "Bon, je ferais mieux de me dépêcher de rentrer pour étudier cette partition.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240911
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240911,
					"content": "Voici votre paiement. Puissent nos chemins se recroiser un jour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240908,
					"content": "N'oubliez pas ma contribution.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240909
					]
				},
				{
					"id": 742240909,
