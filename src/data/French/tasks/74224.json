				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tailleferre"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742240201,
					"content": "Oh, Tailleferre, je ne m'attendais pas à vous revoir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240202,
					"content": "#Oh, c'est vous deux. L'{M#aventurier}{F#aventurière} et sa charmante assistante. J'ai oublié de vous demander vos noms la dernière fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240203
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240203,
					"content": "#Je m'appelle Paimon, et voici {NICKNAME}. Grâce à vous, nous avons réussi à jouer de la musique ancienne à la harpe-conque la dernière fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240204,
					"content": "Qu'est-ce qui vous amène à Petrichor ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240205,
					"content": "#Je voulais justement vous poser la même question. Je suis venue ici dès que j'ai entendu la nouvelle. Mais en {M#grands aventuriers}{F#grandes aventurières} que vous êtes, vous avez sans doute quelques longueurs d'avance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240206
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240206,
					"content": "La nouvelle ? De quoi parlez-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240207,
					"content": "Vous n'avez-vous pas entendu la plus grande nouvelle de Petrichor...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240208,
						742240209
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240208,
					"content": "À propos de la façon dont nous avons accidentellement sauvé le monde ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240210
					]
				},
				{
					"id": 742240210,
					"content": "De quoi parlez-vous ? Non, je parle de la redécouverte du légendaire Château fané bien sûr !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240211
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240211,
					"content": "Les traces les plus récentes du Château fané remontent à plusieurs siècles. Je pensais que c'était précisément ce qui vous amenait ici !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240212
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240212,
					"content": "Oh, ça... Il se peut fortement qu'il y ait un lien avec nous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240213,
					"content": "Vous savez probablement que le château appartenait autrefois à Boethius, l'un des musiciens les plus importants de l'histoire de Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240214
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240214,
					"content": "Qu'il s'agisse de ses opéras ou des vieilles partitions de Remuria qu'il a collectionnées, toutes ces œuvres occupent une place unique dans l'histoire de la musique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240215
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240215,
					"content": "Comme il vivait autrefois au château, il devrait y avoir une grande quantité de matériel là-bas. Ces documents sont précieux pour notre Association des musiciens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240216
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240216,
					"content": "C'est pourquoi je suis venue ici dès que j'ai appris la nouvelle. J'ai essayé d'arriver avant les aventuriers pour mettre les documents importants en sécurité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240217
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240217,
					"content": "Je ne m'attendais pas à ce que vous arriviez avant moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240218
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240218,
					"content": "(Hmm... Devrions-nous lui dire que ce Boethius est en réalité une très mauvaise personne et qu'il a utilisé sa musique pour ses plans maléfiques...?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240219,
					"content": "(Ça va peut-être la rendre triste de découvrir la vérité...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240220,
						742240221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240220,
					"content": "La Symphonie ne peut plus faire de mal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240222
					]
				},
				{
					"id": 742240222,
					"content": "Que murmurez-vous ? Vous n'auriez pas déjà découvert une ancienne partition ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240223
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240223,
					"content": "Alors, si... et ce n'est qu'une hypothèse... Si Boethius était une mauvaise personne, voudriez-vous toujours les partitions qu'il a laissées derrière lui ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240224,
					"content": "Hmm... Je ne sais pas ce que vous entendez par mauvaise personne, mais à part pour sa musique, il n'avait pas très bonne réputation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240225
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240225,
					"content": "De son opéra romantique « L'étranger volant », nous pouvons constater qu'il n'a pas cessé d'essayer de faire revivre Remuria jusqu'à sa mort. C'est pourquoi il considérait la Fontaine nouvellement formée comme un ennemi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240226
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240226,
					"content": "Selon les historiens, il aurait également participé aux troubles militaires entourant la fondation de Fontaine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240227
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240227,
					"content": "Ses réalisations musicales, cependant, sont quelque chose de tout à fait différent. Même si elles sont historiquement inexactes, leur valeur artistique ne peut pas être niée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240228
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240228,
					"content": "Pour moi, tout ça fait partie de l'histoire elle-même. Même l'art pur peut être utilisé pour le mal. Et en tant que musicienne, je ferais bien de ne pas l'oublier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240229,
						742240231
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240229,
					"content": "Vous ne les utiliseriez certainement pas à des fins malveillantes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240230
					]
				},
				{
					"id": 742240230,
					"content": "Haha, je ne suis qu'une chercheuse. Entendre ces mélodies anciennes dépasse déjà toutes mes espérances.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240233
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240233,
					"content": "D'ailleurs, puisque j'ai la chance de vous trouver ici, pourrais-je vous demander de me rendre un service ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240234
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240234,
					"content": "Considérez ça comme une façon de me remercier pour mon aide la dernière fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240235,
						742240237,
						742240239
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240235,
					"content": "Vous aviez dit que vous n'attendiez rien en retour...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240236
					]
				},
				{
					"id": 742240236,
					"content": "Haha, appelons ça simplement de l'aide, alors.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240240
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240240,
					"content": "Bref, comme je l'ai dit, je suis venue ici pour essayer de trouver la partition du célèbre opéra « L'étranger volant ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240241
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240241,
					"content": "D'après les notes laissées par un certain Ruggiero il y a plusieurs centaines d'années, elle devrait se trouver quelque part dans le Château fané. Ce serait génial si vous pouviez m'aider à la trouver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240242
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240242,
					"content": "#Après tout, vous devez être bien plus {M#expérimentés}{F#expérimentées} que moi en la matière.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240243
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240243,
					"content": "#{NICKNAME}, puisqu'elle le demande, nous devrions l'aider. De plus, les partitions n'ont probablement plus ce « pouvoir ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240244,
					"content": "D'accord, je prends ça comme un oui. C'est génial !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240245
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240245,
					"content": "Je compte sur vous. Je vous attendrai au village.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240237,
					"content": "#Mais j'aimerais être {M#rémunéré}{F#rémunérée}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240238
					]
				},
				{
					"id": 742240238,
					"content": "Vous recevrez une récompense, c'est évident. Notre Association des musiciens ne manque pas de moyens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240240
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240239,
					"content": "C'est en effet l'impression que j'avais...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240240
					]
				},
				{
					"id": 742240231,
					"content": "Des convictions remarquables.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240232
					]
				},
				{
					"id": 742240232,
					"content": "Haha, ce n'est que mon opinion personnelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240233
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240221,
					"content": "Ça ne va pas être facile à expliquer tout ça...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240222
					]
				},
				{
					"id": 742240209,
					"content": "À propos de la grande hypnose de Petrichor ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240210
					]
				}
			]
		},
