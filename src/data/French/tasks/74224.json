					"content": "Le paysage est tout simplement magnifique ici. Nous commandons chaque année de nombreux instruments à cette ville, mais c'est la première fois que je viens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240802,
						742240803
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240802,
					"content": "À propos de la partition...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 742240803,
					"content": "Non, rien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240804
					]
				},
				{
					"id": 742240804,
					"content": "Je compte sur vous. Je vous attendrai au village.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tailleferre"
				}
			]
		},
