				"points": []
			},
			"dialogs": [
				{
					"id": 400040201,
					"content": "#Salut {NICKNAME} ! Ça faisait un bail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040202
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040202,
					"content": "Kaeya ! Nous sommes de retour après avoir vu le Festival des lanternes à Liyue !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040203,
					"content": "Comment c'était ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040204
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040204,
					"content": "Dé-li-cieux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040205,
					"content": "#Dans ce cas, tenez-vous {M#prêts}{F#prêtes} pour le Ludi Harpastum de Mondstadt. Vous ne serez pas {M#déçus}{F#déçues}, c'est promis !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040206
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040206,
					"content": "Viens-en aux faits, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040207
					]
				},
				{
					"id": 400040207,
					"content": "Oui... Oui... Kaeya, on a quelque chose d'important...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040208,
					"content": "Hmm... Des matériaux pour les lanternes... Du bois, du papier, de l'huile... La situation peut déraper à tout moment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040209
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040209,
					"content": "Qu'est-ce qui vous a fait croire que je reconnaîtrais ce symbole ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040210,
						400040215
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040210,
					"content": "Parce que vous êtes trop fort et qu'on peut se fier à vous.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040211
					]
				},
				{
					"id": 400040211,
					"content": "Tout à fait !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040212,
					"content": "Vous me flattez ! Mais je crains que vous ne me surestimiez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040213
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040213,
					"content": "Voici le chevalier Kaeya pris en flagrant délit de modestie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040214,
					"content": "Eh bien, je vois que ton esprit s'est aiguisé lors de ton séjour à Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040220
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040220,
					"content": "Pour en revenir à nos Brutocollinus, ce symbole est celui des Pilleurs de trésors, un groupe de malfaiteurs qui sévit à travers tout le continent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040221
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040221,
					"content": "Si ça vous intéresse, je peux arranger une rencontre avec un de mes espions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040222
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040222,
					"content": "Je croyais que l'Ordre de Favonius ne recourait pas à ce genre de méthode ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040223,
					"content": "Nuance. Je n'ai pas dit que c'était un espion de l'Ordre, mais le mien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040224
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040224,
					"content": "Rendez-vous à Ventlevé un peu plus tard. Je lui dirai d'aller vous chercher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040225
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040225,
					"content": "Merci Kaeya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040226,
					"content": "N'oubliez pas : le vin apporte la sagesse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040227
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040227,
					"content": "Hmm ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040215,
					"content": "Parce que vous êtes toujours au courant des affaires douteuses.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040216
					]
				},
				{
					"id": 400040216,
					"content": "C'est ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040217,
					"content": "#Tss, tss. Tu devrais faire attention à ce que tu dis, {M#mon cher}{F#ma chère}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040218
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040218,
					"content": "Je ne vois pas du tout de quoi tu parles. Ce n'est pas digne d'un chevalier tel que moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040219
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040219,
					"content": "Je suis quelqu'un d'intègre, voyons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040220
					],
					"speakerTitle": "Kaeya"
				}
			]
		},
