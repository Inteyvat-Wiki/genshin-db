				"points": []
			},
			"dialogs": [
				{
					"id": 400040901,
					"content": "#Excusez-moi mon{M#ami}{F#amie}. Où que vous alliez, ce n'est pas dans cette direction.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040902
					],
					"speakerTitle": "Bei'er"
				},
				{
					"id": 400040902,
					"content": "C'est la direction du Port de Liyue, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040903,
					"content": "Exact. Ici on est au milieu de nulle part, donc vous ne pouvez aller que là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040904
					],
					"speakerTitle": "Bei'er"
				},
				{
					"id": 400040904,
					"content": "Si vous cherchez un hébergement, je ne peux que vous conseiller l'Auberge Wangshu. Le service est excellent pour un prix raisonnable et le paysage est à tomber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040905
					],
					"speakerTitle": "Jo le rusé"
				},
				{
					"id": 400040905,
					"content": "On voudrait voir cette fameuse lettre anonyme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040906
					]
				},
				{
					"id": 400040906,
					"content": "Comment êtes-vous au courant de ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040907
					],
					"speakerTitle": "Bei'er"
				},
				{
					"id": 400040907,
					"content": "Euh, un des Adeptes de Liyue nous en a parlé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040908,
					"content": "Il faut arrêter de me prendre pour un jambon quand même...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040909
					],
					"speakerTitle": "Bei'er"
				},
				{
					"id": 400040909,
					"content": "C'est bien moi qui leur ai demandé d'enquêter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040910
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400040910,
					"content": "Vous avez d'autres questions ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040911
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400040911,
					"content": "Vous êtes le Gardien Yaksha ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040912
					],
					"speakerTitle": "Bei'er"
				},
				{
					"id": 400040912,
					"content": "Hé, faites attention à votre ton ! Vous ne voudriez pas mettre un Adepte en colère, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040913,
					"content": "Ce n'est pas que nous ne croyons pas que vous soyez un Adepte, c'est juste que... Prenons un peu de recul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040914
					],
					"speakerTitle": "Jo le rusé"
				},
				{
					"id": 400040914,
					"content": "Comme vous le savez sûrement, nous ne sommes que des Pilleurs de trésors, pas des tueurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040915
					],
					"speakerTitle": "Bei'er"
				},
				{
					"id": 400040915,
					"content": "Soyez indulgents avec nous si vous êtes vraiment un Adepte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040916
					],
					"speakerTitle": "Jo le rusé"
				},
				{
					"id": 400040916,
					"content": "Si vous êtes un imposteur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040917
					],
					"speakerTitle": "Bei'er"
				},
				{
					"id": 400040917,
					"content": "Ne nous en voulez pas si nous vous traitons comme les autres...",
					"roleType": "TALK_ROLE_NPC",
