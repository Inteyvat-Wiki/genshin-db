			"dialogs": [
				{
					"id": 400040301,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040302
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040302,
					"content": "Hé, vous êtes le type, n'est-ce pas ? L'informateur de Kaeya ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040303,
					"content": "Informateur ? Pas du tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040304
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040304,
					"content": "Pourtant, nous avons rendez-vous ici et il n'y a que vous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040305,
					"content": "Quel rendez-vous ? Je ne vois pas de quoi vous parlez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040306
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040307,
					"content": "Le vin apporte la sagesse.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040308
					]
				},
				{
					"id": 400040310,
					"content": "Le vin apporte... l'ivresse ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040311
					]
				},
				{
					"id": 400040306,
					"content": "Vous êtes vraiment casse-pieds !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040307,
						400040310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040308,
					"content": "Oui, c'est bien moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040309
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040309,
					"content": "En quoi tout cela est-il nécessaire ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040311,
					"content": "Hum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040312
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040312,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040313,
					"content": "Le mot de passe n'est pas tout à fait correct, mais le thème est plutôt respecté, alors...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040314
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040314,
					"content": "Oui, c'est moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040315
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040315,
					"content": "En quoi tout cela est-il nécessaire ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040316,
					"content": "Qu'est-ce que vous voulez savoir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040317
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040317,
					"content": "En gros, voilà ce qu'il s'est passé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040318,
					"content": "Ah bon ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040319
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040319,
					"content": "Vous avez des renseignements internes à partager ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040320,
					"content": "Je ne pense pas que ce soit l'œuvre des Pilleurs de trésors.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040321
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040321,
					"content": "S'ils ont réussi à mettre en place une organisation aussi étendue, c'est parce qu'ils respectent un certain principe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040322
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040322,
					"content": "Et ce principe, c'est le principe de prudence. On les voit rarement prendre des risques : ils préfèrent se faire discrets.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040323
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040323,
					"content": "Il y a des Adeptes qui veillent sur Liyue, n'est-ce pas ? Ils sont d'ailleurs très actifs lors du Festival des lanternes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040325
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040324,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040325,
					"content": "Exactement. Autrement dit, il est impossible que nous – pardon, ça fait trop longtemps que je suis sous couverture –, qu'ils soient impliqués.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040326
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040326,
					"content": "La branche liyuéenne des Pilleurs de trésors a aussi récemment reçu une lettre anonyme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040327
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040327,
					"content": "Quelqu'un voudrait donc monter un coup contre eux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040328,
					"content": "Aucune idée, mais je peux vous dire où se trouve cette lettre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040329
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040329,
					"content": "... Voilà, je vous ai marqué l'emplacement sur la carte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040330
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040330,
					"content": "#Super, {NICKNAME} ! Nous détenons à présent une piste solide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040331,
					"content": "Si vous n'avez pas d'autres questions, je retourne à mes activités de pill... Ahem, d'espionnage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nimrod"
				}
			]
		},
