			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110450101,
					"content": "J'imagine que vous avez dû rencontrer bien des énigmes lors de vos périples.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450102
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450102,
					"content": "J'aimerais observer votre intelligence au moyen d'un test pratique de vos capacités ; tout comme nous l'avons fait pour le test physique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450103,
						110450104
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450103,
					"content": "Aucun problème.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450105
					]
				},
				{
					"id": 110450105,
					"content": "J'aimerais que vous exploriez ces ruines et que vous reveniez avec ce que vous avez trouvé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450106
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450106,
					"content": "Il y a deux énigmes situées aux extrémités des ruines. Une fois résolues, vous devriez pouvoir activer le mécanisme au centre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450107
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450107,
					"content": "Comme pour le test physique, il n'y a aucune restriction. Tout ce que vous faites est une action que je souhaite observer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450108,
						110450110
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450108,
					"content": "Je commence à avoir l'habitude.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450109
					]
				},
				{
					"id": 110450109,
					"content": "#{M#Un aventurier éprouvé}{F#Une aventurière éprouvée}, je vois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450112
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450112,
					"content": "Bon, voyons ce que vous valez en action. Commencez où vous voulez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450110,
					"content": "Quand on veut, on peut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450111
					]
				},
				{
					"id": 110450111,
					"content": "N'oubliez pas que c'est un test d'intellect. La chance n'entre pas en jeu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450112
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450104,
					"content": "Et un test écrit ne suffit pas ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450105
					]
				}
			]
		},
		{
			"id": 1104504,
			"completionStepIds": [
				1104504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104504",
							"2"
						],
						"stepId": 1104504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110450461,
					"content": "Qu'est-ce que c'est ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450462,
						110450463
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450462,
					"content": "Des motifs inconnus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450401
					]
				},
				{
					"id": 110450401,
					"content": "À ma connaissance, ils appartiennent à une sorte d'écriture. On les retrouve partout en Teyvat, mais ils n'ont jamais révélé leurs secrets.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450402
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450402,
					"content": "Il y a encore beaucoup à apprendre à leur sujet, et sur les raisons pour lesquelles on en trouve ici... C'est un vrai mystère !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450403
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450403,
					"content": "Laissez-moi d'abord faire une copie... Je prendrai le temps de les examiner plus en détail après nos recherches.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450404
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450404,
					"content": "*soupir* Encore quelque chose pour la liste des « je ne comprends pas »... Un mystère insoluble ici, une expérimentation étrange là... Ce serait bien d'obtenir des résultats sympas pour une fois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450405,
					"content": "La récompense a un prix, on dirait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450406,
					"content": "J'ai vraiment beaucoup appris grâce à tout cela... Comparativement, la récompense que je peux vous offrir est bien moindre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450407
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450407,
					"content": "Permettez-moi de retourner d'abord au campement. Quand vous serez de retour, j'aurais peut-être un miracle éphémère à vous montrer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450408,
						110450409
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450408,
					"content": "À tout à l'heure.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450410
					]
				},
				{
					"id": 110450410,
					"content": "J'ai quand même hâte de voir le résultat de toute cette charade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450411,
					"content": "À moins qu'il n'y ait quelque chose de mieux à faire, retournons au campement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450412,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450413,
					"content": "Pas si vite ! Vous ne partirez pas tant que vous ne m'aurez pas convaincue que vous n'êtes pas un danger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450414
					],
					"speakerTitle": "Rosalia"
				},
				{
					"id": 110450414,
					"content": "Ah ! Vous ! Vous n'avez pas quitté la montagne !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450415,
					"content": "Évidemment que non ! Et j'ai été témoin de tout ce qu'Albedo et vous avez fait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450416
					],
					"speakerTitle": "Rosalia"
				},
				{
					"id": 110450416,
					"content": "#Je dois dire que vous avez baissé votre garde... Ou peut-être avez-vous été {M#séduit}{F#séduite} par ses hypothèses convaincantes et son attitude amicale ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450417,
						110450418
					],
					"speakerTitle": "Rosalia"
				},
				{
					"id": 110450417,
					"content": "Que voulez-vous dire ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450419
					]
				},
				{
					"id": 110450419,
					"content": "Suivre les ordres d'un parfait inconnu, boire des potions étranges et participer à toutes sortes d'expérimentations bizarres ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450420
					],
					"speakerTitle": "Rosalia"
				},
				{
					"id": 110450420,
					"content": "#Je préfère penser que vous avez été {M#trompé}{F#trompée} plutôt que de penser que vous soyez aussi {M#naïf}{F#naïve}. Ou peut-être... Que vous étiez de connivence depuis le début ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450421
					],
					"speakerTitle": "Rosalia"
				},
				{
					"id": 110450421,
					"content": "Écoutez ma sœur, votre garde est si haute que vous ne pouvez même pas voir par-dessus !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450422,
						110450423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450422,
					"content": "Je l'aidais simplement dans ses recherches.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450424
					]
				},
				{
					"id": 110450424,
					"content": "#Peu importe ce que vous pensez, il pourrait bien être un saint, vous n'en savez rien. Mais je le comprends un peu mieux que vous, {M#étranger}{F#étrangère}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450425
					],
					"speakerTitle": "Rosalia"
				},
				{
					"id": 110450425,
					"content": "#Je ne suis préoccupée que par une chose : savoir si son alchimie vous a {M#transformé}{F#transformée} en quelque chose de plus sinistre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450426
					],
					"speakerTitle": "Rosalia"
				},
				{
					"id": 110450426,
					"content": "Pas possible ! Je l'aurais ressenti. Et de toute façon, il n'a même pas fait appel à l'alchimie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450427,
					"content": "Avec un alchimiste de son niveau, vous ne ressentiriez rien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450428
					],
					"speakerTitle": "Rosalia"
				},
				{
					"id": 110450428,
					"content": "En tout cas, je ne vais pas laisser une menace potentielle retourner à Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450429
					],
					"speakerTitle": "Rosalia"
				},
				{
					"id": 110450429,
					"content": "Et donc, qu'est-ce que vous allez faire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450430,
					"content": "Vous êtes venue ici pour en être sûre. Alors, faites ce que vous avez à faire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450431
					]
				},
				{
					"id": 110450431,
					"content": "#Je dois l'admettre, vous comprenez vite. Si je peux m'assurer que vous n'êtes {M#entré}{F#entrée} en contact avec rien de dangereux, ça me suffira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450432
					],
					"speakerTitle": "Rosalia"
				},
				{
					"id": 110450432,
					"content": "J'ai déjà tout vérifié. Et la seule chose qui reste, ce sont ces symboles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450433
					],
					"speakerTitle": "Rosalia"
				},
				{
					"id": 110450433,
					"content": "Mais on ne sait même pas ce qu'ils signifient !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450451
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450451,
					"content": "C'est vrai, sans oublier que... Hmm, on dirait qu'il n'y a rien d'autre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450452
					],
					"speakerTitle": "Rosalia"
				},
				{
					"id": 110450452,
					"content": "Mais pour en être certaine, je ferais mieux d'en faire une copie... Hmm. C'est maintenant un point d'intérêt. Il faut mettre des patrouilles régulières en place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450434
					],
					"speakerTitle": "Rosalia"
				},
				{
					"id": 110450434,
					"content": "Bon, après avoir tout considéré, j'ai déterminé que vous ne représentiez aucune menace immédiate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450435
					],
					"speakerTitle": "Rosalia"
				},
				{
					"id": 110450435,
					"content": "C'est bien ce que j'espérais... J'aurais été bien malheureuse si vous m'aviez fait faire des heures supplémentaires...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450436
					],
					"speakerTitle": "Rosalia"
				},
				{
					"id": 110450436,
					"content": "... Des heures supplémentaires ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450437,
					"content": "#Avant de nous séparer, {M#étranger}{F#étrangère}, un conseil : ne faites pas si vite confiance à Albedo et ne répétez pas les mêmes erreurs que vous avez faites cette fois. Vous avez pris beaucoup de décisions irréfléchies aujourd'hui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450439
					],
					"speakerTitle": "Rosalia"
				},
				{
					"id": 110450439,
					"content": "Et elle est partie... Quelle têtue !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450440
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450440,
					"content": "Il n'y a pas beaucoup de gens comme ça à Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450441,
						110450442
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450441,
					"content": "Peut-être qu'elle ne se sent pas en sécurité...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450443
					]
				},
				{
					"id": 110450443,
					"content": "Hum, peu importe ! Allons voir Albedo !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450442,
					"content": "Peut-être qu'elle est juste sensible...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450443
					]
				},
				{
					"id": 110450423,
					"content": "Je ne pense pas que ce soit une mauvaise personne.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450424
					]
				},
				{
					"id": 110450418,
					"content": "Il a des arrière-pensées ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450419
					]
				},
				{
					"id": 110450409,
					"content": "(Je suppose que j'ai réussi son test d'intelligence.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450410
					]
				},
				{
					"id": 110450463,
					"content": "J'ai l'impression d'avoir déjà vu ça...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450401
					]
				}
			]
		},
		{
			"id": 1104505,
			"completionStepIds": [
				1104505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104505",
							"2"
						],
						"stepId": 1104505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110450501,
					"content": "Vous êtes de retour ! Bon timing, j'étais sur le point d'arriver à ma conclusion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450502
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450502,
					"content": "#Vous avez mis un bon bout de temps, quelque chose vous a {M#retenu}{F#retenue} sur le chemin du retour ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450503,
						110450504
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450503,
					"content": "Pas vraiment...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450506
					]
				},
				{
					"id": 110450506,
					"content": "Passons aux résultats. Nous avons obtenu une myriade de données aujourd'hui, et c'était difficile de terminer toutes les recherches en une fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450507
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450507,
					"content": "Mais la conclusion préliminaire intégrale que je peux vous donner, c'est... Que vous êtes semblable à un humain de ce monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450508,
						110450509
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450508,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450510
					]
				},
				{
					"id": 110450510,
					"content": "Vous n'auriez pas pu deviner ça rien qu'en regardant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450511,
					"content": "On a passé toute la journée à crapahuter pour ça !?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450512,
					"content": "Voyons, je comprends que cela vous semble peut-être évident, mais en fait, rien dans ce monde ne doit être tenu pour acquis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450513
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450513,
					"content": "Avez-vous déjà considéré que le monde de Teyvat pouvait contenir une hostilité naturelle envers les étrangers ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450514,
						110450515
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450514,
					"content": "Seuls les dieux le savent...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450516
					]
				},
				{
					"id": 110450516,
					"content": "J'ai déjà mentionné les lois naturelles de ce monde. Vous êtes capable de converser avec moi sans conséquence, et rien ne semble clocher. Mais c'est sans doute un miracle !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450517
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450517,
					"content": "La seule autre forme de vie qui, comme vous, est venue ici de loin, c'est la graine que j'ai mentionnée. Sous les effets des lois naturelles de Teyvat, elle ne peut même pas germer, et encore moins fleurir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450518
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450518,
					"content": "#Mais après vous avoir {M#observé}{F#observée}, j'ai eu une autre idée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450519
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450519,
					"content": "Vous imiter m'a aidé à inspirer mon alchimie, et ainsi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450520
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450520,
					"content": "Waouh ! On dirait... que quelque chose apparaît !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450521,
					"content": "Le passage du néant au présent, du bourgeon à la tige... Et maintenant la floraison...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450522
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450522,
					"content": "Nourrir la vie d'un autre monde, cela ne nourrit-il pas aussi le monde lui-même ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450523
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450523,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450524,
						110450525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450524,
					"content": "C'était beau.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450526
					]
				},
				{
					"id": 110450526,
					"content": "*soupir* Il semblerait que ce soit tout ce que nous puissions faire. Une floraison éphémère d'une beauté incomparable... La plus grande fierté de la vie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450527
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450527,
					"content": "Moi qui pensais qu'avec tous nos efforts, ça aurait pu fleurir pour toujours... Et ça n'a même pas fait de fruits...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450528,
					"content": "La vie est une multitude d'entités libres. Sa valeur ne doit pas dériver de la durée pendant laquelle elle reste parmi nous. Même une explosion momentanée est précieuse !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450529
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450529,
					"content": "Une courte vie peut être bien vécue ! Une vie vécue efficacement, vécue à la perfection, est nécessairement exempte de solitude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450530
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450530,
					"content": "Alors, comprenez-vous ce que je voulais dire en disant que le fait pour nous de converser ici était sans doute un miracle ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450531,
						110450532
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450531,
					"content": "Bah, je n'ai pas encore flétri...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450533
					]
				},
				{
					"id": 110450533,
					"content": "Hein ? Pourquoi ça devient un peu déprimant là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450534
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450534,
					"content": "#Héhé, ne sois pas triste, {NICKNAME} ! Tu as ta petite Paimon pour s'occuper de toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450535
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450535,
					"content": "Et Albedo, je veux vraiment être votre amie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450536
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450536,
					"content": "... Merci à vous deux ! Même si dissiper la solitude n'est pas essentiel à la vie, ça ne fait pas de mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450537
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450537,
					"content": "#{NICKNAME}, votre aide m'a inspiré à découvrir le moyen de faire fleurir cette fleur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450538
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450538,
					"content": "Je suis donc un spécimen utile ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450539
					]
				},
				{
					"id": 110450539,
					"content": "Je veux dire que le temps que j'ai passé à parcourir avec vous les montagnes a été précieux pour moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450540
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450540,
					"content": "À l'avenir... Si le besoin s'en fait sentir... Puis-je solliciter à nouveau votre aide ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450541
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450541,
					"content": "Bien sûr ! Même si vous voulez juste de la compagnie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450542
					]
				},
				{
					"id": 110450542,
					"content": "Bien... Merci !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450543
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450543,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450544
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450544,
					"content": "Je me suis efforcé de lui dire à quel point les résultats étaient ordinaires...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450545
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450545,
					"content": "Mais quel était ce sédiment que j'ai vu se former au fond du flacon ? Ça n'aurait pas dû être là... Qu'est-ce que ça peut signifier ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450546
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450546,
					"content": "Ceux qui sont nés de la terre sont liés par ses imperfections, mais ceux qui sont nés de la craie sont exempts d'impuretés... Vous et moi sommes pareils, tous deux composés d'une substance qui n'a pas encore été définie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450547
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450547,
					"content": "Si un jour, je perds le contrôle... détruit Mondstadt... détruit tout...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450548
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450548,
					"content": "Pourrais-je compter sur vous pour m'arrêter ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450532,
					"content": "#(Je me demande comment va {M#ma sœur}{F#mon frère}...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450533
					]
				},
				{
					"id": 110450525,
					"content": "C'était... rapide.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450526
					]
				},
				{
					"id": 110450515,
					"content": "Peut-être...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450516
					]
				},
				{
					"id": 110450509,
					"content": "Et c'est tout ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450510
					]
				},
				{
					"id": 110450504,
					"content": "Littéralement, et une sœur en plus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450505
					]
				},
				{
					"id": 110450505,
					"content": "Haha, ne vous inquiétez pas. Elle fait juste son travail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450506
					],
					"speakerTitle": "Albedo"
				}
			]
		},
		{
			"id": 1104506,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
