							"1104505",
							"2"
						],
						"stepId": 1104505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Timaeus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110450621,
					"content": "Désolé ! Il y a eu des problèmes avec les recherches. La plupart des déductions que j'ai rassemblées ne correspondent tout simplement pas aux données des expérimentations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450622
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110450622,
					"content": "Cependant, certaines des conclusions qu'Albedo a tirées de sa propre intuition ont été confirmées par les faits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450623
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110450623,
					"content": "Je suis tout de même content que nous ayons fait des progrès, alors euh... Aucune raison d'être déçus ! Albedo a dit que j'avais fait du bon travail !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450624
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110450624,
					"content": "Si vous voulez connaître les résultats en détail, vous feriez mieux de lui parler. J'ai du travail...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timaeus"
				}
			]
		}
	]
