						],
						"pointId": 340100545
					},
					{
						"sceneId": 3,
						"position": [
							3938.103,
							443.774,
							4554.202
						],
						"pointId": 340100546
					},
					{
						"sceneId": 3,
						"position": [
							3942.292,
							441.271,
							4545.01
						],
						"pointId": 340100652
					}
				]
			},
			"dialogs": [
				{
					"id": 191851001,
					"content": "... Lorsque la Maréchaussée fantôme a fouillé la maison de Pierre, il n'y avait aucune trace de ces tonneaux, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851002
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 191851002,
					"content": "Il a donc dû les déplacer. Mais les amener ici aurait trop attiré l'attention.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851003
					]
				},
				{
					"id": 191851003,
					"content": "Vous avez raison. Ça ne lui ressemble pas... Alors comment a-t-il fait ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851004
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 191851004,
					"content": "(Inspecter les tonneaux...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851005
					]
				},
				{
					"id": 191851005,
					"content": "(Les tonneaux semblent avoir été abîmés par de l'eau. Ils sont couverts de taches d'eau séchée...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851006
					],
					"speakerTitle": "Examiner"
				},
				{
					"id": 191851006,
					"content": "(Il y a des similitudes dans la position des taches. Pour une certaine raison, elles sont toutes sur la moitié inférieure des tonneaux.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851007
					],
					"speakerTitle": "Examiner"
				},
				{
					"id": 191851007,
					"content": "(Les couvercles ne semblent pas très étanches, il y a des interstices visibles sur les bords. Mais il n'y a aucune trace d'eau à l'intérieur des tonneaux.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851008
					],
					"speakerTitle": "Examiner"
				},
				{
					"id": 191851008,
					"content": "On dirait que seule la moitié inférieure des tonneaux a été submergée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lynette"
				}
			]
		},
		{
			"id": 1918511,
