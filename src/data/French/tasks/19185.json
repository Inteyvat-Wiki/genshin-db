				]
			},
			"dialogs": [
				{
					"id": 191851201,
					"content": "Haha, comme nous le pensions, c'est ici que la sinthe contrefaite était produite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851202
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 191851202,
					"content": "[Médecine] Aider Chevreuse à identifier les substances...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851203
					]
				},
				{
					"id": 191851203,
					"content": "Est-ce que toutes ces bouteilles et flacons contiennent de la sinthe contrefaite ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851204
					]
				},
				{
					"id": 191851204,
					"content": "... On dirait qu'il a stocké bien plus que de la sinthe contrefaite... En plus des matières premières nécessaires à la production de la substance elle-même, on trouve ici un grand nombre de produits de nettoyage et plusieurs substances narcotiques que je ne parviens pas à identifier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851205
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 191851205,
					"content": "Ces produits de nettoyage sont très probablement utilisés pour éliminer les traces de la sinthe, et notamment son odeur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851206
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 191851206,
					"content": "La patrouille de surveillance spéciale a mené une enquête sur la sinthe contrefaite. Selon nos informations, il est très difficile pour les gens ordinaires de détecter les traces laissées par cette substance. Je suis sûre que c'était aussi le cas de Pierre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851207
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 191851207,
					"content": "Ça a dû demander énormément de temps et d'efforts pour éliminer toutes les traces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851208
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 191851208,
					"content": "Mais à quoi servent les autres substances ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chevreuse"
				}
			]
		},
