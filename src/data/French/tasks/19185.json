							4548.217
						],
						"pointId": 340100651
					}
				]
			},
			"dialogs": [
				{
					"id": 191851101,
					"content": "Ces sacs sont fabriqués... à partir d'un matériau plutôt rare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851102
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 191851102,
					"content": "[Connaissance] Aider Lyney à identifier le matériau...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851103
					]
				},
				{
					"id": 191851103,
					"content": "Ça ressemble à celui utilisé pour fabriquer vos pochettes magiques ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851104
					]
				},
				{
					"id": 191851104,
					"content": "... En fait, le matériau est de la fibre de fleur romaritime. Mais il y a quelque chose d'unique dans ces sacs. En regardant de plus près, il s'avère qu'ils sont non seulement étanches, mais également résistants à la corrosion et aux fuites.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851105
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 191851105,
					"content": "Même les cordes semblent avoir été spécialement conçues pour maintenir les sacs fermés de manière étanche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851106
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 191851106,
					"content": "Je viens de tomber sur des sacs faits du même matériau, mais ils étaient beaucoup plus petits et plus fins. À en juger par leur apparence, ils étaient beaucoup moins durables.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851107
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 191851107,
					"content": "Donc... Quelque chose comme ces petits sacs scellés ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851108
					]
				},
				{
					"id": 191851108,
					"content": "... On dirait. En règle générale, le caniche de garde peut facilement détecter de la sinthe contrefaite. Mais si elle est scellée dans un tel sac, elle sera indétectable pendant un certain temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851109
					],
					"speakerTitle": "Lyney"
				},
