				},
				{
					"id": 221120202,
					"content": "Pas encore.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221120203
					]
				},
				{
					"id": 221120203,
					"content": "Elles devraient être en bas. C'est pas compliqué à trouver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120204
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120204,
					"content": "Je reste ici pendant que vous allez les chercher. On ne sait jamais, si quelqu'un se précipite et trébuche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
