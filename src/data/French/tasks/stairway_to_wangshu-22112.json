			"dialogs": [
				{
					"id": 221120501,
					"content": "C'est réparé ! Personne ne devrait plus se casser la figure dans ces escaliers maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120502
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120502,
					"content": "#Je n'en suis pas si {M#sûr}{F#sûre}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221120503
					]
				},
				{
					"id": 221120503,
					"content": "Malheureusement, je ne suis pas un professionnel. C'est le mieux que je puisse faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120504
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120504,
					"content": "Hum... Il y a encore une autre réparation à faire sur ces escaliers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120505
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120505,
					"content": "Enfin, j'ai eu ma dose pour aujourd'hui. L'auberge est encore ouverte alors je ferais mieux de retourner accueillir nos hôtes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120506
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120506,
					"content": "Je dois continuer de travailler, même avec des escaliers cassés. Merci pour votre aide !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
