					"Vermeer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413350701,
					"content": "Alors ? Tu as récupéré le nectar de Fleur mensongère ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350702
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350702,
					"content": "Oui, voilà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350703
					]
				},
				{
					"id": 413350703,
					"content": "Voyons voir... Oui, c'est ça. Très bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350704
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350704,
					"content": "Une fois que j'en ai fini avec le pigment, je trouve un joli paysage et je m'y mets.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350705
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350705,
					"content": "Hmm, et il verra bien ce soi-disant poète ! Fanfaronnera bien qui fanfaronnera le dernier !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350706
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350706,
					"content": "Oh, j'allais presque oublier ! Pendant le Festival des lanternes, il faut lâcher des lanternes célestes et aussi écrire des vœux dessus... Pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350707
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350707,
					"content": "Héhé, j'en avais préparé une aussi ! Quant à mon vœu... Je ne peux pas te le dire, sinon il ne se réalisera pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350708
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350708,
					"content": "Ah, et aussi... Prends ça. C'est pour m'avoir aidé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350709
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350709,
					"content": "Cette peinture va clouer le bec une bonne fois pour toutes à ce poète...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
		},
