				"objectNames": [
					"Sayid"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790041201,
					"content": "#Bonjour mon {M#ami}{F#amie}. Je peux faire quelque chose pour vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041202
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790041202,
					"content": "Est-ce que vous êtes un chercheur ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790041203,
					"content": "Haha, je suppose qu'on peut dire ça. Pour être exact, je suis un « chercheur itinérant », mais je suppose qu'on peut classer ça dans la catégorie des « chercheurs ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041204
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790041204,
					"content": "Eh bien. Avez-vous rencontré un problème qui nécessite l'aide d'un « chercheur » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041205
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790041205,
					"content": "Eh bien, voici ce qui s'est passé...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790041206
					]
				},
				{
					"id": 790041206,
					"content": "Une île perdue en pleine mer... et les fresques que vous avez trouvées. Comme c'est fascinant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041207
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790041207,
					"content": "Vous êtes donc à la recherche d'un chercheur pour vous aider à déchiffrer ces fresques, je suppose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041208,
						790041210
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790041208,
					"content": "Vous voulez bien nous aider ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790041209
					]
				},
				{
					"id": 790041209,
					"content": "Bien sûr. Je ne refuse jamais une opportunité d'étudier l'inconnu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041213
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790041213,
					"content": "À présent, ne nous attardons pas. Puis-je jeter un œil à ces fresques ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041214
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790041214,
					"content": "Voici celles que nous avons photographiées.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790041215
					]
				},
				{
					"id": 790041215,
					"content": "Oh, pas mal, pas mal du tout. Laissez-moi un moment pour réfléchir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790041210,
					"content": "On peut payer pour vos services.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790041211
					]
				},
				{
					"id": 790041211,
					"content": "Hahaha. Vous connaissez les ficelles à ce que je vois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041212
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790041212,
					"content": "Cependant, je dirais que la découverte de l'inconnu est la meilleure des récompenses pour quelqu'un comme moi. Je n'ai besoin de rien d'autre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041213
					],
					"speakerTitle": "Sayid"
				}
			]
		},
