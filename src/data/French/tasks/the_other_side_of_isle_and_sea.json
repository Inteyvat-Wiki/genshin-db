					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040102
					],
					"speakerTitle": "Observer"
				},
				{
					"id": 790040102,
					"content": "On dirait un bateau avec beaucoup de monde dessus... qui fait face à un désastre en mer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040103
					],
					"speakerTitle": "Observer"
				},
				{
					"id": 790040103,
					"content": "Je ne suis pas sûre de bien déchiffrer... Quoi qu'il en soit, commençons par faire une photo de cette fresque, d'accord ?",
