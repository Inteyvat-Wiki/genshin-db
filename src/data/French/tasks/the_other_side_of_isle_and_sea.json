							"7900419",
							"2"
						],
						"stepId": 7900419,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790040301,
					"content": "Bon, on a photographié toutes les fresques. Si on les connecte les unes aux autres, on devrait pouvoir découvrir ce qui est arrivé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7900404,
			"completionStepIds": [
				7900404
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7900404",
							"2"
						],
						"stepId": 7900404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sayid"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790040401,
					"content": "Hmm. Le contenu de ces fresques murales n'est pas très difficile à déchiffrer. Je ne sais pas encore dans quel ordre les mettre, mais si on les prend une par une, je pense qu'on ne devrait pas avoir de problème à les comprendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040402
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040402,
					"content": "Tout d'abord, nous avons cette fresque, qui représente un groupe de gens victime d'un naufrage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040403
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040403,
					"content": "Après le naufrage, ils ont dû dériver vers les îles où vous avez trouvé cette fresque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040404
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040404,
					"content": "Ils sont alors restés sur cette île.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040405
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040405,
					"content": "Quant à cette fresque, elle représente cinq objets avec cinq signes différents.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040406
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040406,
					"content": "Un peu comme cinq coupes qui contiendraient chacune une quantité d'eau différente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040407
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040407,
					"content": "Ce genre d'œuvre illustre généralement le changement d'état de quelque chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040414,
						790040415
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040414,
					"content": "Un changement d'état...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790040408
					]
				},
				{
					"id": 790040408,
					"content": "Cependant, je n'arrive pas à deviner ce qu'est ce « quelque chose ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040409
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040409,
					"content": "Vu qu'il est question d'une île perdue au milieu de l'océan, ce pourrait être de l'« eau de mer ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040410
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040410,
					"content": "Maintenant, jetons un œil à cette fresque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040411
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040411,
					"content": "Après un autre naufrage, cette île a accueilli de nouveaux « invités ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040412
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040412,
					"content": "Ce doit être le premier groupe qui a essayé de sauver le deuxième. Et vous pouvez voir le navire naufragé représenté ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040413
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040413,
					"content": "Si la première fresque ne fournissait que quelques indices sur la situation, celle-ci est beaucoup plus précise sur l'emplacement de l'épave du navire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040416
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040416,
					"content": "Peut-être que ce naufrage signifiait quelque chose d'inhabituel pour les gens qui se sont retrouvés sur cette île.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040417
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040417,
					"content": "Venons-en à cette fresque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040418
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040418,
					"content": "Là, je suis sûr que vous pouvez remarquer que cette montagne a été spécialement marquée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040419
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040419,
					"content": "Je suspecte que cet endroit avait une grande signification pour ces gens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040422
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040422,
					"content": "Et enfin, nous arrivons à celle-là. De toute évidence, ils ont trouvé un moyen de quitter cette île et ils sont partis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040423
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040423,
					"content": "Voilà l'histoire que racontent ces fresques murales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040424,
						790040428
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040424,
					"content": "Merci.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790040425
					]
				},
				{
					"id": 790040425,
					"content": "Ce n'est rien. J'ai toujours été intéressé par ce genre de recherches.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040426
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040426,
					"content": "Je vous remercie de m'avoir apporté cette histoire et ces fresques. Je n'aurais jamais pensé rencontrer une telle chose à Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040427
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040427,
					"content": "Peut-être que je devrais prendre l'air un peu plus souvent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040428,
					"content": "Pourquoi avoir utilisé des fresques ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790040429
					]
				},
				{
					"id": 790040429,
					"content": "Parfois, les images sont plus parlantes que les mots, pour ce qui est d'enregistrer et de transmettre des informations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040426
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040415,
					"content": "... Qu'est-ce que ça veut dire exactement ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790040408
					]
				}
			]
		},
		{
			"id": 7900405,
			"completionStepIds": [
