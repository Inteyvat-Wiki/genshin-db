			"dialogs": [
				{
					"id": 705000501,
					"content": "C'est de... la viande ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000502
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 705000502,
					"content": "De la viande congelée.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000503
					]
				},
				{
					"id": 705000503,
					"content": "Viande congelée... Quel nom approprié.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000504
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 705000504,
					"content": "Hmm... Cette viande est de bonne qualité, mais dans cet état, elle a encore besoin d'être décongelée avant à feu doux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000505
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 705000505,
					"content": "Heureusement, le cuiseur suprême que j'ai conçu peut le faire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000506,
						705000512
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 705000506,
					"content": "Eh bien, on dirait qu'il peut tout faire...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000507
					]
				},
				{
					"id": 705000507,
					"content": "Tout ? Pas vraiment, il lui manque plein de fonctionnalités, comme l'obtention automatique des ingrédients ou le contrôle automatique de la cuisson, etc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000508
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 705000508,
					"content": "Il a encore besoin d'être amélioré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000509
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 705000509,
					"content": "Eh bien, trêve de bavardages. Puisque les ingrédients sont prêts, je vais démarrer la machine tout de suite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000510
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 705000510,
					"content": "#Je te laisse surveiller le feu comme toujours, {M#voyageur}{F#voyageuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000511
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 705000511,
					"content": "Une fois que c'est prêt, fais-le-moi savoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 705000512,
					"content": "Les Adeptes sont vraiment puissants.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000513
					]
				},
				{
					"id": 705000513,
					"content": "#Au lieu d'admirer la puissance des Adeptes, j'aimerais que tu sois {M#ébahi}{F#ébahie} par les prouesses du cuiseur suprême.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000509
					],
					"speakerTitle": "Souffle-Nuages"
				}
			]
		},
