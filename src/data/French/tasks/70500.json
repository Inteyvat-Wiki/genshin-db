				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705000701,
					"content": "Hmm... C'est plutôt bon, grâce...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000702,
						705000703
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 705000702,
					"content": "À vous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000704
					]
				},
				{
					"id": 705000704,
					"content": "Exactement. Après avoir cuisiné ces trois plats, mon cuiseur suprême s'avère fiable d'utilisation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000705
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 705000705,
					"content": "Une fois que j'aurai mis en place le contrôle de la cuisson et l'obtention automatique des ingrédients, il suffira d'appuyer sur un bouton pour cuisiner un plat entier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000706
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 705000706,
					"content": "D'ailleurs, voici la recette de la viande braisée. On utilise de la viande crue ordinaire pour ce plat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000707
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 705000707,
					"content": "Il fait trop froid dans les Monts Dosdragon pour te demander de chercher des ingrédients là-bas à chaque fois que tu voudras faire ce plat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000708
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 705000708,
