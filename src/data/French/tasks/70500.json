			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Souffle-Nuages"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705000101,
					"content": "Les arbres d'azur se dressent au milieu de la scène enneigée, la terre est solitaire et tranquille. En vérité, mon troisième plat convient parfaitement à cette atmosphère.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000102
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 705000102,
					"content": "Qu'avez-vous envie de cuisiner cette fois-ci ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000103
					]
				},
				{
					"id": 705000103,
					"content": "Hum... Dis, as-tu déjà entendu parler d'une technique de cuisson nommée « braisage » ? Je suis tombée dessus en cherchant des recettes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000104
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 705000104,
					"content": "Cela m'a tellement intéressée que j'ai créé une nouvelle recette qui met cette technique à l'honneur : la « viande braisée ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000105
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 705000105,
					"content": "Bien que ce plat ne soit pas trop difficile à faire grâce à mon cuiseur suprême, il s'agit d'un plat de viande. Celle-ci doit donc être de très bonne qualité...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000106
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 705000106,
					"content": "Par conséquent, j'ai démarré la machine, puis j'ai suivi l'odeur des ingrédients jusqu'ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000107
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 705000107,
					"content": "C'est un endroit très venteux et enneigé, il est donc très difficile de faire quoi que ce soit ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000108
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 705000108,
					"content": "#{M#Voyageur}{F#Voyageuse}, je sais que tu as beaucoup d'expérience et le cœur aventureux. Une simple montagne enneigée ne devrait pas te poser de problème.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000109
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 705000109,
					"content": "Pourrais-tu me ramener des ingrédients ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000110,
						705000116
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 705000110,
					"content": "Vous me donnerez aussi la troisième recette.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000111
					]
				},
				{
					"id": 705000111,
					"content": "Bien sûr, je ne l'oublie pas. Je compte sur toi. Retrouve-moi ici quand tu auras terminé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000112
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 705000112,
					"content": "Hum, pourquoi la machine s'est soudainement arrêtée ? Parce qu'il fait trop froid autour ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000113
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 705000113,
					"content": "Je vais la redémarrer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000114
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 705000114,
					"content": "Cuiseur suprême... Activation !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000115
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 705000115,
					"content": "#Cela devrait faire l'affaire... {M#Voyageur}{F#Voyageuse}, suis l'odeur et récupère les ingrédients que je souhaite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 705000116,
					"content": "Il fait trop froid pour voler, c'est ça ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000117
					]
				},
				{
					"id": 705000117,
					"content": "Tu plaisantes ! Ne sous-estime pas ma puissance ! J'ai juste... besoin de rester pour réparer la machine !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000118
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 705000118,
					"content": "Tu devrais y aller et vite, ne me fais pas attendre trop longtemps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000112
					],
					"speakerTitle": "Souffle-Nuages"
				}
			]
		},
