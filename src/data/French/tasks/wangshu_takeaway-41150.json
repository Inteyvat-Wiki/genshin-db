					"nextDialogs": [
						411500304
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 411500304,
					"content": "<color=#00E1FFFF>Ah, puis évite d'interagir avec les éléments, ça pourrait modifier son goût.</color>",
