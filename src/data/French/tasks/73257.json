					"nextDialogs": [
						732571706
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732571706,
					"content": "Je sais, mais je n'ai pas encore l'habitude de porter le chapelet !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571707
					],
					"speakerTitle": "Sorush"
				},
