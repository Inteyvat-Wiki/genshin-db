						732572902
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732572902,
					"content": "C'est tout ? Comme vous parliez de rituel, j'ai cru qu'il fallait réciter plein d'incantations incompréhensibles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732572903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732572903,
					"content": "Hmph. Il n'y a que les humains pour faire ça, car ils ne peuvent pas contrôler le pouvoir des éléments d'eux-mêmes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732572904
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732572904,
					"content": "C'est une autre histoire pour les paris, parce que nous avons les mêmes origines que le pouvoir de la khvarena. Par exemple, vous n'avez pas besoin d'incantation pour pouvoir marcher. C'est le même principe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732572905
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732572905,
					"content": "Enfin, même si tu flottes, toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732572906
					],
					"speakerTitle": "Mihir"
				},
