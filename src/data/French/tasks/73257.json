			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sorush"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732570101,
					"content": "Au fait, Sorush n'a pas dit un mot depuis qu'on a quitté la manufacture dans les ruines.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570102,
					"content": "Elle est si bavarde d'habitude que je trouve ça bizarre maintenant qu'elle ne parle plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570103,
						732570104,
						732570105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570103,
					"content": "Sorush a dû être sacrément choquée.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570106
					]
				},
				{
					"id": 732570106,
					"content": "Ne sois pas triste, Sorush ! On a tellement de choses à faire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570107,
					"content": "Par exemple, accomplir ce rituel étrange et reboucher le grand trou dans le ciel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570108,
					"content": "Quand ce sera terminé, on pourra se régaler pour célébrer ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570109,
					"content": "On pourrait manger... Euh, je ne sais pas ce que les paris mangent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570110,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570111
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570111,
					"content": "... Les paris n'ont pas besoin de manger, idiote flottante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570112
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570112,
					"content": "*soupir* Je suis tombée tellement bas que Blanche flottante me console.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570113
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570113,
					"content": "Je préférerais être enfermée dans des cristaux gris ou trouver une caverne pour y dormir pour l'éternité jusqu'à ce que toutes les personnes que je connaisse ne cessent de vivre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570114
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570114,
					"content": "Je t'ai déjà dit que je n'étais pas Blanche flottante ! Et une caverne comme celle-ci existe-t-elle vraiment ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570115,
						732570117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570115,
					"content": "Tu ne résoudras pas le problème en l'évitant.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570116
					]
				},
				{
					"id": 732570116,
					"content": "Je n'en ai plus rien à faire à ce stade !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570119
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570119,
					"content": "Comment suis-je censée digérer la honte de m'être fait manipuler par Nasejuna ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570120
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570120,
					"content": "Maintenant que vous avez tous les hymnes finaux de la khvarena, allez voir Mihir ou Rashnu à l'Éden pour faire disparaître l'anomalie dans le ciel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570121
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570121,
					"content": "En tout cas, laissez-moi tranquille et faites semblant de ne jamais avoir entendu ce que j'ai pu vous dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570122
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570122,
					"content": "Tu nous as dit plein de trucs bizarres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570123,
						732570124,
						732570125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570123,
					"content": "Mon yasnapati ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570126
					]
				},
				{
					"id": 732570126,
					"content": "Arrêtez ! N'en dites pas plus !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570127
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570127,
					"content": "#Arrête de l'embêter, {NICKNAME}. Elle voyage avec nous depuis si longtemps que je ne souhaite pas la voir abandonner à mi-chemin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570128,
					"content": "Et puis, Sorush a aussi des qualités, comme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570129,
					"content": "Tu viens d'hésiter ! Bouhouhou... Arrête de me prendre de haut !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570130,
						732570131
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570130,
					"content": "Tu agis vite.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570132
					]
				},
				{
					"id": 732570132,
					"content": "Absolument ! On a travaillé dur ensemble pour chasser l'anomalie céleste, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570133,
					"content": "C'est grâce à toi qu'on a pu aller aussi loin !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570134,
					"content": "C'était quoi déjà ? Hum, « À ce rythme-là, tu deviendrais bientôt une aventurière de légende »...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570135,
					"content": "C'est vrai ? Vos compliments sont sincères ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570136
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570136,
					"content": "#Oui, c'est de la part des {M#amis}{F#amies}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570137
					]
				},
				{
					"id": 732570137,
					"content": "Héhé ! Je savais que j'étais géniale !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570138
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570138,
					"content": "J'ai retrouvé ma motivation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570139
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570139,
					"content": "Maintenant que Sorush est redevenue elle-même, allons voir Zurvan, chassons ce gros trou du ciel et obtenons la récompense ! J'ai hâte de manger un bon gros repas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570131,
					"content": "Tu as le sens des responsabilités.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570132
					]
				},
				{
					"id": 732570124,
					"content": "Ma vaillance ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570126
					]
				},
				{
					"id": 732570125,
					"content": "Mon sacrifice destiné ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570126
					]
				},
				{
					"id": 732570117,
					"content": "Il te reste des choses à faire, non ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570118
					]
				},
				{
					"id": 732570118,
					"content": "Je sais, mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570119
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570104,
					"content": "C'est normal, après ce qui vient de se passer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570106
					]
				},
				{
					"id": 732570105,
					"content": "Peut-être qu'elle est juste fatiguée ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570106
					]
				}
			]
		},
		{
			"id": 7325702,
			"completionStepIds": [
				7325702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7325702",
							"2"
						],
						"stepId": 7325702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zurvan"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							390.447,
							312.914,
							5703.516
						],
						"pointId": 4535
					}
				]
			},
			"dialogs": [
				{
					"id": 732570201,
					"content": "#Zurvan, on est {M#revenus}{F#revenues} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570202,
					"content": "#Oh, {NICKNAME}, Sorush et Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570203
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570203,
					"content": "On dirait que vous avez réuni tous les hymnes finaux de la khvarena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570204,
						732570205
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570204,
					"content": "Oui, malgré quelques problèmes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570206
					]
				},
				{
					"id": 732570206,
					"content": "Au moins, vous avez réussi. J'ai eu raison de vous faire confiance pour cette mission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570207
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570207,
					"content": "Sans vous, les hymnes finaux seraient sans doute tombés dans de mauvaises mains.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570208
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570208,
					"content": "Pourquoi j'ai l'impression que vous aviez tout vu venir, Zurvan ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570209,
					"content": "Héhé, j'ai visé juste ? Vous avez rencontré les disciples des profondeurs ténébreuses, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570210,
						732570212
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570210,
					"content": "Comment vous le savez ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570211
					]
				},
				{
					"id": 732570211,
					"content": "Et si vous me racontiez ce qui s'est passé plutôt ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570214
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570214,
					"content": "Vous racontez à Zurvan votre aventure dans les ruines souterraines et la trahison de Nasejuna.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732570215
					]
				},
				{
					"id": 732570215,
					"content": "Le vijnanapati de l'Ordre s'est donc allié aux profondeurs ténébreuses. Je ne m'y attendais pas. Enfin, je n'attendais rien d'eux, mais c'est quand même surprenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570216
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570216,
					"content": "Si je ne me trompe pas, Nasejuna a été incité à rechercher les hymnes finaux de la khvarena par le serviteur des profondeurs ténébreuses que vous avez combattu. C'est l'une de mes vieilles connaissances.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570217
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570217,
					"content": "Hein ? Vous connaissez le type de l'Ordre de l'Abîme ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570218,
					"content": "Hmph, c'était un Sceptique. Il y a plusieurs siècles, une équipe d'enquête qui venait de la forêt a exploré les ruines dahriennes dans le but de découvrir leurs secrets.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570219
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570219,
					"content": "Elle a insisté pour pénétrer à l'intérieur malgré les avertissements de l'Ordre. Alors, le vijnanapati de l'époque avait envoyé cette personne pour l'accompagner et assurer sa sécurité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570220
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570220,
					"content": "Personne ne sait ce qui s'est passé dans les ruines, mais lorsque cet individu en est sorti, il avait complètement accepté la bénédiction de la souillure et l'équipe d'enquête était portée disparue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570221
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570221,
					"content": "Les fidèles des profondeurs ténébreuses ont suivi. Ils ont invoqué des hordes de devs pour attaquer l'Éden et mettre la main sur les hymnes finaux de la khvarena qu'ils convoitaient.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570222
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570222,
					"content": "Nous sommes parvenus à défendre nos terres malgré tout, grâce à de nombreux guerriers paris et humains. Cependant, les fidèles des profondeurs ténébreuses n'ont pas été éradiqués.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570223
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570223,
					"content": "Pour m'assurer de ne leur laisser aucune faille à exploiter, j'ai scellé l'Éden et toutes les ruines avec le pouvoir des hymnes finaux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570224
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570224,
					"content": "L'Ordre ne s'est jamais remis de cet incident. Ils ont perdu leurs archives anciennes dans un incendie et sont progressivement devenus ce qu'ils sont aujourd'hui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570225
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570225,
					"content": "J'ai senti qu'ils avaient commencé à bouger depuis notre dernière confrontation, mais je ne m'attendais pas à ce qu'ils entraînent le chef des Sceptiques dans leurs plans.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570226
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570226,
					"content": "Mais je pense encore aux paroles de Nasejuna... Est-ce que vous pouvez nous en dire plus sur les ancêtres des Sceptiques ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570227,
					"content": "C'est vrai que vous avez combattu à leurs côtés.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570228
					]
				},
				{
					"id": 732570228,
					"content": "L'histoire devient légende, la légende devient un récit... C'est de cette façon que nos traditions se perpétuent. L'oubli fait aussi partie de cela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570229
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570229,
					"content": "Plus vous vous accrochez à une tradition et plus vous choisissez les parties de l'histoire que vous souhaitez retenir. À la fin, vous vous noyez dans une mer de récits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570230
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570230,
					"content": "Dans un monde qui oublie facilement, les empreintes que nous laissons sur le sol sont beaucoup plus fiables que les faits chantés dans des hymnes au vent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570231
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570231,
					"content": "C'est pour cette raison que je vous fais confiance. Vous êtes des gens honnêtes qui n'ont que faire du regard des autres !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570232
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570232,
					"content": "Merci pour le compliment, mais je trouve ça un peu bizarre pour une raison qui m'échappe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570233,
					"content": "Je sens un peu de sarcasme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570234
					]
				},
				{
					"id": 732570234,
					"content": "La doyenne Zurvan me vise en particulier...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570235
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570235,
					"content": "En ce qui concerne les événements d'il y a cinq cents ans, je pense que vous préféreriez les connaître de vos propres yeux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570236
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570236,
					"content": "Le moment présent est opportun pour ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570237
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570237,
					"content": "Tu m'as l'air plus assagie maintenant, Sorush. Les épreuves que tu as traversées t'ont sans doute ouvert les yeux sur ces mythes humains, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570238
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570238,
					"content": "Doyenne ! Tout cela appartient au passé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570239
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570239,
					"content": "#Il semblerait que j'aie eu raison de vous confier cette tâche, {NICKNAME} et Paimon. Je peux donc vous laisser l'organisation du rite d'ab-zohr en toute sérénité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570240
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570240,
					"content": "Le rite d'ab-zohr...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570241
					]
				},
				{
					"id": 732570241,
					"content": "Je me souviens que vous nous en aviez déjà parlé ! C'est une cérémonie de purification de la souillure, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570242,
					"content": "Le rite d'ab-zohr est une cérémonie qui a lieu dans le but de nettoyer l'Harvisptokhm de la souillure. En temps normal, il s'effectue sous les arbres qui repoussent les ténèbres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570243
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570243,
					"content": "Cependant, nous avons besoin d'en faire davantage cette fois-ci, à cause du sceau qui faiblit et cette anomalie dans le ciel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570244
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570244,
					"content": "Cette anomalie est apparue au-dessus de l'Harvisptokhm car celui-ci a absorbé une grande quantité de souillure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570245
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570245,
					"content": "En raison de cette accumulation de souillure et de la corrosion causée par l'anomalie, l'Harvisptokhm n'arrive plus à préserver le pouvoir de la khvarena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570246
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570246,
					"content": "La seule chose qu'on puisse faire à présent est d'entrer au sein de l'Harvisptokhm pour le purifier et réveiller notre grande divinité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570247
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570247,
					"content": "On peut entrer dans l'Harvisptokhm ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570248
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570248,
					"content": "Vous pensiez que le rituel de la traversée se faisait dans les profondeurs ténébreuses ? Les paris y succomberaient.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570249
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570249,
					"content": "Au sein de l'Harvisptokhm se trouve un lotus géant : la Gaokerena. La conscience de notre grande divinité sommeille dedans. La fleur de sainteté pourra s'épanouir à nouveau, une fois que la souillure aura été nettoyée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570250
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570250,
					"content": "L'amrita se débarrassera de toutes les impuretés de nos terres. Toutes ces choses peuvent vous paraître un peu compliquées, mais rassurez-vous, cela ne vous empêchera pas d'accomplir ce que vous devez faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570251
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570251,
					"content": "Bon, j'ai déjà envoyé Rashnu et Mihir à la Brèche de Tunigi. Vous n'avez plus qu'à apporter les hymnes finaux pour rassembler le pouvoir de la khvarena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570252
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570252,
					"content": "La khvarena réveillera les grands arbres qui luttent contre la souillure et purifiera la boue des profondeurs. Ensuite, vous pourrez effectuer le rituel de la traversée pour ouvrir la voie vers l'Harvisptokhm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570253
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570253,
					"content": "Une fois à l'intérieur, le chapelet dévoilera les vaillantes actions des héros anciens à Sorush.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570254
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570254,
					"content": "Tous les souvenirs liés à la khvarena finiront par revenir à l'Harvisptokhm et ne disparaîtront jamais, peu importe toutes les fois où les légendes sont réécrites ou modifiées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570255
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570255,
					"content": "C'est la première fois que j'en entends parler !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570256
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570256,
					"content": "Haha, le chapelet est une partie intégrante de l'Harvisptokhm. Tu sauras tout le moment venu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570257
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570257,
					"content": "Maintenant, allez faire disparaître le signe d'Apaosha. Nous nous retrouverons lorsque l'amrita pleuvra du ciel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570212,
					"content": "Oui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570213
					]
				},
				{
					"id": 732570213,
					"content": "Et si vous me racontiez ce qui s'est passé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570214
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570205,
					"content": "#Je suis {M#épuisé}{F#épuisée}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570206
					]
				}
			]
		},
		{
			"id": 7325704,
			"completionStepIds": [
				7325704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7325704",
							"2"
						],
						"stepId": 7325704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rashnu",
					"Mihir",
					"Sorush"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732570401,
					"content": "Sorush prend tout son temps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570402
					],
					"speakerTitle": "Rashnu"
				},
				{
					"id": 732570402,
					"content": "Ça fait longtemps que nous attendons ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570403
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732570403,
					"content": "Je suis fatiguée... Je veux rentrer et dormir... Zzz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570404
					],
					"speakerTitle": "Rashnu"
				},
				{
					"id": 732570404,
					"content": "Hé ! C'est moi qui ai fait tout le travail pendant que vous bayiez aux corneilles !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570405
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570405,
					"content": "Faux ! Nous t'avons attendue, c'est aussi un travail important. L'action est éphémère tandis que l'attente est éternelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570406
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732570406,
					"content": "C'est particulier comme façon de voir les choses...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570407,
					"content": "C'est la philosophie des paris.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570408
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732570408,
					"content": "Enfin, ce n'est pas le moment d'en parler... Les hymnes finaux de la khvarena sont ce qui nous importe à l'heure actuelle. Vous les avez tous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570409
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732570409,
					"content": "Bien sûr !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570410,
					"content": "Dans ce cas, nous allons défaire le sceau. Vous pourrez ensuite rassembler le pouvoir de la khvarena grâce aux hymnes finaux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570411
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732570411,
					"content": "Faites quand même attention à vous. La souillure s'est accumulée depuis des siècles, j'ignore ce qu'elle va manifester quand le sceau sera brisé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mihir"
				}
			]
		},
