					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732571702,
					"content": "Des fleurs ont l'air d'avoir poussé sur l'arbre. Que devrions-nous faire ensuite ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732571703,
					"content": "Ne me regardez pas, je n'en ai aucune idée non plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571704
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732571704,
					"content": "Sorush a le chapelet à deux cornes en sa possession, pas vrai ? Elle n'a qu'à se connecter aux souvenirs et à la sagesse de l'Harvisptokhm en l'utilisant.",
					"roleType": "TALK_ROLE_NPC",
