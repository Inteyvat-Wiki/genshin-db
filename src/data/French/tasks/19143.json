			"dialogs": [
				{
					"id": 191431001,
					"content": "Qu'est-ce qu'on fait ? On ne joue plus à l'Invocation des Sept ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431002
					],
					"speakerTitle": "Souta"
				},
				{
					"id": 191431002,
					"content": "On peut jouer ailleurs ? Mais à part sous le pont, il n'y a aucun endroit où l'on peut être tranquilles sans se faire repérer par les adultes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431003
					],
					"speakerTitle": "Eita"
				},
				{
					"id": 191431003,
					"content": "Ah, j'ai une idée ! On pourrait demander à Yoimiya de lâcher des feux d'artifice pour effrayer le gars qui nous a volé notre coin !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431004
					],
					"speakerTitle": "Souta"
				},
				{
					"id": 191431004,
					"content": "C'est pas très gentil, non ? Même si c'est lui qui nous a fait partir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431005
					],
					"speakerTitle": "Eita"
				},
				{
					"id": 191431005,
					"content": "Ce sera bien fait pour lui !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431006
					],
					"speakerTitle": "Souta"
				},
				{
					"id": 191431006,
					"content": "Peut-être qu'on devrait juste rentrer et faire nos devoirs ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431007
					],
					"speakerTitle": "Yuma"
				},
				{
					"id": 191431007,
					"content": "Les enfants qui passent leur temps à jouer sans se préoccuper de l'école deviennent <color=#00E1FFFF>des adultes qui traînent sous les ponts</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuma"
				}
			]
		},
