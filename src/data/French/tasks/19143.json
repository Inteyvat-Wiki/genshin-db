			"dialogs": [
				{
					"id": 191430901,
					"content": "J'étais en train de faire le ménage dans mon établissement quand j'ai entendu un bruit violent qui venait de l'extérieur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191430902
					],
					"speakerTitle": "Aikawa Susumu"
				},
				{
					"id": 191430902,
					"content": "À peine ai-je eu le temps de sortir qu'une <color=#00E1FFFF>silhouette sombre a disparu en haut de l'arbre</color> !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191430903
					],
					"speakerTitle": "Aikawa Susumu"
				},
				{
					"id": 191430903,
					"content": "Cette rue est très fréquentée. J'espère que ce n'est pas un voleur...",
