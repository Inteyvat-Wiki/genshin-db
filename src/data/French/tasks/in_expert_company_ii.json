			"dialogs": [
				{
					"id": 741140201,
					"content": "*soupir* J'espère que les films n'ont pas été endommagés par l'eau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140202
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 741140202,
					"content": "Ne vous inquiétez pas, patronne. La boîte a été bien fermée, l'eau ne rentrera pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140203
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 741140203,
					"content": "C'est une bonne chose que notre Kinétoscope n'est pas tombé à l'eau, sinon ça aurait été la goutte d'eau qui fait déborder le vase...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xingye"
				}
			]
