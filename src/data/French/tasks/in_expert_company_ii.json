			"dialogs": [
				{
					"id": 741140101,
					"content": "Pas de souci, notre boîte est étanche. Il n'y a qu'à plonger sous l'eau pour la chercher...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140102
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 741140102,
					"content": "Patronne, personne ne sait faire de la plongée ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140103
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 741140103,
					"content": "Je sais nager, mais la plongée, c'est un autre monde pour moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140104
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 741140104,
					"content": "Est-ce que notre annonce à la Guilde des aventuriers est encore affichée sur le panneau ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140105
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 741140105,
					"content": "Ce n'était pas vous qui aviez dit qu'il fallait se dépêcher de la retirer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140106
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 741140106,
					"content": "On a fait ça hier. La Guilde nous a dit qu'elle pourrait nous rembourser les frais de publication de l'annonce aujourd'hui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140107
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 741140107,
					"content": "Hum... Si nous voulons remettre une annonce, il faudra payer des frais de service supplémentaires...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140108,
						741140109
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 741140108,
					"content": "Vous avez fini de tourner ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140110
					]
				},
				{
					"id": 741140110,
					"content": "#Ah, c'est vous... {NICKNAME} ! Vous tombez à pic !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140111
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 741140111,
					"content": "Vous savez plonger ? Ou pourriez-vous me trouver quelqu'un qui sache le faire et qui a du temps libre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140112
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 741140112,
					"content": "Vous voulez tourner une scène sous l'eau ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140113
					]
				},
				{
					"id": 741140113,
					"content": "Nous ne sommes pas si doués que ça. De plus, nous n'avons pas les moyens d'acheter du matériel étanche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140114
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 741140114,
					"content": "C'est juste que la boîte qui contient tous nos films est tombée à l'eau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140115
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 741140115,
					"content": "#Assez parlé, vous deux ! {NICKNAME}, aidez-nous, s'il vous plaît.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140116
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 741140116,
					"content": "Ne vous inquiétez pas pour la rémunération, je vous paierai en personne, comme la fois dernière.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 741140109,
					"content": "Que faites-vous ici ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140110
					]
				}
			]
		},
