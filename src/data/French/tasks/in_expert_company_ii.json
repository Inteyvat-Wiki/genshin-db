			},
			"dialogs": [
				{
					"id": 741140601,
					"content": "#{NICKNAME}, j'aimerais vous présenter à un maître de l'éclairage, monsieur Geisert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140602
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 741140602,
					"content": "#Monsieur Geisert, voici {NICKNAME}. C'est {M#un aventurier très compétent}{F#une aventurière très compétente}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140603
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 741140603,
					"content": "#Si vous prévoyez de tourner un film d'action, pensez à {M#lui}{F#elle} pour le premier rôle !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140604
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 741140604,
					"content": "Haha, madame Qiu exagère. Je ne suis pas aussi bon qu'elle le prétend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140605
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140605,
					"content": "Je suis juste quelqu'un qui sait s'y prendre avec les lumières pendant le tournage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140606
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140606,
					"content": "Vous êtes si modeste. L'éclairage dans vos films parle de lui-même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140607,
						741140609
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 741140607,
					"content": "Les lumières pendant le tournage ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140608
					]
				},
				{
					"id": 741140608,
					"content": "C'est exact. Ma théorie est que l'utilisation de la lumière doit refléter les émotions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140611
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140611,
					"content": "Mais... Comment dire... Personne n'accorde d'importance à ces propos dans l'industrie du cinéma de Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140612
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140612,
					"content": "La plupart des réalisateurs préfèrent utiliser des mouvements directs ou le décor de la scène.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140613
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140613,
					"content": "J'ai tourné des films seulement en utilisant des transitions de lumière pour raconter une histoire, mais ils n'ont intéressé personne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140614
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140614,
					"content": "Enfin, il y a quand même une réalisatrice qui a trouvé que ma théorie était pertinente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140615
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140615,
					"content": "Moi, une réalisatrice ? Hahaha, vous plaisantez ? J'étais seulement une marchande de thé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140616
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 741140616,
					"content": "Qui dit qu'une marchande de thé ne peut pas être une réalisatrice ? J'étais moi-même un journaliste par le passé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140617
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140617,
					"content": "Un journaliste... Alors, vous devez savoir rédiger des articles ? Comme ceux de la presse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140618
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 741140618,
					"content": "Oui, en quelque sorte. Pourquoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140619
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140619,
					"content": "Hum, ça tombe bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140620
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 741140620,
					"content": "Ah ! Rien du tout ! Passons à table ! Nous aurons tout le temps du monde pour travailler ensemble plus tard, hahaha !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140621
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 741140621,
					"content": "Tout le monde s'assied sous les rires francs de madame Qiu.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741140622
					]
				},
				{
					"id": 741140622,
					"content": "Après le repas, madame Qiu prépare un plat en plus et le met dans votre sac une fois emballé...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 741140609,
					"content": "C'est important l'éclairage quand on tourne des films ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140610
					]
				},
				{
					"id": 741140610,
					"content": "Bien sûr. C'est l'élément clé pour exprimer l'ambiance d'une scène, d'après ma théorie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140611
					],
					"speakerTitle": "Geisert"
				}
			]
		},
