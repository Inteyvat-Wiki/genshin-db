			"dialogs": [
				{
					"id": 741140401,
					"content": "C'est une marmite assez étrange, mais... Hmm... Elle doit pouvoir être utilisée comme celles de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140402
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 741140402,
					"content": "Patronne, j'ai tout acheté à part de la marcotte. Il n'y en avait plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140403
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 741140403,
					"content": "Je n'ai pas trouvé d'autre magasin qui en vend...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140404
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 741140404,
					"content": "#C'est... le dernier ingrédient qu'il nous fallait. Euh, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140405,
						741140406
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 741140405,
					"content": "Je vais aller le chercher.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140407
					]
				},
				{
					"id": 741140407,
					"content": "Merci pour votre aide. Ne vous en faites pas, je sais comment ça marche avec les aventuriers. Ce service sera évidemment payé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 741140406,
					"content": "Rajoutez ça à ma paie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140407
					]
				}
			]
		},
