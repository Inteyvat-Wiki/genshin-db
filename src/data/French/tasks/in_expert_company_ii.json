			"dialogs": [
				{
					"id": 741140301,
					"content": "#Ah, vous êtes {M#génial}{F#géniale}, {NICKNAME}. Vraiment !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140302
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 741140302,
					"content": "Sans vous, nous aurions perdu tous nos travaux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140303
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 741140303,
					"content": "Nous devons retourner en ville pour remettre les films à monsieur Geisert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140304
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 741140304,
					"content": "#Ensuite, nous irons manger. Vous pouvez venir aussi, si ça vous dit, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140305
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 741140305,
					"content": "Je vous donnerai la récompense après manger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140306,
						741140307
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 741140306,
					"content": "D'accord.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140308
					]
				},
				{
					"id": 741140308,
					"content": "Super ! Eh bien, marché conclu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140309
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 741140309,
					"content": "Yifeng, tu apporteras les films de la boîte à monsieur Geisert plus tard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140310
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 741140310,
					"content": "Xingye, va acheter des légumes dans le coin. Je me suis entraînée à préparer de la soupe fraîche de Poisson et je veux montrer à monsieur Geisert ce que je sais faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140311
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 741140311,
					"content": "Patronne, nous allons manger dans un restaurant. Pourquoi vous devez encore faire les choses vous-même ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140312
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 741140312,
					"content": "Pour faire moins de dépenses...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140313
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 741140313,
					"content": "Ahem ! C'est bon, allons-y.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140314
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 741140314,
					"content": "#Suivez-moi, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 741140307,
					"content": "Ça tombe bien, j'ai un petit creux.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140308
					]
				}
			]
		},
