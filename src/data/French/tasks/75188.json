						"stepId": 7518804,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paqarin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751880401,
					"content": "Mes trois petits sont de retour. C'est sûrement grâce à vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880402
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880402,
					"content": "#Merci pour votre gentillesse, {M#courageux passant}{F#courageuse passante}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880403
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880403,
					"content": "J'ai encore mal au dos, mais je me sens beaucoup mieux en compagnie de mes petits sauriens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880404
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880404,
					"content": "Je ne suis pas très riche, mais je peux quand même vous donner une petite récompense. Prenez ceci en guise de remerciement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paqarin"
				}
			]
		}
	]
}