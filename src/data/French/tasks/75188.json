			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paqarin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751880101,
					"content": "Pourriez-vous vous rendre dans les champs pour voir si vous pouvez trouver mes <color=#00E1FFFF>trois petits sauriens</color> ? Ramenez-les-moi, s'il vous plaît.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paqarin"
				}
			]
		},
		{
			"id": 7518802,
			"completionStepIds": [
				7518802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7518802",
							"2"
						],
						"stepId": 7518802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paqarin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751880201,
					"content": "Hé, vous là ! Oui, vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880202
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880202,
					"content": "#Vous avez une telle impulsion dans votre démarche, puis à en juger la vitesse à laquelle vous courez... Je sais que vous êtes {M#fort}{F#forte}, comme quelqu'un qui fait de la musculation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880203
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880203,
					"content": "#Êtes-vous {M#un guerrier}{F#une guerrière} du Collectif de l'abondance ? Ou d'une autre tribu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880204,
						751880205
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880204,
					"content": "#Je ne suis qu'{M#un aventurier}{F#une aventurière} de passage.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751880206
					]
				},
				{
					"id": 751880206,
					"content": "Je vois, c'est dommage. *soupir* Ce n'est que dans les rêves qu'on croise quelqu'un prêt à nous aider quand on en a besoin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880207
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880207,
					"content": "Qu'y a-t-il ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751880208
					]
				},
				{
					"id": 751880208,
					"content": "Comme vous l'avez certainement remarqué, j'ai une ferme ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880209
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880209,
					"content": "Je m'en suis toujours occupé seul, mais je n'ai pas eu beaucoup de chance ces derniers temps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880210
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880210,
					"content": "Il y a quelques jours, j'ai participé à un combat de lutte avec un guerrier de la tribu et je me suis blessé au dos. Oui, je sais, c'était stupide de ma part...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880211
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880211,
					"content": "Du coup, je ne peux pas aider mon vieux père à défricher de nouveaux champs, ni m'occuper de ma propre ferme. Honnêtement, même le simple fait de marcher me fait mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880212
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880212,
					"content": "#Je pensais justement à engager quelqu'un pour m'aider pendant quelques jours lorsque vous êtes {M#apparu}{F#apparue}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880213
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880213,
					"content": "C'est dommage que vous ne soyez que de passage. Le travail à la ferme demande des efforts et de l'attention au quotidien. Si vous n'êtes là que de temps à autre, mes récoltes seront perdues.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880214
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880214,
					"content": "Pour l'instant, je n'ai malheureusement pas la force de me rendre jusqu'à la tribu pour trouver quelqu'un. *soupir* À part les quelques petits tatankasaures que j'ai élevés, personne d'autre ne peut m'aider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880215
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880215,
					"content": "Ces petites canailles n'en ont fait qu'à leur tête ces derniers jours. Ils ont paressé tous les trois dans les champs et ne sont pas revenus me voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880216
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880216,
					"content": "Pourriez-vous me rendre un petit service, s'il vous plaît ? J'aimerais que vous me les rameniez, comme j'ai beaucoup de mal à marcher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880217
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880217,
					"content": "D'accord, pas de problème.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751880218
					]
				},
				{
					"id": 751880218,
					"content": "Merci, c'est gentil. Ils se comportent généralement bien et me tiennent souvent compagnie quand je travaille dans les champs. Je ne sais pas ce qui leur est arrivé ces derniers jours...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880219
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880219,
					"content": "Si vous les appelez, je suis sûr... Enfin, plutôt sûr qu'ils reviendront d'eux-mêmes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880205,
					"content": "Je ne viens pas de Natlan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751880206
					]
				}
			]
		},
		{
			"id": 7518804,
			"completionStepIds": [
				7518804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
