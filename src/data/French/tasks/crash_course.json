			"dialogs": [
				{
					"id": 3071501,
					"content": "Bravo ! Excellent !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071502
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071502,
					"content": "#Je ne savais pas que tu étais {M#un combattant entraîné}{F#une combattante entraînée}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071503
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071503,
					"content": "Les combats que tu as livrés tout à l'heure valaient le coup d'œil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071504,
						3071505
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071504,
					"content": "Merci, vous me flattez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3071506
					]
				},
				{
					"id": 3071506,
					"content": "Hahaha, une modestie digne d'un chevalier !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071507
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071507,
					"content": "Tes exploits pour le salut de Mondstadt seront connus de tous pour les générations à venir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071508
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071508,
					"content": "Rends-moi visite au quartier général de l'Ordre quand tu auras du temps libre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071509
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071509,
					"content": "Je connais aussi une bonne taverne, si cela t'intéresse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071505,
					"content": "Ce n'est rien d'extraordinaire.",
					"roleType": "TALK_ROLE_PLAYER",
