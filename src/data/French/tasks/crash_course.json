			"dialogs": [
				{
					"id": 3071101,
					"content": "Te voilà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071102
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071102,
					"content": "Approche-toi. Tu sens cette odeur ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071103,
						3071104
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071103,
					"content": "... Non.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3071105
					]
				},
				{
					"id": 3071105,
					"content": "Quelque chose a dû se passer dans le <color=#00E1FFFF>temple</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071106
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071106,
					"content": "J'imagine qu'on va y trouver des Blobs, des Brutocollinus et... tout ce qui tire son pouvoir de Stormterror.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071107
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071107,
					"content": "Il y aura de l'animation, crois-moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071108,
						3071110
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071108,
					"content": "Ça sera dangereux pour nous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3071109
					]
				},
				{
					"id": 3071109,
					"content": "Je pense que ça devrait aller.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071112
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071112,
					"content": "Quel dommage que le Temple du Loup ait été profané de la sorte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071113
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071113,
					"content": "#Allons-y, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071114
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071114,
					"content": "Plus personne ne vient faire d'offrande aux Quatre Vents, mais les vents anciens ne se sont pas dissipés...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071115
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071115,
					"content": "Aujourd'hui, on va faire un peu de ménage en leur nom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071110,
					"content": "On y trouvera sans doute juste une flopée de monstres pas très futés.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3071111
					]
				},
				{
					"id": 3071111,
					"content": "Quelle assurance !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071112
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071104,
					"content": "Ça sent le Pyroblob brûlé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3071105
					]
				}
			]
		},
