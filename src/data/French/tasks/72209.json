				"points": []
			},
			"dialogs": [
				{
					"id": 722090101,
					"content": "Un autre jour tranquille...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090102,
					"content": "Miaou, vous êtes là. J'ai bien dormi après que vous avez nettoyé le sanctuaire... Miaou miaou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090103
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090103,
					"content": "Ces deux humains en vert sont aussi passés hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090104,
					"content": "Mais personne d'autre n'est venu prier... C'est très étrange...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090105,
					"content": "Quand ces deux humains verts sont venus, ils n'arrêtaient pas de parler de ce support en bois, miaou miaou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090106
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090106,
					"content": "Hibiki appelait ces petites plaquettes des « Emma », je crois. Puis ce support en bois, « un portique d'Emma ». Beaucoup de gens venaient au sanctuaire pour ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090107
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090107,
					"content": "Hmm... Est-ce que ça veut dire que les humains aiment particulièrement le bois ? Ils accrochaient leurs petites plaquettes sur le support après avoir mis quelques moras dans la boîte à offrandes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090108
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090108,
					"content": "Je ne pense pas que ce soit à propos du bois...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090109
					]
				},
				{
					"id": 722090109,
					"content": "Ah bon ? Les humains aiment une divinité protectrice du nom d'Emma alors ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090110,
						722090111
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090110,
					"content": "Emma ? Qui c'est ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090112
					]
				},
				{
					"id": 722090112,
					"content": "Dans tous les cas, le support est cassé et les plaquettes sont de moins en moins nombreuses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090113
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090113,
					"content": "Je ne sais pas ce que vous avez avec le bois ou Emma, mais un sanctuaire ne peut pas se passer de ces choses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090114
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090114,
					"content": "Ce doit être parce que le support est en piteux état et que le sanctuaire est à court de bois que personne ne vient plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090115
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090115,
					"content": "J'aimerais donc vous demander un autre service : réparez ce portique d'Emma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090116,
						722090121
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090116,
					"content": "On s'en charge.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090117
					]
				},
				{
					"id": 722090117,
					"content": "Maintenant que j'y pense, il doit nous rester des matériaux de la dernière fois, non ? Quand on a réparé la boîte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722090118,
					"content": "Qu'est-ce que j'en sais moi... Pourquoi les humains aiment autant le bois ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090119
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090119,
					"content": "Euh, vous savez quoi, laissez tomber... Je me souviens qu'il nous restait des matériaux. Inspectons les environs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722090120,
					"content": "Quoi qu'il en soit, je vous laisse vous occuper du portique en bois. Ce sanctuaire ne va pas se gérer tout seul, alors je reste ici, miaou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090129
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090129,
					"content": "Une fois que le portique et la boîte seront en état, je suis sûre que les humains afflueront.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090121,
					"content": "Depuis quand est-il dans cet état ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090122
					]
				},
				{
					"id": 722090122,
					"content": "Très longtemps. Il était cassé avant la boîte, et ça faisait très longtemps que la boîte était cassée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090123
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090123,
					"content": "Admettez que vous n'en savez rien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722090124,
					"content": "Ah. Je ne fais pas particulièrement attention au nombre de fois où le soleil se lève et se couche, vous savez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090125
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090125,
					"content": "Bon, on devrait avoir des matériaux qu'il nous reste de la fois où on a réparé la boîte, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722090126,
					"content": "Qu'est-ce que j'en sais moi... Pourquoi les humains aiment autant le bois ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090127
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090127,
					"content": "Euh, vous savez quoi, laissez tomber... Je me souviens qu'il nous restait des matériaux. Inspectons les environs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722090128,
					"content": "Quoi qu'il en soit, je vous laisse vous occuper du portique en bois. Ce sanctuaire ne va pas se gérer tout seul, alors je reste ici, miaou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090129
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090111,
					"content": "Ça n'a rien à voir avec ça non plus...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090112
					]
				}
			]
		},
