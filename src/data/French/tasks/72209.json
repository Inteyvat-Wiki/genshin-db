			"dialogs": [
				{
					"id": 722090501,
					"content": "Tu as fait un sacré bon boulot, dis donc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090502,
						722090503
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722090502,
					"content": "Merci.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090504
					]
				},
				{
					"id": 722090504,
					"content": "Par contre, on n'arrive plus du tout à distinguer ce qu'il y a sur ces ema. Depuis combien de temps sont-ils ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090505
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722090505,
					"content": "Etsuko ! Regarde, j'ai fabriqué des ema à partir de planches en bois que j'ai trouvées à proximité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090506
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090506,
					"content": "Maintenant que le portique est réparé, il faut en accrocher de nouveaux, héhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090507
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090507,
					"content": "Est-ce que tu as des souhaits que tu veux réaliser ? Je peux les dessiner pour toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090508
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090508,
					"content": "Accrocher un ema ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090509
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722090509,
					"content": "Haha, pourquoi pas... Donne-moi un ema, je vais dessiner dessus moi-même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090510
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722090510,
					"content": "On dirait qu'ils sont partis pour accrocher des ema sur le portique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722090511,
					"content": "Allons annoncer la nouvelle à Neko. Elle en sera ravie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722090503,
					"content": "Je m'y connais un peu en réparation.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
