			"dialogs": [
				{
					"id": 722090201,
					"content": "Ce portique d'ema a l'air cassé depuis bien longtemps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090202
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090202,
					"content": "Que faites-vous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090203
					]
				},
				{
					"id": 722090203,
					"content": "#Oh, {M#voyageur}{F#voyageuse}. Etsuko et moi sommes en train d'inspecter les environs de ce sanctuaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090204
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090204,
					"content": "Les locaux sont en ruine depuis longtemps, mais tout y est encore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090205
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090205,
					"content": "Les gens des villages avoisinants venaient sans doute prier ici. Je pense que l'état décrépit de ce sanctuaire est en rapport avec l'abandon du Village de Koseki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taisuke"
				}
			]
		},
		{
			"id": 7220903,
			"completionStepIds": [
				7220904
			],
