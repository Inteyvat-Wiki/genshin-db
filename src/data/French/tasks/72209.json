					"Neko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722090301,
					"content": "Miaou miaou miaou, le support en bois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090302
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090302,
					"content": "Je l'ai réparé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090303
					]
				},
				{
					"id": 722090303,
					"content": "Oh ! Vraiment ? Ah, ce sanctuaire revient de plus en plus à la vie ! Miaou miaou !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090304
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090304,
					"content": "Maintenant, dites à ces deux humains en vert que le support a été réparé et qu'ils peuvent y accrocher des plaquettes en bois. D'ailleurs, ils peuvent dire à d'autres humains de visiter le sanctuaire et de mettre des moras dans la boîte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090305
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090305,
					"content": "Pourquoi ne pas leur dire vous-même ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090306
					]
				},
				{
					"id": 722090306,
					"content": "J—Je... Ce grand humain en vert me fait peur. Il peut lire dans les pensées des chats... Je ne fais pas le poids face à lui, miaou miaou !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090307
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090307,
					"content": "Puis il est un peu trop enthousiaste à chaque fois que je lui parle... Miaou miaou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
		{
			"id": 7220904,
			"completionStepIds": [
				7220905
