			"dialogs": [
				{
					"id": 722090601,
					"content": "J'ai vu que ces deux humains en vert étaient en train d'accrocher des Emma. Je savais que je pouvais compter sur vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090602
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090602,
					"content": "Une fois qu'ils auront terminé, je suis certaine qu'ils en parleront aux autres humains, qui visiteront le sanctuaire à leur tour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090603
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090603,
					"content": "Miaou miaou miaou... Ce support en bois est aussi important que le ménage et la réparation de la boîte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090604
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090604,
					"content": "C'est bien, miaou miaou miaou ! À ce rythme, le sanctuaire sera bientôt aussi vivant qu'avant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090605
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090605,
					"content": "Pourquoi voulez-vous restaurer cet endroit ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090606
					]
				},
				{
					"id": 722090606,
					"content": "Miaou. Pourquoi ? Eh bien, c'est mon devoir de grande prêtresse suppléante. Je dois m'occuper du sanctuaire, faire en sorte que plein d'humains le visitent et le faire vivre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090607
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090607,
					"content": "Et puis, Hibiki sera triste si le sanctuaire est en mauvais état quand elle revient.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090608
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090608,
					"content": "Miaou miaou, mais ça ne devrait plus être un problème grâce à votre aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090609
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090609,
					"content": "Je ferai peut-être encore appel à vous plus tard. Je vous prie de ne pas décliner le moment venu, miaou miaou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
