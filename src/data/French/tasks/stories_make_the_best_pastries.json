			"dialogs": [
				{
					"id": 742480101,
					"content": "Mademoiselle Columbina, mademoiselle Sandrone ! Merci d'avoir trouvé le temps de rejoindre notre Troupe de plateau !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480102
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 742480102,
					"content": "Tout le plaisir est pour nous. Nous n'avons jamais vraiment joué à ça auparavant, alors nous comptons sur vous pour nous montrer les ficelles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480103
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742480103,
					"content": "Ne vous inquiétez pas, il n'y a aucune pression. Le plus important, c'est que tout le monde s'amuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480104
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 742480104,
					"content": "C'est génial ! J'ai vraiment hâte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480105
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 742480105,
					"content": "Permettez-moi de vous présenter brièvement le contexte de cette histoire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480106
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 742480106,
					"content": "« C'est une époque où vampires et humains coexistent, et l'histoire se déroule dans une ville où vivent ces deux races... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480107
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Jouée par Clorinde"
				},
				{
					"id": 742480107,
					"content": "« Les relations entre humains et vampires ne sont ni totalement opposées, ni véritablement harmonieuses. Et un meurtre survenu en pleine nuit est venu briser cet équilibre fragile... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480108
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Jouée par Clorinde"
				},
				{
					"id": 742480108,
					"content": "Des vampires ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480109
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 742480109,
					"content": "C'est une race qui survit en buvant du sang humain. C'est un thème très courant dans les romans fantastiques. Avez-vous déjà lu des histoires de ce genre, mademoiselle Columbina ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480110
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 742480110,
					"content": "#Hmm, je crois que j'en ai déjà entendu parler. Que fait-on dans cette histoire{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480111
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 742480111,
					"content": "D'abord, chacune doit décider quel personnage elle veut incarner. Il suffit que cela corresponde au contexte, l'identité et la profession sont libres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480112
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 742480112,
					"content": "Quel personnage est-ce que je veux incarner...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480113
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 742480113,
					"content": "Si vous avez du mal à choisir, vous pouvez aussi demander à quelqu'un d'autre de décider à votre place et de définir votre personnage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480114
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 742480114,
					"content": "Oh ? Vous voulez dire... laisser quelqu'un d'autre écrire notre histoire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480115
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742480115,
					"content": "Oh ! Ça a l'air amusant ! Faisons toutes ça ! Je vous laisse créer mon personnage, Clorinde !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480116
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 742480116,
					"content": "Dans ce cas, je te confie mon personnage, Sandrone. J'en concevrai aussi un qui te correspond.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480117
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 742480117,
					"content": "Ha... d'accord. De toute façon, je ne savais pas trop quoi choisir comme profession pour coller à l'histoire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480118
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742480118,
					"content": "Tout le monde a fini ? Héhé, je vais commencer par regarder le mien !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480119
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 742480119,
					"content": "« Je suis une marchande qui parcourt habituellement les villes où cohabitent humains et vampires... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480120
					],
					"speakerTitle": "Navia",
					"speakerSubtitle": "Marchande"
				},
				{
					"id": 742480120,
					"content": "#Attendez, meneuse de jeu, ça ne ressemble pas à ma fiche de personnage d'avant ? Même les statistiques sont identiques ! Vous avez choisi la facilité{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480121
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 742480121,
					"content": "De toute façon, peu importe ce que je vous donne, vous trouverez toujours un moyen étrange de détourner l'histoire. Et puis, ce genre de personnage vif et exubérant vous correspond plutôt bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480122
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 742480122,
					"content": "... Hé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480123
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 742480123,
					"content": "Haha. Voyons voir qui je suis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480124
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 742480124,
					"content": "« Je suis une grande méchante vampire. Le jour, j'aime dormir chez moi, et je ne sors me promener dans le jardin que lorsque la lune se lève... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480125
					],
					"speakerTitle": "Columbina",
					"speakerSubtitle": "Grande méchante vampire"
				},
				{
					"id": 742480125,
					"content": "« J'aime chanter, et j'utilise mes chansons pour attirer mes proies. Aucun de ceux qui croisent mon regard ne revoit le lever du soleil. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480126
					],
					"speakerTitle": "Columbina",
					"speakerSubtitle": "Grande méchante vampire"
				},
				{
					"id": 742480126,
					"content": "Hmm... Est-ce que c'est comme ça que tu me vois, Sandrone ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480127
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 742480127,
					"content": "Héhé, tu ne trouves pas que ça te va bien ? En plus, c'est un personnage fascinant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480128
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742480128,
					"content": "D'accord, mais je veux quand même faire de mon mieux pour être une bonne vampire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480129
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 742480129,
					"content": "Fais comme tu le souhaites. Bon, voyons voir le mien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480130
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742480130,
					"content": "« Je suis une noble demoiselle élégante. J'aime rester dans ma chambre à bricoler quelques inventions. J'ai tendance à me coucher tard et mon rythme de vie est assez irrégulier... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480131
					],
					"speakerTitle": "Sandrone",
					"speakerSubtitle": "Chasseuse de vampires"
				},
				{
					"id": 742480131,
					"content": "Hé ! Quel genre de personne se présente comme ça ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480132
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742480132,
					"content": "Hmm... « Mais je suis aussi une chasseuse de vampires. Dès que la ville est en danger, je sors avec mes inventions pour sauver tout le monde... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480133
					],
					"speakerTitle": "Sandrone",
					"speakerSubtitle": "Chasseuse de vampires"
				},
				{
					"id": 742480133,
					"content": "Hein ? Ça ne me ressemble pas du tout !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480134
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742480134,
					"content": "Tu ne trouves pas ? Moi je trouve que ça te ressemble tout à fait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480135
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 742480135,
					"content": "À en juger par ces présentations, on dirait que les personnages de mademoiselle Columbina et de mademoiselle Sandrone devraient être des ennemies jurées !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480136
					],
					"speakerTitle": "Navia",
					"speakerSubtitle": "Marchande"
				},
				{
					"id": 742480136,
					"content": "Hmm, on dirait que cette histoire va prendre d'intéressantes tournures.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480137
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Jouée par Clorinde"
				},
				{
					"id": 742480137,
					"content": "Oh, j'ai hâte !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480138
					],
					"speakerTitle": "Navia",
					"speakerSubtitle": "Marchande"
				},
				{
					"id": 742480138,
					"content": "Haha... J'ai l'impression que cette histoire ne sera pas des plus faciles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480139
					],
					"speakerTitle": "Sandrone",
					"speakerSubtitle": "Chasseuse de vampires"
				},
				{
					"id": 742480139,
					"content": "Tu as peur, Sandrone ? Parce que je suis une grande méchante vampire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480140
					],
					"speakerTitle": "Columbina",
					"speakerSubtitle": "Grande méchante vampire"
				},
				{
					"id": 742480140,
					"content": "Ha ! La seule chose qui me fait peur, c'est de rater l'occasion de mettre une raclée à ton personnage !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sandrone",
					"speakerSubtitle": "Chasseuse de vampires"
				}
			]
		},
