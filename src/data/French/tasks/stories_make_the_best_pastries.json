					"content": "Cette Troupe de plateau est vraiment intéressante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480202,
						742480203
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 742480202,
					"content": "(Rester encore ici un moment.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480204
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742480204,
					"content": "Oui, même les « grandes méchantes vampires » doivent rentrer à la maison.",
					"roleType": "TALK_ROLE_NPC",
