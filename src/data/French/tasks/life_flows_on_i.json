			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 414210601,
					"content": "Eau ici... douce. Pareille que Endora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210602
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210602,
					"content": "Endora fait eau douce... Rhodeia fait eau amère.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210603
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210603,
					"content": "Euh, question : il n'y avait pas une légende portant sur une fée de source à Deauclaire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210604,
					"content": "Enfin, commençons par nous dépêcher d'aller remplacer l'eau de cette bouteille par de l'eau qui n'est pas amère.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4142107,
			"completionStepIds": [
				4142107
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4142107",
							"2"
						],
						"stepId": 4142107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Finch"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414210701,
					"content": "... Qui tu es ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210702
					],
					"speakerTitle": "Finch"
				},
				{
					"id": 414210702,
					"content": "Aaah, Endora ! Comment tu as fait pour sortir ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210703,
					"content": "Je suis... Endora. Je suis... fée de source.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210704
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210704,
					"content": "On dirait bien que le vieux Finch a l'air d'être de ceux qui croient en l'existence des fées de source.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210705,
					"content": "... Hmm hmm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210706
					],
					"speakerTitle": "Finch"
				},
				{
					"id": 414210706,
					"content": "Tu lui ressembles comme... deux gouttes d'eau. Même si tu es encore petite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210707
					],
					"speakerTitle": "Finch"
				},
				{
					"id": 414210707,
					"content": "Petite mais... apprendre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210708
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210708,
					"content": "Enfin, de te voir apparaître comme ça m'aura au moins confirmé que tout ça n'était pas un rêve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210709
					],
					"speakerTitle": "Finch"
				},
				{
					"id": 414210709,
					"content": "Elle est encore là. Connais pas... nom. Elle... répond pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210710
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210710,
					"content": "Veux... lui parler. Peux... faire passer message. Toi vouloir dire quelque chose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210711
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210711,
					"content": "Tu veux dire qu'elle... qu'elle est ici depuis tout ce temps ? Et que tu peux lui parler pour moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210712
					],
					"speakerTitle": "Finch"
				},
				{
					"id": 414210712,
					"content": "Oui, oui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210713
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210713,
					"content": "... Hmm hmm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210714
					],
