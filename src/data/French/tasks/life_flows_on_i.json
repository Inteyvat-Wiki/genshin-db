			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Catherine"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414210101,
					"content": "#Bonjour {M#voyageur}{F#voyageuse}. Ça fait un moment qu'on ne s'est pas {M#vus}{F#vues}, non ? Comment vas-tu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210102
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 414210102,
					"content": "Il s'est encore passé quelque chose de bizarre, Catherine ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210103,
					"content": "Comparé à d'autres événements récents, ce n'est pas si bizarre que ça. Mais c'est directement lié à l'économie de Mondstadt, et ça m'embête assez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210104,
						414210105
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 414210104,
					"content": "De quoi s'agit-il ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210106
					]
				},
				{
					"id": 414210106,
					"content": "L'eau de la source située près de la vinerie est devenue amère sans raison apparente ces derniers temps. Ce qui est très mauvais pour l'industrie locale du vin si ça continue de la sorte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210107
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 414210107,
					"content": "Allez voir Connor au Domaine de l'Aurore, il vous en dira plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Catherine"
				},
				{
					"id": 414210105,
					"content": "« L'économie de Mondstadt » ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210106
					]
				}
			]
		},
		{
			"id": 4142102,
			"completionStepIds": [
				4142102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4142102",
							"2"
						],
						"stepId": 4142102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Connor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414210201,
					"content": "Ah, c'est vous que la Guilde des aventuriers envoie ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210202
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 414210202,
					"content": "C'est nous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210203,
					"content": "Me voilà rassuré alors. Bien, mieux vaut que vous voyiez de vous-même de quoi il s'agit, ce sera plus rapide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210204
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 414210204,
					"content": "L'eau de cette bouteille a été extraite il y a peu, et a subi toutes les étapes de purification ; elle est propre et potable, c'est garanti. Goûtez-la.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210205
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 414210205,
					"content": "Eh, moi aussi, je veux goûter !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210206,
					"content": "(Prenons une gorgée...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210207
					]
				},
				{
					"id": 414210207,
					"content": "Ouh, pouah... C'est super amer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210208,
					"content": "Les méthodes de purification traditionnelles de cette eau ne suffisent pas à lui enlever cette amertume, et le problème n'est pas dû à la façon dont elle est traitée chez nous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210209
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 414210209,
					"content": "Impossible de faire du vin avec une eau de la sorte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210210
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 414210210,
					"content": "Les poissons ont aussi dû remarquer le changement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210211,
					"content": "On en a goûté, et tous les poissons qui grandissent dans cette eau deviennent aussi amers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210212
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 414210212,
					"content": "... C'est pas exactement ce à quoi je m'attendais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210213,
					"content": "Enfin, voilà où on en est. Ne m'en demandez pas plus, je n'ai guère d'idée sur la cause du problème, si ce n'est que j'imagine qu'il faut enquêter au nord d'ici. Je me demande si l'eau à la Rivière Bishui et au Village de Qingce a le même problème...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Connor"
				}
			]
		},
		{
			"id": 4142105,
			"completionStepIds": [
				4142105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
