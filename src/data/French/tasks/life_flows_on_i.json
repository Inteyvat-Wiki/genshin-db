				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 414210501,
					"content": "Regarde, il y a quelque chose, là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210502,
					"content": "Sans eau, Endora... mourir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210503
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210503,
					"content": "« Endora », c'est ton nom ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210504,
					"content": "Eau amère... pas bien. Ça... me tuer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210505
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210505,
					"content": "Que peut-on faire pour t'aider ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210506,
					"content": "Besoin... eau douce. Dois aller... source.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210507
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210507,
					"content": "J'ai besoin eau... pour bouger. Pas d'eau, pas partir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210508
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210508,
					"content": "Comment on va faire pour l'amener là où on trouve de l'eau douce ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210509,
					"content": "Tiens, on a une bouteille d'eau.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210510
					]
				},
				{
					"id": 414210510,
					"content": "Mais c'est de l'eau amère.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210511,
					"content": "... Peux résister... pas longtemps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210512
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210512,
					"content": "Bon alors dans ce cas, ne traînons pas. Allons vite trouver un endroit avec de l'eau fraîche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210513,
					"content": "Au passage, cette... chose qui passe son temps à voyager avec les Blobs, c'est un peu comme nous, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4142106,
			"completionStepIds": [
				4142106
