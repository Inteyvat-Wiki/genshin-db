						414210810
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210810,
					"content": "À moins de vouloir se noyer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210811,
					"content": "Humains... seuls... Nous... aimer... tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210812
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210812,
					"content": "Ah !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210813
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210813,
					"content": "Qu'est-ce qui t'arrive ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210814,
					"content": "Près... Porte de Pierre, Rhodeia espionne ! Petites créatures océanides... éclaireurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210815
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210815,
					"content": "Tiens, on n'a pas vu des créatures océanides récemment justement ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210816,
						414210817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210816,
					"content": "Il me semble, si.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210818
					]
				},
				{
					"id": 414210818,
					"content": "Animaux en magie des eaux, très dangereux. Mais apprendre... en fusionnant avec eux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210819
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210819,
					"content": "Moi aller là-bas. Rhodeia... pas contente. Faire eau amère. Moi apprendre à parler. Pour parler Rhodeia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210820
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210820,
					"content": "Tu veux dire que tu peux nous aider ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210821
					]
				},
				{
					"id": 414210821,
					"content": "Oui, oui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210822
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210822,
					"content": "#{NICKNAME}, ça vaut le coup d'essayer je trouve. On n'a pas d'autre piste, de toute façon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210817,
					"content": "Ah bon ? Je n'ai pas fait attention.",
