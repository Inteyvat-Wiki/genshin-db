			"dialogs": [
				{
					"id": 722080201,
					"content": "Merci beaucoup ! Je peux à présent embarquer sur le bateau l'esprit tranquille...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080202
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080202,
					"content": "Où va ce bateau ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080203
					]
				},
				{
					"id": 722080203,
					"content": "#Vers les terres d'or, celles des rêves. Un monde sans brouillard... On se reverra dans tes songes, mon {M#ami}{F#amie}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ipe"
				}
			]
		},
