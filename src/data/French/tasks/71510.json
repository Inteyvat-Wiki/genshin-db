			"dialogs": [
				{
					"id": 715100101,
					"content": "Alors ? Vous avez réussi à faire fonctionner les Pointes de Pursina ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715100102,
						715100103
					],
					"speakerTitle": "Hussein"
				},
				{
					"id": 715100102,
					"content": "Oui, j'ai réussi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715100104
					]
				},
				{
					"id": 715100104,
					"content": "Tant mieux, tant mieux. Les Pointes de Pursina ne peuvent pas refermer la rupture en une seule fois, mais une seule réussite suffit pour pouvoir les faire fonctionner en continu sans problème.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715100105
					],
					"speakerTitle": "Hussein"
				},
				{
					"id": 715100105,
					"content": "Comme ça, ce ne sera qu'une question de temps avant que la rupture ne se referme complètement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715100106
					],
					"speakerTitle": "Hussein"
				},
				{
					"id": 715100106,
					"content": "Notre problème est donc résolu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715100107
					],
					"speakerTitle": "Hussein"
				},
				{
					"id": 715100107,
					"content": "Hmm, il faut que je prenne tout cela en note. Quand j'aurai remis le rapport complet de recherche sur les Pointes de Pursina, peut-être que... Peut-être que je deviendrai quelqu'un d'important à l'Académie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715100108
					],
					"speakerTitle": "Hussein"
				},
				{
					"id": 715100108,
					"content": "#Je pourrais même l'écrire dans mes futurs mémoires : « J'ai fait des expériences avec l'incroyable {NICKNAME} au Gouffre »...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715100109
					],
					"speakerTitle": "Hussein"
				},
				{
					"id": 715100109,
					"content": "J'attends ce jour avec impatience.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715100110
					]
				},
				{
					"id": 715100110,
					"content": "Haha ! Enfin, je crains de ne pas être aussi doué pour écrire des histoires que pour rédiger des rapports.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715100111
					],
					"speakerTitle": "Hussein"
				},
				{
					"id": 715100111,
					"content": "#J'espère que vous serez {M#indulgent}{F#indulgente} le moment venu.",
					"roleType": "TALK_ROLE_NPC",
