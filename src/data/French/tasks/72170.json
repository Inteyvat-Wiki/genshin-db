			"dialogs": [
				{
					"id": 721700101,
					"content": "On va pas y arriver comme ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700102
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700102,
					"content": "Qu'est-ce qu'il y a ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700103
					]
				},
				{
					"id": 721700103,
					"content": "#{M#Voyageur}{F#Voyageuse}, comme on se retrouve. On essaye de trouver comment... plonger dans l'eau devant nous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700104
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700104,
					"content": "On veut aller cueillir de l'herbe marine fraîche pour faire un plat appelé « Onigiris ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700105,
						721700107
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700105,
					"content": "Pourquoi ne pas cueillir celles qui poussent en bord de mer ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700106
					]
				},
				{
					"id": 721700106,
					"content": "On pourrait, mais les herbes marines là-bas ne sont généralement pas très fraîches. Il manque toujours un petit quelque chose dans la saveur des plats qu'on prépare avec.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700109
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700109,
					"content": "Je me suis renseigné en ville, et les habitants disent que des herbes de bonne qualité poussent ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700110
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700110,
					"content": "Mais quand on est arrivés aujourd'hui... on a constaté que c'était complètement inondé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700111
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700111,
					"content": "Et... aucun d'entre nous ne sait plonger. On peut juste regarder...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700112
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700112,
					"content": "Est-ce qu'il y a des mécanismes dans le coin ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700113
					]
				},
				{
					"id": 721700113,
					"content": "Il y en a un là-bas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700114
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721700114,
					"content": "Mais il est encore derrière une de ces barrières. On ne peut pas y accéder...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700115
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700115,
					"content": "*soupir* On va continuer d'essayer de trouver une solution...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700116
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700116,
					"content": "#{M#Voyageur}{F#Voyageuse}, si vous savez comment résoudre ce problème, venez nous aider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700117
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700117,
					"content": "Bien sûr, ce serait mieux si vous pouviez simplement nous rapporter les herbes marines...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700118
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700118,
					"content": "Monsieur Xudong ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700119
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721700119,
					"content": "#*tousse* Je veux dire, vous seriez largement {M#récompensé}{F#récompensée} si vous pouviez nous rapporter ces herbes marines directement ! Et j'ajoute un festin d'onigiris comme motivation supplémentaire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700120
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700120,
					"content": "Comment peux-tu qualifier des onigiris de « festin » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700121
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721700121,
					"content": "Eh bien, tant qu'il y en a assez... *tousse* Bon, continuons à réfléchir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700107,
					"content": "C'est obligé de plonger ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700108
					]
				},
				{
					"id": 721700108,
					"content": "Les herbes marines qu'on trouve au bord de la mer ne sont généralement pas très frais. Il manque toujours un petit quelque chose dans la saveur des plats qu'on prépare avec.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700109
					],
					"speakerTitle": "Xudong"
				}
			]
		},
