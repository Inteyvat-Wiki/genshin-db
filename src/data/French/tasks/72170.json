			"dialogs": [
				{
					"id": 721700201,
					"content": "#Est-ce que vous avez ramassé des herbes marines, {M#voyageur}{F#voyageuse} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700202
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700202,
					"content": "#Ah oui, c'est ça. Merci pour votre aide, {M#voyageur}{F#voyageuse} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700203
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700203,
					"content": "Bon, je vais commencer à préparer ce plat appelé... onigiris. J'ai entendu dire que c'était facile à faire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700204
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700204,
					"content": "Il me faut un peu de temps pour préparer les ingrédients, il faudra patienter un instant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
			]
		},
