						721700705
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721700705,
					"content": "Eh bien, n'y pensons plus. Ramassons vite des herbes marines.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700706
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700706,
					"content": "Qu'est-ce que vous faites ici ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700707
					]
				},
				{
					"id": 721700707,
					"content": "#Hé ? Je ne m'attendais pas à vous rencontrer ici, nous avons une vraie connexion, {M#voyageur}{F#voyageuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700708
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700708,
					"content": "Nous sommes juste descendus pour ramasser des herbes marines fraîches, pour préparer un plat connu sous le nom d'« onigiris ». C'était assez dur de descendre là-bas. Mes chaussures sont complètement trempées...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700709
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700709,
					"content": "#Trêve de bavardages, {M#voyageur}{F#voyageuse}, vous pouvez nous aider à ramasser plus d'herbes marines ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700710
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700710,
					"content": "La zone en dessous semble avoir été inondée il n'y a pas longtemps, et bien que l'eau se soit retirée, on ne sait pas quand elle pourrait revenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700711
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700711,
					"content": "Je pense donc qu'il vaut mieux ramasser les herbes marines aussi rapidement que possible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700712,
						721700715
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700712,
					"content": "C'est comme si c'était fait.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700713
					]
				},
				{
					"id": 721700713,
					"content": "#Merci ! Je vous laisse faire alors, {M#voyageur}{F#voyageuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700714
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700714,
					"content": "Quand vous aurez ramassé quelques herbes marines, ramenez-les-moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700715,
					"content": "Pourquoi ne pas cueillir des herbes marines au bord de la mer ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700716
					]
				},
				{
					"id": 721700716,
					"content": "On pourrait, mais les herbes marines là-bas ne sont généralement pas très fraîches. Il manque toujours un petit quelque chose dans la saveur des plats qu'on prépare avec.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700717
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700717,
					"content": "#Les herbes marines ici sont de bonne qualité. En tout cas, je compte sur vous, {M#voyageur}{F#voyageuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700718
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700718,
					"content": "Quand vous aurez ramassé quelques herbes marines, ramenez-les-moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
			]
		}
	]
}