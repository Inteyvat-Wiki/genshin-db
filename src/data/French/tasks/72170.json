			"dialogs": [
				{
					"id": 721700301,
					"content": "Des herbes marines... Du poisson... Et du riz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700302
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700302,
					"content": "Je pense que c'est ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700303
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700303,
					"content": "C'est fait ! Voilà les onigiris.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700304
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700304,
					"content": "Oh, ça a l'air vraiment... banal... Eh bien, je vais prendre celui-ci. Je doute que je puisse finir plus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700305
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721700305,
					"content": "Tant que ça a bon goût, je prends !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700306
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721700306,
					"content": "#C'est à vous, {M#voyageur}{F#voyageuse}. Et aussi la recette des onigiris, j'en ai fait une copie pour vous aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700307
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700307,
					"content": "Même si les onigiris semblent faciles à faire, il faut quand même de la technique pour qu'ils soient bons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700308
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700308,
					"content": "*tousse* ... Bon, trêve de bavardages, j'ai faim après tout ce que j'ai fait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700309
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700309,
					"content": "Hé ! Parvaneh, tu as dit que c'était trop pour toi ! Ne mange pas tout !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
