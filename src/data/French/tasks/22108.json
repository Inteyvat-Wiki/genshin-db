			"dialogs": [
				{
					"id": 221080301,
					"content": "C'est bon ? Vous les avez éliminés ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080302
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080302,
					"content": "Oui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080303
					]
				},
				{
					"id": 221080303,
					"content": "#Pas mal, vous avez été plutôt rapide. C'est un exploit digne d'{M#un aventurier}{F#une aventurière} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080304
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080304,
					"content": "Merci, voici votre récompense. Maintenant que vous nous avez débarrassés de ces créatures, tout devrait revenir dans l'ordre par ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080305
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080305,
					"content": "#Vous ne seriez pas {M#tombé}{F#tombée} sur des pistes concernant l'épée par hasard ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080306
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080306,
					"content": "Je vois. Pas de problème, je m'en doutais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080307
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080307,
					"content": "Merci, prenez cette récompense. Je vous laisse y aller, à bientôt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
		}
	]
