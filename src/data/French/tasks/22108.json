			"dialogs": [
				{
					"id": 221080201,
					"content": "C'est bon ? Vous les avez éliminés ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080202
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080202,
					"content": "Pas encore.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080203
					]
				},
				{
					"id": 221080203,
					"content": "Ne vous pressez pas trop. Les aventuriers qui se précipitent ne font pas assez preuve de vigilance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080204
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080204,
					"content": "Mais ne traînez pas trop non plus, car votre récompense dépendra du temps que vous mettrez à accomplir cette mission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
		},
