			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221080101,
					"content": "Encore bredouille... et je n'ai plus aucune piste à présent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080102
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080102,
					"content": "Qu'est-ce qu'il se passe ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080103
					]
				},
				{
					"id": 221080103,
					"content": "Qu'est-ce qui vous amène ? Vous devriez vous adresser à Catherine si vous désirez obtenir des informations sur la Guilde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080104
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080104,
					"content": "#Ah ? Vous êtes déjà {M#aventurier}{F#aventurière} ? Excusez-moi, j'ai beau être à la tête de la branche liyuéenne de la Guilde, je ne suis pas toujours au courant de tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080105
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080105,
					"content": "C'est pour ça que je ne connais pas vraiment les nouvelles têtes ! Rien qu'à vous regarder, je vois que vous avez de l'expérience sur le terrain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080106
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080106,
					"content": "#Vous êtes {M#parfait}{F#parfaite} pour me filer un coup de main dans une mission, qu'en dites-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080107,
						221080108
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080107,
					"content": "D'accord.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080109
					]
				},
				{
					"id": 221080109,
					"content": "J'apprécie votre enthousiasme, mais ce n'est pas très malin d'accepter quand on ne sait pas de quoi il s'agit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080111
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080111,
					"content": "Votre mission, si vous l'acceptez, sera de vaincre deux Brutocollinus munis de grands boucliers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080112
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080112,
					"content": "Leurs écus sont renforcés avec de l'énergie Géo. Ils ne devraient pas être trop dangereux, mais il vaut mieux rester prudent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080113
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080113,
					"content": "C'est là que vous entrez en scène pour les éliminer. Revenez me voir et je vous récompenserai généreusement pour votre aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080114
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080114,
					"content": "Ah, et tant que vous y serez, ramenez-moi des indices sur une certaine épée si vous en trouvez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080115
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080115,
					"content": "Ne vous en faites pas si vous n'en avez pas, je vous récompenserai quand même pour avoir éliminé les Brutocollinus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080108,
					"content": "Dites-en moi plus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080110
					]
				},
				{
					"id": 221080110,
					"content": "J'apprécie votre prudence. Je me doute que c'est l'expérience qui parle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080111
					],
					"speakerTitle": "Lan"
				}
			]
		},
		{
