				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tsarevich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 207000101,
					"content": "Ah, mais quelle malchance !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000102
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000102,
					"content": "Qu'est-ce qu'il se passe ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000103
					]
				},
				{
					"id": 207000103,
					"content": "Les chevaliers de l'Ordre ne valent pas grand-chose, voilà ce qu'il y a. Des monstres bloquent le chemin, et le passage est interdit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000104
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000104,
					"content": "Les chevaliers n'ont pas encore résolu le problème, tu parles d'une bande d'incapables...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000105
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000105,
					"content": "Mes affaires n'attendent pas. À cette allure, combien d'argent je vais perdre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000106
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000106,
					"content": "#Mais... Tu m'as l'air d'être {M#un aventurier}{F#une aventurière}, je me trompe ? Si je te paie, tu m'aides ou pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000107,
						207000109
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000107,
					"content": "Pas de problème.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000108
					]
				},
				{
					"id": 207000108,
					"content": "Ah, parfait, parfait... Une fois le travail accompli, tu ne le regretteras pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000111
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000111,
					"content": "Je ne sais pas si c'est moi ou pas, mais j'ai bien l'impression qu'il y a de plus en plus de ces saletés de Brutocollinus aux alentours de Mondstadt... Va savoir ce que font ces imbéciles de chevaliers de l'Ordre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000112
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000112,
					"content": "#Puisque tu es d'accord, va t'occuper de ces monstres pour moi. Bon, tu es {M#seul}{F#seule}, c'est sûr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000113
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000113,
					"content": "Bah, débrouille-toi comme tu peux, mais nettoie-moi tout ça. Choisis un endroit – au sommet, sur le flanc ou au pied de cette hauteur –, et va me nettoyer tout ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000114
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000114,
					"content": "Fais comme tu l'entends, du moment que tu te dépêches. Je suis pressé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000109,
					"content": "Combien peux-tu payer ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000110
					]
				},
				{
					"id": 207000110,
					"content": "Ça dépend de ton efficacité. Si tu te débrouilles bien, je te garantis que tu ne le regretteras pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000111
					],
					"speakerTitle": "Tsarevich"
				}
			]
		},
		{
