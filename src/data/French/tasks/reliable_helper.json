			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tsarevich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 207000201,
					"content": "C'est fait.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000202
					]
				},
				{
					"id": 207000202,
					"content": "Si vite ? Problème résolu en une minute, je vois que tu sais te débrouiller, hahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000203
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000203,
					"content": "Bien, très bien... Tiens, 5 000 moras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000204
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000204,
					"content": "Seulement 5 000 moras ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 207000205,
					"content": "Ah, ne te plains pas. C'est le montant adéquat pour la tâche que tu as accomplie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000206
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000206,
					"content": "Si tu veux te faire plus d'argent, alors il faudra faire plus. La prochaine fois, si l'occasion se présente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsarevich"
				}
			]
		},
