			},
			"dialogs": [
				{
					"id": 207000304,
					"content": "C'est fait.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000305
					]
				},
				{
					"id": 207000305,
					"content": "Eh bien, aussi peu efficace que les chevaliers de l'Ordre, à ce que je vois. Une minute aurait dû suffire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000306
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000306,
					"content": "Enfin, à quoi bon perdre mon temps sur ces détails. Tiens, 1 000 moras. Vous pouvez partir maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000307
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000307,
					"content": "1 000 moras ?! Quel radin !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 207000308,
					"content": "#Hé ! Si vous étiez un peu plus efficaces, vous seriez mieux {M#payés}{F#payées} ! Allez, prenez votre récompense, et ouste !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsarevich"
				}
			]
		},
