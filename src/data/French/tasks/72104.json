			"dialogs": [
				{
					"id": 721043801,
					"content": "Mademoiselle Gendou, vous semblez de bonne humeur aujourd'hui, non ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721043802
					]
				},
				{
					"id": 721043802,
					"content": "Qu'est-ce qu'il y a ? Un problème ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721043803
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721043803,
					"content": "Vous n'avez pas l'air comme d'habitude...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721043804
					]
				},
				{
					"id": 721043804,
					"content": "Ah bon ? J'en prends note !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721043805
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721043805,
					"content": "Ça doit être parce que j'ai tiré un omikuji de « grande fortune » aujourd'hui et que je souhaite partager ma bonne humeur avec vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721043806
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721043806,
					"content": "#En revanche, un omikuji de « grande fortune » pour certains peut être une «{NON_BREAK_SPACE}grande infortune » pour d'autres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721043807
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721043807,
					"content": "Et pour ceux qui obtiennent « grande infortune », qu'est-ce qui les attend au portique d'omikuji ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721043808
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721043808,
					"content": "Quelque chose d'intéressant, ça je n'en doute pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gendou Ringo"
				}
			]
