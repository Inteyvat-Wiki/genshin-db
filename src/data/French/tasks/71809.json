			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718090201,
					"content": "Tout va bien, tout va bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090202
					],
					"speakerTitle": "Hao"
				},
				{
					"id": 718090202,
					"content": "Qu'est-ce qui va bien ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090203
					]
				},
				{
					"id": 718090203,
					"content": "#C'est vous, {M#voyageur}{F#voyageuse}. J'ai entendu dire qu'il y a eu un incident dans la cité tout à l'heure, est-ce vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090204
					],
					"speakerTitle": "Hao"
				},
				{
					"id": 718090204,
					"content": "Encore heureux qu'il n'y a pas eu de gros problèmes après. Les restaurants sont encore ouverts et tant mieux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090205
					],
					"speakerTitle": "Hao"
				},
				{
					"id": 718090205,
					"content": "Ce serait un désastre sinon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090206
					],
					"speakerTitle": "Hao"
				},
				{
					"id": 718090206,
					"content": "Vous ne pensez qu'à manger...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090207
					]
				},
				{
					"id": 718090207,
					"content": "Je vous interdis de prendre la bonne cuisine à la légère. C'est la façon la plus rapide de savoir si un endroit en vaut la chandelle ou non.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090208
					],
					"speakerTitle": "Hao"
				},
				{
					"id": 718090208,
					"content": "Ah, ça me donne faim rien que d'en parler. Peut-être que je devrais aller me chercher quelque chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hao"
				}
			]
		},
		{
			"id": 7180903,
			"completionStepIds": [
				7180906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7180906",
							"2"
						],
						"stepId": 7180906,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fan Er'ye"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718090301,
					"content": "Plus j'écoute cette pièce de théâtre et moins je la comprends...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090302
					],
					"speakerTitle": "Fan Er'ye"
				},
				{
					"id": 718090302,
					"content": "Qu'est-ce qu'il se passe ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090303
					]
				},
				{
					"id": 718090303,
					"content": "Oh, bonjour. De nouvelles pièces se jouent au Salon de thé Heyu ces derniers temps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090304
					],
					"speakerTitle": "Fan Er'ye"
				},
				{
					"id": 718090304,
					"content": "Je les trouve bien... animées. Mais je n'arrive pas bien à comprendre de quoi elles retournent. Les jeunes ont l'air d'apprécier, ceci dit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090305
					],
					"speakerTitle": "Fan Er'ye"
				},
				{
					"id": 718090305,
					"content": "Qu'en pensez-vous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090306
					]
				},
				{
					"id": 718090306,
					"content": "J'aime bien les classiques, bien entendu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090307
					],
					"speakerTitle": "Fan Er'ye"
				},
				{
					"id": 718090307,
					"content": "Mais Liyue connaît actuellement beaucoup de changements, et cela se reflète dans les pièces qu'elle joue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090308
					],
					"speakerTitle": "Fan Er'ye"
				},
				{
					"id": 718090308,
					"content": "*soupir* Je me demande si tout cela ne va pas trop vite. Il n'y a pas eu de représentations des vieilles pièces de théâtre depuis un certain temps. Si le Souverain de la Roche... Ne parlons pas de ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fan Er'ye"
				}
			]
		},
		{
			"id": 7180904,
			"completionStepIds": [
				7180909
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
