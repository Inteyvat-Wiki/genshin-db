			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jean"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414130201,
					"content": "Jean, on est là !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130202,
					"content": "#{M#Voyageur}{F#Voyageuse} ! Ah... Excuse-moi. « Chevalier honoraire » serait plus indiqué dans ces circonstances.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130203
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130203,
					"content": "Je suppose que tu es au courant : c'est toi la Fleur de la fête cette année. Tu t'occuperas de l'offrande d'alizées pour l'Archon Anémo, Barbatos, au nom de l'ensemble de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130204
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130204,
					"content": "Bien que... les choses soient un peu différentes cette fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130205
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130205,
					"content": "Ouais ! Avec le barde de pacotille et nous, la Fête des alizées de cette année va assurer, c'est sûr !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130206,
					"content": "C'est vrai. Merci d'avoir élu domicile à Mondstadt, et j'espère que vous continuerez à profiter de la vie mondstadtoise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130207
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130207,
					"content": "La cérémonie des alizées est sur le point de commencer. Fleur de la fête, as-tu choisi ton alizée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130208
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130208,
					"content": "Donc, on choisit un type de fleur, et on l'offre à l'Archon Anémo, c'est ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130209,
					"content": "Exactement. Réfléchis bien avant de faire ton choix. N'oublie pas : tu parles au nom de tout Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130210
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130210,
					"content": "Venti, quel genre de fleur tu aimes ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130211
					]
				},
				{
					"id": 414130211,
					"content": "Hein ? Haha, rusé. On essaye de tricher ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130212
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130212,
					"content": "Ahem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130213
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130213,
					"content": "Hé ! Ne faites pas de cachoteries ici tous les deux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130214,
					"content": "Haha, pris la main dans le sac !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130215
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130215,
					"content": "Ne te préoccupe pas de moi. Choisis quelque chose que tu aimes, j'ai confiance en ton jugement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130216
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130216,
					"content": "Alors, chevalier honoraire, quel est ton choix ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130217,
						414130219,
						414130221,
						414130223,
						414130225,
						414130227
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130217,
					"content": "Pissenlit",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130218
					]
				},
				{
					"id": 414130218,
					"content": "Ah, un grand favori ! Les alizées, ça doit sûrement être des pissenlits en vrai !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130229,
					"content": "Au nom des habitants de Mondstadt, je te prie d'offrir ton alizée à la statue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130219,
					"content": "Chrysanthème à aubes",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130220
					]
				},
				{
					"id": 414130220,
					"content": "Ah, un grand favori ! Les alizées, ça doit sûrement être des chrysanthèmes à aubes en vrai !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130221,
					"content": "Cécilia",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130222
					]
				},
				{
					"id": 414130222,
					"content": "Oh, comme Béatrice. C'est assez rare, mais les partisans de cette théorie existent !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130223,
					"content": "Herbe à lampe",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130224
					]
				},
				{
					"id": 414130224,
					"content": "Oh, comme le pensait Nimrod, les alizées, ce sont des herbes à lampe. Une fleur pour éclairer les ténèbres !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130225,
					"content": "Fleur sucrante",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130226
					]
				},
				{
					"id": 414130226,
					"content": "Oh, comme le pensait Sucrose, les alizées, ce sont des fleurs sucrantes. Une fleur qui a traversé les âges !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130227,
					"content": "Baie à crochet",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130228
					]
				},
				{
					"id": 414130228,
					"content": "Oh, comme le pensait Razor, les alizées, ce sont des baies à crochet. Épineuses et piquantes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4141304,
			"completionStepIds": [
				4141304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4141304",
							"2"
						],
						"stepId": 4141304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414130401,
					"content": "Merci, Fleur de la fête, pour ton offrande sincère d'alizée à l'Archon Anémo. Que les vents protègent Mondstadt !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130402
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130402,
					"content": "Un très bon choix.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130403
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130403,
					"content": "Tu aimes ça ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130404
					]
				},
				{
					"id": 414130404,
					"content": "Haha, devine !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130405
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130405,
					"content": "Encore à faire deviner, tu abuses vraiment !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130406,
					"content": "Hahaha ! D'accord, d'accord, je vais te dire. Mais pas ici, par contre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130407
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130407,
					"content": "Ce n'est pas une bonne idée avec autant de monde sur la place. Un petit changement de décor est nécessaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130408
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130408,
					"content": "Où doit-on aller ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130409,
					"content": "Je veux que vous veniez avec moi à l'Antre de Stormterror.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
		{
			"id": 4141307,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4141307",
							"2"
						],
						"stepId": 4141307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414130701,
					"content": "Ah... Ça, c'est de la vue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130702,
						414130703
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130702,
					"content": "Le paysage est magnifique.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130704
					]
				},
				{
					"id": 414130704,
					"content": "N'est-ce pas ? J'adore cet endroit. Parfois, quand je n'ai rien d'autre à faire, je viens ici juste pour m'asseoir et m'absorber dans le paysage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130705
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130705,
					"content": "Tu veux dire que tu t'assieds et que tu feignasses ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130706,
					"content": "Haha, je plaide coupable !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130707
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130707,
					"content": "C'est si beau... Si seulement on avait une bouteille de cidre sous la main...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130708
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130708,
					"content": "#Alors, {M#voyageur}{F#voyageuse}. Est-ce que tu aimes la Fête des alizées de Mondstadt ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130709,
						414130710
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130709,
					"content": "Ça déborde d'animation et d'allégresse.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130711
					]
				},
				{
					"id": 414130711,
					"content": "Et pourtant, tu as encore quelque chose à demander, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130712
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130712,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130713
					]
				},
				{
					"id": 414130713,
					"content": "Je connais déjà ta question. Que sont les alizées, exactement ? Et que signifient ces fleurs et la Fête des alizées pour Barbatos, l'Archon Anémo ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130714
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130714,
					"content": "Comme tu l'as vu, les habitants de Mondstadt font chacun leur propre choix. Parmi les millions de fleurs qu'il y a, certains choisissent les pissenlits, d'autres choisissent les chrysanthèmes à aubes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130715
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130715,
					"content": "C'est comme si l'alizée signifiait quelque chose d'unique pour chaque personne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130716,
					"content": "Correct, et j'espère qu'il en sera ainsi encore longtemps. Il n'y a pas de réponse unique, pas plus que les alizées ont existé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130717
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130717,
					"content": "Alors... Ça n'existe pas vraiment ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130718,
					"content": "Le mot « alizée » date de l'époque du vieux Mondstadt. C'était à l'origine un nom de code utilisé par la résistance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130719
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130719,
					"content": "À cette époque, les gens disaient souvent que plus le vent souffle, plus profondes sont les racines des alizées et plus éclatantes en sont les fleurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130720
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130720,
					"content": "Si tu veux mon avis, les alizées n'existent pas. Et pourtant, elles sont tout autour de nous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130721
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130721,
					"content": "Elles représentent l'esprit qui aspire à la liberté, le courage de suivre les vents partout où ils nous mènent... Tout ce qui est beau, tout ce qui est noble peut être une alizée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130722
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130722,
					"content": "Nul ne peut les voir, mais tous peuvent sentir leur présence... Comme le vent !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130723
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130723,
					"content": "Haha, bien dit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130724
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130724,
					"content": "Alors l'Archon Anémo, Barbatos, ne se prononcera pas sur ce que sont vraiment les alizées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130725
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130725,
					"content": "Fleurs de bénédictions, fleurs de respect, fleurs d'amour. Chacun a l'alizée qui lui correspond, et chacun peut choisir comme il lui plaît.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130726
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130726,
					"content": "Pas surprenant que la fleur offerte par la cité de la liberté à sa divinité soit en fait une expression de la liberté.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130727,
					"content": "J'aime aussi cette sensation de liberté.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130728
					]
				},
				{
					"id": 414130728,
					"content": "Je sais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130729
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130729,
					"content": "C'est la volonté partagée des gens qui les amène sur le même chemin. Et ce sont sûrement les vents de la liberté qui nous ont réunis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130730
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130730,
					"content": "C'est quelque chose qui vient de la fin du voyage, du bout du monde, du fond de nos cœurs. C'est incessant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130731
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130731,
					"content": "« Qui est celui qui enserre\\nTon visage meurtri et fier\\nFaible par le ruisseau\\nEt fort sur les falaises en haut ? »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130732
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130732,
					"content": "« Qui est celui qui enlace ton âme lasse mais noble\\nDans les rêves heureux\\nEt là-haut dans les cieux ? »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130733
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130733,
					"content": "« Ami, je suis là\\nAllez viens, suis-moi\\nEt ensemble allons voir les lanternes »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130734
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130734,
					"content": "« Laisse-moi te narrer un conte de rêves et de liberté\\nL'histoire de comment ce festival est né... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130710,
					"content": "C'est bien d'être avec tout le monde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130711
					]
				},
				{
					"id": 414130703,
					"content": "C'est une atmosphère agréable.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130704
					]
				}
			]
		},
