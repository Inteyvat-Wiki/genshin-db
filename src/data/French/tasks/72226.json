			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ruu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722260301,
					"content": "Merci beaucoup !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260302
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260302,
					"content": "Le perchoir semble en bon état. Je suis sûr que la cérémonie se déroulera bien cette fois !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260303,
						722260304
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260303,
					"content": "C'était facile.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260305
					]
				},
				{
					"id": 722260304,
					"content": "C'était pas évident.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260305
					]
				},
				{
					"id": 722260305,
					"content": "#Héhé. On est des {M#aventuriers aguerris}{F#aventurières aguerries}, {NICKNAME} et moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722260306,
					"content": "#Tiens, d'ailleurs... D'où est-ce que tu viens, {NICKNAME} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260307
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260307,
					"content": "Les gens qui sont venus ici auparavant m'ont parlé d'Inazuma et de l'Île de Narukami. Est-ce que tu viens d'Inazuma ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260308,
						722260312
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260308,
					"content": "Strictement parlant...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260309
					]
				},
				{
					"id": 722260309,
					"content": "Euh, c'est vrai, on vient de l'Île de Narukami, n'est-ce pas... Attends un instant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722260310,
					"content": "J'avais presque oublié qu'on était là pour le maushiro !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722260311,
					"content": "On vient d'un pays très lointain...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260312
					]
				},
				{
					"id": 722260312,
					"content": "C'est vrai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722260313,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260314
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260314,
					"content": "Waouh ! Tu as même grimpé sur un dragon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260315,
						722260316
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260315,
					"content": "Ce n'était pas très confortable.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260317
					]
				},
				{
					"id": 722260316,
					"content": "Ce n'était rien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260317
					]
				},
				{
					"id": 722260317,
					"content": "C'est génialissime...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260318
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260318,
					"content": "Il y a beaucoup à voir, tu sais !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722260319,
					"content": "Je ne savais pas qu'il existait autant d'endroits au-delà de la mer de brouillard. J'aimerais les visiter si j'arrive à quitter l'île un jour !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260320
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260320,
					"content": "Les autres disent qu'on va perdre notre âme si on s'aventure hors du brouillard et qu'il nous protège du mal extérieur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260321
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260321,
					"content": "Mais j'ai rencontré des gens qui viennent de l'extérieur, donc je sais que la Mer de silence est habitée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260322
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260322,
					"content": "Tu peux venir avec nous si tu en as l'occasion.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260323
					]
				},
				{
					"id": 722260323,
					"content": "Marché conclu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260324
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260324,
					"content": "#Partez devant, {NICKNAME} et Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260325
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260325,
					"content": "Et une fois que la cérémonie sera terminée, allons explorer le monde au-delà de l'Île de Tsurumi ensemble !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722260326,
					"content": "Ce sera avec plaisir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ruu"
				}
			]
		},
