			},
			"dialogs": [
				{
					"id": 741511001,
					"content": "Il y a quelque chose qui cloche dans la relation qu'entretient Benoît avec ce couple.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511002
					]
				},
				{
					"id": 741511002,
					"content": "Ils avaient l'air complices quand on les a rencontrés il y a quelques jours, mais j'ai l'impression qu'il y a quelque chose qui ne va pas entre eux depuis aujourd'hui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511003,
						741511005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511003,
					"content": "Benoît subit des pressions de la part de son gendre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511004
					]
				},
				{
					"id": 741511004,
					"content": "Est-ce que tu parles de la façon dont son gendre l'a regardé et l'a fait rentrer après qu'il a dit quelques mots ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511007
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511007,
					"content": "Mais maintenant que tu le dis, je comprends un peu mieux d'où vient ce genre de sensation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511005,
					"content": "Benoît subit des pressions de sa fille.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511006
					]
				},
				{
					"id": 741511006,
					"content": "Je ne suis pas allée aussi loin que toi dans mes déductions, mais j'ai eu la chair de poule quand sa fille s'est mise à parler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511007
					],
					"speakerTitle": "Paimon"
				}
			]
		},
