			"dialogs": [
				{
					"id": 741511201,
					"content": "C'est tout ce qu'on peut en déduire pour l'instant.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511202
					]
				},
				{
					"id": 741511202,
					"content": "#Dis-moi {NICKNAME}, est-ce que Benoît est tombé dans une sorte de piège ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511203,
					"content": "C'est exactement ça.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511204
					]
				},
				{
					"id": 741511204,
					"content": "J'ai un mauvais pressentiment. Est-ce qu'on devrait signaler cette affaire ? Allons en parler à la Maison Gardiennage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511205,
						741511206,
						741511207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511205,
					"content": "Mais nous n'avons aucune preuve.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511208
					]
				},
				{
					"id": 741511208,
					"content": "Je comprends, tu as raison. Quoi qu'il en soit, il va falloir qu'on lui vienne en aide, pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511209,
					"content": "Molli nous a demandé de dire à Benoît que ses friandises étaient délicieuses, et on lui a donné notre parole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511210,
					"content": "Et nous allons la respecter.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511211
					]
				},
				{
					"id": 741511211,
					"content": "Je sais que tu fais tout ce que tu dis ! Tu en as aussi dans la caboche. Alors, qu'est-ce qu'on fait ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511212,
					"content": "Menons notre enquête.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511213
					]
				},
				{
					"id": 741511213,
					"content": "Faisons la lumière sur cette affaire ! Euh... Concrètement, sur quoi est-ce qu'on va enquêter ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511214,
						741511215,
						741511216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511214,
					"content": "L'identité de ce couple.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511217
					]
				},
				{
					"id": 741511217,
					"content": "#Oui ! Nous allons dévoiler la vérité au grand jour ! {NICKNAME} et la détective Paimon passent à l'action !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511215,
					"content": "L'objectif de ce couple.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511217
					]
				},
				{
					"id": 741511216,
					"content": "L'attitude de Benoît à l'égard de ce couple.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511217
					]
				},
				{
					"id": 741511206,
					"content": "Les choses ne sont pas encore claires.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511208
					]
				},
				{
					"id": 741511207,
					"content": "Nous ne savons pas ce que pense Benoît de tout ça.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511208
					]
				}
