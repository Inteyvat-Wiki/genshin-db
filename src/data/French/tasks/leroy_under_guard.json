			"dialogs": [
				{
					"id": 741511101,
					"content": "L'attitude de ce couple envers les gens qu'ils ne connaissent pas est très louche.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511102
					]
				},
				{
					"id": 741511102,
					"content": "Oui, c'est vrai. Ils avaient l'air d'être très amicaux lorsqu'on les a rencontrés, mais ils se montrent agressifs envers nous depuis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511103,
					"content": "C'est seulement devant leur père qu'ils se montrent chaleureux avec nous.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511104
					]
				},
				{
					"id": 741511104,
					"content": "Oh... Attends que je me souvienne. C'est vrai, la première fois qu'on s'est vus, Benoît était rentré chez lui, et son gendre nous a dit sur un ton agressif de ne plus jamais revenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511105,
					"content": "Tout ça est une mascarade.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511106
					]
				},
				{
					"id": 741511106,
					"content": "Pourquoi font-ils semblant d'être accueillants devant leur père ? Il doit y avoir une raison à ça, mais je ne comprends pas pourquoi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
