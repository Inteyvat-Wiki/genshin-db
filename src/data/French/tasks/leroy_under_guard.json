			},
			"dialogs": [
				{
					"id": 741500501,
					"content": "Père, comment se passent vos nuits récemment ? Vous avez encore des insomnies ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500502
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500502,
					"content": "Je me sens beaucoup mieux, je ne fais plus de cauchemars ces derniers temps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500503
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500503,
					"content": "(Les bavardages de la famille Leroy deviennent de plus en plus inaudibles...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Frapper"
				}
			]
		},
		{
			"id": 7415101,
			"completionStepIds": [
				7415101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7415101",
							"2"
