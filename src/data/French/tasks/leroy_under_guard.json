				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Molli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741510101,
					"content": "#Vous êtes {M#venus}{F#venues} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510102
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510102,
					"content": "#Je m'appelle Paimon, et {M#lui}{F#elle}, c'est {NICKNAME}. Tu peux nous appeler par nos prénoms maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510103,
					"content": "Est-ce que tu es venue voir Benoît ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510104
					]
				},
				{
					"id": 741510104,
					"content": "Oui, mais je n'ai pas pu lui parler... *soupir* À ce rythme-là, je n'arriverai pas à terminer ma rédaction.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510105
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510105,
					"content": "Une rédaction ? Oh, je m'en souviens, tu faisais de bonnes actions pour ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510106,
					"content": "Ce n'est pas pour ça ! J'aime beaucoup monsieur Benoît, il est très... Euh... Doux ? Oui, c'est quelqu'un de très doux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510107
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510107,
					"content": "Pfft, c'est quoi cet adjectif ? Dis plutôt qu'il est très doué pour parler aux gens ou quelque chose comme ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510108,
					"content": "#D'accord... Paimon, est-ce que vous pouvez m'aider par rapport à ma rédaction{NON_BREAK_SPACE}? Je ne sais pas quoi écrire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510109
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510109,
					"content": "Ma tutrice m'a dit que ma rédaction sur le fait de nourrir le chat de monsieur Leroy était « très sopre et écrite avec le fond du cœur ». Elle veut que j'en refasse une autre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510110
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510110,
					"content": "Qu'est-ce que ça veut dire « sopre » ? Tu veux plutôt dire « sobre » ? Oh, je pense avoir compris. C'est pour ça que tu veux revoir Benoît.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510111,
					"content": "Je reviens pour mes devoirs, mais aussi parce que j'aime beaucoup monsieur Leroy ! Il m'a dit de passer le bonjour à mes parents, et c'est ce que j'ai fait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510112
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510112,
					"content": "Mais ils n'étaient pas contents du tout quand je leur ai parlé de lui. Ils m'ont interdit de le revoir, je ne comprends pas pourquoi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510113
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510113,
					"content": "C'est très simple de trouver de la matière qui pourrait t'inspirer dans ta rédaction. Tu peux toujours nourrir le chat comme la dernière fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510114,
					"content": "C'est juste assez pour écrire une ligne. Ça ne suffira pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510115
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510115,
					"content": "On peut t'accompagner.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510116
					]
				},
				{
					"id": 741510116,
					"content": "Oui, comme avant. Nourris le chat, et nous, on ira nettoyer la porte et la façade arrière de la maison.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510117,
					"content": "Quand on aura terminé, on ira toquer à la porte de Benoît pour le prévenir. Ça te donnera de quoi écrire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510118,
					"content": "Oui, on peut faire comme ça ! Vous êtes tellement intelligente, Paimon ! Je vais aller donner à manger au chat !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Molli"
				}
			]
		},
		{
