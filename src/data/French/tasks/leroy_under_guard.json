					"Molli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741510301,
					"content": "#Paimon, {NICKNAME}, j'ai donné à manger à Nana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510302
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510302,
					"content": "Très bien, allons frapper à la porte de monsieur Leroy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510303,
					"content": "Quelque chose me tracasse. Est-ce qu'il pourra sortir ? Je suis allée devant chez lui récemment, et il ne m'a pas adressé la parole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510304
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510304,
					"content": "J'ai toqué à sa porte avant que vous ne veniez, et quand il est sorti, son beau-fils pas très sympa l'a forcé à rentrer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510305
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510305,
					"content": "Il m'a ensuite donné un bonbon et m'a dit de rentrer chez moi avant de fermer la porte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510306
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510306,
					"content": "Benoît est quelqu'un de très chaleureux, comment ça se fait que sa famille soit si peu aimable ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510307,
					"content": "Son beau-fils a dit que monsieur Leroy était malade, qu'il n'allait pas bien. Moi, je trouve qu'il est en forme. Pourquoi il ne pourrait pas me parler ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510308
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510308,
					"content": "Paimon, ce n'est pas grave si je n'écris pas cette deuxième rédaction. Je m'inquiète beaucoup plus pour monsieur Leroy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510309
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510309,
					"content": "S'il est malade, il doit sans doute se sentir mal. Ma mère a dit qu'il fallait prendre soin des malades, parce que c'est difficile pour eux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510310
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510310,
					"content": "Est-ce que vous pouvez demander au beau-fils de monsieur Leroy quelle est sa maladie ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510311
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510311,
					"content": "Est-ce que c'est parce qu'il a mangé trop de gâteaux ou bien qu'il a dormi sans couverture ? Je peux retourner chez moi et demander à mes parents ce qu'il devrait faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510312,
						741510313
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510312,
					"content": "Allons toquer à sa porte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510314
					]
				},
				{
					"id": 741510314,
					"content": "J'ai un peu peur de son beau-fils. Est-ce que vous pouvez lui parler pour moi ? Il est très autoritaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510315
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510315,
					"content": "N'aie pas peur, ma petite Molli. On va t'aider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510313,
					"content": "On avait convenu avec lui qu'on se reverrait.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510314
					]
				}
			]
		},
