			},
			"dialogs": [
				{
					"id": 741510901,
					"content": "Quelque chose ne va pas avec ce couple.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510902
					]
				},
				{
					"id": 741510902,
					"content": "Je trouve aussi qu'ils ont quelque chose de bizarre. L'un des deux parle beaucoup, et l'autre ne dit pas grand-chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510903,
					"content": "Et le moment où ils sont revenus est plus qu'une coïncidence.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510904
					]
				},
				{
					"id": 741510904,
					"content": "Tu veux dire qu'au moment où Benoît voulait recruter une aide à domicile, ils sont apparus comme par magie ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510905,
					"content": "Mademoiselle Euphrasie nous avait dit que Benoît cherchait à embaucher une aide à domicile il y a six mois, et à la même période...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510906,
					"content": "Cet homme et cette femme sont devenus ses enfants.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510907
					]
				},
				{
					"id": 741510907,
					"content": "Tu as raison. Tout ça a l'air délibéré. En y réfléchissant, il y a quelque chose qui cloche chez ce couple !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
