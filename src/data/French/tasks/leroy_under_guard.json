			"dialogs": [
				{
					"id": 741510501,
					"content": "Athos, que vous avez déjà vu, ouvre la porte et sort.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741510502
					]
				},
				{
					"id": 741510502,
					"content": "C'est encore vous ? Qu'est-ce que vous voulez à la fin ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510503
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741510503,
					"content": "Est-ce que Benoît est chez lui ? Nous avons entendu dire qu'il était malade, on s'inquiète pour son état de santé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510504,
					"content": "Mon père est ici, mais il ne va pas bien. Il ne peut pas recevoir d'invités.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510505
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741510505,
					"content": "Pouvez-vous nous dire de quoi il souffre ? Je peux demander de l'aide à mes parents pour qu'ils lui trouvent un remède.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510506
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510506,
					"content": "Pas la peine, nous irons en acheter nous-mêmes. Et mon père ne manque pas de médicaments.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510507
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741510507,
					"content": "On s'inquiète simplement pour sa santé, pourquoi vous êtes si froid...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510508,
					"content": "(Cet Athos ne veut absolument pas qu'on voie Benoît !)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510509,
						741510510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510509,
					"content": "(Ce comportement autoritaire me semble un peu exagéré...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510511
					]
				},
				{
					"id": 741510511,
					"content": "#Vous vous mêlez trop des affaires des autres. Vous avez autre chose à me dire{NON_BREAK_SPACE}? Si ce n'est pas le cas, je m'en vais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510512
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741510512,
					"content": "Attendez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510513
					]
				},
				{
					"id": 741510513,
					"content": "Qu'est-ce qu'il y a ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510514,
						741510516
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741510514,
					"content": "Est-ce que Benoît est réellement malade ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510515
					]
				},
				{
					"id": 741510515,
					"content": "Bien sûr. Il est gravement malade. Morticia et moi cherchons un moyen de le guérir. Personne d'autre n'a à s'inquiéter pour sa santé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510518
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741510518,
					"content": "Athos, qu'est-ce que c'est que ce vacarme dehors ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510519
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741510519,
					"content": "Ce n'est rien, Morticia, il s'agit de jeunes gens qui veulent rendre visite à notre père.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510520
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741510520,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510521
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741510521,
					"content": "Papa, les enfants t'apprécient beaucoup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510522
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741510522,
					"content": "Il y a des enfants qui veulent te rendre visite, est-ce que tu veux sortir leur passer le bonjour ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510523
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741510523,
					"content": "... J'aimerais y aller... Je peux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510524
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741510524,
					"content": "Bien sûr que oui, papa. Vas-y !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510525
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741510525,
					"content": "Benoît apparaît après avoir ouvert la porte.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741510526
					]
				},
				{
					"id": 741510526,
					"content": "#Oh les enfants, vous êtes {M#revenus}{F#revenues} me rendre visite ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510527
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741510527,
					"content": "Monsieur Leroy, est-ce que tout va bien ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510528
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510528,
					"content": "Moi ? *tousse* Je ne suis pas vraiment au meilleur de ma forme. Mais ne vous inquiétez pas, je fais de mon mieux pour récupérer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510529
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741510529,
					"content": "Ma fille et mon gendre me traitent très bien, donc tout va bien pour moi. Vous pouvez rentrer chez vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510530
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741510530,
					"content": "Papa, tu es sûr que tu vas bien ? Si ce n'est pas le cas, tu peux rentrer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510531
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741510531,
					"content": "Benoît regarde Athos dans les yeux, et franchit la porte sans dire un mot.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741510532
					]
				},
				{
					"id": 741510532,
					"content": "#Voilà, vous voyez, mon père ne va pas bien du tout. Vous êtes maintenant {M#satisfaits}{F#satisfaites} ? Je m'en vais aussi si vous n'avez plus rien à nous dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510533
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741510533,
					"content": "On...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510534
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510534,
					"content": "Athos vous ignore.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741510535
					]
				},
				{
					"id": 741510535,
					"content": "Cette fois, on a pu échanger quelques mots avec monsieur Leroy. *soupir* J'espère qu'il ira mieux très bientôt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510536
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510536,
					"content": "Paimon, j'ai l'impression que je cause des ennuis aux autres. Mais je n'ai pas envie de faire ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510537
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510537,
					"content": "Qu'est-ce qui te fait dire ça, Molli ? Tu ne causes d'ennuis à personne ! Moi, je trouve que c'est Athos qui cause du tort aux autres !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510538
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510538,
					"content": "Hmph... Pendant tout ce temps, il était...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510539,
						741510540
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510539,
					"content": "Tu devrais rentrer chez toi, Molli.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510541
					]
				},
				{
					"id": 741510541,
					"content": "#Hein ? {NICKNAME}, qu'est-ce que tu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510542
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510542,
					"content": "Oui, il est temps pour moi de rentrer. À vrai dire, mes parents n'aiment pas quand je viens ici. S'ils savaient où je suis allée aujourd'hui, ils seraient en colère.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510543
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510543,
					"content": "Je ne sais pas si j'aurai encore l'occasion de revoir monsieur Leroy. J'aimerais lui dire que ses friandises étaient vraiment délicieuses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510544
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510544,
					"content": "Si jamais vous le revoyez quand il ira mieux, est-ce que vous pourrez lui transmettre ce message ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510545,
						741510546
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510545,
					"content": "Pas de problème.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510547
					]
				},
				{
					"id": 741510547,
					"content": "Tu as la mienne également !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510548
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510548,
					"content": "#Très bien, merci à vous, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510549
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510549,
					"content": "#Je vais rentrer chez moi. À bientôt, les {M#amis}{F#amies} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510550
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510550,
					"content": "#À quoi tu penses, {NICKNAME} ? Je vois sur ton visage que tu as quelque chose à dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510551,
						741510552
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510551,
					"content": "Parlons de ça ailleurs.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510553
					]
				},
				{
					"id": 741510553,
					"content": "Très bien, discutons autre part.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510552,
					"content": "Ne parlons pas de ça ici à haute voix.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510553
					]
				},
				{
					"id": 741510546,
					"content": "Tu as ma parole.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510547
					]
				},
				{
					"id": 741510540,
					"content": "Paimon et moi devons aussi nous en aller.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510541
					]
				},
				{
					"id": 741510516,
					"content": "Pourquoi nous empêchez-vous de voir Benoît ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510517
					]
				},
				{
					"id": 741510517,
					"content": "#Pourquoi devrais-je laisser des {M#inconnus}{F#inconnues} s'occuper de mon père ? Je vous l'ai déjà dit, sa condition physique ne lui permet pas de recevoir des invités.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510518
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741510510,
					"content": "(Cette froideur est aussi très soudaine...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510511
					]
				}
			]
		},
