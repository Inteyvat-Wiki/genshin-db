			"dialogs": [
				{
					"id": 210230201,
					"content": "Il faut vraiment réparer ces escaliers...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230202
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210230202,
					"content": "C'est vous le patron ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210230203
					]
				},
				{
					"id": 210230203,
					"content": "C'est moi, je peux vous aider ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230204
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210230204,
					"content": "J'ai quelque chose à vous remettre ; quelqu'un en bas nous a demandé de vous l'apporter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210230205,
					"content": "Ah, ça doit venir d'un client. Zhen Qiang n'a pas voulu monter ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230206
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210230206,
					"content": "Il doit encore réceptionner les marchandises ? Ah, il n'arrête pas de se plaindre qu'il passe son temps à monter et descendre... Quel fainéant celui-là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230207
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210230207,
					"content": "#Vous êtes {M#un client}{F#une cliente}, veuillez accepter mes excuses... Cet escalier a vraiment choisi le pire moment pour se casser, croyez-moi. J'étais justement en train de réfléchir à comment le réparer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230208
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210230208,
					"content": "Merci pour le coup de main. Tenez, ce n'est pas grand-chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230209
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210230209,
					"content": "J'avais préparé ça pour Zhen Qiang, mais puisque ce fainéant s'est désisté, c'est normal que ça vous revienne !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230210
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210230210,
					"content": "Bon, et maintenant, je vais aller trouver un moyen de réparer ces satanés escaliers. N'hésitez pas à visiter l'auberge et à venir me voir si vous avez des questions !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		}
	]
