			"dialogs": [
				{
					"id": 790640601,
					"content": "#Individus suspects détectés ! Je ne sais pas quelle loi vous avez enfreinte, mais nous sommes actuellement en alerte rouge. Je vous arrête, rendez-vous{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640602
					],
					"speakerTitle": "Garde géant"
				},
				{
					"id": 790640602,
					"content": "Vous vous dispersez et entendez Cappet crier : chacun pour sa peau !\\nUne fois les gardes partis, vous vous rassemblez au même endroit, comme si vous n'aviez pas été repérés.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						790640603
					]
				},
				{
					"id": 790640603,
					"content": "Réessayons.",
					"roleType": "TALK_ROLE_NPC",
