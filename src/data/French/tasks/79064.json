			"dialogs": [
				{
					"id": 790640801,
					"content": "C'est le quartier général des gardes. Je suis sûr que les gardes géants seront compréhensifs si nous leur expliquons la situation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640802
					],
					"speakerTitle": "Albizzi",
					"speakerSubtitle": "Superviseur bleu"
				},
				{
					"id": 790640802,
					"content": "Bonjour...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790640803
					]
				},
				{
					"id": 790640803,
					"content": "Quoi ? Je suis occupé à me remémorer le bon vieux temps en regardant une photo de mon ami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640804
					],
					"speakerTitle": "Frapper"
				},
				{
					"id": 790640804,
					"content": "Je connais cette voix. Winston ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640805
					],
					"speakerTitle": "Albizzi",
					"speakerSubtitle": "Superviseur bleu"
				},
				{
					"id": 790640805,
					"content": "Hahaha, tu reviens en douce... Je t'avais dit que c'était moi, ton seul ami dans ce monde. Qu'est-ce qui t'a pris de partir en mission avec deux inconnus ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640806
					],
					"speakerTitle": "Frapper"
				},
				{
					"id": 790640806,
					"content": "Tu as été si naïf : « Oh, je vais devenir ami avec eux ! Je le sais ! » Au bout du compte, il n'y a que moi qui t'ai attendu. Je suis ton seul ami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640807
					],
					"speakerTitle": "Frapper"
				},
				{
					"id": 790640807,
					"content": "#C'est faux... Il n'y a pas qu'eux deux. Je suis devenu ami avec {M#le marquis}{F#la marquise} et son amie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640808
					],
					"speakerTitle": "Albizzi",
					"speakerSubtitle": "Superviseur bleu"
				},
				{
					"id": 790640808,
					"content": "#... Tu t'es fait d'autres {M#amis}{F#amies} dans mon dos ! On dirait que tu t'es senti pousser des ailes, Albizzi... C'est la goutte d'eau qui fait déborder le vase. Pars d'ici ! Je ne veux plus jamais te revoir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640809
					],
					"speakerTitle": "Frapper"
				},
				{
					"id": 790640809,
					"content": "*soupir* Ce n'est pas ça... Enfin, tu ne pourrais pas lever l'alerte rouge un instant pour me laisser entrer ? J'ai un VIP avec moi et nous sommes à deux doigts de résoudre le mystère de notre site sacré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640810
					],
					"speakerTitle": "Albizzi",
					"speakerSubtitle": "Superviseur bleu"
				},
				{
					"id": 790640810,
					"content": "J'ai dit : dehors !!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640811
					],
					"speakerTitle": "Frapper"
				},
				{
					"id": 790640811,
					"content": "Winston sonne l'alarme. Le garde géant arrive qui vous prend et vous dépose à l'extérieur.\\n« Winston et vous avez besoin d'espace et de temps pour réfléchir à votre amitié. »\\nLe garde vous dispense également ce gentil conseil.\\nLe processus se déroule sans violence, à votre grande surprise.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		}
	]
}