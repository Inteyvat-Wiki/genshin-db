				]
			},
			"dialogs": [
				{
					"id": 760810201,
					"content": "C'était un combat palpitant, monsieur Sigurd.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810202
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810202,
					"content": "Il est regrettable que cela marque la fin d'un héros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810203
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810203,
					"content": "Errer seul sur la terre pour laquelle vous avez sacrifié votre vie... Aviez-vous vu venir ce jour lorsque vous avez répondu au serment des Gardiens de lumière la première fois ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810204
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810204,
					"content": "Peut-être est-ce le cas, et vous n'avez pas hésité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810205
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810205,
					"content": "Je vous rendrai visite une prochaine fois. Adieu, monsieur Sigurd.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				}
			]
		},
		{
			"id": 7608103,
			"completionStepIds": [
				7608102
