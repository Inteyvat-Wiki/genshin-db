					}
				]
			},
			"dialogs": [
				{
					"id": 760810401,
					"content": "Beau combat, monsieur Sigurd.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810402
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810402,
					"content": "Soyez rassuré. Après votre chute, celle de vos camarades et moi-même, mon père Nikita a repris le rôle de starshyna et a mené le peuple que vous avez sauvé pour reconstruire l'ordre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810403
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810403,
					"content": "Aujourd'hui, nous sommes assez forts pour protéger cette terre, même sous la menace de la Chasse sauvage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810404
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810404,
					"content": "Votre sacrifice n'a pas été vain. Vos actes et votre volonté resteront gravés dans les mémoires.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810405
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810405,
					"content": "Adieu, monsieur Sigurd. Je viendrai vous rendre visite de temps en temps. Puissiez-vous enfin trouver la paix.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
		},
		{
			"id": 7608199,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
