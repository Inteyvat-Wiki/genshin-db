					},
					{
						"sceneId": 3,
						"position": [
							1963.909,
							200.31,
							9077.054
						],
						"pointId": 13645
					}
				]
			},
			"dialogs": [
				{
					"id": 760810301,
					"content": "Monsieur Sigurd, je vous dois la vie. Si vous n'aviez pas conduit les Gardiens de lumière vers le sud pour tenir la ligne à l'époque, je serais peut-être mort sans même savoir comment, et mon corps aurait été introuvable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810302
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810302,
					"content": "Mais pourquoi votre esprit n'a-t-il pas trouvé le repos ? Pourquoi continuez-vous à errer et à vous battre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810303
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810303,
					"content": "Corrompu par la Chasse sauvage, votre corps est brisé... On dirait que vous n'avez jamais vraiment quitté ce champ de bataille, n'est-ce pas ? Pour vous, la guerre n'a jamais pris fin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810304
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810304,
					"content": "En ce sens, je ne suis peut-être pas si différent de vous. Aucun d'entre nous ne trouvera la paix tant que la Chasse sauvage ne sera pas définitivement éradiquée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810305
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810305,
					"content": "C'est un honneur de vous rencontrer, monsieur Sigurd.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810306
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810306,
					"content": "Je comprends maintenant. Pour un Gardien de lumière, la meilleure manière de communiquer est de prendre les armes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810307
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810307,
					"content": "Alors permettez-moi de vous montrer la puissance de la nouvelle génération de Gardiens de lumière.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
		},
