			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 760819901,
					"content": "Sa façon d'éliminer les monstres... Non, ce personnage légendaire a disparu depuis longtemps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760819902
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760819902,
					"content": "Aurait-il pu se réveiller à nouveau d'une quelconque manière ? Hmm... Si vous avez le temps, rendez-vous sur la plage au nord-est des Landes d'Osmousse. C'est là que se trouve sa tombe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760819903
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760819903,
					"content": "Le vieux m'a raconté autrefois des histoires sur Sigurd le légendaire starshyna, celui avec qui il avait combattu des années auparavant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760819904
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760819904,
					"content": "Une lame violette, les cheveux dorés... il est exactement comme le décrivent les contes. La personne que j'ai vue ces derniers jours... pourrait-il vraiment s'agir de lui ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760819905
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760819905,
					"content": "Sa dernière demeure se trouve sur la plage au nord-est des Landes d'Osmousse. Si j'ai le temps, je devrais aller y jeter un œil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
		}
	]
}