			"dialogs": [
				{
					"id": 760810101,
					"content": "J'ai entendu dire que Sigurd, le légendaire starshyna, maniait une épée longue et que ses exploits en chasse de monstres étaient uniques en leur genre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810102
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810102,
					"content": "Il a disparu après une grande bataille. C'est pourquoi cette tombe vide a été érigée en son honneur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810103
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810103,
					"content": "Une lame violette et des cheveux dorés... C'est sans doute le guerrier errant qui affronte la Chasse sauvage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810104
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810104,
					"content": "On dirait que son esprit n'a pas trouvé le repos dans sa tombe, comme de nombreux autres fantômes qui veillent toute la nuit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810105
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810105,
					"content": "Pour brandir son épée contre la Chasse sauvage même après sa mort, son esprit de héros doit être resté inébranlable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810106
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810106,
					"content": "... Monsieur Sigurd, vous êtes vraiment digne de mon respect.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810107
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810107,
					"content": "Mais en tant que guerrier, il est motivé par la haine et par son sens du devoir. Cette existence solitaire est un destin trop cruel pour lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810108
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810108,
					"content": "Les jours où vous buviez et chantiez avec vos amis Gardiens de lumière vous manquent-ils, Sigurd ? Avez-vous une raison de brandir votre lame maintenant, si ce n'est que pour massacrer vos ennemis ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810109
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810109,
					"content": "Si c'est le cas, montrez-vous. On pourrait s'affronter ? Comme au bon vieux temps, quand vous étiez Gardien de lumière.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				}
			]
		},
