			"dialogs": [
				{
					"id": 760300101,
					"content": "Oh ? L'ambiance a l'air différente aujourd'hui. Vous décorez ce champ de fleurs, Columbina ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300102,
					"content": "Pas moi, elles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300103
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760300103,
					"content": "Elles... Les kuuhenkis ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300104,
					"content": "Ces pierres émettent une faible lueur en absorbant le kuuvahki. Les kuuhenkis les aiment beaucoup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300105
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760300105,
					"content": "Du coup, elles les mettent par terre et jouent avec ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300106,
					"content": "Venez par ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300107
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760300107,
					"content": "Hmm ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300108,
					"content": "Oh ! On dirait une peinture vu d'en haut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300109,
					"content": "On dirait qu'il en manque une partie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760300110
					]
				},
				{
					"id": 760300110,
					"content": "Oui, nous n'en avons pas assez. Je vais aller en ramasser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300111
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760300111,
					"content": "Oh ? Vous allez faire ça à l'extérieur ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300112,
					"content": "Je connais un endroit idéal, illuminé par le clair de lune, où ces pierres abondent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300113
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760300113,
					"content": "Voudriez-vous qu'on vous accompagne ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760300114
					]
				},
				{
					"id": 760300114,
					"content": "D'accord.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300115
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760300115,
					"content": "D'accord. Allons en prendre quelques-unes de plus. On a hâte de voir à quoi ressemble l'œuvre achevée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
