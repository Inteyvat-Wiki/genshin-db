			},
			"dialogs": [
				{
					"id": 760300301,
					"content": "Je pense que ça devrait suffire. J'ai l'impression qu'on en a pris beaucoup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300302,
					"content": "Rentrons. On ne peut pas laisser cette œuvre d'art inachevée pour toujours, hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300303,
					"content": "*pleure*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300304
					],
					"speakerTitle": "Rijeka"
				},
				{
					"id": 760300304,
					"content": "Aah ! Vite, cachez-vous ! Il y a quelqu'un ici !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300305,
					"content": "*snif* Où est-ce que je suis... Maman... Je veux rentrer à la maison...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300306
					],
					"speakerTitle": "Rijeka"
				},
				{
					"id": 760300306,
					"content": "On dirait une membre des Descendants de givrelune. Est-ce qu'elle s'est perdue ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300307,
					"content": "Je vais l'aider...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760300308
					]
				},
				{
					"id": 760300308,
					"content": "Vraiment ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300309
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760300309,
					"content": "Que voulez-vous dire par là ? Elle a besoin d'aide !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300310,
					"content": "Oui, mais je me souviens que les Descendants de givrelune se méfient des étrangers. Vous n'avez pas de bois sur la tête, et il est tard. Si elle s'enfuyait par peur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300311
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760300311,
					"content": "C'est une possibilité, mais on ne peut pas la laisser comme ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300312,
					"content": "Hmm... Suivez-moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300313
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760300313,
					"content": "Hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
