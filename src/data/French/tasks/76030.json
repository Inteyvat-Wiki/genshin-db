			"dialogs": [
				{
					"id": 760300501,
					"content": "*snif* ... Oh ? Qu'est-ce que c'est ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300502
					],
					"speakerTitle": "Rijeka"
				},
				{
					"id": 760300502,
					"content": "C'est... joli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300503
					],
					"speakerTitle": "Rijeka"
				},
				{
					"id": 760300503,
					"content": "Et voilà qui règle le problème.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300504
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760300504,
					"content": "Et la voilà partie. Ce chemin de pierres devrait la ramener à l'Enclave de givrelune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300505,
					"content": "(Columbina dit qu'elle ne veut pas être traitée comme une divinité, mais elle aide quand même ceux qui en ont besoin...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760300506
					]
				},
				{
					"id": 760300506,
					"content": "Ah, mais l'œuvre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300507,
					"content": "Ce n'est pas grave.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300508
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760300508,
					"content": "Nous pouvons toujours la terminer plus tard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300509
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760300509,
					"content": "J'aime bien voir les gens retrouver le chemin de leur maison, là où est leur place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				}
			]
