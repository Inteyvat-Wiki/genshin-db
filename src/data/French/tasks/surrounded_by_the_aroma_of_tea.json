				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705070201,
					"content": "Et voilà !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705070202,
					"content": "Bonne dégustation.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070203
					]
				},
				{
					"id": 705070203,
					"content": "Le thé est clair et brille d'une lueur agréable. Son intensité est complétée par un parfum floral et fruité. Quel rare délice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070204
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070204,
					"content": "Ouah, Zhongli s'y connaît aussi en thé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705070205,
					"content": "D'habitude, j'engloutis tout d'une traite avant de dire « Trop bon ! ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705070206,
					"content": "Savourer le thé avec intention est un signe de respect envers la personne qui l'a préparé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070207
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070207,
					"content": "Le thé de qualité est rare, mais il est encore plus difficile de tomber sur des personnes capables de le préparer selon l'occasion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070208,
						705070209
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070208,
					"content": "C'est trop gentil...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070210
					]
				},
				{
					"id": 705070210,
					"content": "Oh, je vois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705070211,
					"content": "Vous pouvez m'enseigner comment vous faites pour déguster votre thé ? Il faut le sentir, puis le boire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705070212,
					"content": "C'est exact.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070213
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070213,
					"content": "Chaque thé est unique. Plus vous en boirez, et plus vous vous rendrez compte de leurs différences. Sentir le parfum d'un thé permet de deviner sa qualité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070214
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070214,
					"content": "Les thés de moindre qualité dégagent une senteur de renfermé et de brûlé, tandis que les plus exquis ont une odeur délicate et raffinée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070215
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070215,
					"content": "Selon les traditions liyuéennes, vous pouvez toujours acquérir une tasse spécialement conçue pour pousser votre observation un peu plus loin si vous le souhaitez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070216
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070216,
					"content": "Oh non, j'ai l'impression d'être complètement passée à côté de la beauté du thé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705070217,
					"content": "Ne vous inquiétez pas. Le monde est rempli de connaissances, mais il n'est jamais trop tard pour apprendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070218
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070218,
					"content": "Les débutants peuvent commencer par observer la couleur, puis sentir le parfum et enfin, boire une gorgée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070219
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070219,
					"content": "Rien n'est impossible à comprendre si vous abordez les choses dans le bon ordre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070220,
						705070221
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070220,
					"content": "J'ai beaucoup appris aujourd'hui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070222
					]
				},
				{
					"id": 705070222,
					"content": "Le Village de Qiaoying dans le nord-ouest de Liyue est réputé pour son thé. Pourquoi ne pas le visiter si vous en avez l'occasion ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070223
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070223,
					"content": "Tout ce dont je vous ai parlé aujourd'hui ne sont que mes habitudes de vieux Liyuéen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070224
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070224,
					"content": "Chaque région possède sa propre tradition et culture du thé qu'il faut respecter lorsqu'on s'y trouve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070225
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070225,
					"content": "Je comprends ! Reste à savoir si je vais arriver à retenir tout ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705070226,
					"content": "Comme d'habitude...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070227
					]
				},
				{
					"id": 705070227,
					"content": "#Merci pour aujourd'hui, {NICKNAME}. Je suis heureux d'avoir pu goûter à un thé aussi exquis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070228
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070228,
					"content": "Si vous décidez d'ouvrir un salon de thé un jour, j'en deviendrai sans aucun doute un habitué.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070229
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070229,
					"content": "#On est déjà bien {M#occupés}{F#occupées} comme ça. Je ne crois pas qu'on ait le temps pour ce genre de chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705070230,
					"content": "Qui sait ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070231
					]
				},
				{
					"id": 705070231,
					"content": "En tout cas, je suis de tout cœur avec vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070232
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070232,
					"content": "Bien, je pense qu'on peut en rester là pour aujourd'hui. Vous avez tous mes vœux de réussite lors de vos prochaines entreprises.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070233,
						705070234
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070233,
					"content": "Merci, bonne journée.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070235
					]
				},
				{
					"id": 705070235,
					"content": "Ah, mettez tout sur le compte du Funérarium Wangsheng, comme d'habitude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070236
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070236,
					"content": "Prenez soin de vous et dites bonjour à la directrice de notre part !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705070234,
					"content": "Et l'addition ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070235
					]
				},
				{
					"id": 705070221,
					"content": "J'aimerais en savoir plus...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070222
					]
				},
				{
					"id": 705070209,
					"content": "Vous me flattez...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070210
					]
				}
			]
		}
	]
}