				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Grainville"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740630401,
					"content": "Bonjour, nous avons remarqué qu'il y avait un petit problème avec le mégaphone... C'est par là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630402,
					"content": "Encore une fois ? C'est bizarre... J'ai déjà demandé à Clynes de le réparer. On dirait qu'il n'est pas aussi doué que moi. Faut juste lui mettre quelques coups et ça repart, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630403
					],
					"speakerTitle": "Grainville"
				},
				{
					"id": 740630403,
					"content": "Merci, je passerai vérifier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630404
					],
					"speakerTitle": "Grainville"
				},
				{
					"id": 740630404,
					"content": "Beau travail !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7406305,
			"completionStepIds": [
				7406305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
