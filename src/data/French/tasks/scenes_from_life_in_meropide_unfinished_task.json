					}
				]
			},
			"dialogs": [
				{
					"id": 740630201,
					"content": "Hein ? Pourquoi y a-t-il un Daguerréotype ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630202,
					"content": "« Là où il y a des nouvelles, il y a un Daguerréotype », vous n'avez jamais entendu cette phrase ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630203,
						740630206
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630203,
					"content": "J'ai l'impression de l'avoir déjà entendue quelque part.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630204
					]
				},
				{
					"id": 740630204,
					"content": "Mais c'est une phrase que je viens d'inventer, où auriez-vous pu l'entendre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630205
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630205,
					"content": "De toute façon, il n'y a rien qui se passe. Quoi que je dise ou écrive, ce ne sera jamais qu'une parodie des autres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630208
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630208,
					"content": "Maintenant que nous avons le Daguerréotype, où sont les nouvelles ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630209
					]
				},
				{
					"id": 740630209,
					"content": "Les nouvelles... C'est comme à la pêche, il faut de la patience et faire le bon choix au bon moment pour attraper les gros poissons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630210
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630210,
					"content": "Ah non, je veux dire que c'est comme ça qu'on part à la pêche aux scoops. Hmm ? Ça ne m'a pas l'air très juste ! Tant pis, oublions ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630211,
						740630213
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630211,
					"content": "C'est un raisonnement d'amateur. Vous n'êtes pas journaliste, si ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630212
					]
				},
				{
					"id": 740630212,
					"content": "Hmph ! Je suis une journaliste amatrice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630222
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630222,
					"content": "Et puis, que fait une journaliste amatrice ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630223,
					"content": "Pour accomplir le projet qui m'a été confié par mon prédécesseur : immortaliser des geôliers de la Forteresse de Méropide au travail avec un Daguerréotype !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630224
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630224,
					"content": "Mais j'ai passé trop de temps à remplir les documents de conformité demandés... Jetez un coup d'œil et vous comprendrez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630225
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630225,
					"content": "Nelly sort tout un tas de documents sur lesquels figurent diverses clauses et signatures. Les voir vous donne un mal de crâne...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740630226
					]
				},
				{
					"id": 740630226,
					"content": "Le temps de remplir tous les documents de la procédure, j'ai raté les geôliers au travail ! Pour reprendre l'analogie de la pêche, c'est comme s'il n'y avait pas de poisson dans l'eau en ce moment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630227
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630227,
					"content": "Hein ? Mais il y a encore des geôliers en service à cette heure-ci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630228,
					"content": "Mais je veux un collecteur de platine. Un mek de type configuration initiale ou nettoyeur aquatique n'aura pas le même impact... Sinon, mes collègues ne complimenteront pas mon projet, même si je le termine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630229,
						740630230
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630229,
					"content": "Ne soyez pas si exigeante si vous ne voulez pas rentrer bredouille.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630233
					]
				},
				{
					"id": 740630233,
					"content": "Vous avez raison, je dois avoir conscience de la limite de mes capacités, au lieu de vouloir pêcher de trop gros poissons... Bouhouhou, je suis une pêcheuse nulle... Euh, non, une journaliste amatrice nulle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630234
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630234,
					"content": "Bon, j'arrête de me dénigrer. C'est l'heure de se ressaisir ! Si ça ne vous dérange pas... Pourriez-vous me rendre un petit service ? S'il vous plaît ! Je vous paierai !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630235
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630235,
					"content": "Vous vous en remettez très vite... Ça dépend. Vous pourriez commencer par nous dire de quoi il s'agit ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630236,
					"content": "Vous voyez le geôlier qui se trouve là-bas, Grainville. Je trouve qu'il a une valeur informative équivalente à celle d'un contrôleur de l'environnement parmi les meks de maintenance...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630237
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630237,
					"content": "Je devrais pouvoir faire un bon reportage si j'en fais mon sujet. Personne n'aura rien à me reprocher, au moins.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630238
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630238,
					"content": "Mais il ne vient jamais par ici ! Pouvez-vous l'amener dans un endroit propice pour prendre des photos de lui ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630239,
						740630241
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630239,
					"content": "Pourquoi ne pas lui expliquer la situation et l'amener ici toute seule ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630240
					]
				},
				{
					"id": 740630240,
					"content": "Il prendrait des poses raides parce qu'il n'est pas à l'aise devant le Daguerréotype. Les photos n'auront pas l'air naturelles !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630243
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630243,
					"content": "Laissez-moi voir. Le mieux reste d'éteindre le mégaphone, de signaler la panne à Grainville et de lui demander de venir ici pour jeter un coup d'œil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630244
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630244,
					"content": "#Je pourrai ainsi immortaliser un instant vivant du travail d'un geôlier de la Forteresse de Méropide{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630245
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630245,
					"content": "La réussite de mon projet en dépend ! Aidez-moi, s'il vous plaît !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630246
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630246,
					"content": "#Ça n'a pas l'air trop difficile. {NICKNAME}, aidons-la.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630241,
					"content": "Pourquoi ne pas prendre des photos là-bas avec votre Daguerréotype ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630242
					]
				},
				{
					"id": 740630242,
					"content": "Je trouve que c'est meilleur de prendre des photos ici. En plus, il va se crisper en voyant le Daguerréotype et je n'aurais que des photos avec des poses pas naturelles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630243
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630230,
					"content": "Continuez d'attendre. Au revoir !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630231
					]
				},
				{
					"id": 740630231,
					"content": "Vous partez maintenant ? Vraiment ? Vous n'allez pas m'aider ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630232
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630232,
					"content": "Hum... On n'a pas le pouvoir faire apparaître un collecteur de platine parce que vous le voulez, hein !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630213,
					"content": "Oublions les nouvelles. J'aime aussi la pêche.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630214
					]
				},
				{
					"id": 740630214,
					"content": "Vraiment ? Super ! Je ne suis qu'une débutante en pêche et je me demandais à qui je pouvais poser mes questions. Par exemple : comment faire si l'on repêche un mek de maintenance et qu'il mord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630215,
						740630216,
						740630217
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630215,
					"content": "Je le relâcherai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630219
					]
				},
				{
					"id": 740630219,
					"content": "Je vois, c'est comme ça que vous auriez réagi. C'est très utile, je le note.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630220
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630220,
					"content": "#... Hé ! Pourquoi parle-t-on de pêche tout à coup ? Vous êtes tellement {M#doués}{F#douées} pour changer de sujet ! On dirait que j'ai encore beaucoup à apprendre en tant que journaliste amatrice...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630221
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630221,
					"content": "Mais c'est vous qui avez lancé le sujet de la pêche !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630216,
					"content": "#Je lui donnerai quelques coups pour lui montrer qui est {M#le patron}{F#la patronne}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630219
					]
				},
				{
					"id": 740630217,
					"content": "Je le cuisinerai pour Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630218
					]
				},
				{
					"id": 740630218,
					"content": "#Oh, je fais confiance à tes compétences culinaires, {NICKNAME}, mais ce truc n'a pas l'air comestible ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630206,
					"content": "Jamais.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630207
					]
				},
				{
					"id": 740630207,
					"content": "Oh ! Eh bien, vous l'avez entendue maintenant. Et n'oubliez pas que si vous voulez la citer ailleurs, il faut toujours indiquer la source ! C'est-à-dire l'auteure de cette phrase : moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630208
					],
					"speakerTitle": "Nelly"
				}
			]
		},
		{
