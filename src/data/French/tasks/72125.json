				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721250501,
					"content": "Est-ce que ces graines que j'ai vous seront utiles ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250502
					]
				},
				{
					"id": 721250502,
					"content": "Hein...? Oh, waouh ! Oui, bien sûr ! Avec ça, je suis sûre de pouvoir faire pousser beaucoup de fleurs !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250503
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250503,
					"content": "Euh, euh, désolée. S'il vous plaît, attendez... Je dois vous donner quelque chose en retour...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250504
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250504,
					"content": "Voilà pour vous ! Merci pour ces graines. Vous verrez de belles fleurs lors de votre prochaine visite !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hanayama Kaoru"
				}
			]
		},
