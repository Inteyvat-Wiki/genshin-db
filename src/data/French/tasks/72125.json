			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hanayama Kaoru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721250102,
					"content": "Si seulement je pouvais planter plus de fleurs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250103
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250103,
					"content": "#Ah, bonjour ! Ravie de vous rencontrer... Excusez-moi, êtes-vous aussi {M#un résident}{F#une résidente} de retour ? Je suis désolée, je ne pense pas vous avoir déjà {M#vu}{F#vue}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250104,
						721250109
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250104,
					"content": "#{M#Un résident}{F#Une résidente} de retour ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250105
					]
				},
				{
					"id": 721250105,
					"content": "Oui. Après ce qui s'est passé au Fourneau Mikage, les habitants de Tatarasuna ont été évacués...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250106
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250106,
					"content": "Il y a quelque temps, j'ai entendu dire que tout allait bien avec le Fourneau et que Tatarasuna était en sécurité. Alors je suis allée demander si je pouvais revenir vivre ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250107
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250107,
					"content": "Après avoir obtenu l'autorisation, j'ai ramassé mes affaires et je suis revenue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250108
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250108,
					"content": "Mais... À part moi, il ne semble pas y avoir grand monde disposé à revenir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250115
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250115,
					"content": "Mais ce n'est pas de leur faute.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250116
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250116,
					"content": "Après tout ce qui s'est passé avec le Fourneau Mikage, tout le monde craint que cela ne se reproduise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250117
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250117,
					"content": "Ça ne vous inquiète pas ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250118
					]
				},
				{
					"id": 721250118,
					"content": "Bien sûr. Mais je suis très attachée à mon foyer... Et je ne pouvais pas arrêter de m'inquiéter pour mes fleurs, héhé. Alors j'ai décidé de revenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250119
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250119,
					"content": "Malheureusement, les fleurs que j'avais plantées ici se sont toutes fanées. Et en plus, je ne trouve plus de graines. C'est dommage...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250120
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250120,
					"content": "C'est un endroit idéal pour planter des fleurs. Peu importe les graines que vous semez, elles fleuriront avant même que vous ne vous en rendiez compte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250121
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250121,
					"content": "J'ai même déjà fait pousser des fleurs de l'étranger ici ! Des herbes à lampe de Mondstadt, et des chrysanthèmes à aubes, des pissenlits et aussi des fleurs de soie de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250122
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250122,
					"content": "Les herbes à lampes sont très jolies le soir, mais il faut les planter dans un endroit ombragé, les arroser régulièrement et tailler les feuilles mortes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250123
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250123,
					"content": "Les chrysanthèmes à aubes poussent bien là où il y a de la brise, mais je ne pense pas que le vent d'Inazuma soit comparable à celui de Mondstadt... Alors j'allais souvent les éventer avec un éventail. Je ne sais pas si ça aide...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250124
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250124,
					"content": "Les pissenlits sont le cadet de vos soucis : ils prennent soin d'eux-mêmes, mais... Ils poussent toujours dans toutes sortes d'endroits bizarres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250125
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250125,
					"content": "C'est pas faux ! Quoi qu'il en soit, je...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250126
					]
				},
				{
					"id": 721250126,
					"content": "Les fleurs de soie de Liyue, par contre, représentent beaucoup de travail. Les scarabutos aiment rester dans leurs pétales, alors je dois les enlever un par un de là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250127
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250127,
					"content": "Par contre, je n'ai pas réussi à faire pousser de fleurs de Qingxin ici... Soit elles n'ont pas poussé du tout, soit elles se sont fanées rapidement. *soupir* Je me demande s'il existe une sorte de lieu magique où toutes les fleurs peuvent s'épanouir en harmonie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250128
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250128,
					"content": "Peut-être bien... Maintenant, je...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250129
					]
				},
				{
					"id": 721250129,
					"content": "Oh... Saviez-vous qu'il existe une fleur à Liyue appelée muguet bleu ? Elle est très difficile à trouver. J'ai demandé à beaucoup de gens, mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250130
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250130,
					"content": "Ahem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250131
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250131,
					"content": "Ah ! Désolée... Je parle trop... Je suis comme ça quand je parle de fleurs. Je suis vraiment, vraiment désolée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250132
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250132,
					"content": "Vous... Vous vous y connaissez vraiment en fleurs...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250133
					]
				},
				{
					"id": 721250133,
					"content": "Je suis juste une amatrice, vraiment, héhéhé... Mais je n'ai même plus de graines en ce moment. Donc je ne peux rien faire pousser du tout...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250109,
					"content": "Je ne suis pas d'ici.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250110
					]
				},
				{
					"id": 721250110,
					"content": "Oh ? C'est vrai ? Je pensais avoir trouvé quelqu'un comme moi, qui avait envie de revenir habiter ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250111
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250111,
					"content": "Après ce qui s'est passé au Fourneau Mikage, les habitants de Tatarasuna ont été évacués...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250112
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250112,
					"content": "Il y a quelque temps, j'ai entendu dire que tout allait bien avec le Fourneau et que Tatarasuna était en sécurité. Alors je suis allée demander si je pouvais revenir vivre ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250113
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250113,
					"content": "Après avoir obtenu l'autorisation, j'ai ramassé mes affaires et je suis revenue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250114
