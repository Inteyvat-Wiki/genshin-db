			"dialogs": [
				{
					"id": 718040201,
					"content": "Ceci est le panneau d'affichage de la Pente Feiyun : vous y trouverez des informations sur la région, des annonces, des publicités, etc. Merci de ne pas mettre d'annonce sans autorisation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040202,
						718040205,
						718040208
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 718040202,
					"content": "Les mutations de personnel du Bureau des affaires civiles...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040203
					]
				},
				{
					"id": 718040203,
					"content": "« Le Bureau des affaires civiles a procédé aux mutations de personnel suivantes... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040204
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 718040204,
					"content": "Attends, mais ça n'a rien à voir avec le nouveau permis de travail !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040201
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718040205,
					"content": "La pollution des eaux de la Pente Feiyun...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040206
					]
				},
				{
					"id": 718040206,
					"content": "« Communiqué sur la pollution des eaux de la Pente Feiyun... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040207
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 718040207,
					"content": "Ivanovich a besoin qu'on l'informe sur le nouveau permis de travail. On s'occupera de cette affaire plus tard !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040201
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718040208,
					"content": "Regardons s'il y a quelque chose sur le nouveau permis de travail...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040209
					]
				},
				{
					"id": 718040209,
					"content": "« Si vous souhaitez demander un nouveau permis de travail, veuillez procéder comme suit... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040210
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 718040210,
					"content": "Ça doit être ce dont Ivanovich nous a parlé. Notons les démarches à faire et ramenons-les-lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7180403,
			"completionStepIds": [
				7180403
