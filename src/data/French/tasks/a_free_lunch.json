			"dialogs": [
				{
					"id": 741660701,
					"content": "#Les {M#amis}{F#amies} ! Nous sommes enfin à mon endroit préféré{NON_BREAK_SPACE}: l'Arène de pancrace ! C'est notre paradis !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660702
					],
					"speakerTitle": "Personne étrange"
				},
				{
					"id": 741660702,
					"content": "Ah bon ? C'est vraiment aussi bien que vous le dites ? C'est très différent de ce que j'ai entendu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660703,
					"content": "Bien sûr ! N'écoutez pas les rumeurs de l'extérieur. Elles sont répandues pour induire les gens en erreur. Venez, j'ai un formulaire de consentement ici, si vous le signez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660704
					],
					"speakerTitle": "Personne étrange"
				},
				{
					"id": 741660704,
					"content": "Hé ! Mais c'est toi ! Encore en train d'inciter les gens à signer des formulaires de consentement pour s'inscrire au tournoi, hein ? Tu ne t'en sortiras pas cette fois !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660705
					],
					"speakerTitle": "Geôlier"
				},
				{
					"id": 741660705,
					"content": "Vous avez de la chance que je l'ai remarqué avant que vous ne signiez !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660706
					],
					"speakerTitle": "Geôlier"
				},
				{
					"id": 741660706,
					"content": "Bref, ignorez ce type. Lui et l'organisation pour laquelle il travaille piègent des personnes insouciantes pour les faire participer à des tournois dangereux et gagner de l'argent sur leur dos !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660707
					],
					"speakerTitle": "Geôlier"
				},
				{
					"id": 741660707,
					"content": "Arrêtez de raconter n'importe quoi ! Je n'ai piégé personne ! C'étaient tous des amis, ils s'inscrivent de leur plein gré après que je leur ai recommandé le tournoi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660708
					],
					"speakerTitle": "Personne étrange"
				},
				{
					"id": 741660708,
					"content": "Mais oui, tu m'en diras tant ! Je connais un meilleur endroit où tu pourras débiter tes sottises. Allez, tu viens avec moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660709
					],
					"speakerTitle": "Geôlier"
				},
				{
					"id": 741660709,
					"content": "La personne étrange est escortée par le geôlier...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741660710
					]
				},
