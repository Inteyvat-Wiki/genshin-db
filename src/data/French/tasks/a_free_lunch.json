			"dialogs": [
				{
					"id": 741660601,
					"content": "C'est l'élévateur menant à la Zone de production.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660602
					],
					"speakerTitle": "Personne étrange"
				},
				{
					"id": 741660602,
					"content": "Il n'y a pas de rumeurs étranges qui concernent cet endroit, cette fois-ci ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660603,
					"content": "Non, c'est juste que je déteste ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660604
					],
					"speakerTitle": "Personne étrange"
				},
				{
					"id": 741660604,
					"content": "Oh ? Pourquoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660605,
					"content": "Parce que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660606
					],
					"speakerTitle": "Personne étrange"
				},
				{
					"id": 741660606,
					"content": "Parce que ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660607,
					"content": "Parce que je ne veux pas travailler !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660608
					],
					"speakerTitle": "Personne étrange"
				},
				{
					"id": 741660608,
					"content": "Je suis détenu à la Forteresse parce que je ne voulais pas travailler. J'ai volé une miche de pain parce que j'avais très faim, et j'ai été condamné en conséquence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660609
					],
					"speakerTitle": "Personne étrange"
				},
				{
					"id": 741660609,
					"content": "Mais pourquoi dois-je encore trimer ici ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660610
					],
					"speakerTitle": "Personne étrange"
				},
				{
					"id": 741660610,
					"content": "« La moindre tâche m'achève ! » C'est mon leitmotiv !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660611
					],
					"speakerTitle": "Personne étrange"
				},
				{
					"id": 741660611,
					"content": "Ouh, j'ai l'impression qu'il devient bizarre en restant ici. Allons ailleurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
