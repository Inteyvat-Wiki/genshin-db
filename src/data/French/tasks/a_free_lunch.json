				]
			},
			"dialogs": [
				{
					"id": 741660201,
					"content": "#Excusez-moi, {M#jeune homme}{F#jeune femme}. Oui, vous ! Venez par ici{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660202
					],
					"speakerTitle": "Personne étrange"
				},
				{
					"id": 741660202,
					"content": "C'est à nous que vous parlez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660203,
					"content": "#Oh, mes {M#amis}{F#amies}, j'ai tout de suite vu que vous étiez {M#nouveaux}{F#nouvelles} dans le coin. Vous ne devez pas très bien connaître la Forteresse de Méropide, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660204
					],
					"speakerTitle": "Personne étrange"
				},
				{
					"id": 741660204,
					"content": "#Félicitations ! Vous êtes {M#tombés}{F#tombées} sur moi aujourd'hui, le résident le plus sympa de ces lieux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660205
					],
					"speakerTitle": "Personne étrange"
				},
				{
					"id": 741660205,
					"content": "Je prévois de vous faire visiter la Forteresse de Méropide. Et « gratuitement », bien sûr !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660206
					],
					"speakerTitle": "Personne étrange"
				},
				{
					"id": 741660206,
					"content": "À vrai dire, je connais bien les lieux.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741660207
					]
				},
				{
					"id": 741660207,
					"content": "Ah, ne dites pas ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660208
					],
					"speakerTitle": "Personne étrange"
				},
				{
					"id": 741660208,
					"content": "Vous pensez connaître cet endroit, mais grâce à mon expertise, vous découvrirez les lieux sous un autre angle !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660209
					],
					"speakerTitle": "Personne étrange"
				},
				{
					"id": 741660209,
					"content": "Ça existe vraiment les choses gratuites ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741660210
					]
				},
				{
					"id": 741660210,
					"content": "Bien sûr que oui ! Je suis le plus sympa des résidents de la Forteresse, après tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660211
					],
					"speakerTitle": "Personne étrange"
				},
				{
					"id": 741660211,
					"content": "Hm, ce type est bizarre. On vient à peine de se rencontrer, mais il se prend déjà pour notre ami !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660212,
					"content": "Haha ! Ne réfléchissez pas trop ! Je vais vous laisser parler et attendre sagement ici que vous preniez une décision.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660213
					],
					"speakerTitle": "Personne étrange"
				},
				{
					"id": 741660213,
					"content": "#Venez me voir une fois que vous vous serez {M#décidés}{F#décidées}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Personne étrange"
				}
			]
		},
