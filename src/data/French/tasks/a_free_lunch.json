			"dialogs": [
				{
					"id": 741660501,
					"content": "Voici où se trouve la Troupe Tri-coupon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660502
					],
					"speakerTitle": "Personne étrange"
				},
				{
					"id": 741660502,
					"content": "C'est tout ce que vous avez à nous dire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660503,
					"content": "Vous n'avez pas réussi à faire le lien ? Qui dit troupe, dit théâtre ! Qui dit théâtre, dit romance ! Qui dit romance, dit amour !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660504
					],
					"speakerTitle": "Personne étrange"
				},
				{
					"id": 741660504,
					"content": "Il paraît que vous trouverez le grand amour si vous venez ici tous les jours pour assister à leurs représentations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660505
					],
					"speakerTitle": "Personne étrange"
				},
				{
					"id": 741660505,
					"content": "Ce genre de rumeur existe vraiment ? Les gens doivent se bousculer pour voir les spectacles alors ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660506,
					"content": "Oui, mais pour que ça se réalise, il ne faut pas être un geôlier ou un détenu de la Forteresse de Méropide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660507
					],
					"speakerTitle": "Personne étrange"
				},
				{
					"id": 741660507,
					"content": "#Du coup, personne ne peut trouver son grand amour{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660508,
					"content": "C'est peut-être là qu'est le cœur du problème. Enfin, dirigeons-nous vers notre prochain arrêt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Personne étrange"
				}
			]
		},
