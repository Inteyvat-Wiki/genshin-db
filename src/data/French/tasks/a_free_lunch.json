			"dialogs": [
				{
					"id": 741660301,
					"content": "#Alors ? Vous vous êtes {M#mis}{F#mises} d'accord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660302
					],
					"speakerTitle": "Personne étrange"
				},
				{
					"id": 741660302,
					"content": "Vous avez dit que ce serait gratuit, alors ne comptez pas sur nous pour lâcher un mora !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660303,
					"content": "Évidemment que ce sera « gratuit ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660304
					],
					"speakerTitle": "Personne étrange"
				},
				{
					"id": 741660304,
					"content": "Allez, je vais vous faire visiter la Forteresse de Méropide !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Personne étrange"
