			"dialogs": [
				{
					"id": 741660401,
					"content": "Voici la Cantine à coupons. Tout le monde peut récupérer une ration caritative par jour ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660402
					],
					"speakerTitle": "Personne étrange"
				},
				{
					"id": 741660402,
					"content": "Cependant, vous ne savez pas du tout ce que vous mangerez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660403
					],
					"speakerTitle": "Personne étrange"
				},
				{
					"id": 741660403,
					"content": "C'est le genre d'information que tout le monde apprend lors de la première visite !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660404,
					"content": "Calmez-vous, j'ai aussi des informations secrètes. On raconte qu'il y a code secret que vous pouvez dire à Bran quand vous demandez votre ration caritative ! Ça vous permettra d'obtenir le légendaire repas mystère !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660405
					],
					"speakerTitle": "Personne étrange"
				},
				{
					"id": 741660405,
					"content": "Ah bon ? Quel code ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660406,
					"content": "Malheureusement, je ne le sais pas. J'attends le jour où vous le découvrirez vous-même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660407
					],
					"speakerTitle": "Personne étrange"
				},
				{
					"id": 741660407,
					"content": "C'est moi qui devrais dire ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660408,
					"content": "Ne vous préoccupez pas des détails ! Notre prochain arrêt est la Troupe Tri-coupon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Personne étrange"
				}
			]
		},
