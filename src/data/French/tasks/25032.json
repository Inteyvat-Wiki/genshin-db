			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zicheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250320601,
					"content": "Vous voilà ! Avez-vous pris des photos ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320602
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320602,
					"content": "Oui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320603
					]
				},
				{
					"id": 250320603,
					"content": "Waouh... Elles sont belles ! Beaucoup plus belles que celles de mon assistant. Il doit souvent les reprendre plusieurs fois avant d'avoir le bon cliché sur les sites qu'on inspecte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320604
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320604,
					"content": "Si vous étiez avec moi pendant les relevés de terrain, je suis sûr qu'on aurait cassé moins de Daguerréotypes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320605
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320605,
					"content": "Ces photos peuvent vraiment vous aider à écrire des poèmes ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320606
					]
				},
				{
					"id": 250320606,
					"content": "Je pense que... oui ? Au pire, si ça ne donne rien, j'en ferai des cartes postales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320607
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320607,
					"content": "J'écrirai des messages au dos et les enverrai aux collègues de bureau. Comme ça, personne ne pourra rien me dire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320608
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320608,
					"content": "Ahem... Mais c'est le dernier recours. Je dois quand même essayer jusqu'au bout...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320609
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320609,
					"content": "Les cinq vents... soufflent ? Non, rugissent ?... Attendez, combien y a-t-il de tribus à Natlan ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zicheng"
				}
			]
		},
		{
