			},
			"dialogs": [
				{
					"id": 250321001,
					"content": "Ah oui ! J'ai entendu des gens dire que le Peuple des sources ont des enseignes de magasins très particulières, dont celle du Studio Djembe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250321002
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250321002,
					"content": "Prenez une photo de ce studio le matin, s'il vous plaît !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zicheng"
				}
			]
		},
