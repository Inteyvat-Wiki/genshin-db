	"talks": [
		{
			"id": 2503201,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2503201",
							"2"
						],
						"stepId": 2503201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zicheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250320101,
					"content": "Hmm... Évoquer la poésie avec la peinture ou peindre en apportant une touche de poésie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320102
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320102,
					"content": "Hmm... Non, ces deux phrases veulent dire la même chose, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320103,
						250320104
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320103,
					"content": "Que dites-vous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320105
					]
				},
				{
					"id": 250320105,
					"content": "Bonjour. Oui, j'essaye d'écrire un poème sur les paysages de Natlan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320106
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320106,
					"content": "Mais... À vrai dire, le paysage ici est très différent de celui de Liyue. En plus, je ne connais pas l'histoire de Natlan, alors je n'ai aucune inspiration.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320107
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320107,
					"content": "Et je ne suis pas un poète digne de ce nom... Mes rimes ne sont pas terribles, j'ai du mal à écrire mes vers...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320108
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320108,
					"content": "Hélas... Mais je ne peux pas rentrer bredouille de ce voyage. Mes collègues du Bureau des affaires civiles vont dire que j'ai trouvé la « dépression plutôt que l'inspiration »...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320109
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320109,
					"content": "Vous travaillez au Bureau des affaires civiles ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320110
					]
				},
				{
					"id": 250320110,
					"content": "Oui. J'ai été engagé il y a quelque temps par le bureau pour effectuer des relevés de terrain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320111
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320111,
					"content": "En fait, il s'agit simplement de faire quelques tours de Liyue avec quelques personnes pour voir s'il y a des changements concernant le sol et les cours d'eau, et si la carte a besoin d'être modifiée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320112
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320112,
					"content": "Comme ce travail m'a épuisé, sans parler du nombre de chaussures que j'ai usées... J'ai donc décidé de prendre congé pour voyager.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320113
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320113,
					"content": "C'est juste que... Je ne sais pas à quoi je pensais, mais dans ma demande de congé, j'ai écrit : j'ai envie d'écrire de la poésie, alors j'aimerais partir à la recherche d'inspiration.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320114
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320114,
					"content": "Et à ma grande surprise, la personne responsable des congés m'a répondu très sérieusement : « J'espère que vous serez prolifique »... en m'accordant un demi-mois de congé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320115,
						250320117
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320115,
					"content": "C'est une bonne nouvelle, non ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320116
					]
				},
				{
					"id": 250320116,
					"content": "Bonne nouvelle ? Pas du tout ! Tout le Bureau des affaires civiles est au courant de mon formulaire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320119
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320119,
					"content": "*soupir* C'est vrai que je m'amuse bien à Natlan. Les paysages sont beaux, la nourriture est délicieuse et il y a toutes sortes de créatures, surtout les saurienneaux qui sont très mignons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320120
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320120,
					"content": "Mais, je ne suis pas arrivé à écrire un seul vers jusqu'à maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320121
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320121,
					"content": "J'ai même emprunté un Daguerréotype pour récupérer de l'inspiration, mais mes clichés ne m'inspirent pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320122
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320122,
					"content": "Je sais me débrouiller avec les paysages, mais dès que c'est des magasins ou des gens... Je n'y arrive pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320123,
						250320124
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320123,
					"content": "Je peux vous aider ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320125
					]
				},
				{
					"id": 250320125,
					"content": "Vraiment ?! Merci, enfin quelqu'un peut m'aider... Je dois vraiment trouver l'inspiration coûte que coûte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320126
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320126,
					"content": "Laissez-moi réfléchir un peu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320124,
					"content": "Je prends de très belles photos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320125
					]
				},
				{
					"id": 250320117,
					"content": "Du coup, vous avez eu de la chance avec vos poèmes ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320118
					]
				},
				{
					"id": 250320118,
					"content": "Pas le moins du monde, mais la nouvelle de mes congés et de leur but s'est quand même répandue comme une traînée de poudre. Maintenant, tout le monde au travail sait pourquoi je suis allé à Natlan !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320119
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320104,
					"content": "Vous écrivez un poème ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320105
					]
				}
			]
		},
		{
