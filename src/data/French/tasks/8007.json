			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80071001,
					"content": "Est-ce que c'était... l'esprit de Halfdan ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071002,
					"content": "Il y a plus d'une force mystérieuse en ce lieu. Ce n'est donc pas étrange de voir un esprit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071003
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071003,
					"content": "Mais si vous souhaitez vous aventurer davantage dans les profondeurs, prenez garde à vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071004
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071004,
					"content": "*tousse* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071005
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071005,
					"content": "#Oui, on sera {M#vigilants}{F#vigilantes}. Ah, mais vous ne venez pas avec nous, Dain ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071006,
					"content": "Ce dispositif m'a causé d'importantes blessures. J'ai besoin d'un peu de temps pour récupérer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071007
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071007,
					"content": "Je vois... Euh, non. En fait, je l'ai remarqué depuis longtemps ! Vous vous forcez depuis tout à l'heure !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071008,
					"content": "Allez vous reposer, Dain... Vous pouvez prendre des vacances ou quelque chose comme ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071009,
					"content": "Des vacances ? C'est un mot que l'on ne saurait associer avec moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071010
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071010,
					"content": "J'ai d'autres choses importantes à faire. Le plan des fils du destin est encore en cours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071011
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071011,
					"content": "Je soupçonne même ce dispositif d'amplification d'avoir un lien avec ce plan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071012,
						80071013
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071012,
					"content": "Je garderai l'œil ouvert.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80071014
					]
				},
				{
					"id": 80071014,
					"content": "#Merci de votre compréhension, {M#cher « employeur »}{F#chère « employeuse »}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071015
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071015,
					"content": "J'espère ne pas vous voir dans l'autre camp à notre prochaine rencontre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071016
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071016,
					"content": "Hé, tu ne trouves pas que Dain est un peu rancunier ? Il nous dit ça au dernier moment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071017
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071017,
					"content": "#Même si on n'a pas réussi à revoir {M#ta sœur}{F#ton frère}, on a tout de même obtenu beaucoup d'informations utiles, tu ne trouves pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071018
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071018,
					"content": "#Si on continue à voyager, tu finiras par {M#la}{F#le} retrouver. Vous vous réconcilierez, et tout sera comme avant, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071019
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071019,
					"content": "#D'ailleurs, je viens de me souvenir qu'on était {M#venus}{F#venues} ici pour enquêter sur les activités des Brutocollinus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071020
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071020,
					"content": "On va pouvoir faire notre rapport au mineur. C'est juste que... ça va être délicat à expliquer. Pas facile pour des gens ordinaires de comprendre ce qu'il se passe ici !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071021
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071021,
					"content": "Bref, on ne doit pas oublier notre mission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071013,
					"content": "Quand vous vous serez remis, nous discuterons à nouveau.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80071014
					]
				}
			]
		},
