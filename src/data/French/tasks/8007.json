				"points": []
			},
			"dialogs": [
				{
					"id": 80070101,
					"content": "Moi qui pensais qu'il disparaîtrait en un instant... L'esprit de Halfdan est étonnamment tenace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070102
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070102,
					"content": "Écarte-toi de là, importun !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070103
					],
					"speakerTitle": "Chanoine de l'Abîme"
				},
				{
					"id": 80070103,
					"content": "Qu'est-ce que tu regardes ? Tu as enfin l'occasion de te débarrasser de moi... C'est une belle opportunité, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070104
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070104,
					"content": "... Dainsleif !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070105
					],
					"speakerTitle": "Chanoine de l'Abîme"
				},
				{
					"id": 80070105,
					"content": "Éliminez-le, et désactivez ce dispositif !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				}
			]
		},
		{
			"id": 800703,
			"completionStepIds": [
				800703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
