			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80070301,
					"content": "Que faire ? Même après s'être occupé de ce Chanoine de l'Abîme, le dispositif ne s'est pas arrêté...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80070302,
					"content": "Halfdan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070303,
						80070304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80070303,
					"content": "Laissez-moi le remplacer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80070305
					]
				},
				{
					"id": 80070305,
					"content": "#Non ! Tant que le dispositif fonctionne, tous ceux qui sont touchés par la malédiction seront incapables d'utiliser toutes leurs forces. Vous {M#seul}{F#seule} pouvez arrêter l'Abîme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070306
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070306,
					"content": "Si son sacrifice est important à vos yeux, alors ne perdez pas de temps ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070307
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070307,
					"content": "Vous voyez ces portails et ces rayons lumineux autour de nous ? Ils ont certainement installé les dispositifs d'énergie à des endroits séparés. Allons voir ce qu'il en est, dépêchons-nous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070308
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070308,
					"content": "On doit traverser ces portails de l'Abîme ? Hé, attendez-moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80070304,
					"content": "Je ne subirai pas les effets de la purification.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80070305
					]
				}
			]
		},
		{
			"id": 800709,
			"completionStepIds": [
				800709
