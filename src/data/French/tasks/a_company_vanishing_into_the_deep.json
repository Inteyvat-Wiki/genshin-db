			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106207",
							"2"
						],
						"stepId": 7106207,
						"stateName": "QUEST_STATE_UNFINISHED"
