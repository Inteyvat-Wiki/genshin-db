				"objectNames": [
					"Anton"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620137,
					"content": "Commencez par me dire quels sont vos plans.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620140
					]
				},
				{
					"id": 710620140,
					"content": "Alors voilà : tu peux en douter autant que tu le veux, mais on est ici pour enquêter sur la source de la calamité dans le Gouffre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620141
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620141,
					"content": "Quelle calamité ? Je n'ai rien vu d'anormal dans le Gouffre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710620142,
					"content": "La calamité qui s'est produite il y a cinq cents ans. Ce n'était qu'un prélude : la guerre contre les ténèbres n'a jamais cessé et nous nous trouvons sur l'un des champs de bataille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620143
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620143,
					"content": "*soupir* Notre sergent-chef est tellement affamé qu'il se met à tout exagérer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620144
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620144,
					"content": "Il adore en faire des tonnes... Mais c'est la première fois qu'il dit vraiment n'importe quoi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620145
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620145,
					"content": "Ça va, ça va ! Ce qu'Antoha veut dire, c'est que vous, les gens de Liyue, n'êtes pas nos ennemis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620146
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620146,
					"content": "Du moins, vous n'êtes pas les ennemis de la Neuvième compagnie dans cette opération... Par contre, je ne suis pas sûr que nos camarades qui sont éparpillés un peu partout seront du même avis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620147
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620147,
					"content": "Bon, je vais vous aider par pure gentillesse, mais c'est juste pour cette fois.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620148
					]
				},
				{
					"id": 710620148,
					"content": "Merci, merci à toi ! On s'en souviendra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anton"
				}
			]
		},
