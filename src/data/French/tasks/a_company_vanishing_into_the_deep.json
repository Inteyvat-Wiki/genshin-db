			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anton",
					"Radomir",
					"Danila",
					"Temur"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710621101,
					"content": "Vous êtes de retour ! Alors ? Vous avez du nouveau ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621102
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621102,
					"content": "La station d'approvisionnement a été abandonnée.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621103
					]
				},
				{
					"id": 710621103,
					"content": "Je vois... Avez-vous trouvé quelque chose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621104
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621104,
					"content": "Vous n'êtes plus les bienvenus au Port de Liyue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621105
					]
				},
				{
					"id": 710621105,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621106
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621106,
					"content": "Et à part ça, vous avez d'autres nouvelles ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621107
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621107,
					"content": "Hmm, on a trouvé une lettre. Elle semble vous être destinée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710621108,
					"content": "La voici...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621109
					]
				},
				{
					"id": 710621109,
					"content": "Les Fatui lisent la lettre un à un...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710621110
					]
				},
				{
					"id": 710621110,
					"content": "Une lettre de Yanbo. Je vois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621111
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621111,
					"content": "Qu'est-ce qu'il y a ? Les Millelithes sont partis ? Laisse-moi lire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621112
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710621112,
					"content": "*soupir* C'est quoi leur problème ? On se bat pour eux ! On est alliés !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621113
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710621113,
					"content": "Il n'y a plus d'alliance qui tienne. Nos liens ont été rompus... Pour être précis, les liens entre les Fatui et Liyue ont été rompus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621131
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710621131,
					"content": "C'est une trahison ! Liyue nous a trahis !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621132
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710621132,
					"content": "Peut-être que c'est l'inverse pour les Liyuéens ? Ils considèrent que ce sont les Fatui qui les ont trahis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621114
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710621114,
					"content": "De qui se moque-t-on ?! On est venus ici pour protéger le peuple de Liyue ! Vous vous souvenez de ce que le capitaine disait à notre départ ? « Cette expédition n'a rien à voir avec quelconque complot ou coup fourré » !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621115
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710621115,
					"content": "Et pourtant, ça n'a pas empêché les complots et les coups fourrés de nous tomber dessus... C'est quelque chose qu'on ne peut pas contrôler, Danila.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621116
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710621116,
					"content": "C'est bon, j'ai compris. *soupir* J'ai pris ma décision : on doit partir d'ici. Le plus vite possible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621117
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621117,
					"content": "Pas d'inquiétude, c'est moi qui endosserai toutes les responsabilités. C'est moi — et moi seul — qui déserterai et apporterai le déshonneur à la Neuvième compagnie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621118
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621118,
					"content": "Danila a raison, on est venus ici pour protéger les Liyuéens de la calamité des ténèbres. On ne peut pas partir comme ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621119
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710621119,
					"content": "Tu crois vraiment que c'est le moment de t'inquiéter de ton honneur personnel, Mirka ? Tu n'as pas compris ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621120
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621120,
					"content": "Les Liyuéens n'ont pas besoin qu'on les protège, et ils ne veulent pas de nous ici ! Ils ont même battu nos camarades qui se croyaient invincibles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621121,
						710621122
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621121,
					"content": "Tout à fait. Vous avez trahi la confiance du peuple de Liyue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621123
					]
				},
				{
					"id": 710621123,
					"content": "Préparons-nous à évacuer les lieux. Il faut absolument partir dans le plus grand silence pour ne pas alerter les Millelithes présents.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621124
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621124,
					"content": "Le capitaine a dit qu'on devait être prêts à donner nos vies ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621125
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710621125,
					"content": "Et il a aussi affirmé qu'il ne laisserait personne se sacrifier en vain ! Il a dit qu'il ne souhaitait pas que la compagnie finisse enterrée ici !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621126
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621126,
					"content": "Au moins, on est encore en vie. La Neuvième compagnie est toujours debout, tu comprends ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621127
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621127,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621128
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710621128,
					"content": "Oui, chef.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621129
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710621129,
					"content": "Bien ! D'autres questions ? Je ne veux plus entendre aucune autre objection. Rompez !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621130
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621130,
					"content": "#En tout cas, merci pour ton aide, {NICKNAME}. Prends ces quelques moras et ces fournitures.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621122,
					"content": "Vous feriez mieux de réfléchir à ce que vous allez faire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621123
					]
				}
			]
		},
