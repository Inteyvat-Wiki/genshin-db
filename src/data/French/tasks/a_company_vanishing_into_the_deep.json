						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anton"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620119,
					"content": "Pourquoi je vous aiderais ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620121
					]
				},
				{
					"id": 710620121,
					"content": "Qu'est-ce que tu veux ? Des fournitures, des armes, des renseignements, des moras, on en a plein. Prends-les si c'est ce que tu veux, tant que tu nous aides.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620122
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620122,
					"content": "Regardez ! Notre chef de compagnie s'attelle à la tâche la plus humiliante qui soit : il mendie ! ... Merveilleux ! Le peu de dignité qui nous restait s'est envolé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620123
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620123,
					"content": "Arrête un peu avec ton sarcasme ! Ce n'est pas en ironisant que tu rempliras ta panse !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620124
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620124,
					"content": "« Rejoignez nos rangs ! Que nos bottes fassent trembler la terre avec la force du tonnerre ! Vous qui souhaitez marcher avec nous vers l'étoile polaire de la nuit blanche, rejoignez-nous ! Nous ne vous abandonnerons jamais... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620125
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620125,
					"content": "Qu'on le fasse taire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620126
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620126,
					"content": "Hmm... Même si ce sont de mauvaises personnes, les voir si affamés fait de la peine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710620127,
					"content": "J'ai honte de l'admettre, mais... Comme tu peux le voir, on a perdu toute volonté de se battre. On veut juste un peu de nourriture.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anton"
				}
			]
		},
		{
			"id": 7106218,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_NOT_RECEIVE",
						"rawParams": [
							"7106205",
