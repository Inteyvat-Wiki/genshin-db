	"talks": [
		{
			"id": 7106201,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106201",
							"2"
						],
						"stepId": 7106201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Anton"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620101,
					"content": "#Pouf... Désolé de vous déranger si vous êtes {M#pressés}{F#pressées}. Je suis le sergent-chef Anton Melnikov, le... chef intérimaire de la Neuvième compagnie. Tu peux m'appeler Anton, tout simplement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620102
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620102,
					"content": "Et voici Danila, Temur, Radomir et... Euh, Romanski n'est pas là, il est... au camp médical.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620103
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620103,
					"content": "Il n'y a plus de Romanski, ni de camp médical d'ailleurs. Antoha... Romanski n'a pas tenu le coup...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620104
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620104,
					"content": "Danila... Combien de fois te l'ai-je dit ? Je suis le chef de la compagnie, maintenant. Tu dois m'appeler sergent-chef Anton !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620105
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620105,
					"content": "Ha ! Le chef de la compagnie ? Un sergent-chef ? Pour qui te prends-tu, Antoha ? Depuis que le capitaine a disparu, tu fais comme si tu étais un gradé important ! Laisse-moi rire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620106
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620106,
					"content": "Ça suffit, Temur. Avoir le ventre vide te brouille l'esprit. Garde tes forces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620107
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620107,
					"content": "Tu es le chef de la compagnie par INTÉRIM, Antoha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620149
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620149,
					"content": "Un chef par intérim, mais quelle blague ! Pendant combien de temps encore doit-on recevoir des ordres de ce faux commandant qui ne sait même pas ce qu'il fait ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620150
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620150,
					"content": "Dis-moi, Temur, c'est être affamé qui te fait perdre la boule comme ça ? Que dirais-tu de quelques baffes pour te faire reprendre tes esprits ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620151
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620151,
					"content": "Viens, je t'attends ! Si tu as faim, tu peux manger mon pied !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620152
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620152,
					"content": "Génial ! Après avoir épuisé nos rations, on perd la raison. C'est merveilleux ! On est en train de dépenser nos dernières forces...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620108
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620108,
					"content": "Ahem ! Silence ! Vous voulez vous battre ? Alors, descendez vous mesurer à ces choses qui sortent de la boue noire ! Allez-y, avec vos ventres vides !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620109
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620109,
					"content": "Si on veut survivre et s'en aller d'ici, alors il faut rester unis ! Je ne veux pas avoir à me répéter, est-ce bien clair ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620110
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620110,
					"content": "Un, deux, avec moi ! Qui d'autre que moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620111
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620111,
					"content": "Qui d'autre que moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620112
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620112,
					"content": "Qui d'autre que moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620113
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620113,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620153
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620153,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620114
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620114,
					"content": "#Euh... Héhé... Comme tu peux le voir, mon {M#ami}{F#amie}... on manque un peu de motivation, ici. Il faut dire qu'on a eu quelques imprévus dernièrement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620115
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620115,
					"content": "Hmph... « Quelques imprévus » ! Tu reprends même la façon de parler du capitaine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620116
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620116,
					"content": "Le capitaine n'est pas là, alors c'est moi le chef de la compagnie ! Économise tes forces et ferme ton bec !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620117
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620117,
					"content": "#Désolé pour ça... Mon {M#ami}{F#amie}, on a besoin de ton aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anton"
				}
			]
		},
		{
			"id": 7106202,
