					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500305
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760500305,
					"content": "#Moi, je laisse tomber... Devine, {NICKNAME}.",
