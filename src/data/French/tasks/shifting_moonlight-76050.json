					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500307
					]
				},
				{
					"id": 760500307,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500308
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 760500308,
					"content": "Ouah, cette réaction veut dire que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500309,
					"content": "Bravo, c'est la bonne réponse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760500310,
					"content": "C'est... un rhinocéros à long cou.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500311
					]
				},
				{
					"id": 760500311,
					"content": "Avec une grave blessure au cou, alors !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500312,
					"content": "Hmm... Je n'ai jamais vu de créature pareille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500313
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760500313,
					"content": "La bonne réponse est un cerf à cornes givrées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500314
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760500314,
					"content": "Revenez, mes petites.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760500315,
					"content": "Un harpon avec une pointe recourbée vers l'arrière.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500316
					]
				},
				{
					"id": 760500316,
					"content": "Tu as une imagination débordante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500317,
