			"dialogs": [
				{
					"id": 760500101,
					"content": "~ !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500102
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 760500102,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500103
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 760500103,
					"content": "Ouah, c'est animé ici aujourd'hui ! Toutes ces kuuhenkis dansent autour de Columbina !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500104,
					"content": "Euh... En fait, elles ne dansent pas. On dirait plutôt qu'elles essaient de... l'enterrer vivante avec leur mignonitude !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500105,
					"content": "A—Aidez-moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500106
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760500106,
					"content": "Donnez-moi la main.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500107
					]
				},
				{
					"id": 760500107,
					"content": "Pfiou... Merci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500108
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760500108,
					"content": "Qu'est-ce qui leur a pris ? D'habitude, elles ne sont pas aussi énergiques.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500109,
					"content": "~ !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500110
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 760500110,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500111
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760500111,
					"content": "J'ai décidé de jouer à un jeu avec les petites, et elles ont l'air de s'être beaucoup investies...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500112
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760500112,
					"content": "Elles se rassemblent autour de vous après avoir joué... Un peu comme des chiots, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500113,
					"content": "C'est peut-être leur façon de montrer leur gratitude.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500114
					]
				},
				{
					"id": 760500114,
					"content": "Mais cette fois j'ai eu l'impression d'avoir été emportée par une avalanche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500115
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760500115,
					"content": "C'est ce que vous dites, mais je parie que vous ne ratez jamais une occasion de les gâter !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500116,
					"content": "#En tout cas, voudriez-vous essayer {M#tous}{F#toutes} les deux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500117,
						760500119
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760500117,
					"content": "#Vous voulez dire... être {M#entourés}{F#entourées} comme vous l'étiez ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500118
					]
				},
				{
					"id": 760500118,
					"content": "Hm... C'est possible. Il suffit d'obtenir la bonne réponse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500121
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760500121,
					"content": "Ça me va. Ce sera intéressant de voir à quoi ressemble le jeu qui les captive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500122,
					"content": "Allez-y.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500123
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760500123,
					"content": "~ !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500124
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 760500124,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 760500119,
					"content": "Vous voulez qu'on joue avec les kuuhenkis ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500120
					]
				},
				{
					"id": 760500120,
					"content": "Oui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500121
					],
					"speakerTitle": "Columbina"
				}
			]
