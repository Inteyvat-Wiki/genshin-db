						760500903
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 760500903,
					"content": "Alors, c'est comment ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500904,
					"content": "Elles sont toutes douces et moelleuses.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500905
					]
				},
				{
					"id": 760500905,
					"content": "#Attendez, on est {M#récompensés}{F#récompensées} même si on s'est {M#trompés}{F#trompées} ? Je ne suis pas contre un prix de consolation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500906,
					"content": "Vous êtes mignonnes comme tout...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500907
					]
				},
				{
					"id": 760500907,
					"content": "Les kuuhenkis vous aiment beaucoup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500908
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760500908,
					"content": "Je peux le sentir. Elles sont à l'aise en votre présence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500909
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760500909,
					"content": "Tout comme les cerfs aux cornes givrées aiment se baigner dans le clair de lune, les kuuhenkis sont attirées par ce que votre cœur irradie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500910
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760500910,
					"content": "Et de quoi s'agit-il exactement ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500911
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500911,
					"content": "De la gentillesse et de la douceur, je suppose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				}
			]
