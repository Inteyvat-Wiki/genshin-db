			"trigger": {
				"objectNames": [
					"Godwin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200370101,
					"content": "Qu'est-ce que je ne donnerais pas pour pouvoir rentrer à Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370102
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370102,
					"content": "Oh, c'est vous ! J'ai une faveur à vous demander.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370103
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370103,
					"content": "Je suis en train de patrouiller avec les chevaliers de l'Ordre en ce moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370104
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370104,
					"content": "Mais j'avais promis à ma petite amie que je lui enverrai une lettre pour qu'elle sache que tout va bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370105
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370105,
					"content": "Et bien sûr, avec tout ce que j'ai eu à faire depuis, cette <color=#00E1FFFF>lettre</color> m'était complètement sortie de l'esprit... Pourriez-vous la transmettre à <color=#00E1FFFF>Gloria</color> ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370106
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370106,
					"content": "C'est pour Gloria ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370107
					]
				},
				{
					"id": 200370107,
					"content": "Une jeune fille aveugle qui voulait qu'on lui rapporte des graines de pissenlit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200370108,
					"content": "Je vois ! Vous êtes Godwin, c'est ça ? Gloria m'a parlé de vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200370109,
					"content": "Hein ? D'où la connaissez-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370110
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370110,
					"content": "On lui a rendu un petit service, il n'y a pas si longtemps que ça.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370111
					]
				},
				{
					"id": 200370111,
					"content": "Vraiment ? C'était pour quelque chose de dangereux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370112
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370112,
					"content": "Non, elle nous a juste demandé de lui rapporter quelques graines de pissenlit pour vous transmettre un message.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200370113,
					"content": "Ça ressemble bien à une chose qu'elle ferait. Sacrée Gloria !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370114
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370114,
					"content": "Par contre, elle nous a dit que vous étiez très loin d'ici ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370115
					]
				},
				{
					"id": 200370115,
					"content": "Ah, oui. C'est vrai que je suis censé l'être. Laissez-moi vous expliquer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370116
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370116,
					"content": "Vous savez que le Grand Maître a quitté Mondstadt avec la plupart de nos chevaliers, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370117
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370117,
					"content": "Bah, je faisais partie de ces chevaliers, mais je me suis rendu compte sur le départ que j'avais perdu le porte-bonheur que Gloria m'avait donné. Quand je l'ai retrouvé, mes collègues étaient déjà partis depuis longtemps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370118
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370118,
					"content": "Je ne sais toujours pas où ils sont, alors c'est pour ça que j'erre dans les environs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370119
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370119,
					"content": "Et impossible de retourner à Mondstadt, sinon je serais la risée de l'Ordre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370120
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370120,
					"content": "J'ai promis à Gloria de lui envoyer des lettres et des cadeaux du monde entier ! Vous vous rendez compte ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370121
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370121,
					"content": "Si jamais elle apprend que je n'ai jamais fait un pas hors de Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370122
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370122,
					"content": "C'était donc ça votre problème ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200370123,
					"content": "Allez donner cette <color=#00E1FFFF>lettre</color> à <color=#00E1FFFF>Gloria</color>, je vous en supplie. Elle doit vraiment s'inquiéter pour moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370124,
						200370126
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370124,
					"content": "Hmm, d'accord.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370125
					]
				},
				{
					"id": 200370125,
					"content": "Merci de m'aider à garder mon secret.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370126,
					"content": "Pourquoi n'utilisez-vous pas des graines de pissenlit pour lui transmettre un message ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370127
					]
				},
				{
					"id": 200370127,
					"content": "J'ai vraiment trop de choses à lui dire, quelques graines de pissenlit ne suffiront pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370128
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370128,
					"content": "Merci encore, et surtout, ne lui dites rien !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Godwin"
				}
			]
		},
