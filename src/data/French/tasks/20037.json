				"points": []
			},
			"dialogs": [
				{
					"id": 200370301,
					"content": "#Bonjour {M#voyageur}{F#voyageuse}. C'est vous, pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370302
					],
					"speakerTitle": "Gloria"
				},
				{
					"id": 200370302,
					"content": "Je peux vous aider ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370303
					],
					"speakerTitle": "Gloria"
				},
				{
					"id": 200370303,
					"content": "On m'a demandé de vous remettre une lettre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370304
					]
				},
				{
					"id": 200370304,
					"content": "Une lettre ? De la part de qui ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370305
					],
					"speakerTitle": "Gloria"
				},
				{
					"id": 200370305,
					"content": "De Godwin ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370306
					],
					"speakerTitle": "Gloria"
				},
				{
					"id": 200370306,
					"content": "Vous l'avez donc vu ? J'espère qu'il va bien... Vous a-t-il dit quand est-ce qu'il reviendrait ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370307
					],
					"speakerTitle": "Gloria"
				},
				{
					"id": 200370307,
					"content": "Non, oubliez ce que je viens de dire. Il doit être trop occupé pour répondre à ce genre de question, je ne peux pas trop lui en demander.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370308
					],
					"speakerTitle": "Gloria"
				},
				{
					"id": 200370308,
					"content": "Auriez-vous l'amabilité de me lire sa lettre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370309
					],
					"speakerTitle": "Gloria"
				},
				{
					"id": 200370309,
					"content": "Pas trop fort, s'il vous plaît. Je ne voudrais pas que d'autres vous entendent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370310
					],
					"speakerTitle": "Gloria"
				},
				{
					"id": 200370310,
					"content": "Bien sûr.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370311
					]
				},
				{
					"id": 200370311,
					"content": "#Vous lisez souvent des lettres ? Je trouve que vous êtes {M#un orateur}{F#une oratrice} très {M#doué}{F#douée}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370312
					],
					"speakerTitle": "Gloria"
				},
				{
					"id": 200370312,
					"content": "Voilà, c'est tout ce qu'il a écrit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370313
					]
				},
				{
					"id": 200370313,
					"content": "Godwin a dit qu'il était à Liyue en ce moment... Ça doit le dépayser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370314
					],
					"speakerTitle": "Gloria"
				},
				{
					"id": 200370314,
					"content": "Merci de m'avoir donné cette lettre. Dites à <color=#00E1FFFF>Godwin</color> que je pense fort à lui si vous le revoyez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370315
					],
					"speakerTitle": "Gloria"
				}
			]
		},
