					"Godwin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200370501,
					"content": "Avez-vous remis ma lettre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370502
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370502,
					"content": "Gloria vous salue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370503
					]
				},
				{
					"id": 200370503,
					"content": "Ouf, elle n'est pas en colère après tout ce temps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370504
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370504,
					"content": "Comment savez-vous à quoi Liyue ressemble, alors que vous étiez ici pendant tout ce temps ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200370505,
					"content": "Ah, je me suis inspiré des récits du Grand Maître. Cet homme est vraiment allé dans les quatre coins du monde !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370506
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370506,
					"content": "Merci infiniment. Vous m'avez beaucoup aidé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370507
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370507,
					"content": "Je vous donne ces quelques graines de pissenlit que j'ai ramassées tout à l'heure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370508
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370508,
					"content": "Vous pourrez les donner à Gloria la prochaine fois qu'elle vous en redemande.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Godwin"
				}
			]
		}
	]
