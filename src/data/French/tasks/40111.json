			"dialogs": [
				{
					"id": 401115301,
					"content": "Je vous ai entendue parler de l'adversaire comme d'un « démon Kitsune », pourriez-vous m'en dire un peu plus à ce sujet ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115302
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401115302,
					"content": "Ne négligez aucun détail. Qui sait, peut-être qu'il y a quelque chose que je pourrai utiliser dans mon reportage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115303
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401115303,
					"content": "Oh ! Je ferais mieux d'éviter, j'ai peur de dire quelque chose de mal. De plus, je ne suis pas vraiment le démon le plus qualifié pour répondre aux questions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115304
					],
					"speakerTitle": "Kirara"
				},
				{
					"id": 401115304,
					"content": "D'accord, alors peut-être pourriez-vous m'aider à comprendre pourquoi une Kitsune s'intéresse au tofu frit ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115305
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401115305,
					"content": "Ah, maintenant vos questions me donnent faim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115306
					],
					"speakerTitle": "Kirara"
				},
				{
					"id": 401115306,
					"content": "Pourquoi est-ce que je ne vous emmènerais pas manger des ramen Kitsune ici, à Inazuma ? Je peux vous expliquer pendant que nous mangeons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kirara"
				}
			]
		}
	]
