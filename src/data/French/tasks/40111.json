			},
			"dialogs": [
				{
					"id": 401113101,
					"content": "#Au fait, est-ce que la capitaine Beidou joue à l'Invocation des Sept, par hasard{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113102
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401113102,
					"content": "Oui. Elle est même l'une des meilleures de toute la Flotte du Crux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113103
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 401113103,
					"content": "Pourriez-vous transmettre un message pour moi, Kazuha ? Je suis une fan de longue date de la capitaine Beidou. J'ai toujours espéré pouvoir me lier d'amitié avec elle un jour, mais jusqu'à présent, je n'en ai jamais eu l'occasion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113104
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401113104,
					"content": "Bien sûr. Mais je vous prie de ne pas y aller trop fort lorsque vous la battrez inévitablement à l'Invocation des Sept.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
		{
			"id": 4011132,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4011102",
							"2"
						],
						"stepId": 4011102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ningguang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401113201,
					"content": "J'ai entendu dire que même le tournoi officieux d'Invocation des Sept connaît une forte participation. De nombreux joueurs sérieux se sont inscrits aux tournois officiels et non officiels.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113202
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 401113202,
					"content": "Quant à moi... Cela ne me dérange pas d'essayer les jeux à la mode de temps en temps, même si je préfère toujours les échecs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113203
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 401113203,
					"content": "Mais en fin de compte, quelles que soient les différences entre les différents jeux, ils ont tous une chose importante en commun : ils rassemblent des amis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ningguang"
				}
			]
		},
		{
			"id": 4011133,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
