			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Timmy"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401111101,
					"content": "J'ai gagné, j'ai gagné !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111102,
						401111106
					],
					"speakerTitle": "Timmy"
				},
				{
					"id": 401111102,
					"content": "Félicitations, Timmy !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401111103
					]
				},
				{
					"id": 401111103,
					"content": "Merci. J'ai hâte de le dire à ma mère... Ça va la rendre vraiment heureuse, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111104
					],
					"speakerTitle": "Timmy"
				},
				{
					"id": 401111104,
					"content": "C'est elle qui m'a convaincu de participer au tournoi, alors je vais lui donner les prix !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111105
					],
					"speakerTitle": "Timmy"
				},
				{
					"id": 401111105,
					"content": "J'aimerais vraiment que mon père puisse me voir maintenant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmy"
				},
				{
					"id": 401111106,
					"content": "Au revoir, Timmy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401111107
					]
				},
				{
					"id": 401111107,
					"content": "Au revoir ! Ah, l'Invocation des Sept est tellement amusante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmy"
				}
			]
		},
		{
			"id": 4011112,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4011101",
							"2"
						],
						"stepId": 4011101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mika",
					"Hoffman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401111201,
					"content": "Attends, pourquoi tout le monde part ? ... Est-ce que je l'ai ratée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111202
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401111202,
					"content": "Ah Mika, dommage que tu n'étais pas là pour la voir. J'ai bien peur que, euh... Le capitaine Kaeya ait perdu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111203
					],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 401111203,
					"content": "Quoi ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111204
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401111204,
					"content": "Dis-moi tout, qu'est-ce qui s'est passé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111205
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401111205,
					"content": "Eh bien, je ne connais pas grand-chose à l'Invocation des Sept, mais j'ai essayé de suivre en écoutant ce que tout le monde disait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111206
					],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 401111206,
					"content": "Apparemment, le capitaine Kaeya a sorti l'une des cartes de personnage de Timmy dès le début, lui donnant un avantage précoce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111207
					],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 401111207,
					"content": "Mais je suppose que tout ça faisait partie de la stratégie de son adversaire ? En tout cas, Timmy a passé les premières manches à accumuler des cartes, puis a fait basculer le jeu avec une offensive brutale à la fin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111208
					],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 401111208,
					"content": "Hmm, mais peut-être que la partie était déjà terminée à partir du moment où ils ont lancé la pièce et déterminé que Kaeya jouerait en deuxième...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111209
					],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 401111209,
					"content": "*soupir* Je crois que j'ai besoin d'un verre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111210
					],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 401111210,
					"content": "Calme-toi, frangin. Ce n'est pas le moment de commencer à noyer ton chagrin dans l'alcool.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111211
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401111211,
					"content": "Connaissant le capitaine Kaeya, il ne voudrait pas te voir contrarié par sa défaite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111212
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401111212,
					"content": "Hé, pourquoi n'apprendrions-nous pas à jouer nous aussi ? Peut-être qu'alors, nous pourrons jouer contre le capitaine Kaeya un jour ! Haha... Cependant, je suis sûr que nous perdrions contre lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111213
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401111213,
					"content": "Ah, tu as raison, Mika.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hoffman"
				}
			]
		},
		{
			"id": 4011113,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
