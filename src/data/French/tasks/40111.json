			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401111301,
					"content": "Salut. Y a-t-il autre chose dont tu voulais discuter ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111302,
						401111306,
						401111310
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401111302,
					"content": "À propos de l'Invocation des Sept...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401111303
					]
				},
				{
					"id": 401111303,
					"content": "Le jeu a vraiment décollé ces derniers temps. Il fait désormais partie de la vie de tous les jours. Partout où tu vas, tu vois des gens y jouer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111304
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401111304,
					"content": "En fait, certaines personnes ont même renoncé à boire afin de garder la tête froide pendant la partie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111305
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401111305,
					"content": "Haha, je suis sûr que Diona sera heureuse d'entendre ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111306,
						401111310
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401111306,
					"content": "Comment va l'Ordre de Favonius ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401111307
					]
				},
				{
					"id": 401111307,
					"content": "Ne t'inquiète pas, tout le monde va bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111308
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401111308,
					"content": "En fait, j'ai réussi à convaincre Jean de se joindre à moi pour une partie, mais nous étions loin d'avoir fini quand le devoir l'a appelé. J'ai dû finir la partie pour nous deux. *soupir* Que veux-tu ? Le travail doit rester la priorité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111309
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401111309,
					"content": "Mais vu le succès du tournoi et le plaisir que tout le monde a pris, j'espère que ce sera au moins une chose dont elle ne devra plus préoccuper.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111302,
						401111310
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401111310,
					"content": "Rattrapons le temps perdu une autre fois.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401111311
					]
				},
				{
					"id": 401111311,
					"content": "Bien sûr. Nous devrions faire une partie d'Invocation des Sept quand on en aura l'occasion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				}
			]
		},
