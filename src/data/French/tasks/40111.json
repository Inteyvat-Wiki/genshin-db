			"dialogs": [
				{
					"id": 401111401,
					"content": "Quel tournoi incroyable. Ce Timmy, hein... Il a vraiment un don pour ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111402
					],
					"speakerTitle": "Eichendorff"
				},
				{
					"id": 401111402,
					"content": "Ouais, qui l'aurait prédit... Mais au moins, ça me réconforte un peu d'avoir perdu contre lui maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lennard"
				}
			]
		},
