				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401115101,
					"content": "Ouf, cette partie entre la dame Kitsune et la dame-poisson était super palpitante ! J'en ai des sueurs froides !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115102
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401115102,
					"content": "Oui, oui. Je suis sûre que tout Ritou a su à quel point vous étiez excité, mais la bande nous attend. Nous devrions rentrer maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115103
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401115103,
					"content": "#Euh, ils peuvent attendre encore un peu... Le temps de jouer une dernière partie contre mon {M#ami}{F#amie} ! Tu ne peux pas dire non... Steuplaît ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115104,
						401115107
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401115104,
					"content": "D'accord, faisons une partie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401115105
					]
				},
				{
					"id": 401115105,
					"content": "#Super ! Je savais que tu serais {M#partant}{F#partante} pour une partie ! Toi {M#seul}{F#seule} peux comprendre un vrai joueur de cartes comme moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115106
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401115106,
					"content": "Sérieusement, que vais-je faire de vous deux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401115107,
					"content": "La prochaine fois peut-être.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401115108
					]
				},
				{
					"id": 401115108,
					"content": "... D'accord.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115109
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401115109,
					"content": "C'est bon, je ne t'en veux pas... Mais tu devrais probablement partir. Tu ne voudrais pas voir un Oni pleurer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
