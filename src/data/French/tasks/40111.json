			},
			"dialogs": [
				{
					"id": 401115201,
					"content": "Générale Kujou, puis-je vous dire un mot ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115202
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401115202,
					"content": "Félicitations pour votre victoire, Sangonomiya Kokomi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115203
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 401115203,
					"content": "Je voulais vous remercier pour les conseils utiles que vous avez prodigués avant la finale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115204
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401115204,
					"content": "Ce n'était rien. Quiconque a une bonne tête sur les épaules sait que les compétences et la stratégie déterminent en fin de compte le gagnant. En tout cas, c'était une partie passionnante à regarder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115205
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 401115205,
					"content": "Dommage que vous ne vous soyez pas inscrite au tournoi également.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115206
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401115206,
					"content": "Je crains de ne pas être à la hauteur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115207
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 401115207,
					"content": "Ne dites pas ça. Vous n'êtes pas si différente de moi... Vous cherchez des occasions de parfaire vos compétences dans le jeu, vous imaginez des contre-attaques et rivalisez avec les autres comme s'ils étaient des amis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115208
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401115208,
					"content": "... Vous avez peut-être raison.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115209
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 401115209,
					"content": "Dans ce cas, faisons une partie d'Invocation des Sept avant que vous ne quittiez l'Île de Narukami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115210
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 401115210,
					"content": "Avec plaisir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				}
			]
		},
