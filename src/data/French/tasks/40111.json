			"dialogs": [
				{
					"id": 401113301,
					"content": "Bonjour, je m'appelle Charlotte. Je suis journaliste pour L'Oiseau de vapeur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113302
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401113302,
					"content": "Puis-je prendre un peu de votre temps pour une brève interview ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113303
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401113303,
					"content": "*soupir* Bien sûr, allez-y.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113304
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 401113304,
					"content": "Vous avez fait un début prometteur dans cette compétition et avez fait mordre la poussière à de nombreux compétiteurs sur votre chemin vers la finale, avant de rater de peu le titre lorsque vous avez perdu contre la directrice Hu Tao du Funérarium Wangsheng. Ça doit être difficile pour vous, sachant à quel point vous êtes passé près de la victoire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113305
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401113305,
					"content": "Dans cet esprit, souhaitez-vous partager vos réflexions sur le déroulement de la finale ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113306
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401113306,
					"content": "Euh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113307
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 401113307,
					"content": "Vous voulez une réponse pour les médias ou savoir ce que j'en pense réellement ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113308
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 401113308,
					"content": "J'aimerais entendre le fond de votre pensée, bien sûr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113309
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401113309,
					"content": "*soupir* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113310
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 401113310,
					"content": "Jouer aux cartes, c'est soixante-dix pour cent de compétence et trente pour cent de chance... Mais lorsque votre adversaire lance six dés du même élément à la fois, il n'y a pas de retour en arrière, même avec des compétences du niveau d'un Adepte. Un simple aventurier comme moi n'avait pas la moindre chance de gagner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qian"
				}
			]
		},
