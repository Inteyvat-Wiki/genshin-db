				"objectNames": [
					"Charlotte"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401111501,
					"content": "« La cité sur le lac regorge de talents dans le tournoi de cartes : le jeune prodige bat le capitaine de l'Ordre de Favonius »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111502
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401111502,
					"content": "Hmm, ce titre sauve la face de l'Ordre de Favonius, mais il n'est pas très incisif...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111503
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401111503,
					"content": "« L'esprit stratégique le mieux aiguisé de l'Ordre de Favonius déjoué par un jeune talent dans une défaite en cinq manches »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111504
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401111504,
					"content": "« Les espoirs de titre du capitaine balayés par la victoire retentissante d'un jeune prodige »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111505
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401111505,
					"content": "Hmm... Peut-être que je devrais m'en tenir à mon premier essai...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Charlotte"
				}
			]
		},
		{
