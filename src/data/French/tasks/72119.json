				"objectNames": [
					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721190101,
					"content": "#Oh ! Euh, {M#voyageur}{F#voyageuse}... Les choses s'annoncent mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190102
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190102,
					"content": "Les Fatui se sont rassemblés autour du noyau. On dirait qu'ils ont découvert quelque chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190103
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190103,
					"content": "Ils n'ont quand même pas l'intention de percer les défenses du noyau... Non, nous n'avons plus de temps à perdre. Il faut commencer les tests fonctionnels.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190104
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190104,
					"content": "Les tests fonctionnels ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190105
					]
				},
				{
					"id": 721190105,
					"content": "Ce que je veux dire, c'est qu'on doit tester la capacité de purification de notre nouvelle machine. Je n'ai pas l'intention de la déplacer dans le fourneau pour me rendre compte qu'elle ne fonctionne pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190106
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190106,
					"content": "À cet effet, pourriez-vous m'aider à trouver 3 scarabutos, s'il vous plaît ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190107
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190107,
					"content": "Je voudrais les placer près du Fourneau Mikage pour les imprégner de l'énergie du Tatarigami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190108
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190108,
					"content": "Ensuite, on pourra les récupérer et utiliser cet appareil de purification pour les purifier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190109
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190109,
					"content": "Voilà le test que j'ai prévu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190110
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190110,
					"content": "Où puis-je trouver ces scarabutos ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190111
					]
				},
				{
					"id": 721190111,
					"content": "Hmm... Normalement, on les trouve dans des environnements riches en élément Électro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190112
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190112,
					"content": "J'ai aussi entendu dire qu'ils pouvaient survivre près du Fourneau Mikage. Quelles petites bestioles incroyables...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190113
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190113,
					"content": "Pourquoi ne pas simplement attraper ceux du Fourneau Mikage alors ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190114
					]
				},
				{
					"id": 721190114,
					"content": "Eh bien, vous pourriez le faire, mais si vous deviez prélever des scarabutos directement dans le Fourneau Mikage...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190115
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190115,
					"content": "Pour tout vous dire, je m'inquiète de la fiabilité de ma petite machine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190116
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190116,
					"content": "Il vaut mieux faire les tests étape par étape.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190117
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190117,
					"content": "*tousse* Bref, pourriez-vous attraper 3 scarabutos, s'il vous plaît ? Je vous attends ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190118,
						721190120
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190118,
					"content": "Je m'en charge.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190119
					]
				},
				{
					"id": 721190119,
					"content": "Je vous laisse faire. Juste 3, c'est bien !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190120,
					"content": "Je pourrais faire moi-même un tour à l'intérieur du fourneau...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190121
					]
				},
				{
					"id": 721190121,
					"content": "Eh bien... Vous pourriez vous utiliser comme sujet de test, hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190122
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190122,
					"content": "Mais comme je l'ai déjà dit, la fiabilité de cet appareil peut laisser à désirer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190123
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190123,
					"content": "Si quelque chose d'inattendu se produisait pendant le processus de purification, vous pourriez... euh, rencontrer des problèmes imprévus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190124
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190124,
					"content": "Hum. Contentons-nous d'utiliser le scarabuto pour le moment, d'accord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190125
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190125,
					"content": "3 suffisent ! Une fois que vous les aurez attrapés, ramenez-les simplement ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
