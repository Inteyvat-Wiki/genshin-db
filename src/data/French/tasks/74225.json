			"dialogs": [
				{
					"id": 742250201,
					"content": "#Merci, {M#mon bienfaiteur}{F#ma bienfaitrice}. Par le roi divin, je suis enfin sauvé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250202
					],
					"speakerTitle": "Foscari"
				},
				{
					"id": 742250202,
					"content": "#Êtes-vous l'un des soldats qui assurent la sécurité de cette ville, ou {M#un justicier}{F#une justicière} de passage ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250203
					],
					"speakerTitle": "Foscari"
				},
				{
					"id": 742250203,
					"content": "Laissez-moi me présenter, je m'appelle Faustus, je suis un mercatores exquisiti nommé par le roi divin lui-même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250204
					],
					"speakerTitle": "Foscari"
				},
				{
					"id": 742250204,
					"content": "Je suis ici pour livrer des épices du sud. Je ne m'attendais pas à être encerclé par ces Élémentosaures à peine après avoir mis le pied à terre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250205
					],
					"speakerTitle": "Foscari"
				},
				{
					"id": 742250205,
					"content": "Des Élémentosaures ? Où ça ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742250206
					]
				},
				{
					"id": 742250206,
					"content": "#Waouh, vous devez vraiment être {M#fort}{F#forte} si vous n'avez même pas remarqué les ennemis que vous venez de vaincre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250207
					],
					"speakerTitle": "Foscari"
				},
				{
					"id": 742250207,
					"content": "Prenez ceci en guise de remerciement. Je dois me dépêcher d'emmener ces marchandises en ville. Nous nous verrons peut-être là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Foscari"
				}
			]
		}
	]
