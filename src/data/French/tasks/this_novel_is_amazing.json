			"dialogs": [
				{
					"id": 223020301,
					"content": "Où est-ce qu'il est parti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020302
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020302,
					"content": "Je viens avec le roman de Chang le Neuvième...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223020303
					]
				},
				{
					"id": 223020303,
					"content": "Ah ? Il écrit encore ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020304
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020304,
					"content": "Ah oui, c'est vrai... Il m'avait mentionné qu'il voulait participer au concours organisé par Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020305
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020305,
					"content": "Que raconte son dernier livre ? Son dernier ouvrage était au sujet des Sept étoiles de Liyue. Il a vraiment insisté pour qu'on l'aide à le faire publier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020306
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020306,
					"content": "Au bout du compte, nous n'avons pas réussi, et nous avons même failli avoir des problèmes avec les Millelithes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020307
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020307,
					"content": "Enfin, au moins cette fois tout ça partira à Inazuma. Nous devrions être hors de cause.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020308
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020308,
					"content": "Donnez-moi le manuscrit, je vais demander à mes collègues de le faire livrer par bateau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020309
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020309,
					"content": "Mais pour être honnête, je doute que Chang ait une chance. Il paraît que le roman « Une légende d'épée » est très populaire en ce moment à Inazuma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020310
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020310,
					"content": "Cet ouvrage a aussi été écrit par un Liyuéen, mais j'ignore qui en est l'auteur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020311
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020311,
					"content": "Merci de nous avoir amené ce livre ; Chang avait demandé qu'on aille le chercher, et payé en avance même. Tenez, veuillez accepter ceci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xu"
				}
			]
		},
