					"Chang le Neuvième"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223020101,
					"content": "Cette année, c'est la bonne...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020102
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 223020102,
					"content": "De quoi vous parlez ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223020103
					]
				},
				{
					"id": 223020103,
					"content": "Vous l'ignorez peut-être, mais Inazuma organise régulièrement un concours d'écriture.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020104
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 223020104,
					"content": "Si mes souvenirs sont bons, le concours s'intitule « Ce roman est génial ! ». Mais plus important, la compétition est organisée par la Chambre Yae, la célèbre maison d'édition.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020105
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 223020105,
					"content": "Ça fait tellement longtemps que je me prépare pour ce concours ! J'ai étudié de nombreux romans populaires auprès des Inazumiens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020106
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 223020106,
					"content": "Sans compter tous ceux qu'il y a chez moi... J'ai mis le meilleur de Liyue et d'Inazuma dans mon roman. Il faut que je remporte la première place !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020107
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 223020107,
					"content": "C'est la Guilde des marchands de Feiyun qui est censée apporter mon ouvrage au concours, mais leur envoyé n'est jamais venu le chercher...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020108
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 223020108,
					"content": "Pourriez-vous apporter mon manuscrit à un certain Xu de la <color=#00E1FFFF>Guilde des marchands de Feiyun</color> ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020109,
						223020111
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 223020109,
					"content": "Bien sûr !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223020110
					]
				},
				{
					"id": 223020110,
					"content": "Merci beaucoup ! J'y arriverai cette fois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 223020111,
					"content": "Il est sur quel sujet votre roman ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223020112
					]
				},
				{
					"id": 223020112,
					"content": "Je ne peux pas vous le dévoiler. Vous le saurez après le concours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020113
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 223020113,
					"content": "Si je gagne, tout ira mieux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang le Neuvième"
				}
			]
		},
