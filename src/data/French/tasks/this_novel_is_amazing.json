			},
			"dialogs": [
				{
					"id": 223020201,
					"content": "Je crois qu'on est bien devant la <color=#00E1FFFF>Guilde des marchands de Feiyun</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 223020202,
					"content": "Confions le livre à <color=#00E1FFFF>cette personne devant la porte</color> et ça sera bon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 223020203,
					"content": "Mais je suis curieuse... De quoi parle ce roman ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 223020204,
					"content": "On pourrait y jeter un coup d'œil rapide, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
