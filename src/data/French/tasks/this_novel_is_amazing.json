				{
					"id": 223020401,
					"content": "Je dois réussir à tout prix cette fois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020402
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 223020402,
					"content": "Je serai enfin publié dans le monde entier et elle le lira...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020403
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 223020403,
					"content": "V—Vous êtes encore là ? Ouste ! Mettez-vous en route vers la <color=#00E1FFFF>Guilde des marchands de Feiyun</color> !",
					"roleType": "TALK_ROLE_NPC",
