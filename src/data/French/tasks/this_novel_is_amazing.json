					"content": "Juste un petit coup d'œil alors...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223020502
					]
				},
				{
					"id": 223020502,
					"content": "Carrément !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 223020503,
					"content": "Ce jeune homme dont il est question dans l'histoire... Tu penses que c'est Chang le Neuvième ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 223020504,
					"content": "Il est encore jeune dans sa tête...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 223020505,
					"content": "Bref, dépêchons-nous de remettre ce livre à la <color=#00E1FFFF>Guilde des marchands de Feiyun</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
