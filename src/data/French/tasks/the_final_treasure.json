			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Viandomaru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790271001,
					"content": "Kosekimaru, Kosekimaru !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790271002,
					"content": "On a trouvé le trésor ! Regarde, c'est une maquette de bateau pirate ! Ton intuition a finalement fonctionné cette fois !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790271003,
					"content": "Ah oui, au fait, quelle est l'autre chose que tu voulais nous dire ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790271004,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271005
					],
					"speakerTitle": "Viandomaru"
				},
				{
					"id": 790271005,
					"content": "Kosekimaru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790271006,
					"content": "(Le bateau nommé Kosekimaru ne répond pas...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271007,
						790271008
					],
					"speakerTitle": "Viandomaru"
				},
				{
					"id": 790271007,
					"content": "Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790271009
					]
				},
				{
					"id": 790271009,
					"content": "... Hmph, alors qu'il nous avait dit qu'il nous dirait tout quand on reviendrait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790271010,
					"content": "Kosekimaru... C'est vraiment un menteur !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790271008,
					"content": "Kosekimaru ne peut plus parler...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790271009
					]
				}
			]
		}
	]
