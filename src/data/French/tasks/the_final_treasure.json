				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Viandomaru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790270601,
					"content": "C'était vraiment dangereux ! J'ai l'impression qu'on a failli couler !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270602,
					"content": "Kosekimaru, tu es incroyable !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270603,
					"content": "#Haha, je ne suis qu'un bateau qui parle. Ce sont les superbes compétences en navigation de {NICKNAME} qui nous ont permis de traverser l'orage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270604,
						790270605
					],
					"speakerTitle": "Viandomaru"
				},
				{
					"id": 790270604,
					"content": "On recommence ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270606
					]
				},
				{
					"id": 790270606,
					"content": "Haha, il ne vaut mieux pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270607
					],
					"speakerTitle": "Viandomaru"
				},
				{
					"id": 790270607,
					"content": "Hélas, j'ai peur d'avoir déclenché l'orage de tout à l'heure. Il semble que la mer soit moins calme à présent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270608
					],
					"speakerTitle": "Viandomaru"
				},
				{
					"id": 790270608,
					"content": "#Mais ça tombe bien... {NICKNAME} et Paimon, le trésor est juste là-haut !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270609
					],
					"speakerTitle": "Viandomaru"
				},
				{
					"id": 790270609,
					"content": "#N'est-ce pas l'endroit où on est {M#venus}{F#venues} chercher le trésor la première fois{NON_BREAK_SPACE}? Kosekimaru, il n'y a rien d'autre là-bas que la moitié de ton corps brisé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270610,
					"content": "Cette fois, je suis certain qu'il y a un trésor là-bas, mais... comment on dit, déjà ? C'est « mon intuition de grand bateau pirate » !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270611
					],
					"speakerTitle": "Viandomaru"
				},
				{
					"id": 790270611,
					"content": "Vraiment... Au fait, tu nous avais dit que tu avais deux choses à nous annoncer. L'une est que tu t'es finalement souvenu de ton nom, mais l'autre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270612,
					"content": "Hahaha, je pensais que tu avais déjà oublié. Je vous le dirai quand vous reviendrez !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viandomaru"
				},
				{
					"id": 790270605,
					"content": "Merci pour ce compliment.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270607
					]
				}
			]
		},
		{
			"id": 7902710,
