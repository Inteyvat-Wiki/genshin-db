			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Viandomaru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790270101,
					"content": "#Ah, vous voilà. Je pensais que vous étiez trop {M#occupés}{F#occupées} à voler partout avec vos ailes bidules, là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270102
					],
					"speakerTitle": "Viandomaru"
				},
				{
					"id": 790270102,
					"content": "Et vous avez oublié votre vieil ami Viandomaru qui trempe dans l'eau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270103
					],
					"speakerTitle": "Viandomaru"
				},
				{
					"id": 790270103,
					"content": "On est là maintenant, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270104,
					"content": "Au fait, tu as dit que tu avais besoin d'aide. Qu'est-ce qu'il y a ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270105,
					"content": "Ce n'est pas si important... Vous vous rappelez, la dernière fois quand vous m'avez aidé à trouver les fragments de mon corps ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270106
					],
					"speakerTitle": "Viandomaru"
				},
				{
					"id": 790270106,
					"content": "Je ne sais pas comment l'expliquer, mais c'est peut-être parce que j'ai réalisé des souhaits... ou que cette mer diminue lentement ma capacité à parler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270107
					],
					"speakerTitle": "Viandomaru"
				},
				{
					"id": 790270107,
					"content": "Récemment, je me retrouve à dormir la plupart du temps plutôt que de rester éveillé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270108,
						790270109
					],
					"speakerTitle": "Viandomaru"
				},
				{
					"id": 790270108,
					"content": "Peut-être qu'il y a un rapport avec l'appareil ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270110
					]
				},
				{
					"id": 790270110,
					"content": "#Je vois. Grâce à une sorte d'appareil, je suis devenu le bateau de {NICKNAME} et j'ai pu communiquer avec toi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270111
					],
					"speakerTitle": "Viandomaru"
				},
				{
					"id": 790270111,
					"content": "Ah... Ça veut dire qu'une fois que l'appareil sera arrêté, tu ne pourras plus parler !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270112,
					"content": "#{NICKNAME}, on doit faire quelque chose avant qu'il ne soit trop tard...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270113,
					"content": "Haha, ça va, Paimon... Je suis déjà très satisfait de pouvoir vous parler comme ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270114
					],
					"speakerTitle": "Viandomaru"
				},
				{
					"id": 790270114,
					"content": "Maintenant que j'y pense, le fait que moi, un bateau, je sois capable de communiquer avec vous comme ça, c'est merveilleux comme dans un rêve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270115
					],
					"speakerTitle": "Viandomaru"
				},
				{
					"id": 790270115,
					"content": "Mais maintenant, je dois vous demander une autre faveur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270116
					],
					"speakerTitle": "Viandomaru"
				},
				{
					"id": 790270116,
					"content": "Alors dis-nous...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270117
					]
				},
				{
					"id": 790270117,
					"content": "Je vous ai dit qu'une fois que j'aurai retrouvé mon corps, je vous emmènerai faire un tour ici. Mais mon corps est dans cet état depuis longtemps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270125
					],
					"speakerTitle": "Viandomaru"
				},
				{
					"id": 790270125,
					"content": "La plupart des trésors ont déjà été emportés, il ne reste rien de bien ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270118
					],
					"speakerTitle": "Viandomaru"
				},
				{
					"id": 790270118,
					"content": "Cependant, cette fois, je jure sur mon honneur de grand bateau pirate qu'il y aura de grands trésors ! Faites-moi confiance encore une fois et venez avec moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270119
					],
					"speakerTitle": "Viandomaru"
				},
				{
					"id": 790270119,
					"content": "#{NICKNAME}, Viandomaru pourrait à tout moment ne plus jamais pouvoir parler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270120,
					"content": "#Et... il y a des trésors ! Allons-y ensemble, {NICKNAME} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270121,
						790270122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270121,
					"content": "Tu ne changeras jamais.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270123
					]
				},
				{
					"id": 790270123,
					"content": "Alors, allons-y maintenant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270124,
					"content": "Parfait, montez à bord !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viandomaru"
				},
				{
					"id": 790270122,
					"content": "Puisque tu le dis...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270123
					]
				},
				{
					"id": 790270109,
					"content": "Viandomaru serait affecté par l'appareil...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270110
					]
				}
			]
		},
		{
			"id": 7902706,
			"completionStepIds": [
				7902706
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7902706",
							"2"
						],
						"stepId": 7902706,
						"stateName": "QUEST_STATE_UNFINISHED"
