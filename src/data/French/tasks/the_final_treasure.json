	"talks": [
		{
			"id": 7902701,
			"completionStepIds": [
				7902701
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
