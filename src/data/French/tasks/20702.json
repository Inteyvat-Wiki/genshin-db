					"nextDialogs": [
						207020102
					],
					"speakerTitle": "Swann"
				},
				{
					"id": 207020102,
					"content": "J'ai quelques questions, comme la dernière fois. Elles portent sur certains paragraphes du Code, et sur quelques connaissances générales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207020103
					],
					"speakerTitle": "Swann"
				},
				{
					"id": 207020103,
					"content": "Je vous donnerai une récompense en fonction de vos réponses.",
