			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Araminali"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731000301,
					"content": "#Araminali a entendu dire que {NICKNAME} avait fait une belle démonstration de ses talents dans la vana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000302
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000302,
					"content": "#Les trésors ont déjà été placés dans les coffres. Nara {NICKNAME}, ouvre-les, « fais comme chez toi » !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araminali"
				}
			]
		},
		{
			"id": 7310004,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310014",
							"3"
						],
						"stepId": 7310014,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_GREATER",
						"rawParams": [
							"73100",
							"32"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Araminali"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731000401,
					"content": "#{NICKNAME} et Paimon, vous êtes vraiment {M#lents}{F#lentes} ! Araminali a déjà préparé les coffres et vous attend depuis un bon moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000402
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000402,
					"content": "#{M#Ami des aranaras}{F#Amie des aranaras}, les coffres sont remplis. Va les ouvrir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araminali"
				}
			]
		},
		{
			"id": 7310005,
			"completionStepIds": [
				7310015
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310015",
							"2"
						],
						"stepId": 7310015,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Araminali",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731000501,
					"content": "#De nombreux aranaras ont dit à Araminali que nara {NICKNAME} et Paimon avaient fait beaucoup de choses bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000502
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000502,
					"content": "Cela fait un bon moment que je suis au courant de cela. Le vent a porté toutes ces belles paroles jusqu'au nid douillet d'Araminali à travers les branches et les cours d'eau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000503
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000503,
					"content": "#Par conséquent, Araminali a rempli les coffres à ras bord. Ils n'attendent plus que toi, nara {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000504
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000504,
					"content": "#Aranimba a envoyé quelques cristaux brillants... Araminali les a aussi mis dans les coffres. Tu les apprécieras peut-être, nara {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000505
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000505,
					"content": "Aranimba n'est pas revenu ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731000506
					]
				},
				{
					"id": 731000506,
					"content": "Non, Aranimba n'est pas comme un arbre aux racines enfoncées dans la terre, c'est un aranara qui n'arrête jamais de bouger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000507
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000507,
					"content": "Oh... Mais alors, tu ne te sens pas un peu seul ici, Araminali ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731000508,
					"content": "Me sentir seul ? Qu'est-ce que ça veut dire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000509
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000509,
					"content": "Euh... Ça veut dire que quand tu es seul, tu as très envie que quelqu'un te tienne compagnie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731000510,
					"content": "Il y a beaucoup d'aranaras à Vanarana, alors Araminali ne se sent jamais seul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000511
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000511,
					"content": "Mais Arayama et Aranimba ne sont plus à Vanarana. Autrefois, on était toujours ensemble et on était très heureux comme ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000512
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000512,
					"content": "L'ararakalari d'Arayama est très puissant et les naras faibles ne peuvent le neutraliser. Aranimba, lui, est très doué en dessin, toutes ses œuvres sont magnifiques.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000513
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000513,
					"content": "Mais désormais, il ne reste plus qu'Araminali et ses coffres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000514
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000514,
					"content": "Araminali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731000515,
					"content": "Ce n'est rien, Araminali a beaucoup de coffres. J'ignore pourquoi les naras aiment tant ouvrir des coffres, mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000516
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000516,
					"content": "Comme Araminali est le propriétaire des coffres et que les naras aiment les coffres, ils doivent aussi aimer Araminali, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000517
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000517,
					"content": "Mais Araminali n'a plus de trésors... Alors, les coffres vont avoir le ventre tout vide pendant un moment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000518
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000518,
					"content": "#J'espère qu'à l'avenir, même si les coffres d'Araminali sont vides, nara {NICKNAME}, restera {M#l'ami des aranaras}{F#l'amie des aranaras}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araminali"
				}
			]
		},
		{
			"id": 7310006,
