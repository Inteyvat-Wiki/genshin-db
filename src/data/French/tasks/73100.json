				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Araminali"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731000201,
					"content": "#Araminali sait que {M#Le nara doré}{F#La nara dorée} a aidé des aranaras. C'est pourquoi Araminali lui donne ses coffres !",
					"roleType": "TALK_ROLE_NPC",
