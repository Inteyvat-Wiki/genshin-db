			"dialogs": [
				{
					"id": 731000601,
					"content": "#Araminali n'a pas encore fini les préparatifs et les coffres ont encore faim. Nara {NICKNAME} et Paimon peuvent flâner un moment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000602
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000602,
					"content": "Euh, ou plutôt « vous balader partout ». Vous rencontrerez peut-être des aranaras dans le besoin comme ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araminali"
				}
			]
		},
		{
			"id": 7310007,
