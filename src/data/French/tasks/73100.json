				"objectNames": [
					"Araminali"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731000101,
					"content": "#{NICKNAME} veut ouvrir les coffres ? Mais... il y a encore beaucoup d'aranaras qui ont besoin d'aide dans la vana. Si {M#le nara doré}{F#la nara dorée} pouvait leur donner un coup de main...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000102
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000102,
					"content": "Araminali va remplir les coffres de trésors ! Et avec tous ceux qu'Aranimba a envoyés, les offres vont être pleins à craquer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araminali"
				}
			]
		},
		{
			"id": 7310002,
			"completionStepIds": [
				7310014
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
