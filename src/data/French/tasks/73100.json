			},
			"dialogs": [
				{
					"id": 731000701,
					"content": "#Araminali a le ventre plein, mais ce n'est pas le cas des coffres. Avoir le ventre vide n'est pas une bonne chose. {NICKNAME} et Paimon doivent être affamés après toute cette marche. Mangez des champignons, cela vous redonnera de la force.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araminali"
				}
			]
		}
