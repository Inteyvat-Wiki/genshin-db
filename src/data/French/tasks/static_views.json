			"dialogs": [
				{
					"id": 730980401,
					"content": "Hmm... Voyons voir... On dirait qu'une nouvelle carte est apparue !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980402,
					"content": "On n'aide plus les aranaras en difficulté ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980403
					]
				},
				{
					"id": 730980403,
					"content": "#*tousse* Euh, nous n'avons toujours pas réussi à trouver le propriétaire de la maison. C'est inquiétant ! {NICKNAME}, allons vérifier les autres endroits indiqués sur la peinture !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980404,
					"content": "#Quand on sera {M#arrivés}{F#arrivées}, on pourra se diriger vers les emplacements décrits ci-dessus pour...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980405,
						730980407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980405,
					"content": "Trouver plus de trésors ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980406
					]
				},
				{
					"id": 730980406,
					"content": "Oui ! Ah, non ! Pour trouver des aranaras qui ont besoin d'aide, pardi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980409,
					"content": "Hmm... J'ai l'impression que cette boîte aux lettres est magique. Peut-être qu'on recevra de nouvelles peintures plus tard. Gardons un œil dessus !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980407,
					"content": "Trouver des aranaras en difficulté ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980408
					]
				},
				{
					"id": 730980408,
					"content": "Oui ! Et peut-être qu'on pourra trouver un trésor dans la foulée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980409
					],
					"speakerTitle": "Paimon"
				}
			]
