			},
			"dialogs": [
				{
					"id": 730980301,
					"content": "Laisse-moi voir... Oh ? Est-ce que c'est une peinture d'aranara ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980302,
					"content": "Ce n'est pas très poli de fouiller sans permission...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980303
					]
				},
				{
					"id": 730980303,
					"content": "Vraiment ? Pourtant, ce n'est pas la première fois qu'on le fait ! Qui sait combien de camps d'aventuriers et de coffres aux trésors on a déjà fouillés ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980304,
					"content": "#Hmm... Disons que comme on n'a pas vu d'aranaras près de la maison, on était très {M#inquiets}{F#inquiètes} et on a décidé de chercher des indices. Si ça se trouve, on va aider un aranara en difficulté !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980305,
						730980306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980305,
					"content": "Tu as raison.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980307
					]
				},
				{
					"id": 730980307,
					"content": "Hmph, évidemment ! Bref, je crois que cette peinture représente des paysages près d'ici... Non ? Trop bien, c'est peut-être une carte au trésor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980308,
					"content": "#{NICKNAME}, allons à l'endroit indiqué sur la peinture pour vérifier ! Peut-être que les aranaras y ont vraiment caché un trésor !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980306,
					"content": "Oh, c'est vrai !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980307
					]
				}
			]
		},
		{
			"id": 7309804,
			"completionStepIds": [
				7309803
