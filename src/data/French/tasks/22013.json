					"Yuzu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220130301,
					"content": "Bonjour, est-ce que je peux vous aider ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130302
					],
					"speakerTitle": "Yuzu"
				},
				{
					"id": 220130302,
					"content": "Vous avez déjà lu « Onibudo » ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130303
					]
				},
				{
					"id": 220130303,
					"content": "Oh ? Oui, je trouvais ça même très bien, mais... Comment dire ? L'histoire est devenue un peu bizarre ces derniers temps ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130304
					],
					"speakerTitle": "Yuzu"
				},
				{
					"id": 220130304,
					"content": "À chaque fois que le héros affronte un ennemi, il va soudainement se retrouver doté d'un nouveau pouvoir et le vaincre avec en un instant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130305
					],
					"speakerTitle": "Yuzu"
				},
				{
					"id": 220130305,
					"content": "Le héros d'« Onibudo » battait toujours ses ennemis de manière ingénieuse, et c'est ce que j'aimais dans ce roman. Maintenant, j'ai l'impression qu'il n'a plus besoin de bouger le petit doigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130306
					],
					"speakerTitle": "Yuzu"
				},
				{
					"id": 220130306,
					"content": "Puis, il n'utilise ses nouveaux pouvoirs qu'une seule fois. Je ne trouve pas cela très logique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130307
					],
					"speakerTitle": "Yuzu"
				},
				{
					"id": 220130307,
					"content": "Je ne comprends pas bien ce qui s'est passé dans la tête de l'auteur pendant l'écriture...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130308
					],
					"speakerTitle": "Yuzu"
				},
				{
					"id": 220130308,
					"content": "Ahem ! Hum, allons demander ce qu'en pensent d'autres personnes. Ce n'est qu'un seul avis après tout...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		},
		{
