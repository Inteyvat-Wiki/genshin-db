				{
					"id": 220130601,
					"content": "Alors ? Vous avez demandé l'opinion des...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130602
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130602,
					"content": "Eh bien, pourquoi as-tu l'air si abattu, Junkichi ? Qu'est-ce que les lecteurs ont pu dire pour te mettre dans un état pareil ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130603
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130603,
					"content": "*soupir* Tu comprends maintenant, Junkichi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130604
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130604,
					"content": "Je ne pensais pas que ça se passerait comme ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130605
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130605,
					"content": "Mes idées et ma plume n'attireraient donc plus personne ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130606
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130606,
					"content": "Je t'avais prévenu que c'était risqué d'ajouter des éléments n'importe comment pour faire avancer ton histoire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130607
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130607,
					"content": "Admettons que tu suscites de l'engouement avec ces nouveaux pouvoirs. Il ne sera que temporaire et les lecteurs s'ennuieront ensuite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130608
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130608,
					"content": "C'est une leçon que j'ai tirée de mes années d'expérience dans le métier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130609
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130609,
					"content": "Je comprends maintenant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130610
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130610,
					"content": "Heureusement qu'on peut encore remettre les choses dans l'ordre... On ne peut pas changer l'avis négatif des lecteurs sur les derniers chapitres, mais on réussira à sauver l'écriture des prochains au moins...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130611
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130611,
					"content": "#Merci, {M#voyageur}{F#voyageuse}. Junkichi avait besoin d'ouvrir les yeux avant de s'enfoncer plus loin. Cela lui aurait causé d'énormes problèmes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130612
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130612,
					"content": "Voici une récompense, prenez-la.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shigeru"
				}
			]
		}
	]
}