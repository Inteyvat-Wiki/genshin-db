			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shigeru",
					"Junkichi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220130101,
					"content": "Tu as lu les derniers commentaires des lecteurs ? C'est catastrophique !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130102
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130102,
					"content": "Pas de panique, c'est seulement le calme avant l'apothéose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130103
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130103,
					"content": "Quand l'intrigue clé sera dévoilée, les critiques seront bien meilleures !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130104
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130104,
					"content": "Ton roman sera annulé avant qu'on en arrive là !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130105
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130105,
					"content": "Qu'est-ce qui vous arrive ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130106
					]
				},
				{
					"id": 220130106,
					"content": "#{M#Voyageur}{F#Voyageuse}, vous voilà !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130107
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130107,
					"content": "Après notre dernière discussion, Junkichi a donné plusieurs pouvoirs au héros d'« Onibudo ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130108
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130108,
					"content": "Notre maison d'édition, la Chambre Yae, a reçu pléthore de commentaires négatifs. Les lecteurs n'ont pas compris d'où venaient ces pouvoirs et pensent que l'auteur a simplement écrit toutes les choses qui lui passaient par la tête sans réfléchir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130109
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130109,
					"content": "Ils ne savent pas de quoi ils parlent, mais ils comprendront avec la suite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130110
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130110,
					"content": "Ton roman sera annulé avant que les lecteurs aient l'occasion de comprendre quoi que ce soit !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130111
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130111,
					"content": "J'en ai vraiment assez... Tiens, je crois qu'il y a des lecteurs d'« Onibudo » dans les environs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130112
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130112,
					"content": "Si tu es persuadé qu'ils aimeront ce que tu leur réserves, tu n'as qu'à aller leur demander directement si c'est le cas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130113
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130113,
					"content": "#Bien sûr que je vais y aller ! Je suis certain qu'ils me comprendront. Pourriez-vous m'accompagner, {M#voyageur}{F#voyageuse} ? Vous ferez office de témoin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130114
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130114,
					"content": "Je suis d'accord avec cette idée. Avec sa présence, tu admettras ta défaite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130115
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130115,
					"content": "J'y vais alors.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130116
					]
				},
				{
					"id": 220130116,
					"content": "Très bien, allons-y maintenant. Mes lecteurs me connaissent, c'est sûr !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130117
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130117,
					"content": "Combien de pouvoirs avez-vous donné au héros...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130118
					]
				},
				{
					"id": 220130118,
					"content": "Juste un tout petit peu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130119
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130119,
					"content": "Tu plaisantes ? À ce rythme, le héros possédera bientôt plus de pouvoirs que tous les autres personnages réunis !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130120
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130120,
					"content": "Ahem ! On va y aller. Les lecteurs seront de mon avis, j'en suis persuadé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		},
