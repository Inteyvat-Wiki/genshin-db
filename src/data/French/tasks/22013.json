				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220130401,
					"content": "Bonjour. Je peux faire quelque chose pour vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130402
					],
					"speakerTitle": "Hasegawa"
				},
				{
					"id": 220130402,
					"content": "Vous avez déjà lu « Onibudo » ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130403
					]
				},
				{
					"id": 220130403,
					"content": "Oui, c'est un roman très intéressant. Les personnages, aussi bien que l'intrigue sont excellents.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130404
					],
					"speakerTitle": "Hasegawa"
				},
				{
					"id": 220130404,
					"content": "Mais récemment, j'ai l'impression que l'auteur est devenu bien fainéant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130405
					],
					"speakerTitle": "Hasegawa"
				},
				{
					"id": 220130405,
					"content": "Hum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130406
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130406,
					"content": "Cela fait plusieurs fois qu'il donne des pouvoirs au personnage principal sans aucun élément qui en laisserait présager l'apparition.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130407
					],
					"speakerTitle": "Hasegawa"
				},
				{
					"id": 220130407,
					"content": "On appelle ça un « éveil », mais ça me paraît un peu facile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130408
					],
					"speakerTitle": "Hasegawa"
				},
				{
					"id": 220130408,
					"content": "Ce genre de combine scénaristique risque de rendre les personnages ennuyeux. J'espère que l'auteur réfléchira bien à ce qu'il fera par la suite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130409
					],
					"speakerTitle": "Hasegawa"
				},
				{
					"id": 220130409,
					"content": "#{M#Voyageur}{F#Voyageuse}... Allons interroger une autre personne...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		},
