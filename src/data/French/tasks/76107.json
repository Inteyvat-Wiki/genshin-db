			},
			"dialogs": [
				{
					"id": 761071101,
					"content": "Je suis Sandrone !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071102
					]
				},
				{
					"id": 761071102,
					"content": "Hein ? C'est ce que t'as trouvé de mieux ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761071103,
					"content": "Hmph. J'admire votre audace, mais vous nous prenez pour des imbéciles si vous croyez que ça va marcher !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
		{
			"id": 7610712,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Risto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071201,
					"content": "#Je suis... {M#un chercheur}{F#une chercheuse} qui travaille spécifiquement sous les ordres de Sandrone.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071202
					]
				},
				{
					"id": 761071202,
					"content": "#{M#Un chercheur}{F#Une chercheuse} spécifiquement sous les ordres de Sandrone ? Sandrone est déjà la meilleure en matière de recherche mécanique et sur le kuuvahki. Pourquoi aurait-elle besoin d'engager des chercheurs extérieurs ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
		{
			"id": 7610713,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Risto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071301,
					"content": "Les progrès scientifiques reposent sur la collaboration, je vous signale.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071302
					]
				},
				{
					"id": 761071302,
					"content": "Hmm... Vous avez raison. J'ai contribué en lui ramenant de nombreux rapports de l'Institut de recherche de Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071303
					],
					"speakerTitle": "Risto"
				},
				{
					"id": 761071303,
					"content": "#Comme vous êtes {M#un expert}{F#une experte} dans le domaine, j'imagine que ce serait du gâteau pour vous de réparer le dysfonctionnement de ce patrouilleur terrestre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
		{
			"id": 7610714,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Risto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071401,
					"content": "... Je crains que mes recherches se focalisent davantage sur la théorie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071402
					]
				},
				{
					"id": 761071402,
					"content": "Ah, je vois ! La théorie du kuuvahki est un domaine d'études très complexe. Vous êtes incroyable ! En comparaison, réparer un patrouilleur terrestre demande de la pratique. C'est deux disciplines différentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071403
					],
					"speakerTitle": "Risto"
				},
				{
					"id": 761071403,
					"content": "Cela dit, dame Sandrone n'est pas là maintenant. Vous devriez vous adresser à la commandante Azalea. Elle devrait savoir comment vous orienter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
		{
			"id": 7610715,
			"completionStepIds": [
				7610701
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Risto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071501,
					"content": "Bien sûr, comptez sur moi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071502
					]
				},
				{
					"id": 761071502,
					"content": "Vous donnez quelques coups au patrouilleur terrestre... Clang-clang-clang... et le voilà complètement immobile.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761071503
					]
				},
				{
					"id": 761071503,
					"content": "Tu l'as cassé... Qu'est-ce qu'on fait maintenant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761071504,
					"content": "#Hmph, je savais que quelque chose ne tournait pas rond chez vous depuis le début ! {M#Un véritable chercheur}{F#Une véritable chercheuse} ne dirait jamais de telles choses. Vous êtes un imposteur !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
		{
			"id": 7610716,
			"completionStepIds": [
				7610701
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
