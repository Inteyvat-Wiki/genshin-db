				"points": []
			},
			"dialogs": [
				{
					"id": 761071601,
					"content": "On peut dire que je suis sa mentor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071602
					]
				},
				{
					"id": 761071602,
					"content": "Oh ! D'ailleurs, je lui ai ramené de nombreux rapports de l'Institut de recherche de Fontaine. Elle a parlé des résultats des recherches du docteur Mosso de manière positive. Attendez... Vous seriez...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071603
					],
					"speakerTitle": "Risto"
				},
				{
					"id": 761071603,
					"content": "*tousse* Hmm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071604
					]
				},
				{
					"id": 761071604,
					"content": "On ne s'attendait pas à ce qu'on vous connaisse ici aussi, docteur Mosso !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761071605,
					"content": "Hmph, ça fait trente ans que vous devriez être mort et enterré. Enfin, il n'est pas encore trop tard pour ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
		{
			"id": 7610717,
