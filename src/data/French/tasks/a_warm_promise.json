			},
			"dialogs": [
				{
					"id": 765070101,
					"content": "#Ouah ! Regarde, {NICKNAME} ! On a cet album depuis pas si longtemps que ça, mais il se remplit tellement vite ! Toutes les photos sont super jolies !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070102,
						765070103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070102,
					"content": "Le temps passe vite quand on s'amuse.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070104
					]
				},
				{
					"id": 765070104,
					"content": "Héhé ! Je n'aurais jamais cru qu'on trouverait autant d'endroits magnifiques et qu'on prendrait autant de photos de nos amis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070105,
					"content": "Oh et regarde celle-là ! On en avait bavé pour trouver l'angle parfait, mais le résultat est extra !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070106,
						765070107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070106,
					"content": "C'est grâce à tes talents de guide, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070108
					]
				},
				{
					"id": 765070108,
					"content": "Eh oui ! Je suis la meilleure guide de toute la profession !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070109,
					"content": "Et je me considère payée tant qu'on se fait des souvenirs heureux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070110,
					"content": "#{NICKNAME}, qu'est-ce que ça te fait de prendre des photos avec ce Daguerréotype ? Tu crois que tes compétences de photographe se sont beaucoup améliorées ? Est-ce que tu vas dépasser le légendaire Pierre Leblanc ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070111,
						765070112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070111,
					"content": "Mes compétences... J'ai encore beaucoup à apprendre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070113
					]
				},
				{
					"id": 765070113,
					"content": "Héhé, tu as raison ! Le plus important, c'est d'être heureux ! En plus, je trouve que tes photos sont aussi belles que celles d'un grand photographe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070114,
					"content": "Parce que chacune d'entre elles contient des histoires qu'on a vécues ensemble. C'est quelque chose d'irremplaçable pour moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070115,
					"content": "À l'avenir, quand... euh, quand nos aventures nous mèneront à d'autres endroits, on se remémorera ces bons souvenirs. Ce sera intéressant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070116,
					"content": "Prenons d'autres photos ensemble plus tard.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070117
					]
				},
				{
					"id": 765070117,
					"content": "Oui ! C'est décidé, notre prochain album photo sera plus grand, plus beau et plein de souvenirs encore plus spéciaux que celui-ci !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070112,
					"content": "L'important, c'est de s'amuser.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070113
					]
				},
				{
					"id": 765070107,
					"content": "C'est grâce à ta réserve de fonds d'urgence, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070108
					]
				},
				{
					"id": 765070103,
					"content": "Il y a un souvenir derrière chaque photo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070104
					]
				}
			]
		}
	]
