			},
			"dialogs": [
				{
					"id": 718130801,
					"content": "Bonjour, puis-je vous aider ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130802
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718130802,
					"content": "À propos de ces préparatifs...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130803
					]
				},
				{
					"id": 718130803,
					"content": "C'est... « Perle précieuse » ? Où avez-vous trouvé ça ? J'ai cherché cet ouvrage dans tout Liyue sans résultat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130804
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718130804,
					"content": "Qingzhou a rédigé lui-même cette copie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130805
					]
				},
				{
					"id": 718130805,
					"content": "Le poète ? Il semble que sa réputation ne soit pas usurpée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130806
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718130806,
					"content": "Merci pour votre aide ! Je paierai maître Lu dès qu'il aura fini les pièces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130807
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718130807,
					"content": "Vous prévoyez donc de reconstruire la Chambre de Jade...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130808
					]
				},
				{
					"id": 718130808,
					"content": "C'est en effet dans nos plans. Mais vu le nombre de choses à préparer, il sera impossible d'achever ce projet dans un court délai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130809
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718130809,
					"content": "Sans parler de notre souci de matériaux, pour lequel nous n'avons pas encore trouvé de solution tangible...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130810
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718130810,
					"content": "Bon, n'en parlons plus pour le moment. Merci encore d'avoir aidé à préparer tout ça, et veuillez accepter ceci pour votre peine. Je dois retourner à mon travail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Baiwen"
				}
			]
		},
