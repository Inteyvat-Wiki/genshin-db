					"Maître Lu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718130701,
					"content": "Alors, ces sangliers ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130702
					],
					"speakerTitle": "Maître Lu"
				},
				{
					"id": 718130702,
					"content": "C'est bon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130703
					]
				},
				{
					"id": 718130703,
					"content": "Voilà une bonne chose de faite ! Je vais de suite aller chercher du bambou, et j'enverrai les pièces directement au Pavillon Yuehai une fois terminées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130704
					],
					"speakerTitle": "Maître Lu"
				},
				{
					"id": 718130704,
					"content": "Cette commande est importante. Elle devrait valoir son pesant de moras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maître Lu"
				}
			]
		},
