			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Maître Lu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718130601,
					"content": "Bonjour, que puis-je faire pour vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130602
					],
					"speakerTitle": "Maître Lu"
				},
				{
					"id": 718130602,
					"content": "J'aimerais commander des pièces en bambou...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130603
					]
				},
				{
					"id": 718130603,
					"content": "Du bambou, vous dites ? Ça ne posera pas de problème, mais puis-je savoir d'où vient cette commande ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130604
					],
					"speakerTitle": "Maître Lu"
				},
				{
					"id": 718130604,
					"content": "C'est une demande de Baiwen...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130605
					]
				},
				{
					"id": 718130605,
					"content": "Oh... Une commande du Pavillon Yuehai ! Je vais faire de mon mieux pour terminer ça le plus rapidement possible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130606
					],
					"speakerTitle": "Maître Lu"
				},
				{
					"id": 718130606,
					"content": "Par contre, c'est dans la forêt de bambou que je récupère mes matériaux, et les sangliers se sont mis à pulluler ces derniers temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130607
					],
					"speakerTitle": "Maître Lu"
				},
				{
					"id": 718130607,
					"content": "Ils ne sont pas si gênants, mais je dois quand même les éviter pour couper du bambou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130608
					],
					"speakerTitle": "Maître Lu"
				},
				{
					"id": 718130608,
					"content": "Si vous pouviez les chasser de la forêt, je pourrais récupérer mon bambou plus rapidement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130609
					],
					"speakerTitle": "Maître Lu"
				},
				{
					"id": 718130609,
					"content": "Pas de problème.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130610
					]
				},
				{
					"id": 718130610,
					"content": "#Bon, je vous attends ici. Revenez me voir une fois que vous vous serez {M#occupé}{F#occupée} d'eux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maître Lu"
				}
			]
		},
