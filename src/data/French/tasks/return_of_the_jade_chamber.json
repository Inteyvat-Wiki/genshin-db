			"trigger": {
				"objectNames": [
					"Qingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718130501,
					"content": "« Pour l'immortalité de Liyue et pour la prospérité du monde mortel... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130502
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130502,
					"content": "Oh, vous êtes de retour. Attendez une seconde... J'ai presque fini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130503
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130503,
					"content": "Bon... Voilà, terminé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130504
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130504,
					"content": "Voilà pour vous...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130505
					]
				},
				{
					"id": 718130505,
					"content": "Point de précipitation ! Admirez d'abord ce savoir-faire. Ma calligraphie est, je dois l'avouer, plus qu'acceptable et à même de plaire à l'œil le plus exigeant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130506
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130506,
					"content": "C'est quand même assez impressionnant.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130507
					]
				},
				{
					"id": 718130507,
					"content": "Haha, vos louanges me vont droit au cœur. Prenez donc ce livre, et ne l'égarez pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
			]
		},
		{
			"id": 7181306,
			"completionStepIds": [
				7181306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
