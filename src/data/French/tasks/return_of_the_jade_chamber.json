					"Jifang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718130201,
					"content": "Bonjour, recherchez-vous quelque chose en particulier ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130202
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718130202,
					"content": "J'aimerais un exemplaire de « Perle précieuse ».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130203
					]
				},
				{
					"id": 718130203,
					"content": "« Perle précieuse », vous dites... Je ne l'ai pas en rayon... Est-ce que c'est urgent ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130204
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718130204,
					"content": "C'est pour la reconstruction de la Chambre de Jade...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130205
					]
				},
				{
					"id": 718130205,
					"content": "Oh, la Chambre de Jade... Cela requiert de nombreux préparatifs en effet. Voyons voir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130206
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718130206,
					"content": "Vous pourriez peut-être demander à Qingzhou. Il est extrêmement cultivé et saura probablement où trouver un exemplaire de « Perle précieuse ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130207
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718130207,
					"content": "Entendu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130208
					]
				},
				{
					"id": 718130208,
					"content": "Qingzhou réside à l'Auberge Wangshu. Vous devriez le trouver là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jifang"
				}
			]
		},
		{
			"id": 7181303,
			"completionStepIds": [
				7181303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181303",
							"2"
						],
						"stepId": 7181303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718130301,
					"content": "Voilà qui n'est pas chose aisée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130302
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130302,
					"content": "Ça vous dit quelque chose « Perle précieuse » ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130303
					]
				},
				{
					"id": 718130303,
					"content": "« Perle précieuse » ? Oui, je me souviens de cet ouvrage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130304
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130304,
					"content": "J'étais à la recherche d'inspiration pour un poème sur les marchands quand la chance m'a fait tomber sur cette œuvre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130305
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130305,
					"content": "Le sens profond de certains de ses passages m'a échappé, mais il a au moins servi d'inspiration à l'une de mes créations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130306
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130306,
					"content": "Je me rappelle à présent de ce poème...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130307
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130307,
					"content": "Vous souvenez-vous où trouver ce livre ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130308
					]
				},
				{
					"id": 718130308,
					"content": "Vous êtes à sa recherche ? Diantre, je ne me souviens plus où il était...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130309
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130309,
					"content": "Cependant, si l'urgence est de mise, il m'est possible de vous en rédiger une copie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130310,
						718130311
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130310,
					"content": "À la main ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130312
					]
				},
				{
					"id": 718130312,
					"content": "*soupir* Ce texte ne brille pas vraiment par sa longueur. Le mémoriser était un jeu d'enfant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130313
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130313,
					"content": "Qui plus est, la personne qui possédait la copie de « Perle précieuse » ne voulait pas que je l'emporte avec moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130314
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130314,
					"content": "Et comme je ne pouvais pas écrire mon poème au pied levé, j'ai par conséquent recopié l'ouvrage, et comme le contenu était plutôt court, je le connais pratiquement par cœur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130315
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130315,
					"content": "C'est quand même assez impressionnant.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130316
					]
				},
				{
					"id": 718130316,
					"content": "#Ce n'est pas grand-chose, mon {M#ami}{F#amie}... Cela étant, peut-être pourriez vous m'accorder une faveur en retour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130317
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130317,
					"content": "Cela m'afflige de le confesser, mais j'ai été tellement pris par ma quête d'inspiration que j'en ai oublié de me repaître, et mon ventre crie famine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130318
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130318,
					"content": "Pourriez-vous m'apporter un pâté aux trois saveurs ? Je vous fournirai une copie manuscrite de « Perle précieuse ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130319
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130319,
					"content": "J'aurai fini de retranscrire l'ouvrage quand vous serez de retour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130311,
					"content": "Vous l'avez mémorisé ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130312
					]
				}
			]
		},
		{
			"id": 7181304,
