			},
			"dialogs": [
				{
					"id": 790580101,
					"content": "C'est une scène coupée de « La grande évasion ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580102
					],
					"speakerTitle": "Notes de scène"
				},
				{
					"id": 790580102,
					"content": "À l'origine, c'est l'histoire d'un Eidolon Hydro pris au piège dans une grotte mystérieuse. Celui-ci n'avait que les outils cachés dans un livre pour s'échapper...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580103
					],
					"speakerTitle": "Notes de scène"
				},
				{
					"id": 790580103,
					"content": "Mais Idyia a rejeté l'idée en bloc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580104
					],
					"speakerTitle": "Notes de scène"
				},
				{
					"id": 790580104,
					"content": "Je pense qu'elle n'avait pas tout à fait tort. Les Eidolons Hydro n'ont pas besoin d'outils pour s'échapper d'une grotte, ils peuvent s'enfuir comme ils veulent. De plus, cacher des outils dans un livre était un peu tiré par les cheveux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580105
					],
					"speakerTitle": "Notes de scène"
				},
				{
					"id": 790580105,
					"content": "Mais je reste convaincu que c'est une super idée ! Si seulement Idyia pouvait en voir le potentiel...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580106
					],
					"speakerTitle": "Notes de scène"
				},
				{
					"id": 790580106,
					"content": "Hélas, il faut d'abord récupérer le <color=#00E1FFFF>livre contenant les outils que les Brutocollinus ont volé</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580107
					],
					"speakerTitle": "Notes de scène"
				},
				{
					"id": 790580107,
					"content": "- Le metteur en scène",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Notes de scène"
				}
			]
		},
