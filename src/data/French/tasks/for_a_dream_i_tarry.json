	"talks": [
		{
			"id": 7310901,
			"completionStepIds": [
				7310901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310901",
							"2"
						],
						"stepId": 7310901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Javi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731090101,
					"content": "C'est étrange, ça devrait être près d'ici. Pourquoi je n'arrive pas à la trouver ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090102
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090102,
					"content": "Que cherchez-vous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090103
					]
				},
				{
					"id": 731090103,
					"content": "#Vous êtes... Ouah ! C'est vous {M#le voyageur}{F#la voyageuse}, n'est-ce pas ? J'ai entendu parler de vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090104
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090104,
					"content": "Je m'appelle Javi, je... Je suis un vendeur, tout ce qu'il y a de plus banal. Je suis en train de chercher la boîte à rêve que j'ai enterrée ici l'autre fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090105
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090105,
					"content": "C'est plutôt bizarre comme nom... Qu'est-ce qu'il y a dans cette boîte ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731090106,
					"content": "Eh bien... Si vous voulez le savoir, j'y ai mis le rêve que j'espérais voir se réaliser lorsque j'étais petit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090107
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090107,
					"content": "Pourquoi faire ça ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090108
					]
				},
				{
					"id": 731090108,
					"content": "Hahaha, c'est un genre de jeu auquel je jouais avec mes amis quand on était enfants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090109
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090109,
					"content": "On écrivait un rêve que l'on voulait voir se réaliser sur un papier, puis on l'enterrait ici. Après quoi, on fixait une date à laquelle venir déterrer ensemble la boîte à rêve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090110
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090110,
					"content": "Et cette date que nous avons fixée, c'est aujourd'hui ! Mais apparemment, je suis le seul à m'en être souvenu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090111
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090111,
					"content": "*soupir* Peu importe s'ils ont oublié... Du moment qu'ils n'ont pas oublié leurs rêves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090112
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090112,
					"content": "Bref, je suis venu pour déterrer ma propre boîte. J'y voyais le moyen de soulager le poids que j'ai sur le cœur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090113
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090113,
					"content": "Mais j'ai beau la chercher... je n'ai rien trouvé... Vous ne pensez tout de même pas que quelqu'un aurait pu la déterrer, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090114,
						731090115
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090114,
					"content": "Avez-vous laissé une marque à l'époque ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090118
					]
				},
				{
					"id": 731090118,
					"content": "Je me souviens qu'à l'époque, je l'avais enterrée à côté d'un arbre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090119
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090119,
					"content": "À côté d'un arbre ? Mais il y en a plein dans le coin !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731090120,
					"content": "Je n'avais pas pensé à ça. On avait placé un petit panneau pour marquer l'endroit où la boite était enterrée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090121
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090121,
					"content": "Cela fait désormais si longtemps que le panneau a disparu. Et en plus, je ne reconnais plus du tout les arbres du coin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090122
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090122,
					"content": "Tout ce dont je me souviens, c'est que la boîte ne doit pas être loin d'ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090123
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090123,
					"content": "#{M#Voyageur}{F#Voyageuse}, pourriez-vous m'aider à la chercher ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090124,
						731090127
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090124,
					"content": "Mais comment faire ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090125
					]
				},
				{
					"id": 731090125,
					"content": "J'ai enterré la boîte à côté d'un arbre, alors... commençons par creuser à côté des arbres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090126
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090126,
					"content": "#Aidez-moi, {M#voyageur}{F#voyageuse}. Je vous récompenserai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090130
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090130,
					"content": "Regardez à quel point cette forêt est grande, je n'y arriverai jamais seul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090131
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090131,
					"content": "D'accord...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090132
					]
				},
				{
					"id": 731090132,
					"content": "Héhé, merci. Séparons-nous pour chercher. Je vais aller de ce côté. Vous, occupez-vous de l'autre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090127,
					"content": "Votre rêve s'est envolé de toute façon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090128
					]
				},
				{
					"id": 731090128,
					"content": "C'est justement pour ça que je veux déterrer cette boîte. Pour me rappeler le rêve que je voulais voir se réaliser à l'époque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090129
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090129,
					"content": "#Je vous en prie, {M#voyageur}{F#voyageuse}, donnez-moi un coup de main. Je vous récompenserai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090130
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090115,
					"content": "Votre rêve s'est envolé...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090116
					]
				},
				{
					"id": 731090116,
					"content": "Hahaha... Peut-être bien. Je ne me rappelle même plus de ce que j'ai écrit à l'époque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090117
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090117,
					"content": "Mais même si mon rêve s'était envolé, je ne crois pas que cette boîte l'aurait suivi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090118
					],
					"speakerTitle": "Javi"
				}
			]
		},
		{
			"id": 7310903,
			"completionStepIds": [
				7310903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310903",
							"2"
						],
						"stepId": 7310903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Javi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731090301,
					"content": "Non, ce n'est pas ma boîte à rêve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090302,
						731090304
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090302,
					"content": "On a déterré une boîte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090303
					]
				},
				{
					"id": 731090303,
					"content": "Haha... Moi aussi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090305
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090305,
					"content": "Oui et je l'ai ouverte. Sur le papier qu'elle contenait, il y a écrit le nom « Ami ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090306
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090306,
					"content": "Je connais cette enfant, c'est la fille de Jahangir. Elle est souvent près du magasin d'alimentation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090307
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090307,
					"content": "Son rêve est de devenir une fleuriste et de planter tout plein de plantes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090308
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090308,
					"content": "Je n'y aurais pas cru en la voyant. Je pensais que Jahangir voulait la former afin qu'elle prenne la succession de leur boutique familiale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090309,
						731090310
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090309,
					"content": "Regardons d'abord votre rêve.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090311
					]
				},
				{
					"id": 731090311,
					"content": "Ouah ! Oui, c'est ça ! Voyons voir quel était mon rêve...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090312
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090312,
					"content": "Voyons voir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090313
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090313,
					"content": "« J'espère devenir un vanara et vivre pour toujours dans la forêt... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090314
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090314,
					"content": "Mon rêve d'enfant, c'était ça ? Mais où avais-je la tête...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090315
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090315,
					"content": "Pouah... Quel idiot ! Le métier de vanara n'est pas un métier facile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090316,
						731090317
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090316,
					"content": "Je ne vois rien de mal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090318
					]
				},
				{
					"id": 731090318,
					"content": "Seuls des enfants peuvent avoir ce genre d'idée. À mon âge, les rêves...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090319
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090319,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090320
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090320,
					"content": "Il vaut mieux réfléchir au moyen de gagner plus de moras. Ça permet de mieux dormir la nuit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090321
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090321,
					"content": "Bien, oublions ce rêve sans intérêt et parlons plutôt d'Ami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090322
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090322,
					"content": "J'ai ouvert sa boîte à rêve, alors il va falloir faire quelque chose pour réparer ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090323
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090323,
					"content": "Laissez-moi réfléchir... Elle va d'abord devoir apprendre à planter des fleurs, si elle veut devenir fleuriste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090324
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090324,
					"content": "J'ai justement un pot qui ne me sert à rien. Nous pourrions le lui offrir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090325
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090325,
					"content": "#{M#Voyageur}{F#Voyageuse}, savez-vous comment obtenir des graines de fleurs ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090326,
						731090327
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090326,
					"content": "Je m'en occupe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090332
					]
				},
				{
					"id": 731090332,
					"content": "#Bien, {M#voyageur}{F#voyageuse}, je compte sur vous pour les graines. Retrouvons-nous devant le magasin de Jahangir tout à l'heure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090327,
					"content": "Pourquoi voulez-vous faire cela ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090328
					]
				},
				{
					"id": 731090328,
					"content": "Haha... Disons que c'est quelque chose de spontané.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090329
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090329,
					"content": "Il m'est désormais impossible de courir après mon rêve. Je suis trop vieux pour cela et puis... ce rêve ne m'emballe plus vraiment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090330
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090330,
					"content": "Mais Ami est encore jeune et a encore l'opportunité de réaliser le sien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090331
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090331,
					"content": "Un adulte ennuyeux comme moi ne peut pas grand-chose pour l'aider, mais au moins, avec ce pot, je pourrai l'encourager un peu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090332
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090317,
					"content": "Aucun rêve n'est bon ou mauvais.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090318
					]
				},
				{
					"id": 731090310,
					"content": "Voici votre boîte à rêve.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090311
					]
				},
				{
					"id": 731090304,
					"content": "Vous en avez déterré une aussi ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090305
					]
				}
			]
		},
		{
			"id": 7310905,
			"completionStepIds": [
				7310905
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
