						],
						"stepId": 7310905,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ami",
					"Javi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731090501,
					"content": "C'est pour moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090502
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090502,
					"content": "Ce n'est pas grave si vous avez lu ce qui est écrit, j'avais juste enterré cette boîte comme ça. Ce n'est pas la peine de vous excuser !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090503
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090503,
					"content": "Ce n'est rien. Je ne me sers pas de ce pot de toute manière, alors autant te l'offrir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090504
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090504,
					"content": "#J'ai également demandé à quelqu'un de se procurer des graines, {M#il}{F#elle} devrait bientôt arriver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090505,
						731090506
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090505,
					"content": "Voilà les graines !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090507
					]
				},
				{
					"id": 731090507,
					"content": "#Hein ? Quand êtes-vous {M#arrivé}{F#arrivée} ? Je ne vous avais même pas {M#vu}{F#vue}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090508
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090508,
					"content": "Hum... Ami, n'as-tu pas envie de devenir fleuriste ? Tu peux utiliser tout ça pour commencer à planter des fleurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090509
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090509,
					"content": "Merci... Mais si je plante une fleur à côté du magasin de papa, les insectes vont peut-être se mettre à voler jusque dans ses casseroles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090510
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090510,
					"content": "Ces pauvres petits insectes... Sans parler des gens qui les mangeront après coup...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090511
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090511,
					"content": "Mais si je la mets plus loin, j'ai peur de l'oublier. Je n'ose pas imaginer cette pauvre fleur qui dépérirait toute seule...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090512
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090512,
					"content": "Et puis, papa est toujours très occupé et ne me laisse pas aller trop loin toute seule...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090513
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090513,
					"content": "Euh... Et si je t'aidais à t'en occuper, ça irait ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090514
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090514,
					"content": "Je ne pourrai venir qu'après le travail chaque jour, mais c'est déjà ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090515
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090515,
					"content": "Super ! Mais peut-être que papa ne sera pas d'accord...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090516
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090516,
					"content": "Je connais un peu Jahangir. Allons lui parler ensemble et je suis sûr qu'il acceptera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090517
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090517,
					"content": "D'accord ! A—Alors... Je veux planter plus de fleurs ! Celles que j'adore par-dessus tout, ce sont les roses sumériennes ! Plus tard... j'en planterai à côté du magasin de papa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090518
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090518,
					"content": "D'accord. Tu as des rêves plein la tête, toi. Bien, alors on va faire de notre mieux ensemble !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090519,
						731090520
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090519,
					"content": "Quand elles auront poussé, gardez-m'en une.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090521
					]
				},
				{
					"id": 731090521,
					"content": "#Oui ! Merci, {M#monsieur}{F#madame}. Que vais-je bien encore pouvoir planter, hmm... Une fleur sucrante et euh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090522
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090522,
					"content": "On dirait qu'elle aime vraiment beaucoup les fleurs. J'espère qu'elle va pouvoir poursuivre son rêve...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090523
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090523,
					"content": "Héhé, il ne faut pas qu'elle devienne une adulte aussi banale et ennuyeuse que moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090524
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090524,
					"content": "#Ahem ! Merci pour votre aide, {M#voyageur}{F#voyageuse}. Prenez ceci en guise de remerciement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090525,
						731090526
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090525,
					"content": "Ce n'est pas parce que vous êtes sérieux que vous êtes banal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090527
					]
				},
				{
					"id": 731090527,
					"content": "Merci, je ne me plains pas non plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090528
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090528,
					"content": "C'est juste que... en voyant la boîte à rêve que j'ai enterrée aujourd'hui, j'ai été un peu sous le coup de l'émotion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090529
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090529,
					"content": "#Bon allez, je vais devoir rentrer. Merci encore pour aujourd'hui, {M#voyageur}{F#voyageuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090530
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090530,
					"content": "Est-ce que je ne devrais pas... réécrire un rêve et aller l'enterrer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090526,
					"content": "Ce n'est pas parce que vous êtes sérieux que vous êtes ennuyeux.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090527
					]
				},
				{
					"id": 731090520,
					"content": "Bon courage !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090521
					]
				},
				{
					"id": 731090506,
					"content": "Ces fleurs sont pour toi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090507
					]
				}
			]
		},
