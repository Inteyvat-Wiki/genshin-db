			"dialogs": [
				{
					"id": 752780101,
					"content": "A—Attendez, vous deux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780102
					],
					"speakerTitle": "Chiton"
				},
				{
					"id": 752780102,
					"content": "On peut t'aider, petite ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780103,
					"content": "« Soyez témoins du miracle de l'épanouissement des barbarifigues, laissez le sanctifeu embraser votre sourire ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780104
					],
					"speakerTitle": "Chiton"
				},
				{
					"id": 752780104,
					"content": "Hein ? Qu'est-ce que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780105,
					"content": "« Au nom de la Station balnéaire Brisedouce, laissez-moi vous interpréter une danse de bienvenue ! C'est le moment de briller, Idole de Pipilpan ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780106
					],
					"speakerTitle": "Chiton"
				},
				{
					"id": 752780106,
					"content": "Argh, encore cette réplique ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780107,
					"content": "#Eh oui, c'est moi, Chiton ! Ça faisait longtemps, {M#monsieur}{F#mademoiselle} {NICKNAME} et mademoiselle Paimon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780108
					],
					"speakerTitle": "Chiton"
				},
				{
					"id": 752780108,
					"content": "#Oh, c'est toi, Chiton ! Je pensais qu'on était encore {M#tombés}{F#tombées} sur quelqu'un d'effrayant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780109,
						752780110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780109,
					"content": "Tu as l'air heureuse. Tu as de bonnes nouvelles à raconter ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752780111
					]
				},
				{
					"id": 752780111,
					"content": "Hehe, devinez quoi ? Papa va me former personnellement pour que je devienne une vraie comédienne !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780112
					],
					"speakerTitle": "Chiton"
				},
				{
					"id": 752780112,
					"content": "Tu vois ? Il joue les durs, mais il se soucie vraiment de toi ! Même si ce serait quand même mieux s'il ne t'apprenait pas... des choses douteuses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780113,
					"content": "Oh, au fait. Voici pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780114
					],
					"speakerTitle": "Chiton"
				},
				{
					"id": 752780114,
					"content": "Mais c'est ta tenue de scène ? Sans elle, tu..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780115,
					"content": "Ne vous inquiétez pas ! Papa m'a fabriqué une nouvelle tenue qui me va beaucoup mieux ! C'est fini les chutes sur scène pour moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780116
					],
					"speakerTitle": "Chiton"
				},
				{
					"id": 752780116,
					"content": "Considérez cette vieille tenue comme un souvenir ! Prenez-la, s'il vous plaît. Ce sera un symbole de notre amitié !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780117
					],
					"speakerTitle": "Chiton"
				},
				{
					"id": 752780117,
					"content": "La prochaine fois qu'on se verra, je porterai ma nouvelle tenue et je danserai juste pour vous. Promettez-moi de venir me voir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780118
					],
					"speakerTitle": "Chiton"
				},
				{
					"id": 752780118,
					"content": "Oui, c'est promis !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780119,
					"content": "Chiton ! C'est l'heure de s'entraîner !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780120,
					"content": "#Bon, je dois aller entraîner mes muscles. Au revoir {NICKNAME} et Paimon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780121
					],
					"speakerTitle": "Chiton"
				},
				{
					"id": 752780121,
					"content": "Au revoir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780122,
					"content": "(Tu vas vraiment y aller ?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752780123
					]
				},
				{
					"id": 752780123,
					"content": "Bien sûr ! Bien que... voir une performance normale d'idole serait pas mal non plus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780110,
					"content": "Comment ça va ces derniers temps ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752780111
					]
				}
			]
		}
	]
}