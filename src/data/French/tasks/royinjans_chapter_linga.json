			"dialogs": [
				{
					"id": 730280101,
					"content": "Il y a aussi des pièces du grand robot ici. Si monsieur Jazari voyait ça, il sortirait sans doute son Daguerréotype.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730280102,
					"content": "Au fait, Ararycan, tu nous avais dit que c'était toi qui avais déplacé les grandes pièces de la base secrète. Alors, c'est vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730280103,
					"content": "Bien sûr que c'est vrai. Ararycan ne ment pas aux naras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280104,
						730280105
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730280104,
					"content": "C'est donc ce à quoi je pensais...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730280106
					]
				},
				{
					"id": 730280106,
					"content": "Ararycan était l'aranara qui jouait avec les enfants à la base secrète.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730280107,
					"content": "Mais il ne se souvient de rien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280108,
						730280109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730280108,
					"content": "Cela a peut-être quelque chose à voir avec la fleur séchée dans le journal...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730280110
					]
				},
				{
					"id": 730280110,
					"content": "Oui. L'aranara de la Forêt de Mawtiyima avait tout oublié après nous avoir donné sa fleur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730280111,
					"content": "Peut-être que ces trois-là ont vécu les mêmes aventures que nous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730280112,
					"content": "Ararycan ne sait pas de quoi vous parlez, et Ararycan ne se souvient pas non plus. Qu'importe, c'est amusant de jouer avec les petits naras !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280113
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730280113,
					"content": "Oui. J'espère que tu seras toujours heureux, Ararycan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730280109,
					"content": "On a déjà vu ce genre de chose...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730280110
					]
				},
				{
					"id": 730280105,
					"content": "Si je ne me trompe pas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730280106
					]
				}
			]
		},
