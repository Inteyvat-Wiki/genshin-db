			"dialogs": [
				{
					"id": 200610401,
					"content": "À propos des pigeons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610402
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610402,
					"content": "Comme ça, ils arrêteront d'être paresseux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610403
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610403,
					"content": "Je ne peux pas suivre leurs faits et gestes, alors je ne peux me contenter que de ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610404
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610404,
					"content": "Merci. Voilà votre récompense ! Si vous avez besoin d'envoyer un message, n'hésitez pas à venir me voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Draff"
				}
			]
		},
