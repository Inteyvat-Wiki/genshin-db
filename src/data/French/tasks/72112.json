					"nextDialogs": [
						721123603
					]
				},
				{
					"id": 721123603,
					"content": "Ce sanctuaire semble vraiment manquer d'affection divine, hein...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721123604,
					"content": "Voilà pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123605
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721123605,
					"content": "Regardons ce que le destin nous réserve...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721123606,
					"content": "Les omikuji, c'est seulement un par jour. Compris ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123607
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721123607,
					"content": "Ce serait trop fatigant sinon... Non, je veux dire que vous ne pourriez pas utiliser le portique pour... Non, c'est pas ça non plus. Zut, qu'est-ce que je suis censée dire déjà ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123608
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721123608,
					"content": "« Les omikuji sont la manifestation de la volonté de notre Archon. Il est de notre devoir de mortels de la respecter et de faire de notre mieux. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123609
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721123609,
					"content": "Vous voyez, c'est écrit noir sur blanc. Les omikuji, c'est seulement un par jour. Compris ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gendou Ringo"
				}
			]
