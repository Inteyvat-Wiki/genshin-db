				"objectNames": [
					"Gendou Ringo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721123501,
					"content": "C'est pour les omikuji ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123502
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721123502,
					"content": "Quelle froideur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721123503,
					"content": "Oui, s'il vous plaît.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721123504
					]
				},
				{
					"id": 721123504,
					"content": "Très bien. Je vous explique comment ça marche. Tout d'abord, vous secouez cette... boîte, là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123505
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721123505,
					"content": "C'est ça, une boîte d'omikuji ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721123506
					]
				},
				{
					"id": 721123506,
					"content": "Exact. Un bâtonnet en bambou en tombera. Donnez-le-moi et je vous donne le truc correspondant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123507
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721123507,
					"content": "#Je suis presque {M#sûr}{F#sûre} que ça s'appelle un omikuji...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721123508
					]
				},
				{
					"id": 721123508,
					"content": "Peu importe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123509
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721123509,
					"content": "J'ai une question ! Que fait-on si on obtient un papier avec écrit « infortune » dessus ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721123510,
					"content": "C'est le destin, c'est tout. Ça vous pose un problème ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123511
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721123511,
					"content": "Hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721123512,
					"content": "Il n'y a pas une sorte de dispositif pour l'accrocher ou quoi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721123513
					]
				},
				{
					"id": 721123513,
					"content": "Tsss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123514
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721123514,
					"content": "Elle a vraiment dit « Tsss. » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721123515,
					"content": "Voyons... Hmm, oui : « Accrochez l'omikuji qui prédit une mauvaise fortune sur le portique d'omikuji pour renverser le sort. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123516
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721123516,
					"content": "Voilà ! Il suffit d'accrocher votre papier sur le portique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123517
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721123517,
					"content": "#Quelle bande de... Oups, pardon. Le Sanctuaire de Narukami est très clément. Vous avez l'occasion de renverser votre sort si vous êtes {M#frappé}{F#frappée} par la malchance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123518
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721123518,
					"content": "Je trouve ça louche, moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721123519,
					"content": "#Allez, tire un omikuji, {NICKNAME} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
