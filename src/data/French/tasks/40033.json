			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400330301,
					"content": "Ah ! Parfait ! On devrait tous les avoir maintenant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330302
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330302,
					"content": "... Attendez. Pourquoi ils ne sont pas tous là ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330303
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330303,
					"content": "Oh-oh... Pourquoi ai-je l'impression que ça ne va jamais finir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400330304,
					"content": "C'est vrai qu'il faut parfois s'armer de patience pour résoudre une affaire. Si on suit la mauvaise piste, on peut se retrouver avec rien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330305
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330305,
					"content": "On a trouvé pas mal de ces petits animaux, alors au moins on progresse dans la bonne direction.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330306
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330306,
					"content": "On a peut-être juste manqué quelques indices ou oublié de chercher à certains endroits, ce qui nous a amenés dans l'impasse où on se trouve actuellement. Mais je pense que ce n'est que temporaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330307
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330307,
					"content": "Ooh, je comprends ! Vous voulez dire qu'on a juste besoin d'un peu de peps et tout deviendra clair ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400330308,
					"content": "Mmm, oui, on peut dire qu'on manque de peps à l'heure actuelle. Mais pas de beaucoup. On a fait de gros progrès grâce à vous deux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330309,
						400330310
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330309,
					"content": "(Il... te comprend, Paimon.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400330311
					]
				},
				{
					"id": 400330311,
					"content": "Je comprends tout ce que vous dites, Ryuuji !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400330312,
					"content": "Tu me flattes. C'est juste l'expérience qui parle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330313
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330313,
					"content": "Plus la vérité est enfouie profondément, plus il est important de la découvrir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330314
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330314,
					"content": "C'est juste dommage qu'on n'ait pas plus d'informations pour le moment. Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330315
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330315,
					"content": "Je pense que je vais simplement rapporter l'état actuel de l'enquête à Sango.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330316
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330316,
					"content": "Elle devrait être en mesure d'apporter une nouvelle lumière sur l'affaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330317
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330317,
					"content": "Bien sûr ! J'ai foi en votre bon jugement !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400330318,
					"content": "Alors c'est décidé. Retrouvons-nous à l'endroit habituel quand on aura plus d'indices.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330319
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330319,
					"content": "Si je suis déjà occupé, vous pouvez aller voir Sango directement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330310,
					"content": "(On dirait qu'il te comprend déjà pas mal, Paimon...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400330311
					]
				}
			]
		},
