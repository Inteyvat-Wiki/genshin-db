			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Elber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731850101,
					"content": "#Pfiou... Merci beaucoup, {M#voyageur}{F#voyageuse}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850102,
						731850103
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850102,
					"content": "Tant que vous allez bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850104
					]
				},
				{
					"id": 731850104,
					"content": "Je m'appelle Elber et je suis un marchand. J'avais juste l'intention de me reposer ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850105
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850105,
					"content": "Mais à ma grande surprise, j'ai été attaqué par les Brutocollinus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850106,
						731850107
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850106,
					"content": "Vous n'avez pas d'escortes ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850108
					]
				},
				{
					"id": 731850108,
					"content": "Oui, nous avons entendu dire en ville que les marchands qui transportent des marchandises engagent généralement des Érémites pour les aider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850109,
					"content": "Eh bien, je... C'est cher !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850110
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850110,
					"content": "Les membres des Érémites demandent des rémunérations trop élevées, l'un demande plus que l'autre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850111
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850111,
					"content": "Je ne suis qu'un petit marchand, comment pourrais-je payer un montant aussi élevé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850112
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850112,
					"content": "Je connais un peu les arts martiaux et la route n'était pas si longue, alors je me suis dit que ça irait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850113
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850113,
					"content": "Mais je ne m'attendais pas à ce que les Brutocollinus effraient mes deux bêtes de somme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850114
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850114,
					"content": "Avant de pouvoir faire quoi que ce soit, j'ai été renversé au sol par une des bêtes, et puis, après m'être relevé, j'ai reçu un coup de patte de l'autre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850115
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850115,
					"content": "Ouah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850116,
					"content": "Ensuite, les deux se sont échappées et j'ai été attaqué par les Brutocollinus... Mais heureusement que vous m'avez aidé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850117
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850117,
					"content": "#Mais tous mes biens sont sur le dos de ces deux bêtes de somme... {M#Voyageur}{F#Voyageuse}, pourriez-vous m'aider à les retrouver ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850118,
						731850119
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850118,
					"content": "#Je... Je ne veux pas être {M#frappé}{F#frappée}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850120
					]
				},
				{
					"id": 731850120,
					"content": "Non, ne vous inquiétez pas. Elles sont très dociles en réalité, c'est juste que les Brutocollinus ont renversé leur nourriture.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850121
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850121,
					"content": "Elles avaient beaucoup marché avec des marchandises sur le dos et avaient très faim, alors quand quelqu'un a renversé leur nourriture, elles sont devenues très agressives...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850122
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850122,
					"content": "Je vois... Être dérangées pendant qu'elles mangeaient et avoir toute leur nourriture renversée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850123,
					"content": "Rah, rien que d'y penser me met en colère !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850124,
					"content": "Tu t'emportes vite, Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850125
					]
				},
				{
					"id": 731850125,
					"content": "Bon... Tenez, prenez cette nourriture.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850126
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850126,
					"content": "Quand vous trouvez les bêtes de somme, nourrissez-les avec ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850127
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850127,
					"content": "Tant que vous leur donnez de la nourriture, elles ne se mettront pas en colère.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850128
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850128,
					"content": "Si je m'en souviens bien, une bête de somme s'est heurtée aux Brutocollinus et s'est enfuie toute seule...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850129
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850129,
					"content": "L'autre semble avoir été enlevée par les Brutocollinus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850130
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850130,
					"content": "#Je vais vous marquer les directions approximatives dans lesquelles elles se sont dirigées... Je compte sur vous, {M#voyageur}{F#voyageuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850131
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850131,
					"content": "Je vous donnerai une généreuse récompense quand j'aurai récupéré mes marchandises !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850119,
					"content": "#Je... J'ai peur d'être {M#renversé}{F#renversée}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850120
					]
				},
				{
					"id": 731850107,
					"content": "#Il n'y a personne pour vous protéger{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850108
					]
				},
				{
					"id": 731850103,
					"content": "Ce n'est rien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850104
					]
				}
			]
		},
