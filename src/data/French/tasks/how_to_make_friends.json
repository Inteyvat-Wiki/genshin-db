			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tlamot"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250260201,
					"content": "Concentrez-vous plutôt sur le yumkasaure.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260202
					]
				},
				{
					"id": 250260202,
					"content": "Hmm... Vous avez raison. Le pauvre petit est déjà assez effrayé comme ça. D'accord, je vais aller le calmer d'abord...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260203
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260203,
					"content": "#Venez avec moi. Vous m'avez l'air d'{M#un aventurier expérimenté}{F#une aventurière expérimentée}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260204
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260204,
					"content": "Si nous sommes deux, ces sales voleurs n'oseront rien faire. Ne vous en faites pas pour votre contrepartie, je connais les règles de la Guilde et je compte bien les respecter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260206
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260206,
					"content": "Le petit les adore... Si je me souviens bien, ils poussent sous les arbres là-bas. Pourriez-vous aller en chercher ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260205
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260205,
					"content": "Je vais cueillir des candélapignons de l'autre côté. Retrouvons-nous sur la falaise près du Stade quand vous aurez fini votre cueillette.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260207
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260207,
					"content": "Le saurienneau se repose souvent là-bas. Peut-être qu'on l'y retrouvera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tlamot"
				}
			]
		},
		{
			"id": 2502603,
			"completionStepIds": [
				2502603
			],
