			"trigger": {
				"objectNames": [
					"Tlamot"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250260101,
					"content": "Pauvre petit yumkasaure... Ces ordures... Je vais leur donner une bonne leçon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260102
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260102,
					"content": "Vous pouvez toujours courir, mais je vous retrouverai toujours !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260103
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260103,
					"content": "Qu'est-ce qui se passe ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260104
					]
				},
				{
					"id": 250260104,
					"content": "#Vous êtes {M#un voyageur}{F#une voyageuse} d'ailleurs ? Bonjour, mais je crains de ne pas pouvoir vous accueillir comme il se doit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260105
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260105,
					"content": "Ces satanés Pilleurs de trésors voulaient à nouveau essayer de capturer ce petit yumkasaure. Heureusement que j'ai pu les chasser à temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260106
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260106,
					"content": "Le pauvre est tout apeuré. Il refuse de s'approcher même si je l'appelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260107
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260107,
					"content": "Maintenant que j'ai trouvé le repaire de ces bandits, je vais aller leur donner une bonne leçon ! Je vais les attacher à un arbre et les frapper !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260108
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260108,
					"content": "Il faut aussi que je ramène un encas pour réconforter ce pauvre yumkasaure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tlamot"
				}
			]
		},
		{
			"id": 2502602,
			"completionStepIds": [
				2502601,
				2502606
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
