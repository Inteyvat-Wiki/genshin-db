			"dialogs": [
				{
					"id": 250260601,
					"content": "... Chut. Regardez par là-bas. Il nous attend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260602
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260602,
					"content": "... Raouh ? Raouh, raouh...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260603
					],
					"speakerTitle": "Petit yumkasaure timide"
				},
				{
					"id": 250260603,
					"content": "Viens, petit. On ne te fera pas de mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260604
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260604,
					"content": "Raouh...? Raouh raouh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260605
					],
					"speakerTitle": "Petit yumkasaure timide"
				},
				{
					"id": 250260605,
					"content": "C'est moi, Tlamot. Tu te souviens ? Je t'ai donné toutes ces bonnes choses à manger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260606,
						250260607
					],
					"speakerTitle": "Tlamot"
				},
