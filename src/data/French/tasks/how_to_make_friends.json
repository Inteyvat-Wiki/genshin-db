			"dialogs": [
				{
					"id": 250260501,
					"content": "On va voir s'ils oseront encore s'en prendre à mon petit yumkasaure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260502
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260502,
					"content": "On dirait qu'il y a un malentendu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260503
					]
				},
				{
					"id": 250260503,
					"content": "N'écoutez pas leurs mensonges. Je les ai vus attacher sa queue de mes propres yeux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260504
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260504,
					"content": "Qui sait ce qui lui serait arrivé si je n'étais pas intervenu à temps ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260505
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260505,
					"content": "En tout cas, merci pour votre aide. Voici votre récompense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260506
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260506,
					"content": "Dommage qu'ils se soient enfuis aussi vite. On aurait pu mettre fin à leurs actions malveillantes une bonne fois pour toutes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tlamot"
				}
			]
		},
