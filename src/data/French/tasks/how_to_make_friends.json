					"Tlamot"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250260301,
					"content": "Il traîne dans ce coin d'habitude, mais aucune trace de lui aujourd'hui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260302
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260302,
					"content": "Il doit être mort de trouille depuis l'incident.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260303
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260303,
					"content": "On le cherche ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260304
					]
				},
				{
					"id": 250260304,
					"content": "... Non, laissons-le tranquille pour l'instant. Déposons juste les candélapignons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260305
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260305,
					"content": "Vous savez vous y prendre...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260306
					]
				},
				{
					"id": 250260306,
					"content": "Je m'occupe de ce petit depuis un bon bout de temps. Il est très sensible. Voir des inconnus le terrifie toujours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260307
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260307,
					"content": "Il a bien voulu se montrer à moi après l'avoir nourri pendant un certain temps... Mais je doute qu'il reviendra de sitôt, à cause de ces voyous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260308
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260308,
					"content": "On doit le laisser tranquille pour l'instant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260309
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260309,
					"content": "Merci de m'avoir accompagné. Tenez votre récompense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260310,
						250260311
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260310,
					"content": "Dommage qu'on n'ait pas pu le voir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260312
					]
				},
				{
					"id": 250260312,
					"content": "Ne vous en faites pas. Il se souvient des personnes qui l'ont bien traité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260311,
					"content": "J'aurais bien voulu rencontrer ce petit yumkasaure.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260312
					]
				}
			]
		},
