			"dialogs": [
				{
					"id": 250260401,
					"content": "Allons donner une leçon à ces Pilleurs de trésors.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260402
					]
				},
				{
					"id": 250260402,
					"content": "#Vous voulez m'accompagner ? Merci ! Vous me seriez aussi d'une grande aide. Je peux voir que vous êtes {M#un aventurier expérimenté}{F#une aventurière expérimentée}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260403
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260403,
					"content": "Je vous rémunèrerai selon le règlement de la Guilde des aventuriers. Allons-y, donnons une bonne râclée à ces bandits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tlamot"
