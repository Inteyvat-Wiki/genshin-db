			"dialogs": [
				{
					"id": 730580401,
					"content": "Allons vois les camps des méchants naras ! On va sûrement découvrir ce qu'ils font ici !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580402
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580402,
					"content": "Comment peux-tu savoir si quelqu'un est méchant ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580403
					]
				},
				{
					"id": 730580403,
					"content": "#Eh bien, je ne peux pas vraiment l'expliquer, mais nara {NICKNAME} et Blanche-volante ne sont pas des {M#méchants}{F#méchantes}, c'est sûr ! Aragaru a confiance en {M#eux}{F#elles} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aragaru"
				}
			]
		},
