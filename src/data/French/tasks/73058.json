				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730580201,
					"content": "Vous avez découvert quelque chose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580202
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580202,
					"content": "Hum... On a juste trouvé des ordres vagues et une fleur séchée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730580203,
					"content": "Oh ! Je peux l'avoir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580204
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580204,
					"content": "Ça vient de chez les méchants. Tu n'as pas peur de te faire empoisonner ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730580205,
					"content": "Ne vous inquiétez pas, j'ai vu cette fleur... et je pense connaître cette personne... Pourriez-vous me la donner ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580206
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580206,
					"content": "La voilà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580207
					]
				},
				{
					"id": 730580207,
					"content": "#Merci, nara {NICKNAME} et Blanche-volante !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580208
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580208,
					"content": "Aragaru emporte la fleur séchée à la Forêt de Mawtiyima...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7305804,
