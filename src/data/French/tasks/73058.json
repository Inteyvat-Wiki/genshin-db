				"points": []
			},
			"dialogs": [
				{
					"id": 730580101,
					"content": "#{M#Nara doré}{F#Nara dorée}, Blanche-volante, je suis content de vous revoir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580102
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580102,
					"content": "Oups, dis bonjour la prochaine fois que tu apparais à l'improviste ! J'ai été surprise encore une fois !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580103,
						730580104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730580103,
					"content": "#On n'est pas des {M#méchants}{F#méchantes}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580105
					]
				},
				{
					"id": 730580105,
					"content": "#Hmph... Vous avez raison... Dans ce cas, {M#nara doré}{F#nara dorée} et Blanche-volante qui ne ressemblent pas à des {M#méchants}{F#méchantes}, pourriez-vous m'aider à nouveau ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580106
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580106,
					"content": "#Avec plaisir, appelle-moi {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580107
					]
				},
				{
					"id": 730580107,
					"content": "Je suis Paimon, n'oublie pas mon nom cette fois-ci !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730580108,
					"content": "Cette fois-ci ? Euh... *tousse* Je suis Aragaru !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580109
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580109,
					"content": "#Nous étions ici avec toi, mais tu l'as oublié... Bref, c'est compliqué ! {NICKNAME}, on lui raconte ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730580110,
					"content": "Vous racontez à Aragaru votre aventure en détail.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730580111
					]
				},
				{
					"id": 730580111,
					"content": "Vraiment ? ... Je ne me souviens pas, mais pour une raison que j'ignore, j'ai l'impression que je peux vous faire confiance... En plus, vous avez la fleur que j'ai donnée, je peux sentir sa présence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580112
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580112,
					"content": "Ah ! Les méchants naras ont installé des camps. Voyons ce qu'ils y ont laissé ! Peut-être qu'on pourra découvrir ce qu'ils mijotent !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580104,
					"content": "Nous avons chassé les méchants pour toi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580105
					]
				}
			]
		},
		{
			"id": 7305802,
			"completionStepIds": [
				7305804
