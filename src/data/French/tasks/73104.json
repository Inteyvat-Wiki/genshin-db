					"nextDialogs": [
						731040413
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040413,
					"content": "*soupir* Allez, ne traînons pas. J'ai hâte de pouvoir recommencer à pêcher en toute tranquillité.",
