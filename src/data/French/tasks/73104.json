					"nextDialogs": [
						731040411
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040411,
					"content": "C'est un compliment ? Ça ne me rend pas particulièrement content...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040412
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040412,
					"content": "Bon, on a fini de récupérer les antiquités au premier endroit. Pour ce qui est du prochain... lieu de pêche, il n'est pas loin à l'ouest.",
