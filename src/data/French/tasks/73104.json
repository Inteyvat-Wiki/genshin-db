					"nextDialogs": [
						731040916
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040916,
					"content": "#Peu importe... {M#Voyageur}{F#Voyageuse}, s'il vous plaît, trouvez-moi des pêches zaytuns fraîches pour cette fois.",
