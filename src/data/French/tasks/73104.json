	"talks": [
		{
			"id": 7310401,
			"completionStepIds": [
				7310401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
