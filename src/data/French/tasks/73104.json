			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kayvan",
					"Helbet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731040101,
					"content": "#S'il vous plaît, soyez un peu accommodant ! J'ai vraiment besoin de votre aide{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040102
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040102,
					"content": "Non, c'est impossible. S'il vous plaît, partez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040103
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040103,
					"content": "Oh là là, pourquoi ces deux-là se disputent-ils ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731040104,
					"content": "#Hé, {M#étranger}{F#étrangère}, pouvez-vous m'aider à parler à cette demoiselle ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040105
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040105,
					"content": "Aujourd'hui, elle est soudainement venue me harceler pour que je l'aide à repêcher des antiquités.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040106
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040106,
					"content": "Non seulement elle a fait fuir mes poissons, mais en plus, elle veut occuper mon temps pour le reste de la journée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040107
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040107,
					"content": "Mademoiselle, pourquoi êtes-vous si pressée, vous comptez faire fortune avec ces antiquités ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040108
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040108,
					"content": "Non, monsieur Kayvan ! Je suis Helbet, je fais partie de l'Académie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040109
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040109,
					"content": "Ces antiquités sont des objets qui ont été rassemblés par l'Académie à des fins de recherche, et j'en suis responsable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040110
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040110,
					"content": "Mais hier, le bateau transportant ces reliques a eu un accident, et quelques-unes d'entre elles sont tombées dans la rivière et ont été emportées par le courant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040111
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040111,
					"content": "Alors vous auriez dû vous adresser à une équipe de repêchage professionnelle ! Je ne suis qu'un simple pêcheur, pourquoi vous adresser à moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040112
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040112,
					"content": "Trouver une équipe de repêchage prend trop de temps. J'ai entendu dire que monsieur Kayvan, qu'on appelle le splendide hameçon, arrivait à récupérer des objets perdus dans la rivière presque tous les jours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040113
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040113,
					"content": "D'ailleurs, vous pêchez souvent dans ces eaux. Alors, j'aimerais vous demander d'essayer pour voir si vous arrivez à...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040114,
						731040115
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040114,
					"content": "Quand la situation est désespérée, on essaye toutes sortes de choses...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040117
					]
				},
				{
					"id": 731040117,
					"content": "*tousse* Mademoiselle Helbet, je compatis, mais je ne suis qu'un pêcheur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040118
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040118,
					"content": "Je n'utilise ma canne que pour pêcher des poissons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040119
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040119,
					"content": "Mais vous n'avez pas attrapé un seul poisson...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731040120,
					"content": "Ahem ! Je me suis toujours entraîné dans cette optique. Je n'ai jamais eu en tête de pêcher autre chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040121
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040121,
					"content": "Il vaut donc mieux que vous alliez demander à quelqu'un d'autre de vous aider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040122
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040122,
					"content": "Ah... Ah ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040123
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040123,
					"content": "Sinon... On peut faire comme ça : je ne vous demande plus d'attraper des objets perdus, j'ai juste besoin que vous alliez pêcher ailleurs. Qu'est-ce que vous en dites ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040124
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040124,
					"content": "Considérez que... que je vous paye pour pêcher ! S'il vous plaît, monsieur !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040125
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040125,
					"content": "Grr... Puisque je vous dis que je suis un pêcheur ! Un pêcheur !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040126,
						731040127
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040126,
					"content": "Changer d'endroit pour pêcher, ce n'est pas mal non plus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040128
					]
				},
				{
					"id": 731040128,
					"content": "S'il vous plaît, aidez-moi ! J'ai déjà préparé l'argent pour vous payer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040129
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040129,
					"content": "Vous êtes vraiment insupportables... Bon, allez, j'accepte votre proposition. Où voulez-vous que j'aille pêcher ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040130
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040130,
					"content": "Merci beaucoup, suivez-moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040131
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040131,
					"content": "#{M#Voyageur}{F#Voyageuse}, tout comme avant, j'aimerais que vous m'aidiez à trouver un appât.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040132
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040132,
					"content": "Laissez-moi réfléchir... Oui, cette fois, j'utiliserai de la menthe comme appât, mais il faut que ce soit de la menthe d'un endroit que je fréquente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040133
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040133,
					"content": "Je vais vous marquer l'emplacement approximatif sur la carte... Je compte sur vous. Nous reparlerons de la récompense en détail dès que vous m'aurez ramené les matériaux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040134
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040134,
					"content": "Je vais suivre mademoiselle Helbet jusqu'au lieu de pêche, et nous nous retrouverons plus tard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040127,
					"content": "Les pêcheurs peuvent pêcher toute sorte de choses.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040128
					]
				},
				{
					"id": 731040115,
					"content": "Mais si c'est monsieur Kayvan qui essaye, peut-être que ça fonctionnera...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040116
					]
				},
				{
					"id": 731040116,
					"content": "Je ne pêche que pour attraper de gros poissons, vous comprenez !?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040117
					],
					"speakerTitle": "Kayvan"
				}
			]
		},
