			"dialogs": [
				{
					"id": 701110301,
					"content": "#Hein{NON_BREAK_SPACE}? Fausse alerte{NON_BREAK_SPACE}! C'était juste un feu d'artifice...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 701110302,
					"content": "Q—Quelle splendeur... Lorsque je suivais Son Excellence Narukami Ogosho dans ses batailles, je n'ai jamais vu de fleurs de feu aussi éblouissantes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110303
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110303,
					"content": "Je vois... Voici donc le spectacle merveilleux que Son Altesse Yu Huangyi m'a invité à contempler... Je suis très honoré...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110304
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110304,
					"content": "#«{NON_BREAK_SPACE}Nuit noire comme jais d'ébène, à minuit les nuages éclosent en fleurs lumineuses, le corps tel écume sur l'eau{NON_BREAK_SPACE}; en un instant tout retombe dans le silence, les étoiles se dispersent et la pluie tombe dans le vide...{NON_BREAK_SPACE}» Quelle élégance...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110305
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110305,
					"content": "#Bon, je ne comprends pas trop ce que vous racontez avec vos grands airs... Mais l'essentiel, c'est que tout aille bien{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
