			"dialogs": [
				{
					"id": 701110101,
					"content": "#Chers {M#voyageurs}{F#voyageuses}, veuillez patienter un instant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110102
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110102,
					"content": "Pour aller droit au but, j'ai une requête à vous formuler. Il y a quelques jours, Son Altesse Yu Huangyi de Liyue m'a envoyé un objet précieux d'une rareté exceptionnelle, mais il n'est toujours pas arrivé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110103
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110103,
					"content": "#Je suspecte qu'il a été dérobé par les protecteurs de ces lieux. Si vous trouvez le «{NON_BREAK_SPACE}trésor{NON_BREAK_SPACE}» dont a parlé Son Altesse Yu Huangyi, pourriez-vous me le rapporter{NON_BREAK_SPACE}? En retour, je vous offrirai une récompense à la hauteur de ce service.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				}
			]
		},
		{
			"id": 7011102,
