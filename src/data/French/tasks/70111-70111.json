						],
						"pointId": 229
					}
				]
			},
			"dialogs": [
				{
					"id": 701110201,
					"content": "#On est de retour{NON_BREAK_SPACE}! Regardez, c'est bien ça, le «{NON_BREAK_SPACE}trésor{NON_BREAK_SPACE}», non{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 701110202,
					"content": "#Oh oh, merci infiniment, merci infiniment{NON_BREAK_SPACE}! Un grand merci à vous deux pour votre aide{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110203
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110203,
					"content": "Bon, je vais l'ouvrir sans plus tarder...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110204
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110204,
					"content": "#C—C'est...{NON_BREAK_SPACE}?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110205
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110205,
					"content": "#Waouh{NON_BREAK_SPACE}! Ce truc ne va pas exploser, si{NON_BREAK_SPACE}?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 701110206,
					"content": "#Son Altesse Yu Huangyi ne me ferait jamais de mal... Serait-ce les protecteurs qui l'auraient transformé en bombe après l'avoir dérobé{NON_BREAK_SPACE}?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110207
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110207,
					"content": "#C'est regrettable, mais je ne sais absolument pas comment désamorcer cette bombe... Je n'ai pas d'autre choix que de la jeter au loin{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110208
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110208,
					"content": "#Pas d'inquiétude{NON_BREAK_SPACE}!Un noble venu de l'Hyperborée m'a un jour expliqué comment lancer une sainte bombe{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110209
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110209,
					"content": "#«{NON_BREAK_SPACE}Il faut compter jusqu'à trois, ni plus, ni moins. Il ne faut compter ni jusqu'à quatre, ni jusqu'à deux, cinq serait beaucoup trop. Après trois secondes...{NON_BREAK_SPACE}»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110210
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110210,
					"content": "#Arrêtez de raconter n'importe quoi{NON_BREAK_SPACE}! Si vous ne la lancez pas tout de suite, elle va vraiment exploser{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
