			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200201001,
					"content": "#{M#Voyageur}{F#Voyageuse}, vous êtes déjà de retour ! Vous avez réussi à prendre toutes les photos ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201002
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200201002,
					"content": "Oui, les voici avec les échantillons.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200201003
					]
				},
				{
					"id": 200201003,
					"content": "#Ouah ! Vous avez été rapide ! C'est ça, être {M#un aventurier expérimenté}{F#une aventurière expérimentée} ? Trop fort...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201004
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200201004,
					"content": "#Merci, {M#voyageur}{F#voyageuse} ! Pour vous remercier, laissez-moi vous cuisiner un bon plat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201005
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200201005,
					"content": "Vous trouvez ça comment ? C'est pas mal, n'est-ce pas ? Prenez votre temps pour déguster.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201006
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200201006,
					"content": "Je vais rentrer pour continuer à rédiger mes notes. Hmm, et pour ces plantes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201007
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200201007,
					"content": "Il faut que je demande à Jack s'il sait comment faire pour les conserver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201008
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200201008,
					"content": "Le cécilia sera bien plus joli dans un vase plutôt que d'en faire un échantillon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				}
			]
		},
