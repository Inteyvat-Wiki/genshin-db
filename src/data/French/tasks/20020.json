				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200200101,
					"content": "Je vois, je vois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200102
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200102,
					"content": "Anthony, est-ce que tu sais à quoi servent ces plantes en dehors de leur utilisation en cuisine ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200103
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200103,
					"content": "Comment suis-je supposé le savoir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200104
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200200104,
					"content": "Je sais juste où les trouver et si elles sont comestibles ou non.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200105
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200200105,
					"content": "Oh... Alors je vais aller voir moi-même. Ne t'inquiète pas, je vais juste cueillir des plantes, je ne m'approcherai pas des monstres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200106
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200106,
					"content": "*soupir* D'accord, mais fais attention.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200107
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200200107,
					"content": "Je sais. Je rentrerai un peu plus tard aujourd'hui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200108,
						200200109
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200108,
					"content": "Tu continues toujours ton entraînement ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200200110
					]
				},
				{
					"id": 200200110,
					"content": "#{M#Voyageur}{F#Voyageuse} ! Vous tombez à pic. Je m'apprêtais à sortir pour étudier des plantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200111
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200111,
					"content": "Cyrus m'a dit que les aventuriers dormaient souvent à la belle étoile et que la recherche de nourriture était une compétence très importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200112
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200112,
					"content": "Je voulais donc sortir pour observer les plantes dans la nature. Je vais noter leurs caractéristiques et l'endroit où on les trouve pour ensuite mémoriser ces connaissances petit à petit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200113
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200113,
					"content": "Comme ça, quand je chercherai de la nourriture dans la nature, je saurai quelles plantes sont comestibles et lesquelles sont à éviter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200114
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200114,
					"content": "Cependant... Je trouve qu'un carnet avec seulement des descriptions ne suffit pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200115
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200115,
					"content": "#{M#Voyageur}{F#Voyageuse}, j'ai entendu dire que vous possédiez ce que l'on appelle un «{NON_BREAK_SPACE}Daguerréotype{NON_BREAK_SPACE}».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200116
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200116,
					"content": "Est-ce que vous pourriez utiliser votre Daguerréotype pour m'aider à prendre en photo l'environnement dans lequel vivent certains types de plantes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200117
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200117,
					"content": "Bien sûr.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200200118
					]
				},
				{
					"id": 200200118,
					"content": "Alors si vous le voulez bien, aidez-moi à prendre en photo du lys calla, des herbes à lampe et des cécilias dans leurs environnements respectifs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200119
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200119,
					"content": "Après cela, pourriez-vous me ramener ces trois types de plantes ? J'aimerais les conserver comme échantillons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200120
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200120,
					"content": "Avec des images de ces plantes dans leur environnement naturel, des échantillons de ces espèces et des descriptions détaillées...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200121
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200121,
					"content": "Mon « herbier de l'aventurier » sera vraiment agréable à lire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200122
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200122,
					"content": "#Alors je compte sur vous, {M#voyageur}{F#voyageuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200123
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200123,
					"content": "Vous devriez pouvoir trouver beaucoup de lys calla à côté de la source de Deauclaire et des herbes à lampe au Territoire des Loups.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200124
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200124,
					"content": "Quant aux cécilias... Vous les trouverez à la Falaise Arrachétoile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200125
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200125,
					"content": "Pour ma part, je vais continuer mes observations de plantes ailleurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200126
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200126,
					"content": "Retrouvons-nous dans la cité quand vous aurez pris toutes les photos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200109,
					"content": "Comment se passe ton entraînement ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200200110
					]
				}
			]
		},
		{
			"id": 2002010,
