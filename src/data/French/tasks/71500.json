			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Souffle-Nuages"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715000101,
					"content": "Hum, peut-être qu'il est plus judicieux de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000102
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 715000102,
					"content": "#Ah, {M#voyageur}{F#voyageuse}. Tu tombes bien, j'ai terminé de configurer cette machine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000103,
						715000105
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 715000103,
					"content": "Le cuiseur suprême ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715000104
					]
				},
				{
					"id": 715000104,
					"content": "Tout à fait. J'y ai consacré beaucoup de temps et ses fonctionnalités sont nombreuses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000107
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 715000107,
					"content": "Afin de fabriquer ce cuiseur suprême, j'ai lu pléthores de textes antiques pour comprendre les principes de la cuisine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000108
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 715000108,
					"content": "Premièrement, il faut chercher des ingrédients. Innombrables sont les chefs qui se sont efforcés de parcourir la nature pour obtenir des denrées rares...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000109
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 715000109,
					"content": "Ma machine s'en charge pour nous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000110
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 715000110,
					"content": "Il suffit de la démarrer pour qu'elle recherche automatiquement tous les ingrédients adaptés dans les environs. Ensuite, elle isole leur odeur, et il suffit de la suivre pour nous mener à eux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000111
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 715000111,
					"content": "La machine ne peut pas aller ramasser les ingrédients elle-même ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715000112
					]
				},
				{
					"id": 715000112,
					"content": "Hum, je n'en suis qu'aux prémices du développement, il me faut encore résoudre la question de la façon dont un cuiseur pourrait se déplacer dans ces montagnes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000113
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 715000113,
					"content": "Deuxièmement, il faut cuisiner. J'ai donc placé de nombreux mécanismes à l'intérieur de la machine prévus à cet effet. Il n'y a qu'à mettre les ingrédients, et la machine s'occupe de tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000114
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 715000114,
					"content": "La machine sait quoi faire avec les ingrédients ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715000115
					]
				},
				{
					"id": 715000115,
					"content": "Hum... Elle se réfère à la recette adéquate pour déterminer comment procéder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000116
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 715000116,
					"content": "C'est compliqué de t'expliquer en détail le fonctionnement de ces mécanismes en peu de temps. L'important, c'est que tu saches que j'y ai consacré beaucoup de travail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000117
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 715000117,
					"content": "Outre cela, j'ai aussi pensé à mettre en place une fonctionnalité pour effectuer une tâche des plus fastidieuses pour un chef : le nettoyage des ustensiles de cuisine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000118
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 715000118,
					"content": "L'ambiance d'un merveilleux festin en prendrait un coup s'il fallait nettoyer les restes du repas au fond de la marmite après...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000119,
						715000122
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 715000119,
					"content": "Combien vendez-vous ce cuiseur suprême ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715000120
					]
				},
				{
					"id": 715000120,
					"content": "Hahaha, je ne pense pas que tu aurais les moyens de te l'offrir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000121
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 715000121,
					"content": "De plus, seuls les Adeptes peuvent se servir de ce cuiseur pour l'instant. Admettons que je te le vende, tu ne pourrais rien en faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000125
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 715000125,
					"content": "Bien, assez bavardé. Pendant la création de cette machine, j'ai également étudié un bon nombre de recettes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000126
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 715000126,
					"content": "J'en ai élaboré quelques-unes aussi pour tester les fonctionnalités du cuiseur suprême, maintenant qu'il est opérationnel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000127
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 715000127,
					"content": "#Je t'ai {M#invité}{F#invitée} ici pour te demander de m'aider à recueillir des ingrédients et de suivre mes recettes pour préparer des plats.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000128
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 715000128,
					"content": "Le premier plat s'appelle le « tofu oncidium ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000129
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 715000129,
					"content": "Il faut que le tofu soit finement émincé... Parfait pour mettre les capacités de coupe du cuiseur suprême à l'épreuve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000130
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 715000130,
					"content": "En ce qui concerne les ingrédients... J'ai besoin de tofu, de jambon, de pousses de bambou et de la volaille. Ganyu les a préparés à ma demande, ils devraient être...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000131
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 715000131,
					"content": "... Quoi ? Où sont passées les pousses de bambou ? Je suis persuadée de les avoir posées là. Qui a osé me les dérober pendant que j'étais occupée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000132
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 715000132,
					"content": "Hmpf, tant pis. Au moins, je peux profiter de cette occasion pour te faire une démonstration de la fonctionnalité de recherche d'ingrédients du cuiseur suprême.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000133
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 715000133,
					"content": "Cuiseur suprême... Activation !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000134
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 715000134,
					"content": "#{M#Voyageur}{F#Voyageuse}, la machine est désormais activée. Suis l'odeur et récupère mes pousses de bambou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 715000122,
					"content": "Pourquoi avez-vous fabriqué ce cuiseur ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715000123
					]
				},
				{
					"id": 715000123,
					"content": "Pourquoi ? Pour explorer l'art des mécanismes et de l'ingénierie, bien sûr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000124
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 715000124,
					"content": "Puis, ce cuiseur me facilitera la tâche quand je voudrai manger à l'avenir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000125
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 715000105,
					"content": "Qu'est-ce qu'il peut faire ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715000106
					]
				},
				{
					"id": 715000106,
					"content": "#Hmpf, tu es bien {M#pressé}{F#pressée}. Attends, je vais t'expliquer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000107
					],
					"speakerTitle": "Souffle-Nuages"
				}
			]
		},
		{
