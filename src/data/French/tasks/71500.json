		},
		{
			"id": 7150003,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7150005",
							"2"
						],
						"stepId": 7150005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Souffle-Nuages"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715000303,
					"content": "Tu peux laisser le cuiseur faire. Cependant, c'est à toi de contrôler la température de cuisson.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000304
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 715000304,
					"content": "Le cuiseur n'est pas capable de le faire ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715000305
					]
				},
				{
					"id": 715000305,
					"content": "Hum, on ne peut pas dire que je n'ai pas essayé. Je voulais mettre en place un réchaud interne pour contrôler la température de cuisson de façon autonome...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000306
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 715000306,
					"content": "Mais la flamme du cuiseur suprême est loin d'être ordinaire. Elle ne marche qu'avec du feu d'Adepte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000307
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 715000307,
					"content": "Cependant, le feu d'Adepte est si puissant qu'il pourrait déformer les composants s'il venait à être directement allumé à l'intérieur de la machine. Ce n'est pas judicieux de prendre le risque d'endommager la machine pour remédier à un problème moindre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000308
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 715000308,
					"content": "La meilleure solution est donc d'allumer un feu d'Adepte à l'extérieur pour la cuisson et de le faire surveiller par quelqu'un...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000309
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 715000309,
					"content": "#Cette tâche te revient, {M#voyageur}{F#voyageuse}. Préviens-moi dès tu es {M#prêt}{F#prête}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Souffle-Nuages"
				}
			]
		},
		{
			"id": 7150004,
			"completionStepIds": [
				7150007
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7150007",
							"2"
						],
						"stepId": 7150007,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Souffle-Nuages"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715000401,
					"content": "Le contrôle de la cuisson n'est pas tout à fait réussi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000402
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 715000402,
					"content": "Ce n'est pas grave. Il reste des ingrédients, tu peux recommencer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Souffle-Nuages"
				}
			]
