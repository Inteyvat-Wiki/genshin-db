				]
			},
			"dialogs": [
				{
					"id": 761150301,
					"content": "Comme prévu, un homme pathétique qui ne peut s'empêcher de répéter ses erreurs. Honnêtement, je suis déçue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150302
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150302,
					"content": "Il avait réussi à bien se tenir pendant de nombreuses années, mais à la fin... Ça veut dire que les méchants resteront toujours des méchants ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150303,
						761150304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761150303,
					"content": "C'est plus difficile de faire le bien que le mal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761150305
					]
				},
				{
					"id": 761150305,
					"content": "Hark est responsable de ses choix. Il aurait pu se repentir et admettre ses erreurs, mais il a choisi la violence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150306
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150306,
					"content": "Il n'a pas arrêté de se tromper, et tous ces mauvais choix l'ont mené à cette fin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150307
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150307,
					"content": "#Assez parlé de lui. Beau travail, {NICKNAME}. Vous pouvez apporter la preuve de la prime à Leszek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150308
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150308,
					"content": "#Je suis soulagée que vous étiez dans le coin, patronne et {NICKNAME} ! C'était comme si j'étais en vacances !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150309
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761150309,
					"content": "Maintenant que cette mission est terminée, c'est l'heure de penser à la prochaine, Jahoda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150310
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150310,
					"content": "Quoi ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761150304,
					"content": "Il a pris de mauvaises décisions.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761150305
					]
				}
			]
		}
	]
}