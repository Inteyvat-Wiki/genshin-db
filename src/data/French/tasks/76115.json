						],
						"pointId": 14157
					}
				]
			},
			"dialogs": [
				{
					"id": 761150201,
					"content": "... Je ne vous ai rien fait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150202
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761150202,
					"content": "Vous avez l'air de savoir la raison de notre venue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150203
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150203,
					"content": "... C'est du passé. Tout ce que je veux, c'est vivre tranquille maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150204
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761150204,
					"content": "En usurpant l'identité de quelqu'un d'autre ? D'abord, c'était Juhani, mais ça n'a pas marché, puis Derwent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150205
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150205,
					"content": "Votre mauvais jeu d'acteur ne dupera pas le public plus longtemps. Il n'y aura plus de victimes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150206
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150206,
					"content": "... Juhani ? Vous êtes en train de dire que je voulais prendre sa place ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150207
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761150207,
					"content": "Ça n'a jamais été la sienne ! Il a tout obtenu parce qu'il était plus beau et plus éloquent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150208
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761150208,
					"content": "On était pareils ! Tout ce qu'il a pris m'appartenait !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150209
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761150209,
					"content": "Qu'est-ce que monsieur Derwent et le marchand vous ont fait ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150210
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761150210,
					"content": "Ils... Ils ont posé des questions qu'il ne fallait pas poser. Comme vous, alors...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150211
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761150211,
					"content": "Mourrez !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Derwent"
				}
			]
		},
