			"dialogs": [
				{
					"id": 761150101,
					"content": "Hein ? Nefer et Jahoda ! Que faites-vous ici toutes les deux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761150102,
					"content": "On travaille évidemment ! On vient de trouver une piste pour une prime non accomplie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150103
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761150103,
					"content": "Jahoda vous parle de la cible de la prime, Hark la « Mâchoire fendue », et des informations que le Curatorium des secrets a réussi à obtenir...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761150104
					]
				},
				{
					"id": 761150104,
					"content": "Commençons par notre conclusion : Derwent, le véritable ermite, est probablement mort, et l'homme qui vit dans sa cabane est la cible de la prime, Hark la « Mâchoire fendue ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150105
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150105,
					"content": "Les morceaux de journal que Jahoda a récupérés montrent que Derwent était au courant de l'identité de Hark, mais qu'il l'a quand même accueilli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150106
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150106,
					"content": "Sans surprise, Hark a repris sa vie de crime. Après avoir liquidé Derwent, il a usurpé son identité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150107
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150107,
					"content": "Lors de mon enquête, il n'a pas voulu me montrer son visage. Enfin, quoi qu'il en soit, cet homme n'était pas le véritable Derwent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150108
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761150108,
					"content": "En se faisant passer pour un ermite, Hark peut se livrer à des activités suspectes sans éveiller le moindre soupçon. Le masque qu'il porte n'a aucun rapport avec son « entraînement ». C'est juste pour cacher sa cicatrice !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150109
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761150109,
					"content": "Pour ce qui est du marchand disparu... Si on envisage le pire, il est probablement déjà mort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150110
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150110,
					"content": "Comment peut-on être aussi mauvais ?! Hark a tué l'ermite, alors qu'il a été sympa avec lui... Ça me met hors de moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761150111,
					"content": "Je ne pense pas que Hark ait volé la marchandise du Cercle ambulant. Il n'y a pas de mobile assez solide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150112
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150112,
					"content": "Il s'est bien comporté pendant dix ans. La disparition de quelques objets aurait-elle vraiment été suffisante pour envoyer tous ses efforts en l'air ? Je ne crois pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150113
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150113,
					"content": "Émettons quelques hypothèses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150114
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150114,
					"content": "On sait qu'il est revenu sur l'épave de l'Atlas et qu'il a attaqué les chasseurs de trésors qui se sont rendus là-bas. Lorsque les gens sont au pied du mur, ils reprennent souvent leurs instincts premiers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150115
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150115,
					"content": "Quand il était encore le timonier de l'Atlas, Hark était riche et célèbre. Il avait tout ce qu'il voulait, mais que s'est-il passé quand il a rejoint le Cercle ambulant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150116
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150116,
					"content": "Malgré dix ans de bonne conduite, les gens ont commencé à le soupçonner directement après le vol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150117
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150117,
					"content": "Et le pire ? Juhani qui était aussi un pirate autrefois, et de moindre renommée, n'était même pas inquiété.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150118
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150118,
					"content": "Il a accusé Juhani, mais personne ne l'a cru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150119
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150119,
					"content": "La déception et la colère l'ont poussé à commettre sa première erreur. Cet incident a marqué un tournant pour la suite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150120
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150120,
					"content": "Les événements dans la cabane de l'ermite ont dû être similaires... Pour ce genre d'individu, le plus insignifiant des conflits peut se transformer en confrontation mortelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150121
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150121,
					"content": "#{NICKNAME}, on ne peut pas laisser un type aussi dangereux en liberté !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150122,
						761150123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761150122,
					"content": "Je m'occupe de ce criminel !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761150124
					]
				},
				{
					"id": 761150124,
					"content": "#Comme {NICKNAME} s'est {M#porté}{F#portée} volontaire pour la suite, tu devrais aller te reposer, Jahoda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150125
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150125,
					"content": "J'ai travaillé dur pendant l'enquête, alors c'est bien mérité !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150126
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761150126,
					"content": "Et on saura bientôt si mes hypothèses sont correctes ou non.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150123,
					"content": "Prime ou pas, je m'en occupe !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761150124
					]
				}
			]
		},
