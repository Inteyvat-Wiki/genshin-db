	"talks": [
		{
			"id": 1100901,
			"completionStepIds": [
				1100901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
