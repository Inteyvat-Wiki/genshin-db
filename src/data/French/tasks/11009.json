			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ningguang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110090101,
					"content": "Je vous ai rassemblés ici aujourd'hui pour vous annoncer une nouvelle très importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090102
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090102,
					"content": "Certains d'entre vous ont peut-être déjà entendu des rumeurs à ce sujet, et je vous le confirme : j'ai bien l'intention de reconstruire la Chambre de Jade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090103
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090103,
					"content": "La reconstruire ? Ce ne sera pas aisé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090104
					],
					"speakerTitle": "Hongfei"
				},
				{
					"id": 110090104,
					"content": "Les rumeurs étaient vraies en fin de compte. Pas étonnant que le prix des matériaux de construction ait explosé récemment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090105
					],
					"speakerTitle": "Changgui"
				},
				{
					"id": 110090105,
					"content": "La Chambre de Jade représente beaucoup pour dame Ningguang. Si nous prenions part à sa reconstruction...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090106
					],
					"speakerTitle": "Zhicheng"
				},
				{
					"id": 110090106,
					"content": "Dame Ningguang, que pouvons-nous faire pour vous aider ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090107
					],
					"speakerTitle": "Hongfei"
				},
				{
					"id": 110090107,
					"content": "Nul besoin de se précipiter. Depuis que la nouvelle s'est répandue, de très nombreuses personnes m'ont contactée ces derniers jours pour demander à faire partie du chantier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090108
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090108,
					"content": "Néanmoins, il y a une affaire que j'aimerais vous confier à tous ici présents.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090109
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090109,
					"content": "À l'heure actuelle, nous avons décidé de l'emplacement du chantier et préparé toutes sortes de matériaux pour la construction. Cependant, il nous en manque trois des plus indispensables.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090110
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090110,
					"content": "Il s'agit d'une plaustrite crépusculaire, d'un noyau des merveilles et d'un blason des Adeptes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090111
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090111,
					"content": "Hum... Veuillez pardonner mon ignorance, mais à part la plaustrite, je n'ai jamais entendu parler des deux derniers matériaux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090112
					],
					"speakerTitle": "Changgui"
				},
				{
					"id": 110090112,
					"content": "Seules les plaustrites qui atteignent une certaine taille peuvent être qualifiées de « crépusculaires ». Elles sont essentielles pour nous assurer que la Chambre de Jade puisse flotter dans les airs. Le noyau des merveilles sera le cœur de toute la structure mécanique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090113
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090113,
					"content": "Enfin, le blason des Adeptes permettra d'infuser la magie des Adeptes à tous les mécanismes. Il est tout aussi indispensable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090114
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090114,
					"content": "Bien que ces trois matériaux soient rares, ce n'est qu'une question de temps avant que vous puissiez mettre la main dessus grâce à votre réseau et vos capacités.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090115
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090115,
					"content": "La vitesse et l'efficacité seront les maîtres-mots. Je vous achèterai tous les matériaux que vous trouverez à bon prix. De plus, les trois premiers qui m'apporteront tous les matériaux auront le privilège de me poser une question.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090116
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090116,
					"content": "J'y répondrai, quelle qu'elle soit. Cette récompense ne vous décevra pas, j'en suis certaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090117
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090117,
					"content": "Ces matériaux sont difficiles à trouver, mais imaginez pouvoir demander quels sont les projets pour le Port de Liyue l'année prochaine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090118
					],
					"speakerTitle": "Changgui"
				},
				{
					"id": 110090118,
					"content": "C'est une véritable aubaine. Ceux qui détiendront l'information pourront l'exploiter à leur avantage...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090119
					],
					"speakerTitle": "Zhicheng"
				},
				{
					"id": 110090119,
					"content": "Haha, quelle coïncidence ! J'ai récemment entendu ces bruits courir sur de la plaustrite. Eh bien, pardonnez-moi les amis, mais j'y vais !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090120
					],
					"speakerTitle": "Hongfei"
				},
				{
					"id": 110090120,
					"content": "Zut... Dépêchons-nous aussi, personne ne doit mettre la main sur ces matériaux avant nous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090121
					],
					"speakerTitle": "Changgui"
				},
				{
					"id": 110090121,
					"content": "La reconstruction de la Chambre de Jade est une affaire importante. Voyons ce qu'on peut trouver, nous aussi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090122,
					"content": "Vous m'avez bien entendue, n'est-ce pas ? Alors ? Cela vous intéresse-t-il de participer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090123
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090123,
					"content": "Je pourrai vraiment vous demander ce que je veux ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090124
					]
				},
				{
					"id": 110090124,
					"content": "Je répondrai à n'importe quelle question du moment que j'en connais la réponse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090125
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090125,
					"content": "#(Peut-être que je pourrais poser des questions sur {M#ma sœur}{F#mon frère}...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090126
					]
				},
				{
					"id": 110090126,
					"content": "Pour de vrai ? Moi, je veux savoir comment vous faites pour commercer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090127,
					"content": "#De cette façon, on deviendra richissimes, {M#le voyageur}{F#la voyageuse} et moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090128,
					"content": "Haha, bien sûr. Mais la quantité d'informations divulguées dépendra de votre performance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090129
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090129,
					"content": "La reconstruction de la Chambre de Jade nécessite une grande surface pour le chantier. J'ai donc fait en sorte qu'il soit situé dans la mine abandonnée à l'extérieur de la Chambre d'Or. Tous les matériaux doivent y être apportés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090130
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090130,
					"content": "D'autres affaires importantes m'attendent, alors je ne peux pas vous tenir compagnie plus longtemps. Vous n'aurez qu'à contacter ma secrétaire lorsque vous y serez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090131
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090131,
					"content": "N'oubliez pas que le temps vous est compté. C'est une occasion en or, alors ne la laissez pas vous échapper.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090132
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090132,
					"content": "Ningguang a vraiment un emploi du temps de ministre... Dépêchons-nous de partir à la recherche de ces matériaux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090133,
					"content": "#Commençons par quitter la Terrasse Yujing pour... Hé ? {NICKNAME}, regarde là-bas. On dirait que quelque chose de louche est en train de se passer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090134,
					"content": "Ma p'tite dame, vous m'avez l'air bien élégante et distinguée. Je suis certain que vous gagnerez cette course aux matériaux pour la Chambre de Jade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090135
					],
					"speakerTitle": "Liu la balafre"
				},
				{
					"id": 110090135,
					"content": "Nous avons des informations à propos des matériaux. Venez, trouvons un endroit plus calme pour discuter...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090136
					],
					"speakerTitle": "Liu la balafre"
				},
				{
					"id": 110090136,
					"content": "Ce ne sera pas nécessaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090137
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090137,
					"content": "Ne soyez pas timide. Hé, ne partez pas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090138
					],
					"speakerTitle": "Liu la balafre"
				},
				{
					"id": 110090138,
					"content": "Ne reste pas planté là, rattrapons-la !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090139
					],
					"speakerTitle": "Liu la balafre"
				},
				{
					"id": 110090139,
					"content": "O—Oui, chef !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chiang"
				}
			]
		},
		{
			"id": 1100902,
			"completionStepIds": [
				1100902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1100902",
							"2"
						],
						"stepId": 1100902,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shenhe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110090201,
					"content": "Vous n'avez nulle part où vous enfuir maintenant, ma p'tite dame.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090202
					],
					"speakerTitle": "Liu la balafre"
				},
				{
					"id": 110090202,
					"content": "Ne vous en faites pas, nous ne sommes pas méchants. Donnez-nous un peu de moras en échange de nos précieux renseignements et tout le monde repartira gagnant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090203
					],
					"speakerTitle": "Liu la balafre"
				},
				{
					"id": 110090203,
					"content": "Chef, je ne la sens pas cette affaire. Son attitude me dit qu'elle n'a pas l'air d'être n'importe qui et ses cheveux blancs sortent aussi de l'ordinaire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090204
					],
					"speakerTitle": "Chiang"
				},
				{
					"id": 110090204,
					"content": "Et alors ? On ne trouve pas des gens comme elle à tous les coins de rue, comment on fait pour rembourser nos dettes de jeu si on ne saisit pas cette occasion ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090205
					],
					"speakerTitle": "Liu la balafre"
				},
				{
					"id": 110090205,
					"content": "Je vous ai déjà dit que je n'ai pas besoin de vos informations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090206
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090206,
					"content": "Je vous le répète une dernière fois au cas où vous n'auriez pas entendu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090207
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090207,
					"content": "*soupir* Je ne devrais pas avoir besoin d'expliquer ça à une personne qui a l'air aussi intelligente que vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090208
					],
					"speakerTitle": "Liu la balafre"
				},
				{
					"id": 110090208,
					"content": "Peu importe si vous en avez besoin ou non, vous allez juste gentiment me donner votre argent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090209
					],
					"speakerTitle": "Liu la balafre"
				},
				{
					"id": 110090209,
					"content": "Je...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090210
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090210,
					"content": "N'essayez pas de m'embobiner ! Vous êtes pleine aux as, ça se voit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090211
					],
					"speakerTitle": "Liu la balafre"
				},
				{
					"id": 110090211,
					"content": "Vous avez commandé une table pleine de plats au Pavillon Liuli, mais n'en avez mangé qu'une bouchée de chaque avant de partir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090212
					],
					"speakerTitle": "Liu la balafre"
				},
				{
					"id": 110090212,
					"content": "Ensuite, vous avez fait pareil avec les spécialités du Pavillon Xinyue et du Restaurant Wanmin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090213
					],
					"speakerTitle": "Liu la balafre"
				},
				{
					"id": 110090213,
					"content": "Comment auriez-vous pu vous permettre ce luxe si vous n'étiez pas la fille d'une famille riche ? Et comme vous êtes si riche, ça ne vous embêterait pas de nous donner un peu d'argent, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090214
					],
					"speakerTitle": "Liu la balafre"
				},
				{
					"id": 110090214,
					"content": "Le maître m'a ordonné de ne pas en venir aux mains au Port de Liyue, mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090215
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090215,
					"content": "Tant pis. C'est le destin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090216
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090216,
					"content": "Chef, je ne la sens vraiment pas cette affaire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090217
					],
					"speakerTitle": "Chiang"
				},
				{
					"id": 110090217,
					"content": "Pas besoin d'avoir peur ! On ne fait rien d'illégal en vendant des informations. Si elle nous attaque, elle paiera le prix fort si on la poursuit en justice !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090218,
						110090219
					],
					"speakerTitle": "Liu la balafre"
				},
				{
					"id": 110090218,
					"content": "Ils sont là.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090220
					]
				},
				{
					"id": 110090220,
					"content": "Oh ? C'est encore vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090221
					],
					"speakerTitle": "Zheng"
				},
				{
					"id": 110090221,
					"content": "Les Millelithes ? Qu'est-ce qu'ils font là... C'est à cause de vous ? Hmph. Espèce de fouine, je vais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090222
					],
					"speakerTitle": "Liu la balafre"
				},
				{
					"id": 110090222,
					"content": "Taisez-vous ! Vous osez menacer quelqu'un en plus ? Suivez-nous, et que ça saute !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090223
					],
					"speakerTitle": "Zheng"
				},
				{
					"id": 110090223,
					"content": "Haha... Ne vous énervez pas, cher monsieur. Je peux tout vous expliquer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090224
					],
					"speakerTitle": "Liu la balafre"
				},
				{
					"id": 110090224,
					"content": "Les bandits qui encerclaient la jeune femme aux cheveux blancs ont été emmenés par les Millelithes.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						110090225
					]
				},
				{
					"id": 110090225,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090226,
						110090227
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090226,
					"content": "Vous allez bien ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090228
					]
				},
				{
					"id": 110090228,
					"content": "... Shenhe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090229
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090229,
					"content": "Shenhe ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090230,
					"content": "C'est comme ça que je m'appelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090231
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090231,
					"content": "#Oh, c'est votre prénom ! Moi, je m'appelle Paimon et voici {NICKNAME} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090232,
					"content": "J'ai déjà entendu parler de vous. Merci de m'avoir aidée à dénouer cette situation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090233
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090233,
					"content": "J'aurais pu m'en sortir sans aide, cependant. Il aurait fallu que je mette trois coups dans son crâne pour qu'il tombe à terre et admette sa défaite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090234
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090234,
					"content": "Ouah ! Ce n'est pas nécessaire d'utiliser autant de violence !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090235,
					"content": "Nous sommes au Port de Liyue ici, il y a des lois !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090236,
					"content": "Des lois ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090237
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090237,
					"content": "Vous ne savez pas ce que c'est ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090238
					]
				},
				{
					"id": 110090238,
					"content": "Non, pas du tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090239
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090239,
					"content": "Pour de vrai ? Mais tout à l'heure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090241,
					"content": "J'entends un bruit...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090242
					]
				},
				{
					"id": 110090242,
					"content": "C'est mon estomac qui gargouille. Je n'ai pas assez mangé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090243
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090243,
					"content": "Ce n'est pas moi qui pourrais admettre ça d'une manière aussi franche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090244,
					"content": "D'ailleurs, les hommes de tout à l'heure disaient que vous n'aviez mangé qu'une seule bouchée de chaque plat que vous aviez commandé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090245,
					"content": "Pas moyen d'être rassasiée avec ça ! Qu'est-ce qui vous ferait envie ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090246
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090246,
					"content": "D'habitude, je mange des fleurs de Qingxin, des lys vernis ou du muguet bleu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090247
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090247,
					"content": "Ce sont toutes des plantes médicinales...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090248
					]
				},
				{
					"id": 110090248,
					"content": "Des plantes médicinales ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090249
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090249,
					"content": "Hum, je crois que Shenhe n'a pas l'air de comprendre... Le Cottage Bubu n'est pas très loin, emmenons-la là-bas pour qu'elle puisse manger à sa faim !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090250
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090250,
					"content": "Il n'y a qu'avec l'estomac rempli qu'on trouve la force de travailler !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090227,
					"content": "Ne vous en faites plus, tout va bien maintenant.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090228
					]
				},
				{
					"id": 110090219,
					"content": "On dirait que ces gens sont en train de la forcer à acheter.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090220
					]
				}
			]
		},
		{
			"id": 1100903,
			"completionStepIds": [
				1100903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1100903",
							"2"
						],
						"stepId": 1100903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gui l'herboriste"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110090301,
					"content": "Bonjour, c'est pour acheter des herbes médicinales ? Avez-vous apporté l'ordonnance ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090302
					],
					"speakerTitle": "Gui l'herboriste"
				},
				{
					"id": 110090302,
					"content": "Il me faudrait des fleurs de Qingxin, des lys vernis et du muguet bleu, 250 grammes de chaque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090303
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090303,
					"content": "Ce n'est pas le contenu d'une ordonnance, si ? On dirait plutôt une commande de repas... Et voici, c'est tout ce qu'on a en stock.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090304
					],
					"speakerTitle": "Gui l'herboriste"
				},
				{
					"id": 110090304,
					"content": "Merci beaucoup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090305
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090305,
					"content": "Vous les mangez pour de vrai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090306,
					"content": "Sous les yeux étonnés de tous, Shenhe mange toutes les herbes médicinales.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						110090307
					]
				},
				{
					"id": 110090307,
					"content": "Je suis repue, merci beaucoup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090308,
						110090309
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090308,
					"content": "Quel goût ont ces plantes ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090310
					]
				},
				{
					"id": 110090310,
					"content": "C'était mauvais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090311
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090311,
					"content": "Ces plantes dégagent un parfum agréable, mais une fois qu'on les mange, elles ont un goût amer, acide et âpre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090312
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090312,
					"content": "Dans ce cas, pourquoi avez-vous préféré les manger à la place des bons petits plats des restaurants ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090313,
					"content": "Si j'avais beaucoup d'argent, je commanderais plein de plats dans les meilleurs restaurants et je les finirais tous d'une traite !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090314,
					"content": "Je ne sais pas si je vais rester ici à l'avenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090315
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090315,
					"content": "La nourriture humaine est délicieuse, mais si je retourne dans les montagnes, l'envie d'en manger deviendrait un obstacle à mon entraînement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090316
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090316,
					"content": "Alors je ne prends qu'une bouchée pour voir brièvement quel goût elle a.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090317
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090317,
					"content": "#Retourner dans les montagnes ? {NICKNAME}, j'en suis sûre maintenant, c'est vraiment une Adepte !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090318,
					"content": "Assez parlé de moi pour l'instant. Qu'aviez-vous l'intention de faire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090319
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090319,
					"content": "Ah, j'avais presque oublié ! On est ici pour participer à la course aux matériaux pour la reconstruction de la Chambre de Jade !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090320,
					"content": "Nous avons laissé filer beaucoup de temps, impossible de la remporter...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090321,
					"content": "Je vois. Je crois avoir entendu parler de cet événement tout à l'heure quand je me promenais dans la rue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090322
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090322,
					"content": "Héhé... Les gagnants peuvent demander tout ce qu'ils veulent à Ningguang !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090323,
					"content": "Vous êtes aussi là pour ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090324,
					"content": "En effet, je suis venue pour la reconstruction de la Chambre de Jade, mais pas du tout pour cette compétition.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090325
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090325,
					"content": "Je vais vous donner un coup de main pour vous remercier de votre aide. Ne vous inquiétez pas, je n'exige rien en retour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090326
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090326,
					"content": "Oh, mais on ne peut pas accepter ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090327,
					"content": "Ceci dit, avoir l'aide d'une Adepte nous faciliterait beaucoup de choses...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090328,
						110090329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090328,
					"content": "Eh bien, mettons-nous en route.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090330
					]
				},
				{
					"id": 110090330,
					"content": "Ne perdons pas de temps, j'ai un plan pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090331
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090331,
					"content": "Super ! Votre plan est certainement génial !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090332,
					"content": "Je ne sais pas s'il sera « génial », mais il sera efficace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090333
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090333,
					"content": "#Il suffit de se débarrasser des concurrents qui sont devant nous dans le classement pour devenir les {M#premiers}{F#premières}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090334
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090334,
					"content": "... On ne peut pas faire ça ! Absolument pas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090335
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090335,
					"content": "Ah bon ? Mais je pensais qu'on était censé mettre des bâtons dans les roues des autres et les dépasser...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090336
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090336,
					"content": "On veut gagner de façon équitable, nous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090337
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090337,
					"content": "Une plaustrite crépusculaire, un noyau des merveilles et un blason des Adeptes... Essayons de les trouver dans cet ordre. On commence donc par la plaustrite crépusculaire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090338
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090338,
					"content": "Je me disais bien que j'entendais depuis l'extérieur des voix se disputer, c'était donc vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090339
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 110090339,
					"content": "Baizhu ? Que faites-vous ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090340
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090340,
					"content": "Dame Ningguang m'a commandé tout un lot de remèdes qui guérit les blessures, mais je n'ai plus assez d'ingrédients en stock à la pharmacie. C'est pour cette raison que je suis venu personnellement les réaliser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090341
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 110090341,
					"content": "Hé, mais que va faire Ningguang avec tous ces remèdes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090342
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090342,
					"content": "Je l'ignore aussi, mais j'ai entendu dire qu'elle voulait reconstruire la Chambre de Jade ? C'est peut-être pour les travailleurs du chantier. Enfin, c'est la vie privée de mes clients, il serait mal venu de ma part de poser ce genre de questions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090343
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 110090343,
					"content": "Elle m'a même emprunté Qiqi. Comme le Cottage Bubu est en sous-effectif, auriez-vous un moment pour m'aider un peu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090344
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 110090344,
					"content": "On ne peut pas. On a d'autres choses à faire... D'ailleurs, vous qui en connaissez un rayon, avez-vous déjà entendu parler de « plaustrite crépusculaire » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090345
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090345,
					"content": "Vous parlez de celle qui sert à faire flotter la Chambre de Jade ? Je me souviens qu'elle est mentionnée dans le « Traité des sept montagnes ». Il est dit qu'elle peut s'envoler dans le ciel après activation, ce qui est rare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090346
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 110090346,
					"content": "D'après les écrits, toutes les plaustrites crépusculaires ont déjà été extraites et appropriées par quelqu'un. Cependant, je pense la Guilde des marchands de Feiyun saura mieux vous renseigner à leur sujet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090347
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 110090347,
					"content": "Je vois ! Allons demander à la Guilde des marchands de Feiyun !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090348
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090348,
					"content": "Merci beaucoup, Baizhu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090349
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090349,
					"content": "Je vous en prie. J'espère que vous réussirez à en trouver. N'hésitez pas à venir me voir au Cottage Bubu si vous avez besoin de mon aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 110090329,
					"content": "Votre aide est la bienvenue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090330
					]
				},
				{
					"id": 110090309,
					"content": "C'était bon ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090310
					]
				}
			]
		},
