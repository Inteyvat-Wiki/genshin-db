			"dialogs": [
				{
					"id": 220230201,
					"content": "Vous revoilà déjà ? Vous n'êtes pas un chef qui cache son identité, par hasard ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230202
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230202,
					"content": "Hmm... J'ai hâte ! Laissez-moi goûter, s'il vous plaît !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230203,
						220230204
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230203,
					"content": "Bon appétit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220230204,
					"content": "Voyons voir... de quels plats a-t-on parlé ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220230205
					]
				},
				{
					"id": 220230205,
					"content": "Hum... De la viande-mora, de la cocotte de porc fumé et du goulasch !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220230206,
					"content": "Décidons lequel cuisiner et donnons-le à Tang Wen !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
