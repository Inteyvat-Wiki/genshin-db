			"dialogs": [
				{
					"id": 732181601,
					"content": "Recrutement permanent de travailleurs pour l'entretien du Mur de Samiel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181602
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732181602,
					"content": "Nous offrons un salaire décent, repas et logis compris.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181603
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732181603,
					"content": "Les employés exceptionnels seront recommandés par moi-même pour recevoir une formation supérieure à l'Académie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
