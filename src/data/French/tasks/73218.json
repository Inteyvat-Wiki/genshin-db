					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180801,
					"content": "Les chercheurs qui séjournent à la Caravane Ribat pour une longue durée doivent informer les mahamatas avant de loger à l'auberge afin d'éviter des fuites de connaissances et d'autres imprévus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
		{
			"id": 7321809,
			"completionStepIds": [
				7321809
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321809",
							"2"
						],
						"stepId": 7321809,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180901,
					"content": "Les marchands et les voyageurs doivent s'enregistrer auprès des mahamatas pour obtenir l'autorisation d'entrer à l'intérieur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180902
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732180902,
					"content": "Toutes les marchandises non enregistrées ou de contrebande seront confisquées. Le personnel impliqué sera expulsé dans le désert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180903
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732180903,
					"content": "En outre, les habitants du Village d'Aaru peuvent franchir la frontière directement avec le certificat d'autorisation délivré par l'Académie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
		{
