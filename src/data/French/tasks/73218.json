			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180101,
					"content": "La Caravane Ribat est un point d'entrée important de Sumeru. Ce panneau d'affichage a donc pour visée d'informer les marchands et les voyageurs des affaires importantes de la région. Veuillez prêter attention aux annonces affichées ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
		{
			"id": 7321802,
			"completionStepIds": [
				7321802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321802",
							"2"
						],
						"stepId": 7321802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180201,
					"content": "« Mon amour, bien que tu sois si loin de moi, mon cœur t'appartient pour toujours. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180202
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732180202,
					"content": "« Je sais. Tu as des choses plus importantes à faire. Après tout, plus on est haut placé, plus on a de responsabilités. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180203
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732180203,
					"content": "« Hélas, je ne peux partager mon tracas avec les autres, ni leur faire entendre ton nom. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180204
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732180204,
					"content": "« J'espère qu'un jour je pourrai faire savoir à tout le monde à quel point tu es érudit et sage. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
		{
			"id": 7321803,
			"completionStepIds": [
				7321803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
