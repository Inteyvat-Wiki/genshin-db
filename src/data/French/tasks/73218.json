			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181001,
					"content": "« Pack service aventure dans le désert à vendre. Nous fournissons les meilleures solutions aux marchands et aux voyageurs pour leurs aventures dans le désert. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181002
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732181002,
					"content": "« Nous garantissons à tous ceux qui achètent notre pack de rentrer sains et saufs de leurs aventures. Nous nous engageons à payer dix fois le prix du pack en cas de contrefaçon. Commandez dès maintenant pour bénéficier d'une réduction ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
		{
			"id": 7321811,
			"completionStepIds": [
				7321811
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
