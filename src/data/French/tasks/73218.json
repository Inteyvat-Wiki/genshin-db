			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181301,
					"content": "Attention, les aventuriers qui souhaitent se rendre dans le Grand désert écarlate doivent s'enregistrer à l'Académie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181302
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732181302,
					"content": "Les reliques trouvées dans le désert appartiennent à l'Académie, et personne n'a le droit d'en prendre possession.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181303
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732181303,
					"content": "Pour des raisons de sécurité, l'Académie interdit à toute personne d'entrer dans les zones désertiques hormis celle du Grand désert écarlate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181304
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732181304,
					"content": "Si ces consignes ne sont pas respectées, l'Académie n'assumera aucune responsabilité en cas d'accident à l'intérieur de ces zones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
		{
