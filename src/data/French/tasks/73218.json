			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181101,
					"content": "« J'ai entendu dire que l'Académie avait mis sur pied un hôpital spécial dans le désert pour traiter l'éléazar, mais que celui-ci avait été abandonné pour des raisons inconnues... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181102
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732181102,
					"content": "« Les habitants du Village d'Aaru disent que des patients guéris de l'éléazar se sont évadés de là-bas. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181103
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732181103,
					"content": "« Si des données sont restées là-bas, peut-être pourrait-on trouver un remède à cette maladie... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
		{
			"id": 7321812,
			"completionStepIds": [
				7321812
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321812",
							"2"
						],
						"stepId": 7321812,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181201,
					"content": "« On dit que l'un des habitants du Village d'Aaru est devenu un haut fonctionnaire à l'Académie. Qui sait, peut-être que nous, les habitants du désert, on aura une vie meilleure à l'avenir grâce à ça. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181202
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732181202,
					"content": "« Je ne gagne pas beaucoup en transportant ces pierres ici. Si je pouvais transporter des concentrés de connaissances, je pourrais gagner assez en un seul voyage pour pouvoir me marier à mon retour au pays. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181203
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732181203,
					"content": "« Par contre, j'ai entendu dire que ce haut fonctionnaire avait pour responsabilité de lutter contre la contrebande. Je ne pense pas qu'il nous aidera. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181204
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732181204,
					"content": "« Hélas, c'est bien parce qu'on est incapable de s'unir que nous, les gens du désert, finissons de la sorte. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
		{
			"id": 7321813,
			"completionStepIds": [
				7321813
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321813",
