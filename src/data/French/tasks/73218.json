			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181501,
					"content": "« Les jeunes d'aujourd'hui ont des idées folles. S'il n'y avait pas eu la Molrani Rukkhadevata, nous, les habitants du Village d'Aaru, serions depuis longtemps des squelettes enterrés sous les ruines de ces temples. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181502
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732181502,
					"content": "« J'ai entendu quelqu'un dire que le roi Deshret allait revenir à la vie. Même la Molrani Rukkhadevata n'est pas revenue après toutes ces années, alors le roi Deshret, n'y pensons même pas ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181503
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732181503,
					"content": "« On ferait mieux de se mettre au travail maintenant. Transporter ces quelques provisions au Village d'Aaru chaque mois n'est pas suffisant pour gagner notre vie. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
