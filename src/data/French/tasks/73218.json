			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180301,
					"content": "Vers le Grand désert écarlate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180302
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732180302,
					"content": "Vous qui ne respectez pas la mort, arrêtez-vous ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
		{
			"id": 7321804,
			"completionStepIds": [
				7321804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321804",
							"2"
						],
						"stepId": 7321804,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180401,
					"content": "L'Académie interdit strictement toute dégradation du Mur de Samiel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180402
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732180402,
					"content": "Toute violation sera sévèrement punie une fois découverte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
		{
			"id": 7321805,
			"completionStepIds": [
				7321805
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321805",
							"2"
						],
						"stepId": 7321805,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180501,
					"content": "« Vente de fruits confits, d'ingrédients de desserts et d'autres spécialités du désert. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180502
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732180502,
					"content": "« Livraison possible pour les grosses commandes. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180503
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732180503,
					"content": "« Ça a l'air très bon, je pourrais faire des dango avec. Pouvez-vous m'en livrer à Inazuma ? »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180504
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732180504,
					"content": "« Désolé, mais les livraisons à l'international ne sont disponibles que pour Liyue. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
		{
			"id": 7321806,
			"completionStepIds": [
				7321806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321806",
							"2"
						],
						"stepId": 7321806,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180601,
					"content": "Le Périple doré est le seul hôtel au monde qui n'a pas besoin de publicité, car il est la seule auberge de la Caravane Ribat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180602
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732180602,
					"content": "Sachez tout de même que notre barbecue est délicieux, et qu'il représente les saveurs authentiques du désert. Bien plus authentique que ceux de la ville.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180603
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732180603,
					"content": "Voyageurs fatigués, venez vite y goûter !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
		{
			"id": 7321807,
			"completionStepIds": [
				7321807
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321807",
							"2"
						],
						"stepId": 7321807,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180701,
					"content": "« J'espère que les mahamatas réfléchiront à renforcer les douanes de la Caravane Ribat. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180702
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732180702,
					"content": "« Aujourd'hui, n'importe quel habitant du désert peut passer la frontière. Les bandits peuvent s'enfuir dans la jungle pour se cacher et de voler le travail des habitants de Sumeru. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180703
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732180703,
					"content": "« Même si l'Akasha n'est pas accessible aux habitants du désert, les mercenaires ne sont déjà plus les seuls à recevoir des missions de la Citadelle de Regzar. Si ça continue comme ça, même si on entre tous à l'Académie, certains se retrouveront sans emploi. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180704
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732180704,
					"content": "« Ne dites pas n'importe quoi. Les habitants du désert font eux aussi partie du peuple de la Molrani Rukkhadevata et ils sont des habitants de Sumeru. Il est normal qu'ils aient le droit d'entrer en ville. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180705
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732180705,
					"content": "« Faites attention à ce que vous dites ici. Il serait dommage de recevoir des coups à cause de ça. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
		{
			"id": 7321808,
			"completionStepIds": [
				7321808
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321808",
							"2"
						],
						"stepId": 7321808,
