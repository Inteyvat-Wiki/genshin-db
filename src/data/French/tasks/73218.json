			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181401,
					"content": "« On dit que certaines personnes ont gagné une fortune juste en vendant de la graisse de chrysalide de sable en ville. Aujourd'hui, ces personnes-là vivent dans des manoirs et se disent amies avec les gens de l'Académie. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181402
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732181402,
					"content": "« J'ai passé la moitié de ma vie à transporter des pierres ici, et je suis complètement sans le sou. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181403
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732181403,
					"content": "« Tu ne comprends rien. Le commerce de graisse de chrysalide de sable ne peut se faire qu'avec une autorisation spéciale de l'Académie. Ne rêve pas, tu n'y mettras même pas un doigt. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181404
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732181404,
					"content": "« Si tu veux faire fortune, viens faire de la contrebande de livres avec moi. Si ça marche, on sera plus obligés de faire du transport de pierres ici. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
		{
