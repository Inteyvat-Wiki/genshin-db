				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400741101,
					"content": "Tout le monde, venez par ici !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741102
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400741102,
					"content": "Êtes-vous tous bien réveillés ? Mona a quelque chose d'important à nous dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741103
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400741103,
					"content": "Le premier matin après mon retour de l'Empire de la nuit éternelle est vraiment agréable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741104
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400741104,
					"content": "Ce que mademoiselle veut dire, c'est qu'elle est prête pour la prochaine épreuve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741105
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400741105,
					"content": "Nous avons aussi bien dormi et bien mangé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400741106,
					"content": "Bon, je vais être directe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741107
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741107,
					"content": "Tout à l'heure, avec le disque d'eau, j'ai vu une nouvelle illusion qui s'est formée sur l'île là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741108
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741108,
					"content": "Et... Si mon intuition est correcte, elle devrait être en rapport avec moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741109
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741109,
					"content": "C'est donc à ton tour cette fois, Mona. Tu nous as accompagnés dans les illusions précédentes. À notre tour de visiter la tienne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741110
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400741110,
					"content": "Hum... Je suis sûre qu'il n'y a pas grand-chose à voir là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741111
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741111,
					"content": "Dame Megistus, êtes-vous embarrassée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741112
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400741112,
					"content": "Non, pas du tout, hahaha ! Je n'ai pas du tout peur que vous me voyiez différemment après avoir visité mon illusion minable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741113
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741113,
					"content": "J'avancerais plutôt le contraire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741114
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400741114,
					"content": "Disons que... Tout le monde pense que les astromanciens sont extraordinaires, pas vrai ? J'ai bien peur que mon illusion ne soit pas à la hauteur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741115
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741115,
					"content": "Je n'ai point d'attentes aussi stupides.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741116
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400741116,
					"content": "Moi non plus. Ça ne veut pas dire que je n'attends rien de toi, Mona. Je pense juste que tu es une fille très sympa qui n'a pas besoin de faire semblant avec nous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741117
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400741117,
					"content": "La gentillesse d'une personne doit certainement se refléter dans son illusion. C'est plutôt positif, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741118
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400741118,
					"content": "Oui et en plus, on ne part pas simplement en visite dans ton illusion. On y sera pour d'autres raisons, pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741119,
						400741120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400741119,
					"content": "Oui. Peut-être que...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400741121
					]
				},
				{
					"id": 400741121,
					"content": "Vraiment ? Bon, très bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741122
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741122,
					"content": "Tant que vous n'en attendez pas trop, ça me va. Allons-y.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741120,
					"content": "... On y trouvera des indices pour élucider le mystère des illusions.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400741121
					]
				}
			]
		},
		{
