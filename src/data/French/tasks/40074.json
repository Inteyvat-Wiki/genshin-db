				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400740301,
					"content": "Quelle magnifique structure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740302
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400740302,
					"content": "Waouh... Je n'ai jamais vu un endroit comme celui-ci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740303
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400740303,
					"content": "Hé, Mona, ton illusion est vraiment impressionnante !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740304
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400740304,
					"content": "Elle fait pâle figure à côté de l'Empire de la nuit éternelle, mais cela reste plutôt admirable, dame Megistus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740305
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400740305,
					"content": "(Heureusement, ce n'est pas un cours où je me fais réprimander par la vieille... Ma réputation est sauve...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740306
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400740306,
					"content": "Évidemment, une astromancienne de génie se doit d'avoir une illusion à son image.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740307
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400740307,
					"content": "Commençons donc nos recherches.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
		{
			"id": 4007409,
			"completionStepIds": [
				4007409
