				"points": []
			},
			"dialogs": [
				{
					"id": 400740201,
					"content": "Le disque d'eau montre que nous sommes arrivés à l'illusion. Eh bien, trouvons d'abord l'entrée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740202
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400740202,
					"content": "Ce ne serait pas ça là-bas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400740203,
					"content": "Ça ressemble... à un bassin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740204
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400740204,
					"content": "On ne va quand même pas plonger pour entrer, hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400740205,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740206
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400740206,
					"content": "Y en a-t-il parmi nous qui ne savent pas nager ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740207
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400740207,
					"content": "Je ne pense pas que ce soit le problème...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740208
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400740208,
					"content": "Haha, quelqu'un a peur ? Eh bien, laissez-moi prendre les devants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740209
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400740209,
					"content": "Et voilà ! Elle est toujours obligée de mettre ses talents de nageuse en avant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740210
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400740210,
					"content": "Ahem ! Mademoiselle, faites attention à votre façon de vous exprimer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740211
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400740211,
					"content": "Ah, oh !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740212
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400740212,
					"content": "Je passe devant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740213
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400740213,
					"content": "Ah, Mona a sauté dans l'eau et a disparu ?! Suivons-la !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
