				"points": []
			},
			"dialogs": [
				{
					"id": 400741201,
					"content": "Dame Megistus... C'est d'une tristesse infinie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741202
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400741202,
					"content": "Euh, ne me consolez pas, c'est embarrassant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741203
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741203,
					"content": "Dans ces moments, le silence vaut toutes les paroles du monde. Tu veux un câlin ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741204
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400741204,
					"content": "Non, merci !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741205
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741205,
					"content": "Ce sont des pensées que j'avais autrefois, quand je débutais en astromancie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741206
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741206,
					"content": "Maintenant que je suis expérimentée, je suis indifférente à l'opinion du commun des mortels.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741207
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741207,
					"content": "Je suis très surprise que l'archimage Megistus ait également connu des moments difficiles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741208
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400741208,
					"content": "C'est dur d'être incomprise toute sa vie... Heureusement que vous êtes parvenue à lâcher prise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741209
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400741209,
					"content": "En réalité, certaines personnes abandonnent l'astromancie parce qu'elles ne peuvent pas le supporter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741210
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741210,
					"content": "Mais je suis un génie capable de faire des choses que personne d'autre ne peut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741211
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741211,
					"content": "Ça me donne du courage de t'entendre dire ça dans un endroit aussi magnifique !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741212,
						400741213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400741212,
					"content": "Tu es formidable, Mona !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400741214
					]
				},
				{
					"id": 400741214,
					"content": "Merci ! Jetez-moi encore des fleurs !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741215
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741215,
					"content": "Excusez-moi, euh... Je n'ai point l'intention de vous déranger, mais on dirait qu'il y a une porte là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741216
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400741216,
					"content": "Bien, lorsque nous aurons tout réglé ici, je vous donnerai l'occasion de chanter mes louanges.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741213,
					"content": "Je sais que Mona est un génie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400741214
					]
				}
			]
		}
	]
}