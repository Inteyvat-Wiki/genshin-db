			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kazuha",
					"Oz",
					"Fischl",
					"Mona",
					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400740901,
					"content": "L'environnement a changé. Ce n'est pas la plage où nous étions avant de partir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740902
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400740902,
					"content": "On dirait les montagnes de Mondstadt. Se pourrait-il que nous ayons été téléportés à Mondstadt ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740903
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400740903,
					"content": "Mais on est toujours entourés par la mer infinie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740904
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400740904,
					"content": "Il devrait y avoir un bassin à proximité qui sert d'entrée comme tout à l'heure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740905
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400740905,
					"content": "C'est ici !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740906
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400740906,
					"content": "... Hmm ? On ne peut pas plonger dedans directement ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740907
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400740907,
					"content": "Je crois que quelque chose flotte sur l'eau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400740908,
					"content": "Est-ce un dessin ? Ou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740909
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400740909,
					"content": "Il semble faire allusion à un endroit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740910
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400740910,
					"content": "Sa volonté est que je conduise tout le monde là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740911
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400740911,
					"content": "Pourquoi tu fais encore la cheffe... Bon, peu importe. Trouvons cet endroit d'abord.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
		{
