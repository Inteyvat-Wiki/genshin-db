			},
			"dialogs": [
				{
					"id": 705232201,
					"content": "Pas mal, mais ce n'est pas encore suffisant compte tenu de la difficulté de la livraison au Village de Qingce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Georg"
				}
			]
		},
