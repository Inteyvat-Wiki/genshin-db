				"objectNames": [
					"Georg"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705230201,
					"content": "#Oh ? Vous êtes {M#revenus}{F#revenues}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230202
					],
					"speakerTitle": "Georg"
				},
				{
					"id": 705230202,
					"content": "Vous venez encore passer commande pour un client à l'étranger ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230203
					],
					"speakerTitle": "Georg"
				},
				{
					"id": 705230203,
					"content": "Tout à fait ! Cette fois-ci, nous allons commander 100 cartons de jus de fruits du festival pour Guanchui, le chef cuisinier du Village de Qingce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230204,
					"content": "#Nous sommes {M#prêts}{F#prêtes} à donner notre prix, monsieur Georg !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230205,
						705230206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230205,
					"content": "Tu parles comme si c'était une bataille commerciale...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230207
					]
				},
				{
					"id": 705230207,
					"content": "Oh ! Vous avez beaucoup d'entrain ! Montrez-moi comment vous négociez !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Georg"
				},
				{
					"id": 705230206,
					"content": "Prenez ça ! Monsieur Georg !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230207
					]
				}
			]
		},
		{
			"id": 7052303,
			"completionStepIds": [
				7052303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
