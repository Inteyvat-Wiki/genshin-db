			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Guanchui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705230301,
					"content": "Monsieur Guanchui, on est de retour !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230302,
					"content": "Nous avons déjà commandé 100 cartons de jus de fruits du festival pour vous. Voici votre reçu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230303,
					"content": "Merci beaucoup ! Vous m'avez vraiment été d'une grande aide !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230304
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230304,
					"content": "Je vais méticuleusement étudier ce jus de fruits du festival. En le mélangeant avec un certain ratio de thé, je pourrai en faire ressortir le goût. Mes frères pourront reprendre plus de forces dans les champs !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230305
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230305,
					"content": "Euh, ça ressemble un peu au travail d'un barman, mais avec du thé... C'est vraiment possible ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230306,
					"content": "Ne vous en faites pas, j'ai été chef cuisinier dans un restaurant pendant un certain temps. Cette approche permet de trouver le meilleur équilibre entre le coût et le goût. Je l'ai utilisée de nombreuses fois !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230307
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230307,
					"content": "Ça me donne envie d'essayer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230308
					]
				},
				{
					"id": 705230308,
					"content": "La prochaine fois que vous viendrez au Village de Qingce, je vous offrirai le produit fini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230309
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230309,
					"content": "#Super ! {NICKNAME} pourra en goûter !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230310,
					"content": "Bon courage, chef mixologue !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230311
					]
				},
				{
					"id": 705230311,
					"content": "Merci beaucoup ! N'hésitez pas à revenir souvent !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guanchui"
				}
			]
		},
		{
			"id": 7052304,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
