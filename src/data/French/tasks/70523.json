			"dialogs": [
				{
					"id": 705232101,
					"content": "Non, c'est trop bas ! Même si le total de la commande est plus élevé, le prix unitaire de chaque carton ne peut pas être aussi bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Georg"
				}
			]
		},
		{
