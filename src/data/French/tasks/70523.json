					"Guanchui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705230101,
					"content": "#Vous êtes des {M#visiteurs étrangers}{F#visiteuses étrangères} ? Bienvenue au Village de Qingce...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230102,
						705230103
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230102,
					"content": "Bonjour...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230104
					]
				},
				{
					"id": 705230104,
					"content": "Laisse-moi faire ! On se présente d'abord !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230105,
					"content": "#Voici {NICKNAME}, {M#un voyageur}{F#une voyageuse} capable de tout ! Et je suis sa meilleure amie, Paimon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230106,
					"content": "#Nous aidons les clients étrangers à passer commande pour les boissons spéciales du Weinlesefest ! Nous avons vu votre demande et sommes {M#venus}{F#venues} directement pour vous parler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230107,
					"content": "Je vois ! Vous n'y allez pas par quatre chemins, j'aime ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230109
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230109,
					"content": "Je me présente : Guanchui, chef cuisinier. Je voudrais acheter <color=#00E1FFFF>100 cartons de jus de fruits du festival</color> ! Je ferai du thé avec pour mes frères qui font un travail manuel intense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230110
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230110,
					"content": "Bien ! C'est noté, quel est votre budget ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230111,
					"content": "Il est déjà prêt ! Prenez ces gelées de cru ! Je suis sûr qu'il restera de l'argent après l'achat, prenez-le comme rémunération !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230112
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230112,
					"content": "Bien reçu ! On y va tout de suite !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230113,
					"content": "Super ! Alors j'attends de vos nouvelles !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230114,
						705230115
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230114,
					"content": "Quelle transaction rapide...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230116
					]
				},
				{
					"id": 705230116,
					"content": "#Ne reste pas les bras croisés, {NICKNAME} ! Allons-y !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230117,
					"content": "Si tu as quelque chose à dire, on en parlera après avoir passé la commande.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230118,
					"content": "Plus vite nous terminerons ces missions et plus vite nous pourrons ouvrir notre boutique !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230119,
					"content": "L'ouverture de notre boutique, héhé ~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230115,
					"content": "Tu es devenue une pro, Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230116
					]
				},
				{
					"id": 705230103,
					"content": "Est-ce que...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230104
					]
				}
			]
		},
		{
			"id": 7052302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
