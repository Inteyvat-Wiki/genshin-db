			"trigger": {
				"objectNames": [
					"Guanchui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705230401,
					"content": "Les boissons spéciales du Weinlesefest de cette année devraient se marier à merveille au thé à l'eau de source du Village de Qingce !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230402
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230402,
					"content": "Un grand merci à vous deux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230403,
						705230407,
						705230415
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230403,
					"content": "Parlez-moi de vous...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230404
					]
				},
				{
					"id": 705230404,
					"content": "Cela ne fait pas longtemps que je suis rentré au village avec mes frères. Je suis chargé de préparer et de livrer les repas pour ceux qui travaillent dans les champs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230405
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230405,
					"content": "Bien que rassasiants, la plupart des plats que je prépare sont assez rudimentaires et ne sont pas dignes d'être servis à des invités...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230406
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230406,
					"content": "Le Village de Qingce n'est pas un lieu très animé, mais il y a beaucoup de mets à déguster, comme vous pouvez le constater en vous promenant dans le village !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230407,
					"content": "À propos du thé...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230408
					]
				},
				{
					"id": 705230408,
					"content": "Mes frères qui travaillent dans les champs ont tellement soif qu'ils peuvent souvent finir une grande carafe de thé en une demi-journée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230409
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230409,
					"content": "Les champs et le stand de thé du village sont loin l'un de l'autre. Ce n'est pas pratique de s'y rendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230410
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230410,
					"content": "Oncle Kai est trop vieux pour faire de la livraison, alors je m'en occupe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230411
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230411,
					"content": "Comme mes frères et moi avons travaillé ailleurs pendant un certain temps, nous trouvons le thé d'ici un peu insipide. Parfois, ils veulent quelque chose avec un goût plus fort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230412
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230412,
					"content": "Je mélange d'autres boissons avec le thé pour lui donner un goût frais qui leur convient.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230413
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230413,
					"content": "Bien sûr, ceci n'est réservé qu'à mes frères ! Je n'ai pas l'intention de voler les clients d'oncle Kai !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230414
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230414,
					"content": "Quand nous avons du temps libre, nous dégustons également du thé chez oncle Kai et faisons des petites courses pour lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230415,
					"content": "On revient de suite.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230416
					]
				},
				{
					"id": 705230416,
					"content": "Bien ! Alors j'attends de vos nouvelles !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guanchui"
				}
			]
		},
		{
			"id": 7052321,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
