			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xingqiu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120001001,
					"content": "Je croyais que ce n'était qu'un pendentif quelconque... Tu... Tu possèdes un œil divin !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001002
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120001002,
					"content": "Tu t'en sors cette fois-ci... Mais un petit conseil : surveille tes arrières ! Tu ne sais pas dans quoi tu t'es fourré !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001022
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120001022,
					"content": "J'aurais espéré qu'ils tirent une leçon de cet échec, mais ne soyons pas trop optimistes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001003,
						120001005
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120001003,
					"content": "Vous possédez un œil divin...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120001004
					]
				},
				{
					"id": 120001004,
					"content": "En effet, même si j'évite de l'utiliser en général. Il me donne un trop gros avantage, et j'aime combattre équitablement. Mais à circonstances exceptionnelles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001008
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120001008,
					"content": "Ils sont partis, mais nul doute qu'on les reverra avant peu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120001009,
					"content": "Certes. Je veillerai à ce que nul mal ne soit fait à celui qui m'a fait preuve de bonté. Je ne saurais rester de marbre face à l'injustice, et j'irai au fond des choses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001010
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120001010,
					"content": "Ce n'est pas dans l'habitude des Fatui de prendre parti pour un marchand... Mais l'homme avait l'air sûr de lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001011
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120001011,
					"content": "Quelque chose me dit qu'il y a là quelque machination de plus grande envergure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001012
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120001012,
					"content": "Il a mentionné le notable Maocai ; ce nom ne m'est pas étranger. Si mes souvenirs sont bons, l'homme réside à Liyue, dans une demeure difficile à ignorer. Peut-être que vous deux pourriez aller y jeter un œil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001013
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120001013,
					"content": "Ce n'est pas une mauvaise idée... Et vous, qu'allez-vous faire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001014
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120001014,
					"content": "Moi ? D'autres choses requièrent mon attention. Voyons voir... Retrouvons-nous plus tard à la Terrasse Yujing, au Port de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001015
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120001015,
					"content": "Hum, vous avez vraiment quelque chose à faire, ou vous préférez nous laisser faire tout le boulot ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120001016,
					"content": "Diable, quel récit... Ce chapitre est juste incroyable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001017
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120001017,
					"content": "Hmph ! Il m'énerve ! Je peux le frapper ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001018,
						120001019
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120001018,
					"content": "Aidons d'abord Chang le Neuvième.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120001020
					]
				},
				{
					"id": 120001020,
					"content": "Pas de problème ! Mais je donne toujours un surnom moche pour tous les gens qui m'énervent !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001021
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120001021,
					"content": "Désormais, je l'appellerai « rat de bibliothèque » !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120001019,
					"content": "La vengeance est un plat qui se mange froid.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120001020
					]
				},
				{
					"id": 120001005,
					"content": "Le Clan Guhua cache bien son jeu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120001006
					]
				},
				{
					"id": 120001006,
					"content": "Hum, pas exactement. Cet homme, bien que vulgaire, n'a malheureusement pas complètement tort quant à l'état du Clan Guhua, j'en ai bien peur. *soupir*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001007
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120001007,
					"content": "J'ai bon espoir de lui faire regagner ses lettres de noblesses un jour... Mais cela prendra du temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001008
					],
					"speakerTitle": "Xingqiu"
				}
			]
		},
		{
			"id": 1200012,
