			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xingqiu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120000601,
					"content": "Alors comme ça, vous aimez lire, monsieur le héros du jour ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000602,
					"content": "Passionnant... Voilà un retournement de situation que je n'aurais jamais deviné...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000603
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000603,
					"content": "Hé, vous m'entendez ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000604,
					"content": "Je comprends maintenant pourquoi ce livre est si recherché.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000608
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000608,
					"content": "Hé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000605,
						120000606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000605,
					"content": "Ce type tout à l'heure n'avait pas l'air de rigoler...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000607
					]
				},
				{
					"id": 120000607,
					"content": "Cette histoire de cœur de lapis... C'est de l'extorsion pure et simple !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000609,
						120000611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000609,
					"content": "Nous devons trouver un moyen d'aider Chang le Neuvième.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000610
					]
				},
				{
					"id": 120000610,
					"content": "Ne m'oubliez pas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000613
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000613,
					"content": "Oh, alors maintenant vous nous entendez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000614,
					"content": "J'ai emprunté ce livre à Chang le Neuvième parce que ça serait dommage qu'il ait à le vendre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000615
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000615,
					"content": "Je tiendrai la promesse que je lui ai faite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000616
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000616,
					"content": "Je garderai ce livre en sécurité et je l'aiderai à racheter le reste de sa collection.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000617,
						120000618
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000617,
					"content": "Vous n'avez quand même pas déjà un plan, si ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000619
					]
				},
				{
					"id": 120000619,
					"content": "Bien sûr que si. J'ai un plan en tête, mais il faut que je réfléchisse encore aux détails.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000620
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000620,
					"content": "J'aurais besoin de réfléchir encore un peu. Attendez-moi ici, ça ne prendra pas longtemps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000621
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000621,
					"content": "Tu es encore là, toi ?! Tu crois que je plaisante ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000622
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000622,
					"content": "Je dois le reconnaître : à défaut de talent, les disciples du clan des clowns ont de l'audace à revendre – même si elle ne sert à rien !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000623
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000623,
					"content": "Oh, pardon... Ai-je dit « clan des clowns » ? Je voulais dire le Clan Guhua, bien sûr... c'est comme ça que les clowns l'appellent non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000624
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000624,
					"content": "Connaissez-vous l'expression « L'insecte qui agite les feuilles de l'arbre n'a pas conscience de sa taille » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000625
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000625,
					"content": "Arrête de me citer des proverbes, bouffon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000626
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000626,
					"content": "Quittez ce lieu sur l'instant. Je ne tolérerai pas que l'on s'en prenne à un honnête commerçant – un commerçant envers qui je suis redevable, qui plus est.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000627
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000627,
					"content": "Comme c'est mignon... Tu es un beau parleur, mais tout le monde est capable de fanfaronner !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000628
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000628,
					"content": "Mais tu as choisi le mauvais adversaire, petit ! Regarde, les Fatui sont là, gros malin. Une armée de ton clan d'imbéciles ne servirait à rien !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000629
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000629,
					"content": "Je suis peut-être jeune, mon ami ; mais la voie que j'ai choisie m'a enseigné le péril. Je ne bats pas en retraite face au mal, quelqu'il soit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000630
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000630,
					"content": "Comme tu voudras. On ne pourra pas dire qu'on ne t'a pas prévenu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000618,
					"content": "Vous n'en avez aucune idée, je me trompe ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000619
					]
				},
				{
					"id": 120000611,
					"content": "Je crois qu'on peut dire adieu à notre guide touristique.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000612
					]
				},
				{
					"id": 120000612,
					"content": "Pourquoi ? Vous allez abandonner aussi facilement ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000613
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000606,
					"content": "Ce type travaillait pour le notable Maocai, non ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000607
					]
				}
			]
		},
		{
			"id": 1200010,
			"completionStepIds": [
				1200010
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
