			"dialogs": [
				{
					"id": 120000201,
					"content": "Librairie Wanwen... C'est ici qu'on achète des livres à Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000202,
					"content": "On devrait leur demander un exemplaire du numéro de Liyue du Guide de voyage en Teyvat !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1200003,
			"completionStepIds": [
				1200003
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200003",
							"2"
						],
						"stepId": 1200003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jifang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120000301,
					"content": "N'hésitez pas à jeter un coup d'œil ! Pas d'obligation d'achat ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000302
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 120000302,
					"content": "Nous sommes à la recherche d'un exemplaire du numéro de Liyue du Guide de voyage en Teyvat, vous l'avez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000303,
					"content": "Je suis désolée. Nous ne l'avons plus en stock depuis longtemps ! Ça ne se vendait pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000304
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 120000304,
					"content": "Ah bon ? Quel dommage ! Le numéro sur Mondstadt était passionnant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000305,
					"content": "C'est censé être un guide, mais il est inutile, car l'auteur s'est laissé emporter par ses sentiments personnels pendant la rédaction...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000306
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 120000306,
					"content": "Les quelques acheteurs de l'ouvrage se sont aussi plaints à l'éditeur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000307,
						120000308
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 120000307,
					"content": "Son style n'a pas fait l'unanimité ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000309
					]
				},
				{
					"id": 120000309,
					"content": "C'est tout de même triste. Comme je disais, le numéro sur Mondstadt était très intéressant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000310,
					"content": "En tout cas, ce n'est pas chez moi que vous trouverez ce livre. Vous pouvez aller tenter votre chance chez Chang le Neuvième. Il l'a peut-être dans sa bibliothèque ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000311
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 120000311,
					"content": "Chang le Neuvième ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000312,
					"content": "C'est un collectionneur de livres qui vit au Village de Qingce. Il a un caractère de cochon, mais ça devrait aller si vous lui parlez de livres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000313
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 120000313,
					"content": "C'était un de mes meilleurs clients quand il vivait encore à Liyue. Je lui envoie des ouvrages qui ne sont plus édités de temps en temps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000324
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 120000324,
					"content": "Sa maison n'est pas facile à atteindre. Vous devez vous rendre à la montagne juste derrière le village et suivre le chemin en bois jusqu'au bout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000314
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 120000314,
					"content": "Pardon, vous avez parlé de livres rares ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000315
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000315,
					"content": "Savez-vous s'il possède le sixième tome du « Bris de l'arme divine » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000316,
						120000317
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000316,
					"content": "Qui êtes-vous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000318
					]
				},
				{
					"id": 120000318,
					"content": "Excusez-moi. Je m'appelle Xingqiu, et je suis un amateur de littérature qui a eu le hasard d'entendre votre conversation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000319
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000319,
					"content": "Vous et moi sommes à la recherche de livres rares, alors pourquoi ne pas faire la route ensemble jusqu'à chez Chang le Neuvième ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000320,
						120000322
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000320,
					"content": "Vous avez raison. Je vous suis !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000321
					]
				},
				{
					"id": 120000321,
					"content": "Avec plaisir ! On doit s'entraider entre férus de littérature.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000322,
					"content": "Ça a l'air de faire un bout de chemin...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000323
					]
				},
				{
					"id": 120000323,
					"content": "Profitez-en pour prendre un grand bol d'air frais. Ça ne fait pas de mal de s'éloigner des rues bondées de Liyue parfois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000317,
					"content": "Vous m'avez fait peur !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000318
					]
				},
				{
					"id": 120000308,
					"content": "Il a incité à la dégradation de certains lieux ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000309
					]
				}
			]
		},
		{
			"id": 1200005,
			"completionStepIds": [
				1200005
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200005",
							"2"
						],
						"stepId": 1200005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chang le Neuvième"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120000501,
					"content": "Les dieux veulent ma peau, pauvre de moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000502
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 120000502,
					"content": "Excusez-moi, vous êtes bien monsieur Chang le Neuvième ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000503
					]
				},
				{
					"id": 120000503,
					"content": "Oui. Qu'est-ce que vous me voulez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000504
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 120000504,
					"content": "On nous a raconté que vous possédiez de nombreux livres rares, et nous sommes à la recherche d'un examplaire du numéro de Liyue du Guide de voyage en Teyvat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000505,
					"content": "Arrêtez de me parler de bouquins, j'en ai ma claque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000506
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 120000506,
					"content": "Mon entreprise a coulé après la fermeture du Gouffre et maintenant, les Fatui essayent de me nuire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000507
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 120000507,
					"content": "J'ai dû vendre toute ma collection de livres pour payer ma dette. Vous vous rendez compte ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000508,
						120000509
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 120000508,
					"content": "... Vous êtes triste de n'avoir plus rien à lire ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000510
					]
				},
				{
					"id": 120000510,
					"content": "Vous ne comprenez pas, ces livres étaient ma vie ! Je prenais soin de cette précieuse collection ! Ils les ont tous embarqués !!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000511
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 120000511,
					"content": "À quoi bon vous dire tout ça... Tout ce que je peux faire, c'est d'économiser assez pour les racheter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000512
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 120000512,
					"content": "Si vous n'avez rien d'autre à faire ici, partez. Au revoir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000513
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 120000513,
					"content": "Attendez... Vous n'auriez pas perdu aussi le sixième tome du « Bris de l'arme divine » par hasard ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000514
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000514,
					"content": "Ah ! Un excellent ouvrage, dont je n'avais pas entendu parler depuis longtemps ! Vous faites preuve de bon goût, jeune homme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000515
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 120000515,
					"content": "#Euh, et {NICKNAME} et moi alors ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000516,
					"content": "C'est une œuvre qui a marqué son époque, même si elle était assez méconnue quand elle a été publiée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000517
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 120000517,
					"content": "Par la suite, c'est devenu une œuvre qui a façonné les romans d'arts martiaux, beaucoup s'en sont inspirés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000518
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 120000518,
					"content": "Les exemplaires de la première édition de ce livre sont très rares de nos jours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000519
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 120000519,
					"content": "Quand la série a été rééditée plus tard, le sixième tome qui apportait un complément à l'histoire n'a pas été publié pour une raison inconnue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000520
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000520,
					"content": "Vous avez raison ! Le sixième tome est encore plus rare que les autres, alors je ne l'aurais vendu pour rien au monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000521
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 120000521,
					"content": "Vous l'avez toujours ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000522
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000522,
					"content": "Oui. C'est le dernier livre qui me reste...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000523
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 120000523,
					"content": "Hé, Chang !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000524
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000524,
					"content": "Tu es culotté de nous faire poireauter comme ça. Tu nous vends le cœur de lapis, oui ou non ? J'ai besoin d'une réponse !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000525
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000525,
					"content": "Ou alors faut-il que je te rappelle que décevoir le notable Maocai, c'est décevoir les Fatui ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000526
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000526,
					"content": "Ah, encore vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000527
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 120000527,
					"content": "Vous savez très bien que je ne peux pas vous le vendre au rabais. Sinon, je n'aurais jamais assez pour racheter ma collection de livres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000528
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 120000528,
					"content": "Ce n'est pas mon problème. Il faut choisir entre manger et lire, et à ce que je vois tu es bien parti pour emporter de la lecture dans la tombe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000529
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000529,
					"content": "Espèce de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000530
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 120000530,
					"content": "Calmez-vous, mon ami. Vous ne pouvez pas forcer cet homme à vous vendre un bien s'il ne le veut pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000531
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000531,
					"content": "D'où tu sors toi ? Occupe-toi de tes oignons !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000532
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000532,
					"content": "Je suis celui qui vient en aide à ceux dans le besoin, Xingqiu, disciple du Clan Guhua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000533
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000533,
					"content": "Pouhahahaha !!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000534
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000534,
					"content": "Un disciple du Clan Guhua !! Pfft ! Ça existe encore les guignols de ce genre aujourd'hui ?! Hahaha !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000535
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000535,
					"content": "Et moi qui pensais que cette école de clowns était finie depuis dieu sait quand ! Tu es censé être quoi, leur messie ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000536
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000536,
					"content": "La justice ne s'embarrasse pas de savoir qui la sert, mon ami – et j'en suis l'un des serviteurs. Vous n'êtes que l'esclave d'un autre, et tout aussi coupable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000537
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000537,
					"content": "Comment oses-tu... Regardez-moi ce rigolo ! Attends un peu, tu regretteras tes paroles !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000538
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000538,
					"content": "Et toi, Chang ! Ton cœur de lapis nous appartiendra, de gré ou de force !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000539
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000539,
					"content": "*soupir* L'homme est un loup pour l'homme... Mes jours sont comptés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000540
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 120000540,
					"content": "Revenons à ce que nous disions. Qu'en est-il de ce bouquin, puis-je l'emprunter ou pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000541,
						120000542
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000541,
					"content": "Si... Si insensible...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000543
					]
				},
				{
					"id": 120000543,
					"content": "Peu importe ! Personne ne se soucie de moi de toute façon. Comme vous m'avez aidé, prenez ce fichu livre et partez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000544
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 120000544,
					"content": "Merci infiniment ! Ça fait trois ans que je cherche ce livre ! Vous ne savez pas à quel point je suis heureux... Je vous revaudrai votre générosité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000545
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000545,
					"content": "C'est bon, pas la peine d'en faire tout un plat ! Faites juste en sorte de me le rendre quand vous l'aurez terminé. Je n'attends rien en retour, surtout pas de la part d'un soi-disant disciple du Clan Guhua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000546
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 120000546,
					"content": "Hé ! Mais où est-ce que vous allez ?! Il reste encore plein de questions en suspens !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000542,
					"content": "Comment peut-on sauter comme ça du coq à l'âne...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000543
					]
				},
				{
					"id": 120000509,
					"content": "... Vous vous ennuyez sans vos livres ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000510
					]
				}
			]
		},
		{
			"id": 1200006,
			"completionStepIds": [
				1200006
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
