			"dialogs": [
				{
					"id": 761140101,
					"content": "Cette fois-ci, il faut enquêter sur un ermite au comportement suspect ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140102
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140102,
					"content": "Mais ne le sont-ils pas tous par nature ? Quelqu'un de normal ne choisirait pas de vivre dans les montagnes au milieu de nulle part...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140103
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140103,
					"content": "Les gens ne changent pas sur un coup de tête, que ce soit à cause de facteurs internes ou externes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140104
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761140104,
					"content": "De plus, la disparition du marchand est aussi préoccupante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140105
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761140105,
					"content": "Hein ? Mais c'est une zone dangereuse. Tout le monde le sait. Il y a des bandits, des monstres... Un marchand itinérant peut perdre la vie de mille façons là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140106
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140106,
					"content": "Comme tout le monde a conscience du danger, tu ne crois pas qu'un marchand qui passe régulièrement par là s'y serait bien préparé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140107
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761140107,
					"content": "Il a disparu malgré tout. Quelque chose ne tourne pas rond.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140108
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761140108,
					"content": "Jahoda, je compte sur toi pour rendre visite à cet ermite au comportement suspect.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140109
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761140109,
					"content": "Le chemin est long. Assure-toi de ne pas faire de détours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140110
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761140110,
					"content": "Oh... Pas de problème, patronne ! Je m'en occupe !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		},
		{
