			"dialogs": [
				{
					"id": 761140201,
					"content": "Bonjour ? Y'a quelqu'un ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140202
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140202,
					"content": "Monsieur Derwent, vous êtes là ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140203
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140203,
					"content": "... Qui est-ce ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140204
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761140204,
					"content": "Je suis Jahoda, du Curatorium des secrets. J'aimerais vous poser quelques questions...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140205
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140205,
					"content": "... Vous pouvez me les poser de là où vous êtes. Je suis malade, alors je ne peux pas me lever.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140206
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761140206,
					"content": "(Étrange... Les gamins de la Clique de la conque m'ont dit que monsieur Derwent leur avait appris à lire, et qu'il parlait doucement...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140207
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140207,
					"content": "(La voix de cet homme est rauque, mais on ne dirait pas qu'il est malade. On dirait plutôt que c'est naturel...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140208
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140208,
					"content": "Tout va bien ? Si c'est grave, je peux demander à un médecin de venir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140209
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140209,
					"content": "... Pas la peine. Je guérirai bientôt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140210
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761140210,
					"content": "D'accord. Revenez au Village de Nasha quand vous vous sentirez mieux, vos amis s'inquiètent pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140211
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140211,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140212
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761140212,
					"content": "(... Pourquoi est-il aussi silencieux ? Je peux entendre quelqu'un marcher, mais ses pas sont lourds...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140213
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140213,
					"content": "Avez-vous été à l'extérieur récemment ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140214
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140214,
					"content": "... Je me suis entraîné.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140215
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761140215,
					"content": "J'ai entendu dire que vous vous étiez transformé... Quelqu'un disait qu'il n'arrivait pas à croire à quel point vous étiez devenu fort, alors que vous aviez l'air de n'avoir que la peau sur les os.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140216
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140216,
					"content": "Et un masque pour bloquer le kuuvahki... C'est la mode ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140217
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140217,
					"content": "... C'est pour bloquer le bruit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140218
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761140218,
					"content": "Pour mieux vous entraîner ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140219
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140219,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140220
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761140220,
					"content": "Bref, un marchand vous a rendu visite il n'y a pas longtemps. Savez-vous où est-ce qu'il est passé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140221
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140221,
					"content": "... Aucune idée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140222
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761140222,
					"content": "D'accord... Hum, désolée du dérangement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140223
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140223,
					"content": "(Je ne sais pas pourquoi, mais je sens que ça devient dangereux...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140224
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140224,
					"content": "(Ils avaient raison. On dirait un tout autre homme...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140225
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140225,
					"content": "(Je ne peux pas rentrer en ayant appris aussi peu. Je devrais rester près d'ici et inspecter les environs.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		},
