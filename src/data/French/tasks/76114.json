			},
			"dialogs": [
				{
					"id": 761140301,
					"content": "(Oh ? On dirait que ça n'a pas été entièrement brûlé...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140302
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140302,
					"content": "(J'ai entendu dire que monsieur Derwent accueillait les aventuriers blessés... Ça a l'air récent.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140303
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140303,
					"content": "(Pourquoi aurait-il voulu brûler ça ?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		},
