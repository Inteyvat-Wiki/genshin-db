				{
					"id": 105000212,
					"content": "20 000 moras...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000213,
						105000214
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000216,
					"content": "Tu étais en train de parler de la fierté des astromanciens je crois...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000218
					]
				},
				{
					"id": 105000217,
					"content": "Tu étais en train de dire que les principes, ce sont les principes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000218
					]
				},
				{
					"id": 105000215,
					"content": "... Ce n'est rien ! Je... Je réfléchissais juste au fait que la personne qui trouvera cette bague aura bien de la chance. Gagner 20 000 moras de cette manière...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000216,
						105000217
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000218,
					"content": "Haha, hum. En effet. Mais... Le pauvre monsieur Zhu n'a pas la vie facile, avec son commerce qui n'est guère florissant. Il doit s'agir là d'une bague vraiment spéciale, à ce prix.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000219
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000219,
					"content": "Partir sans lui venir à l'aide serait faire montre d'égoïsme ; on doit pouvoir l'aider sans avoir à faire appel aux étoiles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000220
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000220,
					"content": "Oh, je sais où elle veut en venir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000222,
					"content": "Évidemment...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000224
					]
				},
				{
					"id": 105000223,
					"content": "C'est à moi de m'occuper de tout. Encore...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000224
					]
				},
				{
					"id": 105000221,
					"content": "#{NICKNAME}, je compte sur toi ! Voilà la première mission que ton maître te donne !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000222,
						105000223
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000224,
					"content": "Hmm, puisqu'elle a été avalée par un Blob, on pourrait peut-être utiliser un piège élémentaire pour attirer les Blobs du coin ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000825,
					"content": "Tu sais ce que c'est ? C'est un truc mis au point par hasard au Domaine de l'Aurore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000826
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000826,
					"content": "La recette est gardée secrète, mais c'est très efficace pour attirer les Blobs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000827
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000227,
					"content": "Tu me surprends, Paimon !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000228
					]
				},
				{
					"id": 105000229,
					"content": "Tu n'aurais quand même pas prévu de faire des réserves en cas de faim soudaine, dis-moi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000230
					]
				},
				{
					"id": 105000226,
					"content": "Et... Héhé... J'en ai gardé sur moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000227,
						105000229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000228,
					"content": "Alors, je suis la meilleure des partenaires, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000230,
					"content": "Euh, enfin ! Pas la peine de s'attarder sur les détails !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000231,
					"content": "Bien, on dirait que vous avez déjà une idée de comment procéder ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000232
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000232,
					"content": "Oui ! On revient dans un moment !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1050009,
