					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105000902,
					"content": "Ça faisait un moment, tiens.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000904
					]
				},
				{
					"id": 105000903,
					"content": "Mona !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000904
					]
				},
				{
					"id": 105000901,
					"content": "Ma capacité à voir à travers les secrets n'éveille donc pas de souvenirs ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000902,
						105000903
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000904,
					"content": "Oh, c'est vrai, l'astromancienne !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000905,
					"content": "Héhé, en effet, c'est bien moi, l'astromancienne Mona Megistus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000906
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000906,
					"content": "J'aimerais que vous m'accompagniez à Mondstadt récupérer le coffre de mon maître.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000907
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000109,
					"content": "Cela fait partie d'un accord qu'elle a passé il y a cinquante ans avec un ami. Mais elle n'est plus toute jeune, aussi m'a-t-elle chargée de m'en occuper.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000110
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000110,
					"content": "Récupérer un coffre... Je ne vois pas le rapport avec nous. Pourquoi tu veux qu'on te suive ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000111,
					"content": "Eh bien... C'est parce que j'aimerais aussi affronter le gardien du coffre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000112
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000911,
					"content": "Donc tu veux faire tes preuves...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000912
					]
				},
				{
					"id": 105000913,
					"content": "Donc en gros, c'est juste une question d'ego...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000914
					]
				},
				{
					"id": 105000112,
					"content": "Mon maître et son amie, mais aussi sa rivale, se sont affrontées dans les arts occultes toute leur vie, sans que jamais personne ne remporte vraiment de victoire. Si je triomphe ici, alors j'aurai prouvé que je lui suis supérieure !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000113,
						105000115
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000114,
					"content": "Haha... Pour être plus précise, je veux montrer le vrai pouvoir de l'astromancie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000117
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000116,
					"content": "Mais non, voyons ! Je veux simplement saisir l'occasion de montrer le pouvoir de l'astromancie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000117
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000117,
					"content": "Mais d'après mes prédictions, l'amie de mon maître a déjà quitté Mondstadt, et a laissé à sa successeure la garde du coffre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000118
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000118,
					"content": "Tout comme moi, cette successeure doit être quelqu'un qui a surpassé son professeur ; je me dois d'être prudente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000119
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000918,
					"content": "Euh... Je n'y connais rien en astromachin, moi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000919
					]
				},
				{
					"id": 105000920,
					"content": "Pourquoi as-tu pensé à moi ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000921
					]
				},
				{
					"id": 105000119,
					"content": "Je veux être sûre de l'emporter, et après réflexion, ton nom m'est venu à l'esprit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000120,
						105000122
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000121,
					"content": "#Comment s'est-{M#il}{F#elle} retrouvée {M#mêlé}{F#mêlée} à tout ça de toute façon ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000123,
					"content": "Le savoir que m'a enseigné mon maître doit être transmis à son tour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000124
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000124,
					"content": "Si j'y vais avec mon disciple, alors j'ai déjà un avantage, tu ne trouves pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000125
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000924,
					"content": "Sans façon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000926
					]
				},
				{
					"id": 105000925,
					"content": "Parce que je suis ton disciple maintenant ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000926
					]
				},
				{
					"id": 105000125,
					"content": "#Et puis, tu es {M#le grand héros}{F#la grande héroïne} de Mondstadt, quelqu'un de ma stature...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000126,
						105000127
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000128,
					"content": "*soupir* Pas la peine de prendre les choses au pied de la lettre ; joue le rôle, ça suffira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000129
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000129,
					"content": "Et puis, c'est aussi dans ton intérêt de m'accompagner récupérer ce coffre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000130
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000130,
					"content": "Une fois que j'aurai rencontré cette successeure, nous pourrons échanger nos connaissances, et je devrais pouvoir lire ton futur avec plus de certitude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000131
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000131,
					"content": "J'aurai alors des réponses aux questions que tu te poses, sur des sujets aussi variés que les dieux ou tes proches.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000132
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000133,
					"content": "Ça m'a l'air acceptable.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000135
					]
				},
				{
					"id": 105000134,
					"content": "Bon... J'imagine que je vais jouer le jeu alors.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000135
					]
				},
				{
					"id": 105000132,
					"content": "C'est... autrement plus rapide que de chercher à travers le monde entier...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000133,
						105000134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000135,
					"content": "Haha, une sage décision, crois-moi. Bien, si vous le voulez bien, partons maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000136
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000136,
					"content": "Cela dit, j'aimerais d'abord passer quelque part avant d'y aller.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		}
	]
}