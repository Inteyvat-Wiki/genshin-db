	"talks": [
		{
			"id": 1050001,
			"completionStepIds": [
				1050002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1050002",
							"2"
						],
						"stepId": 1050002,
