					"speakerTitle": "Mona"
				},
				{
					"id": 105000232,
					"content": "Oui ! On revient dans un moment !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000229,
					"content": "Tu n'aurais quand même pas prévu de faire des réserves en cas de faim soudaine, dis-moi...",
					"roleType": "TALK_ROLE_PLAYER",
