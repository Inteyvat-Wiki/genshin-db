						"stepId": 1050003,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"46622",
							"3"
						],
						"stepId": 46622,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"M. Zhu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105000201,
					"content": "(Pas surprenant que les affaires soient mauvaises, vu où cette auberge est située...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000202,
					"content": "Mona, vous tombez à pic ! Auriez-vous vu une bague en jade sur votre chemin par hasard ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000203
					],
					"speakerTitle": "M. Zhu"
				},
				{
					"id": 105000203,
					"content": "Une bague en jade ? J'ai bien peur que non.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000204
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000204,
					"content": "Mince, mince, mince... C'est ma mère qui me l'avait donnée, mais un de ces satanés Blobs l'a avalée quand j'avais le dos tourné !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000205
					],
					"speakerTitle": "M. Zhu"
				},
				{
					"id": 105000205,
					"content": "Oh ? Ça ne devrait pas poser de problème à Mona ; elle est si forte en astromancie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000206,
					"content": "Hors de question. L'astromancie sert à voir à travers la réalité de ce monde et à observer les fils du destin. Ce genre de chose n'a rien à voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000207
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000207,
					"content": "Tu ne nous as pas dit que le gérant d'ici a été très gentil avec toi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000208,
					"content": "C'est une question de fierté, et d'état d'esprit. Un astromancien qui pense que son art peut tout résoudre, des petits problèmes aux gros, finit par être abandonné par les étoiles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000209
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000209,
					"content": "Ses prédictions perdront leur pouvoir de guidance, et finiront par ne plus être capables de percer les limbes de l'inconnu. Les principes doivent être respectés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000210
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000210,
					"content": "Avoir un talent comme ça et ne pas s'en servir pour faire quelques moras... Quel dommage...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000211,
					"content": "*soupir* Je comptais vous proposer une rénumération de 20 000 moras, si vous aviez accepté de m'aider...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000212
					],
					"speakerTitle": "M. Zhu"
				},
				{
					"id": 105000212,
					"content": "20 000 moras...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000213,
						105000214
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000213,
					"content": "Euh... Tout va bien ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000215
					]
				},
				{
					"id": 105000215,
					"content": "... Ce n'est rien ! Je... Je réfléchissais juste au fait que la personne qui trouvera cette bague aura bien de la chance. Gagner 20 000 moras de cette manière...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000216,
						105000217
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000216,
					"content": "Tu étais en train de parler de la fierté des astromanciens je crois...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000218
					]
				},
				{
					"id": 105000218,
					"content": "Haha, hum. En effet. Mais... Le pauvre monsieur Zhu n'a pas la vie facile, avec son commerce qui n'est guère florissant. Il doit s'agir là d'une bague vraiment spéciale, à ce prix.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000219
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000219,
					"content": "Partir sans lui venir à l'aide serait faire montre d'égoïsme ; on doit pouvoir l'aider sans avoir à faire appel aux étoiles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000220
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000220,
					"content": "Oh, je sais où elle veut en venir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000221,
					"content": "#{NICKNAME}, je compte sur toi ! Voilà la première mission que ton maître te donne !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000222,
						105000223
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000222,
					"content": "Évidemment...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000224
					]
				},
				{
