			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ahangar",
					"Garcia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230155001,
					"content": "Pourquoi tu as besoin de tous ces engrenages et de ces tuyaux ? Tu veux construire une maison en fer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155002
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230155002,
					"content": "Exactement, monsieur ! Je veux construire une maison, une maison pleine d'engrenages.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155003
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230155003,
					"content": "J'appelle l'endroit où certains des engrenages sont logés la chambre de retenue, tandis que les roulements et une autre partie des engrenages formeront la banque de calcul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155004
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230155004,
					"content": "Les engrenages dans la chambre de retenue sont utilisés pour stocker et enregistrer les chiffres, tandis que les engrenages de la banque de calcul sont utilisés pour les calculs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155005
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230155005,
					"content": "Je vais faire un schéma pour que vous puissiez comprendre. Vous avez du papier ? Non ? Ce n'est pas grave, je vais dessiner sur mes vêtements pour que ce soit plus facile à voir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155006
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230155006,
					"content": "Vous pouvez me passer ce morceau de charbon ? Merci, regardez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				}
			]
		}
	]
