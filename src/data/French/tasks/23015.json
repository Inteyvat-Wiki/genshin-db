			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Garcia",
					"Lutong",
					"Ahangar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230150301,
					"content": "Ça va ! Ça va ! J'ai compris, je vais te les faire tes engrenages !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150302
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230150302,
					"content": "Mais je n'ai pas fini d'expliquer le fonctionnement de ma machine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150303
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230150303,
					"content": "Maintenant que j'ai des morceaux de fer, je me remets au travail. Écarte-toi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150304
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230150304,
					"content": "Ahangar se met à marteler le fer avec son marteau si fort que Garcia est forcé de s'écarter...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230150305
					]
				},
				{
					"id": 230150305,
					"content": "Laissons monsieur Ahangar se concentrer sur son travail. Voici votre paiement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150306
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150306,
					"content": "Tous mes vœux de réussite.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150307
					]
				},
				{
					"id": 230150307,
					"content": "#Merci pour vos encouragements, {M#voyageur}{F#voyageuse}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150308
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150308,
					"content": "... Mais j'ai quelques réserves à ce sujet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150309
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150309,
					"content": "Il ne fait aucun doute que monsieur Garcia est un génie de la mécanique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150310
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150310,
					"content": "Mais je pense que pour la machine qu'il veut construire... le génie de monsieur Garcia ne suffira peut-être pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				}
			]
		},
		{
			"id": 2301550,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
