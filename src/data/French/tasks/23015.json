				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230150101,
					"content": "Ce roulement est trop grand, il ne va pas avec les autres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150102
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230150102,
					"content": "La dernière fois, c'était trop petit, maintenant trop grand. Vous allez épuiser tous mes morceaux de fer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150103
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230150103,
					"content": "Et on va épuiser toutes nos économies, aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150104
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150104,
					"content": "Pourquoi vous vous disputez ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150105
					]
				},
				{
					"id": 230150105,
					"content": "Ce type veut que je construise des tuyaux et des engrenages en fer pour lui, et chacun a des spécifications différentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150106
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230150106,
					"content": "J'ai déjà épuisé tous mes morceaux de fer pour lui !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150107
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230150107,
					"content": "Mais il a dit que ce n'était pas assez, et qu'il voulait plus de pièces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150108
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230150108,
					"content": "S'il vous plaît, laissez-moi vous réexpliquer mon travail. Après, je suis sûr que vous comprendrez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150109
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230150109,
					"content": "#Qu'est-ce que vous faites exactement{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150110
					]
				},
				{
					"id": 230150110,
					"content": "Laissez monsieur Garcia expliquer à monsieur Ahangar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150111
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150111,
					"content": "#{M#Voyageur}{F#Voyageuse}, je... Euh, monsieur Garcia aimerait que vous récupériez des morceaux de fer pour lui, si ça ne vous dérange pas trop. S'il vous plaît ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150112,
						230150113
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150112,
					"content": "Oui, je suis libre, mais...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150114
					]
				},
				{
					"id": 230150114,
					"content": "La mise au point de la machine... On a rencontré des obstacles auxquels on s'attendait. Monsieur Garcia réfléchit actuellement à des moyens de les surmonter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150115
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150115,
					"content": "Si ça vous intéresse un jour, vous pouvez vous renseigner directement auprès de monsieur Garcia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150116
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150116,
					"content": "Je pense que... personne ne comprend vraiment le fonctionnement de cette machine à part lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150117
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150117,
					"content": "Mais avant cela, s'il vous plaît, rapportez-nous des morceaux de fer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150113,
					"content": "Comment se passe la mise au point de sa machine ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150114
					]
				}
			]
		},
