			"dialogs": [
				{
					"id": 735200101,
					"content": "Alors, vous avez décidé de m'acheter des renseignements ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200102
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200102,
					"content": "Hmm... Je suis curieuse de savoir de quoi il s'agit, mais dis-nous ton prix d'abord ! Si c'est trop cher, tu peux oublier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200103,
					"content": "Je vous les faits au prix fixe d'un million de moras !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200104
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200104,
					"content": "C'est trop cher ! Laisse tomber. On peut acheter plein de bonne nourriture avec un million de moras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200105,
					"content": "Une minute, laissez-moi voir... Tiens ? Tu es ma mille et unième cliente du jour, petite Paimon. Ces informations à un million de moras sont désormais gratuites pour toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200106
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200106,
					"content": "Quoi ?! C'est possible d'avoir autant de chance ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200107,
					"content": "Attends, tu ne serais pas en train de nous appâter pour nous faire dépenser ? Tu vas nous dire que la première phrase est gratuite, mais pas la deuxième...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200108,
					"content": "#Si vous n'êtes pas {M#intéressés}{F#intéressées}, tant pis pour vous ! Suivant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200109
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200109,
					"content": "Non, je n'ai rien dit, attends ! Ça nous intéresse !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200110,
					"content": "Voici le premier scoop de Dori ! Vous vous souvenez du diadème de la connaissance ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200111
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200111,
					"content": "Je me souviens que seul le champion a le droit de porter le diadème. Il a l'air très précieux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200112,
					"content": "Voilà. Le diadème que Sachin a donné à l'Académie est une antiquité assez chère.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200113
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200113,
					"content": "Pourtant, ce même diadème a autrefois été perdu par l'Académie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200114
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200114,
					"content": "Ah bon ? Comment ça se fait qu'on n'en ait jamais entendu parler ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200115,
					"content": "Héhé... Si tout le monde était au courant, est-ce que ce serait vraiment un scoop ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200116
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200116,
					"content": "Bien entendu, je ne sors pas cette information de nulle part. J'ai des témoins.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200117
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200117,
					"content": "Si vous voulez en savoir plus, vous pouvez interroger un jeune homme nommé Kashmer, qui vient du sud de la ville.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200118
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200118,
					"content": "Le code secret est « l'incident d'il y a vingt ans » !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dori"
				}
			]
		},
