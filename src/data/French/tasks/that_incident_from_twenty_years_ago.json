				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kashmer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735200203,
					"content": "« L'incident d'il y a vingt ans »",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735200204
					]
				},
				{
					"id": 735200204,
					"content": "... Je n'aurais pas dû parler de ça à tout le monde. La dernière fois, j'ai un peu trop bu et j'ai trop parlé. Et maintenant, voilà qu'on vient m'interroger là-dessus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200205
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200205,
					"content": "#Bon, puisque vous êtes si {M#curieux}{F#curieuses}, je vais vous en dire quelques mots.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200206
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200206,
					"content": "Je n'étais qu'un jeune enfant de six ans il y a vingt ans, et je ne me souviens pas clairement de ce qui s'est passé à l'époque. Ce n'est qu'en relisant mon journal intime de l'époque que j'ai pu vaguement me remémorer ces événements.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200207
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200207,
					"content": "Le tournoi interdarshan se tenait cette année-là. Il y avait trois épreuves, et la dernière avait lieu à l'extérieur de la ville. J'ai supplié ma mère de m'amener la voir, et quand elle a refusé, j'y suis allé en cachette.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200208
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200208,
					"content": "Et ensuite ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200209,
					"content": "J'ai fini par me perdre à l'extérieur de la ville. J'étais au milieu de nulle part, il n'y avait personne. J'ai eu de plus en plus peur et j'ai commencé à pleurer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200210
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200210,
					"content": "C'est alors que j'ai vu d'étranges créatures... Je ne me souviens pas à quoi elles ressemblaient. Je me rappelle seulement les avoir regardées et m'être rapidement arrêté de pleurer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200211
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200211,
					"content": "D'étranges créatures... Est-ce que ça pourrait être...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200212,
					"content": "(Les aranaras...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735200213
					]
				},
				{
					"id": 735200213,
					"content": "Ils m'ont amené sur les lieux du tournoi. Malheureusement, il était trop tard et l'épreuve était déjà terminée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200214
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200214,
					"content": "J'étais dépité. Quand soudain... J'ai vu une de ces créatures marcher lentement en traînant une couronne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200215
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200215,
					"content": "Elle était très belle et brillait au clair de lune. Je n'ai pas pu m'empêcher de la suivre. J'ai vu le petit bonhomme la cacher dans un creux d'arbre avant de disparaître.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200216
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200216,
					"content": "Je voulais la toucher. Mais à ce moment-là, j'ai entendu ma mère crier au loin. Elle avait réalisé que j'avais disparu, et avait demandé à nos voisins de partir à ma recherche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200217
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200217,
					"content": "Je n'ai jamais pu toucher la couronne. Ce n'est que lorsque j'ai vu le diadème de la connaissance au tournoi interdarshan une fois plus grand que j'ai réalisé qu'il s'agissait du même objet qu'à l'époque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200218
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200218,
					"content": "Je vois... Est-ce que tu te souviens de l'endroit où le diadème avait été posé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200219,
					"content": "Je crois que c'était dans la Forêt d'Avidya. J'y suis retourné plusieurs fois pour le chercher, mais je n'ai rien trouvé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200220
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200220,
					"content": "Personne ne me croirait, même si je le leur disais. Hélas, même moi, je ne m'en souviens pas clairement. Ce n'était peut-être qu'un rêve d'enfant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200221
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200221,
					"content": "#Hmm... {NICKNAME}, et si on allait voir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
