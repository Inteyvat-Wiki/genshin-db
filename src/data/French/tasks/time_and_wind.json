				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710121101,
					"content": "Le temps et le vent... Qu'est-ce qu'il a pu vouloir dire par là ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121102,
						710121106
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121102,
					"content": "« Le temps et le vent » ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710121103
					]
				},
				{
					"id": 710121103,
					"content": "Oh, oui, pardon. Ce sont les mots de mon ami dans sa dernière lettre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121104
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121104,
					"content": "D'après lui, « Mondstadt cache un secret dans le temps et le vent ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121105
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121105,
					"content": "Mais c'est la première fois que j'entends ce genre de chose, et je suis des environs... Qui sait où il a entendu ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121106,
					"content": "Vous avez étudié à Sumeru ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710121107
					]
				},
				{
					"id": 710121107,
					"content": "En effet. Je suis de Mondstadt, mais j'ai fait toutes mes études à l'Académie de Sumeru. J'y ai passé plus de temps qu'à Mondstadt, d'ailleurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121108
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121108,
					"content": "Vous voulez en savoir plus sur l'Académie ? Ma foi, il n'y a rien de secret... C'est, comment dire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121109
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121109,
					"content": "Rempli de gens étranges – disons « excentriques » pour ne blesser personne...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121110
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121110,
					"content": "Si vous avez l'occasion de vous y rendre un jour, vous comprendrez ce que je veux dire. Mais n'y restez pas trop longtemps par contre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henry Morton"
				}
			]
		},
