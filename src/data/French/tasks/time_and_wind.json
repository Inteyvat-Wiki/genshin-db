			"dialogs": [
				{
					"id": 710120101,
					"content": "« Les histoires soufflées par le vent deviennent mythes avec le temps. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120102
					],
					"speakerTitle": "Inscription abîmée"
				},
				{
					"id": 710120102,
					"content": "Qu'est-ce que ça peut vouloir dire... Aucune idée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710120103,
					"content": "Hum... N'empêche qu'on dirait bien qu'il doit y avoir un secret quelque part...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710120104,
					"content": "Allons jeter un œil dans le coin, peut-être qu'on trouvera des indices.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7101202,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
