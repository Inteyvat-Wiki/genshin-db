			"dialogs": [
				{
					"id": 710122401,
					"content": "Hé, d'où est-ce que ça sort ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710122402
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710122402,
					"content": "Comment vous avez fait ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710122403
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710122403,
					"content": "Eh bien...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710122404
					]
				},
				{
					"id": 710122404,
					"content": "Ah, c'était bien « le temps et le vent »...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710122405
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710122405,
					"content": "Il y a donc un cadran solaire identique à celui-ci sur l'île, c'est bien ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710122406
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710122406,
					"content": "Et la méthode pour résoudre l'énigme est la même ? Il doit y avoir un lien entre ces deux cadrans solaires et les deux lieux où ils se trouvent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710122407
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710122407,
					"content": "Il faut que je trouve le moyen d'aller sur cette île...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710122408
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710122408,
					"content": "#Merci, {M#voyageur}{F#voyageuse}. Je viendrai vous chercher quand je serai prêt, et nous irons faire un tour sur cette île.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henry Morton"
				}
			]
		}
