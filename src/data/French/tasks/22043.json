			"dialogs": [
				{
					"id": 220430301,
					"content": "#Hmm, ça devrait aller. Excusez-moi de vous avoir {M#importuné}{F#importunée} après tout ce chemin pour venir au sanctuaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430302
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430302,
					"content": "Une fois que je m'améliorerai en sculpture sur bois, je vous offrirai un de mes chefs-d'œuvre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430303
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430303,
					"content": "Dans quelle pose devrais-je sculpter la grande prêtresse suppléante...",
