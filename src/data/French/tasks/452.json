			"dialogs": [
				{
					"id": 4520201,
					"content": "Regardez devant ! Il se passe quelque chose !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520202
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520202,
					"content": "Ce ne sont pas des loups, mais des Brutocollinus qui attaquent les convois !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520203,
					"content": "Rien d'étonnant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520204
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520204,
					"content": "Assez parlé. Allons secourir cette malheureuse !",
					"roleType": "TALK_ROLE_NPC",
