			"dialogs": [
				{
					"id": 748000401,
					"content": "Pourquoi vous vous cachez ? Il n'y a rien dans le coin !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 748000402,
					"content": "Vous ne voyez pas le Gendarmek ? Il est juste devant nous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000403,
						748000404
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000403,
					"content": "Qu'est-ce qu'il a ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000405
					]
				},
				{
					"id": 748000405,
					"content": "Chut ! Dépêchez-vous de vous éloigner ! Et s'il perdait tout contrôle ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000406
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000406,
					"content": "Peut-être que... son noyau d'énergie va soudainement exploser ?! Si ça se trouve, quelqu'un le contrôle à distance pour nous attaquer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000407
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000407,
					"content": "Il a l'air tout à fait normal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000408
					]
				},
				{
					"id": 748000408,
					"content": "C'est exactement pourquoi ça me fait peur ! Un méka qui fonctionne normalement peut tout à coup devenir fou et une pauvre personne perd la vie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000409
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000409,
					"content": "Personne ne pourrait être tenu responsable de ça ! Le véritable coupable ne serait jamais retrouvé... Non, c'est juste trop dangereux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000410
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000410,
					"content": "Il est parti, vous pouvez sortir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 748000411,
					"content": "Pfiou... Il n'a pas vrillé, c'était inespéré. Nos vies ont été épargnées à nouveau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000412,
						748000413
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000412,
					"content": "Ce genre d'accident n'est simplement pas possible.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000414
					]
				},
				{
					"id": 748000414,
					"content": "Ce que j'avais en tête, c'était juste un « accident volontaire ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000415
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000415,
					"content": "Attendez. Un crime sans coupable... Un crime dont personne ne peut être purement tenu responsable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000416
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000416,
					"content": "Voilà ! Je tiens l'inspiration ! Vite, au café ! Je dois écrire tout ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000417
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000417,
					"content": "Hé, ralentissez ! Vous n'avez pas peur que quelqu'un vous jette des pierres ou vous fasse un croche-patte ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 748000413,
					"content": "Il n'allait rien se passer dès le début.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000414
					]
				},
				{
					"id": 748000404,
					"content": "Et donc ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000405
					]
				}
			]
		},
