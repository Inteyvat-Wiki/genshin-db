			"dialogs": [
				{
					"id": 748000501,
					"content": "Ah oui, c'est donc ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000502,
						748000503
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000502,
					"content": "Le café est en train de refroidir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000504
					]
				},
				{
					"id": 748000503,
					"content": "On a déjà terminé de boire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000504
					]
				},
				{
					"id": 748000504,
					"content": "#Merci de m'avoir escortée jusqu'ici, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000505
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000505,
					"content": "Vous escorter... On n'a rien fait à part marcher avec vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000506,
						748000507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 748000506,
					"content": "Rien de mal n'est arrivé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000508
					]
				},
				{
					"id": 748000507,
					"content": "Vous n'avez rencontré aucun danger.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000508
					]
				},
				{
					"id": 748000508,
					"content": "En effet, j'étais vraiment en train de trop y penser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000509
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000509,
					"content": "Le café est délicieux, haha... Ha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000510
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000510,
					"content": "... Dites, vous croyez qu'il est empoisonné ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000511,
						748000512
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000511,
					"content": "... Ugh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000513
					]
				},
				{
					"id": 748000512,
					"content": "Ça vous tuerait d'arrêter avec ces histoires ?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000513
					]
				},
				{
					"id": 748000513,
					"content": "Ne dites pas n'importe quoi ! On a fini notre tasse et rien ne nous est arrivé, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 748000514,
					"content": "Non non non, peut-être qu'il s'agissait d'une méthode spéciale d'empoisonnement ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000515
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000515,
					"content": "D'abord, le coupable ajoute un poison dans notre café.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000516
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000516,
					"content": "Ce poison seul n'a aucun effet sur nous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000517
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000517,
					"content": "Mais après avoir fini nos boissons, le coupable nous suit jusqu'à chez nous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000518
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000518,
					"content": "Et pendant notre sommeil, il rentre dans nos chambres et ajoute un autre poison dans nos bouteilles d'eau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000519
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000519,
					"content": "Le lendemain, nous prendrons une gorgée de cette bouteille d'eau et c'est là que les deux poisons se mélangeront et entreront en réaction l'un avec l'autre dans notre corps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000520
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000520,
					"content": "Et puis, nous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000521
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000599,
					"content": "Des pas rapides à l'approche se font entendre...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 748000521,
					"content": "Qu'est-ce que vous racontez, madame ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000522
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 748000522,
					"content": "Du café empoisonné ? Je vous prie d'éviter de raconter de telles âneries dans mon établissement !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000523
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 748000523,
					"content": "Je vais devoir vous demander de quitter les lieux si vous importunez les autres clients avec ces mensonges !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000524,
						748000525
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 748000524,
					"content": "Patron, laissez-moi vous expliquer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000526
					]
				},
				{
					"id": 748000525,
					"content": "C'est une amie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000526
					]
				},
				{
					"id": 748000526,
					"content": "Vous expliquez la situation de Guijarro à Arouet. Ce dernier part après la fin de votre récit, sans voix...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						748000527
					]
				},
				{
					"id": 748000527,
					"content": "Guijarro commande trois autres tasses de café pour se faire pardonner...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						748000528
					]
				},
				{
					"id": 748000528,
					"content": "Vous l'avez vu préparer le café cette fois ! Il n'a rien glissé dedans.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 748000529,
					"content": "Arrêtez de vous imaginer n'importe quoi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000530
					]
				},
				{
					"id": 748000530,
					"content": "Je sais... Mais j'ai trouvé beaucoup d'inspiration avec tous ces événements.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000531
					],
