			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718230201,
					"content": "Hmm, je vais bientôt être à court de plantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230202
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230202,
					"content": "Tu vas aller en ramasser ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718230203
					]
				},
				{
					"id": 718230203,
					"content": "Oui, j'étais sur le point de partir. Je prépare toujours un peu plus de remèdes que d'habitude à cette époque de l'année.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230204
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230204,
					"content": "Rien de particulièrement puissant, juste des médicaments pour traiter les fièvres ou les indigestions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230205
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230205,
					"content": "Pourquoi ne pas simplement aller au Cottage Bubu ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718230206
					]
				},
				{
					"id": 718230206,
					"content": "Le Cottage Bubu est trop loin. Ça me prendrait trop de temps d'aller au Port de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230207
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230207,
					"content": "#En plus, le Village de Qingce est surtout rempli d'enfants et de personnes âgées. Ils ne peuvent pas marcher aussi loin qu'{M#un aventurier}{F#une aventurière} comme toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230208
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230208,
					"content": "C'est pourquoi j'ai préparé quelques remèdes à l'avance, pour deux trois petites maladies mineures.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230209
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230209,
					"content": "Par contre, si quelqu'un contracte une maladie grave, on aura besoin d'une ordonnance, et il faudra aller au Cottage Bubu. *soupir* Mais bon, j'espère que ça n'arrivera pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230210
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230210,
					"content": "Bon, on pourra continuer à discuter plus tard. J'ai encore des herbes à ramasser, et puis je dois les préparer ensuite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230211
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230211,
					"content": "Allez, je t'aide.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718230212
					]
				},
				{
					"id": 718230212,
					"content": "Hein ? Vraiment ? Ce serait pas de refus ! Je me demandais justement combien de temps ça allait me prendre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230213
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230213,
					"content": "Attends, je regarde... J'ai encore besoin de trois plantes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230214
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230214,
					"content": "D'abord, il me faut une fleur de Qingxin... Tu sais, la fleur qui pousse sur les sommets des montagnes. C'est nourrissant et bon pour la digestion !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230215
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230215,
					"content": "Ensuite, il y a le lys calla, qu'on trouve le long des cours d'eau. Très utile pour réguler l'hydratation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230216
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230216,
					"content": "Ceux qui poussent le long de ces berges sont les meilleurs. C'est généralement là que j'en récupère. Le lys calla des autres endroits est bien moins efficace...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230217
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230217,
					"content": "Et enfin, j'aurai besoin d'un fruit du lotus... Un de ceux de l'étang voisin ! Transformés en remèdes, ils sont utilisés pour calmer les nerfs et renforcer le cœur. Par contre, c'est un peu compliqué... Il vaut mieux les collecter entre minuit et six heures du matin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhi"
				}
			]
		},
		{
			"id": 7182307,
