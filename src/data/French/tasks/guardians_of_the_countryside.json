			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718230901,
					"content": "Ah, te revoilà ! Tu as trouvé ce dont j'avais besoin ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230902
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230902,
					"content": "Oui, tout est là.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718230903
					]
				},
				{
					"id": 718230903,
					"content": "Merci pour ton aide ! J'ai aussi demandé l'aide de Xiaobai, on n'a qu'à se retrouver directement au moulin. Et n'oublie pas mes herbes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhi"
				}
			]
		},
		{
			"id": 7182310,
			"completionStepIds": [
				7182310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182310",
							"2"
						],
						"stepId": 7182310,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xiaobai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718231001,
					"content": "Bon, je m'occupe de ces plantes tout de suite... Comme ça, on peut préparer les concoctions plus vite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231002
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718231002,
					"content": "Merci bien. Maintenant, je dois trouver un moyen d'améliorer le goût. Sinon, les enfants du village refusent de les avaler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231003
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718231003,
					"content": "Vous êtes toujours aussi occupée à cette période de l'année ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718231004
					]
				},
				{
					"id": 718231004,
					"content": "Oui, à peu près... Après tout, il n'y a plus beaucoup de jeunes dans le Village de Qingce, alors on fait du mieux qu'on peut pour aider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231005
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718231005,
					"content": "Mais c'est surtout durant ces quelques jours qu'on est facilement débordé. Ça s'est passé bien plus facilement cette année grâce à ton aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231006
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718231006,
					"content": "Les années précédentes, je devais passer plusieurs jours à collecter ces plantes, sans parler du temps qu'il faut pour préparer les remèdes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231007
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718231007,
					"content": "En tout cas, merci pour ton aide ! On va aller s'occuper de tout ça, et puis je pourrai enfin préparer ma lanterne céleste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231008
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718231008,
					"content": "J'ai failli oublier d'en lâcher une l'année dernière... Je ne voudrais pas oublier cette année.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231009
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718231009,
					"content": "Quel est ton souhait ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718231010
					]
				},
				{
					"id": 718231010,
					"content": "Hmm... Que tous ceux du Village de Qingce restent en bonne santé... Probablement quelque chose comme ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231011
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718231011,
					"content": "Par contre, ça ne marche pas si on dit son souhait à voix haute... Alors, je ne te dirai rien de plus !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231012
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718231012,
					"content": "Tiens, voilà pour toi ! C'est pour te remercier pour ton aide aujourd'hui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhi"
				}
			]
		},
