				]
			},
			"dialogs": [
				{
					"id": 742510101,
					"content": "Merci pour l'invitation, mademoiselle Guillotin. Je suppose que cette eau pure a été préparée spécialement pour moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510102
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510102,
					"content": "Ne me remerciez pas, monsieur Neuvillette. Que l'iudex de Fontaine puisse se libérer pour venir partager une tasse, euh... d'eau avec moi est un honneur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510103
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742510103,
					"content": "Les Fatui ont-ils des affaires officielles dont vous souhaitez discuter, mademoiselle Guillotin ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510104
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510104,
					"content": "Pas du tout. Il s'agit plutôt d'une visite personnelle. Et pas besoin d'être si formel. Je voulais simplement vous poser des questions sur une vieille connaissance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510105
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742510105,
					"content": "Une vieille connaissance... Ah, vous parlez d'Alain Guillotin, n'est-ce pas ? Le grand maître-artificier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510106
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510106,
					"content": "Exactement. Quel genre d'homme était-il ? J'ai entendu dire qu'il a été votre subordonné dans sa jeunesse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510107
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742510107,
					"content": "Hm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510108
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510108,
					"content": "Monsieur Guillotin était un homme sincère et posé. Même après avoir reçu le titre de « Blanc cavalier de la protection », il n'a jamais fait preuve d'arrogance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510109
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510109,
					"content": "Il passait le plus clair de son temps à étudier les machines. Tout ce qui sortait de son domaine ne l'intéressait guère.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510110
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510110,
					"content": "Oh... Donc il était déjà comme ça quand il était plus jeune ? Difficile de dire s'il était mature... ou simplement détaché du monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510111
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742510111,
					"content": "Cependant... Il a changé radicalement après avoir perdu sa famille et ses amis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510112
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510112,
					"content": "La Tour de la gestalt ? Et Elynas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510113
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742510113,
					"content": "En effet. Lorsque nous avons signé ensemble l'ordre de fouiller la tour, il semblait... désemparé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510114
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510114,
					"content": "C'est l'éloignement et l'aliénation du passé qui ont mené à tout cela. Il devait aussi se sentir coupable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510115
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742510115,
					"content": "Hmm... Il est devenu encore plus taciturne après cela, et nos interactions se sont faites de plus en plus rares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510116
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510116,
					"content": "Lors de la cérémonie où il a reçu le titre de maître-artificier, il ne prononça qu'une seule phrase.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510117
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510117,
					"content": "« Une vie paisible et modeste permet de trouver plus facilement le bonheur que la poursuite aveugle d'une perfection sans fin. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510118
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510118,
					"content": "Ha... C'est exactement comme ça qu'il a vécu ses dernières années.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510119
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742510119,
					"content": "J'imagine que ces mots n'étaient pas seulement destinés aux autres... mais aussi à lui-même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510120
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742510120,
					"content": "Et vous, qu'en pensez-vous, mademoiselle Guillotin ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510121
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510121,
					"content": "Moi ? Hmm. Je ne porterai aucun jugement sur ses découvertes ou sa façon de vivre, tout comme il ne m'a jamais dit comment je devais vivre ma propre vie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510122
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742510122,
					"content": "Mais je n'ai aucune intention de suivre son chemin ou d'imiter ses idéaux. Je suis ma propre personne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510123
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742510123,
					"content": "Ah... Merci. Vous m'avez aidé à mieux le comprendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510124
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742510124,
					"content": "Je vous en prie. C'est un plaisir de partager des histoires du passé avec un membre de sa famille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neuvillette"
				}
			]
		},
