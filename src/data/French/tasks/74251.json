			},
			"dialogs": [
				{
					"id": 742510201,
					"content": "C'est aussi un plaisir de discuter de ces souvenirs avec vous autour de cette eau, mademoiselle Guillotin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510202,
						742510203
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510202,
					"content": "(Rester encore ici un moment.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510204
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742510204,
					"content": "Très bien. Je vous souhaite bon voyage, où que vous alliez ensuite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510203,
					"content": "L'heure du thé est terminée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510204
					],
					"speakerTitle": "Sandrone"
				}
			]
		}
	]
