			},
			"dialogs": [
				{
					"id": 402270101,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270102
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 402270102,
					"content": "Salut vous deux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270103,
					"content": "#{NICKNAME}, Paimon, bonjour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270104
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270104,
					"content": "On aide Nefer avec l'exposition, et on a entendu dire que la Knieperterie Cling-clang participait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270105,
					"content": "C'est exact. Aino fait juste une dernière vérification de la Brigade crac-boum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270106
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270106,
					"content": "Oh, c'est sa création pour l'exposition ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270107,
					"content": "Oui. Les taupes et autres petites créatures volent souvent des choses dans la Knieperterie, alors Aino a conçu un robot de défense inspiré de ces dernières pour protéger cet endroit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270108
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270108,
					"content": "Après des tests approfondis, ces robots se sont révélés très efficaces, alors elle a décidé de les améliorer et de les amener à l'exposition.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270109
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270109,
					"content": "Attends, Aino va vraiment vendre un de ses robots ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270110,
					"content": "Pas exactement. À quelques commandes spéciales près, Aino vend rarement ses produits finis. Ce qu'elle propose à l'exposition, ce sont les plans, pas le produit fini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270111
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270111,
					"content": "Ohhh... Alors, vous êtes prêtes à y aller ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270112,
					"content": "Jahoda nous a demandé d'accélérer un peu les choses. Elle vous a réservé un super bon emplacement, et elle s'inquiète que les gens commencent à poser des questions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270113,
					"content": "Je lui ai dit que je devais d'abord terminer le débogage ! Ça ne sert à rien de me presser, sinon je n'aurai rien à vendre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270114
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 402270114,
					"content": "Waouh, je n'ai jamais vu Aino aussi sérieuse avant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270115,
					"content": "La Knieperterie traverse une grave pénurie de fonds. Aino espère que l'exposition améliorera notre situation financière, alors elle est particulièrement méticuleuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270116
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270116,
					"content": "Où est passé tout l'argent ? Dans des recherches coûteuses ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270117,
					"content": "Négatif. Ce sont nos fonds pour les desserts qui manquent. Nous avons eu au moins 47 cas où des achats excessifs de desserts ont entraîné une pénurie de fonds de recherche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270118
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270118,
					"content": "C'est pourquoi j'ai décidé de séparer nos budgets de recherche et de desserts. Aino n'a pas le droit de puiser dans l'un pour transférer vers l'autre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270119
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270119,
					"content": "Très récemment, elle a épuisé tout le budget desserts de ce mois-ci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270120,
						402270121
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270120,
					"content": "Je vois...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402270122
					]
				},
				{
					"id": 402270122,
					"content": "Et voilà, c'est fait ! Brigade crac-boum, fais-moi honneur !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270123
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 402270123,
					"content": "On dirait qu'on peut y aller maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270121,
					"content": "Ça ne m'étonne pas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402270122
					]
				}
			]
		},
