			"dialogs": [
				{
					"id": 747080101,
					"content": "#Bonjour, {NICKNAME} et Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080102
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080102,
					"content": "Mademoiselle Guillotin m'a dit que vous teniez un océanarium. Naturellement, j'ai accepté son invitation à venir servir de consultante en biologie marine !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080103,
						747080104
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080103,
					"content": "Bienvenue !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747080105
					]
				},
				{
					"id": 747080105,
					"content": "Génial ! Avec l'infirmière en chef Sigewinne dans les parages, nous n'aurons pas à nous inquiéter de voir nos petits poissons tomber malades !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747080106,
					"content": "Héhé, depuis que vous m'avez demandé de m'occuper des animaux du Parc cinématographique de Chevalmarin, j'ai appris quelques petites choses...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080107
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080107,
					"content": "Finalement, prendre soin d'animaux et s'occuper de patients ont beaucoup de points communs. Enfin... surtout quand ils sont sages.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080108
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080108,
					"content": "#Mais cette fois, en plus d'exposer des poissons ordinaires, j'aimerais discuter avec {NICKNAME} d'un projet de guérison.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080109
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080109,
					"content": "Je vous écoute. Je suis tout ouïe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747080110
					]
				},
				{
					"id": 747080110,
					"content": "D'après l'officier Ceasth, certains poissons sauvages sont récemment devenus particulièrement agressifs. Ils attaqueraient les autres créatures, ainsi que les plongeurs et même les petites embarcations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080111
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080111,
					"content": "Je me demandais si on pourrait les inviter à l'Océanarium pour qu'ils se reposent un peu ? Au moins, ça les empêcherait de causer d'autres problèmes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080112
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080112,
					"content": "Une fois qu'ils seront ici, je pourrai chercher un moyen de soigner leur soudaine agressivité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080113
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080113,
					"content": "De cette façon, nous pourrons non seulement aider les poissons et les eaux à retrouver leur état normal, mais aussi ajouter des pensionnaires un peu particuliers à votre Océanarium.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080114
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080114,
					"content": "Quelle merveilleuse idée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747080115,
					"content": "Je vous soutiens totalement !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747080116
					]
				},
				{
					"id": 747080116,
					"content": "Très bien, je vais vous donner toutes les informations que j'ai sur l'endroit où trouver ces poissons agressifs. Je vous laisse vous occuper du reste !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080104,
					"content": "Votre aide nous sera précieuse !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747080105
					]
				}
			]
		}
	]
}