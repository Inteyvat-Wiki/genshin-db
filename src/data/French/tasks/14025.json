			},
			"dialogs": [
				{
					"id": 140250501,
					"content": "Arlecchino, de quoi parliez-vous exactement tout à l'heure ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250502,
					"content": "Vous avez mentionné des rivières, une vaste étendue d'eau... et puis de l'irrigation ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250503,
					"content": "Vous voulez vraiment savoir ce que c'était ? Il y a quand même des choses plus importantes dont vous devriez vous préoccuper...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250504
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250504,
					"content": "C'est vrai... J'espère que tout se passe bien pour Lyney...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250505,
					"content": "#{NICKNAME}, tu viens d'avoir une idée, là. Pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250506,
					"content": "(Arlecchino semble détendue, mais elle ne plaisantait pas tout à l'heure. Les enfants qui la trahiront seront tués.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250507
					]
				},
				{
					"id": 140250507,
					"content": "(Comment l'arrêter ? Non, il y a autre chose dont on doit s'occuper d'abord.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250508
					]
				},
				{
					"id": 140250508,
					"content": "(Pendant notre conversation devant le Palais Mermonia, elle a parlé de Clervie. Sait-elle de qui il s'agit depuis le début ? Peut-être qu'elle a deviné les actions de Lyney et des autres ?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250509
					]
				},
				{
					"id": 140250509,
					"content": "Ahh !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250510
					],
					"speakerTitle": "Horrer"
				},
				{
					"id": 140250510,
					"content": "Aïe... Ah, vous n'avez rien ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250511
					],
					"speakerTitle": "Horrer"
				},
				{
					"id": 140250511,
					"content": "Pardon, j'étais tellement concentré sur la vente des journaux que je ne regardais pas du tout où j'allais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250512,
						140250513
					],
					"speakerTitle": "Horrer"
				},
				{
					"id": 140250512,
					"content": "#{M#Désolé}{F#Désolée}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250514
					]
				},
				{
					"id": 140250514,
					"content": "Ah, prenez cet exemplaire en guise d'excuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250515
					],
					"speakerTitle": "Horrer"
				},
				{
					"id": 140250515,
					"content": "(J'ai l'impression de l'avoir déjà vu quelque part...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250516
					]
				},
				{
					"id": 140250516,
					"content": "Ah, mais on ne peut pas accepter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250517,
					"content": "J'insiste. J'en ai plein de toute façon et ces journaux ne me serviront à rien demain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250518
					],
					"speakerTitle": "Horrer"
				},
				{
					"id": 140250518,
					"content": "C'est ma faute. Je voulais gagner un peu d'argent en plus pour ma famille, mais peu de gens lisent les journaux de nos jours. Je n'ai toujours pas fini d'écouler mon stock.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250519
					],
					"speakerTitle": "Horrer"
				},
				{
					"id": 140250519,
					"content": "Que s'est-il passé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250520
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250520,
					"content": "#Tout va bien, j'ai juste bousculé votre {M#ami}{F#amie} sans le faire exprès. D'ailleurs, je vais y aller...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250521
					],
					"speakerTitle": "Horrer"
				},
				{
					"id": 140250521,
					"content": "Attends.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250522
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250522,
					"content": "Hum, j'aurais bien voulu vous donner des moras en compensation, mais je n'en ai pas sur moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250523
					],
					"speakerTitle": "Horrer"
				},
				{
					"id": 140250523,
					"content": "Je vais prendre trois journaux. Tiens, tes moras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250524
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250524,
					"content": "Ah ? Merci beaucoup ! Que les Archons vous rendent riche !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250525
					],
					"speakerTitle": "Horrer"
				},
				{
					"id": 140250525,
					"content": "Si seulement je pouvais tomber sur des gens aussi généreux que vous tous les jours... Non, plus sérieusement, je devrais juste prendre moins de journaux. Je me marie bientôt, alors je suis un peu nerveux... Bref, j'y vais ! Au revoir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250526
					],
					"speakerTitle": "Horrer"
				},
				{
					"id": 140250526,
					"content": "Maintenant que tout est réglé ici, retournons à Poisson en bateau. On a même de la lecture pour le trajet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250527
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250527,
					"content": "Attendez... Et si on restait encore un peu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250528,
					"content": "Je meurs de faim ! Pas question de rentrer à Poisson le ventre vide !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250529,
					"content": "(Paimon essaye de nous faire gagner du temps. Si nous rentrons maintenant, je doute que Lyney et les autres auront eu le temps de faire quoi que ce soit. Que faire...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250530
					]
				},
				{
					"id": 140250530,
					"content": "Si vous pensez que la situation vous sera plus favorable si vous repoussez notre départ, je crains que vous vous mettiez le doigt dans l'œil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250531
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250531,
					"content": "Mais si vous me promettez quelque chose, je pourrai accorder un peu plus de temps à Lyney.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250532
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250532,
					"content": "#Si vous acceptez, je vais même répondre à certaines de vos questions. Vous êtes {M#curieux}{F#curieuses} au sujet de Clervie, non ? Et de ma relation avec elle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250533
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250533,
					"content": "Pourquoi vous êtes aussi sympa tout à coup ? Vous n'allez quand même pas nous demander de faire quelque chose de mal par la suite ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250534
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250534,
					"content": "Vous vous surestimez. Vous n'avez pas ce talent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250535
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250535,
					"content": "Hum, mais dans ce cas, pourquoi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250536
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250536,
					"content": "Le plus important dans une négociation, c'est que les deux parties obtiennent ce qu'elles veulent. On n'y parvient pas avec les demandes et les menaces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250537
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250537,
					"content": "Dites-nous ce que vous voulez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250538
					]
				},
				{
					"id": 140250538,
					"content": "D'accord. Eh bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250539
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250539,
					"content": "Le moment venu, faites le choix que vous jugerez le plus adéquat par rapport à la situation et aidez le Foyer de l'âtre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250540
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250540,
					"content": "Bizarre, ce n'est rien d'extraordinaire... Mais que voulez-vous dire par « le moment venu » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250541
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250541,
					"content": "C'est à vous de décider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250542
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250542,
					"content": "Nous acceptons votre condition.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250543
					]
				},
				{
					"id": 140250543,
					"content": "Marché conclu, alors. Suivez-moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250513,
					"content": "Je n'ai pas fait attention non plus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250514
					]
				}
			]
		},
		{
