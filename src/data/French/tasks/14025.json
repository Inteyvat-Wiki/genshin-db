			"dialogs": [
				{
					"id": 140250201,
					"content": "Ah, c'est vous encore. Vous avez mauvaise mine, la nuit a été rude ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250202
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250202,
					"content": "Un peu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250203,
					"content": "Arrêtez de trop vous inquiéter si vous souhaitez passer une bonne nuit de sommeil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250204
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250204,
					"content": "Qu'avez-vous prévu de faire après ? Rattraper un peu de sommeil ou essayer de trouver un sujet de conversation avec moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250205
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250205,
					"content": "Je suis curieuse de savoir comment vous allez vous en sortir pour me retenir ici, maintenant que Tartaglia n'est plus là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250206
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250206,
					"content": "(!!!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250207
					]
				},
				{
					"id": 140250207,
					"content": "Nous ? Vous retenir ici ? Mais pas du tout, quelle idée ! On voulait juste papoter avec vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250208,
					"content": "Si vous n'avez toujours rien trouvé, que diriez-vous de m'accompagner quelque part ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250209
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250209,
					"content": "Ne vous en faites pas, nous n'allons pas croiser le chemin des petits garnements qui sont en train de faire des bêtises.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250210
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250210,
					"content": "Ah... La brise marine est agréable aujourd'hui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250211,
					"content": "Vous êtes au courant ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250212
					]
				},
				{
					"id": 140250212,
					"content": "Les enfants pensent pouvoir cacher des choses aux adultes, mais je vois tout, surtout les petits tours de ce genre. Je vais les laisser faire encore un peu, je suis quelqu'un de patient.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250213
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250213,
					"content": "Je vous laisse réfléchir. Si vous acceptez ma proposition, retrouvez-moi à l'extérieur du Palais Mermonia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250214
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250214,
					"content": "Soyez des enfants sages, vos amis vous en remercieront.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250215
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250215,
					"content": "Qu'est-ce qu'on fait maintenant ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250216,
					"content": "Arlecchino sait clairement ce qui se passe, non ? Et elle nous menace en plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250217,
					"content": "Libérons l'oiseau que Lyney nous a donné.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250218
					]
				},
				{
					"id": 140250218,
					"content": "Oui, en espérant qu'il le verra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250219,
					"content": "Bon, rendons-nous au Palais Mermonia. Si on n'y va pas, je pense que ça va barder pour nous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250220,
						140250221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250220,
					"content": "On n'a pas le choix...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250222
					]
				},
				{
					"id": 140250222,
					"content": "Dépêchons-nous, alors. Si on la fait trop attendre, ce sera la fin des haricots pour Lyney, Lynette et Fréminet !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250221,
					"content": "On verra comment ça se passera.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250222
					]
				}
			]
		},
