			"dialogs": [
				{
					"id": 140250301,
					"content": "Nous avons encore un peu de temps avant mon rendez-vous. Discutons un peu en attendant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250302
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250302,
					"content": "Je suis ravie que vous vous entendiez avec mes enfants. Avoir de bonnes fréquentations est essentiel pour qu'ils se développent comme il faut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250303
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250303,
					"content": "Vous n'allez rien leur faire, j'espère ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250304,
					"content": "J'imagine que vous parlez de Lyney, Lynette et Fréminet...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250305
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250305,
					"content": "Il y a aussi Filliol, Nanteuil... Ça en fait du beau monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250306
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250306,
					"content": "Enfin, je ne réserve aucun traitement de faveur quand on me trahit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250307
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250307,
					"content": "Vous... Vous allez les tuer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250308,
					"content": "Vous allez implorer ma clémence ? Désolée de vous décevoir, mais les règles sont sans exception. Chacun est responsable de ses actes au sein du Foyer de l'âtre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250309
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250309,
					"content": "Vous ne vous souciez pas d'eux ?! Ils vous respectent du fond du cœur et vous appellent même « Père » !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250310,
					"content": "Une organisation où les sentiments l'emportent sur les règles est vouée au déclin. C'est encore plus vrai pour la nôtre qui est réputée pour être intransigeante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250311
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250311,
					"content": "#En guise de consolation, je peux vous assurer que vous ne subirez pas le même sort qu'eux. Vous êtes des {M#invités}{F#invitées} après tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250312
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250312,
					"content": "Il n'y a pas d'autre solution ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250313
					]
				},
				{
					"id": 140250313,
					"content": "Lyney, Lynette et Fréminet pourront rester en vie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250314
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250314,
					"content": "Quant à Filliol, Nanteuil et les autres... Ils veulent s'enfuir, alors je ne peux pas y faire grand-chose. Personne ne peut partir en vie avec nos secrets.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250315
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250315,
					"content": "C'est trop cruel...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250316,
					"content": "Bon, rien que pour vous, je vais continuer à faire semblant de ne rien savoir encore un peu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250317
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250317,
					"content": "Si Lyney et les autres arrivent à se débarrasser de Clervie pendant ce temps-là, cela effacera toute trace de leur méfait. Je ne pourrais pas les punir sans preuve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250318
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250318,
					"content": "Mais s'ils échouent, ils feront face aux conséquences de leurs actes et recevront une sévère punition.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250319,
						140250320
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250319,
					"content": "Très bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250321
					]
				},
				{
					"id": 140250321,
					"content": "Bien sûr. Ah, je crois que cela vous appartient. Ne le perdez plus à l'avenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250322
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250322,
					"content": "Dresser un oiseau comme celui-ci demande énormément de temps. Ce serait dommage qu'il lui arrive quelque chose de fâcheux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250323
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250323,
					"content": "Attendez, mais où l'avez-vous trouvé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250324,
					"content": "Eh bien, assez bavardé. C'est l'heure des choses sérieuses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250325
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250325,
					"content": "Je vous ai demandé de me retrouver ici parce que j'ai une affaire à régler au Palais Mermonia. Cela ne vous concerne pas, mais je vous invite à rester avec moi pour l'instant. N'allez pas tout dire à Lyney tout de suite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250326
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250326,
					"content": "C'est l'heure d'y aller. La chute de l'histoire va bientôt se produire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250320,
					"content": "J'espère que vous tiendrez parole.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250321
					]
				}
			]
		},
		{
			"id": 1402504,
