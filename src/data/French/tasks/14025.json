			"dialogs": [
				{
					"id": 140250102,
					"content": "Tout le monde est là maintenant. Bon, aujourd'hui, on continue le plan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250103,
						140250104
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140250103,
					"content": "Mais avant cela...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250105
					]
				},
				{
					"id": 140250105,
					"content": "Oui ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250106
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 140250106,
					"content": "Est-ce qu'Arlecchino a déjà travaillé avec Dottore ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250107
					]
				},
				{
					"id": 140250107,
					"content": "Pourquoi cette question ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250108
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140250108,
					"content": "En fait, on a croisé Clervie hier soir et elle nous a dit que c'était le cas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250109,
					"content": "On a rencontré Dottore à Sumeru, c'est un type super dangereux ! Et il a commis des tonnes d'atrocités !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250110,
					"content": "... Je ne peux pas dire qu'ils ne se sont jamais parlés, mais je ne pense pas que Père travaillerait avec lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250111
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140250111,
					"content": "Nous ne sommes pas vraiment de la même faction, alors je doute qu'ils se fassent confiance. Ce n'est pas possible de collaborer sans cette condition.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250112
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140250112,
					"content": "Par contre, j'ai entendu dire que Dottore a proposé à Père de travailler avec le Foyer de l'âtre quand elle est devenue une Exécutrice des Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250113
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140250113,
					"content": "Père a refusé la plupart de ses propositions, sauf une seule qui concernait une expérience secrète.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250114
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140250114,
					"content": "Une expérience secrète ? C'est ce dont parlait Clervie ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250115,
					"content": "Je ne pense pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250116
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 140250116,
					"content": "J'ignore ce qu'est cette expérience, mais je sais qu'il s'agit d'une mission indépendante de Dottore. Il nous a seulement proposé d'adopter une certaine direction pour la recherche, alors ce n'est pas une collaboration à proprement parler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250117
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140250117,
					"content": "Les détails de l'expérience sont confidentiels, mais il y a des dossiers complets sur tous les participants. Ce n'est pas le cas dans la situation que Clervie a évoquée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250118
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140250118,
					"content": "Faites-moi confiance. Je sais que certaines de nos actions en tant que Fatui sont répréhensibles pour vous, mais le Foyer de l'âtre a ses propres principes et des limites à ne pas dépasser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250119
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140250119,
					"content": "Pfiou, je suis quand même contente de l'entendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250120,
					"content": "Clervie semble croire qu'Arlecchino et Dottore ont collaboré pour commettre des horreurs. Si c'était vrai, je ne saurais pas comment vous faire face...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250121,
					"content": "Est-ce que Clervie ment ? Personnellement, je n'en ai pas l'impression...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250122,
					"content": "Le plus simple serait de poser la question directement à Arlecchino, mais je ne crois pas qu'elle nous répondra aussi facilement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250123,
					"content": "Concentrons-nous sur le plan pour l'instant.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250124
					]
				},
				{
					"id": 140250124,
					"content": "Père n'est pas revenue la nuit dernière. Elle est probablement encore sur le rivage, on compte sur vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250125
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140250125,
					"content": "Lynette, viens avec moi. Fréminet, fais attention à toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250126
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140250126,
					"content": "C'est parti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140250104,
					"content": "J'ai une question.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250105
					]
				}
			]
		},
