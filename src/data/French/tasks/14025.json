			"dialogs": [
				{
					"id": 140250801,
					"content": "Où allons-nous aujourd'hui ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250802
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 140250802,
					"content": "Essayons d'aller un peu plus loin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lyney"
				}
			]
		},
		{
			"id": 1402510,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1402505",
							"2"
						],
						"stepId": 1402505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Neuvillette"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 140251001,
					"content": "Je crois vous avoir déjà dit que mes émotions résonnent facilement avec celles des autres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140251002
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 140251002,
					"content": "Cependant, je n'ai pas été capable de percevoir quoi que ce soit de la part de cette Exécutrice malgré le fait de l'avoir vue plusieurs fois. Son esprit est semblable à des eaux calmes. Personne ne sait ce qui se cache dans leurs profondeurs, mais l'absence d'ondulations à la surface ne laisse rien paraître.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140251003
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 140251003,
					"content": "Je ne sais pas si c'est sa vraie nature ou si elle fait preuve d'une forme incroyable qui lui permet de maîtriser ses émotions. En tout cas, cela indique qu'il s'agit d'une personne très dangereuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140251004
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 140251004,
					"content": "Je ne vous demanderai pas de m'expliquer votre présence à ses côtés, mais je vous conseille de faire attention à vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neuvillette"
				}
			]
		}
	]
}