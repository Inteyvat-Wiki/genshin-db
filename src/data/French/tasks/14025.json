					}
				]
			},
			"dialogs": [
				{
					"id": 140250401,
					"content": "Notre dernière rencontre remonte à loin, monsieur Neuvillette.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250402
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250402,
					"content": "Je ne pensais pas que ma demande de rendez-vous serait aussi vite approuvée. Le Palais Mermonia est d'une efficacité impressionnante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250403
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250403,
					"content": "Une diplomate de votre réputation se doit d'être traitée avec le respect qu'elle mérite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250404
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 140250404,
					"content": "Tout de même, je dois avouer que je ne pensais plus vous revoir après vous avoir remis le Gnosis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250405
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 140250405,
					"content": "#... Je vois que vous êtes venue avec {NICKNAME} et Paimon. Pouvez-vous m'en dire plus sur la raison de votre visite ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250406
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 140250406,
					"content": "Je vais bientôt quitter Fontaine, mais j'aimerais régler une certaine affaire avant de pouvoir partir l'esprit tranquille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250407
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250407,
					"content": "Ce n'était pas quelque chose que je pouvais résumer en quelques mots, alors je me suis permis de tout écrire en détail dans cette proposition que je vous invite à lire, monsieur Neuvillette.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250408
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250408,
					"content": "Arlecchino remet le document et prend une gorgée de sa tasse d'une manière élégante.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						140250409
					]
				},
				{
					"id": 140250409,
					"content": "Je comprends votre demande, mais sauf votre respect, je n'arrive pas à voir pourquoi vous souhaiteriez cela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250410
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 140250410,
					"content": "J'ai ouï dire que vous aimez la dégustation d'eau, monsieur Neuvillette. Dans ce cas, permettez-moi d'utiliser l'analogie de l'eau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250411
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250411,
					"content": "Une famille est comme une vaste étendue d'eau où des rivières convergent ou prennent source.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250412
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250412,
					"content": "J'observe cette étendue tous les jours en espérant que chaque rivière qui en part puisse atteindre l'océan un jour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250413
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250413,
					"content": "D'un point de vue objectif, je sais que c'est impossible. La plupart d'entre elles s'assécheront avant et seront absorbées par la terre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250414
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250414,
					"content": "Cependant, je pense que l'existence de ces rivières qui n'arrivent pas à se jeter dans l'océan a quand même un sens. Peut-être que leur eau irriguera des champs ou finira dans le verre d'un amateur de dégustation d'eau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250415
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250415,
					"content": "#Tu as compris quelque chose, {NICKNAME} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250416,
						140250417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250416,
					"content": "Pas vraiment...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250418
					]
				},
				{
					"id": 140250418,
					"content": "Vous voyez les choses de façon optimiste, mais je vous rappelle que peu sont enclins à prendre une gorgée d'eau boueuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250419
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 140250419,
					"content": "Elle a peut-être été salie, mais ne vous en faites pas. Je m'assurerai de bien la filtrer pour me débarrasser de ses impuretés et la rendre la plus propre possible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250420
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250420,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250421
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 140250421,
					"content": "Votre proposition présente un aspect transactionnel, pourriez-vous m'en dire plus ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250422
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 140250422,
					"content": "Si vous acceptez ma proposition, monsieur Neuvillette, je vais progressivement retirer mes forces de Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250423
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250423,
					"content": "Sauf en cas de nécessité absolue, je ne mènerai plus de « missions spéciales » à Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250424
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250424,
					"content": "Je suppose que vous voulez dire qu'il n'y aura plus d'incident comme l'assassinat de Tartuffe à l'avenir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250425
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 140250425,
					"content": "Cet escroc qui a détourné les fonds d'associations de charité ? Je suis désolée de ce qu'il lui est arrivé, mais aucune preuve n'incrimine le Foyer de l'âtre dans cette affaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250426
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250426,
					"content": "Bien sûr, je suis certaine que des mesures seront prises pour éviter que ce genre de situations ne se reproduise si vous acceptez ma proposition.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250427
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250427,
					"content": "Vous savez comment négocier. Très bien, j'accepte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250428
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 140250428,
					"content": "Je vous remercie pour votre générosité, monsieur Neuvillette.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250429
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250429,
					"content": "Maintenant que cette affaire est réglée, nous devrions rentrer. J'ai ramené deux bouteilles d'eau de source de Snezhnaya pour vous les offrir. Vous me direz ce que vous en aurez pensé à notre prochaine rencontre, j'espère.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250430
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250430,
					"content": "Sans faute. N'oubliez pas votre promesse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250431
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 140250431,
					"content": "#{NICKNAME}, Paimon, c'est l'heure d'y aller.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250417,
					"content": "À moitié...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250418
					]
				}
			]
		},
