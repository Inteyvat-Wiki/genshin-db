			"dialogs": [
				{
					"id": 710350101,
					"content": "Qu'est-ce qui vous ferait plaisir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350102
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 710350102,
					"content": "Trois portions de poisson chihu grillé à emporter, s'il vous plaît.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350103
					]
				},
				{
					"id": 710350103,
					"content": "C'est parti ! Attendez un moment, ce sera bientôt prêt !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350104
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 710350104,
					"content": "Trois portions ? Une pour toi, une pour moi... C'est pour qui la dernière part ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350105,
						710350106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350105,
					"content": "Allons voir Pervases avec cette dernière portion.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350107
					]
				},
				{
					"id": 710350107,
					"content": "Tu veux dire le Pervases qui nous a donné les sept lampes des étoiles et l'encensoir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350108,
					"content": "Ah oui, c'est vrai. Il a dit que le goût du poisson chihu grillé lui manquait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350109,
					"content": "Mais il n'est pas déjà parti ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350110,
					"content": "Eh bien, on peut toujours essayer de lui rendre visite.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350111
					]
				},
				{
					"id": 710350111,
					"content": "Oui, tu as raison. Allons le voir alors !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350112,
					"content": "Lorsqu'on avait rencontré Pervases, le temple était en mauvais état et il y avait des Pilleurs de trésors dans le coin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350113,
					"content": "Espérons que sa statue n'a pas été abîmée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350114,
					"content": "Vos trois portions de poisson chihu grillé. Elles sont à vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350115
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 710350115,
					"content": "#Ohh, ça sent tellement bon ! Allez, {NICKNAME}. On y va !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350106,
					"content": "Pervases adore le poisson chihu grillé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350107
					]
				}
			]
		},
