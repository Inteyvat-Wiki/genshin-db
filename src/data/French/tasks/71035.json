			"dialogs": [
				{
					"id": 710350301,
					"content": "#Merci, Ô puissant Adepte, merci à vous, {M#puissant héros}{F#puissante héroïne} ! ... Oh, quelle chance de vous retrouver !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350302
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350302,
					"content": "Vous nous connaissez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350303,
					"content": "Comment aurais-je pu vous oublier...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350304
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350304,
					"content": "Vous êtes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350305
					]
				},
				{
					"id": 710350305,
					"content": "Je suis Wang Ping'an ! Vous vous souvenez de moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350306,
						710350308
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350306,
					"content": "Ah, le « Céleste voleur d'étoiles » ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350307
					]
				},
				{
					"id": 710350307,
					"content": "Hein ?! Quoi ? Comment ça « voleur d'étoiles » ? ... Vous voulez me faire tuer ou quoi ? L'Adepte est là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350310
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350310,
					"content": "Je m'apprêtais à aller au temple du Yaksha Pervases.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350311
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350311,
					"content": "Mais peu de temps après être rentré dans les montagnes, j'ai été attaqué par ces Pilleurs de trésors... Merci de m'avoir sauvé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350312
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350312,
					"content": "Attendez un moment. Qu'est-ce que vous vouliez faire au temple de Pervases ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350313,
					"content": "Est-ce que vous aviez l'intention de faire quelque chose à sa statue ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350314,
					"content": "Non, non ! Bien sûr que non !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350315
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350315,
					"content": "Alors qu'est-ce que vous vouliez faire ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350316
					]
				},
				{
					"id": 710350316,
					"content": "Je... voulais restaurer le temple.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350317
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350317,
					"content": "Je prévoyais d'examiner la situation aujourd'hui et d'arranger l'achat des matériaux nécessaires.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350318
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350318,
					"content": "Je n'avais pas prévu que les Pilleurs de trésors me sautent dessus à mi-chemin et que je doive fuir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350319
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350319,
					"content": "Mais je me suis perdu en courant... Pour ce qui est du reste, vous savez ce qu'il s'est passé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350320
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350320,
					"content": "Continuons la discussion au temple.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350321
					]
				},
				{
					"id": 710350321,
					"content": "En effet, cet endroit n'est pas tellement propice à la conversation. Allons d'abord au temple.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350322
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350322,
					"content": "On pourra discuter là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350323
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350323,
					"content": "Allez-y. J'ai d'autres choses à régler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350324
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 710350324,
					"content": "Hein ? Vous partez déjà ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350325,
					"content": "... Il est déjà parti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350308,
					"content": "Oui, je me souviens de vous.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350309
					]
				},
				{
					"id": 710350309,
					"content": "Ah, bien, bien.",
