			"dialogs": [
				{
					"id": 700160101,
					"content": "... Yaya dala ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160102
					],
					"speakerTitle": "Brutocollinus"
				},
				{
					"id": 700160102,
					"content": "Mimi tomo, mimi mosi mita, Muhe mita ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160103
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700160103,
					"content": "Mita...? Gusha... Dada ika odomu Plata mimi, mimi mosi gusha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160104
					],
					"speakerTitle": "Brutocollinus"
				},
				{
					"id": 700160104,
					"content": "Mimi tomo, mimi plata yaya ika ! Mimi mani ye !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160105
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700160105,
					"content": "Mani...? Dada ! Kundala zido mi, mi dada, mimi tomo !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160106
					],
					"speakerTitle": "Brutocollinus"
				},
				{
					"id": 700160106,
					"content": "Ils discutent bien joyeusement, dis donc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160107,
						700160108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700160107,
					"content": "Comme on peut s'y attendre de la part d'Ella...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700160109
					]
				},
				{
					"id": 700160109,
					"content": "En fait, il n'aime pas trop discuter... Mais j'ai déjà demandé ce qu'on voulait savoir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160110
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700160110,
					"content": "Il suffit de l'aider à vaincre ses ennemis. Alors, je compte sur toi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160111
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700160111,
					"content": "Dada, Valo !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Brutocollinus"
				},
				{
					"id": 700160108,
