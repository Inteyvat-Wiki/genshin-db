			"dialogs": [
				{
					"id": 750711001,
					"content": "#Haha ! {M#Mes chers}{F#Mes chères} {NICKNAME} et Paimon, {M#ma source d'inspiration et euh... Ma mini-muse}{F#ma muse et euh... Ma mini-muse} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711002
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711002,
					"content": "#Ah et {REALNAME[ID(2)|SHOWHOST(true)]}, bien sûr !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711003
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711003,
					"content": "C'est qui mini-machin ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711004,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711005
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750711005,
					"content": "Haha, n'y prêtez pas attention.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711006
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711006,
					"content": "Mais ça me dérange, moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711007,
						750711011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711007,
					"content": "Vous avez l'air inspiré à nouveau ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750711008
					]
				},
				{
					"id": 750711008,
					"content": "Bien sûr ! Cependant... Héhé, ça veut dire que j'ai encore besoin de votre aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711009
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711009,
					"content": "Pas de problème ! Vous nous payez à chaque fois de toute façon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711010,
					"content": "Haha ! Merveilleux, petite mercenaire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711017
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711017,
					"content": "Cette fois-ci, je veux prendre une photo d'un tepetlisaure... Chut. Nous ne voudrions pas les déranger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711018
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711018,
					"content": "C'est la première fois que j'interagis avec ce genre de saurien, mais ça fait un moment que je les observe... Ce sont des créatures vraiment fascinantes, chacune possède une personnalité unique sous sa carapace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711019
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711019,
					"content": "Ceux-ci ont appris quelques ordres de base après avoir été nourris plusieurs fois, héhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711020
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711020,
					"content": "#J'aurai besoin de votre aide, {M#chers maîtres-dompteurs}{F#chères maîtresses-dompteuses} de sauriens, pour l'emmener avec nous et prendre une photo de lui en train d'interagir avec d'autres tepetlisaures.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711021
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711021,
					"content": "C'est simple, pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711022
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711022,
					"content": "Oui !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711023,
						750711024
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711023,
					"content": "(Facile à dire quand ce n'est pas toi qui t'en occupes...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750711025
					]
				},
				{
					"id": 750711025,
					"content": "Haha ! Oui, c'est ça ! Allez, aidez-moi à trouver un petit tepetlisaure avant de nous mettre au travail !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711024,
					"content": "(Pas aussi simple qu'on pourrait le croire !)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750711025
					]
				},
				{
					"id": 750711011,
					"content": "Avez-vous à nouveau besoin de vos « amuse-bouches » ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750711012
					]
				},
				{
					"id": 750711012,
					"content": "« Amuse-bouches »... Ça me donne faim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711013
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711013,
					"content": "Kuru... Kuru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711014
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750711014,
					"content": "Euh, vous voulez dire « muses », non ? Ce n'est pas de la nourriture !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711015
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711015,
					"content": "Tant que vous payez, on pourra s'acheter de la nourriture !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711016,
					"content": "Si vous le dites, Paimon... En effet, j'ai de l'argent, alors ne vous inquiétez pas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711017
					],
					"speakerTitle": "Magnifico"
				}
			]
		},
