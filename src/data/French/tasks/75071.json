			"dialogs": [
				{
					"id": 750711101,
					"content": "Avez-vous vu ? Notre petit bonhomme semble avoir remarqué quelque chose... Sa famille, peut-être ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711102
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711102,
					"content": "Il est parti ! Allez, suivons-le ! On ne peut pas se permettre de perdre sa trace !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnifico"
				}
			]
		},
