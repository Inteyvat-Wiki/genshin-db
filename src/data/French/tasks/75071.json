			"dialogs": [
				{
					"id": 750711321,
					"content": "Vous avez battu l'ennemi et brisé la cage qui emprisonnait la bête de somme. Elle bondit hors de la cage en poussant un cri de joie.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750711301
					]
				},
				{
					"id": 750711301,
					"content": "Ouah... Pfiou ! C'est fini. Quelle adrénaline !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711302,
					"content": "Chut ! Regardez !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711303
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711303,
					"content": "*clic*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711304
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711304,
					"content": "Parfait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711305
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711305,
					"content": "Ouah, ils s'entendent bien... Et moi qui pensais que la bête de somme allait se faire dévorer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711306,
					"content": "Héhé, les apparences sont trompeuses. Les tepetlisaures ont l'air féroces, mais ils ont un caractère très doux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711307
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711307,
					"content": "Voilà la photo que j'ai prise, et votre exemplaire. Ah oui, sans oublier votre rémunération. Tenez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711308
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711308,
					"content": "*soupir* Je pensais immortaliser un moment intime entre un petit tepetlisaure et un adulte, mais la bête de somme a eu une longueur d'avance !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711309
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711309,
					"content": "Héhé ! Les bêtes de somme ne sont pas aussi désagréables ! Je suis sûre que vous le savez aussi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711310,
					"content": "Peu importe mon opinion, c'est l'avis du comité de photographie qui compte !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711311
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711311,
					"content": "Par contre... C'est peut-être dangereux de laisser notre petite bête de somme se promener dans un environnement qui lui est étranger, comme celui de Natlan. En plus, il se trouve que j'ai besoin d'un partenaire pour m'aider à porter des choses...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711312
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711312,
					"content": "Haha, je suppose que je n'ai pas d'autre choix que de l'adopter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711313
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711313,
					"content": "Et son propriétaire, alors ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711314,
					"content": "Hmph, c'est sa faute d'avoir laissé la pauvre bête dans un endroit aussi dangereux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711317
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711317,
					"content": "Bref, assez parlé de ça ! Galeries de photos de Fontaine, me voilà ! Vous me rendrez visite aussi le moment venu, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711318
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711318,
					"content": "#Toutes mes excuses, mais je dois quitter cette nation immédiatement. Au revoir, {NICKNAME}, Paimon ! Au revoir, mon petit !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711319
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711319,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711320
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750711320,
					"content": "Ah, attrapez ! C'est un souvenir pour ne pas m'oublier !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnifico"
				}
			]
