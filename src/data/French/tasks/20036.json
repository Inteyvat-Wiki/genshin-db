			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gloria"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200360101,
					"content": "Godwin... Qu'est-ce qui te prend autant de temps ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360102
					],
					"speakerTitle": "Gloria"
				},
				{
					"id": 200360102,
					"content": "Bonjour...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360103
					]
				},
				{
					"id": 200360103,
					"content": "#Cette voix... C'est vous, {M#Voyageur}{F#Voyageuse} ? Que Barbatos soit loué, le vent vous a sûrement {M#mené}{F#menée} à moi. J'aurais un service à vous demander...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360104
					],
					"speakerTitle": "Gloria"
				},
				{
					"id": 200360104,
					"content": "Hum... Godwin, mon petit ami, est un chevalier de l'Ordre de Favonius et ça fait longtemps qu'il n'est pas revenu de mission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360105
					],
					"speakerTitle": "Gloria"
				},
				{
					"id": 200360105,
					"content": "Je n'ai plus aucune nouvelle de lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360106
					],
					"speakerTitle": "Gloria"
				},
				{
					"id": 200360106,
					"content": "Je me fais un sang d'encre pour lui. Mon pauvre chéri... Si ça se trouve, des Brutocollinus s'en sont pris à lui ? L'Ordre de l'Abîme l'aurait peut-être gravement blessé ? Sinon, il pourrait s'être entiché d'une autre femme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360107
					],
					"speakerTitle": "Gloria"
				},
				{
					"id": 200360107,
					"content": "P—Pardon ! Je me suis emportée ! Ma mère me dit toujours que les graines de pissenlit peuvent porter les pensées des gens jusqu'à des contrées lointaines...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360108
					],
					"speakerTitle": "Gloria"
				},
				{
					"id": 200360108,
					"content": "J'ai une faveur à vous demander. Pouvez-vous me ramener trois graines de pissenlit de Ventlevé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360109,
						200360110
					],
					"speakerTitle": "Gloria"
				},
				{
					"id": 200360109,
					"content": "Bien sûr.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360111
					]
				},
				{
					"id": 200360111,
					"content": "Merci beaucoup ! Que Barbatos vous bénisse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gloria"
				},
				{
					"id": 200360110,
					"content": "#Je suis {M#occupé}{F#occupée}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360112
					]
				},
				{
					"id": 200360112,
					"content": "#Je vous en prie ! Ce n'est rien pour {M#un voyageur expérimenté}{F#une voyageuse expérimentée} comme vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gloria"
				}
			]
		},
		{
