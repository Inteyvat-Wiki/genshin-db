			"dialogs": [
				{
					"id": 200360301,
					"content": "C'est bon ? Vous l'avez fait ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360302
					],
					"speakerTitle": "Gloria"
				},
				{
					"id": 200360302,
					"content": "Le vent soufflait si fort au sommet...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360303
					]
				},
				{
					"id": 200360303,
					"content": "Tant mieux, les graines pourront voyager longtemps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360304
					],
					"speakerTitle": "Gloria"
				},
				{
					"id": 200360304,
					"content": "Elles auront plus de chances d'atteindre les oreilles de Godwin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360305
					],
					"speakerTitle": "Gloria"
				},
				{
					"id": 200360305,
					"content": "Prenez donc ce cadeau de remerciement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360306
					],
					"speakerTitle": "Gloria"
				},
				{
					"id": 200360306,
					"content": "Il y a encore tant de choses que je voudrais lui dire. Je solliciterai certainement de nouveau votre aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gloria"
				}
			]
		}
