				"points": []
			},
			"dialogs": [
				{
					"id": 200360201,
					"content": "Bonjour ! Avez-vous pu trouver mes graines de pissenlit ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360202
					],
					"speakerTitle": "Gloria"
				},
				{
					"id": 200360202,
					"content": "Oui, tout est là.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360203
					]
				},
				{
					"id": 200360203,
					"content": "Merci encore ! Pourriez-vous les déposer dans ma main ? Je les perdrai sinon... Je suis aveugle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360204
					],
					"speakerTitle": "Gloria"
				},
				{
					"id": 200360204,
					"content": "Le compte est bon ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360205
					]
				},
				{
					"id": 200360205,
					"content": "Pourriez-vous les déposer dans ma main ? C'est la seule manière que j'ai de le savoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360206
					],
					"speakerTitle": "Gloria"
				},
				{
					"id": 200360206,
					"content": "Tout est bon. Je n'ai plus qu'à leur dire le message qu'ils doivent passer à Godwin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360207
					],
					"speakerTitle": "Gloria"
				},
				{
					"id": 200360207,
					"content": "Euh, bouchez-vous les oreilles, s'il vous plaît. Et n'essayez pas d'écouter en cachette ! Ce sont des paroles qui ne sont destinées qu'à mon amant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360208
					],
					"speakerTitle": "Gloria"
				},
				{
					"id": 200360208,
					"content": "C'est bon, j'ai fini. Une dernière chose : Prenez-les avec vous et lâchez-les au sommet de la statue de l'Archon Anémo. Merci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360209
					],
					"speakerTitle": "Gloria"
				},
				{
					"id": 200360209,
					"content": "J'espère qu'il saura transporter mes mots à Godwin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gloria"
				}
			]
		},
