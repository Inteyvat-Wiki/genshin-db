						],
						"pointId": 310400536
					}
				]
			},
			"dialogs": [
				{
					"id": 401490201,
					"content": "... C'est délicieux ! C'est parfaitement assaisonné, et même le riz est savoureux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490202
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490202,
					"content": "Rien de tel qu'un bon repas bien chaud sorti tout droit de la marmite... Ça m'avait manqué !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490203
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490203,
					"content": "Haha, vous venez de ridiculiser les meilleures rations de l'Ordre de Favonius, et ce n'est pas peu dire... Alors dites-nous, comment s'appelle ce plat ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490204
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401490204,
					"content": "Il s'appelle... Euh... J'imagine que l'« En-vrac » ne fera pas l'affaire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490205,
					"content": "... Je ne sais pas du tout comment décrire ce plat ! Il n'a pas de nom, ce ne sont que des ingrédients ordinaires, cuisinés très simplement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490206,
					"content": "Des ingrédients ordinaires, cuisinés très simplement ? Vraiment ? J'aurais juré que vous y aviez ajouté un ingrédient particulier, ou que vous lui aviez donné une sorte de touche magique du chef...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490207,
						401490208
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490207,
					"content": "Ce n'est pas le plat le plus fin de tout Teyvat...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490209
					]
				},
				{
					"id": 401490208,
					"content": "Mais c'est sans doute celui dont vous aviez besoin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490209
					]
				},
				{
					"id": 401490209,
					"content": "Pas le plat le plus fin, mais celui dont ils avaient besoin...? Qu'est-ce que ça veut dire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490210,
						401490211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490210,
					"content": "Vous êtes sur la route depuis un moment...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490212
					]
				},
				{
					"id": 401490211,
					"content": "Et vous n'avez mangé que des rations...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490212
					]
				},
				{
					"id": 401490212,
					"content": "Vous voulez dire que... nous pensons que c'est délicieux seulement parce que nous avons très faim ? Hmm, ça ne doit pas se limiter à ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490213
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490213,
					"content": "... Peut-être parce que l'arôme d'un plat chaud fraîchement cuit est un changement bienvenu par rapport aux rations froides ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490214
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401490214,
					"content": "Oh, un peu comme se réveiller le matin avec l'odeur du pain fraîchement sorti du four ? Ça a du sens...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490215
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490215,
					"content": "Oui, c'est presque comme si nous étions de retour au Bon Chasseur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490216
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490216,
					"content": "Hein ? Mais Le Bon Chasseur est à Mondstadt... Pourquoi essayer la cuisine de Liyue si vous ne pouvez même pas goûter la différence ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490217,
					"content": "Oh, je ne parle pas du goût. Je parle de cette sensation de... réconfort, tu sais ? C'est comme le sentiment de rentrer à la maison !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490218
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490218,
					"content": "Réconfort... Rentrer à la maison... Yanxiao a bien dit que nous voulons que nos invités se sentent comme à la maison !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490219,
					"content": "Il n'y a pas de goût absolu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490220
					]
				},
				{
					"id": 401490220,
					"content": "Chacun a ses propres préférences.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490221
					]
				},
				{
					"id": 401490221,
					"content": "Mais une chose ne change jamais, le chef...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490222
					]
				},
				{
					"id": 401490222,
					"content": "Essayera toujours de donner le sourire à ses convives.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490223
					]
				},
				{
					"id": 401490229,
					"content": "... Mais ils sont tous similaires.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490223
					]
				},
				{
					"id": 401490223,
					"content": "Donc l'ingrédient secret serait en réalité... la passion ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490224
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490224,
					"content": "Même si ça semble terriblement cliché, je dois admettre que ça se tient pour ce repas. Bien joué... Je me souviendrai de cette recette, croyez-moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490225
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401490225,
					"content": "D'accord, mais vous ne pouvez pas vraiment avoir une recette sans nom, n'est-ce pas ? Avez-vous trouvé un nom pour ce plat ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490226,
						401490227
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490226,
					"content": "Non, pas encore...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490228
					]
				},
				{
					"id": 401490227,
					"content": "Tu as des suggestions ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490228
					]
				},
				{
					"id": 401490228,
					"content": "Hmm... Pourquoi pas « Doux foyer » ?",
