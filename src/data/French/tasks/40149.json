					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401499402,
					"content": "Amber ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401499403
					]
				},
				{
					"id": 401499403,
					"content": "#... Oh, désolée. J'étais perdue dans mes pensées, je ne t'avais pas {M#vu}{F#vue}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499404
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401499404,
					"content": "Quelque chose te préoccupe ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401499405
					]
				},
				{
					"id": 401499405,
					"content": "Oui... Le repas que tu nous as préparé tout à l'heure, ça m'a rappelé ceux que mon grand-père me préparait. Je pensais avoir oublié leur goût, mais tout m'est revenu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499406
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401499406,
					"content": "Il préparait tout le temps des plats de Liyue. Je m'entrainais avec lui jusqu'au soir, puis j'attendais patiemment à table...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499407
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401499407,
					"content": "... Je restais assise là, à sentir l'odeur de la délicieuse nourriture qui s'échappait de la cuisine tout en attendant qu'il serve enfin les plats à table.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499408
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401499408,
					"content": "Parfois, nous invitions Eula pour le dîner, et même si elle trouvait toujours quelque chose à redire, je voyais bien qu'elle appréciait vraiment la nourriture.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499409,
						401499410
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401499409,
					"content": "Peut-être qu'elle s'en rappelle aussi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401499411
					]
				},
				{
					"id": 401499411,
					"content": "... Mieux vaut ne pas lui parler de ça, ou tu risques d'en voir de toutes les couleurs !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 401499410,
					"content": "Et c'est peut-être pour ça qu'elle a voulu venir manger ici ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401499411
					]
				}
			]
