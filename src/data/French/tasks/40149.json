			"dialogs": [
				{
					"id": 401490401,
					"content": "« Tout me va », hein ? Pff... C'est ce qu'il y a de pire pour un chef. Sans aucune indication concernant les goûts des clients, il ne reste plus qu'à deviner...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490402
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 401490402,
					"content": "Enfin, maintenant que tu as quelques jours d'expérience en cuisine, je suis sûr que tu vas trouver quelque chose. Allez, montre-leur ce dont tu es capable !",
					"roleType": "TALK_ROLE_NPC",
