			"dialogs": [
				{
					"id": 401490301,
					"content": "#Ah, vous voilà, {NICKNAME} ! Vous avez vraiment travaillé dur ces derniers jours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490302
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 401490302,
					"content": "#Je vous en prie... pour autant que je sois {M#rémunéré}{F#rémunérée} bien sûr ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490303
					]
				},
				{
					"id": 401490303,
					"content": "Haha, on va droit au but, n'est-ce pas ? Tenez, c'est pour vous. Je vous ai même mis un peu plus. Vous pouvez voir ça comme un bonus. On récompense le dur labeur ici !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490304
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 401490304,
					"content": "Super ! C'est comme si toute la fatigue et le stress avaient soudainement disparu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490305,
					"content": "J'ai de la chance que tu n'aies fait ce travail que quelques jours. Au rythme où tu progresses, encore quelques semaines et je pense que je pourrais perdre mon gagne-pain !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490306
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 401490306,
					"content": "J'ai hâte d'apprécier ta cuisine encore et encore à l'avenir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490307
					]
				},
				{
					"id": 401490307,
					"content": "Haha, quand tu veux ! Viens avec des amis la prochaine fois, et je vous montrerai toute l'étendue de mon talent !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490308
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 401490308,
					"content": "Parfait ! Mais... fais tout de même attention d'ici là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
