						],
						"pointId": 310400536
					}
				]
			},
			"dialogs": [
				{
					"id": 401490101,
					"content": "... Comme le temps passe vite. Mes brûlures sont presque guéries maintenant, je devrais donc pouvoir reprendre la cuisine demain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490102
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 401490102,
					"content": "#Tu as vraiment fait de l'excellent travail ces derniers jours, {NICKNAME}. C'est le dernier jour aujourd'hui, j'espère que nous nous en sortirons sans incident.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490103
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 401490103,
					"content": "J'ai l'impression que ça va nous porter malchance...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490104,
					"content": "La journée se déroule sans incident...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401490105
					]
				},
				{
					"id": 401490105,
					"content": "On arrive à la fin de la journée, ça s'est plutôt bien passé ! C'est sans doute parce que nous avons pris la main !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490106,
					"content": "Je me rappelle notre premier jour. On avait du mal à se souvenir des commandes de chaque table. Tout ça nous paraît facile, maintenant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490107,
						401490108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490107,
					"content": "Ne t'emballe pas trop vite...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490109
					]
				},
				{
					"id": 401490109,
					"content": "C'est vrai, mais qui viendrait si tard dans la soirée ? Oh... Maintenant que j'y pense, c'est à cette heure-ci que Lyney et les autres sont arrivés à la fin de notre premier jour...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490110,
					"content": "#{NICKNAME}, Paimon ? Quelle bonne surprise !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490111
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490111,
					"content": "Amber ? Eula et Mika aussi ? Vous êtes venus pour dîner ? Pourquoi aussi tard ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490112,
					"content": "Nous venons de terminer une mission d'escorte pour une caravane marchande. Le plan initial était de se contenter de quelques rations pour ce soir et de continuer notre marche vers le nord en direction de la Porte de Pierre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490113
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490113,
					"content": "Mais la capitaine Eula nous a fait remarquer qu'aucun de nous n'avait goûté à la cuisine de Liyue depuis un certain temps. Nous avons donc décidé de venir à l'auberge pour voir s'il nous était encore possible de commander quelque chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490114
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490114,
					"content": "Oh, alors c'est Eula qui invite ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490115,
					"content": "... Eh bien, nous mangeons les mêmes rations depuis le début du voyage. J'ai donc pensé qu'il était grand temps que nous profitions d'un vrai repas. Pourquoi, ça pose un problème ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490116,
						401490117
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401490116,
					"content": "Bienvenue à l'Auberge Wangshu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490118
					]
				},
				{
					"id": 401490118,
					"content": "#Qu'allons-nous commander... Attendez, pourquoi c'est vous qui nous recevez{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490119
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401490119,
					"content": "#{NICKNAME} remplace temporairement le chef ! Vous arrivez juste au bon moment, vous serez les derniers clients à apprécier sa cuisine avant que le véritable chef ne reprenne les rênes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490120,
					"content": "Vraiment ? Heureusement qu'Eula a suggéré de venir ici alors, je n'aurais pas voulu manquer ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490121
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490121,
					"content": "Bon, que devrions-nous commander ? Hmm... Je ne connais plus aussi bien la cuisine de Liyue qu'avant. Mika, Eula, de quoi avez-vous envie ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490122
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490122,
					"content": "Tout me va ! J'ai vraiment hâte de goûter à la cuisine du chevalier honoraire. Je suis sûr que ce sera une excellente opportunité d'apprentissage pour moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490123
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490123,
					"content": "... Quelque chose de léger, je dirais. Nous devons reprendre la route après avoir mangé. À part ça, tout me va.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490124
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401490124,
					"content": "Mais ce n'était pas votre idée de venir ici ? Et vous n'avez envie de rien en particulier... Très bien, je suppose que ça dépend de toi, Amber. Dis-nous ce qui te ferait plaisir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490125,
					"content": "Ah ? Euh... Tout me va, moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490126
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490126,
					"content": "Mais !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490117,
					"content": "Puis-je prendre votre commande ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490118
					]
				},
				{
					"id": 401490108,
					"content": "La journée n'est pas encore finie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490109
					]
				}
			]
		},
		{
