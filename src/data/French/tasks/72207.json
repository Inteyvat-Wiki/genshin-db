				"points": []
			},
			"dialogs": [
				{
					"id": 722070101,
					"content": "C'est loin d'être assez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070102
					],
					"speakerTitle": "Shitoki"
				},
				{
					"id": 722070102,
					"content": "Le trésor que mon frère m'a laissé est dans ces conques...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070103
					],
					"speakerTitle": "Shitoki"
				},
				{
					"id": 722070103,
					"content": "Mais elles ont été dispersées, oui elles ont été dispersées partout...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070104
					],
					"speakerTitle": "Shitoki"
				},
				{
					"id": 722070104,
					"content": "C'est son trésor, je ne peux pas encore m'en aller...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070105,
						722070106
					],
					"speakerTitle": "Shitoki"
				},
				{
					"id": 722070105,
					"content": "Un trésor ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722070107
					]
				},
				{
					"id": 722070107,
					"content": "Mon frère s'est aventuré dans la mer de brouillard. Le prêtre était furieux... Il a dit que son esprit ne reviendrait jamais sur l'île.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070108
					],
					"speakerTitle": "Shitoki"
				},
				{
					"id": 722070108,
					"content": "Mais mon frère a dit : « Les fleurs là-bas sont très belles. Il y a aussi une mer de perles. Papa rame sur un bateau en compagnie de notre sœur et ils nous font tous les deux signe... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070109
					],
					"speakerTitle": "Shitoki"
				},
				{
					"id": 722070109,
					"content": "Il a laissé son trésor ici après son départ et n'est jamais revenu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shitoki"
				},
				{
					"id": 722070106,
					"content": "Pouvez-vous en dire plus sur votre frère ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722070107
					]
				}
			]
		},
