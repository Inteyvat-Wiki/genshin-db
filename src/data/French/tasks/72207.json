			"dialogs": [
				{
					"id": 722070301,
					"content": "Haha... Le trésor était donc à cet endroit... Merci beaucoup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070302
					],
					"speakerTitle": "Shitoki"
				},
				{
					"id": 722070302,
					"content": "Bien que nous ne puissions pas nous rendre ensemble dans les terres des rêves ensemble, je suis sûr que je vous retrouverai une fois que je serai devenu lumière...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070303
					],
					"speakerTitle": "Shitoki"
				},
				{
					"id": 722070303,
					"content": "Je me demande si les esprits errants des contrées étrangères sont capables de rêver...",
