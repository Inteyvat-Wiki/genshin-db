			"dialogs": [
				{
					"id": 10091501,
					"content": "Hé, qu'est-ce que cette table fait ici ? Regarde, on dirait même que tout est prêt pour un repas, il y a même une carafe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091502,
					"content": "Oh, il y a même les noms des invités gravés sur les sièges ! « Ici prend place Souffle-Nuages »...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091510,
					"content": "« Ici prend place Guizhong »... « Ici prend place le Souverain de la Roche »...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091503,
					"content": "« Le Souverain de la Roche »... Et qui est « Guizhong »...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091504,
					"content": "« Souffle-Nuages »... Ah oui, ça me revient ! Quand Grave-Lune a parlé de ses euh, collègues, il a mentionné quelqu'un de ce nom...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091505,
					"content": "Donc ça doit être l'endroit où les Adeptes se retrouvent pour festoyer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091506,
					"content": "Héhéhé... Si c'est vraiment le cas, on pourrait peut-être cuisiner quelques plats rien que pour eux ? Ça pourrait aider, tu en penses quoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091507,
					"content": "Hum... Par contre, aucune idée de ce que mangent les Adeptes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091508,
					"content": "Les gens doivent venir faire des offrandes ici tout le temps, non ? Peut-être qu'on pourrait jeter un œil et voir s'il y a des restes, ça pourrait nous donner des idées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091509,
					"content": "... Tu crois que les Adeptes apprécieraient un délice de viande et de carottes au miel ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
