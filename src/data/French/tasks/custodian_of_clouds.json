		{
			"id": 100914,
			"completionStepIds": [
				100914
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"100914",
							"2"
						],
						"stepId": 100914,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Souffle-Nuages"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10091401,
					"content": "Je suis impressionnée. Le chemin à travers cette demeure n'est point aisé pour de simples mortels.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091402
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 10091402,
					"content": "Devant vous se tient Souffle-Nuages. À présent, faites-moi part de l'affaire qui vous amène.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091403,
						10091405
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 10091403,
					"content": "C'est vous qui avez construit cet endroit ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091404
					]
				},
				{
					"id": 10091404,
					"content": "Tu ne te trompes point. Ce lieu a par moi été construit, et les mécanismes qui l'habitent de même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091407
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 10091407,
					"content": "En vérité, même Guizhong et le Souverain de la Roche ont trouvé ces prouesses technologiques dignes d'être louées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091408
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 10091408,
					"content": "Cet endroit est gigantesque ! Et il y a tellement de mécanismes... C'est vraiment rien que pour vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091409,
					"content": "À quoi ça sert tout ça... C'est votre atelier perso ou quoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091410,
					"content": "C'est comme dans les histoires : les Adeptes ont quitté le monde des hommes, pour devenir ermites quelque part et créer plein d'inventions...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091411,
					"content": "Les interactions sociales ne m'intéressent guère. Seules la paix et la quiétude ont l'heur de me seoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091412
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 10091412,
					"content": "Or ces dernières ont été troublées par votre venue... Vous, et le talisman de permission que vous portez avec vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091413
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 10091413,
					"content": "Mais assez de paroles vaines. Parlez, et ne me faites point languir. Vous avez assez troublé la paix de ces lieux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091414
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 10091414,
					"content": "Le Souverain de la Roche... Assassiné ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091415
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 10091415,
					"content": "Comment est-ce donc possible ? Un crime d'une telle outrecuidance... Qui donc oserait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091416
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 10091416,
					"content": "De telles nouvelles sont difficiles à croire... Je vais devoir procéder à mes propres vérifications...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091417
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 10091417,
					"content": "... Peut-être serais-je avisée d'écraser d'abord le Port de Liyue, avant de retrouver les autres Adeptes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091418
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 10091418,
					"content": "... Pardon ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091419
					]
				},
				{
					"id": 10091419,
					"content": "Hein ? Attendez ! Comment ça, « écraser le Port de Liyue » ? Vous voulez détruire toute la ville ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091420,
					"content": "Seule une réponse d'amplitude suffisante pourra prévenir d'autres incidents de la sorte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091421,
						10091423
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 10091421,
					"content": "Mais les Adeptes ont juré de protéger la ville...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091422
					]
				},
				{
					"id": 10091422,
					"content": "C'est en effet le cas. Sache que les Adeptes ont protégé le Port de Liyue sous la gouvernance du Souverain de la Roche durant trente-sept siècles. Mais ce sombre événement requiert des mesures exceptionnelles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091425
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 10091425,
					"content": "C'est justement pour éviter toute souffrance future qu'il est nécessaire de prendre des mesures que seules ces circonstances exceptionnelles imposent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091426
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 10091426,
					"content": "Oh là là... Vite, trouve quelque chose à dire ! Sinon tu vas voir qu'elle va vraiment détruire le Port de Liyue, elle a l'air sérieuse !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091427,
					"content": "#Vous avez accepté notre offrande. Nous sommes {M#liés}{F#liées} de manière contractuelle...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091428
					]
				},
				{
					"id": 10091428,
					"content": "Exactement ce que j'allais dire ! Nous avons préparé tous ces plats délicieux et nous vous avons tout donné !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091429,
					"content": "#On est {M#venus}{F#venues} vous chercher pour protéger Liyue, pas l'inverse !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091430,
					"content": "La moindre des choses serait quand même de discuter avant de prendre la décision, non ? Un deuxième avis ne fait jamais de mal, je me trompe ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091431,
					"content": "#... Ainsi donc vous faites appel à la tradition liyuéenne du « contrat ». Une ironie bien cruelle, au vu de la nouvelle du meurtre impitoyable dont vous êtes {M#porteurs}{F#porteuses}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091432
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 10091432,
					"content": "Le peuple de Liyue semble ne vivre que pour ces « contrats », et pourtant il m'apparaît que les occasions de ne pas les respecter valent autant que ces soi-disant contrats...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091433
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 10091433,
					"content": "Néanmoins... Puisque vous invoquez cette antique coutume, je ne manquerai pas à mes obligations contractuelles, soit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091434
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 10091434,
					"content": "Vous portez de plus un talisman de permission... *soupir* Le Souverain de la Roche a imprégné lui-même ces artéfacts du pouvoir des Adeptes lors de leur création. Ce même pouvoir qui accompagna les mortels au combat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091435
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 10091435,
					"content": "Le pouvoir contenu par ce talisman s'est depuis longtemps épuisé... Il ne s'agit plus guère que d'un souvenir à présent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091436
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 10091436,
					"content": "#Néanmoins, cela ne saurait suffire à mes yeux à prouver que vous êtes {M#tous deux}{F#toutes deux} dignes de confiance... Je dois avant tout mener ma propre investigation quant aux faits que vous m'avez rapportés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091437
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 10091437,
					"content": "Nul doute qu'il s'agit là de la raison pour laquelle Grave-Lune souhaite nous réunir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091438
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 10091438,
					"content": "Bien, quittez ces lieux à présent. Partez, et ne troublez plus ma demeure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 10091423,
					"content": "Vous n'êtes pas censée protéger le peuple du Port de Liyue ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091424
					]
				},
				{
					"id": 10091424,
					"content": "En effet. Mais si comme tu l'affirmes le Souverain de la Roche a bien été assassiné, alors c'est tout Liyue qui est en grand péril. Tarder à circonscrire la menace reviendrait à prendre le risque de voir advenir un désastre encore plus important.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091425
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 10091405,
					"content": "C'est vous qui avez conçu tous ces mécanismes ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091406
					]
				},
				{
					"id": 10091406,
					"content": "Naturellement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091407
					],
					"speakerTitle": "Souffle-Nuages"
				}
			]
		},
