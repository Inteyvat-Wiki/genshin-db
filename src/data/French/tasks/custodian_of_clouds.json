					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 10090301,
					"content": "Ouh, le sol est recouvert de farine. Pas très propre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090302,
					"content": "Qu'est-ce qu'on a là ? Hum, de la viande, mais je ne saurais pas te dire laquelle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090303,
					"content": "Tu crois que ce plat était une offrande pour un Adepte ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090304,
					"content": "Qu'est-ce qu'on peut bien faire avec juste de la viande et de la farine ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090305,
					"content": "Ah, notre cuisinier a laissé tomber un papier... avec une grosse empreinte de pied dessus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090306,
					"content": "Peut-être que ça a un rapport avec le plat mystère ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 100904,
			"completionStepIds": [
				100904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"100904",
							"2"
						],
						"stepId": 100904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 10090401,
					"content": "Oh, c'est propre ici. La personne qui était ici avant nous doit avoir nettoyé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090402,
					"content": "Je suis certaine qu'elle préparait une offrande pour les Adeptes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090403,
					"content": "Il y a des matsutake et de la viande crue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090404,
					"content": "Et voilà la recette ! Quel sens de l'organisation...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 100913,
