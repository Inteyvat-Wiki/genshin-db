			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 10090201,
					"content": "Quelqu'un a sans doute fait la cuisine ici. Tu penses que c'était pour faire une offrande ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090202,
					"content": "Cette personne a laissé quelques ingrédients. Voyons... Gueule-de-loup, fruit du lotus, tofu... Son plat devait être compliqué à faire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090203,
					"content": "Hé, regarde. Elle a aussi laissé des notes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090204,
					"content": "J'avais raison. C'était si compliqué qu'elle a dû noter les étapes de préparation... C'est long, mais on devrait lire ça attentivement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 100903,
			"completionStepIds": [
				100903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"100903",
							"2"
						],
						"stepId": 100903,
