			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718220101,
					"content": "Les Monts Tianheng... Brise-Cieux... Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220102
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220102,
					"content": "À quoi tu penses ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220103
					]
				},
				{
					"id": 718220103,
					"content": "Ah, je suis en train d'étudier les histoires et les légendes du Festival des lanternes de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220104
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220104,
					"content": "J'ai entendu dire que la lanterne Mingxiao de cette année était basée sur un Adepte nommé Brise-Cieux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220105
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220105,
					"content": "Selon les légendes que j'ai ici, cet Adepte aurait combattu aux côtés du Souverain de la Roche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220106
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220106,
					"content": "Malheureusement, les dates et les ennemis qu'ils ont affrontés diffèrent d'un texte à l'autre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220107
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220107,
					"content": "Par contre, toutes les sources sont d'accord sur un point : Brise-Cieux a fait l'ultime sacrifice, et on dit même que cet Adepte a autrefois soutenu les Monts Tianheng avec ses propres ramures.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220108
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220108,
					"content": "C'est pourquoi je suis venue enquêter dans les Monts Tianheng. Je me suis dit qu'avec un peu de chance, je pourrais trouver quelque chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220109
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220109,
					"content": "Hélas, les Monts Tianheng grouillent de monstres... J'ai bien repéré une route vers l'endroit qui m'intéresse, mais des monstres s'y trouvent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220110
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220110,
					"content": "#{M#Voyageur}{F#Voyageuse}, est-ce que tu pourrais y aller et récupérer un échantillon géologique pour moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220111
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220111,
					"content": "Un échantillon géologique ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220112
					]
				},
				{
					"id": 718220112,
					"content": "Oui, c'est le jargon qu'on utilise à l'Académie, mais en fait, c'est juste un peu de terre de la zone à étudier...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220113
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220113,
					"content": "Les légendes locales affirment que Brise-Cieux a porté les Monts Tianheng sur ses ramures...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220114
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220114,
					"content": "Donc, d'un point de vue académique, le sol pourrait présenter dans la zone une composition inhabituelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220115
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220115,
					"content": "Alors, ramène-moi si tu peux un peu de terre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
		{
			"id": 7182202,
