					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718220301,
					"content": "As-tu ramené l'échantillon ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220302
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220302,
					"content": "Le voilà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220303
					]
				},
				{
					"id": 718220303,
					"content": "Merci bien. Fais-moi voir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220304
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220304,
					"content": "... Hmm, il semble ne rien y avoir de spécial dans le sol...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220305
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220305,
					"content": "Qu'espérais-tu trouver ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220306
					]
				},
				{
					"id": 718220306,
					"content": "On dit que Brise-Cieux, afin de protéger le Port de Liyue, a utilisé ses puissantes ramures pour empêcher les Monts Tianheng de s'effondrer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220307
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220307,
					"content": "Donc je pensais qu'il y aurait peut-être des traces microscopique de ses ramures...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220308
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220308,
					"content": "Enfin, les légendes ne sont que des légendes... À moins que trop de temps ne se soit écoulé depuis et que toutes les traces aient disparu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220309
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220309,
					"content": "Un échantillon géologique des Monts Tianheng devrait pouvoir porter ses fruits à un moment ou à un autre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220310
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220310,
					"content": "#{M#Voyageur}{F#Voyageuse}, peux-tu m'accompagner encore un peu ? Je veux voir plus haut, mais ça ne devrait pas être trop loin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220311,
						718220312
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220311,
					"content": "Compte sur moi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220313
					]
				},
				{
					"id": 718220313,
					"content": "Cette fois... je veux aller plus en hauteur pour surplomber les Monts Tianheng et observer la topographie du terrain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220314
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220314,
					"content": "Les légendes racontent que le Souverain de la Roche et de nombreux Adeptes ont pris part à ce fameux combat, qui a presque causé l'effondrement des Monts Tianheng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220315
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220315,
					"content": "Une bataille aussi violente... Peut-être que la topographie du coin nous permettra de déduire quelque chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220312,
					"content": "Qu'est-ce que tu cherches cette fois ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220313
					]
				}
			]
		},
		{
			"id": 7182206,
			"completionStepIds": [
				7182206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182206",
							"2"
						],
						"stepId": 7182206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718220601,
					"content": "#Enfin {M#arrivés}{F#arrivées}... Eh bien, ce n'était pas une partie de plaisir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220602
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220602,
					"content": "Le terrain environnant... Hmm... n'a rien de spécial...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220603
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220603,
					"content": "Oh ? Qu'est-ce que c'est sur cet arbre ? Une lanterne céleste ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220604
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220604,
					"content": "Pourquoi y aurait-il une lanterne céleste ici ? Quelqu'un serait-il venu rendre hommage à l'Adepte ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220605
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220605,
					"content": "Il y a quelque chose d'écrit dessus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220606
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220606,
					"content": "« Que le monde entier soit en paix. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220607,
						718220608
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220607,
					"content": "Une aspiration des plus nobles.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220609
					]
				},
				{
					"id": 718220609,
					"content": "En effet. Et cette formulation... Comment dire, c'est un peu trop... grandiose, non ? Ça ne ressemble ni à un hommage, ni à une ambition...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220610
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220610,
					"content": "Ça ressemble plutôt au vœu qu'aurait pu faire un de ces Adeptes de légende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220611
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220611,
					"content": "Qui écrirait un tel souhait sur une lanterne céleste ? C'est étrange...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220612
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220612,
					"content": "Au moins quelqu'un s'est souvenu de placer une lanterne céleste ici... Ça fera certainement plaisir à l'Adepte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220613
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220613,
					"content": "Merci de m'avoir accompagnée jusqu'ici. Je vais rester un peu plus pour approfondir mes recherches...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220614
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220614,
					"content": "Ah oui, et prends ceci. C'est pour te remercier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220615
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220615,
					"content": "*soupir* Liyue est remplie de légendes, et pourtant, j'ai l'impression que mes recherches n'avancent jamais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220608,
					"content": "Je n'ai pas l'impression que c'était pour rendre hommage.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220609
					]
				}
			]
		}
	]
}