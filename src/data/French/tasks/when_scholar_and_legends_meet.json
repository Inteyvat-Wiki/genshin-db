		},
		{
			"id": 7182203,
			"completionStepIds": [
				7182203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182203",
							"2"
						],
						"stepId": 7182203,
