			"dialogs": [
				{
					"id": 761920201,
					"content": "C'est une belle photo !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920202
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920202,
					"content": "Tu es satisfaite ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920203
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920203,
					"content": "Oui ! Que la légende soit vraie ou non, j'espère que peu importe où tu iras, la chance te protégera de tout danger et te ramènera au Speranza saine et sauve, Helka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920204
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920204,
					"content": "... Merci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920205
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920205,
					"content": "#Héhé, et si on rentrait ? Merci beaucoup, Linnea ! On se voit au Speranza{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920206
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920206,
					"content": "On se voit là-bas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linnea"
				}
			]
		},
