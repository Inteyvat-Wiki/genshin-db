			},
			"dialogs": [
				{
					"id": 761920101,
					"content": "Apparemment, ce n'est pas notre jour de chance aujourd'hui... Ça fait tellement longtemps qu'on attend et on n'a même pas aperçu la moindre baleine givreuse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920102
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920102,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920103
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920103,
					"content": "Hmm... Nous devrions peut-être en rester là et rentrer. Nous aurons d'autres occasions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920104
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920104,
					"content": "Mais... Tu ne restes que peu de temps avant de repartir à nouveau, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920105
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920105,
					"content": "Nous pouvons attendre encore un peu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920106
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920106,
					"content": "Une minute... Helka, c'est toi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920107
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920107,
					"content": "Linnea ! Oui, je suis de retour. Mais mon livre n'est pas encore complet, notre affrontement devra attendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920108
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920108,
					"content": "Oh ? Alors ton voyage a porté ses fruits. Je n'ai pas chômé non plus, et j'ai ajouté pas mal de données à mon propre ouvrage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920109
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920109,
					"content": "Toi aussi, tu es venue pour voir la baleine givreuse ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920110
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920110,
					"content": "Oui. J'ai entendu dire qu'elle n'avait été découverte que récemment. Compte tenu de sa taille, je soupçonne que ce sont des changements environnementaux qui ont provoqué ce changement au niveau de la couleur de sa peau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920111
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920111,
					"content": "Comme la concentration de kuuvahki dans la zone, par exemple...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920112
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920112,
					"content": "C'est dommage, mais nous ne la verrons probablement pas aujourd'hui. Nous avons attendu si longtemps pour finalement nous retrouver bredouilles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920113
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920113,
					"content": "Linnea... Aide-moi ! Il est temps de plier bagage et de rentrer, Maisie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920114
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920114,
					"content": "Je vais bien, vraiment. Je me sens plus en forme que d'habitude depuis que je me suis réveillée ce matin. Attendons encore un peu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920115
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920115,
					"content": "J'ai entendu dire que quiconque aperçoit une baleine givreuse peut voir son vœu se réaliser. Donc... elle est censée porter chance, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920116
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920116,
					"content": "J'espère que tu pourras emporter cette chance lors de ton prochain voyage, Helka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920117
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920117,
					"content": "Mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920118
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920118,
					"content": "Attendons ensemble, alors.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920119
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920119,
					"content": "... Linnea !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920120
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920120,
					"content": "Ne t'inquiète pas. Mon intuition me dit que nous allons bel et bien voir cette baleine givreuse aujourd'hui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920121
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920121,
					"content": "Tu me connais, Helka. Mon instinct ne se trompe jamais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920122
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920122,
					"content": "D'accord... Attendons encore un peu. Mais juste un peu, d'accord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920123
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920123,
					"content": "Un peu plus tard...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						761920124
					]
				},
				{
					"id": 761920124,
					"content": "Regardez, regardez ! Ouah, elle a sauté si haut !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920125
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920125,
					"content": "J'aimerais pouvoir nager aussi vite... Nager avec les baleines doit être tellement amusant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920126
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920126,
					"content": "Allez, plongeons maintenant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920127
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920127,
					"content": "Hé ! C'est bien trop dangereux ! Bon sang, rien n'a changé pendant mon absence. Tu es toujours aussi imprudente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920128
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920128,
					"content": "Q—Quoi ? Tu ne veux pas jouer avec les baleines ? Elles s'amusent tellement !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920129
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920129,
					"content": "Mais si tes vêtements sont mouillés, tu risques d'attraper froid. Pourquoi ne pas rester sur la rive et utiliser le Daguerréotype pour les prendre en photo pendant qu'elles s'amusent ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920130
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920130,
					"content": "Hmm... C'est vrai. Je vais emprunter le Daguerréotype d'Helka un instant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linnea"
				}
			]
		},
