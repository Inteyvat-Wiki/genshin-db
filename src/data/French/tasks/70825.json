			"dialogs": [
				{
					"id": 708250601,
					"content": "Alors, ça s'est bien passé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250602
					],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 708250602,
					"content": "C'est bon, le passage a été dégagé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708250603
					]
				},
				{
					"id": 708250603,
					"content": "Parfait. Vous avez été d'une grande aide ; sans vous, qui sait combien de temps tout ça serait resté tel quel...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250604
					],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 708250604,
					"content": "Tenez, chevalier honoraire. Vous l'avez bien mérité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hoffman"
				}
