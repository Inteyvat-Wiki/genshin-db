			"dialogs": [
				{
					"id": 708250401,
					"content": "*soupir* Si seulement on avait plus d'effectifs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250402,
						708250406
					],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 708250402,
					"content": "Les chevaliers dans Mondstadt ne peuvent pas s'en charger ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708250403
					]
				},
				{
					"id": 708250403,
					"content": "Maintenir les défenses de la cité, aider à la reconstruction, et tout un tas d'autres tâches...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250404
					],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 708250404,
					"content": "Les chevaliers sont bien trop occupés à l'heure actuelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250405
					],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 708250405,
					"content": "En comparaison, garder la porte principale ne demande guère d'efforts...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 708250406,
					"content": "Pourquoi ne pas demander de l'aide à la Guilde des aventuriers ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708250407
					]
				},
				{
					"id": 708250407,
					"content": "Oh, ils ont mis la main à la pâte dès le début. D'abord pour trouver et sauver les victimes, ensuite pour repousser les monstres des environs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250408
					],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 708250408,
					"content": "C'est grâce aux renseignements de leurs éclaireurs que nous avons pu mettre sur pied un plan de défense efficace en un minimum de temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250409
					],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 708250409,
					"content": "Ils participent encore à l'effort général visant à remettre la cité sur pied. Sans eux, les chevaliers crouleraient sous le poids des problèmes à régler, c'est sûr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250410
					],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 708250410,
					"content": "D'ailleurs, il faudra que j'aille remercier maître Cyrus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hoffman"
				}
			]
		},
