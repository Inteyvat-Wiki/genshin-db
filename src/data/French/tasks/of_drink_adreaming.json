				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Luka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705020101,
					"content": "#Bonjour ! Vous devez être {M#ce célèbre voyageur}{F#cette célèbre voyageuse} dont tout le monde parle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020102,
						705020103
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705020102,
					"content": "C'est bien moi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020104
					]
				},
				{
					"id": 705020104,
					"content": "Hé, n'oubliez pas l'illustre Paimon qui est tout aussi célèbre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705020105,
					"content": "Voilà : notre taverne, le Cadeau de l'Ange, organise une semaine d'initiation au métier de barman. J'ai pensé que ça vous intéresserait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020106
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705020106,
					"content": "En gros, vous pourrez mixer personnellement vos boissons... ou autre chose avec tous nos ingrédients à votre disposition.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020107
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705020107,
					"content": "Il vous sera aussi possible de boire vos créations à volonté, du moment qu'il n'y a pas de gaspillage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020108
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705020108,
					"content": "Des boissons à volonté !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705020109,
					"content": "#De plus, vous serez {M#récompensés}{F#récompensées} généreusement si nos clients apprécient vos boissons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020110
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705020110,
					"content": "Ouah, il y a même des récompenses à la clé ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705020111,
					"content": "Paimon fait déjà ses plans sur la comète...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020112
					]
				},
				{
					"id": 705020112,
					"content": "Allez, on participe !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705020113,
					"content": "Bien que ce soit une semaine d'initiation, il n'est pas obligatoire de se présenter tous les jours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020114
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705020114,
					"content": "Vous n'avez pas besoin de me confirmer votre participation tout de suite non plus. Il est tout à fait possible de faire un essai d'abord.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020115
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705020115,
					"content": "Qu'en pensez-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Luka"
				},
				{
					"id": 705020103,
					"content": "Je peux vous aider ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020104
					]
				}
			]
		},
		{
			"id": 7050202,
			"completionStepIds": [
				7050203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7050203",
							"2"
						],
						"stepId": 7050203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Charles"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705020201,
					"content": "Hé, mais c'est vous deux ! Qu'est-ce que je vous sers à boire aujourd'hui ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020202
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020202,
					"content": "Bonjour Charles.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020203
					]
				},
				{
					"id": 705020203,
					"content": "Charles ! On est là pour apprendre le métier de barman !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705020204,
					"content": "Le métier de barman... Ah, je vois. C'est Luka qui vous a embarqué là-dedans. Il se débrouille bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020205
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020205,
					"content": "#{NICKNAME}, je suis sûr que tu as toutes les capacités pour te débrouiller, mais la mixologie est un travail technique qui ne doit pas être pris à la légère.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020206
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020206,
					"content": "Que ce soit la proportion des ingrédients ou la technique de mixage, le moindre détail peut avoir un effet sur ta boisson.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020207
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020207,
					"content": "#{NICKNAME} n'aura aucun problème ! {M#Il}{F#Elle} cuisine déjà très bien, et je suis sûre que ses boissons seront toutes aussi délicieuses !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705020208,
					"content": "Je vois. Une dernière chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020209
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020209,
					"content": "Lors d'un événement similaire autrefois, un élève avait mélangé trois sortes d'alcools forts. Un seul verre suffisait pour faire tomber nos clients dans les pommes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020210
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020210,
					"content": "Depuis cet incident, nous avons décidé de ne plus proposer d'alcool à disposition des mixologues débutants. J'espère que tu comprendras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020211
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020211,
					"content": "Pas de problème.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020212
					]
				},
				{
					"id": 705020212,
					"content": "Bien, je crois que c'est tout ce que j'avais à dire. Je t'apprendrai les techniques lorsque tu mettras la main à la pâte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Charles"
				}
			]
		},
		{
			"id": 7050203,
			"completionStepIds": [
				7050205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7050205",
							"2"
						],
						"stepId": 7050205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Charles"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705020301,
					"content": "Tu apprends vite, dis donc. C'est vraiment pas mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020302
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020302,
					"content": "Je suis d'accord ! C'est super bon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705020303,
					"content": "Ce n'était qu'un entraînement. En réalité, les clients ont souvent des demandes spécifiques.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020304
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020304,
					"content": "Par exemple, certains aiment que ce soit un peu fort, alors que d'autres préfèrent une pointe d'acidité. Le tout est de savoir ajuster les ingrédients pour satisfaire les goûts de chacun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020305
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020305,
					"content": "Je voudrais une pomme de pin au caramel, plus sucrée que d'habitude. La plus grande tasse qui soit !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705020306,
					"content": "Je pense que c'est à peu près tout. Cependant, un barman ne se contente pas seulement de faire des boissons. Il vous faudra aussi maîtriser l'art de la conversation avec les clients...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020307,
						705020308
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020307,
					"content": "Laissez-moi faire !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020309
					]
				},
				{
					"id": 705020309,
					"content": "#Très bien, je vous laisse le comptoir à {M#tous}{F#toutes} les deux. Appelez-moi si vous avez besoin d'aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020310
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020310,
					"content": "Pfiou ! C'est enfin terminé ! Euh, elle est où ma tasse de pomme de pin au caramel ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705020311,
					"content": "Tu voulais juste boire...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 705020308,
					"content": "#Je suis {M#un expert}{F#une experte} dans ce domaine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020309
					]
				}
			]
		},
