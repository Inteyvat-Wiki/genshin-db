			"dialogs": [
				{
					"id": 150080501,
					"content": "On devrait être tout près.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080502
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080502,
					"content": "Regardez, un groupe se rassemble autour de ce rocher. Qu'est-ce qu'ils font ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080503,
					"content": "Hum, peut-être que quand les choses commencent à devenir ennuyeuses, ils se réunissent pour parler de quelque chose d'amusant ? Dommage que je ne comprenne pas ce qu'ils disent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080504
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080504,
					"content": "Hein ? Mais je pensais que les guides du Peuple des sources comprenaient le langage des koholasaures.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080505,
					"content": "Je pense que vous vous êtes fait avoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080506
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080506,
					"content": "C'est vrai, ils essayaient vraiment de nous rouler... Hein ? Vous voyez ça sur le rocher ? On dirait une sorte de... dessin ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080507,
					"content": "J'ai entendu dire qu'il existe un type de mousse qui change de couleur en réaction aux signaux biologiques émis par les koholasaures. Mais pour déclencher ce genre de réaction, il en faut un grand nombre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080508
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080508,
					"content": "Ça doit être l'indice !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080509
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080509,
					"content": "Devrions-nous prendre une photo ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080510,
					"content": "Le flash pourrait les déranger, je vais le recopier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080511
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080511,
					"content": "Mualani copie le dessin sur la mousse et vous ramène tranquillement via le chemin que vous avez emprunté. Vous racontez ensuite tout ce que vous avez vu et entendu à Viramdra et Karya qui attendaient patiemment.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150080512
					]
				},
				{
					"id": 150080512,
					"content": "Nous avons donc franchi la première étape du voyage ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080513,
					"content": "Je vois... Si nous avions choisi de chasser les koholasaures, nous n'aurions jamais trouvé cette piste... Tout ce que vous avez dit semble reposer sur une base logique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080514
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080514,
					"content": "A-t-il toujours été ainsi, mademoiselle Karya ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080515
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080515,
					"content": "Il est obnubilé par ses recherches, c'est tout...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080516
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150080516,
					"content": "Au moins, ça prouve que mon jugement était correct. Je vous ai prouvé que j'étais digne de confiance. Nous ne devrions donc pas avoir à nous disputer la prochaine fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080517
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080517,
					"content": "Oui, je comprends... Et je suppose que ça nous évitera de perdre du temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080518
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080518,
					"content": "Mualani sait vraiment comment gérer un groupe !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080519,
					"content": "C'est une guide professionnelle après tout.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150080520
					]
				},
				{
					"id": 150080520,
					"content": "Maintenant, nous allons devoir utiliser la piste que nous avons trouvée pour découvrir notre prochaine destination. À votre avis, qu'est-ce que ça représente ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080521
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080521,
					"content": "C'est très abstrait... Je n'en ai pas la moindre idée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080522,
					"content": "Oh ! Je sais !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080523
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080523,
					"content": "Même si les lignes sont un peu approximatives, je peux toujours voir qu'elles représentent les limites entre l'eau et la terre au Tertre Jujade. Nous pouvons utiliser ça pour combler le trou sur la carte et...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080524
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080524,
					"content": "Trouver notre prochaine destination !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080525
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080525,
					"content": "Tout ça grâce à quelques lignes approximatives ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080526,
					"content": "Eh bien, j'ai eu de l'intuition. En tant que guide, j'ai vu énormément de cartes. C'est beaucoup plus facile pour moi de deviner ce genre de schémas maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080527
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080527,
					"content": "La pause est terminée. Préparons-nous à partir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				}
			]
		},
