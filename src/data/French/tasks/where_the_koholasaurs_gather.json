			"dialogs": [
				{
					"id": 150080201,
					"content": "Waouh, il y a plein de koholasaures devant nous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080202,
					"content": "Je le savais, les koholasaures ont un lien avec le premier indice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080203
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080203,
					"content": "Lorsque des copies de la carte sortent de la tribu et tombent entre les mains d'étrangers, la plupart d'entre eux arrivent à cette conclusion. Mais ils regardent souvent dans la mauvaise direction.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080204
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080204,
					"content": "Lorsque le premier chef a créé la carte, il a marqué un symbole spécial. C'est un code qui permet d'identifier un troupeau de koholasaures.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080205
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080205,
					"content": "Par conséquent, nous ne trouverons pas l'indice si on se concentre sur l'un ou l'autre koholasaure isolé des autres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080206
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080206,
					"content": "Vous êtes une vraie pro, Mualani !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080207,
					"content": "Mais d'après les informations que j'ai trouvées, les koholasaures n'aiment pas vivre en troupeau, sauf pour se disputer les sources thermales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080208
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080208,
					"content": "Laissez-moi vous révéler un secret que seuls les guides du Peuple des sources connaissent : les koholasaures se rassemblent périodiquement dans la vallée devant vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080209
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080209,
					"content": "C'est un peu comme... lorsque notre tribu se rassemble lors de festivals. Cependant, dès que la saison est passée, le troupeau se disperse rapidement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080210
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080210,
					"content": "À moins d'être un guide qui parcourt régulièrement Natlan de fond en comble, assister à ce phénomène est très rare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080211
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080211,
					"content": "Vraiment ? Je dois absolument en prendre note et l'ajouter à ma thèse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080212
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080212,
					"content": "D'après ce que j'ai réussi à déchiffrer sur la carte, l'indice devrait se trouver au fond de la vallée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080213
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080213,
					"content": "Ça veut dire que nous allons devoir traverser le troupeau de koholasaures ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080214,
					"content": "Hum... Il va falloir trouver un moyen de passer discrètement pour ne pas les alerter. Ils sont en train de se réunir entre amis, ils ne veulent sûrement pas être dérangés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080215
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080215,
					"content": "Vous voulez dire qu'on va devoir traverser un troupeau de koholasaures ? Euh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080216
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150080216,
					"content": "Ahem... Puisque nous avons décidé de coopérer, nous devrions tous faire un effort. Cependant, Karya a déjà été attaquée par des koholasaures, ce n'est donc vraiment pas idéal pour elle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080217
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080217,
					"content": "Quant à moi... Je n'ai aucun problème ! Karya peut nous attendre ici, j'assumerai les tâches qui lui reviennent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080218
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080218,
					"content": "Pas de problème... Nous n'avons pas besoin de tout le monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080219
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080219,
					"content": "#En fait, nous avons besoin de quelqu'un pour s'occuper des bagages. Vous pouvez vous en occuper tous les deux. {NICKNAME} et Paimon m'accompagneront.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080220
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080220,
					"content": "Ah bon ? C'est encore mieux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080221
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080221,
					"content": "Je comprends maintenant que vous vouliez prendre soin de votre apprentie.",
