				]
			},
			"dialogs": [
				{
					"id": 150080301,
					"content": "Ces koholasaures sont sur leurs gardes. On ne va pas pouvoir passer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080302,
					"content": "Étant donné que vous avez déjà utilisé les informations fournies par la carte pour déduire que l'indice se trouve dans cette vallée, pourquoi ne pas simplement les faire fuir ? Vous êtes très forte, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080303
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080303,
					"content": "Tout d'abord, les aînés de la tribu nous ont toujours bien dit de ne jamais blesser les koholasaures. Cela nous porterait certainement malheur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080304
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080304,
					"content": "Ensuite, c'est une chose de se joindre à un rassemblement sans autorisation, mais les chasser ? Quel horrible comportement !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080305
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080305,
					"content": "Qu'est-ce que c'est que cette théorie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080306
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080306,
					"content": "Et si on essayait de trouver une autre solution ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080307
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150080307,
					"content": "Hum... Il doit y avoir un moyen d'atteindre la vallée sans les alerter. Il me faudrait un certain temps pour trouver une solution par moi-même, c'est pourquoi j'aimerais vous demander à tous de m'aider à trouver des idées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080308
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080308,
					"content": "Laissez-moi réfléchir... Et si nous les contournions ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080309,
					"content": "D'après les informations figurant sur la carte, l'emplacement de l'indice se situe au milieu du troupeau. Si nous les contournons, nous aurons le même problème.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080310
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080310,
					"content": "C'est compliqué...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080311,
					"content": "Karya, j'ai remarqué que vous ne parliez que pour arrondir les angles avec Viramdra. Mais je suis sûre que vous avez vos propres idées. Est-ce que quelque chose vous vient à l'esprit ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080312
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080312,
					"content": "Moi ? Bon... Plus tôt, quand Viramdra a décidé de creuser la piste des koholasaures, j'ai fait quelques recherches pour l'aider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080313
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150080313,
					"content": "J'ai découvert quelque chose de très intéressant. On pensait que les koholasaures se fiaient à leur ouïe pour chasser, mais en réalité, leur odorat est également très développé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080314
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150080314,
					"content": "Cependant, je ne sais pas si ça peut nous être utile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080315
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150080315,
					"content": "Oh ! C'est très utile, mademoiselle Karya !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080316
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080316,
					"content": "Vous pouvez simplement m'appeler Karya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080317
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150080317,
					"content": "#Très bien, restez ici pour surveiller les bagages. {NICKNAME} et Paimon, suivez-moi, j'ai une idée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				}
			]
		},
