			"dialogs": [
				{
					"id": 150080101,
					"content": "#{NICKNAME}, Paimon, par ici !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080102
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080102,
					"content": "Mualani est déjà là. Et cet homme étrange est là aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080103,
					"content": "#Bonjour {M#tous}{F#toutes} les deux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080104
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150080104,
					"content": "Bonjour !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080105,
					"content": "Quand partons-nous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080106
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080106,
					"content": "Haha, vous ressemblez à un petit enfant tout excité de partir en voyage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080107
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080107,
					"content": "Ce que j'aimerais, c'est commencer le plus tôt possible... Comme vous le savez, ce ne sera pas une promenade de santé. J'espère que nous pourrons tous faire preuve de plus de professionnalisme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080108
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080108,
					"content": "Ne vous inquiétez pas, je suis très professionnelle. Ahem... Eh bien, notre expédition vers l'île mystérieuse a officiellement commencé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080109
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080109,
					"content": "Trop bien !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080110,
					"content": "Tout d'abord, vous voyez cette statue ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080111
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080111,
					"content": "Oui, est-ce un indice important ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080112,
					"content": "Ce n'est pas un indice, c'est un mémorial construit par le premier chef du Peuple des sources après son retour de l'île mystérieuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080113
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080113,
					"content": "Avant de partir, nous devons toucher cette statue et prier nos ancêtres afin qu'ils nous donnent leur bénédiction. Ça devrait faciliter notre voyage vers l'île mystérieuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080114
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080114,
					"content": "... Y a-t-il un fondement théorique à cette affirmation ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080115
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080115,
					"content": "Un fondement théorique ? Non, mais mon maître m'a appris que c'était la première étape essentielle avant de se lancer à la recherche de l'île mystérieuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080116
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080116,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080117
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080117,
					"content": "C'est très bien ! Vous faites preuve de professionnalisme en ne critiquant pas quelque chose qui sort de votre domaine d'expertise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080118
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080118,
					"content": "Oui, mais je ne pourrai pas l'inclure dans ma thèse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080119
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080119,
					"content": "Venez, tout le monde !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080120
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080120,
					"content": "Ici, je rends hommage à mes ancêtres. En tant que descendante, je vais embarquer pour ce voyage que vous avez entrepris autrefois et je serai témoin de vos exploits. Permettez-moi de partir sous votre œil vigilant et de revenir grâce à votre protection.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080121
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080121,
					"content": "On dirait vraiment que nous allons nous lancer dans une aventure incroyable !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080122,
					"content": "Maintenant, préparez-vous. Il faut aller chercher le premier indice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				}
			]
		},
