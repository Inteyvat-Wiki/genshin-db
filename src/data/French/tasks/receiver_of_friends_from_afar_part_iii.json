			},
			"dialogs": [
				{
					"id": 401480101,
					"content": "#Bonjour, {NICKNAME}. Merci pour ton aide à nouveau aujourd'hui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480102
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 401480102,
					"content": "Grâce à l'expérience que tu as acquise ces derniers jours, tu te débrouilles de mieux en mieux...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401480103
					]
				},
				{
					"id": 401480103,
					"content": "#Excellent travail... Tu ressembles chaque jour davantage à {M#un}{F#une} véritable {M#chef}{F#cheffe} ! Haha, quelles que soient les demandes saugrenues que pourraient avoir certains clients, je sais que tu seras à la hauteur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480104
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 401480104,
					"content": "Attends, non ! Chaque fois que tu dis quelque chose comme ça, tu lui portes la poisse !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480105,
					"content": "Mais n'importe quoi ! Quoi qu'il en soit, je ne le pensais pas comme ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480106
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 401480106,
					"content": "Haha !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480107
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480107,
					"content": "Hé ! Quoi de neuf ?! Je ne savais pas que tu étais à Liyue aussi ! Ah, ça fait toujours plaisir de rencontrer quelqu'un d'étranger à Inazuma... Attends, c'était correct ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480108
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480108,
					"content": "Presque, vous vouliez probablement dire « quelqu'un d'Inazuma à l'étranger », patron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480109
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480109,
					"content": "Oui, voilà, c'est ça ! Il faut prendre soin les uns des autres quand on est si loin de chez soi ! N'est-ce pas, Ayato ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480110
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480110,
					"content": "Haha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480111
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480111,
					"content": "Vacheron ? Encore toi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480112,
					"content": "Hein ? Oh, Melon lavande de fer blanc ! Et mon compagnon ! Tous mes potes au même endroit, ce doit être mon jour de chance !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480113
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480113,
					"content": "Tu n'avais pas dit que tu allais rentrer et gagner de l'argent honnêtement ? Comment se fait-il que tu sois déjà revenu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480114,
					"content": "Haha, ça peut attendre. Dès que j'annoncerai qu'Arataki Itto cherche du travail, les moras ne seront plus un problème... En ce moment, j'ai une situation plus urgente à régler : j'ai envie de bons plats épicés !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480115
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480115,
					"content": "Oh, et pendant que nous sommes ici, nous devons aussi voir comment se porte Hanakado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480116
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480116,
					"content": "(Shinobu a l'air de vouloir nous dire de ne pas chercher à en savoir davantage.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480117
					]
				},
				{
					"id": 401480117,
					"content": "Qu'en est-il de vous, Ayato ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480118
					]
				},
				{
					"id": 401480118,
					"content": "... J'ai récemment entendu une rumeur selon laquelle un combat de scarabées était organisé à Liyue. Je suis donc venu dès que j'ai pu... mais il était déjà trop tard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480119
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480119,
					"content": "Quoi ? Tu l'as raté ? Quel dommage !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480120
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480120,
					"content": "En effet, mais puisque vous êtes là, vous allez pouvoir tout me raconter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480121
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480121,
					"content": "Haha, bien sûr ! Mais discutons plutôt autour d'un repas... D'ailleurs, où il est le chef ? Appelle-le pour moi, j'ai des compagnons à nourrir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480122
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480122,
					"content": "Je suis là.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480123
					]
				},
				{
					"id": 401480123,
					"content": "... Hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480124
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480124,
					"content": "Waouh, vacheron nous tend une perche cette fois-ci. Il faut la saisir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480125,
					"content": "... Mais le chef principal, c'est quelqu'un d'autre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480126
					]
				},
				{
					"id": 401480126,
					"content": "Haha, tu m'as presque eu. Bon, appelle-moi le chef alors !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480127
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480127,
					"content": "Paimon et vous allez dans la cuisine pour appeler Yanxiao...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401480128
					]
				},
				{
					"id": 401480128,
					"content": "Qu'est-ce que ce sera pour vous ? Si vous souhaitez ravir vos invités, je peux vous suggérer les joyaux du palais, les cordes vibrantes sur bruissement de roseaux, ou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480129
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 401480129,
					"content": "... Patron, il faut faire attention à notre budget.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480130
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480130,
					"content": "Hmm, d'accord, euh... Est-ce que tu aurais quelque chose de plus, euh... abordable ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480131
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480131,
					"content": "Abordable...? Eh bien, nous avons l'humilité satisfaisante. C'est un plat très riche, et on ne lésine pas sur la quantité. Vous en aurez pour votre argent, ça ne fait aucun doute...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480132
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 401480132,
					"content": "L'humilité satisfaisante ? Ça me paraît très bien. Nous sommes entre amis ici, pas besoin de faire des manières !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480133
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480133,
					"content": "Excellent choix, Itto. Je n'aime pas particulièrement les plats trop sophistiqués non plus. C'est une question de ressenti, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480134
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480134,
					"content": "Haha... Ouais, ça doit être ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480135
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480135,
					"content": "Sérieusement ? ... Qu'importe, je vous laisse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
