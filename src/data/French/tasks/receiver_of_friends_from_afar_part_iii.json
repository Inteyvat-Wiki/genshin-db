				]
			},
			"dialogs": [
				{
					"id": 401480201,
					"content": "Le... repas est servi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480202,
					"content": "Oh, c'est donc ça l'humilité satisfaisante ? Vous ne plaisantez pas, en tout cas, quelle belle portion !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480203
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480203,
					"content": "Assieds-toi, cher compagnon. Nous sommes tous amis ici, pas besoin de faire des manières ! Allez, je me lance...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480204
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480204,
					"content": "Euh... patron, nous ferions mieux de respecter les coutumes locales. Ici, à Liyue, il est de bon ton de laisser les invités commencer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480205
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480205,
					"content": "De bon ton ? Je ne savais pas que tu faisais attention à ce genre de choses, Shinobu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480206,
						401480207
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480206,
					"content": "#Maintenant que j'ai fini en cuisine, je suis aussi {M#un invité}{F#une invitée}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480208
					]
				},
				{
					"id": 401480208,
					"content": "Sérieusement ? ... Oh, je sais. Le plat sent tellement bon que maintenant tout le monde veut le goûter en premier ! J'imagine que je goûterai en dernier dans ce cas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480209
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480209,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480210
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480210,
					"content": "Paimon, Ayato, Shinobu et vous vous servez, et ne laissez que très peu de « viande »...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401480211
					]
				},
				{
					"id": 401480211,
					"content": "... Je vois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480212
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480212,
					"content": "Enfin, c'est mon tour ! J'ai vu un gros morceau qui est fait pour moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480213
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480213,
					"content": "Attends un peu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480214,
					"content": "Qu'est-ce qu'il y a encore ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480215,
						401480216
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480215,
					"content": "À toi de jouer, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480217
					]
				},
				{
					"id": 401480217,
					"content": "Je... Je vais faire de mon mieux... Euh, j'ai oublié de vous présenter l'origine de ce plat !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480218,
					"content": "L'origine ? Pas besoin de savoir d'où il vient, on sait tous où il va ! Dans la panse !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480219
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480219,
					"content": "Euh, eh bien... Ignorer l'origine d'un plat, c'est comme... voyager sans guide touristique ! Crois-moi, l'expérience n'en sera que meilleure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480220,
					"content": "Paimon a raison. Tout comme chaque thé doit être apprécié d'une certaine façon, ne passerions-nous pas à côté de quelque chose en profitant d'un plat sans connaître l'intention du chef ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480221
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480221,
					"content": "L'intention de mon compagnon, hein ? Je ne peux pas ignorer ça... Très bien, je t'écoute !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480222
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480222,
					"content": "Bonne décision ! Commençons par les ingrédients... En fait, non, commençons par l'histoire de l'Auberge Wangshu... qui commence par l'histoire du Marais Dihua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480223,
					"content": "#(C'est le moment, {NICKNAME} !)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480224
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480224,
					"content": "(Compris !)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480225
					]
				},
				{
					"id": 401480225,
					"content": "Pendant qu'Itto est distrait, Shinobu et vous commencez à engloutir le plat...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401480226
					]
				},
				{
					"id": 401480226,
					"content": "... Waouh, l'histoire du Marais Dihua est émouvante, ça n'a pas dû être facile dans le passé. L'humilité satisfaisante prend tout son sens... c'est une bonne façon de voir la vie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480227
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480227,
					"content": "(Oups, je ne peux pas mentionner le mot « tofu », je me suis éloignée du sujet sans m'en rendre compte... Heureusement que le plat est presque terminé !)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480228,
					"content": "#(Mais nous sommes déjà... plus que {M#repus}{F#repues}...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480229
					]
				},
				{
					"id": 401480229,
					"content": "Compagnon, Shinobu, vous avez déjà tout mangé ? Il ne reste presque plus rien !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480230
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480230,
					"content": "Bon, j'ai assez attendu. À mon tour !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480231
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480231,
					"content": "Patron, attendez ! Il y a du...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480232
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480232,
					"content": "Attendez, Itto. Si ça ne vous dérange pas, j'aurais... une petite faveur à vous demander.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480233
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480233,
					"content": "J'ai quitté la maison précipitamment, et je n'ai pu emmener aucun membre de ma famille avec moi. Ils ont tous beaucoup entendu parler de vous, et sont de grands admirateurs du gang Arataki. Ils seront donc dévastés d'apprendre qu'ils ont raté l'opportunité de vous rencontrer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480234
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480234,
					"content": "Cependant... Si vous étiez prêt à me laisser leur apporter le reste de ce plat, je suis sûr que ça leur remonterait le moral.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480235
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480235,
					"content": "Hmm... Je ne sais pas trop...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480236
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480236,
					"content": "Patron, vous devriez vous montrer généreux avec vos amis. C'est très important ici, à Liyue... En plus, vous avez mangé beaucoup de poisson grillé pendant que nous attendions le plat principal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480237
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480237,
					"content": "... Y compris ma part et celle d'Ayato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480238
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480238,
					"content": "Oh, c'était pour vous ?! Zut... J'étais tellement pris par mon histoire que je ne m'en suis pas rendu compte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480239
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480239,
					"content": "Dans ce cas, salue ta famille pour moi ! Chef, on va prendre le reste à emporter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480216,
					"content": "Tu connais la chanson...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480217
					]
				},
				{
					"id": 401480207,
					"content": "Je pourrais peut-être commencer ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480208
					]
				}
			]
		},
