			"dialogs": [
				{
					"id": 401480401,
					"content": "Je dois dire que votre ami est un sacré personnage... Enfin, l'humilité satisfaisante n'est pas compliquée à réaliser, donc je ne pense pas qu'il y aura de problèmes avec cette commande.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480402
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 401480402,
					"content": "#Au fait, pourquoi l'avoir appelé comme ça ? Un plat de viande copieux est un bon début, mais d'après mon expérience, un simple plat n'est jamais suffisant{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480403,
					"content": "Euh, j'ai dit que c'était copieux, mais je n'ai jamais dit qu'il contenait de la viande... Ne vous laissez pas tromper par son aspect, c'est en fait juste du tofu dont l'apparence et le goût ressemblent à ceux de la viande.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480404
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 401480404,
					"content": "Du tofu ?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480405
					]
				},
				{
					"id": 401480405,
					"content": "#Attends, le tofu est fait à partir de haricots... Vacheron ne peut pas en manger{NON_BREAK_SPACE}! Ils vont devoir commander autre chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480406,
					"content": "... Il y a un problème ? J'ai cru entendre parler de tofu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480407
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480407,
					"content": "#Qu'est-ce que vous faites ici ? La cuisine est réservée aux membres du personnel... *soupir* Peu importe, je vais laisser passer. Madame, pourriez-vous demander à votre patron de commander autre chose {NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480408
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 401480408,
					"content": "... Haha ! Personne ne connaît mon frère Ayato comme moi ! Je déclare par la présente que l'humilité satisfaisante sera un symbole éternel de notre amitié !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480409
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480409,
					"content": "Où est notre commande ? Dépêchez-vous, j'ai presque terminé de raconter les incroyables aventures de Titan cramoisi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480410
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480410,
					"content": "... Comme vous l'avez entendu, ça va être compliqué de changer la commande maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480411
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480411,
					"content": "Mince, il s'est vraiment engagé là... Même si on lui dit maintenant, il préféra sans doute manger le tofu plutôt que revenir sur ses mots...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480412,
						401480413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480412,
					"content": "On n'a pas le choix, on doit préparer ce plat...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480414
					]
				},
				{
					"id": 401480414,
					"content": "Bonne idée. Je m'assurerai que ça le rassasie dans un premier temps... Ensuite, nous devrons improviser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480413,
					"content": "Et si nous leur servions gratuitement quelques entrées ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480414
					]
				}
			]
		},
