				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220190101,
					"content": "... Je compte sur vous deux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190102
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190102,
					"content": "Laissez-nous faire, mademoiselle Sango.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190103
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220190103,
					"content": "Comment a-t-il osé nous filer sous le nez aussi longtemps ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190104
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220190104,
					"content": "Avec ce genre d'identité, en plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190105
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220190105,
					"content": "Quoi qu'il en soit, sa carrière dans le crime prend fin aujourd'hui. Ryuuji, te souviens-tu de ce que je t'ai dit ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190106
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190106,
					"content": "Oui, madame la directrice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190107
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220190107,
					"content": "#Très bien... Ah, vous êtes là aussi, {M#voyageur}{F#voyageuse}. Génial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190108,
						220190109
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190108,
					"content": "C'est l'heure d'attraper le voleur ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190111
					]
				},
				{
					"id": 220190111,
					"content": "J'ai réuni suffisamment de preuves accablantes, puis j'ai réussi à comprendre le comportement du coupable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190112
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190112,
					"content": "#{M#Voyageur}{F#Voyageuse}, vous irez vous occuper de lui avec Ryuuji, Andou et Amano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190113
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190113,
					"content": "Il doit avoir de nombreux complices. Avec vous, l'opération aura plus de chances de réussir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190114,
						220190117
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190114,
					"content": "Que dois-je faire ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190115
					]
				},
				{
					"id": 220190115,
					"content": "Menacez-le avec votre imposante prestance pour l'empêcher de commettre... d'autres bêtises.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190116
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190116,
					"content": "Cependant, je ne pense pas qu'un voleur aussi furtif que lui se risquerait à attirer votre attention.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190121
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190121,
					"content": "Si mes conclusions sont correctes, il devrait être hors de la ville en ce moment pour enterrer les objets volés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190122
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190122,
					"content": "Allez-y maintenant et vous devriez arriver juste à temps pour le prendre en flagrant délit. J'attendrai vos bonnes nouvelles ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190117,
					"content": "Vous n'y allez pas aussi ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190118
					]
				},
				{
					"id": 220190118,
					"content": "Je considère l'affaire close. La suite ne me concerne plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190119
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190119,
					"content": "#{M#Voyageur}{F#Voyageuse}, menacez-le avec votre imposante prestance pour l'empêcher de commettre... d'autres bêtises.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190120
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190120,
					"content": "Cependant, je ne pense pas qu'un voleur aussi furtif que lui se risquerait à attirer votre attention.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190121
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190109,
					"content": "C'est l'heure de clore l'affaire ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190110
					]
				},
				{
					"id": 220190110,
					"content": "Si tout se passe bien, on en aura terminé aujourd'hui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190111
					],
					"speakerTitle": "Sango"
				}
			]
		},
		{
