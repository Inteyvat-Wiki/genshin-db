			"dialogs": [
				{
					"id": 761970120,
					"content": "(test) Réplique vocale",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						761970101
					]
				},
				{
					"id": 761970101,
					"content": "Au cours de mes années passées en mer, j'ai un jour entendu un appel venant de nulle part. Les autres n'ont pas réagi du tout, mais j'ai été presque instantanément captivé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970102
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970102,
					"content": "Cela devait certainement être une voix provenant d'un autre monde. Je l'ai entendue moi aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970103
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970103,
					"content": "Ce n'est que plus tard que j'ai compris... Cet appel portait en lui tous les rêves qui n'avaient jamais atteint l'autre rive. On pourrait même parler d'un ensemble de regrets.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970104
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970104,
					"content": "Vous devriez emporter un galet gelé avec vous. En regardant à travers le trou au centre, vous verrez qui vous a appelé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970105
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970105,
					"content": "Mais à l'époque, j'étais encore un jeune écervelé impétueux. Je voyais même le danger comme une nouvelle opportunité. Je me suis donc précipité sans réfléchir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970106
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970106,
					"content": "On dit que le trou situé au centre des galets gelés constitue une porte vers un autre monde... Mais comment faire pour passer à travers ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970107
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970107,
					"content": "Après cela... La mer et ses vents violents m'ont tout pris : ma fortune, mon honneur et même ma famille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970108
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970108,
					"content": "Les aventures motivées par l'ambition et l'envie ne finissent jamais bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970109
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970109,
					"content": "Ah, c'est coincé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970110
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970110,
					"content": "Laisse-moi t'aider à enlever ça. Évite de recommencer, d'accord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970111
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761970111,
					"content": "Linnea ! Qu'est-ce qui t'amène ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970112
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970112,
					"content": "Je ramassais des galets gelés dans les environs. Je vous ai vus discuter et j'ai décidé de venir dire bonjour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970113
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761970113,
					"content": "Oh ! Peut-être que tu pourrais vraiment utiliser un galet gelé pour ouvrir une porte vers un autre monde, Linnea ! Si quelqu'un peut y arriver, c'est bien toi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970114
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970114,
					"content": "Même moi, j'en serais incapable. Je te l'ai pourtant déjà dit, ce n'est qu'une légende populaire inventée de toutes pièces. Il n'y a aucune preuve tangible derrière tout ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970115
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761970115,
					"content": "Ugh... On dirait que ça ne marchera pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970116
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970116,
					"content": "... Oh. Alors vous avez entendu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970117
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761970117,
					"content": "Ahem... Non. Je ne suis plus la personne que j'étais. Aujourd'hui, je suis satisfait de ce que j'ai et je ne demande rien de plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970118
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970118,
					"content": "Quel dommage. Bon, je vais t'aider à ramasser des galets gelés, Linnea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970119
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970119,
					"content": "Ce serait super !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970124
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761970124,
					"content": "Grâce à l'aide d'Auni, les matériaux sont rapidement collectés...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761970122
					]
				},
				{
					"id": 761970122,
					"content": "Merci, mais j'ai déjà ramassé tout ce dont j'avais besoin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970123
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761970123,
					"content": "Très bien. Je file à la Valléemoley pour rendre visite à grand-père Moley et aux autres. À plus tard !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Auni"
				}
			]
		},
