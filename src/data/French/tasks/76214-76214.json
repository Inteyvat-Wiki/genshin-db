					}
				]
			},
			"dialogs": [
				{
					"id": 762140101,
					"content": "Miaou... C'est déjà l'heure du goûter, miaou. J'espère qu'elles ne se sont pas perdues en chemin, miaou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140102
					],
					"speakerTitle": "Monsieur Chagris"
				},
				{
					"id": 762140102,
					"content": "#Ah, {M#monsieur le voyageur doré}{F#mademoiselle la voyageuse dorée}, vous devez être {M#l'élu}{F#l'élue}, miaou{NON_BREAK_SPACE}! Pourriez-vous m'aider à retrouver mes deux amies{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140103,
						762140104
					],
					"speakerTitle": "Monsieur Chagris"
				},
				{
					"id": 762140103,
					"content": "Vos amies sont...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762140106
					]
				},
				{
					"id": 762140106,
					"content": "Ces deux demoiselles qui ne sont pas encore arrivées... L'une d'elles est un chat qui parle comme moi. Mais son pelage est roux, miaou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140107
					],
					"speakerTitle": "Monsieur Chagris"
				},
				{
					"id": 762140107,
					"content": "L'autre est une demoiselle caniche très polie. Même si elle appartient au genre canin, elle est très gentille, miaou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140108
					],
					"speakerTitle": "Monsieur Chagris"
				},
				{
					"id": 762140108,
					"content": "#Chat ou chien, quand on s'assoit ensemble pour boire le thé, on passe toujours un bon moment, miaou{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140109
					],
					"speakerTitle": "Monsieur Chagris"
				},
				{
					"id": 762140109,
					"content": "#Pour la paix de Meouranopolis, aidez-moi, miaou{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Monsieur Chagris"
				},
				{
					"id": 762140104,
					"content": "#C'est tout ce qu'il faut pour se faire appeler {M#un héros}{F#une héroïne} ces temps-ci{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762140105
					]
				},
				{
					"id": 762140105,
					"content": "#Ne faites pas attention à ce genre de détails, miaou. Même sans la sainte lame ou sans avoir trouvé le pur graal, {M#un héros reste un héros}{F#une héroïne reste une héroïne}, miaou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140106
					],
					"speakerTitle": "Monsieur Chagris"
				}
			]
		},
