				]
			},
			"dialogs": [
				{
					"id": 762140201,
					"content": "... Miaou. Votre maîtrise de l'épée... est impressionnante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140209
					],
					"speakerTitle": "Mademoiselle Charoux"
				},
				{
					"id": 762140209,
					"content": "Je vous remercie, noble chevalier venu de contrées lointaines. Ces brutes arrogantes ne viendront plus jamais troubler les foyers de mon peuple.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140210
					],
					"speakerTitle": "Mademoiselle Charoux"
				},
				{
					"id": 762140210,
					"content": "Eh bien... Qu'est-ce qui vous amène à ma cour ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140202,
						762140204
					],
					"speakerTitle": "Mademoiselle Charoux"
				},
				{
					"id": 762140202,
					"content": "#Cour{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762140203
					]
				},
				{
					"id": 762140203,
					"content": "#Euh... Puisque c'est un conte de fées, ça doit aussi faire partie de l'histoire, non{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762140206,
					"content": "Vous avez transmis à dame Charoux l'invitation de monsieur Chagris pour le goûter...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						762140207
					]
				},
				{
					"id": 762140207,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140208
					],
					"speakerTitle": "Mademoiselle Charoux"
				},
				{
					"id": 762140208,
					"content": "#... Je comprends. Merci à vous, honorable chevalier {M#venu}{F#venue} de l'étranger. Dans ce cas, je vais suivre votre sage conseil et me mettre en route.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mademoiselle Charoux"
				},
				{
					"id": 762140204,
					"content": "Votre Majesté, permettez-moi de vous faire mon rapport...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762140205
					]
				},
				{
					"id": 762140205,
					"content": "#Tu rentres super facilement dans ton rôle{NON_BREAK_SPACE}! Bon euh... puisque ça fait partie de l'histoire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140206
					],
					"speakerTitle": "Paimon"
				}
			]
		},
