			},
			"dialogs": [
				{
					"id": 762140301,
					"content": "#Ouaf{NON_BREAK_SPACE}? Que se passe-t-il, {M#monsieur le voyageur doré}{F#mademoiselle la voyageuse dorée}{NON_BREAK_SPACE}? Puis-je faire quelque chose pour vous{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140302
					],
					"speakerTitle": "Madame la caniche demoiselle"
				},
				{
					"id": 762140302,
					"content": "Vous transmettez à madame la caniche demoiselle l'invitation à prendre le thé de monsieur Chagris...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						762140303
					]
				},
				{
					"id": 762140303,
					"content": "#Oh{NON_BREAK_SPACE}? C'est déjà l'heure{NON_BREAK_SPACE}?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140304
					],
					"speakerTitle": "Madame la caniche demoiselle"
				},
				{
					"id": 762140304,
					"content": "#Merci beaucoup{NON_BREAK_SPACE}! Ouaf, si je n'avais pas été si occupée, je serais allée inviter mademoiselle Charoux moi-même... Si je l'avais fait, monsieur Chagris aurait peut-être...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140305
					],
					"speakerTitle": "Madame la caniche demoiselle"
				},
				{
					"id": 762140305,
					"content": "#Chats ou chiens, tout le monde peut vivre en harmonie... J'en suis certaine. En tout cas, je vais de ce pas aller prendre le thé. Merci de me l'avoir rappelé{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madame la caniche demoiselle"
				}
			]
		},
