			"dialogs": [
				{
					"id": 710460101,
					"content": "Halte ! Personne n'est autorisé à entrer dans le Gouffre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soldat des Millelithes"
				}
			]
		},
		{
			"id": 7104602,
			"completionStepIds": [
				7104602
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7104602",
							"2"
						],
						"stepId": 7104602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tie Hong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710460201,
					"content": "#Halte ! Le Gouffre est scellé. Si vous êtes un visiteur, veuillez... Oh, c'est vous{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460202
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460202,
					"content": "Oh non, cours !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460203,
						710460204,
						710460205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710460203,
					"content": "Allons, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710460206
					]
				},
				{
					"id": 710460206,
					"content": "Hahaha ! Désolé de vous avoir fait peur. Bien sûr que je me souviens de vous. Comment pourrais-je oublier la personne qui m'a sauvé la vie ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460207
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460207,
					"content": "Je n'ai été transféré ici que récemment... Je ne pensais pas vous rencontrer ici. Je suppose que c'est de la chance, hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460208
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460208,
					"content": "On vous a sauvé la vie ? Vraiment ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710460209,
					"content": "Allons ! J'étais à la Chambre de Jade quand on a combattu ce monstre marin ensemble. J'ai été légèrement blessé, c'est pourquoi je ne suis retourné à mon poste que récemment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460210
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460210,
					"content": "Vous ne vous rappelez peut-être pas de moi, mais moi, je ne vous oublierai jamais. Tous nos camarades qui ont combattu ce jour-là ont vu ce que vous avez fait pour Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460211
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460211,
					"content": "Parlez-moi du Gouffre...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710460212
					]
				},
				{
					"id": 710460212,
					"content": "Il y a deux ans, un incident inconnu s'est produit au fond des tunnels, et les Sept Étoiles ont donné l'ordre de sceller l'endroit. Les mineurs ont été rapatriés en sécurité pour la plupart.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460213
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460213,
					"content": "C'est dommage qu'une si grande mine ait fermé comme ça. Les travailleurs ont pris leurs indemnités et sont partis chacun de leur côté... Une fois que les gens sont dispersés, c'est difficile de les réunir à nouveau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460214
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460214,
					"content": "... Hum, désolé, je m'égare. Je suppose que vous devez avoir des choses importantes à régler, je ne vous dérange pas plus longtemps. Si vous avez des questions, vous pouvez demander directement à Muning. Il devrait être au camp, à l'entrée de la mine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460215
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460215,
					"content": "Aussi, euh, ce n'est pas que je ne vous fais pas confiance ou quoi que ce soit, mais mon travail est de vous rappeler ne rien faire qui enfreigne la loi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460216
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460216,
					"content": "Ne vous inquiétez pas, vous pouvez nous faire confiance, allons !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710460204,
					"content": "On se connaît ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710460206
					]
				},
				{
					"id": 710460205,
					"content": "#On nous a {M#reconnus}{F#reconnues} ! Vite, filons !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710460206
					]
				}
			]
		}
	]
}