					}
				]
			},
			"dialogs": [
				{
					"id": 761590101,
					"content": "Déjà sur le départ ? Hé, Barbie ! Tu n'oublies pas quelque chose ? Comme tout un tas de choses que tu étais censée me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590102
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590102,
					"content": "... donner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590103,
						761590104
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590103,
					"content": "On tombe mal...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590105
					]
				},
				{
					"id": 761590105,
					"content": "Pas du tout, votre arrivée correspond plus ou moins à la prophétie de Barbie... Même si, pour être honnête, je pensais que vous arriveriez un peu plus tard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590106
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590106,
					"content": "Bref... Avant de passer aux choses sérieuses, vous devriez peut-être... manger quelque chose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590107,
						761590108
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590107,
					"content": "E—Est-ce que la prophétie de Barbeloth disait qu'on aurait faim ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590109
					]
				},
				{
					"id": 761590109,
					"content": "Non, bien sûr que non ! Mais j'ai l'ouïe très fine, et j'ai entendu l'estomac de Paimon gargouiller de loin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590110
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590110,
					"content": "*gargouillis*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590111,
					"content": "#Hé ! Mon... ventre gargouille pour celui de {NICKNAME} aussi ! On a {M#tous}{F#toutes} les deux très faim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590112,
						761590113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590112,
					"content": "Comment j'aurais pu savoir qu'il n'y aurait plus de steak...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590114
					]
				},
				{
					"id": 761590114,
					"content": "#Ne vous inquiétez pas, une sorcière ne laissera jamais ses {M#invités}{F#invitées} mourir de faim. Tenez, des biscuits et des gâteaux sont déjà prêts pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590115
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590115,
					"content": "Paimon et vous grignotez joyeusement biscuits et gâteaux tout en avalant de grandes gorgées de thé. Étrangement, peu importe la quantité que vous mangez ou buvez, la théière reste à moitié pleine et il y a toujours un biscuit frais et une part de gâteau dans vos assiettes...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						761590116
					]
				},
				{
					"id": 761590116,
					"content": "Je... je ne peux plus manger... Pourquoi ça ne diminue jamais ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590117,
						761590120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590117,
					"content": "C'est donc ça, un goûteron de sorcières...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590118
					]
				},
				{
					"id": 761590118,
					"content": "Bien sûr ! On ne peut pas organiser un goûteron sans une bonne quantité de nourriture et de boissons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590119
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590119,
					"content": "Même si c'est vrai, il est difficile d'afficher une élégance « de sorcière » appropriée après s'être empiffré. C'est pourquoi la théière n'est généralement remplie qu'à moitié, et il n'y a qu'un biscuit ou une part de gâteau dans chaque assiette.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590123
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590123,
					"content": "Je ne peux plus manger... Je suis vraiment repue. On peut revenir aux choses sérieuses ? *hic*... Oups, pardon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590124,
					"content": "#Bon. Je suppose que vous êtes {M#venus}{F#venues} pour me remettre mon « devoir » ? Celui que Barbie avait prédit, c'est ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590125,
						761590126
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590125,
					"content": "Vous étiez au courant depuis le début...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590127
					]
				},
				{
					"id": 761590127,
					"content": "Rien de tout cela. Nous discutions de quelque chose de complètement différent. L'altération massive de la lune a perturbé son hydromancie, elle doit donc retourner un moment chez elle pour suivre une période de méditation silencieuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590128
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590128,
					"content": "Pendant son absence, je vais prendre en charge les devoirs de tout le monde. Je compte aussi l'aider à ajouter la prochaine série de devoirs au dictionnaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590129
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590129,
					"content": "Hein ? On peut changer de responsable comme ça ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590130,
						761590131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590130,
					"content": "Eh bien, ça ne m'étonne pas de...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590132
					]
				},
				{
					"id": 761590132,
					"content": "Ce n'est pas comme si j'avais vraiment le choix ! Avant même que Barbie et Alice ne m'en parlent, elles avaient déjà inscrit mes « devoirs spéciaux » dans le dictionnaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590133
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590133,
					"content": "Bien que j'aimerais tout effacer et continuer à observer tranquillement le monde, Alice est occupée à maintenir les frontières de Teyvat, et Barbie est partie réaligner son hydromancie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590134
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590134,
					"content": "Octavia ne s'est même pas donné la peine de revenir, et vous pouvez oublier Rhinedottir... Les autres sorcières ont toutes leurs propres affaires à régler, donc la supervision de ce devoir m'est revenue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590135,
						761590136
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590135,
					"content": "Je ne savais pas que l'Hexenzirkel était si occupé...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590137
					]
				},
				{
					"id": 761590137,
					"content": "C'est vrai. Je ne sais même plus depuis combien de temps on ne s'est pas toutes réunies pour organiser un vrai goûteron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590138
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590138,
					"content": "Quoi qu'il en soit, dès que j'aurai terminé ce devoir, mon histoire sera officiellement inscrite dans le dictionnaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590139
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590139,
					"content": "#Après cela, je pourrai observer le monde et vous guider plus librement... Alors, Paimon, {NICKNAME}, dites-m'en plus à propos de ce devoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590140
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590140,
					"content": "D'ailleurs, comme ce n'est pas une véritable prophétie, juste une histoire inventée par Barbie et Alice il y a dix minutes, vous ne trouverez probablement aucune information utile dans ce dictionnaire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590141
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590141,
					"content": "C'est vrai, Nicole ! On a vérifié avant de venir, et il n'y a aucun détail. Il n'y a que ces deux phrases.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590142,
						761590143,
						761590144
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590142,
					"content": "« Nicole accomplira son devoir. »",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590145
					]
				},
				{
					"id": 761590145,
					"content": "D'accord. La première phrase a clairement été écrite par Barbie, mais je parierais jusqu'à mon dernier mora que c'est Alice qui a ajouté la seconde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590146
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590146,
					"content": "Bref, mettons-nous au travail ! Voyons voir... par où commencer...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590147,
						761590148
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590147,
					"content": "Attendez, vous avez vraiment compris ce qu'elles vous demandaient de faire ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590149
					]
				},
				{
					"id": 761590149,
					"content": "Hein ? Oh, Barbie m'a déjà expliqué ce que je devais faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590150
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590150,
					"content": "En gros, je dois juste me rendre à quelques endroits prévus, m'assurer que tout est en ordre et effectuer quelques recherches sur le terrain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590151
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590151,
					"content": "Attendez ! Ça marche vraiment comme ça ? On ne dirait même plus une prophétie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590152
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590152,
					"content": "Ah, eh bien, voyez-vous... Je considère naturellement tout ce que Barbie me dit comme une sorte de prophétie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590153
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590153,
					"content": "En plus, quand Barbie a écrit ce devoir à ma place, tout ce qu'elle a fait, c'est aller directement à la dernière page de mon histoire et me révéler la fin à l'avance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590154,
						761590156
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590154,
					"content": "Mais c'est gâcher la révélation de la fin ?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590155
					]
				},
				{
					"id": 761590155,
					"content": "Eh bien, au fond, prophétie ou fin gâchée, quelle différence ? Bon, assez bavardé. Venez, suivez-moi. On va commencer par... Hmm, oui. Cet endroit fera l'affaire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590159
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590159,
					"content": "#Comme ça, d'un coup ? Attendez ! Comment on est {M#censés}{F#censées}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590160
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590160,
					"content": "En un clin d'œil, vous vous retrouvez au bord d'une falaise...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 761590156,
					"content": "#Ça veut dire que je suis {M#venu}{F#venue} ici pour rien...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590157
					]
				},
				{
					"id": 761590157,
					"content": "Mais pas du tout ! C'est vous qui deviez remettre ce devoir. C'est une étape très importante. Certaines formalités doivent être respectées pour que le devoir soit valide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590158
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590158,
					"content": "Mais on en parlera plus tard. Allez, suivez-moi. On va commencer par... Hmm, oui. Cet endroit fera l'affaire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590159
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590148,
					"content": "Je n'ai rien compris du tout...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590149
					]
				},
				{
					"id": 761590143,
					"content": "« Elle ne vous laissera certainement pas travailler gratuitement ! »",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590145
					]
				},
				{
					"id": 761590144,
					"content": "C'est tout.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590145
					]
				},
				{
					"id": 761590136,
					"content": "En y réfléchissant, vous êtes quand même assez nombreuses.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590137
					]
				},
				{
					"id": 761590131,
					"content": "Nicole !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590132
					]
				},
				{
					"id": 761590126,
					"content": "Donc tout à l'heure, Barbeloth était...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590127
					]
				},
				{
					"id": 761590120,
					"content": "La prochaine fois, il faudra inviter Varesa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590121
					]
				},
				{
					"id": 761590121,
					"content": "C'est bien cette fille réputée pour son appétit, du Collectif de l'abondance ? Alice m'en a parlé, elle a l'air assez fascinante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590122
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590122,
					"content": "J'imagine que si elle venait à l'une de nos fêtes, il faudrait prévoir trois... voire sept assiettes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590123
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590113,
					"content": "On ne peut pas se contenter de salade pour se remplir l'estomac...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590114
					]
				},
				{
					"id": 761590108,
					"content": "La faim, c'est quelque chose qu'on peut prédire aussi ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590109
					]
				},
				{
					"id": 761590104,
					"content": "On devrait peut-être revenir plus tard...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590105
					]
				}
			]
		},
