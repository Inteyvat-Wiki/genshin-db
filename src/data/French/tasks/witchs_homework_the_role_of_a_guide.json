			"dialogs": [
				{
					"id": 761590301,
					"content": "C'est le Territoire des loups ? Ça n'a pas l'air d'être le meilleur endroit pour faire le devoir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590302,
					"content": "C'est le support des Fées le plus proche de notre destination. Ne vous inquiétez pas, le point de départ n'est pas loin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590303
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590303,
					"content": "#Hein ? D'où sortent tous ces loups ? Hé... nous ne vous voulons aucun mal ! Nous sommes {M#amis}{F#amies} avec Razor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590304,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590305,
						761590306
					],
					"speakerTitle": "Meute de loups"
				},
				{
					"id": 761590305,
					"content": "Les loups sont partis...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590307
					]
				},
				{
					"id": 761590307,
					"content": "#Chut. Cet enfant n'est pas encore arrivé ? Peut-être sommes-nous {M#venus}{F#venues} trop tôt, encore une fois. Pas d'inquiétude, tant qu'il se tient aux côtés de son lupical, il peut surmonter n'importe quel adversaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590308
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590308,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590309
					],
					"speakerTitle": "Meute de loups"
				},
				{
					"id": 761590309,
					"content": "#Pourquoi sont-ils revenus ? Nous ont-ils {M#entendus}{F#entendues} parler ? Si seulement Razor était là, il pourrait nous dire ce qu'ils veulent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590310,
					"content": "Vous n'avez pas tort, Paimon, mais il a encore beaucoup à comprendre... Bien plus que le simple langage des loups...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590311,
						761590312
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590311,
					"content": "Hé, ce n'est pas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590313
					]
				},
				{
					"id": 761590313,
					"content": "C'est exact. Cet enfant qu'on appelle Razor a déjà remporté la victoire dans le combat qu'il était destiné à mener.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590314
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590314,
					"content": "Tant qu'il se tient aux côtés de son lupical, je suis sûre qu'il pourra vaincre n'importe quel ennemi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590315
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590315,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590316
					],
					"speakerTitle": "Meute de loups"
				},
				{
					"id": 761590316,
					"content": "... Je suis sûre que son lupical ressent la même chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590317
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590317,
					"content": "Très bien ! On en a fini avec cet endroit. Je ne dirais pas non à un peu de repos. Allez, on y va. Il est temps de rentrer boire une bonne tasse de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590318
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590318,
					"content": "Ouah ! Quand est-ce que cette porte est apparue ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590319,
						761590320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590319,
					"content": "Il y a un mot collé dessus...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590321
					]
				},
				{
					"id": 761590321,
					"content": "On dirait l'écriture d'Alice. Voyons voir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590322
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590322,
					"content": "« Merci pour ton aide avec le devoir ! Rentre vite chez toi et bois une bonne tasse de thé bien chaud ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590323
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590323,
					"content": "« P.-S. Il y a une surprise qui t'attend derrière cette porte ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590324
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590324,
					"content": "Rentrer ? Attendez... Pourquoi cette porte me semble-t-elle si familière ? Elle ne mènerait quand même pas à...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590325
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590325,
					"content": "Nicole pousse la porte et entre d'un pas décidé, et vous la suivez. Un instant plus tard, vous vous retrouvez dans une pièce...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 761590320,
					"content": "Ce style... Ça me dit quelque chose...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590321
					]
				},
				{
					"id": 761590312,
					"content": "Razor et moi nous sommes battus ensemble ici.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590313
					]
				},
				{
					"id": 761590306,
					"content": "Je suppose que ce devoir n'est pas pour...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590307
					]
				}
			]
		},
