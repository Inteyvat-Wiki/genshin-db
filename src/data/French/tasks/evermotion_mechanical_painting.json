						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Félix Yogue"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705140401,
					"content": "Oui, c'est ça ! Merveilleux, mes composants !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140402
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140402,
					"content": "Maintenant que les composants ont été trouvés, il ne reste plus qu'à les assembler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140403
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140403,
					"content": "Eh bien... Chevalier honoraire, si cela vous intéresse, vous pouvez essayer d'assembler vous-même ce cadre mécanique perpétuel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140404
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140404,
					"content": "Croyez-moi, ça va être amusant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Félix Yogue"
				}
			]
		},
