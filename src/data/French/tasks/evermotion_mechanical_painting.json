			"dialogs": [
				{
					"id": 705140301,
					"content": "Chevalier honoraire ! Vous êtes de retour ! Comment s'est passée votre recherche de composants ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140302
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140302,
					"content": "Vous parlez de ça ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7051404,
			"completionStepIds": [
				7051404
			],
