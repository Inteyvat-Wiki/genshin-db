			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Félix Yogue",
					"Swann"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705140101,
					"content": "L'enthousiasme qui règne à Mondstadt dépasse mon imagination... Sa réputation est vraiment justifiée, même les Brutocollinus sont si énergiques.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140102
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140102,
					"content": "En tout cas... Monsieur Yogue, s'il vous plaît, ne sortez plus tout seul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140103
					],
					"speakerTitle": "Swann"
				},
				{
					"id": 705140103,
					"content": "Quoi ? Et mon mécanisme alors ? Il me faut encore... Euh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140104
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140104,
					"content": "Une, deux, trois... Dix-huit... Dix-neuf pièces !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140105
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140105,
					"content": "Il y a déjà des aventuriers qui sont à leur recherche, donc vous pouvez attendre tranquillement en ville...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140106
					],
					"speakerTitle": "Swann"
				},
				{
					"id": 705140106,
					"content": "Mais si je n'ai pas mon mécanisme, c'est... C'est mon inspiration, vous savez ? Qu'est-ce que je vais faire de mon inspiration ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140107
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140107,
					"content": "L'inspiration est quelque chose de fugace, comme... comme le hoquet après avoir bu du vin !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140108
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140108,
					"content": "Oh, c'est une excellente métaphore. Je dois la noter, Xavier l'appréciera certainement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140109
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140109,
					"content": "Je... Vous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140110
					],
					"speakerTitle": "Swann"
				},
				{
					"id": 705140110,
					"content": "Hein ? Chevalier honoraire... Formidable, je voulais vous voir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140111,
						705140112
					],
					"speakerTitle": "Swann"
				},
				{
					"id": 705140111,
					"content": "Qu'est-ce qu'il y a ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140113
					]
				},
				{
					"id": 705140113,
					"content": "Permettez-moi de vous présenter une personne de la Cour de Fontaine, il est...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140114
					],
					"speakerTitle": "Swann"
				},
				{
					"id": 705140114,
					"content": "Un rêveur ! C'est ainsi que nous nous appelons entre nous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140115
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140115,
					"content": "... Monsieur Yogue, voici le chevalier honoraire de la Cité de Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140116
					],
					"speakerTitle": "Swann"
				},
				{
					"id": 705140116,
					"content": "Haha ! Je suis Yogue, Félix Yogue ! Permettez-moi de vous présenter mes respects, chevalier honoraire ! J'ai tellement entendu parler de vos exploits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140117
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140117,
					"content": "Vous me connaissez ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140118
					]
				},
				{
					"id": 705140118,
					"content": "Bien sûr ! Bien sûr que je vous connais, qui pourrait ne pas vous connaître ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140119
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140119,
					"content": "Vos exploits lors de la bataille contre Stormterror à Mondstadt ont fait la une de L'Oiseau de vapeur pendant au moins trois semaines.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140120
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140120,
					"content": "Hahaha, si les journalistes apprenaient que je suis en train de vous parler, ils seraient verts de jalousie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140121,
						705140124
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140121,
					"content": "Qu'est-ce que L'Oiseau de vapeur ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140122
					]
				},
				{
					"id": 705140122,
					"content": "Vous ne le savez pas ? L'Oiseau de vapeur est un journal... Euh... Très connu à la Cour de Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140123
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140123,
					"content": "Et c'est vous qui leur avez permis de réaliser un record de ventes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140125
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140125,
					"content": "La... une ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140126
					]
				},
				{
					"id": 705140126,
					"content": "Bien sûr, leurs ventes ont explosé grâce à vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140127
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140127,
					"content": "Les unes, les numéros complets, les interviews d'experts et les meilleures illustrations, ha ! Ils ont gagné énormément d'argent !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140128
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140128,
					"content": "#Alors, {M#voyageur}{F#voyageuse} et monsieur Yogue, je vous laisse parler ensemble. Je... Euh... Je vais aller faire autre chose, excusez-moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140129
					],
					"speakerTitle": "Swann"
				},
				{
					"id": 705140129,
					"content": "Swann part très vite...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705140130
					]
				},
				{
					"id": 705140130,
					"content": "Eh bien, il semble que l'Ordre de Favonius croule sous les tâches à traiter. C'est bien ce que j'avais entendu dire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140131
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140131,
					"content": "Alors, pourquoi êtes-vous venu à Mondstadt ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140132
					]
				},
				{
					"id": 705140132,
					"content": "Moi ? En fait, mon plan est de visiter tous les coins de Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140133
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140133,
					"content": "Et le but de mon voyage est de vendre ces noyaux cinétiques que j'ai fabriqués.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140134
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140134,
					"content": "En termes simples, il s'agit d'un mécanisme à ressort. Si on tord le ressort de temps en temps, son noyau peut fournir de l'énergie pendant une longue période.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140135
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140135,
					"content": "Afin de pouvoir faire la publicité de ce mécanisme, j'ai spécialement conçu un jouet qui fonctionne grâce à ce noyau cinétique. Et je l'ai appelé « cadre mécanique perpétuel ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140136
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140136,
					"content": "Euh... Cependant, c'est regrettable... Je rêverais de pouvoir vous montrer ce mécanisme, mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140137
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140137,
					"content": "Il se révèle si bon que même les monstres ne peuvent pas résister à son charme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140138
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140138,
					"content": "Et maintenant... Les monstres ont démonté mon mécanisme en d'innombrables pièces et ils sont en train d'admirer leur travail...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140139
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140139,
					"content": "Bien que j'aie déjà demandé de l'aide à la Guilde des aventuriers, je n'ai pas encore eu de nouvelles d'eux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140140
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140140,
					"content": "#Chevalier honoraire, si vous êtes {M#intéressé}{F#intéressée}, pouvez-vous me rendre un service{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140141
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140141,
					"content": "Croyez-moi, mon mécanisme... et les récompenses ne vous décevront en aucun cas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140142
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140142,
					"content": "Vous pouvez compter sur moi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140143
					]
				},
				{
					"id": 705140143,
					"content": "#Génial ! Vous êtes {M#un aventurier aussi fort et compatissant}{F#une aventurière aussi forte et compatissante} que le disent les journaux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140144
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140144,
					"content": "C'est dommage que l'on soit à Mondstadt. Si on était à la Cour de Fontaine, je vous aurais mis en contact avec les journalistes de L'Oiseau de vapeur pour vous donner une interview.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140145
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140145,
					"content": "Ils seraient sûrement une fois de plus impressionnés par votre charme et vous laisseraient volontiers la une de leur journal ainsi qu'une rémunération pour les trois prochaines semaines !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140124,
					"content": "Les unes, les numéros complets, les interviews d'experts et les meilleures illustrations, ha ! Ils ont gagné énormément d'argent !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140125
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140112,
					"content": "Que s'est-il passé ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140113
					]
				}
			]
		},
		{
			"id": 7051403,
