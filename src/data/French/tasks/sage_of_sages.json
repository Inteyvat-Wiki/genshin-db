					}
				]
			},
			"dialogs": [
				{
					"id": 130380101,
					"content": "Le groupe se retrouve à l'heure du rendez-vous...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130380102
					]
				},
				{
					"id": 130380102,
					"content": "J'y ai bien réfléchi. Connaissant le professeur, il savait très bien qu'en se rendant dans le désert, il y avait de grandes chances qu'il n'en revienne jamais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380103
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380103,
					"content": "C'est un homme têtu qui a tendance à se mettre en colère lorsqu'il est convaincu de quelque chose. Nous n'arriverons pas à le convaincre de s'échapper.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380104
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380104,
					"content": "Je suis d'accord. Mon maître, Naphis, a dit que Cyrus était quelqu'un de très têtu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380105
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380105,
					"content": "J'ai aussi pensé à autre chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380106
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380106,
					"content": "Vous savez tout ce que vous devez savoir sur le Temple du silence. Je n'ai donc rien à ajouter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380107
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380107,
					"content": "Mes souvenirs de cet endroit sont encore flous, probablement à cause des fragments de Ba. Quand j'étais petit, j'avais souvent des maux de tête et de la fièvre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380108
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380108,
					"content": "Je me souviens de brefs moments d'émotion intense alors que des images floues défilaient devant mon esprit. Mais je n'en sais plus grand-chose, juste quelques bribes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380109
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380109,
					"content": "J'étais encore jeune à l'époque et tout ce que j'ai compris, c'est qu'il y avait cette volonté incroyablement forte dans mon esprit. Maintenant que j'y pense, je pense que c'était une façon pour Hermanubis de m'encourager même lorsque nous ne pouvions pas communiquer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380110
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380110,
					"content": "Le pouvoir qui commençait à habiter mon esprit était peut-être un pilier de toute leur foi. Si la volonté et le pouvoir de Hermanubis sont réels ainsi que tangibles et qu'ils sont ses fidèles légitimes, alors...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380111
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380111,
					"content": "Vous n'allez pas céder à leurs demandes, n'est-ce pas ? Il doit y avoir un autre moyen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380112,
						130380113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130380112,
					"content": "Ne prenez pas de décisions irréfléchies, Cyno.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380114
					]
				},
				{
					"id": 130380114,
					"content": "Non, je n'ai pas l'intention de le rendre. Mais le Temple du silence a le droit de décider de son sort, puisqu'il appartient à l'un des sept piliers du Roi Deshret...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380115
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380115,
					"content": "Je vais donc les défier directement et me battre pour le droit d'utiliser ce pouvoir, de manière équitable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380116
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380116,
					"content": "Ça me rappelle quelque chose qu'Alhaitham m'a dit juste avant notre départ. Il a déclaré que le Temple du silence avait été fondé à l'origine par l'élite dirigeante de l'époque. Traditionnellement, ces organisations sont liées par un code aristocratique strict et ancien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380117
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380117,
					"content": "Lors de ses voyages d'affaires là-bas, Kaveh a fait des observations similaires sur les habitants du désert. Il dit que beaucoup d'entre eux suivent leurs propres règles. Ils soulignent toujours l'importance de ne jamais déshonorer leurs liens tribaux ni les règles établies par leurs ancêtres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380118
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380118,
					"content": "Je pense que nous pouvons utiliser ça à notre avantage. Retournons les voir avec une proposition.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380119
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380119,
					"content": "Waouh... On a renversé la situation !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130380120,
					"content": "Nous avons probablement eu la même idée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380121
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380121,
					"content": "Prenons l'initiative et faisons-lui une offre qu'il ne pourra pas refuser. C'est notre clé vers la victoire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380122
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380122,
					"content": "Ça me va.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380123
					]
				},
				{
					"id": 130380123,
					"content": "Très bien, et je sais déjà par où commencer la conversation. Allons voir Sethos. Nous allons lui dire que j'ai étudié la médecine et que j'aimerais examiner son grand-père.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380113,
					"content": "Il doit y avoir un autre moyen !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380114
					]
				}
			]
		},
