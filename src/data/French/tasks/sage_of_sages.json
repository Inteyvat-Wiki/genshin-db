			"dialogs": [
				{
					"id": 130380501,
					"content": "Le deuxième tour est terminé. Combattants du troisième tour, veuillez vous avancer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380502
					],
					"speakerTitle": "Duaenre"
				},
				{
					"id": 130380502,
					"content": "Je suis prêt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380503
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380503,
					"content": "Moi aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380504
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380504,
					"content": "C'est la dernière étape du rituel. Je vous rappelle à tous les deux que les conditions que vous avez acceptées sont contraignantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380505
					],
					"speakerTitle": "Duaenre"
				},
				{
					"id": 130380505,
					"content": "Vous pouvez commencer quand vous êtes prêts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380506
					],
					"speakerTitle": "Duaenre"
				},
				{
					"id": 130380506,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380507
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380507,
					"content": "Je suis Sethos, détenteur du pouvoir de Hermanubis et petit-fils de Bamoun, le chef actuel du Temple du silence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380508
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380508,
					"content": "Depuis de nombreuses années, nous respectons notre vœu envers Hermanubis en gardant les secrets du roi Deshret. Et même dans nos heures les plus sombres, quand nous pensions qu'il n'y avait plus d'issue, nous n'avons pas perdu espoir. Nous nous sommes lancés dans une nouvelle expérience qui nous permettrait d'avancer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380509
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380509,
					"content": "Nous recherchons la sagesse et le pouvoir de Hermanubis, aspirant à voir son esprit et sa lumière descendre sur nous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380510
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380510,
					"content": "Je me bats pour être le porteur légitime de ce pouvoir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380511
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380511,
					"content": "Je suis Cyno, général mahamatra de l'Académie, disciple et successeur de Cyrus, le chercheur du Spantamad. Je me bats pour défendre mon pouvoir, mon professeur et ma nation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380512
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380512,
					"content": "Et vous ? Je pense que vous avez oublié quelque chose. C'est un duel sacré devant Hermanubis. Vous devez révéler ce qu'il y a réellement dans votre cœur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380513
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380513,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380514
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380514,
					"content": "(Tout le monde, vieux ou jeunes, hommes ou femmes, est impatient de connaître l'issue de ce duel.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380515
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380515,
					"content": "Mon grand-père est un dirigeant avisé. Il est également connu comme n'ayant pas peur de se salir les mains. Je connais ses convictions et je sais qu'il a de grandes attentes pour moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380516
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380516,
					"content": "Mais notre foi nous a retenus trop longtemps. Quand j'étais enfant, je suis allé un jour dans la forêt tropicale et j'ai vu les gens de la ville de mes propres yeux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380517
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380517,
					"content": "Les temps ont changé. Les habitants de Sumeru sont plus heureux et plus libres aujourd'hui que par le passé. Je l'ai réalisé alors que je me tenais à l'un des points les plus élevés de la ville à observer les rues en contrebas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380518
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380518,
					"content": "Et c'est là que j'ai pensé à vous, Cyno. Nous avons tous les deux le même pouvoir. Mais les vies que nous menons ne pourraient pas être plus différentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380519
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380519,
					"content": "#Chaque fragment de Ba de Hermanubis représente quelque chose de différent{NON_BREAK_SPACE}: la puissance, la gloire... ou bien d'autres secrets qui n'ont pas encore été révélés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380520
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380520,
					"content": "Autrefois, je croyais que la nature de nos fragments était ce qui nous différenciait. Mais c'est peut-être davantage parce que vous avez trouvé votre réponse alors que je cherche encore la mienne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380521
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380521,
					"content": "Je suis plus qu'un simple guerrier. Je suis une personne à part entière.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380522
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380522,
					"content": "... Parfaitement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380523
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380523,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380524
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380524,
					"content": "Le nom « Hermanubis » nous a façonnés tous les deux et a influencé nos vies. Nous sommes les porteurs de son pouvoir, mais nous sommes aussi bien plus encore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380525
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380525,
					"content": "S'il s'agissait de vous, vous pourriez certainement répondre à ma question. Que puis-je apporter à part cette force et cette foi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380526
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380526,
					"content": "Allez !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380527
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380527,
					"content": "Qu'est-ce qu'il y a ? Est-ce que ça va ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130380528,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380529
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380529,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sethos"
				}
			]
