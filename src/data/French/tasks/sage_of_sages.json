			},
			"dialogs": [
				{
					"id": 130380601,
					"content": "Eh bien, dans l'état actuel des choses, il n'y a plus de retour en arrière possible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380602
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380602,
					"content": "Il n'y en a jamais eu. Depuis que le professeur est parti dans le désert, faire demi-tour n'a plus été une option pour moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380603
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380603,
					"content": "Il faut gagner ! Tu as besoin de ce pouvoir à la fois en tant que mahamatra et pour toi-même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380604
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380604,
					"content": "C'est vrai. En plus, vous le portez depuis que vous êtes petit. C'est certainement un signe qu'il vous considère comme le porteur légitime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130380605,
					"content": "... À la fois en tant que mahamatra et pour moi-même...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380606
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380606,
					"content": "Eh bien, c'est vrai que dit comme ça... J'ai vraiment dû traverser beaucoup de choses pour maîtriser ce pouvoir. Ce n'est pas à la portée de tout le monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380607
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380607,
					"content": "Exactement !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380608,
						130380609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130380608,
					"content": "Ne nous laissons pas distraire. Concentrons-nous sur la victoire !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380610
					]
				},
				{
					"id": 130380610,
					"content": "#Oui, {NICKNAME} et moi ne perdrons pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380611
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380611,
					"content": "Moi non plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380612
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380612,
					"content": "Le désert abritait autrefois une civilisation ancienne et importante qui, pour diverses raisons, est entrée en conflit avec la civilisation de la forêt tropicale. Comme le dit Dehya : les préjugés creusent un fossé entre les gens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380613
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380613,
					"content": "Mais les motivations personnelles jouent certainement un rôle aussi. Je ne peux pas m'empêcher de penser que Bamoun se soucie de bien plus de choses qu'il ne le laisse paraître. Et je ne pense pas que Sethos soit une mauvaise personne. Il fait simplement ce qu'il pense être juste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380614
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380614,
					"content": "... Demain, tout s'éclaircira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380609,
					"content": "Nous allons vous aider.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380610
					]
				}
			]
		},
