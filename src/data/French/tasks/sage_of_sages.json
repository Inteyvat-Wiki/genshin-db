					}
				]
			},
			"dialogs": [
				{
					"id": 130380201,
					"content": "Discutons, Sethos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380202
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380202,
					"content": "Avez-vous pris une décision ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380203
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380203,
					"content": "Avant toute chose, j'ai quelques connaissances médicales. Je me demandais si je pouvais examiner votre grand-père ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380204
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380204,
					"content": "Je n'y vois pas d'inconvénient, mais nous avons des médecins ici. Je doute que vous puissiez nous apprendre quoi que soit de nouveau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380205
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380205,
					"content": "Il n'y a qu'une seule façon de le savoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380206
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380206,
					"content": "Suivez-moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380207
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380207,
					"content": "Ne parlez pas trop fort, il ne faut pas le déranger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380208
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380208,
					"content": "Tighnari déballe sa trousse et fait passer à Bamoun un examen médical de base.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130380209
					]
				},
				{
					"id": 130380209,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380210
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380210,
					"content": "Parlons dehors.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380211
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380211,
					"content": "Bamoun est dans un coma profond et le pronostic est assez grave. Nul doute que vos médecins sont arrivés à la même conclusion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380212
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380212,
					"content": "Il semble avoir subi une grave blessure dans sa jeunesse. Ses années de dur labeur et maintenant la vieillesse ont aggravé la situation...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380213
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380213,
					"content": "Je dois malheureusement vous informer que... d'après ce que j'ai vu chez des patients dans un état similaire, il ne lui reste plus beaucoup de temps. Quelques jours, tout au plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380214
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380214,
					"content": "... Oui, je le sais depuis longtemps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380215
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380215,
					"content": "Vous êtes son héritier, n'est-ce pas ? Vous avez évidemment le plus grand respect pour cet homme. Mais vous voyez aussi les choses un peu différemment. Vous avez un éventail de préoccupations plus large et une approche plus pragmatique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380216
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380216,
					"content": "Alors, dites-moi comment nous pouvons mettre fin à cela selon vos conditions. Nous devrions trouver un moyen de régler tout ça pendant que Bamoun est encore en vie... C'est ce qui vous tient vraiment à cœur, j'en suis sûr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380217
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380217,
					"content": "Oui, nous n'avons pas de temps à perdre. Vous le savez mieux que quiconque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130380218,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380219
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380219,
					"content": "En réalité, vous vous trouvez dans une situation très similaire en ce moment. Vous avez tous les deux une perspective très différente de celle des hommes qui vous ont élevés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380220
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380220,
					"content": "C'est le conflit d'une autre génération, mais c'est à vous de prendre les décisions difficiles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130380221,
					"content": "... Vous avez raison. Notre vision du problème est très différente de celle de nos prédécesseurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380222
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380222,
					"content": "Je suis d'accord, Cyno. Tout a commencé à cause de Hermanubis, alors mettons un terme à tout cela avec un rituel qu'il a créé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380223
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380223,
					"content": "La légende raconte que lorsque Hermanubis est arrivé à Tulaytullah, il a combattu avec les habitants de la ville. Ses deux compagnons et lui ont démontré leur bravoure en se battant pendant plusieurs jours, gagnant le soutien de nombreuses personnes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380224
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380224,
					"content": "Ce groupe de partisans était parmi les premiers membres du Temple du silence et ces duels ont été immortalisés comme l'un de nos rites fondateurs... Le rituel de duel. C'est là que tout a commencé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380225
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380225,
					"content": "Ça me paraît très bien. Faisons comme ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380226
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380226,
					"content": "Vous portez également le pouvoir de Hermanubis, et vous êtes profondément lié au Temple du silence. Je vous autorise donc à participer à ce rite avec vos compagnons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380227
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380227,
					"content": "Trois contre trois, très bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380228
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380228,
					"content": "Mais je voudrais ajouter une condition. En tant qu'adversaires, vous devez gagner les trois combats pour l'emporter. Et Cyno, nous devons chacun mettre en jeu notre fragment de Ba. Le gagnant repartira avec les deux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380229
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380229,
					"content": "C'était une erreur de mon grand-père que de laisser Cyrus partir avec l'un des fragments de Ba par pitié. C'est un problème qui dure depuis trop longtemps et qui doit être résolu pour que le Temple du silence puisse avancer. Je ne peux faire aucune concession à ce sujet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380230
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380230,
					"content": "Je vois les choses exactement comme vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380231
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380231,
					"content": "Si je gagne, le Temple du silence devra laisser partir Cyrus et oublier ce différend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380232
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380232,
					"content": "Si vous gagnez, je vous rendrai mon pouvoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380233
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380233,
					"content": "Marché conclu. Nous nous retrouverons à la salle des cérémonies demain soir à huit heures.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sethos"
				}
			]
		},
