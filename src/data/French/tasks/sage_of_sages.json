			},
			"dialogs": [
				{
					"id": 130380301,
					"content": "Nous nous réunissons en ce jour pour célébrer une fois de plus le rituel de duel avec le plus grand de tous les sages, Hermanubis, comme témoin. Son pouvoir et son autorité résident parmi nous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380302
					],
					"speakerTitle": "Duaenre"
				},
				{
					"id": 130380302,
					"content": "Il s'agit de notre cérémonie la plus sacrée et nous ne tolérons aucune perturbation de la part du public. Il est de la responsabilité de chaque individu d'assister au duel avec le plus de respect et de dévotion possible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380303
					],
					"speakerTitle": "Duaenre"
				},
				{
					"id": 130380303,
					"content": "Pour représenter le Temple du silence : les défenseurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380304
					],
					"speakerTitle": "Duaenre"
				},
				{
					"id": 130380304,
					"content": "Grand-père, vous voilà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380305
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380305,
					"content": "*tousse* ... Un rituel de duel, après toutes ces années... Ta décision me surprend, Sethos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380306
					],
					"speakerTitle": "Bamoun"
				},
				{
					"id": 130380306,
					"content": "Je sais ce que je fais, grand-père. Laissez-moi faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380307
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380307,
					"content": "Pour représenter l'Académie : les adversaires.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380308
					],
					"speakerTitle": "Duaenre"
				},
				{
					"id": 130380308,
					"content": "Nous sommes prêts. Nous nous battrons pour faire entendre nos voix.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380309
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380309,
					"content": "Guerriers, prenez position et décidez de l'ordre de combat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380310
					],
					"speakerTitle": "Duaenre"
				},
				{
					"id": 130380310,
					"content": "Nous ne sommes pas ici pour discuter des motivations de nos adversaires ou du sort des duellistes perdants. Duellistes, il s'agit du pouvoir de Hermanubis lui-même. C'est le moment de combattre jusqu'à ce que le vrai vainqueur soit couronné !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380311
					],
					"speakerTitle": "Duaenre"
				},
				{
					"id": 130380311,
					"content": "Je vais commencer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380312
					]
				},
				{
					"id": 130380312,
					"content": "#Oh ? Tu es {M#sûr}{F#sûre} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130380313,
					"content": "Oui, le moral est très important.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380314
					]
				},
				{
					"id": 130380314,
					"content": "#Je suis d'accord, {NICKNAME} est très {M#fort}{F#forte}. L'envoyer d'abord intimidera certainement le camp adverse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380315
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380315,
					"content": "Tu vas passer en deuxième.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380316
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380316,
					"content": "D'accord.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380317
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380317,
					"content": "Nous avons décidé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380318
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380318,
					"content": "Nous aussi. Allons-y !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sethos"
				}
			]
		},
