			"dialogs": [
				{
					"id": 200530101,
					"content": "Qu'est-ce que je suis censée faire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530102
					],
					"speakerTitle": "Eileen"
				},
				{
					"id": 200530102,
					"content": "Qu'est-ce qu'il t'arrive ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200530103
					]
				},
				{
					"id": 200530103,
					"content": "Je m'entraîne pour la sélection de l'Ordre de Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530104
					],
					"speakerTitle": "Eileen"
				},
				{
					"id": 200530104,
					"content": "Mais je suis loin d'être aussi puissante que Jean...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530105
					],
					"speakerTitle": "Eileen"
				},
				{
					"id": 200530105,
					"content": "Je pense que je devrais me concentrer davantage sur la technique que sur la force.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530106
					],
					"speakerTitle": "Eileen"
				},
				{
					"id": 200530106,
					"content": "Par exemple, je me demandais comment je pourrais casser tous ces mannequins en un coup...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530107
					],
					"speakerTitle": "Eileen"
				},
				{
					"id": 200530107,
					"content": "Si tu as un peu de temps libre, ça te dit de réfléchir avec moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530108,
						200530109
					],
					"speakerTitle": "Eileen"
				},
				{
					"id": 200530108,
					"content": "Ça marche.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200530110
					]
				},
				{
					"id": 200530110,
					"content": "Merci. Prends ton temps, ces mannequins n'iront nulle part.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530111
					],
					"speakerTitle": "Eileen"
				},
				{
					"id": 200530111,
					"content": "Moi non plus d'ailleurs... Je suis coincée ici jusqu'à ce que je trouve la solution...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530114
					],
					"speakerTitle": "Eileen"
				},
				{
					"id": 200530114,
					"content": "À cette distance, je pourrais briser les pieux d'un côté et balancer une bombe sur l'autre côté.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530115
					],
					"speakerTitle": "Eileen"
				},
				{
					"id": 200530115,
					"content": "Je rigole ! Où trouver une bombe de toute façon ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eileen"
				},
				{
					"id": 200530109,
					"content": "Voyons voir ça ensemble...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200530112
					]
				},
				{
					"id": 200530112,
					"content": "Tu aimes bien combattre en équipe ? C'est super d'avoir quelqu'un sur qui on peut compter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530113
					],
					"speakerTitle": "Eileen"
				},
				{
					"id": 200530113,
					"content": "Le mieux que je puisse faire est de me battre seule...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530114
					],
					"speakerTitle": "Eileen"
				}
			]
		},
