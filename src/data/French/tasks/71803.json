					],
					"speakerTitle": "Grisounet"
				},
				{
					"id": 718030302,
					"content": "Qu'est-ce qu'un chat fait ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030303,
					"content": "Miaou... Miaou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030304,
						718030308
					],
					"speakerTitle": "Grisounet"
				},
				{
					"id": 718030304,
					"content": "Un chat gris...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030305
					]
				},
				{
					"id": 718030305,
					"content": "Un chat gris, perdu dans la nature...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030306,
					"content": "Ah, mais ce chat dont parlait Lan tout à l'heure ! Il s'appelle Grisounet, je crois ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030307,
					"content": "Qui aurait cru qu'on tomberait sur lui ? C'est là qu'il se cachait depuis tout ce temps ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030311,
					"content": "Je suppose que personne n'a osé s'approcher d'ici avec le Chef Brutorocheux dans les parages. Quant au chat, il n'avait pas d'autre choix que de se cacher par peur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030312,
					"content": "#Heureusement que nous sommes {M#venus}{F#venues}. Il aurait attendu encore très longtemps ici sinon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030313,
					"content": "Miaou... Miaou ! Miaou !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030314,
						718030317
					],
					"speakerTitle": "Grisounet"
				},
				{
					"id": 718030314,
					"content": "Miaou... Miaou...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030315
					]
				},
				{
					"id": 718030315,
					"content": "Qu'est-ce que tu fais ? Je ne crois pas qu'il comprenne ce que tu dis de toute façon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030316,
					"content": "Ramenons-le à Lan pour qu'elle puisse le rendre à son maître.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030319,
					"content": "Miaou... Miaou ! Miaou !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030320,
						718030322
					],
					"speakerTitle": "Grisounet"
				},
				{
					"id": 718030320,
					"content": "Miaou... Miaou ! Miaou !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030321
					]
				},
				{
					"id": 718030321,
					"content": "Allez, arrête. Il ne te comprendra jamais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030322,
					"content": "Il a l'air d'accord avec nous.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030323
					]
				},
				{
					"id": 718030323,
					"content": "Depuis quand tu es bilingue en langue féline ? ... Enfin, bref. Retournons voir Lan !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030317,
					"content": "On devrait le ramener à Lan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030318
					]
				},
				{
					"id": 718030318,
					"content": "Pas comme si on avait d'autre choix. Elle le rendra à son maître.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030308,
					"content": "Attends, mais ce ne serait pas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030309
					]
				},
				{
					"id": 718030309,
					"content": "Un chat gris, perdu dans la nature...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030310,
					"content": "Ah, mais ce chat dont parlait Lan tout à l'heure ! Qui aurait cru qu'on le trouverait... C'est là qu'il se cachait depuis tout ce temps ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
