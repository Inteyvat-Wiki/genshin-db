			"dialogs": [
				{
					"id": 80062001,
					"content": "Un feu de camp, tout comme chez les Brutocollinus ordinaires.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80062002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80062002,
					"content": "Dain a pourtant dit que les Brutocollinus craignaient la lumière lors des derniers moments de leur vie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80062003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80062003,
					"content": "Se pourrait-il qu'ils souhaitent sentir une dernière fois la chaleur et la lumière dans leurs derniers moments ? Ce n'est qu'une supposition, peut-être y a-t-il une autre raison !",
					"roleType": "TALK_ROLE_NPC",
