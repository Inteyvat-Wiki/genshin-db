			},
			"dialogs": [
				{
					"id": 80062201,
					"content": "Ces Brutocollinus sont dénués de vie... Ils sont sur le point de s'unir aux ténèbres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80062202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80062202,
					"content": "C'est donc comme ça que les Brutocollinus vieillissent, eux qui sont si bruyants et agités. Ça paraît incroyable, quand on y pense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80062203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80062203,
					"content": "Même si je n'ai pas beaucoup de bons souvenirs d'eux, j'espère tout de même qu'ils sauront trouver la paix dans leurs derniers instants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
