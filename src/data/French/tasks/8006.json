			"dialogs": [
				{
					"id": 80060601,
					"content": "D'ici aussi, on peut voir cette cité renversée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060602,
					"content": "Non... Attention !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060603
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060603,
					"content": "Aaaah !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060604,
					"content": "Q—Qu'est-ce qui se passe ? Est-ce que c'est la salle centrale qui projette cette lumière ? J'ai mal aux yeux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060605,
					"content": "La mutation se poursuit. L'Ordre de l'Abîme aurait-il déjà commencé à agir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060606
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060606,
					"content": "#Dainsleif... Tu es décidément obstiné. Et je vois que tu t'es encore allié avec {M#le frère}{F#la sœur} de Son Altesse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060607
					],
					"speakerTitle": "Apôtre de l'Abîme"
				},
				{
					"id": 80060607,
					"content": "Je n'ai pas eu le temps de régler le réseau de téléportation, et je t'ai envoyé ici par erreur... Une maladresse qui pourrait être fatale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060608
					],
					"speakerTitle": "Apôtre de l'Abîme"
				},
				{
					"id": 80060608,
					"content": "Hmph ! Tu n'es qu'un lâche qui ne sait que s'enfuir ! Qu'est-ce qui t'a donné le courage de me faire face ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060609
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060609,
					"content": "#La volonté de Son Altesse {M#la princesse}{F#le prince} doit être accomplie. Pour cela, il est nécessaire d'éradiquer tout obstacle, quoi qu'il en coûte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060610
					],
					"speakerTitle": "Apôtre de l'Abîme"
				},
				{
					"id": 80060610,
					"content": "Nous allons éradiquer cette malédiction qui tourmente notre peuple une bonne fois pour toutes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060611
					],
					"speakerTitle": "Apôtre de l'Abîme"
				},
				{
					"id": 80060611,
					"content": "C'est vous qui les tourmentez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060612
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060612,
					"content": "Il ne reste plus rien à ces Brutocollinus, si ce n'est cette malédiction.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060613
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060613,
					"content": "Je ne fuirai pas. Viens, Dainsleif !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060614
					],
					"speakerTitle": "Apôtre de l'Abîme"
				},
				{
					"id": 80060614,
					"content": "Cela vaut-il vraiment la peine de faire don de ta vie pour faire gagner du temps à une cause risible ? Si tu souhaites t'obstiner dans cette voie, alors tant pis pour toi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				}
			]
		},
