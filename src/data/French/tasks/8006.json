			},
			"dialogs": [
				{
					"id": 80060501,
					"content": "Comment peut-il y avoir des fleurs pareilles dans un endroit aussi profond ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060502,
					"content": "Sont-elles dédiées à ces Brutocollinus qui partent vers l'au-delà ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060503,
						80060504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060503,
					"content": "Je connais ces fleurs...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060505
					]
				},
				{
					"id": 80060505,
					"content": "Tiens, maintenant que tu le dis, elles me disent quelque chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060506,
					"content": "C'est la fleur nationale de Khaenri'ah : l'« inteyvat ». Elle poussait autrefois dans tout le territoire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060507
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060507,
					"content": "La floraison de cette fleur ne dure que deux semaines. Mais si on l'arrache et qu'on l'emmène hors des terres de Khaenri'ah, ses pétales ne poussent plus et deviennent extrêmement durs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060508
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060508,
					"content": "Ce n'est qu'en retournant sur leurs terres natales que ces pétales redeviennent souples et doux, pour finir par disparaître dans la terre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060509
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060509,
					"content": "C'est pour cette raison que l'inteyvat est considérée comme le symbole du vagabond. Il a pour signification la « tendresse des terres natales ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060510
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060510,
					"content": "#{M#C'est la fleur que ma sœur portait dans ses cheveux.}{F#C'est la fleur que je porte dans mes cheveux depuis mon réveil.}",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060511
					]
				},
				{
					"id": 80060511,
					"content": "Ah ! Si cette fleur est apparue ici, ça veut dire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060512,
					"content": "#{M#Princesse}{F#Prince}, êtes-vous finalement d'accord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060513
					],
					"speakerTitle": "Apôtre de l'Abîme"
				},
				{
					"id": 80060513,
					"content": "À trop me plonger dans cette grande cause qu'est la lutte contre l'ordre divin, j'en oublie ma mission première : la renaissance du royaume.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060514
					]
				},
				{
					"id": 80060514,
					"content": "#Il est vrai que je ne devrais pas être si {M#indécise}{F#indécis}.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060515
					]
				},
				{
					"id": 80060515,
					"content": "L'installation est bientôt terminée. Nous attendons vos instructions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060516
					],
					"speakerTitle": "Apôtre de l'Abîme"
				},
				{
					"id": 80060516,
					"content": "Quelles sont les chances de réussite ?",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060517
					]
				},
				{
					"id": 80060517,
					"content": "En théorie, elles s'élèvent à...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060518
					],
					"speakerTitle": "Apôtre de l'Abîme"
				},
				{
					"id": 80060518,
					"content": "Oublie ça. Même s'il n'y avait qu'une chance infime...",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060519
					]
				},
				{
					"id": 80060519,
					"content": "Nous sommes comme eux. Nous nous trouvons dans l'Abîme depuis longtemps.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060520
					]
				},
				{
					"id": 80060520,
					"content": "Pour eux, il est préférable de retourner dans le « cycle » plutôt que de vivre sans dignité.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060521
					]
				},
				{
					"id": 80060521,
					"content": "Il ne faut plus que nous les laissions porter ces pêchés sans fondement.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060522
					]
				},
				{
					"id": 80060522,
					"content": "Votre détermination est une chance pour l'Ordre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060523
					],
					"speakerTitle": "Apôtre de l'Abîme"
				},
				{
					"id": 80060523,
					"content": "#{M#Lumine}{F#Aether}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060524
					]
				},
				{
					"id": 80060524,
					"content": "Vous semblez avoir vu quelque chose. Pouvez-vous m'en parler ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060525
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060525,
					"content": "Oui, tu avais le regard vide pendant un moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060526,
					"content": "Vous racontez votre vision à Dainsleif...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						80060527
					]
				},
				{
					"id": 80060527,
					"content": "Est-ce là le lien mystique qui unit des jumeaux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060528
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060528,
					"content": "D'après vous, il semblerait qu'ils cherchent à utiliser un dispositif pour défaire la malédiction. C'est probablement l'objet que nous avons vu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060529
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060529,
					"content": "#Et puis... {M#votre sœur}{F#votre frère} a également parlé de « renaissance du royaume », c'est bien cela ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060530,
						80060531
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060530,
					"content": "Oui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060532
					]
				},
				{
					"id": 80060532,
					"content": "Cette tête de mule n'a toujours pas abandonné.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060533
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060533,
					"content": "L'Ordre semble vouloir utiliser cet endroit pour briser la malédiction des Brutocollinus et leur faire retrouver leur forme originelle... Ceux-ci constitueront alors le fondement de la renaissance de Khaenri'ah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060534
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060534,
					"content": "Après tout, une nation en est-elle vraiment une sans son peuple ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060535,
						80060536
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060535,
					"content": "Qu'en pensez-vous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060537
					]
				},
				{
					"id": 80060537,
					"content": "Hmph. Quelle idiotie ! Il n'y a pas la moindre chance que cela soit possible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060538
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060538,
					"content": "Comme je l'ai déjà dit, j'ai vécu cinq siècles avec cette malédiction. Alors je le sais mieux que quiconque : il n'existe aucune rédemption possible. La malédiction est irréversible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060539
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060539,
					"content": "Essayez de la briser de force, et vous n'obtiendrez que de la douleur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060540
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060540,
					"content": "Il faut donc garder les pieds sur terre, et se répéter que ces êtres ne sont déjà plus des humains.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060541
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060541,
					"content": "En s'accrochant à de faux espoirs et en s'investissant émotionnellement, on s'enfonce de plus en plus... jusqu'à finir comme eux, embourbés dans une fange d'hypocrisie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060542
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060542,
					"content": "Il est préférable de s'investir dans des choses qui valent la peine d'être sauvées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060543
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060543,
					"content": "Pourquoi devrais-je vous faire confiance ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060544
					]
				},
				{
					"id": 80060544,
					"content": "Hmm ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060545
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060545,
					"content": "#Haha... Vous avez raison. Nous n'avons qu'une relation de travail, vous et moi, tandis qu'{M#elle}{F#il} est votre {M#sœur}{F#frère}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060546
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060546,
					"content": "#Il est tout à fait raisonnable que vous preniez parti pour {M#elle}{F#lui}. Je n'y vois pas de problème.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060547
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060547,
					"content": "Peu importe votre choix, ma résolution initiale restera inchangée. Arrêter l'Ordre de l'Abîme est l'objectif que je me suis fixé. S'il nous est impossible de trouver un point d'entente, alors...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060548
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060548,
					"content": "Je choisis de vous faire confiance pour cette fois.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060549,
						80060550
					]
				},
				{
					"id": 80060549,
					"content": "Mais ça ne veut pas dire que je vous fais entièrement confiance.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060551
					]
				},
				{
					"id": 80060551,
					"content": "Ah oui ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060552,
						80060553
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060552,
					"content": "1 % de chance d'obtenir la rédemption.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060554,
						80060555
					]
				},
				{
					"id": 80060554,
					"content": "Personne n'a le droit de...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060556,
						80060557
					]
				},
				{
					"id": 80060556,
					"content": "De plus, ces Brutocollinus...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060558
					]
				},
				{
					"id": 80060558,
					"content": "Vous voyez que les trois questions que je vous ai posées n'étaient pas sans importance. Vous avez trouvé une manière de voir ce monde qui vous est propre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060559
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060559,
					"content": "Puisque vous m'avez fait part du véritable fond de votre pensée, je ne compte pas vous le cacher plus longtemps non plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060560
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060560,
					"content": "Aujourd'hui, je ne cherche plus simplement à arrêter l'Abîme. Le plus important pour moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060561
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060561,
					"content": "... C'est que je ne peux plus tolérer la démarche arbitraire de l'Abîme. Je ne peux les laisser fouler aux pieds la volonté de Halfdan et des autres chevaliers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060562,
						80060563
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060562,
					"content": "Je comprends.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060564
					]
				},
				{
					"id": 80060564,
					"content": "L'Abîme peut apparaître à tout moment. Restons sur nos gardes et continuons d'avancer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060563,
					"content": "Continuons de travailler ensemble.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060564
					]
				},
				{
					"id": 80060557,
					"content": "... Ont déjà fait le choix de leur destinée.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060558
					]
				},
				{
					"id": 80060555,
					"content": "... Prendre cette décision pour les autres.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060556,
						80060557
					]
				},
				{
					"id": 80060553,
					"content": "99 % de chances de mourir dans la douleur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060554,
						80060555
					]
				},
				{
					"id": 80060550,
					"content": "#C'est simplement parce que je suis en désaccord avec la façon de faire de {M#ma sœur}{F#mon frère}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060551
					]
				},
				{
					"id": 80060536,
					"content": "Pourront-ils réaliser leur plan ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060537
					]
				},
				{
					"id": 80060531,
					"content": "#{M#Elle}{F#Il} a dit que c'était sa mission.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060532
					]
				},
				{
					"id": 80060504,
					"content": "J'ai déjà vu ce type de fleurs.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060505
					]
				}
			]
		}
	]
}