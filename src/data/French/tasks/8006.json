			},
			"dialogs": [
				{
					"id": 80062101,
					"content": "Ces caisses sont habituellement utilisées par les Brutocollinus pour entreposer de la nourriture.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80062102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80062102,
					"content": "Elles ont l'air d'être toutes vides. Les Brutocollinus n'auraient-ils pas besoin de se nourrir à l'approche de leur fin ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80062103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80062103,
					"content": "À leur place, le goût de la nourriture me manquerait... Au minimum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 800622,
			"completionStepIds": [
				800611
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
