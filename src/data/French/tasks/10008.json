			},
			"dialogs": [
				{
					"id": 100080301,
					"content": "Pfiou ! Heureusement que la meute de loups était là pour nous aider !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080302,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080303
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080303,
					"content": "Ils ont aussi retenu beaucoup de Limiers de faille... et ils nous ont aussi aidé à les repousser !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080304,
					"content": "Mais ce n'est pas... le problème des loups...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080305
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080305,
					"content": "Tu fais ça pour aider ton lupical, pas vrai ? Tu sais, ils ne veulent pas te mettre en danger non plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080306,
					"content": "Je parie qu'ils sont allés voir le Loup du Nord pour lui dire : « Écoutez ! Ce n'est pas seulement le problème de notre lupical, mais du monde entier ! »... Et qu'ils se sont précipités pour t'aider !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080307,
					"content": "Hm, « lupical » c'est... « lupical ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080308
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080308,
					"content": "Je suis humain, mais je n'ai pas besoin d'être un loup pour être « lupical ». Je... veux juste les aider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080309
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080309,
					"content": "Bien dit, Razor !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080310,
					"content": "Peut-être que Boreas a accepté de laisser la meute nous aider...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100080311
					]
				},
				{
					"id": 100080311,
					"content": "Parce qu'il sait tes intentions.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100080312
					]
				},
				{
					"id": 100080312,
					"content": "Tu... Tu crois ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080313
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080313,
					"content": "Ouais, carrément ! Allez, viens ! On va botter les fesses de ces limiers de faille !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1000806,
			"completionStepIds": [
				1000806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
