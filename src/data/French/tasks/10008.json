			"dialogs": [
				{
					"id": 100080601,
					"content": "On a réussi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080602,
					"content": "Merci... de m'avoir aidé. Je pensais que la protection de mon lupical ne dépendait que de moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080603
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080603,
					"content": "Mais, lupical aussi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080604
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080604,
					"content": "On est là parce qu'on tient à toi, tout comme tu tiens à nous ! C'est ça qui fait de nous ton lupical, pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080605,
					"content": "C'est vrai... On sera lupical pour toujours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080606
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080606,
					"content": "Oh... et maintenant, il n'y aura plus d'intrus sur le Territoire des loups !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080607,
					"content": "Non... La meute de loups noirs déchire le ciel. Ils... pourraient revenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080608
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080608,
					"content": "Mais mon lupical et moi les traquerons... quoi qu'il arrive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080609
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080609,
					"content": "... Ne nous oublie pas non plus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100080610
					]
				},
				{
					"id": 100080610,
					"content": "Oui, si tu as besoin d'aide, tu n'as qu'à le dire ! On est là pour toi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080611,
					"content": "Merci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080612
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080612,
					"content": "Aouuuuh !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080613
					],
					"speakerTitle": "Hurlement lointain"
				},
				{
					"id": 100080613,
					"content": "Ils... m'appellent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080614
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080614,
					"content": "On dirait qu'ils veulent s'assurer que tu vas bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080615,
					"content": "Dans ce cas... je devrais y aller. Merci... pour votre aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080616
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080616,
					"content": "Mais de rien ! C'est à ça que sert le lupical !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100080617
					]
				},
				{
					"id": 100080617,
					"content": "Maintenant que le Territoire des loups a retrouvé la paix, Razor vous fait ses adieux et s'enfonce dans la forêt.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						100080618
					]
				},
				{
					"id": 100080618,
					"content": "Dans l'épaisse végétation, vous apercevez plusieurs paires d'yeux qui le regardent avec bienveillance, attendant de l'accueillir chez lui.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		}
	]
