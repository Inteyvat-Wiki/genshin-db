			},
			"dialogs": [
				{
					"id": 230240701,
					"content": "#{M#Voyageur}{F#Voyageuse}, vous êtes {M#arrivé}{F#arrivée} juste à temps, le rosier est enfin en fleurs !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240702
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240702,
					"content": "Cela n'aurait pas pu être possible sans votre aide. Ce rosier est sans doute le plus beau que j'aie jamais vu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240703
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240703,
					"content": "Les médecins du Bimarestan vont sûrement s'émerveiller eux aussi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240704
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240704,
					"content": "Il n'y a pas de temps à perdre, je vais le transférer de ce pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240705
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240705,
					"content": "Attendez. C'était quoi, ce bruit ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240706
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240706,
					"content": "Quelque chose s'agite dans le champ de fleurs...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230240707
					]
				},
				{
					"id": 230240707,
					"content": "Ouah ! Une Fleur mensongère ! Qu'est-ce qu'elle fait là ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230240708,
					"content": "Oh non ! Le champ de fleurs ! Elle va tout détruire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240709,
						230240710
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240709,
					"content": "Je m'en occupe !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240711
					]
				},
				{
					"id": 230240711,
					"content": "Hé... Hein ? La Fleur mensongère... Elle s'enfuit ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230240712,
					"content": "C—Comment est-ce possible ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240713
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240713,
					"content": "Notre rose, notre herbe la plus précieuse... Elle s'est transformée en monstre et s'est enfuie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240714,
						230240715
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240714,
					"content": "Elle ne s'est pas « transformée »...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240716
					]
				},
				{
					"id": 230240716,
					"content": "Voulez-vous dire que... si le rosier a poussé si lentement, c'est à cause de cette Fleur mensongère ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240717
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240717,
					"content": "Alors, ça veut dire que... Ces engrais qui ne fonctionnent pas du tout... Le fait qu'il faille les arroser deux fois plus que d'habitude...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240718
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240718,
					"content": "E—Est-ce qu'on aurait entretenu cette Fleur mensongère pendant tout ce temps ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240719
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240719,
					"content": "Et mince... Comment s'est-elle infiltrée parmi les autres fleurs ? On ne s'est aperçus de rien !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240720
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240720,
					"content": "Nous aussi, on se fait avoir par elles, parfois.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240721
					]
				},
				{
					"id": 230240721,
					"content": "*soupir* On est vraiment dans le pétrin. Tout le champ de plantes médicinales autour a été détruit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240722
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240722,
					"content": "On n'a pas d'autre choix que d'aller voir les médecins du Bimarestan pour leur expliquer la situation, puis les replanter au plus vite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gurgen"
				},
				{
