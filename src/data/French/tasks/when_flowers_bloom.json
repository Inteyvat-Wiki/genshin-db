			"dialogs": [
				{
					"id": 230240401,
					"content": "#{M#Voyageur}{F#Voyageuse}, vous arrivez juste à temps, le rosier est en fleurs !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240402
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240402,
					"content": "Cela n'aurait pas pu être possible sans votre aide. Ce rosier est sans doute le plus beau que j'aie jamais vu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240403
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240403,
					"content": "Merci à vous, veuillez accepter ceci en guise de remerciement !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240404
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240404,
					"content": "Félicitations !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240405
					]
				},
				{
					"id": 230240405,
					"content": "#Nous aussi, on est {M#contents}{F#contentes} de voir ce rosier en fleurs !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230240406,
					"content": "Ouf... On va pouvoir effectuer notre livraison au Bimarestan à temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240407
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240407,
					"content": "J'espère que ce rosier pourra les aider...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vardan"
				}
			]
		},
