					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230240203
					]
				},
				{
					"id": 230240203,
					"content": "Rien ne se passe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240204,
						230240205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230240204,
					"content": "Je ne vois rien...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240206
					]
				},
				{
					"id": 230240206,
					"content": "Eh bien... Peut-être que ce rosier est un peu timide et n'ose pas s'ouvrir devant vous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240207
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240207,
					"content": "En tout cas, si on se fie à son rythme de croissance, il devrait avoir fleuri au plus tard d'ici demain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240208
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240208,
					"content": "#{M#Voyageur}{F#Voyageuse}, s'il vous plaît, revenez demain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240205,
					"content": "Je suis debout depuis si longtemps que j'en ai les jambes engourdies...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240206
					]
				}
			]
		},
