			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Riese"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200730201,
					"content": "Avez-vous fini de placer les provisions ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730202
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730202,
					"content": "Elles sont toutes à leur place.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200730203
					]
				},
				{
					"id": 200730203,
					"content": "Parfait ! Voilà qui m'enlève un poids !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730204
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730204,
					"content": "Enfin, j'espère cependant que ceux qui gravissent les montagnes seront bien préparés et qu'ils n'auront pas à utiliser ces provisions d'urgence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730205
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730205,
					"content": "Mais au fait, vos vêtements semblent vraiment légers. Est-ce la dernière mode à Mondstadt ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730206
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730206,
					"content": "Prenez cette récompense, et retournez vous couvrir davantage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Riese"
				}
			]
		},
