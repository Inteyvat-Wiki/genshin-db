				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Riese"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200730101,
					"content": "#{M#Voyageur}{F#Voyageuse}, vous tombez à pic ! Pourriez-vous me donner un coup de main ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730102
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730102,
					"content": "Qu'est-ce qu'il se passe ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200730103
					]
				},
				{
					"id": 200730103,
					"content": "Comme vous l'avez certainement vu, les conditions climatiques des Monts Dosdragon sont épouvantables. Même les aventuriers expérimentés n'osent pas faire face à tout ce que la montagne leur réserve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730104
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730104,
					"content": "J'ai été déployé ici par ordre de la Grande Maîtresse suppléante pour empêcher les Mondstadtois de monter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730105
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730105,
					"content": "J'ai persuadé nombre d'entre eux de ne pas gravir ces monts, mais il y a toujours ces aventuriers...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730106
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730106,
					"content": "Vous le savez certainement... On a beau les prévenir, ils n'en font qu'à leur tête...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730107
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730107,
					"content": "Je ne compte même plus le nombre d'incidents que j'ai dû résoudre à cause de ces têtes brûlées... Mais il y en a de plus en plus qui veulent tenter l'ascension.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730108
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730108,
					"content": "Et je ne peux pas m'occuper de tout ce monde... Alors on place des provisions à certains endroits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730109
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730109,
					"content": "Comme ça, les aventuriers qui n'en peuvent plus et veulent rebrousser chemin ont une meilleure chance de s'extirper des montagnes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730110
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730110,
					"content": "Mais... Un aventurier téméraire montant trop haut ne pourra compter que sur lui-même...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730111
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730111,
					"content": "Est-ce que vous pourriez m'aider à placer ces provisions dans la montagne ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730112,
						200730114
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730112,
					"content": "Je m'en charge.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200730113
					]
				},
				{
					"id": 200730113,
					"content": "Je compte sur vous alors ! *soupir* Ce serait formidable si ces aventuriers étaient davantage comme vous, et avaient la tête sur les épaules...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730117
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730117,
					"content": "J'ai marqué trois emplacements sur votre carte. Vous n'avez qu'à placer <color=#00E1FFFF>une portion de jambon</color> à chaque endroit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730118
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730118,
					"content": "*soupir* Si seulement ces aventuriers étaient un peu plus responsables...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730114,
					"content": "Et... Ce sera utile ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200730115
					]
				},
				{
					"id": 200730115,
					"content": "Utile ou pas... Mieux vaut avoir quelque chose que rien du tout !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730116
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730116,
					"content": "Avec les conditions affreuses du coin, avoir davantage de provisions n'est jamais une mauvaise chose ! Je compte sur vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730117
					],
					"speakerTitle": "Riese"
				}
			]
		},
		{
			"id": 2007302,
			"completionStepIds": [
				2007306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
