					"nextDialogs": [
						726771033
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771033,
					"content": "Mais Paimon peut voler. Pas mal aux jambes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771034
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726771034,
					"content": "Hé ! Quand je vole, ça fait travailler tout mon corps, c'est épuisant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771035
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771035,
					"content": "Ouah ! Fleur en feu !",
