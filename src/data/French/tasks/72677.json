			},
			"dialogs": [
				{
					"id": 726770301,
					"content": "Grosse ! Très chaude ! Grosse fleur en feu, génial !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770302
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726770302,
					"content": "Étonnant, n'est-ce pas ? Ah, d'ailleurs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770303,
					"content": "Ne bouge pas, Kichiboushi, on va te prendre en photo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770304,
					"content": "Ici ? Mais il fait trop chaud !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770305
					]
				},
				{
					"id": 726770305,
					"content": "C'est justement ce qu'il faut pour notre photo !",
