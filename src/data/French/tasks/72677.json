			"dialogs": [
				{
					"id": 726771001,
					"content": "Le paysage d'ici est très spécial, tu ne trouves pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771002,
					"content": "Beaucoup d'eau, avec couleur très spéciale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771003,
						726771008,
						726771011
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726771003,
					"content": "Votre niveau de vocabulaire se vaut...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771004
					]
				},
				{
					"id": 726771004,
					"content": "#Mais quoi, c'est vrai que c'est très spécial ! Comment tu décrirais cette couleur, {NICKNAME} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771005,
						726771006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771005,
					"content": "Une couleur Cryo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771007
					]
				},
				{
					"id": 726771007,
					"content": "Qu'est-ce que tu veux dire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771013
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771013,
					"content": "Mais tu as raison, le paysage ici est très spécial. Ça me donnerait presque envie de le peindre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771014
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771014,
					"content": "Tu sais peindre ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771015
					]
				},
				{
					"id": 726771015,
					"content": "... Je peux toujours apprendre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771016,
					"content": "Peindre... Mais peindre, difficile. Avant, vu Utamarou peindre. Juste un tableau, ça prend longtemps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771017
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726771017,
					"content": "Pourquoi peindre, si on peut prendre photo ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771018
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726771018,
					"content": "#Euh... C'est vrai ça ! {NICKNAME}, pourquoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771019,
						726771021
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771019,
					"content": "Parce qu'un tableau est une création propre à son auteur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771020
					]
				},
				{
					"id": 726771020,
					"content": "Hmm, ça se tient.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771024
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771024,
					"content": "Et puis, un tableau peint soi-même possède plus de valeur sentimentale.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771025
					]
				},
				{
					"id": 726771025,
					"content": "Oui, c'est tout un travail de peindre son œuvre idéale, un coup de pinceau après l'autre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771026
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771026,
					"content": "Oh... Alors prendre photos de moi est facile, pas difficile et pas sentimental ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771027
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726771027,
					"content": "Hé ! C'est pas ce qu'on veut dire. En fait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771028
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771028,
					"content": "Peindre un tableau demande beaucoup de temps. Ça serait trop fatigant pour toi, Kichiboushi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771029
					]
				},
				{
					"id": 726771029,
					"content": "Oui ! Il faut beaucoup de temps pour peindre un tableau. Il faudrait que tu restes dans la même position tout le long, c'est épuisant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771030
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771030,
					"content": "Quand on m'a scellé dans pierre, debout tout le temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771031
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726771031,
					"content": "Après le sceau rompu, très mal aux jambes.",
