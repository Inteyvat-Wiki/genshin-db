			"dialogs": [
				{
					"id": 726770701,
					"content": "#{NICKNAME}, très {M#fort}{F#forte} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770702,
						726770703
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726770702,
					"content": "Ce n'est pas grand-chose.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770704
					]
				},
				{
					"id": 726770704,
					"content": "#{NICKNAME} et Paimon, souvent en combat ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770705
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726770705,
					"content": "#Euh... Quand on y pense, on se bat tout le temps. Alors qu'à la base, on voyage pour retrouver {M#ta sœur}{F#ton frère}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770706,
						726770708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770706,
					"content": "Ce n'est pas si grave. J'aime me battre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770707
					]
				},
				{
					"id": 726770707,
					"content": "Euh... C'est bien d'avoir l'esprit combatif, mais il ne vaut mieux pas en faire un loisir, hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770710,
					"content": "#Quand je serai grand Bake-danuki, être fort comme {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770711
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726770711,
					"content": "Je suis sûre que tu y arriveras ! Par contre, tu dois me promettre quelque chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770712,
					"content": "Oui ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770713
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726770713,
					"content": "Euh... Hum, hum. Si un jour, tu deviens un Bake-danuki encore plus fort qu'Ioroi, tu ne dois pas t'en prendre aux plus faibles. Et tu ne dois pas te battre sans raison.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770714,
					"content": "#Pas comme cette grande fleur enflammée qui crache du feu dans tous les sens dès qu'elle voit {NICKNAME} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770715,
					"content": "Alors, on peut combattre quand ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770716,
						726770717,
						726770718
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726770716,
					"content": "Dans les moments où tu dois te protéger...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770719
					]
				},
				{
					"id": 726770719,
					"content": "Hmm... Comprends pas trop. Mais d'accord, promis Paimon. Pas s'en prendre aux plus faibles, pas se battre sans raison.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770720
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726770720,
					"content": "Tu es bien sage, Kichiboushi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770721
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770721,
					"content": "Et pour notre prochaine étape... C'est le dernier des huit endroits qu'Ioroi nous a demandé de choisir pour ce parcours initiatique...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770722
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770722,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726770717,
					"content": "Dans les moments où tu dois protéger les autres...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770719
					]
				},
				{
					"id": 726770718,
					"content": "Dans les moments où tu dois te battre pour la bonne cause...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770719
					]
				},
				{
					"id": 726770708,
					"content": "Se battre, c'est incommodant.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770709
					]
				},
				{
					"id": 726770709,
					"content": "Oui. Mais parfois, il est nécessaire de prendre les armes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770703,
					"content": "#C'était pas difficile. Je me suis {M#battu}{F#battue} plein de fois contre ce genre de choses.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770704
					]
				}
			]
