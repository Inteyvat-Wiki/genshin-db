			"dialogs": [
				{
					"id": 726770101,
					"content": "Le paysage d'ici est très spécial, tu ne trouves pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770102,
					"content": "Beaucoup d'eau, avec couleur très spéciale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770103,
						726770108,
						726770111
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726770103,
					"content": "Votre niveau de vocabulaire se vaut...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770104
					]
				},
				{
					"id": 726770104,
					"content": "#Mais quoi, c'est vrai que c'est très spécial ! Comment tu décrirais cette couleur, {NICKNAME} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770105,
						726770106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770105,
					"content": "Une couleur Cryo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770107
					]
				},
				{
					"id": 726770107,
					"content": "Qu'est-ce que tu veux dire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770113,
					"content": "#Enfin bon, on ne peut pas nier que le paysage d'ici est très spécial. {NICKNAME}, tu te souviens de ce peintre que l'on a rencontré ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770114,
						726770116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770114,
					"content": "Vermeer ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770115
					]
				},
				{
					"id": 726770115,
					"content": "Oui, c'est ça, Vermeer ! Tu te rappelles qu'on l'avait aidé à installer de grosses perles super brillantes sur deux grandes statues ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770118,
					"content": "Et après ça, il nous a offert un de ses tableaux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770119,
					"content": "Tu parles de celui-là ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770120
					]
				},
				{
					"id": 726770120,
					"content": "Oui, c'est celui-là ! Kichiboushi, viens voir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770121,
					"content": "Hmm ! Très ressemblant ! C'est photo ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770122
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726770122,
					"content": "Non, c'est un tableau qui a été peint par quelqu'un.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770123,
					"content": "Ah ? Mais pourquoi peindre, si on peut prendre photo ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770124
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726770124,
					"content": "#Euh... C'est vrai ça ! {NICKNAME}, pourquoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770125,
						726770127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770125,
					"content": "Parce qu'un tableau est une création propre à son auteur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770126
					]
				},
				{
					"id": 726770126,
					"content": "Hmm, ça se tient.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770130,
					"content": "Et puis, un tableau peint soi-même possède plus de valeur sentimentale.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770131
					]
				},
				{
					"id": 726770131,
					"content": "Oui, c'est tout un travail de peindre son œuvre idéale, un coup de pinceau après l'autre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770132,
					"content": "Oh... Alors prendre photos de moi est facile, pas difficile et pas sentimental ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770133
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726770133,
					"content": "Hé ! C'est pas ce qu'on veut dire. En fait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770134,
					"content": "Peindre un tableau demande beaucoup de temps. Ça serait trop fatigant pour toi, Kichiboushi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770135
					]
				},
				{
					"id": 726770135,
					"content": "Oui ! Il faut beaucoup de temps pour peindre un tableau. Il faudrait que tu restes dans la même position tout le long, c'est épuisant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770136,
					"content": "Quand on m'a scellé dans pierre, debout tout le temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770137
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726770137,
					"content": "Après le sceau rompu, très mal aux jambes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770138
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726770138,
					"content": "Ouah... Ça a l'air d'avoir été douloureux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770139,
					"content": "Mais Paimon peut voler. Pas mal aux jambes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770140
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726770140,
					"content": "Hé ! Quand je vole, ça fait travailler tout mon corps, c'est épuisant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770141,
					"content": "Ouah ! Fleur en feu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770142
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726770142,
					"content": "Écoute un peu quand on te parle !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770143,
					"content": "Une fleur enflammée ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770144
					]
				},
				{
					"id": 726770144,
					"content": "Ah tiens, c'est vrai que je n'ai jamais vu de fleur enflammée dans la Forêt de Chinju...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770145,
					"content": "Tu en veux une, Kichiboushi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770146,
					"content": "Oui ! Ça a l'air très chaud.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770147
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726770147,
					"content": "#Alors demande poliment à {NICKNAME} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770148
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770148,
					"content": "#{NICKNAME}, je veux ça. Merci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770149
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726770149,
					"content": "Est-ce que tous les Bake-danuki s'expriment comme ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770127,
					"content": "Parce qu'un Daguerréotype coûte cher.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770128
					]
				},
				{
					"id": 726770128,
					"content": "Ah ? Le Daguerréotype coûte cher ? Du coup, ne risque-t-on pas de le casser en se battant, en nageant, en escaladant des montagnes et en sautant de leur sommet ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770129,
					"content": "Oh là là, il va falloir qu'on fasse attention...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770116,
					"content": "Qui ça ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770117
					]
				},
				{
					"id": 726770117,
					"content": "Vermeer, enfin ! Tu te rappelles qu'on l'avait aidé à installer de grosses perles super brillantes sur deux grandes statues ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770106,
					"content": "Une couleur Anémo ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770107
					]
				},
				{
					"id": 726770108,
					"content": "Vos vocabulaires respectifs sont d'un niveau exceptionnel...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770109
					]
				},
				{
					"id": 726770109,
					"content": "Fort comme Paimon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770110
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726770110,
					"content": "#Euh... C'est probablement pas ce que {NICKNAME} a voulu dire... Mais bon, Kichiboushi, tu es quand même intelligent !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770111,
					"content": "C'est vraiment très spécial !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770112
					]
				},
				{
					"id": 726770112,
					"content": "#Tiens ? Ton vocabulaire manque de richesse, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770113
					],
					"speakerTitle": "Paimon"
				}
			]
		},
