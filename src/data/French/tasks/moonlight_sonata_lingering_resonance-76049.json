	"talks": [
		{
			"id": 7604901,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7604901",
							"2"
						],
						"stepId": 7604901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Columbina"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2130.918,
							108.955,
							11206.71
						],
						"pointId": 360300003
					}
				]
			},
			"dialogs": [
				{
					"id": 760490101,
					"content": "... Hmm, c'est peut-être un peu trop aigu. Recommencons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490102
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760490102,
					"content": "Bonjour, Columbina !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490103,
					"content": "Ah, vous enseignez la lyre aux kuuhenkis ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490104,
					"content": "Oui. Elles étaient tellement contentes de l'avoir fait réparer qu'elles ne m'ont pas quittée d'une semelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490105
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760490105,
					"content": "Je n'ai jamais été douée pour jouer de la lyre. J'avais plutôt l'habitude d'écouter les autres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490106
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760490106,
					"content": "Oh, je vois ! Si vous faisiez partie d'un groupe, je pense que vous en seriez la chanteuse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490107,
					"content": "#Mais {NICKNAME} est {M#un}{F#une} virtuose de la musique ! {M#Il}{F#Elle} peut jouer de tout : lyre, tambour djem djem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490108,
						760490109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490108,
					"content": "Tu exagères...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490110
					]
				},
				{
					"id": 760490110,
					"content": "Ah bon ? Dans ce cas... pourriez-vous leur enseigner à ma place ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490111,
						760490112
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760490111,
					"content": "Pourquoi pas ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490113
					]
				},
				{
					"id": 760490113,
					"content": "Je leur apprends l'air de la chanson que je chante d'habitude. Vous vous souvenez de la mélodie ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490114
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760490114,
					"content": "Ou vous pourriez leur enseigner quelque chose d'autre aussi. Les kuuhenkis n'ont pas l'occasion d'entendre de la musique d'ailleurs. Cela m'intéresserait aussi d'écouter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490115
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760490115,
					"content": "(Hmm... Quel morceau devrais-je jouer ?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490202,
						760490801
					]
				},
				{
					"id": 760490202,
					"content": "Essayons l'air que Columbina chante souvent...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490201
					]
				},
				{
					"id": 760490201,
					"content": "(De quelle manière devrais-je jouer ?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490603,
						760490701
					]
				},
				{
					"id": 760490603,
					"content": "Jouons calmement et doucement...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490604
					]
				},
				{
					"id": 760490604,
					"content": "C'était très beau. Vous avez vraiment mémorisé le morceau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490605
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760490605,
					"content": "C'est parce que vous êtes une très bonne chanteuse ! Quand on entend votre voix, on s'arrête parfois pour vous écouter...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490606,
					"content": "Hm, les kuuhenkis ont l'air d'avoir été charmées par votre performance. Peut-être qu'elles ont retenu certaines choses...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490607
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760490607,
					"content": "Je vous redemanderai certainement de m'aider à l'avenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490608
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760490608,
					"content": "Donnez-moi la main.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490609
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760490609,
					"content": "Hein ? Non, c'était une représentation gratuite. Pas de frais demandés !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490610,
					"content": "Hm ? Des frais ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490611
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760490611,
					"content": "J'ai seulement pensé que la douce lueur du clair de lune serait parfaite pour accompagner cette si belle mélodie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760490701,
					"content": "Jouons joyeusement...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490702
					]
				},
				{
					"id": 760490702,
					"content": "Oh ? C'est déjà terminé ? J'aurais pu écouter cela pour toujours...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490703
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760490703,
					"content": "Comme je vous l'ai dit, c'est la seule berceuse dont je me souviens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490704
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760490704,
					"content": "J'ignore encore sa signification, mais après vous avoir entendu jouer, j'ai l'impression que la réponse qui m'attend, là-haut sur la lune... sera belle, quoi qu'il arrive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490705
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760490705,
					"content": "Donnez-moi votre main.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490706
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760490706,
					"content": "Ce n'est pas grave. Vous n'avez vraiment pas besoin de nous donner quelque chose en retour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490707,
					"content": "Ah, ce n'était pas mon intention... J'ai seulement voulu décorer votre mélodie d'un doux rayon de clair de lune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760490801,
					"content": "Essayons quelque chose d'une autre nation...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490802
					]
				},
				{
					"id": 760490802,
					"content": "C'est curieux... J'ai déjà entendu ce genre de mélodies, mais votre jeu leur donne une toute nouvelle dimension...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490803
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760490803,
					"content": "#Ah, peut-être parce que {NICKNAME} a essayé d'exprimer le lien émotionnel qui l'unit à ce lieu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490804,
					"content": "C'est étonnant, mais... j'ai l'impression de pouvoir imaginer le paysage rien qu'en écoutant la mélodie. Je me demande si la réalité est différente de mon imagination...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490805
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760490805,
					"content": "Vous devriez visiter cette nation un jour ! On pourra vous guider là-bas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490806,
					"content": "Mm... Peut-être, si ce jour arrive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760490112,
					"content": "Que devrais-je jouer ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490113
					]
				},
				{
					"id": 760490109,
					"content": "J'en ai juste joué un peu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490110
					]
				}
			]
		},
