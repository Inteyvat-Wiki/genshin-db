			"dialogs": [
				{
					"id": 752460384,
					"content": "#Comme tu es notre {M#aîné}{F#aînée}, c'est à toi de commencer, {M#grand-père}{F#autre grand-mère}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460385
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460385,
					"content": "Avec plaisir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460301
					]
				},
				{
					"id": 752460301,
					"content": "#Ouah, la compétition est rude ! {NICKNAME} vient de faire un mouvement de pro... et ça mord ! {NICKNAME} rembobine et c'est...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460302,
					"content": "Quoi ? Un asha ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460303,
					"content": "Eh beh... C'est une prise inattendue ! Je ne sais pas trop comment on va l'évaluer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460304
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460304,
					"content": "#Super, {M#grand-père}{F#autre grand-mère} ! On verra si quelqu'un arrive à attraper quelque chose d'encore plus spécial. Si ce n'est pas le cas, ça te suffira pour gagner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460305
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460305,
					"content": "Merci à tous ! Je suis face à une concurrence féroce, mais je pense que j'ai une chance de remporter la victoire. Espérons que mon petit-fils ait raison !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460306
					]
				},
				{
					"id": 752460306,
					"content": "#C'est une performance impressionnante de la part de {NICKNAME} ! Les deux autres concurrents ont du fil à retordre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460307,
					"content": "Ifa, c'est à ton tour !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460308,
					"content": "Tu vas y arriver, poto ! Je vais te donner un coup de main, poto !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460309
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460309,
					"content": "Désolé, Cacucu. Tu ne pourras pas m'aider cette fois-ci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460310
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460310,
					"content": "Calmez-vous un peu, les potos... Ah, ça mord !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460311,
						752460313
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460311,
					"content": "Ifa rembobine sa canne à pêche et la tire de toutes ses forces. On dirait qu'il a attrapé un gros poisson...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752460312
					]
				},
				{
					"id": 752460312,
					"content": "Mais... c'est encore une prise inattendue.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 752460313,
					"content": "Euh... On dirait qu'Ifa a pêché un koholasaure... qui traîne un capybara ? Je ne sais pas trop ce qui se passe là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460314,
					"content": "Impressionnant ! Les animaux ont toujours aimé Ifa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460315
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460315,
					"content": "Attendez, la queue de ce koholasaure... Je pense qu'il s'est coupé sur un rocher, et que ce capybara essaye de l'aider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460316
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460316,
					"content": "Peut-être que le capybara essaye de lui manger la queue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460317
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460317,
					"content": "Mais non, poto. Cacucu, tu peux leur demander ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460318
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460318,
					"content": "D'accord, poto !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460319
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460319,
					"content": "Tu vois ? J'avais raison... Non, ce n'est pas ma priorité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460320,
						752460322
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460320,
					"content": "Ifa examine rapidement la queue du koholasaure. Heureusement, ce n'est qu'une blessure bénigne.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752460321
					]
				},
				{
					"id": 752460321,
					"content": "Après des soins simples, le koholasaure et son ami capybara partent.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 752460322,
					"content": "Oh, une nouvelle amitié est née. On dirait qu'aujourd'hui est un jour de chance pour eux aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460323
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460323,
					"content": "« Aussi » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460324
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460324,
					"content": "Eh oui. C'est mon tour, et je sens que je vais gagner !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460325
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460325,
					"content": "Je vais te donner un coup de main, poto !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460326
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460326,
					"content": "Je suppose que c'est ta façon de nous encourager ? Où as-tu appris à dire ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460327
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460327,
					"content": "Cacucu, le meilleur supporter des compétitions de pêche !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460328
					]
				},
				{
					"id": 752460328,
					"content": "Non, ça ne sonne pas très bien. On se bat pour une cause importante, alors il faut que ce soit... Hein ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460329
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460329,
					"content": "Qu'est-ce que c'est ?! Vite, écartez-vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460330
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460330,
					"content": "#Bon, c'est un peu particulier... Un autre capybara ! Et il nous a foncés dessus{NON_BREAK_SPACE}! Tu as dit que c'étaient de gentilles créatures, pourtant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460331,
					"content": "Il doit se battre pour une cause importante. Hmm, je le sens...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460332
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460332,
					"content": "... ou pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460333
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460333,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460334
					],
					"speakerTitle": "Capybara"
				},
				{
					"id": 752460334,
					"content": "Je crois qu'il est en colère contre nous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460335
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460335,
					"content": "Hé, coucou !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460336
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460336,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460337
					],
					"speakerTitle": "Capybara"
				},
				{
					"id": 752460337,
					"content": "Haha ! Génial, poto !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460338
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460338,
					"content": "Hein ? Cacucu est en train de le calmer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460339
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460339,
					"content": "Je crois qu'il le console. On ne dirait pas, mais Cacucu est très doué pour apaiser les patients.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460340
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460340,
					"content": "Ah, même avec son vocabulaire limité ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460341
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460341,
					"content": "Je ne pense pas que ce soit important pour communiquer avec un capybara, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460342
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460342,
					"content": "Ah oui, c'est vrai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460343
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460343,
					"content": "On doit juste faire confiance à notre petit poto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460344
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460344,
					"content": "D'ailleurs, je trouve que le ton est plus important que les mots quand on communique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460345
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460345,
					"content": "Par exemple, quand on dit « bonjour », ça exprime de la joie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460346
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460346,
					"content": "Dire « bonjour » de cette façon, exprime de la frustration.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460347
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460347,
					"content": "Et « bonjour ! », c'est de la colère. Il faut s'enfuir parce qu'un danger est à proximité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460348
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460348,
					"content": "Je ne comprends pas tout, mais je te crois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460349
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460349,
					"content": "On en apprend tous les jours. Merci !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460350
					]
				},
				{
					"id": 752460350,
					"content": "Tout le plaisir est pour moi ! C'est la méthode que j'ai trouvée pour communiquer avec les pucerons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460351
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460351,
					"content": "Les EMPLOYÉS pucerons, s'il te plaît.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460352
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460352,
					"content": "Non, pas seulement les employés. Il y a des pucerons qui n'ont pas voulu travailler, tu sais. Je comprends et je respecte leur décision.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460353
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460353,
					"content": "... Peut-être que tu devrais m'expliquer, poto ? Je ne sais pas trop quoi en penser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460354
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460354,
					"content": "Ah bon ? Je pensais que tu serais fier. Regarde là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460355
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460355,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460356
					],
					"speakerTitle": "Capybara"
				},
				{
					"id": 752460356,
					"content": "Haha ! Vraiment ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460357
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460357,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460358
					],
					"speakerTitle": "Capybara"
				},
				{
					"id": 752460358,
					"content": "Ouah, ouah !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460359
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460359,
					"content": "Oh, on dirait qu'ils s'entendent super bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460360
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460360,
					"content": "Je suis un peu fier, mais... Ororon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460361
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460361,
					"content": "T'inquiète, je gère.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460362
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460362,
					"content": "Bonjour, roi capybara. Une petite faim ? J'ai une fournée de biscuits fraîchement préparés par Ifa à te proposer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460363
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460363,
					"content": "Raouh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460364
					],
					"speakerTitle": "Capybara"
				},
				{
					"id": 752460364,
					"content": "Roi capybara ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460365
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460365,
					"content": "Il les a mangés ! Ça a l'air de lui avoir plu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460366
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460366,
					"content": "Sérieux ! Sérieux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460367
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460367,
					"content": "Attendez... Pourquoi notre compétition de pêche s'est transformée en attraction de parc animalier ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460368,
						752460369
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460368,
					"content": "Hé, ce n'est pas si mal !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460370
					]
				},
				{
					"id": 752460370,
					"content": "Tu as raison. Du coup, c'est Ororon le gagnant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460371
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460371,
					"content": "Comme il a réussi à attraper, ce... Euh, roi capybara ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460372
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460372,
					"content": "C'est un nom qui lui va bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460373
					]
				},
				{
					"id": 752460373,
					"content": "Ororon gagne, oui. Aucun d'entre nous n'a réussi à attraper un poisson de toute façon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460374
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460374,
					"content": "Haha !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460375
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460375,
					"content": "Cool, à moi l'hydromiel ! Même si c'était déjà le mien de base...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460376
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460376,
					"content": "Eh bien, tu vas pouvoir le garder. C'est bien, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460377
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460377,
					"content": "C'est vrai, et le roi capybara nous a laissé quelque chose aussi. Regardez, je crois que c'est un cadeau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460378
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460378,
					"content": "Un cadœuf brillant et une photo ? L'endroit dessus me dit quelque chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460379
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460379,
					"content": "Le roi capybara veut qu'on aille à cet endroit ? On dirait une sorte d'indice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460380
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460380,
					"content": "Ça ne nous fera pas de mal d'aller voir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460381
					]
				},
				{
					"id": 752460381,
					"content": "Je pense aussi. On ira quand vous aurez du temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460382
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460382,
					"content": "Peut-être que quelque chose de génial nous y attend.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460383
					]
				},
				{
					"id": 752460383,
					"content": "Qui sait... Mais il faut y aller préparés, au cas où.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460369,
					"content": "Plutôt amusant, non ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460370
					]
				}
			]
		}
	]
}