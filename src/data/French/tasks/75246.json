			},
			"dialogs": [
				{
					"id": 752460101,
					"content": "#Regarde, {NICKNAME} ! Il y a des gens là-bas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460102,
					"content": "Oh, ils me disent quelque chose. Je pense que c'est...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460103
					]
				},
				{
					"id": 752460103,
					"content": "Ororon et Ifa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460104,
					"content": "#Oh, {M#grand-père}{F#autre grand-mère} et Paimon ! Je savais que c'était des voix que je connaissais !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460105
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460105,
					"content": "Potos !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460106
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460106,
					"content": "Ça faisait longtemps ! Vous êtes aussi en vacances ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460107
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460107,
					"content": "#Oui ! Chasca nous a dit que vous travailliez ici. On serait {M#tombés}{F#tombées} sur vous tôt ou tard !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460108,
					"content": "C'est sûr. L'ambiance de cet endroit est super, tu ne trouves pas ? J'ai entendu dire que tout le monde passe un très bon moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460109
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460109,
					"content": "Héhé, oui ! Avec un peu de chance, ça ne fera que s'améliorer et il y aura encore plus de visiteurs !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460110,
					"content": "Comment se passe le travail ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460111,
					"content": "Pas mal ! Comme les employés sauriens et les pucerons sont tous en bonne santé et pleins d'énergie, on a du temps libre. Du coup, on a décidé de faire un tour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460112
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460112,
					"content": "Les employés pucerons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460113
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460113,
					"content": "Ah ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460114
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460114,
					"content": "Les pucerons sont aussi des employés. Cette partie t'a échappé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460115
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460115,
					"content": "Bien dit, poto !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460116
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460116,
					"content": "Ah, désolé. Je suis reconnaissant envers l'ensemble de notre personnel, bien sûr. Et envers monsieur Ororon de faire attention à eux, d'une manière aussi... proactive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460117
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460117,
					"content": "Nous sommes arrivés tôt pour nous battre pour une cause importante. C'est une récompense en soi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460118
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460118,
					"content": "C'est la première fois que mon poto reçoit une invitation formelle de ce type et, comme vous pouvez le constater, il est très... enthousiaste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460119
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460119,
					"content": "C'est bien d'être enthousiaste.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460120
					]
				},
				{
					"id": 752460120,
					"content": "#Tu vois ? {M#Grand-père}{F#Autre grand-mère} le dit aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460121
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460121,
					"content": "Chaque jour, on a une nouvelle chance de se battre pour ce qui est important. C'est Cacucu qui me l'a appris.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460122
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460122,
					"content": "Haha !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460123
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460123,
					"content": "Mais vous n'êtes pas simplement... en train de pêcher ? Depuis quand ça compte comme « se battre pour ce qui est important » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460124,
					"content": "Tu t'entends parler ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460125
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460125,
					"content": "C'est important, depuis que ça m'a été suggéré par un ami. C'est un célèbre aventurier de Mondstadt qui a une chance incroyable. S'il dit que ça va marcher, qui est-on pour dire le contraire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460126
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460126,
					"content": "(Bennett ?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460127
					]
				},
				{
					"id": 752460127,
					"content": "Le poto a tourné une branche avant de pointer vers cette étendue d'eau. Comme l'a dit Ororon, il vaut mieux suivre la chance là où elle mène que d'essayer de la provoquer soi-même. C'est pour ça qu'on est venus pêcher ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460128
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460128,
					"content": "D'accord, mais bon... Il y a plein de capybaras autour de cet étang ! Peut-on vraiment pêcher ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460129,
					"content": "Évidemment que oui ! Les capybaras sont de gentilles créatures, alors tout va bien. De plus, quand la vie nous donne de l'eau, on pêche. C'est ce que grand-mère m'a appris.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460130
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460130,
					"content": "Ah, encore une des perles de sagesse de grand-mère. Du style : « Quand la vie te donne de la nourriture, tu manges » ou « Quand la vie te donne des citrons, fais de la citronnade ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460131
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460131,
					"content": "#Exactement. Sauf que c'est nous qui vous donnons des citrons cette fois-ci, {M#grand-père}{F#autre grand-mère} et Paimon. Puisque vous êtes là, pourquoi ne pas pêcher avec nous{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460132
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460132,
					"content": "Et pour récompenser nos efforts... La personne qui attrape le plus gros poisson gagnera une pinte d'hydromiel d'Ororon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460133
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460133,
					"content": "Fallait commencer par ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460134,
					"content": "#Héhé ! On dirait que tu oublies à qui tu as affaire. On ne se défile jamais ! Et {NICKNAME} est {M#un}{F#une} adversaire redoutable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460135,
						752460137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460135,
					"content": "Allons-y, les potos !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460136
					]
				},
				{
					"id": 752460136,
					"content": "#Je vois que vous êtes {M#partants}{F#partantes} ! Je vais jouer le jeu aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460137,
					"content": "J'accepte ton défi, petit-fils.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460138
					]
				},
				{
					"id": 752460138,
					"content": "D'accord, le gagnant remporte la totale : tous les poissons et l'hydromiel des employés pucerons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ororon"
				}
			]
		},
