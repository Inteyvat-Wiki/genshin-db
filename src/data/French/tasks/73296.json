				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Julien"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732960801,
					"content": "Alors ? C'est superbe, hein ? Poivre a l'air de bien aimer aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960802,
					"content": "Aucun mot ne peut qualifier cette vue. Caterpillar avait raison, il y a tant à voir en dehors de ma boîte en métal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960803
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960803,
					"content": "Boîte en métal... Vous nous avez effectivement dit que vous viviez dans un endroit étroit à Fontaine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960804,
					"content": "Ahem. Les beaux paysages sont nombreux à Sumeru.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960805
					]
				},
				{
					"id": 732960805,
					"content": "Ah, mais oui ! Il a décidé de devenir un véritable artiste, alors changeons d'environnement pour... Euh... Élargir nos horizons !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960806,
					"content": "Vous avez beau dire que vous voulez renoncer, mais je trouve que c'est trop tôt pour ça ! Réfléchissez-y encore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960807,
					"content": "Il doit bien exister des paysages encore plus splendides que celui-ci et que vous n'avez jamais vus ! Peut-être que ça vous donnera l'inspiration que vous recherchez !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960808,
					"content": "Et ne vous en faites pas pour votre perception des couleurs. Comme vous l'avez dit, ce n'est qu'une différence de vision...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960809,
					"content": "Mais nous ressentons la même beauté.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960810
					]
				},
				{
					"id": 732960810,
					"content": "Pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960811,
					"content": "En effet, vous avez raison.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960812
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960812,
					"content": "Je n'ai fait que répéter vos paroles !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960813,
					"content": "Je... Haha, je le savais. C'est juste que je me fourvoyais sur le chemin à prendre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960814
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960814,
					"content": "Nous nous sommes rencontrés parce que Poivre vous a fait prendre cette route. Je ne pense pas qu'on puisse dire que c'était vraiment un mauvais chemin !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960815
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960815,
					"content": "Enfin, c'est quand même dommage qu'on n'ait pas réussi à retrouver le parcours du pèlerinage des Océanides...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960816,
					"content": "Est-ce que ça existe vraiment ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960817
					]
				},
				{
					"id": 732960817,
					"content": "Encore aujourd'hui, je crois que ce parcours existe, mais je ne me soucie plus de le trouver ou non.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960818
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960818,
					"content": "Parce que j'ai trouvé la réponse que je cherchais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960819
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960819,
					"content": "#Merci, mes {M#amis}{F#amies}. *soupir* Comment pourrais-je un jour vous remercier assez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960820
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960820,
					"content": "#Si seulement j'avais acheté ces œufs mystiques... Un tel objet peut sûrement chasser la malchance ou être d'une quelconque utilité pour des {M#aventuriers}{F#aventurières} comme vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960821,
						732960823
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960821,
					"content": "C'est vrai que c'est dommage.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960822
					]
				},
				{
					"id": 732960822,
					"content": "#Tu y crois vraiment, {NICKNAME} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960825
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960825,
					"content": "Je vais rester ici pendant un certain temps. Cet endroit apaise mon esprit et c'est idéal pour un peu d'introspection.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960826
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960826,
					"content": "Je pense pouvoir dessiner quelque chose de différent cette fois-ci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960827
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960827,
					"content": "#Merci, mes {M#amis}{F#amies}. Je vous souhaite une bonne route !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960823,
					"content": "C'est gentil, mais nous n'en avons pas besoin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960824
					]
				},
				{
					"id": 732960824,
					"content": "Et pourquoi pas ? Si ces œufs sont capables de chasser la malchance, ils doivent avoir un bien meilleur goût que des œufs ordinaires !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960825
					],
					"speakerTitle": "Paimon"
				}
			]
		},
