			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Julien"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732960201,
					"content": "#Paimon et {NICKNAME}, vous êtes ici ! Avoir des amis de confiance est réellement une nécessité quand on s'aventure dans la nature.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960202
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960202,
					"content": "Nous avons accepté de vous guider, non ? Ce n'est pas une tâche difficile. Je dirais même que c'est super fastoche ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960203,
					"content": "Mais vous êtes sûr de vouloir rentrer aussitôt à Fontaine ? Vous êtes à Sumeru, il y a tellement de choses à voir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960204,
						732960206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960204,
					"content": "La forêt tropicale est splendide.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960205
					]
				},
				{
					"id": 732960205,
					"content": "Il y a beaucoup d'arbres et de rivières !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960208,
					"content": "Je suis sûr que c'est aussi charmant que vous le dites, mais hélas... Je ne crois pas être préparé à voyager à l'étranger aussi longtemps. Cette aventure a été un échec total, mais j'en tire de précieux enseignements.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960209
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960209,
					"content": "Euh, il y a aussi beaucoup de belles choses à voir près d'ici ! Ce serait dommage de les louper.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960210,
					"content": "Les conseils de Paimon ne déçoivent jamais.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960211
					]
				},
				{
					"id": 732960211,
					"content": "Bon, si vous insistez. Ce serait malpoli de refuser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960212
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960212,
					"content": "Héhé ! Je suis la meilleure guide de Teyvat ! Laissez-moi faire et ne traînez pas trop derrière.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960206,
					"content": "Le désert a du charme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960207
					]
				},
				{
					"id": 732960207,
					"content": "Il y a du sable à perte de vue et plein de ruines !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960208
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7329603,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7329612",
							"2"
						],
						"stepId": 7329612,
						"stateName": "QUEST_STATE_UNFINISHED"
