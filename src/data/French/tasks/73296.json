			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Julien"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732960301,
					"content": "Les artistes doivent apparemment regarder leur sujet sous tous les angles avant de commencer à dessiner, pas vrai ? Ce n'est pas un cliché, hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960302,
					"content": "Regardons autour et si nous ne trouvons rien, réessayons depuis un endroit en hauteur !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960303,
					"content": "C'est une bonne idée. Je suis prêt à partir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960304
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960304,
					"content": "#Est-ce qu'on fait la course jusqu'à là-bas ? {M#Prêt}{F#Prête}, {NICKNAME} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7329604,
			"completionStepIds": [
				7329604
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7329604",
							"2"
						],
						"stepId": 7329604,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Julien"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732960401,
					"content": "Cet endroit sent vraiment la nature ! Ça ne vous donne pas envie de chercher l'inspiration et de sortir un carnet pour dessiner ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960402,
					"content": "En voilà un de cliché...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960403
					]
				},
				{
					"id": 732960403,
					"content": "Mais... Pourtant, j'ai bien envie de prendre un pinceau. C'est un lieu plein de vie et les couleurs sont splendides...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960404,
					"content": "Ahem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960405
					]
				},
				{
					"id": 732960405,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960406,
					"content": "Désolée, je ne voulais pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960407,
					"content": "Haha, ce n'est rien. Ma vision est simplement différente de la vôtre, mais nous ressentons la même beauté.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960408
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960408,
					"content": "Oui ! J'aime bien ici, c'est comme si mon âme avait été purifiée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960409,
					"content": "Ton âme n'avait pas besoin de purification.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960410
					]
				},
				{
					"id": 732960410,
					"content": "Merci d'avoir fait preuve de gentillesse à l'égard d'un individu comme moi qui vous a menti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960411
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960411,
					"content": "#Vous avez {M#tous}{F#toutes} les deux une âme pure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960412
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960412,
					"content": "Héhé... Vous exagérez. Il existe encore mieux comme paysage !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960413,
					"content": "#Je parie que tu sais de quoi je parle, {NICKNAME}. Emmenons Julien là-bas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
