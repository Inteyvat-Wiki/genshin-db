						220470402
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470402,
					"content": "Vous avez pu bien voir ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470403
					]
				},
				{
					"id": 220470403,
					"content": "Oui, votre prise de l'arc, la façon dont vous tendez la corde... Tout !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470404
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470404,
					"content": "Mais, comment dire... Plus je vous regarde et plus je me rends compte de l'écart qu'il y a entre nous en termes de technique. *soupir*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470405
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470405,
					"content": "Hum, je ne dois pas me laisser abattre. Merci et prenez ça en cadeau pour la démonstration.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470406
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470406,
					"content": "Je vais recommencer à m'entraîner dans un instant. Définissons l'objectif à atteindre... 7 tirs sur 10 ?",
