			"dialogs": [
				{
					"id": 220470101,
					"content": "J'ai encore raté la cible... Qu'est-ce qui ne va pas avec moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470102
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470102,
					"content": "Vous vous entraînez encore au tir à l'arc ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470103
					]
				},
				{
					"id": 220470103,
					"content": "Oh, mais c'est vous... Merci encore pour la démonstration de la dernière fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470104
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470104,
					"content": "Grâce à vous, je suis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470105,
						220470106
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470105,
					"content": "Devenu un pro de l'arc ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470107
					]
				},
				{
					"id": 220470107,
					"content": "Hum, je n'irai pas jusque-là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470108
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470108,
					"content": "Mais j'arrive à toucher ma cible la moitié du temps au moins...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470109
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470109,
					"content": "Mes instructeurs en attendent davantage de ma part, alors je continuerai à travailler dur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470110
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470110,
					"content": "Hum, je profite de votre présence pour vous le demander... Ça vous dérangerait de me refaire une démonstration ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470111
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470111,
					"content": "Je progresserai plus facilement avec votre aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470112,
						220470114
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470112,
					"content": "Aucun problème.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470113
					]
				},
				{
					"id": 220470113,
					"content": "Merci beaucoup ! Je vais bien vous observer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470120
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470120,
					"content": "Je vous laisse me montrer, alors. Je vous observerai minutieusement de mon côté.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470114,
					"content": "Avez-vous pu surmonter vos points faibles depuis ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470115
					]
				},
				{
					"id": 220470115,
					"content": "Vous voulez dire ma posture, ma puissance et ma prise qui laissaient toutes à désirer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470116
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470116,
					"content": "... Honnêtement, j'y travaille encore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470117
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470117,
					"content": "Mis à part ça, je crains de ne pas savoir me servir des compétences que j'ai apprises en combat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470118
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470118,
					"content": "Ahem, ne mettons pas la charrue avant les Géosaures. Il faudrait que je maîtrise d'abord les bases.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470119
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470119,
					"content": "Je vous laisse me montrer, alors. Je vous observerai minutieusement de mon côté.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470106,
					"content": "Devenu un sniper d'élite ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470107
					]
				}
			]
