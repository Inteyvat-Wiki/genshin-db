				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 735020101,
					"content": "« Le jour passe le flambeau au jour, et on peut voir depuis le pont le dos du phare quitter son travail. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020102
					],
					"speakerTitle": "Examiner"
				},
				{
					"id": 735020102,
					"content": "Qu'est-ce que c'est ? Une énigme ? Un proverbe ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735020103,
					"content": "Le jour passe le flambeau au jour ? Le dos du phare qui quitte son travail...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735020104,
					"content": "#{M#Voyageur}{F#Voyageuse} ? Êtes-vous également {M#intéressé}{F#intéressée} par l'énigme de monsieur Drusus ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020105,
						735020106
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020105,
					"content": "Est-ce vraiment une énigme ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020107
					]
				},
				{
					"id": 735020107,
					"content": "C'est un chercheur de l'Académie, monsieur Drusus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020108
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020108,
					"content": "Pour autant que je sache... Il est plutôt excentrique, même pour un érudit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020109
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020109,
					"content": "Il adore discuter de toutes sortes d'énigmes et faire des recherches sur des méthodes de chiffrement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020110
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020110,
					"content": "Mais certaines de ses énigmes sont tellement incompréhensibles que peu de gens veulent encore lui adresser la parole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020111
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020111,
					"content": "Par conséquent, il a eu l'idée de récompenser les personnes qui résolvent ses énigmes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020112
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020112,
					"content": "Pour résumer, cette énigme fait allusion à l'emplacement d'un trésor caché.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020113
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020113,
					"content": "Tant qu'on arrive au bon endroit, au bon moment et de la bonne manière, on pourra obtenir le trésor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020114
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020114,
					"content": "Monsieur Drusus a également donné un indice : ces emplacements de trésors cachés se trouvent tous dans la Ville de Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020115
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020115,
					"content": "Mais comme vous pouvez le voir, aucun aventurier n'a encore réussi à résoudre cette énigme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020116
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020116,
					"content": "Si cela vous intéresse, vous pouvez également essayer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020117
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020117,
					"content": "Mais personnellement, je vous recommande de faire quelque chose de plus productif...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020106,
					"content": "Savez-vous qui l'a posée ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020107
					]
				}
			]
		},
		{
			"id": 7350203,
			"completionStepIds": [
				7350203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7350203",
							"2"
						],
						"stepId": 7350203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Drusus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735020301,
					"content": "Personne ne vient aujourd'hui non plus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020302
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020302,
					"content": "C'est ici, l'entrée principale du Temple de la Connaissance ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020303
					]
				},
				{
					"id": 735020303,
					"content": "Tout à fait, je crois que vous avez résolu toutes mes énigmes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020304
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020304,
					"content": "Génial ! Je pensais que personne ne serait capable de le faire aujourd'hui encore ! J'étais sur le point de rentrer pour manger...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020305
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020305,
					"content": "#Pourquoi avez-vous écrit ces énigmes{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020306
					]
				},
				{
					"id": 735020306,
					"content": "Parce que c'est amusant, évidemment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020307
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020307,
					"content": "Vous n'avez pas hésité une seule seconde !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735020308,
					"content": "Et vous ? Pourquoi pensez-vous que j'ai écrit ces énigmes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020309
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020309,
					"content": "Vous pensez que j'aime faire le difficile ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020310,
						735020311
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020310,
					"content": "Peut-être...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020312
					]
				},
				{
					"id": 735020312,
					"content": "Haha, vous vous méprenez sur mon compte, tout comme certaines personnes de l'Académie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020313
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020313,
					"content": "J'ai écrit ces énigmes simplement par amour pour la réflexion qui intervient dans la démarche de la résolution.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020314
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020314,
					"content": "Si vous regardez bien mes énigmes, vous verrez qu'il y a toujours un mot-clé qui permet de les résoudre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020315
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020315,
					"content": "Tant que vous continuez à réfléchir à ce mot-clé, vous serez en mesure de triompher de chaque énigme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020316
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020316,
					"content": "Si mon but était de mener la vie difficile aux autres, je ne laisserais aucun indice pour transformer ces énigmes en véritables casse-tête insolubles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020317
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020317,
					"content": "Mais puisque vous les avez toutes résolues, voici pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020318
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020318,
					"content": "C'est la récompense que vous avez gagnée avec votre pouvoir de réflexion, gardez-la précieusement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020311,
					"content": "Je ne sais pas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020312
					]
				}
			]
		},
