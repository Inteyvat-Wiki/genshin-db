			},
			"dialogs": [
				{
					"id": 761000701,
					"content": "Dégage le passage, vite !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000702
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761000702,
					"content": "Héhé... Pourquoi êtes-vous si pressés...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000703
					],
					"speakerTitle": "Voix du monstre"
				},
				{
					"id": 761000703,
					"content": "D'une manière ou d'une autre... vous allez tous mourir. Mais certains d'entre vous... partiront juste un peu plus tôt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000704
					],
					"speakerTitle": "Voix du monstre"
				},
				{
					"id": 761000704,
					"content": "Il se plaignait de ne pas mourir à l'époque... Il y a trois ans... Et maintenant... Je vais exaucer son souhait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000705
					],
					"speakerTitle": "Voix du monstre"
				},
				{
					"id": 761000705,
					"content": "... Bjorn ? Qu'est-ce que tu lui as fait ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000706
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761000706,
					"content": "Il était trop faible... Les faibles... sont inutiles... Ce ne sont que des insectes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000707
					],
					"speakerTitle": "Voix du monstre"
				},
				{
					"id": 761000707,
					"content": "... Ils ne sont bons qu'à mourir, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000708
					],
					"speakerTitle": "Voix du monstre"
				},
				{
					"id": 761000708,
					"content": "Ne t'avise même pas de l'insulter ! Il n'est pas faible du tout !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000709
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761000709,
					"content": "Oh... À tes yeux... Il était fort...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000710
					],
					"speakerTitle": "Voix du monstre"
				},
				{
					"id": 761000710,
					"content": "Mais... les forts meurent tous de la même manière...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000711
					],
					"speakerTitle": "Voix du monstre"
				},
				{
					"id": 761000711,
					"content": "Je pensais... que tu comprendrais cela mieux que quiconque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000712
					],
					"speakerTitle": "Voix du monstre"
				},
				{
					"id": 761000712,
					"content": "Ceux qui étaient plus forts que toi... Ils sont tous morts, pas vrai ? Ils sont morts il y a trois ans... et il y a dix ans aussi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000713
					],
					"speakerTitle": "Voix du monstre"
				},
				{
					"id": 761000713,
					"content": "... La ferme !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000714
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761000714,
					"content": "Oui... Le seul faible ici... c'est toi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000715
					],
					"speakerTitle": "Voix du monstre"
				},
				{
					"id": 761000715,
					"content": "Sinon... pourquoi est-ce que chaque fois... Chaque fois... tu es le seul à survivre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000716
					],
					"speakerTitle": "Voix du monstre"
				},
				{
					"id": 761000716,
					"content": "... Tu t'es enfui du champ de bataille, hm ? Tu n'es qu'un lâche qui s'accroche à la vie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000717
					],
					"speakerTitle": "Voix du monstre"
				},
				{
					"id": 761000717,
					"content": "Illuga, n'écoutez pas ces absurdités !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761000718,
					"content": "Ça suffit, c'est l'heure de mourir !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761000719
					]
				},
				{
					"id": 761000719,
					"content": "#... {NICKNAME} ! Finissons-en vite !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
		},
