			"dialogs": [
				{
					"id": 740310101,
					"content": "#Affrontons-nous, jeune {M#combattant}{F#combattante} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740310102
					],
					"speakerTitle": "Nizami"
				},
				{
					"id": 740310102,
					"content": "C'était direct comme approche !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740310103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740310103,
					"content": "#Qu'en dites-vous, jeune {M#homme}{F#femme} aux cheveux blonds ? J'ai tout de suite compris que vous étiez un adversaire redoutable qui avait traversé beaucoup d'épreuves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740310104
					],
					"speakerTitle": "Nizami"
				},
				{
					"id": 740310104,
					"content": "Je m'ennuie à mourir, parce que ça fait une éternité que personne ne veut s'entraîner avec moi. Je vous donnerai des coupons si vous acceptez ! J'en ai gagné plein auprès de Roussimoff et je ne sais pas comment les dépenser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740310105
					],
					"speakerTitle": "Nizami"
				},
				{
					"id": 740310105,
					"content": "#Alors ? Vous êtes {M#partant}{F#partante} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nizami"
				}
			]
		},
