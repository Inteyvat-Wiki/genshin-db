					"nextDialogs": [
						740318103
					],
					"speakerTitle": "Nizami"
				},
				{
					"id": 740318103,
					"content": "Mais ce n'est pas un combat, c'est un entraînement. On s'entraîne pour maintenir la paix. Puisque vous êtes pacifiste, vous devriez vous joindre à moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740318104
					],
					"speakerTitle": "Nizami"
				},
				{
					"id": 740318104,
					"content": "Vous avez raison. Allons-y !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740318105
					]
				},
				{
					"id": 740318105,
					"content": "Haha, génial !",
