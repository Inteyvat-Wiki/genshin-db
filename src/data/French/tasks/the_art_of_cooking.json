			"dialogs": [
				{
					"id": 4670101,
					"content": "Hum, que devrais-je cuisiner après ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670102
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670102,
					"content": "Salut ! Vous êtes aussi du coin ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670103
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670103,
					"content": "Non, nous sommes juste de passage ici. Qu'est-ce que tu cuisines ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4670104,
					"content": "#Je vois, bienvenue à {M#tous}{F#toutes} les deux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670105
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670105,
					"content": "Je m'appelle Lynn, l'experte en survie de la Guilde des aventuriers ! Comme vous pouvez le voir, je suis en train de tester de nouvelles recettes de cuisine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670106
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670106,
					"content": "« Ne jamais partir le ventre vide » est la première règle du Guide de survie dans la nature.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670107
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670107,
					"content": "Un pique-nique ! J'adore ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4670108,
					"content": "#{M#Mon}{F#Ma} partenaire de voyage est aussi un cordon-bleu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670801,
						4670901
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4670801,
					"content": "Je peux cuisiner quelques plats simples...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4670802
					]
				},
				{
					"id": 4670802,
					"content": "Super ! Montre-moi de quoi tu es capable !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670803
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670803,
					"content": "On ne rencontre pas une experte en survie telle que moi tous les jours !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671001
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4671001,
					"content": "Il y a des champignons et un peu de poulet dans le tonneau là-bas. Prépare-moi une <color=#00E1FFFF>brochette de poulet et de champignons</color>, s'il te plaît !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670901,
					"content": "J'adore cuisiner !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4670902
					]
				},
				{
					"id": 4670902,
					"content": "Super ! Montre-moi de quoi tu es capable !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670903
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670903,
					"content": "C'est toujours mieux de s'entraîner avec quelqu'un. Plus on est de fous, plus on rit !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671001
					],
					"speakerTitle": "Lynn"
				}
			]
		},
