					"nextDialogs": [
						4671209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4671209,
					"content": "Avec ton niveau, tu pourrais essayer de préparer des plats plus compliqués.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671210
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4671210,
					"content": "J'ai quelques ingrédients dans mon sac. Prenez-les en guise de remerciement pour ce repas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671211
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4671211,
					"content": "On peut vraiment les prendre ? Ça ne va pas te manquer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4671212,
					"content": "Bien sûr. Ne vous inquiétez pas, je peux en ramasser plein <color=#00E1FFFF>dans la nature</color>. Il suffit de garder l'œil !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671213
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4671213,
					"content": "Sinon, <color=#00E1FFFF>Le Bon Chasseur</color> vend aussi des plats et des ingrédients. Allez y faire un tour quand vous aurez le temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671214
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4671214,
					"content": "Merci pour ces infos... Hé ! Laissez-moi quelques brochettes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
