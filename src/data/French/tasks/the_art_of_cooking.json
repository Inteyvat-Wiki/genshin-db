					"nextDialogs": [
						4670307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4670307,
					"content": "Le goût est indescriptible... Ça passe, mais de peu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670308
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670308,
					"content": "#Quoi ?! {NICKNAME} est capable de mieux faire ! Cette fois ne compte pas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4670309,
					"content": "Tu as beaucoup de potentiel. Il te manque juste un peu de pratique !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670310
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670310,
					"content": "J'ai quelques ingrédients dans mon sac. Prenez-les en guise de remerciement pour ce repas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670311
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670311,
					"content": "On peut vraiment les prendre ? Ça ne va pas te manquer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4670312,
					"content": "Bien sûr. Ne vous inquiétez pas, je peux en ramasser plein <color=#00E1FFFF>dans la nature</color>. Il suffit de garder l'œil !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670313
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670313,
					"content": "Sinon, <color=#00E1FFFF>Le Bon Chasseur</color> vend aussi des plats et des ingrédients. Allez y faire un tour quand vous aurez le temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670314
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670314,
					"content": "Merci pour ces infos... Hé ! Laissez-moi quelques brochettes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
