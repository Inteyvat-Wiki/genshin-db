					"nextDialogs": [
						751120505
					],
					"speakerTitle": "Cima",
					"speakerSubtitle": "Maîtresse-formatrice des Êtres des canopées"
				},
				{
					"id": 751120505,
					"content": "#Vous avez l'air très {M#fort, étranger}{F#forte, étrangère}. Voulez-vous relever mon défi ?",
