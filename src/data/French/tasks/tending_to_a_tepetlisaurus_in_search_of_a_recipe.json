					"nextDialogs": [
						250220307
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220307,
					"content": "Oh ! Il a l'air d'adorer, mais il ne peut pas être rassasié en mangeant simplement des fleurs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220308
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220308,
					"content": "Et puis, ce type de fleur n'a pas l'air bon marché... Enfin bref, je vais en prendre note pour l'instant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220309
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220309,
					"content": "Comment on peut transformer des fleurs en nourriture ? Et si on en faisait un gâteau ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				}
