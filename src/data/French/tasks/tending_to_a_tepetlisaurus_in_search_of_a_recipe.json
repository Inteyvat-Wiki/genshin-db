			"dialogs": [
				{
					"id": 250220301,
					"content": "C'est une jolie fleur, avec un joli nom... Tu veux y goûter, Hora ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220304
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220304,
					"content": "Raouh raouh, raouh !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220305
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220305,
					"content": "(Hora mâche avec précaution et savoure le goût des pétales.)",
