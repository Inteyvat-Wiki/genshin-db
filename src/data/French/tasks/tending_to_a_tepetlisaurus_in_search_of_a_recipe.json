			"dialogs": [
				{
					"id": 250220101,
					"content": "Hmm... On dirait qu'il va falloir essayer une autre recette...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220102
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220102,
					"content": "Raouh raouh, raouh raouh raouh !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220103,
						250220104
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220103,
					"content": "Vous avez des suggestions ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220106
					]
				},
				{
					"id": 250220106,
					"content": "Raouh, raouh !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220107
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220107,
					"content": "D'habitude, Hora peut finir un bol de fruits et jouer toute la journée sans s'arrêter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220108
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220108,
					"content": "Mais maintenant, il ne mange plus que la moitié d'un bol de fruits, avant de s'assoir à côté, sans bouger d'un poil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220109
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220109,
					"content": "J'ai cru qu'il était malade. Mort d'inquiétude, je suis allé chercher de l'aide auprès du vétérinaire dans la nuit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220110
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220110,
					"content": "On a tous les deux cherché à savoir d'où venait le problème, pour nous rendre compte que Hora n'était pas malade. Il faisait simplement... la fine bouche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220111
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220111,
					"content": "Le vétérinaire a dit que la meilleure solution serait de préparer une nouvelle recette pour Hora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220112
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220112,
					"content": "Il a aussi dit que je pouvais essayer de mettre de la musique pour lui pendant les repas, que ça l'aiderait peut-être à retrouver l'appétit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220113,
						250220114
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220113,
					"content": "Ce n'est pas une mauvaise idée...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220115
					]
				},
				{
					"id": 250220115,
					"content": "Hahaha... J'ai en effet trouvé un disque que Hora avait l'air de beaucoup apprécier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220116
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220116,
					"content": "Mais nous avons été obligés d'abandonner ce plan quand il a bondi pour croquer la moitié du disque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220117
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220117,
					"content": "Après tout, un disque fait d'obsidienne et de phlogistique est un encas particulièrement savoureux pour un tepetlisaure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220118
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220118,
					"content": "Il ne me reste plus qu'à aller voir les Êtres des canopées et prier pour que quelqu'un m'aide à trouver de nouveaux ingrédients.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220119,
						250220120
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220119,
					"content": "Je vais vous chercher des ingrédients.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220121
					]
				},
				{
					"id": 250220121,
					"content": "Vous voulez nous aider ? C'est génial ! Les Êtres des canopées ne peuvent chercher des ingrédients qu'à Natlan, alors que vous pouvez aller au-delà de la frontière !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220124
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220124,
					"content": "Attendez, je vais regarder la liste des ingrédients recommandés par le vétérinaire. Il s'y connaît pas mal, il y a même des ingrédients étrangers...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220125
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220125,
					"content": "Hmm... Ça dit qu'on pourrait essayer des <color=#00E1FFFF>roses arc-en-ciel</color>, des <color=#00E1FFFF>melons lavandes</color> et des <color=#00E1FFFF>fleurs de Qingxin</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220122
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220122,
					"content": "Bon, je vous remercie. Apportez-moi les ingrédients dès que vous mettrez la main dessus !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220123
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220123,
					"content": "Raouh raouh, raouh raouh !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220120,
					"content": "C'est mon domaine d'expertise.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220121
					]
				},
				{
					"id": 250220114,
					"content": "Je ne savais pas que ça existait ce genre de musique.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220115
					]
				},
				{
					"id": 250220104,
					"content": "(Toucher Hora...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220105
