			"dialogs": [
				{
					"id": 762260201,
					"content": "Hein ? Maalaus ? Tu es là aussi ? On ne s'attendait pas à te croiser sur la lune !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260202,
					"content": "Alors c'est Columbina qui t'a amenée ici, non ? Elle avait bien dit qu'elle t'emmènerait sur la lune pour ton exposition.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260203,
					"content": "D'ailleurs, en parlant de l'exposition... Où sont tes tableaux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260204,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260205
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 762260205,
					"content": "Qu'est-ce qui se passe ? Ne me dis pas... qu'ils sont perdus ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260206,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260207
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 762260207,
					"content": "Comment est-ce possible ? On est sur la lune ! On n'a quand même pas pu les voler, si...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260208,
					"content": "Bref, aidons d'abord Maalaus à les chercher. Ils ont peut-être juste été laissés quelque part dans les environs.",
					"roleType": "TALK_ROLE_NPC",
